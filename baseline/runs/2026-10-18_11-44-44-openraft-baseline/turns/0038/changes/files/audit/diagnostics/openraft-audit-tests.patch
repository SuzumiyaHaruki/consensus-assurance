 use crate::Config;
 use crate::SnapshotPolicy;
 
+use std::ops::Deref;
+use std::panic::AssertUnwindSafe;
+
+struct St<R>(R);
+
+impl<R> Deref for St<R> {
+    type Target = R;
+
+    fn deref(&self) -> &R {
+        &self.0
+    }
+}
+
+/// `SnapshotPolicy::LogsSinceLast` adds an unvalidated `u64` to the snapshot
+/// index. The parser accepts `u64::MAX`, and the addition overflows on every
+/// commit once a snapshot exists.
+#[test]
+fn audit_snapshot_policy_max_threshold_overflow() -> anyhow::Result<()> {
+    let config = Config::build(&["foo", "--snapshot-policy=since_last:18446744073709551615"])?;
+    assert_eq!(SnapshotPolicy::LogsSinceLast(u64::MAX), config.snapshot_policy);
+
+    let mut st = crate::RaftState::<u64, (), crate::TokioInstant>::default();
+    st.committed = Some(crate::testing::log_id(1, 1, 5));
+    st.snapshot_meta.last_log_id = Some(crate::testing::log_id(1, 1, 1));
+    let st = St(st);
+
+    if cfg!(debug_assertions) {
+        let res = std::panic::catch_unwind(AssertUnwindSafe(|| {
+            SnapshotPolicy::LogsSinceLast(u64::MAX).should_snapshot(&st)
+        }));
+        assert!(res.is_err(), "expected snapshot index + u64::MAX to overflow");
+    } else {
+        // The add wraps to 1, so every committed entry is "5000 entries
+        // since the snapshot" and a snapshot is triggered on every commit.
+        assert!(
+            SnapshotPolicy::LogsSinceLast(u64::MAX).should_snapshot(&st),
+            "release build must be shown to trigger a snapshot after every commit"
+        );
+    }
+    Ok(())
+}
+
