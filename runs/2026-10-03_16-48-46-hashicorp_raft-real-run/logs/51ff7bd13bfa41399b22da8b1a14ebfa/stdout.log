 := leader.VerifyLeader()\n\n\tif err := verify.Error(); err != ErrNotLeader && err != ErrLeadershipLost {\n\t\tt.Fatalf(\"err: %v\", err)\n\t}\n\n\t// Ensure the known leader is cleared\n\tif l, _ := leader.LeaderWithID(); l != \"\" {\n\t\tt.Fatalf(\"bad: %v\", l)\n\t}\n}\n\nfunc TestRaft_VerifyLeader_PartialConnect(t *testing.T) {\n\t// Make a cluster\n\tconf := inmemConfig(t)\n\tc := MakeCluster(3, t, conf)\n\tdefer c.Close()\n\n\t// Get the leader\n\tleader := c.Leader()\n\n\t// Wait until we have a followers\n\tlimit := time.Now().Add(c.longstopTimeout)\n\tvar followers []*Raft\n\tfor time.Now().Before(limit) && len(followers) != 2 {\n\t\tc.WaitEvent(nil, c.conf.CommitTimeout)\n\t\tfollowers = c.GetInState(Follower)\n\t}\n\tif len(followers) != 2 {\n\t\tt.Fatalf(\"expected two followers but got: %v\", followers)\n\t}\n\n\t// Force partial disconnect\n\tfollower := followers[0]\n\tt.Logf(\"[INFO] Disconnecting %v\", follower)\n\tc.Disconnect(follower.localAddr)\n\n\t// Verify we are leader\n\tverify := leader.VerifyLeader()\n\n\t// Wait for the leader to step down\n\tif err := verify.Error(); err != nil {\n\t\tt.Fatalf(\"err: %v\", err)\n\t}\n}\n\nfunc TestRaft_NotifyCh(t *testing.T) {\n\tch := make(chan bool, 1)\n\tconf := inmemConfig(t)\n\tconf.NotifyCh = ch\n\tc := MakeCluster(1, t, conf)\n\tdefer c.Close()\n\n\t// Watch leaderCh for change\n\tselect {\n\tcase v := <-ch:\n\t\tif !v {\n\t\t\tt.Fatalf(\"should become leader\")\n\t\t}\n\tcase <-time.After(conf.HeartbeatTimeout * 8):\n\t\tt.Fatalf(\"timeout becoming leader\")\n149:\t// HeartbeatTimeout specifies the time in follower state without contact\n151:\tHeartbeatTimeout time.Duration\n201:\t// LeaderLeaseTimeout is used to control how long the \"lease\" lasts\n205:\tLeaderLeaseTimeout time.Duration\n267:type ReloadableConfig struct {\n285:\t// HeartbeatTimeout specifies the time in follower state without\n287:\tHeartbeatTimeout time.Duration\n301:\tto.HeartbeatTimeout = rc.HeartbeatTimeout\n311:\trc.HeartbeatTimeout = from.HeartbeatTimeout\n319:\t\tHeartbeatTimeout:   1000 * time.Millisecond,\n327:\t\tLeaderLeaseTimeout: 500 * time.Millisecond,\n333:func ValidateConfig(config *Config) error {\n348:\tif config.HeartbeatTimeout < 5*time.Millisecond {\n349:\t\treturn fmt.Errorf(\"HeartbeatTimeout is too low\")\n366:\tif config.LeaderLeaseTimeout < 5*time.Millisecond {\n367:\t\treturn fmt.Errorf(\"LeaderLeaseTimeout is too low\")\n369:\tif config.LeaderLeaseTimeout > config.HeartbeatTimeout {\n370:\t\treturn fmt.Errorf(\"LeaderLeaseTimeout (%s) cannot be larger than heartbeat timeout (%s)\", config.LeaderLeaseTimeout, config.HeartbeatTimeout)\n372:\tif config.ElectionTimeout < config.HeartbeatTimeout {\n373:\t\treturn fmt.Errorf(\"ElectionTimeout (%s) must be equal or greater than Heartbeat Timeout (%s)\", config.ElectionTimeout, config.HeartbeatTimeout)\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"const\": \"explore\",\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"question\": {\n      \"minLength\": 1,\n      \"title\": \"Question\",\n      \"type\": \"string\"\n    },\n    \"harness_pat