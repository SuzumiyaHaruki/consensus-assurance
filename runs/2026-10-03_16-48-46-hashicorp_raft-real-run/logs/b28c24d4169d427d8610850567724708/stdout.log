estoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n../agent-source/raft.go:1203:func (r *Raft) appendConfigurationEntry(future *configurationChangeFuture) {\n../agent-source/raft.go:1244:func (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n../agent-source/raft.go:1292:func (r *Raft) processLogs(index uint64, futures map[uint64]*logFuture) {\n../agent-source/raft.go:1362:func (r *Raft) prepareLog(l *Log, future *logFuture) *commitTuple {\n../agent-source/raft.go:1390:func (r *Raft) processRPC(rpc RPC) {\n../agent-source/raft.go:1418:func (r *Raft) processHeartbeat(rpc RPC) {\n../agent-source/raft.go:1440:func (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n../agent-source/raft.go:1585:func (r *Raft) processConfigurationLogEntry(entry *Log) error {\n../agent-source/raft.go:1603:func (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n../agent-source/raft.go:1736:func (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n../agent-source/raft.go:1814:func (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n../agent-source/raft.go:1956:func (r *Raft) setLastContact() {\n../agent-source/raft.go:1976:func (r *Raft) electSelf() <-chan *voteResult {\n../agent-source/raft.go:2050:func (r *Raft) preElectSelf() <-chan *preVoteResult {\n../agent-source/raft.go:2130:func (r *Raft) persistVote(term uint64, candidate []byte) error {\n../agent-source/raft.go:2141:func (r *Raft) setCurrentTerm(t uint64) {\n../agent-source/raft.go:2152:func (r *Raft) setState(state RaftState) {\n../agent-source/raft.go:2163:func (r *Raft) pickServer() *Server {\n../agent-source/raft.go:2187:func (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n../agent-source/raft.go:2209:func (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n../agent-source/raft.go:2217:func (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n../agent-source/raft.go:2224:func (r *Raft) setCommittedCon