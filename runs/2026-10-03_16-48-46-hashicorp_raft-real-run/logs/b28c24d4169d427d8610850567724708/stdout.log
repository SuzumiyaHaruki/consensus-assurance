*followerReplication, req *AppendEntriesRequest) {\n../agent-source/commitment.go:35:func newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n../agent-source/commitment.go:53:func (c *commitment) setConfiguration(configuration Configuration) {\n../agent-source/commitment.go:67:func (c *commitment) getCommitIndex() uint64 {\n../agent-source/commitment.go:77:func (c *commitment) match(server ServerID, matchIndex uint64) {\n../agent-source/commitment.go:88:func (c *commitment) recalculate() {\n../agent-source/snapshot.go:72:func (r *Raft) runSnapshots() {\n../agent-source/snapshot.go:106:func (r *Raft) shouldSnapshot() bool {\n../agent-source/snapshot.go:125:func (r *Raft) takeSnapshot() (string, error) {\n../agent-source/snapshot.go:216:func (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n../agent-source/snapshot.go:252:func (r *Raft) compactLogs(snapIdx uint64) error {\n../agent-source/snapshot.go:264:func (r *Raft) removeOldLogs() error {\n../agent-source/fsm.go:86:func (r *Raft) runFSM() {\n../agent-source/fsm.go:269:func fsmRestoreAndMeasure(logger hclog.Logger, fsm FSM, source io.ReadCloser, snapshotSize int64) error {\n","exit_code":0,"status":"completed"}}
