{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '299,387p' ../agent-source/replication.go; sed -n '870,965p' ../agent-source/raft.go; sed -n '2209,2238p' ../agent-source/raft.go; grep -n 'heartbeat\\\\|Heartbeat' ../agent-source/net_transport.go | tail -12; sed -n '1,80p' ../agent-source/state.go\"","aggregated_output":"func (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n\t// Get the snapshots\n\tsnapshots, err := r.snapshots.List()\n\tif err != nil {\n\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n\t\treturn false, err\n\t}\n\n\t// Check we have at least a single snapshot\n\tif len(snapshots) == 0 {\n\t\treturn false, fmt.Errorf(\"no snapshots found\")\n\t}\n\n\t// Open the most recent snapshot\n\tsnapID := snapshots[0].ID\n\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n\tmeta, snapshot, err := r.snapshots.Open(snapID)\n\tif err != nil {\n\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n\t\treturn false, err\n\t}\n\tdefer snapshot.Close()\n\n\t// Setup the request\n\treq := InstallSnapshotRequest{\n\t\tRPCHeader:       r.getRPCHeader(),\n\t\tSnapshotVersion: meta.Version,\n\t\tTerm:            s.currentTerm,\n\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n\t\tLastLogIndex:       meta.Index,\n\t\tLastLogTerm:        meta.Term,\n\t\tPeers:              meta.Peers,\n\t\tSize:               meta.Size,\n\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n\t\tConfigurationIndex: meta.ConfigurationIndex,\n\t}\n\n\ts.peerLock.RLock()\n\tpeer := s.peer\n\ts.peerLock.RUnlock()\n\n\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n\t// Make the call\n\tstart := time.Now()\n\tvar resp InstallSnapshotResponse\n\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n\t\ts.failures++\n\t\treturn false, err\n\t}\n\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n\n\tif !r.noLegacyTelemetry {\n\t\t// Duplicated information. Kept for backward compatibility.\n\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n\t}\n\n\t// Check for a newer term, stop running\n\tif resp.Term > req.Term {\n\t\tr.handleStaleTerm(s)\n\t\treturn true, nil\n\t}\n\n\t// Update the last contact\n\ts.setLastContact()\n\n\t// Check for success\n\tif resp.Success {\n\t\t// Update the indexes\n\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n\t\ts.commitment.match(peer.ID, meta.Index)\n\n\t\t// Clear any failures\n\t\ts.failures = 0\n\n\t\t// Notify we are still leader\n\t\ts.notifyAll(true)\n\t} else {\n\t\ts.failures++\n\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n\t}\n\treturn false, nil\n}\n\n// heartbeat is used to periodically invoke AppendEntries on a peer\n// to ensure they don't time out. This is done async of replicate(),\n// since that routine could potentially be blocked on disk IO.\n\t\t\t}\n\n\t\tcase future := <-r.userRestoreCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tif r.getLeadershipTransferInProgress() {\n\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n\t\t\tfuture.respond(err)\n\n\t\tcase future := <-r.configurationsCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tif r.getLeadershipTransferInProgress() {\n\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfuture.configurations = r.configurations.Clone()\n\t\t\tfuture.respond(nil)\n\n\t\tcase future := <-r.configurationChangeChIfStable():\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tif r.getLeadershipTransferInProgress() {\n\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tr.appendConfigurationEntry(future)\n\n\t\tcase b := <-r.bootstrapCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tb.respond(ErrCantBootstrap)\n\n\t\tcase newLog := <-r.applyCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tif r.getLeadershipTransferInProgress() {\n\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// Group commit, gather all the ready commits\n\t\t\tready := []*logFuture{newLog}\n\t\tGROUP_COMMIT_LOOP:\n\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n\t\t\t\tselect {\n\t\t\t\tcase newLog := <-r.applyCh:\n\t\t\t\t\tready = append(ready, newLog)\n\t\t\t\tdefault:\n\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Dispatch the logs\n\t\t\tif stepDown {\n\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n\t\t\t\tfor i := range ready {\n\t\t\t\t\tready[i].respond(ErrNotLeader)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tr.dispatchLogs(ready)\n\t\t\t}\n\n\t\tcase <-lease:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Check if we've exceeded the lease, potentially stepping down\n\t\t\tmaxDiff := r.checkLeaderLease()\n\n\t\t\t// Next check interval should adjust for the last node we've\n\t\t\t// contacted, without going negative\n\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n\t\t\tif checkInterval < minCheckInterval {\n\t\t\t\tcheckInterval = minCheckInterval\n\t\t\t}\n\n\t\t\t// Renew the lease timer\n\t\t\tlease = time.After(checkInterval)\n\n\t\tcase <-r.leaderNotifyCh:\n\t\t\tfor _, repl := range r.leaderState.replState {\n\t\t\t\tasyncNotifyCh(repl.notifyCh)\n\t\t\t}\n\n\t\tcase <-r.followerNotifyCh:\n\t\t\t//  Ignore since we are not a follower\n\n\t\tcase <-r.shutdownCh:\n\t\t\treturn\n\t\t}\n\t}\n}\n\n// verifyLeader must be called from the main thread for safety.\n// Causes the followers to attempt an immediate heartbeat.\nfunc (r *Raft) verifyLeader(v *verifyFuture) {\nfunc (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n\tr.setLeader(\"\", \"\")\n\tr.setState(Candidate)\n\tr.candidateFromLeadershipTransfer.Store(true)\n\trpc.Respond(&TimeoutNowResponse{}, nil)\n}\n\n// setLatestConfiguration stores the latest configuration and updates a copy of it.\nfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n\tr.configurations.latest = c\n\tr.configurations.latestIndex = i\n\tr.latestConfiguration.Store(c.Clone())\n}\n\n// setCommittedConfiguration stores the committed configuration.\nfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n\tr.configurations.committed = c\n\tr.configurations.committedIndex = i\n}\n\n// getLatestConfiguration reads the configuration from a copy of the main\n// configuration, which means it can be accessed independently from the main\n// loop.\nfunc (r *Raft) getLatestConfiguration() Configuration {\n\t// this switch catches the case where this is called without having set\n\t// a configuration previously.\n\tswitch c := r.latestConfiguration.Load().(type) {\n\tcase Configuration:\n\t\treturn c\n\tdefault:\n649:\t// for a good while waiting for a heartbeat whereas the append entries/rpc conn should not.\n660:\tisHeartbeat := false\n675:\t\t// Check if this is a heartbeat\n679:\t\t\tisHeartbeat = true\n682:\t\tif isHeartbeat {\n683:\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"Heartbeat\"}}\n724:\t// Check for heartbeat fast-path\n725:\tif isHeartbeat {\n726:\t\tn.heartbeatFnLock.Lock()\n727:\t\tfn := n.heartbeatFn\n728:\t\tn.heartbeatFnLock.Unlock()\n744:\t// we will differentiate the heartbeat fast path from normal RPCs with labels\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\n// RaftState captures the state of a Raft node: Follower, Candidate, Leader,\n// or Shutdown.\ntype RaftState uint32\n\nconst (\n\t// Follower is the initial state of a Raft node.\n\tFollower RaftState = iota\n\n\t// Candidate is one of the valid states of a Raft node.\n\tCandidate\n\n\t// Leader is one of the valid states of a Raft node.\n\tLeader\n\n\t// Shutdown is the terminal state of a Raft node.\n\tShutdown\n)\n\nfunc (s RaftState) String() string {\n\tswitch s {\n\tcase Follower:\n\t\treturn \"Follower\"\n\tcase Candidate:\n\t\treturn \"Candidate\"\n\tcase Leader:\n\t\treturn \"Leader\"\n\tcase Shutdown:\n\t\treturn \"Shutdown\"\n\tdefault:\n\t\treturn \"Unknown\"\n\t}\n}\n\n// raftState is used to maintain various state variables\n// and provides an interface to set/get the variables in a\n// thread safe manner.\ntype raftState struct {\n\t// currentTerm commitIndex, lastApplied,  must be kept at the top of\n\t// the struct so they're 64 bit aligned which is a requirement for\n\t// atomic ops on 32 bit platforms.\n\n\t// The current term, cache of StableStore\n\tcurrentTerm uint64\n\n\t// Highest committed log entry\n\tcommitIndex uint64\n\n\t// Last applied log to the FSM\n\tlastApplied uint64\n\n\t// protects 4 next fields\n\tlastLock sync.Mutex\n\n\t// Cache the latest snapshot index/term\n\tlastSnapshotIndex uint64\n\tlastSnapshotTerm  uint64\n\n\t// Cache the latest log from LogStore\n\tlastLogIndex uint64\n\tlastLogTerm  uint64\n\n\t// Tracks running goroutines\n\troutinesGroup sync.WaitGroup\n\n\t// The current state\n\tstate RaftState\n}\n\nfunc (r *raftState) getState() RaftState {\n\tstateAddr := (*uint32)(&r.state)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(id,file,a,b,kind='code_observation'):\n sources.append(dict(id=id,file=file,start_line=a,end_line=b,kind=kind));return id\nsrc('follower-authority','raft.go',158,260)\nsrc('replication-context','raft.go',582,652)\nsrc('verify-lease','raft.go',965,1094)\nsrc('vote-handlers','raft.go',1603,1813)\nsrc('snapshot-install','raft.go',1814,1955)\nsrc('startup','api.go',496,708)\nsrc('api-completion','api.go',804,907,'interface_statement')\nsrc('configuration-update','raft.go',1203,1243)\nsrc('leader-results','raft.go',790,964)\nsrc('term-persistence','raft.go',2130,2162)\nsrc('replication-triggers','replication.go',137,201)\nsrc('heartbeat-verify','replication.go',388,442)\nsrc('verify-notify','replication.go',100,118)\nsrc('verify-tally','future.go',236,295)\nsrc('suffrage-contract','configuration.go',7,24,'interface_statement')\nsrc('configuration-rules','configuration.go',196,307)\nsrc('fsm-contract','fsm.go',15,68,'interface_statement')\nsrc('fsm-execution','fsm.go',86,260)\nsrc('snapshot-create','snapshot.go',125,213)\nsrc('snapshot-send','replication.go',299,381)\nsrc('restore-contract','api.go',1042,1100,'interface_statement')\nsrc('restore-user','raft.go',1104,1202)\nsrc('rpc-dispatch','raft.go',1390,1439)\nsrc('transfer-receiver','raft.go',2209,2215)\nsrc('transport-contract','transport.go',28,106,'interface_statement')\nsrc('membership-proposal','membership.md',1,35,'document_statement')\nB=[]\ndef beh(id,a,owner,ctx,trigger,s,**kw):\n d=dict(id=id,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trigger,source_ids=s);d.update(kw);B.append(d)\nbeh('campaign','A2','Raft main loop, campaign RPC workers','Current term and latest configuration; campaign-local reply channel','Follower contact expiry or TimeoutNow; candidate election retries',['follower-authority','leader-tenure','election-producer','vote-handlers','term-persistence','transfer-receiver'],implementation_guards=['Only latest-configuration voters are solicited. Normal follower timeout requires local voting eligibility. Pre-vote precedes term increment unless disabled or leadership transfer.','Vote handlers check known leader, candidate configuration membership, terms, prior persisted vote, and lexicographic last-log term/index freshness. A newer-term request may cause step-down before rejection as nonvoter.'],writes=['Term, role, known leader, last-contact, campaign tally'],durable_effects=['Current term stored before publishing; vote term then candidate bytes stored before granting'],external_effects=['A campaign majority changes role to Leader; higher-term vote reply changes to Follower'],async_boundaries=['One buffered reply channel per campaign; old replies do not enter a later campaign tally'],cross_activity_effects={'A1':'Elects owner of a fresh commitment context using persisted log freshness','A6':'Reads durable vote and last log/snapshot history'},unknowns=['Failure semantics between the two vote persistence writes remain unexamined.'])\nbeh('leader-tenure-state','A2','Raft main loop','One leader tenure with captured term and commitment object','Entering or leaving runLeader',['leader-tenure','replication-context','verify-lease'],writes=['Fresh commitment startIndex, inflight list, replication map, verification map, stepDown channel'],external_effects=['Starts replicators and dispatches a current-term no-op; leaving closes replication stop channels and fails pending inflight and verification futures'],async_boundaries=['Each replicator retains this tenure commitment pointer and stepDown channel; old workers can finish against detached state'],produces_fact_ids=['tenure-support'],cross_activity_effects={'A1':'New commitment requires a current-term entry before advancing old prefix','A7':'Leadership loss does not certify that a previously submitted write was never committed'})\nbeh('replicate-support','A1','Leader dispatch on main loop and per-peer replication workers','Captured leader term, peer identity and commitment pointer','Log dispatch, periodic commit propagation, explicit trigger, retry or successful pipeline response',['dispatch-apply','replication-context','replication-response','replication-producer','replication-match','replication-triggers','snapshot-send'],implementation_guards=['Leader local StoreLogs must succeed before self match. Follower success and absence of newer response term precede match. commitment.match accepts current voters only.'],writes=['Peer nextIndex, lastContact, matchIndexes'],external_effects=['Bounded contiguous append batches; rejection backs up nextIndex; missing log invokes snapshot transfer; successful responses may notify pending verification'],async_boundaries=['Pipeline decoding and heartbeat run separately; replication fallback and commit timeout provide later attempts'],produces_fact_ids=['tenure-support'],consumes_fact_ids=['tenure-support'],cross_activity_effects={'A2':'A newer response term signals this tenure to step down','A3':'Snapshot restores participation when log replay cannot reach peer'},unknowns=['Legal history in which bounded AppendEntries ends before a divergent follower suffix remains to be traced.'])\nbeh('aggregate-commit','A1','Mutex-protected commitment object and main leader loop','One tenure, latest voter set, first index of tenure','match increase or voter-set change; commitCh notification',['commitment','leader-results','leader-consumption'],implementation_guards=['Match increases only for IDs in current voter map. Majority order statistic must reach startIndex and exceed prior commitIndex.'],writes=['Commitment commitIndex then Raft commitIndex on notification'],external_effects=['Updates committed configuration when crossed, queues committed inflight prefix for application, and steps down if removed'],consumes_fact_ids=['tenure-support'],produces_fact_ids=['commit-bound'],cross_activity_effects={'A4':'New configuration is marked committed on crossing its index','A5':'processLogs queues committed entries, separate from completed FSM execution'})\nbeh('follower-append','A1','Raft RPC consumer; transport fast-path for empty heartbeat','Incoming leader term and local log/snapshot predecessor','AppendEntries request',['follower-append','rpc-dispatch','replication-producer','heartbeat-verify'],implementation_guards=['Reject older term or mismatching predecessor; skip same-term duplicate entries; delete conflicting suffix then store new entries'],writes=['Role/term/known leader, log suffix, latest/committed configuration, commitIndex and queued lastApplied'],durable_effects=['Replacement logs persist before successful response'],external_effects=['With positive newer LeaderCommitIndex, queues up to min(LeaderCommitIndex, local last index); successful response refreshes contact. Empty heartbeat producer carries zero commit index.'],produces_fact_ids=['commit-bound'],cross_activity_effects={'A2':'New term changes authority, with same-term candidate transfer exception','A4':'Truncation can revert latest configuration','A5':'processLogs consumes the computed boundary'},unknowns=['Does bounded replication establish matching history through every index used by the follower commit bound?','After successful truncation and failed StoreLogs, cached last-log metadata is not refreshed; applicable failure contract and later consumers remain unresolved.'])\nbeh('membership','A4','Raft main loop','Latest and committed configuration indexes','Admitted configuration request or received configuration entry',['configuration-update','configuration-rules','suffrage-contract','follower-append','leader-consumption'],implementation_guards=['Leader admits changes only after prior latest configuration and current-term no-op are committed. nextConfiguration checks prevIndex, unique nonempty IDs/addresses and at least one voter.'],writes=['Latest configuration, commitment voter map, replication map'],external_effects=['AddVoter grants Voter directly; replication includes Nonvoters too. A following configuration entry implies preceding configuration committed on follower.'],consumes_fact_ids=['commit-bound'],cross_activity_effects={'A1':'Rebuilds eligible match map while preserving retained voter match indexes','A2':'Latest configuration controls campaign and lease quorum eligibility'},unknowns=['Detailed address-change and remove/re-add overlap semantics remain unread.'])\nbeh('verification','A2','Main-loop verifyLeader and asynchronous followerReplication notifications','One verifyFuture attached to current tenure replicators','Public VerifyLeader admitted on verifyCh; response-triggered vote notification',['api-completion','verify-lease','verify-notify','verify-tally','heartbeat-verify','leader-results','replication-context','replication-match','snapshot-send'],implementation_guards=['Threshold is latest voter count / 2 + 1; initial self vote is one. vote lock permits only one terminal notification per future.'],writes=['Future votes and quorumSize; each replicator notify set'],external_effects=['verifyLeader registers the future with every replicator and requests immediate heartbeats. notifyAll forwards success booleans without identity/suffrage; leader loop returns nil once votes reach threshold or steps down on early negative notification.'],produces_fact_ids=['verify-tally-fact'],consumes_fact_ids=['verify-tally-fact'],cross_activity_effects={'A1':'Aggregates support for authority verification using voter-derived threshold','A7':'Successful public verification is intended to prevent stale reads after leadership loss'},existing_protections=['Leader lease separately counts only Voter contact and eventually steps down on insufficient contact. Main-loop tenure exit fails tracked verification futures.'],unknowns=['Can a reachable Nonvoter success complete VerifyLeader while the old leader has lost voter-majority contact and another leader exists, before lease step-down?','Configuration changes concurrent with a pending verification may reinterpret threshold/support; this is a separate unresolved context.'])\nbeh('fsm-consumption','A5','Raft main loop queues; dedicated FSM goroutine consumes','Ordered committed log prefix or explicit snapshot restore','processLogs batch or restoreFuture',['dispatch-apply','fsm-contract','fsm-execution'],implementation_guards=['Skip already queued lastApplied indexes; missing required log panics; batching validates response count'],writes=['Raft queued lastApplied separately from FSM worker lastIndex/lastTerm and user FSM state'],external_effects=['Commands invoke user Apply/ApplyBatch; futures complete after FSM callback. No-ops are not applied. Barrier completion is sequenced through FSM queue. Restore replaces state and worker indexes.'],consumes_fact_ids=['commit-bound'],cross_activity_effects={'A7':'Apply response represents callback completion rather than merely replication','A6':'FSM snapshot captures worker completed index'},unknowns=['Batching interface no-gap wording versus filtered internal log types has not been investigated.'])\nbeh('snapshot-recovery','A3','Replication sender, main RPC loop and FSM worker','Leader term and snapshot log/configuration boundary','Missing append history or InstallSnapshot RPC',['snapshot-send','snapshot-install','fsm-execution'],implementation_guards=['Reject older term/version mismatch, incomplete transfer, snapshot finalization or FSM restore failure'],writes=['After successful FSM restore, lastApplied, snapshot boundary and latest/committed configuration; sender advances nextIndex and reports match on successful response'],external_effects=['Compacts logs or removes old logs for monotonic stores; then acknowledges snapshot'],produces_fact_ids=['tenure-support'],cross_activity_effects={'A1':'Successful snapshot acknowledgement contributes match index to sender tenure','A4':'Receiver installs snapshot configuration','A5':'Snapshot restoration replaces FSM state'},unknowns=['Handling of delayed snapshots relative to newer applied entries needs separate source/history investigation.'])\nbeh('history-reconstruction','A6','NewRaft startup and snapshot goroutine','Persisted current term, logs, snapshot and configuration','Startup or snapshot request',['startup','snapshot-create','term-persistence'],implementation_guards=['Startup validates configuration, loads last log, tries snapshots newest first and scans later configuration entries. Snapshot creation rejects FSM boundary before committed configuration.'],writes=['Startup role Follower, term/log/snapshot caches, lastApplied and configuration; snapshot capture persists index/term/configuration'],external_effects=['Registers heartbeat callback and starts main/FSM/snapshot workers unless test skipStartup set'],cross_activity_effects={'A1':'Persisted history feeds matching and prefix application','A2':'Persisted term and log freshness constrain subsequent campaigns','A3':'Snapshots support recovery and truncation'},unknowns=['Concrete persistence backend error atomicity and restart fault contracts are not yet mapped.'])\nbeh('client-entry','A7','Application API and main loop','Leader-only Apply/Barrier/VerifyLeader; caller-owned FSM implementation','Public invocation',['api-completion','restore-contract','restore-user','leader-results'],implementation_guards=['Apply and Barrier timeout bounds enqueue, not completion. Nonleader rejects operations. Leadership transfer blocks writes/configuration changes.'],external_effects=['Apply returns future; ErrLeadershipLost leaves write survival ambiguous. Disaster-recovery Restore cancels inflight writes, creates a hole above local/snapshot index with current configuration, restores FSM, then public API submits and waits for no-op.'],cross_activity_effects={'A5':'Caller observes FSM completion via future','A3':'Manual restore is documented for disaster recovery into fresh cluster, not nor