    "knowledge": [
      {
        "id": "1f6e894a67e24249ab6b8dbbcd9e76e3-knowledge-0",
        "ref": null,
        "kind": "fact",
        "statement": "shouldSnapshot returns true whenever the log store's last index is below the cached last snapshot index, because the delta is computed as an unsigned subtraction and underflows; in that state the verdict does not depend on any new entry since the snapshot, and it did not clear in the observed window while the store index stayed below the snapshot index. The consequence is witnessed only as redundant snapshot creation at the unchanged snapshot index with the applied index fixed (observed at least twice in one execution); the recurrence rate is not established, and stored-snapshot counts cannot establish it because the in-memory snapshot store replaces its single latest snapshot on Create and returns only that one from List, while the file-backed store reaps older snapshots by its retain count. Operands: CheckRun 9cba2e79ff6c4019b0f0381690d9aaab - control store_last=4/snapshot_index=0 gives false, then the emptied store with store_last=0 against snapshot_index=4 and commit/applied still 4 gives true; CheckRun a4a0cbfa094b4d1982032d9de0652861 - emptied state store_last=0, snapshot_index=3, applied_index=3, should_snapshot=true with the stored count rising 1 to 3.",
        "conditions": "Node whose log store last index has fallen below the cached snapshot index, produced by the target's own compaction (for example a user snapshot with TrailingLogs=0) or left behind by an installed snapshot; the FSM must still be able to answer Snapshot for the redundant attempt to create a snapshot.",
        "source_ids": [
          "should_snapshot",
