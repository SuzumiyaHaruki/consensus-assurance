    ],
    "investigations": [],
    "knowledge": [
      {
        "id": "68e8d28ce0d24ceab7d8ada23a81f56c-knowledge-0",
        "ref": null,
        "kind": "fact",
        "statement": "A follower that installs a snapshot above its own log store's last index ends up with the store's last index below the snapshot index, because the compaction that follows the install honours the configured trailing-log count and therefore keeps entries below the installed snapshot index instead of removing them. The follower's log store then compares below its snapshot index and shouldSnapshot reports true even though the node has applied and committed up to the snapshot and holds no newer entry; that spurious verdict makes the node attempt snapshots at the unchanged index, with the rate of those attempts unmeasured. Observed operands (CheckRun e5116cfe896549deb27799d6d871ed77): snapshot_index=8, applied_index=8, store_last=5, store_emptied=true, should_snapshot=true, with the leader's snapshot taken at index 8 while the follower was isolated.",
        "conditions": "Follower whose log store last index is below the snapshot index the leader ships (typical when a lagging or newly added follower needs a snapshot); the follower's trailing-log configuration must be large enough that post-install compaction does not trim past the installed index.",
        "source_ids": [
          "should_snapshot",
          "install_snapshot",
          "compact_trailing"
        ],
        "executions": {},
        "knowledge": [],
        "changed_premise": "68e8d28ce0d24ceab7d8ada23a81f56c-knowledge-0@1",
        "affected_uses": []
