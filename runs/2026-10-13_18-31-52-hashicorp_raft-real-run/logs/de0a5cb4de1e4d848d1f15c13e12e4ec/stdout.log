{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_18-31-52-hashicorp_raft-real-run/agent-source; sed -n 90,470p raft.go | cat -n | sed 's/\"'^'\"\\\\( *[0-9]*\\\\)/\\\\1/' \"","aggregated_output":"     1\t\tleadershipTransferInProgress int32 // indicates that a leadership transfer is in progress.\n     2\t\tcommitCh                     chan struct{}\n     3\t\tcommitment                   *commitment\n     4\t\tinflight                     *list.List // list of logFuture in log index order\n     5\t\treplState                    map[ServerID]*followerReplication\n     6\t\tnotify                       map[*verifyFuture]struct{}\n     7\t\tstepDown                     chan struct{}\n     8\t}\n     9\t\n    10\t// setLeader is used to modify the current leader Address and ID of the cluster\n    11\tfunc (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {\n    12\t\tr.leaderLock.Lock()\n    13\t\toldLeaderAddr := r.leaderAddr\n    14\t\tr.leaderAddr = leaderAddr\n    15\t\toldLeaderID := r.leaderID\n    16\t\tr.leaderID = leaderID\n    17\t\tr.leaderLock.Unlock()\n    18\t\tif oldLeaderAddr != leaderAddr || oldLeaderID != leaderID {\n    19\t\t\tr.observe(LeaderObservation{Leader: leaderAddr, LeaderAddr: leaderAddr, LeaderID: leaderID})\n    20\t\t}\n    21\t}\n    22\t\n    23\t// requestConfigChange is a helper for the above functions that make\n    24\t// configuration change requests. 'req' describes the change. For timeout,\n    25\t// see AddVoter.\n    26\tfunc (r *Raft) requestConfigChange(req configurationChangeRequest, timeout time.Duration) IndexFuture {\n    27\t\tvar timer <-chan time.Time\n    28\t\tif timeout > 0 {\n    29\t\t\ttimer = time.After(timeout)\n    30\t\t}\n    31\t\tfuture := &configurationChangeFuture{\n    32\t\t\treq: req,\n    33\t\t}\n    34\t\tfuture.init()\n    35\t\tselect {\n    36\t\tcase <-timer:\n    37\t\t\treturn errorFuture{ErrEnqueueTimeout}\n    38\t\tcase r.configurationChangeCh <- future:\n    39\t\t\treturn future\n    40\t\tcase <-r.shutdownCh:\n    41\t\t\treturn errorFuture{ErrRaftShutdown}\n    42\t\t}\n    43\t}\n    44\t\n    45\t// run the main thread that handles leadership and RPC requests.\n    46\tfunc (r *Raft) run() {\n    47\t\tfor {\n    48\t\t\t// Check if we are doing a shutdown\n    49\t\t\tselect {\n    50\t\t\tcase <-r.shutdownCh:\n    51\t\t\t\t// Clear the leader to prevent forwarding\n    52\t\t\t\tr.setLeader(\"\", \"\")\n    53\t\t\t\treturn\n    54\t\t\tdefault:\n    55\t\t\t}\n    56\t\n    57\t\t\tswitch r.getState() {\n    58\t\t\tcase Follower:\n    59\t\t\t\tr.runFollower()\n    60\t\t\tcase Candidate:\n    61\t\t\t\tr.runCandidate()\n    62\t\t\tcase Leader:\n    63\t\t\t\tr.runLeader()\n    64\t\t\t}\n    65\t\t}\n    66\t}\n    67\t\n    68\t// runFollower runs the main loop while in the follower state.\n    69\tfunc (r *Raft) runFollower() {\n    70\t\tdidWarn := false\n    71\t\tleaderAddr, leaderID := r.LeaderWithID()\n    72\t\tr.logger.Info(\"entering follower state\", \"follower\", r, \"leader-address\", leaderAddr, \"leader-id\", leaderID)\n    73\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"follower\"}, 1)\n    74\t\theartbeatTimer := randomTimeout(r.config().HeartbeatTimeout)\n    75\t\n    76\t\tfor r.getState() == Follower {\n    77\t\t\tr.mainThreadSaturation.sleeping()\n    78\t\n    79\t\t\tselect {\n    80\t\t\tcase rpc := <-r.rpcCh:\n    81\t\t\t\tr.mainThreadSaturation.working()\n    82\t\t\t\tr.processRPC(rpc)\n    83\t\n    84\t\t\tcase c := <-r.configurationChangeCh:\n    85\t\t\t\tr.mainThreadSaturation.working()\n    86\t\t\t\t// Reject any operations since we are not the leader\n    87\t\t\t\tc.respond(ErrNotLeader)\n    88\t\n    89\t\t\tcase a := <-r.applyCh:\n    90\t\t\t\tr.mainThreadSaturation.working()\n    91\t\t\t\t// Reject any operations since we are not the leader\n    92\t\t\t\ta.respond(ErrNotLeader)\n    93\t\n    94\t\t\tcase v := <-r.verifyCh:\n    95\t\t\t\tr.mainThreadSaturation.working()\n    96\t\t\t\t// Reject any operations since we are not the leader\n    97\t\t\t\tv.respond(ErrNotLeader)\n    98\t\n    99\t\t\tcase ur := <-r.userRestoreCh:\n   100\t\t\t\tr.mainThreadSaturation.working()\n   101\t\t\t\t// Reject any restores since we are not the leader\n   102\t\t\t\tur.respond(ErrNotLeader)\n   103\t\n   104\t\t\tcase l := <-r.leadershipTransferCh:\n   105\t\t\t\tr.mainThreadSaturation.working()\n   106\t\t\t\t// Reject any operations since we are not the leader\n   107\t\t\t\tl.respond(ErrNotLeader)\n   108\t\n   109\t\t\tcase c := <-r.configurationsCh:\n   110\t\t\t\tr.mainThreadSaturation.working()\n   111\t\t\t\tc.configurations = r.configurations.Clone()\n   112\t\t\t\tc.respond(nil)\n   113\t\n   114\t\t\tcase b := <-r.bootstrapCh:\n   115\t\t\t\tr.mainThreadSaturation.working()\n   116\t\t\t\tb.respond(r.liveBootstrap(b.configuration))\n   117\t\n   118\t\t\tcase <-r.leaderNotifyCh:\n   119\t\t\t\t//  Ignore since we are not the leader\n   120\t\n   121\t\t\tcase <-r.followerNotifyCh:\n   122\t\t\t\theartbeatTimer = time.After(0)\n   123\t\n   124\t\t\tcase <-heartbeatTimer:\n   125\t\t\t\tr.mainThreadSaturation.working()\n   126\t\t\t\t// Restart the heartbeat timer\n   127\t\t\t\thbTimeout := r.config().HeartbeatTimeout\n   128\t\t\t\theartbeatTimer = randomTimeout(hbTimeout)\n   129\t\n   130\t\t\t\t// Check if we have had a successful contact\n   131\t\t\t\tlastContact := r.LastContact()\n   132\t\t\t\tif time.Since(lastContact) < hbTimeout {\n   133\t\t\t\t\tcontinue\n   134\t\t\t\t}\n   135\t\n   136\t\t\t\t// Heartbeat failed! Transition to the candidate state\n   137\t\t\t\tlastLeaderAddr, lastLeaderID := r.LeaderWithID()\n   138\t\t\t\tr.setLeader(\"\", \"\")\n   139\t\n   140\t\t\t\tif r.configurations.latestIndex == 0 {\n   141\t\t\t\t\tif !didWarn {\n   142\t\t\t\t\t\tr.logger.Warn(\"no known peers, aborting election\")\n   143\t\t\t\t\t\tdidWarn = true\n   144\t\t\t\t\t}\n   145\t\t\t\t} else if r.configurations.latestIndex == r.configurations.committedIndex &&\n   146\t\t\t\t\t!hasVote(r.configurations.latest, r.localID) {\n   147\t\t\t\t\tif !didWarn {\n   148\t\t\t\t\t\tr.logger.Warn(\"not part of stable configuration, aborting election\")\n   149\t\t\t\t\t\tdidWarn = true\n   150\t\t\t\t\t}\n   151\t\t\t\t} else {\n   152\t\t\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"heartbeat_timeout\"}, 1)\n   153\t\t\t\t\tif hasVote(r.configurations.latest, r.localID) {\n   154\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, starting election\", \"last-leader-addr\", lastLeaderAddr, \"last-leader-id\", lastLeaderID)\n   155\t\t\t\t\t\tr.setState(Candidate)\n   156\t\t\t\t\t\treturn\n   157\t\t\t\t\t} else if !didWarn {\n   158\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, not part of a stable configuration or a non-voter, not triggering a leader election\")\n   159\t\t\t\t\t\tdidWarn = true\n   160\t\t\t\t\t}\n   161\t\t\t\t}\n   162\t\n   163\t\t\tcase <-r.shutdownCh:\n   164\t\t\t\treturn\n   165\t\t\t}\n   166\t\t}\n   167\t}\n   168\t\n   169\t// liveBootstrap attempts to seed an initial configuration for the cluster. See\n   170\t// the Raft object's member BootstrapCluster for more details. This must only be\n   171\t// called on the main thread, and only makes sense in the follower state.\n   172\tfunc (r *Raft) liveBootstrap(configuration Configuration) error {\n   173\t\tif !hasVote(configuration, r.localID) {\n   174\t\t\t// Reject this operation since we are not a voter\n   175\t\t\treturn ErrNotVoter\n   176\t\t}\n   177\t\n   178\t\t// Use the pre-init API to make the static updates.\n   179\t\tcfg := r.config()\n   180\t\terr := BootstrapCluster(&cfg, r.logs, r.stable, r.snapshots, r.trans, configuration)\n   181\t\tif err != nil {\n   182\t\t\treturn err\n   183\t\t}\n   184\t\n   185\t\t// Make the configuration live.\n   186\t\tvar entry Log\n   187\t\tif err := r.logs.GetLog(1, &entry); err != nil {\n   188\t\t\tpanic(err)\n   189\t\t}\n   190\t\tr.setCurrentTerm(1)\n   191\t\tr.setLastLog(entry.Index, entry.Term)\n   192\t\treturn r.processConfigurationLogEntry(&entry)\n   193\t}\n   194\t\n   195\t// runCandidate runs the main loop while in the candidate state.\n   196\tfunc (r *Raft) runCandidate() {\n   197\t\tterm := r.getCurrentTerm() + 1\n   198\t\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n   199\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n   200\t\n   201\t\t// Start vote for us, and set a timeout\n   202\t\tvar voteCh <-chan *voteResult\n   203\t\tvar prevoteCh <-chan *preVoteResult\n   204\t\n   205\t\t// check if pre-vote is active and that this is not a leader transfer.\n   206\t\t// Leader transfer do not perform prevote by design\n   207\t\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n   208\t\t\tprevoteCh = r.preElectSelf()\n   209\t\t} else {\n   210\t\t\tvoteCh = r.electSelf()\n   211\t\t}\n   212\t\n   213\t\t// Make sure the leadership transfer flag is reset after each run. Having this\n   214\t\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n   215\t\t// which will make other servers vote even though they have a leader already.\n   216\t\t// It is important to reset that flag, because this privilege could be abused\n   217\t\t// otherwise.\n   218\t\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n   219\t\n   220\t\telectionTimeout := r.config().ElectionTimeout\n   221\t\telectionTimer := randomTimeout(electionTimeout)\n   222\t\n   223\t\t// Tally the votes, need a simple majority\n   224\t\tpreVoteGrantedVotes := 0\n   225\t\tpreVoteRefusedVotes := 0\n   226\t\tgrantedVotes := 0\n   227\t\tvotesNeeded := r.quorumSize()\n   228\t\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n   229\t\n   230\t\tfor r.getState() == Candidate {\n   231\t\t\tr.mainThreadSaturation.sleeping()\n   232\t\n   233\t\t\tselect {\n   234\t\t\tcase rpc := <-r.rpcCh:\n   235\t\t\t\tr.mainThreadSaturation.working()\n   236\t\t\t\tr.processRPC(rpc)\n   237\t\t\tcase preVote := <-prevoteCh:\n   238\t\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n   239\t\t\t\tr.mainThreadSaturation.working()\n   240\t\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   241\t\t\t\t// Check if the term is greater than ours, bail\n   242\t\t\t\tif preVote.Term > term {\n   243\t\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n   244\t\t\t\t\tr.setState(Follower)\n   245\t\t\t\t\tr.setCurrentTerm(preVote.Term)\n   246\t\t\t\t\treturn\n   247\t\t\t\t}\n   248\t\n   249\t\t\t\t// Check if the preVote is granted\n   250\t\t\t\tif preVote.Granted {\n   251\t\t\t\t\tpreVoteGrantedVotes++\n   252\t\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   253\t\t\t\t} else {\n   254\t\t\t\t\tpreVoteRefusedVotes++\n   255\t\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   256\t\t\t\t}\n   257\t\n   258\t\t\t\t// Check if we've won the pre-vote and proceed to election if so\n   259\t\t\t\tif preVoteGrantedVotes >= votesNeeded {\n   260\t\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n   261\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   262\t\t\t\t\tpreVoteGrantedVotes = 0\n   263\t\t\t\t\tpreVoteRefusedVotes = 0\n   264\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   265\t\t\t\t\tprevoteCh = nil\n   266\t\t\t\t\tvoteCh = r.electSelf()\n   267\t\t\t\t}\n   268\t\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n   269\t\t\t\t// prevote.\n   270\t\t\t\tif preVoteRefusedVotes >= votesNeeded {\n   271\t\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n   272\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   273\t\t\t\t}\n   274\t\t\tcase vote := <-voteCh:\n   275\t\t\t\tr.mainThreadSaturation.working()\n   276\t\t\t\t// Check if the term is greater than ours, bail\n   277\t\t\t\tif vote.Term > r.getCurrentTerm() {\n   278\t\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n   279\t\t\t\t\tr.setState(Follower)\n   280\t\t\t\t\tr.setCurrentTerm(vote.Term)\n   281\t\t\t\t\treturn\n   282\t\t\t\t}\n   283\t\n   284\t\t\t\t// Check if the vote is granted\n   285\t\t\t\tif vote.Granted {\n   286\t\t\t\t\tgrantedVotes++\n   287\t\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n   288\t\t\t\t}\n   289\t\n   290\t\t\t\t// Check if we've become the leader\n   291\t\t\t\tif grantedVotes >= votesNeeded {\n   292\t\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n   293\t\t\t\t\tr.setState(Leader)\n   294\t\t\t\t\tr.setLeader(r.localAddr, r.localID)\n   295\t\t\t\t\treturn\n   296\t\t\t\t}\n   297\t\t\tcase c := <-r.configurationChangeCh:\n   298\t\t\t\tr.mainThreadSaturation.working()\n   299\t\t\t\t// Reject any operations since we are not the leader\n   300\t\t\t\tc.respond(ErrNotLeader)\n   301\t\n   302\t\t\tcase a := <-r.applyCh:\n   303\t\t\t\tr.mainThreadSaturation.working()\n   304\t\t\t\t// Reject any operations since we are not the leader\n   305\t\t\t\ta.respond(ErrNotLeader)\n   306\t\n   307\t\t\tcase v := <-r.verifyCh:\n   308\t\t\t\tr.mainThreadSaturation.working()\n   309\t\t\t\t// Reject any operations since we are not the leader\n   310\t\t\t\tv.respond(ErrNotLeader)\n   311\t\n   312\t\t\tcase ur := <-r.userRestoreCh:\n   313\t\t\t\tr.mainThreadSaturation.working()\n   314\t\t\t\t// Reject any restores since we are not the leader\n   315\t\t\t\tur.respond(ErrNotLeader)\n   316\t\n   317\t\t\tcase l := <-r.leadershipTransferCh:\n   318\t\t\t\tr.mainThreadSaturation.working()\n   319\t\t\t\t// Reject any operations since we are not the leader\n   320\t\t\t\tl.respond(ErrNotLeader)\n   321\t\n   322\t\t\tcase c := <-r.configurationsCh:\n   323\t\t\t\tr.mainThreadSaturation.working()\n   324\t\t\t\tc.configurations = r.configurations.Clone()\n   325\t\t\t\tc.respond(nil)\n   326\t\n   327\t\t\tcase b := <-r.bootstrapCh:\n   328\t\t\t\tr.mainThreadSaturation.working()\n   329\t\t\t\tb.respond(ErrCantBootstrap)\n   330\t\n   331\t\t\tcase <-r.leaderNotifyCh:\n   332\t\t\t\t//  Ignore since we are not the leader\n   333\t\n   334\t\t\tcase <-r.followerNotifyCh:\n   335\t\t\t\tif electionTimeout != r.config().ElectionTimeout {\n   336\t\t\t\t\telectionTimeout = r.config().ElectionTimeout\n   337\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   338\t\t\t\t}\n   339\t\n   340\t\t\tcase <-electionTimer:\n   341\t\t\t\tr.mainThreadSaturation.working()\n   342\t\t\t\t// Election failed! Restart the election. We simply return,\n   343\t\t\t\t// which will kick us back into runCandidate\n   344\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n   345\t\t\t\treturn\n   346\t\n   347\t\t\tcase <-r.shutdownCh:\n   348\t\t\t\treturn\n   349\t\t\t}\n   350\t\t}\n   351\t}\n   352\t\n   353\tfunc (r *Raft) setLeadershipTransferInProgress(v bool) {\n   354\t\tif v {\n   355\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 1)\n   356\t\t} else {\n   357\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 0)\n   358\t\t}\n   359\t}\n   360\t\n   361\tfunc (r *Raft) getLeadershipTransferInProgress() bool {\n   362\t\tv := atomic.LoadInt32(&r.leaderState.leadershipTransferInProgress)\n   363\t\treturn v == 1\n   364\t}\n   365\t\n   366\tfunc (r *Raft) setupLeaderState() {\n   367\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n   368\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n   369\t\t\tr.configurations.latest,\n   370\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n   371\t\tr.leaderState.inflight = list.New()\n   372\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n   373\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n   374\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n   375\t}\n   376\t\n   377\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n   378\t// the leaderLoop for the hot loop.\n   379\tfunc (r *Raft) runLeader() {\n   380\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   381\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n","exit_code":0,"status":"completed"}}
