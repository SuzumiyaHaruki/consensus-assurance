{
  "$defs": {
    "AuditQuestion": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "explained_by_existing_mechanism",
                "concrete_suspicion",
                "needs_specific_evidence",
                "ready_for_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition"
        },
        "preferred_check": {
          "anyOf": [
            {
              "enum": [
                "source_review",
                "direct_test",
                "controlled_schedule",
                "local_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preferred Check"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/ReadRequest"
          },
          "title": "Requests",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "activity_classes": {
          "items": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7"
            ],
            "type": "string"
          },
          "title": "Activity Classes",
          "type": "array"
        },
        "behavior_ids": {
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "obligation_relation_kind": {
          "anyOf": [
            {
              "enum": [
                "establishment",
                "preservation",
                "consumption",
                "recovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Obligation Relation Kind"
        },
        "counterevidence": {
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "priority": {
          "description": "System consequence and audit significance, justified in importance; not proof",
          "maximum": 3,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "preferred_check",
        "requests",
        "question",
        "importance",
        "source_ids",
        "participants",
        "objects",
        "contexts",
        "event_paths",
        "activity_classes",
        "behavior_ids",
        "fact_ids",
        "obligation_relation_kind",
        "counterevidence",
        "unknowns",
        "priority",
        "trigger_rationale"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "minItems": 1,
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "associations",
        "anchor",
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending",
        "grounding"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "boundary_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Boundary Complete"
        },
        "kind": {
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "boundary_complete",
        "kind",
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "DescriptiveIssue": {
      "additionalProperties": false,
      "properties": {
        "candidate_effect": {
          "enum": [
            "requires_recheck",
            "independent_enrichment"
          ],
          "title": "Candidate Effect",
          "type": "string"
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Object Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate_effect",
        "object_ids",
        "source_ids",
        "reason"
      ],
      "title": "DescriptiveIssue",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "expectation_ids": {
          "description": "Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.",
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object",
      "required": [
        "source_ids",
        "expectation_ids",
        "binding_ids",
        "derivation",
        "applicability",
        "unresolved",
        "conflicts",
        "alternatives"
      ]
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    },
    "RelationDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "depends_all",
            "conditional_on",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "group",
        "rationale",
        "pending",
        "grounding"
      ],
      "title": "RelationDraft",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "parameters": {
          "type": "array",
          "description": " Dictionary entries; keys must be unique. value_json encodes a JSON value.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value_json": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value_json"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description",
        "assumptions",
        "excluded",
        "parameters"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Id"
    },
    "obligation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/BindingDraft"
      },
      "title": "Bindings",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/RelationDraft"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "context_claims": {
      "items": {
        "$ref": "#/$defs/ClaimDraft"
      },
      "title": "Context Claims",
      "type": "array"
    },
    "audit_question": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditQuestion"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_rationale": {
      "title": "Selection Rationale",
      "type": "string"
    },
    "reading_requests": {
      "items": {
        "$ref": "#/$defs/ReadRequest"
      },
      "maxItems": 8,
      "title": "Reading Requests",
      "type": "array"
    },
    "descriptive_issues": {
      "items": {
        "$ref": "#/$defs/DescriptiveIssue"
      },
      "title": "Descriptive Issues",
      "type": "array"
    },
    "fork_from_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fork From Candidate Id"
    },
    "fork_reason": {
      "title": "Fork Reason",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "obligation",
    "bindings",
    "dependencies",
    "context_claims",
    "audit_question",
    "selection_rationale",
    "reading_requests",
    "descriptive_issues",
    "fork_from_candidate_id",
    "fork_reason"
  ],
  "title": "Derivation",
  "type": "object"
}