{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '341,430p' ../agent-source/rawnode_test.go; sed -n '74,113p' ../agent-source/raftpb/confchange.go; sed -n '2053,2062p' ../agent-source/raft.go; sed -n '995,1024p' ../agent-source/raft.go; sed -n '30,65p' ../agent-source/rawnode.go; sed -n '297,322p' ../agent-source/storage.go\"","aggregated_output":"func (r *raft) hasUnappliedConfChanges() bool {\n\tif r.raftLog.applied >= r.raftLog.committed { // in fact applied == committed\n\t\treturn false\n\t}\n\tfound := false\n\t// Scan all unapplied committed entries to find a config change. Paginate the\n\t// scan, to avoid a potentially unlimited memory spike.\n\tlo, hi := r.raftLog.applied+1, r.raftLog.committed+1\n\t// Reuse the maxApplyingEntsSize limit because it is used for similar purposes\n\t// (limiting the read of unapplied committed entries) when raft sends entries\n\t// via the Ready struct for application.\n\t// TODO(pavelkalinnikov): find a way to budget memory/bandwidth for this scan\n\t// outside the raft package.\n\tpageSize := r.raftLog.maxApplyingEntsSize\n\tif err := r.raftLog.scan(lo, hi, pageSize, func(ents []pb.Entry) error {\n\t\tfor i := range ents {\n\t\t\tif ents[i].Type == pb.EntryConfChange || ents[i].Type == pb.EntryConfChangeV2 {\n\t\t\t\tfound = true\n\t\t\t\treturn errBreak\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}); err != nil && err != errBreak {\n\t\tr.logger.Panicf(\"error scanning unapplied entries [%d, %d): %v\", lo, hi, err)\n\t}\n\treturn found\n}\n\n// campaign transitions the raft instance to candidate state. This must only be\n// called after verifying that this is a legitimate transition.\n\n// RawNode is a thread-unsafe Node.\n// The methods of this struct correspond to the methods of Node and are described\n// more fully there.\ntype RawNode struct {\n\traft               *raft\n\tasyncStorageWrites bool\n\n\t// Mutable fields.\n\tprevSoftSt     *SoftState\n\tprevHardSt     pb.HardState\n\tstepsOnAdvance []pb.Message\n}\n\n// NewRawNode instantiates a RawNode from the given configuration.\n//\n// See Bootstrap() for bootstrapping an initial state; this replaces the former\n// 'peers' argument to this method (with identical behavior). However, It is\n// recommended that instead of calling Bootstrap, applications bootstrap their\n// state manually by setting up a Storage that has a first index > 1 and which\n// stores the desired ConfState as its InitialState.\nfunc NewRawNode(config *Config) (*RawNode, error) {\n\tr := newRaft(config)\n\trn := &RawNode{\n\t\traft: r,\n\t}\n\trn.asyncStorageWrites = config.AsyncStorageWrites\n\tss := r.softState()\n\trn.prevSoftSt = &ss\n\trn.prevHardSt = r.hardState()\n\treturn rn, nil\n}\n\n// Tick advances the internal logical clock by a single tick.\nfunc (rn *RawNode) Tick() {\n\trn.raft.tick()\n\toffset := entries[0].Index - ms.ents[0].Index\n\tswitch {\n\tcase uint64(len(ms.ents)) > offset:\n\t\t// NB: full slice expression protects ms.ents at index >= offset from\n\t\t// rewrites, as they may still be referenced from outside MemoryStorage.\n\t\tms.ents = append(ms.ents[:offset:offset], entries...)\n\tcase uint64(len(ms.ents)) == offset:\n\t\tms.ents = append(ms.ents, entries...)\n\tdefault:\n\t\tgetLogger().Panicf(\"missing log entry [last: %d, append at: %d]\",\n\t\t\tms.lastIndex(), entries[0].Index)\n\t}\n\treturn nil\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > map_next.py <<'PY'\nimport json,pathlib\nm=json.load(open('../audit-spec/v1.json'))\n# Controller-derived fields are excluded from the proposed map.\nfor a in m['activities']: a.pop('behavior_ids',None)\nfor f in m['facts']:\n for k in ['established_by','consumed_by']: f.pop(k,None)\nS=[]\ndef source(i,f,a,b,kind='code_observation'):\n S.append(dict(id=i,file=f,start_line=a,end_line=min(b,len((pathlib.Path('../agent-source')/f).read_text().splitlines())),kind=kind))\nfor args in [('S-init','raft.go',437,496),('S-retry','raft.go',616,710),('S-restore','raft.go',1835,1940),('S-storage-msg','rawnode.go',202,366),('S-apply-msg','rawnode.go',375,403),('S-changer','confchange/confchange.go',51,356),('S-confrestore','confchange/restore.go',24,168),('S-loginit','log.go',73,98),('S-apply-limit','log.go',218,273),('S-load','raft.go',2033,2040),('S-tick-transfer','raft.go',862,888),('S-transfer','raft.go',1606,1664),('S-node-loop','node.go',348,460),('S-storage','storage.go',39,313),('S-bootstrap','bootstrap.go',23,88),('S-stable','log_unstable.go',128,161),('S-abort','raft.go',2053,2059),('S-hup-scan','raft.go',995,1023),('S-joint-test','rawnode_test.go',341,430,'test_expectation'),('S-joint-contract','raftpb/raft.proto',117,150,'interface_statement'),('S-joint-duty','raftpb/raft.proto',185,206,'interface_statement'),('S-node-apply-contract','node.go',158,190,'interface_statement'),('S-joint-flag','raftpb/confchange.go',77,112),('S-raw-boundary','rawnode.go',30,64,'interface_statement')]:source(*args)\nB={b['id']:b for b in m['behaviors']}\ndef extend(i,refs):B[i]['source_ids']+=refs\nextend('B-formation',['S-retry','S-transfer']);B['B-formation']['unknowns']=[]\nextend('B-authority',['S-hup-scan','S-tick-transfer','S-transfer','S-abort']);B['B-authority']['unknowns']=['pendingReadIndexMessages is not cleared by reset; lifetime and later consumption need analysis']\nB['B-authority']['writes']+=['Transfer records a non-learner transferee and resets electionElapsed; timeout abort only clears leadTransferee']\nB['B-authority']['external_effects']+=['Transfer sends TimeoutNow when target Match reaches lastIndex; proposals are dropped during transfer; election-timeout abort permits later proposals without itself proposing work']\nextend('B-follower-log',['S-retry']);B['B-follower-log']['unknowns']=[];B['B-follower-log']['implementation_guards']+=['Heartbeat producer caps commit at min(peer Match, leader committed)'];B['B-follower-log']['produces_fact_ids']=['F-commit']\nextend('B-ready',['S-storage-msg','S-apply-msg','S-stable','S-node-loop','S-node-apply-contract']);B['B-ready']['unknowns']=[]\nB['B-ready']['important_branches']=['Append completion carries issuance term plus last unstable index/entry term; stale-term entry stability is ignored. New-term HardState completion can attest still-pending entries even without new entries.','Snapshot completion remains valid after term change; application responses carry term zero because committed work is term independent.','Node run serializes channels and withholds another synchronous Ready until Advance, while still processing messages/ticks/configuration calls. RawNode requires caller serialization.']\nextend('B-config',['S-changer','S-confrestore','S-node-apply-contract','S-joint-contract','S-joint-flag']);B['B-config']['unknowns']=['Configuration-driven commit omits releasePendingReadIndexMessages seen in acknowledgment-driven commit; reachable pending history and alternative release remain unresolved']\nB['B-config']['implementation_guards']=['Simple changes change at most one voter and cannot remove all voters or run in joint state. EnterJoint retains old majority; LeaveJoint removes outgoing majority and activates staged learners.','Changer copies existing progress; additions start Match=0; outgoing voters retain progress through joint state.']\nB['B-config']['writes']+=['JointImplicit or multi-change Auto sets AutoLeave; LeaveJoint clears AutoLeave and outgoing voters'];B['B-config']['produces_fact_ids']+=['F-joint-exit']\ndef add(i,a,trig,refs,**kw):\n b=dict(id=i,primary_activity=a,execution_owner='Serialized raft instance and its caller as specified',protocol_context='One group with current term, applied configuration and durable storage',trigger=trig,source_ids=refs,**kw);m['behaviors'].append(b);B[i]=b\nadd('B-recover','A3','Initialization or received snapshot after Step term processing',['S-init','S-restore','S-confrestore','S-loginit','S-load','S-storage','S-bootstrap'],writes=['Initialization reconstructs log bounds, ConfState and HardState; restores configured applied index and becomes follower','Snapshot at/below committed is ignored; matching snapshot term/index fast-forwards committed without replacing configuration; otherwise restores unstable snapshot and reconstructs tracker','Bootstrap requires empty Storage; installs initial committed configuration entries for caller persistence/application'],implementation_guards=['Snapshot restore requires follower and recipient present in snapshot configuration','HardState commit must lie within stored log bounds','Campaign prohibited while snapshot remains pending/in-progress'],external_effects=['Snapshot acceptance emits persistence-delayed append acknowledgment'],produces_fact_ids=['F-commit'],cross_activity_effects={'A1':'Restored committed prefix remains established history; new remote Match support must be learned','A2':'Recovered term/vote prevent reusing authority; restored membership determines eligibility'},unknowns=[])\nadd('B-application','A5','Ready committed entries or storage apply response / Advance',['S-apply-limit','S-apply-msg','S-node-apply-contract','S-auto','S-step'],reads=['Committed/applying/applied endpoints and local stable boundary'],writes=['Tracks outstanding application size and applied endpoint; responses reduce uncommitted size'],implementation_guards=['Snapshot pending/in-progress suppresses committed entries','Async committed-entry delivery is capped at stable log boundary','Caller finishes prior committed entries/snapshots before applying next batch'],consumes_fact_ids=['F-commit'],cross_activity_effects={'A4':'Caller applies configuration entries before reporting application progress; appliedTo can initiate auto-exit'},unknowns=['Early Advance optimization and delayed ApplyConfChange may deserve a separate caller-ordering investigation'])\nadd('B-auto-exit','A4','raft.appliedTo invoked by storage application/snapshot completion or Advance',['S-auto','S-proposal','S-joint-contract','S-joint-duty','S-abort','S-tick-transfer'],reads=['AutoLeave, applied index, pendingConfIndex, role and transfer state'],consumes_fact_ids=['F-joint-exit'],implementation_guards=['AutoLeave and applied >= pendingConfIndex and StateLeader gate zero configuration proposal','Step rejects proposals during leader transfer'],writes=['Successful proposal appends leave-joint entry and updates pendingConfIndex; rejection leaves no explicit retry flag'],external_effects=['Successful internal proposal broadcasts append; later application of leave-joint entry changes quorum'],cross_activity_effects={'A1':'Exiting joint state removes outgoing-majority support requirement','A2':'Transfer state controls whether internal continuation is admitted'},unknowns=['After rejected internal proposal and transfer timeout, does a legal fully drained history contain any required event that invokes appliedTo again?'])\nf=m['facts'][0];f.update(meaning='Local committed log prefix endpoint. Leader maybeCommit advances to a current-term entry supported by current voters. Follower append/heartbeat, accepted or matching snapshots, initialization from HardState and bootstrap also establish the endpoint under their separate guards.',durability='Caller persists Ready HardState and entries/snapshot. Field update and completed local persistence/application are separate boundaries.',recovery='newLog initializes at compacted prefix; newRaft restores ConfState and in-range HardState commit, term and vote. Snapshot restoration establishes its committed index.',source_ids=f['source_ids']+['S-init','S-restore','S-loginit','S-load','S-bootstrap'],unknowns=[])\nm['facts'].append(dict(id='F-joint-exit',meaning='The applied voter configuration is joint and assigns automatic exit to Raft. This flag records configuration state and responsibility; it does not assert that an exit proposal has been queued.',identity={'group':'Raft group','configuration':'Applied incoming/outgoing voter sets'},validity_context='Current applied configuration with nonempty outgoing voter set and AutoLeave=true; survives term changes until configuration is replaced or joint state is exited.',representation=['tracker.Config.AutoLeave','tracker.Config.Voters[1]'],durability='ConfState saved in caller snapshot; committed configuration log entries reconstruct changes after snapshot.',recovery='ConfState AutoLeave is reconstructed by confchange.Restore through EnterJoint.',source_ids=['S-joint-contract','S-joint-duty','S-changer','S-confrestore'],unknowns=[]))\nB['B-recover']['produces_fact_ids'].append('F-joint-exit')\nfor a in m['activities']:\n a['applicability']='applicable';a['unknowns']=[]\n a['source_ids']+= {'A1':['S-retry'],'A2':['S-init','S-hup-scan','S-transfer'],'A3':['S-restore','S-retry'],'A4':['S-changer'],'A5':['S-apply-limit','S-node-apply-contract'],'A6':['S-storage-msg','S-storage'],'A7':['S-node-loop','S-raw-boundary']}[a['class_id']]\n a['realization_summary']={'A1':'Leader term-qualified quorum aggregation and follower prefix validation establish commit; heartbeat bounds and flow recovery preserve catch-up.','A2':'Term/vote elections, role resets and bounded leader transfer control authority; pending snapshot and unapplied configuration block campaigning.','A3':'Snapshots replace divergent compacted history and restore membership; matching snapshots fast-forward commit; retries use heartbeat responses and transport reports.','A4':'Applied simple/joint changes preserve progress and determine both quorum eligibility and automatic exit responsibility.','A5':'Ready exports ordered committed work; completion advances applied accounting, with distinct async stable-boundary and snapshot restrictions.','A6':'Caller performs IO; library queues durability-dependent support, qualifies completion by issuance term and reconstructs stored state. MemoryStorage implements local storage operations.','A7':'Node serializes events; RawNode caller serializes operations and consumes Ready. Proposal admission does not guarantee commitment.'}[a['class_id']]\nco=m['core_overview'];co['status']='usable';co['core_gaps']=[];co['rationale']='Both core paths now connect through sourced persistence, membership, recovery and application mechanisms; local continuation anomalies remain open rather than assumed defects.'\nco['formation']['explanation']+=' Heartbeats cap follower commit by known Match; rejection probes, empty appends after heartbeat responses and snapshots recover missing support. Application delivery excludes in-progress snapshots and, in async mode, unstable entries.'\nco['formation']['source_ids']+=['S-retry','S-apply-limit'];co['formation']['behavior_ids']+=['B-recover','B-application']\nco['context']['explanation']+=' Startup restores durable term/vote and ConfState as follower. Snapshots reconstruct membership only when replacing the log; matching snapshots advance commit and leave configuration entries for normal application. Campaigning is blocked until committed configuration work and snapshots are handled. Transfers suppress proposals, catch up the target, and abort after electionTimeout if still leader.'\nco['context']['source_ids']+=['S-init','S-restore','S-hup-scan','S-transfer','S-tick-transfer'];co['context']['behavior_ids']+=['B-recover']\nco['connection']['explanation']+=' Old-term storage append replies cannot stabilize