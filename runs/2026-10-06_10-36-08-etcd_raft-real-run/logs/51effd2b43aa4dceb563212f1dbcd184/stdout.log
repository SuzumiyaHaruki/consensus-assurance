s\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/experiment.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/go_module.cpython-310.pyc: binary file matches\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/direct_checks.py:47:        admission=next((r for r in plan.harness.prerequisites if r.alias==monitor.admission_alias),None)\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/direct_checks.py:49:            errors.append('Monitor '+monitor.id+' needs an explicit admission_alias from harness.prerequisites')\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/direct_checks.py:168:    if parsing:blockers.append('Event output contains incomplete or invalid CA_EVENT records')\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/observations.py:14:            admission = next((r for r in declared if r.alias == monitor.admission_alias), None)\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/observations.py:16:                admission_error = 'Explicit admission_alias is missing or prerequisites depend on the result'\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/encoding.py:9:    observations=lambda plan:[(m.checker_id,m.event,m.admission_alias,m.binding_ids) for m in plan.monitors]\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/encoding.py:14:        monitors=[m.model_dump(exclude={'event','admission_alias','applicability_conditions'}) for m in plan.monitors]\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/plugins/targets/hashicorp_raft/assurance_support_test.go:48:\tfmt.Println(\"CA_EVENT \" + string(raw))\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/core/proposals.py:91:    admission_alias: str | None = Field(default=None,\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/go_module.py:36:    harness_instructions = \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py:116:    \"\"\"Extract complete CA_EVENT lines, preserving runner-provided stream ownership.\"\"\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py:121:    marker = \"CA_EVENT \"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/cargo.py:19:    harness_instructions = \"Write Rust #[test] integration tests using the captured crate's public API and existing dependencies. The controller fixes the workspace lock and tools; build reuse is specific to a manifest, integration test target and saved build basis. Switching crates may require a first heavy dependency build. Consult research.json build_inputs for preparation evidence and current seed availability; unlisted targets are not known to be prepared, and available seeds still require execution-time validation. Only the generated test target runs, serially with --nocapture and --locked --offline. Emit complete CA_EVENT JSON lines. Helpers are workspace-relative; never replace manifests, locks, build scripts or Cargo configuration. No extra feature flags are added; original dev-dependencies can enable additional features. Actual compiler-artifact records describe reuse; declaration syntax does not establish active cfg branches or private-state reachability.\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/python.py:9:    harness_instructions = \"Use Python imports from the current isolated workspace and print CA_EVENT JSON containing actual returned values.\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/references/experiments.md:5:CORRELATION Monitor.admission_alias explicitly selects the declared harness prerequisite admitting operations whose completion is owed. It is not the first prerequisite by array order. Harness.prerequisites contains prerequisite events only; monitors select independent result events. ObservableProperty.identity_fields declares the stable operation identity once, using fields present at the relevant observation points. Do not repeat a result as a prerequisite or duplicate each identity equality as a Comparison. Reference conditions declare necessary predecessor relationships; unrelated prerequisites have no implicit list order. Assertions may refer to any declared prerequisite alias that actually precedes the result. Missing identity/reference fields or nonunique associations remain unknown. Independent applicability is checked before requiring unrelated history. Alias-dependent applicability follows correlation. Each operation is matched separately. A complete violating witness survives missing results in demonstrably independent operations, while coverage remains partial. Same-witness ambiguity and potentially global parse loss still block attribution. Use independent identity, not the compared value, to associate an input and output. A context expected to change cannot also be an equality filter. More complex histories need actual correlated prerequisites and results; unsupported general temporal expressions remain a stated limitation.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/consensus-analysis/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/references/experiments.md; sed -n '116,172p' /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py; sed -n '1,115p' /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/observations.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/consensus-analysis/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/references/experiments.md; sed -n '116,172p' /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py; sed -n '1,115p' /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/observations.py\"","aggregated_output":"# Investigation and selection\n\nCandidate investigates a sourced question, including unknown requirements, protection premises or legal history. Obligation fixes an applicable responsibility without presuming violation; Check supplies inputs, history and observations. Missing authority calls for contract investigation, missing history for source work or conditional exploration. Neither gap bars a Candidate or licenses an invented obligation.\n\nFirst explain both core relationships from activity_roles and their connection in AuditSpec.core_overview. Follow representative work through owners, qualified support, aggregation, decision, propagation and consumption; explain acquisition, change and loss of context/authority and handling of old requests, replies, pending support and established decisions. Read the supporting membership, history, recovery and completion mechanisms needed for this backbone. Trace callers and callees, important rejection, retry and asynchronous paths; deeper variants may remain open.\n\nSave early discrepancies as sourced Surfaces or specific unknowns even when no obligation is ready. Distinguish open_details from core_gaps: unexplained formation, authority transition or old-work handling breaks readiness; a usable overview can retain local anomalies. Only a preconfigured directed_question permits a proportionate local boundary first; activity_focus does not. A usable map and first Candidate may share a product. Unmapped source work and exploration need no fabricated Fact.\n\nUse behavior-facts.md for implementation meaning. Select a principal Fact lifecycle with a sourced A1/A2 connection; a question need not span both. Direct behavior_ids establish, consume, invalidate or reinterpret it; supporting_behavior_ids explain separate history/context/consequence support. Cross-activity effects establish actual relationships without relabeling support Activities. Names and protocol labels establish neither relevance nor responsibility.\n\nUse question, counterevidence, unknowns, importance and trigger_rationale to identify what remains unexplained, what existing protection does establish, and what the next action will distinguish. A concise sourced difference suffices; no ranking, mandatory alternative list or confidence threshold. Compare contract reading, smaller exploration and another known relationship before committing to a costly test. “This input has not been run” alone is not a discriminator. An empty unknowns list does not disqualify a check whose earlier investigation established its value.\n\nWhen sourced mechanisms answer the specific suspicion, submit explained and reselect. An unconstructed single obligation may remain unexecuted; this is neither holds nor a budget refund. Fixed artifacts, directed execution tasks, changed premises and open disputes remain visible until explicitly handled. An explicit guard with unresolved ownership, timing, producer or context instead calls for investigation of that premise. A negative result should identify the plausible explanation it excluded and independent premises left open; distinguish it from execution corroborating an already-explained protection. Neither settles the entire Fact or becomes a reason to expand input variants indefinitely. Keep one requirement's independent scenarios together; a genuinely different responsibility gets its own question.\n\nConditional differences with unclear contracts remain exploration or local pause. Once responsibility is grounded, obligation and construction may be separate products. Reuse helpers and legal prefixes only after checking their entry, caller duties, completion order and fault assumptions for this question. A convenient driver must not exclude permitted overlap that supplied the discriminator, nor assume a looser ordering is legal because it produces a difference. Fixed checks must still exercise the investigated premise; a narrower child cannot settle its parent. Use existing F2/F3 when requirement or scope changes. Finish necessary technical repair and review of accepted work; switching questions preserves its debt.\n\nPrioritize consensus safety and explicitly scoped progress duties. Distinguish a sourced numeric/event deadline, implementation-owned automatic continuation without a numeric deadline, and later work explicitly owed by the caller. No numeric deadline does not preclude investigating lost continuation triggers; the word automatic alone supplies no obligation. A possible later event in a comment is not a guarantee that callers produce it. Independently grounded eligibility, accounting, wakeup or correlation duties can be resolved without a client endpoint or global consequence. Shared facts and helpers transfer understanding, not results.\n\nAt natural handoffs retain the answered proposition and remaining discriminator in feedback using tasks/audit.md references. In the next already-needed related map submission, replace the answered original unknown with its sourced conditional relationship and remove obsolete progress reminders. Correct materially misleading higher-level summaries in that same product before reuse; harmless wording differences need no cleanup turn or whole-map sweep. Preserve independent unknowns and historical inputs. Consult the actual answer and assessment, not an understanding label or reference alone. Use behavior-facts.md for primary ownership instead of copying one answer across layers. Source work and exploration may continue from feedback; near expiry save minimal complete learning.\n\nOpen runs continue investigation until controller time/call or actual interruption boundaries. Empty pending_work or disposed registered questions does not exhaust the frontier: use the overview, other consumers/contexts, Surfaces and unread paths. Unit admission exhaustion still permits sourced Candidates, premise investigation and authorized exploration without immediate escalation. Follow each capacity separately; do not repeat handoffs, rerun explained guards, reuse an old Claim for a new proposition or refill budgets. Take a smaller informative step near expiry. Only a preconfigured finite directed task may complete early. Actual cancellation, safety refusal, permission loss and unrecoverable service/tool failure still stop.\nSEMANTIC REVIEW Use the supplied contract against fixed inputs, source dependencies and observations. One checker_correspondence review covers requirement versus encoded predicate, entry/caller duties, oracle, identity, legal history, observation path/completion and counterevidence. Use experiments.md for these criteria, including wait/cleanup ownership and finite progress observations; unexamined continuation triggers remain gaps under the stated scheduling assumptions. Applicability and decomposition need separate answers only for concrete issues. No issue found is provisional, not proof or an independent vote.\n\nCURRENT VERSION Cite unchanged established parts and focus on the increment: what changed, which premise it answers, what the new execution observed and what remains unanswered. Verify that the fixed entry, prefix and schedule still exercise the original discriminator: stronger setup must not exclude the investigated premise. A narrower scope cannot settle its parent; substantive changes use the existing revision rules. New inputs require fresh execution and correspondence; old review success cannot certify them. Scope/cause/consequence questions outside the checked proposition are independent limits, not additional confirmation gates. Never alter a requirement or weaken a predicate merely to obtain a passing test.\n\nISSUES Fixed Claim, Harness and Monitor conflicts have exact issue/condition records. Address the listed issue with a sourced resolution and, where supplied, condition dispositions; do not answer the same conflict separately in several products. A no_issue_found item alone clears nothing. Preserve current counterevidence as an open issue, explained alternatives in rationale and independent limits in limitations. Resolution applies to its answering version and descendants; it does not legalize an older driver. Shared semantic issues follow actual dependencies, not checker names.\n\nREPAIR Distinguish review aspect from challenged component. F4 repairs unreached experiment prerequisites. Ordinary technical repair preserves shared property descriptions, events, identities, predicates and legality; it needs no preliminary review or encoding refactor unless an actual dispute/change requires one. Tool, parser and framework failures are not semantic feedback. Executed harness changes require a new artifact, fresh execution and current correspondence. Driver/configuration/initialization repairs name repair_issue_ids, preserve the requirement and oracle, and replace only sourced current premises. Changed observation/oracle encoding uses explicit correction; changed normative meaning/applicability uses F2, and proposition-preserving dependency expansion uses F3. Resolve against the actual changed component, never an unrelated edit. If additional source evidence answers the issue without changing inputs, resolve on that executed version instead of manufacturing a harness rewrite. Remaining issues and the current version's missing correspondence stay visible independently.\nEXECUTION Observe actual implementation effects under explicit inputs, caller policy and authorized isolation. Contract applicability may remain unresolved during exploration; execution permission may not. A changed value or tests_passed is not a violation oracle. Exploration remains construction knowledge: a later requirement needs a separately fixed check, fresh execution and correspondence review, not retroactive relabelling. Missing capability, compilation failure, timeout, panic and a completed property comparison remain distinct. Retain failures; never precompute expected observations or alter protocol behavior to create a finding.\n\nCOMPLETION Initialization, driver compliance and observation validity belong in prerequisites, controls or diagnostics, not duplicate properties. Check a wait's return or record actual attainment when it establishes a necessary premise; when waiting is the investigated behavior, requiring success would discard the failure history. Sleep establishes elapsed time, not synchronization, completion or a coherent snapshot; a printed readiness flag is not a prerequisite witness. A diagnostic control need not satisfy the principal scenario's premises or acquire a separate obligation: select formal applicability from independently declared input/policy fields before execution, retaining control output. Distinct formal scenarios need their actual admission and premises; incompatible histories may need separate checks. Never select scenarios by observed results or missing premises after execution. Role readiness does not imply that earlier work drained. Across preparation, policy changes and delivery, preserve caller/transport duties; prefer one policy-selected delivery path and record the identity, provenance and order needed for attribution. Distinguish receipt, per-message-type queueing and dispatch; preserve the replaced layer's ordering without assuming global FIFO or arbitrary reordering. Legal in-flight work need not be emptied. End controlled work independently of the forbidden behavior. Observe admission, completion and final state for the same operation before treating absence as bounded holds. Missing completion, identity, result events and tool timeout remain unknown. A finite window records non-completion, not a deadline violation or infinite stalling. A repeatable suffix must account for behavior-determining state, schedule, queues, timers and callbacks; equal business fields do not close execution. A rescue stimulus may itself be required caller work.\n\nCORRELATION Monitor.admission_alias explicitly selects the declared harness prerequisite admitting operations whose completion is owed. It is not the first prerequisite by array order. Harness.prerequisites contains prerequisite events only; monitors select independent result events. ObservableProperty.identity_fields declares the stable operation identity once, using fields present at the relevant observation points. Do not repeat a result as a prerequisite or duplicate each identity equality as a Comparison. Reference conditions declare necessary predecessor relationships; unrelated prerequisites have no implicit list order. Assertions may refer to any declared prerequisite alias that actually precedes the result. Missing identity/reference fields or nonunique associations remain unknown. Independent applicability is checked before requiring unrelated history. Alias-dependent applicability follows correlation. Each operation is matched separately. A complete violating witness survives missing results in demonstrably independent operations, while coverage remains partial. Same-witness ambiguity and potentially global parse loss still block attribution. Use independent identity, not the compared value, to associate an input and output. A context expected to change cannot also be an equality filter. More complex histories need actual correlated prerequisites and results; unsupported general temporal expressions remain a stated limitation.\n\nMEANING Distinguish the written obligation, the proposition encoded by applicability/trigger/antecedent/assertion, and what this execution actually compared. Type, count or numeric-position equality may be necessary without establishing content or identity equality. Record comparisons and scope limits separately. Identify live object, copy, cache or caller-maintained observations, their writers and the synchronization or ownership boundary supporting the read; multiple fields must represent the state the proposition needs. Include ownership of injection flags, counters and sampling itself. An export discrepancy need not mean active protocol state changed. Match observation to the claim: stopping may change the behavior; neither shutdown sampling, locks, public APIs, dual reads nor race detection are universally required. Challenge specific unreliable reads, not all concurrent checks. Keep unresolved contracts, counterevidence, input legality and observation differences explicit; CheckRun owns execution status. An implementation/requirement discrepancy is the subject, not a conflict between requirement sources. Real contradictions remain conflicts.\n\nCONFIRMATION Reconstruct decisive relationships from the fixed test, actual constructors/producers and raw events; the plan's legality account is a claim to verify. Check prepared state, substituted calls and identity/context/generation across stages; constructible inputs or isolated fragments do not establish one legal history. Preserve relevant queues, callbacks, lock ownership and caller/transport duties. For waiting, missing replies or retained resources, trace waiter, result/cancel/close producer, normal shutdown entry and the observation's shutdown phase. Verify which owner/caller actually performs cleanup: no local timeout does not prove permanent waiting, and an available Close method does not prove it ran. A direct post-stop handler call differs from production dispatch still reaching it. Sourced local interface or exit duties need no whole-deployment proof. Review oracle, parsing, reached premises and completion together. Use rationale, source_ids, counterevidence, challenged_components and exact ReviewIssues for discrepancies; choose driver repair, encoding or F2/F3 by what changes, never weaken the written responsibility to rescue confirmation. Incompatible inputs are attribution gaps. Local functions, injectable storage, bounded initialization and substitute schedules remain valid when the sourced proposition permits them. Preserve measurements while correspondence is pending; complete local counterexamples survive independent wider-history or endpoint limits. New source counterevidence may challenge prior confirmation; an unobserved wider endpoint remains a limit.\nNECESSITY For S implies E, compare S when independently established E is false, or use equivalent supported implication encoding; never strengthen to S equals E or filter the result through applicability. In a complete implication comparison, observed S=false retains holds but supports only that S did not occur here, not E or universal consistency; S=true actually tests E. Missing results, identity or prerequisites are not observed falsity and cannot supply holds. Do not require every conditional branch to execute before confirming a complete local counterexample, or infer eventual success from a permitted pending control.\n    \"\"\"Extract complete CA_EVENT lines, preserving runner-provided stream ownership.\"\"\"\n    events = []\n    if not check.stdout or not Path(check.stdout).is_file():\n        return events\n\n    marker = \"CA_EVENT \"\n    buffers = {}\n\n    def parse_line(line, stream=None, location=None):\n        if marker not in line:\n            return\n        raw = line.split(marker, 1)[1].strip()\n        provenance = {'stream':stream,'location':location}\n        try:\n            event = json.loads(raw)\n            if not isinstance(event, dict) or not isinstance(event.get(\"event\"), str):\n                raise ValueError(\"Event must be an object with an event name\")\n            if stream is not None:\n                event['_ca_stream'] = stream\n            event['_ca_observation'] = provenance\n            events.append(event)\n        except ValueError as exc:\n            events.append({\"event\":\"invalid_observation\",\"raw\":raw,\"reason\":str(exc),\n                \"_ca_stream\":stream,\"_ca_observation\":provenance})\n\n    for physical, line in enumerate(Path(check.stdout).read_text().splitlines(keepends=True), 1):\n        try:\n            outer = json.loads(line)\n        except (ValueError, TypeError):\n            parse_line(line.rstrip('\\r\\n'), location={'line':physical})\n            continue\n        if not isinstance(outer,dict) or not isinstance(outer.get('Output'),str):\n            continue\n        # Package-level output is a real, separate stream. Never guess that it\n        # belongs to a concurrently reported test stream.\n        stream = json.dumps([outer.get('Package'),outer.get('Test') if 'Test' in outer else None],\n            ensure_ascii=False,separators=(',',':'))\n        buffers[stream] = buffers.get(stream,'') + outer['Output']\n        while '\\n' in buffers[stream]:\n            complete,buffers[stream] = buffers[stream].split('\\n',1)\n            parse_line(complete.rstrip('\\r'),stream,{'line':physical,'stream':stream})\n    for stream,tail in buffers.items():\n        if marker in tail:\n            parse_line(tail,stream,{'line':'end-of-stream','stream':stream})\n    return events\n\"\"\"Finite, non-evaluating event correlation and fully observed safety monitors.\"\"\"\nfrom consensus_assurance.core.events import MISSING, field, compare, match_prerequisites, event_requirements\n\n\ndef monitor_events(events, monitor, prop, requirements=None):\n    \"\"\"Keep existential witnesses separate from completeness of the observed scope.\"\"\"\n    results, missing, correlations, outside, diagnostics = [], [], {}, [], []\n    admission = None\n    admission_dependencies = []\n    admission_error = ''\n    if prop and requirements:\n        try:\n            declared = event_requirements(requirements)\n            admission = next((r for r in declared if r.alias == monitor.admission_alias), None)\n            if admission is None or any(r.event==monitor.event for r in declared):\n                admission_error = 'Explicit admission_alias is missing or prerequisites depend on the result'\n            else:\n                wanted={c.reference.partition('.')[0] for c in admission.conditions if c.reference}\n                for req in reversed(declared):\n                    if req.alias in wanted:wanted.update(c.reference.partition('.')[0] for c in req.conditions if c.reference)\n                admission_dependencies=[r for r in declared if r.alias in wanted]\n        except ValueError as exc:\n            admission_error = str(exc)\n    def gap(index, reason):\n        missing.append(index)\n        diagnostics.append({'event_index':index, 'identity':{k:field(events[index],k)\n            for k in prop.identity_fields if field(events[index],k) is not MISSING}, 'reason':reason})\n    for index, event in enumerate(events):\n        if prop is None or event.get('event') != monitor.event:\n            continue\n        independent = [prop.trigger, *(c for c in monitor.applicability_conditions if not c.reference)]\n        if any(compare(event,c) is False for c in independent):\n            outside.append(index)\n            continue\n        absent = [k for k in prop.identity_fields if field(event,k) is MISSING]\n        absent += [c.field for c in independent if compare(event,c) is None]\n        if absent:\n            gap(index, 'Missing identity or applicability fields: '+', '.join(dict.fromkeys(absent)))\n            continue\n        aliases = {}\n        if requirements is not None:\n            linked = match_prerequisites(events, requirements, index, prop.identity_fields)\n            correlations[str(index)] = linked\n            if linked['status'] != 'matched':\n                gap(index, linked['reason'])\n                continue\n            aliases = {alias:events[i] for alias,i in linked['alias_indices'].items()}\n        applicability = [compare(event,c,aliases) for c in monitor.applicability_conditions if c.reference]\n        if any(value is False for value in applicability):\n            outside.append(index)\n            continue\n        if any(value is None for value in applicability):\n            gap(index, 'Missing alias-dependent applicability fields')\n            continue\n        value = compare(event,prop.assertion,aliases)\n        if prop.kind == 'event_implication':\n            antecedent = compare(event,prop.antecedent,aliases) if prop.antecedent else None\n            value = None if antecedent is None or value is None else not antecedent or value\n        if value is None:\n            gap(index, 'Missing required result fields: '+prop.assertion.field+\n                (' or '+prop.antecedent.field if prop.antecedent else ''))\n        else:\n            results.append((index,value))\n    violations = [index for index,value in results if value is False]\n    # A missing result in the same operation can affect its witness. Unknown\n    # identity is not evidence of independence; distinct runner streams are.\n    def independent_operation(left, right):\n        a, b = events[left], events[right]\n        if a.get('_ca_stream') is not None and b.get('_ca_stream') is not None and a['_ca_stream'] != b['_ca_stream']:\n            return True\n        return any(field(a,k) is not MISSING and field(b,k) is not MISSING\n            and compare(a, type(prop.trigger)(field=k,reference='other.'+k), {'other':b}) is False\n            for k in prop.identity_fields)\n    if admission and not admission_error:\n        for index,event in enumerate(events):\n            if event.get('event') != admission.event:continue\n            if any(compare(event,c) is False for c in admission.conditions if not c.reference):continue\n            aliases={}\n            if admission_dependencies:\n                linked=match_prerequisites(events,admission_dependencies,index,prop.identity_fields)\n                if linked['status']!='matched':\n                    gap(index,'Operation admission history: '+linked['reason'])\n                    continue\n                aliases={alias:events[i] for alias,i in linked['alias_indices'].items()}\n            checks=[compare(event,c,aliases) for c in admission.conditions]\n            if any(v is False for v in checks):continue\n            if any(v is None for v in checks) or any(field(event,k) is MISSING for k in prop.identity_fields):\n                gap(index, 'Missing operation admission fields or identity')\n                continue\n            if not any(r>index and event.get('_ca_stream')==events[r].get('_ca_stream') and\n                    all(field(event,k) is not MISSING and compare(event,type(prop.trigger)(field=k,reference='result.'+k),{'result':events[r]}) is True for k in prop.identity_fields)\n                    and (r in outside or correlations.get(str(r),{}).get('alias_indices',{}).get(admission.alias)==index)\n                    for r in [i for i,_ in results]+outside):\n                gap(index, 'Admitted operation has no complete applicable result observation')\n    valid = [index for index in violations if not admission_error and all(independent_operation(index,m) for m in missing)]\n    complete = bool(results) and not missing and not admission_error\n    limitations = [f\"Event {d['event_index']} {d['identity']}: {d['reason']}\" for d in diagnostics]\n    if admission_error:limitations.append(admission_error)\n    if not results and not missing:\n        limitations.append('No applicable completed result event was reached')\n    return {'monitor_id':monitor.id, 'checker_id':monitor.checker_id,\n        'outcome':'violated' if valid else 'unknown' if missing or not results or admission_error else 'holds',\n        'witness_indices':violations, 'valid_witness_indices':valid, 'witness_complete':bool(valid),\n        'comparison_complete':complete, 'missing_indices':sorted(set(missing)),\n        'evaluated_indices':[index for index,_ in results], 'outside_applicability_indices':outside,\n        'correlations':correlations, 'diagnostics':diagnostics, 'limitations':limitations,\n        'reason':'Independent applicability, correlated prerequisites and fully observed result comparison'}\n","exit_code":0,"status":"completed"}}
