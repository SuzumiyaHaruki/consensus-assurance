ndex++\n../agent-source/storage.go:189:\tms.callStats.firstIndex++\n{\n  \"description\": \"Check C-auto-exit-continuation by comparing exact serialized protocol/storage state at the same schedule phase after transfer abort and after ten fair tick-and-drain iterations. Admission is the actual application of the implicit configuration during transfer. A repeated state with AutoLeave still set is a closed non-exiting suffix, not merely bounded waiting. The full delivery trace and follower heartbeat counts expose the executed suffix.\",\n  \"claim_id\": \"C-auto-exit-continuation\",\n  \"binding_ids\": [\n    \"BIND-auto\",\n    \"BIND-transfer-abort\"\n  ],\n  \"harness\": {\n    \"execution_package\": \".\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"testing\\\"\\n \\\"reflect\\\"\\n \\\"sort\\\"\\n pb \\\"go.etcd.io/raft/v3/raftpb\\\"\\n)\\n\\ntype assuranceCluster struct {\\n t *testing.T\\n nodes map[uint64]*RawNode\\n stores map[uint64]*MemoryStorage\\n queue []pb.Message\\n transfer bool\\n injected bool\\n drops int\\n changeIndex uint64\\n ticks int\\n suffixTrace []string\\n inSuffix bool\\n heartbeatAcks map[uint64]int\\n}\\nfunc assuranceEmit(kind string, fields map[string]interface{}) {\\n fields[\\\"event\\\"] = kind\\n b, err := json.Marshal(fields); if err != nil { panic(err) }\\n fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc assuranceNew(t *testing.T, transfer bool) *assuranceCluster {\\n c := &assuranceCluster{t:t,nodes:map[uint64]*RawNode{},stores:map[uint64]*MemoryStorage{},transfer:transfer,heartbeatAcks:map[uint64]int{}}\\n for id:=uint64(1); id<=3; id++ {\\n  s:=NewMemoryStorage()\\n  if err:=s.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{Index:1,Term:1,ConfState:pb.ConfState{Voters:[]uint64{1,2,3}}}}); err!=nil { t.Fatal(err) }\\n  if err:=s.SetHardState(pb.HardState{Term:1,Commit:1}); err!=nil {t.Fatal(err)}\\n  rn,err:=NewRawNode(&Config{ID:id,ElectionTick:10,HeartbeatTick:1,Storage:s,Applied:1,MaxSizePerMsg:4096,MaxInflightMsgs:16,CheckQuorum:true,PreVote:true})\\n  if err!=nil {t.Fatal(err)}\\n  c.nodes[id]=rn;c.stores[id]=s\\n }\\n return c\\n}\\nfunc(c *assuranceCluster) drain() {\\n for step:=0;step<10000;step++ {\\n  work:=false\\n  for id:=uint64(1);id<=3;id++ {\\n   rn:=c.nodes[id];s:=c.stores[id]\\n   if !rn.HasReady(){continue};work=true\\n   rd:=rn.Ready()\\n   if !IsEmptySnap(rd.Snapshot){if err:=s.ApplySnapshot(rd.Snapshot);err!=nil{c.t.Fatal(err)}}\\n   if err:=s.Append(rd.Entries);err!=nil{c.t.Fatal(err)}\\n   if !IsEmptyHardState(rd.HardState){if err:=s.SetHardState(rd.HardState);err!=nil{c.t.Fatal(err)}}\\n   // Queue only after the corresponding persistence work, and deliver FIFO.\\n   c.queue=append(c.queue,rd.Messages...)\\n   for _,ent:=range rd.CommittedEntries {\\n    switch ent.Type {\\n    case pb.EntryConfChangeV2:\\n     var cc pb.ConfChangeV2;if err:=cc.Unmarshal(ent.Data);err!=nil{c.t.Fatal(err)}\\n     if id==1 && len(cc.Changes)>0 {\\n      c.changeIndex=ent.Index\\n      if c.transfer && !c.injected {\\n       rn.TransferLeader(2);c.injected=true\\n       assuranceEmit(\\\"transfer_started\\\",map[string]interface{}{\\\"index\\\":ent.Index,\\\"term\\\":rn.raft.Term,\\\"target\\\":rn.raft.leadTransferee})\\n      }\\n     }\\n     cs:=rn.ApplyConfChange(cc)\\n     if id==1 && len(cc.Changes)>0 { assuranceEmit(\\\"admitted\\\",map[string]interface{}{\\\"op_id\\\":\\\"implicit-remove-3\\\",\\\"node\\\":1,\\\"change_index\\\":ent.Index,\\\"entry_term\\\":ent.Term,\\\"term\\\":rn.raft.Term,\\\"auto_leave\\\":cs.AutoLeave,\\\"target\\\":rn.raft.leadTransferee,\\\"policy\\\":\\\"drop_timeout_now\\\",\\\"role\\\":rn.raft.state.String()}) }\\n     if id==1 {assuranceEmit(\\\"configuration_applied\\\",map[string]interface{}{\\\"index\\\":ent.Index,\\\"term\\\":rn.raft.Term,\\\"auto_leave\\\":cs.AutoLeave,\\\"outgoing\\\":cs.VotersOutgoing,\\\"transfer\\\":rn.raft.leadTransferee})}\\n    case pb.EntryConfChange:\\n     var cc pb.ConfChange;if err:=cc.Unmarshal(ent.Data);err!=nil{c.t.Fatal(err)};rn.ApplyConfChange(cc)\\n    }\\n   }\\n   rn.Advance(rd)\\n  }\\n  if len(c.queue)>0 {\\n   work=true;m:=c.queue[0];c.queue=c.queue[1:]\\n   // The transport policy is chosen before execution, not from observed failure.\\n   if c.transfer && m.Type==pb.MsgTimeoutNow {\\n    c.drops++;assuranceEmit(\\\"transport_drop\\\",map[string]interface{}{\\\"type\\\":m.Type.String(),\\\"from\\\":m.From,\\\"to\\\":m.To,\\\"term\\\":m.Term})\\n   } else if n:=c.nodes[m.To];n!=nil {\\n    if c.inSuffix { b,err:=json.Marshal(m);if err!=nil{c.t.Fatal(err)};c.suffixTrace=append(c.suffixTrace,string(b));if m.Type==pb.MsgHeartbeatResp && m.To==1 {c.heartbeatAcks[m.From]++} }\\n    if err:=n.Step(m);err!=nil && err!=ErrStepPeerNotFound {c.t.Fatal(err)}\\n   } else {c.t.Fatalf(\\\"unknown destination %d\\\",m.To)}\\n  }\\n  if !work{return}\\n }\\n c.t.Fatal(\\\"driver did not drain within operation bound\\\")\\n}\\nfunc(c *assuranceCluster) observe(phase string) {\\n r:=c.nodes[1].raft\\n ready:=false;unstable:=0;localMessages:=0\\n for _,n:=range c.nodes {ready=ready||n.HasReady();unstable+=len(n.raft.raftLog.unstable.entries);localMessages+=len(n.raft.msgs)+len(n.raft.msgsAfterAppend)+len(n.stepsOnAdvance)}\\n assuranceEmit(\\\"observation\\\",map[string]interface{}{\\\"phase\\\":phase,\\\"transfer_policy\\\":c.transfer,\\\"ticks\\\":c.ticks,\\\"term\\\":r.Term,\\\"role\\\":r.state.String(),\\\"change_index\\\":c.changeIndex,\\\"last\\\":r.raftLog.lastIndex(),\\\"committed\\\":r.raftLog.committed,\\\"applied\\\":r.raftLog.applied,\\\"applying\\\":r.raftLog.applying,\\\"auto_leave\\\":r.trk.AutoLeave,\\\"outgoing\\\":r.trk.ConfState().VotersOutgoing,\\\"transferee\\\":r.leadTransferee,\\\"pending_conf\\\":r.pendingConfIndex,\\\"queue\\\":len(c.queue),\\\"local_messages\\\":localMessages,\\\"unstable\\\":unstable,\\\"has_ready\\\":ready,\\\"timeout_drops\\\":c.drops})\\n}\\n\\n// Capture protocol state without invoking String methods or mutating target values.\\n// The only exclusions are IO/logging diagnostics and the duplicate Storage interface.\\n// MemoryStorage content is included separately; all access is on this test goroutine.\\nfunc assuranceValue(v reflect.Value) interface{} {\\n if !v.IsValid(){return nil}\\n switch v.Kind(){\\n case reflect.Interface,reflect.Pointer:\\n  if v.IsNil(){return nil};return assuranceValue(v.Elem())\\n case reflect.Struct:\\n  out:=map[string]interface{}{}\\n  for i:=0;i<v.NumField();i++ {\\n   name:=v.Type().Field(i).Name\\n   switch name {case \\\"logger\\\",\\\"traceLogger\\\",\\\"storage\\\",\\\"Mutex\\\",\\\"callStats\\\":continue}\\n   out[name]=assuranceValue(v.Field(i))\\n  };return out\\n case reflect.Slice:\\n  if v.IsNil(){return nil}\\n  a:=make([]interface{},v.Len());for i:=range a{a[i]=assuranceValue(v.Index(i))}\\n  return map[string]interface{}{\\\"capacity\\\":v.Cap(),\\\"values\\\":a}\\n case reflect.Array:\\n  a:=make([]interface{},v.Len());for i:=range a{a[i]=assuranceValue(v.Index(i))};return a\\n case reflect.Map:\\n  if v.IsNil(){return nil}\\n  keys:=v.MapKeys();sort.Slice(keys,func(i,j int)bool{return assuranceKey(keys[i])<assuranceKey(keys[j])})\\n  a:=make([]interface{},0,len(keys));for _,k:=range keys{a=append(a,[]interface{}{assuranceValue(k),assuranceValue(v.MapIndex(k))})};return a\\n case reflect.Bool:return v.Bool()\\n case reflect.String:return v.String()\\n case reflect.Int,reflect.Int8,reflect.Int16,reflect.Int32,reflect.Int64:return v.Int()\\n case reflect.Uint,reflect.Uint8,reflect.Uint16,reflect.Uint32,reflect.Uint64,reflect.Uintptr:return v.Uint()\\n case reflect.Func:\\n  if v.IsNil(){return nil};return fmt.Sprintf(\\\"function-code:%x\\\",v.Pointer())\\n default:panic(fmt.Sprintf(\\\"unsupported captured state %s\\\",v.Type()))\\n }\\n}\\nfunc assuranceKey(v reflect.Value)string {b,e:=json.Marshal(assuranceValue(v));if e!=nil{panic(e)};return string(b)}\\nfunc(c *assuranceCluster) state()string {\\n // Driver counters and observations cannot influence future delivery or protocol work.\\n // The suffix schedule is fixed: tick 1,2,3, then drain; compare at its boundary.\\n nodes:=map[uint64]interface{}{};stores:=map[uint64]interface{}{}\\n for id:=uint64(1);id<=3;id++ {nodes[id]=assuranceValue(reflect.ValueOf(c.nodes[id]));stores[id]=assuranceValue(reflect.ValueOf(c.stores[id]))}\\n out:=map[string]interface{}{\\\"nodes\\\":nodes,\\\"stores\\\":stores,\\\"queue\\\":assuranceValue(reflect.ValueOf(c.queue)),\\\"transfer_policy\\\":c.transfer,\\\"injected\\\":c.injected,\\\"change_index\\\":c.changeIndex,\\\"schedule_phase\\\":\\\"before_tick_1\\\"}\\n b,e:=json.Marshal(out);if e!=nil{c.t.Fatal(e)};return string(b)\\n}\\nfunc(c *assuranceCluster) resultFields()map[string]interface{} {\\n r:=c.nodes[1].raft;pending:=0;ready:=false\\n for _,n:=range c.nodes{pending+=len(n.raft.msgs)+len(n.raft.msgsAfterAppend)+len(n.stepsOnAdvance);ready=ready||n.HasReady()}\\n return map[string]interface{}{\\\"policy\\\":\\\"drop_timeout_now\\\",\\\"op_id\\\":\\\"implicit-remove-3\\\",\\\"node\\\":1,\\\"change_index\\\":c.changeIndex,\\\"term\\\":r.Term,\\\"role\\\":r.state.String(),\\\"target\\\":r.leadTransferee,\\\"auto_leave\\\":r.trk.AutoLeave,\\\"outgoing_count\\\":len(r.trk.Voters[1]),\\\"last\\\":r.raftLog.lastIndex(),\\\"committed\\\":r.raftLog.committed,\\\"applied\\\":r.raftLog.applied,\\\"applying\\\":r.raftLog.applying,\\\"queue_count\\\":len(c.queue),\\\"local_messages\\\":pending,\\\"has_ready\\\":ready,\\\"ticks\\\":c.ticks,\\\"timeout_drops\\\":c.drops,\\\"state\\\":c.state()}\\n}\\nfunc(c *assuranceCluster) tickAll(){\\n for id:=uint64(1);id<=3;id++{c.nodes[id].Tick()};c.ticks++;c.drain()\\n}\\nfunc TestAssuranceAutoExitCycle(t *testing.T){\\n c:=assuranceNew(t,true)\\n if StateTraceDeployed {t.Fatal(\\\"this check requires the default no-op trace build\\\")}\\n if err:=c.nodes[1].Campaign();err!=nil{t.Fatal(err)};c.drain()\\n if c.nodes[1].raft.state!=StateLeader{t.Fatal(\\\"campaign did not establish leader\\\")}\\n cc:=pb.ConfChangeV2{Transition:pb.ConfChangeTransitionJointImplicit,Changes:[]pb.ConfChangeSingle{{Type:pb.ConfChangeRemoveNode,NodeID:3}}}\\n if err:=c.nodes[1].ProposeConfChange(cc);err!=nil{t.Fatal(err)};c.drain()\\n if !c.injected || c.changeIndex==0 {t.Fatal(\\\"configuration and transfer prefix not reached\\\")}\\n c.observe(\\\"after_apply\\\")\\n for i:=0;i<10;i++{c.tickAll()}\\n startState:=c.state()\\n assuranceEmit(\\\"cycle_start\\\",c.resultFields())\\n c.inSuffix=true\\n for i:=0;i<10;i++{c.tickAll()}\\n c.inSuffix=false\\n out:=c.resultFields();out[\\\"cycle_repeats\\\"]=out[\\\"state\\\"].(string)==startState;out[\\\"heartbeat_acks_2\\\"]=c.heartbeatAcks[2];out[\\\"heartbeat_acks_3\\\"]=c.heartbeatAcks[3]\\n out[\\\"delivery_trace\\\"]=c.suffixTrace\\n assuranceEmit(\\\"cycle_result\\\",out)\\n}\\n\",\n    \"description\": \"Single-threaded RawNode harness using actual emitted messages and MemoryStorage; direct read-only reflection captures all RawNode/raft/log/tracker fields and MemoryStorage data at drained boundaries. No target implementation is replaced.\",\n    \"semantic_changes\": [\n      \"No target code edits or behavior instrumentation. Controlled FIFO network may drop TimeoutNow only.\",\n      \"One public TransferLeader call is interleaved after committed configuration delivery and before ApplyConfChange/Advance.\",\n      \"Reflection records unexported state without invoking methods; excludes logger/traceLogger, duplicate Storage interface, MemoryStorage mutex and call statistics. MemoryStorage contents are captured separately. Function code identities are recorded; bound raft owner is the same node throughout.\",\n      \"Nil versus empty maps/slices and slice capacities are preserved; map entries are canonicalized by key. Pointer allocation addresses are omitted because the suffix does not branch on them.\",\n      \"Clock, driver diagnostic counters and recorded output are not fed back to protocol. The fixed schedule phase, transport policy, injected flag, operation identity and queue are captured.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": \"drop_timeout_now\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"auto_leave\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"target\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"role\",\n            \"op\": \"eq\",\n            \"value\": \"StateLeader\",\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"start\",\n        \"event\": \"cycle_start\",\n        \"conditions\": [\n          {\n            \"field\": \"term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"admitted.term\"\n          },\n          {\n            \"field\": \"target\",\n            \"op\": \"eq\",\n            \"value\": 0,\n            \"reference\": null\n          },\n          {\n            \"field\": \"role\",\n            \"op\": \"eq\",\n            \"value\": \"StateLeader\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"queue_count\",\n            \"op\": \"eq\",\n            \"value\": 0,\n            \"reference\": null\n          },\n          {\n            \"field\": \"local_messages\",\n            \"op\": \"eq\",\n            \"value\": 0,\n            \"reference\": null\n          },\n          {\n            \"field\": \"has_ready\",\n            \"op\": \"eq\",\n            \"value\": false,\n            \"reference\": null\n          },\n          {\n            \"field\": \"ticks\",\n            \"op\": \"eq\",\n            \"value\": 10,\n            \"reference\": null\n          },\n          {\n            \"field\": \"timeout_drops\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-auto\",\n        \"S-proposal\",\n        \"S-tick-transfer\",\n        \"S-abort\",\n        \"S-ready\",\n        \"S-advance\",\n        \"S-node-apply-contract\",\n        \"S-raw-boundary\",\n        \"S-storage\",\n        \"S-init\",\n        \"S-retry\",\n        \"S-ack\",\n        \"S-follow\",\n        \"S-state-raft\",\n        \"S-state-log\",\n        \"S-state-unstable\",\n        \"S-state-tracker\",\n        \"S-state-progress\",\n        \"S-state-inflight\",\n        \"S-heartbeat-send\",\n        \"S-trace-default\"\n      ],\n      \"expectation_ids\": [\n        \"S-joint-contract\",\n        \"S-joint-duty\"\n      ],\n      \"binding_ids\": [\n        \"BIND-auto\",\n        \"BIND-transfer-abort\"\n      ],\n      \"derivation\": \"Initialize three MemoryStorage instances with the same index-1/term-1 snapshot and voters 1,2,3, HardState commit=1 and Applied=1, following recommended snapshot bootstrap. Campaign through public RawNode and deliver actual messages. Propose JointImplicit removal of 3; when leader receives that committed entry in Ready, request transfer to 2 before applying and advancing the entry. This preserves the investigated overlap. Process each Ready synchronously: persist, queue messages, apply configuration, Advance. FIFO transport drops only genuine MsgTimeoutNow according to the policy chosen before the run. No source state is altered. Tick all three nodes, drain all Ready and messages, observe after ten ticks and again after ten more. The latter ten-step schedule is indefinitely repeatable if behavior state repeats; no exit deadline is inferred from its length.\",\n      \"applicability\": \"Implicit joint removal committed and applied while transfer suppresses exit proposal; transfer then aborts; fixed fair tick/delivery suffix with no further client proposals.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"A later client proposal or successful election can resume automatic exit; neither is a duty of this suffix.\",\n        \"Compared with exploration, all three nodes are ticked in the suffix, preserving activity of the outgoing voter; this strengthens fairness without excluding transfer-time rejection.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-auto-exit-cycle\",\n      \"checker_id\": \"P-no-pending-cycle\",\n      \"event\": \"cycle_result\",\n      \"binding_ids\": [\n        \"BIND-auto\",\n        \"BIND-transfer-abort\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-auto\",\n          \"S-proposal\",\n          \"S-tick-transfer\",\n          \"S-abort\",\n          \"S-ready\",\n          \"S-advance\",\n          \"S-node-apply-contract\",\n          \"S-raw-boundary\",\n          \"S-storage\",\n          \"S-init\",\n          \"S-retry\",\n          \"S-ack\",\n          \"S-follow\",\n          \"S-state-raft\",\n          \"S-state-log\",\n          \"S-state-unstable\",\n          \"S-state-tracker\",\n          \"S-state-progress\",\n          \"S-state-inflight\",\n          \"S-heartbeat-send\",\n          \"S-trace-default\"\n        ],\n        \"expectation_ids\": [\n          \"S-joint-contract\",\n          \"S-joint-duty\"\n        ],\n        \"binding_ids\": [\n          \"BIND-auto\",\n          \"BIND-transfer-abort\"\n        ],\n        \"derivation\": \"The result cycle_repeats is computed from the actual captured start and end state strings, both retained in raw events for reconstruction. The implication antecedent inspects that result boolean; the consequent requires AutoLeave=false. No expected state is precomputed. Healthy delivery and state projection completeness require correspondence against the source and raw trace.\",\n        \"applicability\": \"Implicit joint removal committed and applied while transfer suppresses exit proposal; transfer then aborts; fixed fair tick/delivery suffix with no further client proposals.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"A later client proposal or successful election can resume automatic exit; neither is a duty of this suffix.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"policy\",\n          \"op\": \"eq\",\n          \"value\": \"drop_timeout_now\",\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"P-no-pending-cycle\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"policy\",\n        \"op\": \"eq\",\n        \"value\": \"drop_timeout_now\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"auto_leave\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"cycle_repeats\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"op_id\",\n        \"node\",\n        \"change_index\"\n      ],\n      \"description\": \"For the admitted automatic-exit operation after transfer abort, identical protocol/storage/queue state after one full fair suffix implies the automatic joint state cannot remain pending. If state differs, this finite comparison only excludes this cycle witness; it does not establish eventual exit.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Fresh execution must establish the encoded observations; local compilation is not Evidence.\",\n    \"Repeatability depends on the source-supported exclusion of logging, storage call statistics, mutex internals, pointer allocation identities and the global election RNG. The suffix never reaches an election or reset; randomized timeout fields are included and follower elapsed time is reset by each heartbeat.\",\n    \"Exact endpoint comparison alone would be insufficient under hidden callbacks or asynchronous IO; this harness deliberately uses serialized RawNode, synchronous MemoryStorage and completed Advance, with no external goroutines or callbacks.\",\n    \"This single legal history does not cover every configuration, async IO mode, successful transfer or endpoint application.\"\n  ]\n}","exit_code":0,"status":"completed"}}
