{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > make_formal.py <<'PY'\nfrom pathlib import Path\np=Path('explore_notify.rs').read_text()\np=p.replace('struct Runtime;','struct Runtime;\\\\nstatic ACTOR: std::sync::Mutex<Option<tokio::task::JoinHandle<()>>> = std::sync::Mutex::new(None);')\np=p.replace('type JoinHandle = tokio::task::JoinHandle<()>;','type JoinHandle = ();')\np=p.replace('{ tokio::spawn(f) }','{ *ACTOR.lock().unwrap() = Some(tokio::spawn(f)); }')\np=p.replace('q.extend(v);','for m in v { println\"'!(\"TRACE emitted {:?}\", m); q.push_back(m); }'\"')\np=p.replace('let to=m.get_receiver() as usize-1;', 'println\"'!(\"TRACE route {:?}\",m);let to=m.get_receiver() as usize-1;'\"')\np=p.replace('async fn investigate_notification_after_replacement()', 'async fn check_notification_identity_after_replacement()')\np=p.replace('    let mut dropped=0;', '''    let mut dropped=0;\n    let requested_value=101u64;''')\np=p.replace('            let m=out.recv().await.unwrap();','            let m=out.recv().await.unwrap();\\\\n            println\"'!(\"TRACE partition_drop {:?}\",m);'\"')\np=p.replace('    // Nodes 2 and 3 form', '''    println\"'!(\"CA_EVENT {{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"admitted\\\\\\\\\\\",\\\\\\\\\\\"scenario\\\\\\\\\\\":\\\\\\\\\\\"replacement\\\\\\\\\\\",\\\\\\\\\\\"operation\\\\\\\\\\\":\\\\\\\\\\\"notify-A\\\\\\\\\\\",\\\\\\\\\\\"requested_value\\\\\\\\\\\":{},\\\\\\\\\\\"origin\\\\\\\\\\\":1,\\\\\\\\\\\"admitted\\\\\\\\\\\":true}}\\\", requested_value);\n    // Nodes 2 and 3 form''')\np=p.replace('while let Ok(m)=out.try_recv(){q.push_back(m);}','while let Ok(m)=out.try_recv(){println\"'!(\"TRACE actor_emitted {:?}\",m);q.push_back(m);}'\"')\nstart=p.index('    let result=tokio::time::timeout(Duration::from_secs(15),call)')\np=p[:start]+'''    // Keep the healed transport and raw-node clocks serviced until the actor\n    // returns. Completion is read before shutdown; a wait failure is not a result.\n    let raw_clock=tokio::time::sleep(Duration::from_secs(10));\n    tokio::pin\"'!(raw_clock);\n    tokio::time::timeout(Duration::from_secs(15),async {\n        loop {\n            while let Ok(m)=out.try_recv(){println!(\"TRACE actor_emitted {:?}\",m);q.push_back(m);}\n            take_raw(&mut nodes,&mut q);\n            while let Some(m)=q.pop_front(){\n                println!(\"TRACE route {:?}\",m);\n                let to=m.get_receiver() as usize-1;\n                if to==0 {h.handle_incoming(m).await;} else {nodes[to].as_mut().unwrap().handle_incoming(m);}\n            }\n            if call.is_finished(){break;}\n            tokio::select! {\n                _=&mut raw_clock=>{\n                    for n in nodes.iter_mut().flatten(){n.tick();}\n                    raw_clock.as_mut().reset(tokio::time::Instant::now()+Duration::from_secs(10));\n                }\n                _=tokio::time::sleep(Duration::from_millis(1))=>{}\n            }\n        }\n    }).await.expect(\"notification must return a result within observation bound\");\n    let result=call.await.unwrap();\n    let (ok,returned_index,error)=match result {\n        Ok(idx)=>(true,idx,\"none\"),\n        Err(omnipaxos_runtime::AppendError::Superseded{..})=>(false,0,\"superseded\"),\n        Err(omnipaxos_runtime::AppendError::Timeout)=>(false,0,\"timeout\"),\n        Err(omnipaxos_runtime::AppendError::Shutdown)=>(false,0,\"shutdown\"),\n        Err(_)=>(false,0,\"other\"),\n    };\n    // All state reads are actor commands. No caller writes log values, injects\n    // ballots/messages, or samples mutable protocol fields concurrently.\n    let final_decided=h.decided_idx().await;\n    let final_read=h.read_decided_suffix(0).await.unwrap();\n    let final_values:Vec<u64>=final_read.iter().filter_map(|e|match e{LogEntry::Decided(v)=>Some(v.0),_=>None}).collect();\n    // accepted_idx/decided_idx and runtime assignments are exclusive boundaries:\n    // the assigned first entry has return value 1 and core read position 0.\n    let actual_value=returned_index.checked_sub(1).and_then(|i|final_values.get(i)).map(|v|*v as i64).unwrap_or(-1);\n    println!(\"CA_EVENT {{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"result\\\\\\\\\\\",\\\\\\\\\\\"scenario\\\\\\\\\\\":\\\\\\\\\\\"replacement\\\\\\\\\\\",\\\\\\\\\\\"operation\\\\\\\\\\\":\\\\\\\\\\\"notify-A\\\\\\\\\\\",\\\\\\\\\\\"completed\\\\\\\\\\\":true,\\\\\\\\\\\"ok\\\\\\\\\\\":{},\\\\\\\\\\\"returned_index\\\\\\\\\\\":{},\\\\\\\\\\\"error\\\\\\\\\\\":\\\\\\\\\\\"{}\\\\\\\\\\\",\\\\\\\\\\\"actual_value\\\\\\\\\\\":{},\\\\\\\\\\\"decided_idx\\\\\\\\\\\":{},\\\\\\\\\\\"decided_values\\\\\\\\\\\":{:?}}}\\\",ok,returned_index,error,actual_value,final_decided,final_values);\n    drop(h);\n    drop(out);\n    let join=ACTOR.lock().unwrap().take().unwrap();\n    tokio::time::timeout(Duration::from_secs(2),join).await.expect(\\\"actor shutdown\\\").expect(\\\"actor did not panic\\\");\n    println\"'!(\"CA_EVENT {{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"cleanup\\\\\\\\\\\",\\\\\\\\\\\"actor_joined\\\\\\\\\\\":true}}\\\");\n}\n'''\nPath('check_notify.rs').write_text(p)\nPY\npython3 make_formal.py\npython3 - <<'PY'\nimport json\nr=json.load(open('../research.json'));q=r['candidates'][0]['question'];q.pop('audit_spec_version',None)\nq['disposition']='ready_for_check';q['unknowns']=['Fresh fixed execution and correspondence must establish the property comparison; exploration observations are construction knowledge only.']\nsources=q['source_ids']\nclaim=dict(id='C-notify-identity',kind='obligation',concern='implementation_semantics',description='For a pending append_notify operation in an uncompacted log, an Ok(k) completion must refer to the submitted entry at the assigned decided position. A later ballot deciding a different entry at that position must not certify the original operation as successful.',source_ids=['M-runtime-contract','M-runtime-errors','M-actor','M-log-doc'],scope=dict(description='Async actor append_notify identity consumption across core authority transitions, one fixed three-member configuration, MemoryStorage, unbatched and uncompacted entries, no restarts or Byzantine behavior.',assumptions=['Caller routes authentic emitted messages to their intended nodes; finite partition loss is permitted and reconnection callbacks are supplied.','Actor runs on the provided AsyncRuntime contract with finite periodic real-time sleeps; caller services transport and reads decisions.'],excluded=['Crash durability','Global linearizability beyond this completion relation','Exactly-once retry behavior','Progress deadline guarantee','Compacted, batched and reconfiguration variants']),pending=[],grounding=dict(source_ids=['M-actor','M-storage-read'],expectation_ids=['M-runtime-contract','M-runtime-errors','M-log-doc'],derivation='append_notify explicitly awaits its entry\\\\'s decided index. Its Superseded documentation permits conservative error when the original entry may survive; it does not authorize successful completion for a different entry. Decided content is stable under the core log contract. Assignment index is the accepted exclusive boundary, so position k-1 is checked in an uncompacted log.',applicability='One actually admitted operation and its own future; success is the implication antecedent, not an admission filter.',unresolved=[],conflicts=[],alternatives=['Superseded or another error is not a false success and therefore satisfies the bounded implication only.']))\nbinding=dict(id='BND-notify',material_id='M-actor',symbol='drain_notifiers',start_line=201,end_line=222,description='Consumes Pending.assigned and local decided index to complete append_notify, with success before supersession.',pending=[],associations=[dict(claim_id='C-notify-identity',source_ids=['M-runtime-contract','M-runtime-errors'],rationale='The runtime completion consumer implements the public entry-specific notification contract.')],anchor=dict(material_id='M-actor',symbol='drain_notifiers',start_line=201,end_line=222,kind='declaration',boundary_complete=True,source_ids=['M-actor']))\nground=dict(source_ids=['M-actor','M-runtime-io','M-storage-read'],expectation_ids=['M-runtime-contract','M-runtime-errors'],binding_ids=['BND-notify'],derivation='admitted is emitted after authentic AcceptDecide messages demonstrate acceptance of the only notify call, while its future remains pending and local decided index is zero. The result joins that exact future and then reads actor-owned decided contents through the read command. Operation/scenario identity is independent of compared content and changing ballot. actual_value is read at returned_index-1; -1 denotes no such entry and differs from the positive input domain.',applicability='Single unbatched, uncompacted operation with real message history and no concurrent application proposals after replacement.',unresolved=[],conflicts=[],alternatives=['An error is completed but does not assert that the submitted value was decided.'])\nplan=dict(description='Isolate the old leader\\\\'s sole unchosen entry, form a new quorum on the other two nodes, decide a different value, then heal through documented reconnect callbacks and genuine Prepare/AcceptSync before the next origin actor notification tick. Observe the exact original future and decided entry content after completion.',claim_id='C-notify-identity',binding_ids=['BND-notify'],harness=dict(kind='rust_test',execution_package='omnipaxos_runtime',source='',files={},description='Public API integration test; raw core setup followed by one actor owner and two synchronous core peers. All protocol messages are emitted by target code. TRACE lines retain packet provenance and ordered routing; CA_EVENT lines retain admission and result.',semantic_changes=['No target behavior modifications. Test transport partitions node 1 and later heals; time configuration uses 10-second ticks and 1ms egress to allow legal incoming processing between notifier ticks.','Test AsyncRuntime delegates spawning and sleep to tokio; keeps actor join handle for observed shutdown. Core peers are synchronously driven and their clocks/transport serviced during result wait.'],prerequisites=[dict(alias='admission',event='admitted',conditions=[dict(field='admitted',op='eq',value=True),dict(field='scenario',op='eq',value='replacement')])],legality=dict(source_ids=sources+['M-memory-storage','M-runtime-trait'],expectation_ids=['M-runtime-contract','M-runtime-io','M-runtime-trait','M-network-doc'],binding_ids=['BND-notify'],derivation='Initial synchronous cluster is prepared by try_become_leader and complete authentic-message delivery. Same node-1 instance is moved into spawn_actor with no reconstruction or state editing. Its A acceptance messages are dropped during partition, so only node 1 has A. Node 2 manually attempts leadership through the public API, obtains node-3 promise and acceptance, and decides B at the vacant first position. On healing, reconnected callbacks generate genuine recovery traffic; streams are drained in emission order without fabricated or duplicate messages. Within each directed link, remaining packets preserve order; old packets dropped by partition are never replayed. Actor read commands confirm installation of B before notifier evaluation. Actor has one mutable owner; result is joined and read before handles drop, then actor shutdown is awaited.',applicability='One captured crate with original manifests/dependencies; no injected protocol internals, altered sources, crashes, snapshots or batching. Real timers need only allow this finite legal interleaving; no protocol numeric deadline is inferred.',unresolved=[],conflicts=[],alternatives=['A tick observing the new ballot before decision would return Superseded. This check intentionally permits incoming Prepare and AcceptSync between ticks, as the actor loop does.'])),monitors=[dict(id='MON-notify',checker_id='CHK-notify',event='result',binding_id