{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba ../agent-source/omnipaxos/src/sequence_paxos/leader.rs | head -300; nl -ba ../agent-source/omnipaxos/src/sequence_paxos/follower.rs | head -320'","aggregated_output":"     1\tuse super::super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    util::{LeaderState, PromiseMetaData},\n     4\t};\n     5\tuse crate::util::{AcceptedMetaData, WRITE_ERROR_MSG};\n     6\t\n     7\tuse super::*;\n     8\t\n     9\timpl<T, B> SequencePaxos<T, B>\n    10\twhere\n    11\t    T: Entry,\n    12\t    B: Storage<T>,\n    13\t{\n    14\t    /// Handle a new leader. Should be called when the leader election has elected a new leader with the ballot `n`\n    15\t    /*** Leader ***/\n    16\t    pub(crate) fn handle_leader(&mut self, n: Ballot) {\n    17\t        if n <= self.leader_state.n_leader || n <= self.internal_storage.get_promise() {\n    18\t            return;\n    19\t        }\n    20\t        #[cfg(feature = \"logging\")]\n    21\t        debug!(self.logger, \"Newly elected leader: {:?}\", n);\n    22\t        if self.pid == n.pid {\n    23\t            self.leader_state =\n    24\t                LeaderState::with(n, self.leader_state.max_pid, self.leader_state.quorum);\n    25\t            // Flush any pending writes\n    26\t            // Don't have to handle flushed entries here because we will sync with followers\n    27\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    28\t            self.internal_storage.set_promise(n).expect(WRITE_ERROR_MSG);\n    29\t            /* insert my promise */\n    30\t            let na = self.internal_storage.get_accepted_round();\n    31\t            let decided_idx = self.get_decided_idx();\n    32\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    33\t            let my_promise = Promise {\n    34\t                n,\n    35\t                n_accepted: na,\n    36\t                decided_idx,\n    37\t                accepted_idx,\n    38\t                log_sync: None,\n    39\t            };\n    40\t            self.leader_state.set_promise(my_promise, self.pid, true);\n    41\t            /* initialise longest chosen sequence and update state */\n    42\t            self.state = (Role::Leader, Phase::Prepare);\n    43\t            let prep = Prepare {\n    44\t                n,\n    45\t                decided_idx,\n    46\t                n_accepted: na,\n    47\t                accepted_idx,\n    48\t            };\n    49\t            /* send prepare */\n    50\t            for pid in &self.peers {\n    51\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    52\t                    from: self.pid,\n    53\t                    to: *pid,\n    54\t                    msg: PaxosMsg::Prepare(prep),\n    55\t                }));\n    56\t            }\n    57\t        } else {\n    58\t            self.become_follower();\n    59\t        }\n    60\t    }\n    61\t\n    62\t    pub(crate) fn become_follower(&mut self) {\n    63\t        self.state.0 = Role::Follower;\n    64\t    }\n    65\t\n    66\t    pub(crate) fn handle_preparereq(&mut self, prepreq: PrepareReq, from: NodeId) {\n    67\t        #[cfg(feature = \"logging\")]\n    68\t        debug!(self.logger, \"Incoming message PrepareReq from {}\", from);\n    69\t        if self.state.0 == Role::Leader && prepreq.n <= self.leader_state.n_leader {\n    70\t            self.leader_state.reset_promise(from);\n    71\t            self.leader_state.set_latest_accept_meta(from, None);\n    72\t            self.send_prepare(from);\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub(crate) fn handle_forwarded_proposal(&mut self, mut entries: Vec<T>) {\n    77\t        if !self.accepted_reconfiguration() {\n    78\t            match self.state {\n    79\t                (Role::Leader, Phase::Prepare) => self.buffered_proposals.append(&mut entries),\n    80\t                (Role::Leader, Phase::Accept) => self.accept_entries_leader(entries),\n    81\t                _ => self.forward_proposals(entries),\n    82\t            }\n    83\t        }\n    84\t    }\n    85\t\n    86\t    pub(crate) fn handle_forwarded_stopsign(&mut self, ss: StopSign) {\n    87\t        if self.accepted_reconfiguration() {\n    88\t            return;\n    89\t        }\n    90\t        match self.state {\n    91\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n    92\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n    93\t            _ => self.forward_stopsign(ss),\n    94\t        }\n    95\t    }\n    96\t\n    97\t    pub(crate) fn send_prepare(&mut self, to: NodeId) {\n    98\t        let prep = Prepare {\n    99\t            n: self.leader_state.n_leader,\n   100\t            decided_idx: self.internal_storage.get_decided_idx(),\n   101\t            n_accepted: self.internal_storage.get_accepted_round(),\n   102\t            accepted_idx: self.internal_storage.get_accepted_idx(),\n   103\t        };\n   104\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   105\t            from: self.pid,\n   106\t            to,\n   107\t            msg: PaxosMsg::Prepare(prep),\n   108\t        }));\n   109\t    }\n   110\t\n   111\t    pub(crate) fn accept_entry_leader(&mut self, entry: T) {\n   112\t        let accepted_metadata = self\n   113\t            .internal_storage\n   114\t            .append_entry_with_batching(entry)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        if let Some(metadata) = accepted_metadata {\n   117\t            self.leader_state\n   118\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   119\t            self.send_acceptdecide(metadata);\n   120\t        }\n   121\t    }\n   122\t\n   123\t    pub(crate) fn accept_entries_leader(&mut self, entries: Vec<T>) {\n   124\t        let accepted_metadata = self\n   125\t            .internal_storage\n   126\t            .append_entries_with_batching(entries)\n   127\t            .expect(WRITE_ERROR_MSG);\n   128\t        if let Some(metadata) = accepted_metadata {\n   129\t            self.leader_state\n   130\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   131\t            self.send_acceptdecide(metadata);\n   132\t        }\n   133\t    }\n   134\t\n   135\t    pub(crate) fn accept_stopsign_leader(&mut self, ss: StopSign) {\n   136\t        let accepted_metadata = self\n   137\t            .internal_storage\n   138\t            .append_stopsign(ss.clone())\n   139\t            .expect(WRITE_ERROR_MSG);\n   140\t        if let Some(metadata) = accepted_metadata {\n   141\t            self.send_acceptdecide(metadata);\n   142\t        }\n   143\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   144\t        self.leader_state.set_accepted_idx(self.pid, accepted_idx);\n   145\t        for pid in self.leader_state.get_promised_followers() {\n   146\t            self.send_accept_stopsign(pid, ss.clone(), false);\n   147\t        }\n   148\t    }\n   149\t\n   150\t    fn send_accsync(&mut self, to: NodeId) {\n   151\t        let current_n = self.leader_state.n_leader;\n   152\t        let PromiseMetaData {\n   153\t            n_accepted: prev_round_max_promise_n,\n   154\t            accepted_idx: prev_round_max_accepted_idx,\n   155\t            ..\n   156\t        } = &self.leader_state.get_max_promise_meta();\n   157\t        let PromiseMetaData {\n   158\t            n_accepted: followers_promise_n,\n   159\t            accepted_idx: followers_accepted_idx,\n   160\t            pid,\n   161\t            ..\n   162\t        } = self.leader_state.get_promise_meta(to);\n   163\t        let followers_decided_idx = self\n   164\t            .leader_state\n   165\t            .get_decided_idx(*pid)\n   166\t            .expect(\"Received PromiseMetaData but not found in ld\");\n   167\t        // Follower can have valid accepted entries depending on which leader they were previously following\n   168\t        let followers_valid_entries_idx = if *followers_promise_n == current_n {\n   169\t            *followers_accepted_idx\n   170\t        } else if *followers_promise_n == *prev_round_max_promise_n {\n   171\t            *prev_round_max_accepted_idx.min(followers_accepted_idx)\n   172\t        } else {\n   173\t            followers_decided_idx\n   174\t        };\n   175\t        let log_sync = self.create_log_sync(followers_valid_entries_idx, followers_decided_idx);\n   176\t        self.leader_state.increment_seq_num_session(to);\n   177\t        let acc_sync = AcceptSync {\n   178\t            n: current_n,\n   179\t            seq_num: self.leader_state.next_seq_num(to),\n   180\t            decided_idx: self.get_decided_idx(),\n   181\t            log_sync,\n   182\t            #[cfg(feature = \"unicache\")]\n   183\t            unicache: self.internal_storage.get_unicache(),\n   184\t        };\n   185\t        let msg = Message::SequencePaxos(PaxosMessage {\n   186\t            from: self.pid,\n   187\t            to,\n   188\t            msg: PaxosMsg::AcceptSync(acc_sync),\n   189\t        });\n   190\t        self.outgoing.push(msg);\n   191\t    }\n   192\t\n   193\t    fn send_acceptdecide(&mut self, accepted: AcceptedMetaData<T>) {\n   194\t        let decided_idx = self.internal_storage.get_decided_idx();\n   195\t        for pid in self.leader_state.get_promised_followers() {\n   196\t            let latest_accdec = self.get_latest_accdec_message(pid);\n   197\t            match latest_accdec {\n   198\t                // Modify existing AcceptDecide message to follower\n   199\t                Some(accdec) => {\n   200\t                    accdec.entries.extend(accepted.entries.iter().cloned());\n   201\t                    accdec.decided_idx = decided_idx;\n   202\t                }\n   203\t                // Add new AcceptDecide message to follower\n   204\t                None => {\n   205\t                    self.leader_state\n   206\t                        .set_latest_accept_meta(pid, Some(self.outgoing.len()));\n   207\t                    let acc = AcceptDecide {\n   208\t                        n: self.leader_state.n_leader,\n   209\t                        seq_num: self.leader_state.next_seq_num(pid),\n   210\t                        decided_idx,\n   211\t                        entries: accepted.entries.clone(),\n   212\t                    };\n   213\t                    self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   214\t                        from: self.pid,\n   215\t                        to: pid,\n   216\t                        msg: PaxosMsg::AcceptDecide(acc),\n   217\t                    }));\n   218\t                }\n   219\t            }\n   220\t        }\n   221\t    }\n   222\t\n   223\t    fn send_accept_stopsign(&mut self, to: NodeId, ss: StopSign, resend: bool) {\n   224\t        let seq_num = match resend {\n   225\t            true => self.leader_state.get_seq_num(to),\n   226\t            false => self.leader_state.next_seq_num(to),\n   227\t        };\n   228\t        let acc_ss = PaxosMsg::AcceptStopSign(AcceptStopSign {\n   229\t            seq_num,\n   230\t            n: self.leader_state.n_leader,\n   231\t            ss,\n   232\t        });\n   233\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   234\t            from: self.pid,\n   235\t            to,\n   236\t            msg: acc_ss,\n   237\t        }));\n   238\t    }\n   239\t\n   240\t    pub(crate) fn send_decide(&mut self, to: NodeId, decided_idx: usize, resend: bool) {\n   241\t        let seq_num = match resend {\n   242\t            true => self.leader_state.get_seq_num(to),\n   243\t            false => self.leader_state.next_seq_num(to),\n   244\t        };\n   245\t        let d = Decide {\n   246\t            n: self.leader_state.n_leader,\n   247\t            seq_num,\n   248\t            decided_idx,\n   249\t        };\n   250\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   251\t            from: self.pid,\n   252\t            to,\n   253\t            msg: PaxosMsg::Decide(d),\n   254\t        }));\n   255\t    }\n   256\t\n   257\t    fn handle_majority_promises(&mut self) {\n   258\t        let max_promise_sync = self.leader_state.take_max_promise_sync();\n   259\t        let decided_idx = self.leader_state.get_max_decided_idx();\n   260\t        let mut new_accepted_idx = self\n   261\t            .internal_storage\n   262\t            .sync_log(self.leader_state.n_leader, decided_idx, max_promise_sync)\n   263\t            .expect(WRITE_ERROR_MSG);\n   264\t        if !self.accepted_reconfiguration() {\n   265\t            if !self.buffered_proposals.is_empty() {\n   266\t                let entries = std::mem::take(&mut self.buffered_proposals);\n   267\t                new_accepted_idx = self\n   268\t                    .internal_storage\n   269\t                    .append_entries_without_batching(entries)\n   270\t                    .expect(WRITE_ERROR_MSG);\n   271\t            }\n   272\t            if let Some(ss) = self.buffered_stopsign.take() {\n   273\t                self.internal_storage\n   274\t                    .append_stopsign(ss)\n   275\t                    .expect(WRITE_ERROR_MSG);\n   276\t                new_accepted_idx = self.internal_storage.get_accepted_idx();\n   277\t            }\n   278\t        }\n   279\t        self.state = (Role::Leader, Phase::Accept);\n   280\t        self.leader_state\n   281\t            .set_accepted_idx(self.pid, new_accepted_idx);\n   282\t        for pid in self.leader_state.get_promised_followers() {\n   283\t            self.send_accsync(pid);\n   284\t        }\n   285\t    }\n   286\t\n   287\t    pub(crate) fn handle_promise_prepare(&mut self, prom: Promise<T>, from: NodeId) {\n   288\t        #[cfg(feature = \"logging\")]\n   289\t        debug!(\n   290\t            self.logger,\n   291\t            \"Handling promise from {} in Prepare phase\", from\n   292\t        );\n   293\t        if prom.n == self.leader_state.n_leader {\n   294\t            let received_majority = self.leader_state.set_promise(prom, from, true);\n   295\t            if received_majority {\n   296\t                self.handle_majority_promises();\n   297\t            }\n   298\t        }\n   299\t    }\n   300\t\n     1\tuse super::super::ballot_leader_election::Ballot;\n     2\t\n     3\tuse super::*;\n     4\t\n     5\tuse crate::util::{MessageStatus, WRITE_ERROR_MSG};\n     6\t\n     7\timpl<T, B> SequencePaxos<T, B>\n     8\twhere\n     9\t    T: Entry,\n    10\t    B: Storage<T>,\n    11\t{\n    12\t    /*** Follower ***/\n    13\t    pub(crate) fn handle_prepare(&mut self, prep: Prepare, from: NodeId) {\n    14\t        let old_promise = self.internal_storage.get_promise();\n    15\t        if old_promise < prep.n || (old_promise == prep.n && self.state.1 == Phase::Recover) {\n    16\t            // Flush any pending writes\n    17\t            // Don't have to handle flushed entries here because we will sync with followers\n    18\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    19\t            self.internal_storage\n    20\t                .set_promise(prep.n)\n    21\t                .expect(WRITE_ERROR_MSG);\n    22\t            self.state = (Role::Follower, Phase::Prepare);\n    23\t            self.current_seq_num = SequenceNumber::default();\n    24\t            let na = self.internal_storage.get_accepted_round();\n    25\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    26\t            let log_sync = if na > prep.n_accepted {\n    27\t                // I'm more up to date: send leader what he is missing after his decided index.\n    28\t                Some(self.create_log_sync(prep.decided_idx, prep.decided_idx))\n    29\t            } else if na == prep.n_accepted && accepted_idx > prep.accepted_idx {\n    30\t                // I'm more up to date and in same round: send leader what he is missing after his\n    31\t                // accepted index.\n    32\t                Some(self.create_log_sync(prep.accepted_idx, prep.decided_idx))\n    33\t            } else {\n    34\t                // I'm equally or less up to date\n    35\t                None\n    36\t            };\n    37\t            let promise = Promise {\n    38\t                n: prep.n,\n    39\t                n_accepted: na,\n    40\t                decided_idx: self.internal_storage.get_decided_idx(),\n    41\t                accepted_idx,\n    42\t                log_sync,\n    43\t            };\n    44\t            self.cached_promise_message = Some(promise.clone());\n    45\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    46\t                from: self.pid,\n    47\t                to: from,\n    48\t                msg: PaxosMsg::Promise(promise),\n    49\t            }));\n    50\t        }\n    51\t    }\n    52\t\n    53\t    pub(crate) fn handle_acceptsync(&mut self, accsync: AcceptSync<T>, from: NodeId) {\n    54\t        if self.check_valid_ballot(accsync.n) && self.state == (Role::Follower, Phase::Prepare) {\n    55\t            self.cached_promise_message = None;\n    56\t            let new_accepted_idx = self\n    57\t                .internal_storage\n    58\t                .sync_log(accsync.n, accsync.decided_idx, Some(accsync.log_sync))\n    59\t                .expect(WRITE_ERROR_MSG);\n    60\t            if self.internal_storage.get_stopsign().is_none() {\n    61\t                self.forward_buffered_proposals();\n    62\t            }\n    63\t            let accepted = Accepted {\n    64\t                n: accsync.n,\n    65\t                accepted_idx: new_accepted_idx,\n    66\t            };\n    67\t            self.state = (Role::Follower, Phase::Accept);\n    68\t            self.current_seq_num = accsync.seq_num;\n    69\t            let cached_idx = self.outgoing.len();\n    70\t            self.latest_accepted_meta = Some((accsync.n, cached_idx));\n    71\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    72\t                from: self.pid,\n    73\t                to: from,\n    74\t                msg: PaxosMsg::Accepted(accepted),\n    75\t            }));\n    76\t            #[cfg(feature = \"unicache\")]\n    77\t            self.internal_storage.set_unicache(accsync.unicache);\n    78\t        }\n    79\t    }\n    80\t\n    81\t    fn forward_buffered_proposals(&mut self) {\n    82\t        let proposals = std::mem::take(&mut self.buffered_proposals);\n    83\t        if !proposals.is_empty() {\n    84\t            self.forward_proposals(proposals);\n    85\t        }\n    86\t    }\n    87\t\n    88\t    pub(crate) fn handle_acceptdecide(&mut self, acc_dec: AcceptDecide<T>) {\n    89\t        if self.check_valid_ballot(acc_dec.n)\n    90\t            && self.state == (Role::Follower, Phase::Accept)\n    91\t            && self.handle_sequence_num(acc_dec.seq_num, acc_dec.n.pid) == MessageStatus::Expected\n    92\t        {\n    93\t            #[cfg(not(feature = \"unicache\"))]\n    94\t            let entries = acc_dec.entries;\n    95\t            #[cfg(feature = \"unicache\")]\n    96\t            let entries = self.internal_storage.decode_entries(acc_dec.entries);\n    97\t            let mut new_accepted_idx = self\n    98\t                .internal_storage\n    99\t                .append_entries_and_get_accepted_idx(entries)\n   100\t                .expect(WRITE_ERROR_MSG);\n   101\t            let flushed_after_decide =\n   102\t                self.update_decided_idx_and_get_accepted_idx(acc_dec.decided_idx);\n   103\t            if flushed_after_decide.is_some() {\n   104\t                new_accepted_idx = flushed_after_decide;\n   105\t            }\n   106\t            if let Some(idx) = new_accepted_idx {\n   107\t                self.reply_accepted(acc_dec.n, idx);\n   108\t            }\n   109\t        }\n   110\t    }\n   111\t\n   112\t    pub(crate) fn handle_accept_stopsign(&mut self, acc_ss: AcceptStopSign) {\n   113\t        if self.check_valid_ballot(acc_ss.n)\n   114\t            && self.state == (Role::Follower, Phase::Accept)\n   115\t            && self.handle_sequence_num(acc_ss.seq_num, acc_ss.n.pid) == MessageStatus::Expected\n   116\t        {\n   117\t            // Flush entries before appending stopsign. The accepted index is ignored here as\n   118\t            // it will be updated when appending stopsign.\n   119\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   120\t            let new_accepted_idx = self\n   121\t                .internal_storage\n   122\t                .set_stopsign(Some(acc_ss.ss))\n   123\t                .expect(WRITE_ERROR_MSG);\n   124\t            self.reply_accepted(acc_ss.n, new_accepted_idx);\n   125\t        }\n   126\t    }\n   127\t\n   128\t    pub(crate) fn handle_decide(&mut self, dec: Decide) {\n   129\t        if self.check_valid_ballot(dec.n)\n   130\t            && self.state.1 == Phase::Accept\n   131\t            && self.handle_sequence_num(dec.seq_num, dec.n.pid) == MessageStatus::Expected\n   132\t        {\n   133\t            let new_accepted_idx = self.update_decided_idx_and_get_accepted_idx(dec.decided_idx);\n   134\t            if let Some(idx) = new_accepted_idx {\n   135\t                self.reply_accepted(dec.n, idx);\n   136\t            }\n   137\t        }\n   138\t    }\n   139\t\n   140\t    /// To maintain decided index <= accepted index, batched entries may be flushed.\n   141\t    /// Returns `Some(new_accepted_idx)` if entries are flushed, otherwise `None`.\n   142\t    fn update_decided_idx_and_get_accepted_idx(&mut self, new_decided_idx: usize) -> Option<usize> {\n   143\t        if new_decided_idx <= self.internal_storage.get_decided_idx() {\n   144\t            return None;\n   145\t        }\n   146\t        if new_decided_idx > self.internal_storage.get_accepted_idx() {\n   147\t            let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   148\t            self.internal_storage\n   149\t                .set_decided_idx(new_decided_idx.min(new_accepted_idx))\n   150\t                .expect(WRITE_ERROR_MSG);\n   151\t            Some(new_accepted_idx)\n   152\t        } else {\n   153\t            self.internal_storage\n   154\t                .set_decided_idx(new_decided_idx)\n   155\t                .expect(WRITE_ERROR_MSG);\n   156\t            None\n   157\t        }\n   158\t    }\n   159\t\n   160\t    fn reply_accepted(&mut self, n: Ballot, accepted_idx: usize) {\n   161\t        let latest_accepted = self.get_latest_accepted_message(n);\n   162\t        match latest_accepted {\n   163\t            Some(acc) => acc.accepted_idx = accepted_idx,\n   164\t            None => {\n   165\t                let accepted = Accepted { n, accepted_idx };\n   166\t                let cached_idx = self.outgoing.len();\n   167\t                self.latest_accepted_meta = Some((n, cached_idx));\n   168\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   169\t                    from: self.pid,\n   170\t                    to: n.pid,\n   171\t                    msg: PaxosMsg::Accepted(accepted),\n   172\t                }));\n   173\t            }\n   174\t        }\n   175\t    }\n   176\t\n   177\t    fn get_latest_accepted_message(&mut self, n: Ballot) -> Option<&mut Accepted> {\n   178\t        if let Some((ballot, outgoing_idx)) = &self.latest_accepted_meta {\n   179\t            if *ballot == n {\n   180\t                if let Message::SequencePaxos(PaxosMessage {\n   181\t                    msg: PaxosMsg::Accepted(a),\n   182\t                    ..\n   183\t                }) = self.outgoing.get_mut(*outgoing_idx).unwrap()\n   184\t                {\n   185\t                    return Some(a);\n   186\t                } else {\n   187\t                    #[cfg(feature = \"logging\")]\n   188\t                    debug!(self.logger, \"Cached idx is not an Accepted message!\");\n   189\t                }\n   190\t            }\n   191\t        }\n   192\t        None\n   193\t    }\n   194\t\n   195\t    /// Also returns whether the message's ballot was promised\n   196\t    fn check_valid_ballot(&mut self, message_ballot: Ballot) -> bool {\n   197\t        let my_promise = self.internal_storage.get_promise();\n   198\t        match my_promise.cmp(&message_ballot) {\n   199\t            std::cmp::Ordering::Equal => true,\n   200\t            std::cmp::Ordering::Greater => {\n   201\t                let not_acc = NotAccepted { n: my_promise };\n   202\t                #[cfg(feature = \"logging\")]\n   203\t                trace!(\n   204\t                    self.logger,\n   205\t                    \"NotAccepted. My promise: {:?}, theirs: {:?}\",\n   206\t                    my_promise,\n   207\t                    message_ballot\n   208\t                );\n   209\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   210\t                    from: self.pid,\n   211\t                    to: message_ballot.pid,\n   212\t                    msg: PaxosMsg::NotAccepted(not_acc),\n   213\t                }));\n   214\t                false\n   215\t            }\n   216\t            std::cmp::Ordering::Less => {\n   217\t                // Should never happen, but to be safe send PrepareReq\n   218\t                #[cfg(feature = \"logging\")]\n   219\t                warn!(\n   220\t                    self.logger,\n   221\t                    \"Received non-prepare message from a leader I've never promised. My: {:?}, theirs: {:?}\", my_promise, message_ballot\n   222\t                );\n   223\t                self.reconnected(message_ballot.pid);\n   224\t                false\n   225\t            }\n   226\t        }\n   227\t    }\n   228\t\n   229\t    /// Also returns the MessageStatus of the sequence based on the incoming sequence number.\n   230\t    fn handle_sequence_num(&mut self, seq_num: SequenceNumber, from: NodeId) -> MessageStatus {\n   231\t        let msg_status = self.current_seq_num.check_msg_status(seq_num);\n   232\t        match msg_status {\n   233\t            MessageStatus::Expected => self.current_seq_num = seq_num,\n   234\t            MessageStatus::DroppedPreceding => self.reconnected(from),\n   235\t            MessageStatus::Outdated => (),\n   236\t        };\n   237\t        msg_status\n   238\t    }\n   239\t\n   240\t    pub(crate) fn resend_messages_follower(&mut self) {\n   241\t        match self.state.1 {\n   242\t            Phase::Prepare => {\n   243\t                // Resend Promise\n   244\t                match &self.cached_promise_message {\n   245\t                    Some(promise) => {\n   246\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   247\t                            from: self.pid,\n   248\t                            to: promise.n.pid,\n   249\t                            msg: PaxosMsg::Promise(promise.clone()),\n   250\t                        }));\n   251\t                    }\n   252\t                    None => {\n   253\t                        // Shouldn't be possible to be in prepare phase without having\n   254\t                        // cached the promise sent as a response to the prepare\n   255\t                        #[cfg(feature = \"logging\")]\n   256\t                        warn!(self.logger, \"In Prepare phase without a cached promise!\");\n   257\t                        self.state = (Role::Follower, Phase::Recover);\n   258\t                        self.send_preparereq_to_all_peers();\n   259\t                    }\n   260\t                }\n   261\t            }\n   262\t            Phase::Recover => {\n   263\t                // Resend PrepareReq\n   264\t                self.send_preparereq_to_all_peers();\n   265\t            }\n   266\t            Phase::Accept => (),\n   267\t            Phase::None => (),\n   268\t        }\n   269\t    }\n   270\t\n   271\t    fn send_preparereq_to_all_peers(&mut self) {\n   272\t        let prepreq = PrepareReq {\n   273\t            n: self.get_promise(),\n   274\t        };\n   275\t        for peer in &self.peers {\n   276\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   277\t                from: self.pid,\n   278\t                to: *peer,\n   279\t                msg: PaxosMsg::PrepareReq(prepreq),\n   280\t            }));\n   281\t        }\n   282\t    }\n   283\t\n   284\t    pub(crate) fn flush_batch_follower(&mut self) {\n   285\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   286\t        let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   287\t        if new_accepted_idx > accepted_idx {\n   288\t            self.reply_accepted(self.get_promise(), new_accepted_idx);\n   289\t        }\n   290\t    }\n   291\t}\n","exit_code":0,"status":"completed"}}
