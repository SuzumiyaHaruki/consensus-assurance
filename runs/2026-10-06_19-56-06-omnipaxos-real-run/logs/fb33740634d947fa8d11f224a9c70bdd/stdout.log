{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"find ../ -name guide.md -o -name behavior-facts.md; nl -ba ../agent-source/omnipaxos/src/ballot_leader_election.rs | sed -n '140,322p'; grep -n 'pub fn\\\\|fn sync_log' ../agent-source/omnipaxos/src/storage/internal_storage.rs; grep -n 'pub fn\\\\|fn tick' ../agent-source/omnipaxos/src/omni_paxos.rs\"","aggregated_output":"   140\t            },\n   141\t        };\n   142\t        #[cfg(feature = \"logging\")]\n   143\t        {\n   144\t            info!(\n   145\t                ble.logger,\n   146\t                \"Ballot Leader Election component pid: {} created!\", pid\n   147\t            );\n   148\t        }\n   149\t        ble.new_hb_round();\n   150\t        ble\n   151\t    }\n   152\t\n   153\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   154\t    /// priority triggers a leader re-election.\n   155\t    pub(crate) fn set_priority(&mut self, p: u32) {\n   156\t        self.current_ballot.priority = p;\n   157\t    }\n   158\t\n   159\t    /// Returns reference to outgoing messages\n   160\t    pub(crate) fn outgoing_mut(&mut self) -> &mut Vec<BLEMessage> {\n   161\t        &mut self.outgoing\n   162\t    }\n   163\t\n   164\t    /// Handle an incoming message.\n   165\t    /// # Arguments\n   166\t    /// * `m` - the message to be handled.\n   167\t    pub(crate) fn handle(&mut self, m: BLEMessage) {\n   168\t        match m.msg {\n   169\t            HeartbeatMsg::Request(req) => self.handle_request(m.from, req),\n   170\t            HeartbeatMsg::Reply(rep) => self.handle_reply(rep),\n   171\t        }\n   172\t    }\n   173\t\n   174\t    /// Initiates a new heartbeat round.\n   175\t    pub(crate) fn new_hb_round(&mut self) {\n   176\t        self.prev_replies = std::mem::take(&mut self.heartbeat_replies);\n   177\t        self.hb_round += 1;\n   178\t        #[cfg(feature = \"logging\")]\n   179\t        trace!(\n   180\t            self.logger,\n   181\t            \"Initiate new heartbeat round: {}\",\n   182\t            self.hb_round\n   183\t        );\n   184\t        for peer in &self.peers {\n   185\t            let hb_request = HeartbeatRequest {\n   186\t                round: self.hb_round,\n   187\t            };\n   188\t            self.outgoing.push(BLEMessage {\n   189\t                from: self.pid,\n   190\t                to: *peer,\n   191\t                msg: HeartbeatMsg::Request(hb_request),\n   192\t            });\n   193\t        }\n   194\t    }\n   195\t\n   196\t    /// End of a heartbeat round. Returns current leader and election status.\n   197\t    pub(crate) fn hb_timeout(\n   198\t        &mut self,\n   199\t        seq_paxos_state: &(Role, Phase),\n   200\t        seq_paxos_promise: Ballot,\n   201\t    ) -> Option<Ballot> {\n   202\t        self.update_leader();\n   203\t        self.update_happiness(seq_paxos_state);\n   204\t        self.check_takeover();\n   205\t        self.new_hb_round();\n   206\t        if seq_paxos_promise > self.leader {\n   207\t            // Sync leader with Paxos promise in case ballot didn't make it to BLE followers\n   208\t            // or become_leader() was called.\n   209\t            self.leader = seq_paxos_promise;\n   210\t            if seq_paxos_promise.pid == self.pid {\n   211\t                self.current_ballot = seq_paxos_promise;\n   212\t            }\n   213\t            self.happy = true;\n   214\t        }\n   215\t        if self.leader == self.current_ballot {\n   216\t            Some(self.current_ballot)\n   217\t        } else {\n   218\t            None\n   219\t        }\n   220\t    }\n   221\t\n   222\t    fn update_leader(&mut self) {\n   223\t        let max_reply_ballot = self.heartbeat_replies.iter().map(|r| r.ballot).max();\n   224\t        if let Some(max) = max_reply_ballot {\n   225\t            if max > self.leader {\n   226\t                self.leader = max;\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n   232\t        self.happy = if self.leader == self.current_ballot {\n   233\t            let potential_followers = self\n   234\t                .heartbeat_replies\n   235\t                .iter()\n   236\t                .filter(|hb_reply| hb_reply.leader <= self.current_ballot)\n   237\t                .count();\n   238\t            let can_form_quorum = match seq_paxos_state {\n   239\t                (Role::Leader, Phase::Accept) => {\n   240\t                    self.quorum.is_accept_quorum(potential_followers + 1)\n   241\t                }\n   242\t                _ => self.quorum.is_prepare_quorum(potential_followers + 1),\n   243\t            };\n   244\t            if can_form_quorum {\n   245\t                true\n   246\t            } else {\n   247\t                let see_larger_happy_leader = self\n   248\t                    .heartbeat_replies\n   249\t                    .iter()\n   250\t                    .any(|r| r.leader > self.current_ballot && r.happy);\n   251\t                see_larger_happy_leader\n   252\t            }\n   253\t        } else {\n   254\t            self.heartbeat_replies\n   255\t                .iter()\n   256\t                .any(|r| r.ballot == self.leader && r.happy)\n   257\t        };\n   258\t    }\n   259\t\n   260\t    fn check_takeover(&mut self) {\n   261\t        if !self.happy {\n   262\t            let all_neighbors_unhappy = self.heartbeat_replies.iter().all(|r| !r.happy);\n   263\t            let im_quorum_connected = self\n   264\t                .quorum\n   265\t                .is_prepare_quorum(self.heartbeat_replies.len() + 1);\n   266\t            if all_neighbors_unhappy && im_quorum_connected {\n   267\t                // We increment past our leader instead of max of unhappy ballots because we\n   268\t                // assume we have already checked leader for this round so they should be equal\n   269\t                self.current_ballot.n = self.leader.n + 1;\n   270\t                self.leader = self.current_ballot;\n   271\t                self.happy = true;\n   272\t            }\n   273\t        }\n   274\t    }\n   275\t\n   276\t    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n   277\t        let hb_reply = HeartbeatReply {\n   278\t            round: req.round,\n   279\t            ballot: self.current_ballot,\n   280\t            leader: self.leader,\n   281\t            happy: self.happy,\n   282\t        };\n   283\t        self.outgoing.push(BLEMessage {\n   284\t            from: self.pid,\n   285\t            to: from,\n   286\t            msg: HeartbeatMsg::Reply(hb_reply),\n   287\t        });\n   288\t    }\n   289\t\n   290\t    fn handle_reply(&mut self, rep: HeartbeatReply) {\n   291\t        if rep.round == self.hb_round && rep.ballot.config_id == self.configuration_id {\n   292\t            self.heartbeat_replies.push(rep);\n   293\t        }\n   294\t    }\n   295\t\n   296\t    pub(crate) fn get_current_ballot(&self) -> Ballot {\n   297\t        self.current_ballot\n   298\t    }\n   299\t\n   300\t    pub(crate) fn get_ballots(&self) -> Vec<HeartbeatReply> {\n   301\t        self.prev_replies.clone()\n   302\t    }\n   303\t}\n   304\t\n   305\t/// Configuration for `BallotLeaderElection`.\n   306\t/// # Fields\n   307\t/// * `configuration_id`: The identifier for the configuration that this node is part of.\n   308\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   309\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   310\t/// * `priority`: Set custom priority for this node to be elected as the leader.\n   311\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   312\t/// * `buffer_size`: The buffer size for outgoing messages.\n   313\t/// * `logger_file_path`: The path where the default logger logs events.\n   314\t#[derive(Clone, Debug)]\n   315\tpub(crate) struct BLEConfig {\n   316\t    configuration_id: ConfigurationId,\n   317\t    pid: NodeId,\n   318\t    peers: Vec<NodeId>,\n   319\t    priority: u32,\n   320\t    flexible_quorum: Option<FlexibleQuorum>,\n   321\t    buffer_size: usize,\n   322\t    #[cfg(feature = \"logging\")]\n313:    pub(crate) fn sync_log(\n41:    pub fn validate(&self) -> Result<(), ConfigError> {\n53:    pub fn with_toml(file_path: &str) -> Result<Self, ConfigError> {\n61:    pub fn build<T, B>(self, storage: B) -> Result<OmniPaxos<T, B>, ConfigError>\n104:    pub fn validate(&self) -> Result<(), ConfigError> {\n135:    pub fn build_for_server<T, B>(\n189:    pub fn validate(&self) -> Result<(), ConfigError> {\n245:    pub fn trim(&mut self, trim_index: Option<usize>) -> Result<(), CompactionErr> {\n253:    pub fn snapshot(\n262:    pub fn get_decided_idx(&self) -> usize {\n269:    pub fn get_accepted_idx(&self) -> usize {\n279:    pub fn get_batched_len(&self) -> usize {\n284:    pub fn get_compacted_idx(&self) -> usize {\n294:    pub fn get_current_leader(&self) -> Option<(NodeId, bool)> {\n305:    pub fn get_promise(&self) -> Ballot {\n310:    pub fn get_pid(&self) -> NodeId {\n315:    pub fn take_outgoing_messages(&mut self, buffer: &mut Vec<Message<T>>) {\n321:    pub fn read(&self, idx: usize) -> Option<LogEntry<T>> {\n334:    pub fn read_entries<R>(&self, r: R) -> Option<Vec<LogEntry<T>>>\n345:    pub fn read_decided_suffix(&self, from_idx: usize) -> Option<Vec<LogEntry<T>>> {\n353:    pub fn handle_incoming(&mut self, m: Message<T>) {\n366:    pub fn is_reconfigured(&self) -> Option<StopSign> {\n371:    pub fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n379:    pub fn reconfigure(\n396:    pub fn reconnected(&mut self, pid: NodeId) {\n403:    pub fn tick(&mut self) {\n418:    pub fn try_become_leader(&mut self) {\n428:    pub fn set_priority(&mut self, p: u32) {\n445:    pub fn get_ui_states(&self) -> ui::OmniPaxosStates {\n","exit_code":0,"status":"completed"}}
