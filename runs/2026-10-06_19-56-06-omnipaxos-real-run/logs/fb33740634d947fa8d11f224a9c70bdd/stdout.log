{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/util.rs | sed -n '96,260p'; nl -ba ../agent-source/omnipaxos/src/sequence_paxos/mod.rs | sed -n '260,445p'; nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '90,190p'; grep -n 'pub fn\\\\|fn handle\\\\|fn check' ../agent-source/omnipaxos/src/ballot_leader_election.rs\"","aggregated_output":"    96\t    pub fn with(n_leader: Ballot, max_pid: usize, quorum: Quorum) -> Self {\n    97\t        Self {\n    98\t            n_leader,\n    99\t            promises_meta: vec![PromiseState::NotPromised; max_pid],\n   100\t            follower_seq_nums: vec![SequenceNumber::default(); max_pid],\n   101\t            accepted_indexes: vec![0; max_pid],\n   102\t            max_promise_meta: PromiseMetaData::default(),\n   103\t            max_promise_sync: None,\n   104\t            latest_accept_meta: vec![None; max_pid],\n   105\t            max_pid,\n   106\t            quorum,\n   107\t        }\n   108\t    }\n   109\t\n   110\t    fn pid_to_idx(pid: NodeId) -> usize {\n   111\t        (pid - 1) as usize\n   112\t    }\n   113\t\n   114\t    // Resets `pid`'s accept sequence to indicate they are in the next session of accepts\n   115\t    pub fn increment_seq_num_session(&mut self, pid: NodeId) {\n   116\t        let idx = Self::pid_to_idx(pid);\n   117\t        self.follower_seq_nums[idx].session += 1;\n   118\t        self.follower_seq_nums[idx].counter = 0;\n   119\t    }\n   120\t\n   121\t    pub fn next_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   122\t        let idx = Self::pid_to_idx(pid);\n   123\t        self.follower_seq_nums[idx].counter += 1;\n   124\t        self.follower_seq_nums[idx]\n   125\t    }\n   126\t\n   127\t    pub fn get_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   128\t        self.follower_seq_nums[Self::pid_to_idx(pid)]\n   129\t    }\n   130\t\n   131\t    pub fn set_promise(&mut self, prom: Promise<T>, from: NodeId, check_max_prom: bool) -> bool {\n   132\t        let promise_meta = PromiseMetaData {\n   133\t            n_accepted: prom.n_accepted,\n   134\t            accepted_idx: prom.accepted_idx,\n   135\t            decided_idx: prom.decided_idx,\n   136\t            pid: from,\n   137\t        };\n   138\t        if check_max_prom && promise_meta > self.max_promise_meta {\n   139\t            self.max_promise_meta = promise_meta.clone();\n   140\t            self.max_promise_sync = prom.log_sync;\n   141\t        }\n   142\t        self.promises_meta[Self::pid_to_idx(from)] = PromiseState::Promised(promise_meta);\n   143\t        let num_promised = self\n   144\t            .promises_meta\n   145\t            .iter()\n   146\t            .filter(|p| matches!(p, PromiseState::Promised(_)))\n   147\t            .count();\n   148\t        self.quorum.is_prepare_quorum(num_promised)\n   149\t    }\n   150\t\n   151\t    pub fn reset_promise(&mut self, pid: NodeId) {\n   152\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::NotPromised;\n   153\t    }\n   154\t\n   155\t    /// Node `pid` seen with ballot greater than my ballot\n   156\t    pub fn lost_promise(&mut self, pid: NodeId) {\n   157\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::PromisedHigher;\n   158\t    }\n   159\t\n   160\t    pub fn take_max_promise_sync(&mut self) -> Option<LogSync<T>> {\n   161\t        std::mem::take(&mut self.max_promise_sync)\n   162\t    }\n   163\t\n   164\t    pub fn get_max_promise_meta(&self) -> &PromiseMetaData {\n   165\t        &self.max_promise_meta\n   166\t    }\n   167\t\n   168\t    pub fn get_max_decided_idx(&self) -> usize {\n   169\t        self.promises_meta\n   170\t            .iter()\n   171\t            .filter_map(|p| match p {\n   172\t                PromiseState::Promised(m) => Some(m.decided_idx),\n   173\t                _ => None,\n   174\t            })\n   175\t            .max()\n   176\t            .unwrap_or_default()\n   177\t    }\n   178\t\n   179\t    pub fn get_promise_meta(&self, pid: NodeId) -> &PromiseMetaData {\n   180\t        match &self.promises_meta[Self::pid_to_idx(pid)] {\n   181\t            PromiseState::Promised(metadata) => metadata,\n   182\t            _ => panic!(\"No Metadata found for promised follower\"),\n   183\t        }\n   184\t    }\n   185\t\n   186\t    pub fn get_min_all_accepted_idx(&self) -> &usize {\n   187\t        self.accepted_indexes\n   188\t            .iter()\n   189\t            .min()\n   190\t            .expect(\"Should be all initialised to 0!\")\n   191\t    }\n   192\t\n   193\t    pub fn reset_latest_accept_meta(&mut self) {\n   194\t        self.latest_accept_meta = vec![None; self.max_pid];\n   195\t    }\n   196\t\n   197\t    pub fn get_promised_followers(&self) -> Vec<NodeId> {\n   198\t        self.promises_meta\n   199\t            .iter()\n   200\t            .enumerate()\n   201\t            .filter_map(|(idx, x)| match x {\n   202\t                PromiseState::Promised(_) if idx != Self::pid_to_idx(self.n_leader.pid) => {\n   203\t                    Some((idx + 1) as NodeId)\n   204\t                }\n   205\t                _ => None,\n   206\t            })\n   207\t            .collect()\n   208\t    }\n   209\t\n   210\t    /// The pids of peers which have not promised a higher ballot than mine.\n   211\t    pub(crate) fn get_preparable_peers(&self, peers: &[NodeId]) -> Vec<NodeId> {\n   212\t        peers\n   213\t            .iter()\n   214\t            .filter_map(|pid| {\n   215\t                let idx = Self::pid_to_idx(*pid);\n   216\t                match self.promises_meta.get(idx).unwrap() {\n   217\t                    PromiseState::NotPromised => Some(*pid),\n   218\t                    _ => None,\n   219\t                }\n   220\t            })\n   221\t            .collect()\n   222\t    }\n   223\t\n   224\t    pub fn set_latest_accept_meta(&mut self, pid: NodeId, idx: Option<usize>) {\n   225\t        let meta = idx.map(|x| (self.n_leader, x));\n   226\t        self.latest_accept_meta[Self::pid_to_idx(pid)] = meta;\n   227\t    }\n   228\t\n   229\t    pub fn set_accepted_idx(&mut self, pid: NodeId, idx: usize) {\n   230\t        self.accepted_indexes[Self::pid_to_idx(pid)] = idx;\n   231\t    }\n   232\t\n   233\t    pub fn get_latest_accept_meta(&self, pid: NodeId) -> Option<(Ballot, usize)> {\n   234\t        self.latest_accept_meta\n   235\t            .get(Self::pid_to_idx(pid))\n   236\t            .unwrap()\n   237\t            .as_ref()\n   238\t            .copied()\n   239\t    }\n   240\t\n   241\t    pub fn get_decided_idx(&self, pid: NodeId) -> Option<usize> {\n   242\t        match self.promises_meta.get(Self::pid_to_idx(pid)).unwrap() {\n   243\t            PromiseState::Promised(metadata) => Some(metadata.decided_idx),\n   244\t            _ => None,\n   245\t        }\n   246\t    }\n   247\t\n   248\t    pub fn get_accepted_idx(&self, pid: NodeId) -> usize {\n   249\t        *self.accepted_indexes.get(Self::pid_to_idx(pid)).unwrap()\n   250\t    }\n   251\t\n   252\t    pub fn is_chosen(&self, idx: usize) -> bool {\n   253\t        let num_accepted = self\n   254\t            .accepted_indexes\n   255\t            .iter()\n   256\t            .filter(|la| **la >= idx)\n   257\t            .count();\n   258\t        self.quorum.is_accept_quorum(num_accepted)\n   259\t    }\n   260\t}\n   260\t    }\n   261\t\n   262\t    /// Handle an incoming message.\n   263\t    pub(crate) fn handle(&mut self, m: PaxosMessage<T>) {\n   264\t        match m.msg {\n   265\t            PaxosMsg::PrepareReq(prepreq) => self.handle_preparereq(prepreq, m.from),\n   266\t            PaxosMsg::Prepare(prep) => self.handle_prepare(prep, m.from),\n   267\t            PaxosMsg::Promise(prom) => match &self.state {\n   268\t                (Role::Leader, Phase::Prepare) => self.handle_promise_prepare(prom, m.from),\n   269\t                (Role::Leader, Phase::Accept) => self.handle_promise_accept(prom, m.from),\n   270\t                _ => {}\n   271\t            },\n   272\t            PaxosMsg::AcceptSync(acc_sync) => self.handle_acceptsync(acc_sync, m.from),\n   273\t            PaxosMsg::AcceptDecide(acc) => self.handle_acceptdecide(acc),\n   274\t            PaxosMsg::NotAccepted(not_acc) => self.handle_notaccepted(not_acc, m.from),\n   275\t            PaxosMsg::Accepted(accepted) => self.handle_accepted(accepted, m.from),\n   276\t            PaxosMsg::Decide(d) => self.handle_decide(d),\n   277\t            PaxosMsg::ProposalForward(proposals) => self.handle_forwarded_proposal(proposals),\n   278\t            PaxosMsg::Compaction(c) => self.handle_compaction(c),\n   279\t            PaxosMsg::AcceptStopSign(acc_ss) => self.handle_accept_stopsign(acc_ss),\n   280\t            PaxosMsg::ForwardStopSign(f_ss) => self.handle_forwarded_stopsign(f_ss),\n   281\t        }\n   282\t    }\n   283\t\n   284\t    /// Returns whether this Sequence Paxos has been reconfigured\n   285\t    pub(crate) fn is_reconfigured(&self) -> Option<StopSign> {\n   286\t        match self.internal_storage.get_stopsign() {\n   287\t            Some(ss) if self.internal_storage.stopsign_is_decided() => Some(ss),\n   288\t            _ => None,\n   289\t        }\n   290\t    }\n   291\t\n   292\t    /// Returns whether this Sequence Paxos instance is stopped, i.e. if it has been reconfigured.\n   293\t    fn accepted_reconfiguration(&self) -> bool {\n   294\t        self.internal_storage.get_stopsign().is_some()\n   295\t    }\n   296\t\n   297\t    /// Append an entry to the replicated log.\n   298\t    pub(crate) fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   299\t        if self.accepted_reconfiguration() {\n   300\t            Err(ProposeErr::PendingReconfigEntry(entry))\n   301\t        } else {\n   302\t            self.propose_entry(entry);\n   303\t            Ok(())\n   304\t        }\n   305\t    }\n   306\t\n   307\t    /// Propose a reconfiguration. Returns an error if already stopped or `new_config` is invalid.\n   308\t    /// `new_config` defines the cluster-wide configuration settings for the next cluster.\n   309\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   310\t    pub(crate) fn reconfigure(\n   311\t        &mut self,\n   312\t        new_config: ClusterConfig,\n   313\t        metadata: Option<Vec<u8>>,\n   314\t    ) -> Result<(), ProposeErr<T>> {\n   315\t        if self.accepted_reconfiguration() {\n   316\t            return Err(ProposeErr::PendingReconfigConfig(new_config, metadata));\n   317\t        }\n   318\t        #[cfg(feature = \"logging\")]\n   319\t        info!(\n   320\t            self.logger,\n   321\t            \"Accepting reconfiguration {:?}\", new_config.nodes\n   322\t        );\n   323\t        let ss = StopSign::with(new_config, metadata);\n   324\t        match self.state {\n   325\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n   326\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n   327\t            _ => self.forward_stopsign(ss),\n   328\t        }\n   329\t        Ok(())\n   330\t    }\n   331\t\n   332\t    fn get_current_leader(&self) -> NodeId {\n   333\t        self.get_promise().pid\n   334\t    }\n   335\t\n   336\t    /// Returns this node's own pid.\n   337\t    pub(crate) fn get_pid(&self) -> NodeId {\n   338\t        self.pid\n   339\t    }\n   340\t\n   341\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   342\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   343\t    pub(crate) fn reconnected(&mut self, pid: NodeId) {\n   344\t        if pid == self.pid {\n   345\t            return;\n   346\t        } else if pid == self.get_current_leader() {\n   347\t            self.state = (Role::Follower, Phase::Recover);\n   348\t        }\n   349\t        let prepreq = PrepareReq {\n   350\t            n: self.get_promise(),\n   351\t        };\n   352\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   353\t            from: self.pid,\n   354\t            to: pid,\n   355\t            msg: PaxosMsg::PrepareReq(prepreq),\n   356\t        }));\n   357\t    }\n   358\t\n   359\t    fn propose_entry(&mut self, entry: T) {\n   360\t        match self.state {\n   361\t            (Role::Leader, Phase::Prepare) => self.buffered_proposals.push(entry),\n   362\t            (Role::Leader, Phase::Accept) => self.accept_entry_leader(entry),\n   363\t            _ => self.forward_proposals(vec![entry]),\n   364\t        }\n   365\t    }\n   366\t\n   367\t    pub(crate) fn get_leader_state(&self) -> &LeaderState<T> {\n   368\t        &self.leader_state\n   369\t    }\n   370\t\n   371\t    pub(crate) fn forward_proposals(&mut self, mut entries: Vec<T>) {\n   372\t        let leader = self.get_current_leader();\n   373\t        if leader > 0 && self.pid != leader {\n   374\t            let pf = PaxosMsg::ProposalForward(entries);\n   375\t            let msg = Message::SequencePaxos(PaxosMessage {\n   376\t                from: self.pid,\n   377\t                to: leader,\n   378\t                msg: pf,\n   379\t            });\n   380\t            self.outgoing.push(msg);\n   381\t        } else {\n   382\t            self.buffered_proposals.append(&mut entries);\n   383\t        }\n   384\t    }\n   385\t\n   386\t    pub(crate) fn forward_stopsign(&mut self, ss: StopSign) {\n   387\t        let leader = self.get_current_leader();\n   388\t        if leader > 0 && self.pid != leader {\n   389\t            #[cfg(feature = \"logging\")]\n   390\t            trace!(self.logger, \"Forwarding StopSign to Leader {:?}\", leader);\n   391\t            let fs = PaxosMsg::ForwardStopSign(ss);\n   392\t            let msg = Message::SequencePaxos(PaxosMessage {\n   393\t                from: self.pid,\n   394\t                to: leader,\n   395\t                msg: fs,\n   396\t            });\n   397\t            self.outgoing.push(msg);\n   398\t        } else if self.buffered_stopsign.as_mut().is_none() {\n   399\t            self.buffered_stopsign = Some(ss);\n   400\t        }\n   401\t    }\n   402\t    /// Returns `LogSync`, a struct to help other servers synchronize their log to correspond to the\n   403\t    /// current state of our own log. The `common_prefix_idx` marks where in the log the other server\n   404\t    /// needs to be sync from.\n   405\t    fn create_log_sync(\n   406\t        &self,\n   407\t        common_prefix_idx: usize,\n   408\t        other_logs_decided_idx: usize,\n   409\t    ) -> LogSync<T> {\n   410\t        let decided_idx = self.internal_storage.get_decided_idx();\n   411\t        let (decided_snapshot, suffix, sync_idx) =\n   412\t            if T::Snapshot::use_snapshots() && decided_idx > common_prefix_idx {\n   413\t                // Note: We snapshot from the other log's decided index and not the common prefix because\n   414\t                // snapshots currently only work on decided entries.\n   415\t                let (delta_snapshot, compacted_idx) = self\n   416\t                    .internal_storage\n   417\t                    .create_diff_snapshot(other_logs_decided_idx)\n   418\t                    .expect(READ_ERROR_MSG);\n   419\t                let suffix = self\n   420\t                    .internal_storage\n   421\t                    .get_suffix(decided_idx)\n   422\t                    .expect(READ_ERROR_MSG);\n   423\t                (delta_snapshot, suffix, compacted_idx)\n   424\t            } else {\n   425\t                let suffix = self\n   426\t                    .internal_storage\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n    90\t#[cfg_attr(feature = \"toml_config\", serde(default))]\n    91\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n    92\tpub struct ClusterConfig {\n    93\t    /// The identifier for the cluster configuration that this OmniPaxos server is part of. Must\n    94\t    /// not be 0 and be greater than the previous configuration's id.\n    95\t    pub configuration_id: ConfigurationId,\n    96\t    /// The nodes in the cluster i.e. the `pid`s of the servers in the configuration.\n    97\t    pub nodes: Vec<NodeId>,\n    98\t    /// Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n    99\t    pub flexible_quorum: Option<FlexibleQuorum>,\n   100\t}\n   101\t\n   102\timpl ClusterConfig {\n   103\t    /// Checks that all the fields of the cluster config are valid.\n   104\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   105\t        let num_nodes = self.nodes.len();\n   106\t        valid_config!(num_nodes > 1, \"Need more than 1 node\");\n   107\t        valid_config!(self.configuration_id != 0, \"Configuration ID cannot be 0\");\n   108\t        if let Some(FlexibleQuorum {\n   109\t            read_quorum_size,\n   110\t            write_quorum_size,\n   111\t        }) = self.flexible_quorum\n   112\t        {\n   113\t            valid_config!(\n   114\t                read_quorum_size + write_quorum_size > num_nodes,\n   115\t                \"The quorums must overlap i.e., the sum of their sizes must exceed the # of nodes\"\n   116\t            );\n   117\t            valid_config!(\n   118\t                read_quorum_size >= 2 && read_quorum_size <= num_nodes,\n   119\t                \"Read quorum must be in range 2 to # of nodes in the cluster\"\n   120\t            );\n   121\t            valid_config!(\n   122\t                write_quorum_size >= 2 && write_quorum_size <= num_nodes,\n   123\t                \"Write quorum must be in range 2 to # of nodes in the cluster\"\n   124\t            );\n   125\t            valid_config!(\n   126\t                read_quorum_size >= write_quorum_size,\n   127\t                \"Read quorum size must be >= the write quorum size.\"\n   128\t            );\n   129\t        }\n   130\t        Ok(())\n   131\t    }\n   132\t\n   133\t    /// Checks all configuration fields and builds a local OmniPaxos node with settings for this\n   134\t    /// node defined in `server_config` and using storage `with_storage`.\n   135\t    pub fn build_for_server<T, B>(\n   136\t        self,\n   137\t        server_config: ServerConfig,\n   138\t        with_storage: B,\n   139\t    ) -> Result<OmniPaxos<T, B>, ConfigError>\n   140\t    where\n   141\t        T: Entry,\n   142\t        B: Storage<T>,\n   143\t    {\n   144\t        let op_config = OmniPaxosConfig {\n   145\t            cluster_config: self,\n   146\t            server_config,\n   147\t        };\n   148\t        op_config.build(with_storage)\n   149\t    }\n   150\t}\n   151\t\n   152\t/// Configuration for a singular `OmniPaxos` instance in a cluster.\n   153\t/// # Fields\n   154\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   155\t/// * `election_tick_timeout`: The number of calls to `tick()` before leader election is updated. If this is set to 5 and `tick()` is called every 10ms, then the election timeout will be 50ms. Must not be 0.\n   156\t/// * `resend_message_tick_timeout`: The number of calls to `tick()` before a message is considered dropped and thus resent. Must not be 0.\n   157\t/// * `buffer_size`: The buffer size for outgoing messages.\n   158\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   159\t/// * `logger_file_path`: The path where the default logger logs events.\n   160\t/// * `leader_priority` : Custom priority for this node to be elected as the leader.\n   161\t#[derive(Clone, Debug)]\n   162\t#[cfg_attr(feature = \"toml_config\", derive(Deserialize), serde(default))]\n   163\tpub struct ServerConfig {\n   164\t    /// The unique identifier of this node. Must not be 0.\n   165\t    pub pid: NodeId,\n   166\t    /// The number of calls to `tick()` before leader election is updated. If this is set to 5 and `tick()` is called every 10ms, then the election timeout will be 50ms.\n   167\t    pub election_tick_timeout: u64,\n   168\t    /// The number of calls to `tick()` before a message is considered dropped and thus resent. Must not be 0.\n   169\t    pub resend_message_tick_timeout: u64,\n   170\t    /// The buffer size for outgoing messages.\n   171\t    pub buffer_size: usize,\n   172\t    /// The size of the buffer for log batching. The default is 1, which means no batching.\n   173\t    pub batch_size: usize,\n   174\t    /// The number of calls to `tick()` before the batched log entries are flushed.\n   175\t    pub flush_batch_tick_timeout: u64,\n   176\t    /// Custom priority for this node to be elected as the leader.\n   177\t    pub leader_priority: u32,\n   178\t    /// The path where the default logger logs events.\n   179\t    #[cfg(feature = \"logging\")]\n   180\t    pub logger_file_path: Option<String>,\n   181\t    /// Custom logger, if provided, will be used instead of the default logger.\n   182\t    #[cfg(feature = \"logging\")]\n   183\t    #[cfg_attr(feature = \"toml_config\", serde(skip_deserializing))]\n   184\t    pub custom_logger: Option<slog::Logger>,\n   185\t}\n   186\t\n   187\timpl ServerConfig {\n   188\t    /// Checks that all the fields of the server config are valid.\n   189\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   190\t        valid_config!(self.pid != 0, \"Server pid cannot be 0\");\n43:    pub fn with(config_id: ConfigurationId, n: u32, priority: u32, pid: NodeId) -> Ballot {\n167:    pub(crate) fn handle(&mut self, m: BLEMessage) {\n260:    fn check_takeover(&mut self) {\n276:    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n290:    fn handle_reply(&mut self, rep: HeartbeatReply) {\n","exit_code":0,"status":"completed"}}
