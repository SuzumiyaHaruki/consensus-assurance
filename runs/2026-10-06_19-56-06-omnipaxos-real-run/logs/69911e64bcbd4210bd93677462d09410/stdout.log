{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '1,300p'; nl -ba ../agent-source/omnipaxos_runtime/src/traits.rs | head -150; grep -n 'fn\\\\|flush\\\\|transaction' ../agent-source/omnipaxos_storage/src/persistent_storage.rs\"","aggregated_output":"     1\tuse core::time::Duration;\n     2\tuse std::{\n     3\t    collections::{HashMap, VecDeque},\n     4\t    marker::PhantomData,\n     5\t    time::Instant,\n     6\t};\n     7\t\n     8\tuse futures::{channel::oneshot, select_biased, FutureExt, StreamExt};\n     9\t\n    10\tuse omnipaxos::{\n    11\t    ballot_leader_election::Ballot,\n    12\t    messages::{\n    13\t        async_runtime::{AsyncRuntimeMessage, AsyncRuntimeMsg, EntryId},\n    14\t        Message,\n    15\t    },\n    16\t    storage::{Entry, Storage},\n    17\t    util::{LogEntry, NodeId},\n    18\t    OmniPaxos, ProposeErr,\n    19\t};\n    20\t\n    21\tuse super::{\n    22\t    event::{AppendError, Command, OmniPaxosEvent},\n    23\t    handle::RuntimeConfig,\n    24\t    traits::{ActorEntry, AsyncRuntime},\n    25\t};\n    26\t\n    27\t/// Actor-loop-relevant subset of [`RuntimeConfig`]. Excludes the channel-capacity\n    28\t/// fields, which are only needed once, to construct the channels in `spawn_actor`\n    29\t/// before the actor itself is built — mirrors how `SequencePaxosConfig` in the core\n    30\t/// crate trims down the public `OmniPaxosConfig` to just what that component needs.\n    31\tpub(crate) struct ActorConfig {\n    32\t    tick_period: Duration,\n    33\t    egress_period: Duration,\n    34\t    append_notify_timeout: Duration,\n    35\t    max_pending_appends: usize,\n    36\t    max_decided_subscribers: usize,\n    37\t    max_outgoing_buffered: usize,\n    38\t}\n    39\t\n    40\timpl From<&RuntimeConfig> for ActorConfig {\n    41\t    fn from(cfg: &RuntimeConfig) -> Self {\n    42\t        Self {\n    43\t            tick_period: cfg.tick_period,\n    44\t            egress_period: cfg.egress_period,\n    45\t            append_notify_timeout: cfg.append_notify_timeout,\n    46\t            max_pending_appends: cfg.max_pending_appends,\n    47\t            max_decided_subscribers: cfg.max_decided_subscribers,\n    48\t            max_outgoing_buffered: cfg.max_outgoing_buffered,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\t/// A pending `append_notify` awaiting decision. Uniform representation regardless\n    54\t/// of whether the entry was accepted locally (we are leader) or forwarded (we are\n    55\t/// follower). The `assigned` field is filled in by either code path; the drain\n    56\t/// loop treats every pending item the same way.\n    57\tstruct Pending<T>\n    58\twhere\n    59\t    T: Entry,\n    60\t{\n    61\t    id: EntryId,\n    62\t    /// The entry, retained until dispatched (accepted locally or sent as a\n    63\t    /// `TaggedProposal`). While `Some`, `try_dispatch_undispatched` retries it\n    64\t    /// each tick — this is what lets `append_notify` be called before a\n    65\t    /// leader is known.\n    66\t    undispatched: Option<T>,\n    67\t    /// `(assigned_idx, ballot_at_assignment)`. `None` until either:\n    68\t    ///   (a) we accepted the entry ourselves as leader, or\n    69\t    ///   (b) we received `AsyncRuntimeMsg::Assigned` from the leader.\n    70\t    assigned: Option<(usize, Ballot)>,\n    71\t    deadline: Instant,\n    72\t    reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n    73\t}\n    74\t\n    75\t/// What to do, once its index is known, for a write buffered in the shared\n    76\t/// batch buffer. Every code path that can add to that buffer pushes one of\n    77\t/// these (see `track_untracked_batch_growth`), keeping `unconfirmed_local`'s\n    78\t/// FIFO position in sync with the buffer regardless of source.\n    79\tenum TrackIntent {\n    80\t    /// Not tracked: a plain `Command::Append`, or an entry that entered the\n    81\t    /// buffer via core-internal protocol handling we have no id for (a\n    82\t    /// forwarded proposal, replicated entries, a reconfiguration stopsign).\n    83\t    Untracked,\n    84\t    /// Resolve a pending `append_notify` we own directly, via `self.pending`,\n    85\t    /// once this index is known.\n    86\t    Local(EntryId),\n    87\t    /// Reply with `AsyncRuntimeMsg::Assigned` to `from` once this index is\n    88\t    /// known -- used for entries that arrived via a remote `TaggedProposal`\n    89\t    /// and got deferred by batching rather than accepted immediately (the\n    90\t    /// immediate case is handled inline by `handle_runtime_msg` instead).\n    91\t    Remote { id: EntryId, from: NodeId },\n    92\t}\n    93\t\n    94\tpub(crate) struct ActorState<T, B>\n    95\twhere\n    96\t    T: Entry,\n    97\t    B: Storage<T>,\n    98\t{\n    99\t    pub(crate) op: OmniPaxos<T, B>,\n   100\t    pub(crate) cmd_rx: async_channel::Receiver<Command<T>>,\n   101\t    pub(crate) incoming_rx: async_channel::Receiver<Message<T>>,\n   102\t    pub(crate) outgoing_tx: async_channel::Sender<Message<T>>,\n   103\t    pub(crate) event_tx: async_channel::Sender<OmniPaxosEvent>,\n   104\t    pub(crate) config: ActorConfig,\n   105\t\n   106\t    pid: NodeId,\n   107\t    outgoing_buf: Vec<Message<T>>,\n   108\t    pending: VecDeque<Pending<T>>,\n   109\t    decided_subscribers: Vec<DecidedSub<T>>,\n   110\t    last_leader: Option<(NodeId, bool)>,\n   111\t    last_decided_idx: usize,\n   112\t    last_reconfigured: bool,\n   113\t    /// One entry per write currently sitting in the shared per-node batch\n   114\t    /// buffer, in the order it was added, awaiting the flush that assigns it\n   115\t    /// an index. Popping one entry per unit of `get_accepted_idx()` advance\n   116\t    /// (`reconcile_unconfirmed`) lines up with what actually flushed. Paired\n   117\t    /// with the ballot in effect when buffered so a leader change before the\n   118\t    /// flush is detected rather than mis-assigned.\n   119\t    unconfirmed_local: VecDeque<(TrackIntent, Ballot)>,\n   120\t    last_seen_accepted_idx: usize,\n   121\t}\n   122\t\n   123\t/// A single subscriber to the decided-log stream. `next_idx` is the next log\n   124\t/// index the actor must deliver; incremented on every successful `try_send`.\n   125\tstruct DecidedSub<T>\n   126\twhere\n   127\t    T: Entry,\n   128\t{\n   129\t    next_idx: usize,\n   130\t    tx: async_channel::Sender<LogEntry<T>>,\n   131\t}\n   132\t\n   133\timpl<T, B> ActorState<T, B>\n   134\twhere\n   135\t    T: Entry,\n   136\t    B: Storage<T>,\n   137\t{\n   138\t    pub(crate) fn new(\n   139\t        op: OmniPaxos<T, B>,\n   140\t        cmd_rx: async_channel::Receiver<Command<T>>,\n   141\t        incoming_rx: async_channel::Receiver<Message<T>>,\n   142\t        outgoing_tx: async_channel::Sender<Message<T>>,\n   143\t        event_tx: async_channel::Sender<OmniPaxosEvent>,\n   144\t        config: ActorConfig,\n   145\t    ) -> Self {\n   146\t        let last_decided_idx = op.get_decided_idx();\n   147\t        let last_leader = op.get_current_leader();\n   148\t        let pid = op.get_pid();\n   149\t        let accepted_idx = op.get_accepted_idx();\n   150\t        Self {\n   151\t            op,\n   152\t            cmd_rx,\n   153\t            incoming_rx,\n   154\t            outgoing_tx,\n   155\t            event_tx,\n   156\t            config,\n   157\t            pid,\n   158\t            outgoing_buf: Vec::new(),\n   159\t            pending: VecDeque::new(),\n   160\t            decided_subscribers: Vec::new(),\n   161\t            last_leader,\n   162\t            last_decided_idx,\n   163\t            last_reconfigured: false,\n   164\t            unconfirmed_local: VecDeque::new(),\n   165\t            last_seen_accepted_idx: accepted_idx,\n   166\t        }\n   167\t    }\n   168\t\n   169\t    async fn detect_and_emit_events(&mut self) {\n   170\t        let cur = self.op.get_current_leader();\n   171\t        if cur != self.last_leader {\n   172\t            if let Some((pid, accepted)) = cur {\n   173\t                let _ = self\n   174\t                    .event_tx\n   175\t                    .send(OmniPaxosEvent::LeaderElected { pid, accepted })\n   176\t                    .await;\n   177\t            }\n   178\t            self.last_leader = cur;\n   179\t        }\n   180\t        let d = self.op.get_decided_idx();\n   181\t        if d > self.last_decided_idx {\n   182\t            let _ = self\n   183\t                .event_tx\n   184\t                .send(OmniPaxosEvent::Decided { new_decided_idx: d })\n   185\t                .await;\n   186\t            self.last_decided_idx = d;\n   187\t        }\n   188\t        if !self.last_reconfigured {\n   189\t            if let Some(_ss) = self.op.is_reconfigured() {\n   190\t                let _ = self\n   191\t                    .event_tx\n   192\t                    .send(OmniPaxosEvent::Reconfigured {\n   193\t                        stop_sign_idx: self.op.get_decided_idx(),\n   194\t                    })\n   195\t                    .await;\n   196\t                self.last_reconfigured = true;\n   197\t            }\n   198\t        }\n   199\t    }\n   200\t\n   201\t    fn drain_notifiers(&mut self) {\n   202\t        let decided = self.op.get_decided_idx();\n   203\t        let now = Instant::now();\n   204\t        let cur_ballot = self.op.get_promise();\n   205\t        let old = std::mem::take(&mut self.pending);\n   206\t        for p in old {\n   207\t            match p.assigned {\n   208\t                Some((idx, _)) if idx <= decided => {\n   209\t                    let _ = p.reply.send(Ok(idx));\n   210\t                }\n   211\t                Some((idx, ballot)) if ballot < cur_ballot => {\n   212\t                    let _ = p\n   213\t                        .reply\n   214\t                        .send(Err(AppendError::Superseded { log_entry_idx: idx }));\n   215\t                }\n   216\t                _ if now > p.deadline => {\n   217\t                    let _ = p.reply.send(Err(AppendError::Timeout));\n   218\t                }\n   219\t                _ => self.pending.push_back(p),\n   220\t            }\n   221\t        }\n   222\t    }\n   223\t\n   224\t    /// Effective cap for `outgoing_buf`: the channel's own capacity when known,\n   225\t    /// else [`ActorConfig::max_outgoing_buffered`].\n   226\t    fn outgoing_buf_cap(&self) -> usize {\n   227\t        self.outgoing_tx\n   228\t            .capacity()\n   229\t            .unwrap_or(self.config.max_outgoing_buffered)\n   230\t    }\n   231\t\n   232\t    /// Non-blocking drain of `outgoing_buf` onto `outgoing_tx`. Uses `try_send`\n   233\t    /// so a merely-full channel (slow consumer) doesn't block the actor loop;\n   234\t    /// unsent messages stay in `outgoing_buf` (in order) for the next attempt.\n   235\t    /// If the buffer exceeds [`Self::outgoing_buf_cap`], oldest messages are\n   236\t    /// dropped — see [`RuntimeConfig::max_outgoing_buffered`].\n   237\t    fn drain_outgoing_buf(&mut self) {\n   238\t        let cap = self.outgoing_buf_cap();\n   239\t        trim_oldest(&mut self.outgoing_buf, cap);\n   240\t\n   241\t        let pending = std::mem::take(&mut self.outgoing_buf);\n   242\t        let mut iter = pending.into_iter();\n   243\t        for msg in iter.by_ref() {\n   244\t            match self.outgoing_tx.try_send(msg) {\n   245\t                Ok(()) => {}\n   246\t                Err(async_channel::TrySendError::Full(msg)) => {\n   247\t                    self.outgoing_buf.push(msg);\n   248\t                    break;\n   249\t                }\n   250\t                Err(async_channel::TrySendError::Closed(_)) => {\n   251\t                    // Receiver dropped — user is not draining outgoing. Discard\n   252\t                    // everything remaining; nothing left to retry against.\n   253\t                    return;\n   254\t                }\n   255\t            }\n   256\t        }\n   257\t        self.outgoing_buf.extend(iter);\n   258\t    }\n   259\t\n   260\t    /// Enqueue one outgoing message without awaiting. Appends behind any\n   261\t    /// already-buffered messages (preserves order), then tries to drain.\n   262\t    /// Used for both core protocol traffic (via [`Self::flush_outgoing`]) and\n   263\t    /// runtime control-plane messages (`TaggedProposal` / `Assigned`).\n   264\t    fn enqueue_outgoing(&mut self, msg: Message<T>) {\n   265\t        self.outgoing_buf.push(msg);\n   266\t        self.drain_outgoing_buf();\n   267\t    }\n   268\t\n   269\t    /// Pull newly-produced OmniPaxos/BLE messages into `outgoing_buf` and drain.\n   270\t    fn flush_outgoing(&mut self) {\n   271\t        self.op.take_outgoing_messages(&mut self.outgoing_buf);\n   272\t        self.drain_outgoing_buf();\n   273\t    }\n   274\t\n   275\t    /// Push newly-decided entries to a single, freshly-added subscriber. Used\n   276\t    /// only on the immediate catch-up path from `Command::SubscribeDecided`,\n   277\t    /// where there is no shared read to amortize against. Returns `false` if\n   278\t    /// the receiver was already closed.\n   279\t    fn push_to_sub(op: &mut OmniPaxos<T, B>, sub: &mut DecidedSub<T>) -> bool {\n   280\t        let decided = op.get_decided_idx();\n   281\t        if sub.next_idx >= decided {\n   282\t            return true;\n   283\t        }\n   284\t        let Some(entries) = op.read_decided_suffix(sub.next_idx) else {\n   285\t            return true;\n   286\t        };\n   287\t        for entry in entries {\n   288\t            match sub.tx.try_send(entry) {\n   289\t                Ok(()) => sub.next_idx += 1,\n   290\t                Err(async_channel::TrySendError::Full(_)) => return true,\n   291\t                Err(async_channel::TrySendError::Closed(_)) => return false,\n   292\t            }\n   293\t        }\n   294\t        true\n   295\t    }\n   296\t\n   297\t    /// Push newly-decided entries to every subscriber, reading the log suffix\n   298\t    /// **once** and fanning out. Each sub keeps its own cursor, so slow subs\n   299\t    /// don't block fast ones; the storage read is amortized across all subs\n   300\t    /// starting from the trailing sub's position.\n     1\tuse core::{future::Future, time::Duration};\n     2\t\n     3\tuse omnipaxos::storage::Entry;\n     4\t\n     5\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n     6\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n     7\t/// covers any `Entry` whose associated types are `Send`.\n     8\t#[cfg(not(feature = \"unicache\"))]\n     9\tpub trait ActorEntry: Entry<Snapshot: Send> + Send + 'static {}\n    10\t\n    11\t#[cfg(not(feature = \"unicache\"))]\n    12\timpl<T> ActorEntry for T where T: Entry<Snapshot: Send> + Send + 'static {}\n    13\t\n    14\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n    15\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n    16\t/// covers any `Entry` whose associated types are `Send`.\n    17\t#[cfg(feature = \"unicache\")]\n    18\tpub trait ActorEntry:\n    19\t    Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n    20\t{\n    21\t}\n    22\t\n    23\t#[cfg(feature = \"unicache\")]\n    24\timpl<T> ActorEntry for T where\n    25\t    T: Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n    26\t{\n    27\t}\n    28\t\n    29\t/// Abstraction over an async executor.\n    30\t///\n    31\t/// Implement this trait to run OmniPaxos on runtimes other than tokio. Two primitives\n    32\t/// are required: task spawning and a timer. The actor loop builds intervals on top of\n    33\t/// [`AsyncRuntime::sleep`], so no separate `interval` primitive is needed.\n    34\tpub trait AsyncRuntime: 'static {\n    35\t    /// The join handle returned by [`AsyncRuntime::spawn`]. The runtime is free to\n    36\t    /// return `()` if it does not need cancellation or joining.\n    37\t    type JoinHandle: Send + 'static;\n    38\t\n    39\t    /// Spawn a future onto the executor.\n    40\t    fn spawn<F>(future: F) -> Self::JoinHandle\n    41\t    where\n    42\t        F: Future<Output = ()> + Send + 'static;\n    43\t\n    44\t    /// Return a future that resolves after `duration` elapses.\n    45\t    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static;\n    46\t}\n32:    pub fn get_path(&self) -> &String {\n37:    pub fn set_path(&mut self, path: String) {\n42:    pub fn get_log_options(&self) -> Options {\n47:    pub fn set_log_options(&mut self, log_opts: Options) {\n52:    pub fn get_database_options(&self) -> Options {\n57:    pub fn set_database_options(&mut self, opts: Options) {\n62:    pub fn with(path: String, log_options: Options, rocksdb_options: Options) -> Self {\n71:    pub fn with_path(path: String) -> Self {\n84:    fn default() -> Self {\n120:    pub fn open(storage_config: PersistentStorageConfig) -> Self {\n168:    pub fn new(storage_config: PersistentStorageConfig) -> Self {\n177:    fn get_log_handle(&self) -> ColumnFamilyRef<'_> {\n183:    fn batch_append_entry(&mut self, entry: T) -> StorageResult<()> {\n193:    fn batch_append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n205:    fn batch_append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n218:    fn batch_set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n224:    fn batch_set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n230:    fn batch_set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n236:    fn batch_set_compacted_idx(&mut self, trimmed_idx: usize) -> StorageResult<(