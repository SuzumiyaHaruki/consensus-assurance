{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '300,780p'\"","aggregated_output":"   300\t    /// starting from the trailing sub's position.\n   301\t    fn push_to_all_subs(&mut self) {\n   302\t        if self.decided_subscribers.is_empty() {\n   303\t            return;\n   304\t        }\n   305\t        let cur = self.op.get_decided_idx();\n   306\t        let min_next = self\n   307\t            .decided_subscribers\n   308\t            .iter()\n   309\t            .map(|s| s.next_idx)\n   310\t            .min()\n   311\t            .expect(\"non-empty checked above\");\n   312\t        if min_next >= cur {\n   313\t            return;\n   314\t        }\n   315\t        // Read once, from the trailing sub's position. `entries[i]` is the log\n   316\t        // entry at position `min_next + i`.\n   317\t        let Some(entries) = self.op.read_decided_suffix(min_next) else {\n   318\t            return;\n   319\t        };\n   320\t        // Fan out; drop closed subscribers in place via retain_mut.\n   321\t        self.decided_subscribers.retain_mut(|sub| {\n   322\t            // sub.next_idx should always be >= min_next; guard defensively.\n   323\t            let start = sub.next_idx.saturating_sub(min_next);\n   324\t            for entry in entries.iter().skip(start) {\n   325\t                match sub.tx.try_send(entry.clone()) {\n   326\t                    Ok(()) => sub.next_idx += 1,\n   327\t                    Err(async_channel::TrySendError::Full(_)) => break,\n   328\t                    Err(async_channel::TrySendError::Closed(_)) => return false,\n   329\t                }\n   330\t            }\n   331\t            true\n   332\t        });\n   333\t    }\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`, but the entry went to `buffered_proposals`\n   366\t    /// or out as a `ProposalForward`, not the shared batch buffer — pushing a\n   367\t    /// placeholder for that case would desync `unconfirmed_local`'s FIFO\n   368\t    /// count. `accept_as_leader`'s stable-leader gate means only plain\n   369\t    /// `Command::Append` can hit this case.\n   370\t    fn append_tracked(\n   371\t        &mut self,\n   372\t        intent: TrackIntent,\n   373\t        entry: T,\n   374\t    ) -> Result<Option<(usize, Ballot)>, ProposeErr<T>> {\n   375\t        let accepted_before = self.op.get_accepted_idx();\n   376\t        let batched_before = self.op.get_batched_len();\n   377\t        self.op.append(entry)?;\n   378\t        let accepted_after = self.op.get_accepted_idx();\n   379\t        let batched_after = self.op.get_batched_len();\n   380\t        if accepted_after > accepted_before {\n   381\t            let ballot = self.op.get_promise();\n   382\t            if let TrackIntent::Local(id) = intent {\n   383\t                self.record_assignment(id, accepted_after, ballot);\n   384\t            }\n   385\t            Ok(Some((accepted_after, ballot)))\n   386\t        } else if batched_after > batched_before {\n   387\t            // Genuinely deferred by batching.\n   388\t            self.unconfirmed_local\n   389\t                .push_back((intent, self.op.get_promise()));\n   390\t            Ok(None)\n   391\t        } else {\n   392\t            // Went somewhere else entirely (forwarded, or buffered pending a\n   393\t            // Prepare -> Accept transition) -- nothing entered the shared\n   394\t            // batch buffer, so there's nothing to track here.\n   395\t            Ok(None)\n   396\t        }\n   397\t    }\n   398\t\n   399\t    /// Leader-side accept, for an entry we originate locally (`from: None`)\n   400\t    /// or received via `TaggedProposal` from follower `from`. Populates the\n   401\t    /// pending's `assigned` (or, if buffered by batching, queues a\n   402\t    /// `TrackIntent` for `reconcile_unconfirmed` to resolve later) and\n   403\t    /// returns `(id, assigned_idx)` if accepted immediately, so batch callers\n   404\t    /// can collect these and send one `Assigned` reply for the whole batch.\n   405\t    fn accept_as_leader(\n   406\t        &mut self,\n   407\t        id: EntryId,\n   408\t        entry: T,\n   409\t        from: Option<NodeId>,\n   410\t    ) -> Option<(EntryId, usize)> {\n   411\t        // Only accept while leadership is stable (Accept phase).\n   412\t        let stable_leader =\n   413\t            matches!(self.op.get_current_leader(), Some((pid, true)) if pid == self.pid);\n   414\t        if !stable_leader {\n   415\t            return None;\n   416\t        }\n   417\t        let intent = match from {\n   418\t            None => TrackIntent::Local(id),\n   419\t            Some(from) => TrackIntent::Remote { id, from },\n   420\t        };\n   421\t        match self.append_tracked(intent, entry) {\n   422\t            Ok(Some((after, _ballot))) => Some((id, after)),\n   423\t            Ok(None) => None,\n   424\t            Err(err) => {\n   425\t                self.resolve_pending_failed(id, err);\n   426\t                None\n   427\t            }\n   428\t        }\n   429\t    }\n   430\t\n   431\t    /// Matches everything buffered in `unconfirmed_local` to the index it's\n   432\t    /// assigned once its batch flushes and `get_accepted_idx()` advances.\n   433\t    /// FIFO correspondence is exact here regardless of what added to the\n   434\t    /// shared batch buffer (see `unconfirmed_local`'s doc comment), as long as\n   435\t    /// the ballot hasn't changed since the entry was buffered; if it has,\n   436\t    /// leadership moved on and this index may belong to different writes, so\n   437\t    /// we drop tracking for it and let the caller time out.\n   438\t    fn reconcile_unconfirmed(&mut self) {\n   439\t        let cur_ballot = self.op.get_promise();\n   440\t        let accepted = self.op.get_accepted_idx();\n   441\t        let mut idx = self.last_seen_accepted_idx;\n   442\t        // Entries from a single remote TaggedProposal batch can resolve\n   443\t        // across several different `idx` values here (their own batch may\n   444\t        // have been interleaved with others' writes); group by origin so\n   445\t        // each gets one `Assigned` reply instead of one message per entry.\n   446\t        let mut remote_assigned: HashMap<NodeId, Vec<(EntryId, usize)>> = HashMap::new();\n   447\t        while idx < accepted {\n   448\t            idx += 1;\n   449\t            let Some((intent, ballot)) = self.unconfirmed_local.pop_front() else {\n   450\t                break;\n   451\t            };\n   452\t            if ballot != cur_ballot {\n   453\t                // Leadership moved on since this was buffered; the index may\n   454\t                // belong to different writes. Drop tracking -- Local/Remote\n   455\t                // origins simply time out, matching the ballot-mismatch\n   456\t                // handling in `drain_notifiers` for already-assigned entries.\n   457\t                continue;\n   458\t            }\n   459\t            match intent {\n   460\t                TrackIntent::Untracked => {}\n   461\t                TrackIntent::Local(id) => self.record_assignment(id, idx, ballot),\n   462\t                TrackIntent::Remote { id, from } => {\n   463\t                    remote_assigned.entry(from).or_default().push((id, idx));\n   464\t                }\n   465\t            }\n   466\t        }\n   467\t        self.last_seen_accepted_idx = accepted;\n   468\t\n   469\t        for (from, entries) in remote_assigned {\n   470\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   471\t                from: self.pid,\n   472\t                to: from,\n   473\t                msg: AsyncRuntimeMsg::Assigned {\n   474\t                    ballot: cur_ballot,\n   475\t                    entries,\n   476\t                },\n   477\t            }));\n   478\t        }\n   479\t    }\n   480\t\n   481\t    /// Attempt to dispatch every pending entry that hasn't yet been sent or\n   482\t    /// accepted locally. Called from `Command::AppendNotify` and on each tick,\n   483\t    /// which lets a call issued *before* an election eventually succeed once a\n   484\t    /// leader is known.\n   485\t    fn try_dispatch_undispatched(&mut self) {\n   486\t        let Some((leader, accepted)) = self.op.get_current_leader() else {\n   487\t            return;\n   488\t        };\n   489\t        if leader == self.pid && !accepted {\n   490\t            // We're leader but not yet in Accept phase — leave entries undispatched\n   491\t            // and wait for the next tick.\n   492\t            return;\n   493\t        }\n   494\t        let entries: Vec<(EntryId, T)> = self\n   495\t            .pending\n   496\t            .iter_mut()\n   497\t            .filter_map(|p| p.undispatched.take().map(|entry| (p.id, entry)))\n   498\t            .collect();\n   499\t        if leader == self.pid {\n   500\t            for (id, entry) in entries {\n   501\t                self.accept_as_leader(id, entry, None);\n   502\t            }\n   503\t        } else if !entries.is_empty() {\n   504\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   505\t                from: self.pid,\n   506\t                to: leader,\n   507\t                msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   508\t            }));\n   509\t        }\n   510\t    }\n   511\t\n   512\t    fn handle_runtime_msg(&mut self, arm: AsyncRuntimeMessage<T>) {\n   513\t        match arm.msg {\n   514\t            AsyncRuntimeMsg::TaggedProposal { entries } => {\n   515\t                let cur = self.op.get_current_leader().map(|(p, _)| p);\n   516\t                if cur == Some(self.pid) {\n   517\t                    // Collect accepted assignments and reply to the origin with a\n   518\t                    // single batched `Assigned`.\n   519\t                    let from = arm.from;\n   520\t                    let assigned: Vec<(EntryId, usize)> = entries\n   521\t                        .into_iter()\n   522\t                        .filter_map(|(id, entry)| self.accept_as_leader(id, entry, Some(from)))\n   523\t                        .collect();\n   524\t                    if !assigned.is_empty() {\n   525\t                        let ballot = self.op.get_promise();\n   526\t                        self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   527\t                            from: self.pid,\n   528\t                            to: arm.from,\n   529\t                            msg: AsyncRuntimeMsg::Assigned {\n   530\t                                ballot,\n   531\t                                entries: assigned,\n   532\t                            },\n   533\t                        }));\n   534\t                    }\n   535\t                } else if let Some(new_leader) = cur {\n   536\t                    // Leadership drifted since sender chose us. Hop the whole batch\n   537\t                    // forward, preserving the original `from` so the leader replies\n   538\t                    // to the true origin.\n   539\t                    self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   540\t                        from: arm.from,\n   541\t                        to: new_leader,\n   542\t                        msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   543\t                    }));\n   544\t                }\n   545\t                // Else: no leader; drop. Originators will timeout.\n   546\t            }\n   547\t            AsyncRuntimeMsg::Assigned { ballot, entries } => {\n   548\t                for (id, assigned_idx) in entries {\n   549\t                    self.record_assignment(id, assigned_idx, ballot);\n   550\t                }\n   551\t            }\n   552\t        }\n   553\t    }\n   554\t\n   555\t    /// Given a `(batched_len, accepted_idx)` snapshot taken before some call\n   556\t    /// that may have silently added to the shared batch buffer (a forwarded\n   557\t    /// proposal, an incoming replication batch, a reconfiguration stopsign),\n   558\t    /// pushes a `TrackIntent::Untracked` placeholder in `unconfirmed_local`\n   559\t    /// for each newly-added entry, keeping its FIFO count accurate.\n   560\t    ///\n   561\t    /// Growth is `(accepted_after - accepted_before) + (batched_after -\n   562\t    /// batched_before)`, computed with signed arithmetic and clamped at 0:\n   563\t    /// `accepted_idx` can legitimately *decrease* when a follower's log is\n   564\t    /// truncated by an incoming `AcceptSync` from a new leader, which isn't a\n   565\t    /// case with anything new to track.\n   566\t    fn track_batch_growth(&mut self, batched_before: usize, accepted_before: usize) {\n   567\t        let batched_after = self.op.get_batched_len();\n   568\t        let accepted_after = self.op.get_accepted_idx();\n   569\t        let added = accepted_after as isize - accepted_before as isize + batched_after as isize\n   570\t            - batched_before as isize;\n   571\t        let ballot = self.op.get_promise();\n   572\t        for _ in 0..added.max(0) {\n   573\t            self.unconfirmed_local\n   574\t                .push_back((TrackIntent::Untracked, ballot));\n   575\t        }\n   576\t    }\n   577\t\n   578\t    /// Delivers an incoming `SequencePaxos`/BLE message to the core, tracking\n   579\t    /// any entries it silently adds to the shared batch buffer -- see\n   580\t    /// `track_batch_growth`.\n   581\t    fn handle_incoming_tracked(&mut self, m: Message<T>) {\n   582\t        let batched_before = self.op.get_batched_len();\n   583\t        let accepted_before = self.op.get_accepted_idx();\n   584\t        self.op.handle_incoming(m);\n   585\t        self.track_batch_growth(batched_before, accepted_before);\n   586\t    }\n   587\t\n   588\t    async fn handle_command(&mut self, cmd: Command<T>) {\n   589\t        match cmd {\n   590\t            Command::Append { entry, reply } => {\n   591\t                // Via append_tracked (not self.op.append) so a deferred write\n   592\t                // still gets its unconfirmed_local placeholder, keeping FIFO\n   593\t                // position exact for any append_notify entries batched alongside it.\n   594\t                let res = self\n   595\t                    .append_tracked(TrackIntent::Untracked, entry)\n   596\t                    .map(|_| ());\n   597\t                let _ = reply.send(res);\n   598\t            }\n   599\t            Command::AppendNotify {\n   600\t                entry,\n   601\t                timeout,\n   602\t                reply,\n   603\t            } => {\n   604\t                if self.pending.len() >= self.config.max_pending_appends {\n   605\t                    let _ = reply.send(Err(AppendError::TooManyOutstanding));\n   606\t                    return;\n   607\t                }\n   608\t                let id = EntryId(uuid::Uuid::new_v4());\n   609\t                let timeout = timeout.unwrap_or(self.config.append_notify_timeout);\n   610\t                self.pending.push_back(Pending {\n   611\t                    id,\n   612\t                    undispatched: Some(entry),\n   613\t                    assigned: None,\n   614\t                    deadline: Instant::now() + timeout,\n   615\t                    reply,\n   616\t                });\n   617\t                self.try_dispatch_undispatched();\n   618\t            }\n   619\t            Command::CurrentLeader { reply } => {\n   620\t                let _ = reply.send(self.op.get_current_leader());\n   621\t            }\n   622\t            Command::DecidedIdx { reply } => {\n   623\t                let _ = reply.send(self.op.get_decided_idx());\n   624\t            }\n   625\t            Command::ReadDecidedSuffix { from, reply } => {\n   626\t                let _ = reply.send(self.op.read_decided_suffix(from));\n   627\t            }\n   628\t            Command::SubscribeDecided { from, tx } => {\n   629\t                if self.decided_subscribers.len() >= self.config.max_decided_subscribers {\n   630\t                    // Reject: drop `tx` without storing it, closing the\n   631\t                    // subscriber's channel immediately with no entries delivered.\n   632\t                    return;\n   633\t                }\n   634\t                let mut sub = DecidedSub { next_idx: from, tx };\n   635\t                // Immediate catch-up: push whatever is already decided from `from`.\n   636\t                if Self::push_to_sub(&mut self.op, &mut sub) {\n   637\t                    self.decided_subscribers.push(sub);\n   638\t                }\n   639\t            }\n   640\t            Command::Reconfigure {\n   641\t                new_configuration,\n   642\t                metadata,\n   643\t                reply,\n   644\t            } => {\n   645\t                // Wrapped like handle_incoming_tracked: a stopsign accepted as\n   646\t                // leader is itself an untracked addition to the shared batch buffer.\n   647\t                let batched_before = self.op.get_batched_len();\n   648\t                let accepted_before = self.op.get_accepted_idx();\n   649\t                let res = self.op.reconfigure(new_configuration, metadata);\n   650\t                self.track_batch_growth(batched_before, accepted_before);\n   651\t                let _ = reply.send(res);\n   652\t            }\n   653\t            Command::TryBecomeLeader => {\n   654\t                self.op.try_become_leader();\n   655\t            }\n   656\t            Command::Reconnected { pid } => {\n   657\t                self.op.reconnected(pid);\n   658\t            }\n   659\t        }\n   660\t    }\n   661\t}\n   662\t\n   663\t/// Drives the actor. Runs until all handles are dropped (both `cmd_tx` and\n   664\t/// `incoming_tx` senders closed).\n   665\tpub(crate) async fn run<T, B, R>(mut state: ActorState<T, B>, _rt: PhantomData<fn() -> R>)\n   666\twhere\n   667\t    T: ActorEntry,\n   668\t    B: Storage<T> + Send + 'static,\n   669\t    R: AsyncRuntime,\n   670\t{\n   671\t    let mut tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   672\t    let mut egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   673\t\n   674\t    // async_channel::Receiver is !Unpin; keep it in a Pin<Box<...>> so the Stream\n   675\t    // impl works under select_biased!.\n   676\t    let cmd_rx = std::mem::replace(&mut state.cmd_rx, async_channel::bounded(1).1);\n   677\t    let incoming_rx = std::mem::replace(&mut state.incoming_rx, async_channel::bounded(1).1);\n   678\t    let mut cmd_rx = Box::pin(cmd_rx);\n   679\t    let mut incoming_rx = Box::pin(incoming_rx);\n   680\t\n   681\t    loop {\n   682\t        select_biased! {\n   683\t            _ = tick_fut => {\n   684\t                state.op.tick();\n   685\t                state.detect_and_emit_events().await;\n   686\t                state.try_dispatch_undispatched();\n   687\t                state.reconcile_unconfirmed();\n   688\t                state.drain_notifiers();\n   689\t                state.push_to_all_subs();\n   690\t                tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   691\t            }\n   692\t            _ = egress_fut => {\n   693\t                state.flush_outgoing();\n   694\t                egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   695\t            }\n   696\t            in_msg = incoming_rx.next() => {\n   697\t                match in_msg {\n   698\t                    Some(Message::AsyncRuntime(arm)) => state.handle_runtime_msg(arm),\n   699\t                    Some(m) => state.handle_incoming_tracked(m),\n   700\t                    None => break,\n   701\t                }\n   702\t            }\n   703\t            cmd = cmd_rx.next() => {\n   704\t                match cmd {\n   705\t                    Some(c) => state.handle_command(c).await,\n   706\t                    None => break,\n   707\t                }\n   708\t            }\n   709\t        }\n   710\t    }\n   711\t}\n   712\t\n   713\t/// Drops the oldest elements of `buf` until its length is at most `cap`, preserving\n   714\t/// the relative order of what remains. A no-op if `buf` is already within `cap`.\n   715\tfn trim_oldest<M>(buf: &mut Vec<M>, cap: usize) {\n   716\t    if buf.len() > cap {\n   717\t        let excess = buf.len() - cap;\n   718\t        buf.drain(..excess);\n   719\t    }\n   720\t}\n   721\t\n   722\t#[cfg(test)]\n   723\tmod tests {\n   724\t    use super::trim_oldest;\n   725\t\n   726\t    #[test]\n   727\t    fn trim_oldest_drops_front_keeps_cap_most_recent() {\n   728\t        let mut buf = vec![1, 2, 3, 4, 5];\n   729\t        trim_oldest(&mut buf, 3);\n   730\t        assert_eq!(buf, vec![3, 4, 5]);\n   731\t    }\n   732\t\n   733\t    #[test]\n   734\t    fn trim_oldest_is_noop_when_within_cap() {\n   735\t        let mut buf = vec![1, 2, 3];\n   736\t        trim_oldest(&mut buf, 5);\n   737\t        assert_eq!(buf, vec![1, 2, 3]);\n   738\t    }\n   739\t\n   740\t    #[test]\n   741\t    fn trim_oldest_is_noop_when_exactly_at_cap() {\n   742\t        let mut buf = vec![1, 2, 3];\n   743\t        trim_oldest(&mut buf, 3);\n   744\t        assert_eq!(buf, vec![1, 2, 3]);\n   745\t    }\n   746\t\n   747\t    #[test]\n   748\t    fn trim_oldest_can_drop_everything() {\n   749\t        let mut buf = vec![1, 2, 3];\n   750\t        trim_oldest(&mut buf, 0);\n   751\t        assert!(buf.is_empty());\n   752\t    }\n   753\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '1,340p'; nl -ba ../agent-source/omnipaxos_runtime/src/event.rs | head -145; nl -ba ../agent-source/omnipaxos_storage/src/persistent_storage.rs | sed -n '115,167p;275,335p;353,405p'; nl -ba ../agent-source/omnipaxos/src/storage/mod.rs | sed -n '100,210p'; cat ../agent-source/omnipaxos_runtime/Cargo.toml; cat ../agent-source/omnipaxos/Cargo.toml\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '1,340p'; nl -ba ../agent-source/omnipaxos_runtime/src/event.rs | head -145; nl -ba ../agent-source/omnipaxos_storage/src/persistent_storage.rs | sed -n '115,167p;275,335p;353,405p'; nl -ba ../agent-source/omnipaxos/src/storage/mod.rs | sed -n '100,210p'; cat ../agent-source/omnipaxos_runtime/Cargo.toml; cat ../agent-source/omnipaxos/Cargo.toml\"","aggregated_output":"     1\tuse core::time::Duration;\n     2\tuse std::marker::PhantomData;\n     3\t\n     4\tuse futures::channel::oneshot;\n     5\t\n     6\tuse omnipaxos::{\n     7\t    messages::Message,\n     8\t    storage::{Entry, Storage},\n     9\t    util::{LogEntry, NodeId},\n    10\t    ClusterConfig, OmniPaxos,\n    11\t};\n    12\t\n    13\tuse super::{\n    14\t    actor::{run, ActorConfig, ActorState},\n    15\t    event::{AppendError, Command, OmniPaxosEvent, RuntimeProposeErr},\n    16\t    traits::{ActorEntry, AsyncRuntime},\n    17\t};\n    18\t\n    19\t/// Configuration for the async runtime actor.\n    20\t#[derive(Debug, Clone)]\n    21\tpub struct RuntimeConfig {\n    22\t    /// How often the actor calls `tick()` on the underlying OmniPaxos.\n    23\t    /// Should match the tick timeout budget used when building `ServerConfig`.\n    24\t    pub tick_period: Duration,\n    25\t    /// How often outgoing messages are drained and forwarded on the `outgoing_messages`\n    26\t    /// channel.\n    27\t    pub egress_period: Duration,\n    28\t    /// Bounded capacity for the actor's command channel.\n    29\t    pub cmd_channel_capacity: usize,\n    30\t    /// Bounded capacity for the outgoing message channel.\n    31\t    pub outgoing_capacity: usize,\n    32\t    /// Bounded capacity for the incoming message channel.\n    33\t    pub incoming_capacity: usize,\n    34\t    /// Bounded capacity for the event channel.\n    35\t    pub event_capacity: usize,\n    36\t    /// How long an `append_notify` call waits for its entry to be decided before\n    37\t    /// resolving with [`AppendError::Timeout`](super::AppendError::Timeout).\n    38\t    pub append_notify_timeout: Duration,\n    39\t    /// Bounded capacity for each per-subscriber decided-log stream returned by\n    40\t    /// [`OmniPaxosHandle::subscribe_decided`].\n    41\t    pub decided_channel_capacity: usize,\n    42\t    /// Maximum number of concurrently outstanding `append_notify` calls (i.e.\n    43\t    /// calls that have not yet resolved). Once reached, further `append_notify`\n    44\t    /// calls are rejected immediately with [`AppendError::TooManyOutstanding`]\n    45\t    /// rather than queued, so a stalled cluster (e.g. no leader) can't grow this\n    46\t    /// backlog without bound.\n    47\t    pub max_pending_appends: usize,\n    48\t    /// Maximum number of concurrent [`OmniPaxosHandle::subscribe_decided`]\n    49\t    /// subscribers. Once reached, a new subscription is rejected: the returned\n    50\t    /// receiver's channel is closed immediately without delivering any entries.\n    51\t    pub max_decided_subscribers: usize,\n    52\t    /// Fallback cap on how many outgoing messages the actor buffers internally\n    53\t    /// while waiting for room on the (bounded) `outgoing_messages` channel,\n    54\t    /// used only if that channel's own capacity can't be read. Past this cap,\n    55\t    /// the *oldest* buffered messages are dropped rather than growing without\n    56\t    /// bound -- safe because OmniPaxos already tolerates lost messages via its\n    57\t    /// own resend/retry mechanisms.\n    58\t    pub max_outgoing_buffered: usize,\n    59\t}\n    60\t\n    61\timpl Default for RuntimeConfig {\n    62\t    fn default() -> Self {\n    63\t        Self {\n    64\t            tick_period: Duration::from_millis(10),\n    65\t            egress_period: Duration::from_millis(1),\n    66\t            cmd_channel_capacity: 1024,\n    67\t            outgoing_capacity: 10_000,\n    68\t            incoming_capacity: 10_000,\n    69\t            event_capacity: 1024,\n    70\t            append_notify_timeout: Duration::from_secs(5),\n    71\t            decided_channel_capacity: 1024,\n    72\t            max_pending_appends: 1024,\n    73\t            max_decided_subscribers: 128,\n    74\t            max_outgoing_buffered: 10_000,\n    75\t        }\n    76\t    }\n    77\t}\n    78\t\n    79\t/// A cloneable, `Send + Sync` handle to an OmniPaxos actor running in the background.\n    80\t///\n    81\t/// All state-mutating and read methods are `async`. Users must drive message transport\n    82\t/// externally via [`OmniPaxosHandle::outgoing_messages`] and\n    83\t/// [`OmniPaxosHandle::handle_incoming`]. Dropping every clone shuts the actor down.\n    84\tpub struct OmniPaxosHandle<T>\n    85\twhere\n    86\t    T: Entry,\n    87\t{\n    88\t    cmd_tx: async_channel::Sender<Command<T>>,\n    89\t    events_rx: async_channel::Receiver<OmniPaxosEvent>,\n    90\t    outgoing_rx: async_channel::Receiver<Message<T>>,\n    91\t    incoming_tx: async_channel::Sender<Message<T>>,\n    92\t    decided_channel_capacity: usize,\n    93\t}\n    94\t\n    95\timpl<T> Clone for OmniPaxosHandle<T>\n    96\twhere\n    97\t    T: Entry,\n    98\t{\n    99\t    fn clone(&self) -> Self {\n   100\t        Self {\n   101\t            cmd_tx: self.cmd_tx.clone(),\n   102\t            events_rx: self.events_rx.clone(),\n   103\t            outgoing_rx: self.outgoing_rx.clone(),\n   104\t            incoming_tx: self.incoming_tx.clone(),\n   105\t            decided_channel_capacity: self.decided_channel_capacity,\n   106\t        }\n   107\t    }\n   108\t}\n   109\t\n   110\timpl<T> OmniPaxosHandle<T>\n   111\twhere\n   112\t    T: Entry + Send + 'static,\n   113\t{\n   114\t    /// Append an entry and await its decided log index.\n   115\t    ///\n   116\t    /// Works from any node: the actor tags the entry with a unique id, routes it to\n   117\t    /// the current leader, and resolves the future when the assigned log index is\n   118\t    /// decided. If no leader is known yet, the call waits rather than failing fast --\n   119\t    /// it resolves once a leader is elected, or with `Timeout` if none is elected in\n   120\t    /// time. Fails with:\n   121\t    /// - [`AppendError::Timeout`] if the entry is not decided within\n   122\t    ///   [`RuntimeConfig::append_notify_timeout`] (including when no leader was ever\n   123\t    ///   elected in that time);\n   124\t    /// - [`AppendError::Propose`] if the underlying propose call itself failed (e.g. a\n   125\t    ///   reconfiguration is already pending) -- only when this node owns the pending\n   126\t    ///   call, otherwise it still resolves via `Timeout`;\n   127\t    /// - [`AppendError::Superseded`] if a leader change occurred before decision --\n   128\t    ///   a heuristic, not a certainty; see its doc comment for why, and check the\n   129\t    ///   returned index yourself if you need to know for sure;\n   130\t    /// - [`AppendError::TooManyOutstanding`] if [`RuntimeConfig::max_pending_appends`]\n   131\t    ///   outstanding calls are already queued.\n   132\t    ///\n   133\t    /// Uses [`RuntimeConfig::append_notify_timeout`] as the deadline; use\n   134\t    /// [`Self::append_notify_with_timeout`] to override it for a single call.\n   135\t    pub async fn append_notify(&self, entry: T) -> Result<usize, AppendError<T>> {\n   136\t        self.append_notify_inner(entry, None).await\n   137\t    }\n   138\t\n   139\t    /// Same as [`append_notify`](Self::append_notify), but `timeout` overrides\n   140\t    /// [`RuntimeConfig::append_notify_timeout`] for this call only -- e.g. to give a\n   141\t    /// latency-sensitive caller a shorter deadline, or a bulk/background caller a\n   142\t    /// longer one, without changing the default for every other call.\n   143\t    pub async fn append_notify_with_timeout(\n   144\t        &self,\n   145\t        entry: T,\n   146\t        timeout: Duration,\n   147\t    ) -> Result<usize, AppendError<T>> {\n   148\t        self.append_notify_inner(entry, Some(timeout)).await\n   149\t    }\n   150\t\n   151\t    async fn append_notify_inner(\n   152\t        &self,\n   153\t        entry: T,\n   154\t        timeout: Option<Duration>,\n   155\t    ) -> Result<usize, AppendError<T>> {\n   156\t        let (tx, rx) = oneshot::channel();\n   157\t        self.cmd_tx\n   158\t            .send(Command::AppendNotify {\n   159\t                entry,\n   160\t                timeout,\n   161\t                reply: tx,\n   162\t            })\n   163\t            .await\n   164\t            .map_err(|_| AppendError::Shutdown)?;\n   165\t        rx.await.unwrap_or(Err(AppendError::Shutdown))\n   166\t    }\n   167\t\n   168\t    /// Append an entry without waiting for decision. Mirrors the sync API.\n   169\t    pub async fn append(&self, entry: T) -> Result<(), RuntimeProposeErr<T>> {\n   170\t        let (tx, rx) = oneshot::channel();\n   171\t        self.cmd_tx\n   172\t            .send(Command::Append { entry, reply: tx })\n   173\t            .await\n   174\t            .map_err(|_| RuntimeProposeErr::Shutdown)?;\n   175\t        match rx.await {\n   176\t            Ok(res) => res.map_err(RuntimeProposeErr::Propose),\n   177\t            Err(_) => Err(RuntimeProposeErr::Shutdown),\n   178\t        }\n   179\t    }\n   180\t\n   181\t    /// Ask the actor for the current leader.\n   182\t    pub async fn current_leader(&self) -> Option<(NodeId, bool)> {\n   183\t        let (tx, rx) = oneshot::channel();\n   184\t        if self\n   185\t            .cmd_tx\n   186\t            .send(Command::CurrentLeader { reply: tx })\n   187\t            .await\n   188\t            .is_err()\n   189\t        {\n   190\t            return None;\n   191\t        }\n   192\t        rx.await.unwrap_or(None)\n   193\t    }\n   194\t\n   195\t    /// Ask the actor for the current decided index.\n   196\t    pub async fn decided_idx(&self) -> usize {\n   197\t        let (tx, rx) = oneshot::channel();\n   198\t        if self\n   199\t            .cmd_tx\n   200\t            .send(Command::DecidedIdx { reply: tx })\n   201\t            .await\n   202\t            .is_err()\n   203\t        {\n   204\t            return 0;\n   205\t        }\n   206\t        rx.await.unwrap_or(0)\n   207\t    }\n   208\t\n   209\t    /// Ask the actor for a slice of the decided log starting at `from`.\n   210\t    pub async fn read_decided_suffix(&self, from: usize) -> Option<Vec<LogEntry<T>>> {\n   211\t        let (tx, rx) = oneshot::channel();\n   212\t        if self\n   213\t            .cmd_tx\n   214\t            .send(Command::ReadDecidedSuffix { from, reply: tx })\n   215\t            .await\n   216\t            .is_err()\n   217\t        {\n   218\t            return None;\n   219\t        }\n   220\t        rx.await.unwrap_or(None)\n   221\t    }\n   222\t\n   223\t    /// Propose a cluster reconfiguration.\n   224\t    pub async fn reconfigure(\n   225\t        &self,\n   226\t        new_configuration: ClusterConfig,\n   227\t        metadata: Option<Vec<u8>>,\n   228\t    ) -> Result<(), RuntimeProposeErr<T>> {\n   229\t        let (tx, rx) = oneshot::channel();\n   230\t        self.cmd_tx\n   231\t            .send(Command::Reconfigure {\n   232\t                new_configuration,\n   233\t                metadata,\n   234\t                reply: tx,\n   235\t            })\n   236\t            .await\n   237\t            .map_err(|_| RuntimeProposeErr::Shutdown)?;\n   238\t        match rx.await {\n   239\t            Ok(res) => res.map_err(RuntimeProposeErr::Propose),\n   240\t            Err(_) => Err(RuntimeProposeErr::Shutdown),\n   241\t        }\n   242\t    }\n   243\t\n   244\t    /// Attempt to become the leader by incrementing the local ballot.\n   245\t    pub async fn try_become_leader(&self) {\n   246\t        let _ = self.cmd_tx.send(Command::TryBecomeLeader).await;\n   247\t    }\n   248\t\n   249\t    /// Notify the actor that a previously disconnected peer is reachable again.\n   250\t    pub async fn reconnected(&self, pid: NodeId) {\n   251\t        let _ = self.cmd_tx.send(Command::Reconnected { pid }).await;\n   252\t    }\n   253\t\n   254\t    /// Subscribe to state-transition events. Each event is delivered to exactly one\n   255\t    /// receiver: if you clone the returned receiver, the clones share the queue.\n   256\t    /// For fan-out to multiple independent subscribers, wrap in a broadcasting task.\n   257\t    pub fn subscribe_events(&self) -> async_channel::Receiver<OmniPaxosEvent> {\n   258\t        self.events_rx.clone()\n   259\t    }\n   260\t\n   261\t    /// Subscribe to decided log entries, starting at `from`. Returns a receiver\n   262\t    /// that emits [`LogEntry`]s in log order — both the backlog already decided\n   263\t    /// at subscription time and entries decided later.\n   264\t    ///\n   265\t    /// Each call creates an independent subscription with its own cursor;\n   266\t    /// multiple subscribers can coexist, up to [`RuntimeConfig::max_decided_subscribers`]\n   267\t    /// — beyond that, the returned receiver's channel is closed immediately\n   268\t    /// without delivering any entries. Dropping the receiver ends the\n   269\t    /// subscription; slow subscribers apply backpressure by causing the actor\n   270\t    /// to defer pushes rather than blocking the actor loop.\n   271\t    pub async fn subscribe_decided(&self, from: usize) -> async_channel::Receiver<LogEntry<T>> {\n   272\t        let (tx, rx) = async_channel::bounded(self.decided_channel_capacity);\n   273\t        // If the actor is gone, `rx` stays open but never receives — the\n   274\t        // caller's stream drops naturally when the sender is dropped here.\n   275\t        let _ = self\n   276\t            .cmd_tx\n   277\t            .send(Command::SubscribeDecided { from, tx })\n   278\t            .await;\n   279\t        rx\n   280\t    }\n   281\t\n   282\t    /// Returns a receiver from which outgoing messages should be drained and forwarded\n   283\t    /// by the application's transport.\n   284\t    pub fn outgoing_messages(&self) -> async_channel::Receiver<Message<T>> {\n   285\t        self.outgoing_rx.clone()\n   286\t    }\n   287\t\n   288\t    /// Deliver an incoming message from the network to the actor.\n   289\t    pub async fn handle_incoming(&self, m: Message<T>) {\n   290\t        let _ = self.incoming_tx.send(m).await;\n   291\t    }\n   292\t}\n   293\t\n   294\t/// Spawn the actor and return a handle to it.\n   295\tpub fn spawn_actor<T, B, R>(op: OmniPaxos<T, B>, cfg: RuntimeConfig) -> OmniPaxosHandle<T>\n   296\twhere\n   297\t    T: ActorEntry,\n   298\t    B: Storage<T> + Send + 'static,\n   299\t    R: AsyncRuntime,\n   300\t{\n   301\t    let (cmd_tx, cmd_rx) = async_channel::bounded(cfg.cmd_channel_capacity);\n   302\t    let (outgoing_tx, outgoing_rx) = async_channel::bounded(cfg.outgoing_capacity);\n   303\t    let (incoming_tx, incoming_rx) = async_channel::bounded(cfg.incoming_capacity);\n   304\t    let (event_tx, events_rx) = async_channel::bounded(cfg.event_capacity);\n   305\t\n   306\t    let state = ActorState::new(\n   307\t        op,\n   308\t        cmd_rx,\n   309\t        incoming_rx,\n   310\t        outgoing_tx,\n   311\t        event_tx,\n   312\t        ActorConfig::from(&cfg),\n   313\t    );\n   314\t\n   315\t    R::spawn(run::<T, B, R>(state, PhantomData::<fn() -> R>));\n   316\t\n   317\t    OmniPaxosHandle {\n   318\t        cmd_tx,\n   319\t        events_rx,\n   320\t        outgoing_rx,\n   321\t        incoming_tx,\n   322\t        decided_channel_capacity: cfg.decided_channel_capacity,\n   323\t    }\n   324\t}\n     1\tuse core::time::Duration;\n     2\t\n     3\tuse futures::channel::oneshot;\n     4\t\n     5\tuse omnipaxos::{\n     6\t    storage::Entry,\n     7\t    util::{LogEntry, NodeId},\n     8\t    ClusterConfig, ProposeErr,\n     9\t};\n    10\t\n    11\t/// A state transition observed by the actor and broadcast on the event stream.\n    12\t#[derive(Debug, Clone)]\n    13\tpub enum OmniPaxosEvent {\n    14\t    /// A new leader was observed on this node.\n    15\t    LeaderElected {\n    16\t        /// The pid of the elected leader.\n    17\t        pid: NodeId,\n    18\t        /// Whether this node's phase is `Phase::Accept`.\n    19\t        accepted: bool,\n    20\t    },\n    21\t    /// The decided index advanced. The value is the new decided index.\n    22\t    Decided {\n    23\t        /// The new decided index.\n    24\t        new_decided_idx: usize,\n    25\t    },\n    26\t    /// A reconfiguration StopSign was decided.\n    27\t    Reconfigured {\n    28\t        /// The log index at which the StopSign was decided.\n    29\t        stop_sign_idx: usize,\n    30\t    },\n    31\t}\n    32\t\n    33\t/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n    34\t#[derive(Debug)]\n    35\tpub enum AppendError<T>\n    36\twhere\n    37\t    T: Entry,\n    38\t{\n    39\t    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n    40\t    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n    41\t    /// pending). Unlike the other variants, this is resolved immediately rather than\n    42\t    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n    43\t    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n    44\t    /// leader). If the failure happens on a different node than the origin, the origin\n    45\t    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n    46\t    /// require a new wire message.\n    47\t    Propose(ProposeErr<T>),\n    48\t    /// A leader change occurred after the entry was accepted at the given index but\n    49\t    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n    50\t    /// required to adopt any value a majority-overlapping quorum may have already\n    51\t    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n    52\t    /// new ballot -- we just stop waiting rather than confirm it. Check\n    53\t    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n    54\t    /// at that index if you need to know for sure before re-appending.\n    55\t    Superseded {\n    56\t        /// The log index the entry was assigned before the leader change.\n    57\t        log_entry_idx: usize,\n    58\t    },\n    59\t    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n    60\t    Timeout,\n    61\t    /// The actor has shut down before the entry could be decided.\n    62\t    Shutdown,\n    63\t    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n    64\t    /// outstanding `append_notify` calls; this one was rejected immediately rather\n    65\t    /// than queued. Nothing was proposed, so it's safe to retry (ideally after a\n    66\t    /// backoff, since the backlog needs time to drain).\n    67\t    TooManyOutstanding,\n    68\t}\n    69\t\n    70\t/// Error returned by [`OmniPaxosHandle::append`](super::OmniPaxosHandle::append) and\n    71\t/// [`OmniPaxosHandle::reconfigure`](super::OmniPaxosHandle::reconfigure). Distinct from\n    72\t/// [`AppendError`]: these calls don't track decision, so they only ever fail\n    73\t/// synchronously -- either the propose call itself was rejected, or the actor is gone.\n    74\t#[derive(Debug)]\n    75\tpub enum RuntimeProposeErr<T>\n    76\twhere\n    77\t    T: Entry,\n    78\t{\n    79\t    /// The underlying propose call failed (e.g. a reconfiguration is already pending,\n    80\t    /// or an invalid cluster config was proposed).\n    81\t    Propose(ProposeErr<T>),\n    82\t    /// The actor has shut down.\n    83\t    Shutdown,\n    84\t}\n    85\t\n    86\t/// Commands sent from an [`OmniPaxosHandle`](super::OmniPaxosHandle) to the actor task.\n    87\t///\n    88\t/// This type is `pub(crate)` because it is an implementation detail of the actor <-> handle\n    89\t/// protocol.\n    90\tpub(crate) enum Command<T>\n    91\twhere\n    92\t    T: Entry,\n    93\t{\n    94\t    Append {\n    95\t        entry: T,\n    96\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n    97\t    },\n    98\t    AppendNotify {\n    99\t        entry: T,\n   100\t        /// Overrides [`RuntimeConfig::append_notify_timeout`](super::RuntimeConfig::append_notify_timeout)\n   101\t        /// for this call only, if `Some`.\n   102\t        timeout: Option<Duration>,\n   103\t        reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n   104\t    },\n   105\t    CurrentLeader {\n   106\t        reply: oneshot::Sender<Option<(NodeId, bool)>>,\n   107\t    },\n   108\t    DecidedIdx {\n   109\t        reply: oneshot::Sender<usize>,\n   110\t    },\n   111\t    ReadDecidedSuffix {\n   112\t        from: usize,\n   113\t        reply: oneshot::Sender<Option<Vec<LogEntry<T>>>>,\n   114\t    },\n   115\t    SubscribeDecided {\n   116\t        from: usize,\n   117\t        tx: async_channel::Sender<LogEntry<T>>,\n   118\t    },\n   119\t    Reconfigure {\n   120\t        new_configuration: ClusterConfig,\n   121\t        metadata: Option<Vec<u8>>,\n   122\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n   123\t    },\n   124\t    TryBecomeLeader,\n   125\t    Reconnected {\n   126\t        pid: NodeId,\n   127\t    },\n   128\t}\n   115\twhere\n   116\t    T: Entry + Serialize + for<'a> Deserialize<'a>,\n   117\t    T::Snapshot: Serialize + for<'a> Deserialize<'a>,\n   118\t{\n   119\t    /// Creates or opens an existing storage\n   120\t    pub fn open(storage_config: PersistentStorageConfig) -> Self {\n   121\t        // Create database with log column\n   122\t        let path = storage_config.path;\n   123\t        let log_cf = ColumnFamilyDescriptor::new(LOG, storage_config.log_options);\n   124\t        let db_opts = storage_config.rocksdb_options;\n   125\t        let db = rocksdb::DB::open_cf_descriptors(&db_opts, path, vec![log_cf])\n   126\t            .expect(\"Failed to create RocksDB\");\n   127\t        let log_handle = db\n   128\t            .cf_handle(LOG)\n   129\t            .expect(\"Failed to create RocksDB log column family\");\n   130\t\n   131\t        // Create next log key from the state of the database\n   132\t        let mut log_iter = db.raw_iterator_cf(log_handle);\n   133\t        log_iter.seek_to_last();\n   134\t        let next_log_key = if log_iter.valid() {\n   135\t            // There's a max key in the database. Next key is 1 greater.\n   136\t            let key = log_iter.key().unwrap();\n   137\t            assert_eq!(\n   138\t                key.len(),\n   139\t                8,\n   140\t                \"Couldn't recover storage: Log key has unexpected format.\"\n   141\t            );\n   142\t            usize::from_be_bytes([\n   143\t                key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7],\n   144\t            ]) + 1\n   145\t        } else {\n   146\t            // No max key in the database. Either there's no entry yet added or they have been\n   147\t            // trimmed away.\n   148\t            match db\n   149\t                .get(TRIM)\n   150\t                .expect(\"Couldn't recover storage: Reading compacted_idx failed.\")\n   151\t            {\n   152\t                Some(bytes) => usize::read_from(bytes.as_bytes())\n   153\t                    .expect(\"Couldn't recover storage: Commpacted index has unexpected format.\"),\n   154\t                None => 0,\n   155\t            }\n   156\t        };\n   157\t        drop(log_iter);\n   158\t\n   159\t        Self {\n   160\t            db,\n   161\t            write_batch: WriteBatchWithTransaction::<false>::default(),\n   162\t            next_log_key,\n   163\t            t: PhantomData,\n   164\t        }\n   165\t    }\n   166\t\n   167\t    /// Creates a new storage instance, panics if a RocksDB instance already exists in the given path\n   275\t    T: Entry + Serialize + for<'a> Deserialize<'a>,\n   276\t    T::Snapshot: Serialize + for<'a> Deserialize<'a>,\n   277\t{\n   278\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n   279\t        for op in ops {\n   280\t            match op {\n   281\t                StorageOp::AppendEntry(entry) => self.batch_append_entry(entry)?,\n   282\t                StorageOp::AppendEntries(entries) => self.batch_append_entries(entries)?,\n   283\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n   284\t                    self.batch_append_on_prefix(from_idx, entries)?\n   285\t                }\n   286\t                StorageOp::SetPromise(bal) => self.batch_set_promise(bal)?,\n   287\t                StorageOp::SetDecidedIndex(idx) => self.batch_set_decided_idx(idx)?,\n   288\t                StorageOp::SetAcceptedRound(bal) => self.batch_set_accepted_round(bal)?,\n   289\t                StorageOp::SetCompactedIdx(idx) => self.batch_set_compacted_idx(idx)?,\n   290\t                StorageOp::Trim(idx) => self.batch_trim(idx)?,\n   291\t                StorageOp::SetStopsign(ss) => self.batch_set_stopsign(ss)?,\n   292\t                StorageOp::SetSnapshot(snap) => self.batch_set_snapshot(snap)?,\n   293\t            }\n   294\t        }\n   295\t        Ok(self.db.write(std::mem::take(&mut self.write_batch))?)\n   296\t    }\n   297\t\n   298\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n   299\t        let entry_bytes = bincode::serialize(&entry)?;\n   300\t        self.db.put_cf(\n   301\t            self.get_log_handle(),\n   302\t            self.next_log_key.to_be_bytes(),\n   303\t            entry_bytes,\n   304\t        )?;\n   305\t        self.next_log_key += 1;\n   306\t        Ok(())\n   307\t    }\n   308\t\n   309\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n   310\t        let mut batch = WriteBatchWithTransaction::<false>::default();\n   311\t        for entry in entries {\n   312\t            batch.put_cf(\n   313\t                self.get_log_handle(),\n   314\t                self.next_log_key.to_be_bytes(),\n   315\t                bincode::serialize(&entry)?,\n   316\t            );\n   317\t            self.next_log_key += 1;\n   318\t        }\n   319\t        self.db.write(batch)?;\n   320\t        Ok(())\n   321\t    }\n   322\t\n   323\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n   324\t        // Don't need to delete entries that will be overwritten.\n   325\t        let delete_idx = from_idx + entries.len();\n   326\t        if delete_idx < self.next_log_key {\n   327\t            let from_key = delete_idx.to_be_bytes();\n   328\t            let to_key = self.next_log_key.to_be_bytes();\n   329\t            self.db\n   330\t                .delete_range_cf(self.get_log_handle(), from_key, to_key)?;\n   331\t        }\n   332\t        self.next_log_key = from_idx;\n   333\t        self.append_entries(entries)\n   334\t    }\n   335\t\n   353\t    fn get_log_len(&self) -> StorageResult<usize> {\n   354\t        Ok(self.next_log_key - self.get_compacted_idx()?)\n   355\t    }\n   356\t\n   357\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   358\t        self.get_entries(from, self.next_log_key)\n   359\t    }\n   360\t\n   361\t    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n   362\t        let promise = self.db.get_pinned(NPROM)?;\n   363\t        match promise {\n   364\t            Some(pinned_bytes) => Ok(Some(bincode::deserialize(&pinned_bytes)?)),\n   365\t            None => Ok(None),\n   366\t        }\n   367\t    }\n   368\t\n   369\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   370\t        let prom_bytes = bincode::serialize(&n_prom)?;\n   371\t        self.db.put(NPROM, prom_bytes)?;\n   372\t        Ok(())\n   373\t    }\n   374\t\n   375\t    fn get_decided_idx(&self) -> StorageResult<usize> {\n   376\t        let decided = self.db.get_pinned(DECIDE)?;\n   377\t        match decided {\n   378\t            Some(ld_bytes) => Ok(usize::read_from(ld_bytes.as_bytes()).ok_or(ErrHelper {})?),\n   379\t            None => Ok(0),\n   380\t        }\n   381\t    }\n   382\t\n   383\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n   384\t        let ld_bytes = usize::as_bytes(&ld);\n   385\t        self.db.put(DECIDE, ld_bytes)?;\n   386\t        Ok(())\n   387\t    }\n   388\t\n   389\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n   390\t        let accepted = self.db.get_pinned(ACC)?;\n   391\t        match accepted {\n   392\t            Some(acc_bytes) => {\n   393\t                let ballot = bincode::deserialize(&acc_bytes)?;\n   394\t                Ok(Some(ballot))\n   395\t            }\n   396\t            None => Ok(None),\n   397\t        }\n   398\t    }\n   399\t\n   400\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n   401\t        let acc_bytes = bincode::serialize(&na)?;\n   402\t        self.db.put(ACC, acc_bytes)?;\n   403\t        Ok(())\n   404\t    }\n   405\t\n   100\t/// The write operations of the storge implementation.\n   101\t#[derive(Debug)]\n   102\tpub enum StorageOp<T: Entry> {\n   103\t    /// Appends an entry to the end of the log.\n   104\t    AppendEntry(T),\n   105\t    /// Appends entries to the end of the log.\n   106\t    AppendEntries(Vec<T>),\n   107\t    /// Appends entries to the log from the prefix specified by the given index.\n   108\t    AppendOnPrefix(usize, Vec<T>),\n   109\t    /// Sets the round that has been promised.\n   110\t    SetPromise(Ballot),\n   111\t    /// Sets the decided index in the log.\n   112\t    SetDecidedIndex(usize),\n   113\t    /// Sets the latest accepted round.\n   114\t    SetAcceptedRound(Ballot),\n   115\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   116\t    SetCompactedIdx(usize),\n   117\t    /// Removes elements up to the given idx from storage.\n   118\t    Trim(usize),\n   119\t    /// Sets the StopSign used for reconfiguration.\n   120\t    SetStopsign(Option<StopSign>),\n   121\t    /// Sets the snapshot.\n   122\t    SetSnapshot(Option<T::Snapshot>),\n   123\t}\n   124\t\n   125\t/// Trait for implementing the storage backend of Sequence Paxos.\n   126\tpub trait Storage<T>\n   127\twhere\n   128\t    T: Entry,\n   129\t{\n   130\t    /// **Atomically** perform all storage operations in order.\n   131\t    /// For correctness, the operations must be atomic i.e., either all operations are performed\n   132\t    /// successfully or all get rolled back. If the `StorageResult` returns as `Err`, the\n   133\t    /// operations are assumed to have been rolled back to the previous state before this function\n   134\t    /// call.\n   135\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()>;\n   136\t\n   137\t    /// Appends an entry to the end of the log.\n   138\t    fn append_entry(&mut self, entry: T) -> StorageResult<()>;\n   139\t\n   140\t    /// Appends the entries of `entries` to the end of the log.\n   141\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()>;\n   142\t\n   143\t    /// Appends the entries of `entries` to the prefix from index `from_index` (inclusive) in the log.\n   144\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()>;\n   145\t\n   146\t    /// Sets the round that has been promised.\n   147\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()>;\n   148\t\n   149\t    /// Sets the decided index in the log.\n   150\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()>;\n   151\t\n   152\t    /// Returns the decided index in the log.\n   153\t    fn get_decided_idx(&self) -> StorageResult<usize>;\n   154\t\n   155\t    /// Sets the latest accepted round.\n   156\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()>;\n   157\t\n   158\t    /// Returns the latest round in which entries have been accepted, returns `None` if no\n   159\t    /// entries have been accepted.\n   160\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>>;\n   161\t\n   162\t    /// Returns the entries in the log in the index interval of [from, to).\n   163\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   164\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>>;\n   165\t\n   166\t    /// Returns the current length of the log (without the trimmed/snapshotted entries).\n   167\t    fn get_log_len(&self) -> StorageResult<usize>;\n   168\t\n   169\t    /// Returns the suffix of entries in the log from index `from` (inclusive).\n   170\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   171\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>>;\n   172\t\n   173\t    /// Returns the round that has been promised.\n   174\t    fn get_promise(&self) -> StorageResult<Option<Ballot>>;\n   175\t\n   176\t    /// Sets the StopSign used for reconfiguration.\n   177\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()>;\n   178\t\n   179\t    /// Returns the stored StopSign, returns `None` if no StopSign has been stored.\n   180\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>>;\n   181\t\n   182\t    /// Removes elements up to the given [`idx`] from storage.\n   183\t    fn trim(&mut self, idx: usize) -> StorageResult<()>;\n   184\t\n   185\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   186\t    fn set_compacted_idx(&mut self, idx: usize) -> StorageResult<()>;\n   187\t\n   188\t    /// Returns the garbage collector index from storage.\n   189\t    fn get_compacted_idx(&self) -> StorageResult<usize>;\n   190\t\n   191\t    /// Sets the snapshot.\n   192\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()>;\n   193\t\n   194\t    /// Returns the stored snapshot.\n   195\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>>;\n   196\t}\n   197\t\n   198\t/// A place holder type for when not using snapshots. You should not use this type, it is only internally when deriving the Entry implementation.\n   199\t#[derive(Copy, Clone, Debug, Eq, PartialEq)]\n   200\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   201\tpub struct NoSnapshot;\n   202\t\n   203\timpl<T: Entry> Snapshot<T> for NoSnapshot {\n   204\t    fn create(_entries: &[T]) -> Self {\n   205\t        panic!(\"NoSnapshot should not be created\");\n   206\t    }\n   207\t\n   208\t    fn merge(&mut self, _delta: Self) {\n   209\t        panic!(\"NoSnapshot should not be merged\");\n   210\t    }\n[package]\nname = \"omnipaxos_runtime\"\nversion = \"0.1.0\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"Async runtime actor layer for OmniPaxos.\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\nkeywords = [\"omnipaxos\", \"paxos\", \"consensus\", \"distributed-systems\", \"async\"]\ncategories = [\"asynchronous\", \"concurrency\", \"network-programming\"]\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nomnipaxos = { version = \"0.2.3\", path = \"../omnipaxos\", features = [\"async_runtime\"] }\nfutures = \"0.3\"\nasync-channel = \"2\"\nfutures-timer = \"3\"\nuuid = { version = \"1\", features = [\"v4\"] }\ntokio = { version = \"1\", optional = true, features = [\"rt\", \"time\", \"sync\", \"macros\"] }\n\n[dev-dependencies]\nomnipaxos_storage = { version = \"0.2.2\", path = \"../omnipaxos_storage\" }\ntokio = { version = \"1\", features = [\"rt-multi-thread\", \"sync\", \"time\", \"macros\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\n\n[features]\ntokio_runtime = [\"dep:tokio\"]\nunicache = [\"omnipaxos/unicache\"]\nserde = [\"omnipaxos/serde\"]\nlogging = [\"omnipaxos/logging\"]\n[package]\nname = \"omnipaxos\"\nversion = \"0.2.3\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"A distributed log library written in Rust\"\nreadme = \"../README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nslog = { version = \"2.7.0\", optional = true }\nslog-term = { version = \"2.9.0\", optional = true }\nslog-async = { version = \"2.7.0\", optional = true }\nserde = { version = \"1.0\", optional = true, features = [\"derive\"] }\ntoml = { version = \"0.7.3\", optional = true }\nomnipaxos_macros = { version = \"0.1.3\", path = \"../omnipaxos_macros\", optional = true }\nlru = { version = \"0.11.0\", optional = true }\nnum-traits = { version = \"0.2.16\", optional = true }\nlinked_hash_set = { version = \"0.1.4\", optional = true }\nuuid = { version = \"1\", optional = true, features = [\"v4\"] }\n\n[dev-dependencies]\nkompact = { git = \"https://github.com/kompics/kompact\", rev = \"4fd1fdc\", features = [\"silent_logging\"] }\nomnipaxos_storage = { path = \"../omnipaxos_storage\", features = [\"persistent_storage\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\ntoml = \"0.7.3\"\ntempfile = \"3.3.0\"\nserial_test = \"0.5.1\"\nrand = \"0.8.4\"\nserde_json = \"1.0\"\n\n[features]\nlogging  = [\"slog\", \"slog-term\", \"slog-async\"]\ntoml_config = [\"serde\", \"toml\"]\nmacros = [\"omnipaxos_macros\"]\nunicache = [\"lru\", \"num-traits\", \"linked_hash_set\"]\nasync_runtime = [\"dep:uuid\"]\n# Explicit serde feature so it can chain uuid's serde support when both are on.\nserde = [\"dep:serde\", \"uuid?/serde\"]\n\ndefault = [\"macros\"]\n\n[profile.release]\nlto = true\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The runtime introduces a concrete identity question: `append_notify` records an entry’s assigned index and ballot, but its completion check returns success for a decided index before checking whether the ballot changed. I’ll retain the existing `Superseded` protection as counterevidence and investigate whether a legal leader change can replace that entry before the next notifier check.\n"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/sequence_paxos/mod.rs | sed -n '468,530p'; nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '430,445p'; nl -ba ../agent-source/omnipaxos/src/ballot_leader_election.rs | sed -n '328,360p'; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']\nfor k in ['CandidateSubmission','AuditQuestion','Grounding']:\n print(k,json.dumps(s[k],indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/sequence_paxos/mod.rs | sed -n '468,530p'; nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '430,445p'; nl -ba ../agent-source/omnipaxos/src/ballot_leader_election.rs | sed -n '328,360p'; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']\nfor k in ['CandidateSubmission','AuditQuestion','Grounding']:\n print(k,json.dumps(s[k],indent=2))\nPY\"","aggregated_output":"CandidateSubmission {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\nAuditQuestion {\n  \"additionalProperties\": false,\n  \"description\": \"Sourced investigation of requirements, protections and history; these may remain unknown.\",\n  \"properties\": {\n    \"audit_spec_version\": {\n      \"anyOf\": [\n        {\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Audit Spec Version\"\n    },\n    \"disposition\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"explained_by_existing_mechanism\",\n            \"concrete_suspicion\",\n            \"needs_specific_evidence\",\n            \"ready_for_check\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Disposition\"\n    },\n    \"preferred_check\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"source_review\",\n            \"direct_test\",\n            \"controlled_schedule\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Preferred Check\"\n    },\n    \"question\": {\n      \"title\": \"Question\",\n      \"type\": \"string\"\n    },\n    \"importance\": {\n      \"title\": \"Importance\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"participants\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Participants\",\n      \"type\": \"array\"\n    },\n    \"objects\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Objects\",\n      \"type\": \"array\"\n    },\n    \"contexts\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Contexts\",\n      \"type\": \"array\"\n    },\n    \"event_paths\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Event Paths\",\n      \"type\": \"array\"\n    },\n    \"activity_classes\": {\n      \"default\": [],\n      \"items\": {\n        \"enum\": [\n          \"A1\",\n          \"A2\",\n          \"A3\",\n          \"A4\",\n          \"A5\",\n          \"A6\",\n          \"A7\"\n        ],\n        \"type\": \"string\"\n      },\n      \"title\": \"Activity Classes\",\n      \"type\": \"array\"\n    },\n    \"behavior_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Behavior Ids\",\n      \"type\": \"array\"\n    },\n    \"fact_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Fact Ids\",\n      \"type\": \"array\"\n    },\n    \"supporting_behavior_ids\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Behavior ID to sourced prehistory, context or consequence support; not a direct principal Fact edge\",\n      \"title\": \"Supporting Behavior Ids\",\n      \"type\": \"object\"\n    },\n    \"obligation_relation_kind\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"establishment\",\n            \"preservation\",\n            \"consumption\",\n            \"recovery\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Obligation Relation Kind\"\n    },\n    \"counterevidence\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Counterevidence\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"description\": \"Specific unresolved premises or discriminators of this question; not generic caution or a checklist of untested cases\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unknowns\",\n      \"type\": \"array\"\n    },\n    \"priority\": {\n      \"default\": 0,\n      \"description\": \"System consequence and audit significance, justified in importance; not proof\",\n      \"maximum\": 3,\n      \"minimum\": 0,\n      \"title\": \"Priority\",\n      \"type\": \"integer\"\n    },\n    \"trigger_rationale\": {\n      \"title\": \"Trigger Rationale\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"question\",\n    \"importance\",\n    \"trigger_rationale\"\n  ],\n  \"title\": \"AuditQuestion\",\n  \"type\": \"object\"\n}\nGrounding {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"source_ids\": {\n      \"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"expectation_ids\": {\n      \"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Expectation Ids\",\n      \"type\": \"array\"\n    },\n    \"binding_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Binding Ids\",\n      \"type\": \"array\"\n    },\n    \"derivation\": {\n      \"default\": \"\",\n      \"description\": \"This component\\u2019s sourced reasoning; cite accepted IDs instead of repeating their full argument\",\n      \"title\": \"Derivation\",\n      \"type\": \"string\"\n    },\n    \"applicability\": {\n      \"default\": \"\",\n      \"description\": \"Conditions for this component, including any added assumptions or omitted protections\",\n      \"title\": \"Applicability\",\n      \"type\": \"string\"\n    },\n    \"unresolved\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unresolved\",\n      \"type\": \"array\"\n    },\n    \"conflicts\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Conflicts\",\n      \"type\": \"array\"\n    },\n    \"alternatives\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Alternatives\",\n      \"type\": \"array\"\n    }\n  },\n  \"title\": \"Grounding\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > extend_map.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v1.json')); sources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nA=src('M-actor','omnipaxos_runtime/src/actor.rs',53,711)\nT=src('M-runtime-contract','omnipaxos_runtime/src/handle.rs',79,165,'interface_statement')\nG=src('M-runtime-errors','omnipaxos_runtime/src/event.rs',33,67,'interface_statement')\nI=src('M-runtime-io','omnipaxos_runtime/src/handle.rs',181,324)\nJ=src('M-runtime-config','omnipaxos_runtime/src/handle.rs',19,76,'interface_statement')\nK=src('M-runtime-trait','omnipaxos_runtime/src/traits.rs',29,46,'interface_statement')\nO=src('M-build','omnipaxos/src/omni_paxos.rs',39,79)\nV=src('M-peer-conversion','omnipaxos/src/sequence_paxos/mod.rs',475,496)\nW=src('M-ble-conversion','omnipaxos/src/ballot_leader_election.rs',328,351)\nY=src('M-election-call','omnipaxos/src/omni_paxos.rs',432,442)\nH=src('M-storage-read','omnipaxos/src/storage/internal_storage.rs',37,201)\nN=src('M-memory-storage','omnipaxos_storage/src/memory_storage.rs',29,160)\nP=src('M-persistent-open','omnipaxos_storage/src/persistent_storage.rs',119,165)\nR=src('M-persistent-write','omnipaxos_storage/src/persistent_storage.rs',278,403)\nS=src('M-storage-contract','omnipaxos/src/storage/mod.rs',125,195,'interface_statement')\ndef b(i,a,owner,ctx,trig,ss,**kw):\n m['behaviors'].append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss,unknowns=[],**kw))\nb('B-config-build','A4','OmniPaxosConfig and component conversion','Fixed cluster node list and configuration ID','Public build with caller-provided Storage',[O,V,W,'M-config'],implementation_guards=['Validate cluster and server settings; require local PID in configured node list.'],writes=['Peers are configured nodes excluding own PID; shared flexible quorum passed to both components; BLE receives configuration ID and recovered promise.'],cross_activity_effects={'A1':'Member count determines promise and accept quorum thresholds.','A2':'Build seeds BLE with stored promise and initializes SequencePaxos recovery.'})\nb('B-reconstruct','A6','InternalStorage::load_cache and bundled Storage implementations','Stored promise, accepted round, decided/compacted index and StopSign','Construction from supplied storage',[H,N,P,R,S],writes=['Cache loads promise and accepted round, decision and compacted index, StopSign; accepted index equals stored log length plus compacted prefix plus StopSign presence.'],existing_protections=['Storage trait requires atomic ordered operations with rollback on Err. PersistentStorage batches sync operations into one RocksDB write; MemoryStorage uses infallible in-memory updates under ordinary valid indices.'],cross_activity_effects={'A2':'Reloaded promise constrains future prepares and accepts.','A1':'Recovered accepted history and decisions inform future promises.'})\nb('B-read-decided','A5','InternalStorage read API','Current actor-owned or synchronous storage state','read_decided_suffix/read',[H,'M-public','M-log-doc'],implementation_guards=['Suffix ends at current decided index; lower reads classify entries by absolute log index relative to decision boundary.'],external_effects=['Returns Decided entries, compacted-prefix marker, and/or StopSign status; no application state mutation.'],cross_activity_effects={'A1':'Exposes the decided prefix rather than treating append admission as agreement.'})\nb('B-runtime-assignment','A7','ActorState pending, append_tracked, reconcile_unconfirmed and Assigned handler','EntryId-scoped pending call, assigned index and ballot','AppendNotify admission; local stable-leader append, batch reconciliation or incoming Assigned',[A,T],implementation_guards=['Stable leader (local pid and Accept phase) required for tracked leader acceptance; pending admission limited; record_assignment matches EntryId.','Batch reconciliation discards tracking on ballot mismatch.'],writes=['Allocate EntryId; retain entry until dispatch. Immediate append records accepted_after and current promise; deferred batch queues tracking intent. Remote Assigned overwrites matching pending assignment.'],external_effects=['Route TaggedProposal to leader and Assigned back to origin.'],produces_fact_ids=['F-assignment'],cross_activity_effects={'A1':'Assignment records acceptance position, not a quorum decision.','A2':'Records ballot at assignment but incoming Assigned has no current-ballot filter.'})\nb('B-runtime-notification','A7','ActorState::drain_notifiers','Pending call assignment and current local decided index/promise','Tick after core tick, event emission, dispatch and reconciliation',[A,T,G],reads=['Pending assigned index/ballot, current decided index and promise, wall-clock deadline'],important_branches=['If assigned idx <= decided, send Ok(idx), without testing ballot. Otherwise if assignment ballot < current promise, send Superseded; otherwise expired deadline sends Timeout; remaining calls stay pending.'],external_effects=['Oneshot completes the original append_notify future.'],consumes_fact_ids=['F-assignment'],cross_activity_effects={'A1':'Interprets local decided boundary as completion of the identified proposal.','A2':'Checks supersession only after the success branch.'})\nb('B-runtime-drive','A7','ActorState::run and handle','Single actor owns OmniPaxos state, separate incoming/command queues and periodic timers','Executor poll, incoming message, command or timer',[A,I,J,K,Y],writes=['Serializes access; dispatches AsyncRuntime control messages separately from core protocol.'],external_effects=['Tick drives core, awaits event sends, dispatches pending work, reconciles assignments, drains notifiers and pushes subscriber data. Egress drains core messages into bounded outgoing transport channel.','handle_incoming enqueues a message; read commands obtain state after their own dispatch. Handle drop closes channels and ends actor when a receive stream closes.'],async_boundaries=['Multiple incoming messages may run between ticks; incoming handling does not itself call drain_notifiers. Event sends can await channel capacity. External transport owns routing/delivery and reconnect notification.'],cross_activity_effects={'A1':'Drives ticks and transports protocol output, including bounded-buffer dropping of oldest messages.','A2':'Dispatches actual core Prepare and AcceptSync transitions before later notification ticks.'})\nm['facts'].append(dict(id='F-assignment',meaning='An identified pending append has a recorded assigned log index and assignment ballot, produced by a local accepted append/batch or a received Assigned message. It asserts recorded placement in that context, not decision or preservation of entry identity under later ballots.',identity={'call':'runtime EntryId within originating actor','placement':'assigned index and assignment ballot'},validity_context='Pending object until completion, failure or actor shutdown. An assignment can survive core ballot changes between notifier ticks and may be overwritten by another matching Assigned.',representation=['Pending.assigned: Option<(usize, Ballot)>'],durability='Volatile actor bookkeeping, not part of the replicated log or Storage.',recovery='No pending-call reconstruction on actor restart; channel closure returns Shutdown through handle.',source_ids=[A,T,G],unknowns=['Whether success after ballot change can refer to a different decided entry under one legal message history.']))\n# Additive knowledge answers the prior coarse boundary gap without claiming backend power-failure proof.\nm['facts'][0]['unknowns']=['PersistentStorage power-loss durability and failure rollback details remain untested; MemoryStorage has no process-crash durability.']\nm['facts'][0]['source_ids'] += [H,N,P,R]\nm['target_profile']['system_boundary']='Captured OmniPaxos core, bundled memory/persistent storage and optional async actor runtime. The actor owns tick, notification and protocol dispatch; caller owns transport delivery and application state/new-configuration startup.'\nm['target_profile']['source_ids'] += [A,I,O,H,N,P,R]\nfor a in m['activities']:\n if a['class_id']=='A4': a['realization_summary']='Validated cluster settings determine peers and shared quorum; configured peer conversion excludes local PID. StopSign identifies next cluster, which caller starts.';a['source_ids'] += [O,V,W]\n if a['class_id']=='A5': a['realization_summary']='Internal reads classify entries below the decided boundary. Actor can return suffixes or fan them to subscribers; application remains caller-owned.';a['source_ids'] += [H,A,I]\n if a['class_id']=='A6': a['realization_summary']='Construction reconstructs cached indices, rounds and StopSign from Storage. MemoryStorage retains values in-process; PersistentStorage reopens RocksDB keys and writes synchronization operations in a WriteBatch. Storage promises rollback on returned errors; detailed failure testing remains open.';a['source_ids'] += [H,N,P,R,S]\n if a['class_id']=='A7': a['realization_summary']='Synchronous append admits a proposal. Optional actor tags append_notify calls, records placement, polls decision completion on tick and exposes read/subscription APIs; transport still belongs to caller.';a['source_ids'] += [A,T,G,I]\nco=m['core_overview']; co['status']='usable';co['core_gaps']=[]\nco['rationale']='Both core paths and their ownership/reconstruction/consumption connection are traced through caller interfaces, actor dispatch and storage. Open local anomalies and backend fault details are not treated as proven protections.'\nco['formation']['explanation'] += ' InternalStorage read classifies values below the decided index; the actor has a separate proposal-identity assignment and completion layer, so correct decided-index advancement alone does not establish correct append_notify completion.'\nco['formation']['behavior_ids'] += ['B-read-decided'];co['formation']['source_ids'] += [H,A,T]\nco['context']['explanation'] += ' Build derives peers from configuration, passes quorum policy to both core components, reloads stored promise into BLE and reconstructs cached log metadata. The actor serializes protocol dispatch but can dispatch multiple incoming messages between ticks.'\nco['context']['behavior_ids'] += ['B-config-build','B-reconstruct','B-runtime-drive'];co['context']['source_ids'] += [O,V,W,H,A]\nco['connection']['explanation'] += ' Storage reconstruction supplies prior promise/history; runtime notification bookkeeping remains volatile and separate. Assigned position is consumed with a later decided-boundary read; its ballot is checked only after the success branch, leaving entry identity across replacement as a specific question.'\nco['connection']['behavior_ids'] += ['B-runtime-assignment','B-runtime-notification','B-runtime-drive','B-reconstruct'];co['connection']['fact_ids'] += ['F-assignment'];co['connection']['source_ids'] += [A,T,G,H]\nco['open_details'] += ['Pending assignment identity versus decided slot after leader replacement; existing Superseded path runs only when success condition did not match.','Actor subscriber cursor treats returned vector positions as log positions; compacted prefix markers can cover multiple indices.','PersistentStorage serialization/error rollback and crash durability remain deeper fault-contract questions.']\nfor s in m['surfaces']:\n if s['entry_point']=='OmniPaxos::handle_incoming AsyncRuntime branch':\n  s.update(disposition='mapped',behavior_ids=['B-runtime-drive','B-runtime-assignment','B-runtime-notification'],reason='Actor dispatches runtime wire messages before the core; tick performs notification. Caller still owns transport.',source_ids=['M-public',A,I])\nm['surfaces'].append(dict(entry_point='ActorState::push_to_all_subs/push_to_sub',disposition='deferred',reason='Cursor advances per returned LogEntry, while compacted prefix markers represent multiple indices; inspect snapshot subscription history and contract.',source_ids=[A,H,I],high_consequence=True))\njson.dump(m,open('runtime-map.json','w'),indent=2)\nchanges={}\nfor key in ['target_profile','A4','A5','A6','A7','core_overview','surface:OmniPaxos::handle_incoming AsyncRuntime branch','F-promise']:\n changes[key]=dict(impact='clarification',source_ids=[A,I,O,H,N,P,R,S],rationale='Resolve prior ownership and reconstruction unknowns with actual constructor, actor and backend paths; preserve the existing core mechanism and promise meaning.',preserves='No existing Candidate or Unit. Existing promise identity, guards and observation scope are unchanged; new runtime assignment is a distinct fact.')\nq=dict(disposition='concrete_suspicion',preferred_check='controlled_schedule',question='Can append_notify return Ok for an assigned slot whose entry was replaced and decided under a later ballot before the next notifier tick?',importance='Potential false client success for a write absent from the decided log, despite core consensus remaining safe.',source_ids=[A,T,G,'M-leader','M-follower','M-sync-storage'],participants=['Origin actor with pending append','Old leader','New leader and prepare/accept quorum'],objects=['EntryId','Pending.assigned','Assigned message','Decided log entry'],contexts=['One fixed configuration, non-Byzantine nodes, unbatched initial scenario','Old assignment followed by legitimate new-ballot history replacement; timers and transport explicit'],event_paths=['append_notify -> local acceptance or TaggedProposal/Assigned -> newer Prepare/AcceptSync and decision -> tick -> drain_notifiers'],activity_classes=['A7','A1','A2'],behavior_ids=['B-runtime-assignment','B-runtime-notification'],fact_ids=['F-assignment'],supporting_behavior_ids={'B-runtime-drive':'Serializes actor dispatch but notifications occur only on ticks, permitting multiple protocol transitions between checks.','B-prepare':'Establishes new promise/authority.','B-formation':'Selects eligible history and forms new decision.','B-accept':'Follower synchronization can replace unchosen history.','B-sync-storage':'Installs selected suffix and decision index.','B-read-decided':'Independently observes decided entry content.'},obligation_relation_kind='consumption',counterevidence=['Assigned carries ballot and EntryId; batch reconciliation rejects changed-ballot tracking.','drain_notifiers sends Superseded if it sees a newer promise while the assigned index remains undecided.','New leaders must retain potentially chosen history; replacement is only legal for an entry lacking necessary quorum support.','API calls Superseded heuristic because a value may survive leadership change; successful preserved-entry completion is not itself a violation.'],unknowns=['Construct an actual emitted-message history that assigns an unchosen entry, replaces it via another quorum, and makes the slot decided before notifier evaluation, preserving per-link ordering and caller reconnect duties.','Verify public runtime test reachability and effective features for selected crate; no private-state mutation or manufactured protocol messages.'],priority=3,trigger_rationale='The success branch tests idx <= decided before ballot supersession, while incoming handlers do not drain notifiers. Source reading supplies a concrete schedule discriminator. This identity obligation is stronger audit value than sparse-ID compaction or duplicate-heartbeat liveness questions; a small public-API controlled history can distinguish replacement from valid preservation without requiring crash injection.')\nsub=dict(action='continue',rationale='Complete the usable core map and select the sourced runtime assignment-consumption question, preserving supersession protections and legal-history uncertainty.',sources=sources,map_path='runtime-map.json',map_changes=changes,question=q)\njson.dump(sub,open('submission-runtime.json','w'),indent=2)\nPY\npython3 