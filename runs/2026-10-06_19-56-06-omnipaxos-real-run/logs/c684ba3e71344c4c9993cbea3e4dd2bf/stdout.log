      \"objects\": [\n        \"EntryId\",\n        \"Pending.assigned\",\n        \"Assigned message\",\n        \"Decided log entry\"\n      ],\n      \"contexts\": [\n        \"One fixed configuration, non-Byzantine nodes, unbatched initial scenario\",\n        \"Old assignment followed by legitimate new-ballot history replacement; timers and transport explicit\"\n      ],\n      \"event_paths\": [\n        \"append_notify -> local acceptance or TaggedProposal/Assigned -> newer Prepare/AcceptSync and decision -> tick -> drain_notifiers\"\n      ],\n      \"activity_classes\": [\n        \"A7\",\n        \"A1\",\n        \"A2\"\n      ],\n      \"behavior_ids\": [\n        \"B-runtime-assignment\",\n        \"B-runtime-notification\"\n      ],\n      \"fact_ids\": [\n        \"F-assignment\"\n      ],\n      \"supporting_behavior_ids\": {\n        \"B-runtime-drive\": \"Serializes actor dispatch but notifications occur only on ticks, permitting multiple protocol transitions between checks.\",\n        \"B-prepare\": \"Establishes new promise/authority.\",\n        \"B-formation\": \"Selects eligible history and forms new decision.\",\n        \"B-accept\": \"Follower synchronization can replace unchosen history.\",\n        \"B-sync-storage\": \"Installs selected suffix and decision index.\",\n        \"B-read-decided\": \"Independently observes decided entry content.\"\n      },\n      \"obligation_relation_kind\": \"consumption\",\n      \"counterevidence\": [\n        \"Assigned carries ballot and EntryId; batch reconciliation rejects changed-ballot tracking.\",\n        \"drain_notifiers sends Superseded if it sees a newer promise while the assigned index remains undecided.\",\n        \"New leaders must retain potentially chosen history; replacement is only legal for an entry lacking necessary quorum support.\",\n        \"API calls Superseded heuristic because a value may survive leadership change; successful preserved-entry completion is not itself a violation.\"\n      ],\n      \"unknowns\": [\n        \"Construct an actual emitted-message history that assigns an unchosen entry, replaces it via another quorum, and makes the slot decided before notifier evaluation, preserving per-link ordering and caller reconnect duties.\",\n        \"Verify public runtime test reachability and effective features for selected crate; no private-state mutation or manufactured protocol messages.\"\n      ],\n      \"priority\": 3,\n      \"trigger_rationale\": \"The success branch tests idx <= decided before ballot supersession, while incoming handlers do not drain notifiers. Source reading supplies a concrete schedule discriminator. This identity obligation is stronger audit value than sparse-ID compaction or duplicate-heartbeat liveness questions; a small public-API controlled history can distinguish replacement from valid preservation without requiring crash injection.\"\n    },\n    \"status\": \"active\",\n    \"parent_candidate_id\": null,\n    \"fork_reason\": \"\",\n    \"stop_reason\": \"Complete the usable core map and select the sourced runtime assignment-consumption question, preserving supersession protections and legal-history uncertainty.\",\n    \"resume_conditions\": [],\n    \"obligation_id\": null,\n    \"result_claim_ids\": [],\n    \"open_issue_ids\": [],\n    \"executions\": [],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"question_candidates\",\n      \"match\": {\n        \"id\": \"739a7fe5e829431788df0e6cbe41428f\"\n      }\n    }\n  }\n]\npending_work [\n  {\n    \"id\": \"739a7fe5e829431788df0e6cbe41428f\",\n    \"kind\": \"candidate\",\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"question_candidates\",\n      \"match\": {\n        \"id\": \"739a7fe5e829431788df0e6cbe41428f\"\n      }\n    }\n  }\n]\nlatest_decision {\n  \"operation_id\": \"69911e64bcbd4210bd93677462d09410\",\n  \"action\": \"continue\",\n  \"record\": {\n    \"path\": \"state.json\",\n    \"collection\": \"selections\",\n    \"match\": {\n      \"operation_id\": \"69911e64bcbd4210bd93677462d09410\"\n    }\n  }\n}\nbuild_inputs [\n  {\n    \"record\": \"build-inputs/targets/omnipaxos/assurance_generated/basis.json\",\n    \"manifest\": \"omnipaxos/Cargo.toml\",\n    \"test_target\": \"assurance_generated\",\n    \"resolved_features\": [\n      \"async_runtime\",\n      \"default\",\n      \"logging\",\n      \"macros\",\n      \"omnipaxos_macros\",\n      \"serde\",\n      \"slog\",\n      \"slog-async\",\n      \"slog-term\"\n    ],\n    \"feature_evidence\": \"metadata resolution; selected test compilation is recorded separately\",\n    \"compilations\": [],\n    \"status\": \"inputs_fixed\",\n    \"latest_preparation\": null\n  }\n]\nExplore {\"additionalProperties\": false, \"properties\": {\"rationale\": {\"minLength\": 1, \"title\": \"Rationale\", \"type\": \"string\"}, \"sources\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/SourceRange\"}, \"title\": \"Sources\", \"type\": \"array\"}, \"feedback\": {\"anyOf\": [{\"$ref\": \"#/$defs/ResearchFeedback\"}, {\"type\": \"null\"}], \"default\": null}, \"repair_of\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Rejected operation ID whose complete draft this submission repairs\", \"title\": \"Repair Of\"}, \"action\": {\"const\": \"explore\", \"title\": \"Action\", \"type\": \"string\"}, \"question\": {\"minLength\": 1, \"title\": \"Question\", \"type\": \"string\"}, \"harness_path\": {\"title\": \"Harness Path\", \"type\": \"string\"}, \"execution_package\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Optional single local Go package or Rust crate directory, with the same meaning as Harness.execution_package\", \"title\": \"Execution Package\"}, \"files\": {\"additionalProperties\": {\"type\": \"string\"}, \"default\": {}, \"title\": \"Files\", \"type\": \"object\"}}, \"required\": [\"rationale\", \"action\", \"question\", \"harness_path\"], \"title\": \"ExploreSubmission\", \"type\": \"object\"}\n//! Async runtime actor layer for OmniPaxos.\n//!\n//! The [`AsyncRuntime`] trait abstracts over the async executor so this crate can be used\n//! on top of any runtime. A ready-to-use [`TokioRuntime`] is provided behind the\n//! `tokio_runtime` feature.\n//!\n//! The main entry point is [`spawn_actor`], which takes an\n//! [`OmniPaxos`](omnipaxos::OmniPaxos) instance and returns an [`OmniPaxosHandle`]. The\n//! handle is cloneable and provides `async` methods to append entries and observe state\n//! transitions.\n//!\n//! The runtime does NOT own message transport: use [`OmniPaxosHandle::outgoing_messages`]\n//! to drain outgoing messages and [`OmniPaxosHandle::handle_incoming`] to deliver\n//! incoming ones. This keeps the crate free of I/O dependencies and lets users plug in\n//! any transport (TCP, QUIC, in-process channels, etc.).\n\n#![deny(missing_docs)]\n\nmod actor;\nmod event;\nmod handle;\nmod traits;\n\n#[cfg(feature = \"tokio_runtime\")]\nmod tokio_rt;\n\npub use event::{AppendError, OmniPaxosEvent, RuntimeProposeErr};\npub use handle::{spawn_actor, OmniPaxosHandle, RuntimeConfig};\npub use omnipaxos::messages::EntryId;\npub use traits::{ActorEntry, AsyncRuntime};\n\n#[cfg(feature = \"tokio_runtime\")]\npub use tokio_rt::TokioRuntime;\n//! Integration tests for the async runtime layer.\n//!\n//! Sets up a small in-process cluster where each node runs an OmniPaxos actor and messages\n//! are shuttled between them over in-memory channels, then exercises the async API.\n#![cfg(feature = \"tokio_runtime\")]\n\nuse std::{\n    collections::HashMap,\n    sync::{\n        atomic::{AtomicBool, Ordering},\n        Arc,\n    },\n    time::Duration,\n};\n\n#[cfg(feature = \"unicache\")]\nuse omnipaxos::unicache::UniCache;\nuse omnipaxos::{\n    messages::{sequence_paxos::PaxosMsg, Message},\n    storage::{Entry, Snapshot},\n    util::{LogEntry, NodeId},\n    ClusterConfig, OmniPaxosConfig, ProposeErr, ServerConfig,\n};\nuse omnipaxos_runtime::{\n    spawn_actor, AppendError, OmniPaxosEvent, OmniPaxosHandle, RuntimeConfig, RuntimeProposeErr,\n    TokioRuntime,\n};\nuse omnipaxos_storage::memory_storage::MemoryStorage;\nuse tokio::time::timeout;\n\n/// Minimal Entry type — avoids depending on the `macros` feature. Always derives serde\n/// traits (an unconditional dev-dependency here) rather than gating on this crate's own\n/// `serde` feature: under workspace-wide builds (`cargo check --workspace`), `omnipaxos`'s\n/// `serde` feature can be active (enabled by some other workspace member) independently of\n/// whether *this* crate's `serde` feature was requested, and `Entry::Snapshot` requires\n/// `Serialize + Deserialize` whenever the dependency's feature is on, regardless.\n#[derive(Clone, Debug, Default, PartialEq, serde::Serialize, serde::Deserialize)]\nstruct TestEntry(u64);\n\n#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\nstruct NoSnapshot;\n\nimpl Snapshot<TestEntry> for NoSnapshot {\n    fn create(_entries: &[TestEntry]) -> Self {\n        NoSnapshot\n    }\n    fn merge(&mut self, _delta: Self) {}\n    fn use_snapshots() -> bool {\n        false\n    }\n}\n\n/// No-op UniCache so `cargo test --all-features` can compile without the macros crate.\n#[cfg(feature = \"unicache\")]\n#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\nstruct NoUniCache;\n\n#[cfg(feature = \"unicache\")]\nimpl UniCache for NoUniCache {\n    type T = TestEntry;\n\n    fn new() -> Self {\n        NoUniCache\n    }\n\n    fn try_encode(&mut self, entry: &Self::T) -> <Self::T as Entry>::EncodeResult {\n        entry.clone()\n    }\n\n    fn decode(&mut self, processed: <Self::T as Entry>::EncodeResult) -> Self::T {\n        processed\n    }\n}\n\nimpl Entry for TestEntry {\n    type Snapshot = NoSnapshot;\n\n    #[cfg(feature = \"unicache\")]\n    type Encoded = ();\n    #[cfg(feature = \"unicache\")]\n    type Encodable = TestEntry;\n    #[cfg(feature = \"unicache\")]\n    type NotEncodable = ();\n    #[cfg(feature = \"unicache\")]\n    type EncodeResult = TestEntry;\n    #[cfg(feature = \"unicache\")]\n    type UniCache = NoUniCache;\n}\n\nfn build_op(\n    pid: NodeId,\n    nodes: Vec<NodeId>,\n) -> omnipaxos::OmniPaxos<TestEntry, MemoryStorage<TestEntry>> {\n    let cluster_config = ClusterConfig {\n        configuration_id: 1,\n        nodes,\n        flexible_quorum: None,\n    };\n    // `..Default::default()` is needed only when the `logging` feature adds\n    // extra fields to `ServerConfig`; clippy flags it as redundant under\n    // feature combinations where it isn't (e.g. `logging` off).\n    #[allow(clippy::needless_update)]\n    let server_config = ServerConfig {\n        pid,\n        election_tick_timeout: 3,\n        resend_message_tick_timeout: 5,\n        buffer_size: 100,\n        batch_size: 1,\n        flush_batch_tick_timeout: 100,\n        leader_priority: 0,\n        ..Default::default()\n    };\n    let cfg = OmniPaxosConfig {\n        cluster_config,\n        server_config,\n    };\n    cfg.build(MemoryStorage::default()).unwrap()\n}\n\n/// Spawn `n` nodes and wire their outgoing/incoming message streams together.\nasync fn spawn_cluster(n: NodeId) -> HashMap<NodeId, OmniPaxosHandle<TestEntry>> {\n    let nodes: Vec<NodeId> = (1..=n).collect();\n    let cfg = RuntimeConfig {\n        tick_period: Duration::from_millis(2),\n        egress_period: Duration::from_millis(1),\n        ..Default::default()\n    };\n\n    let mut handles: HashMap<NodeId, OmniPaxosHandle<TestEntry>> = HashMap::new();\n    for pid in nodes.clone() {\n        let op = build_op(pid, nodes.clone());\n        let h = spawn_actor::<TestEntry, MemoryStorage<TestEntry>, TokioRuntime>(op, cfg.clone());\n        handles.insert(pid, h);\n    }\n\n    // Wire in-process transport: every node's outgoing_messages -> receiver's handle_incoming.\n    let handles_arc = Arc::new(handles.clone());\n    for pid in nodes {\n        let out = handles_arc[&pid].outgoing_messages();\n        let peers = handles_arc.clone();\n","exit_code":0,"status":"completed"}}
