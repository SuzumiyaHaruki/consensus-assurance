{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'cat update.json; echo ---; cat assurance_generated_test.go'","aggregated_output":"{\n  \"rationale\": \"Seventy-seventh pass: bound the reach of the asserted witness-reporting defect inside the captured tree. The defect's impact statement depends on which consumers exist, so this pass searches the snapshot for every reference to the summary list and to the node host info call. The list appears only in its field declaration, in the producer that fills it and in node host tests that read cluster identity, leader flag or member counts; no example, tool or test reads the witness flag. That keeps the impact where the existing account puts it - on callers outside the tree - and adds a concrete, checkable bound to the defect record.\",\n  \"sources\": [\n    {\n      \"id\": \"nodehost_info_summary_field\",\n      \"file\": \"nodehost.go\",\n      \"start_line\": 205,\n      \"end_line\": 218,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"nodehost_test_summary_reads\",\n      \"file\": \"nodehost_test.go\",\n      \"start_line\": 2652,\n      \"end_line\": 2656,\n      \"kind\": \"code_observation\"\n    }\n  ],\n  \"knowledge\": [\n    {\n      \"ref\": \"@ki_cluster_info_consumers_in_tree\",\n      \"kind\": \"fact\",\n      \"statement\": \"Within the captured tree the cluster summary list is referenced only by the NodeHostInfo field that carries it, by the node host producer that fills it from the per-node summaries, and by node host tests that inspect cluster identity, leader state, member counts or a single cluster entry. No example, plugin, tool or test in the captured tree reads the witness flag of a summary, so the misreported field has no consumer inside the snapshot and its effect is confined to callers outside it.\",\n      \"conditions\": \"Search of the captured snapshot for references to the summary list and to the node host info call, at the recorded snapshot.\",\n      \"source_ids\": [\n        \"nodehost_info_summary_field\",\n        \"nodehost_test_summary_reads\",\n        \"nodehost_get_nodehost_info\",\n        \"nodehost_cluster_info_list\"\n      ]\n    }\n  ]\n}\n---\npackage dragonboat\n\nimport (\n\t\"fmt\"\n\t\"testing\"\n\n\t\"github.com/lni/dragonboat/v3/config\"\n\t\"github.com/lni/dragonboat/v3/internal/rsm\"\n\t\"github.com/lni/dragonboat/v3/internal/vfs\"\n\tpb \"github.com/lni/dragonboat/v3/raftpb\"\n)\n\nfunc assuranceCCEntry(t *testing.T, index uint64, cc pb.ConfigChange) pb.Entry {\n\tt.Helper()\n\tdata, err := cc.Marshal()\n\tif err != nil {\n\t\tt.Fatalf(\"failed to marshal config change %v\", err)\n\t}\n\treturn pb.Entry{Index: index, Term: 1, Type: pb.ConfigChangeEntry, Cmd: data}\n}\n\n// TestAssuranceWitnessRecordFromMembership lets the replicated state machine\n// build its membership from configuration-change entries - first the cluster's\n// only voting member, then the local node as a witness - and then reads back\n// what node.notifyConfigChange stores and what node.getClusterInfo reports.\nfunc TestAssuranceWitnessRecordFromMembership(t *testing.T) {\n\tfs := vfs.GetTestFS()\n\tcfg := config.Config{ClusterID: 1, NodeID: 2}\n\tn := &node{\n\t\tclusterID:    1,\n\t\tnodeID:       2,\n\t\tconfig:       cfg,\n\t\tinitializedC: make(chan struct{}),\n\t\tsysEvents:    &sysEventListener{},\n\t}\n\tn.sm = rsm.NewStateMachine(\n\t\trsm.NewNativeSM(cfg, &rsm.InMemStateMachine{}, nil),\n\t\tnil, cfg, &testDummyNodeProxy{}, fs)\n\n\tn.sm.TaskQ().Add(rsm.Task{Entries: []pb.Entry{\n\t\tassuranceCCEntry(t, 1, pb.ConfigChange{\n\t\t\tType: pb.AddNode, NodeID: 1, Address: \"a1\", ConfigChangeId: 0,\n\t\t}),\n\t\tassuranceCCEntry(t, 2, pb.ConfigChange{\n\t\t\tType: pb.AddWitness, NodeID: 2, Address: \"a2\", ConfigChangeId: 1,\n\t\t}),\n\t}})\n\tif _, err := n.sm.Handle(nil, nil); err != nil {\n\t\tt.Fatalf(\"failed to apply config changes %v\", err)\n\t}\n\tm := n.sm.GetMembership()\n\t_, localIsWitness := m.Witnesses[2]\n\tfmt.Printf(\"CA_EVENT {\\\"event\\\":\\\"membership\\\",\\\"addresses\\\":%d,\\\"witnesses\\\":%d,\\\"local_is_witness\\\":%t,\\\"config_change_id\\\":%d}\\n\",\n\t\tlen(m.Addresses), len(m.Witnesses), localIsWitness, m.ConfigChangeId)\n\n\tn.notifyConfigChange()\n\tstored, ok := n.clusterInfo.Load().(*ClusterInfo)\n\tif !ok || stored == nil {\n\t\tt.Fatalf(\"no cluster record stored\")\n\t}\n\tfmt.Printf(\"CA_EVENT {\\\"event\\\":\\\"stored\\\",\\\"is_witness\\\":%t,\\\"is_observer\\\":%t,\\\"config_index\\\":%d,\\\"node_count\\\":%d}\\n\",\n\t\tstored.IsWitness, stored.IsObserver, stored.ConfigChangeIndex, len(stored.Nodes))\n\n\treported := n.getClusterInfo()\n\tfmt.Printf(\"CA_EVENT {\\\"event\\\":\\\"reported\\\",\\\"is_witness\\\":%t,\\\"is_observer\\\":%t,\\\"pending\\\":%t,\\\"config_index\\\":%d,\\\"node_count\\\":%d}\\n\",\n\t\treported.IsWitness, reported.IsObserver, reported.Pending,\n\t\treported.ConfigChangeIndex, len(reported.Nodes))\n}\n","exit_code":0,"status":"completed"}}
