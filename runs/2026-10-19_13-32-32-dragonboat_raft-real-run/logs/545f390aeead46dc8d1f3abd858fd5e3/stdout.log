rance/runs/2026-10-19_13-32-32-dragonboat_raft-real-run/draft\",\n  \"state_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-19_13-32-32-dragonboat_raft-real-run/state.json\",\n  \"submission_schema\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-19_13-32-32-dragonboat_raft-real-run/submission.schema.json\",\n  \"method_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-19_13-32-32-dragonboat_raft-real-run/audit-method.md\",\n  \"directed_question\": null,\n  \"investigation_focus\": [],\n  \"investigations\": [\n    {\n      \"id\": \"1b1f6ec36e5540a5a256dc25dd86cc61-question-0\",\n      \"version\": 2,\n      \"question\": \"When a leader loses authority (check-quorum step-down or another raft state transition) while a ReadIndex request is registered in the raft readIndex queue, does the request retain a legal terminal outcome in the node layer, and can a stale heartbeat confirmation from the deposed leader wrongly complete it?\",\n      \"hypothesis\": \"reset() discards registered read contexts without emitting DroppedReadIndexes, so a request registered before the step-down can only be terminated by the node-layer deadline as RequestTimeout; a deposed leader cannot complete the request from stale heartbeat responses because follower state has no HeartbeatResp handler and lower-term messages are dropped.\",\n      \"discriminator\": \"Whether a remote requester's ReadIndexResp (or leader-local ReadyToRead) can fail to be emitted when confirmation and reset race in the same event batch, so the batch stays unindexed until its deadline, and whether any node-layer observation shows a terminal result other than RequestTimeout in that window.\",\n      \"disposition\": \"explained\",\n      \"parent_id\": null,\n      \"source_ids\": [\n        \"raft_leader_readindex\",\n        \"raft_heartbeat_resp\",\n        \"raft_readindex_confirm\",\n        \"raft_checkquorum_stepdown\",\n        \"raft_reset_replaces_readindex\",\n        \"raft_follower_handler_map\",\n        \"raft_term_check\",\n        \"raft_readindex_confirm_core\",\n        \"peer_handle_response_filter\",\n        \"node_read_admission\",\n        \"node_handle_events\",\n        \"node_tick\",\n        \"request_pending_readindex_applied_gc\",\n        \"request_dropped_timeout\"\n      ],\n      \"resume_conditions\": [],\n      \"knowledge\": [],\n      \"open_gaps\": [],\n      \"latest_execution\": {\n        \"id\": \"3008fe6b26434113be5cd484d8d7a5a6\",\n        \"experiment_id\": \"b9e49b2df9c8453aab2f0b292ce3c176-experiment\",\n        \"status\": \"completed\",\n        \"exit_code\": 0,\n        \"record\": \"logs/3008fe6b26434113be5cd484d8d7a5a6/check.json\",\n        \"observations\": \"logs/3008fe6b26434113be5cd484d8d7a5a6/observations.json\"\n      },\n      \"latest_interpretation\": {\n        \"id\": \"b6feef742879467d9b34c6e69d947021-interpretation-0\",\n        \"investigation_id\": \"1b1f6ec36e5540a5a256dc25dd86cc61-question-0\",\n        \"experiment_id\": \"b9e49b2df9c8453aab2f0b292ce3c176-experiment\",\n        \"source_ids\": [\n          \"raft_handle_readindex_path\",\n          \"raft_checkquorum_handler\",\n          \"raft_reset_replaces_readindex\",\n          \"raft_readindex_confirm_core\",\n          \"raft_follower_handler_map\",\n          \"raft_term_check\"\n        ],\n        \"executions\": {\n          \"3008fe6b26434113be5cd484d8d7a5a6\": [\n            0,\n            1,\n            2\n          ]\n        },\n        \"conclusion\": \"holds\",\n        \"defect_claim\": \"refuted\",\n        \"rationale\": \"Current claim for this experiment: the raft layer discards a registered read context on the CheckQuorum step-down without reporting it, and a heartbeat response carrying that discarded context afterwards does not complete a reacat: write error: Broken pipe\n","exit_code":0,"status":"completed"}}
