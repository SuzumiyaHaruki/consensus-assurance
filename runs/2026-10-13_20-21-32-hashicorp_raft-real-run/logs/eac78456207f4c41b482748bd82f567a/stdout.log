ster: %v\", err)\n> \t}\n> \treturn c\n> }\n> \n> // NOTE: This is exposed for middleware testing purposes and is not a stable API\n> func MakeClusterCustomWithErr(t *testing.T, opts *MakeClusterOpts) (*cluster, error) {\n> \topts.PropagateError = true\n########## testing_batch.go\n4d3\n< // +build batchtest\n########## transport_test.go\n40c40\n< \t\tdefer trans1.Close()\n---\n> \t\tdefer func() { _ = trans1.Close() }()\n84c84\n< \t\tdefer trans2.Close()\n---\n> \t\tdefer func() { _ = trans2.Close() }()\n104c104\n< \t\tdefer trans1.Close()\n---\n> \t\tdefer func() { _ = trans1.Close() }()\n151c151\n< \t\tdefer trans2.Close()\n---\n> \t\tdefer func() { _ = trans2.Close() }()\n160c160\n< \t\tdefer pipeline.Close()\n---\n> \t\tdefer func() { _ = pipeline.Close() }()\n186c186\n< \t\tdefer trans1.Close()\n---\n> \t\tdefer func() { _ = trans1.Close() }()\n221c221\n< \t\tdefer trans2.Close()\n---\n> \t\tdefer func() { _ = trans2.Close() }()\n241c241\n< \t\tdefer trans1.Close()\n---\n> \t\tdefer func() { _ = trans1.Close() }()\n272c272\n< \t\t\t\trpc.Reader.Read(buf)\n---\n> \t\t\t\t_, _ = rpc.Reader.Read(buf)\n275c275\n< \t\t\t\tif bytes.Compare(buf, []byte(\"0123456789\")) != 0 {\n---\n> \t\t\t\tif !bytes.Equal(buf, []byte(\"0123456789\")) {\n289c289\n< \t\tdefer trans2.Close()\n---\n> \t\tdefer func() { _ = trans2.Close() }()\n312c312\n< \t\tdefer trans1.Close()\n---\n> \t\tdefer func() { _ = trans1.Close() }()\n########## util.go\n17,21d16\n< func init() {\n< \t// Ensure we use a high-entropy seed for the pseudo-random generator\n< \trand.Seed(newSeed())\n< }\n< \n92,100d86\n< // asyncNotifyBool is used to do an async notification\n< // on a bool channel.\n< func asyncNotifyBool(ch chan bool, v bool) {\n< \tselect {\n< \tcase ch <- v:\n< \tdefault:\n< \t}\n< }\n< \n131,135c117,119\n< \thd := codec.MsgpackHandle{\n< \t\tBasicHandle: codec.BasicHandle{\n< \t\t\tTimeNotBuiltin: true,\n< \t\t},\n< \t}\n---\n> \thd := codec.MsgpackHandle{}\n> \thd.TimeNotBuiltin = true\n> \