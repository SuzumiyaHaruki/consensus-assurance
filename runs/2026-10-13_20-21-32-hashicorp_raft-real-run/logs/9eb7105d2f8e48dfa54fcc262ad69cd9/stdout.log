:\\\"code_observation\\\"},\n {\\\"id\\\":\\\"api_addvoter\\\",\\\"file\\\":\\\"api.go\\\",\\\"start_line\\\":994,\\\"end_line\\\":1005,\\\"kind\\\":\\\"code_observation\\\"},\n {\\\"id\\\":\\\"raft_follower_election_abort\\\",\\\"file\\\":\\\"raft.go\\\",\\\"start_line\\\":228,\\\"end_line\\\":246,\\\"kind\\\":\\\"code_observation\\\"},\n {\\\"id\\\":\\\"raft_quorum_size\\\",\\\"file\\\":\\\"raft.go\\\",\\\"start_line\\\":1087,\\\"end_line\\\":1094,\\\"kind\\\":\\\"code_observation\\\"},\n {\\\"id\\\":\\\"config_restore_committed_doc\\\",\\\"file\\\":\\\"config.go\\\",\\\"start_line\\\":242,\\\"end_line\\\":254,\\\"kind\\\":\\\"document_statement\\\"},\n {\\\"id\\\":\\\"log_commit_tracking_iface\\\",\\\"file\\\":\\\"log.go\\\",\\\"start_line\\\":194,\\\"end_line\\\":219,\\\"kind\\\":\\\"interface_statement\\\"}\n]\nd['investigations']=[\n {\\\"ref\\\":\\\"@multivoter\\\",\\\"parent_id\\\":\\\"ef5ddbf78bd4456ea51537bd60a60a80-question-0\\\",\\\"question\\\":\\\"Does the configuration loss also occur for a real membership change in a multi-voter cluster, and can the resulting stale membership produce a decision the committed configuration would not allow?\\\",\n  \\\"source_ids\\\":[\\\"api_restore_committed_call\\\",\\\"api_restore_committed_body\\\",\\\"api_restore_snapshot_config\\\",\\\"api_addvoter\\\",\\\"raft_follower_election_abort\\\",\\\"raft_quorum_size\\\"],\n  \\\"hypothesis\\\":\\\"A node restarted with RestoreCommittedLogs keeps the snapshot's configuration when committed membership changes sit below the restored commit index, so its quorum arithmetic reflects an obsolete membership.\\\",\n  \\\"discriminator\\\":\\\"Grow a snapshot-age three-voter cluster to five voters, restart the leader, and compare the configuration index and server count with the log's latest configuration; then isolate the restarted node with one committed voter and see whether it can win with its smaller quorum.\\\"}\n]\njson.dump(d,open(p,'w'),indent=2)\nprint('stage1 ok')\nPY