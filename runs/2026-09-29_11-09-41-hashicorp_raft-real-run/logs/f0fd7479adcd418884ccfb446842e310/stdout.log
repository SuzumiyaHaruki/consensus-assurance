ing_protections\": [\"voteLock and nil notifyCh prevent further aggregate notification after threshold or negative vote\"], \"source_ids\": [\"S-notify\", \"S-heartbeat\", \"S-reply-match\", \"S-send-snapshot\", \"S-verify-vote\"], \"unknowns\": [\"Response timing relative to registration and membership transitions needs a controlled same-history check\"]}}, \"B-vote\": {\"before\": {}, \"after\": {\"id\": \"B-vote\", \"primary_activity\": \"A2\", \"execution_owner\": \"RequestVote handler and election RPC workers\", \"protocol_context\": \"Candidate address bytes and requested term; last log/snapshot term and index\", \"trigger\": \"Vote request or local election\", \"legal_preconditions\": [], \"implementation_guards\": [\"Known other leader rejects unless transfer flag\", \"Candidate membership/voter checks when ID present\", \"Reject older candidate history or term\", \"Persisted same-term vote restricts another candidate\"], \"reads\": [], \"writes\": [], \"durable_effects\": [\"Current term persisted before in-memory update; vote term and candidate stored with separate calls before granting\"], \"external_effects\": [], \"important_branches\": [\"Same-term same-candidate request reuses stored vote\", \"Storage read/write failure denies grant\", \"Empty legacy ID omits candidate membership tests\"], \"async_boundaries\": [], \"produces_fact_ids\": [\"F-vote\"], \"consumes_fact_ids\": [], \"cross_activity_effects\": {}, \"existing_protections\": [], \"source_ids\": [\"S-vote-handler\", \"S-vote-producer\", \"S-term-persist\"], \"unknowns\": [\"Partial failure between separate vote persistence writes not analyzed\"]}}, \"F-append-success\": {\"before\": {}, \"after\": {\"id\": \"F-append-success\", \"meaning\": \"Receiver accepted this AppendEntries request after applicable term, prefix and storage checks. Empty fast-path success does not certify any positive log index.\", \"identity\": {\"rpc\": \"Concrete request/response association\", \"context\": \"Request Term and previous-log fields\"}, \"validity_context\": \"Receiver state when processing request; later transitions may supersede it\", \"representation\": [\"AppendEntriesResponse.Success\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Volatile observation/state; not a durable certificate.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-append\", \"S-net-fastpath\"], \"unknowns\": []}}, \"F-applied\": {\"before\": {}, \"after\": {\"id\": \"F-applied\", \"meaning\": \"FSM command callback or batch callback has returned for the dispatched entry; where present its future is then completed successfully. Main-loop lastApplied alone is weaker.\", \"identity\": {\"entry\": \"Log Index/Term\", \"operation\": \"Associated future if locally invoked\"}, \"validity_context\": \"Single FSM worker processing committed batches\", \"representation\": [\"ApplyFuture response\", \"FSM worker lastIndex/lastTerm\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Application persistence depends on FSM/snapshot implementation.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-fsm-worker\", \"S-dispatch-apply\"], \"unknowns\": []}}, \"F-authority\": {\"before\": {}, \"after\": {\"id\": \"F-authority\", \"meaning\": \"Candidate loop counted enough granted responses from its campaign channel and entered Leader; this is local role acquisition, not perpetual authority.\", \"identity\": {\"server\": \"localID\", \"campaign\": \"term and campaign response channel\"}, \"validity_context\": \"Latest voter majority at campaign start; until role loss or cleanup\", \"representation\": [\"Raft state Leader\", \"leaderAddr/leaderID\"], \"invalidators\": [\"B-leader-session\", \"B-append\"], \"reinterpreters\": [], \"durability\": \"Volatile observation/state; not a durable certificate.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-election\", \"S-vote-producer\", \"S-leader-session\"], \"unknowns\": []}}, \"F-commit\": {\"before\": {}, \"after\": {\"id\": \"F-commit\", \"meaning\": \"Session commitment calculator found a majority of tracked voters at or beyond this index and reached startIndex; leader main loop copied the resulting index.\", \"identity\": {\"session\": \"commitment object\", \"prefix\": \"commitIndex\"}, \"validity_context\": \"Current tracked voter set; monotone commit index within session\", \"representation\": [\"commitment.commitIndex\", \"Raft commitIndex\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Volatile decision tracking; logs/snapshots persist supporting history.\", \"recovery\": \"A new leader rebuilds matches and commits a current-term entry; followers learn leader commit index.\", \"source_ids\": [\"S-commitment\", \"S-leader-loop\"], \"unknowns\": []}}, \"F-local-store\": {\"before\": {}, \"after\": {\"id\": \"F-local-store\", \"meaning\": \"LogStore.StoreLogs returned nil for this leader-assigned prefix; local match was submitted. This does not itself establish a quorum.\", \"identity\": {\"log\": \"Index and Term\", \"owner\": \"local ServerID / session\"}, \"validity_context\": \"Leader dispatch, before later truncation or restore\", \"representation\": [\"Stored Log\", \"commitment.match(localID,index)\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Durability relies on supplied LogStore implementation.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-dispatch-apply\"], \"unknowns\": []}}, \"F-peer-match\": {\"before\": {}, \"after\": {\"id\": \"F-peer-match\", \"meaning\": \"A worker has reported successful append through its request last index, or successful installation through a snapshot index, into its captured commitment object. Eligibility is separately filtered there.\", \"identity\": {\"peer\": \"ServerID\", \"session\": \"Captured commitment object\", \"prefix\": \"matchIndex\"}, \"validity_context\": \"Specific leader session; inferred agreement assumes legal producer history and storage contract\", \"representation\": [\"commitment.matchIndexes\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Volatile observation/state; not a durable certificate.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-reply-match\", \"S-send-snapshot\", \"S-commitment\"], \"unknowns\": [\"Transport substitution and snapshot-history validity must be justified for any executed check\"]}}, \"F-verify-support\": {\"before\": {}, \"after\": {\"id\": \"F-verify-support\", \"meaning\": \"A registered replication worker detached a pending verifyFuture and delivered vote(true) because an append/heartbeat/snapshot path reported success. This records positive worker support; it does not assert that the worker is a voter or that a fresh post-registration RPC ran.\", \"identity\": {\"verification\": \"verifyFuture pointer\", \"supporter\": \"Owning followerReplication peer\", \"session\": \"Captured replication tenure\"}, \"validity_context\": \"Registration survives until detached or cleaned; aggregate vote loses peer identity\", \"representation\": [\"followerReplication.notify\", \"verifyFuture.vote(true)\"], \"invalidators\": [\"B-leader-session\"], \"reinterpreters\": [], \"durability\": \"Volatile observation/state; not a durable certificate.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-notify\", \"S-heartbeat\", \"S-reply-match\", \"S-send-snapshot\", \"S-verify-vote\"], \"unknowns\": [\"Membership eligibility and response freshness are not encoded in vote(bool)\", \"Competing negative delivery can terminate the future before sufficient positives\"]}}, \"F-vote\": {\"before\": {}, \"after\": {\"id\": \"F-vote\", \"meaning\": \"An actual election response grants a vote for the campaign after successful persisted vote writes, or reuses a matching same-term persisted vote. It is distinct from provisional pre-vote.\", \"identity\": {\"voter\": \"Requested server identity\", \"candidate\": \"Candidate address bytes\", \"term\": \"Request term\"}, \"validity_context\": \"Per-campaign response channel with membership selected at launch\", \"representation\": [\"RequestVoteResponse.Granted\", \"keyLastVoteTerm/keyLastVoteCand\"], \"invalidators\": [], \"reinterpreters\": [], \"durability\": \"Vote term and candidate use separate StableStore writes.\", \"recovery\": \"Re-established by actual producers after restart.\", \"source_ids\": [\"S-vote-handler\", \"S-vote-producer\", \"S-term-persist\"], \"unknowns\": [\"Atomicity under partial StableStore write failure remains open\"]}}, \"core_overview\": {\"before\": {}, \"after\": {\"formation\": {\"explanation\": \"Apply creates a future on applyCh. The leader main loop assigns index/term and stores logs; only successful storage reports local match. Per-peer workers send real AppendEntries with previous-log identity, term and leader commit index. Receiver rejects stale terms or mismatched prefix, truncates conflicts, stores new suffix and updates configuration before successful response. Successful nonempty append or snapshot installation advances that worker's captured session commitment. Commitment counts only current voter IDs and requires a majority match reaching the first index of this tenure; leaderLoop consumes commitCh, records commitment and queues committed entries. Followers learn commit index from ordinary replication; empty independent heartbeat carries neither entries nor commit index. processLogs dispatches in order to runFSM; command completion follows Apply/ApplyBatch return, while the main-loop lastApplied value only tracks dispatch. Replication retry and snapshot fallback recover lagging peers.\", \"behavior_ids\": [\"B-submit\", \"B-dispatch\", \"B-append\", \"B-reply-match\", \"B-commit\", \"B-apply\", \"B-recover\"], \"fact_ids\": [\"F-local-store\", \"F-append-success\", \"F-peer-match\", \"F-commit\", \"F-applied\"], \"source_ids\": [\"S-api-apply\", \"S-append\", \"S-bootstrap\", \"S-commitment\", \"S-config-replay\", \"S-dispatch-apply\", \"S-follower\", \"S-fsm-contract\", \"S-fsm-worker\", \"S-install\", \"S-leader-loop\", \"S-leader-session\", \"S-net-fastpath\", \"S-pipeline-consume\", \"S-repl-membership\", \"S-replicate\", \"S-reply-match\", \"S-send-snapshot\", \"S-startup\"]}, \"context\": {\"explanation\": \"Startup reads durable term and log, restores snapshot/FSM and membership, replays suffix configurations and starts as Follower. Ordinary contact timeout campaigns only for a local voter. Optional pre-vote does not persist a vote; actual electSelf increments durable term, persists self-vote and sends one request per voter into a campaign-specific channel. RequestVote rejects stale history/term, disallowed membership or another known leader (transfer excepted), and persists vote before grant. Candidate majority enters Leader; newer term responses, received append, lease quorum loss or committed local removal exit it. Leadership transfer first catches the target up, suppresses new leader work, then sends TimeoutNow to trigger election without pre-vote. VerifyLeader separately registers an authority observation with replication workers and returns from aggregate support; that support eligibility is an open local question.\", \"behavior_ids\": [\"B-recover\", \"B-vote\", \"B-election\", \"B-leader-session\", \"B-membership\", \"B-verify-register\", \"B-verify-support\", \"B-verify-consume\"], \"fact_ids\": [\"F-vote\", \"F-authority\", \"F-verify-support\"], \"source_ids\": [\"S-api-verify\", \"S-bootstrap\", \"S-commitment\", \"S-config-dispatch\", \"S-config-replay\", \"S-election\", \"S-follower\", \"S-fsm-worker\", \"S-heartbeat\", \"S-install\", \"S-leader-loop\", \"S-leader-session\", \"S-lease\", \"S-membership-change\", \"S-membership-contract\", \"S-notify\", \"S-prevote-handler\", \"S-prevote-producer\", \"S-repl-membership\", \"S-reply-match\", \"S-send-snapshot\", \"S-startup\", \"S-term-persist\", \"S-timeout-now\", \"S-transfer\", \"S-verify-register\", \"S-verify-vote\", \"S-vote-handler\", \"S-vote-producer\"]}, \"connection\": {\"explanation\": \"Every tenure creates a new commitment object, isolated replication workers and an initial term no-op. Existing durable history survives role loss, but old worker replies retain the old commitment/channel and do not certify a new tenure. Current-term commitment reconciles inherited history before allowing a new membership change. Membership activates latest voter eligibility at configuration append; retained voter matches survive by permanent ServerID, while new voters start at zero. Only one uncommitted configuration is admitted and committed local removal ends leadership. Exit fails pending inflight/verify futures, while already committed work queued to the FSM continues; ErrLeadershipLost is explicitly ambiguous about actual commitment. Recovery restores snapshot index/term/configuration and reconstructs latest configuration from retained logs. Snapshot production pairs applied state with committed configuration; manual Restore is an explicitly exceptional recovery operation that aborts inflight work and forces snapshot propagation followed by no-op commitment. Verification support differs from log support: all replication workers can notify pending verification, although voter filtering protects log commitment and lease quorum. This distinction supplies a focused question rather than a conclusion about safety.\", \"behavior_ids\": [\"B-leader-session\", \"B-commit\", \"B-membership\", \"B-apply\", \"B-recover\", \"B-snapshot\", \"B-user-restore\", \"B-verify-support\", \"B-verify-consume\"], \"fact_ids\": [\"F-peer-match\", \"F-commit\", \"F-authority\", \"F-verify-support\"], \"source_ids\": [\"S-api-apply\", \"S-api-verify\", \"S-append\", \"S-bootstrap\", \"S-commitment\", \"S-config-dispatch\", \"S-config-replay\", \"S-dispatch-apply\", \"S-election\", \"S-fsm-contract\", \"S-fsm-worker\", \"S-heartbeat\", \"S-install\", \"S-leader-loop\", \"S-leader-session\", \"S-lease\", \"S-membership-change\", \"S-membership-contract\", \"S-notify\", \"S-repl-membership\", \"S-reply-match\", \"S-restore-api\", \"S-restore-user\", \"S-send-snapshot\", \"S-snapshot-produce\", \"S-startup\", \"S-timeout-now\", \"S-transfer\", \"S-verify-register\", \"S-verify-vote\", \"S-vote-producer\"]}, \"open_details\": [\"VerifyLeader supporter eligibility, response timing and behavior across configuration activation\", \"Heartbeat response term/contact asymmetry with blocked ordinary progress\", \"Partial StableStore failure and network fast-path concurrency\", \"Production store/snapshot failure variants, transport pipeline internals and manual RecoverCluster\", \"Legacy interoperability and application-specific FSM behavior\"], \"core_gaps\": [], \"status\": \"usable\", \"rationale\": \"Representative normal command formation and authority acquisition/loss have been followed through real producers, consumers, membership, storage, recovery and completion. Usable identifies a sourced investigation basis, not verified correctness or exhaustive coverage.\"}}, \"surface:NetworkTransport heartbeat callback concurrent with appendEntries/installSnapshot\": {\"before\": {}, \"after\": {\"entry_point\": \"NetworkTransport heartbeat callback concurrent with appendEntries/installSnapshot\", \"disposition\": \"deferred\", \"behavior_ids\": [], \"reason\": \"Actual fast-path ownership differs from main-thread comments. Need same-history ordering, durable update semantics and real transport schedules.\", \"source_ids\": [\"S-net-fastpath\", \"S-append\", \"S-install\", \"S-startup\"], \"high_consequence\": true}}, \"surface:RecoverCluster and persistence backend variants\": {\"before\": {}, \"after\": {\"entry_point\": \"RecoverCluster and persistence backend variants\", \"disposition\": \"deferred\", \"behavior_ids\": [], \"reason\": \"Manual recovery is separately documented at the API boundary; its full implementation and backend failure variants have not been expanded in this normal-operation map.\", \"source_ids\": [\"S-bootstrap\", \"S-restore-api\"], \"high_consequence\": true}}, \"surface:heartbeat -> LastContact -> checkLeaderLease\": {\"before\": {}, \"after\": {\"entry_point\": \"heartbeat -> LastContact -> checkLeaderLease\", \"disposition\": \"deferred\", \"behavior_ids\": [], \"reason\": \"Heartbeat refreshes contact even on unsuccessful replies and lacks the ordinary replication response-term check. Need permitted blocked-progress schedule and precise lease contract before drawing a consequence.\", \"source_ids\": [\"S-heartbeat\", \"S-lease\", \"S-replicate\"], \"high_consequence\": true}}, \"surface:persistVote -> same-term duplicate RequestVote\": {\"before\": {}, \"after\": {\"entry_point\": \"persistVote -> same-term duplicate RequestVote\", \"disposition\": \"deferred\", \"behavior_ids\": [], \"reason\": \"Separate term/candidate writes and duplicate-vote reuse invite partial-write recovery analysis; concrete backend/fault responsibility not established.\", \"source_ids\": [\"S-term-persist\", \"S-vote-handler\", \"S-store-contract\"], \"high_consequence\": true}}, \"target_profile\": {\"before\": {}, \"after\": {\"system_boundary\": \"Captured Go raft library: main role loop, per-peer replication and heartbeats, FSM and snapshot workers, injectable transports/stores/FSM. No production deployment or caller application is supplied.\", \"protocol_contexts\": [\"Per-Raft term and role\", \"Per-leader commitment object and worker generation\", \"Latest and committed indexed membership\", \"Per-entry index/term and per-future identity\"], \"external_interfaces\": [\"Apply/ApplyLog, VerifyLeader, membership APIs, Restore\", \"Transport RPC and optional heartbeat fast path\", \"LogStore, StableStore, SnapshotStore and caller FSM\"], \"ownership\": [\"Main loop owns leader state and configuration\", \"Independent workers send support through locked commitment and verification objects\", \"Network fast-path may process empty heartbeats concurrently with blocking main RPC\"], \"selection_injection\": [\"NewRaft takes caller-supplied stores, transport, FSM and validated Config; in-repository implementations are not assumed externalized\"], \"variants\": [\"Protocol compatibility branches\", \"PreVoteDisabled or unsupported transport\", \"BatchingFSM and ConfigurationStore\", \"Network fast-path vs in-memory transport\", \"MonotonicLogStore and NoSnapshotRestoreOnStart\"], \"source_ids\": [\"S-startup\", \"S-inmem-transport\", \"S-net-fastpath\", \"S-inmem-store\", \"S-transport-contract\"], \"unknowns\": [\"Full production persistence, transport failure semantics and application-specific FSM contracts remain outside this initial trace\"]}}}, \"map_effects\": {}, \"candidate_ids\": [\"e882dd28e3a74f959e62c629f3382252\"]}\n","exit_code":0,"status":"completed"}}
