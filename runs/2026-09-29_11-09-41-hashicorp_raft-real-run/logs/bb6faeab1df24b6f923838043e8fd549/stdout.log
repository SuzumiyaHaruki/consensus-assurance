{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,137p' ../agent-source/replication.go; sed -n '250,310p' ../agent-source/future.go; sed -n '875,897p' ../agent-source/api.go; sed -n '660,745p' ../agent-source/net_transport.go; sed -n '50,85p' ../agent-source/inmem_transport.go; sed -n '1035,1102p' ../agent-source/api.go; sed -n '1,110p' ../agent-source/transport.go; sed -n '1,125p' ../agent-source/inmem_store.go; sed -n '1,95p' ../agent-source/config.go; find . -name guide.md -o -name AGENTS.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,137p' ../agent-source/replication.go; sed -n '250,310p' ../agent-source/future.go; sed -n '875,897p' ../agent-source/api.go; sed -n '660,745p' ../agent-source/net_transport.go; sed -n '50,85p' ../agent-source/inmem_transport.go; sed -n '1035,1102p' ../agent-source/api.go; sed -n '1,110p' ../agent-source/transport.go; sed -n '1,125p' ../agent-source/inmem_store.go; sed -n '1,95p' ../agent-source/config.go; find . -name guide.md -o -name AGENTS.md\"","aggregated_output":"\t\treturn future\n\tcase <-r.shutdownCh:\n\t\tfuture.respond(ErrRaftShutdown)\n\t\treturn future\n\t}\n}\n\n// Restore is used to manually force Raft to consume an external snapshot, such\n// as if restoring from a backup. We will use the current Raft configuration,\n// not the one from the snapshot, so that we can restore into a new cluster. We\n// will also use the max of the index of the snapshot, or the current index,\n// and then add 1 to that, so we force a new state with a hole in the Raft log,\n// so that the snapshot will be sent to followers and used for any new joiners.\n// This can only be run on the leader, and blocks until the restore is complete\n// or an error occurs.\n//\n// WARNING! This operation has the leader take on the state of the snapshot and\n// then sets itself up so that it replicates that to its followers though the\n// install snapshot process. This involves a potentially dangerous period where\n// the leader commits ahead of its followers, so should only be used for disaster\n// recovery into a fresh cluster, and should not be used in normal operations.\nfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n\tvar timer <-chan time.Time\n\tif timeout > 0 {\n\t\ttimer = time.After(timeout)\n\t}\n\n\t// Perform the restore.\n\trestore := &userRestoreFuture{\n\t\tmeta:   meta,\n\t\treader: reader,\n\t}\n\trestore.init()\n\tselect {\n\tcase <-timer:\n\t\treturn ErrEnqueueTimeout\n\tcase <-r.shutdownCh:\n\t\treturn ErrRaftShutdown\n\tcase r.userRestoreCh <- restore:\n\t\t// If the restore is ingested then wait for it to complete.\n\t\tif err := restore.Error(); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n\t// followers have gotten the restore and replicated at least this new\n\t// entry, which shows that we've also faulted and installed the\n\t// snapshot with the contents of the restore.\n\tnoop := &logFuture{\n\t\tlog: Log{\n\t\t\tType: LogNoop,\n\t\t},\n\t}\n\tnoop.init()\n\tselect {\n\tcase <-timer:\n\t\treturn ErrEnqueueTimeout\n\tcase <-r.shutdownCh:\n\t\treturn ErrRaftShutdown\n\tcase r.applyCh <- noop:\n\t\treturn noop.Error()\n\t}\n}\n\n// State returns the state of this raft peer.\nfunc (r *Raft) State() RaftState {\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"io\"\n\t\"time\"\n)\n\n// RPCResponse captures both a response and a potential error.\ntype RPCResponse struct {\n\tResponse interface{}\n\tError    error\n}\n\n// RPC has a command, and provides a response mechanism.\ntype RPC struct {\n\tCommand  interface{}\n\tReader   io.Reader // Set only for InstallSnapshot\n\tRespChan chan<- RPCResponse\n}\n\n// Respond is used to respond with a response, error or both\nfunc (r *RPC) Respond(resp interface{}, err error) {\n\tr.RespChan <- RPCResponse{resp, err}\n}\n\n// Transport provides an interface for network transports\n// to allow Raft to communicate with other nodes.\ntype Transport interface {\n\t// Consumer returns a channel that can be used to\n\t// consume and respond to RPC requests.\n\tConsumer() <-chan RPC\n\n\t// LocalAddr is used to return our local address to distinguish from our peers.\n\tLocalAddr() ServerAddress\n\n\t// AppendEntriesPipeline returns an interface that can be used to pipeline\n\t// AppendEntries requests.\n\tAppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error)\n\n\t// AppendEntries sends the appropriate RPC to the target node.\n\tAppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error\n\n\t// RequestVote sends the appropriate RPC to the target node.\n\tRequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error\n\n\t// InstallSnapshot is used to push a snapshot down to a follower. The data is read from\n\t// the ReadCloser and streamed to the client.\n\tInstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error\n\n\t// EncodePeer is used to serialize a peer's address.\n\tEncodePeer(id ServerID, addr ServerAddress) []byte\n\n\t// DecodePeer is used to deserialize a peer's address.\n\tDecodePeer([]byte) ServerAddress\n\n\t// SetHeartbeatHandler is used to setup a heartbeat handler\n\t// as a fast-pass. This is to avoid head-of-line blocking from\n\t// disk IO. If a Transport does not support this, it can simply\n\t// ignore the call, and push the heartbeat onto the Consumer channel.\n\tSetHeartbeatHandler(cb func(rpc RPC))\n\n\t// TimeoutNow is used to start a leadership transfer to the target node.\n\tTimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error\n}\n\n// WithPreVote is an interface that a transport may provide which\n// allows a transport to support a PreVote request.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithPreVote interface {\n\t// RequestPreVote sends the appropriate RPC to the target node.\n\tRequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error\n}\n\n// WithClose is an interface that a transport may provide which\n// allows a transport to be shut down cleanly when a Raft instance\n// shuts down.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithClose interface {\n\t// Close permanently closes a transport, stopping\n\t// any associated goroutines and freeing other resources.\n\tClose() error\n}\n\n// LoopbackTransport is an interface that provides a loopback transport suitable for testing\n// e.g. InmemTransport. It's there so we don't have to rewrite tests.\ntype LoopbackTransport interface {\n\tTransport   // Embedded transport reference\n\tWithPeers   // Embedded peer management\n\tWithClose   // with a close routine\n\tWithPreVote // with a prevote\n}\n\n// WithPeers is an interface that a transport may provide which allows for connection and\n// disconnection. Unless the transport is a loopback transport, the transport specified to\n// \"Connect\" is likely to be nil.\ntype WithPeers interface {\n\tConnect(peer ServerAddress, t Transport) // Connect a peer\n\tDisconnect(peer ServerAddress)           // Disconnect a given peer\n\tDisconnectAll()                          // Disconnect all peers, possibly to reconnect them later\n}\n\n// AppendPipeline is used for pipelining AppendEntries requests. It is used\n// to increase the replication throughput by masking latency and better\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"errors\"\n\t\"sync\"\n)\n\n// InmemStore implements the LogStore and StableStore interface.\n// It should NOT EVER be used for production. It is used only for\n// unit tests. Use the MDBStore implementation instead.\ntype InmemStore struct {\n\tl         sync.RWMutex\n\tlowIndex  uint64\n\thighIndex uint64\n\tlogs      map[uint64]*Log\n\tkv        map[string][]byte\n\tkvInt     map[string]uint64\n}\n\n// NewInmemStore returns a new in-memory backend. Do not ever\n// use for production. Only for testing.\nfunc NewInmemStore() *InmemStore {\n\ti := &InmemStore{\n\t\tlogs:  make(map[uint64]*Log),\n\t\tkv:    make(map[string][]byte),\n\t\tkvInt: make(map[string]uint64),\n\t}\n\treturn i\n}\n\n// FirstIndex implements the LogStore interface.\nfunc (i *InmemStore) FirstIndex() (uint64, error) {\n\ti.l.RLock()\n\tdefer i.l.RUnlock()\n\treturn i.lowIndex, nil\n}\n\n// LastIndex implements the LogStore interface.\nfunc (i *InmemStore) LastIndex() (uint64, error) {\n\ti.l.RLock()\n\tdefer i.l.RUnlock()\n\treturn i.highIndex, nil\n}\n\n// GetLog implements the LogStore interface.\nfunc (i *InmemStore) GetLog(index uint64, log *Log) error {\n\ti.l.RLock()\n\tdefer i.l.RUnlock()\n\tl, ok := i.logs[index]\n\tif !ok {\n\t\treturn ErrLogNotFound\n\t}\n\t*log = *l\n\treturn nil\n}\n\n// StoreLog implements the LogStore interface.\nfunc (i *InmemStore) StoreLog(log *Log) error {\n\treturn i.StoreLogs([]*Log{log})\n}\n\n// StoreLogs implements the LogStore interface.\nfunc (i *InmemStore) StoreLogs(logs []*Log) error {\n\ti.l.Lock()\n\tdefer i.l.Unlock()\n\tfor _, l := range logs {\n\t\ti.logs[l.Index] = l\n\t\tif i.lowIndex == 0 {\n\t\t\ti.lowIndex = l.Index\n\t\t}\n\t\tif l.Index > i.highIndex {\n\t\t\ti.highIndex = l.Index\n\t\t}\n\t}\n\treturn nil\n}\n\n// DeleteRange implements the LogStore interface.\nfunc (i *InmemStore) DeleteRange(min, max uint64) error {\n\ti.l.Lock()\n\tdefer i.l.Unlock()\n\tfor j := min; j <= max; j++ {\n\t\tdelete(i.logs, j)\n\t}\n\tif min <= i.lowIndex {\n\t\ti.lowIndex = max + 1\n\t}\n\tif max >= i.highIndex {\n\t\ti.highIndex = min - 1\n\t}\n\tif i.lowIndex > i.highIndex {\n\t\ti.lowIndex = 0\n\t\ti.highIndex = 0\n\t}\n\treturn nil\n}\n\n// Set implements the StableStore interface.\nfunc (i *InmemStore) Set(key []byte, val []byte) error {\n\ti.l.Lock()\n\tdefer i.l.Unlock()\n\ti.kv[string(key)] = val\n\treturn nil\n}\n\n// Get implements the StableStore interface.\nfunc (i *InmemStore) Get(key []byte) ([]byte, error) {\n\ti.l.RLock()\n\tdefer i.l.RUnlock()\n\tval := i.kv[string(key)]\n\tif val == nil {\n\t\treturn nil, errors.New(\"not found\")\n\t}\n\treturn val, nil\n}\n\n// SetUint64 implements the StableStore interface.\nfunc (i *InmemStore) SetUint64(key []byte, val uint64) error {\n\ti.l.Lock()\n\tdefer i.l.Unlock()\n\ti.kvInt[string(key)] = val\n\treturn nil\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"time\"\n\n\t\"github.com/hashicorp/go-hclog\"\n)\n\n// ProtocolVersion is the version of the protocol (which includes RPC messages\n// as well as Raft-specific log entries) that this server can _understand_. Use\n// the ProtocolVersion member of the Config object to control the version of\n// the protocol to use when _speaking_ to other servers. Note that depending on\n// the protocol version being spoken, some otherwise understood RPC messages\n// may be refused. See dispositionRPC for details of this logic.\n//\n// There are notes about the upgrade path in the description of the versions\n// below. If you are starting a fresh cluster then there's no reason not to\n// jump right to the latest protocol version. If you need to interoperate with\n// older, version 0 Raft servers you'll need to drive the cluster through the\n// different versions in order.\n//\n// The version details are complicated, but here's a summary of what's required\n// to get from a version 0 cluster to version 3:\n//\n//  1. In version N of your app that starts using the new Raft library with\n//     versioning, set ProtocolVersion to 1.\n//  2. Make version N+1 of your app require version N as a prerequisite (all\n//     servers must be upgraded). For version N+1 of your app set ProtocolVersion\n//     to 2.\n//  3. Similarly, make version N+2 of your app require version N+1 as a\n//     prerequisite. For version N+2 of your app, set ProtocolVersion to 3.\n//\n// During this upgrade, older cluster members will still have Server IDs equal\n// to their network addresses. To upgrade an older member and give it an ID, it\n// needs to leave the cluster and re-enter:\n//\n//  1. Remove the server from the cluster with RemoveServer, using its network\n//     address as its ServerID.\n//  2. Update the server's config to use a UUID or something else that is\n//     not tied to the machine as the ServerID (restarting the server).\n//  3. Add the server back to the cluster with AddVoter, using its new ID.\n//\n// You can do this during the rolling upgrade from N+1 to N+2 of your app, or\n// as a rolling change at any time after the upgrade.\n//\n// # Version History\n//\n// 0: Original Raft library before versioning was added. Servers running this\n//\n//\tversion of the Raft library use AddPeerDeprecated/RemovePeerDeprecated\n//\tfor all configuration changes, and have no support for LogConfiguration.\n//\n// 1: First versioned protocol, used to interoperate with old servers, and begin\n//\n//\tthe migration path to newer versions of the protocol. Under this version\n//\tall configuration changes are propagated using the now-deprecated\n//\tRemovePeerDeprecated Raft log entry. This means that server IDs are always\n//\tset to be the same as the server addresses (since the old log entry type\n//\tcannot transmit an ID), and only AddPeer/RemovePeer APIs are supported.\n//\tServers running this version of the protocol can understand the new\n//\tLogConfiguration Raft log entry but will never generate one so they can\n//\tremain compatible with version 0 Raft servers in the cluster.\n//\n// 2: Transitional protocol used when migrating an existing cluster to the new\n//\n//\tserver ID system. Server IDs are still set to be the same as server\n//\taddresses, but all configuration changes are propagated using the new\n//\tLogConfiguration Raft log entry type, which can carry full ID information.\n//\tThis version supports the old AddPeer/RemovePeer APIs as well as the new\n//\tID-based AddVoter/RemoveServer APIs which should be used when adding\n//\tversion 3 servers to the cluster later. This version sheds all\n//\tinteroperability with version 0 servers, but can interoperate with newer\n//\tRaft servers running with protocol version 1 since they can understand the\n//\tnew LogConfiguration Raft log entry, and this version can still understand\n//\ttheir RemovePeerDeprecated Raft log entries. We need this protocol version\n//\tas an intermediate step between 1 and 3 so that servers will propagate the\n//\tID information that will come from newly-added (or -rolled) servers using\n//\tprotocol version 3, but since they are still using their address-based IDs\n//\tfrom the previous step they will still be able to track commitments and\n//\ttheir own voting status properly. If we skipped this step, servers would\n//\tbe started with their new IDs, but they wouldn't see themselves in the old\n//\taddress-based configuration, so none of the servers would think they had a\n//\tvote.\n//\n// 3: Protocol adding full support for server IDs and new ID-based server APIs\n//\n//\t(AddVoter, AddNonvoter, etc.), old AddPeer/RemovePeer APIs are no longer\n//\tsupported. Version 2 servers should be swapped out by removing them from\n//\tthe cluster one-by-one and re-adding them with updated configuration for\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']\nfor n in ['CandidateSubmission','AuditQuestion']:\n print(n,json.dumps(s[n],indent=2))\nPY\nsed -n '940,968p' ../agent-source/api.go\nsed -n '1,120p' ../agent-source/docs/apply.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']\nfor n in ['CandidateSubmission','AuditQuestion']:\n print(n,json.dumps(s[n],indent=2))\nPY\nsed -n '940,968p' ../agent-source/api.go\nsed -n '1,120p' ../agent-source/docs/apply.md\"","aggregated_output":"# Raft Apply\n\nApply is the primary operation provided by raft. A client calls `raft.Apply` to apply\na command to the FSM. A command will first be committed, i.e., durably stored on a\nquorum of raft nodes. Then, the committed command is applied to fsm.\n\nThis sequence diagram shows the steps involved in a `raft.Apply` operation. Each box\nacross the top is a separate thread. The name in the box identifies the state of the peer\n(leader or follower) and the thread (`<peer state>:<thread name>`). When there are\nmultiple copies of the thread, it is indicated with `(each peer)`.\n\n```mermaid\nsequenceDiagram\n   autonumber\n \n   participant client\n   participant leadermain as leader:main\n   participant leaderfsm as leader:fsm\n   participant leaderreplicate as leader:replicate (each peer)\n   participant followermain as follower:main (each peer)\n   participant followerfsm as follower:fsm (each peer)\n \n   client-)leadermain: applyCh to dispatchLogs\n   leadermain->>leadermain: store logs to disk\n \n   leadermain-)leaderreplicate: triggerCh\n   leaderreplicate-->>followermain: Transport.AppendEntries RPC\n \n   followermain->>followermain: store logs to disk\n \n   opt leader commit index is ahead of peer commit index\n       followermain-)followerfsm: fsmMutateCh <br>apply committed logs\n       followerfsm->>followerfsm: fsm.Apply\n   end\n \n   followermain-->>leaderreplicate: respond success=true\n   leaderreplicate->>leaderreplicate: update commitment\n \n   opt quorum commit index has increased\n       leaderreplicate-)leadermain: commitCh\n       leadermain-)leaderfsm: fsmMutateCh\n       leaderfsm->>leaderfsm: fsm.Apply\n       leaderfsm-)client: future.respond\n   end\n\n```\n\nFollowing is the description of each step as shown in the above diagram\n\n1. The raft node handles the `raft.Apply` call by creating a new log entry and send the entry\nto the `applyCh` channel.\n\n2. If the node is not a leader, the method will return an error of `ErrNotLeader`. Otherwise,\nthe main loop of the leader node calls `raft.dispatchLogs` to write the log entry locally.\n\n3. `raft.dispatchLogs` also sends a notification to the `f.triggerCh` of each follower (`map[ServerID]*followerReplication`) to start replicating log entries to the followers.\n\n4. For each follower, the leader has started a long running routine (`replicate`) to\nreplicates log entries. On receiving a log entry to the `triggerCh`, the `replicate`\nroutine makes the `Transport.AppendEntries` RPC call to do the replication. The log entries\nto be replicated are from the follower's nextIndex to min(nextIndex + maxAppendEntries, \nleader's lastIndex). Another parameter to AppendEntries is the LeaderCommitIndex. Following\nis some examples:\n\n```\nAppendEntries(Log: 1..5, LeaderCommitIndex: 0)   // Replicating log entries 1..5, \n                                                 // the leader hasn't committed any log entry;\nAppendEntries(Log: 6..8, LeaderCommitIndex: 4)   // Replicating log entries 6..8,\n                                                 // log 0..4 are committed after the leader receives\n                                                 // a quorum of responses\nAppendEntries(Log: 9, LeaderCommitIndex: 8)      // Replicating log entry 9,\n                                                 // log 5..8 are committed.\nAppendEntries(Log: , LeaderCommitIndex: 9)       // no new log, bumping the commit index\n                                                 // to let the follower stay up to date of the\n                                                 // latest committed entries\n```\n\n5. The follower which receives the `appendEntries` RPC calls invokes `raft.appendEntries` to handle\nthe request. It appends any new entries to the local log store.\n\n6. In the same method on the follower as step 5, if the LeaderCommitIndex > this follower's\ncommitIndex, the follower updates it's commitIndex to min(LeaderCommitIndex, index of its last\nlog entries). In the first `AppendEntries` call of the above example, the follower won't\nupdate it's commitIndex, because LeaderCommitIndex is 0. The last RPC call doesn't contain\nany new log, whereas the follower will update its commitIndex to 9.\n\nFurther, the follower start `processLogs` to send all the committed entries that haven't been\napplied to fsm (`fsmMutateCh <- batch`). Otherwise (i.e., `commitIndex <= lastApplied`),\nthe appendEntries RPC call returns success.\n\nTherefore, it's possible that a very small window of time exists when all followers have\ncommitted the log to disk, the write has been realized in the FSM of the leader but the\nfollowers have not yet applied the log to their FSM.\n\n7. The peer applies the committed entries to the FSM.\n\n8. If all went well, the follower responds success (`resp.Success = true`) to the \n`appendEntries` RPC call.\n\n9. On receiving the successful response from `Transport.AppendEntries`, the leader needs to\nupdate the fsm based on the replicated log entries. Specifically, the leader finds the\nhighest log entry index that has been replicated to a quorum of the servers (\n`if quorumMatchIndex > c.commitIndex`), update `commitIndex` to that index, and\nnotify through the `commitCh` channel.\n\n10. The leader receives the notification on the  `r.leaderState.commitCh` channel and starts\ngrouping the entries that can be applied to the fsm.\n\n11. `processLogs` applies all the committed entries that haven't been applied by batching the log entries and forwarding them through the `fsmMutateCh` channel to fsm.\n\n12. The actual place applying the committed log entries is in the main loop of `runFSM()`.\n\n13. After the log entries that contains the client req are applied to the fsm, the fsm\nmodule will set the responses to the client request (`req.future.respond(nil)`). From the\nclient's point of view, the future returned by `raft.Apply` should now be unblocked and\ncalls to `Error()` or `Response()` should return the data at this point.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"I found an eligibility difference worth investigating: log commitment and lease checks filter for voters, while `VerifyLeader` registers with every replication worker, including nonvoters. That is a sourced lead, not yet a demonstrated violation. I’ll save it with the two-path overview and keep the negative-response, lease-expiry, and leader-exit protections explicit.\n"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nsrc('S-api-apply','api.go',803,856)\nsrc('S-api-verify','api.go',880,895,'interface_statement')\nsrc('S-membership-contract','configuration.go',7,81,'interface_statement')\nsrc('S-membership-change','configuration.go',174,309)\nsrc('S-bootstrap','api.go',239,284)\nsrc('S-startup','api.go',500,707)\nsrc('S-follower','raft.go',158,259)\nsrc('S-election','raft.go',285,440)\nsrc('S-leader-session','raft.go',455,579)\nsrc('S-repl-membership','raft.go',582,665)\nsrc('S-leader-loop','raft.go',667,963)\nsrc('S-verify-register','raft.go',965,987)\nsrc('S-transfer','raft.go',990,1030)\nsrc('S-lease','raft.go',1033,1093)\nsrc('S-config-dispatch','raft.go',1203,1241)\nsrc('S-dispatch-apply','raft.go',1244,1386)\nsrc('S-append','raft.go',1418,1582)\nsrc('S-config-replay','raft.go',1585,1600)\nsrc('S-vote-handler','raft.go',1603,1733)\nsrc('S-prevote-handler','raft.go',1736,1807)\nsrc('S-vote-producer','raft.go',1976,2044)\nsrc('S-prevote-producer','raft.go',2050,2127)\nsrc('S-term-persist','raft.go',2130,2160)\nsrc('S-timeout-now','raft.go',2208,2227)\nsrc('S-replicate','replication.go',137,296)\nsrc('S-heartbeat','replication.go',388,443)\nsrc('S-pipeline-consume','replication.go',534,584)\nsrc('S-reply-match','replication.go',646,667)\nsrc('S-notify','replication.go',98,135)\nsrc('S-verify-vote','future.go',272,295)\nsrc('S-commitment','commitment.go',10,104)\nsrc('S-fsm-contract','fsm.go',15,65,'interface_statement')\nsrc('S-fsm-worker','fsm.go',83,266)\nsrc('S-install','raft.go',1814,1954)\nsrc('S-send-snapshot','replication.go',299,383)\nsrc('S-snapshot-produce','snapshot.go',125,211)\nsrc('S-restore-user','raft.go',1104,1199)\nsrc('S-restore-api','api.go',1040,1100)\nsrc('S-net-fastpath','net_transport.go',660,742)\nsrc('S-inmem-transport','inmem_transport.go',50,85)\nsrc('S-transport-contract','transport.go',28,77,'interface_statement')\nsrc('S-store-contract','stable.go',6,19,'interface_statement')\nsrc('S-inmem-store','inmem_store.go',11,120)\nB=[]\ndef beh(i,a,owner,ctx,trigger,ss,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trigger,source_ids=ss);d.update(kw);B.append(d)\nbeh('B-submit','A7','API caller and leader/follower main loops','One Apply future; term and index assigned only on dispatch','Apply/ApplyLog queues a command', ['S-api-apply','S-follower','S-leader-loop'],writes=['New logFuture carrying command bytes'],external_effects=['Enqueue timeout and shutdown return errors; nonleaders reject; leader dispatches unless transfer or step-down prohibits it'],async_boundaries=['applyCh and future completion'],unknowns=['Caller byte ownership and batching races are not analyzed'])\nbeh('B-dispatch','A6','Leader main loop','Current leader session and newly assigned contiguous log indexes','Leader accepts command, configuration entry or initial no-op',['S-dispatch-apply','S-leader-session'],writes=['Assign Index/Term, append inflight list, update lastLog after StoreLogs success'],durable_effects=['Calls LogStore.StoreLogs before recording local match'],external_effects=['Notifies replication workers'],important_branches=['StoreLogs error fails submitted futures and switches to Follower'],produces_fact_ids=['F-local-store'],cross_activity_effects={'A1':'Local storage success supplies the local voter match to the session commitment calculator'},existing_protections=['No local match update on storage error'])\nbeh('B-append','A1','Receiving main RPC loop; network heartbeat callback for empty fast-path requests','Request term, previous index/term, receiver log and configuration','AppendEntries delivered',['S-append','S-config-replay','S-net-fastpath','S-startup'],implementation_guards=['Reject lower term','Check previous entry term if previous index is positive','Return unsuccessful on storage/truncation failures'],writes=['Adopt accepted leader/term; truncate conflicts, store suffix and update latest configuration; advance commit index from leader indication bounded by local last index'],durable_effects=['StoreLogs and durable term update precede successful response'],produces_fact_ids=['F-append-success'],important_branches=['Empty heartbeat has no previous-log check or commit update','Conflicting suffix rolls latest configuration back before replay','Higher term or applicable same-term request switches to Follower'],cross_activity_effects={'A2':'Accepted request can change term, role and known leader','A4':'Configuration entries update latest/committed configuration bookkeeping','A5':'Leader commit indication invokes processLogs'},unknowns=['Concurrent fast-path interaction with blocked ordinary RPCs needs separate schedules','Storage failure after truncation leaves an explicitly noted cached-lastLog concern'])\nbeh('B-reply-match','A1','Per-peer replication worker and pipeline decoder','Captured leader-session commitment pointer and currentTerm; peer ServerID','AppendEntries response received or completed pipeline future consumed',['S-replicate','S-pipeline-consume','S-reply-match','S-repl-membership'],consumes_fact_ids=['F-append-success'],produces_fact_ids=['F-peer-match'],implementation_guards=['Response term greater than request signals session step-down','Only successful responses advance match; empty entry list does not advance match'],writes=['nextIndex and commitment.match for last request entry'],important_branches=['Reject retreats nextIndex; missing prior log switches to snapshot; pipeline failure returns to ordinary replication'],existing_protections=['Old worker retains old session commitment and stepDown channel'],unknowns=['Transport pipeline error/completion contracts need deeper review'])\nbeh('B-commit','A1','Locked commitment object and leader main loop','One leader session; startIndex and latest voter set','Local/peer match or membership update recalculates quorum; commitCh consumed',['S-commitment','S-leader-loop','S-leader-session'],consumes_fact_ids=['F-local-store','F-peer-match'],produces_fact_ids=['F-commit'],implementation_guards=['Only IDs in voter matchIndexes accepted','Matches and commit index only increase','Quorum match must reach startIndex'],writes=['Commitment commitIndex then Raft commitIndex; committed configuration advanced when crossed'],external_effects=['Committed inflight logs passed to processLogs; committed local removal steps down or shuts down'],existing_protections=['Fresh object each leadership session; preserved matches only for retained voters during configuration change'])\nbeh('B-apply','A5','Main loop processLogs and single FSM goroutine','Ordered indexes after lastApplied, with optional per-index future','Committed prefix dispatched to FSM',['S-dispatch-apply','S-fsm-worker','S-fsm-contract','S-leader-loop','S-append'],consumes_fact_ids=['F-commit'],produces_fact_ids=['F-applied'],implementation_guards=['Skip indexes already dispatched','Batch response length checked'],writes=['lastApplied records dispatch progress; FSM worker separately tracks its applied index/term'],external_effects=['Commands call FSM.Apply or ApplyBatch before successful future completion; barriers ordered on same worker'],important_branches=['No-op does not call FSM','Configuration delivery depends on protocol and optional ConfigurationStore/BatchingFSM','Follower application derives from received leader commit indication, not local quorum counting'],async_boundaries=['Buffered fsmMutateCh; completion differs from main-loop lastApplied'],unknowns=['Application-specific deterministic FSM semantics are caller owned'])\nbeh('B-vote','A2','RequestVote handler and election RPC workers','Candidate address bytes and requested term; last log/snapshot term and index','Vote request or local election',['S-vote-handler','S-vote-producer','S-term-persist'],produces_fact_ids=['F-vote'],implementation_guards=['Known other leader rejects unless transfer flag','Candidate membership/voter checks when ID present','Reject older candidate history or term','Persisted same-term vote restricts another candidate'],durable_effects=['Current term persisted before in-memory update; vote term and candidate stored with separate calls before granting'],important_branches=['Same-term same-candidate request reuses stored vote','Storage read/write failure denies grant','Empty legacy ID omits candidate membership tests'],unknowns=['Partial failure between separate vote persistence writes not analyzed'])\nbeh('B-election','A2','Main follower/candidate loops','Latest configuration and per-campaign response channel','Contact timeout or TimeoutNow enters Candidate',['S-follower','S-election','S-prevote-handler','S-prevote-producer','S-vote-producer','S-timeout-now'],consumes_fact_ids=['F-vote'],produces_fact_ids=['F-authority'],implementation_guards=['Ordinary timeout campaigns only if local node is voter','One RPC launched per latest voter and isolated response channel per campaign','Grant threshold is latest voter majority'],writes=['Pre-vote may authorize actual election; electSelf durably increments term and self-votes; majority switches to Leader'],important_branches=['Higher-term response returns to Follower','Timeout restarts campaign; old response channel is no longer selected','Pre-vote disabled or transfer bypasses pre-vote; unsupported peer pre-vote counts as provisional grant, not actual vote'])\nbeh('B-leader-session','A2','Leader main loop, lease checker and transfer worker','Single tenure with private commitment, notify and replication state','Enter leader, lease check, higher-term signal, RPC transition or transfer',['S-leader-session','S-lease','S-transfer','S-leader-loop','S-timeout-now','S-repl-membership'],consumes_fact_ids=['F-authority'],implementation_guards=['Lease counts recent contact only from current voters','Transfer blocks new applies/config changes while active and catches target up before TimeoutNow'],writes=['Create fresh commitment with startIndex=lastIndex+1; append term no-op','On exit stop replicators, fail inflight and verification futures and discard session state'],external_effects=['ErrLeadershipLost does not prove command was not committed'],important_branches=['Already committed logs queued to FSM survive role change','Durable log survives exit; later leader must re-establish eligible matches','Lease contact is a time observation, not an entry replication proof'])\nbeh('B-membership','A4','Leader main loop and configuration replay','Latest and committed configurations identified by log index and unique ServerIDs','Configuration API request or configuration log replay',['S-membership-contract','S-membership-change','S-config-dispatch','S-config-replay','S-repl-membership','S-commitment'],implementation_guards=['New leader waits for current-term commitment and latest configuration commitment before next change','prevIndex conditional update; unique IDs/addresses and at least one voter'],writes=['Append config, activate latest voter set for commitment and start/stop replication workers','Preserve match by retained voter ID, initialize new voters to zero'],cross_activity_effects={'A1':'Defines eligible matches and majority denominator','A2':'Defines voters for elections and leases; committed local removal exits authority'},important_branches=['Replication is started for all nonlocal servers including nonvoters','Address change reuses worker for same permanent ID'],unknowns=['Concurrent pending verification across membership activation needs explicit analysis'])\nbeh('B-verify-register','A2','Leader main loop','One verifyFuture in current leadership session; quorumSize captured at registration','Public VerifyLeader reaches verifyCh',['S-api-verify','S-verify-register','S-repl-membership'],writes=['Initialize votes=1; quorumSize from latest voters; register same future on every replication worker'],external_effects=['Immediate success if quorumSize is one; otherwise trigger heartbeat workers'],important_branches=['No suffrage filter in registration loop'],unknowns=['Whether unqualified supporters can cause a public success after authority loss is not yet checked'])\nbeh('B-verify-support','A2','Heartbeat, replication and snapshot-response workers; followerReplication.notifyAll','Future registered on a specific worker in a leader session','Worker calls notifyAll with positive or negative leader observation',['S-notify','S-heartbeat','S-reply-match','S-send-snapshot','S-verify-vote'],produces_fact_ids=['F-verify-support'],writes=['Atomically detach worker notify map and cast each pending vote once for that detachment'],important_branches=['Heartbeat transport success refreshes contact and uses resp.Success without a response-term comparison','Ordinary append/snapshot detects higher response term and casts negative support','Successful append/snapshot can satisfy pending verification without a new heartbeat'],existing_protections=['voteLock and nil notifyCh prevent further aggregate notification after threshold or negative vote'],unknowns=['Response timing relative to registration and membership transitions needs a controlled same-history check'])\nbeh('B-verify-consume','A2','verifyFuture.vote and leader main loop','Captured quorum size; scalar count for registered future','Positive or negative worker notification and later verifyCh consumption',['S-verify-vote','S-leader-loop','S-leader-session','S-api-verify'],consumes_fact_ids=['F-verify-support'],implementation_guards=['Nonleader loops reject public requests','Negative notification with votes below threshold causes step-down and error','Session cleanup fails pending futures'],writes=['Increment scalar votes; enqueue future when threshold reached or any negative; remove registration from all current workers at completion'],external_effects=['Successful public future when count reaches captured threshold'],unknowns=['No voter identity accompanies vote(bool); applicability of voter-only support to the public leadership assurance must be derived independently'])\nbeh('B-recover','A3','Constructor, InstallSnapshot handler and FSM restore worker','Persisted term, snapshot index/term/configuration and retained suffix','NewRaft startup or snapshot RPC',['S-startup','S-install','S-send-snapshot','S-fsm-worker','S-bootstrap'],produces_fact_ids=['F-peer-match'],implementation_guards=['Reject old-term or unsupported snapshot; require complete bytes and successful sink close and FSM restore before success','Startup returns error if no listed snapshot can be restored'],writes=['Restore lastApplied and snapshot metadata and configuration; scan retained configuration entries at startup'],cross_activity_effects={'A1':'Successful snapshot response advances matching support to snapshot index','A2':'Startup begins Follower with durable current term, restored log metadata and configuration','A4':'Snapshot carries committed membership then retained suffix establishes latest'},important_branches=['NoSnapshotRestoreOnStart intentionally skips FSM load','MonotonicLogStore changes retained-log cleanup; deeper backend variants open'])\nbeh('B-snapshot','A6','Snapshot worker and FSM worker','Applied index/term paired with committed configuration','Snapshot request or periodic production',['S-snapshot-produce','S-fsm-worker'],consumes_fact_ids=['F-applied'],durable_effects=['Persist snapshot and close sink before metadata update and compaction'],implementation_guards=['Reject snapshot whose FSM index precedes committed configuration index'],cross_activity_effects={'A3':'Produces state and configuration used by startup and lagging-peer recovery'},unknowns=['File-store persistence failures and compaction backend variants remain unexpanded'])\nbeh('B-user-restore','A3','Leader main loop, FSM worker and public Restore caller','Explicit disaster recovery into fresh cluster; current membership retained','Restore supplied snapshot',['S-restore-user','S-restore-api'],implementation_guards=['Reject unstable membership and invalid version/size; restore failure after persistence panics'],writes=['Abort inflight futures; synthesize index above local/supplied index and current term; install FSM state; public API follows with a committed no-op'],cross_activity_effects={'A1':'Gap forces lagging replication toward snapshot; no-op completion waits for renewed replication','A7':'ErrAbortedByRestore has a distinct client meaning from ambiguous leadership loss'},unknowns=['Disaster recovery variants are outside normal-operation candidate scope'])\nF=[]\ndef fact(i,m,ident,ctx,rep,ss,dur='Volatile observation/state; not a durable certificate.',rec='Re-established by actual producers after restart.',**kw):\n d=dict(id=i,meaning=m,identity=ident,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=ss);d.update(kw);F.append(d)\nfact('F-local-store','LogStore.StoreLogs returned nil for this leader-assigned prefix; local match was submitted. This does not itself establish a quorum.',{'log':'Index and Term','owner':'local ServerID / session'},'Leader dispatch, before later truncation or restore',['Stored Log','commitment.match(localID,index)'],['S-dispatch-apply'],dur='Durability relies on supplied LogStore implementation.')\nfact('F-append-success','Receiver accepted this AppendEntries request after applicable term, prefix and storage checks. Empty fast-path success does not certify any positive log index.',{'rpc':'Concrete request/response association','context':'Request Term and previous-log fields'},'Receiver state when processing request; later transitions may supersede it',['AppendEntriesResponse.Success'],['S-append','S-net-fastpath'])\nfact('F-peer-match','A worker has reported successful append through its request last index, or successful installation through a snapshot index, into its captured commitment object. Eligibility is separately filtered there.',{'peer':'ServerID','session':'Captured commitment object','prefix':'matchIndex'},'Specific leader session; inferred agreement assumes legal producer history and storage contract',['commitment.matchIndexes'],['S-reply-match','S-send-snapshot','S-commitment'],unknowns=['Transport substitution and snapshot-history validity must be justified for any executed check'])\nfact('F-commit','Session commitment calculator found a majority of tracked voters at or beyond this index and reached startIndex; leader main loop copied the resulting index.',{'session':'commitment object','prefix':'commitIndex'},'Current tracked voter set; monotone commit index within session',['commitment.commitIndex','Raft commitIndex'],['S-commitment','S-leader-loop'],dur='Volatile decision tracking; logs/snapshots persist supporting history.',rec='A new leader rebuilds matches and commits a current-term entry; followers learn leader commit index.')\nfact('F-applied','FSM command callback or batch callback has returned for the dispatched entry; where present its future is then completed successfully. Main-loop lastApplied alone is weaker.',{'entry':'Log Index/Term','operation':'Associated future if locally invoked'},'Single FSM worker processing committed batches',['ApplyFuture response','FSM worker lastIndex/lastTerm'],['S-fsm-worker','S-dispatch-apply'],dur='Application persistence depends on FSM/snapshot implementation.')\nfact('F-vote','An actual election response grants a vote for the campaign after successful persisted vote writes, or reuses a matching same-term persisted vote. It is distinct from provisional pre-vote.',{'voter':'Requested server identity','candidate':'Candidate address bytes','term':'Request term'},'Per-campaign response channel with membership selected at launch',['RequestVoteResponse.Granted','keyLastVoteTerm/keyLastVoteCand'],['S-vote-handler','S-vote-producer','S-term-persist'],dur='Vote term and candidate use separate StableStore writes.',unknowns=['Atomicity under partial StableStore write failure remains open'])\nfact('F-authority','Candidate loop counted enough granted responses from its campaign channel and entered Leader; this is local role acquisition, not perpetual authority.',{'server':'localID','campaign':'term and campaign response channel'},'Latest voter majority at campaign start; until role loss or cleanup',['Raft state Leader','leaderAddr/leaderID'],['S-election','S-vote-producer','S-leader-session'],invalidators=['B-leader-session','B-append'])\nfact('F-verify-support','A registered replication worker detached a pending verifyFuture and delivered vote(true) because an append/heartbeat/snapshot path reported success. This records positive worker support; it does not assert that the worker is a voter or that a fresh post-registration RPC ran.',{'verification':'verifyFuture pointer','supporter':'Owning followerReplication peer','session':'Captured replication tenure'},'Registration survives until detached or cleaned; aggregate vote loses peer identity',['followerReplication.notify','verifyFuture.vote(true)'],['S-notify','S-heartbeat','S-reply-match','S-send-snapshot','S-verify-vote'],invalidators=['B-leader-session'],unknowns=['Membership eligibility and response freshness are not encoded in vote(bool)','Competing negative delivery can terminate the future before sufficient positives'])\nroles=json.load(open('../research.json'))['activity_roles']\nactivity_sources={'A1':['S-commitment','S-append','S-replicate'],'A2':['S-election','S-vote-handler','S-leader-session','S-verify-register'],'A3':['S-startup','S-install','S-restore-api'],'A4':['S-membership-contract','S-membership-change','S-repl-membership'],'A5':['S-fsm-worker','S-fsm-contract'],'A6':['S-dispatch-apply','S-term-persist','S-snapshot-produce','S-inmem-store'],'A7':['S-api-apply','S-api-verify','S-restore-api']}\nsummary={'A1':'Per-session voter matches produce monotone commitment after current-term startIndex; followers use accepted leader commit indications.','A2':'Pre-vote and persisted voting establish a local leader role; RPCs, response signals, lease checks, removal and transfer change it. Verification is a separate authority observation path.','A3':'Constructor rebuilds term, history and membership; snapshot install restores FSM before reply; manual restore is explicitly exceptional.','A4':'Latest/committed log configurations select voting and commitment membership while replication includes nonvoters.','A5':'Dedicated FSM worker consumes committed batches and returns application responses; dispatch progress is not completion.','A6':'LogStore and StableStore support retained logs and terms/votes; snapshot worker persists applied state. In-repository InmemStore is test-only; other backend semantics remain open.','A7':'Apply admission is a future, not completion; nonleader, shutdown, enqueue and leadership-loss cases differ. VerifyLeader promises leadership assurance.'}\nM={'version':1,'target_profile':{'system_boundary':'Captured Go raft library: main role loop, per-peer replication and heartbeats, FSM and snapshot workers, injectable transports/stores/FSM. No production deployment or caller application is supplied.','protocol_contexts':['Per-Raft term and role','Per-leader commitment object and worker generation','Latest and committed indexed membership','Per-entry index/term and per-future identity'],'external_interfaces':['Apply/ApplyLog, VerifyLeader, membership APIs, Restore','Transport RPC and optional heartbeat fast path','LogStore, StableStore, SnapshotStore and caller FSM'],'ownership':['Main loop owns leader state and configuration','Independent workers send support through locked commitment and verification objects','Network fast-path may process empty heartbeats concurrently with blocking main RPC'],'selection_injection':['NewRaft takes caller-supplied stores, transport, FSM and validated Config; in-repository implementations are not assumed externalized'],'variants':['Protocol compatibility branches','PreVoteDisabled or unsupported transport','BatchingFSM and ConfigurationStore','Network fast-path vs in-memory transport','MonotonicLogStore and NoSnapshotRestoreOnStart'],'source_ids':['S-startup','S-inmem-transport','S-net-fastpath','S-inmem-store','S-transport-contract'],'unknowns':['Full production persistence, transport failure semantics and application-specific FSM contracts remain outside this initial trace']},'activities':[dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary=summary[a],source_ids=activity_sources[a]) for a in roles],'behaviors':B,'facts':F,'surfaces':[], 'core_overview':{}}\ndef surface(ep,reason,ss,high=True): M['surfaces'].append(dict(entry_point=ep,disposition='deferred',reason=reason,source_ids=ss,high_consequence=high))\nsurface('heartbeat -> LastContact -> checkLeaderLease','Heartbeat refreshes contact even on unsuccessful replies and lacks the ordinary replication response-term check. Need permitted blocked-progress schedule and precise lease contract before drawing a consequence.',['S-heartbeat','S-lease','S-replicate'])\nsurface('persistVote -> same-term duplicate RequestVote','Separate term/candidate writes and duplicate-vote reuse invite partial-write recovery analysis; concrete backend/fault responsibility not established.',['S-term-persist','S-vote-handler','S-store-contract'])\nsurface('NetworkTransport heartbeat callback concurrent with appendEntries/installSnapshot','Actual fast-path ownership differs from main-thread comments. Need same-history ordering, durable update semantics and real transport schedules.',['S-net-fastpath','S-append','S-install','S-startup'])\nsurface('RecoverCluster and persistence backend variants','Manual recovery is separately documented at the API boundary; its full implementation and backend failure variants have not been expanded in this normal-operation map.',['S-bootstrap','S-restore-api'])\nM['core_overview']={\n 'status':'usable','rationale':'Representative normal command formation and authority acquisition/loss have been followed through real producers, consumers, membership, storage, recovery and completion. Usable identifies a sourced investigation basis, not verified correctness or exhaustive coverage.',\n 'formation':{'explanation':'Apply creates a future on applyCh. The leader main loop assigns index/term and stores logs; only successful storage reports local match. Per-peer workers send real AppendEntries with previous-log identity, term and leader commit index. Receiver rejects stale terms or mismatched prefix, truncates conflicts, stores new suffix and updates configuration before successful response. Successful nonempty append or snapshot installation advances that worker\\\\'s captured session commitment. Commitment counts only current voter IDs and requires a majority match reaching the first index of this tenure; leaderLoop consumes commitCh, records commitment and queues committed entries. Followers learn commit index from ordinary replication; empty independent heartbeat carries neither entries nor commit index. processLogs dispatches in order to runFSM; command completion follows Apply/ApplyBatch return, while the main-loop lastApplied value only tracks dispatch. Replication retry and snapshot fallback recover lagging peers.','behavior_ids':['B-submit','B-dispatch','B-append','B-reply-match','B-commit','B-apply','B-recover'],'fact_ids':['F-local-store','F-append-success','F-peer-match','F-commit','F-applied'],'source_ids':['S-api-apply','S-dispatch-apply','S-append','S-replicate','S-commitment','S-leader-loop','S-fsm-worker','S-send-snapshot']},\n 'context':{'explanation':'Startup reads durable term and log, restores snapshot/FSM and membership, replays suffix configurations and starts as Follower. Ordinary contact timeout campaigns only for a local voter. Optional pre-vote does not persist a vote; actual electSelf increments durable term, persists self-vote and sends one request per voter into a campaign-specific channel. RequestVote rejects stale history/term, disallowed membership or another known leader (transfer excepted), and persists vote before grant. Candidate majority enters Leader; newer term responses, received append, lease quorum loss or committed local removal exit it. Leadership transfer first catches the target up, suppresses new leader work, then sends TimeoutNow to trigger election without pre-vote. VerifyLeader separately registers an authority observation with replication workers and returns from aggregate support; that support eligibility is an open local question.','behavior_ids':['B-recover','B-vote','B-election','B-leader-session','B-membership','B-verify-register','B-verify-support','B-verify-consume'],'fact_ids':['F-vote','F-authority','F-verify-support'],'source_ids':['S-startup','S-follower','S-election','S-vote-handler','S-vote-producer','S-prevote-producer','S-leader-session','S-transfer','S-timeout-now','S-lease','S-verify-register','S-verify-vote']},\n 'connection':{'explanation':'Every tenure creates a new commitment object, isolated replication workers and an initial term no-op. Existing durable history survives role loss, but old worker replies retain the old commitment/channel and do not certify a new tenure. Current-term commitment reconciles inherited history before allowing a new membership change. Membership activates latest voter eligibility at configuration append; retained voter matches survive by permanent ServerID, while new voters start at zero. Only one uncommitted configuration is admitted and committed local removal ends leadership. Exit fails pending inflight/verify futures, while already committed work queued to the FSM continues; ErrLeadershipLost is explicitly ambiguous about actual commitment. Recovery restores snapshot index/term/configuration and reconstructs latest configuration from retained logs. Snapshot production pairs applied state with committed configuration; manual Restore is an explicitly exceptional recovery operation that aborts inflight work and forces snapshot propagation followed by no-op commitment. Verification support differs from log support: all replication workers can notify pending verification, although voter filtering protects log commitment and lease quorum. This distinction supplies a focused question rather than a conclusion about safety.','behavior_ids':['B-leader-session','B-commit','B-membership','B-apply','B-recover','B-snapshot','B-user-restore','B-verify-support','B-verify-consume'],'fact_ids':['F-peer-match','F-commit','F-authority','F-verify-support'],'source_ids':['S-leader-session','S-repl-membership','S-commitment','S-config-dispatch','S-api-apply','S-startup','S-snapshot-produce','S-restore-user','S-restore-api','S-verify-register']},\n 'core_gaps':[], 'open_details':['VerifyLeader supporter eligibility, response timing and behavior across configuration activation','Heartbeat response term/contact asymmetry with blocked ordinary progress','Partial StableStore failure and network fast-path concurrency','Production store/snapshot failure variants, transport pipeline internals and manual RecoverCluster','Legacy interoperability and application-specific FSM behavior']}\nquestion={'disposition':'concrete_suspicion','preferred_check':'controlled_schedule','question':'Can VerifyLeader complete successfully using nonvoter worker support after this peer has lost effective leadership to a newer elected voter leader, and do the lease and negative-response paths prevent that outcome in a permitted execution?','importance':'VerifyLeader explicitly supports avoiding stale FSM reads after leadership loss. If nonvoters can supply sufficient verification support while the voter majority elects elsewhere, callers could treat an obsolete authority observation as permission to return stale data. This consequence requires an actual replacement-leader history and endpoint observation; code asymmetry alone does not establish it.','source_ids':['S-api-verify','S-verify-register','S-repl-membership','S-membership-contract','S-notify','S-heartbeat','S-verify-vote','S-leader-loop','S-lease'],'participants':['Old leader','Remaining voter majority','Replicated nonvoter','VerifyLeader caller'],'objects':['verifyFuture','followerReplication.notify','Latest configuration','Actual elected leader context'],'contexts':['Stable protocol-v3 configuration containing voters and a nonvoter','One pending verification in an old leader tenure','Permitted transport partition/delay and real election in the voter component'],'event_paths':['VerifyLeader -> verifyCh -> verifyLeader registration on every worker','Successful nonvoter reply -> notifyAll(true) -> vote(true) -> threshold -> leaderLoop future completion','Voter majority election competes with old leader lease expiry, negative reply and leader-session cleanup'],'activity_classes':['A2'],'behavior_ids':['B-verify-support','B-verify-consume','B-leader-session'],'fact_ids':['F-verify-support'],'supporting_behavior_ids':{'B-verify-register':'Defines captured quorum and all-worker registration before support delivery','B-membership':'Defines actual voter/nonvoter eligibility and creates replication workers for both','B-election':'Must establish newer authority through real vote production and consumption','B-append':'Actual receiver produces successful heartbeat responses with term checks'},'obligation_relation_kind':'consumption','counterevidence':['Lease checks count voters only and can demote isolated leader.','Negative worker observation can fail pending verification and trigger step-down.','Old-session cleanup fails registered futures; stale higher-term ordinary append or snapshot responses signal step-down.','Log commitment independently filters nonvoters, so verification asymmetry does not itself show invalid log commitment.'],'unknowns':['Applicable requirement: public VerifyLeader leadership guarantee is explicit, but voter-only verification must be justified from actual authority intersection rather than invented as an API promise.','Actual producer: source shows nonvoter workers can notify; none has executed in this run.','Initial prefix: need real bootstrap/election and a committed configuration containing a nonvoter.','Same execution/faults: must construct replacement election and old verification in one history, allowing lease/negative workers to run or finitely delaying them with explicit controls.','Observed endpoint: public VerifyLeader completion and newer leader establishment for the same history remain unobserved.'],'priority':3,'trigger_rationale':'Initial two-line trace found an eligibility mismatch at a concrete A2 consumer: B-verify-consume turns scalar positive worker support into public leadership assurance, although B-verify-register enrolls nonvoters and F-verify-support carries no voter eligibility. Next discriminator is a real-worker, stable-membership partition history with observed new election and old VerifyLeader return, not direct assignment of authority state.'}\nsub={'action':'continue','rationale':'Register the sourced overall backbone and select the verification-support consumption question. No obligation, formal execution evidence or violation is claimed.','sources':sources,'map_path':'audit-map.json','question':question,'feedback':{'ref_ids':['S-commitment','S-leader-session','S-verify-register','S-notify','S-api-verify','S-lease'],'answered':'Initial source investigation connects client command formation, qualified log support, authority acquisition/loss, membership, recovery and application. Log commitment and lease count voters; pending leadership verification is registered with every replication worker. This is a distinct authority-support question, with protective lease, negative replies and tenure cleanup retained.','remaining':['Derive the exact applicable verification responsibility and inspect existing target test/transport control interfaces.','Construct one legal same-history prefix and schedule establishing newer elected authority and observing old VerifyLeader completion; do not substitute assigned protocol state.'],'understanding':'updated','rationale':'Compared three directions: verification eligibility has a direct public contract and tractable in-memory real-worker schedule; heartbeat/term asymmetry requires blocked-progress timing and a more precise lease consequence; partial vote persistence needs a concrete permitted storage failure contract. Select verification eligibility first because it can distinguish authority-consumption behavior without claiming broader log safety. The other sourced surfaces remain open.'}}\nfor name,obj in [('audit-map.json',M),('submission.json',sub)]:\n with open(name,'w') as f: json.dump(obj,f,indent=2); f.write('\\\\n')\nPY\npython3 build_submission.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nsrc('S-api-apply','api.go',803,856)\nsrc('S-api-verify','api.go',880,895,'interface_statement')\nsrc('S-membership-contract','configuration.go',7,81,'interface_statement')\nsrc('S-membership-change','configuration.go',174,309)\nsrc('S-bootstrap','api.go',239,284)\nsrc('S-startup','api.go',500,707)\nsrc('S-follower','raft.go',158,259)\nsrc('S-election','raft.go',285,440)\nsrc('S-leader-session','raft.go',455,579)\nsrc('S-repl-membership','raft.go',582,665)\nsrc('S-leader-loop','raft.go',667,963)\nsrc('S-verify-register','raft.go',965,987)\nsrc('S-transfer','raft.go',990,1030)\nsrc('S-lease','raft.go',1033,1093)\nsrc('S-config-dispatch','raft.go',1203,1241)\nsrc('S-dispatch-apply','raft.go',1244,1386)\nsrc('S-append','raft.go',1418,1582)\nsrc('S-config-replay','raft.go',1585,1600)\nsrc('S-vote-handler','raft.go',1603,1733)\nsrc('S-prevote-handler','raft.go',1736,1807)\nsrc('S-vote-producer','raft.go',1976,2044)\nsrc('S-prevote-producer','raft.go',2050,2127)\nsrc('S-term-persist','raft.go',2130,2160)\nsrc('S-timeout-now','raft.go',2208,2227)\nsrc('S-replicate','replication.go',137,296)\nsrc('S-heartbeat','replication.go',388,443)\nsrc('S-pipeline-consume','replication.go',534,584)\nsrc('S-reply-match','replication.go',646,667)\nsrc('S-notify','replication.go',98,135)\nsrc('S-verify-vote','future.go',272,295)\nsrc('S-commitment','commitment.go',10,104)\nsrc('S-fsm-contract','fsm.go',15,65,'interface_statement')\nsrc('S-fsm-worker','fsm.go',83,266)\nsrc('S-install','raft.go',1814,1954)\nsrc('S-send-snapshot','replication.go',299,383)\nsrc('S-snapshot-produce','snapshot.go',125,211)\nsrc('S-restore-user','raft.go',1104,1199)\nsrc('S-restore-api','api.go',1040,1100)\nsrc('S-net-fastpath','net_transport.go',660,742)\nsrc('S-inmem-transport','inmem_transport.go',50,85)\nsrc('S-transport-contract','transport.go',28,77,'interface_statement')\nsrc('S-store-contract','stable.go',6,19,'interface_statement')\nsrc('S-inmem-store','inmem_store.go',11,120)\nB=[]\ndef beh(i,a,owner,ctx,trigger,ss,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trigger,source_ids=ss);d.update(kw);B.append(d)\nbeh('B-submit','A7','API caller and leader/follower main loops','One Apply future; term and index assigned only on dispatch','Apply/ApplyLog queues a command', ['S-api-apply','S-follower','S-leader-loop'],writes=['New logFuture carrying command bytes'],external_effects=['Enqueue timeout and shutdown return errors; nonleaders reject; leader dispatches unless transfer or step-down prohibits it'],async_boundaries=['applyCh and future completion'],unknowns=['Caller byte ownership and batching races are not analyzed'])\nbeh('B-dispatch','A6','Leader main loop','Current leader session and newly assigned contiguous log indexes','Leader accepts command, configuration entry or initial no-op',['S-dispatch-apply','S-leader-session'],writes=['Assign Index/Term, append inflight list, update lastLog after StoreLogs success'],durable_effects=['Calls LogStore.StoreLogs before recording local match'],external_effects=['Notifies replication workers'],important_branches=['StoreLogs error fails submitted futures and switches to Follower'],produces_fact_ids=['F-local-store'],cross_activity_effects={'A1':'Local storage success supplies the local voter match to the session commitment calculator'},existing_protections=['No local match update on storage error'])\nbeh('B-append','A1','Receiving main RPC loop; network heartbeat callback for empty fast-path requests','Request term, previous index/term, receiver log and configuration','AppendEntries delivered',['S-append','S-config-replay','S-net-fastpath','S-startup'],implementation_guards=['Reject lower term','Check previous entry term if previous index is positive','Return unsuccessful on storage/truncation failures'],writes=['Adopt accepted leader/term; truncate conflicts, store suffix and update latest configuration; advance commit index from leader indication bounded by local last index'],durable_effects=['StoreLogs and durable term update precede successful response'],produces_fact_ids=['F-append-success'],important_branches=['Empty heartbeat has no previous-log check or commit update','Conflicting suffix rolls latest configuration back before replay','Higher term or applicable same-term request switches to Follower'],cross_activity_effects={'A2':'Accepted request can change term, role and known leader','A4':'Configuration entries update latest/committed configuration bookkeeping','A5':'Leader commit indication invokes processLogs'},unknowns=['Concurrent fast-path interaction with blocked ordinary RPCs needs separate schedules','Storage failure after truncation leaves an explicitly noted cached-lastLog concern'])\nbeh('B-reply-match','A1','Per-peer replication worker and pipeline decoder','Captured leader-session commitment pointer and currentTerm; peer ServerID','AppendEntries response received or completed pipeline future consumed',['S-replicate','S-pipeline-consume','S-reply-match','S-repl-membership'],consumes_fact_ids=['F-append-success'],produces_fact_ids=['F-peer-match'],implementation_guards=['Response term greater than request signals session step-down','Only successful responses advance match; empty entry list does not advance match'],writes=['nextIndex and commitment.match for last request entry'],important_branches=['Reject retreats nextIndex; missing prior log switches to snapshot; pipeline failure returns to ordinary replication'],existing_protections=['Old worker retains old session commitment and stepDown channel'],unknowns=['Transport pipeline error/completion contracts need deeper review'])\nbeh('B-commit','A1','Locked commitment object and leader main loop','One leader session; startIndex and latest voter set','Local/peer match or membership update recalculates quorum; commitCh consumed',['S-commitment','S-leader-loop','S-leader-session'],consumes_fact_ids=['F-local-store','F-peer-match'],produces_fact_ids=['F-commit'],implementation_guards=['Only IDs in voter matchIndexes accepted','Matches and commit index only increase','Quorum match must reach startIndex'],writes=['Commitment commitIndex then Raft commitIndex; committed configuration advanced when crossed'],external_effects=['Committed inflight logs passed to processLogs; committed local removal steps down or shuts down'],existing_protections=['Fresh object each leadership session; preserved matches only for retained voters during configuration change'])\nbeh('B-apply','A5','Main loop processLogs and single FSM goroutine','Ordered indexes after lastApplied, with optional per-index future','Committed prefix dispatched to FSM',['S-dispatch-apply','S-fsm-worker','S-fsm-contract','S-leader-loop','S-append'],consumes_fact_ids=['F-commit'],produces_fact_ids=['F-applied'],implementation_guards=['Skip indexes already dispatched','Batch response length checked'],writes=['lastApplied records dispatch progress; FSM worker separately tracks its applied index/term'],external_effects=['Commands call FSM.Apply or ApplyBatch before successful future completion; barriers ordered on same worker'],important_branches=['No-op does not call FSM','Configuration delivery depends on protocol and optional ConfigurationStore/BatchingFSM','Follower application derives from received leader commit indication, not local quorum counting'],async_boundaries=['Buffered fsmMutateCh; completion differs from main-loop lastApplied'],unknowns=['Application-specific deterministic FSM semantics are caller owned'])\nbeh('B-vote','A2','RequestVote handler and election RPC workers','Candidate address bytes and requested term; last log/snapshot term and index','Vote request or local election',['S-vote-handler','S-vote-producer','S-term-persist'],produces_fact_ids=['F-vote'],implementation_guards=['Known other leader rejects unless transfer flag','Candidate membership/voter checks when ID present','Reject older candidate history or term','Persisted same-term vote restricts another candidate'],durable_effects=['Current term persisted before in-memory update; vote term and candidate stored with separate calls before granting'],important_branches=['Same-term same-candidate request reuses stored vote','Storage read/write failure denies grant','Empty legacy ID omits candidate membership tests'],unknowns=['Partial failure between separate vote persistence writes not analyzed'])\nbeh('B-election','A2','Main follower/candidate loops','Latest configuration and per-campaign response channel','Contact timeout or TimeoutNow enters Candidate',['S-follower','S-election','S-prevote-handler','S-prevote-producer','S-vote-producer','S-timeout-now'],consumes_fact_ids=['F-vote'],produces_fact_ids=['F-authority'],implementation_guards=['Ordinary timeout campaigns only if local node is voter','One RPC launched per latest voter and isolated response channel per campaign','Grant threshold is latest voter majority'],writes=['Pre-vote may authorize actual election; electSelf durably increments term and self-votes; majority switches to Leader'],important_branches=['Higher-term response returns to Follower','Timeout restarts campaign; old response channel is no longer selected','Pre-vote disabled or transfer bypasses pre-vote; unsupported peer pre-vote counts as provisional grant, not actual vote'])\nbeh('B-leader-session','A2','Leader main loop, lease checker and transfer worker','Single tenure with private commitment, notify and replication state','Enter leader, lease check, higher-term signal, RPC transition or transfer',['S-leader-session','S-lease','S-transfer','S-leader-loop','S-timeout-now','S-repl-membership'],consumes_fact_ids=['F-authority'],implementation_guards=['Lease counts recent contact only from current voters','Transfer blocks new applies/config changes while active and catches target up before TimeoutNow'],writes=['Create fresh commitment with startIndex=lastIndex+1; append term no-op','On exit stop replicators, fail inflight and verification futures and discard session state'],external_effects=['ErrLeadershipLost does not prove command was not committed'],important_branches=['Already committed logs queued to FSM survive role change','Durable log survives exit; later leader must re-establish eligible matches','Lease contact is a time observation, not an entry replication proof'])\nbeh('B-membership','A4','Leader main loop and configuration replay','Latest and committed configurations identified by log index and unique ServerIDs','Configuration API request or configuration log replay',['S-membership-contract','S-membership-change','S-config-dispatch','S-config-replay','S-repl-membership','S-commitment'],implementation_guards=['New leader waits for current-term commitment and latest configuration commitment before next change','prevIndex conditional update; unique IDs/addresses and at least one voter'],writes=['Append config, activate latest voter set for commitment and start/stop replication workers','Preserve match by retained voter ID, initialize new voters to zero'],cross_activity_effects={'A1':'Defines eligible matches and majority denominator','A2':'Defines voters for elections and leases; committed local removal exits authority'},important_branches=['Replication is started for all nonlocal servers including nonvoters','Address change reuses worker for same permanent ID'],unknowns=['Concurrent pending verification across membership activation needs explicit analysis'])\nbeh('B-verify-register','A2','Leader main loop','One verifyFuture in current leadership session; quorumSize captured at registration','Public VerifyLeader reaches verifyCh',['S-api-verify','S-verify-register','S-repl-membership'],writes=['Initialize votes=1; quorumSize from latest voters; register same future on every replication worker'],external_effects=['Immediate success if quorumSize is one; otherwise trigger heartbeat workers'],important_branches=['No suffrage filter in registration loop'],unknowns=['Whether unqualified supporters can cause a public success after authority loss is not yet checked'])\nbeh('B-verify-support','A2','Heartbeat, replication and snapshot-response workers; followerReplication.notifyAll','Future registered on a specific worker in a leader session','Worker calls notifyAll with positive or negative leader observation',['S-notify','S-heartbeat','S-reply-match','S-send-snapshot','S-verify-vote'],produces_fact_ids=['F-verify-support'],writes=['Atomically detach worker notify map and cast each pending vote once for that detachment'],important_branches=['Heartbeat transport success refreshes contact and uses resp.Success without a response-term comparison','Ordinary append/snapshot detects higher response term and casts negative support','Successful append/snapshot can satisfy pending verification without a new heartbeat'],existing_protections=['voteLock and nil notifyCh prevent further aggregate notification after threshold or negative vote'],unknowns=['Response timing relative to registration and membership transitions needs a controlled same-history check'])\nbeh('B-verify-consume','A2','verifyFuture.vote and leader main loop','Captured quorum size; scalar count for registered future','Positive or negative worker notification and later verifyCh consumption',['S-verify-vote','S-leader-loop','S-leader-session','S-api-verify'],consumes_fact_ids=['F-verify-support'],implementation_guards=['Nonleader loops reject public requests','Negative notification with votes below threshold causes step-down and error','Session cleanup fails pending futures'],writes=['Increment scalar votes; enqueue future when threshold reached or any negative; remove registration from all current workers at completion'],external_effects=['Successful public future when count reaches captured threshold'],unknowns=['No voter identity accompanies vote(bool); applicability of voter-only support to the public leadership assurance must be derived independently'])\nbeh('B-recover','A3','Constructor, InstallSnapshot handler and FSM restore worker','Persisted term, snapshot index/term/configuration and retained suffix','NewRaft startup or snapshot RPC',['S-startup','S-install','S-send-snapshot','S-fsm-worker','S-bootstrap'],produces_fact_ids=['F-peer-match'],implementation_guards=['Reject old-term or unsupported snapshot; require complete bytes and successful sink close and FSM restore before success','Startup returns error if no listed snapshot can be restored'],writes=['Restore lastApplied and snapshot metadata and configuration; scan retained configuration entries at startup'],cross_activity_effects={'A1':'Successful snapshot response advances matching support to snapshot index','A2':'Startup begins Follower with durable current term, restored log metadata and configuration','A4':'Snapshot carries committed membership then retained suffix establishes latest'},important_branches=['NoSnapshotRestoreOnStart intentionally skips FSM load','MonotonicLogStore changes retained-log cleanup; deeper backend variants open'])\nbeh('B-snapshot','A6','Snapshot worker and FSM worker','Applied index/term paired with committed configuration','Snapshot request or periodic production',['S-snapshot-produce','S-fsm-worker'],consumes_fact_ids=['F-applied'],durable_effects=['Persist snapshot and close sink before metadata update and compaction'],implementation_guards=['Reject snapshot whose FSM index precedes committed configuration index'],cross_activity_effects={'A3':'Produces state and configuration used by startup and lagging-peer recovery'},unknowns=['File-store persistence failures and compaction backend variants remain unexpanded'])\nbeh('B-user-restore','A3','Leader main loop, FSM worker and public Restore caller','Explicit disaster recovery into fresh cluster; current membership retained','Restore supplied snapshot',['S-restore-user','S-restore-api'],implementation_guards=['Reject unstable membership and invalid version/size; restore failure after persistence panics'],writes=['Abort inflight futures; synthesize index above local/supplied index and current term; install FSM state; public API follows with a committed no-op'],cross_activity_effects={'A1':'Gap forces lagging replication toward snapshot; no-op completion waits for renewed replication','A7':'ErrAbortedByRestore has a distinct client meaning from ambiguous leadership loss'},unknowns=['Disaster recovery variants are outside normal-operation candidate scope'])\nF=[]\ndef fact(i,m,ident,ctx,rep,ss,dur='Volatile observation/state; not a durable certificate.',rec='Re-established by actual producers after restart.',**kw):\n d=dict(id=i,meaning=m,identity=ident,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=ss);d.update(kw);F.append(d)\nfact('F-local-store','LogStore.StoreLogs returned nil for this leader-assigned prefix; local match was submitted. This does not itself establish a quorum.',{'log':'Index and Term','owner':'local ServerID / session'},'Leader dispatch, before later truncation or restore',['Stored Log','commitment.match(localID,index)'],['S-dispatch-apply'],dur='Durability relies on supplied LogStore implementation.')\nfact('F-append-success','Receiver accepted this AppendEntries request after applicable term, prefix and storage checks. Empty fast-path success does not certify any positive log index.',{'rpc':'Concrete request/response association','context':'Request Term and previous-log fields'},'Receiver state when processing request; later transitions may supersede it',['AppendEntriesResponse.Success'],['S-append','S-net-fastpath'])\nfact('F-peer-match','A worker has reported successful append through its request last index, or successful installation through a snapshot index, into its captured commitment object. Eligibility is separately filtered there.',{'peer':'ServerID','session':'Captured commitment object','prefix':'matchIndex'},'Specific leader session; inferred agreement assumes legal producer history and storage contract',['commitment.matchIndexes'],['S-reply-match','S-send-snapshot','S-commitment'],unknowns=['Transport substitution and snapshot-history validity must be justified for any executed check'])\nfact('F-commit','Session commitment calculator found a majority of tracked voters at or beyond this index and reached startIndex; leader main loop copied the resulting index.',{'session':'commitment object','prefix':'commitIndex'},'Current tracked voter set; monotone commit index within session',['commitment.commitIndex','Raft commitIndex'],['S-commitment','S-leader-loop'],dur='Volatile decision tracking; logs/snapshots persist supporting history.',rec='A new leader rebuilds matches and commits a current-term entry; followers learn leader commit index.')\nfact('F-applied','FSM command callback or batch callback has returned for the dispatched entry; where present its future is then completed successfully. Main-loop lastApplied alone is weaker.',{'entry':'Log Index/Term','operation':'Associated future if locally invoked'},'Single FSM worker processing committed batches',['ApplyFuture response','FSM worker lastIndex/lastTerm'],['S-fsm-worker','S-dispatch-apply'],dur='Application persistence depends on FSM/snapshot implementation.')\nfact('F-vote','An actual election response grants a vote for the campaign after successful persisted vote writes, or reuses a matching same-term persisted vote. It is distinct from provisional pre-vote.',{'voter':'Requested server identity','candidate':'Candidate address bytes','term':'Request term'},'Per-campaign response channel with membership selected at launch',['RequestVoteResponse.Granted','keyLastVoteTerm/keyLastVoteCand'],['S-vote-handler','S-vote-producer','S-term-persist'],dur='Vote term and candidate use separate StableStore writes.',unknowns=['Atomicity under partial StableStore write failure remains open'])\nfact('F-authority','Candidate loop counted enough granted responses from its campaign channel and entered Leader; this is local role acquisition, not perpetual authority.',{'server':'localID','campaign':'term and campaign response channel'},'Latest voter majority at campaign start; until role loss or cleanup',['Raft state Leader','leaderAddr/leaderID'],['S-election','S-vote-producer','S-leader-session'],invalidators=['B-leader-session','B-append'])\nfact('F-verify-support','A registered replication worker detached a pending verifyFuture and delivered vote(true) because an append/heartbeat/snapshot path reported success. This records positive worker support; it does not assert that the worker is a voter or that a fresh post-registration RPC ran.',{'verification':'verifyFuture pointer','supporter':'Owning followerReplication peer','session':'Captured replication tenure'},'Registration survives until detached or cleaned; aggregate vote loses peer identity',['followerReplication.notify','verifyFuture.vote(true)'],['S-notify','S-heartbeat','S-reply-match','S-send-snapshot','S-verify-vote'],invalidators=['B-leader-session'],unknowns=['Membership eligibility and response freshness are not encoded in vote(bool)','Competing negative delivery can terminate the future before sufficient positives'])\nroles=json.load(open('../research.json'))['activity_roles']\nactivity_sources={'A1':['S-commitment','S-append','S-replicate'],'A2':['S-election','S-vote-handler','S-leader-session','S-verify-register'],'A3':['S-startup','S-install','S-restore-api'],'A4':['S-membership-contract','S-membership-change','S-repl-membership'],'A5':['S-fsm-worker','S-fsm-contract'],'A6':['S-dispatch-apply','S-term-persist','S-snapshot-produce','S-inmem-store'],'A7':['S-api-apply','S-api-verify','S-restore-api']}\nsummary={'A1':'Per-session voter matches produce monotone commitment after current-term startIndex; followers use accepted leader commit indications.','A2':'Pre-vote and persisted voting establish a local leader role; RPCs, response signals, lease checks, removal and transfer change it. Verification is a separate authority observation path.','A3':'Constructor rebuilds term, history and membership; snapshot install restores FSM before reply; manual restore is explicitly exceptional.','A4':'Latest/committed log configurations select voting and commitment membership while replication includes nonvoters.','A5':'Dedicated FSM worker consumes committed batches and returns application responses; dispatch progress is not completion.','A6':'LogStore and StableStore support retained logs and terms/votes; snapshot worker persists applied state. In-repository InmemStore is test-only; other backend semantics remain open.','A7':'Apply admission is a future, not completion; nonleader, shutdown, enqueue and leadership-loss cases differ. VerifyLeader promises leadership assurance.'}\nM={'version':1,'target_profile':{'system_boundary':'Captured Go raft library: main role loop, per-peer replication and heartbeats, FSM and snapshot workers, injectable transports/stores/FSM. No production deployment or caller application is supplied.','protocol_contexts':['Per-Raft term and role','Per-leader commitment object and worker generation','Latest and committed indexed membership','Per-entry index/term and per-future identity'],'external_interfaces':['Apply/ApplyLog, VerifyLeader, membership APIs, Restore','Transport RPC and optional heartbeat fast path','LogStore, StableStore, SnapshotStore and caller FSM'],'ownership':['Main loop owns leader state and configuration','Independent workers send support through locked commitment and verification objects','Network fast-path may process empty heartbeats concurrently with blocking main RPC'],'selection_injection':['NewRaft takes caller-supplied stores, transport, FSM and validated Config; in-repository implementations are not assumed externalized'],'variants':['Protocol compatibility branches','PreVoteDisabled or unsupported transport','BatchingFSM and ConfigurationStore','Network fast-path vs in-memory transport','MonotonicLogStore and NoSnapshotRestoreOnStart'],'source_ids':['S-startup','S-inmem-transport','S-net-fastpath','S-inmem-store','S-transport-contract'],'unknowns':['Full production persistence, transport failure semantics and application-specific FSM contracts remain outside this initial trace']},'activities':[dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary=summary[a],source_ids=activity_sources[a]) for a in roles],'behaviors':B,'facts':F,'surfaces':[], 'core_overview':{}}\ndef surface(ep,reason,ss,high=True): M['surfaces'].append(dict(entry_point=ep,disposition='deferred',reason=reason,source_ids=ss,high_consequence=high))\nsurface('heartbeat -> LastContact -> checkLeaderLease','Heartbeat refreshes contact even on unsuccessful replies and lacks the ordinary replication response-term check. Need permitted blocked-progress schedule and precise lease contract before drawing a consequence.',['S-heartbeat','S-lease','S-replicate'])\nsurface('persistVote -> same-term duplicate RequestVote','Separate term/candidate writes and duplicate-vote reuse invite partial-write recovery analysis; concrete backend/fault responsibility not established.',['S-term-persist','S-vote-handler','S-store-contract'])\nsurface('NetworkTransport heartbeat callback concurrent with appendEntries/installSnapshot','Actual fast-path ownership differs from main-thread comments. Need same-history ordering, durable update semantics and real transport schedules.',['S-net-fastpath','S-append','S-install','S-startup'])\nsurface('RecoverCluster and persistence backend variants','Manual recovery is separately documented at the API boundary; its full implementation and backend failure variants have not been expanded in this normal-operation map.',['S-bootstrap','S-restore-api'])\nM['core_overview']={\n 'status':'usable','rationale':'Representative normal command formation and authority acquisition/loss have been followed through real producers, consumers, membership, storage, recovery and completion. Usable identifies a sourced investigation basis, not verified correctness or exhaustive coverage.',\n 'formation':{'explanation':'Apply creates a future on applyCh. The leader main loop assigns index/term and stores logs; only successful storage reports local match. Per-peer workers send real AppendEntries with previous-log identity, term and leader commit index. Receiver rejects stale terms or mismatched prefix, truncates conflicts, stores new suffix and updates configuration before successful response. Successful nonempty append or snapshot installation advances that worker\\\\'s captured session commitment. Commitment counts only current voter IDs and requires a majority match reaching the first index of this tenure; leaderLoop consumes commitCh, records commitment and queues committed entries. Followers learn commit index from ordinary replication; empty independent heartbeat carries neither entries nor commit index. processLogs dispatches in order to runFSM; command completion follows Apply/ApplyBatch return, while the main-loop lastApplied value only tracks dispatch. Replication retry and snapshot fallback recover lagging peers.','behavior_ids':['B-submit','B-dispatch','B-append','B-reply-match','B-commit','B-apply','B-recover'],'fact_ids':['F-local-store','F-append-success','F-peer-match','F-commit','F-applied'],'source_ids':['S-api-apply','S-dispatch-apply','S-append','S-replicate','S-commitment','S-leader-loop','S-fsm-worker','S-send-snapshot']},\n 'context':{'explanation':'Startup reads durable term and log, restores snapshot/FSM and membership, replays suffix configurations and starts as Follower. Ordinary contact timeout campaigns only for a local voter. Optional pre-vote does not persist a vote; actual electSelf increments durable term, persists self-vote and sends one request per voter into a campaign-specific channel. RequestVote rejects stale history/term, disallowed membership or another known leader (transfer excepted), and persists vote before grant. Candidate majority enters Leader; newer term responses, received append, lease quorum loss or committed local removal exit it. Leadership transfer first catches the target up, suppresses new leader work, then sends TimeoutNow to trigger election without pre-vote. VerifyLeader separately registers an authority observation with replication workers and returns from aggregate support; that support eligibility is an open local question.','behavior_ids':['B-recover','B-vote','B-election','B-leader-session','B-membership','B-verify-register','B-verify-support','B-verify-consume'],'fact_ids':['F-vote','F-authority','F-verify-support'],'source_ids':['S-startup','S-follower','S-election','S-vote-handler','S-vote-producer','S-prevote-producer','S-leader-session','S-transfer','S-timeout-now','S-lease','S-verify-register','S-verify-vote']},\n 'connection':{'explanation':'Every tenure creates a new commitment object, isolated replication workers and an initial term no-op. Existing durable history survives role loss, but old worker replies retain the old commitment/channel and do not certify a new tenure. Current-term commitment reconciles inherited history before allowing a new membership change. Membership activates latest voter eligibility at configuration append; retained voter matches survive by permanent ServerID, while new voters start at zero. Only one uncommitted configuration is admitted and committed local removal ends leadership. Exit fails pending inflight/verify futures, while already committed work queued to the FSM continues; ErrLeadershipLost is explicitly ambiguous about actual commitment. Recovery restores snapshot index/term/configuration and reconstructs latest configuration from retained logs. Snapshot production pairs applied state with committed configuration; manual Restore is an explicitly exceptional recovery operation that aborts inflight work and forces snapshot propagation followed by no-op commitment. Verification support differs from log support: all replication workers can notify pending verification, although voter filtering protects log commitment and lease quorum. This distinction supplies a focused question rather than a conclusion about safety.','behavior_ids':['B-leader-session','B-commit','B-membership','B-apply','B-recover','B-snapshot','B-user-restore','B-verify-support','B-verify-consume'],'fact_ids':['F-peer-match','F-commit','F-authority','F-verify-support'],'source_ids':['S-leader-session','S-repl-membership','S-commitment','S-config-dispatch','S-api-apply','S-startup','S-snapshot-produce','S-restore-user','S-restore-api','S-verify-register']},\n 'core_gaps':[], 'open_details':['VerifyLeader supporter eligibility, response timing and behavior across configuration activation','Heartbeat response term/contact asymmetry with blocked ordinary progress','Partial StableStore failure and network fast-path concurrency','Production store/snapshot failure variants, transport pipeline internals and manual RecoverCluster','Legacy interoperability and application-specific FSM behavior']}\nquestion={'disposition':'concrete_suspicion','preferred_check':'controlled_schedule','question':'Can VerifyLeader complete successfully using nonvoter worker support after this peer has lost effective leadership to a newer elected voter leader, and do the lease and negative-response paths prevent that outcome in a permitted execution?','importance':'VerifyLeader explicitly supports avoiding stale FSM reads after leadership loss. If nonvoters can supply sufficient verification support while the voter majority elects elsewhere, callers could treat an obsolete authority observation as permission to return stale data. This consequence requires an actual replacement-leader history and endpoint observation; code asymmetry alone does not establish it.','source_ids':['S-api-verify','S-verify-register','S-repl-membership','S-membership-contract','S-notify','S-heartbeat','S-verify-vote','S-leader-loop','S-lease'],'participants':['Old leader','Remaining voter majority','Replicated nonvoter','VerifyLeader caller'],'objects':['verifyFuture','followerReplication.notify','Latest configuration','Actual elected leader context'],'contexts':['Stable protocol-v3 configuration containing voters and a nonvoter','One pending verification in an old leader tenure','Permitted transport partition/delay and real election in the voter component'],'event_paths':['VerifyLeader -> verifyCh -> verifyLeader registration on every worker','Successful nonvoter reply -> notifyAll(true) -> vote(true) -> threshold -> leaderLoop future completion','Voter majority election competes with old leader lease expiry, negative reply and leader-session cleanup'],'activity_classes':['A2'],'behavior_ids':['B-verify-support','B-verify-consume','B-leader-session'],'fact_ids':['F-verify-support'],'supporting_behavior_ids':{'B-verify-register':'Defines captured quorum and all-worker registration before support delivery','B-membership':'Defines actual voter/nonvoter eligibility and creates replication workers for both','B-election':'Must establish newer authority through real vote production and consumption','B-append':'Actual receiver produces successful heartbeat responses with term checks'},'obligation_relation_kind':'consumption','counterevidence':['Lease checks count voters only and can demote isolated leader.','Negative worker observation can fail pending verification and trigger step-down.','Old-session cleanup fails registered futures; stale higher-term ordinary append or snapshot responses signal step-down.','Log commitment independently filters nonvoters, so verification asymmetry does not itself show invalid log commitment.'],'unknowns':['Applicable requirement: public VerifyLeader leadership guarantee is explicit, but voter-only verification must be justified from actual authority intersection rather than invented as an API promise.','Actual producer: source shows nonvoter workers can notify; none has executed in this run.','Initial prefix: need real bootstrap/election and a committed configuration containing a nonvoter.','Same execution/faults: must construct replacement election and old verification in one history, allowing lease/negative workers to run or finitely delaying them with explicit controls.','Observed endpoint: public VerifyLeader completion and newer leader establishment for the same history remain unobserved.'],'priority':3,'trigger_rationale':'Initial two-line trace found an eligibility mismatch at a concrete A2 consumer: B-verify-consume turns scalar positive worker support into public leadership assurance, although B-verify-register enrolls nonvoters and F-verify-support carries no voter eligibility. Next discriminator is a real-worker, stable-membership partition history with observed new election and old VerifyLeader return, not direct assignment of authority state.'}\nsub={'action':'continue','rationale':'Register the sourced overall backbone and select the verification-support consumption question. No obligation, formal execution evidence or violation is claimed.','sources':sources,'map_path':'audit-map.json','question':question,'feedback':{'ref_ids':['S-commitment','S-leader-session','S-verify-register','S-notify','S-api-verify','S-lease'],'answered':'Initial source investigation connects client command formation, qualified log support, authority acquisition/loss, membership, recovery and application. Log commitment and lease count voters; pending leadership verification is registered with every replication worker. This is a distinct authority-support question, with protective lease, negative replies and tenure cleanup retained.','remaining':['Derive the exact applicable verification responsibility and inspect existing target test/transport control interfaces.','Construct one legal same-history prefix and schedule establishing newer elected authority and observing old VerifyLeader completion; do not substitute assigned protocol state.'],'understanding':'updated','rationale':'Compared three directions: verification eligibility has a direct public contract and tractable in-memory real-worker schedule; heartbeat/term asymmetry requires blocked-progress timing and a more precise lease consequence; partial vote persistence needs a concrete permitted storage failure contract. Select verification eligibility first because it can distinguish authority-consumption behavior without claiming broader log safety. The other sourced surfaces remain open.'}}\nfor name,obj in [('audit-map.json',M),('submission.json',sub)]:\n with open(name,'w') as f: json.dump(obj,f,indent=2); f.write('\\\\n')\nPY\npython3 build_submission.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
