"rationale\"\n      ],\n      \"title\": \"CoreOverview\",\n      \"type\": \"object\"\n    },\n    \"CorePath\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"explanation\": {\n          \"default\": \"\",\n          \"title\": \"Explanation\",\n          \"type\": \"string\"\n        },\n        \"behavior_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Behavior Ids\",\n          \"type\": \"array\"\n        },\n        \"fact_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Fact Ids\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        }\n      },\n      \"title\": \"CorePath\",\n      \"type\": \"object\"\n    },\n    \"Fact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"meaning\": {\n          \"title\": \"Meaning\",\n          \"type\": \"string\"\n        },\n        \"identity\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Identity\",\n          \"type\": \"object\"\n        },\n        \"established_by\": {\n          \"description\": \"Derived from Behavior.produces_fact_ids; never infer an unread producer\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Established By\",\n          \"type\": \"array\",\n          \"x-controller-derived\": true\n        },\n        \"consumed_by\": {\n          \"description\": \"Derived from Behavior.consumes_fact_ids\",\n          \"items\": {\n            \"type\": \"string\"\n          }