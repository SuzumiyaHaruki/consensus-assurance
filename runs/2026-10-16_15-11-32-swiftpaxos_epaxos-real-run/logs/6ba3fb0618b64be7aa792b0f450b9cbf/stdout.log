, map[string]any{\"replica\": 0, \"error\": err.Error()})\n\t\t} else {\n\t\t\temit(\"completion_reply\", map[string]any{\n\t\t\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 1,\n\t\t\t\t\"command_id\": int(reply.CommandId), \"ok\": int(reply.OK)})\n\t\t}\n\t}\n\towner.state(\"final_reproposal\", 0, 1)\n}\n'\"'''\nassert s.count(old)>=1\ns=s.replace(old,new,1)\nopen(p,'w').write(s)\nprint('patched')\nPY\ncp draft/epaxos/assurance_generated_test.go draft/scratch/epaxos/ && cd draft/scratch && timeout 200 go test -run 'TestAssuranceEPaxosRecoveryReproposesClientRequest' -count=1 -v ./epaxos 2>&1 | grep -o 'CA_EVENT .*' | python3 -c \\\"\nimport sys,json\nfor i,l in enumerate(sys.stdin):\n    d=json.loads(l[len('CA_EVENT '):])\n    print(i, json.dumps({k:v for k,v in d.items() if k in ('event','replica','phase','status','cmd_op','command_id','requeued','executed','reply_bytes','ok','instance_index')}))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
