unc() {\n    42\t\t\t\toldFun()\n    43\t\t\t\tf()\n    44\t\t\t}\n    45\t\t\tcf.wanna = true\n    46\t\n    47\t\t\treturn false\n    48\t\t}\n    49\t}\n    50\t\n    51\tfunc (cf *CondF) Recall() bool {\n    52\t\tif cf.wanna && cf.cond() {\n    53\t\t\tcf.wanna = false\n    54\t\t\tcf.fun()\n    55\t\t\tcf.fun = func() {}\n    56\t\n    57\t\t\treturn true\n    58\t\t}\n    59\t\n    60\t\treturn false\n","exit_code":0,"status":"completed"}}
