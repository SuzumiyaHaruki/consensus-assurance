rom = b.ClosestId\n   171\t\t\t}\n   172\t\t\tb.WaitReplies(waitFrom)\n   173\t\t\tb.Loop()\n   174\t\t}\n   175\t}\n     1\tpackage main\n     2\t\n     3\timport (\n     4\t\t\"fmt\"\n     5\t\t\"log\"\n     6\t\t\"net\"\n     7\t\t\"net/http\"\n     8\t\t\"net/rpc\"\n     9\t\t\"strings\"\n    10\t\t\"time\"\n    11\t\n    12\t\t\"github.com/imdea-software/swiftpaxos/config\"\n    13\t\t\"github.com/imdea-software/swiftpaxos/curp\"\n    14\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    15\t\t\"github.com/imdea-software/swiftpaxos/epaxos\"\n    16\t\t\"github.com/imdea-software/swiftpaxos/fastpaxos\"\n    17\t\t\"github.com/imdea-software/swiftpaxos/n2paxos\"\n    18\t\t\"github.com/imdea-software/swiftpaxos/paxos\"\n    19\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    20\t\t\"github.com/imdea-software/swiftpaxos/swift\"\n    21\t)\n    22\t\n    23\tfunc runReplica(c *config.Config, logger *dlog.Logger) {\n    24\t\tport := c.Port\n    25\t\n    26\t\tlog.Printf(\"Server starting on port %d\", port)\n    27\t\tmaddr := fmt.Sprintf(\"%s:%d\", c.MasterAddr, c.MasterPort)\n    28\t\taddr := c.ReplicaAddrs[c.Alias]\n    29\t\treplicaId, nodeList, isLeader := registerWithMaster(addr, maddr, port)\n    30\t\tf := (len(c.ReplicaAddrs) - 1) / 2\n    31\t\tlog.Printf(\"Tolerating %d max. failures\", f)\n    32\t\n    33\t\tswitch strings.ToLower(c.Protocol) {\n    34\t\tcase \"swiftpaxos\":\n    35\t\t\tlog.Println(\"Starting SwiftPaxos replica...\")\n    36\t\t\tswift.MaxDescRoutines = 100\n    37\t\t\trep := swift.New(c.Alias, replicaId, nodeList, !c.Noop,\n    38\t\t\t\tc.Optread, true, false, 1, f, c, logger, nil)\n    39\t\t\trpc.Register(rep)\n    40\t\tcase \"curp\":\n    41\t\t\tlog.Println(\"Starting optimized CURP replica...\")\n    42\t\t\tcurp.MaxDescRoutines = 100\n    43\t\t\trep := curp.New(c.Alias, replicaId, nodeList, !c.Noop,\n    44\t\t\t\t1, f, true, c, logger)\n    45\t\t\trpc.Register(rep)\n    46\t\tcase \"fastpaxos\":\n    47\t\t\tlog.Println(\"Starting Fast Paxos replica...\")\n    48\t\t\trep := fastpaxos.New(c.Alias, replicaId, nodeList, !c.Noop, f, c, logger)\n    49\t\t\trpc.Register(rep)\n    50\t\tcase \"n2paxos\":\n    51\t\t\tlog.Println(\"Starting N²Paxos replica...\")\n    52\t\t\trep := n2paxos.New(c.Alias, replicaId, nodeList, !c.Noop, 1, f, c, logger)\n    53\t\t\trpc.Register(rep)\n    54\t\tcase \"paxos\":\n    55\t\t\tlog.Println(\"Starting Paxos replica...\")\n    56\t\t\trep := paxos.New(c.Alias, replicaId, nodeList, isLeader, f, c, logger)\n    57\t\t\trpc.Register(rep)\n    58\t\tcase \"epaxos\":\n    59\t\t\tlog.Println(\"Starting EPaxos replica...\")\n    60\t\t\trep := epaxos.New(c.Alias, replicaId, nodeList, !c.Noop, false, false, 0, false, f, c, logger)\n    61\t\t\trpc.Register(rep)\n    62\t\t}\n    63\t\n    64\t\trpc.HandleHTTP()\n    65\t\tl, err := net.Listen(\"tcp\", fmt.Sprintf(\":%d\", port+1000))\n    66\t\tif err != nil {\n    67\t\t\tlog.Fatal(\"listen error:\", err)\n    68\t\t}\n    69\t\thttp.Serve(l, nil)\n    70\t}\n    71\t\n    72\tfunc registerWithMaster(addr, mAddr string, port int) (int, []string, bool) {\n    73\t\tvar reply defs.RegisterReply\n    74\t\targs := &defs.RegisterArgs{\n    75\t\t\tAddr: addr,\n    76\t\t\tPort: port,\n    77\t\t}\n    78\t\tlog.Printf(\"connecting to: %v\", mAddr)\n    79\t\n    80\t\tfor {\n    81\t\t\tmcli, err := rpc.DialHTTP(\"tcp\", mAddr)\n    82\t\t\tif err == nil {\n    83\t\t\t\tfor {\n    84\t\t\t\t\t// TODO: This is an active wait...\n    85\t\t\t\t\terr = mcli.Call(\"Master.Register\", args, &reply)\n    86\t\t\t\t\tif err == nil {\n    87\t\t\t\t\t\tif reply.Ready {\n    88\t\t\t\t\t\t\tbreak\n    89\t\t\t\t\t\t}\n    90\t\t\t\t\t\ttime.Sleep(4)\n    91\t\t\t\t\t} else {\n    92\t\t\t\t\t\tlog.Printf(\"%v\", err)\n    93\t\t\t\t\t}\n    94\t\t\t\t}\n    95\t\t\t\tbreak\n    96\t\t\t} else {\n    97\t\t\t\tlog.Printf(\"%v\", err)\n    98\t\t\t}\n    99\t\t\ttime.Sleep(4)\n   100\t\t}\n   101\t\n   102\t\treturn reply.ReplicaId, reply.NodeList, reply.IsLeader\n   103\t}\n     1\tpackage state\n     2\t\n     3\timport (\n     4\t\t\"encoding/binary\"\n     5\t\t\"encoding/hex\"\n     6\t\t\"fmt\"\n     7\t\t\"io\"\n     8\t\t\"strconv\"\n     9\t\t\"sync\"\n    10\t\n    11\t\t\"github.com/emirpasic/gods/maps/treemap\"\n    12\t)\n    13\t\n    14\ttype Operation uint8\n    15\t\n    16\tconst (\n    17\t\tNONE Operation = iota\n    18\t\tPUT\n    19\t\tGET\n    20\t\tSCAN\n    21\t)\n    22\t\n    23\ttype Value []byte\n    24\t\n    25\tfunc NIL() Value { return Value([]byte{}) }\n    26\t\n    27\ttype Key int64\n    28\t\n    29\ttype Command struct {\n    30\t\tOp Operation\n    31\t\tK  Key\n    32\t\tV  Value\n    33\t}\n    34\t\n    35\ttype Id int64\n    36\ttype Phase int8\n    37\t\n    38\tfunc NOOP() []Command { return []Command{{NONE, 0, NIL()}} }\n    39\t\n    40\ttype State struct {\n    41\t\tmutex *sync.Mutex\n    42\t\tStore *treemap.Map\n    43\t}\n    44\t\n    45\tfunc KeyComparator(a, b interface{}) int {\n    46\t\taAsserted := a.(Key)\n    47\t\tbAsserted := b.(Key)\n    48\t\tswitch {\n    49\t\tcase aAsserted > bAsserted:\n    50\t\t\treturn 1\n    51\t\tcase aAsserted < bAsserted:\n    52\t\t\treturn -1\n    53\t\tdefault:\n    54\t\t\treturn 0\n    55\t\t}\n    56\t}\n    57\t\n    58\tfunc concat(slices []Value) Value {\n    59\t\tvar totalLen int\n    60\t\tfor _, s := range slices {\n    61\t\t\ttotalLen += len(s)\n    62\t\t}\n    63\t\ttmp := make([]byte, totalLen)\n    64\t\tvar i int\n    65\t\tfor _, s := range slices {\n    66\t\t\ti += copy(tmp[i:], s)\n    67\t\t}\n    68\t\treturn tmp\n    69\t}\n    70\t\n    71\tfunc InitState() *State {\n    72\t\treturn &State{new(sync.Mutex), treemap.NewWith(KeyComparator)}\n    73\t}\n    74\t\n    75\tfunc Conflict(gamma *Command, delta *Command) bool {\n    76\t\tkey := gamma.K\n    77\t\tlb := delta.K\n    78\t\tub := delta.K\n    79\t\n    80\t\tif gamma.Op == SCAN && delt