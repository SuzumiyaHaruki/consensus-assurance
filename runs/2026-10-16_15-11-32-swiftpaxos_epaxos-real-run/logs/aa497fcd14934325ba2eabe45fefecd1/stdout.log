{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_15-11-32-swiftpaxos_epaxos-real-run/agent-source && cat -n epaxos/exec.go && cat -n replica/quorum.go'","aggregated_output":"     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t\t\"sort\"\n     5\t\n     6\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n     7\t\t\"github.com/imdea-software/swiftpaxos/state\"\n     8\t)\n     9\t\n    10\tconst (\n    11\t\tWHITE int8 = iota\n    12\t\tGRAY\n    13\t\tBLACK\n    14\t)\n    15\t\n    16\ttype Exec struct {\n    17\t\tr *Replica\n    18\t}\n    19\t\n    20\ttype SCComponent struct {\n    21\t\tnodes []*Instance\n    22\t\tcolor int8\n    23\t}\n    24\t\n    25\tfunc (e *Exec) executeCommand(replica int32, instance int32) bool {\n    26\t\tif e.r.InstanceSpace[replica][instance] == nil {\n    27\t\t\treturn false\n    28\t\t}\n    29\t\tinst := e.r.InstanceSpace[replica][instance]\n    30\t\tif inst.Status == EXECUTED {\n    31\t\t\treturn true\n    32\t\t}\n    33\t\tif inst.Status != COMMITTED {\n    34\t\t\treturn false\n    35\t\t}\n    36\t\n    37\t\tif !e.findSCC(inst) {\n    38\t\t\treturn false\n    39\t\t}\n    40\t\n    41\t\treturn true\n    42\t}\n    43\t\n    44\tvar stack []*Instance = make([]*Instance, 0, 100)\n    45\t\n    46\tfunc (e *Exec) findSCC(root *Instance) bool {\n    47\t\tindex := 1\n    48\t\t// find SCCs using Tarjan's algorithm\n    49\t\tstack = stack[0:0]\n    50\t\tret := e.strongconnect(root, &index)\n    51\t\t// reset all indexes in the stack\n    52\t\tfor j := 0; j < len(stack); j++ {\n    53\t\t\tstack[j].Index = 0\n    54\t\t}\n    55\t\treturn ret\n    56\t}\n    57\t\n    58\tfunc (e *Exec) strongconnect(v *Instance, index *int) bool {\n    59\t\tv.Index = *index\n    60\t\tv.Lowlink = *index\n    61\t\t*index = *index + 1\n    62\t\n    63\t\tl := len(stack)\n    64\t\tif l == cap(stack) {\n    65\t\t\tnewSlice := make([]*Instance, l, 2*l)\n    66\t\t\tcopy(newSlice, stack)\n    67\t\t\tstack = newSlice\n    68\t\t}\n    69\t\tstack = stack[0 : l+1]\n    70\t\tstack[l] = v\n    71\t\n    72\t\tif v.Cmds == nil {\n    73\t\t\treturn false\n    74\t\t}\n    75\t\n    76\t\tfor q := int32(0); q < int32(e.r.N); q++ {\n    77\t\t\tinst := v.Deps[q]\n    78\t\t\tfor i := e.r.ExecedUpTo[q] + 1; i <= inst; i++ {\n    79\t\t\t\tif e.r.InstanceSpace[q][i] == nil || e.r.InstanceSpace[q][i].Cmds == nil {\n    80\t\t\t\t\treturn false\n    81\t\t\t\t}\n    82\t\n    83\t\t\t\tif e.r.transconf {\n    84\t\t\t\t\tfor _, alpha := range v.Cmds {\n    85\t\t\t\t\t\tfor _, beta := range e.r.InstanceSpace[q][i].Cmds {\n    86\t\t\t\t\t\t\tif !state.Conflict(&alpha, &beta) {\n    87\t\t\t\t\t\t\t\tcontinue\n    88\t\t\t\t\t\t\t}\n    89\t\t\t\t\t\t}\n    90\t\t\t\t\t}\n    91\t\t\t\t}\n    92\t\n    93\t\t\t\tif e.r.InstanceSpace[q][i].Status == EXECUTED {\n    94\t\t\t\t\tcontinue\n    95\t\t\t\t}\n    96\t\n    97\t\t\t\tfor e.r.InstanceSpace[q][i].Status != COMMITTED {\n    98\t\t\t\t\treturn false\n    99\t\t\t\t}\n   100\t\n   101\t\t\t\tw := e.r.InstanceSpace[q][i]\n   102\t\n   103\t\t\t\tif w.Index == 0 {\n   104\t\t\t\t\tif !e.strongconnect(w, index) {\n   105\t\t\t\t\t\treturn false\n   106\t\t\t\t\t}\n   107\t\t\t\t\tif w.Lowlink < v.Lowlink {\n   108\t\t\t\t\t\tv.Lowlink = w.Lowlink\n   109\t\t\t\t\t}\n   110\t\t\t\t} else if e.inStack(w) {\n   111\t\t\t\t\tif w.Index < v.Lowlink {\n   112\t\t\t\t\t\tv.Lowlink = w.Index\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t}\n   116\t\t}\n   117\t\n   118\t\tif v.Lowlink == v.Index {\n   119\t\t\t//found SCC\n   120\t\t\tlist := stack[l:]\n   121\t\n   122\t\t\t//execute commands in the increasing order of the Seq field\n   123\t\t\tsort.Sort(nodeArray(list))\n   124\t\t\tfor _, w := range list {\n   125\t\t\t\tfor idx := 0; idx < len(w.Cmds); idx++ {\n   126\t\t\t\t\tshouldRespond := e.r.Dreply && w.lb != nil && w.lb.clientProposals != nil\n   127\t\t\t\t\tif w.Cmds[idx].Op == state.NONE {\n   128\t\t\t\t\t\t// nothing to do\n   129\t\t\t\t\t} else if shouldRespond {\n   130\t\t\t\t\t\tval := w.Cmds[idx].Execute(e.r.State)\n   131\t\t\t\t\t\te.r.ReplyProposeTS(\n   132\t\t\t\t\t\t\t&defs.ProposeReplyTS{\n   133\t\t\t\t\t\t\t\tTRUE,\n   134\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].CommandId,\n   135\t\t\t\t\t\t\t\tval,\n   136\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].Timestamp},\n   137\t\t\t\t\t\t\tw.lb.clientProposals[idx].Reply,\n   138\t\t\t\t\t\t\tw.lb.clientProposals[idx].Mutex)\n   139\t\t\t\t\t} else if w.Cmds[idx].Op == state.PUT {\n   140\t\t\t\t\t\tw.Cmds[idx].Execute(e.r.State)\n   141\t\t\t\t\t}\n   142\t\t\t\t}\n   143\t\t\t\tw.Status = EXECUTED\n   144\t\t\t}\n   145\t\t\tstack = stack[0:l]\n   146\t\t}\n   147\t\n   148\t\treturn true\n   149\t}\n   150\t\n   151\tfunc (e *Exec) inStack(w *Instance) bool {\n   152\t\tfor _, u := range stack {\n   153\t\t\tif w == u {\n   154\t\t\t\treturn true\n   155\t\t\t}\n   156\t\t}\n   157\t\treturn false\n   158\t}\n   159\t\n   160\ttype nodeArray []*Instance\n   161\t\n   162\tfunc (na nodeArray) Len() int {\n   163\t\treturn len(na)\n   164\t}\n   165\t\n   166\tfunc (na nodeArray) Less(i, j int) bool {\n   167\t\treturn na[i].Seq < na[j].Seq || (na[i].Seq == na[j].Seq && na[i].id.replica < na[j].id.replica) || (na[i].Seq == na[j].Seq && na[i].id.replica == na[j].id.replica && na[i].proposeTime < na[j].proposeTime)\n   168\t}\n   169\t\n   170\tfunc (na nodeArray) Swap(i, j int) {\n   171\t\tna[i], na[j] = na[j], na[i]\n   172\t}\n     1\tpackage replica\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"errors\"\n     6\t\t\"os\"\n     7\t\t\"sort\"\n     8\t\t\"strings\"\n     9\t)\n    10\t\n    11\ttype QuorumI interface {\n    12\t\tSize() int\n    13\t\tContains(int32) bool\n    14\t}\n    15\t\n    16\ttype Majority int\n    17\t\n    18\tfunc NewMajorityOf(N int) Majority {\n    19\t\treturn Majority(N/2 + 1)\n    20\t}\n    21\t\n    22\tfunc (m Majority) Size() int {\n    23\t\treturn int(m)\n    24\t}\n    25\t\n    26\tfunc (m Majority) Contains(int32) bool {\n    27\t\treturn true\n    28\t}\n    29\t\n    30\ttype ThreeQuarters int\n    31\t\n    32\tfunc NewThreeQuartersOf(N int) ThreeQuarters {\n    33\t\treturn ThreeQuarters((3*N)/4 + 1)\n    34\t}\n    35\t\n    36\tfunc (m ThreeQuarters) Size() int {\n    37\t\treturn int(m)\n    38\t}\n    39\t\n    40\tfunc (m ThreeQuarters) Contains(int32) bool {\n    41\t\treturn true\n    42\t}\n    43\t\n    44\ttype Quorum map[int32]struct{}\n    45\t\n    46\ttype QuorumsOfLeader map[int32]Quorum\n    47\t\n    48\ttype QuorumSet map[int32]QuorumsOfLeader\n    49\t\n    50\tvar (\n    51\t\tNO_QUORUM_FILE = errors.New(\"Quorum file is not provided\")\n    52\t\tTHREE_QUARTERS = errors.New(\"ThreeQuarters\")\n    53\t)\n    54\t\n    55\tfunc NewQuorum(size int) Quorum {\n    56\t\treturn make(map[int32]struct{}, size)\n    57\t}\n    58\t\n    59\tfunc NewQuorumOfAll(size int) Quorum {\n    60\t\tq := NewQuorum(size)\n    61\t\n    62\t\tfor i := int32(0); i < int32(size); i++ {\n    63\t\t\tq[i] = struct{}{}\n    64\t\t}\n    65\t\n    66\t\treturn q\n    67\t}\n    68\t\n    69\tfunc (q Quorum) Size() int {\n    70\t\treturn len(q)\n    71\t}\n    72\t\n    73\tfunc (q Quorum) Contains(repId int32) bool {\n    74\t\t_, exists := q[repId]\n    75\t\treturn exists\n    76\t}\n    77\t\n    78\tfunc (q Quorum) copy() Quorum {\n    79\t\tnq := NewQuorum(len(q))\n    80\t\n    81\t\tfor cmdId := range q {\n    82\t\t\tnq[cmdId] = struct{}{}\n    83\t\t}\n    84\t\n    85\t\treturn nq\n    86\t}\n    87\t\n    88\tfunc (q1 Quorum) Equals(q2 Quorum) bool {\n    89\t\tif len(q1) != len(q2) {\n    90\t\t\treturn false\n    91\t\t}\n    92\t\tfor r := range q1 {\n    93\t\t\tif !q2.Contains(r) {\n    94\t\t\t\treturn false\n    95\t\t\t}\n    96\t\t}\n    97\t\treturn true\n    98\t}\n    99\t\n   100\ttype QuorumSystem struct {\n   101\t\tqs      QuorumSet\n   102\t\tballots []int32\n   103\t}\n   104\t\n   105\tfunc NewQuorumSystem(quorumSize int, r *Replica, qfile string) (*QuorumSystem, error) {\n   106\t\tAQs, leaders, err := NewQuorumsFromFile(qfile, r)\n   107\t\tif err == NO_QUORUM_FILE {\n   108\t\t\treturn &QuorumSystem{\n   109\t\t\t\tqs:      NewQuorumSet(quorumSize, r.N),\n   110\t\t\t\tballots: nil,\n   111\t\t\t}, nil\n   112\t\t} else if err != nil && err != THREE_QUARTERS {\n   113\t\t\treturn nil, err\n   114\t\t}\n   115\t\n   116\t\tsys := &QuorumSystem{\n   117\t\t\tballots: nil,\n   118\t\t}\n   119\t\tids := make(map[int32]int)\n   120\t\tqs := newQuorumSetAdvance(quorumSize, r.N, func(l, qid int32, q Quorum) {\n   121\t\t\tfor i, leader := range leaders {\n   122\t\t\t\tif leader != l || !q.Equals(AQs[i]) {\n   123\t\t\t\t\tcontinue\n   124\t\t\t\t}\n   125\t\t\t\tballot := qid*int32(r.N) + l\n   126\t\t\t\tids[ballot] = i\n   127\t\t\t\tsys.ballots = append(sys.ballots, ballot)\n   128\t\t\t}\n   129\t\t})\n   130\t\tsort.Slice(sys.ballots, func(i, j int) bool {\n   131\t\t\treturn ids[sys.ballots[i]] < ids[sys.ballots[j]]\n   132\t\t})\n   133\t\n   134\t\tsys.qs = qs\n   135\t\treturn sys, err\n   136\t}\n   137\t\n   138\tfunc (sys *QuorumSystem) SameHigher(sameAs, higherThan int32) int32 {\n   139\t\tl := Leader(sameAs, len(sys.qs))\n   140\t\tk := higherThan / int32(len(sys.qs[l]))\n   141\t\treturn sameAs + k*int32(len(sys.qs[l]))*int32(len(sys.qs))\n   142\t}\n   143\t\n   144\tfunc (sys *QuorumSystem) BallotAt(i int) int32 {\n   145\t\tif len(sys.ballots) > i {\n   146\t\t\treturn sys.ballots[i]\n   147\t\t}\n   148\t\treturn -1\n   149\t}\n   150\t\n   151\tfunc (sys *QuorumSystem) BallotOf(leader int32, q Quorum) int32 {\n   152\t\treturn sys.qs.BallotOf(leader, q)\n   153\t}\n   154\t\n   155\tfunc (sys QuorumSystem) AQ(ballot int32) Quorum {\n   156\t\treturn sys.qs.AQ(ballot)\n   157\t}\n   158\t\n   159\tfunc NewQuorumsFromFile(qfile string, r *Replica) ([]Quorum, []int32, error) {\n   160\t\tif qfile == \"\" {\n   161\t\t\treturn nil, nil, NO_QUORUM_FILE\n   162\t\t}\n   163\t\n   164\t\tf, err := os.Open(qfile)\n   165\t\tif err != nil {\n   166\t\t\treturn nil, nil, err\n   167\t\t}\n   168\t\tdefer f.Close()\n   169\t\n   170\t\ti := 0\n   171\t\tleaders := []int32{0}\n   172\t\tAQs := []Quorum{NewQuorum(r.N/2 + 1)}\n   173\t\ts := bufio.NewScanner(f)\n   174\t\tfor s.Scan() {\n   175\t\t\tid := int32(-1)\n   176\t\t\tisLeader := false\n   177\t\t\taddr := \"\"\n   178\t\n   179\t\t\tdata := strings.Split(s.Text(), \" \")\n   180\t\t\tif len(data) == 1 {\n   181\t\t\t\tif data[0] == \"---\" {\n   182\t\t\t\t\ti++\n   183\t\t\t\t\tleaders = append(leaders, 0)\n   184\t\t\t\t\tAQs = append(AQs, NewQuorum(r.N/2+1))\n   185\t\t\t\t\tcontinue\n   186\t\t\t\t} else if data[0] == \"3/4\" {\n   187\t\t\t\t\terr = THREE_QUARTERS\n   188\t\t\t\t\tcontinue\n   189\t\t\t\t}\n   190\t\t\t\taddr = data[0]\n   191\t\t\t} else {\n   192\t\t\t\tisLeader = true\n   193\t\t\t\taddr = data[1]\n   194\t\t\t}\n   195\t\n   196\t\t\taddr = r.Config.ReplicaAddrs[addr]\n   197\t\n   198\t\t\tfor rid := int32(0); rid < int32(r.N); rid++ {\n   199\t\t\t\tpaddr := strings.Split(r.PeerAddrList[rid], \":\")[0]\n   200\t\t\t\tif addr == paddr {\n   201\t\t\t\t\tid = rid\n   202\t\t\t\t\tbreak\n   203\t\t\t\t}\n   204\t\t\t}\n   205\t\n   206\t\t\tif id != -1 {\n   207\t\t\t\tAQs[i][id] = struct{}{}\n   208\t\t\t\tif isLeader {\n   209\t\t\t\t\tleaders[i] = id\n   210\t\t\t\t}\n   211\t\t\t}\n   212\t\t}\n   213\t\n   214\t\tif serr := s.Err(); serr != nil {\n   215\t\t\terr = serr\n   216\t\t}\n   217\t\treturn AQs, leaders, err\n   218\t}\n   219\t\n   220\tfunc NewQuorumsOfLeader() QuorumsOfLeader {\n   221\t\treturn make(map[int32]Quorum)\n   222\t}\n   223\t\n   224\tfunc NewQuorumSet(quorumSize, repNum int) QuorumSet {\n   225\t\treturn newQuorumSetAdvance(quorumSize, repNum, func(int32, int32, Quorum) {})\n   226\t}\n   227\t\n   228\tfunc newQuorumSetAdvance(quorumSize, repNum int, treat func(int32, int32, Quorum)) QuorumSet {\n   229\t\tids := make([]int32, repNum)\n   230\t\tq := NewQuorum(quorumSize)\n   231\t\tqs := make(map[int32]QuorumsOfLeader, repNum)\n   232\t\n   233\t\tfor id := range ids {\n   234\t\t\tids[id] = int32(id)\n   235\t\t\tqs[int32(id)] = NewQuorumsOfLeader()\n   236\t\t}\n   237\t\n   238\t\tsubsets(ids, repNum, quorumSize, 0, q, qs, treat)\n   239\t\n   240\t\treturn qs\n   241\t}\n   242\t\n   243\tfunc (qs QuorumSet) AQ(ballot int32) Quorum {\n   244\t\tl := Leader(ballot, len(qs))\n   245\t\tlqs := qs[l]\n   246\t\tqid := (ballot / int32(len(qs))) % int32(len(lqs))\n   247\t\treturn lqs[qid]\n   248\t}\n   249\t\n   250\tfunc (qs QuorumSet) BallotOf(leader int32, q Quorum) int32 {\n   251\t\tfor qid, qj := range qs[leader] {\n   252\t\t\tif qj.Equals(q) {\n   253\t\t\t\treturn qid*int32(len(qs)) + leader\n   254\t\t\t}\n   255\t\t}\n   256\t\treturn -1\n   257\t}\n   258\t\n   259\tfunc subsets(ids []int32, repNum, quorumSize, i int, q Quorum,\n   260\t\tqs QuorumSet, treat func(int32, int32, Quorum)) {\n   261\t\n   262\t\tif quorumSize == 0 {\n   263\t\t\tfor repId := int32(0); repId < int32(repNum); repId++ {\n   264\t\t\t\tlength := int32(len(qs[repId]))\n   265\t\t\t\t_, exists := q[repId]\n   266\t\t\t\tif exists {\n   267\t\t\t\t\tqs[repId][length] = q.copy()\n   268\t\t\t\t\ttreat(repId, length, q)\n   269\t\t\t\t}\n   270\t\t\t}\n   271\t\t}\n   272\t\n   273\t\tfor j := i; j < repNum; j++ {\n   274\t\t\tq[ids[j]] = struct{}{}\n   275\t\t\tsubsets(ids, repNum, quorumSize-1, j+1, q, qs, treat)\n   276\t\t\tdelete(q, ids[j])\n   277\t\t}\n   278\t}\n","exit_code":0,"status":"completed"}}
