Exit(1)\n    44\t\t}\n    45\t\n    46\t\tif *protocol != \"\" {\n    47\t\t\tc.Protocol = *protocol\n    48\t\t}\n    49\t\tdefs.LatencyConf = *latency\n    50\t\n    51\t\tswitch *machineType {\n    52\t\tcase \"replica\":\n    53\t\t\tfallthrough\n    54\t\tcase \"server\":\n    55\t\t\tc.MachineType = config.ReplicaMachine\n    56\t\tcase \"client\":\n    57\t\t\tc.MachineType = config.ClientMachine\n    58\t\tcase \"master\":\n    59\t\t\tc.MachineType = config.MasterMachine\n    60\t\tdefault:\n    61\t\t\tfmt.Println(\"Unknown participant type\")\n    62\t\t\tflag.Usage()\n    63\t\t\tos.Exit(1)\n    64\t\t}\n    65\t\n    66\t\tc.Quorum = *quorum\n    67\t\n    68\t\trun(c)\n    69\t}\n    70\t\n    71\tfunc run(c *config.Config) {\n    72\t\tswitch c.MachineType {\n    73\t\tcase config.MasterMachine:\n    74\t\t\trunMaster(c)\n    75\t\tcase config.ClientMachine:\n    76\t\t\trunClient(c, true)\n    77\t\tcase config.ReplicaMachine:\n    78\t\t\trunReplica(c, dlog.New(*logFile, true))\n    79\t\t}\n    80\t}\n    81\t\n    82\tfunc runMaster(c *config.Config) {\n    83\t\tm := master.New(len(c.ReplicaAddrs), c.MasterPort, c, dlog.New(*logFile, true))\n    84\t\tm.Run()\n    85\t}\n    86\t\n    87\tfunc runClient(c *config.Config, verbose bool) {\n    88\t\tvar wg sync.WaitGroup\n    89\t\tfor i := 0; i < c.Clones+1; i++ {\n    90\t\t\twg.Add(1)\n    91\t\t\tgo func(i int) {\n    92\t\t\t\trunSingleClient(c, i, verbose)\n    93\t\t\t\twg.Done()\n    94\t\t\t}(i)\n    95\t\t}\n    96\t\twg.Wait()\n    97\t}\n    98\t\n    99\tfunc runSingleClient(c *config.Config, i int, verbose bool) {\n   100\t\tvar l *dlog.Logger\n   101\t\tif i == 0 {\n   102\t\t\tl = dlog.New(*logFile, verbose)\n   103\t\t} else {\n   104\t\t\tf := *logFile\n   105\t\t\tif f == \"\" {\n   106\t\t\t\tf = \"client_\"\n   107\t\t\t}\n   108\t\t\tl = dlog.New(f+strconv.Itoa(i), verbose)\n   109\t\t\t// TODO: remove if already exists\n   110\t\t}\n   111\t\n   112\t\tswitch strings.ToLower(