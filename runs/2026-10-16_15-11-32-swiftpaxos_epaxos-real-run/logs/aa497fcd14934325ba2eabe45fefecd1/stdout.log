    58\t\tmaster.initCond = sync.NewCond(master.lock)\n    59\t\treturn master\n    60\t}\n    61\t\n    62\tfunc (master *Master) Run() {\n    63\t\tmaster.Printf(\"master starting on port %d\", master.port)\n    64\t\tmaster.Printf(\"waiting for %d replicas\", master.N)\n    65\t\n    66\t\trpc.Register(master)\n    67\t\trpc.HandleHTTP()\n    68\t\tl, err := net.Listen(\"tcp\", fmt.Sprintf(\":%d\", master.port))\n    69\t\tif err != nil {\n    70\t\t\tmaster.Fatal(\"master listen error:\", err)\n    71\t\t}\n    72\t\tgo master.run()\n    73\t\thttp.Serve(l, nil)\n    74\t}\n    75\t\n    76\tfunc (master *Master) run() {\n    77\t\tfor {\n    78\t\t\tmaster.lock.Lock()\n    79\t\t\tif len(master.nodeList) == master.N {\n    80\t\t\t\tmaster.lock.Unlock()\n    81\t\t\t\tbreak\n    82\t\t\t}\n    83\t\t\tmaster.lock.Unlock()\n    84\t\t\ttime.Sleep(time.Second)\n    85\t\t}\n    86\t\ttime.Sleep(2 * time.Second)\n    87\t\n    88\t\tfor i := 0; i < master.N; {\n    89\t\t\tvar err error\n    90\t\t\taddr := fmt.Sprintf(\"%s:%d\", master.addrList[i], master.portList[i]+1000)\n    91\t\t\tmaster.nodes[i], err = rpc.DialHTTP(\"tcp\", addr)\n    92\t\t\tif err != nil {\n    93\t\t\t\tmaster.Printf(\"error connecting to replica %d (%v), retrying...\", i, addr)\n    94\t\t\t\ttime.Sleep(time.Second)\n    95\t\t\t} else {\n    96\t\t\t\tbtlReply := defs.NewBeTheLeaderReply()\n    97\t\t\t\tif master.leader[i] {\n    98\t\t\t\t\terr = master.nodes[i].Call(\"Replica.BeTheLeader\", &defs.BeTheLeaderArgs{}, btlReply)\n    99\t\t\t\t\tif err != nil {\n   100\t\t\t\t\t\tmaster.Fatal(\"Not today Zurg!\")\n   101\t\t\t\t\t}\n   102\t\t\t\t\tdefs.UpdateBeTheLeaderReply(btlReply)\n   103\t\t\t\t\tleaderI := i\n   104\t\t\t\t\tif btlReply.Leader != -1 {\n   105\t\t\t\t\t\tleaderI = int(btlReply.Leader)\n   106\t\t\t\t\t\tmaster.leader[i] = false\n   107\t\t\t\t\t\tmaster.leader[leaderI] = true\n   108\t\t\t\t\t}\n   109\t\t\t\t\tmaster.nextLeader = int(btlReply.NextLeader)\n   110\