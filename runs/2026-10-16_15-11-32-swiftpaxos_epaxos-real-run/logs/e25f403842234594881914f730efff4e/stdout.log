g[id]) > 0 {\n\t\t\tdelivered = append(delivered, int(id))\n\t\t}\n\t}\n\temit(label+\"_delivery_order\", map[string]any{\n\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0, \"order\": delivered})\n\tinst := owner.r.InstanceSpace[0][0]\n\tif inst.lb != nil {\n\t\temit(label+\"_lb_state\", map[string]any{\n\t\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0,\n\t\t\t\"lb_status\": int(inst.lb.status), \"lb_nacks\": inst.lb.nacks,\n\t\t\t\"lb_preparing\": inst.lb.preparing, \"lb_last_tried_ballot\": int(inst.lb.lastTriedBallot),\n\t\t\t\"lb_ballot\": int(inst.lb.ballot), \"lb_appended\": len(inst.lb.prepareReplies),\n\t\t\t\"lb_cmds_len\": len(inst.lb.cmds), \"inst_status\": int(inst.Status), \"inst_cmds_len\": len(inst.Cmds),\n\t\t\t\"inst_bal\": int(inst.bal), \"inst_vbal\": int(inst.vbal)})\n\t}\n\tpropOp := -1\n\tfor _, m := range owner.drain() {\n\t\tif pa, ok := m.obj.(*PreAccept); ok {\n\t\t\tif op, ok := cmdOp(pa.Command).(int); ok {\n\t\t\t\tpropOp = op\n\t\t\t}\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\treplyOrder := \"\"\n\tfor id, rp := range replies {\n\t\treplyOrder += fmt.Sprintf(\"%d:vbal=%d,status=%d,cmd=%v; \", id, rp.VBallot, rp.Status, rp.Command != nil && len(rp.Command) > 0)\n\t}\n\temit(label+\"_tiebreak\", map[string]any{\n\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0,\n\t\t\"reply_summary\": replyOrder, \"proposed_cmd_op\": propOp,\n\t\t\"owner_cmd_op_before\": 1,\n\t\t\"owner_instance_status_after\": int(owner.r.InstanceSpace[0][0].Status),\n\t\t\"owner_cmds_len\": len(owner.r.InstanceSpace[0][0].Cmds),\n\t\t\"owner_cmd_op_after\": cmdOp(owner.r.InstanceSpace[0][0].Cmds)})\n}\n\n// TestAssuranceEPaxosRecoverySameBallotOrder runs the same message set twice with\n// different delivery order among the same-ballot prepare replies.\nfunc TestAssuranceEPaxosRecoverySameBallotOrder(t *testing.T) {\n\trunSameBallotTieBreak([]int32{2, 4, 3}, \"orderA\")\n\trunSameBallotTieBreak([]int32{3, 4, 2}, \"orderB\")\n\trunSame