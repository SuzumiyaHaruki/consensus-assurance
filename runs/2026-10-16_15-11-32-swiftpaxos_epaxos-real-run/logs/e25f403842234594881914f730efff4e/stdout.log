{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_15-11-32-swiftpaxos_epaxos-real-run && python3 - <<'PY'\np='draft/epaxos/assurance_generated_test.go'\ns=open(p).read()\nadd = '''\n// runMixedQuorumTieBreak drives the owner's own recovery when two of the four\n// prepare replies carry the owner's command and two carry none, delivering them\n// in the given order. The stated mechanism predicts that the command survives\n// exactly when the second reply delivered carries it.\nfunc runMixedQuorumTieBreak(order []int32, label string) {\n\tconst n = 5\n\tp := newProbe(n)\n\n\tb := p.node(1)\n\tb.r.startPhase1([]state.Command{put(1, \\\"y\\\")}, 2, 0, 2, nil)\n\tb.drain()\n\n\towner := p.node(0)\n\towner.r.startPhase1([]state.Command{put(1, \\\"x\\\")}, 0, 0, 0, nil)\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*PreAccept); ok {\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\tfor _, m := range p.node(1).drain() {\n\t\tp.deliver(m)\n\t}\n\tfor _, m := range p.node(2).drain() {\n\t\tp.deliver(m)\n\t}\n\towner.state(label+\\\"_owner_after_preaccept_replies\\\", 0, 0)\n\n\tacceptRecipients := []int{}\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*Accept); ok {\n\t\t\tacceptRecipients = append(acceptRecipients, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temit(label+\\\"_accept_sent\\\", map[string]any{\\\"from\\\": 0, \\\"instance_row\\\": 0, \\\"instance_index\\\": 0, \\\"to\\\": acceptRecipients, \\\"ballot\\\": 0})\n\tfor _, id := range acceptRecipients {\n\t\tp.node(int32(id)).state(label+\\\"_after_accept\\\", 0, 0)\n\t\tp.node(int32(id)).drain()\n\t}\n\n\towner.r.startRecoveryForInstance(0, 0)\n\trecipients := []int{}\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*Prepare); ok {\n\t\t\trecipients = append(recipients, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\tpending := map[int32][]wireMsg{}\n\tfor _, id := range recipients {\n\t\tfor _, out := range p.node(int32(id)).drain() {\n\t\t\tpending[int32(id)] = append(pending[int32(id)], out)\n\t\t}\n\t}\n\tdelivered := []int{}\n\tcarried := []int{}\n\tfor _, id := range order {\n\t\tfor _, out := range pending[id] {\n\t\t\tif rp, ok := out.obj.(*PrepareReply); ok {\n\t\t\t\tif rp.Command \"'!= nil && len(rp.Command) > 0 {\n\t\t\t\t\tcarried = append(carried, int(id))\n\t\t\t\t}\n\t\t\t}\n\t\t\tp.deliver(out)\n\t\t}\n\t\tif len(pending[id]) > 0 {\n\t\t\tdelivered = append(delivered, int(id))\n\t\t}\n\t}\n\tinst := owner.r.InstanceSpace[0][0]\n\tpropOp := -1\n\tfor _, m := range owner.drain() {\n\t\tif pa, ok := m.obj.(*PreAccept); ok {\n\t\t\tif len(pa.Command) > 0 {\n\t\t\t\tpropOp = int(pa.Command[0].Op)\n\t\t\t} else {\n\t\t\t\tpropOp = 0\n\t\t\t}\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temit(label+\"_mixed\", map[string]any{\n\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0,\n\t\t\"order\": delivered, \"command_carrying_replies\": carried,\n\t\t\"second_reply_carries_command\": len(carried) > 0 && len(delivered) > 1 && carried[0] != delivered[1],\n\t\t\"owner_cmd_op_before\": 1, \"proposed_cmd_op\": propOp,\n\t\t\"owner_cmds_len\": len(inst.Cmds), \"owner_instance_status_after\": int(inst.Status)})\n}\n\n// TestAssuranceEPaxosRecoveryMixedQuorumOrder replays a reply set with two\n// command-carrying and two empty replies in two orders.\nfunc TestAssuranceEPaxosRecoveryMixedQuorumOrder(t *testing.T) {\n\trunMixedQuorumTieBreak([]int32{1, 2, 3, 4}, \"mixedA\")\n\trunMixedQuorumTieBreak([]int32{3, 4, 1, 2}, \"mixedB\")\n}\n'\"'''\ns = s.rstrip() + \\\"\\\\n\\\" + add\nopen(p,'w').write(s)\nprint('appended')\nPY\ncp draft/epaxos/assurance_generated_test.go draft/scratch/epaxos/ && cd draft/scratch && timeout 120 go test -run 'TestAssuranceEPaxosRecoveryMixedQuorumOrder' -count=1 -v ./epaxos 2>&1 | grep -E 'CA_EVENT|FAIL|ok ' | python3 -c \\\"\nimport sys,json\nfor l in sys.stdin:\n    t=l.strip()\n    if t.startswith('CA_EVENT'):\n        d=json.loads(t[len('CA_EVENT '):])\n        if 'mixed' in d['event'] or 'accept_sent' in d['event']: print(json.dumps(d))\n    else: print(t)\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
