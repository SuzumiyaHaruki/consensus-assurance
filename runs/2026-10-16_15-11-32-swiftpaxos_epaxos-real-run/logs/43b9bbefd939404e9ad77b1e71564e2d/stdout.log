{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_15-11-32-swiftpaxos_epaxos-real-run && python3 - <<'PY'\np='draft/epaxos/assurance_generated_test.go'\ns=open(p).read()\nadd = '''\n// TestAssuranceEPaxosRecoveryBallotNonOwnerBoundary measures the boundary of the\n// recovery-authority gate for non-owner recoverers: the same instance is first\n// recovered by a replica whose fixed ballot is below the ballot the peers have\n// stored, and then by a replica whose fixed ballot is above it.\nfunc TestAssuranceEPaxosRecoveryBallotNonOwnerBoundary(t *testing.T) {\n\tconst n = 5\n\tp := newProbe(n)\n\n\tb := p.node(1)\n\tb.r.startPhase1([]state.Command{put(1, \\\"y\\\")}, 2, 0, 2, nil)\n\tb.drain()\n\n\towner := p.node(0)\n\towner.r.startPhase1([]state.Command{put(1, \\\"x\\\")}, 0, 0, 0, nil)\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*PreAccept); ok {\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temitReply := func(peer int32) {\n\t\tfor _, m := range p.node(peer).drain() {\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temitReply(1)\n\tp.crash(1)\n\temitReply(2)\n\towner.state(\\\"after_preaccept_replies\\\", 0, 0)\n\n\tacceptRecipients := []int{}\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*Accept); ok {\n\t\t\tacceptRecipients = append(acceptRecipients, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temit(\\\"owner_accept_sent\\\", map[string]any{\\\"from\\\": 0, \\\"instance_row\\\": 0, \\\"instance_index\\\": 0, \\\"to\\\": acceptRecipients, \\\"ballot\\\": 0})\n\tfor _, id := range acceptRecipients {\n\t\tp.node(int32(id)).state(\\\"after_owner_accept\\\", 0, 0)\n\t\tp.node(int32(id)).drain()\n\t}\n\n\t// Replica 2's recovery raises the ballot its peers store to 7, then fails.\n\thigh := p.node(2)\n\thigh.r.startRecoveryForInstance(0, 0)\n\thighTo := []int{}\n\tfor _, m := range high.drain() {\n\t\tif _, ok := m.obj.(*Prepare); ok {\n\t\t\thighTo = append(highTo, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temit(\\\"high_ballot_recovery\\\", map[string]any{\\\"replica\\\": 2, \\\"instance_row\\\": 0, \\\"instance_index\\\": 0, \\\"tried_ballot\\\": 7, \\\"to\\\": highTo})\n\tfor _, id := range highTo {\n\t\tp.node(int32(id)).state(\\\"after_high_ballot_prepare\\\", 0, 0)\n\t\tp.node(int32(id)).drain()\n\t}\n\tp.crash(2)\n\n\tattempt := func(recoverer int32, round int) {\n\t\tnode := p.node(recoverer)\n\t\tstoredBal := int32(-2)\n\t\tfor q := 0; q < n; q++ {\n\t\t\tif int32(q) == recoverer || p.node(int32(q)).dead {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tst := p.node(int32(q)).r.InstanceSpace[0][0]\n\t\t\tif st \"'!= nil && st.bal > storedBal {\n\t\t\t\tstoredBal = st.bal\n\t\t\t}\n\t\t}\n\t\temit(\"round_start\", map[string]any{\n\t\t\t\"replica\": int(recoverer), \"instance_row\": 0, \"instance_index\": 0, \"round\": round,\n\t\t\t\"is_leader\": node.r.IsLeader, \"stored_bal_before_attempt\": int(storedBal)})\n\t\tnode.r.startRecoveryForInstance(0, 0)\n\t\ttried := -1\n\t\trecipients := []int{}\n\t\tfor _, m := range node.drain() {\n\t\t\tif pr, ok := m.obj.(*Prepare); ok {\n\t\t\t\ttried = int(pr.Ballot)\n\t\t\t\trecipients = append(recipients, int(m.to))\n\t\t\t\tp.deliver(m)\n\t\t\t}\n\t\t}\n\t\tpeerBals := []int{}\n\t\tfor _, id := range recipients {\n\t\t\tpeer := p.node(int32(id))\n\t\t\tfor _, out := range peer.drain() {\n\t\t\t\tif rp, ok := out.obj.(*PrepareReply); ok {\n\t\t\t\t\tpeerBals = append(peerBals, int(rp.Ballot))\n\t\t\t\t\temit(\"prepare_reply\", map[string]any{\n\t\t\t\t\t\t\"from\": int(out.from), \"replica\": int(out.from), \"instance_row\": int(rp.Replica),\n\t\t\t\t\t\t\"instance_index\": int(rp.Instance), \"ballot\": int(rp.Ballot), \"status\": int(rp.Status),\n\t\t\t\t\t\t\"has_command\": rp.Command != nil && len(rp.Command) > 0, \"round\": round})\n\t\t\t\t\tp.deliver(out)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfollowUp := []string{}\n\t\tfor _, m := range node.drain() {\n\t\t\tswitch m.obj.(type) {\n\t\t\tcase *PreAccept:\n\t\t\t\tfollowUp = append(followUp, \"preaccept\")\n\t\t\tcase *Accept:\n\t\t\t\tfollowUp = append(followUp, \"accept\")\n\t\t\tcase *Commit:\n\t\t\t\tfollowUp = append(followUp, \"commit\")\n\t\t\t}\n\t\t\tp.deliver(m)\n\t\t}\n\t\tappended := 0\n\t\tif inst := node.r.InstanceSpace[0][0]; inst != nil && inst.lb != nil {\n\t\t\tappended = len(inst.lb.prepareReplies)\n\t\t}\n\t\temit(\"recovery_attempt\", map[string]any{\n\t\t\t\"replica\": int(recoverer), \"instance_row\": 0, \"instance_index\": 0, \"round\": round,\n\t\t\t\"tried_ballot\": tried, \"stored_bal_before_attempt\": int(storedBal),\n\t\t\t\"prepare_ballot_above_stored_bal\": tried > int(storedBal),\n\t\t\t\"peer_reply_ballots\":              peerBals,\n\t\t\t\"appended_replies\":                appended, \"slow_quorum\": node.r.Replica.SlowQuorumSize(),\n\t\t\t\"subcase_dispatched\":              appended >= node.r.Replica.SlowQuorumSize(),\n\t\t\t\"follow_up\":                       followUp,\n\t\t\t\"instance_status\":                 int(node.r.InstanceSpace[0][0].Status)})\n\t\tp.pump(15)\n\t\tnode.state(\"after_attempt\", 0, 0)\n\t}\n\n\t// Replica 1'\"'s fixed ballot is 6, below the stored 7.\n\tattempt(1, 1)\n\t// Replica 3's fixed ballot is 8, above the stored 7.\n\tattempt(3, 2)\n\n\tp.pump(15)\n\tfor _, id := range []int32{1, 3, 4, 0} {\n\t\tp.node(id).state(\\\"final\\\", 0, 0)\n\t}\n}\n'''\ns = s.rstrip() + \\\"\\\\n\\\" + add\nopen(p,'w').write(s)\nprint('appended')\nPY\ncp draft/epaxos/assurance_generated_test.go draft/scratch/epaxos/ && cd draft/scratch && timeout 200 go test -run 'TestAssuranceEPaxosRecoveryBallotNonOwnerBoundary' -count=1 -v ./epaxos 2>&1 | grep -o 'CA_EVENT .*' | python3 -c \\\"\nimport sys,json\nfor i,l in enumerate(sys.stdin):\n    d=json.loads(l[len('CA_EVENT '):])\n    if d['event'] in ('recovery_attempt','round_start','instance_state'):\n        print(i, json.dumps({k:v for k,v in d.items() if k in ('event','replica','phase','status','round','tried_ballot','stored_bal_before_attempt','prepare_ballot_above_stored_bal','subcase_dispatched','follow_up','appended_replies','cmd_op')}))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
