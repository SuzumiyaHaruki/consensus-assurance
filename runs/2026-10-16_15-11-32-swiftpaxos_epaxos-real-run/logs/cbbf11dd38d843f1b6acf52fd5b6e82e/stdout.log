}\n15 {\"ballot\": 8, \"event\": \"prepare_sent\", \"to\": 4}\n16 {\"ballot\": 8, \"cmd_op\": 1, \"event\": \"prepare_reply\", \"has_command\": true, \"replica\": 2, \"status\": 4, \"vballot\": 0}\n17 {\"ballot\": 8, \"cmd_op\": -1, \"event\": \"prepare_reply\", \"has_command\": false, \"replica\": 4, \"status\": 0, \"vballot\": 0}\n18 {\"event\": \"adoption_inputs\", \"quorum_reply_command_op\": 1, \"replica\": 3, \"self_vballot\": 8}\n19 {\"cmd_op\": 0, \"event\": \"recovery_proposal\", \"quorum_reply_command_op\": 1, \"replica\": 3, \"to\": [2, 4]}\n20 {\"cmd_op\": 0, \"event\": \"instance_state\", \"phase\": \"after_recovery_proposal\", \"replica\": 3, \"status\": 1}\n21 {\"cmd_op\": 0, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 3, \"status\": 1}\n22 {\"cmd_op\": 1, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 2, \"status\": 4}\n23 {\"cmd_op\": 0, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 4, \"status\": 2}\n24 {\"cmd_op\": 1, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 0, \"status\": 4}\n25 {\"cmd_op\": 1, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 1, \"status\": 1}\n","exit_code":0,"status":"completed"}}
