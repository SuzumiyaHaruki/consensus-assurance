nceSpace[0][0].Status),\n\t\t\"owner_cmd_op\":          cmdOp(owner.r.InstanceSpace[0][0].Cmds),\n\t\t\"pending_proposals\":     len(owner.r.InstanceSpace[0][0].lb.clientProposals),\n\t\t\"reply_bytes\":           replyBuf.Len()})\n\towner.state(\"final\", 0, 0)\n}\n'\"'''\ns = s.rstrip() + \\\"\\\\n\\\" + add\nopen(p,'w').write(s)\nprint('appended')\nPY\ncp draft/epaxos/assurance_generated_test.go draft/scratch/epaxos/ && cd draft/scratch && timeout 200 go test -run 'TestAssuranceEPaxosRecoveryReproposesClientRequest' -count=1 -v ./epaxos 2>&1 | grep -o 'CA_EVENT .*' | python3 -c \\\"\nimport sys,json\nfor i,l in enumerate(sys.stdin):\n    d=json.loads(l[len('CA_EVENT '):])\n    print(i, json.dumps({k:v for k,v in d.items() if k in ('event','replica','phase','status','cmd_op','to','vballot','has_command','requeued','command_id','pending_proposals','reply_bytes','owner_instance_status','owner_cmd_op')}))\n\\\"\"","aggregated_output":"appended\n0 {\"cmd_op\": 1, \"event\": \"instance_state\", \"phase\": \"proposed\", \"replica\": 0, \"status\": 1}\n1 {\"cmd_op\": 1, \"command_id\": 77, \"event\": \"owner_proposal\", \"replica\": 0}\n2 {\"cmd_op\": 1, \"event\": \"instance_state\", \"phase\": \"after_preaccept_replies\", \"replica\": 0, \"status\": 1}\n3 {\"event\": \"prepare_reply\", \"has_command\": true, \"replica\": 0, \"status\": 1, \"vballot\": 0}\n4 {\"event\": \"prepare_reply\", \"has_command\": false, \"replica\": 2, \"status\": 0, \"vballot\": 0}\n5 {\"event\": \"prepare_reply\", \"has_command\": false, \"replica\": 4, \"status\": 0, \"vballot\": 0}\n6 {\"cmd_op\": 0, \"event\": \"recovery_proposal\", \"replica\": 3, \"to\": [0]}\n7 {\"cmd_op\": 0, \"event\": \"recovery_proposal\", \"replica\": 3, \"to\": [4]}\n8 {\"cmd_op\": 0, \"event\": \"instance_state\", \"phase\": \"final\", \"replica\": 3, \"status\": 4}\n9 {\"cmd_op\": 0, \"event\": \"instance_state\", \"phase\": \"after_recovered_decision\", \"replica\": 0, \"status\": 4}\n10 {\"cmd_op\": 1, \"comma