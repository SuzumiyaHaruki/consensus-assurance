{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_15-11-32-swiftpaxos_epaxos-real-run && python3 - <<'PY'\np='draft/epaxos/assurance_generated_test.go'\ns=open(p).read()\nadd = '''\n// TestAssuranceEPaxosRecoveryReproposesClientRequest observes the client\n// completion path when a recovery replaces the command a live owner proposed:\n// the owner's pending proposal is expected to be re-queued on its own propose\n// channel by handleCommit.\nfunc TestAssuranceEPaxosRecoveryReproposesClientRequest(t *testing.T) {\n\tconst n = 5\n\tp := newProbe(n)\n\n\tb := p.node(1)\n\tb.r.startPhase1([]state.Command{put(1, \\\"y\\\")}, 2, 0, 2, nil)\n\tb.drain()\n\n\towner := p.node(0)\n\treplyBuf := new(bytes.Buffer)\n\treplyWriter := bufio.NewWriter(replyBuf)\n\tproposal := &defs.GPropose{\n\t\tPropose: &defs.Propose{CommandId: 77, Command: put(1, \\\"x\\\"), Timestamp: 1},\n\t\tReply:   replyWriter,\n\t\tMutex:   new(sync.Mutex),\n\t}\n\towner.r.startPhase1([]state.Command{proposal.Propose.Command}, 0, 0, 0, []*defs.GPropose{proposal})\n\towner.state(\\\"proposed\\\", 0, 0)\n\temit(\\\"owner_proposal\\\", map[string]any{\\\"replica\\\": 0, \\\"instance_row\\\": 0, \\\"instance_index\\\": 0, \\\"command_id\\\": 77, \\\"cmd_op\\\": 1, \\\"cmd_key\\\": 1})\n\n\temitReply := func(peer int32) {\n\t\tfor _, m := range p.node(peer).drain() {\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\temitReply(1)\n\tp.crash(1)\n\temitReply(2)\n\towner.state(\\\"after_preaccept_replies\\\", 0, 0)\n\n\tacceptRecipients := []int{}\n\tfor _, m := range owner.drain() {\n\t\tif _, ok := m.obj.(*Accept); ok {\n\t\t\tacceptRecipients = append(acceptRecipients, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\tfor _, id := range acceptRecipients {\n\t\tp.node(int32(id)).state(\\\"after_accept\\\", 0, 0)\n\t}\n\n\t// Replica 3, which holds no command for the instance, recovers it while the\n\t// owner is alive but has not consumed any AcceptReply.\n\trec := p.node(3)\n\trec.r.startRecoveryForInstance(0, 0)\n\trecRecipients := []int{}\n\tfor _, m := range rec.drain() {\n\t\tif _, ok := m.obj.(*Prepare); ok {\n\t\t\trecRecipients = append(recRecipients, int(m.to))\n\t\t\tp.deliver(m)\n\t\t}\n\t}\n\tfor _, id := range recRecipients {\n\t\tfor _, out := range p.node(int32(id)).drain() {\n\t\t\tif rp, ok := out.obj.(*PrepareReply); ok {\n\t\t\t\temit(\\\"prepare_reply\\\", map[string]any{\n\t\t\t\t\t\\\"from\\\": int(out.from), \\\"replica\\\": int(out.from), \\\"instance_row\\\": int(rp.Replica),\n\t\t\t\t\t\\\"instance_index\\\": int(rp.Instance), \\\"vballot\\\": int(rp.VBallot), \\\"status\\\": int(rp.Status),\n\t\t\t\t\t\\\"has_command\\\": rp.Command \"'!= nil && len(rp.Command) > 0})\n\t\t\t}\n\t\t\tp.deliver(out)\n\t\t}\n\t}\n\tfor _, m := range rec.drain() {\n\t\tif pa, ok := m.obj.(*PreAccept); ok {\n\t\t\temit(\"recovery_proposal\", map[string]any{\n\t\t\t\t\"replica\": 3, \"instance_row\": 0, \"instance_index\": 0, \"to\": []int{int(m.to)},\n\t\t\t\t\"cmd_op\": cmdOp(pa.Command)})\n\t\t}\n\t\tp.deliver(m)\n\t}\n\tp.pump(20)\n\trec.state(\"final\", 0, 0)\n\n\t// The recovered decision reaches the live owner: record whether its pending\n\t// client proposal is re-queued and what its instance now holds.\n\towner.state(\"after_recovered_decision\", 0, 0)\n\trequeued := 0\n\tfor {\n\t\tselect {\n\t\tcase prop := <-owner.r.ProposeChan:\n\t\t\trequeued++\n\t\t\temit(\"client_request_requeued\", map[string]any{\n\t\t\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0,\n\t\t\t\t\"command_id\": int(prop.Propose.CommandId), \"cmd_op\": int(prop.Propose.Command.Op),\n\t\t\t\t\"owner_instance_status\": int(owner.r.InstanceSpace[0][0].Status)})\n\t\tdefault:\n\t\t\tgoto done\n\t\t}\n\t}\ndone:\n\temit(\"requeue_summary\", map[string]any{\n\t\t\"replica\": 0, \"instance_row\": 0, \"instance_index\": 0, \"requeued\": requeued,\n\t\t\"owner_instance_status\": int(owner.r.InstanceSpace[0][0].Status),\n\t\t\"owner_cmd_op\":          cmdOp(owner.r.InstanceSpace[0][0].Cmds),\n\t\t\"pending_proposals\":     len(owner.r.InstanceSpace[0][0].lb.clientProposals),\n\t\t\"reply_bytes\":           replyBuf.Len()})\n\towner.state(\"final\", 0, 0)\n}\n'\"'''\ns = s.rstrip() + \\\"\\\\n\\\" + add\nopen(p,'w').write(s)\nprint('appended')\nPY\ncp draft/epaxos/assurance_generated_test.go draft/scratch/epaxos/ && cd draft/scratch && timeout 200 go test -run 'TestAssuranceEPaxosRecoveryReproposesClientRequest' -count=1 -v ./epaxos 2>&1 | grep -o 'CA_EVENT .*' | python3 -c \\\"\nimport sys,json\nfor i,l in enumerate(sys.stdin):\n    d=json.loads(l[len('CA_EVENT '):])\n    print(i, json.dumps({k:v for k,v in d.items() if k in ('event','replica','phase','status','cmd_op','to','vballot','has_command','requeued','command_id','pending_proposals','reply_bytes','owner_instance_status','owner_cmd_op')}))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
