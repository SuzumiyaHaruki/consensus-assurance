          "type": "array"
        },
        "remove_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Remove Fact Ids",
          "type": "array"
        },
        "remove_surface_entry_points": {
          "items": {
            "type": "string"
          },
          "title": "Remove Surface Entry Points",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "target_profile",
        "activities",
        "behaviors",
        "facts",
        "surfaces",
        "remove_behavior_ids",
        "remove_fact_ids",
        "remove_surface_entry_points",
        "rationale"
      ],
      "title": "AuditSpecDelta",
      "type": "object"
    },
    "Behavior": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "primary_activity": {
          "enum": [
            "A1",
            "A2",
            "A3",
            "A4",
            "A5",
            "A6",
            "A7"
          ],
