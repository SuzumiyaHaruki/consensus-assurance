      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "minItems": 1,
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "associations",
        "anchor",
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending",
        "grounding"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "boundary_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Boundary Complete"
        },
        "kind": {
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "boundary_complete",
        "kind",
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "ConditionDisposition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stable ID from the supplied condition records; preferred for new output",
          "title": "Condition Id"
        },
        "condition": {
          "description": "Legacy exact-text reference; do not paraphrase it to bypass unresolved conditions",
          "title": "Condition",
          "type": "string"
        },
        "applies_to": {
          "enum": [
            "old_judgment",
            "current_judgment",
            "independent_scope"
          ],
          "title": "Applies To",
          "type": "string"
        },
        "rationale": {
          "description": "Explain the responsibility and range to which this condition applies, preserving counterevidence",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "condition_id",
        "condition",
        "applies_to",
        "rationale",
        "source_ids"
      ],
      "title": "ConditionDisposition",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "identity": {
          "type": "array",
          "description": " Dictionary entries; keys must be unique. Use typed values.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "validity_context": {
          "title": "Validity Context",
          "type": "string"
        },
        "representation": {
          "items": {
            "type": "string"
          },
          "title": "Representation",
          "type": "array"
        },
        "invalidators": {
          "description": "Existing Behavior IDs only. Unread events or suspected invalidators belong in unknowns.",
          "items": {
            "type": "string"
          },
          "title": "Invalidators",
          "type": "array"
        },
        "reinterpreters": {
          "description": "Existing Behavior IDs only, not event descriptions or Activity IDs.",
          "items": {
            "type": "string"
          },
          "title": "Reinterpreters",
          "type": "array"
        },
        "durability": {
          "title": "Durability",
          "type": "string"
        },
        "recovery": {
          "title": "Recovery",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "meaning",
        "identity",
        "validity_context",
        "representation",
        "invalidators",
        "reinterpreters",
        "durability",
        "recovery",
        "source_ids",
        "unknowns"
      ],
      "title": "Fact",
      "type": "object"
    },
    "GraphPatch": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 15,
          "title": "Claims",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 20,
          "title": "Bindings",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDraft"
          },
          "maxItems": 30,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitDraft"
          },
          "maxItems": 5,
          "title": "Units",
          "type": "array"
        },
        "expected_versions": {
          "type": "array",
          "description": " Dictionary entries; keys must be unique. Use typed values.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "claims",
        "bindings",
        "relations",
        "units",
        "expected_versions",
        "rationale",
        "gaps"
      ],
      "title": "GraphPatch",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "expectation_ids": {
          "description": "Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.",
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object",
      "required": [
        "source_ids",
        "expectation_ids",
        "binding_ids",
        "derivation",
        "applicability",
        "unresolved",
        "conflicts",
        "alternatives"
      ]
    },
    "IssueResolution": {
      "additionalProperties": false,
      "properties": {
        "condition_dispositions": {
          "items": {
            "$ref": "#/$defs/ConditionDisposition"
          },
          "title": "Condition Dispositions",
          "type": "array"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "target_version": {
          "title": "Target Version",
          "type": "integer"
        },
        "original_question": {
          "description": "The exact stored issue explanation; preserve stable problem identity",
          "title": "Original Question",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "description": "Why actual evidence answers this specific issue; describing current behavior alone is insufficient",
          "title": "Rationale",
          "type": "string"
