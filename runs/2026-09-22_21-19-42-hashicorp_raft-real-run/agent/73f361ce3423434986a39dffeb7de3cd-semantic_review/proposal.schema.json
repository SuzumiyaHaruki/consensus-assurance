          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "externalized",
            "not_applicable",
            "unknown"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "realization_summary": {
          "title": "Realization Summary",
          "type": "string"
        },
        "entry_points": {
          "items": {
            "type": "string"
          },
          "title": "Entry Points",
          "type": "array"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "class_id",
        "applicability",
        "purpose",
        "realization_summary",
        "entry_points",
        "variants",
        "unknowns",
        "source_ids"
      ],
      "title": "Activity",
      "type": "object"
    },
    "AuditQuestion": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "explained_by_existing_mechanism",
                "concrete_suspicion",
                "needs_specific_evidence",
                "ready_for_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition"
        },
        "preferred_check": {
          "anyOf": [
            {
              "enum": [
                "source_review",
                "direct_test",
                "controlled_schedule",
                "local_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preferred Check"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/ReadRequest"
          },
          "title": "Requests",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "activity_classes": {
          "items": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7"
            ],
            "type": "string"
          },
          "title": "Activity Classes",
          "type": "array"
        },
        "behavior_ids": {
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "obligation_relation_kind": {
          "anyOf": [
            {
              "enum": [
                "establishment",
                "preservation",
                "consumption",
                "recovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Obligation Relation Kind"
        },
        "counterevidence": {
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "priority": {
          "description": "System consequence and audit significance, justified in importance; not proof",
          "maximum": 3,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "preferred_check",
        "requests",
        "question",
        "importance",
        "source_ids",
        "participants",
        "objects",
        "contexts",
        "event_paths",
        "activity_classes",
        "behavior_ids",
        "fact_ids",
        "obligation_relation_kind",
        "counterevidence",
        "unknowns",
        "priority",
        "trigger_rationale"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "AuditSpecDelta": {
      "additionalProperties": false,
      "properties": {
        "target_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "title": "Activities",
          "type": "array"
        },
        "behaviors": {
          "items": {
            "$ref": "#/$defs/Behavior"
          },
          "title": "Behaviors",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/Surface"
          },
          "title": "Surfaces",
          "type": "array"
        },
        "remove_behavior_ids": {
          "items": {
            "type": "string"
          },
