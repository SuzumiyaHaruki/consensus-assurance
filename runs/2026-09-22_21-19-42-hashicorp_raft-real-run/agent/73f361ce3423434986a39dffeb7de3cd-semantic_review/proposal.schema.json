          "type": "string"
        },
        "execution_owner": {
          "title": "Execution Owner",
          "type": "string"
        },
        "protocol_context": {
          "title": "Protocol Context",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        },
        "legal_preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Legal Preconditions",
          "type": "array"
        },
        "implementation_guards": {
          "items": {
            "type": "string"
          },
          "title": "Implementation Guards",
          "type": "array"
        },
        "reads": {
          "items": {
            "type": "string"
          },
          "title": "Reads",
          "type": "array"
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "title": "Writes",
          "type": "array"
        },
        "durable_effects": {
          "items": {
            "type": "string"
          },
          "title": "Durable Effects",
          "type": "array"
        },
        "external_effects": {
          "items": {
            "type": "string"
          },
          "title": "External Effects",
          "type": "array"
        },
        "important_branches": {
          "items": {
            "type": "string"
          },
          "title": "Important Branches",
          "type": "array"
        },
        "async_boundaries": {
          "items": {
            "type": "string"
          },
          "title": "Async Boundaries",
          "type": "array"
        },
        "produces_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Produces Fact Ids",
          "type": "array"
        },
        "consumes_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Consumes Fact Ids",
          "type": "array"
        },
        "cross_activity_effects": {
          "type": "array",
          "description": "Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee Dictionary entries; keys must be unique. Use typed values.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5",
                  "A6",
                  "A7"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "existing_protections": {
          "items": {
            "type": "string"
          },
          "title": "Existing Protections",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "primary_activity",
        "execution_owner",
        "protocol_context",
        "trigger",
        "legal_preconditions",
        "implementation_guards",
        "reads",
        "writes",
        "durable_effects",
        "external_effects",
        "important_branches",
        "async_boundaries",
        "produces_fact_ids",
        "consumes_fact_ids",
        "cross_activity_effects",
        "existing_protections",
        "source_ids",
        "unknowns"
      ],
