{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '672,688p' ../agent-source/net_transport.go; sed -n '667,728p' ../agent-source/raft.go; sed -n '1,45p' ../agent-source/future.go; cat ../agent-source/stable.go; sed -n '1,100p' ../agent-source/log.go\"","aggregated_output":"\t\t\tleaderAddr = req.Leader\n\t\t}\n\n\t\t// Check if this is a heartbeat\n\t\tif req.Term != 0 && leaderAddr != nil &&\n\t\t\treq.PrevLogEntry == 0 && req.PrevLogTerm == 0 &&\n\t\t\tlen(req.Entries) == 0 && req.LeaderCommitIndex == 0 {\n\t\t\tisHeartbeat = true\n\t\t}\n\n\t\tif isHeartbeat {\n\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"Heartbeat\"}}\n\t\t} else {\n\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"AppendEntries\"}}\n\t\t}\n\tcase rpcRequestVote:\n\t\tvar req RequestVoteRequest\nfunc (r *Raft) leaderLoop() {\n\t// stepDown is used to track if there is an inflight log that\n\t// would cause us to lose leadership (specifically a RemovePeer of\n\t// ourselves). If this is the case, we must not allow any logs to\n\t// be processed in parallel, otherwise we are basing commit on\n\t// only a single peer (ourself) and replicating to an undefined set\n\t// of peers.\n\tstepDown := false\n\t// This is only used for the first lease check, we reload lease below\n\t// based on the current config value.\n\tlease := time.After(r.config().LeaderLeaseTimeout)\n\n\tfor r.getState() == Leader {\n\t\tr.mainThreadSaturation.sleeping()\n\n\t\tselect {\n\t\tcase rpc := <-r.rpcCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tr.processRPC(rpc)\n\n\t\tcase <-r.leaderState.stepDown:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tr.setState(Follower)\n\n\t\tcase future := <-r.leadershipTransferCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tif r.getLeadershipTransferInProgress() {\n\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\tr.logger.Debug(\"starting leadership transfer\", \"id\", future.ID, \"address\", future.Address)\n\n\t\t\t// When we are leaving leaderLoop, we are no longer\n\t\t\t// leader, so we should stop transferring.\n\t\t\tleftLeaderLoop := make(chan struct{})\n\t\t\tdefer func() { close(leftLeaderLoop) }()\n\n\t\t\tstopCh := make(chan struct{})\n\t\t\tdoneCh := make(chan error, 1)\n\n\t\t\t// This is intentionally being setup outside of the\n\t\t\t// leadershipTransfer function. Because the TimeoutNow\n\t\t\t// call is blocking and there is no way to abort that\n\t\t\t// in case eg the timer expires.\n\t\t\t// The leadershipTransfer function is controlled with\n\t\t\t// the stopCh and doneCh.\n\t\t\t// No matter how this exits, have this function set\n\t\t\t// leadership transfer to false before we return\n\t\t\t//\n\t\t\t// Note that this leaves a window where callers of\n\t\t\t// LeadershipTransfer() and LeadershipTransferToServer()\n\t\t\t// may start executing after they get their future but before\n\t\t\t// this routine has set leadershipTransferInProgress back to false.\n\t\t\t// It may be safe to modify things such that setLeadershipTransferInProgress\n\t\t\t// is set to false before calling future.Respond, but that still needs\n\t\t\t// to be tested and this situation mirrors what callers already had to deal with.\n\t\t\tgo func() {\n\t\t\t\tdefer r.setLeadershipTransferInProgress(false)\n\t\t\t\tselect {\n\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Future is used to represent an action that may occur in the future.\ntype Future interface {\n\t// Error blocks until the future arrives and then returns the error status\n\t// of the future. This may be called any number of times - all calls will\n\t// return the same value, however is not OK to call this method twice\n\t// concurrently on the same Future instance.\n\t// Error will only return generic errors related to raft, such\n\t// as ErrLeadershipLost, or ErrRaftShutdown. Some operations, such as\n\t// ApplyLog, may also return errors from other methods.\n\tError() error\n}\n\n// IndexFuture is used for future actions that can result in a raft log entry\n// being created.\ntype IndexFuture interface {\n\tFuture\n\n\t// Index holds the index of the newly applied log entry.\n\t// This must not be called until after the Error method has returned.\n\tIndex() uint64\n}\n\n// ApplyFuture is used for Apply and can return the FSM response.\ntype ApplyFuture interface {\n\tIndexFuture\n\n\t// Response returns the FSM response as returned by the FSM.Apply method. This\n\t// must not be called until after the Error method has returned.\n\t// Note that if FSM.Apply returns an error, it will be returned by Response,\n\t// and not by the Error method, so it is always important to check Response\n\t// for errors from the FSM.\n\tResponse() interface{}\n}\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\n// StableStore is used to provide stable storage\n// of key configurations to ensure safety.\ntype StableStore interface {\n\tSet(key []byte, val []byte) error\n\n\t// Get returns the value for key, or an empty byte slice if key was not found.\n\tGet(key []byte) ([]byte, error)\n\n\tSetUint64(key []byte, val uint64) error\n\n\t// GetUint64 returns the uint64 value for key, or 0 if key was not found.\n\tGetUint64(key []byte) (uint64, error)\n}\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"fmt\"\n\t\"time\"\n\n\tmetrics \"github.com/hashicorp/go-metrics/compat\"\n)\n\n// LogType describes various types of log entries.\ntype LogType uint8\n\nconst (\n\t// LogCommand is applied to a user FSM.\n\tLogCommand LogType = iota\n\n\t// LogNoop is used to assert leadership.\n\tLogNoop\n\n\t// LogAddPeerDeprecated is used to add a new peer. This should only be used with\n\t// older protocol versions designed to be compatible with unversioned\n\t// Raft servers. See comments in config.go for details.\n\tLogAddPeerDeprecated\n\n\t// LogRemovePeerDeprecated is used to remove an existing peer. This should only be\n\t// used with older protocol versions designed to be compatible with\n\t// unversioned Raft servers. See comments in config.go for details.\n\tLogRemovePeerDeprecated\n\n\t// LogBarrier is used to ensure all preceding operations have been\n\t// applied to the FSM. It is similar to LogNoop, but instead of returning\n\t// once committed, it only returns once the FSM manager acks it. Otherwise,\n\t// it is possible there are operations committed but not yet applied to\n\t// the FSM.\n\tLogBarrier\n\n\t// LogConfiguration establishes a membership change configuration. It is\n\t// created when a server is added, removed, promoted, etc. Only used\n\t// when protocol version 1 or greater is in use.\n\tLogConfiguration\n)\n\n// String returns LogType as a human readable string.\nfunc (lt LogType) String() string {\n\tswitch lt {\n\tcase LogCommand:\n\t\treturn \"LogCommand\"\n\tcase LogNoop:\n\t\treturn \"LogNoop\"\n\tcase LogAddPeerDeprecated:\n\t\treturn \"LogAddPeerDeprecated\"\n\tcase LogRemovePeerDeprecated:\n\t\treturn \"LogRemovePeerDeprecated\"\n\tcase LogBarrier:\n\t\treturn \"LogBarrier\"\n\tcase LogConfiguration:\n\t\treturn \"LogConfiguration\"\n\tdefault:\n\t\treturn fmt.Sprintf(\"%d\", lt)\n\t}\n}\n\n// Log entries are replicated to all members of the Raft cluster\n// and form the heart of the replicated state machine.\ntype Log struct {\n\t// Index holds the index of the log entry.\n\tIndex uint64\n\n\t// Term holds the election term of the log entry.\n\tTerm uint64\n\n\t// Type holds the type of the log entry.\n\tType LogType\n\n\t// Data holds the log entry's type-specific data.\n\tData []byte\n\n\t// Extensions holds an opaque byte slice of information for middleware. It\n\t// is up to the client of the library to properly modify this as it adds\n\t// layers and remove those layers when appropriate. This value is a part of\n\t// the log, so very large values could cause timing issues.\n\t//\n\t// N.B. It is _up to the client_ to handle upgrade paths. For instance if\n\t// using this with go-raftchunking, the client should ensure that all Raft\n\t// peers are using a version that can handle that extension before ever\n\t// actually triggering chunking behavior. It is sometimes sufficient to\n\t// ensure that non-leaders are upgraded first, then the current leader is\n\t// upgraded, but a leader changeover during this process could lead to\n\t// trouble, so gating extension behavior via some flag in the client\n\t// program is also a good idea.\n\tExtensions []byte\n\n\t// AppendedAt stores the time the leader first appended this log to it's\n\t// LogStore. Followers will observe the leader's time. It is not used for\n\t// coordination or as part of the replication protocol at all. It exists only\n\t// to provide operational information for example how many seconds worth of\n\t// logs are present on the leader which might impact follower's ability to\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > complete_backbone.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v2.json'))\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n for k in ['established_by','consumed_by']:f.pop(k,None)\nsources=[]\ndef s(i,f,a,b,kind='code_observation'):sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind))\nfor args in [('S-follow','raft.go',158,283),('S-lease','raft.go',1036,1094),('S-persist','raft.go',2130,2161),('S-prevote-recv','raft.go',1736,1810),('S-prevote-send','raft.go',2050,2127),('S-transfer','raft.go',990,1032),('S-timeout-now','raft.go',2209,2227),('S-leader-control','raft.go',667,784),('S-verify-consume','raft.go',841,880),('S-verify-start','raft.go',965,987),('S-notify','replication.go',100,134),('S-heartbeat','replication.go',388,442),('S-verify-count','future.go',274,295),('S-future-complete','future.go',90,134),('S-net-pipeline','net_transport.go',817,911),('S-inmem-pipeline','inmem_transport.go',272,362),('S-net-decode','net_transport.go',771,790),('S-restore-user','raft.go',1104,1198),('S-bootstrap','api.go',239,282),('S-recover','api.go',283,440),('S-snapshot-create','snapshot.go',125,280),('S-membership','configuration.go',196,308),('S-replicate-loop','replication.go',137,199),('S-net-handler','net_transport.go',639,768)]:s(*args)\ns('S-pipeline-contract','transport.go',112,140,'interface_statement')\ns('S-restore-contract','api.go',1050,1098,'interface_statement')\ns('S-no-start-restore','config.go',229,233,'interface_statement')\ns('S-future-contract','future.go',13,43,'interface_statement')\nchanges={}\ndef ch(i,ss,r,impact='clarification'):\n changes[i]=dict(impact=impact,source_ids=ss,rationale=r,preserves='There are no accepted Candidates or Units. Existing log-support facts retain their identity and conditional meanings; newly mapped authority, storage and API behavior does not turn support reports into correctness guarantees.')\ndef add(i,a,o,c,t,ss,**kw):m['behaviors'].append(dict(id=i,primary_activity=a,execution_owner=o,protocol_context=c,trigger=t,source_ids=ss,**kw))\nadd('B-follow-timeout','A2','Follower main loop','Latest configuration and last successful leader contact','Heartbeat timer expiry',['S-follow'],implementation_guards=['Recent contact suppresses campaign; no known configuration or lack of local voter eligibility prevents election'],writes=['Clear known leader and enter Candidate when eligible'],important_branches=['Reject Apply and Restore as not leader; live bootstrap requires local voter and clean persistent state'])\nadd('B-prevote','A2','Candidate request workers and remote main handler','Proposed next term without persisting that term','Pre-election enabled and not leadership transfer',['S-prevote-send','S-prevote-recv','S-election'],implementation_guards=['Receiver checks known leader, candidate membership/voter status, nonold proposed term and last-log order'],writes=['Return pre-vote grants without setting current term or stable vote'],important_branches=['Local voter grants itself; unsupported remote pre-vote command treated as granted for compatibility; other RPC errors refuse'],external_effects=['Majority pre-votes permit real electSelf campaign, not leadership directly'])\nadd('B-persist','A6','Main term/vote setters','Current term and last voted candidate address bytes','Term advance or new vote',['S-persist'],durable_effects=['persistVote writes lastVoteTerm then candidate bytes in separate calls; setCurrentTerm persists before in-memory update'],important_branches=['Vote store error returns without granting; current-term store error panics'],cross_activity_effects={'A2':'Persistent term and prior-vote checks constrain future authority acquisition'},unknowns=['Crash/partial failure atomicity between vote fields depends on the stable backend; no transactional guarantee inferred'])\nadd('B-heartbeat','A2','Independent per-peer heartbeat worker','Captured worker term and peer; contact timestamp and pending verification requests','Periodic heartbeat or immediate verify notification',['S-heartbeat','S-notify','S-replicate-loop','S-net-handler'],writes=['On error-free RPC refresh lastContact and deliver resp.Success to pending verification; transport errors back off'],important_branches=['Heartbeat is independent of blocked log replication','This branch does not compare response term before refreshing contact','Network fast path accepts only empty append without predecessor or commit index'],cross_activity_effects={'A1':'Empty heartbeat does not call commitment.match; contact is distinct from stored-log support'},unknowns=['Whether stale-term heartbeat contact can indefinitely delay authority loss needs a scoped schedule and other worker analysis'])\nadd('B-lease','A2','Main leader loop','Latest voter set and per-peer contact timestamps','Leader lease timer',['S-lease','S-admit'],implementation_guards=['Count only Voter entries and self; compare contact age to LeaderLeaseTimeout'],writes=['Step down if recent contact count below voters/2+1'],unknowns=['Recent contact is an observation, not a proof of accepted leadership or durable support'])\nadd('B-transfer','A2','Leader loop, transfer worker and TimeoutNow receiver','Selected replication peer, transfer-in-progress flag and ensuing campaign','Public leadership transfer request',['S-transfer','S-timeout-now','S-leader-control','S-election','S-admit'],implementation_guards=['Leader gates new applies/config changes during transfer; worker waits for nextIndex beyond current lastIndex before TimeoutNow'],writes=['Receiver sets Candidate and leadership-transfer flag; campaign bypasses pre-vote and requests transfer votes'],important_branches=['Timeout or role exit stops transfer control; blocking TimeoutNow RPC itself is not cancellable','Granting votes and collecting majority still occurs; transfer is not unilateral decision authority'])\nadd('B-verify','A2','Leader verification registration and mutex-protected vote callbacks','verifyFuture identity and current quorumSize','VerifyLeader request and peer notification',['S-verify-start','S-notify','S-verify-count','S-verify-consume','S-peers'],writes=['Start at one self vote; register on all replState peers; each notifyAll drains its pending map; vote callback completes aggregation once'],implementation_guards=['quorumSize counts voters; negative notification returns early and leader loop steps down'],external_effects=['Leader loop returns nil on sufficient votes, otherwise ErrNotLeader'],unknowns=['Registration includes nonvoter replication workers; whether their success can satisfy a voter-based quorum is an untested source-grounded lead'])\nadd('B-pipeline-producer','A6','Network or in-memory pipeline decoder','Append future request/response pair','RPC response, decoding failure or timeout',['S-net-pipeline','S-inmem-pipeline','S-net-decode','S-future-complete'],writes=['Complete future with result error before publishing it to Consumer'],important_branches=['Network decodes error string and response before returning remote error; partial decode may return an error','In-memory copies response then completes with RPC error; timeout completes with error','Both publish failed as well as successful futures'],cross_activity_effects={'A1':'Future delivery is not equivalent to successful RPC support; consumers must interpret the result under the interface contract'})\nadd('B-config-change','A4','Leader main loop and configuration-log scanner','Latest/committed configuration index and current leader startIndex','Configuration-change request or stored configuration entry',['S-config-append','S-config-scan','S-membership','S-peers','S-consume'],implementation_guards=['Admission requires latest configuration committed and a current-term entry committed','Optional prevIndex must match; require unique nonempty IDs/addresses and at least one voter'],writes=['Dispatch full configuration log; install latest set and update commitment voter filter and replication workers','Follower/startup scanner promotes prior latest to committed when processing next configuration'],cross_activity_effects={'A1':'New latest voter set determines commitment immediately; retained voter IDs retain match indexes','A2':'Committed local removal triggers step-down or shutdown; election eligibility uses latest configuration'},unknowns=['Dispatch failure continuation and address replacement semantics remain local fault/details for later checks'])\nadd('B-snapshot-create','A6','Snapshot worker, FSM worker and main configuration owner','FSM applied boundary and committed configuration index','Snapshot request',['S-snapshot-create','S-fsm-rest'],implementation_guards=['FSM must have an applied boundary; snapshot index must not precede committed configuration index'],writes=['Persist snapshot with FSM index/term and committed configuration; close sink before updating lastSnapshot'],durable_effects=['Persist and finalize snapshot before compacting logs at min(snapshot index, tail minus trailing logs)'],cross_activity_effects={'A3':'Stored snapshot is a source for startup restoration and missing-log resynchronization'},unknowns=['Filesystem snapshot backend failure modes remain unexpanded'])\nadd('B-user-restore','A3','Leader main loop and serialized FSM worker','Explicit disaster recovery, current configuration and term','Restore API enqueues snapshot',['S-restore-user','S-restore-contract','S-fsm-rest','S-verify-consume'],implementation_guards=['Require supported version and no outstanding configuration change','Require exact declared byte count and successful snapshot finalization; FSM restore failure panics'],writes=['Abort inflight futures with ErrAbortedByRestore; burn index greater than current/supplied snapshot index','Persist snapshot under current configuration/term; wait for FSM restore; reset lastLog/applied/snapshot boundary'],external_effects=['Public Restore follows local restoration with a no-op Apply and waits for its completion'],cross_activity_effects={'A1':'Deliberate log hole forces lagging peers onto snapshot transfer','A7':'Source API warns this is disaster recovery into a fresh cluster, not ordinary operation; excluded from ordinary preservation expectations'})\nadd('B-bootstrap-recover','A3','Offline APIs and follower liveBootstrap','Clean bootstrap or explicitly forced manual recovery','BootstrapCluster or RecoverCluster',['S-bootstrap','S-recover','S-follow','S-membership'],implementation_guards=['Bootstrap rejects existing state and validates configuration','RecoverCluster requires existing state and supplied valid configuration'],durable_effects=['Bootstrap writes term 1 and configuration entry at index 1','RecoverCluster restores snapshot, applies remaining command logs irrespective of prior commit, persists a new snapshot with supplied configuration at configuration index 1 and truncates logs'],cross_activity_effects={'A2':'Bootstrap establishes initial eligible voters; forced recovery substitutes an operator-provided configuration'},unknowns=['Offline recovery has an explicitly stronger operator/fault contract; not an ordinary consensus history'])\nfor b in m['behaviors']:\n i=b['id']\n if i=='B-election':\n  b['unknowns']=['Legacy compatibility and pathological transfer schedules remain untested'];b['source_ids']+=['S-follow','S-lease','S-prevote-send','S-prevote-recv','S-persist'];ch(i,b['source_ids'][-5:],'Resolve missing campaign entry, pre-vote, majority definition and durable term/vote helper reads.')\n if i=='B-vote':\n  b['unknowns']=['Stable backend crash/partial failure behavior between the two vote writes remains unresolved'];b['source_ids']+=['S-persist'];ch(i,['S-persist'],'Record actual two-call persistence boundary without inferring atomicity.')\n if i=='B-fsm':\n  b['source_ids']+=['S-fsm-rest','S-prepare'];b['important_branches']=['Batch mode filters command/configuration entries, requires one response per included log, then completes corresponding futures; barriers finish after preceding batch work','Restore and committed batches share the serialized fsmMutateCh; FSM snapshot requests use a separate channel'];b['unknowns']=['Application-specific FSM semantics and concurrent snapshot object implementation are injected and not examined'];ch(i,['S-fsm-rest','S-prepare'],'Integrate batching, barrier and restore ordering into the existing FSM owner.')\n if i=='B-consume':\n  b['source_ids']+=['S-prepare'];b['unknowns']=['Application callbacks beyond the injected FSM interface remain outside current map'];b['important_branches']+=['prepareLog forwards command/barrier and protocol >2 configuration; ignored no-ops complete without an FSM tuple'];ch(i,['S-prepare'],'Resolve log-kind routing and distinguish enqueue progress from callback completion.')\n if i=='B-generation':\n  b['unknowns']=['Late old-generation worker scheduling is not executed; captured commitment object limits support to the old accumulator'];b['source_ids']+=['S-fsm-rest','S-leader-control'];b['important_branches']=['Committed tuples already removed from inflight remain on FSM channel across step-down; deferred cleanup does not cancel them'];ch(i,['S-fsm-rest','S-leader-control'],'Clarify survival of already-enqueued committed work across leader cleanup.')\n if i=='B-pipeline':\n  b['unknowns']=['Response access occurs without Error despite interface requirement; consequences depend on actual future result and producer contract'];b['source_ids']+=['S-pipeline-contract','S-net-pipeline','S-inmem-pipeline'];ch(i,b['source_ids'][-3:],'Record contrary producer protection and explicit interface precondition; no erroneous support execution inferred.')\n if i=='B-startup':\n  b['unknowns']=['Backend corruption and fallback consistency remain unexpanded'];b['source_ids']+=['S-no-start-restore','S-bootstrap','S-recover'];b['important_branches']+=['NoSnapshotRestoreOnStart supports FSMs restored by another mechanism; metadata is still restored'];ch(i,b['source_ids'][-3:],'Resolve skip-restore intent and explicit bootstrap/manual recovery boundary.')\n if i=='B-install':\n  b['unknowns']=['Concrete snapshot backend crash behavior remains unexpanded; no arbitrary snapshot legality assumed'];b['source_ids']+=['S-snapshot-create'];ch(i,['S-snapshot-create'],'Trace source snapshot boundary and compaction alternatives; retain conditional receiver semantics.')\n if i=='B-snapshot-send':\n  b['unknowns']=['Concrete store/backend failures and transport substitution require scenario-specific fault assumptions'];b['source_ids']+=['S-snapshot-create'];ch(i,['S-snapshot-create'],'Identify ordinary snapshot producer; no change to support report identity.')\nfor f in m['facts']:\n if f['id']=='F-pipeline-match':\n  f['unknowns']=['Consumer readiness includes errored futures; effect of accessing Response without Error is a specific unresolved contract question, not evidence of a bad prefix'];f['source_ids']+=['S-pipeline-contract','S-net-pipeline','S-inmem-pipeline'];ch(f['id'],f['source_ids'][-3:],'Resolve future publication behavior while preserving weakest observed decoder assertion.')\n if f['id']=='F-match':\n  f['unknowns']=[];ch(f['id'],['S-pipeline','S-snapshot-send'],'Alternative match reports are now separately mapped; ordinary report identity and meaning remain unchanged.')\nfor a in m['activities']:\n a['source_ids']=list(dict.fromkeys(a['source_ids']+[z for b in m['behaviors'] if b['primary_activity']==a['class_id'] for z in b['source_ids']]))\n if a['class_id']=='A3':a['unknowns']=['Concrete backend failure variants and explicit disaster-recovery deployments remain unexpanded.']\n a['realization_summary']={'A1':'Ordinary append, pipeline and snapshot reports enter a voter-filtered leader-generation commitment accumulator; advancement requires a majority index at or beyond startIndex.','A2':'Follower timers, pre-votes, persisted votes, election-local chan