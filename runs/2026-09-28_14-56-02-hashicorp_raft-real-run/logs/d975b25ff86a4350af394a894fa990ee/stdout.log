\\":3,\\\"event\\\":\\\"new_leader_apply\\\",\\\"higher_term\\\":true,\\\"history\\\":\\\"verify-partition-1\\\",\\\"index\\\":8,\\\"leader\\\":\\\"B\\\",\\\"new_fsm_count\\\":2,\\\"old_fsm_count\\\":1,\\\"old_state\\\":\\\"Leader\\\",\\\"operation\\\":\\\"verify-after-majority\\\",\\\"original_term\\\":2,\\\"term\\\":3}\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.260400866+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterHistory\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"verify_invoked\\\",\\\"higher_term\\\":true,\\\"history\\\":\\\"verify-partition-1\\\",\\\"new_apply_index\\\":8,\\\"new_leader\\\":\\\"B\\\",\\\"new_term\\\":3,\\\"node\\\":\\\"A\\\",\\\"old_state\\\":\\\"Leader\\\",\\\"old_term\\\":2,\\\"operation\\\":\\\"verify-after-majority\\\"}\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.260465126+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterHistory\",\"Output\":\"CA_EVENT {\\\"error\\\":\\\"\\\",\\\"event\\\":\\\"verify_result\\\",\\\"history\\\":\\\"verify-partition-1\\\",\\\"new_fsm_count\\\":2,\\\"node\\\":\\\"A\\\",\\\"old_fsm_count\\\":1,\\\"old_state\\\":\\\"Leader\\\",\\\"operation\\\":\\\"verify-after-majority\\\",\\\"success\\\":true}\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.260516799+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterHistory\",\"Output\":\"--- PASS: TestAssuranceVerifyNonvoterHistory (3.82s)\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.260558231+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterHistory\",\"Elapsed\":3.82}\n{\"Time\":\"2026-09-28T15:20:47.261239061+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.263795406+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"ok  \\tgithub.com/hashicorp/raft\\t3.844s\\n\"}\n{\"Time\":\"2026-09-28T15:20:47.26390343+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Elapsed\":3.8449999999999998}\n{\n  \"description\": \"Correlate prefix, drained voter callbacks, new-majority Apply and subsequent former-leader VerifyLeader result in one execution.\",\n  \"claim_id\": \"O-verify-after-majority\",\n  \"binding_ids\": [\n    \"BIND-verify-registration\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"sync\\\"\\n \\\"testing\\\"\\n \\\"time\\\"\\n\\n \\\"github.com/hashicorp/go-hclog\\\"\\n)\\n\\n// Transport faults affect delivery only. All successful replies come from real Raft handlers.\\ntype assuranceTransport struct {\\n *InmemTransport\\n mu sync.Mutex\\n blocked map[ServerID]bool\\n failed map[string]int\\n epoch uint64\\n}\\nfunc (x *assuranceTransport) AppendEntriesPipeline(id ServerID, addr ServerAddress) (AppendPipeline, error) {\\n return nil, ErrPipelineReplicationNotSupported\\n}\\nfunc (x *assuranceTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\\n kind := \\\"append\\\"\\n if req.PrevLogEntry == 0 && req.PrevLogTerm == 0 && len(req.Entries) == 0 && req.LeaderCommitIndex == 0 { kind = \\\"heartbeat\\\" }\\n x.mu.Lock()\\n epoch := x.epoch\\n blocked := x.blocked[id]\\n if blocked { x.failed[string(id)+\\\"/\\\"+kind]++ }\\n x.mu.Unlock()\\n if blocked { return fmt.Errorf(\\\"controlled partition to %s\\\", id) }\\n err := x.InmemTransport.AppendEntries(id, addr, req, resp)\\n x.mu.Lock()\\n changed := epoch != x.epoch && x.blocked[id]\\n x.mu.Unlock()\\n if changed { return fmt.Errorf(\\\"partition crossed response delivery to %s\\\", id) }\\n return err\\n}\\nfunc assuranceEvent(kind string, fields map[string]interface{}) {\\n fields[\\\"event\\\"] = kind\\n b, _ := json.Marshal(fields)\\n fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc assuranceWait(t *testing.T, what string, limit time.Duration, predicate func() bool) {\\n t.Helper()\\n deadline := time.Now().Add(limit)\\n for time.Now().Before(deadline) {\\n  if predicate() { return }\\n  time.Sleep(5*time.Millisecond)\\n }\\n t.Fatalf(\\\"prefix incomplete: %s\\\", what)\\n}\\nfunc assuranceError(t *testing.T, what string, f Future) error {\\n t.Helper()\\n done := make(chan error, 1)\\n go func(){ done <- f.Error() }()\\n select {\\n case err := <-done: return err\\n case <-time.After(8*time.Second): t.Fatalf(\\\"incomplete future: %s\\\", what); return fmt.Errorf(\\\"timeout\\\")\\n }\\n}\\nfunc TestAssuranceVerifyNonvoterHistory(t *testing.T) {\\n const history = \\\"verify-partition-1\\\"\\n const op = \\\"verify-after-majority\\\"\\n ids := []ServerID{\\\"A\\\", \\\"B\\\", \\\"C\\\", \\\"D\\\"}\\n nodes := make([]*Raft, 4)\\n stores := make([]*InmemStore, 4)\\n fsms := make([]*MockFSM, 4)\\n trans := make([]*assuranceTransport, 4)\\n for i, id := range ids {\\n  _, base := NewInmemTransportWithTimeout(ServerAddress(id), 100*time.Millisecond)\\n  trans[i] = &assuranceTransport{InmemTransport:base, blocked:make(map[ServerID]bool), failed:make(map[string]int)}\\n }\\n for i := range trans { for j := range trans { if i != j { trans[i].Connect(ServerAddress(ids[j]), trans[j].InmemTransport) } } }\\n defer func(){\\n  for _, n := range nodes { if n != nil { n.Shutdown() } }\\n  for _, n := range nodes { if n != nil { _ = n.Shutdown().Error() } }\\n  for _, tr := range trans { _ = tr.Close() }\\n }()\\n for i,id := range ids {\\n  conf := DefaultConfig()\\n  conf.LocalID = id\\n  conf.HeartbeatTimeout = 200*time.Millisecond\\n  conf.ElectionTimeout = 200*time.Millisecond\\n  conf.LeaderLeaseTimeout = 100*time.Millisecond\\n  conf.CommitTimeout = 10*time.Millisecond\\n  conf.Logger = hclog.NewNullLogger()\\n  if i == 0 {\\n   conf.HeartbeatTimeout = 2*time.Second\\n   conf.ElectionTimeout = 2*time.Second\\n   conf.LeaderLeaseTimeout = 2*time.Second\\n  }\\n  store := NewInmemStore()\\n  stores[i] = store\\n  fsms[i] = &MockFSM{}\\n  n, err := NewRaft(conf, fsms[i], store, store, NewInmemSnapshotStore(), trans[i])\\n  if err != nil { t.Fatal(err) }\\n  nodes[i] = n\\n }\\n if err := assuranceError(t,\\\"bootstrap\\\",nodes[0].BootstrapCluster(Configuration{Servers:[]Server{{ID:\\\"A\\\",Address:\\\"A\\\",Suffrage:Voter}}})); err != nil {t.Fatal(err)}\\n assuranceWait(t,\\\"A elected from single-voter bootstrap\\\",6*time.Second,func()bool{return nodes[0].State()==Leader})\\n if err:=assuranceError(t,\\\"add D nonvoter\\\",nodes[0].AddNonvoter(\\\"D\\\",\\\"D\\\",0,time.Second));err!=nil{t.Fatal(err)}\\n for _,id := range []ServerID{\\\"B\\\",\\\"C\\\"} {\\n  if err:=assuranceError(t,\\\"add voter\\\",nodes[0].AddVoter(id,ServerAddress(id),0,time.Second));err!=nil{t.Fatal(err)}\\n }\\n prefix := nodes[0].Apply([]byte(\\\"prefix\\\"),time.Second)\\n if err:=assuranceError(t,\\\"prefix apply\\\",prefix);err!=nil{t.Fatal(err)}\\n for i := range nodes {\\n  ii:=i\\n  assuranceWait(t,\\\"configuration and prefix propagation\\\",3*time.Second,func()bool{\\n   cf:=nodes[ii].GetConfiguration()\\n   if cf.Error()!=nil{return false}\\n   return len(cf.Configuration().Servers)==4 && len(fsms[ii].Logs())>=1\\n  })\\n }\\n control:=nodes[0].VerifyLeader()\\n if err:=assuranceError(t,\\\"connected verification\\\",control);err!=nil{t.Fatal(err)}\\n cf := nodes[0].GetConfiguration()\\n if err := cf.Error(); err != nil { t.Fatal(err) }\\n voters, nonvoters := 0, 0\\n for _, server := range cf.Configuration().Servers {\\n  if server.Suffrage == Voter { voters++ } else if server.Suffrage == Nonvoter { nonvoters++ }\\n  if (server.ID == \\\"D\\\") != (server.Suffrage == Nonvoter) { t.Fatal(\\\"unexpected suffrage\\\", server) }\\n }\\n if voters != 3 || nonvoters != 1 { t.Fatal(\\\"unexpected configuration\\\") }\\n originalTerm := nodes[0].CurrentTerm()\\n assuranceEvent(\\\"prefix\\\",map[string]interface{}{\\\"history\\\":history,\\\"leader\\\":\\\"A\\\",\\\"term\\\":nodes[0].CurrentTerm(),\\\"prefix_index\\\":prefix.Index(),\\\"control_ok\\\":true,\\\"voters\\\":voters,\\\"nonvoters\\\":nonvoters,\\\"operation\\\":op,\\\"configuration_index\\\":cf.Index()})\\n // Split {A,D} from {B,C}. Disable existing and future cross-partition routes.\\n for i := range trans {\\n  for j := range trans {\\n   if (i==0||i==3)!=(j==0||j==3) {\\n    trans[i].mu.Lock();trans[i].epoch++;trans[i].blocked[ids[j]]=true;trans[i].mu.Unlock()\\n    trans[i].Disconnect(ServerAddress(ids[j]))\\n   }\\n  }\\n }\\n // Each of A's two sequential workers must begin a failed post-partition RPC.\\n // This proves its preceding pre-partition callback has already run.\\n assuranceWait(t,\\\"old voter reply drain\\\",time.Second,func()bool{\\n  trans[0].mu.Lock();defer trans[0].mu.Unlock()\\n  return trans[0].failed[\\\"B/append\\\"]>0 && trans[0].failed[\\\"B/heartbeat\\\"]>0 && trans[0].failed[\\\"C/append\\\"]>0 && trans[0].failed[\\\"C/heartbeat\\\"]>0\\n })\\n trans[0].mu.Lock()\\n drain := map[string]interface{}{\\\"history\\\":history,\\\"operation\\\":op,\\\"B_append\\\":trans[0].failed[\\\"B/append\\\"],\\\"B_heartbeat\\\":trans[0].failed[\\\"B/heartbeat\\\"],\\\"C_append\\\":trans[0].failed[\\\"C/append\\\"],\\\"C_heartbeat\\\":trans[0].failed[\\\"C/heartbeat\\\"],\\\"drained\\\":trans[0].failed[\\\"B/append\\\"]>0 && trans[0].failed[\\\"B/heartbeat\\\"]>0 && trans[0].failed[\\\"C/append\\\"]>0 && trans[0].failed[\\\"C/heartbeat\\\"]>0}\\n trans[0].mu.Unlock()\\n assuranceEvent(\\\"voter_callbacks_drained\\\",drain)\\n next:=-1\\n assuranceWait(t,\\\"majority election\\\",1500*time.Millisecond,func()bool{\\n  for _,i:=range []int{1,2}{if nodes[i].State()==Leader{next=i;return true}}\\n  return false\\n })\\n newWrite:=nodes[next].Apply([]byte(\\\"majority-after-partition\\\"),time.Second)\\n if err:=assuranceError(t,\\\"majority apply\\\",newWrite);err!=nil{t.Fatal(err)}\\n var committed Log\\n if err := stores[next].GetLog(newWrite.Index(), &committed); err != nil { t.Fatal(err) }\\n if string(committed.Data) != \\\"majority-after-partition\\\" { t.Fatal(\\\"wrong command identity\\\") }\\n assuranceEvent(\\\"new_leader_apply\\\",map[string]interface{}{\\\"history\\\":history,\\\"leader\\\":ids[next],\\\"term\\\":nodes[next].CurrentTerm(),\\\"index\\\":newWrite.Index(),\\\"operation\\\":op,\\\"command\\\":string(committed.Data),\\\"entry_term\\\":committed.Term,\\\"original_term\\\":originalTerm,\\\"higher_term\\\":committed.Term>originalTerm,\\\"apply_ok\\\":true,\\\"old_state\\\":nodes[0].State().String(),\\\"old_fsm_count\\\":len(fsms[0].Logs()),\\\"new_fsm_count\\\":len(fsms[next].Logs())})\\n assuranceEvent(\\\"verify_invoked\\\",map[string]interface{}{\\\"history\\\":history,\\\"operation\\\":op,\\\"node\\\":\\\"A\\\",\\\"new_leader\\\":ids[next],\\\"new_term\\\":nodes[next].CurrentTerm(),\\\"new_apply_index\\\":newWrite.Index(),\\\"higher_term\\\":committed.Term>originalTerm,\\\"old_term\\\":nodes[0].CurrentTerm(),\\\"old_state\\\":nodes[0].State().String()})\\n f:=nodes[0].VerifyLeader()\\n err:=assuranceError(t,\\\"target verification\\\",f)\\n errText:=\\\"\\\";if err!=nil{errText=err.Error()}\\n assuranceEvent(\\\"verify_result\\\",map[string]interface{}{\\\"history\\\":history,\\\"operation\\\":op,\\\"node\\\":\\\"A\\\",\\\"success\\\":err==nil,\\\"error\\\":errText,\\\"old_state\\\":nodes[0].State().String(),\\\"old_fsm_count\\\":len(fsms[0].Logs()),\\\"new_fsm_count\\\":len(fsms[next].Logs())})\\n}\\n\",\n    \"description\": \"Actual four-node public-API history using in-memory stores and MockFSM, with transport delivery partition and emitted raw fields.\",\n    \"semantic_changes\": [\n      \"Transport wrapper disables optional pipeline support and drops cross-partition AppendEntries; embedded InmemTransport disconnects all cross-partition routes.\",\n      \"Read-only observations count failed worker calls, inspect the applied log entry and FSM command counts. No target source or critical protocol state is changed.\",\n      \"Harness timeouts bound construction and completion; missing required events cannot be a passing comparison.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prefix\",\n        \"event\": \"prefix\",\n        \"conditions\": [\n          {\n            \"field\": \"control_ok\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"voters\",\n            \"op\": \"eq\",\n            \"value\": 3,\n            \"reference\": null\n          },\n          {\n            \"field\": \"nonvoters\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"drain\",\n        \"event\": \"voter_callbacks_drained\",\n        \"conditions\": [\n          {\n            \"field\": \"drained\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"history\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prefix.history\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"majority\",\n        \"event\": \"new_leader_apply\",\n        \"conditions\": [\n          {\n            \"field\": \"apply_ok\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"higher_term\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"command\",\n            \"op\": \"eq\",\n            \"value\": \"majority-after-partition\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"history\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"drain.history\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"invoked\",\n        \"event\": \"verify_invoked\",\n        \"conditions\": [\n          {\n            \"field\": \"new_apply_index\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"majority.index\"\n          },\n          {\n            \"field\": \"new_leader\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"majority.leader\"\n          },\n          {\n            \"field\": \"node\",\n            \"op\": \"eq\",\n            \"value\": \"A\",\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-bootstrap\",\n        \"S-config-append\",\n        \"S-membership\",\n        \"S-inmem-init\",\n        \"S-inmem-partition\",\n        \"S-replicate-loop\",\n        \"S-heartbeat\",\n        \"S-mock-fsm\",\n        \"S-startup\",\n        \"S-lease\"\n      ],\n      \"expectation_ids\": [\n        \"S-verify-api\",\n        \"S-suffrage\",\n        \"S-api\"\n      ],\n      \"binding_ids\": [\n        \"BIND-verify-registration\"\n      ],\n      \"derivation\": \"NewRaft, single-node BootstrapCluster, AddNonvoter, AddVoter and Apply create actual term/log/configuration state. All peers run real handlers and background loops. The transport embeds InmemTransport, disables optional pipelining through its supported error, and drops cross-partition RPC delivery/replies; it never forges Success or terms. Failed post-partition calls from A to each voter in each of its two sequential worker paths occur after all earlier calls and callbacks in that path. The driver waits for these failures before verification, excluding prior voter success callbacks. Connected verification before the partition supplies a permitted path.\",\n      \"applicability\": \"A has 2s heartbeat/election/lease settings; B,C,D use 200ms heartbeat/election and 100ms lease. The configuration is validated by NewRaft; a majority can elect while A has not yet timed out. No worker is suspended or protocol state assigned.\",\n      \"unresolved\": [\n        \"Finite prefix or future timeout is incomplete observation, not a liveness failure.\",\n        \"No network backend or persistence backend claim.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Lease expiry, higher-term replies, negative notifications and shutdown remain real paths; if they return an error, the target comparison may hold.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-verify-result\",\n      \"checker_id\": \"C-verify-after-majority\",\n      \"event\": \"verify_result\",\n      \"binding_ids\": [\n        \"BIND-verify-registration\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-verify-start\",\n          \"S-verify-count\",\n          \"S-verify-consume\",\n          \"S-notify\",\n          \"S-heartbeat\",\n          \"S-peers\",\n          \"S-lease\",\n          \"S-election\",\n          \"S-consume\",\n          \"S-fsm-rest\"\n        ],\n        \"expectation_ids\": [\n          \"S-verify-api\",\n          \"S-suffrage\",\n          \"S-api\"\n        ],\n        \"binding_ids\": [\n          \"BIND-verify-registration\"\n        ],\n        \"derivation\": \"VerifyLeader is documented to ensure the peer is still leader and to prevent stale FSM data after leadership loss. A successful command Apply on a different voter-majority leader in a higher term, completed before the target invocation under an unchanged configuration, independently establishes that A is a former leader for this history. Therefore a subsequent completed VerifyLeader on A must not return nil. This is a necessary public authority-confirmation condition, not an equivalence with communication count or a demand for eventual completion. Suffrage declarations distinguish election/commitment voters from nonvoters; callback registration asymmetry motivates but does not define this obligation.\",\n        \"applicability\": \"Four actual Raft instances; stable three-voter/one-nonvoter configuration produced by public APIs; partition {A,D}/{B,C}; no membership changes or manual restore during the measured interval. Target verification occurs strictly after B or C completes a uniquely identified command in a higher term.\",\n        \"unresolved\": [\n          \"Does not establish every deployment schedule, consensus log divergence, or a stale application read.\",\n          \"Specific cause beyond the mapped nonvoter callback route is not isolated by a separate counterfactual run.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"A lease expiry or negative/higher-term response can cause nonnil verification; these workers remain active.\",\n          \"Before the majority completes the command, an old local leader state alone does not establish this antecedent.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"invoked\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"C-verify-after-majority\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"verify_result\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"history\",\n        \"operation\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For the admitted post-majority verification operation, a completed result must not report successful current leadership.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The measured endpoint is VerifyLeader error status; FSM counts are supplementary raw observations and not the oracle.\",\n    \"No claim of global correctness from a passing scenario; no claim of a consensus-safety violation from a failing API comparison.\"\n  ]\n}package raft\n\nimport (\n \"encoding/json\"\n \"fmt\"\n \"sync\"\n \"testing\"\n \"time\"\n\n \"github.com/hashicorp/go-hclog\"\n)\n\n// Transport faults affect delivery only. All successful replies come from real Raft handlers.\ntype assuranceTransport struct {\n *InmemTransport\n mu sync.Mutex\n blocked map[ServerID]bool\n failed map[string]int\n epoch uint64\n}\nfunc (x *assuranceTransport) AppendEntriesPipeline(id ServerID, addr ServerAddress) (AppendPipeline, error) {\n return nil, ErrPipelineReplicationNotSupported\n}\nfunc (x *assuranceTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n kind := \"append\"\n if req.PrevLogEntry == 0 && req.PrevLogTerm == 0 && len(req.Entries) == 0 && req.LeaderCommitIndex == 0 { kind = \"heartbeat\" }\n x.mu.Lock()\n epoch := x.epoch\n blocked := x.blocked[id]\n if blocked { x.failed[string(id)+\"/\"+kind]++ }\n x.mu.Unlock()\n if blocked { return fmt.Errorf(\"controlled partition to %s\", id) }\n err := x.InmemTransport.AppendEntries(id, addr, req, resp)\n x.mu.Lock()\n changed := epoch != x.epoch && x.blocked[id]\n x.mu.Unlock()\n if changed { return fmt.Errorf(\"partition crossed response delivery to %s\", id) }\n return err\n}\nfunc assuranceEvent(kind string, fields map[string]interface{}) {\n fields[\"event\"] = kind\n b, _ := json.Marshal(fields)\n fmt.Println(\"CA_EVENT \" + string(b))\n}\nfunc assuranceWait(t *testing.T, what string, limit time.Duration, predicate func() bool) {\n t.Helper()\n deadline := time.Now().Add(limit)\n for time.Now().Before(deadline) {\n  if predicate() { return }\n  time.Sleep(5*time.Millisecond)\n }\n t.Fatalf(\"prefix incomplete: %s\", what)\n}\nfunc assuranceError(t *testing.T, what string, f Future) error {\n t.Helper()\n done := make(chan error, 1)\n go func(){ done <- f.Error() }()\n select {\n case err := <-done: return err\n case <-time.After(8*time.Second): t.Fatalf(\"incomplete future: %s\", what); return fmt.Errorf(\"timeout\")\n }\n}\nfunc TestAssuranceVerifyNonvoterHistory(t *testing.T) {\n const history = \"verify-partition-1\"\n const op = \"verify-after-majority\"\n ids := []ServerID{\"A\", \"B\", \"C\", \"D\"}\n nodes := make([]*Raft, 4)\n stores := make([]*InmemStore, 4)\n fsms := make([]*MockFSM, 4)\n trans := make([]*assuranceTransport, 4)\n for i, id := range ids {\n  _, base := NewInmemTransportWithTimeout(ServerAddress(id), 100*time.Millisecond)\n  trans[i] = &assuranceTransport{InmemTransport:base, blocked:make(map[ServerID]bool), failed:make(map[string]int)}\n }\n for i := range trans { for j := range trans { if i != j { trans[i].Connect(ServerAddress(ids[j]), trans[j].InmemTransport) } } }\n defer func(){\n  for _, n := range nodes { if n != nil { n.Shutdown() } }\n  for _, n := range nodes { if n != nil { _ = n.Shutdown().Error() } }\n  for _, tr := range trans { _ = tr.Close() }\n }()\n for i,id := range ids {\n  conf := DefaultConfig()\n  conf.LocalID = id\n  conf.HeartbeatTimeout = 200*time.Millisecond\n  conf.ElectionTimeout = 200*time.Millisecond\n  conf.LeaderLeaseTimeout = 100*time.Millisecond\n  conf.CommitTimeout = 10*time.Millisecond\n  conf.Logger = hclog.NewNullLogger()\n  if i == 0 {\n   conf.HeartbeatTimeout = 2*time.Second\n   conf.ElectionTimeout = 2*time.Second\n   conf.LeaderLeaseTimeout = 2*time.Second\n  }\n  store := NewInmemStore()\n  stores[i] = store\n  fsms[i] = &MockFSM{}\n  n, err := NewRaft(conf, fsms[i], store, store, NewInmemSnapshotStore(), trans[i])\n  if err != nil { t.Fatal(err) }\n  nodes[i] = n\n }\n if err := assuranceError(t,\"bootstrap\",nodes[0].BootstrapCluster(Configuration{Servers:[]Server{{ID:\"A\",Address:\"A\",Suffrage:Voter}}})); err != nil {t.Fatal(err)}\n assuranceWait(t,\"A elected from single-voter bootstrap\",6*time.Second,func()bool{return nodes[0].State()==Leader})\n if err:=assuranceError(t,\"add D nonvoter\",nodes[0].AddNonvoter(\"D\",\"D\",0,time.Second));err!=nil{t.Fatal(err)}\n for _,id := range []ServerID{\"B\",\"C\"} {\n  if err:=assuranceError(t,\"add voter\",nodes[0].AddVoter(id,ServerAddress(id),0,time.Second));err!=nil{t.Fatal(err)}\n }\n prefix := nodes[0].Apply([]byte(\"prefix\"),time.Second)\n if err:=assuranceError(t,\"prefix apply\",prefix);err!=nil{t.Fatal(err)}\n for i := range nodes {\n  ii:=i\n  assuranceWait(t,\"configuration and prefix propagation\",3*time.Second,func()bool{\n   cf:=nodes[ii].GetConfiguration()\n   if cf.Error()!=nil{return false}\n   return len(cf.Configuration().Servers)==4 && len(fsms[ii].Logs())>=1\n  })\n }\n control:=nodes[0].VerifyLeader()\n if err:=assuranceError(t,\"connected verification\",control);err!=nil{t.Fatal(err)}\n cf := nodes[0].GetConfiguration()\n if err := cf.Error(); err != nil { t.Fatal(err) }\n voters, nonvoters := 0, 0\n for _, server := range cf.Configuration().Servers {\n  if server.Suffrage == Voter { voters++ } else if server.Suffrage == Nonvoter { nonvoters++ }\n  if (server.ID == \"D\") != (server.Suffrage == Nonvoter) { t.Fatal(\"unexpected suffrage\", server) }\n }\n if voters != 3 || nonvoters != 1 { t.Fatal(\"unexpected configuration\") }\n originalTerm := nodes[0].CurrentTerm()\n assuranceEvent(\"prefix\",map[string]interface{}{\"history\":history,\"leader\":\"A\",\"term\":nodes[0].CurrentTerm(),\"prefix_index\":prefix.Index(),\"control_ok\":true,\"voters\":voters,\"nonvoters\":nonvoters,\"operation\":op,\"configuration_index\":cf.Index()})\n // Split {A,D} from {B,C}. Disable existing and future cross-partition routes.\n for i := range trans {\n  for j := range trans {\n   if (i==0||i==3)!=(j==0||j==3) {\n    trans[i].mu.Lock();trans[i].epoch++;trans[i].blocked[ids[j]]=true;trans[i].mu.Unlock()\n    trans[i].Disconnect(ServerAddress(ids[j]))\n   }\n  }\n }\n // Each of A's two sequential workers must begin a failed post-partition RPC.\n // This proves its preceding pre-partition callback has already run.\n assuranceWait(t,\"old voter reply drain\",time.Second,func()bool{\n  trans[0].mu.Lock();defer trans[0].mu.Unlock()\n  return trans[0].failed[\"B/append\"]>0 && trans[0].failed[\"B/heartbeat\"]>0 && trans[0].failed[\"C/append\"]>0 && trans[0].failed[\"C/heartbeat\"]>0\n })\n trans[0].mu.Lock()\n drain := map[string]interface{}{\"history\":history,\"operation\":op,\"B_append\":trans[0].failed[\"B/append\"],\"B_heartbeat\":trans[0].failed[\"B/heartbeat\"],\"C_append\":trans[0].failed[\"C/append\"],\"C_heartbeat\":trans[0].failed[\"C/heartbeat\"],\"drained\":trans[0].failed[\"B/append\"]>0 && trans[0].failed[\"B/heartbeat\"]>0 && trans[0].failed[\"C/append\"]>0 && trans[0].failed[\"C/heartbeat\"]>0}\n trans[0].mu.Unlock()\n assuranceEvent(\"voter_callbacks_drained\",drain)\n next:=-1\n assuranceWait(t,\"majority election\",1500*time.Millisecond,func()bool{\n  for _,i:=range []int{1,2}{if nodes[i].State()==Leader{next=i;return true}}\n  return false\n })\n newWrite:=nodes[next].Apply([]byte(\"majority-after-partition\"),time.Second)\n if err:=assuranceError(t,\"majority apply\",newWrite);err!=nil{t.Fatal(err)}\n var committed Log\n if err := stores[next].GetLog(newWrite.Index(), &committed); err != nil { t.Fatal(err) }\n if string(committed.Data) != \"majority-after-partition\" { t.Fatal(\"wrong command identity\") }\n assuranceEvent(\"new_leader_apply\",map[string]interface{}{\"history\":history,\"leader\":ids[next],\"term\":nodes[next].CurrentTerm(),\"index\":newWrite.Index(),\"operation\":op,\"command\":string(committed.Data),\"entry_term\":committed.Term,\"original_term\":originalTerm,\"higher_term\":committed.Term>originalTerm,\"apply_ok\":true,\"old_state\":nodes[0].State().String(),\"old_fsm_count\":len(fsms[0].Logs()),\"new_fsm_count\":len(fsms[next].Logs())})\n assuranceEvent(\"verify_invoked\",map[string]interface{}{\"history\":history,\"operation\":op,\"node\":\"A\",\"new_leader\":ids[next],\"new_term\":nodes[next].CurrentTerm(),\"new_apply_index\":newWrite.Index(),\"higher_term\":committed.Term>originalTerm,\"old_term\":nodes[0].CurrentTerm(),\"old_state\":nodes[0].State().String()})\n f:=nodes[0].VerifyLeader()\n err:=assuranceError(t,\"target verification\",f)\n errText:=\"\";if err!=nil{errText=err.Error()}\n assuranceEvent(\"verify_result\",map[string]interface{}{\"history\":history,\"operation\":op,\"node\":\"A\",\"success\":err==nil,\"error\":errText,\"old_state\":nodes[0].State().String(),\"old_fsm_count\":len(fsms[0].Logs()),\"new_fsm_count\":len(fsms[next].Logs())})\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '138,197p' ../agent-source/config.go; sed -n '333,392p' ../agent-source/config.go; sed -n '897,907p' ../agent-source/api.go; python3 - <<'PY'\nimport json\ns=json.load(open('../direct-checks/5c7afc3e4a2b4bc6a22c86ae466b549c/plan.json'))\nprint(json.dumps({k:s[k] for k in ['monitors','observable_properties']},indent=2))\ns=json.load(open('../state.json'))\nfor c in s['checks']:\n if c['id']=='f3ad8013413542dd8759d95a1e2347b5':print(json.dumps({k:c[k] for k in ['status','outcome','checker_results','reason']},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '138,197p' ../agent-source/config.go; sed -n '333,392p' ../agent-source/config.go; sed -n '897,907p' ../agent-source/api.go; python3 - <<'PY'\nimport json\ns=json.load(open('../direct-checks/5c7afc3e4a2b4bc6a22c86ae466b549c/plan.json'))\nprint(json.dumps({k:s[k] for k in ['monitors','observable_properties']},indent=2))\ns=json.load(open('../state.json'))\nfor c in s['checks']:\n if c['id']=='f3ad8013413542dd8759d95a1e2347b5':print(json.dumps({k:c[k] for k in ['status','outcome','checker_results','reason']},indent=2))\nPY\"","aggregated_output":"type Config struct {\n\t// ProtocolVersion allows a Raft server to inter-operate with older\n\t// Raft servers running an older version of the code. This is used to\n\t// version the wire protocol as well as Raft-specific log entries that\n\t// the server uses when _speaking_ to other servers. There is currently\n\t// no auto-negotiation of versions so all servers must be manually\n\t// configured with compatible versions. See ProtocolVersionMin and\n\t// ProtocolVersionMax for the versions of the protocol that this server\n\t// can _understand_.\n\tProtocolVersion ProtocolVersion\n\n\t// HeartbeatTimeout specifies the time in follower state without contact\n\t// from a leader before we attempt an election.\n\tHeartbeatTimeout time.Duration\n\n\t// ElectionTimeout specifies the time in candidate state without contact\n\t// from a leader before we attempt an election.\n\tElectionTimeout time.Duration\n\n\t// CommitTimeout specifies the time without an Apply operation before the\n\t// leader sends an AppendEntry RPC to followers, to ensure a timely commit of\n\t// log entries.\n\t// Due to random staggering, may be delayed as much as 2x this value.\n\tCommitTimeout time.Duration\n\n\t// MaxAppendEntries controls the maximum number of append entries\n\t// to send at once. We want to strike a balance between efficiency\n\t// and avoiding waste if the follower is going to reject because of\n\t// an inconsistent log.\n\tMaxAppendEntries int\n\n\t// BatchApplyCh indicates whether we should buffer applyCh\n\t// to size MaxAppendEntries. This enables batch log commitment,\n\t// but breaks the timeout guarantee on Apply. Specifically,\n\t// a log can be added to the applyCh buffer but not actually be\n\t// processed until after the specified timeout.\n\tBatchApplyCh bool\n\n\t// If we are a member of a cluster, and RemovePeer is invoked for the\n\t// local node, then we forget all peers and transition into the follower state.\n\t// If ShutdownOnRemove is set, we additional shutdown Raft. Otherwise,\n\t// we can become a leader of a cluster containing only this node.\n\tShutdownOnRemove bool\n\n\t// TrailingLogs controls how many logs we leave after a snapshot. This is used\n\t// so that we can quickly replay logs on a follower instead of being forced to\n\t// send an entire snapshot. The value passed here is the initial setting used.\n\t// This can be tuned during operation using ReloadConfig.\n\tTrailingLogs uint64\n\n\t// SnapshotInterval controls how often we check if we should perform a\n\t// snapshot. We randomly stagger between this value and 2x this value to avoid\n\t// the entire cluster from performing a snapshot at once. The value passed\n\t// here is the initial setting used. This can be tuned during operation using\n\t// ReloadConfig.\n\tSnapshotInterval time.Duration\n\n\t// SnapshotThreshold controls how many outstanding logs there must be before\n\t// we perform a snapshot. This is to prevent excessive snapshotting by\n\t// replaying a small set of logs instead. The value passed here is the initial\nfunc ValidateConfig(config *Config) error {\n\t// We don't actually support running as 0 in the library any more, but\n\t// we do understand it.\n\tprotocolMin := ProtocolVersionMin\n\tif protocolMin == 0 {\n\t\tprotocolMin = 1\n\t}\n\tif config.ProtocolVersion < protocolMin ||\n\t\tconfig.ProtocolVersion > ProtocolVersionMax {\n\t\treturn fmt.Errorf(\"ProtocolVersion %d must be >= %d and <= %d\",\n\t\t\tconfig.ProtocolVersion, protocolMin, ProtocolVersionMax)\n\t}\n\tif len(config.LocalID) == 0 {\n\t\treturn fmt.Errorf(\"LocalID cannot be empty\")\n\t}\n\tif config.HeartbeatTimeout < 5*time.Millisecond {\n\t\treturn fmt.Errorf(\"HeartbeatTimeout is too low\")\n\t}\n\tif config.ElectionTimeout < 5*time.Millisecond {\n\t\treturn fmt.Errorf(\"ElectionTimeout is too low\")\n\t}\n\tif config.CommitTimeout < time.Millisecond {\n\t\treturn fmt.Errorf(\"CommitTimeout is too low\")\n\t}\n\tif config.MaxAppendEntries <= 0 {\n\t\treturn fmt.Errorf(\"MaxAppendEntries must be positive\")\n\t}\n\tif config.MaxAppendEntries > 1024 {\n\t\treturn fmt.Errorf(\"MaxAppendEntries is too large\")\n\t}\n\tif config.SnapshotInterval < 5*time.Millisecond {\n\t\treturn fmt.Errorf(\"SnapshotInterval is too low\")\n\t}\n\tif config.LeaderLeaseTimeout < 5*time.Millisecond {\n\t\treturn fmt.Errorf(\"LeaderLeaseTimeout is too low\")\n\t}\n\tif config.LeaderLeaseTimeout > config.HeartbeatTimeout {\n\t\treturn fmt.Errorf(\"LeaderLeaseTimeout (%s) cannot be larger than heartbeat timeout (%s)\", config.LeaderLeaseTimeout, config.HeartbeatTimeout)\n\t}\n\tif config.ElectionTimeout < config.HeartbeatTimeout {\n\t\treturn fmt.Errorf(\"ElectionTimeout (%s) must be equal or greater than Heartbeat Timeout (%s)\", config.ElectionTimeout, config.HeartbeatTimeout)\n\t}\n\treturn nil\n}\nfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n\tconfigReq := &configurationsFuture{}\n\tconfigReq.init()\n\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n\tconfigReq.respond(nil)\n\treturn configReq\n}\n\n// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n//\n// Deprecated: Use AddVoter/AddNonvoter instead.\n{\n  \"monitors\": [\n    {\n      \"id\": \"M-verify-result\",\n      \"checker_id\": \"C-verify-after-majority\",\n      \"event\": \"verify_result\",\n      \"binding_ids\": [\n        \"BIND-verify-registration\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-verify-start\",\n          \"S-verify-count\",\n          \"S-verify-consume\",\n          \"S-notify\",\n          \"S-heartbeat\",\n          \"S-peers\",\n          \"S-lease\",\n          \"S-election\",\n          \"S-consume\",\n          \"S-fsm-rest\"\n        ],\n        \"expectation_ids\": [\n          \"S-verify-api\",\n          \"S-suffrage\",\n          \"S-api\"\n        ],\n        \"binding_ids\": [\n          \"BIND-verify-registration\"\n        ],\n        \"derivation\": \"VerifyLeader is documented to ensure the peer is still leader and to prevent stale FSM data after leadership loss. A successful command Apply on a different voter-majority leader in a higher term, completed before the target invocation under an unchanged configuration, independently establishes that A is a former leader for this history. Therefore a subsequent completed VerifyLeader on A must not return nil. This is a necessary public authority-confirmation condition, not an equivalence with communication count or a demand for eventual completion. Suffrage declarations distinguish election/commitment voters from nonvoters; callback registration asymmetry motivates but does not define this obligation.\",\n        \"applicability\": \"Four actual Raft instances; stable three-voter/one-nonvoter configuration produced by public APIs; partition {A,D}/{B,C}; no membership changes or manual restore during the measured interval. Target verification occurs strictly after B or C completes a uniquely identified command in a higher term.\",\n        \"unresolved\": [\n          \"Does not establish every deployment schedule, consensus log divergence, or a stale application read.\",\n          \"Specific cause beyond the mapped nonvoter callback route is not isolated by a separate counterfactual run.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"A lease expiry or negative/higher-term response can cause nonnil verification; these workers remain active.\",\n          \"Before the majority completes the command, an old local leader state alone does not establish this antecedent.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"invoked\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"C-verify-after-majority\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"verify_result\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"history\",\n        \"operation\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For the admitted post-majority verification operation, a completed result must not report successful current leadership.\"\n    }\n  ]\n}\n{\n  \"status\": \"completed\",\n  \"outcome\": \"tests_passed\",\n  \"checker_results\": [\n    {\n      \"invariant\": \"C-verify-after-majority\",\n      \"claim_id\": \"O-verify-after-majority\",\n      \"scope\": {\n        \"description\": \"Public VerifyLeader completion after observed higher-term voter-majority progress; endpoint is API success/error, not global consensus safety.\",\n        \"assumptions\": [\n          \"Crash-free processes and functioning in-memory stores/FSMs\",\n          \"Validated heterogeneous election/lease timeouts\",\n          \"Delivery-only transport partition; optional pipelining unsupported\",\n          \"No further configuration or restore operation after prefix\"\n        ],\n        \"excluded\": [\n          \"Eventual response under arbitrary scheduling\",\n          \"Application read linearizability or conflicting committed logs\",\n          \"Generic pipeline correctness and stable storage crash faults\"\n        ],\n        \"parameters\": {}\n      },\n      \"outcome\": \"violated\",\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\"\n    }\n  ],\n  \"reason\": \"\"\n}\n","exit_code":0,"status":"completed"}}
