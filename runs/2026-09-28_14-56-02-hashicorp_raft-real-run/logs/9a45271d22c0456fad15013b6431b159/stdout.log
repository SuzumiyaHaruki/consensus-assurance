ture{AppendFuture:f,observer:p.observer}\n p.futures[f]=v\n return v\n}\nfunc (p *assuranceOrderPipeline) AppendEntries(req *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture,error) {\n f,err:=p.AppendPipeline.AppendEntries(req,resp)\n if err\"'!=nil{return nil,err}\n return p.wrap(f),nil\n}\nfunc (p *assuranceOrderPipeline) Consumer() <-chan AppendFuture {return p.output}\nfunc (p *assuranceOrderPipeline) Close() error {\n p.once.Do(func(){close(p.stop)})\n return p.AppendPipeline.Close()\n}\ntype assuranceOrderTransport struct { *InmemTransport; observer *assuranceOrderObserver }\nfunc (t *assuranceOrderTransport) AppendEntriesPipeline(id ServerID, addr ServerAddress) (AppendPipeline,error) {\n inner,err:=t.InmemTransport.AppendEntriesPipeline(id,addr)\n if err!=nil{return nil,err}\n p:=&assuranceOrderPipeline{AppendPipeline:inner,observer:t.observer,futures:make(map[AppendFuture]*assuranceOrderFuture),output:make(chan AppendFuture),stop:make(chan struct{})}\n go func(){\n  for {\n   select {\n   case f:=<-inner.Consumer():\n    wrapped:=p.wrap(f)\n    select {case p.output<-wrapped:case <-p.stop:return}\n   case <-p.stop:return\n   }\n  }\n }()\n return p,nil\n}\nfunc assuranceOrderWait(t *testing.T, label string, f Future) {\n t.Helper()\n ch:=make(chan error,1)\n go func(){ch<-f.Error()}()\n select{case err:=<-ch:if err!=nil{t.Fatal(label,err)};case <-time.After(5*time.Second):t.Fatal(\"incomplete\",label)}\n}\nfunc TestAssurancePipelineResponseOrder(t *testing.T) {\n observer:=&assuranceOrderObserver{done:make(chan struct{})}\n nodes:=make([]*Raft,2)\n transports:=make([]*assuranceOrderTransport,2)\n for i:=range nodes{\n  addr:=ServerAddress(fmt.Sprintf(\"P%d\",i))\n  _,base:=NewInmemTransportWithTimeout(addr,200*time.Millisecond)\n  transports[i]=&assuranceOrderTransport{InmemTransport:base,observer:observer}\n }\n transports[0].Connect(\"P1\",transports[1].InmemTransport)\n transports[1].Connect(\"P0\",transports[0].InmemTransport)\n defer func(){\n  for _,n:=range nodes{if n!=nil{n.Shutdown()}}\n  for _,n:=range nodes{if n!=nil{_ = n.Shutdown().Error()}}\n  for _,tr:=range transports{_ = tr.Close()}\n }()\n for i:=range nodes{\n  conf:=DefaultConfig()\n  conf.LocalID=ServerID(fmt.Sprintf(\"P%d\",i))\n  conf.HeartbeatTimeout=200*time.Millisecond\n  conf.ElectionTimeout=200*time.Millisecond\n  conf.LeaderLeaseTimeout=100*time.Millisecond\n  conf.CommitTimeout=10*time.Millisecond\n  conf.Logger=hclog.NewNullLogger()\n  store:=NewInmemStore()\n  n,err:=NewRaft(conf,&MockFSM{},store,store,NewInmemSnapshotStore(),transports[i])\n  if err!=nil{t.Fatal(err)}\n  nodes[i]=n\n }\n assuranceOrderWait(t,\"bootstrap\",nodes[0].BootstrapCluster(Configuration{Servers:[]Server{{ID:\"P0\",Address:\"P0\",Suffrage:Voter}}}))\n deadline:=time.Now().Add(3*time.Second)\n for nodes[0].State()!=Leader && time.Now().Before(deadline){time.Sleep(5*time.Millisecond)}\n if nodes[0].State()!=Leader{t.Fatal(\"prefix incomplete: election\")}\n assuranceOrderWait(t,\"add voter\",nodes[0].AddVoter(\"P1\",\"P1\",0,time.Second))\n assuranceOrderWait(t,\"apply\",nodes[0].Apply([]byte(\"pipeline-live-command\"),time.Second))\n select{case <-observer.done:case <-time.After(3*time.Second):t.Fatal(\"incomplete: no actual Response call\")}\n assuranceOrderEvent(\"driver_complete\",map[string]interface{}{\"apply_completed\":true})\n}\nGO'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > make_pipeline_check.py <<'PY'\nimport json\nfrom pathlib import Path\nr=json.load(open('../research.json'));m=json.load(open(r['audit_spec_path']))\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n for k in ['established_by','consumed_by']:f.pop(k,None)\nm['version']=r['audit_spec_version']\nm['facts'].append(dict(id='F-pipeline-ready',meaning='A concrete transport pipeline completed an AppendFuture with an error status and published that future on Consumer. Publication establishes readiness, not successful RPC status.',identity={'future':'AppendFuture object','request':'associated AppendEntriesRequest','context':'one transport pipeline'},validity_context='Network or in-memory transport publication after future.respond; the Response interface still requires Error to return first',representation=['Consumer channel delivery'],durability='Volatile future and delivery',recovery='No replay of pending future after pipeline closure',source_ids=['S-net-pipeline','S-inmem-pipeline','S-pipeline-contract','S-future-complete'],unknowns=['This fact does not establish whether any particular published RPC succeeded.']))\nfor b in m['behaviors']:\n if b['id']=='B-pipeline-producer':b.setdefault('produces_fact_ids',[]).append('F-pipeline-ready')\n if b['id']=='B-pipeline':b.setdefault('consumes_fact_ids',[]).append('F-pipeline-ready')\nchanges={i:dict(impact='dependency',source_ids=['S-pipeline','S-net-pipeline','S-inmem-pipeline','S-pipeline-contract','S-future-complete'],rationale='Add the explicit completed-future publication assertion between transport producer and pipeline consumer, distinct from successful replication support.',preserves='The existing VerifyLeader question, prefix and checker disabled pipelining and rely on ordinary/heartbeat workers. This dependency does not alter its configuration, identity, callback drain or observed API result. Existing pipeline match meaning also remains conditional on the decoder fields.') for i in ['B-pipeline-producer','B-pipeline']}\nq=dict(question='Does the actual pipeline decoder call AppendFuture.Response before that same future Error method has returned, despite the interface access precondition?',importance='Pipeline responses supply support to commitment advancement. Ignoring the documented future-access discipline can break custom transport integrations or bypass error interpretation. This check concerns the local interface contract, not proof of invalid quorum support or log divergence.',source_ids=[],participants=['Raft leader pipeline decoder','In-memory pipeline producer','Two live Raft nodes'],objects=['AppendFuture','AppendEntriesRequest/Response','Consumer channel'],contexts=['Healthy two-voter cluster built through public bootstrap and AddVoter','Real in-memory pipeline futures with observational forwarding wrappers'],event_paths=['Actual ordinary replication enables pipeline mode','In-memory RPC decoder completes and publishes a correlated future','Raft pipelineDecode invokes Response; wrapper records whether Error previously returned on the same wrapper'],activity_classes=['A1'],behavior_ids=['B-pipeline-producer','B-pipeline'],fact_ids=['F-pipeline-ready'],supporting_behavior_ids={'B-commit':'Pipeline responses can become counted replication support; this consequence is not the checked endpoint','B-generation':'Real elected leader owns pipeline generation'},obligation_relation_kind='consumption',counterevidence=['Built-in pipelines complete before publishing, so readiness timing alone is protected.','appendFuture.Response merely returns its pointer; an out-of-order access need not fail or corrupt support in this implementation.','The interface nevertheless explicitly requires Error to return before Response; the check does not invent a stronger response-success condition.'],unknowns=['Formal execution and correspondence review are pending.','Custom transport failure behavior and invalid commit consequences are not established.'],priority=1,trigger_rationale='The mapped decoder calls ready.Request and ready.Response without invoking ready.Error; interface documentation independently requires Error completion. An actual producer with forwarding method instrumentation can discriminate call order without altering responses or protocol state.',preferred_check='direct_test',disposition='ready_for_check')\nbs={x['id']:x for x in m['behaviors']};fs={x['id']:x for x in m['facts']}\nq['source_ids']=list(dict.fromkeys(z for i in q['behavior_ids']+list(q['supporting_behavior_ids']) for z in bs[i]['source_ids']))\nq['source_ids']=list(dict.fromkeys(q['source_ids']+fs['F-pipeline-ready']['source_ids']))\ncid='O-pipeline-response-order';bid='BIND-pipeline-consume'\ng=dict(source_ids=['S-pipeline','S-net-pipeline','S-inmem-pipeline','S-future-complete','S-append-future'],expectation_ids=['S-pipeline-contract'],binding_ids=[bid],derivation='AppendFuture.Response explicitly must only be called after Error returns. The selected necessary ordering condition is Error-return precedes Response invocation for the same future, irrespective of whether concrete publication already implies readiness. This checks that literal interface responsibility and does not assert that Error nil is sufficient for consensus support.',applicability='Actual pipelineDecode consumes actual in-memory transport futures. Observation wraps and delegates all methods without pre-calling Error, rewriting fields or changing the RPC outcome.',unresolved=['No custom transport malfunction or incorrect commit index is inferred.'],conflicts=[],alternatives=['Built-in respond-before-publish ordering avoids a pending-response race but is not the documented Error-method return precondition.'])\nclaim=dict(id=cid,kind='obligation',concern='implementation_semantics',description='For the same AppendFuture consumed by pipelineDecode, Error must have returned before Response is invoked.',source_ids=['S-pipeline-contract'],scope=dict(description='Local documented AppendFuture method ordering in actual in-memory pipeline consumption.',assumptions=['Healthy live two-node Raft prefix','Observation wrappers faithfully delegate the same future','Only the first actual Response invocation is selected independently of observed ordering'],excluded=['Invalid response data or commit index','Application failure or consensus safety','Other future implementations and fault schedules']),pending=['Formal call-order observation and correspondence review'],grounding=g)\nbinding=dict(id=bid,material_id='S-pipeline',symbol='pipelineDecode',start_line=534,end_line=566,description='Decoder retrieves future Request and Response directly before interpreting response term/success.',pending=[],associations=[dict(claim_id=cid,source_ids=['S-pipeline-contract','S-pipeline'],rationale='The documented method precondition applies to the concrete Response call at this decoder site.')])\ndef eq(k,v):return dict(field=k,op='eq',value=v)\nleg=dict(source_ids=['S-startup','S-bootstrap','S-config-append','S-inmem-init','S-inmem-pipeline','S-replicate-loop','S-pipeline','S-append-future'],expectation_ids=['S-pipeline-contract'],binding_ids=[bid],derivation='Public bootstrap and AddVoter establish the elected leader and two-voter cluster, then public Apply completes. Embedded InmemTransport generates actual replies and futures; pipeline wrappers map each underlying future to one wrapper and forward Consumer in order. Error delegates then atomically records return. Response snapshots that per-object observation at entry, delegates the actual getter, then emits the result. A global CAS selects the first Response independently of its observed ordering; no success/error field or protocol state is changed.',applicability='No faults or direct protocol assignments; same future identity is maintained on both AppendEntries return and Consumer. The wrapper introduces only finite for