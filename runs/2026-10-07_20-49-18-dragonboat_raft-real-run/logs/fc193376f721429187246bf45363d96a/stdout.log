reply_contexts\\\":\\\"202/2002\\\",\\\"reply_count\\\":1,\\\"request_node\\\":3,\\\"run\\\":\\\"remote-prefix-loss\\\",\\\"term\\\":2}\\n\"}\n{\"Time\":\"2026-10-07T21:02:07.236734453+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadPrefixContext\",\"Output\":\"--- PASS: TestAssuranceRemoteReadPrefixContext (0.00s)\\n\"}\n{\"Time\":\"2026-10-07T21:02:07.236742949+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadPrefixContext\",\"Elapsed\":0}\n{\"Time\":\"2026-10-07T21:02:07.236895563+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-07T21:02:07.237935057+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Output\":\"ok  \\tgithub.com/lni/dragonboat/v3/internal/raft\\t0.009s\\n\"}\n{\"Time\":\"2026-10-07T21:02:07.237957574+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Elapsed\":0.01}\n     1\tpackage raft\n     2\t\n     3\timport (\n     4\t \"encoding/json\"\n     5\t \"fmt\"\n     6\t \"strings\"\n     7\t \"testing\"\n     8\t\n     9\t \"github.com/lni/dragonboat/v3/config\"\n    10\t pb \"github.com/lni/dragonboat/v3/raftpb\"\n    11\t)\n    12\t\n    13\tfunc TestAssuranceRemoteReadPrefixContext(t *testing.T) {\n    14\t const run = \"remote-prefix-loss\"\n    15\t emit := func(v map[string]interface{}) {\n    16\t  v[\"run\"] = run\n    17\t  b, err := json.Marshal(v)\n    18\t  if err != nil { t.Fatal(err) }\n    19\t  fmt.Println(\"CA_EVENT \" + string(b))\n    20\t }\n    21\t contextText := func(c pb.SystemCtx) string { return fmt.Sprintf(\"%d/%d\", c.Low, c.High) }\n    22\t type participant struct {\n    23\t  p *Peer\n    24\t  db *TestLogDB\n    25\t  applied uint64\n    26\t  ready []pb.ReadyToRead\n    27\t }\n    28\t nodes := make(map[uint64]*participant)\n    29\t addresses := []PeerAddress{{NodeID:1, Address:\"n1:1234\"}, {NodeID:2, Address:\"n2:1234\"}, {NodeID:3, Address:\"n3:1234\"}}\n    30\t for id := uint64(1); id <= 3; id++ {\n    31\t  db := NewTestLogDB().(*TestLogDB)\n    32\t  cfg := config.Config{ClusterID:1, NodeID:id, ElectionRTT:10, HeartbeatRTT:1, CheckQuorum:true}\n    33\t  p := Launch(cfg, db, nil, append([]PeerAddress(nil), addresses...), true, true)\n    34\t  nodes[id] = &participant{p:p, db:db}\n    35\t }\n    36\t // The synchronous driver owns all participants and observations. Each update\n    37\t // is saved and applied before messages are delivered; no crash is injected.\n    38\t collect := func(id uint64) []pb.Message {\n    39\t  n := nodes[id]\n    40\t  ud := n.p.GetUpdate(true, n.applied)\n    41\t  if !pb.IsEmptySnapshot(ud.Snapshot) { t.Fatal(\"unexpected snapshot\") }\n    42\t  if err := n.db.Append(ud.EntriesToSave); err != nil { t.Fatal(err) }\n    43\t  if !pb.IsEmptyState(ud.State) { n.db.SetState(ud.State) }\n    44\t  for _, e := range ud.CommittedEntries {\n    45\t   if e.Index != n.applied+1 { t.Fatalf(\"noncontiguous application %d after %d\", e.Index, n.applied) }\n    46\t   if e.Type == pb.ConfigChangeEntry {\n    47\t    var cc pb.ConfigChange\n    48\t    if err := cc.Unmarshal(e.Cmd); err != nil { t.Fatal(err) }\n    49\t    n.p.ApplyConfigChange(cc)\n    50\t   } else if !e.IsEmpty() { t.Fatal(\"unexpected application command\") }\n    51\t   n.applied = e.Index\n    52\t  }\n    53\t  out := append([]pb.Message(nil), ud.Messages...)\n    54\t  n.ready = append(n.ready, ud.ReadyToReads...)\n    55\t  n.p.Commit(ud)\n    56\t  n.p.NotifyRaftLastApplied(n.applied)\n    57\t  return out\n    58\t }\n    59\t for id := uint64(1); id <= 3; id++ {\n    60\t  if len(collect(id)) != 0 { t.Fatal(\"unexpected bootstrap messages\") }\n    61\t }\n    62\t first := pb.SystemCtx{Low:101, High:1001}\n    63\t second := pb.SystemCtx{Low:202, High:2002}\n    64\t requested := map[uint64]pb.SystemCtx{2:first, 3:second}\n    65\t captured := make(map[uint64]pb.SystemCtx)\n    66\t released := make(map[uint64]bool)\n    67\t replies := make(map[uint64][]pb.Message)\n    68\t phase := \"setup\"\n    69\t dropped := 0\n    70\t delivered := 0\n    71\t pump := func(initial []pb.Message) {\n    72\t  queue := append([]pb.Message(nil), initial...)\n    73\t  for len(queue) != 0 {\n    74\t   if delivered > 1000 { t.Fatal(\"driver message bound reached\") }\n    75\t   m := queue[0]\n    76\t   queue = queue[1:]\n    77\t   // Fixed loss policy: all leader heartbeats carrying the first context\n    78\t   // are discarded. Remaining messages keep generation order.\n    79\t   if m.Type == pb.Heartbeat && m.From == 1 && m.Hint == first.Low && m.HintHigh == first.High {\n    80\t    dropped++\n    81\t    emit(map[string]interface{}{\"event\":\"dropped\", \"from\":m.From, \"to\":m.To, \"context\":contextText(first)})\n    82\t    continue\n    83\t   }\n    84\t   n, ok := nodes[m.To]\n    85\t   if !ok { t.Fatal(\"unknown destination\") }\n    86\t   before := make(map[pb.SystemCtx]readStatus)\n    87\t   if phase == \"second\" && m.To == 1 && m.Type == pb.HeartbeatResp {\n    88\t    for c, s := range n.p.raft.readIndex.pending { before[c] = *s }\n    89\t   }\n    90\t   if m.Type == pb.ReadIndexResp { replies[m.To] = append(replies[m.To], m) }\n    91\t   n.p.Handle(m)\n    92\t   delivered++\n    93\t   if len(before) != 0 {\n    94\t    for _, origin := range []uint64{2,3} {\n    95\t     c, found := captured[origin]\n    96\t     old, wasPending := before[c]\n    97\t     _, stillPending := n.p.raft.readIndex.pending[c]\n    98\t     if found && wasPending && !stillPending {\n    99\t      if old.from != origin || old.ctx != c || n.p.raft.state != leader || m.Term != n.p.raft.term { t.Fatal(\"invalid release premise\") }\n   100\t      released[origin] = true\n   101\t      emit(map[string]interface{}{\"event\":\"released\", \"operation\":fmt.Sprintf(\"read-on-%d\",origin), \"request_node\":origin, \"expected_context\":contextText(old.ctx), \"term\":n.p.raft.term, \"reply_from\":m.From, \"confirmation_context\":contextText(pb.SystemCtx{Low:m.Hint,High:m.HintHigh}), \"policy\":\"drop-first-heartbeats\", \"prefix_size\":len(before), \"current_term_committed\":n.p.raft.hasCommittedEntryAtCurrentTerm()})\n   102\t     }\n   103\t    }\n   104\t   }\n   105\t   queue = append(queue, collect(m.To)...)\n   106\t  }\n   107\t }\n   108\t // Acquire authority through the public tick entry and real vote messages.\n   109\t for i:=0; i<30 && nodes[1].p.raft.state != leader; i++ {\n   110\t  nodes[1].p.Tick()\n   111\t  pump(collect(1))\n   112\t }\n   113\t if nodes[1].p.raft.state != leader || !nodes[1].p.raft.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"leader/current-term commitment not reached\") }\n   114\t term := nodes[1].p.raft.term\n   115\t for id:=uint64(1); id<=3; id++ {\n   116\t  if nodes[id].applied != nodes[1].p.raft.log.committed || nodes[id].p.raft.term != term { t.Fatal(\"initial application/term not reached\") }\n   117\t }\n   118\t emit(map[string]interface{}{\"event\":\"setup\", \"term\":term, \"committed\":nodes[1].p.raft.log.committed, \"members\":3})\n   119\t for _, id := range []uint64{2,3} {\n   120\t  if id == 2 { phase=\"first\" } else { phase=\"second\" }\n   121\t  nodes[id].p.ReadIndex(requested[id])\n   122\t  // Capture leader admission before delivering any generated heartbeat.\n   123\t  forward := collect(id)\n   124\t  if len(forward)!=1 || forward[0].Type!=pb.ReadIndex || forward[0].To!=1 { t.Fatal(\"missing forwarded read\") }\n   125\t  nodes[1].p.Handle(forward[0])\n   126\t  s, ok := nodes[1].p.raft.readIndex.pending[requested[id]]\n   127\t  if !ok || s.from!=id || s.ctx!=requested[id] { t.Fatal(\"read not admitted\") }\n   128\t  captured[id]=s.ctx\n   129\t  emit(map[string]interface{}{\"event\":\"admitted\", \"operation\":fmt.Sprintf(\"read-on-%d\",id), \"request_node\":id, \"context\":contextText(s.ctx), \"index\":s.index})\n   130\t  pump(collect(1))\n   131\t }\n   132\t if dropped != 2 { t.Fatalf(\"expected first broadcast loss, got %d\",dropped) }\n   133\t if len(nodes[1].p.raft.readIndex.pending)!=0 || len(nodes[1].p.raft.readIndex.queue)!=0 { t.Fatal(\"prefix not fully released\") }\n   134\t for _, id := range []uint64{2,3} {\n   135\t  if !released[id] { t.Fatal(\"missing release\") }\n   136\t  wire := []string{}\n   137\t  for _, m := range replies[id] { wire=append(wire,contextText(pb.SystemCtx{Low:m.Hint,High:m.HintHigh})) }\n   138\t  ready := []string{}\n   139\t  for _, r := range nodes[id].ready { ready=append(ready,contextText(r.SystemCtx)) }\n   140\t  emit(map[string]interface{}{\"event\":\"result\", \"operation\":fmt.Sprintf(\"read-on-%d\",id), \"request_node\":id, \"policy\":\"drop-first-heartbeats\", \"completed\":true, \"reply_contexts\":strings.Join(wire,\",\"), \"reply_count\":len(wire), \"ready_contexts\":strings.Join(ready,\",\"), \"ready_count\":len(ready), \"term\":nodes[id].p.raft.term, \"applied\":nodes[id].applied})\n   141\t }\n   142\t // No workers or external resources exist. Every generated non-dropped\n   143\t // message has been dispatched and every update committed before results.\n   144\t}\n{\n  \"description\": \"Elect three bootstrapped Peers, persist/apply their setup, then admit remote reads from nodes 2 and 3. Drop first-context heartbeats before delivering the later context. Observe each released status and compare its original context against the full reply-context list emitted to that independent destination; record follower readiness as diagnostic.\",\n  \"claim_id\": \"C-read-context-preservation\",\n  \"binding_ids\": [\n    \"bind-read-publication\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./internal/raft\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"strings\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/lni/dragonboat/v3/config\\\"\\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\\n)\\n\\nfunc TestAssuranceRemoteReadPrefixContext(t *testing.T) {\\n const run = \\\"remote-prefix-loss\\\"\\n emit := func(v map[string]interface{}) {\\n  v[\\\"run\\\"] = run\\n  b, err := json.Marshal(v)\\n  if err != nil { t.Fatal(err) }\\n  fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n }\\n contextText := func(c pb.SystemCtx) string { return fmt.Sprintf(\\\"%d/%d\\\", c.Low, c.High) }\\n type participant struct {\\n  p *Peer\\n  db *TestLogDB\\n  applied uint64\\n  ready []pb.ReadyToRead\\n }\\n nodes := make(map[uint64]*participant)\\n addresses := []PeerAddress{{NodeID:1, Address:\\\"n1:1234\\\"}, {NodeID:2, Address:\\\"n2:1234\\\"}, {NodeID:3, Address:\\\"n3:1234\\\"}}\\n for id := uint64(1); id <= 3; id++ {\\n  db := NewTestLogDB().(*TestLogDB)\\n  cfg := config.Config{ClusterID:1, NodeID:id, ElectionRTT:10, HeartbeatRTT:1, CheckQuorum:true}\\n  p := Launch(cfg, db, nil, append([]PeerAddress(nil), addresses...), true, true)\\n  nodes[id] = &participant{p:p, db:db}\\n }\\n // The synchronous driver owns all participants and observations. Each update\\n // is saved and applied before messages are delivered; no crash is injected.\\n collect := func(id uint64) []pb.Message {\\n  n := nodes[id]\\n  ud := n.p.GetUpdate(true, n.applied)\\n  if !pb.IsEmptySnapshot(ud.Snapshot) { t.Fatal(\\\"unexpected snapshot\\\") }\\n  if err := n.db.Append(ud.EntriesToSave); err != nil { t.Fatal(err) }\\n  if !pb.IsEmptyState(ud.State) { n.db.SetState(ud.State) }\\n  for _, e := range ud.CommittedEntries {\\n   if e.Index != n.applied+1 { t.Fatalf(\\\"noncontiguous application %d after %d\\\", e.Index, n.applied) }\\n   if e.Type == pb.ConfigChangeEntry {\\n    var cc pb.ConfigChange\\n    if err := cc.Unmarshal(e.Cmd); err != nil { t.Fatal(err) }\\n    n.p.ApplyConfigChange(cc)\\n   } else if !e.IsEmpty() { t.Fatal(\\\"unexpected application command\\\") }\\n   n.applied = e.Index\\n  }\\n  out := append([]pb.Message(nil), ud.Messages...)\\n  n.ready = append(n.ready, ud.ReadyToReads...)\\n  n.p.Commit(ud)\\n  n.p.NotifyRaftLastApplied(n.applied)\\n  return out\\n }\\n for id := uint64(1); id <= 3; id++ {\\n  if len(collect(id)) != 0 { t.Fatal(\\\"unexpected bootstrap messages\\\") }\\n }\\n first := pb.SystemCtx{Low:101, High:1001}\\n second := pb.SystemCtx{Low:202, High:2002}\\n requested := map[uint64]pb.SystemCtx{2:first, 3:second}\\n captured := make(map[uint64]pb.SystemCtx)\\n released := make(map[uint64]bool)\\n replies := make(map[uint64][]pb.Message)\\n phase := \\\"setup\\\"\\n dropped := 0\\n delivered := 0\\n pump := func(initial []pb.Message) {\\n  queue := append([]pb.Message(nil), initial...)\\n  for len(queue) != 0 {\\n   if delivered > 1000 { t.Fatal(\\\"driver message bound reached\\\") }\\n   m := queue[0]\\n   queue = queue[1:]\\n   // Fixed loss policy: all leader heartbeats carrying the first context\\n   // are discarded. Remaining messages keep generation order.\\n   if m.Type == pb.Heartbeat && m.From == 1 && m.Hint == first.Low && m.HintHigh == first.High {\\n    dropped++\\n    emit(map[string]interface{}{\\\"event\\\":\\\"dropped\\\", \\\"from\\\":m.From, \\\"to\\\":m.To, \\\"context\\\":contextText(first)})\\n    continue\\n   }\\n   n, ok := nodes[m.To]\\n   if !ok { t.Fatal(\\\"unknown destination\\\") }\\n   before := make(map[pb.SystemCtx]readStatus)\\n   if phase == \\\"second\\\" && m.To == 1 && m.Type == pb.HeartbeatResp {\\n    for c, s := range n.p.raft.readIndex.pending { before[c] = *s }\\n   }\\n   if m.Type == pb.ReadIndexResp { replies[m.To] = append(replies[m.To], m) }\\n   n.p.Handle(m)\\n   delivered++\\n   if len(before) != 0 {\\n    for _, origin := range []uint64{2,3} {\\n     c, found := captured[origin]\\n     old, wasPending := before[c]\\n     _, stillPending := n.p.raft.readIndex.pending[c]\\n     if found && wasPending && !stillPending {\\n      if old.from != origin || old.ctx != c || n.p.raft.state != leader || m.Term != n.p.raft.term { t.Fatal(\\\"invalid release premise\\\") }\\n      released[origin] = true\\n      emit(map[string]interface{}{\\\"event\\\":\\\"released\\\", \\\"operation\\\":fmt.Sprintf(\\\"read-on-%d\\\",origin), \\\"request_node\\\":origin, \\\"expected_context\\\":contextText(old.ctx), \\\"term\\\":n.p.raft.term, \\\"reply_from\\\":m.From, \\\"confirmation_context\\\":contextText(pb.SystemCtx{Low:m.Hint,High:m.HintHigh}), \\\"policy\\\":\\\"drop-first-heartbeats\\\", \\\"prefix_size\\\":len(before), \\\"current_term_committed\\\":n.p.raft.hasCommittedEntryAtCurrentTerm()})\\n     }\\n    }\\n   }\\n   queue = append(queue, collect(m.To)...)\\n  }\\n }\\n // Acquire authority through the public tick entry and real vote messages.\\n for i:=0; i<30 && nodes[1].p.raft.state != leader; i++ {\\n  nodes[1].p.Tick()\\n  pump(collect(1))\\n }\\n if nodes[1].p.raft.state != leader || !nodes[1].p.raft.hasCommittedEntryAtCurrentTerm() { t.Fatal(\\\"leader/current-term commitment not reached\\\") }\\n term := nodes[1].p.raft.term\\n for id:=uint64(1); id<=3; id++ {\\n  if nodes[id].applied != nodes[1].p.raft.log.committed || nodes[id].p.raft.term != term { t.Fatal(\\\"initial application/term not reached\\\") }\\n }\\n emit(map[string]interface{}{\\\"event\\\":\\\"setup\\\", \\\"term\\\":term, \\\"committed\\\":nodes[1].p.raft.log.committed, \\\"members\\\":3})\\n for _, id := range []uint64{2,3} {\\n  if id == 2 { phase=\\\"first\\\" } else { phase=\\\"second\\\" }\\n  nodes[id].p.ReadIndex(requested[id])\\n  // Capture leader admission before delivering any generated heartbeat.\\n  forward := collect(id)\\n  if len(forward)!=1 || forward[0].Type!=pb.ReadIndex || forward[0].To!=1 { t.Fatal(\\\"missing forwarded read\\\") }\\n  nodes[1].p.Handle(forward[0])\\n  s, ok := nodes[1].p.raft.readIndex.pending[requested[id]]\\n  if !ok || s.from!=id || s.ctx!=requested[id] { t.Fatal(\\\"read not admitted\\\") }\\n  captured[id]=s.ctx\\n  emit(map[string]interface{}{\\\"event\\\":\\\"admitted\\\", \\\"operation\\\":fmt.Sprintf(\\\"read-on-%d\\\",id), \\\"request_node\\\":id, \\\"context\\\":contextText(s.ctx), \\\"index\\\":s.index})\\n  pump(collect(1))\\n }\\n if dropped != 2 { t.Fatalf(\\\"expected first broadcast loss, got %d\\\",dropped) }\\n if len(nodes[1].p.raft.readIndex.pending)!=0 || len(nodes[1].p.raft.readIndex.queue)!=0 { t.Fatal(\\\"prefix not fully released\\\") }\\n for _, id := range []uint64{2,3} {\\n  if !released[id] { t.Fatal(\\\"missing release\\\") }\\n  wire := []string{}\\n  for _, m := range replies[id] { wire=append(wire,contextText(pb.SystemCtx{Low:m.Hint,High:m.HintHigh})) }\\n  ready := []string{}\\n  for _, r := range nodes[id].ready { ready=append(ready,contextText(r.SystemCtx)) }\\n  emit(map[string]interface{}{\\\"event\\\":\\\"result\\\", \\\"operation\\\":fmt.Sprintf(\\\"read-on-%d\\\",id), \\\"request_node\\\":id, \\\"policy\\\":\\\"drop-first-heartbeats\\\", \\\"completed\\\":true, \\\"reply_contexts\\\":strings.Join(wire,\\\",\\\"), \\\"reply_count\\\":len(wire), \\\"ready_contexts\\\":strings.Join(ready,\\\",\\\"), \\\"ready_count\\\":len(ready), \\\"term\\\":nodes[id].p.raft.term, \\\"applied\\\":nodes[id].applied})\\n }\\n // No workers or external resources exist. Every generated non-dropped\\n // message has been dispatched and every update committed before results.\\n}\\n\",\n    \"description\": \"Deterministic single-threaded Peer driver using real Launch, Tick, Handle, ReadIndex, GetUpdate and Commit; existing TestLogDB stores updates.\",\n    \"semantic_changes\": [\n      \"No target changes. Substitute synchronous storage and message delivery with declared loss; apply bootstrap configuration and no-op entries only.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"release\",\n        \"event\": \"released\",\n        \"conditions\": [\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": \"drop-first-heartbeats\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"prefix_size\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"current_term_committed\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"src-peer-launch\",\n        \"src-launch-bootstrap\",\n        \"src-test-logdb\",\n        \"src-peer-update\",\n        \"src-authority-timers\",\n        \"src-term-election\",\n        \"src-peer-boundary\",\n        \"src-transport-loss\",\n        \"src-test-loss\",\n        \"src-message-finalize\",\n        \"src-delivery\"\n      ],\n      \"expectation_ids\": [\n        \"src-read-output-test\"\n      ],\n      \"binding_ids\": [],\n      \"derivation\": \"Launch bootstraps three nodes using real config entries. Tick initiates election; generated vote and replication messages acquire leadership and commit/apply the no-op. Driver saves each update into TestLogDB and applies only bootstrap configs/no-op before Peer.Commit and applied notification. No testOnly election override is used. Peer.ReadIndex generates forwarded messages. All first-context heartbeats are dropped under a declared loss policy; all other messages are delivered FIFO through Peer.Handle. Later authentic heartbeat responses release the prefix. No reordered same-link message, fabricated response, direct handler invocation, crash, asynchronous worker or deadline is used. Each read comes from a different recipient, making its output association independent of the context under comparison. Release is observed from before/after pending status in the actual handler dispatch.\",\n      \"applicability\": \"Single-threaded Raft package driver substitutes storage/transport/application boundaries for no-crash empty-command history; early replication is delayed until save, which is a permitted stronger ordering that does not eliminate overlapping read requests.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"A client endpoint is unnecessary to check wire-result identity; client timeout remains unmeasured.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-read-context\",\n      \"checker_id\": \"check-read-context\",\n      \"event\": \"result\",\n      \"binding_ids\": [\n        \"bind-read-publication\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"src-read-queue\",\n          \"src-read-reply\",\n          \"src-forward-read\",\n          \"src-peer-update\",\n          \"src-read-consumer\"\n        ],\n        \"expectation_ids\": [\n          \"src-prefix-test\",\n          \"src-read-output-test\"\n        ],\n        \"binding_ids\": [\n          \"bind-read-publication\"\n        ],\n        \"derivation\": \"C-read-context-preservation is tested by comparing the complete emitted context list for each distinct remote recipient with its context captured at actual leader admission. Distinct recipients independently associate each result with one operation; contexts themselves are not correlation keys.\",\n        \"applicability\": \"Released same-term prefix in stable three-voter membership with current-term commitment.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"policy\",\n          \"op\": \"eq\",\n          \"value\": \"drop-first-heartbeats\",\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"release\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"check-read-context\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"reply_contexts\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"release.expected_context\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"run\",\n        \"operation\",\n        \"request_node\"\n      ],\n      \"description\": \"Each released remote operation emits exactly its own context to its independently identified recipient; the complete singleton context serialization captures both identity and multiplicity.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Does not execute NodeHost pendingReadIndex or observe client timeout.\",\n    \"Stable authority/membership only; no crash or snapshot.\"\n  ]\n}","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The execution reproduced the mismatch: node 2’s admitted context was `101/1001`, but its reply and follower readiness carried node 3’s `202/2002`. Both requests were released in term 2 after commitment at index 4; node 3 received its own context correctly. The process exited normally. I’m recording the correspondence review with the client-timeout and wider safety consequences left unclaimed."}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\np=dict(action='review',artifact_id='2e210f3af48042e4a0603d11a5eed235',rationale='Review the fixed version-1 peer history, actual raw events and local identity oracle; distinguish the observed mismatch from unmeasured client progress.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=['src-read-api','src-prefix-test','src-read-output-test','src-read-queue','src-read-reply','src-forward-read','src-read-consumer','src-peer-launch','src-launch-bootstrap','src-test-logdb','src-peer-update','src-peer-boundary','src-message-finalize','src-term-election','src-authority-timers','src-transport-loss','src-delivery'],rationale='Reviewed fixed artifact 2e210f3af48042e4a0603d11a5eed235, its retained harness lines 28-59, 69-106 and 108-143, fixed plan and raw stdout for CheckRun 26ad6abcd0bc44fb845a278c177d2f63. Applicability: the accepted responsibility is per-request context/recipient preservation on actual quorum prefix release, grounded by prefix-confirmation identity expectations, safe-read context expectations and the exact-context consumer; no eventual deadline is inferred from the API. Launch and bootstrap create the three-voter configuration. The driver applies only the generated bootstrap configuration entries and empty no-op, saves actual updates in TestLogDB and calls Commit and NotifyRaftLastApplied. Tick plus authentic vote/replication messages establishes term-2 leadership and index-4 commitment; prerequisites are tested from actual state, not merely printed. No test-only election override or protocol-state injection is used. The two remote ReadIndex calls produce real forward messages, inspected at leader admission before heartbeat delivery. The declared policy discards both first-context heartbeats, then drains the second round in generation order. Loss is permitted by transport behavior; there is no same-link reordering. Delaying replication delivery until persistence strengthens only the setup ordering and leaves both read statuses concurrently pending. No crash or concurrent worker exists.\n\nRelease observation snapshots the pending statuses immediately before actual Peer.Handle of a heartbeat response, then observes their removal while the same-term leader remains active. Inspection of Handle, term processing and readIndex.confirm shows this same-term HeartbeatResp path removes the two statuses through quorum prefix release, not cancellation/reset. The statuses retain their original from/ctx, and these values are captured independently of the response being tested. Events 5 and 6 establish a two-element released prefix with current-term commitment. Identity fields run/operation/request_node correlate events 7 and 8 independently of context values; each distinct destination has exactly one admitted operation. The assertion compares the full decimal Low/High context representation from observed replies with release.expected_context. This is content equality, not merely type/count equality. Although serialization also detects extra reply multiplicity, the actual witness has one reply and is a pure context mismatch, so attribution does not depend on an extra exactly-once requirement. Policy applicability is fixed before observations. Release is an antecedent of this local responsibility; it is not the compared result repeated as a prerequisite.\n\nRaw events: setup committed=4, term=2; admitted node 2 context=101/1001 and node 3 context=202/2002. Both first-context heartbeats were dropped. Event 5 releases node 2 with expected_context=101/1001 on confirmation_context=202/2002; result event 7 records reply_count=1, reply_contexts=202/2002, ready_count=1, ready_contexts=202/2002, applied=4, term=2. Event 6/result 8 preserve node 3 context 202/2002. These match the controller correlations and one violating witness with no parse errors. Replies are copied from real generated messages and readiness from GetUpdate before Commit clears it. All state, copies and injection policy are owned by the synchronous test goroutine. Results follow full queue drain and update completion; completed=true denotes this finite driver endpoint, not NodeHost RequestCompleted. No wait, join, Close or asynchronous cleanup is omitted because the selected constructors create only synchronous peers and in-memory test storage. Exit code is zero; test success establishes execution completion only. The observed wrong context is directly explained by remote publication taking m.Hint/m.HintHigh rather than s.ctx; no inferred client timeout is needed to establish this local defect.',counterevidence=['The later request at node 3 receives the correct 202/2002 context in the same execution.','Local ready publication uses s.ctx, and existing sequential safe-read tests expect preserved context; this finding concerns earlier remote statuses in a released prefix.','Current-term commitment, membership response filtering and applied-index gating remain present; they do not repair the emitted identity.'],limitations=['Direct package-level no-crash execution with synchronous storage/application/transport substitutes; no NodeHost end-to-end client timeout measurement.','Stable membership and leadership only; no claim about membership-transition or crash variants.','Follower readiness is corroborating raw output; the formal checker compares reply context.','No cluster-wide linearizability or eventual-progress verdict is established.'],report_title='批量确认读取时，较早请求被回填为较晚请求的上下文',report_answer='受控执行中，节点 2 的请求上下文为 101/1001；较晚请求 202/2002 获得确认后，两者都被释放，但节点 2 的回复与可读通知均携带 202/2002。节点 3 的回复正确。该结果支持同一任期、稳定成员配置下的请求关联缺陷；未测量客户端超时或更广泛的一致性后果。')],feedback=dict(ref_ids=['26ad6abcd0bc44fb845a278c177d2f63','2e210f3af48042e4a0603d11a5eed235','51a7dd248e1c419c9107303d486e486a','B-read-publication','F-read-status','src-read-reply','src-read-consumer'],answered='The fixed legal peer history reaches concurrent remote admission and same-term prefix release. Node 2 receives 202/2002 for admitted context 101/1001, while node 3 receives its correct 202/2002. Both follower readiness records contain 202/2002. The process completes normally and the local correspondence review finds no issue with attributing the measured context mismatch to remote publication. The existing exact-context consumer cannot reinterpret the wrong context as node 2\\\\'s original batch; no client timeout measurement is claimed.',remaining=['Continue investigation on an independent unresolved relationship rather than rerunning this explained cause.','At the next related map update replace the answered publication unknown with the conditional source relationship; retain client endpoint and membership-transition limits.'],understanding='updated',question_updates={'51a7dd248e1c419c9107303d486e486a':dict(unknowns=[],resume_conditions=[])},rationale='This execution resolves the local identity discriminator. Broader consequences are independent scope limits, not missing prerequisites for the observed local mismatch.'))\njson.dump(p,open('submission-review.json','w'),indent=2)\nr=json.load(open('../research.json'));a=subprocess.run(r['validation']['command']+['submission-review.json'],text=True,capture_output=True);print(a.stdout);print(a.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
