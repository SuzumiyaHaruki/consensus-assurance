{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\nm=json.load(open('../audit-spec/v1.json'))\nsources=[]\ndef src(i,f,a,b,k='code_observation'):sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k))\nsrc('src-session-update','internal/rsm/statemachine.go',977,1043)\nsrc('src-session-record','internal/rsm/session.go',49,176)\nsrc('src-session-manager','internal/rsm/sessionmanager.go',25,146)\nsrc('src-session-lru','internal/rsm/lrusession.go',57,200)\nsrc('src-session-order-test','internal/rsm/lrusession_test.go',94,193,'test_expectation')\nsrc('src-session-checkpoint','internal/rsm/statemachine.go',607,635)\nsrc('src-apply-wakeup','internal/rsm/statemachine.go',547,593)\nsrc('src-apply-index','internal/rsm/statemachine.go',637,708)\nsrc('src-apply-dispatch','internal/rsm/statemachine.go',825,848)\nsrc('src-session-client-duty','client/session.go',116,154,'interface_statement')\nsrc('src-session-guarantee','nodehost.go',45,58,'document_statement')\nsrc('src-result-data-contract','statemachine/rsm.go',136,149,'interface_statement')\n# Leave controller-derived reverse indexes to the controller.\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None);f.pop('consumed_by',None)\nfor b in m['behaviors']:\n if b['id']=='B-read-publication':b['unknowns']=[]\n if b['id']=='B-client-read':b['unknowns']=[]\n if b['id']=='B-apply':\n  b['writes']=['Application processing advances internal applied state and publishes lastApplied at batch completion. Proposal/read callbacks depend on entry type and ignored/rejected branches.']\n  b['external_effects']=['StateMachine.Handle schedules node.StepReady after processing a task, even when individual entries skip ApplyUpdate; the subsequent node step reads lastApplied and calls pendingReadIndexes.applied.']\n  b['source_ids']+=['src-apply-wakeup','src-apply-index','src-apply-dispatch','src-session-update']\n  b['unknowns']=['Application-specific result buffer ownership and on-disk durability variants remain open.']\nnew=[dict(id='B-session-dedup',primary_activity='A5',execution_owner='RSM StateMachine under s.mu and SessionManager',protocol_context='Registered ClientID, proposal SeriesID, RespondedTo and applied log index',trigger='Committed session registration/unregistration and session-managed update entries',implementation_guards=['Unknown client rejected; already acknowledged series ignored; stored unacknowledged result replayed without user state update','Client ProposalCompleted increments serial/responded state and enforces expected sequence'],writes=['New application result recorded in session history; RespondedTo prunes acknowledged results; every processed update advances applied index'],external_effects=['Unacknowledged duplicate returns cached result; already-acknowledged duplicate is intentionally ignored'],cross_activity_effects={'A1':'Determines application effects of the committed history rather than selecting a new consensus decision','A7':'Implements documented at-most-once retry behavior subject to registered-session eligibility'},source_ids=['src-session-update','src-session-manager','src-session-record','src-session-client-duty','src-session-guarantee'],unknowns=['Ownership/immutability of Result.Data retained in history versus returned to callers is not explicit in the inspected Result contract.']),dict(id='B-session-checkpoint',primary_activity='A6',execution_owner='RSM snapshot metadata builder and locked LRU session store',protocol_context='Session IDs, acknowledged prefix, cached results and LRU eligibility order',trigger='getSSMeta builds Session buffer; SaveSessions serializes; LoadSessions restores',writes=['Snapshots preserve session history and traverse LRU-first order; successful lookup traversal restores the same final recency order','Load builds entries in serialized order and restores configured cache capacity'],important_branches=['Production getSSMeta supplies bytes.Buffer; arbitrary fallible writers are not the inspected production path','Snapshot tests require restored LRU order and matching future eviction behavior'],cross_activity_effects={'A5':'Restored sessions control whether later committed retries update, replay or reject','A2':'Recovery reconstructs participation history needed to consume committed operations consistently'},source_ids=['src-session-lru','src-session-record','src-session-manager','src-session-checkpoint','src-session-order-test'],unknowns=['Result.Data aliasing contract remains separate from successful serialization order.'])]\nm['behaviors']+=new\nfor a in m['activities']:\n if a['class_id']=='A5':\n  a['realization_summary']+=' Session-managed application rejects unknown clients, ignores acknowledged retries and replays cached results; batch completion schedules the node to consume updated application progress.'\n  a['source_ids']+=['src-session-update','src-session-manager','src-session-guarantee','src-apply-wakeup']\n if a['class_id']=='A6':\n  a['realization_summary']+=' Snapshot metadata serializes session histories and LRU order into an in-memory buffer for recovery.'\n  a['source_ids']+=['src-session-checkpoint','src-session-lru','src-session-order-test']\nfor s in m['surfaces']:\n if s['entry_point']=='raft.handleReadIndexLeaderConfirmation':s['reason']='When a later context releases a prefix, remote replies use the confirming message context for all statuses; local readiness uses each status context. Execution/attribution is owned by Candidate 51a7dd248e1c419c9107303d486e486a and its retained check.'\n if s['entry_point']=='StateMachine.update':\n  s['disposition']='mapped';s['behavior_ids']=['B-session-dedup'];s['reason']='Session retry branches are traced; Result.Data ownership remains a separate unresolved interface premise.';s['source_ids']=['src-session-update','src-result-data-contract']\nm['surfaces'].append(dict(entry_point='statemachine.Result.Data',disposition='UNCLASSIFIED_PROTOCOL_RESPONSIBILITY',reason='Session.addResponse retains a Result whose Data is a slice; inspected interface describes creation/return but not reuse or caller mutation ownership. Need inspect return and snapshot consumers before attributing any isolation duty.',source_ids=['src-result-data-contract','src-session-record','src-session-update'],high_consequence=True))\nm['core_overview']['open_details']=['Remote read prefix publication uses the confirming context for earlier remote statuses; the scoped execution/attribution is retained with its Candidate.','Read confirmations across membership transitions, snapshot transport failures, storage crash atomicity and result buffer ownership remain open.']\n# Maintain required source closure after changing referenced behavior sources.\nobs={x['id']:x for x in m['behaviors']+m['facts']}\nfor key in ['formation','context','connection']:\n p=m['core_overview'][key];p['source_ids']=list(dict.fromkeys(p['source_ids']+[s for i in p['behavior_ids']+p['fact_ids'] for s in obs[i]['source_ids']]))\njson.dump(m,open('audit-map-session.json','w'),indent=2)\nchanges={}\nfor i,ss,why in [('B-read-publication',['src-read-reply','src-read-queue'],'Remove answered publication unknown; the conditional branch description was already accurate.'),('B-client-read',['src-read-consumer'],'Remove execution-progress-only unknown; end-to-end timeout remains in check scope limitations.'),('B-apply',['src-apply-wakeup','src-apply-index','src-session-update'],'Clarify conditional per-entry callbacks and independent batch-level StepReady continuation.'),('A5',['src-session-update','src-apply-wakeup'],'Extend application navigation with session retry branches and continuation.'),('A6',['src-session-checkpoint','src-session-order-test'],'Extend persistence navigation with session checkpointing.'),('core_overview',['src-read-reply','src-session-update','src-apply-wakeup'],'Replace answered read question and s