ef_ids=['src-prefix-test','src-read-output-test','src-transport-loss','src-config-apply','src-rsm-recovery'],answered='Membership application/rejection and snapshot recovery callbacks now connect RSM state to Raft under raftMu; persistence and application boundaries complete representative core navigation. Prefix-confirmation tests preserve individual contexts and sequential end-to-end Raft tests expect readiness context equality. Transport.send and existing test networks permit message loss, so losing the first confirmation round and delivering a later round can exercise prefix release without assuming same-link reordering. These are source-derived construction premises, not observed results.',remaining=['Construct and execute a peer-boundary history that elects a leader, commits its no-op, admits distinct remote reads and drops the earlier heartbeat round before delivering the later round.','Review actual observations against the fixed local correlation requirement; client timeout consequence remains outside the check.'],understanding='updated',rationale='The identified discrepancy is now grounded as an implementation-owned correlation obligation; tests will distinguish the actual publication behavior under admitted history.'))\njson.dump(p,open('submission-map.json','w'),indent=2)\nPY\npython3 build_map.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));p=subprocess.run(r['validation']['command']+['submission-map.json'],capture_output=True,text=True);print(p.stdout);print(p.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
