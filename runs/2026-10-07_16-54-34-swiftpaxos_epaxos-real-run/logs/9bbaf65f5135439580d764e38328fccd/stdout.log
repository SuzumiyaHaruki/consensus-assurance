nce/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_16-54-34-swiftpaxos_epaxos-real-run --submission submission-review-durable.json 2>&1 | head -14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
