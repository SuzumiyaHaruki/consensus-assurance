      \"S14-recovery-start-prepare\",\n          \"S4-execute-loop\"\n        ],\n        \"protections\": []\n      },\n      {\n        \"behavior_id\": \"B11-prepare-resolution\",\n        \"activity\": \"A3\",\n        \"unknowns\": [\n          \"which sub-case the equal guards were meant to distinguish, and whether the TryPreAccept path is reachable at all\"\n        ],\n        \"source_ids\": [\n          \"S15-handlePrepareReply\",\n          \"S7-attributes\",\n          \"S21-quorum-sizes\"\n        ],\n        \"protections\": []\n      },\n      {\n        \"behavior_id\": \"B12-try-preaccept\",\n        \"activity\": \"A3\",\n        \"unknowns\": [\n          \"what the defer-cycle guard is supposed to accomplish and whether the counting error can suppress an abandonment\"\n        ],\n        \"source_ids\": [\n          \"S16-handleTryPreAccept\",\n          \"S17-find-conflicts\",\n          \"S18-handleTryPreAcceptReply\"\n        ],\n        \"protections\": []\n      },\n      {\n        \"behavior_id\": \"B14-ballot-monotonicity\",\n        \"activity\": \"A2\",\n        \"unknowns\": [\n          \"which in-repository entry sets IsLeader other than BeTheLeader\"\n        ],\n        \"source_ids\": [\n          \"S5-broadcasters\",\n          \"S11-handleAccept\",\n          \"S14-recovery-start-prepare\",\n          \"S10-handlePreAcceptReply\"\n        ],\n        \"protections\": []\n      },\n      {\n        \"behavior_id\": \"B15-durable-record\",\n        \"activity\": \"A6\",\n        \"unknowns\": [\n          \"whether any external tool consumes the stable-store file\"\n        ],\n        \"source_ids\": [\n          \"S19-durable-record\",\n          \"S24-runReplica-epaxos\"\n        ],\n        \"protections\": []\n      },\n      {\n        \"behavior_id\": \"B16-client-reply\",\n        \"activity\": \"A7\",\n        \"unknowns\": [\n          \"whether the client library requires a reply for the original CommandId when the command was replaced by NOOP\"\n        ],\n        \"source_ids\": [\n          \"S12-handleAcceptReply\",\n          \"S20-exec\",\n          \"S25-defs-channels\"\n        ],\n        \"protections\": []\n      }\n    ],\n    \"surfaces\": [\n      {\n        \"entry_point\": \"client/client.go and client/buffer.go\",\n        \"disposition\": \"deferred\",\n        \"behavior_ids\": [],\n        \"reason\": \"client-side invocation, pipelining and reply matching were not read; A7 completion and retry semantics depend on them. The wire contract they speak (PROPOSE and STATS requests, ProposeReplyTS answers) is sourced.\",\n        \"source_ids\": [\n          \"S25-defs-channels\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"master/master.go\",\n        \"disposition\": \"deferred\",\n        \"behavior_ids\": [],\n        \"reason\": \"participant set and leader assignment registration were not read; registration supplies ReplicaId and nodeList to every replica through run.go registerWithMaster and can therefore change eligibility (A4).\",\n        \"source_ids\": [\n          \"S24-runReplica-epaxos\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"config/config.go and config/proxy.go\",\n        \"disposition\": \"externalized\",\n        \"behavior_ids\": [],\n        \"reason\": \"supplies N, protocol flags and the client-to-proxy mapping from configuration files; it injects values the epaxos code itself does not validate.\",\n        \"source_ids\": [\n          \"S24-runReplica-epaxos\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"replica/defs/latency.go\",\n        \"disposition\": \"infrastructure\",\n        \"behavior_ids\": [],\n        \"reason\": \"injects per-peer delays for peer message delivery and client proposals (replicaListener and clientListener both sleep before handing a message to its channel); it shapes scheduling but is not a protocol decision.\",\n        \"source_ids\": [\n          \"S22-replica-listener\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"rpc/rpc.go\",\n        \"disposition\": \"infrastructure\",\n        \"behavior_ids\": [],\n        \"reason\": \"byte-tagged message table used for registration and dispatch of every protocol message.\",\n        \"source_ids\": [\n          \"S3-run-dispatch\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"sibling protocol packages (swift, curp, n2paxos, paxos, fastpaxos)\",\n        \"disposition\": \"deferred\",\n        \"behavior_ids\": [],\n        \"reason\": \"separate protocol implementations outside this run's analysis roots; they share replica/ and state/ helpers but implement different responsibilities, and run.go selects epaxos for this target.\",\n        \"source_ids\": [\n          \"S24-runReplica-epaxos\"\n        ],\n        \"high_consequence\": false\n      },\n      {\n        \"entry_point\": \"README.md protocol claims\",\n        \"disposition\": \"deferred\",\n        \"behavior_ids\": [],\n        \"reason\": \"the repository README asserts that the bundled EPaxos is the corrected version and that thriftiness is required for correct recovery; it is project documentation, not a verification source.\",\n        \"source_ids\": [\n          \"S27-readme\"\n        ],\n        \"high_consequence\": false\n      }\n    ],\n    \"core_regions\": [\n      {\n        \"activity\": \"A1\",\n        \"entries\": [\n          {\n            \"class_id\": \"A1\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Form a per-instance decision: fix the command, its sequence number and its dependency vector, and advance the instance from tentative pre-accept through accept to commit.\",\n            \"realization_summary\": \"handlePropose allocates (r.Id, ++crtInstance[r.Id]) and startPhase1 derives the initial (seq,deps) from the local conflict tables, records the instance as PREACCEPTED and broadcasts PreAccept to FastQuorumSize-1 preferred peers (Thrifty). handlePreAccept recomputes attributes on the receiver and replies with (bal,vbal,seq,deps,CommittedUpTo,status). handlePreAcceptReply merges replies and commits on the fast path when preAcceptOKs >= FastQuorumSize-1 and allEqual and (for N>7) allCommitted and the ballot is the initial ballot; otherwise the instance moves to ACCEPTED and a majority accept round runs in handleAcceptReply (acceptOKs+1 > N/2), followed by bcastCommit.\",\n            \"entry_points\": [\n              \"Replica.handlePropose\",\n              \"Replica.startPhase1\",\n              \"Replica.handlePreAccept\",\n              \"Replica.handlePreAcceptReply\",\n              \"Replica.handleAcceptReply\"\n            ],\n            \"behavior_ids\": [\n              \"B1-admit-propose\",\n              \"B2-phase1-attributes\",\n              \"B4-fast-path-decision\",\n              \"B5-slow-path-accept\"\n            ],\n            \"variants\": [\n              \"Thrifty fast quorum versus full broadcast\",\n              \"N<=3 and Thrifty skip the attribute-equality check\",\n              \"N>7 propagates committedDeps and can make the fast path fail on allCommitted\",\n              \"batching when batchWait > 0 (disabled by run.go)\"\n            ],\n            \"unknowns\": [\n              \"whether skipping the equality check for N<=3 with Thrifty is compensated by another mechanism\"\n            ],\n            \"source_ids\": [\n              \"S8-handlePropose-startPhase1\",\n              \"S9-handlePreAccept\",\n              \"S10-handlePreAcceptReply\",\n              \"S7-attributes\",\n              \"S21-quorum-sizes\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [\n          {\n            \"class_id\": \"A2\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Carry the per-instance authority context: which ballot the record is promised to, at which ballot its attributes were last fixed, and which replica may currently advance it.\",\n            \"realization_summary\": \"Each Instance keeps bal (highest ballot promised) and vbal (ballot at which the current attributes were established). maxRecvBallot is raised by every received message type and constrains makeBallot, which picks id + k*N, shifted by another N when the replica is not the instance owner and further raised while IsLeader. Ballot comparison gates every message and reply: lower ballots are dropped or nacked, and a majority of nacks lets a replica raise the ballot and run prepare. Ownership of the instance row never moves, but the right to lead it does.\",\n            \"entry_points\": [\n              \"Replica.makeBallot\",\n              \"Replica.handlePreAccept\",\n              \"Replica.handleAccept\",\n              \"Replica.handlePrepare\",\n              \"Replica.BeTheLeader\"\n            ],\n            \"behavior_ids\": [\n              \"B3-preaccept-recipient\",\n              \"B10-prepare-acceptor\",\n              \"B14-ballot-monotonicity\"\n            ],\n            \"variants\": [\n              \"initial ballot equals the owner replica id\",\n              \"recovery ballot for a non-owner is shifted by N\"\n            ],\n            \"unknowns\": [\n              \"whether any in-repository caller other than a nack majority ever sets IsLeader\"\n            ],\n            \"source_ids\": [\n              \"S2-instance-bookkeeping\",\n              \"S11-handleAccept\",\n              \"S14-recovery-start-prepare\",\n              \"S5-broadcasters\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding