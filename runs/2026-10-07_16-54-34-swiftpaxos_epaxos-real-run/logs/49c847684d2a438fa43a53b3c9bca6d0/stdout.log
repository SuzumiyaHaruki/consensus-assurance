mds[i].Op != state.GET {\n644\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n645\t\t\t\t}\n646\t\t\t}\n647\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n648\t\t\t\tif s < seq {\n649\t\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n650\t\t\t\t}\n651\t\t\t} else {\n652\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n653\t\t\t}\n654\t\t}\n655\t}\n656\t\n657\tfunc (r *Replica) updateAttributes(cmds []state.Command, seq int32, deps []int32, replica int32, instance int32) (int32, []int32, bool) {\n658\t\tchanged := false\n659\t\tfor q := 0; q < r.N; q++ {\n660\t\t\tif r.Id != replica && int32(q) == replica {\n661\t\t\t\tcontinue\n662\t\t\t}\n663\t\t\tfor i := 0; i < len(cmds); i++ {\n664\t\t\t\tif dpair, present := (r.conflicts[q])[cmds[i].K]; present {\n665\t\t\t\t\td := dpair.lastWrite\n666\t\t\t\t\tif cmds[i].Op != state.GET {\n667\t\t\t\t\t\td = dpair.last\n668\t\t\t\t\t}\n669\t\n670\t\t\t\t\tif d > deps[q] {\n671\t\t\t\t\t\tdeps[q] = d\n672\t\t\t\t\t\tif seq <= r.InstanceSpace[q][d].Seq {\n673\t\t\t\t\t\t\tseq = r.InstanceSpace[q][d].Seq + 1\n674\t\t\t\t\t\t}\n675\t\t\t\t\t\tchanged = true\n676\t\t\t\t\t\tbreak\n677\t\t\t\t\t}\n678\t\t\t\t}\n679\t\t\t}\n680\t\t}\n681\t\tfor i := 0; i < len(cmds); i++ {\n682\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n683\t\t\t\tif seq <= s {\n684\t\t\t\t\tchanged = true\n685\t\t\t\t\tseq = s + 1\n686\t\t\t\t}\n687\t\t\t}\n688\t\t}\n689\t\n690\t\treturn seq, deps, changed\n691\t}\n692\t\n693\tfunc (r *Replica) mergeAttributes(seq1 int32, deps1 []int32, seq2 int32, deps2 []int32) (int32, []int32, bool) {\n694\t\tequal := true\n695\t\tif seq1 != seq2 {\n696\t\t\tequal = false\n697\t\t\tif seq2 > seq1 {\n698\t\t\t\tseq1 = seq2\n699\t\t\t}\n700\t\t}\n701\t\tfor q := 0; q < r.N; q++ {\n702\t\t\tif int32(q) == r.Id {\n703\t\t\t\tcontinue\n704\t\t\t}\n705\t\t\tif deps1[q] != deps2[q] {\n706\t\t\t\tequal = false\n707\t\t\t\tif deps2[q] > deps1[q] {\n708\t\t\t\t\tdeps1[q] = deps2[q]\n709\t\t\t\t}\n710\t\t\t}\n711\t\t}\n712\t\treturn seq1, deps1, equal\n713\t}\n714\t\n715\tfunc equal(deps1 []int32, deps2 []int32) bool {\n716\t\tfor i := 0; i < len(deps1); i++ {\n717\t\t\tif deps1[i] != deps2[i] {\n718\t\t\t\treturn false\n719\t\t\t}\n720\t\t}\n721\t\treturn true\n722\t}\n723\t\n724\tfunc (r *Replica) handlePropose(propose *defs.GPropose) {\n725\t\t//TODO!! Handle client retries\n726\t\n727\t\tbatchSize := len(r.ProposeChan) + 1\n728\t\tr.M.Lock()\n729\t\tr.Stats.M[\"totalBatching\"]++\n730\t\tr.Stats.M[\"totalBatchingSize\"] += batchSize\n731\t\tr.M.Unlock()\n732\t\n733\t\tr.crtInstance[r.Id]++\n734\t\n735\t\tcmds := make([]state.Command, batchSize)\n736\t\tproposals := make([]*defs.GPropose, batchSize)\n737\t\tcmds[0] = propose.Command\n738\t\tproposals[0] = propose\n739\t\tfor i := 1; i < batchSize; i++ {\n740\t\t\tprop := <-r.ProposeChan\n741\t\t\tcmds[i] = prop.Command\n742\t\t\tproposals[i] = prop\n743\t\t}\n744\t\n745\t\tr.startPhase1(cmds, r.Id, r.crtInstance[r.Id], r.Id, proposals)\n746\t\n747\t\tcpcounter += len(cmds)\n748\t\n749\t}\n750\t\n751\tfunc (r *Replica) startPhase1(cmds []state.Command, replica int32, instance int32, ballot int32, proposals []*defs.GPropose) {\n752\t\t// init command attributes\n753\t\tseq := int32(0)\n754\t\tdeps := make([]int32, r.N)\n755\t\tfor q := 0; q < r.N; q++ {\n756\t\t\tdeps[q] = -1\n757\t\t}\n758\t\tseq, deps, _ = r.updateAttributes(cmds, seq, deps, replica, instance)\n759\t\tcomDeps := make([]int32, r.N)\n760\t\tfor i := 0; i < r.N; i++ {\n761\t\t\tcomDeps[i] = -1\n762\t\t}\n763\t\n764\t\tinst := r.newInstance(replica, instance, cmds, ballot, ballot, PREACCEPTED, seq, deps)\n765\t\tinst.lb = r.newLeaderBookkeeping(proposals, deps, comDeps, deps, ballot, cmds, PREACCEPTED, -1)\n766\t\tr.InstanceSpace[replica][instance] = inst\n767\t\n768\t\tr.updateConflicts(cmds, replica, instance, seq)\n769\t\n770\t\tif seq >= r.maxSeq {\n771\t\t\tr.maxSeq = seq\n772\t\t}\n773\t\n774\t\tr.recordInstanceMetadata(r.InstanceSpace[r.Id][instance])\n775\t\tr.recordCommands(cmds)\n776\t\tr.sync()\n777\t\n778\t\tr.bcastPreAccept(replica, instance)\n779\t}\n780\t\n781\tfunc (r *Replica) handlePreAccept(preAccept *PreAccept) {\n782\t\tinst := r.InstanceSpace[preAccept.Replica][preAccept.Instance]\n783\t\n784\t\tif preAccept.Seq >= r.maxSeq {\n785\t\t\tr.maxSeq = preAccept.Seq + 1\n786\t\t}\n787\t\n788\t\tif preAccept.Ballot > r.maxRecvBallot {\n789\t\t\tr.maxRecvBallot = preAccept.Ballot\n790\t\t}\n791\t\n792\t\tif preAccept.Instance > r.crtInstance[preAccept.Replica] {\n793\t\t\tr.crtInstance[preAccept.Replica] = preAccept.Instance\n794\t\t}\n795\t\n796\t\tif inst == nil {\n797\t\t\tinst = r.newInstanceDefault(preAccept.Replica, preAccept.Instance)\n798\t\t\tr.InstanceSpace[preAccept.Replica][preAccept.Instance] = inst\n799\t\t}\n800\t\n801\t\tif inst != nil && preAccept.Ballot < inst.bal {\n802\t\t\treturn\n803\t\t}\n804\t\n805\t\tinst.bal = preAccept.Ballot\n806\t\n807\t\tif inst.Status >= ACCEPTED {\n808\t\t\tif inst.Cmds == nil {\n809\t\t\t\tr.InstanceSpace[preAccept.LeaderId][preAccept.Instance].Cmds = preAccept.Command\n810\t\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n811\t\t\t\tr.recordCommands(preAccept.Command)\n812\t\t\t\tr.sync()\n813\t\t\t}\n814\t\n815\t\t} else {\n816\t\t\tseq, deps, changed := r.updateAttributes(preAccept.Command, preAccept.Seq, preAccept.Deps, preAccept.Replica, preAccept.Instance)\n817\t\t\tstatus := PREACCEPTED_EQ\n818\t\t\tif changed {\n819\t\t\t\tstatus = PREACCEPTED\n820\t\t\t}\n821\t\t\tinst.Cmds = preAccept.Command\n822\t\t\tinst.Seq = seq\n823\t\t\tinst.Deps = deps\n824\t\t\tinst.bal = preAccept.Ballot\n825\t\t\tinst.vbal = preAccept.Ballot\n826\t\t\tinst.Status = status\n827\t\n828\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n829\t\t\tr.recordInstanceMetadata(r.InstanceSpace[preAccept.Replica][preAccept.Instance])\n830\t\t\tr.recordCommands(preAccept.Command)\n831\t\t\tr.sync()\n832\t\n833\t\t}\n834\t\n835\t\treply := &PreAcceptReply{\n836\t\t\tpreAccept.Replica,\n837\t\t\tpreAccept.Instance,\n838\t\t\tinst.bal,\n839\t\t\tinst.vbal,\n840\t\t\tinst.Seq,\n841\t\t\tinst.Deps,\n842\t\t\tr.CommittedUpTo,\n843\t\t\tinst.Status}\n844\t\tr.replyPreAccept(preAccept.LeaderId, reply)\n845\t}\n846\t\n847\tfunc (r *Replica) handlePreAcceptReply(pareply *PreAcceptReply) {\n848\t\tinst := r.InstanceSpace[pareply.Replica][pareply.Instance]\n849\t\tlb := inst.lb\n850\t\n851\t\tif pareply.Ballot > r.maxRecvBallot {\n852\t\t\tr.maxRecvBallot = pareply.Ballot\n853\t\t}\n854\t\n855\t\tif lb.lastTriedBallot > pareply.Ballot {\n856\t\t\treturn\n857\t\t}\n858\t\n859\t\tif lb.lastTriedBallot < pareply.Ballot {\n860\t\t\tlb.nacks++\n861\t\t\tif lb.nacks+1 > r.N>>1 {\n862\t\t\t\tif r.IsLeader {\n863\t\t\t\t\tr.makeBallot(pareply.Replica, pareply.Instance)\n864\t\t\t\t\tr.bcastPrepare(pareply.Replica, pareply.Instance)\n865\t\t\t\t}\n866\t\t\t}\n867\t\t\treturn\n868\t\t}\n869\t\n870\t\tif lb.status != PREACCEPTED && lb.status != PREACCEPTED_EQ {\n871\t\t\treturn\n872\t\t}\n873\t\n874\t\tinst.lb.preAcceptOKs++\n875\t\n876\t\tif pareply.VBallot > lb.ballot {\n877\t\t\tlb.ballot = pareply.VBallot\n878\t\t\tlb.seq = pareply.Seq\n879\t\t\tlb.deps = pareply.Deps\n880\t\t\tlb.status = pareply.Status\n881\t\t}\n882\t\n883\t\tisInitialBallot := isInitialBallot(lb.lastTriedBallot, pareply.Replica, pareply.Instance)\n884\t\n885\t\tseq, deps, allEqual := r.mergeAttributes(lb.seq, lb.deps, pareply.Seq, pareply.Deps)\n886\t\tif r.N <= 3 && r.Thrifty {\n887\t\t\t// no need to check for equality\n888\t\t} else {\n889\t\t\tinst.lb.allEqual = inst.lb.allEqual && allEqual\n890\t\t\tif !allEqual {\n891\t\t\t\tr.M.Lock()\n892\t\t\t\tr.Stats.M[\"conflicted\"]++\n893\t\t\t\tr.M.Unlock()\n894\t\t\t}\n895\t\t}\n896\t\n897\t\tallCommitted := true\n898\t\tif r.N > 7 {\n899\t\t\tfor q := 0; q < r.N; q++ {\n900\t\t\t\tif inst.lb.committedDeps[q] < pareply.CommittedDeps[q] {\n901\t\t\t\t\tinst.lb.committedDeps[q] = pareply.CommittedDeps[q]\n902\t\t\t\t}\n903\t\t\t\tif inst.lb.committedDeps[q] < r.CommittedUpTo[q] {\n904\t\t\t\t\tinst.lb.committedDeps[q] = r.CommittedUpTo[q]\n905\t\t\t\t}\n906\t\t\t\tif inst.lb.committedDeps[q] < inst.Deps[q] {\n907\t\t\t\t\tallCommitted = false\n908\t\t\t\t}\n909\t\t\t}\n910\t\t}\n911\t\n912\t\tif lb.status <= PREACCEPTED_EQ {\n913\t\t\tlb.deps = deps\n914\t\t\tlb.seq = seq\n915\t\t}\n916\t\n917\t\tprecondition := inst.lb.allEqual && allCommitted && isInitialBallot\n918\t\n919\t\tif inst.lb.preAcceptOKs >= (r.Replica.FastQuorumSize()-1) && precondition {\n920\t\t\tlb.status = COMMITTED\n921\t\n922\t\t\tinst.Status = lb.status\n923\t\t\tinst.bal = lb.ballot\n924\t\t\tinst.Cmds = lb.cmds\n925\t\t\tinst.Deps = lb.deps\n926\t\t\tinst.Seq = lb.seq\n927\t\t\tr.recordInstanceMetadata(inst)\n928\t\t\tr.sync()\n929\t\n930\t\t\tr.updateCommitted(pareply.Replica)\n931\t\t\tif inst.lb.clientProposals != nil && !r.Dreply {\n932\t\t\t\tfor i := 0; i < len(inst.lb.clientProposals); i++ {\n933\t\t\t\t\tr.ReplyProposeTS(\n934\t\t\t\t\t\t&defs.ProposeReplyTS{\n935\t\t\t\t\t\t\tTRUE,\n936\t\t\t\t\t\t\tinst.lb.clientProposals[i].CommandId,\n937\t\t\t\t\t\t\tstate.NIL(),\n938\t\t\t\t\t\t\tinst.lb.clientProposals[i].Timestamp},\n939\t\t\t\t\t\tinst.lb.clientProposals[i].Reply,\n940\t\t\t\t\t\tinst.lb.clientProposals[i].Mutex)\n941\t\t\t\t}\n942\t\t\t}\n943\t\n944\t\t\tr.bcastCommit(pareply.Replica, pareply.Instance)\n945\t\n946\t\t\tr.M.Lock()\n947\t\t\tr.Stats.M[\"fast\"]++\n948\t\t\tif inst.proposeTime != 0 {\n949\t\t\t\tr.Stats.M[\"totalCommitTime\"] += int(time.Now().UnixNano() - inst.proposeTime)\n950\t\t\t}\n951\t\t\tr.M.Unlock()\n952\t\t} else if inst.lb.preAcceptOKs >= r.Replica.FastQuorumSize()-1 {\n953\t\t\tlb.status = ACCEPTED\n954\t\n955\t\t\tinst.Status = lb.status\n956\t\t\tinst.bal = lb.ballot\n957\t\t\tinst.Cmds = lb.cmds\n958\t\t\tinst.Deps = lb.deps\n959\t\t\tinst.Seq = lb.seq\n960\t\t\tr.recordInstanceMetadata(inst)\n","exit_code":0,"status":"completed"}}
