rless || c.WaitClosest {\n   170\t\t\t\twaitFrom = b.ClosestId\n   171\t\t\t}\n   172\t\t\tb.WaitReplies(waitFrom)\n   173\t\t\tb.Loop()\n   174\t\t}\n   175\t}\n   176\tpackage main\n   177\t\n   178\timport (\n   179\t\t\"fmt\"\n   180\t\t\"log\"\n   181\t\t\"net\"\n   182\t\t\"net/http\"\n   183\t\t\"net/rpc\"\n   184\t\t\"strings\"\n   185\t\t\"time\"\n   186\t\n   187\t\t\"github.com/imdea-software/swiftpaxos/config\"\n   188\t\t\"github.com/imdea-software/swiftpaxos/curp\"\n   189\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n   190\t\t\"github.com/imdea-software/swiftpaxos/epaxos\"\n   191\t\t\"github.com/imdea-software/swiftpaxos/fastpaxos\"\n   192\t\t\"github.com/imdea-software/swiftpaxos/n2paxos\"\n   193\t\t\"github.com/imdea-software/swiftpaxos/paxos\"\n   194\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n   195\t\t\"github.com/imdea-software/swiftpaxos/swift\"\n   196\t)\n   197\t\n   198\tfunc runReplica(c *config.Config, logger *dlog.Logger) {\n   199\t\tport := c.Port\n   200\t\n   201\t\tlog.Printf(\"Server starting on port %d\", port)\n   202\t\tmaddr := fmt.Sprintf(\"%s:%d\", c.MasterAddr, c.MasterPort)\n   203\t\taddr := c.ReplicaAddrs[c.Alias]\n   204\t\treplicaId, nodeList, isLeader := registerWithMaster(addr, maddr, port)\n   205\t\tf := (len(c.ReplicaAddrs) - 1) / 2\n   206\t\tlog.Printf(\"Tolerating %d max. failures\", f)\n   207\t\n   208\t\tswitch strings.ToLower(c.Protocol) {\n   209\t\tcase \"swiftpaxos\":\n   210\t\t\tlog.Println(\"Starting SwiftPaxos replica...\")\n   211\t\t\tswift.MaxDescRoutines = 100\n   212\t\t\trep := swift.New(c.Alias, replicaId, nodeList, !c.Noop,\n   213\t\t\t\tc.Optread, true, false, 1, f, c, logger, nil)\n   214\t\t\trpc.Register(rep)\n   215\t\tcase \"curp\":\n   216\t\t\tlog.Println(\"Starting optimized CURP replica...\")\n   217\t\t\tcurp.MaxDescRoutines = 100\n   218\t\t\trep := curp.New(c.Alias, replicaId, nodeList, !c.Noop,\n   219\t\t\t\t1, f, true, c, logger)\n   220\t\t\trpc.Register(rep)\n   221\t\tcase \"fastpaxos\":\n   222\t\t\tlog.Println(\"Starting Fast Paxos replica...\")\n   223\t\t\trep := fastpaxos.New(c.Alias, replicaId, nodeList, !c.Noop, f, c, logger)\n   224\t\t\trpc.Register(rep)\n   225\t\tcase \"n2paxos\":\n   226\t\t\tlog.Println(\"Starting N²Paxos replica...\")\n   227\t\t\trep := n2paxos.New(c.Alias, replicaId, nodeList, !c.Noop, 1, f, c, logger)\n   228\t\t\trpc.Register(rep)\n   229\t\tcase \"paxos\":\n   230\t\t\tlog.Println(\"Starting Paxos replica...\")\n   231\t\t\trep := paxos.New(c.Alias, replicaId, nodeList, isLeader, f, c, logger)\n   232\t\t\trpc.Register(rep)\n   233\t\tcase \"epaxos\":\n   234\t\t\tlog.Println(\"Starting EPaxos replica...\")\n   235\t\t\trep := epaxos.New(c.Alias, replicaId, nodeList, !c.Noop, false, false, 0, false, f, c, logger)\n   236\t\t\trpc.Register(rep)\n   237\t\t}\n   238\t\n   239\t\trpc.HandleHTTP()\n   240\t\tl, err := net.Listen(\"tcp\", fmt.Sprintf(\":%d\", port+1000))\n   241\t\tif err != nil {\n   242\t\t\tlog.Fatal(\"listen error:\", err)\n   243\t\t}\n   244\t\thttp.Serve(l, nil)\n   245\t}\n   246\t\n   247\tfunc registerWithMaster(addr, mAddr string, port int) (int, []string, bool) {\n   248\t\tvar reply defs.RegisterReply\n   249\t\targs := &defs.RegisterArgs{\n   250\t\t\tAddr: addr,\n   251\t\t\tPort: port,\n   252\t\t}\n   253\t\tlog.Printf(\"connecting to: %v\", mAddr)\n   254\t\n   255\t\tfor {\n   256\t\t\tmcli, err := rpc.DialHTTP(\"tcp\", mAddr)\n   257\t\t\tif err == nil {\n   258\t\t\t\tfor {\n   259\t\t\t\t\t// TODO: This is an active wait...\n   260\t\t\t\t\terr = mcli.Call(\"Master.Register\", args, &reply)\n   261\t\t\t\t\tif err == nil {\n   262\t\t\t\t\t\tif reply.Ready {\n   263\t\t\t\t\t\t\tbreak\n   264\t\t\t\t\t\t}\n   265\t\t\t\t\t\ttime.Sleep(4)\n   266\t\t\t\t\t} else {\n   267\t\t\t\t\t\tlog.Printf(\"%v\", err)\n   268\t\t\t\t\t}\n   269\t\t\t\t}\n   270\t\t\t\tbreak\n   271\t\t\t} else {\n   272\t\t\t\tlog.Printf(\"%v\", err)\n   273\t\t\t}\n   274