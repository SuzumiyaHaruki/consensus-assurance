{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat -n /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_16-54-34-swiftpaxos_epaxos-real-run/agent-source/epaxos/exec.go'","aggregated_output":"     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t\t\"sort\"\n     5\t\n     6\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n     7\t\t\"github.com/imdea-software/swiftpaxos/state\"\n     8\t)\n     9\t\n    10\tconst (\n    11\t\tWHITE int8 = iota\n    12\t\tGRAY\n    13\t\tBLACK\n    14\t)\n    15\t\n    16\ttype Exec struct {\n    17\t\tr *Replica\n    18\t}\n    19\t\n    20\ttype SCComponent struct {\n    21\t\tnodes []*Instance\n    22\t\tcolor int8\n    23\t}\n    24\t\n    25\tfunc (e *Exec) executeCommand(replica int32, instance int32) bool {\n    26\t\tif e.r.InstanceSpace[replica][instance] == nil {\n    27\t\t\treturn false\n    28\t\t}\n    29\t\tinst := e.r.InstanceSpace[replica][instance]\n    30\t\tif inst.Status == EXECUTED {\n    31\t\t\treturn true\n    32\t\t}\n    33\t\tif inst.Status != COMMITTED {\n    34\t\t\treturn false\n    35\t\t}\n    36\t\n    37\t\tif !e.findSCC(inst) {\n    38\t\t\treturn false\n    39\t\t}\n    40\t\n    41\t\treturn true\n    42\t}\n    43\t\n    44\tvar stack []*Instance = make([]*Instance, 0, 100)\n    45\t\n    46\tfunc (e *Exec) findSCC(root *Instance) bool {\n    47\t\tindex := 1\n    48\t\t// find SCCs using Tarjan's algorithm\n    49\t\tstack = stack[0:0]\n    50\t\tret := e.strongconnect(root, &index)\n    51\t\t// reset all indexes in the stack\n    52\t\tfor j := 0; j < len(stack); j++ {\n    53\t\t\tstack[j].Index = 0\n    54\t\t}\n    55\t\treturn ret\n    56\t}\n    57\t\n    58\tfunc (e *Exec) strongconnect(v *Instance, index *int) bool {\n    59\t\tv.Index = *index\n    60\t\tv.Lowlink = *index\n    61\t\t*index = *index + 1\n    62\t\n    63\t\tl := len(stack)\n    64\t\tif l == cap(stack) {\n    65\t\t\tnewSlice := make([]*Instance, l, 2*l)\n    66\t\t\tcopy(newSlice, stack)\n    67\t\t\tstack = newSlice\n    68\t\t}\n    69\t\tstack = stack[0 : l+1]\n    70\t\tstack[l] = v\n    71\t\n    72\t\tif v.Cmds == nil {\n    73\t\t\treturn false\n    74\t\t}\n    75\t\n    76\t\tfor q := int32(0); q < int32(e.r.N); q++ {\n    77\t\t\tinst := v.Deps[q]\n    78\t\t\tfor i := e.r.ExecedUpTo[q] + 1; i <= inst; i++ {\n    79\t\t\t\tif e.r.InstanceSpace[q][i] == nil || e.r.InstanceSpace[q][i].Cmds == nil {\n    80\t\t\t\t\treturn false\n    81\t\t\t\t}\n    82\t\n    83\t\t\t\tif e.r.transconf {\n    84\t\t\t\t\tfor _, alpha := range v.Cmds {\n    85\t\t\t\t\t\tfor _, beta := range e.r.InstanceSpace[q][i].Cmds {\n    86\t\t\t\t\t\t\tif !state.Conflict(&alpha, &beta) {\n    87\t\t\t\t\t\t\t\tcontinue\n    88\t\t\t\t\t\t\t}\n    89\t\t\t\t\t\t}\n    90\t\t\t\t\t}\n    91\t\t\t\t}\n    92\t\n    93\t\t\t\tif e.r.InstanceSpace[q][i].Status == EXECUTED {\n    94\t\t\t\t\tcontinue\n    95\t\t\t\t}\n    96\t\n    97\t\t\t\tfor e.r.InstanceSpace[q][i].Status != COMMITTED {\n    98\t\t\t\t\treturn false\n    99\t\t\t\t}\n   100\t\n   101\t\t\t\tw := e.r.InstanceSpace[q][i]\n   102\t\n   103\t\t\t\tif w.Index == 0 {\n   104\t\t\t\t\tif !e.strongconnect(w, index) {\n   105\t\t\t\t\t\treturn false\n   106\t\t\t\t\t}\n   107\t\t\t\t\tif w.Lowlink < v.Lowlink {\n   108\t\t\t\t\t\tv.Lowlink = w.Lowlink\n   109\t\t\t\t\t}\n   110\t\t\t\t} else if e.inStack(w) {\n   111\t\t\t\t\tif w.Index < v.Lowlink {\n   112\t\t\t\t\t\tv.Lowlink = w.Index\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t}\n   116\t\t}\n   117\t\n   118\t\tif v.Lowlink == v.Index {\n   119\t\t\t//found SCC\n   120\t\t\tlist := stack[l:]\n   121\t\n   122\t\t\t//execute commands in the increasing order of the Seq field\n   123\t\t\tsort.Sort(nodeArray(list))\n   124\t\t\tfor _, w := range list {\n   125\t\t\t\tfor idx := 0; idx < len(w.Cmds); idx++ {\n   126\t\t\t\t\tshouldRespond := e.r.Dreply && w.lb != nil && w.lb.clientProposals != nil\n   127\t\t\t\t\tif w.Cmds[idx].Op == state.NONE {\n   128\t\t\t\t\t\t// nothing to do\n   129\t\t\t\t\t} else if shouldRespond {\n   130\t\t\t\t\t\tval := w.Cmds[idx].Execute(e.r.State)\n   131\t\t\t\t\t\te.r.ReplyProposeTS(\n   132\t\t\t\t\t\t\t&defs.ProposeReplyTS{\n   133\t\t\t\t\t\t\t\tTRUE,\n   134\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].CommandId,\n   135\t\t\t\t\t\t\t\tval,\n   136\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].Timestamp},\n   137\t\t\t\t\t\t\tw.lb.clientProposals[idx].Reply,\n   138\t\t\t\t\t\t\tw.lb.clientProposals[idx].Mutex)\n   139\t\t\t\t\t} else if w.Cmds[idx].Op == state.PUT {\n   140\t\t\t\t\t\tw.Cmds[idx].Execute(e.r.State)\n   141\t\t\t\t\t}\n   142\t\t\t\t}\n   143\t\t\t\tw.Status = EXECUTED\n   144\t\t\t}\n   145\t\t\tstack = stack[0:l]\n   146\t\t}\n   147\t\n   148\t\treturn true\n   149\t}\n   150\t\n   151\tfunc (e *Exec) inStack(w *Instance) bool {\n   152\t\tfor _, u := range stack {\n   153\t\t\tif w == u {\n   154\t\t\t\treturn true\n   155\t\t\t}\n   156\t\t}\n   157\t\treturn false\n   158\t}\n   159\t\n   160\ttype nodeArray []*Instance\n   161\t\n   162\tfunc (na nodeArray) Len() int {\n   163\t\treturn len(na)\n   164\t}\n   165\t\n   166\tfunc (na nodeArray) Less(i, j int) bool {\n   167\t\treturn na[i].Seq < na[j].Seq || (na[i].Seq == na[j].Seq && na[i].id.replica < na[j].id.replica) || (na[i].Seq == na[j].Seq && na[i].id.replica == na[j].id.replica && na[i].proposeTime < na[j].proposeTime)\n   168\t}\n   169\t\n   170\tfunc (na nodeArray) Swap(i, j int) {\n   171\t\tna[i], na[j] = na[j], na[i]\n   172\t}\n","exit_code":0,"status":"completed"}}
