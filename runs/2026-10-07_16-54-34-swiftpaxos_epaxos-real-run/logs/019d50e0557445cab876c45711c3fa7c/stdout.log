{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nd=json.load(open('/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_16-54-34-swiftpaxos_epaxos-real-run/product-schemas.json'))\np=d['DirectCheckPlan']['\"'$defs'\"']\nfor k in ['ObservableProperty','EventMonitor','EventRequirement','Comparison']:\n    print('=====',k, json.dumps(p[k], indent=1)[:2600])\nPY\"","aggregated_output":"===== ObservableProperty {\n \"additionalProperties\": false,\n \"properties\": {\n  \"checker_id\": {\n   \"title\": \"Checker Id\",\n   \"type\": \"string\"\n  },\n  \"kind\": {\n   \"default\": \"event_assertion\",\n   \"enum\": [\n    \"event_assertion\",\n    \"event_implication\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"trigger\": {\n   \"$ref\": \"#/$defs/Comparison\"\n  },\n  \"assertion\": {\n   \"$ref\": \"#/$defs/Comparison\"\n  },\n  \"antecedent\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/Comparison\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"identity_fields\": {\n   \"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Identity Fields\",\n   \"type\": \"array\"\n  },\n  \"description\": {\n   \"title\": \"Description\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"checker_id\",\n  \"trigger\",\n  \"assertion\",\n  \"description\"\n ],\n \"title\": \"ObservableProperty\",\n \"type\": \"object\"\n}\n===== EventMonitor {\n \"additionalProperties\": false,\n \"properties\": {\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"checker_id\": {\n   \"title\": \"Checker Id\",\n   \"type\": \"string\"\n  },\n  \"event\": {\n   \"title\": \"Event\",\n   \"type\": \"string\"\n  },\n  \"binding_ids\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Binding Ids\",\n   \"type\": \"array\"\n  },\n  \"grounding\": {\n   \"$ref\": \"#/$defs/Grounding\"\n  },\n  \"applicability_conditions\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/Comparison\"\n   },\n   \"title\": \"Applicability Conditions\",\n   \"type\": \"array\"\n  },\n  \"admission_alias\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\",\n   \"title\": \"Admission Alias\"\n  }\n },\n \"required\": [\n  \"id\",\n  \"checker_id\",\n  \"event\",\n  \"binding_ids\",\n  \"grounding\"\n ],\n \"title\": \"EventMonitor\",\n \"type\": \"object\"\n}\n===== EventRequirement {\n \"additionalProperties\": false,\n \"properties\": {\n  \"alias\": {\n   \"title\": \"Alias\",\n   \"type\": \"string\"\n  },\n  \"event\": {\n   \"title\": \"Event\",\n   \"type\": \"string\"\n  },\n  \"conditions\": {\n   \"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\",\n   \"items\": {\n    \"$ref\": \"#/$defs/Comparison\"\n   },\n   \"title\": \"Conditions\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"alias\",\n  \"event\"\n ],\n \"title\": \"EventRequirement\",\n \"type\": \"object\"\n}\n===== Comparison {\n \"additionalProperties\": false,\n \"properties\": {\n  \"field\": {\n   \"title\": \"Field\",\n   \"type\": \"string\"\n  },\n  \"op\": {\n   \"default\": \"eq\",\n   \"enum\": [\n    \"eq\",\n    \"ne\"\n   ],\n   \"title\": \"Op\",\n   \"type\": \"string\"\n  },\n  \"value\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"integer\"\n    },\n    {\n     \"type\": \"boolean\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Value\"\n  },\n  \"reference\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Reference\"\n  }\n },\n \"required\": [\n  \"field\"\n ],\n \"title\": \"Comparison\",\n \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
