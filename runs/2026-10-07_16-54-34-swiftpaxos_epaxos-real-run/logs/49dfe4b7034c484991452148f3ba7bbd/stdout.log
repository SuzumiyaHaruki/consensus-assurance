r.go:133:func (s Sender) SendToQuorum(q Quorum, msg fastrpc.Serializable, rpc uint8) {\n./replica/sender.go:137:func (s Sender) SendExcept(q Quorum, msg fastrpc.Serializable, rpc uint8) {\n./replica/sender.go:141:func (s Sender) SendToClient(cid int32, msg fastrpc.Serializable, rpc uint8) {\n./replica/sender.go:145:func (s Sender) SendTo(id int32, msg fastrpc.Serializable, rpc uint8) {\n--- hook ---\npackage hook\n\nimport (\n\t\"os\"\n\t\"os/signal\"\n\t\"syscall\"\n)\n\nfunc HookUser1(f func()) {\n\tuser1 := make(chan os.Signal, 1)\n\tsignal.Notify(user1, syscall.SIGUSR1)\n\n\tgo func() {\n\t\t<-user1\n\t\tf()\n\t}()\n}\n","exit_code":0,"status":"completed"}}
