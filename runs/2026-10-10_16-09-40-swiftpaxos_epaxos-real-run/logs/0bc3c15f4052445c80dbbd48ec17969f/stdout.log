n\"\n    ],\n    \"read_only_paths\": [\n      \"/home/nitro/Desktop/consensus-assurance/src\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/lib/python3.10/site-packages\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/pyvenv.cfg\"\n    ]\n  },\n  \"rejected_drafts\": [],\n  \"records\": {\n    \"path\": \"state.json\",\n    \"keys\": {\n      \"materials\": \"id\",\n      \"checks\": \"id\",\n      \"semantic_reviews\": \"id\",\n      \"selections\": \"operation_id\"\n    },\n    \"paths_relative_to\": \"research.json directory\"\n  },\n  \"review_contracts\": [\n    {\n      \"target_id\": \"8f7394373b3342e3a3b2cfec855bc2b0\",\n      \"object_type\": \"direct_check\",\n      \"version\": 1,\n      \"required_aspects\": [\n        \"checker_correspondence\"\n      ],\n      \"optional_aspects\": [\n        \"applicability\",\n        \"decomposition\"\n      ]\n    }\n  ],\n  \"review_questions\": {\n    \"direct_check\": {\n      \"checker_correspondence\": \"Does this evidence establish a conditional observation, an independently applicable local contract violation, or a reachable protocol violation? Before no_issue_found, identify the necessary premises and how fixed execution/producers or a sourced admitting contract establish them. A narrower endpoint alone cannot turn a missing necessary producer/history into independent scope. Answer exact open issues; unchanged sources or a correct oracle need no artificial edit. See evidence-review.\",\n      \"applicability\": \"Why does the sourced contract admit this input and initial state?\",\n      \"decomposition\": \"Do the selected checks express the responsibility and preserve its dependencies?\"\n    }\n  }\n}{\"Time\":\"2026-10-10T16:16:48.762400181+08:00\",\"Action\":\"start\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\"}\n{\"Time\":\"2026-10-10T16:16:48.77218634+08:00\",\"Action\":\"run\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\"}\n{\"Time\":\"2026-10-10T16:16:48.772264415+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\",\"Output\":\"=== RUN   TestAssurancePrepareReplyProducerTransport\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.772449737+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\",\"Output\":\"CA_EVENT {\\\"acceptor\\\":2,\\\"event\\\":\\\"prepare_reply_admitted\\\",\\\"instance\\\":0,\\\"prepare_ballot\\\":3,\\\"replica\\\":1,\\\"status\\\":2,\\\"vballot\\\":1}\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.772508532+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\",\"Output\":\"CA_EVENT {\\\"acceptor\\\":2,\\\"decoded_status\\\":2,\\\"decoded_vballot\\\":0,\\\"event\\\":\\\"prepare_reply_transport\\\",\\\"identity_preserved\\\":true,\\\"instance\\\":0,\\\"other_fields_preserved\\\":true,\\\"preaccept_ballot\\\":1,\\\"prepare_ballot\\\":3,\\\"producer_status\\\":2,\\\"producer_vballot_after_prepare\\\":1,\\\"producer_vballot_before_prepare\\\":1,\\\"replica\\\":1,\\\"value_ballot_preserved\\\":false}\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.772552046+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\",\"Output\":\"--- PASS: TestAssurancePrepareReplyProducerTransport (0.00s)\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.772563949+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyProducerTransport\",\"Elapsed\":0}\n{\"Time\":\"2026-10-10T16:16:48.772575042+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.773659679+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Output\":\"ok  \\tgithub.com/imdea-software/swiftpaxos/epaxos\\t0.011s\\n\"}\n{\"Time\":\"2026-10-10T16:16:48.77371698+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Elapsed\":0.011}\n{\n  \"description\": \"Repeat the producer/transport prefix from exploration with an input admission event before handlePrepare, then compare the decoded VBallot to that same operation input. This is the local preservation claim, not a cluster endpoint.\",\n  \"claim_id\": \"prepare_reply_value_ballot_preservation\",\n  \"binding_ids\": [\n    \"prepare_reply_marshal\",\n    \"prepare_reply_unmarshal\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./epaxos\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package epaxos\\n\\nimport (\\n    \\\"bufio\\\"\\n    \\\"bytes\\\"\\n    \\\"encoding/json\\\"\\n    \\\"fmt\\\"\\n    \\\"reflect\\\"\\n    \\\"testing\\\"\\n\\n    \\\"github.com/imdea-software/swiftpaxos/dlog\\\"\\n    \\\"github.com/imdea-software/swiftpaxos/replica\\\"\\n    \\\"github.com/imdea-software/swiftpaxos/replica/defs\\\"\\n    fastrpc \\\"github.com/imdea-software/swiftpaxos/rpc\\\"\\n    \\\"github.com/imdea-software/swiftpaxos/state\\\"\\n)\\n\\n// This probe uses constructor-equivalent empty protocol containers of bounded\\n// size. It bypasses network startup, the event loop, timers and execution workers.\\n// All instance contents after initialization are produced by actual handlers.\\nfunc assuranceEmptyReplica(id int32) (*Replica, []*bytes.Buffer) {\\n    const n = 3\\n    base := &replica.Replica{\\n        Logger: dlog.New(\\\"\\\", false), N: n, F: 1, Id: id, Thrifty: true,\\n        PeerWriters: make([]*bufio.Writer, n), Alive: []bool{true,true,true},\\n        PreferredPeerOrder: []int32{(id+1)%n, (id+2)%n, id},\\n        Stats: &defs.Stats{M: make(map[string]int)},\\n        ProposeChan: make(chan *defs.GPropose, 1),\\n    }\\n    r := &Replica{Replica: base, InstanceSpace: make([][]*Instance,n),\\n        crtInstance: []int32{-1,-1,-1}, CommittedUpTo: []int32{-1,-1,-1},\\n        ExecedUpTo: []int32{-1,-1,-1}, conflicts: make([]map[state.Key]*InstPair,n),\\n        maxSeqPerKey: make(map[state.Key]int32), maxRecvBallot: -1,\\n        latestCPInstance: -1, prepareRPC: 10, prepareReplyRPC: 11,\\n        preAcceptRPC: 12, preAcceptReplyRPC: 13,\\n    }\\n    wires := make([]*bytes.Buffer,n)\\n    for i:=0;i<n;i++ {\\n        r.InstanceSpace[i] = make([]*Instance,4)\\n        r.conflicts[i] = make(map[state.Key]*InstPair)\\n        wires[i] = new(bytes.Buffer)\\n        base.PeerWriters[i] = bufio.NewWriter(wires[i])\\n    }\\n    return r,wires\\n}\\n\\nfunc assuranceDecode(t *testing.T, wire *bytes.Buffer, code byte, dst fastrpc.Serializable) {\\n    t.Helper()\\n    got,err:=wire.ReadByte()\\n    if err!=nil || got!=code { t.Fatalf(\\\"RPC code got %d, err %v; want %d\\\",got,err,code) }\\n    if err:=dst.Unmarshal(wire);err!=nil { t.Fatal(err) }\\n    if wire.Len()!=0 { t.Fatalf(\\\"unexpected trailing bytes: %d\\\",wire.Len()) }\\n}\\n\\nfunc TestAssurancePrepareReplyProducerTransport(t *testing.T) {\\n    owner, ow := assuranceEmptyReplica(1)\\n    acceptor, aw := assuranceEmptyReplica(2)\\n    recoverer, rw := assuranceEmptyReplica(0)\\n    proposal := &defs.GPropose{Propose: &defs.Propose{CommandId: 71,ClientId: 9,\\n        Command: state.Command{Op: state.PUT,K: 17,V: state.Value(\\\"payload\\\")}}}\\n    owner.handlePropose(proposal)\\n    pa := new(PreAccept)\\n    assuranceDecode(t,ow[2],owner.preAcceptRPC,pa)\\n    acceptor.handlePreAccept(pa)\\n    // Keep the actual PreAcceptReply pending; no quorum or commit is asserted.\\n    before := acceptor.InstanceSpace[1][0]\\n    acceptedValueBallot := before.vbal\\n    if acceptedValueBallot!=1 || before.Status!=PREACCEPTED_EQ { t.Fatal(\\\"preaccept prefix not reached\\\") }\\n    recoverer.startRecoveryForInstance(1,0)\\n    prep := new(Prepare)\\n    assuranceDecode(t,rw[2],recoverer.prepareRPC,prep)\\n    admission := map[string]any{\\n        \\\"event\\\":\\\"prepare_reply_admitted\\\", \\\"acceptor\\\":acceptor.Id,\\n        \\\"replica\\\":prep.Replica,\\\"instance\\\":prep.Instance,\\n        \\\"vballot\\\":before.vbal,\\\"status\\\":before.Status,\\\"prepare_ballot\\\":prep.Ballot,\\n    }\\n    admittedData,err:=json.Marshal(admission);if err!=nil { t.Fatal(err) }\\n    fmt.Println(\\\"CA_EVENT \\\"+string(admittedData))\\n    acceptor.handlePrepare(prep)\\n    // This is the actual handlePrepare -> replyPrepare -> SendMsg byte stream.\\n    reply := new(PrepareReply).New().(*PrepareReply)\\n    assuranceDecode(t,aw[0],acceptor.prepareReplyRPC,reply)\\n    inst := acceptor.InstanceSpace[1][0]\\n    identityOK := reply.AcceptorId==2 && reply.Replica==1 && reply.Instance==0\\n    otherFieldsOK := reply.Ballot==inst.bal && reply.Status==inst.Status && reply.Seq==inst.Seq &&\\n        reflect.DeepEqual(reply.Command,inst.Cmds) && reflect.DeepEqual(reply.Deps,inst.Deps)\\n    event := map[string]any{\\n        \\\"event\\\":\\\"prepare_reply_transport\\\", \\\"acceptor\\\":reply.AcceptorId,\\n        \\\"replica\\\":reply.Replica,\\\"instance\\\":reply.Instance,\\n        \\\"preaccept_ballot\\\":pa.Ballot,\\\"prepare_ballot\\\":prep.Ballot,\\n        \\\"producer_vballot_before_prepare\\\":acceptedValueBallot,\\\"producer_vballot_after_prepare\\\":inst.vbal,\\n        \\\"decoded_vballot\\\":reply.VBallot,\\\"identity_preserved\\\":identityOK,\\n        \\\"other_fields_preserved\\\":otherFieldsOK,\\\"value_ballot_preserved\\\":reply.VBallot==inst.vbal,\\n        \\\"producer_status\\\":inst.Status,\\\"decoded_status\\\":reply.Status,\\n    }\\n    data,err:=json.Marshal(event);if err!=nil { t.Fatal(err) }\\n    fmt.Println(\\\"CA_EVENT \\\"+string(data))\\n    if !identityOK || !otherFieldsOK { t.Fatal(\\\"probe correlation or other fields failed\\\") }\\n    // The external checker compares this decoded value against the prior admission.\\n}\\n\",\n    \"description\": \"Three bounded empty replicas; propose at owner 1, deliver its real PreAccept to acceptor 2, initiate recovery at replica 0, deliver its real Prepare to acceptor 2, decode the actual SendMsg reply.\",\n    \"semantic_changes\": [\n      \"Replace constructor startup and TCP sockets with constructor-equivalent empty protocol containers and separate per-link byte buffers.\",\n      \"Call private handlers synchronously; no event loop, timer, execution worker or crash is modeled.\",\n      \"Reduce instance arrays to four entries; only instance 1.0 is touched. No produced instance field or message is edited.\",\n      \"Hold the PreAcceptReply and unused Prepare bytes without delivering them.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"prepare_reply_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"status\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"initialization\",\n        \"base_initialization\",\n        \"proposal_producer\",\n        \"recovery_producer_consumer\",\n        \"ballot_send\",\n        \"transport_send\",\n        \"transport_receive\"\n      ],\n      \"expectation_ids\": [],\n      \"binding_ids\": [\n        \"prepare_reply_marshal\",\n        \"prepare_reply_unmarshal\"\n      ],\n      \"derivation\": \"Empty rows, counters -1, empty conflict maps, N=3 F=1, thriftiness and cyclic peer preference match initialization. handlePropose produces ballot 1 and actual bytes; handlePreAccept creates the stored value. startRecoveryForInstance produces Prepare ballot 3; handlePrepare consumes it. The probe omits worker/network startup and invokes recovery directly, so it establishes the admitted local producer input rather than end-to-end recovery reachability.\",\n      \"applicability\": \"Single synchronous test owns all replica objects and buffers. Before the producer call, the input event samples the actual instance value ballot and identity; after its synchronous SendMsg flush, a fresh object decodes the complete untouched byte stream.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"value_ballot_transport_monitor\",\n      \"checker_id\": \"value_ballot_transport\",\n      \"event\": \"prepare_reply_transport\",\n      \"binding_ids\": [\n        \"prepare_reply_marshal\",\n        \"prepare_reply_unmarshal\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"reply_codec\",\n          \"transport_send\",\n          \"transport_receive\",\n          \"recovery_producer_consumer\"\n        ],\n        \"expectation_ids\": [],\n        \"binding_ids\": [\n          \"prepare_reply_marshal\",\n          \"prepare_reply_unmarshal\"\n        ],\n        \"derivation\": \"Read decoded_vballot from the actual fresh decoded reply; compare to the earlier admitted.vballot. Correlation fields are the actual acceptor ID, replica and instance, never the ballot.\",\n        \"applicability\": \"The result occurs only after successful full decoding of the corresponding synchronous producer output. Go assertions check framing, independent identity and other payload fields without filtering the value-ballot comparison.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"value_ballot_transport\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"prepare_reply_transport\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"decoded_vballot\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admitted.vballot\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"acceptor\",\n        \"replica\",\n        \"instance\"\n      ],\n      \"description\": \"The decoded accepted-value ballot equals the value sampled for the same admitted producer operation.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"No decision or application endpoint is observed; loss of this field is not alone proof of a consensus safety violation.\",\n    \"The constructor/event-loop/timer bypass is explicit; local codec applicability is grounded independently in the producer/receiver contract.\"\n  ]\n}","exit_code":0,"status":"completed"}}
