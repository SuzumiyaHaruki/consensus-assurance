ns its new ballot to its local self reply, which can dominate remote evidence independently of serialization.\"\n        ]\n      },\n      \"version\": 1,\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"claims\",\n        \"match\": {\n          \"id\": \"prepare_reply_value_ballot_preservation\",\n          \"version\": 1\n        }\n      }\n    }\n  ],\n  \"artifacts\": [\n    {\n      \"id\": \"8f7394373b3342e3a3b2cfec855bc2b0\",\n      \"version\": 1,\n      \"plan_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-40-swiftpaxos_epaxos-real-run/direct-checks/aadcf7f6d6294d2da76451388323b110/plan.json\",\n      \"harness_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-40-swiftpaxos_epaxos-real-run/direct-checks/aadcf7f6d6294d2da76451388323b110/epaxos/assurance_generated_test.go\",\n      \"unit_id\": \"unit-prepare_reply_value_ballot_preservation\",\n      \"claim_id\": \"prepare_reply_value_ballot_preservation\",\n      \"graph_versions\": {\n        \"prepare_reply_value_ballot_preservation\": 1,\n        \"prepare_reply_marshal\": 1,\n        \"prepare_reply_unmarshal\": 1,\n        \"unit-prepare_reply_value_ballot_preservation\": 1\n      },\n      \"previous_id\": null,\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"direct_checks\",\n        \"match\": {\n          \"id\": \"8f7394373b3342e3a3b2cfec855bc2b0\"\n        }\n      },\n      \"basis\": [\n        {\n          \"path\": \"state.json\",\n          \"collection\": \"claims\",\n          \"match\": {\n            \"id\": \"prepare_reply_value_ballot_preservation\",\n            \"version\": 1\n          }\n        },\n        {\n          \"path\": \"state.json\",\n          \"collection\": \"bindings\",\n          \"match\": {\n            \"id\": \"prepare_reply_marshal\",\n            \"version\": 1\n          }\n        },\n        {\n          \"path\": \"state.json\",\n        