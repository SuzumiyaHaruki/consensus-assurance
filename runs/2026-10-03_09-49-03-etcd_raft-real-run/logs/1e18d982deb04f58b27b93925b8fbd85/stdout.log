{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '3575,3660p' ../agent-source/raft_test.go; sed -n '1,125p' ../agent-source/log_unstable.go; sed -n '2033,2045p' ../agent-source/raft.go; sed -n '2062,2094p' ../agent-source/raft.go; sed -n '245,285p' ../agent-source/raft.go\"","aggregated_output":"\tassert.Equal(t, StateFollower, n2.state)\n\tassert.Equal(t, StatePreCandidate, n3.state)\n\n\t// Pre-Vote again for safety\n\tnt.send(pb.Message{From: 3, To: 3, Type: pb.MsgHup})\n\n\tassert.Equal(t, StateLeader, n1.state)\n\tassert.Equal(t, StateFollower, n2.state)\n\tassert.Equal(t, StatePreCandidate, n3.state)\n\n\tnt.send(pb.Message{From: 1, To: 3, Type: pb.MsgHeartbeat, Term: n1.Term})\n\n\t// Disrupt the leader so that the stuck peer is freed\n\tassert.Equal(t, StateFollower, n1.state)\n\tassert.Equal(t, n1.Term, n3.Term)\n\n}\n\nfunc testConfChangeCheckBeforeCampaign(t *testing.T, v2 bool) {\n\tnt := newNetwork(nil, nil, nil)\n\tn1 := nt.peers[1].(*raft)\n\tn2 := nt.peers[2].(*raft)\n\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})\n\tassert.Equal(t, StateLeader, n1.state)\n\n\t// Begin to remove the third node.\n\tcc := pb.ConfChange{\n\t\tType:   pb.ConfChangeRemoveNode,\n\t\tNodeID: 2,\n\t}\n\tvar ccData []byte\n\tvar err error\n\tvar ty pb.EntryType\n\tif v2 {\n\t\tccv2 := cc.AsV2()\n\t\tccData, err = ccv2.Marshal()\n\t\tty = pb.EntryConfChangeV2\n\t} else {\n\t\tccData, err = cc.Marshal()\n\t\tty = pb.EntryConfChange\n\t}\n\trequire.NoError(t, err)\n\tnt.send(pb.Message{\n\t\tFrom: 1,\n\t\tTo:   1,\n\t\tType: pb.MsgProp,\n\t\tEntries: []pb.Entry{\n\t\t\t{Type: ty, Data: ccData},\n\t\t},\n\t})\n\n\t// Trigger campaign in node 2\n\tfor i := 0; i < n2.randomizedElectionTimeout; i++ {\n\t\tn2.tick()\n\t}\n\t// It's still follower because committed conf change is not applied.\n\tassert.Equal(t, StateFollower, n2.state)\n\n\t// Transfer leadership to peer 2.\n\tnt.send(pb.Message{From: 2, To: 1, Type: pb.MsgTransferLeader})\n\tassert.Equal(t, StateLeader, n1.state)\n\t// It's still follower because committed conf change is not applied.\n\tassert.Equal(t, StateFollower, n2.state)\n\n\t// Abort transfer leader\n\tfor i := 0; i < n1.electionTimeout; i++ {\n\t\tn1.tick()\n\t}\n\n\t// Advance apply\n\tnextEnts(n2, nt.storage[2])\n\n\t// Transfer leadership to peer 2 again.\n\tnt.send(pb.Message{From: 2, To: 1, Type: pb.MsgTransferLeader})\n\tassert.Equal(t, StateFollower, n1.state)\n\tassert.Equal(t, StateLeader, n2.state)\n\n\tnextEnts(n1, nt.storage[1])\n\t// Trigger campaign in node 2\n\tfor i := 0; i < n1.randomizedElectionTimeout; i++ {\n\t\tn1.tick()\n\t}\n\tassert.Equal(t, StateCandidate, n1.state)\n}\n\n// TestConfChangeCheckBeforeCampaign tests if unapplied ConfChange is checked before campaign.\n// Copyright 2015 The etcd Authors\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\npackage raft\n\nimport pb \"go.etcd.io/raft/v3/raftpb\"\n\n// unstable contains \"unstable\" log entries and snapshot state that has\n// not yet been written to Storage. The type serves two roles. First, it\n// holds on to new log entries and an optional snapshot until they are\n// handed to a Ready struct for persistence. Second, it continues to\n// hold on to this state after it has been handed off to provide raftLog\n// with a view of the in-progress log entries and snapshot until their\n// writes have been stabilized and are guaranteed to be reflected in\n// queries of Storage. After this point, the corresponding log entries\n// and/or snapshot can be cleared from unstable.\n//\n// unstable.entries[i] has raft log position i+unstable.offset.\n// Note that unstable.offset may be less than the highest log\n// position in storage; this means that the next write to storage\n// might need to truncate the log before persisting unstable.entries.\ntype unstable struct {\n\t// the incoming unstable snapshot, if any.\n\tsnapshot *pb.Snapshot\n\t// all entries that have not yet been written to storage.\n\tentries []pb.Entry\n\t// entries[i] has raft log position i+offset.\n\toffset uint64\n\n\t// if true, snapshot is being written to storage.\n\tsnapshotInProgress bool\n\t// entries[:offsetInProgress-offset] are being written to storage.\n\t// Like offset, offsetInProgress is exclusive, meaning that it\n\t// contains the index following the largest in-progress entry.\n\t// Invariant: offset <= offsetInProgress\n\toffsetInProgress uint64\n\n\tlogger Logger\n}\n\n// maybeFirstIndex returns the index of the first possible entry in entries\n// if it has a snapshot.\nfunc (u *unstable) maybeFirstIndex() (uint64, bool) {\n\tif u.snapshot != nil {\n\t\treturn u.snapshot.Metadata.Index + 1, true\n\t}\n\treturn 0, false\n}\n\n// maybeLastIndex returns the last index if it has at least one\n// unstable entry or snapshot.\nfunc (u *unstable) maybeLastIndex() (uint64, bool) {\n\tif l := len(u.entries); l != 0 {\n\t\treturn u.offset + uint64(l) - 1, true\n\t}\n\tif u.snapshot != nil {\n\t\treturn u.snapshot.Metadata.Index, true\n\t}\n\treturn 0, false\n}\n\n// maybeTerm returns the term of the entry at index i, if there\n// is any.\nfunc (u *unstable) maybeTerm(i uint64) (uint64, bool) {\n\tif i < u.offset {\n\t\tif u.snapshot != nil && u.snapshot.Metadata.Index == i {\n\t\t\treturn u.snapshot.Metadata.Term, true\n\t\t}\n\t\treturn 0, false\n\t}\n\n\tlast, ok := u.maybeLastIndex()\n\tif !ok {\n\t\treturn 0, false\n\t}\n\tif i > last {\n\t\treturn 0, false\n\t}\n\n\treturn u.entries[i-u.offset].Term, true\n}\n\n// nextEntries returns the unstable entries that are not already in the process\n// of being written to storage.\nfunc (u *unstable) nextEntries() []pb.Entry {\n\tinProgress := int(u.offsetInProgress - u.offset)\n\tif len(u.entries) == inProgress {\n\t\treturn nil\n\t}\n\treturn u.entries[inProgress:]\n}\n\n// nextSnapshot returns the unstable snapshot, if one exists that is not already\n// in the process of being written to storage.\nfunc (u *unstable) nextSnapshot() *pb.Snapshot {\n\tif u.snapshot == nil || u.snapshotInProgress {\n\t\treturn nil\n\t}\n\treturn u.snapshot\n}\n\n// acceptInProgress marks all entries and the snapshot, if any, in the unstable\n// as having begun the process of being written to storage. The entries/snapshot\n// will no longer be returned from nextEntries/nextSnapshot. However, new\n// entries/snapshots added after a call to acceptInProgress will be returned\n// from those methods, until the next call to acceptInProgress.\nfunc (u *unstable) acceptInProgress() {\n\tif len(u.entries) > 0 {\n\t\t// NOTE: +1 because offsetInProgress is exclusive, like offset.\n\t\tu.offsetInProgress = u.entries[len(u.entries)-1].Index + 1\n\t}\n\tif u.snapshot != nil {\n\t\tu.snapshotInProgress = true\n\t}\nfunc (r *raft) loadState(state pb.HardState) {\n\tif state.Commit < r.raftLog.committed || state.Commit > r.raftLog.lastIndex() {\n\t\tr.logger.Panicf(\"%x state.commit %d is out of range [%d, %d]\", r.id, state.Commit, r.raftLog.committed, r.raftLog.lastIndex())\n\t}\n\tr.raftLog.committed = state.Commit\n\tr.Term = state.Term\n\tr.Vote = state.Vote\n}\n\n// pastElectionTimeout returns true if r.electionElapsed is greater\n// than or equal to the randomized election timeout in\n// [electiontimeout, 2 * electiontimeout - 1].\nfunc (r *raft) pastElectionTimeout() bool {\nfunc (r *raft) committedEntryInCurrentTerm() bool {\n\t// NB: r.Term is never 0 on a leader, so if zeroTermOnOutOfBounds returns 0,\n\t// we won't see it as a match with r.Term.\n\treturn r.raftLog.zeroTermOnOutOfBounds(r.raftLog.term(r.raftLog.committed)) == r.Term\n}\n\n// responseToReadIndexReq constructs a response for `req`. If `req` comes from the peer\n// itself, a blank value will be returned.\nfunc (r *raft) responseToReadIndexReq(req pb.Message, readIndex uint64) pb.Message {\n\tif req.From == None || req.From == r.id {\n\t\tr.readStates = append(r.readStates, ReadState{\n\t\t\tIndex:      readIndex,\n\t\t\tRequestCtx: req.Entries[0].Data,\n\t\t})\n\t\treturn pb.Message{}\n\t}\n\treturn pb.Message{\n\t\tType:    pb.MsgReadIndexResp,\n\t\tTo:      req.From,\n\t\tIndex:   readIndex,\n\t\tEntries: req.Entries,\n\t}\n}\n\n// increaseUncommittedSize computes the size of the proposed entries and\n// determines whether they would push leader over its maxUncommittedSize limit.\n// If the new entries would exceed the limit, the method returns false. If not,\n// the increase in uncommitted entry size is recorded and the method returns\n// true.\n//\n// Empty payloads are never refused. This is used both for appending an empty\n// entry at a new leader's term, as well as leaving a joint configuration.\nfunc (r *raft) increaseUncommittedSize(ents []pb.Entry) bool {\n\t// multiple raft group, each raft group can have its own logger\n\tLogger Logger\n\n\t// DisableProposalForwarding set to true means that followers will drop\n\t// proposals, rather than forwarding them to the leader. One use case for\n\t// this feature would be in a situation where the Raft leader is used to\n\t// compute the data of a proposal, for example, adding a timestamp from a\n\t// hybrid logical clock to data in a monotonically increasing way. Forwarding\n\t// should be disabled to prevent a follower with an inaccurate hybrid\n\t// logical clock from assigning the timestamp and then forwarding the data\n\t// to the leader.\n\tDisableProposalForwarding bool\n\n\t// DisableConfChangeValidation turns off propose-time verification of\n\t// configuration changes against the currently active configuration of the\n\t// raft instance. These checks are generally sensible (cannot leave a joint\n\t// config unless in a joint config, et cetera) but they have false positives\n\t// because the active configuration may not be the most recent\n\t// configuration. This is because configurations are activated during log\n\t// application, and even the leader can trail log application by an\n\t// unbounded number of entries.\n\t// Symmetrically, the mechanism has false negatives - because the check may\n\t// not run against the \"actual\" config that will be the predecessor of the\n\t// newly proposed one, the check may pass but the new config may be invalid\n\t// when it is being applied. In other words, the checks are best-effort.\n\t//\n\t// Users should *not* use this option unless they have a reliable mechanism\n\t// (above raft) that serializes and verifies configuration changes. If an\n\t// invalid configuration change enters the log and gets applied, a panic\n\t// will result.\n\t//\n\t// This option may be removed once false positives are no longer possible.\n\t// See: https://github.com/etcd-io/raft/issues/80\n\tDisableConfChangeValidation bool\n\n\t// StepDownOnRemoval makes the leader step down when it is removed from the\n\t// group or demoted to a learner.\n\t//\n\t// This behavior will become unconditional in the future. See:\n\t// https://github.com/etcd-io/raft/issues/83\n\tStepDownOnRemoval bool\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nsrc('s-election-entry','raft.go',973,1083)\nsrc('s-candidate-follower','raft.go',1666,1775)\nsrc('s-read-acks','raft.go',1572,1610)\nsrc('s-transfer','raft.go',1610,1665)\nsrc('s-replication-send','raft.go',605,710)\nsrc('s-append-receive','raft.go',1786,1834)\nsrc('s-restore','raft.go',1857,1970)\nsrc('s-initial-state','raft.go',437,496)\nsrc('s-load-state','raft.go',2033,2040)\nsrc('s-read-result','raft.go',2062,2090)\nsrc('s-applied-auto','raft.go',740,773)\nsrc('s-log-append','log.go',73,151)\nsrc('s-log-delivery','log.go',218,273)\nsrc('s-log-apply','log.go',320,363)\nsrc('s-log-commit','log.go',438,469)\nsrc('s-tracker','tracker/tracker.go',127,184)\nsrc('s-tally','tracker/tracker.go',245,282)\nsrc('s-joint','quorum/joint.go',17,82)\nsrc('s-majority','quorum/majority.go',115,196)\nsrc('s-conf-change','confchange/confchange.go',29,187)\nsrc('s-conf-progress','confchange/confchange.go',199,281)\nsrc('s-conf-restore','confchange/restore.go',113,157)\nsrc('s-node-completion-contract','node.go',156,189,'interface_statement')\nsrc('s-node-read-contract','node.go',217,230,'interface_statement')\nsrc('s-node-loop','node.go',350,458)\nsrc('s-raw-interface','rawnode.go',30,137,'interface_statement')\nsrc('s-apply-response','rawnode.go',370,401)\nsrc('s-storage-interface','storage.go',37,90,'interface_statement')\nsrc('s-unstable-role','log_unstable.go',19,125)\nsrc('s-doc-caller','doc.go',67,108,'document_statement')\nsrc('s-campaign-test','raft_test.go',3593,3671,'test_expectation')\nsrc('s-config-options','raft.go',256,285,'interface_statement')\nB=[]\ndef b(i,a,owner,ctx,trig,ss,**kw):\n B.append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss,**kw))\nb('b-formation','A1','raft.stepLeader, appendEntry, maybeCommit; ProgressTracker and quorum','Leader term and active simple/joint voter configuration','Proposal admission, durable MsgAppResp, or configuration replacement that calls maybeCommit',['s-proposal-read-admission','s-ack-commit','s-reset-authority','s-tracker','s-majority','s-joint','s-log-commit','s-config-commit'],implementation_guards=['Drop proposals from a removed leader or during transfer; configuration proposal checks use pendingConfIndex and joint status unless explicitly disabled.','MsgAppResp requires tracked sender; Step rejects old-term responses. maybeCommit requires an advancing index with current-term entry and active voting quorums.'],writes=['Assign proposal indexes and current term; append to unstable log; update sender Match and flow control; advance committed index.'],external_effects=['Broadcast append messages after commit advancement.'],important_branches=['Append-reply advancement calls releasePendingReadIndexMessages; switchToConfig advancement does not call that function.','Rejected append replies adjust probe position using index/term hints; duplicate nonadvancing replies need not retry commit.'],async_boundaries=['Self append support is a msgsAfterAppend response, consumed after persistence completion.'],produces_fact_ids=['f-commit'],cross_activity_effects={'A2':'Quorum support and current-term entries constrain decisions made by the active leader.','A5':'Committed indexes delimit application delivery.'})\nb('b-authority','A2','raft.Step, hup, campaign, stepCandidate, reset, tickHeartbeat','Per-node term, role, vote, leader, voter configuration','Timer or Campaign/TimeoutNow; vote replies; higher-term messages; quorum loss',['s-election-entry','s-candidate-follower','s-term-dispatch','s-leadership','s-reset-authority','s-tally','s-joint','s-log-commit','s-restore','s-transfer','s-raw-interface','s-node-loop'],implementation_guards=['promotable requires local nonlearner progress and no pending snapshot; hup refuses unapplied committed configuration entries.','Vote requires acceptable prior vote/leader state and up-to-date candidate log; election result counts current voters in both joint halves.','Pre-votes do not increment local term; granted pre-vote responses may carry a future term. Lease check rejects nontransfer votes while the current leader is recent.'],writes=['A real campaign increments Term and votes for self; self vote is durability-delayed. Won quorum becomes leader and appends an empty entry.','reset discards vote tally, remote progress and readOnly quorum contexts, clears transfer and pendingConfIndex; log and committed prefix survive.'],important_branches=['Candidate steps down on same-term leader append/heartbeat/snapshot. Higher-term non-pre-vote traffic generally makes follower.','Old append-storage replies cannot stabilize entries, but their committed snapshot completion remains usable.','pendingReadIndexMessages is not cleared by reset; it is distinct from readOnly.'],consumes_fact_ids=['f-applied'],cross_activity_effects={'A1':'Resets prevent old match/vote support from being counted in a new leadership context; log freshness constrains future leaders.','A4':'Campaign admission scans only the suffix after raftLog.applied, so correctness depends on what that cursor acknowledges.'},unknowns=['Does permitted early Node.Advance allow the election configuration scan to omit configuration work still awaiting ApplyConfChange?'])\nb('b-membership','A4','raft.applyConfChange/switchToConfig and confchange.Changer','Applied configuration; incoming/outgoing voters and staged learners','Caller applies a committed configuration entry or initialization/snapshot restores ConfState',['s-conf-change','s-conf-progress','s-conf-restore','s-restore','s-config-commit','s-proposal-read-admission','s-applied-auto','s-node-completion-contract','s-config-options'],legal_preconditions=['Apply committed changes in application order; disabled proposal validation requires caller serialization/verification.'],writes=['Simple changes affect at most one voter; joint changes retain outgoing voters, and leave-joint promotes staged learners and removes obsolete progress.','switchToConfig replaces the tracker and local learner status.'],important_branches=['Removed/demoted leader steps down only if configured, then returns; removed leader cannot admit proposals.','Retained leader recalculates commit with new quorum or probes peers, and aborts transfer if target is no longer a voter.','appliedTo may propose automatic leave-joint; this requires AutoLeave and leader role and sufficient applied progress.'],cross_activity_effects={'A1':'Reinterprets existing Match support against changed voting quorums.','A2':'Controls election eligibility and voting quorums; configuration application and applied cursor acknowledgement are separate calls.'})\nb('b-recovery','A3','raft replication handlers, maybeSendAppend, maybeSendSnapshot and restore','Follower log matching and snapshot recovery','Incoming append/heartbeat/snapshot; leader retry from rejection, heartbeat or transport report',['s-replication-send','s-append-receive','s-log-append','s-restore','s-transfer','s-read-acks'],implementation_guards=['Append predecessor term must match; conflicting committed entries panic; incoming commit is bounded by matched appended extent.','Heartbeat commit sent is min(peer Match, leader commit). Snapshot restore rejects stale indexes and missing recipient membership.'],writes=['Uncommitted conflicting suffix is replaced; snapshot can fast-forward an already matching committed prefix or replace unstable log and restore configuration.'],external_effects=['Append responses enter the durability-delayed queue; heartbeat echoes read context. Snapshot/probe transitions and heartbeat-triggered empty appends allow retries after loss.'],produces_fact_ids=['f-commit'],cross_activity_effects={'A1':'Follower acknowledgements supply log support; learned commitment is distinct from local quorum calculation.','A2':'Snapshots restore membership while preserving committed history.'})\nb('b-persistence','A6','RawNode readyWithoutAccept/newStorageAppendMsg; external storage owner; raft.Step','Stable storage and in-progress unstable data across terms','Ready emission and subsequent Advance or ordered append-worker responses',['s-durable-send','s-ready-output','s-storage-response','s-ready-completion','s-term-dispatch','s-async-contract','s-storage-interface','s-unstable-role','s-initial-state','s-load-state'],legal_preconditions=['Storage presents persisted log and initial HardState/ConfState. Async append requests to one local worker are reliable and ordered; response-carrying writes are durable before responses.'],writes=['Ready acceptance marks unstable data in progress, clears emitted message queues and tracks HardState; completion stabilizes matching indexes and terms.'],important_branches=['Synchronous Ready includes external durability-delayed responses while self-responses are deferred to Advance.','Async append response carries current Raft term as well as entry term/index to reject stale completions after intervening overwrite histories.','Restart reconstructs log, configuration, term/vote/commit and caller-supplied Applied; becomes follower.'],cross_activity_effects={'A1':'Durability-delayed append replies qualify counted support.','A2':'Persistent term/vote and delayed vote publication constrain repeat voting across crashes.'},unknowns=['README/doc.go permit same-batch send/persist overlap while Ready requires entries before messages; which usage contract governs that overlap remains disputed.'])\nb('b-application','A5','RawNode Ready/acceptReady/Advance; raft.appliedTo; application or async apply worker','Committed, applying and applied cursors; configuration callback is a separate API','Ready committed entry delivery, synchronous Advance, or MsgStorageApplyResp',['s-log-delivery','s-log-apply','s-apply-response','s-ready-completion','s-applied-auto','s-node-completion-contract','s-node-loop','s-raw-interface'],consumes_fact_ids=['f-commit'],produces_fact_ids=['f-applied'],implementation_guards=['Do not return application entries while snapshot is pending. Async application is limited to locally stable entries. Application quota pauses delivery until acknowledgement.'],writes=['acceptReady updates applying and quota. Advance steps a prebuilt MsgStorageApplyResp; appliedTo raises applied to max(previous, result index), releases quota, and may trigger auto-leave.'],important_branches=['The cursor update itself does not invoke ApplyConfChange. Caller separately applies membership through that API.','Node contract permits Advance before application completes while requiring application batches to finish in order; RawNode.Advance describes notification that entries have been applied and saved.'],cross_activity_effects={'A2':'Election guard uses applied cursor as lower bound for scanning unapplied committed configurations.','A4':'Configuration proposal admission and automatic leave-joint consult applied cursor.'},unknowns=['Whether early Advance excludes configuration-containing batches is not stated in the read Node contract; stricter RawNode wording and tests must be reconciled.'])\nb('b-reads','A7','Node/RawNode ReadIndex, raft stepLeader, readOnly and consumer','Unique request context, current leadership term, quorum or configured lease','Local/forwarded read request; first current-term commit; matching heartbeat replies',['s-node-read-contract','s-proposal-read-admission','s-release-reads','s-read-correlation','s-read-acks','s-read-result','s-candidate-follower','s-ready-contract'],consumes_fact_ids=['f-commit'],implementation_guards=['Multi-voter leader queues requests until an entry in its term commits. Safe mode registers context, self ack and heartbeat; current voting quorums must acknowledge.','Singleton directly returns committed index. Lease mode relies on configured lease assumptions.'],writes=['ReadState or MsgReadIndexResp retains request context and selected committed index.'],async_boundaries=['Caller waits until application passes the returned index; Node documents silent read request loss and caller retry with fresh context.'],cross_activity_effects={'A1':'Safe read authorization [REDACTED] context-bound voter responses.','A2':'Reset clears active read quorum contexts; queued pre-current-term requests are distinct and can survive reset.'},unknowns=['Can configuration-driven first current-term commitment occur under any legal early-Advance history, leaving precommit requests queued without a later advancement? No bounded completion obligation is inferred because Node explicitly allows loss.'])\nF=[dict(id='f-commit',meaning='Local raftLog.committed marks the prefix treated as committed by this instance. Leader advancement uses current-term quorum support; followers learn it from matched append/heartbeat or snapshots. Advancing this cursor does not uniformly release pending reads.',identity={'group':'one Raft instance','index':'log prefix ending at committed'},validity_context='Prefix persists across terms; fresh leader can only directly advance through an index matching its own term under the active voter quorum. Follower paths rely on valid protocol messages and producer bounds.',representation=['raftLog.committed'],durability='HardState.Commit and snapshot metadata are caller-persisted; cursor change is in-memory until persistence.',recovery='newRaft/loadState and snapshot restoration reconstruct committed prefix.',source_ids=['s-log-commit','s-log-append','s-append-receive','s-restore','s-load-state','s-ack-commit','s-config-commit']),dict(id='f-applied',meaning='raftLog.applied records the highest application progress acknowledged to the core. Advance constructs that acknowledgement from the accepted Ready batch, while async apply responses return completed worker entries. The cursor update does not establish that ApplyConfChange has been invoked.',identity={'node':'local Raft instance','index':'acknowledged applied prefix'},validity_context='Committed entries remain valid across term changes. Caller completion policy determines whether acknowledgement coincides with completed state-machine/configuration application; Node explicitly permits some early Advance.',representation=['raftLog.applied','stepsOnAdvance MsgStorageApplyResp','MsgStorageApplyResp.Entries'],durability='Volatile cursor; caller may supply Config.Applied on restart.',recovery='Initialization uses storage compaction boundary and optional Config.Applied; completed snapshots also advance application accounting.',source_ids=['s-log-apply','s-apply-response','s-ready-completion','s-node-completion-contract','s-applied-auto','s-initial-state'],unknowns=['Does the caller contract permit advancing the cursor past committed membership entries before ApplyConfChange, and if so what protects elections during the interval?'])]\nroles=json.load(open('../research.json'))['activity_roles']\nacts=[dict(class_id=a,applicability='applicable',purpose=v['relation'],realization_summary={ 'A1':'Proposal/append acknowledgement and active quorum commit computation.', 'A2':'Terms, elections, lease checks, transfers and role reset.', 'A3':'Log matching, retries and snapshot restoration.', 'A4':'Simple and joint voter transitions on application.', 'A5':'Committed delivery and application acknowledgement.', 'A6':'Unstable storage bridge and restart reconstruction; physical disk IO is external.', 'A7':'Read/proposal API and caller completion; actual application endpoint is external.'}[a],source_ids=list(dict.fromkeys(s for x in B if x['primary_activity']==a for s in x['source_ids']))) for a,v in roles.items()]\ndef path(ex,bs,fs,ss):return dict(explanation=ex,behavior_ids=bs,fact_ids=fs,source_ids=ss)\nm=dict(version=1,target_profile=dict(system_boundary='Captured go.etcd.io/raft/v3 library: serialized RawNode core and channel-owned Node wrapper, tracker/quorum/confchange, log/unstable and MemoryStorage interface support. Network delivery, actual durability and client state machine are caller responsibilities, not inspected external implementations.',protocol_contexts=['Per-group term, role, leader and log index/term','Simple or joint voting membership, learners and staged learners','Synchronous Ready/Advance or AsyncStorageWrites worker messages'],external_interfaces=['Node','RawNode','Storage','Ready','raftpb.Message'],ownership=['Node.run serializes events; RawNode is thread-unsafe and must be caller-serialized.','Caller owns transport and durable storage and applies configuration entries.'],source_ids=['s-raw-interface','s-node-loop','s-storage-interface','s-async-contract','s-node-completion-contract']),activities=acts,behaviors=B,facts=F,surfaces=[dict(entry_point='raft.switchToConfig pending read release',disposition='mapped',behavior_ids=['b-membership','b-reads','b-formation'],reason='Different commit producers have different read-release effects. Legal first-current-term commit history remains relevant; no completion guarantee assumed.',source_ids=['s-config-commit','s-ack-commit','s-release-reads']),dict(entry_point='Node.Advance before ApplyConfChange',disposition='mapped',behavior_ids=['b-application','b-authority','b-membership'],reason='Early completion acknowledgement may hide committed membership entries from the campaign scan. Applicability and legal history are unresolved.',source_ids=['s-node-completion-contract','s-election-entry','s-ready-completion']),dict(entry_point='Ready synchronous message persistence ordering',disposition='UNCLASSIFIED_PROTOCOL_RESPONSIBILITY',reason='README and doc.go overlap permission conflicts with stronger Ready ordering. Preserve conflicting contracts before any executable allegation.',source_ids=['s-readme-caller','s-doc-caller','s-ready-contract'],high_consequence=True)],core_overview=dict(status='usable',formation=path('Leader admits proposals, assigns term/index and emits append requests. Followers match predecessors, protect committed prefixes and defer append support until persistence. Leader tracks qualified replies and selects the active majority or both joint majorities, committing only an advancing current-term entry. It propagates commit through appends and bounded heartbeats; Ready/application consumes the prefix separately. Retry/probe/snapshot paths recover lagging replicas. Configuration application can recalculate commit with different quorum eligibility, but unlike append-reply advancement it does not release queued precommit reads.',['b-formation','b-recovery','b-persistence','b-membership','b-application'],['f-commit'],['s-ack-commit','s-log-commit','s-tracker','s-joint','s-replication-send','s-append-receive','s-ready-output','s-config-commit']),context=path('Campaigns require promotable membership and scan committed entries after applied for pending configurations. Real campaigns persist votes, aggregate eligible votes and elect an up-to-date leader; pre-vote preserves the term until support is obtained. Higher terms, same-term leader traffic to candidates and quorum loss remove authority; transfer requires caught-up target and times out. Reset clears per-election votes, remote match, read quorum contexts and transfer. Old-term messages cannot contribute ordinary support; committed log prefixes and old snapshot completion survive. Recovery rebuilds term/vote/configuration/log from caller storage.',['b-authority','b-membership','b-persistence','b-recovery'],['f-applied','f-commit'],['s-election-entry','s-candidate-follower','s-term-dispatch','s-leadership','s-reset-authority','s-transfer','s-initial-state','s-restore']),connection=path('Election log freshness and persistent term/vote constrain who may form future decisions; current-term commit and active voter quorums constrain advancement by that leader. Configurations take effect via ApplyConfChange, not at append. Their applied-history bookkeeping is consumed by campaign admission and proposal serialization. Thus application acknowledgement is authority-relevant. Delayed storage messages carry term/context to avoid using obsolete support, while committed decisions and application work are term-independent. Safe reads wait for current-term commitment and quorum context; pending precommit messages differ from the resettable readOnly map.',['b-authority','b-formation','b-membership','b-application','b-persistence','b-reads'],['f-applied','f-commit'],['s-election-entry','s-node-completion-contract','s-ready-completion','s-config-commit','s-storage-response','s-release-reads','s-read-acks']),core_gaps=[],open_details=['Applicability of early Advance before committed membership application and its effect on campaign eligibility.','Contract conflict on synchronous same-batch send/persist overlap.','Pending reads retained across reset and configuration-driven commit: narrower legal histories and permitted request loss need investigation.','Detailed storage failures, compaction concurrency, lease-clock bounds and special bootstrap histories remain outside this initial backbone.'],rationale='Representative formation and authority paths, their membership/persistence dependencies, old-work treatment, retries and consumption are sourced. Local completion-contract anomalies remain explicit rather than becoming unconditional Fact guarantees.'))\njson.dump(m,open('map.json','w'),indent=2)\nq=dict(question='When Node.Advance is used before application finishes, can raftLog.applied cause campaign admission to skip a committed configuration entry whose ApplyConfChange is still pending, and what caller obligation or alternative mechanism prevents stale-membership authority?',importance='If legally reachable, stale-membership campaigning could undermine eligibility and later quorum formation. This is potential consequence; neither a safety violation nor a legal execution history is established.',trigger_rationale='Node.Advance explicitly permits early acknowledgement; RawNode accepts that acknowledgement as MsgStorageApplyResp and hup scans only after applied. The separate ApplyConfChange callback supplies actual membership. Source contract investigation is cheaper and more decisive than an immediate safety test; the earlier queued-read discrepancy also depends on this premise, whereas synchronous persistence overlap has an independent unresolved contract conflict.',disposition='needs_specific_evidence',preferred_check='source_review',source_ids=['s-node-completion-contract','s-raw-interface','s-ready-completion','s-apply-response','s-election-entry','s-campaign-test','s-node-loop'],participants=['Application driving Node/RawNode','Local follower or candidate','Voting peers'],objects=['Ready.CommittedEntries containing a configuration change','raftLog.applied','tracker.Config'],contexts=['AsyncStorageWrites=false','Serialized caller with durable Ready storage and application batches kept in order','Advance before pending ApplyConfChange'],event_paths=['Committed configuration delivered in Ready -> storage completed -> early Advance -> applied cursor advanced -> campaign before ApplyConfChange'],activity_classes=['A2','A5','A4'],behavior_ids=['b-application','b-authority'],fact_ids=['f-applied'],supporting_behavior_ids={'b-membership':'Actual voting configuration changes only through the separately applied callback, explaining why acknowledged progress may diverge from authority context.','b-persistence':'The legal prefix must finish persistence even if state-machine application is still pending.'},obligation_relation_kind='consumption',counterevidence=['hup explicitly refuses committed configurations after applied.','RawNode.Advance wording says application has applied and saved progress; async apply responses explicitly require completed application.','Node.ApplyConfChange must be called when a committed configuration is observed, which may constrain the timing despite the general early-Advance permission.','Existing campaign test acknowledges application before allowing campaign; its helper behavior must be examined before interpreting it as a configuration-completion requirement.'],unknowns=['Does early-Advance permission cover membership-bearing batches or only ordinary commands/snapshots?','Does a source-backed legal API history reach campaigning before the actual membership callback despite all caller requirements?','If reachable, is the responsibility local campaign eligibility or only a broader consensus property requiring an additional producer history?'],priority=3)\nx=dict(action='continue',rationale='Establish the usable both-core map and select the concrete application-progress/authority premise without asserting a defect.',map_path='map.json',sources=sources,question=q,feedback=dict(ref_ids=['b-application','b-authority','b-reads','s-node-completion-contract','s-node-read-contract','s-election-entry'],answered='Completed source tracing for the representative formation/context backbone. The pending-read observation has a nontrivial protective premise: with completion-before-Advance, unapplied committed configurations block election, while committing previously uncommitted old configuration entries first requires a current-term leader commit that already releases reads. Node also explicitly allows silent ReadIndex loss, so an omitted release alone cannot establish bounded liveness. Early Advance is now the narrower authority premise to investigate; it can update the applied cursor independently of actual ApplyConfChange. This is a contract/history question, not a finding.',remaining=['Resolve early-Advance applicability and inspect the existing test helper before constructing a controlled schedule.','Preserve synchronous persistence-order contract conflict as an independent unmapped responsibility surface.'],understanding='updated',rationale='Map facts preserve acknowledged progress rather than assuming completed membership application. First Candidate focuses on its consumption in election admission.'))\njson.dump(x,open('submission.json','w'),indent=2)\nPY\n/usr/bin/python3 build_map.py\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-03_09-49-03-etcd_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nsrc('s-election-entry','raft.go',973,1083)\nsrc('s-candidate-follower','raft.go',1666,1775)\nsrc('s-read-acks','raft.go',1572,1610)\nsrc('s-transfer','raft.go',1610,1665)\nsrc('s-replication-send','raft.go',605,710)\nsrc('s-append-receive','raft.go',1786,1834)\nsrc('s-restore','raft.go',1857,1970)\nsrc('s-initial-state','raft.go',437,496)\nsrc('s-load-state','raft.go',2033,2040)\nsrc('s-read-result','raft.go',2062,2090)\nsrc('s-applied-auto','raft.go',740,773)\nsrc('s-log-append','log.go',73,151)\nsrc('s-log-delivery','log.go',218,273)\nsrc('s-log-apply','log.go',320,363)\nsrc('s-log-commit','log.go',438,469)\nsrc('s-tracker','tracker/tracker.go',127,184)\nsrc('s-tally','tracker/tracker.go',245,282)\nsrc('s-joint','quorum/joint.go',17,82)\nsrc('s-majority','quorum/majority.go',115,196)\nsrc('s-conf-change','confchange/confchange.go',29,187)\nsrc('s-conf-progress','confchange/confchange.go',199,281)\nsrc('s-conf-restore','confchange/restore.go',113,157)\nsrc('s-node-completion-contract','node.go',156,189,'interface_statement')\nsrc('s-node-read-contract','node.go',217,230,'interface_statement')\nsrc('s-node-loop','node.go',350,458)\nsrc('s-raw-interface','rawnode.go',30,137,'interface_statement')\nsrc('s-apply-response','rawnode.go',370,401)\nsrc('s-storage-interface','storage.go',37,90,'interface_statement')\nsrc('s-unstable-role','log_unstable.go',19,125)\nsrc('s-doc-caller','doc.go',67,108,'document_statement')\nsrc('s-campaign-test','raft_test.go',3593,3671,'test_expectation')\nsrc('s-config-options','raft.go',256,285,'interface_statement')\nB=[]\ndef b(i,a,owner,ctx,trig,ss,**kw):\n B.append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss,**kw))\nb('b-formation','A1','raft.stepLeader, appendEntry, maybeCommit; ProgressTracker and quorum','Leader term and active simple/joint voter configuration','Proposal admission, durable MsgAppResp, or configuration replacement that calls maybeCommit',['s-proposal-read-admission','s-ack-commit','s-reset-authority','s-tracker','s-majority','s-joint','s-log-commit','s-config-commit'],implementation_guards=['Drop proposals from a removed leader or during transfer; configuration proposal checks use pendingConfIndex and joint status unless explicitly disabled.','MsgAppResp requires tracked sender; Step rejects old-term responses. maybeCommit requires an advancing index with current-term entry and active voting quorums.'],writes=['Assign proposal indexes and current term; append to unstable log; update sender Match and flow control; advance committed index.'],external_effects=['Broadcast append messages after commit advancement.'],important_branches=['Append-reply advancement calls releasePendingReadIndexMessages; switchToConfig advancement does not call that function.','Rejected append replies adjust probe position using index/term hints; duplicate nonadvancing replies need not retry commit.'],async_boundaries=['Self append support is a msgsAfterAppend response, consumed after persistence completion.'],produces_fact_ids=['f-commit'],cross_activity_effects={'A2':'Quorum support and current-term entries constrain decisions made by the active leader.','A5':'Committed indexes delimit application delivery.'})\nb('b-authority','A2','raft.Step, hup, campaign, stepCandidate, reset, tickHeartbeat','Per-node term, role, vote, leader, voter configuration','Timer or Campaign/TimeoutNow; vote replies; higher-term messages; quorum loss',['s-election-entry','s-candidate-follower','s-term-dispatch','s-leadership','s-reset-authority','s-tally','s-joint','s-log-commit','s-restore','s-transfer','s-raw-interface','s-node-loop'],implementation_guards=['promotable requires local nonlearner progress and no pending snapshot; hup refuses unapplied committed configuration entries.','Vote requires acceptable prior vote/leader state and up-to-date candidate log; election result counts current voters in both joint halves.','Pre-votes do not increment local term; granted pre-vote responses may carry a future term. Lease check rejects nontransfer votes while the current leader is recent.'],writes=['A real campaign increments Term and votes for self; self vote is durability-delayed. Won quorum becomes leader and appends an empty entry.','reset discards vote tally, remote progress and readOnly quorum contexts, clears transfer and pendingConfIndex; log and committed prefix survive.'],important_branches=['Candidate steps down on same-term leader append/heartbeat/snapshot. Higher-term non-pre-vote traffic generally makes follower.','Old append-storage replies cannot stabilize entries, but their committed snapshot completion remains usable.','pendingReadIndexMessages is not cleared by reset; it is distinct from readOnly.'],consumes_fact_ids=['f-applied'],cross_activity_effects={'A1':'Resets prevent old match/vote support from being counted in a new leadership context; log freshness constrains future leaders.','A4':'Campaign admission scans only the suffix after raftLog.applied, so correctness depends on what that cursor acknowledges.'},unknowns=['Does permitted early Node.Advance allow the election configuration scan to omit configuration work still awaiting ApplyConfChange?'])\nb('b-membership','A4','raft.applyConfChange/switchToConfig and confchange.Changer','Applied configuration; incoming/outgoing voters and staged learners','Caller applies a committed configuration entry or initialization/snapshot restores ConfState',['s-conf-change','s-conf-progress','s-conf-restore','s-restore','s-config-commit','s-proposal-read-admission','s-applied-auto','s-node-completion-contract','s-config-options'],legal_preconditions=['Apply committed changes in application order; disabled proposal validation requires caller serialization/verification.'],writes=['Simple changes affect at most one voter; joint changes retain outgoing voters, and leave-joint promotes staged learners and removes obsolete progress.','switchToConfig replaces the tracker and local learner status.'],important_branches=['Removed/demoted leader steps down only if configured, then returns; removed leader cannot admit proposals.','Retained leader recalculates commit with new quorum or probes peers, and aborts transfer if target is no longer a voter.','appliedTo may propose automatic leave-joint; this requires AutoLeave and leader role and sufficient applied progress.'],cross_activity_effects={'A1':'Reinterprets existing Match support against changed voting quorums.','A2':'Controls election eligibility and voting quorums; configuration application and applied cursor acknowledgement are separate calls.'})\nb('b-recovery','A3','raft replication handlers, maybeSendAppend, maybeSendSnapshot and restore','Follower log matching and snapshot recovery','Incoming append/heartbeat/snapshot; leader retry from rejection, heartbeat or transport report',['s-replication-send','s-append-receive','s-log-append','s-restore','s-transfer','s-read-acks'],implementation_guards=['Append predecessor term must match; conflicting committed entries panic; incoming commit is bounded by matched appended extent.','Heartbeat commit sent is min(peer Match, leader commit). Snapshot restore rejects stale indexes and missing recipient membership.'],writes=['Uncommitted conflicting suffix is replaced; snapshot can fast-forward an already matching committed prefix or replace unstable log and restore configuration.'],external_effects=['Append responses enter the durability-delayed queue; heartbeat echoes read context. Snapshot/probe transitions and heartbeat-triggered empty appends allow retries after loss.'],produces_fact_ids=['f-commit'],cross_activity_effects={'A1':'Follower acknowledgements supply log support; learned commitment is distinct from local quorum calculation.','A2':'Snapshots restore membership while preserving committed history.'})\nb('b-persistence','A6','RawNode readyWithoutAccept/newStorageAppendMsg; external storage owner; raft.Step','Stable storage and in-progress unstable data across terms','Ready emission and subsequent Advance or ordered append-worker responses',['s-durable-send','s-ready-output','s-storage-response','s-ready-completion','s-term-dispatch','s-async-contract','s-storage-interface','s-unstable-role','s-initial-state','s-load-state'],legal_preconditions=['Storage presents persisted log and initial HardState/ConfState. Async append requests to one local worker are reliable and ordered; response-carrying writes are durable before responses.'],writes=['Ready acceptance marks unstable data in progress, clears emitted message queues and tracks HardState; completion stabilizes matching indexes and terms.'],important_branches=['Synchronous Ready includes external durability-delayed responses while self-responses are deferred to Advance.','Async append response carries current Raft term as well as entry term/index to reject stale completions after intervening overwrite histories.','Restart reconstructs log, configuration, term/vote/commit and caller-supplied Applied; becomes follower.'],cross_activity_effects={'A1':'Durability-delayed append replies qualify counted support.','A2':'Persistent term/vote and delayed vote publication constrain repeat voting across crashes.'},unknowns=['README/doc.go permit same-batch send/persist overlap while Ready requires entries before messages; which usage contract governs that overlap remains disputed.'])\nb('b-application','A5','RawNode Ready/acceptReady/Advance; raft.appliedTo; application or async apply worker','Committed, applying and applied cursors; configuration callback is a separate API','Ready committed entry delivery, synchronous Advance, or MsgStorageApplyResp',['s-log-delivery','s-log-apply','s-apply-response','s-ready-completion','s-applied-auto','s-node-completion-contract','s-node-loop','s-raw-interface'],consumes_fact_ids=['f-commit'],produces_fact_ids=['f-applied'],implementation_guards=['Do not return application entries while snapshot is pending. Async application is limited to locally stable entries. Application quota pauses delivery until acknowledgement.'],writes=['acceptReady updates applying and quota. Advance steps a prebuilt MsgStorageApplyResp; appliedTo raises applied to max(previous, result index), releases quota, and may trigger auto-leave.'],important_branches=['The cursor update itself does not invoke ApplyConfChange. Caller separately applies membership through that API.','Node contract permits Advance before application completes while requiring application batches to finish in order; RawNode.Advance describes notification that entries have been applied and saved.'],cross_activity_effects={'A2':'Election guard uses applied cursor as lower bound for scanning unapplied committed configurations.','A4':'Configuration proposal admission and automatic leave-joint consult applied cursor.'},unknowns=['Whether early Advance excludes configuration-containing batches is not stated in the read Node contract; stricter RawNode wording and tests must be reconciled.'])\nb('b-reads','A7','Node/RawNode ReadIndex, raft stepLeader, readOnly and consumer','Unique request context, current leadership term, quorum or configured lease','Local/forwarded read request; first current-term commit; matching heartbeat replies',['s-node-read-contract','s-proposal-read-admission','s-release-reads','s-read-correlation','s-read-acks','s-read-result','s-candidate-follower','s-ready-contract'],consumes_fact_ids=['f-commit'],implementation_guards=['Multi-voter leader queues requests until an entry in its term commits. Safe mode registers context, self ack and heartbeat; current voting quorums must acknowledge.','Singleton directly returns committed index. Lease mode relies on config