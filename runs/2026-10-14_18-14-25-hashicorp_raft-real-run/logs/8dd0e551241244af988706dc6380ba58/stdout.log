recovered_config\\\",\\\"conditions\\\":[{\\\"field\\\":\\\"restore_committed_logs\\\",\\\"value\\\":False},{\\\"field\\\":\\\"latest_config_voters\\\",\\\"value\\\":3}]}],\n \\\"comparisons\\\":[{\\\"event\\\":\\\"assurance.authority.attempt.empty_config\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"admit_empty_config\\\",\\\"assertion\\\":{\\\"field\\\":\\\"attempted_candidacy\\\",\\\"value\\\":True},\\\"description\\\":\\\"With the premise held explicitly - a non-zero persisted commit index at A's restart - a voter whose log establishes the configuration must still attempt candidacy once the other voters are gone.\\\"},{\\\"event\\\":\\\"assurance.authority.attempt.recovered_config\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"admit_recovered_config\\\",\\\"assertion\\\":{\\\"field\\\":\\\"attempted_candidacy\\\",\\\"value\\\":True},\\\"description\\\":\\\"Control: the same node with the same log restarted with the replay disabled recovers its configuration and attempts candidacy.\\\"}]}\njson.dump({\\\"rationale\\\":\\\"Reports the repeat of the multi-node experiment honestly (three cases reproduced identically, the authority witness did not because its precondition failed), states that precondition in the authority paragraph, and submits the revised experiment with a deterministic premise.\\\",\\\"interpretations\\\":[cfg],\\\"experiment\\\":exp},open('update27.json','w'),indent=2)\nprint('written execs',len(cfg['executions']),'ce',len(cfg['counterevidence']),'lim',len(cfg['limitations']))\nPY\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_18-14-25-hashicorp_raft-real-run && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_18-14-25-hashicorp_raft-real-run --submission update27.json 2>&1 | python3 -c \\\"\nimport sys,json; d=json.load(sys.stdin)\nprint('valid',d['valid'],'no_change',d.get('no_change'),'exec',d.get('execution_requested'))\nfor x in d.get('diagnostics',[])[:8]: print(x['paths'],x['message'])\nprint([(e['object'],e['action']) for e in d.get('effects',[])])\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
