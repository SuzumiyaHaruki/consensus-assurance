t(target)+64 {\n\\\\t\\\\tif err := r.Apply([]byte(\\\"x\\\"), 0).Error(); err \"'!= nil {\n'\"\\\\t\\\\t\\\\tt.Fatalf(\\\"prefix apply %d failed: %v\\\", applied, err)\n\\\\t\\\\t}\n\\\\t\\\\tapplied++\n\\\\t\\\\tstaged, _ = stores.logs.GetCommitIndex()\n\\\\t}\n\\\\tlastIndex, err := stores.logs.LastIndex()\n\\\\tif err \"'!= nil {\n'\"\\\\t\\\\tt.Fatalf(\\\"LastIndex failed: %v\\\", err)\n\\\\t}\n\\\\tsnapIndex, _ := r.getLastSnapshot()\n\\\\tassuranceEmit(assuranceEvent{\n\\\\t\\\\t\\\"event\\\":               \\\"assurance.boundary.prefix.\\\" + caseName,\n\\\\t\\\\t\\\"case\\\":                caseName,\n\\\\t\\\\t\\\"commands_applied\\\":    applied,\n\\\\t\\\\t\\\"target_replay\\\":       target,\n\\\\t\\\\t\\\"log_last_index\\\":      lastIndex,\n\\\\t\\\\t\\\"staged_commit_index\\\": staged,\n\\\\t\\\\t\\\"snapshot_index\\\":      snapIndex,\n\\\\t\\\\t\\\"max_append_entries\\\":  maxAppendEntries,\n\\\\t\\\\t\\\"replay_entries\\\":      staged - snapIndex,\n\\\\t\\\\t\\\"replay_batches\\\":      (staged - snapIndex + uint64(maxAppendEntries) - 1) / uint64(maxAppendEntries),\n\\\\t})\n\\\\tif err := r.Shutdown().Error(); err \"'!= nil {\n'\"\\\\t\\\\tt.Fatalf(\\\"prefix shutdown failed: %v\\\", err)\n\\\\t}\n\\\\treturn stores\n}\n\n// TestAssuranceRestoreCommittedLogsReplayBoundary places the flag-on replay exactly on the\n// two sides of the 128-batch channel capacity at MaxAppendEntries 16: 2048 replayed entries\n// need 128 batches and must return, 2049 need 129 and are expected to block.\nfunc TestAssuranceRestoreCommittedLogsReplayBoundary(t *testing.T) {\n\\\\tconst maxAppendEntries = 16\n\\\\tfor _, target := range []uint64{2048, 2049} {\n\\\\t\\\\tcaseName := fmt.Sprintf(\\\"boundary_%d\\\", target)\n\\\\t\\\\tstores := assuranceBuildReplayPrefixToTarget(t, caseName, target, maxAppendEntries)\n\\\\t\\\\tstaged, _ := stores.logs.GetCommitIndex()\n\\\\t\\\\t_, trans := NewInmemTransport(stores.addr)\n\\\\t\\\\tconf := *stores.conf\n\\\\t\\\\tconf.RestoreCommittedLogs = true\n\n\\\\t\\\\tassuranceEmit(assuranceEvent{\n\\\\t\\\\t\\\\t\\\"event\\\":                  \\\"assurance.boundary.restart.\\\" + caseName,\n\\\\t\\\\t\\\\t\\\"case\\\":                   caseName,\n\\\\t\\\\t\\\\t\\\"restore_committed_logs\\\": true,\n\\\\t\\\\t\\\\t\\\"max_append_entries\\\":     maxAppendEntries,\n\\\\t\\\\t\\\\t\\\"replay_entries\\\":         staged,\n\\\\t\\\\t\\\\t\\\"replay_batches\\\":         (staged + uint64(maxAppendEntries) - 1) / uint64(maxAppendEntries),\n\\\\t\\\\t})\n\n\\\\t\\\\tch := make(chan assuranceReplayResult, 1)\n\\\\t\\\\tgo func() {\n\\\\t\\\\t\\\\tstart := time.Now()\n\\\\t\\\\t\\\\tr, err := NewRaft(&conf, &MockFSM{}, stores.logs, stores.stable, stores.snaps, trans)\n\\\\t\\\\t\\\\tch <- assuranceReplayResult{raft: r, err: err, elapsed: time.Since(start).Milliseconds(), returned: true}\n\\\\t\\\\t}()\n\\\\t\\\\tconst waitMS = 8000\n\\\\t\\\\tvar res assuranceReplayResult\n\\\\t\\\\tselect {\n\\\\t\\\\tcase res = <-ch:\n\\\\t\\\\tcase <-time.After(waitMS * time.Millisecond):\n\\\\t\\\\t}\n\\\\t\\\\toutcome := assuranceEvent{\n\\\\t\\\\t\\\\t\\\"event\\\":                  \\\"assurance.boundary.outcome.\\\" + caseName,\n\\\\t\\\\t\\\\t\\\"case\\\":                   caseName,\n\\\\t\\\\t\\\\t\\\"restore_committed_logs\\\": true,\n\\\\t\\\\t\\\\t\\\"max_append_entries\\\":     maxAppendEntries,\n\\\\t\\\\t\\\\t\\\"new_raft_returned\\\":      res.returned,\n\\\\t\\\\t\\\\t\\\"wait_ms\\\":                waitMS,\n\\\\t\\\\t}\n\\\\t\\\\tif res.returned {\n\\\\t\\\\t\\\\toutcome[\\\"elapsed_ms\\\"] = res.elapsed\n\\\\t\\\\t} else {\n\\\\t\\\\t\\\\tbuf := make([]byte, 1<<20)\n\\\\t\\\\t\\\\tn := runtime.Stack(buf, true)\n\\\\t\\\\t\\\\texcerpt, mentions := assuranceStackExcerpt(string(buf[:n]), \\\"restoreFromCommittedLogs\\\")\n\\\\t\\\\t\\\\toutcome[\\\"stack_mentions\\\"] = mentions\n\\\\t\\\\t\\\\toutcome[\\\"blocked_excerpt\\\"] = excerpt\n\\\\t\\\\t}\n\\\\t\\\\tassuranceEmit(outcome)\n\\\\t\\\\tif res.returned && res.raft \"'!= nil {\n'\"\\\\t\\\\t\\\\t_ = res.raft.Shutdown().Error()\n\\\\t\\\\t}\n\\\\t}\n}\n'''\nopen(p,'w').write(s)\nprint('appended')\nPY\ngofmt -l assurance_generated_test.go; echo fmt-check; grep -n \\\"\"'^func TestAssurance\" assurance_generated_test.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
