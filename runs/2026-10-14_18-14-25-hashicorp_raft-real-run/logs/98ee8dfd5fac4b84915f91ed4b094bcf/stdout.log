lastTerm = req.log.Term\n   125\t\t}\n   126\t\n   127\t\tapplyBatch := func(reqs []*commitTuple) {\n   128\t\t\tif !batchingEnabled {\n   129\t\t\t\tfor _, ct := range reqs {\n   130\t\t\t\t\tapplySingle(ct)\n   131\t\t\t\t}\n   132\t\t\t\treturn\n   133\t\t\t}\n   134\t\n   135\t\t\t// Only send LogCommand and LogConfiguration log types. LogBarrier types\n   136\t\t\t// will not be sent to the FSM.\n   137\t\t\tshouldSend := func(l *Log) bool {\n   138\t\t\t\tswitch l.Type {\n   139\t\t\t\tcase LogCommand, LogConfiguration:\n   140\t\t\t\t\treturn true\n   141\t\t\t\t}\n   142\t\t\t\treturn false\n   143\t\t\t}\n   144\t\n   145\t\t\tvar lastBatchIndex, lastBatchTerm uint64\n   146\t\t\tsendLogs := make([]*Log, 0, len(reqs))\n   147\t\t\tfor _, req := range reqs {\n   148\t\t\t\tif shouldSend(req.log) {\n   149\t\t\t\t\tsendLogs = append(sendLogs, req.log)\n   150\t\t\t\t}\n   151\t\t\t\tlastBatchIndex = req.log.Index\n   152\t\t\t\tlastBatchTerm = req.log.Term\n   153\t\t\t}\n   154\t\n   155\t\t\tvar responses []interface{}\n   156\t\t\tif len(sendLogs) > 0 {\n   157\t\t\t\tstart := time.Now()\n   158\t\t\t\tresponses = batchingFSM.ApplyBatch(sendLogs)\n   159\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"applyBatch\"}, start)\n   160\t\t\t\tmetrics.AddSample([]string{\"raft\", \"fsm\", \"applyBatchNum\"}, float32(len(reqs)))\n   161\t\n   162\t\t\t\t// Ensure we get the expected responses\n   163\t\t\t\tif len(sendLogs) != len(responses) {\n   164\t\t\t\t\tpanic(\"invalid number of responses\")\n   165\t\t\t\t}\n   166\t\t\t}\n   167\t\n   168\t\t\t// Update the indexes\n   169\t\t\tlastIndex = lastBatchIndex\n   170\t\t\tlastTerm = lastBatchTerm\n   171\t\n   172\t\t\tvar i int\n   173\t\t\tfor _, req := range reqs {\n   174\t\t\t\tvar resp interface{}\n   175\t\t\t\t// If the log was sent to the FSM, retrieve the response.\n   176\t\t\t\tif shouldSend(req.log) {\n   177\t\t\t\t\tresp = responses[i]\n   178\t\t\t\t\ti++\n   179\t\t\t\t}\n   180\t\n","exit_code":0,"status":"completed"}}
