unc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n1608:func (r *Raft) processConfigurationLogEntry(entry *Log) error {\n1626:func (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n1759:func (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n1837:func (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n1979:func (r *Raft) setLastContact() {\n1999:func (r *Raft) electSelf() <-chan *voteResult {\n2073:func (r *Raft) preElectSelf() <-chan *preVoteResult {\n2153:func (r *Raft) persistVote(term uint64, candidate []byte) error {\n2164:func (r *Raft) setCurrentTerm(t uint64) {\n2175:func (r *Raft) setState(state RaftState) {\n2186:func (r *Raft) pickServer() *Server {\n2210:func (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n2232:func (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n2240:func (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n2247:func (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n2255:func (r *Raft) getLatestConfiguration() Configuration {\n","exit_code":0,"status":"completed"}}
