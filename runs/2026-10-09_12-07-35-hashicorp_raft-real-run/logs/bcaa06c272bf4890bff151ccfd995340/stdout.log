llowers)\n513\t\t}\n514\t\treturn followers\n515\t}\n516\t\n517\t// FullyConnect connects all the transports together.\n518\tfunc (c *cluster) FullyConnect() {\n519\t\tc.logger.Debug(\"fully connecting\")\n520\t\tfor i, t1 := range c.trans {\n24:func inmemConfig(t testing.TB) *Config {\n585\t}\n586\t\n587\t// EnsureLeader checks that ALL the nodes think the leader is the given expected\n588\t// leader.\n589\tfunc (c *cluster) EnsureLeader(t *testing.T, expect ServerAddress) {\n590\t\t// We assume c.Leader() has been called already; now check all the rafts\n591\t\t// think the leader is correct\n592\t\tfail := false\n593\t\tfor _, r := range c.rafts {\n594\t\t\tleaderAddr, _ := r.LeaderWithID()\n595\t\n596\t\t\tif leaderAddr != expect {\n597\t\t\t\tif leaderAddr == \"\" {\n598\t\t\t\t\tleaderAddr = \"[none]\"\n599\t\t\t\t}\n600\t\t\t\tif expect == \"\" {\n601\t\t\t\t\tc.logger.Error(\"peer sees incorrect leader\", \"peer\", r, \"leader\", leaderAddr, \"expected-leader\", \"[none]\")\n602\t\t\t\t} else {\n603\t\t\t\t\tc.logger.Error(\"peer sees incorrect leader\", \"peer\", r, \"leader\", leaderAddr, \"expected-leader\", expect)\n604\t\t\t\t}\n605\t\t\t\tfail = true\n606\t\t\t}\n607\t\t}\n608\t\tif fail {\n609\t\t\tt.Fatalf(\"at least one peer has the wrong notion of leader\")\n610\t\t}\n611\t}\n612\t\n613\t// EnsureSame makes sure all the FSMs have the same contents.\n614\tfunc (c *cluster) EnsureSame(t *testing.T) {\n615\t\tlimit := time.Now().Add(c.longstopTimeout)\n","exit_code":0,"status":"completed"}}
