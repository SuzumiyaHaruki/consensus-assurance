{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-09_12-07-35-hashicorp_raft-real-run/draft; python3 - <<'PY'\nimport json\np=json.load(open('map.json'))\np['version']=11\np['behaviors'].append({\n \\\"id\\\":\\\"b-install-snapshot-align\\\",\n \\\"primary_activity\\\":\\\"A3\\\",\n \\\"execution_owner\\\":\\\"Raft.main (installSnapshot) with the FSM restore goroutine\\\",\n \\\"protocol_context\\\":\\\"follower (or any state) receiving an InstallSnapshot that its log cannot match\\\",\n \\\"trigger\\\":\\\"processRPC dispatches an InstallSnapshotRequest with a term at or above the receiver's current term\\\",\n \\\"implementation_guards\\\":[\\\"version window and request term are checked\\\",\\\"the snapshot is streamed to the store and restored into the FSM\\\",\\\"compaction runs after the restore\\\"],\n \\\"reads\\\":[\\\"req.LastLogIndex/LastLogTerm\\\",\\\"req.Configuration/ConfigurationIndex\\\",\\\"r.logs\\\"],\n \\\"writes\\\":[\\\"setLastApplied(req.LastLogIndex)\\\",\\\"setLastSnapshot(index, term)\\\",\\\"setLatestConfiguration/setCommittedConfiguration from the request\\\",\\\"compactLogs or removeOldLogs\\\"],\n \\\"important_branches\\\":[\\\"no setLastLog call: the in-memory last log is left as it was, and compaction removes entries only up to the snapshot index (or all entries for monotonic stores)\\\",\\\"observed (execution of TestAssuranceInstallSnapshotLogTailAlignment): with a log holding entries up to index 5 and a snapshot installed at index 3, compaction reported 'from=1 to=3', two entries survived, lastApplied and snapshot index became 3, and the node's effective last entry stayed (5, term 1) so within_installed_snapshot was false\\\"],\n \\\"produces_fact_ids\\\":[\\\"f-log-snapshot-agreement\\\"],\n \\\"source_ids\\\":[\\\"S57\\\",\\\"S58\\\",\\\"S54\\\",\\\"S8\\\"],\n \\\"unknowns\\\":[\\\"whether the retained tail can ever be reconciled with the installed snapshot by a later AppendEntries before a vote comparison uses it\\\"]\n})\np['facts'].append({\n \\\"id\\\":\\\"f-log-snapshot-agreement\\\",\n \\\"meaning\\\":\\\"The receiver's retained log agrees with the snapshot it adopted: after installing a snapshot at (N, termN) the receiver either keeps entries above N only when it still holds an entry at N with term termN, or discards the entries it cannot reconcile, so its effective last entry never comes from a discarded branch.\\\",\n \\\"identity\\\":{\\\"scope\\\":\\\"per-node\\\",\\\"keys\\\":\\\"adopted snapshot (N, termN) versus retained log entries\\\"},\n \\\"validity_context\\\":\\\"Established by a successful InstallSnapshot and preserved until a later matching AppendEntries truncates the tail; the effective last entry is derived by getLastEntry from the maximum of log and snapshot position.\\\",\n \\\"representation\\\":[\\\"r.logs contents\\\",\\\"raftState.lastLogIndex/lastLogTerm\\\",\\\"raftState.lastSnapshotIndex/lastSnapshotTerm\\\",\\\"getLastEntry\\\"],\n \\\"durability\\\":\\\"The retained entries are durable in the LogStore; the snapshot is durable in the SnapshotStore.\\\",\n \\\"recovery\\\":\\\"The tail is only removed by a later AppendEntries conflict truncation (which calls setLastLog) or by a monotonic-store log reset.\\\",\n \\\"unknowns\\\":[\\\"whether a retained tail that the snapshot did not confirm is ever reported after the next AppendEntries, and whether that window can affect an election\\\"],\n \\\"source_ids\\\":[\\\"S57\\\",\\\"S58\\\",\\\"S54\\\",\\\"S8\\\"]\n})\nopen('map.json','w').write(json.dumps(p,indent=1))\nprint('version',p['version'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
