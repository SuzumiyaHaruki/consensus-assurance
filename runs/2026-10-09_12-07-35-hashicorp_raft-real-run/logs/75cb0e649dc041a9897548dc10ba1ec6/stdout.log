{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-09_12-07-35-hashicorp_raft-real-run/draft; python3 - <<'PY'\nimport json\np=json.load(open('map.json'))\np['version']=7\np['behaviors'].append({\n \\\"id\\\":\\\"b-timeout-now\\\",\n \\\"primary_activity\\\":\\\"A2\\\",\n \\\"execution_owner\\\":\\\"Raft.main (processRPC -> timeoutNow)\\\",\n \\\"protocol_context\\\":\\\"any state; an incoming TimeoutNow RPC from a peer whose RPC header passes the version window\\\",\n \\\"trigger\\\":\\\"processRPC dispatches a TimeoutNowRequest\\\",\n \\\"legal_preconditions\\\":[\\\"none stated in the handler beyond the RPC-header version window applied by processRPC\\\"],\n \\\"implementation_guards\\\":[\\\"no term is available on the request (TimeoutNowRequest carries only an RPCHeader)\\\",\\\"no membership, voter or known-leader check is performed\\\"],\n \\\"reads\\\":[\\\"the request's RPCHeader only\\\"],\n \\\"writes\\\":[\\\"setLeader(\\\\\\\"\\\\\\\",\\\\\\\"\\\\\\\")\\\",\\\"raftState.state = Candidate\\\",\\\"candidateFromLeadershipTransfer = true\\\"],\n \\\"important_branches\\\":[\\\"the handler responds success unconditionally after clearing the leader context\\\"],\n \\\"async_boundaries\\\":[\\\"the receiver then runs runCandidate on the main thread, which reads the transfer flag\\\"],\n \\\"produces_fact_ids\\\":[\\\"f-leader-transfer-privilege\\\"],\n \\\"source_ids\\\":[\\\"S48\\\",\\\"S49\\\",\\\"S50\\\",\\\"S51\\\"],\n \\\"unknowns\\\":[\\\"whether a peer that is not a member of the receiver's configuration can reach this handler in a legal deployment (a removed or stale node speaking the supported protocol version)\\\"]\n})\nfor b in p['behaviors']:\n    if b['id']=='b-vote-campaign':\n        b['consumes_fact_ids']=list(dict.fromkeys(b.get('consumes_fact_ids',[])+[\\\"f-leader-transfer-privilege\\\"]))\n        b['important_branches'].append(\\\"when the transfer privilege is set the pre-vote campaign is skipped and RequestVote carries LeadershipTransfer=true (S51)\\\")\np['facts'].append({\n \\\"id\\\":\\\"f-leader-transfer-privilege\\\",\n \\\"meaning\\\":\\\"The privilege held by a receiver of a TimeoutNow request to skip the pre-vote campaign and to send votes that peers grant even though they already have a leader.\\\",\n \\\"identity\\\":{\\\"scope\\\":\\\"per-node, one candidate run\\\",\\\"key\\\":\\\"candidateFromLeadershipTransfer\\\"},\n \\\"validity_context\\\":\\\"Set by timeoutNow on receipt of any TimeoutNow request that passes the RPC-header version window, and cleared after each runCandidate invocation; it is the only stated protection against reuse.\\\",\n \\\"representation\\\":[\\\"r.candidateFromLeadershipTransfer atomic flag\\\",\\\"RequestVoteRequest.LeadershipTransfer field\\\",\\\"the pre-vote skip in runCandidate\\\"],\n \\\"durability\\\":\\\"In-memory only; not persisted, so a restart loses it.\\\",\n \\\"recovery\\\":\\\"No recovery; a restarted node starts without the privilege.\\\",\n \\\"reinterpreters\\\":[\\\"b-vote-campaign\\\"],\n \\\"unknowns\\\":[\\\"no obligation yet ties the granting of this privilege to the sender's authority, and the request carries no term with which to check it\\\"],\n \\\"source_ids\\\":[\\\"S48\\\",\\\"S49\\\",\\\"S51\\\",\\\"S6\\\"]\n})\nopen('map.json','w').write(json.dumps(p,indent=1))\nprint('version',p['version'],'behaviors',len(p['behaviors']),'facts',len(p['facts']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
