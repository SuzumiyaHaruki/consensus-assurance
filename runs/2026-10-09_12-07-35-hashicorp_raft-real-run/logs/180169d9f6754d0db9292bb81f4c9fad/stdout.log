 ErrUnsupportedProtocol\n58\t\t}\n59\t\n60\t\t// Second check is whether we should support this message, given the\n61\t\t// current protocol we are configured to run. This will drop support\n62\t\t// for protocol version 0 starting at protocol version 2, which is\n63\t\t// currently what we want, and in general support one version back. We\n64\t\t// may need to revisit this policy depending on how future protocol\n65\t\t// changes evolve.\n66\t\tif header.ProtocolVersion < r.config().ProtocolVersion-1 {\n67\t\t\treturn ErrUnsupportedProtocol\n68\t\t}\n69\t\n70\t\treturn nil\n71\t}\n72\t\n73\t// getSnapshotVersion returns the snapshot version that should be used when\n74\t// creating snapshots, given the protocol version in use.\n75\tfunc getSnapshotVersion(protocolVersion ProtocolVersion) SnapshotVersion {\n76\t\t// Right now we only have two versions and they are backwards compatible\n77\t\t// so we don't need to look at the protocol version.\n78\t\treturn 1\n79\t}\n80\t\n81\t// commitTuple is used to send an index that was committed,\n82\t// with an optional associated future that should be invoked.\n83\ttype commitTuple struct {\n84\t\tlog    *Log\n85\t\tfuture *logFuture\n86\t}\n87\t\n88\t// leaderState is state that is used while we are a leader.\n89\ttype leaderState struct {\n90\t\tleadershipTransferInProgress int32 // indicates that a leadership transfer is in progress.\n91\t\tcommitCh                     chan struct{}\n92\t\tcommitment                   *commitment\n93\t\tinflight                     *list.List // list of logFuture in log index order\n94\t\treplState                    map[ServerID]*followerReplication\n95\t\tnotify                       map[*verifyFuture]struct{}\n96\t\tstepDown                     chan struct{}\n97\t}\n98\t\n99\t// setLeader is used to modify the current leader Address and ID of the cluster\n100\tfunc (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {\n101\t\tr.leaderLock.Lock()\n102\t\toldLeaderAddr := r