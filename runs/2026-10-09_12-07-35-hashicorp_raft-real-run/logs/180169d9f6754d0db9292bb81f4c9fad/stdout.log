{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c 'cd agent-source; cat -n snapshot.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"time\"\n    10\t\n    11\t\t\"github.com/hashicorp/go-metrics/compat\"\n    12\t)\n    13\t\n    14\t// SnapshotMeta is for metadata of a snapshot.\n    15\ttype SnapshotMeta struct {\n    16\t\t// Version is the version number of the snapshot metadata. This does not cover\n    17\t\t// the application's data in the snapshot, that should be versioned\n    18\t\t// separately.\n    19\t\tVersion SnapshotVersion\n    20\t\n    21\t\t// ID is opaque to the store, and is used for opening.\n    22\t\tID string\n    23\t\n    24\t\t// Index and Term store when the snapshot was taken.\n    25\t\tIndex uint64\n    26\t\tTerm  uint64\n    27\t\n    28\t\t// Peers is deprecated and used to support version 0 snapshots, but will\n    29\t\t// be populated in version 1 snapshots as well to help with upgrades.\n    30\t\tPeers []byte\n    31\t\n    32\t\t// Configuration and ConfigurationIndex are present in version 1\n    33\t\t// snapshots and later.\n    34\t\tConfiguration      Configuration\n    35\t\tConfigurationIndex uint64\n    36\t\n    37\t\t// Size is the size of the snapshot in bytes.\n    38\t\tSize int64\n    39\t}\n    40\t\n    41\t// SnapshotStore interface is used to allow for flexible implementations\n    42\t// of snapshot storage and retrieval. For example, a client could implement\n    43\t// a shared state store such as S3, allowing new nodes to restore snapshots\n    44\t// without streaming from the leader.\n    45\ttype SnapshotStore interface {\n    46\t\t// Create is used to begin a snapshot at a given index and term, and with\n    47\t\t// the given committed configuration. The version parameter controls\n    48\t\t// which snapshot version to create.\n    49\t\tCreate(version SnapshotVersion, index, term uint64, configuration Configuration,\n    50\t\t\tconfigurationIndex uint64, trans Transport) (SnapshotSink, error)\n    51\t\n    52\t\t// List is used to list the available snapshots in the store.\n    53\t\t// It should return then in descending order, with the highest index first.\n    54\t\tList() ([]*SnapshotMeta, error)\n    55\t\n    56\t\t// Open takes a snapshot ID and provides a ReadCloser. Once close is\n    57\t\t// called it is assumed the snapshot is no longer needed.\n    58\t\tOpen(id string) (*SnapshotMeta, io.ReadCloser, error)\n    59\t}\n    60\t\n    61\t// SnapshotSink is returned by StartSnapshot. The FSM will Write state\n    62\t// to the sink and call Close on completion. On error, Cancel will be invoked.\n    63\ttype SnapshotSink interface {\n    64\t\tio.WriteCloser\n    65\t\tID() string\n    66\t\tCancel() error\n    67\t}\n    68\t\n    69\t// runSnapshots is a long running goroutine used to manage taking\n    70\t// new snapshots of the FSM. It runs in parallel to the FSM and\n    71\t// main goroutines, so that snapshots do not block normal operation.\n    72\tfunc (r *Raft) runSnapshots() {\n    73\t\tfor {\n    74\t\t\tselect {\n    75\t\t\tcase <-randomTimeout(r.config().SnapshotInterval):\n    76\t\t\t\t// Check if we should snapshot\n    77\t\t\t\tif !r.shouldSnapshot() {\n    78\t\t\t\t\tcontinue\n    79\t\t\t\t}\n    80\t\n    81\t\t\t\t// Trigger a snapshot\n    82\t\t\t\tif _, err := r.takeSnapshot(); err != nil {\n    83\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    84\t\t\t\t}\n    85\t\n    86\t\t\tcase future := <-r.userSnapshotCh:\n    87\t\t\t\t// User-triggered, run immediately\n    88\t\t\t\tid, err := r.takeSnapshot()\n    89\t\t\t\tif err != nil {\n    90\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    91\t\t\t\t} else {\n    92\t\t\t\t\tfuture.opener = func() (*SnapshotMeta, io.ReadCloser, error) {\n    93\t\t\t\t\t\treturn r.snapshots.Open(id)\n    94\t\t\t\t\t}\n    95\t\t\t\t}\n    96\t\t\t\tfuture.respond(err)\n    97\t\n    98\t\t\tcase <-r.shutdownCh:\n    99\t\t\t\treturn\n   100\t\t\t}\n   101\t\t}\n   102\t}\n   103\t\n   104\t// shouldSnapshot checks if we meet the conditions to take\n   105\t// a new snapshot.\n   106\tfunc (r *Raft) shouldSnapshot() bool {\n   107\t\t// Check the last snapshot index\n   108\t\tlastSnap, _ := r.getLastSnapshot()\n   109\t\n   110\t\t// Check the last log index\n   111\t\tlastIdx, err := r.logs.LastIndex()\n   112\t\tif err != nil {\n   113\t\t\tr.logger.Error(\"failed to get last log index\", \"error\", err)\n   114\t\t\treturn false\n   115\t\t}\n   116\t\n   117\t\t// Compare the delta to the threshold\n   118\t\tdelta := lastIdx - lastSnap\n   119\t\treturn delta >= r.config().SnapshotThreshold\n   120\t}\n   121\t\n   122\t// takeSnapshot is used to take a new snapshot. This must only be called from\n   123\t// the snapshot thread, never the main thread. This returns the ID of the new\n   124\t// snapshot, along with an error.\n   125\tfunc (r *Raft) takeSnapshot() (string, error) {\n   126\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n   127\t\n   128\t\t// Create a request for the FSM to perform a snapshot.\n   129\t\tsnapReq := &reqSnapshotFuture{}\n   130\t\tsnapReq.init()\n   131\t\n   132\t\t// Wait for dispatch or shutdown.\n   133\t\tselect {\n   134\t\tcase r.fsmSnapshotCh <- snapReq:\n   135\t\tcase <-r.shutdownCh:\n   136\t\t\treturn \"\", ErrRaftShutdown\n   137\t\t}\n   138\t\n   139\t\t// Wait until we get a response\n   140\t\tif err := snapReq.Error(); err != nil {\n   141\t\t\tif err != ErrNothingNewToSnapshot {\n   142\t\t\t\terr = fmt.Errorf(\"failed to start snapshot: %v\", err)\n   143\t\t\t}\n   144\t\t\treturn \"\", err\n   145\t\t}\n   146\t\tdefer snapReq.snapshot.Release()\n   147\t\n   148\t\t// Make a request for the configurations and extract the committed info.\n   149\t\t// We have to use the future here to safely get this information since\n   150\t\t// it is owned by the main thread.\n   151\t\tconfigReq := &configurationsFuture{}\n   152\t\tconfigReq.ShutdownCh = r.shutdownCh\n   153\t\tconfigReq.init()\n   154\t\tselect {\n   155\t\tcase r.configurationsCh <- configReq:\n   156\t\tcase <-r.shutdownCh:\n   157\t\t\treturn \"\", ErrRaftShutdown\n   158\t\t}\n   159\t\tif err := configReq.Error(); err != nil {\n   160\t\t\treturn \"\", err\n   161\t\t}\n   162\t\tcommitted := configReq.configurations.committed\n   163\t\tcommittedIndex := configReq.configurations.committedIndex\n   164\t\n   165\t\t// We don't support snapshots while there's a config change outstanding\n   166\t\t// since the snapshot doesn't have a means to represent this state. This\n   167\t\t// is a little weird because we need the FSM to apply an index that's\n   168\t\t// past the configuration change, even though the FSM itself doesn't see\n   169\t\t// the configuration changes. It should be ok in practice with normal\n   170\t\t// application traffic flowing through the FSM. If there's none of that\n   171\t\t// then it's not crucial that we snapshot, since there's not much going\n   172\t\t// on Raft-wise.\n   173\t\tif snapReq.index < committedIndex {\n   174\t\t\treturn \"\", fmt.Errorf(\"cannot take snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n   175\t\t\t\tcommittedIndex, snapReq.index)\n   176\t\t}\n   177\t\n   178\t\t// Create a new snapshot.\n   179\t\tr.logger.Info(\"starting snapshot up to\", \"index\", snapReq.index)\n   180\t\tstart := time.Now()\n   181\t\tversion := getSnapshotVersion(r.protocolVersion)\n   182\t\tsink, err := r.snapshots.Create(version, snapReq.index, snapReq.term, committed, committedIndex, r.trans)\n   183\t\tif err != nil {\n   184\t\t\treturn \"\", fmt.Errorf(\"failed to create snapshot: %v\", err)\n   185\t\t}\n   186\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"create\"}, start)\n   187\t\n   188\t\t// Try to persist the snapshot.\n   189\t\tstart = time.Now()\n   190\t\tif err := snapReq.snapshot.Persist(sink); err != nil {\n   191\t\t\tsink.Cancel()\n   192\t\t\treturn \"\", fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   193\t\t}\n   194\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"persist\"}, start)\n   195\t\n   196\t\t// Close and check for error.\n   197\t\tif err := sink.Close(); err != nil {\n   198\t\t\treturn \"\", fmt.Errorf(\"failed to close snapshot: %v\", err)\n   199\t\t}\n   200\t\n   201\t\t// Update the last stable snapshot info.\n   202\t\tr.setLastSnapshot(snapReq.index, snapReq.term)\n   203\t\n   204\t\t// Compact the logs.\n   205\t\tif err := r.compactLogs(snapReq.index); err != nil {\n   206\t\t\treturn \"\", err\n   207\t\t}\n   208\t\n   209\t\tr.logger.Info(\"snapshot complete up to\", \"index\", snapReq.index)\n   210\t\treturn sink.ID(), nil\n   211\t}\n   212\t\n   213\t// compactLogsWithTrailing takes the last inclusive index of a snapshot,\n   214\t// the lastLogIdx, and the trailingLogs and trims the logs that\n   215\t// are no longer needed.\n   216\tfunc (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n   217\t\t// Determine log ranges to compact\n   218\t\tminLog, err := r.logs.FirstIndex()\n   219\t\tif err != nil {\n   220\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   221\t\t}\n   222\t\n   223\t\t// Check if we have enough logs to truncate\n   224\t\t// Use a consistent value for trailingLogs for the duration of this method\n   225\t\t// call to avoid surprising behaviour.\n   226\t\tif lastLogIdx <= trailingLogs {\n   227\t\t\treturn nil\n   228\t\t}\n   229\t\n   230\t\t// Truncate up to the end of the snapshot, or `TrailingLogs`\n   231\t\t// back from the head, which ever is further back. This ensures\n   232\t\t// at least `TrailingLogs` entries, but does not allow logs\n   233\t\t// after the snapshot to be removed.\n   234\t\tmaxLog := min(snapIdx, lastLogIdx-trailingLogs)\n   235\t\n   236\t\tif minLog > maxLog {\n   237\t\t\tr.logger.Info(\"no logs to truncate\")\n   238\t\t\treturn nil\n   239\t\t}\n   240\t\n   241\t\tr.logger.Info(\"compacting logs\", \"from\", minLog, \"to\", maxLog)\n   242\t\n   243\t\t// Compact the logs\n   244\t\tif err := r.logs.DeleteRange(minLog, maxLog); err != nil {\n   245\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   246\t\t}\n   247\t\treturn nil\n   248\t}\n   249\t\n   250\t// compactLogs takes the last inclusive index of a snapshot\n   251\t// and trims the logs that are no longer needed.\n   252\tfunc (r *Raft) compactLogs(snapIdx uint64) error {\n   253\t\tdefer metrics.MeasureSince([]string{\"raft\", \"compactLogs\"}, time.Now())\n   254\t\n   255\t\tlastLogIdx, _ := r.getLastLog()\n   256\t\ttrailingLogs := r.config().TrailingLogs\n   257\t\n   258\t\treturn r.compactLogsWithTrailing(snapIdx, lastLogIdx, trailingLogs)\n   259\t}\n   260\t\n   261\t// removeOldLogs removes all old logs from the store. This is used for\n   262\t// MonotonicLogStores after restore. Callers should verify that the store\n   263\t// implementation is monotonic prior to calling.\n   264\tfunc (r *Raft) removeOldLogs() error {\n   265\t\tdefer metrics.MeasureSince([]string{\"raft\", \"removeOldLogs\"}, time.Now())\n   266\t\n   267\t\tlastLogIdx, err := r.logs.LastIndex()\n   268\t\tif err != nil {\n   269\t\t\treturn fmt.Errorf(\"failed to get last log index: %w\", err)\n   270\t\t}\n   271\t\n   272\t\tr.logger.Info(\"removing all old logs from log store\")\n   273\t\n   274\t\t// call compactLogsWithTrailing with lastLogIdx for snapIdx since\n   275\t\t// it will take the lesser of lastLogIdx and snapIdx to figure out\n   276\t\t// the end for which to apply trailingLogs.\n   277\t\treturn r.compactLogsWithTrailing(lastLogIdx, lastLogIdx, 0)\n   278\t}\n","exit_code":0,"status":"completed"}}
