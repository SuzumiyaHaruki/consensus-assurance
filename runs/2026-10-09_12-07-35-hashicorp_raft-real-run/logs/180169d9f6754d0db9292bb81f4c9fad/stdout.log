{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c 'cd agent-source; cat -n fsm.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"time\"\n    10\t\n    11\t\thclog \"github.com/hashicorp/go-hclog\"\n    12\t\t\"github.com/hashicorp/go-metrics/compat\"\n    13\t)\n    14\t\n    15\t// FSM is implemented by clients to make use of the replicated log.\n    16\ttype FSM interface {\n    17\t\t// Apply is called once a log entry is committed by a majority of the cluster.\n    18\t\t//\n    19\t\t// Apply should apply the log to the FSM. Apply must be deterministic and\n    20\t\t// produce the same result on all peers in the cluster.\n    21\t\t//\n    22\t\t// The returned value is returned to the client as the ApplyFuture.Response.\n    23\t\tApply(*Log) interface{}\n    24\t\n    25\t\t// Snapshot returns an FSMSnapshot used to: support log compaction, to\n    26\t\t// restore the FSM to a previous state, or to bring out-of-date followers up\n    27\t\t// to a recent log index.\n    28\t\t//\n    29\t\t// The Snapshot implementation should return quickly, because Apply can not\n    30\t\t// be called while Snapshot is running. Generally this means Snapshot should\n    31\t\t// only capture a pointer to the state, and any expensive IO should happen\n    32\t\t// as part of FSMSnapshot.Persist.\n    33\t\t//\n    34\t\t// Apply and Snapshot are always called from the same thread, but Apply will\n    35\t\t// be called concurrently with FSMSnapshot.Persist. This means the FSM should\n    36\t\t// be implemented to allow for concurrent updates while a snapshot is happening.\n    37\t\t//\n    38\t\t// Clients of this library should make no assumptions about whether a returned\n    39\t\t// Snapshot() will actually be stored by Raft. In fact it's quite possible that\n    40\t\t// any Snapshot returned by this call will be discarded, and that\n    41\t\t// FSMSnapshot.Persist will never be called. Raft will always call\n    42\t\t// FSMSnapshot.Release however.\n    43\t\tSnapshot() (FSMSnapshot, error)\n    44\t\n    45\t\t// Restore is used to restore an FSM from a snapshot. It is not called\n    46\t\t// concurrently with any other command. The FSM must discard all previous\n    47\t\t// state before restoring the snapshot.\n    48\t\tRestore(snapshot io.ReadCloser) error\n    49\t}\n    50\t\n    51\t// BatchingFSM extends the FSM interface to add an ApplyBatch function. This can\n    52\t// optionally be implemented by clients to enable multiple logs to be applied to\n    53\t// the FSM in batches. Up to MaxAppendEntries could be sent in a batch.\n    54\ttype BatchingFSM interface {\n    55\t\t// ApplyBatch is invoked once a batch of log entries has been committed and\n    56\t\t// are ready to be applied to the FSM. ApplyBatch will take in an array of\n    57\t\t// log entries. These log entries will be in the order they were committed,\n    58\t\t// will not have gaps, and could be of a few log types. Clients should check\n    59\t\t// the log type prior to attempting to decode the data attached. Presently\n    60\t\t// the LogCommand and LogConfiguration types will be sent.\n    61\t\t//\n    62\t\t// The returned slice must be the same length as the input and each response\n    63\t\t// should correlate to the log at the same index of the input. The returned\n    64\t\t// values will be made available in the ApplyFuture returned by Raft.Apply\n    65\t\t// method if that method was called on the same Raft node as the FSM.\n    66\t\tApplyBatch([]*Log) []interface{}\n    67\t\n    68\t\tFSM\n    69\t}\n    70\t\n    71\t// FSMSnapshot is returned by an FSM in response to a Snapshot\n    72\t// It must be safe to invoke FSMSnapshot methods with concurrent\n    73\t// calls to Apply.\n    74\ttype FSMSnapshot interface {\n    75\t\t// Persist should dump all necessary state to the WriteCloser 'sink',\n    76\t\t// and call sink.Close() when finished or call sink.Cancel() on error.\n    77\t\tPersist(sink SnapshotSink) error\n    78\t\n    79\t\t// Release is invoked when we are finished with the snapshot.\n    80\t\tRelease()\n    81\t}\n    82\t\n    83\t// runFSM is a long running goroutine responsible for applying logs\n    84\t// to the FSM. This is done async of other logs since we don't want\n    85\t// the FSM to block our internal operations.\n    86\tfunc (r *Raft) runFSM() {\n    87\t\tvar lastIndex, lastTerm uint64\n    88\t\n    89\t\tbatchingFSM, batchingEnabled := r.fsm.(BatchingFSM)\n    90\t\tconfigStore, configStoreEnabled := r.fsm.(ConfigurationStore)\n    91\t\n    92\t\tapplySingle := func(req *commitTuple) {\n    93\t\t\t// Apply the log if a command or config change\n    94\t\t\tvar resp interface{}\n    95\t\t\t// Make sure we send a response\n    96\t\t\tdefer func() {\n    97\t\t\t\t// Invoke the future if given\n    98\t\t\t\tif req.future != nil {\n    99\t\t\t\t\treq.future.response = resp\n   100\t\t\t\t\treq.future.respond(nil)\n   101\t\t\t\t}\n   102\t\t\t}()\n   103\t\n   104\t\t\tswitch req.log.Type {\n   105\t\t\tcase LogCommand:\n   106\t\t\t\tstart := time.Now()\n   107\t\t\t\tresp = r.fsm.Apply(req.log)\n   108\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"apply\"}, start)\n   109\t\n   110\t\t\tcase LogConfiguration:\n   111\t\t\t\tif !configStoreEnabled {\n   112\t\t\t\t\t// Return early to avoid incrementing the index and term for\n   113\t\t\t\t\t// an unimplemented operation.\n   114\t\t\t\t\treturn\n   115\t\t\t\t}\n   116\t\n   117\t\t\t\tstart := time.Now()\n   118\t\t\t\tconfigStore.StoreConfiguration(req.log.Index, DecodeConfiguration(req.log.Data))\n   119\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"store_config\"}, start)\n   120\t\t\t}\n   121\t\n   122\t\t\t// Update the indexes\n   123\t\t\tlastIndex = req.log.Index\n   124\t\t\tlastTerm = req.log.Term\n   125\t\t}\n   126\t\n   127\t\tapplyBatch := func(reqs []*commitTuple) {\n   128\t\t\tif !batchingEnabled {\n   129\t\t\t\tfor _, ct := range reqs {\n   130\t\t\t\t\tapplySingle(ct)\n   131\t\t\t\t}\n   132\t\t\t\treturn\n   133\t\t\t}\n   134\t\n   135\t\t\t// Only send LogCommand and LogConfiguration log types. LogBarrier types\n   136\t\t\t// will not be sent to the FSM.\n   137\t\t\tshouldSend := func(l *Log) bool {\n   138\t\t\t\tswitch l.Type {\n   139\t\t\t\tcase LogCommand, LogConfiguration:\n   140\t\t\t\t\treturn true\n   141\t\t\t\t}\n   142\t\t\t\treturn false\n   143\t\t\t}\n   144\t\n   145\t\t\tvar lastBatchIndex, lastBatchTerm uint64\n   146\t\t\tsendLogs := make([]*Log, 0, len(reqs))\n   147\t\t\tfor _, req := range reqs {\n   148\t\t\t\tif shouldSend(req.log) {\n   149\t\t\t\t\tsendLogs = append(sendLogs, req.log)\n   150\t\t\t\t}\n   151\t\t\t\tlastBatchIndex = req.log.Index\n   152\t\t\t\tlastBatchTerm = req.log.Term\n   153\t\t\t}\n   154\t\n   155\t\t\tvar responses []interface{}\n   156\t\t\tif len(sendLogs) > 0 {\n   157\t\t\t\tstart := time.Now()\n   158\t\t\t\tresponses = batchingFSM.ApplyBatch(sendLogs)\n   159\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"applyBatch\"}, start)\n   160\t\t\t\tmetrics.AddSample([]string{\"raft\", \"fsm\", \"applyBatchNum\"}, float32(len(reqs)))\n   161\t\n   162\t\t\t\t// Ensure we get the expected responses\n   163\t\t\t\tif len(sendLogs) != len(responses) {\n   164\t\t\t\t\tpanic(\"invalid number of responses\")\n   165\t\t\t\t}\n   166\t\t\t}\n   167\t\n   168\t\t\t// Update the indexes\n   169\t\t\tlastIndex = lastBatchIndex\n   170\t\t\tlastTerm = lastBatchTerm\n   171\t\n   172\t\t\tvar i int\n   173\t\t\tfor _, req := range reqs {\n   174\t\t\t\tvar resp interface{}\n   175\t\t\t\t// If the log was sent to the FSM, retrieve the response.\n   176\t\t\t\tif shouldSend(req.log) {\n   177\t\t\t\t\tresp = responses[i]\n   178\t\t\t\t\ti++\n   179\t\t\t\t}\n   180\t\n   181\t\t\t\tif req.future != nil {\n   182\t\t\t\t\treq.future.response = resp\n   183\t\t\t\t\treq.future.respond(nil)\n   184\t\t\t\t}\n   185\t\t\t}\n   186\t\t}\n   187\t\n   188\t\trestore := func(req *restoreFuture) {\n   189\t\t\t// Open the snapshot\n   190\t\t\tmeta, source, err := r.snapshots.Open(req.ID)\n   191\t\t\tif err != nil {\n   192\t\t\t\treq.respond(fmt.Errorf(\"failed to open snapshot %v: %v\", req.ID, err))\n   193\t\t\t\treturn\n   194\t\t\t}\n   195\t\t\tdefer source.Close()\n   196\t\n   197\t\t\tsnapLogger := r.logger.With(\n   198\t\t\t\t\"id\", req.ID,\n   199\t\t\t\t\"last-index\", meta.Index,\n   200\t\t\t\t\"last-term\", meta.Term,\n   201\t\t\t\t\"size-in-bytes\", meta.Size,\n   202\t\t\t)\n   203\t\n   204\t\t\t// Attempt to restore\n   205\t\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, meta.Size); err != nil {\n   206\t\t\t\treq.respond(fmt.Errorf(\"failed to restore snapshot %v: %v\", req.ID, err))\n   207\t\t\t\treturn\n   208\t\t\t}\n   209\t\n   210\t\t\t// Update the last index and term\n   211\t\t\tlastIndex = meta.Index\n   212\t\t\tlastTerm = meta.Term\n   213\t\t\treq.respond(nil)\n   214\t\t}\n   215\t\n   216\t\tsnapshot := func(req *reqSnapshotFuture) {\n   217\t\t\t// Is there something to snapshot?\n   218\t\t\tif lastIndex == 0 {\n   219\t\t\t\treq.respond(ErrNothingNewToSnapshot)\n   220\t\t\t\treturn\n   221\t\t\t}\n   222\t\n   223\t\t\t// Start a snapshot\n   224\t\t\tstart := time.Now()\n   225\t\t\tsnap, err := r.fsm.Snapshot()\n   226\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"snapshot\"}, start)\n   227\t\n   228\t\t\t// Respond to the request\n   229\t\t\treq.index = lastIndex\n   230\t\t\treq.term = lastTerm\n   231\t\t\treq.snapshot = snap\n   232\t\t\treq.respond(err)\n   233\t\t}\n   234\t\n   235\t\tsaturation := newSaturationMetric([]string{\"raft\", \"thread\", \"fsm\", \"saturation\"}, 1*time.Second)\n   236\t\n   237\t\tfor {\n   238\t\t\tsaturation.sleeping()\n   239\t\n   240\t\t\tselect {\n   241\t\t\tcase ptr := <-r.fsmMutateCh:\n   242\t\t\t\tsaturation.working()\n   243\t\n   244\t\t\t\tswitch req := ptr.(type) {\n   245\t\t\t\tcase []*commitTuple:\n   246\t\t\t\t\tapplyBatch(req)\n   247\t\n   248\t\t\t\tcase *restoreFuture:\n   249\t\t\t\t\trestore(req)\n   250\t\n   251\t\t\t\tdefault:\n   252\t\t\t\t\tpanic(fmt.Errorf(\"bad type passed to fsmMutateCh: %#v\", ptr))\n   253\t\t\t\t}\n   254\t\n   255\t\t\tcase req := <-r.fsmSnapshotCh:\n   256\t\t\t\tsaturation.working()\n   257\t\n   258\t\t\t\tsnapshot(req)\n   259\t\n   260\t\t\tcase <-r.shutdownCh:\n   261\t\t\t\treturn\n   262\t\t\t}\n   263\t\t}\n   264\t}\n   265\t\n   266\t// fsmRestoreAndMeasure wraps the Restore call on an FSM to consistently measure\n   267\t// and report timing metrics. The caller is still responsible for calling Close\n   268\t// on the source in all cases.\n   269\tfunc fsmRestoreAndMeasure(logger hclog.Logger, fsm FSM, source io.ReadCloser, snapshotSize int64) error {\n   270\t\tstart := time.Now()\n   271\t\n   272\t\tcrc := newCountingReadCloser(source)\n   273\t\n   274\t\tmonitor := startSnapshotRestoreMonitor(logger, crc, snapshotSize, false)\n   275\t\tdefer monitor.StopAndWait()\n   276\t\n   277\t\tif err := fsm.Restore(crc); err != nil {\n   278\t\t\treturn err\n   279\t\t}\n   280\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"restore\"}, start)\n   281\t\tmetrics.SetGauge([]string{\"raft\", \"fsm\", \"lastRestoreDuration\"},\n   282\t\t\tfloat32(time.Since(start).Milliseconds()))\n   283\t\n   284\t\treturn nil\n   285\t}\n","exit_code":0,"status":"completed"}}
