\n1145\t\t// Dump the snapshot. Note that we use the latest configuration,\n1146\t\t// not the one that came with the snapshot.\n1147\t\tsink, err := r.snapshots.Create(version, lastIndex, term,\n1148\t\t\tr.configurations.latest, r.configurations.latestIndex, r.trans)\n1149\t\tif err != nil {\n1150\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n1151\t\t}\n1152\t\tn, err := io.Copy(sink, reader)\n1153\t\tif err != nil {\n1154\t\t\tsink.Cancel()\n1155\t\t\treturn fmt.Errorf(\"failed to write snapshot: %v\", err)\n1156\t\t}\n1157\t\tif n != meta.Size {\n1158\t\t\tsink.Cancel()\n1159\t\t\treturn fmt.Errorf(\"failed to write snapshot, size didn't match (%d != %d)\", n, meta.Size)\n1160\t\t}\n1161\t\tif err := sink.Close(); err != nil {\n1162\t\t\treturn fmt.Errorf(\"failed to close snapshot: %v\", err)\n1163\t\t}\n1164\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n1165\t\n1166\t\t// Restore the snapshot into the FSM. If this fails we are in a\n1167\t\t// bad state so we panic to take ourselves out.\n1168\t\tfsm := &restoreFuture{ID: sink.ID()}\n1169\t\tfsm.ShutdownCh = r.shutdownCh\n1170\t\tfsm.init()\n1171\t\tselect {\n1172\t\tcase r.fsmMutateCh <- fsm:\n1173\t\tcase <-r.shutdownCh:\n1174\t\t\treturn ErrRaftShutdown\n1175\t\t}\n1176\t\tif err := fsm.Error(); err != nil {\n1177\t\t\tpanic(fmt.Errorf(\"failed to restore snapshot: %v\", err))\n1178\t\t}\n1179\t\n1180\t\t// We set the last log so it looks like we've stored the empty\n1181\t\t// index we burned. The last applied is set because we made the\n1182\t\t// FSM take the snapshot state, and we store the last snapshot\n1183\t\t// in the stable store since we created a snapshot as part of\n1184\t\t// this process.\n1185\t\tr.setLastLog(lastIndex, term)\n1186\t\tr.setLastApplied(lastIndex)\n1187\t\tr.setLastSnapshot(lastIndex, term)\n1188\t\n1189\t\t// Remove old logs if r.logs is a MonotonicLogStore. Log any errors and continue.\n1190\t\tif logs, ok := r.logs.(MonotonicLogStore); ok && logs.IsMonotonic() {\n1191\t\t\tif err := r.removeOldLogs(); err != nil {\n1192\t\t\t\tr.logger.Error(\"failed to remove old logs\", \"error\", err)\n1193\t\t\t}\n1194\t\t}\n1195\t\n1196\t\tr.logger.Info(\"restored user snapshot\", \"index\", lastIndex)\n1197\t\treturn nil\n1198\t}\n1199\t\n1200\t// appendConfigurationEntry changes the configuration and adds a new\n1201\t// configuration entry to the log. This must only be called from the\n1202\t// main thread.\n","exit_code":0,"status":"completed"}}
