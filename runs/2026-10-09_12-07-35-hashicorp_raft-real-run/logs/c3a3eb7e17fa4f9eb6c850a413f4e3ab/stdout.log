{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-09_12-07-35-hashicorp_raft-real-run/draft; python3 - <<'PY'\nimport json\np=json.load(open('map.json'))\np['version']=9\np['behaviors'].append({\n \\\"id\\\":\\\"b-stable-position-reconstruction\\\",\n \\\"primary_activity\\\":\\\"A6\\\",\n \\\"execution_owner\\\":\\\"raftState accessors (getLastIndex/getLastEntry) fed by NewRaft, restoreSnapshot and every log write\\\",\n \\\"protocol_context\\\":\\\"startup and steady state; the log may be empty while a newer snapshot exists\\\",\n \\\"trigger\\\":\\\"any read of the node's last index/entry, e.g. building RequestVote, dispatching a new log entry, or serving AppendEntries\\\",\n \\\"legal_preconditions\\\":[\\\"the snapshot index/term is set when a snapshot is restored or taken\\\"],\n \\\"implementation_guards\\\":[\\\"getLastIndex returns max(lastLogIndex, lastSnapshotIndex)\\\",\\\"getLastEntry returns the snapshot's pair when the snapshot is newer than the log\\\"],\n \\\"reads\\\":[\\\"lastLogIndex/lastLogTerm\\\",\\\"lastSnapshotIndex/lastSnapshotTerm\\\"],\n \\\"writes\\\":[\\\"lastLog via setLastLog on every local log write and on AppendEntries\\\",\\\"lastSnapshot via setLastSnapshot on snapshot restore/take\\\"],\n \\\"important_branches\\\":[\\\"a node restarted with an empty log but a snapshot at index N therefore advertises and resumes at N rather than at 0, so no log index below the snapshot is reused\\\"],\n \\\"produces_fact_ids\\\":[\\\"f-stable-log-position\\\"],\n \\\"source_ids\\\":[\\\"S54\\\",\\\"S20\\\",\\\"S16\\\"],\n \\\"unknowns\\\":[\\\"whether any accessor or caller bypasses these two and reads the raw log index instead was not exhaustively searched\\\"]\n})\np['facts'].append({\n \\\"id\\\":\\\"f-stable-log-position\\\",\n \\\"meaning\\\":\\\"The node's position in stable storage: the last log entry it holds together with the last snapshot it holds, and the effective last index/term derived from the two.\\\",\n \\\"identity\\\":{\\\"scope\\\":\\\"per-node\\\",\\\"keys\\\":\\\"lastLogIndex/lastLogTerm, lastSnapshotIndex/lastSnapshotTerm\\\"},\n \\\"validity_context\\\":\\\"The effective last position is max(log, snapshot); the snapshot pair wins when the snapshot index exceeds the log index, which is the normal state after log compaction or a restart with an emptied log.\\\",\n \\\"representation\\\":[\\\"raftState.lastLogIndex/lastLogTerm\\\",\\\"raftState.lastSnapshotIndex/lastSnapshotTerm\\\",\\\"getLastIndex/getLastEntry\\\"],\n \\\"durability\\\":\\\"The log entries and the snapshot are durable; the cached pair is recomputed at startup (lastLog from LogStore.LastIndex, lastSnapshot from the restored snapshot).\\\",\n \\\"recovery\\\":\\\"NewRaft reads the log's last index, restoreSnapshot sets lastApplied and the last snapshot, and restoreSnapshot does not need to rewrite lastLog because the accessors take the maximum.\\\",\n \\\"source_ids\\\":[\\\"S54\\\",\\\"S20\\\",\\\"S16\\\"],\n \\\"unknowns\\\":[\\\"none recorded: the max-of-two accessors explain the empty-log-with-newer-snapshot case that would otherwise look like index reuse\\\"]\n})\nopen('map.json','w').write(json.dumps(p,indent=1))\nprint('version',p['version'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
