{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=330 && NR<=440 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' api.go\"","aggregated_output":"330\t\t// bootstrap, rather than quietly fire up a fresh cluster here.\n331\t\tif hasState, err := HasExistingState(logs, stable, snaps); err != nil {\n332\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n333\t\t} else if !hasState {\n334\t\t\treturn fmt.Errorf(\"refused to recover cluster with no initial state, this is probably an operator error\")\n335\t\t}\n336\t\n337\t\t// Attempt to restore any snapshots we find, newest to oldest.\n338\t\tvar (\n339\t\t\tsnapshotIndex  uint64\n340\t\t\tsnapshotTerm   uint64\n341\t\t\tsnapshots, err = snaps.List()\n342\t\t)\n343\t\tif err != nil {\n344\t\t\treturn fmt.Errorf(\"failed to list snapshots: %v\", err)\n345\t\t}\n346\t\n347\t\tlogger := conf.getOrCreateLogger()\n348\t\n349\t\tfor _, snapshot := range snapshots {\n350\t\t\tvar source io.ReadCloser\n351\t\t\t_, source, err = snaps.Open(snapshot.ID)\n352\t\t\tif err != nil {\n353\t\t\t\t// Skip this one and try the next. We will detect if we\n354\t\t\t\t// couldn't open any snapshots.\n355\t\t\t\tcontinue\n356\t\t\t}\n357\t\n358\t\t\t// Note this is the one place we call fsm.Restore without the\n359\t\t\t// fsmRestoreAndMeasure wrapper since this function should only be called to\n360\t\t\t// reset state on disk and the FSM passed will not be used for a running\n361\t\t\t// server instance. If the same process will eventually become a Raft peer\n362\t\t\t// then it will call NewRaft and restore again from disk then which will\n363\t\t\t// report metrics.\n364\t\t\tsnapLogger := logger.With(\n365\t\t\t\t\"id\", snapshot.ID,\n366\t\t\t\t\"last-index\", snapshot.Index,\n367\t\t\t\t\"last-term\", snapshot.Term,\n368\t\t\t\t\"size-in-bytes\", snapshot.Size,\n369\t\t\t)\n370\t\t\tcrc := newCountingReadCloser(source)\n371\t\t\tmonitor := startSnapshotRestoreMonitor(snapLogger, crc, snapshot.Size, false)\n372\t\t\terr = fsm.Restore(crc)\n373\t\t\t// Close the source after the restore has completed\n374\t\t\tsource.Close()\n375\t\t\tmonitor.StopAndWait()\n376\t\t\tif err != nil {\n377\t\t\t\t// Same here, skip and try the next one.\n378\t\t\t\tcontinue\n379\t\t\t}\n380\t\n381\t\t\tsnapshotIndex = snapshot.Index\n382\t\t\tsnapshotTerm = snapshot.Term\n383\t\t\tbreak\n384\t\t}\n385\t\tif len(snapshots) > 0 && (snapshotIndex == 0 || snapshotTerm == 0) {\n386\t\t\treturn fmt.Errorf(\"failed to restore any of the available snapshots\")\n387\t\t}\n388\t\n389\t\t// The snapshot information is the best known end point for the data\n390\t\t// until we play back the Raft log entries.\n391\t\tlastIndex := snapshotIndex\n392\t\tlastTerm := snapshotTerm\n393\t\n394\t\t// Apply any Raft log entries past the snapshot.\n395\t\tlastLogIndex, err := logs.LastIndex()\n396\t\tif err != nil {\n397\t\t\treturn fmt.Errorf(\"failed to find last log: %v\", err)\n398\t\t}\n399\t\tfor index := snapshotIndex + 1; index <= lastLogIndex; index++ {\n400\t\t\tvar entry Log\n401\t\t\tif err = logs.GetLog(index, &entry); err != nil {\n402\t\t\t\treturn fmt.Errorf(\"failed to get log at index %d: %v\", index, err)\n403\t\t\t}\n404\t\t\tif entry.Type == LogCommand {\n405\t\t\t\t_ = fsm.Apply(&entry)\n406\t\t\t}\n407\t\t\tlastIndex = entry.Index\n408\t\t\tlastTerm = entry.Term\n409\t\t}\n410\t\n411\t\t// Create a new snapshot, placing the configuration in as if it was\n412\t\t// committed at index 1.\n413\t\tsnapshot, err := fsm.Snapshot()\n414\t\tif err != nil {\n415\t\t\treturn fmt.Errorf(\"failed to snapshot FSM: %v\", err)\n416\t\t}\n417\t\tversion := getSnapshotVersion(conf.ProtocolVersion)\n418\t\tsink, err := snaps.Create(version, lastIndex, lastTerm, configuration, 1, trans)\n419\t\tif err != nil {\n420\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n421\t\t}\n422\t\tif err = snapshot.Persist(sink); err != nil {\n423\t\t\treturn fmt.Errorf(\"failed to persist snapshot: %v\", err)\n424\t\t}\n425\t\tif err = sink.Close(); err != nil {\n426\t\t\treturn fmt.Errorf(\"failed to finalize snapshot: %v\", err)\n427\t\t}\n428\t\n429\t\t// Compact the log so that we don't get bad interference from any\n430\t\t// configuration change log entries that might be there.\n431\t\tfirstLogIndex, err := logs.FirstIndex()\n432\t\tif err != nil {\n433\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n434\t\t}\n435\t\tif err := logs.DeleteRange(firstLogIndex, lastLogIndex); err != nil {\n436\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n437\t\t}\n438\t\n439\t\treturn nil\n440\t}\n","exit_code":0,"status":"completed"}}
