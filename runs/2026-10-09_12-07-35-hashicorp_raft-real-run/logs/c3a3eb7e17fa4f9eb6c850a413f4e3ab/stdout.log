h = make(chan *logFuture, conf.MaxAppendEntries)\n544\t\t}\n545\t\n546\t\t_, transportSupportPreVote := trans.(WithPreVote)\n547\t\t// Create Raft struct.\n548\t\tr := &Raft{\n549\t\t\tprotocolVersion:       protocolVersion,\n550\t\t\tapplyCh:               applyCh,\n551\t\t\tfsm:                   fsm,\n552\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n553\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n554\t\t\tleaderCh:              make(chan bool, 1),\n555\t\t\tlocalID:               localID,\n556\t\t\tlocalAddr:             localAddr,\n557\t\t\tlogger:                logger,\n558\t\t\tlogs:                  logs,\n559\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n560\t\t\tconfigurations:        configurations{},\n561\t\t\trpcCh:                 trans.Consumer(),\n562\t\t\tsnapshots:             snaps,\n563\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n564\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n565\t\t\tshutdownCh:            make(chan struct{}),\n566\t\t\tstable:                stable,\n567\t\t\ttrans:                 trans,\n568\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n569\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n570\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n","exit_code":0,"status":"completed"}}
