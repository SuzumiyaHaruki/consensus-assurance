{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=814 && NR<=930 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' net_transport.go\"","aggregated_output":"814\t// newNetPipeline is used to construct a netPipeline from a given transport and\n815\t// connection. It is a bug to ever call this with maxInFlight less than 2\n816\t// (minInFlightForPipelining) and will cause a panic.\n817\tfunc newNetPipeline(trans *NetworkTransport, conn *netConn, maxInFlight int) *netPipeline {\n818\t\tif maxInFlight < minInFlightForPipelining {\n819\t\t\t// Shouldn't happen (tm) since we validate this in the one call site and\n820\t\t\t// skip pipelining if it's lower.\n821\t\t\tpanic(\"pipelining makes no sense if maxInFlight < 2\")\n822\t\t}\n823\t\tn := &netPipeline{\n824\t\t\tconn:  conn,\n825\t\t\ttrans: trans,\n826\t\t\t// The buffer size is 2 less than the configured max because we send before\n827\t\t\t// waiting on the channel and the decode routine unblocks the channel as\n828\t\t\t// soon as it's waiting on the first request. So a zero-buffered channel\n829\t\t\t// still allows 1 request to be sent even while decode is still waiting for\n830\t\t\t// a response from the previous one. i.e. two are inflight at the same time.\n831\t\t\tinprogressCh: make(chan *appendFuture, maxInFlight-2),\n832\t\t\tdoneCh:       make(chan AppendFuture, maxInFlight-2),\n833\t\t\tshutdownCh:   make(chan struct{}),\n834\t\t}\n835\t\tgo n.decodeResponses()\n836\t\treturn n\n837\t}\n838\t\n839\t// decodeResponses is a long running routine that decodes the responses\n840\t// sent on the connection.\n841\tfunc (n *netPipeline) decodeResponses() {\n842\t\ttimeout := n.trans.timeout\n843\t\tfor {\n844\t\t\tselect {\n845\t\t\tcase future := <-n.inprogressCh:\n846\t\t\t\tif timeout > 0 {\n847\t\t\t\t\tn.conn.conn.SetReadDeadline(time.Now().Add(timeout))\n848\t\t\t\t}\n849\t\n850\t\t\t\t_, err := decodeResponse(n.conn, future.resp)\n851\t\t\t\tfuture.respond(err)\n852\t\t\t\tselect {\n853\t\t\t\tcase n.doneCh <- future:\n854\t\t\t\tcase <-n.shutdownCh:\n855\t\t\t\t\treturn\n856\t\t\t\t}\n857\t\t\tcase <-n.shutdownCh:\n858\t\t\t\treturn\n859\t\t\t}\n860\t\t}\n861\t}\n862\t\n863\t// AppendEntries is used to pipeline a new append entries request.\n864\tfunc (n *netPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n865\t\t// Create a new future\n866\t\tfuture := &appendFuture{\n867\t\t\tstart: time.Now(),\n868\t\t\targs:  args,\n869\t\t\tresp:  resp,\n870\t\t}\n871\t\tfuture.init()\n872\t\n873\t\t// Add a send timeout\n874\t\tif timeout := n.trans.timeout; timeout > 0 {\n875\t\t\tn.conn.conn.SetWriteDeadline(time.Now().Add(timeout))\n876\t\t}\n877\t\n878\t\t// Send the RPC\n879\t\tif err := sendRPC(n.conn, rpcAppendEntries, future.args); err != nil {\n880\t\t\treturn nil, err\n881\t\t}\n882\t\n883\t\t// Hand-off for decoding, this can also cause back-pressure\n884\t\t// to prevent too many inflight requests\n885\t\tselect {\n886\t\tcase n.inprogressCh <- future:\n887\t\t\treturn future, nil\n888\t\tcase <-n.shutdownCh:\n889\t\t\treturn nil, ErrPipelineShutdown\n890\t\t}\n891\t}\n892\t\n893\t// Consumer returns a channel that can be used to consume complete futures.\n894\tfunc (n *netPipeline) Consumer() <-chan AppendFuture {\n895\t\treturn n.doneCh\n896\t}\n897\t\n898\t// Close is used to shut down the pipeline connection.\n899\tfunc (n *netPipeline) Close() error {\n900\t\tn.shutdownLock.Lock()\n901\t\tdefer n.shutdownLock.Unlock()\n902\t\tif n.shutdown {\n903\t\t\treturn nil\n904\t\t}\n905\t\n906\t\t// Release the connection\n907\t\tn.conn.Release()\n908\t\n909\t\tn.shutdown = true\n910\t\tclose(n.shutdownCh)\n911\t\treturn nil\n912\t}\n","exit_code":0,"status":"completed"}}
