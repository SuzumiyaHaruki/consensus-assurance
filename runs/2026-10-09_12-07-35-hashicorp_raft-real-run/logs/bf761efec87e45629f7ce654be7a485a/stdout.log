{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=680 && NR<=1000 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"680\t\t\tr.mainThreadSaturation.sleeping()\n681\t\n682\t\t\tselect {\n683\t\t\tcase rpc := <-r.rpcCh:\n684\t\t\t\tr.mainThreadSaturation.working()\n685\t\t\t\tr.processRPC(rpc)\n686\t\n687\t\t\tcase <-r.leaderState.stepDown:\n688\t\t\t\tr.mainThreadSaturation.working()\n689\t\t\t\tr.setState(Follower)\n690\t\n691\t\t\tcase future := <-r.leadershipTransferCh:\n692\t\t\t\tr.mainThreadSaturation.working()\n693\t\t\t\tif r.getLeadershipTransferInProgress() {\n694\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n695\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n696\t\t\t\t\tcontinue\n697\t\t\t\t}\n698\t\n699\t\t\t\tr.logger.Debug(\"starting leadership transfer\", \"id\", future.ID, \"address\", future.Address)\n700\t\n701\t\t\t\t// When we are leaving leaderLoop, we are no longer\n702\t\t\t\t// leader, so we should stop transferring.\n703\t\t\t\tleftLeaderLoop := make(chan struct{})\n704\t\t\t\tdefer func() { close(leftLeaderLoop) }()\n705\t\n706\t\t\t\tstopCh := make(chan struct{})\n707\t\t\t\tdoneCh := make(chan error, 1)\n708\t\n709\t\t\t\t// This is intentionally being setup outside of the\n710\t\t\t\t// leadershipTransfer function. Because the TimeoutNow\n711\t\t\t\t// call is blocking and there is no way to abort that\n712\t\t\t\t// in case eg the timer expires.\n713\t\t\t\t// The leadershipTransfer function is controlled with\n714\t\t\t\t// the stopCh and doneCh.\n715\t\t\t\t// No matter how this exits, have this function set\n716\t\t\t\t// leadership transfer to false before we return\n717\t\t\t\t//\n718\t\t\t\t// Note that this leaves a window where callers of\n719\t\t\t\t// LeadershipTransfer() and LeadershipTransferToServer()\n720\t\t\t\t// may start executing after they get their future but before\n721\t\t\t\t// this routine has set leadershipTransferInProgress back to false.\n722\t\t\t\t// It may be safe to modify things such that setLeadershipTransferInProgress\n723\t\t\t\t// is set to false before calling future.Respond, but that still needs\n724\t\t\t\t// to be tested and this situation mirrors what callers already had to deal with.\n725\t\t\t\tgo func() {\n726\t\t\t\t\tdefer r.setLeadershipTransferInProgress(false)\n727\t\t\t\t\tselect {\n728\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n729\t\t\t\t\t\tclose(stopCh)\n730\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n731\t\t\t\t\t\tr.logger.Debug(err.Error())\n732\t\t\t\t\t\tfuture.respond(err)\n733\t\t\t\t\t\t<-doneCh\n734\t\t\t\t\tcase <-leftLeaderLoop:\n735\t\t\t\t\t\tclose(stopCh)\n736\t\t\t\t\t\terr := fmt.Errorf(\"lost leadership during transfer (expected)\")\n737\t\t\t\t\t\tr.logger.Debug(err.Error())\n738\t\t\t\t\t\tfuture.respond(nil)\n739\t\t\t\t\t\t<-doneCh\n740\t\t\t\t\tcase err := <-doneCh:\n741\t\t\t\t\t\tif err != nil {\n742\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n743\t\t\t\t\t\t\tfuture.respond(err)\n744\t\t\t\t\t\t} else {\n745\t\t\t\t\t\t\t// Wait for up to ElectionTimeout before flagging the\n746\t\t\t\t\t\t\t// leadership transfer as done and unblocking applies in\n747\t\t\t\t\t\t\t// the leaderLoop.\n748\t\t\t\t\t\t\tselect {\n749\t\t\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n750\t\t\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n751\t\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n752\t\t\t\t\t\t\t\tfuture.respond(err)\n753\t\t\t\t\t\t\tcase <-leftLeaderLoop:\n754\t\t\t\t\t\t\t\tr.logger.Debug(\"lost leadership during transfer (expected)\")\n755\t\t\t\t\t\t\t\tfuture.respond(nil)\n756\t\t\t\t\t\t\t}\n757\t\t\t\t\t\t}\n758\t\t\t\t\t}\n759\t\t\t\t}()\n760\t\n761\t\t\t\t// leaderState.replState is accessed here before\n762\t\t\t\t// starting leadership transfer asynchronously because\n763\t\t\t\t// leaderState is only supposed to be accessed in the\n764\t\t\t\t// leaderloop.\n765\t\t\t\tid := future.ID\n766\t\t\t\taddress := future.Address\n767\t\t\t\tif id == nil {\n768\t\t\t\t\ts := r.pickServer()\n769\t\t\t\t\tif s != nil {\n770\t\t\t\t\t\tid = &s.ID\n771\t\t\t\t\t\taddress = &s.Address\n772\t\t\t\t\t} else {\n773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n774\t\t\t\t\t\tcontinue\n775\t\t\t\t\t}\n776\t\t\t\t}\n777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n778\t\t\t\tif !ok {\n779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n780\t\t\t\t\tcontinue\n781\t\t\t\t}\n782\t\t\t\tr.setLeadershipTransferInProgress(true)\n783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n784\t\n785\t\t\tcase <-r.leaderState.commitCh:\n786\t\t\t\tr.mainThreadSaturation.working()\n787\t\t\t\t// Process the newly committed entries\n788\t\t\t\toldCommitIndex := r.getCommitIndex()\n789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n790\t\t\t\tr.setCommitIndex(commitIndex)\n791\t\n792\t\t\t\t// New configuration has been committed, set it as the committed\n793\t\t\t\t// value.\n794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n798\t\t\t\t\t\tstepDown = true\n799\t\t\t\t\t}\n800\t\t\t\t}\n801\t\n802\t\t\t\tstart := time.Now()\n803\t\t\t\tvar groupReady []*list.Element\n804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n805\t\t\t\tvar lastIdxInGroup uint64\n806\t\n807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n810\t\t\t\t\tidx := commitLog.log.Index\n811\t\t\t\t\tif idx > commitIndex {\n812\t\t\t\t\t\t// Don't go past the committed index\n813\t\t\t\t\t\tbreak\n814\t\t\t\t\t}\n815\t\n816\t\t\t\t\t// Measure the commit time\n817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n818\t\t\t\t\tgroupReady = append(groupReady, e)\n819\t\t\t\t\tgroupFutures[idx] = commitLog\n820\t\t\t\t\tlastIdxInGroup = idx\n821\t\t\t\t}\n822\t\n823\t\t\t\t// Process the group\n824\t\t\t\tif len(groupReady) != 0 {\n825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n826\t\n827\t\t\t\t\tfor _, e := range groupReady {\n828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n829\t\t\t\t\t}\n830\t\t\t\t}\n831\t\n832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n834\t\n835\t\t\t\t// Count the number of logs enqueued\n836\t\t\t\tmetrics.SetGauge([]string{\"raft\", \"commitNumLogs\"}, float32(len(groupReady)))\n837\t\n838\t\t\t\tif stepDown {\n839\t\t\t\t\tif r.config().ShutdownOnRemove {\n840\t\t\t\t\t\tr.logger.Info(\"removed ourself, shutting down\")\n841\t\t\t\t\t\tr.Shutdown()\n842\t\t\t\t\t} else {\n843\t\t\t\t\t\tr.logger.Info(\"removed ourself, transitioning to follower\")\n844\t\t\t\t\t\tr.setState(Follower)\n845\t\t\t\t\t}\n846\t\t\t\t}\n847\t\n848\t\t\tcase v := <-r.verifyCh:\n849\t\t\t\tr.mainThreadSaturation.working()\n850\t\t\t\tif v.quorumSize == 0 {\n851\t\t\t\t\t// Just dispatched, start the verification\n852\t\t\t\t\tr.verifyLeader(v)\n853\t\t\t\t} else if v.votes < v.quorumSize {\n854\t\t\t\t\t// Early return, means there must be a new leader\n855\t\t\t\t\tr.logger.Warn(\"new leader elected, stepping down\")\n856\t\t\t\t\tr.setState(Follower)\n857\t\t\t\t\tdelete(r.leaderState.notify, v)\n858\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n859\t\t\t\t\t\trepl.cleanNotify(v)\n860\t\t\t\t\t}\n861\t\t\t\t\tv.respond(ErrNotLeader)\n862\t\n863\t\t\t\t} else {\n864\t\t\t\t\t// Quorum of members agree, we are still leader\n865\t\t\t\t\tdelete(r.leaderState.notify, v)\n866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n867\t\t\t\t\t\trepl.cleanNotify(v)\n868\t\t\t\t\t}\n869\t\t\t\t\tv.respond(nil)\n870\t\t\t\t}\n871\t\n872\t\t\tcase future := <-r.userRestoreCh:\n873\t\t\t\tr.mainThreadSaturation.working()\n874\t\t\t\tif r.getLeadershipTransferInProgress() {\n875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n877\t\t\t\t\tcontinue\n878\t\t\t\t}\n879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n880\t\t\t\tfuture.respond(err)\n881\t\n882\t\t\tcase future := <-r.configurationsCh:\n883\t\t\t\tr.mainThreadSaturation.working()\n884\t\t\t\tif r.getLeadershipTransferInProgress() {\n885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n887\t\t\t\t\tcontinue\n888\t\t\t\t}\n889\t\t\t\tfuture.configurations = r.configurations.Clone()\n890\t\t\t\tfuture.respond(nil)\n891\t\n892\t\t\tcase future := <-r.configurationChangeChIfStable():\n893\t\t\t\tr.mainThreadSaturation.working()\n894\t\t\t\tif r.getLeadershipTransferInProgress() {\n895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n897\t\t\t\t\tcontinue\n898\t\t\t\t}\n899\t\t\t\tr.appendConfigurationEntry(future)\n900\t\n901\t\t\tcase b := <-r.bootstrapCh:\n902\t\t\t\tr.mainThreadSaturation.working()\n903\t\t\t\tb.respond(ErrCantBootstrap)\n904\t\n905\t\t\tcase newLog := <-r.applyCh:\n906\t\t\t\tr.mainThreadSaturation.working()\n907\t\t\t\tif r.getLeadershipTransferInProgress() {\n908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n910\t\t\t\t\tcontinue\n911\t\t\t\t}\n912\t\t\t\t// Group commit, gather all the ready commits\n913\t\t\t\tready := []*logFuture{newLog}\n914\t\t\tGROUP_COMMIT_LOOP:\n915\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n916\t\t\t\t\tselect {\n917\t\t\t\t\tcase newLog := <-r.applyCh:\n918\t\t\t\t\t\tready = append(ready, newLog)\n919\t\t\t\t\tdefault:\n920\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n921\t\t\t\t\t}\n922\t\t\t\t}\n923\t\n924\t\t\t\t// Dispatch the logs\n925\t\t\t\tif stepDown {\n926\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n927\t\t\t\t\tfor i := range ready {\n928\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n929\t\t\t\t\t}\n930\t\t\t\t} else {\n931\t\t\t\t\tr.dispatchLogs(ready)\n932\t\t\t\t}\n933\t\n934\t\t\tcase <-lease:\n935\t\t\t\tr.mainThreadSaturation.working()\n936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n937\t\t\t\tmaxDiff := r.checkLeaderLease()\n938\t\n939\t\t\t\t// Next check interval should adjust for the last node we've\n940\t\t\t\t// contacted, without going negative\n941\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n942\t\t\t\tif checkInterval < minCheckInterval {\n943\t\t\t\t\tcheckInterval = minCheckInterval\n944\t\t\t\t}\n945\t\n946\t\t\t\t// Renew the lease timer\n947\t\t\t\tlease = time.After(checkInterval)\n948\t\n949\t\t\tcase <-r.leaderNotifyCh:\n950\t\t\t\tfor _, repl := range r.leaderState.replState {\n951\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n952\t\t\t\t}\n953\t\n954\t\t\tcase <-r.followerNotifyCh:\n955\t\t\t\t//  Ignore since we are not a follower\n956\t\n957\t\t\tcase <-r.shutdownCh:\n958\t\t\t\treturn\n959\t\t\t}\n960\t\t}\n961\t}\n962\t\n963\t// verifyLeader must be called from the main thread for safety.\n964\t// Causes the followers to attempt an immediate heartbeat.\n965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n966\t\t// Current leader always votes for self\n967\t\tv.votes = 1\n968\t\n969\t\t// Set the quorum size, hot-path for single node\n970\t\tv.quorumSize = r.quorumSize()\n971\t\tif v.quorumSize == 1 {\n972\t\t\tv.respond(nil)\n973\t\t\treturn\n974\t\t}\n975\t\n976\t\t// Track this request\n977\t\tv.notifyCh = r.verifyCh\n978\t\tr.leaderState.notify[v] = struct{}{}\n979\t\n980\t\t// Trigger immediate heartbeats\n981\t\tfor _, repl := range r.leaderState.replState {\n982\t\t\trepl.notifyLock.Lock()\n983\t\t\trepl.notify[v] = struct{}{}\n984\t\t\trepl.notifyLock.Unlock()\n985\t\t\tasyncNotifyCh(repl.notifyCh)\n986\t\t}\n987\t}\n988\t\n989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n991\t\t// make sure we are not already stopped\n992\t\tselect {\n993\t\tcase <-stopCh:\n994\t\t\tdoneCh <- nil\n995\t\t\treturn\n996\t\tdefault:\n997\t\t}\n998\t\n999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n1000\t\t\terr := &deferError{}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=1000 && NR<=1110 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go; echo \\\"=== configuration.go ===\\\"; cat -n configuration.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=1000 && NR<=1110 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go; echo \\\"=== configuration.go ===\\\"; cat -n configuration.go\"","aggregated_output":"1000\t\t\terr := &deferError{}\n1001\t\t\terr.init()\n1002\t\t\trepl.triggerDeferErrorCh <- err\n1003\t\t\tselect {\n1004\t\t\tcase err := <-err.errCh:\n1005\t\t\t\tif err != nil {\n1006\t\t\t\t\tdoneCh <- err\n1007\t\t\t\t\treturn\n1008\t\t\t\t}\n1009\t\t\tcase <-stopCh:\n1010\t\t\t\tdoneCh <- nil\n1011\t\t\t\treturn\n1012\t\t\t}\n1013\t\t}\n1014\t\n1015\t\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n1016\t\t// messaging for read-only queries. If this is implemented, the lease\n1017\t\t// has to be reset as well, in case leadership is transferred. This\n1018\t\t// implementation also has a lease, but it serves another purpose and\n1019\t\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n1020\t\t// setup in a similar way to the one in the thesis, but in practice\n1021\t\t// it's a timer that just tells the leader how often to check\n1022\t\t// heartbeats are still coming in.\n1023\t\n1024\t\t// Step 3: send TimeoutNow message to target server.\n1025\t\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n1026\t\tif err != nil {\n1027\t\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n1028\t\t}\n1029\t\tdoneCh <- err\n1030\t}\n1031\t\n1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n1033\t// within the last leader lease interval. If not, we need to step down,\n1034\t// as we may have lost connectivity. Returns the maximum duration without\n1035\t// contact. This must only be called from the main thread.\n1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n1037\t\t// Track contacted nodes, we can always contact ourself\n1038\t\tcontacted := 0\n1039\t\n1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n1042\t\t// changes between iterations below.\n1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n1044\t\n1045\t\t// Check each follower\n1046\t\tvar maxDiff time.Duration\n1047\t\tnow := time.Now()\n1048\t\tfor _, server := range r.configurations.latest.Servers {\n1049\t\t\tif server.Suffrage == Voter {\n1050\t\t\t\tif server.ID == r.localID {\n1051\t\t\t\t\tcontacted++\n1052\t\t\t\t\tcontinue\n1053\t\t\t\t}\n1054\t\t\t\tf := r.leaderState.replState[server.ID]\n1055\t\t\t\tdiff := now.Sub(f.LastContact())\n1056\t\t\t\tif diff <= leaseTimeout {\n1057\t\t\t\t\tcontacted++\n1058\t\t\t\t\tif diff > maxDiff {\n1059\t\t\t\t\t\tmaxDiff = diff\n1060\t\t\t\t\t}\n1061\t\t\t\t} else {\n1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n1065\t\t\t\t\t} else {\n1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n1067\t\t\t\t\t}\n1068\t\t\t\t}\n1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n1070\t\t\t}\n1071\t\t}\n1072\t\n1073\t\t// Verify we can contact a quorum\n1074\t\tquorum := r.quorumSize()\n1075\t\tif contacted < quorum {\n1076\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n1077\t\t\tr.setState(Follower)\n1078\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n1079\t\t}\n1080\t\treturn maxDiff\n1081\t}\n1082\t\n1083\t// quorumSize is used to return the quorum size. This must only be called on\n1084\t// the main thread.\n1085\t// TODO: revisit usage\n1086\tfunc (r *Raft) quorumSize() int {\n1087\t\tvoters := 0\n1088\t\tfor _, server := range r.configurations.latest.Servers {\n1089\t\t\tif server.Suffrage == Voter {\n1090\t\t\t\tvoters++\n1091\t\t\t}\n1092\t\t}\n1093\t\treturn voters/2 + 1\n1094\t}\n1095\t\n1096\t// restoreUserSnapshot is used to manually consume an external snapshot, such\n1097\t// as if restoring from a backup. We will use the current Raft configuration,\n1098\t// not the one from the snapshot, so that we can restore into a new cluster. We\n1099\t// will also use the higher of the index of the snapshot, or the current index,\n1100\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n1101\t// so that the snapshot will be sent to followers and used for any new joiners.\n1102\t// This can only be run on the leader, and returns a future that can be used to\n1103\t// block until complete.\n1104\tfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n1105\t\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n1106\t\n1107\t\t// Sanity check the version.\n1108\t\tversion := meta.Version\n1109\t\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n1110\t\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n=== configuration.go ===\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\ttype nopConfigurationStore struct{}\n    55\t\n    56\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n    57\t\n    58\t// ServerID is a unique string identifying a server for all time.\n    59\ttype ServerID string\n    60\t\n    61\t// ServerAddress is a network address for a server that a transport can contact.\n    62\ttype ServerAddress string\n    63\t\n    64\t// Server tracks the information about a single server in a configuration.\n    65\ttype Server struct {\n    66\t\t// Suffrage determines whether the server gets a vote.\n    67\t\tSuffrage ServerSuffrage\n    68\t\t// ID is a unique string identifying this server for all time.\n    69\t\tID ServerID\n    70\t\t// Address is its network address that a transport can contact.\n    71\t\tAddress ServerAddress\n    72\t}\n    73\t\n    74\t// Configuration tracks which servers are in the cluster, and whether they have\n    75\t// votes. This should include the local server, if it's a member of the cluster.\n    76\t// The servers are listed no particular order, but each should only appear once.\n    77\t// These entries are appended to the log during membership changes.\n    78\ttype Configuration struct {\n    79\t\tServers []Server\n    80\t}\n    81\t\n    82\t// Clone makes a deep copy of a Configuration.\n    83\tfunc (c *Configuration) Clone() (copy Configuration) {\n    84\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n    85\t\treturn\n    86\t}\n    87\t\n    88\t// ConfigurationChangeCommand is the different ways to change the cluster\n    89\t// configuration.\n    90\ttype ConfigurationChangeCommand uint8\n    91\t\n    92\tconst (\n    93\t\t// AddVoter adds a server with Suffrage of Voter.\n    94\t\tAddVoter ConfigurationChangeCommand = iota\n    95\t\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n    96\t\tAddNonvoter\n    97\t\t// DemoteVoter makes a server Nonvoter unless its absent.\n    98\t\tDemoteVoter\n    99\t\t// RemoveServer removes a server entirely from the cluster membership.\n   100\t\tRemoveServer\n   101\t\t// Promote changes a server from Staging to Voter. The command will be a\n   102\t\t// no-op if the server is not Staging.\n   103\t\t// Deprecated: use AddVoter instead.\n   104\t\tPromote\n   105\t\t// AddStaging makes a server a Voter.\n   106\t\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n   107\t\tAddStaging = 0 // explicit 0 to preserve the old value.\n   108\t)\n   109\t\n   110\tfunc (c ConfigurationChangeCommand) String() string {\n   111\t\tswitch c {\n   112\t\tcase AddVoter:\n   113\t\t\treturn \"AddVoter\"\n   114\t\tcase AddNonvoter:\n   115\t\t\treturn \"AddNonvoter\"\n   116\t\tcase DemoteVoter:\n   117\t\t\treturn \"DemoteVoter\"\n   118\t\tcase RemoveServer:\n   119\t\t\treturn \"RemoveServer\"\n   120\t\tcase Promote:\n   121\t\t\treturn \"Promote\"\n   122\t\t}\n   123\t\treturn \"ConfigurationChangeCommand\"\n   124\t}\n   125\t\n   126\t// configurationChangeRequest describes a change that a leader would like to\n   127\t// make to its current configuration. It's used only within a single server\n   128\t// (never serialized into the log), as part of `configurationChangeFuture`.\n   129\ttype configurationChangeRequest struct {\n   130\t\tcommand       ConfigurationChangeCommand\n   131\t\tserverID      ServerID\n   132\t\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n   133\t\t// prevIndex, if nonzero, is the index of the only configuration upon which\n   134\t\t// this change may be applied; if another configuration entry has been\n   135\t\t// added in the meantime, this request will fail.\n   136\t\tprevIndex uint64\n   137\t}\n   138\t\n   139\t// configurations is state tracked on every server about its Configurations.\n   140\t// Note that, per Diego's dissertation, there can be at most one uncommitted\n   141\t// configuration at a time (the next configuration may not be created until the\n   142\t// prior one has been committed).\n   143\t//\n   144\t// One downside to storing just two configurations is that if you try to take a\n   145\t// snapshot when your state machine hasn't yet applied the committedIndex, we\n   146\t// have no record of the configuration that would logically fit into that\n   147\t// snapshot. We disallow snapshots in that case now. An alternative approach,\n   148\t// which LogCabin uses, is to track every configuration change in the\n   149\t// log.\n   150\ttype configurations struct {\n   151\t\t// committed is the latest configuration in the log/snapshot that has been\n   152\t\t// committed (the one with the largest index).\n   153\t\tcommitted Configuration\n   154\t\t// committedIndex is the log index where 'committed' was written.\n   155\t\tcommittedIndex uint64\n   156\t\t// latest is the latest configuration in the log/snapshot (may be committed\n   157\t\t// or uncommitted)\n   158\t\tlatest Configuration\n   159\t\t// latestIndex is the log index where 'latest' was written.\n   160\t\tlatestIndex uint64\n   161\t}\n   162\t\n   163\t// Clone makes a deep copy of a configurations object.\n   164\tfunc (c *configurations) Clone() (copy configurations) {\n   165\t\tcopy.committed = c.committed.Clone()\n   166\t\tcopy.committedIndex = c.committedIndex\n   167\t\tcopy.latest = c.latest.Clone()\n   168\t\tcopy.latestIndex = c.latestIndex\n   169\t\treturn\n   170\t}\n   171\t\n   172\t// hasVote returns true if the server identified by 'id' is a Voter in the\n   173\t// provided Configuration.\n   174\tfunc hasVote(configuration Configuration, id ServerID) bool {\n   175\t\tfor _, server := range configuration.Servers {\n   176\t\t\tif server.ID == id {\n   177\t\t\t\treturn server.Suffrage == Voter\n   178\t\t\t}\n   179\t\t}\n   180\t\treturn false\n   181\t}\n   182\t\n   183\t// inConfiguration returns true if the server identified by 'id' is in the\n   184\t// provided Configuration.\n   185\tfunc inConfiguration(configuration Configuration, id ServerID) bool {\n   186\t\tfor _, server := range configuration.Servers {\n   187\t\t\tif server.ID == id {\n   188\t\t\t\treturn true\n   189\t\t\t}\n   190\t\t}\n   191\t\treturn false\n   192\t}\n   193\t\n   194\t// checkConfiguration tests a cluster membership configuration for common\n   195\t// errors.\n   196\tfunc checkConfiguration(configuration Configuration) error {\n   197\t\tidSet := make(map[ServerID]bool)\n   198\t\taddressSet := make(map[ServerAddress]bool)\n   199\t\tvar voters int\n   200\t\tfor _, server := range configuration.Servers {\n   201\t\t\tif server.ID == \"\" {\n   202\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   203\t\t\t}\n   204\t\t\tif server.Address == \"\" {\n   205\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   206\t\t\t}\n   207\t\t\tif idSet[server.ID] {\n   208\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   209\t\t\t}\n   210\t\t\tidSet[server.ID] = true\n   211\t\t\tif addressSet[server.Address] {\n   212\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   213\t\t\t}\n   214\t\t\taddressSet[server.Address] = true\n   215\t\t\tif server.Suffrage == Voter {\n   216\t\t\t\tvoters++\n   217\t\t\t}\n   218\t\t}\n   219\t\tif voters == 0 {\n   220\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   221\t\t}\n   222\t\treturn nil\n   223\t}\n   224\t\n   225\t// nextConfiguration generates a new Configuration from the current one and a\n   226\t// configuration change request. It's split from appendConfigurationEntry so\n   227\t// that it can be unit tested easily.\n   228\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   229\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   230\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   231\t\t}\n   232\t\n   233\t\tconfiguration := current.Clone()\n   234\t\tswitch change.command {\n   235\t\tcase AddVoter:\n   236\t\t\tnewServer := Server{\n   237\t\t\t\tSuffrage: Voter,\n   238\t\t\t\tID:       change.serverID,\n   239\t\t\t\tAddress:  change.serverAddress,\n   240\t\t\t}\n   241\t\t\tfound := false\n   242\t\t\tfor i, server := range configuration.Servers {\n   243\t\t\t\tif server.ID == change.serverID {\n   244\t\t\t\t\tif server.Suffrage == Voter {\n   245\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   246\t\t\t\t\t} else {\n   247\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   248\t\t\t\t\t}\n   249\t\t\t\t\tfound = true\n   250\t\t\t\t\tbreak\n   251\t\t\t\t}\n   252\t\t\t}\n   253\t\t\tif !found {\n   254\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   255\t\t\t}\n   256\t\tcase AddNonvoter:\n   257\t\t\tnewServer := Server{\n   258\t\t\t\tSuffrage: Nonvoter,\n   259\t\t\t\tID:       change.serverID,\n   260\t\t\t\tAddress:  change.serverAddress,\n   261\t\t\t}\n   262\t\t\tfound := false\n   263\t\t\tfor i, server := range configuration.Servers {\n   264\t\t\t\tif server.ID == change.serverID {\n   265\t\t\t\t\tif server.Suffrage != Nonvoter {\n   266\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   267\t\t\t\t\t} else {\n   268\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   269\t\t\t\t\t}\n   270\t\t\t\t\tfound = true\n   271\t\t\t\t\tbreak\n   272\t\t\t\t}\n   273\t\t\t}\n   274\t\t\tif !found {\n   275\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   276\t\t\t}\n   277\t\tcase DemoteVoter:\n   278\t\t\tfor i, server := range configuration.Servers {\n   279\t\t\t\tif server.ID == change.serverID {\n   280\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   281\t\t\t\t\tbreak\n   282\t\t\t\t}\n   283\t\t\t}\n   284\t\tcase RemoveServer:\n   285\t\t\tfor i, server := range configuration.Servers {\n   286\t\t\t\tif server.ID == change.serverID {\n   287\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   288\t\t\t\t\tbreak\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\tcase Promote:\n   292\t\t\tfor i, server := range configuration.Servers {\n   293\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   294\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   295\t\t\t\t\tbreak\n   296\t\t\t\t}\n   297\t\t\t}\n   298\t\t}\n   299\t\n   300\t\t// Make sure we didn't do something bad like remove the last voter\n   301\t\tif err := checkConfiguration(configuration); err != nil {\n   302\t\t\treturn Configuration{}, err\n   303\t\t}\n   304\t\n   305\t\treturn configuration, nil\n   306\t}\n   307\t\n   308\t// encodePeers is used to serialize a Configuration into the old peers format.\n   309\t// This is here for backwards compatibility when operating with a mix of old\n   310\t// servers and should be removed once we deprecate support for protocol version 1.\n   311\tfunc encodePeers(configuration Configuration, trans Transport) []byte {\n   312\t\t// Gather up all the voters, other suffrage types are not supported by\n   313\t\t// this data format.\n   314\t\tvar encPeers [][]byte\n   315\t\tfor _, server := range configuration.Servers {\n   316\t\t\tif server.Suffrage == Voter {\n   317\t\t\t\tencPeers = append(encPeers, trans.EncodePeer(server.ID, server.Address))\n   318\t\t\t}\n   319\t\t}\n   320\t\n   321\t\t// Encode the entire array.\n   322\t\tbuf, err := encodeMsgPack(encPeers)\n   323\t\tif err != nil {\n   324\t\t\tpanic(fmt.Errorf(\"failed to encode peers: %v\", err))\n   325\t\t}\n   326\t\n   327\t\treturn buf.Bytes()\n   328\t}\n   329\t\n   330\t// decodePeers is used to deserialize an old list of peers into a Configuration.\n   331\t// This is here for backwards compatibility with old log entries and snapshots;\n   332\t// it should be removed eventually.\n   333\tfunc decodePeers(buf []byte, trans Transport) (Configuration, error) {\n   334\t\t// Decode the buffer first.\n   335\t\tvar encPeers [][]byte\n   336\t\tif err := decodeMsgPack(buf, &encPeers); err != nil {\n   337\t\t\treturn Configuration{}, fmt.Errorf(\"failed to decode peers: %v\", err)\n   338\t\t}\n   339\t\n   340\t\t// Deserialize each peer.\n   341\t\tvar servers []Server\n   342\t\tfor _, enc := range encPeers {\n   343\t\t\tp := trans.DecodePeer(enc)\n   344\t\t\tservers = append(servers, Server{\n   345\t\t\t\tSuffrage: Voter,\n   346\t\t\t\tID:       ServerID(p),\n   347\t\t\t\tAddress:  p,\n   348\t\t\t})\n   349\t\t}\n   350\t\n   351\t\treturn Configuration{Servers: servers}, nil\n   352\t}\n   353\t\n   354\t// EncodeConfiguration serializes a Configuration using MsgPack, or panics on\n   355\t// errors.\n   356\tfunc EncodeConfiguration(configuration Configuration) []byte {\n   357\t\tbuf, err := encodeMsgPack(configuration)\n   358\t\tif err != nil {\n   359\t\t\tpanic(fmt.Errorf(\"failed to encode configuration: %v\", err))\n   360\t\t}\n   361\t\treturn buf.Bytes()\n   362\t}\n   363\t\n   364\t// DecodeConfiguration deserializes a Configuration using MsgPack, or panics on\n   365\t// errors.\n   366\tfunc DecodeConfiguration(buf []byte) Configuration {\n   367\t\tvar configuration Configuration\n   368\t\tif err := decodeMsgPack(buf, &configuration); err != nil {\n   369\t\t\tpanic(fmt.Errorf(\"failed to decode configuration: %v\", err))\n   370\t\t}\n   371\t\treturn configuration\n   372\t}\n","exit_code":0,"status":"completed"}}
