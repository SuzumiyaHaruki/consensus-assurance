stLog.Index, lastLog.Term)\n591\t\n592\t\t// Attempt to restore a snapshot if there are any.\n593\t\tif err := r.restoreSnapshot(); err != nil {\n594\t\t\treturn nil, err\n595\t\t}\n596\t\n597\t\t// Scan through the log for any configuration change entries.\n598\t\tsnapshotIndex, _ := r.getLastSnapshot()\n599\t\tfor index := snapshotIndex + 1; index <= lastLog.Index; index++ {\n600\t\t\tvar entry Log\n601\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n603\t\t\t\tpanic(err)\n604\t\t\t}\n605\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n606\t\t\t\treturn nil, err\n607\t\t\t}\n608\t\t}\n609\t\tr.logger.Info(\"initial configuration\",\n610\t\t\t\"index\", r.configurations.latestIndex,\n611\t\t\t\"servers\", hclog.Fmt(\"%+v\", r.configurations.latest.Servers))\n612\t\n613\t\t// Setup a heartbeat fast-path to avoid head-of-line\n614\t\t// blocking where possible. It MUST be safe for this\n615\t\t// to be called concurrently with a blocking RPC.\n616\t\ttrans.SetHeartbeatHandler(r.processHeartbeat)\n617\t\n618\t\tif conf.skipStartup {\n619\t\t\treturn r, nil\n620\t\t}\n621\t\t// Start the background work.\n622\t\tr.goFunc(r.run)\n623\t\tr.goFunc(r.runFSM)\n624\t\tr.goFunc(r.runSnapshots)\n625\t\treturn r, nil\n626\t}\n627\t\n628\t// restoreSnapshot attempts to restore the latest snapshots, and fails if none\n629\t// of them can be restored. This is called at initialization time, and is\n630\t// completely unsafe to call at any other time.\n631\tfunc (r *Raft) restoreSnapshot() error {\n632\t\tsnapshots, err := r.snapshots.List()\n633\t\tif err != nil {\n634\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n635\t\t\treturn err\n636\t\t}\n637\t\n638\t\t// Try to load in order of newest to oldest\n639\t\tfor _, snapshot := range snapshots {\n640\t\t\tif success := r.tryRestoreSingleSnapshot(snapshot); !success {\n641\t\t\t\tcontinue\n642\t\t\t}\n643\t\n644\t\t\t// Update the lastApplied so we don't replay old logs\n645\t\t\tr.setLastApplied(snapshot.Index)\n646\t\n647\t\t\t// Update the last stable snapshot info\n648\t\t\tr.setLastSnapshot(snapshot.Index, snapshot.Term)\n649\t\n650\t\t\t// Update the configuration\n651\t\t\tvar conf Configuration\n652\t\t\tvar index uint64\n653\t\t\tif snapshot.Version > 0 {\n654\t\t\t\tconf = snapshot.Configuration\n655\t\t\t\tindex = snapshot.ConfigurationIndex\n656\t\t\t} else {\n657\t\t\t\tvar err error\n658\t\t\t\tif conf, err = decodePeers(snapshot.Peers, r.trans); err != nil {\n659\t\t\t\t\treturn err\n660\t\t\t\t}\n=== replication funcs ===\n100:func (s *followerReplication) notifyAll(leader bool) {\n114:func (s *followerReplication) cleanNotify(v *verifyFuture) {\n121:func (s *followerReplication) LastContact() time.Time {\n129:func (s *followerReplication) setLastContact() {\n137:func (r *Raft) replicate(s *followerReplication) {\n202:func (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n299:func (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n388:func (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n446:func (r *Raft) pipelineReplicate(s *followerReplication) error {\n512:func (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n534:func (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n570:func (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n587:func (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n614:func (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n633:func appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n646:func (r *Raft) handleStaleTerm(s *followerReplication) {\n655:func updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n","exit_code":0,"status":"completed"}}
