{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"cd agent-source; sed -n '158,470p' raft.go | cat -n | sed 's/\"'^/ /'\"' | awk '{printf \\\"%d: %s\\\\n\\\", NR+157, substr(\"'$0, index($0,$2))}'\"' 2>/dev/null | head -5; echo \\\"=== plain ===\\\"; awk 'NR>=158 && NR<=470 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"158: func (r *Raft) runFollower() {\n159: didWarn := false\n160: leaderAddr, leaderID := r.LeaderWithID()\n161: r.logger.Info(\"entering follower state\", \"follower\", r, \"leader-address\", leaderAddr, \"leader-id\", leaderID)\n162: metrics.IncrCounter([]string{\"raft\", \"state\", \"follower\"}, 1)\n=== plain ===\n158\tfunc (r *Raft) runFollower() {\n159\t\tdidWarn := false\n160\t\tleaderAddr, leaderID := r.LeaderWithID()\n161\t\tr.logger.Info(\"entering follower state\", \"follower\", r, \"leader-address\", leaderAddr, \"leader-id\", leaderID)\n162\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"follower\"}, 1)\n163\t\theartbeatTimer := randomTimeout(r.config().HeartbeatTimeout)\n164\t\n165\t\tfor r.getState() == Follower {\n166\t\t\tr.mainThreadSaturation.sleeping()\n167\t\n168\t\t\tselect {\n169\t\t\tcase rpc := <-r.rpcCh:\n170\t\t\t\tr.mainThreadSaturation.working()\n171\t\t\t\tr.processRPC(rpc)\n172\t\n173\t\t\tcase c := <-r.configurationChangeCh:\n174\t\t\t\tr.mainThreadSaturation.working()\n175\t\t\t\t// Reject any operations since we are not the leader\n176\t\t\t\tc.respond(ErrNotLeader)\n177\t\n178\t\t\tcase a := <-r.applyCh:\n179\t\t\t\tr.mainThreadSaturation.working()\n180\t\t\t\t// Reject any operations since we are not the leader\n181\t\t\t\ta.respond(ErrNotLeader)\n182\t\n183\t\t\tcase v := <-r.verifyCh:\n184\t\t\t\tr.mainThreadSaturation.working()\n185\t\t\t\t// Reject any operations since we are not the leader\n186\t\t\t\tv.respond(ErrNotLeader)\n187\t\n188\t\t\tcase ur := <-r.userRestoreCh:\n189\t\t\t\tr.mainThreadSaturation.working()\n190\t\t\t\t// Reject any restores since we are not the leader\n191\t\t\t\tur.respond(ErrNotLeader)\n192\t\n193\t\t\tcase l := <-r.leadershipTransferCh:\n194\t\t\t\tr.mainThreadSaturation.working()\n195\t\t\t\t// Reject any operations since we are not the leader\n196\t\t\t\tl.respond(ErrNotLeader)\n197\t\n198\t\t\tcase c := <-r.configurationsCh:\n199\t\t\t\tr.mainThreadSaturation.working()\n200\t\t\t\tc.configurations = r.configurations.Clone()\n201\t\t\t\tc.respond(nil)\n202\t\n203\t\t\tcase b := <-r.bootstrapCh:\n204\t\t\t\tr.mainThreadSaturation.working()\n205\t\t\t\tb.respond(r.liveBootstrap(b.configuration))\n206\t\n207\t\t\tcase <-r.leaderNotifyCh:\n208\t\t\t\t//  Ignore since we are not the leader\n209\t\n210\t\t\tcase <-r.followerNotifyCh:\n211\t\t\t\theartbeatTimer = time.After(0)\n212\t\n213\t\t\tcase <-heartbeatTimer:\n214\t\t\t\tr.mainThreadSaturation.working()\n215\t\t\t\t// Restart the heartbeat timer\n216\t\t\t\thbTimeout := r.config().HeartbeatTimeout\n217\t\t\t\theartbeatTimer = randomTimeout(hbTimeout)\n218\t\n219\t\t\t\t// Check if we have had a successful contact\n220\t\t\t\tlastContact := r.LastContact()\n221\t\t\t\tif time.Since(lastContact) < hbTimeout {\n222\t\t\t\t\tcontinue\n223\t\t\t\t}\n224\t\n225\t\t\t\t// Heartbeat failed! Transition to the candidate state\n226\t\t\t\tlastLeaderAddr, lastLeaderID := r.LeaderWithID()\n227\t\t\t\tr.setLeader(\"\", \"\")\n228\t\n229\t\t\t\tif r.configurations.latestIndex == 0 {\n230\t\t\t\t\tif !didWarn {\n231\t\t\t\t\t\tr.logger.Warn(\"no known peers, aborting election\")\n232\t\t\t\t\t\tdidWarn = true\n233\t\t\t\t\t}\n234\t\t\t\t} else if r.configurations.latestIndex == r.configurations.committedIndex &&\n235\t\t\t\t\t!hasVote(r.configurations.latest, r.localID) {\n236\t\t\t\t\tif !didWarn {\n237\t\t\t\t\t\tr.logger.Warn(\"not part of stable configuration, aborting election\")\n238\t\t\t\t\t\tdidWarn = true\n239\t\t\t\t\t}\n240\t\t\t\t} else {\n241\t\t\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"heartbeat_timeout\"}, 1)\n242\t\t\t\t\tif hasVote(r.configurations.latest, r.localID) {\n243\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, starting election\", \"last-leader-addr\", lastLeaderAddr, \"last-leader-id\", lastLeaderID)\n244\t\t\t\t\t\tr.setState(Candidate)\n245\t\t\t\t\t\treturn\n246\t\t\t\t\t} else if !didWarn {\n247\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, not part of a stable configuration or a non-voter, not triggering a leader election\")\n248\t\t\t\t\t\tdidWarn = true\n249\t\t\t\t\t}\n250\t\t\t\t}\n251\t\n252\t\t\tcase <-r.shutdownCh:\n253\t\t\t\treturn\n254\t\t\t}\n255\t\t}\n256\t}\n257\t\n258\t// liveBootstrap attempts to seed an initial configuration for the cluster. See\n259\t// the Raft object's member BootstrapCluster for more details. This must only be\n260\t// called on the main thread, and only makes sense in the follower state.\n261\tfunc (r *Raft) liveBootstrap(configuration Configuration) error {\n262\t\tif !hasVote(configuration, r.localID) {\n263\t\t\t// Reject this operation since we are not a voter\n264\t\t\treturn ErrNotVoter\n265\t\t}\n266\t\n267\t\t// Use the pre-init API to make the static updates.\n268\t\tcfg := r.config()\n269\t\terr := BootstrapCluster(&cfg, r.logs, r.stable, r.snapshots, r.trans, configuration)\n270\t\tif err != nil {\n271\t\t\treturn err\n272\t\t}\n273\t\n274\t\t// Make the configuration live.\n275\t\tvar entry Log\n276\t\tif err := r.logs.GetLog(1, &entry); err != nil {\n277\t\t\tpanic(err)\n278\t\t}\n279\t\tr.setCurrentTerm(1)\n280\t\tr.setLastLog(entry.Index, entry.Term)\n281\t\treturn r.processConfigurationLogEntry(&entry)\n282\t}\n283\t\n284\t// runCandidate runs the main loop while in the candidate state.\n285\tfunc (r *Raft) runCandidate() {\n286\t\tterm := r.getCurrentTerm() + 1\n287\t\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n288\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n289\t\n290\t\t// Start vote for us, and set a timeout\n291\t\tvar voteCh <-chan *voteResult\n292\t\tvar prevoteCh <-chan *preVoteResult\n293\t\n294\t\t// check if pre-vote is active and that this is not a leader transfer.\n295\t\t// Leader transfer do not perform prevote by design\n296\t\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n297\t\t\tprevoteCh = r.preElectSelf()\n298\t\t} else {\n299\t\t\tvoteCh = r.electSelf()\n300\t\t}\n301\t\n302\t\t// Make sure the leadership transfer flag is reset after each run. Having this\n303\t\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n304\t\t// which will make other servers vote even though they have a leader already.\n305\t\t// It is important to reset that flag, because this privilege could be abused\n306\t\t// otherwise.\n307\t\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n308\t\n309\t\telectionTimeout := r.config().ElectionTimeout\n310\t\telectionTimer := randomTimeout(electionTimeout)\n311\t\n312\t\t// Tally the votes, need a simple majority\n313\t\tpreVoteGrantedVotes := 0\n314\t\tpreVoteRefusedVotes := 0\n315\t\tgrantedVotes := 0\n316\t\tvotesNeeded := r.quorumSize()\n317\t\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n318\t\n319\t\tfor r.getState() == Candidate {\n320\t\t\tr.mainThreadSaturation.sleeping()\n321\t\n322\t\t\tselect {\n323\t\t\tcase rpc := <-r.rpcCh:\n324\t\t\t\tr.mainThreadSaturation.working()\n325\t\t\t\tr.processRPC(rpc)\n326\t\t\tcase preVote := <-prevoteCh:\n327\t\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n328\t\t\t\tr.mainThreadSaturation.working()\n329\t\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n330\t\t\t\t// Check if the term is greater than ours, bail\n331\t\t\t\tif preVote.Term > term {\n332\t\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n333\t\t\t\t\tr.setState(Follower)\n334\t\t\t\t\tr.setCurrentTerm(preVote.Term)\n335\t\t\t\t\treturn\n336\t\t\t\t}\n337\t\n338\t\t\t\t// Check if the preVote is granted\n339\t\t\t\tif preVote.Granted {\n340\t\t\t\t\tpreVoteGrantedVotes++\n341\t\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n342\t\t\t\t} else {\n343\t\t\t\t\tpreVoteRefusedVotes++\n344\t\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n345\t\t\t\t}\n346\t\n347\t\t\t\t// Check if we've won the pre-vote and proceed to election if so\n348\t\t\t\tif preVoteGrantedVotes >= votesNeeded {\n349\t\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n350\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n351\t\t\t\t\tpreVoteGrantedVotes = 0\n352\t\t\t\t\tpreVoteRefusedVotes = 0\n353\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n354\t\t\t\t\tprevoteCh = nil\n355\t\t\t\t\tvoteCh = r.electSelf()\n356\t\t\t\t}\n357\t\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n358\t\t\t\t// prevote.\n359\t\t\t\tif preVoteRefusedVotes >= votesNeeded {\n360\t\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n361\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n362\t\t\t\t}\n363\t\t\tcase vote := <-voteCh:\n364\t\t\t\tr.mainThreadSaturation.working()\n365\t\t\t\t// Check if the term is greater than ours, bail\n366\t\t\t\tif vote.Term > r.getCurrentTerm() {\n367\t\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n368\t\t\t\t\tr.setState(Follower)\n369\t\t\t\t\tr.setCurrentTerm(vote.Term)\n370\t\t\t\t\treturn\n371\t\t\t\t}\n372\t\n373\t\t\t\t// Check if the vote is granted\n374\t\t\t\tif vote.Granted {\n375\t\t\t\t\tgrantedVotes++\n376\t\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n377\t\t\t\t}\n378\t\n379\t\t\t\t// Check if we've become the leader\n380\t\t\t\tif grantedVotes >= votesNeeded {\n381\t\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n382\t\t\t\t\tr.setState(Leader)\n383\t\t\t\t\tr.setLeader(r.localAddr, r.localID)\n384\t\t\t\t\treturn\n385\t\t\t\t}\n386\t\t\tcase c := <-r.configurationChangeCh:\n387\t\t\t\tr.mainThreadSaturation.working()\n388\t\t\t\t// Reject any operations since we are not the leader\n389\t\t\t\tc.respond(ErrNotLeader)\n390\t\n391\t\t\tcase a := <-r.applyCh:\n392\t\t\t\tr.mainThreadSaturation.working()\n393\t\t\t\t// Reject any operations since we are not the leader\n394\t\t\t\ta.respond(ErrNotLeader)\n395\t\n396\t\t\tcase v := <-r.verifyCh:\n397\t\t\t\tr.mainThreadSaturation.working()\n398\t\t\t\t// Reject any operations since we are not the leader\n399\t\t\t\tv.respond(ErrNotLeader)\n400\t\n401\t\t\tcase ur := <-r.userRestoreCh:\n402\t\t\t\tr.mainThreadSaturation.working()\n403\t\t\t\t// Reject any restores since we are not the leader\n404\t\t\t\tur.respond(ErrNotLeader)\n405\t\n406\t\t\tcase l := <-r.leadershipTransferCh:\n407\t\t\t\tr.mainThreadSaturation.working()\n408\t\t\t\t// Reject any operations since we are not the leader\n409\t\t\t\tl.respond(ErrNotLeader)\n410\t\n411\t\t\tcase c := <-r.configurationsCh:\n412\t\t\t\tr.mainThreadSaturation.working()\n413\t\t\t\tc.configurations = r.configurations.Clone()\n414\t\t\t\tc.respond(nil)\n415\t\n416\t\t\tcase b := <-r.bootstrapCh:\n417\t\t\t\tr.mainThreadSaturation.working()\n418\t\t\t\tb.respond(ErrCantBootstrap)\n419\t\n420\t\t\tcase <-r.leaderNotifyCh:\n421\t\t\t\t//  Ignore since we are not the leader\n422\t\n423\t\t\tcase <-r.followerNotifyCh:\n424\t\t\t\tif electionTimeout != r.config().ElectionTimeout {\n425\t\t\t\t\telectionTimeout = r.config().ElectionTimeout\n426\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n427\t\t\t\t}\n428\t\n429\t\t\tcase <-electionTimer:\n430\t\t\t\tr.mainThreadSaturation.working()\n431\t\t\t\t// Election failed! Restart the election. We simply return,\n432\t\t\t\t// which will kick us back into runCandidate\n433\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n434\t\t\t\treturn\n435\t\n436\t\t\tcase <-r.shutdownCh:\n437\t\t\t\treturn\n438\t\t\t}\n439\t\t}\n440\t}\n441\t\n442\tfunc (r *Raft) setLeadershipTransferInProgress(v bool) {\n443\t\tif v {\n444\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 1)\n445\t\t} else {\n446\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 0)\n447\t\t}\n448\t}\n449\t\n450\tfunc (r *Raft) getLeadershipTransferInProgress() bool {\n451\t\tv := atomic.LoadInt32(&r.leaderState.leadershipTransferInProgress)\n452\t\treturn v == 1\n453\t}\n454\t\n455\tfunc (r *Raft) setupLeaderState() {\n456\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n457\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n458\t\t\tr.configurations.latest,\n459\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n460\t\tr.leaderState.inflight = list.New()\n461\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n462\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n463\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n464\t}\n465\t\n466\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n467\t// the leaderLoop for the hot loop.\n468\tfunc (r *Raft) runLeader() {\n469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n","exit_code":0,"status":"completed"}}
