{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=1976 && NR<=2165 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"1976\tfunc (r *Raft) electSelf() <-chan *voteResult {\n1977\t\t// Create a response channel\n1978\t\trespCh := make(chan *voteResult, len(r.configurations.latest.Servers))\n1979\t\n1980\t\t// Increment the term\n1981\t\tnewTerm := r.getCurrentTerm() + 1\n1982\t\n1983\t\tr.setCurrentTerm(newTerm)\n1984\t\t// Construct the request\n1985\t\tlastIdx, lastTerm := r.getLastEntry()\n1986\t\treq := &RequestVoteRequest{\n1987\t\t\tRPCHeader: r.getRPCHeader(),\n1988\t\t\tTerm:      newTerm,\n1989\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n1990\t\t\tCandidate:          r.trans.EncodePeer(r.localID, r.localAddr),\n1991\t\t\tLastLogIndex:       lastIdx,\n1992\t\t\tLastLogTerm:        lastTerm,\n1993\t\t\tLeadershipTransfer: r.candidateFromLeadershipTransfer.Load(),\n1994\t\t}\n1995\t\n1996\t\t// Construct a function to ask for a vote\n1997\t\taskPeer := func(peer Server) {\n1998\t\t\tr.goFunc(func() {\n1999\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n2000\t\t\t\tresp := &voteResult{voterID: peer.ID}\n2001\t\t\t\terr := r.trans.RequestVote(peer.ID, peer.Address, req, &resp.RequestVoteResponse)\n2002\t\t\t\tif err != nil {\n2003\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n2004\t\t\t\t\t\t\"target\", peer,\n2005\t\t\t\t\t\t\"error\", err,\n2006\t\t\t\t\t\t\"term\", req.Term)\n2007\t\t\t\t\tresp.Term = req.Term\n2008\t\t\t\t\tresp.Granted = false\n2009\t\t\t\t}\n2010\t\t\t\trespCh <- resp\n2011\t\t\t})\n2012\t\t}\n2013\t\n2014\t\t// For each peer, request a vote\n2015\t\tfor _, server := range r.configurations.latest.Servers {\n2016\t\t\tif server.Suffrage == Voter {\n2017\t\t\t\tif server.ID == r.localID {\n2018\t\t\t\t\tr.logger.Debug(\"voting for self\", \"term\", req.Term, \"id\", r.localID)\n2019\t\n2020\t\t\t\t\t// Persist a vote for ourselves\n2021\t\t\t\t\tif err := r.persistVote(req.Term, req.RPCHeader.Addr); err != nil {\n2022\t\t\t\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n2023\t\t\t\t\t\treturn nil\n2024\t\n2025\t\t\t\t\t}\n2026\t\t\t\t\t// Include our own vote\n2027\t\t\t\t\trespCh <- &voteResult{\n2028\t\t\t\t\t\tRequestVoteResponse: RequestVoteResponse{\n2029\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n2030\t\t\t\t\t\t\tTerm:      req.Term,\n2031\t\t\t\t\t\t\tGranted:   true,\n2032\t\t\t\t\t\t},\n2033\t\t\t\t\t\tvoterID: r.localID,\n2034\t\t\t\t\t}\n2035\t\t\t\t} else {\n2036\t\t\t\t\tr.logger.Debug(\"asking for vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n2037\t\t\t\t\taskPeer(server)\n2038\t\t\t\t}\n2039\t\t\t}\n2040\t\t}\n2041\t\n2042\t\treturn respCh\n2043\t}\n2044\t\n2045\t// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\n2046\t// ourself. This will not increment the current term. The\n2047\t// response channel returned is used to wait for all the responses (including a\n2048\t// vote for ourself).\n2049\t// This must only be called from the main thread.\n2050\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n2051\t\n2052\t\t// At this point transport should support pre-vote\n2053\t\t// but check just in case\n2054\t\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\n2055\t\tif !prevoteTransSupported {\n2056\t\t\tpanic(\"preElection is not possible if the transport don't support pre-vote\")\n2057\t\t}\n2058\t\n2059\t\t// Create a response channel\n2060\t\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\n2061\t\n2062\t\t// Propose the next term without actually changing our state\n2063\t\tnewTerm := r.getCurrentTerm() + 1\n2064\t\n2065\t\t// Construct the request\n2066\t\tlastIdx, lastTerm := r.getLastEntry()\n2067\t\treq := &RequestPreVoteRequest{\n2068\t\t\tRPCHeader:    r.getRPCHeader(),\n2069\t\t\tTerm:         newTerm,\n2070\t\t\tLastLogIndex: lastIdx,\n2071\t\t\tLastLogTerm:  lastTerm,\n2072\t\t}\n2073\t\n2074\t\t// Construct a function to ask for a vote\n2075\t\taskPeer := func(peer Server) {\n2076\t\t\tr.goFunc(func() {\n2077\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"preElectSelf\"}, time.Now())\n2078\t\t\t\tresp := &preVoteResult{voterID: peer.ID}\n2079\t\n2080\t\t\t\terr := prevoteTrans.RequestPreVote(peer.ID, peer.Address, req, &resp.RequestPreVoteResponse)\n2081\t\n2082\t\t\t\t// If the target server do not support Pre-vote RPC we count this as a granted vote to allow\n2083\t\t\t\t// the cluster to progress.\n2084\t\t\t\tif err != nil && strings.Contains(err.Error(), rpcUnexpectedCommandError) {\n2085\t\t\t\t\tr.logger.Error(\"target does not support pre-vote RPC, treating as granted\",\n2086\t\t\t\t\t\t\"target\", peer,\n2087\t\t\t\t\t\t\"error\", err,\n2088\t\t\t\t\t\t\"term\", req.Term)\n2089\t\t\t\t\tresp.Term = req.Term\n2090\t\t\t\t\tresp.Granted = true\n2091\t\t\t\t} else if err != nil {\n2092\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n2093\t\t\t\t\t\t\"target\", peer,\n2094\t\t\t\t\t\t\"error\", err,\n2095\t\t\t\t\t\t\"term\", req.Term)\n2096\t\t\t\t\tresp.Term = req.Term\n2097\t\t\t\t\tresp.Granted = false\n2098\t\t\t\t}\n2099\t\t\t\trespCh <- resp\n2100\t\n2101\t\t\t})\n2102\t\t}\n2103\t\n2104\t\t// For each peer, request a vote\n2105\t\tfor _, server := range r.configurations.latest.Servers {\n2106\t\t\tif server.Suffrage == Voter {\n2107\t\t\t\tif server.ID == r.localID {\n2108\t\t\t\t\tr.logger.Debug(\"pre-voting for self\", \"term\", req.Term, \"id\", r.localID)\n2109\t\n2110\t\t\t\t\t// cast a pre-vote for our self\n2111\t\t\t\t\trespCh <- &preVoteResult{\n2112\t\t\t\t\t\tRequestPreVoteResponse: RequestPreVoteResponse{\n2113\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n2114\t\t\t\t\t\t\tTerm:      req.Term,\n2115\t\t\t\t\t\t\tGranted:   true,\n2116\t\t\t\t\t\t},\n2117\t\t\t\t\t\tvoterID: r.localID,\n2118\t\t\t\t\t}\n2119\t\t\t\t} else {\n2120\t\t\t\t\tr.logger.Debug(\"asking for pre-vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n2121\t\t\t\t\taskPeer(server)\n2122\t\t\t\t}\n2123\t\t\t}\n2124\t\t}\n2125\t\n2126\t\treturn respCh\n2127\t}\n2128\t\n2129\t// persistVote is used to persist our vote for safety.\n2130\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n2131\t\tif err := r.stable.SetUint64(keyLastVoteTerm, term); err != nil {\n2132\t\t\treturn err\n2133\t\t}\n2134\t\tif err := r.stable.Set(keyLastVoteCand, candidate); err != nil {\n2135\t\t\treturn err\n2136\t\t}\n2137\t\treturn nil\n2138\t}\n2139\t\n2140\t// setCurrentTerm is used to set the current term in a durable manner.\n2141\tfunc (r *Raft) setCurrentTerm(t uint64) {\n2142\t\t// Persist to disk first\n2143\t\tif err := r.stable.SetUint64(keyCurrentTerm, t); err != nil {\n2144\t\t\tpanic(fmt.Errorf(\"failed to save current term: %v\", err))\n2145\t\t}\n2146\t\tr.raftState.setCurrentTerm(t)\n2147\t}\n2148\t\n2149\t// setState is used to update the current state. Any state\n2150\t// transition causes the known leader to be cleared. This means\n2151\t// that leader should be set only after updating the state.\n2152\tfunc (r *Raft) setState(state RaftState) {\n2153\t\tr.setLeader(\"\", \"\")\n2154\t\toldState := r.raftState.getState()\n2155\t\tr.raftState.setState(state)\n2156\t\tif oldState != state {\n2157\t\t\tr.observe(state)\n2158\t\t}\n2159\t}\n2160\t\n2161\t// pickServer returns the follower that is most up to date and participating in quorum.\n2162\t// Because it accesses leaderstate, it should only be called from the leaderloop.\n2163\tfunc (r *Raft) pickServer() *Server {\n2164\t\tvar pick *Server\n2165\t\tvar current uint64\n","exit_code":0,"status":"completed"}}
