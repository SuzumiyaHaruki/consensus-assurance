{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=137 && NR<=300 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' replication.go; echo \\\"=== 646-665 ===\\\"; awk 'NR>=646 && NR<=665 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' replication.go\"","aggregated_output":"137\tfunc (r *Raft) replicate(s *followerReplication) {\n138\t\t// Start an async heartbeating routing\n139\t\tstopHeartbeat := make(chan struct{})\n140\t\tdefer close(stopHeartbeat)\n141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n142\t\n143\tRPC:\n144\t\tshouldStop := false\n145\t\tfor !shouldStop {\n146\t\t\tselect {\n147\t\t\tcase maxIndex := <-s.stopCh:\n148\t\t\t\t// Make a best effort to replicate up to this index\n149\t\t\t\tif maxIndex > 0 {\n150\t\t\t\t\tr.replicateTo(s, maxIndex)\n151\t\t\t\t}\n152\t\t\t\treturn\n153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n156\t\t\t\tif !shouldStop {\n157\t\t\t\t\tdeferErr.respond(nil)\n158\t\t\t\t} else {\n159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n160\t\t\t\t}\n161\t\t\tcase <-s.triggerCh:\n162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n165\t\t\t// followers quickly learn the leader's commit index when\n166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n167\t\t\t// can't do this to keep them unblocked by disk IO on the\n168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n172\t\t\t}\n173\t\n174\t\t\t// If things looks healthy, switch to pipeline mode\n175\t\t\tif !shouldStop && s.allowPipeline {\n176\t\t\t\tgoto PIPELINE\n177\t\t\t}\n178\t\t}\n179\t\treturn\n180\t\n181\tPIPELINE:\n182\t\t// Disable until re-enabled\n183\t\ts.allowPipeline = false\n184\t\n185\t\t// Replicates using a pipeline for high performance. This method\n186\t\t// is not able to gracefully recover from errors, and so we fall back\n187\t\t// to standard mode on failure.\n188\t\tif err := r.pipelineReplicate(s); err != nil {\n189\t\t\tif err != ErrPipelineReplicationNotSupported {\n190\t\t\t\ts.peerLock.RLock()\n191\t\t\t\tpeer := s.peer\n192\t\t\t\ts.peerLock.RUnlock()\n193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n194\t\t\t}\n195\t\t}\n196\t\tgoto RPC\n197\t}\n198\t\n199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n200\t// given last index.\n201\t// If the follower log is behind, we take care to bring them up to date.\n202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n203\t\t// Create the base request\n204\t\tvar req AppendEntriesRequest\n205\t\tvar resp AppendEntriesResponse\n206\t\tvar start time.Time\n207\t\tvar peer Server\n208\t\n209\tSTART:\n210\t\t// Prevent an excessive retry rate on errors\n211\t\tif s.failures > 0 {\n212\t\t\tselect {\n213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n214\t\t\tcase <-r.shutdownCh:\n215\t\t\t}\n216\t\t}\n217\t\n218\t\ts.peerLock.RLock()\n219\t\tpeer = s.peer\n220\t\ts.peerLock.RUnlock()\n221\t\n222\t\t// Setup the request\n223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n224\t\t\tgoto SEND_SNAP\n225\t\t} else if err != nil {\n226\t\t\treturn\n227\t\t}\n228\t\n229\t\t// Make the RPC call\n230\t\tstart = time.Now()\n231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n233\t\t\ts.failures++\n234\t\t\treturn\n235\t\t}\n236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n237\t\n238\t\t// Check for a newer term, stop running\n239\t\tif resp.Term > req.Term {\n240\t\t\tr.handleStaleTerm(s)\n241\t\t\treturn true\n242\t\t}\n243\t\n244\t\t// Update the last contact\n245\t\ts.setLastContact()\n246\t\n247\t\t// Update s based on success\n248\t\tif resp.Success {\n249\t\t\t// Update our replication state\n250\t\t\tupdateLastAppended(s, &req)\n251\t\n252\t\t\t// Clear any failures, allow pipelining\n253\t\t\ts.failures = 0\n254\t\t\ts.allowPipeline = true\n255\t\t} else {\n256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n257\t\t\tif resp.NoRetryBackoff {\n258\t\t\t\ts.failures = 0\n259\t\t\t} else {\n260\t\t\t\ts.failures++\n261\t\t\t}\n262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n263\t\t}\n264\t\n265\tCHECK_MORE:\n266\t\t// Poll the stop channel here in case we are looping and have been asked\n267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n268\t\t// where we are asked to replicate to a given index and then shutdown,\n269\t\t// it's better to not loop in here to send lots of entries to a straggler\n270\t\t// that's leaving the cluster anyways.\n271\t\tselect {\n272\t\tcase <-s.stopCh:\n273\t\t\treturn true\n274\t\tdefault:\n275\t\t}\n276\t\n277\t\t// Check if there are more logs to replicate\n278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n279\t\t\tgoto START\n280\t\t}\n281\t\treturn\n282\t\n283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n284\t\t// is too far behind, and we must ship a snapshot down instead\n285\tSEND_SNAP:\n286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n287\t\t\treturn true\n288\t\t} else if err != nil {\n289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n290\t\t\treturn\n291\t\t}\n292\t\n293\t\t// Check if there is more to replicate\n294\t\tgoto CHECK_MORE\n295\t}\n296\t\n297\t// sendLatestSnapshot is used to send the latest snapshot we have\n298\t// down to our follower.\n299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n300\t\t// Get the snapshots\n=== 646-665 ===\n646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n648\t\ts.notifyAll(false) // No longer leader\n649\t\tasyncNotifyCh(s.stepDown)\n650\t}\n651\t\n652\t// updateLastAppended is used to update follower replication state after a\n653\t// successful AppendEntries RPC.\n654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n656\t\t// Mark any inflight logs as committed\n657\t\tif logs := req.Entries; len(logs) > 0 {\n658\t\t\tlast := logs[len(logs)-1]\n659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n661\t\t}\n662\t\n663\t\t// Notify still leader\n664\t\ts.notifyAll(true)\n665\t}\n","exit_code":0,"status":"completed"}}
