{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=1603 && NR<=1830 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"1603\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n1604\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n1605\t\tr.observe(*req)\n1606\t\n1607\t\t// Setup a response\n1608\t\tresp := &RequestVoteResponse{\n1609\t\t\tRPCHeader: r.getRPCHeader(),\n1610\t\t\tTerm:      r.getCurrentTerm(),\n1611\t\t\tGranted:   false,\n1612\t\t}\n1613\t\tvar rpcErr error\n1614\t\tdefer func() {\n1615\t\t\trpc.Respond(resp, rpcErr)\n1616\t\t}()\n1617\t\n1618\t\t// Version 0 servers will panic unless the peers is present. It's only\n1619\t\t// used on them to produce a warning message.\n1620\t\tif r.protocolVersion < 2 {\n1621\t\t\tresp.Peers = encodePeers(r.configurations.latest, r.trans)\n1622\t\t}\n1623\t\n1624\t\t// Check if we have an existing leader [who's not the candidate] and also\n1625\t\t// check the LeadershipTransfer flag is set. Usually votes are rejected if\n1626\t\t// there is a known leader. But if the leader initiated a leadership transfer,\n1627\t\t// vote!\n1628\t\tvar candidate ServerAddress\n1629\t\tvar candidateBytes []byte\n1630\t\tif len(req.RPCHeader.Addr) > 0 {\n1631\t\t\tcandidate = r.trans.DecodePeer(req.RPCHeader.Addr)\n1632\t\t\tcandidateBytes = req.RPCHeader.Addr\n1633\t\t} else {\n1634\t\t\tcandidate = r.trans.DecodePeer(req.Candidate)\n1635\t\t\tcandidateBytes = req.Candidate\n1636\t\t}\n1637\t\n1638\t\t// For older raft version ID is not part of the packed message\n1639\t\t// We assume that the peer is part of the configuration and skip this check\n1640\t\tif len(req.ID) > 0 {\n1641\t\t\tcandidateID := ServerID(req.ID)\n1642\t\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n1643\t\t\t// Grant the vote\n1644\t\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n1645\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not in configuration\",\n1646\t\t\t\t\t\"from\", candidate)\n1647\t\t\t\treturn\n1648\t\t\t}\n1649\t\t}\n1650\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate && !req.LeadershipTransfer {\n1651\t\t\tr.logger.Warn(\"rejecting vote request since we have a leader\",\n1652\t\t\t\t\"from\", candidate,\n1653\t\t\t\t\"leader\", leaderAddr,\n1654\t\t\t\t\"leader-id\", string(leaderID))\n1655\t\t\treturn\n1656\t\t}\n1657\t\n1658\t\t// Ignore an older term\n1659\t\tif req.Term < r.getCurrentTerm() {\n1660\t\t\treturn\n1661\t\t}\n1662\t\n1663\t\t// Increase the term if we see a newer one\n1664\t\tif req.Term > r.getCurrentTerm() {\n1665\t\t\t// Ensure transition to follower\n1666\t\t\tr.logger.Debug(\"lost leadership because received a requestVote with a newer term\")\n1667\t\t\tr.setState(Follower)\n1668\t\t\tr.setCurrentTerm(req.Term)\n1669\t\n1670\t\t\tresp.Term = req.Term\n1671\t\t}\n1672\t\n1673\t\t// if we get a request for vote from a nonVoter  and the request term is higher,\n1674\t\t// step down and update term, but reject the vote request\n1675\t\t// This could happen when a node, previously voter, is converted to non-voter\n1676\t\t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n1677\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n1678\t\tif len(req.ID) > 0 {\n1679\t\t\tcandidateID := ServerID(req.ID)\n1680\t\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n1681\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n1682\t\t\t\treturn\n1683\t\t\t}\n1684\t\t}\n1685\t\t// Check if we have voted yet\n1686\t\tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n1687\t\tif err != nil && err.Error() != \"not found\" {\n1688\t\t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n1689\t\t\treturn\n1690\t\t}\n1691\t\tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n1692\t\tif err != nil && err.Error() != \"not found\" {\n1693\t\t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n1694\t\t\treturn\n1695\t\t}\n1696\t\n1697\t\t// Check if we've voted in this election before\n1698\t\tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n1699\t\t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n1700\t\t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n1701\t\t\t\tr.logger.Warn(\"duplicate requestVote from\", \"candidate\", candidate)\n1702\t\t\t\tresp.Granted = true\n1703\t\t\t}\n1704\t\t\treturn\n1705\t\t}\n1706\t\n1707\t\t// Reject if their term is older\n1708\t\tlastIdx, lastTerm := r.getLastEntry()\n1709\t\tif lastTerm > req.LastLogTerm {\n1710\t\t\tr.logger.Warn(\"rejecting vote request since our last term is greater\",\n1711\t\t\t\t\"candidate\", candidate,\n1712\t\t\t\t\"last-term\", lastTerm,\n1713\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n1714\t\t\treturn\n1715\t\t}\n1716\t\n1717\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n1718\t\t\tr.logger.Warn(\"rejecting vote request since our last index is greater\",\n1719\t\t\t\t\"candidate\", candidate,\n1720\t\t\t\t\"last-index\", lastIdx,\n1721\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n1722\t\t\treturn\n1723\t\t}\n1724\t\n1725\t\t// Persist a vote for safety\n1726\t\tif err := r.persistVote(req.Term, candidateBytes); err != nil {\n1727\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n1728\t\t\treturn\n1729\t\t}\n1730\t\n1731\t\tresp.Granted = true\n1732\t\tr.setLastContact()\n1733\t}\n1734\t\n1735\t// requestPreVote is invoked when we get a request Pre-Vote RPC call.\n1736\tfunc (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n1737\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n1738\t\tr.observe(*req)\n1739\t\n1740\t\t// Setup a response\n1741\t\tresp := &RequestPreVoteResponse{\n1742\t\t\tRPCHeader: r.getRPCHeader(),\n1743\t\t\tTerm:      r.getCurrentTerm(),\n1744\t\t\tGranted:   false,\n1745\t\t}\n1746\t\tvar rpcErr error\n1747\t\tdefer func() {\n1748\t\t\trpc.Respond(resp, rpcErr)\n1749\t\t}()\n1750\t\n1751\t\t// Check if we have an existing leader [who's not the candidate] and also\n1752\t\tcandidate := r.trans.DecodePeer(req.GetRPCHeader().Addr)\n1753\t\tcandidateID := ServerID(req.ID)\n1754\t\n1755\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n1756\t\t// Grant the vote\n1757\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n1758\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not in configuration\",\n1759\t\t\t\t\"from\", candidate)\n1760\t\t\treturn\n1761\t\t}\n1762\t\n1763\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate {\n1764\t\t\tr.logger.Warn(\"rejecting pre-vote request since we have a leader\",\n1765\t\t\t\t\"from\", candidate,\n1766\t\t\t\t\"leader\", leaderAddr,\n1767\t\t\t\t\"leader-id\", string(leaderID))\n1768\t\t\treturn\n1769\t\t}\n1770\t\n1771\t\t// Ignore an older term\n1772\t\tif req.Term < r.getCurrentTerm() {\n1773\t\t\treturn\n1774\t\t}\n1775\t\n1776\t\tif req.Term > r.getCurrentTerm() {\n1777\t\t\t// continue processing here to possibly grant the pre-vote as in a \"real\" vote this will transition us to follower\n1778\t\t\tr.logger.Debug(\"received a requestPreVote with a newer term, grant the pre-vote\")\n1779\t\t\tresp.Term = req.Term\n1780\t\t}\n1781\t\n1782\t\t// if we get a request for a pre-vote from a nonVoter  and the request term is higher, do not grant the Pre-Vote\n1783\t\t// This could happen when a node, previously voter, is converted to non-voter\n1784\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n1785\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not a voter\", \"from\", candidate)\n1786\t\t\treturn\n1787\t\t}\n1788\t\n1789\t\t// Reject if their term is older\n1790\t\tlastIdx, lastTerm := r.getLastEntry()\n1791\t\tif lastTerm > req.LastLogTerm {\n1792\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last term is greater\",\n1793\t\t\t\t\"candidate\", candidate,\n1794\t\t\t\t\"last-term\", lastTerm,\n1795\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n1796\t\t\treturn\n1797\t\t}\n1798\t\n1799\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n1800\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last index is greater\",\n1801\t\t\t\t\"candidate\", candidate,\n1802\t\t\t\t\"last-index\", lastIdx,\n1803\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n1804\t\t\treturn\n1805\t\t}\n1806\t\n1807\t\tresp.Granted = true\n1808\t}\n1809\t\n1810\t// installSnapshot is invoked when we get a InstallSnapshot RPC call.\n1811\t// We must be in the follower state for this, since it means we are\n1812\t// too far behind a leader for log replay. This must only be called\n1813\t// from the main thread.\n1814\tfunc (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n1815\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"installSnapshot\"}, time.Now())\n1816\t\t// Setup a response\n1817\t\tresp := &InstallSnapshotResponse{\n1818\t\t\tTerm:    r.getCurrentTerm(),\n1819\t\t\tSuccess: false,\n1820\t\t}\n1821\t\tvar rpcErr error\n1822\t\tdefer func() {\n1823\t\t\t_, _ = io.Copy(io.Discard, rpc.Reader) // ensure we always consume all the snapshot data from the stream [see issue #212]\n1824\t\t\trpc.Respond(resp, rpcErr)\n1825\t\t}()\n1826\t\n1827\t\t// Sanity check the version\n1828\t\tif req.SnapshotVersion < SnapshotVersionMin ||\n1829\t\t\treq.SnapshotVersion > SnapshotVersionMax {\n1830\t\t\trpcErr = fmt.Errorf(\"unsupported snapshot version %d\", req.SnapshotVersion)\n","exit_code":0,"status":"completed"}}
