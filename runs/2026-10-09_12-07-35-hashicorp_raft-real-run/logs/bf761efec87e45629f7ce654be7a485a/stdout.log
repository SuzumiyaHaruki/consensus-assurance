epair Of\"\n        },\n        \"action\": {\n          \"const\": \"explore\",\n          \"title\": \"Action\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"minLength\": 1,\n          \"title\": \"Question\",\n          \"type\": \"string\"\n        },\n        \"harness_path\": {\n          \"title\": \"Harness Path\",\n          \"type\": \"string\"\n        },\n        \"execution_package\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Optional single local Go package or Rust crate directory, with the same meaning as Harness.execution_package\",\n          \"title\": \"Execution Package\"\n        },\n        \"files\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"default\": {},\n          \"title\": \"Files\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"question\",\n        \"harness_path\"\n      ],\n      \"title\": \"ExploreSubmission\",\n      \"type\": \"object\"\n    },\n    \"Grounding\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"source_ids\": {\n          \"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"expectation_ids\": {\n          \"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Expectation Ids\",\n          \"type\": \"array\"\n        },\n        \"binding_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Binding Ids\",\n          \"type\": \"array\"\n        },\n        \"derivation\": {\n          \"default\": \"\",\n          \"description\": \"This component’s sourced reasoning; cite accepted IDs instead of repeating their full argument\",\n          \"title\": \"Derivation\",\n          \"type\": \"string\"\n        },\n        \"applicability\": {\n          \"default\": \"\",\n          \"description\": \"Conditions for this component, including any added assumptions or omitted protections\",\n          \"title\": \"Applicability\",\n          \"type\": \"string\"\n        },\n        \"unresolved\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unresolved\",\n          \"type\": \"array\"\n        },\n        \"conflicts\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Conflicts\",\n          \"type\": \"array\"\n        },\n        \"alternatives\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Alternatives\",\n          \"type\": \"array\"\n        }\n      },\n      \"title\": \"Grounding\",\n      \"type\": \"object\"\n    },\n    \"IssueResolution\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"condition_dispositions\": {\n          \"default\": [],\n          \"items\": {\n            \"$ref\": \"#/$defs/ConditionDisposition\"\n          },\n          \"title\": \"Condition Dispositions\",\n          \"type\": \"array\"\n        },\n        \"issue_id\": {\n          \"title\": \"Issue Id\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n       