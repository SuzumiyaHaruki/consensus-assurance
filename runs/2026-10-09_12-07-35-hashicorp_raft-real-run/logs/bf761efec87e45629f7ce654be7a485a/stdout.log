    \"title\": \"CheckSubmission\",\n      \"type\": \"object\"\n    },\n    \"ClaimDraft\": {\n      \"additionalProperties\": false,\n      \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n      \"properties\": {\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"obligation\",\n            \"assumption\"\n          ],\n          \"title\": \"Kind\",\n          \"type\": \"string\"\n        },\n        \"concern\": {\n          \"default\": \"implementation_semantics\",\n          \"enum\": [\n            \"consensus_safety\",\n            \"bounded_liveness\",\n            \"implementation_semantics\"\n          ],\n          \"title\": \"Concern\",\n          \"type\": \"string\"\n        },\n        \"description\": {\n          \"description\": \"Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability\",\n          \"title\": \"Description\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"description\": \"Located materials; file kinds do not establish normative authority\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"scope\": {\n          \"$ref\": \"#/$defs/Scope\"\n        },\n        \"pending\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Pending\",\n          \"type\": \"array\"\n        },\n        \"grounding\": {\n          \"$ref\": \"#/$defs/Grounding\",\n          \"default\": {\n            \"source_ids\": [],\n            \"expectation_ids\": [],\n            \"binding_ids\": [],\n            \"derivation\": \"\",\n            \"applicability\": \"\",\n            \"unresol