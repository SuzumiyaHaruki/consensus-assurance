{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=2217 && NR<=2241 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go; echo \\\"=== api 280-330 ===\\\"; awk 'NR>=285 && NR<=330 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' api.go; echo \\\"=== api 819-905 ===\\\"; awk 'NR>=819 && NR<=905 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' api.go\"","aggregated_output":"2217\tfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n2218\t\tr.configurations.latest = c\n2219\t\tr.configurations.latestIndex = i\n2220\t\tr.latestConfiguration.Store(c.Clone())\n2221\t}\n2222\t\n2223\t// setCommittedConfiguration stores the committed configuration.\n2224\tfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n2225\t\tr.configurations.committed = c\n2226\t\tr.configurations.committedIndex = i\n2227\t}\n2228\t\n2229\t// getLatestConfiguration reads the configuration from a copy of the main\n2230\t// configuration, which means it can be accessed independently from the main\n2231\t// loop.\n2232\tfunc (r *Raft) getLatestConfiguration() Configuration {\n2233\t\t// this switch catches the case where this is called without having set\n2234\t\t// a configuration previously.\n2235\t\tswitch c := r.latestConfiguration.Load().(type) {\n2236\t\tcase Configuration:\n2237\t\t\treturn c\n2238\t\tdefault:\n2239\t\t\treturn Configuration{}\n2240\t\t}\n2241\t}\n=== api 280-330 ===\n285\t// RecoverCluster is used to manually force a new configuration in order to\n286\t// recover from a loss of quorum where the current configuration cannot be\n287\t// restored, such as when several servers die at the same time. This works by\n288\t// reading all the current state for this server, creating a snapshot with the\n289\t// supplied configuration, and then truncating the Raft log. This is the only\n290\t// safe way to force a given configuration without actually altering the log to\n291\t// insert any new entries, which could cause conflicts with other servers with\n292\t// different state.\n293\t//\n294\t// WARNING! This operation implicitly commits all entries in the Raft log, so\n295\t// in general this is an extremely unsafe operation. If you've lost your other\n296\t// servers and are performing a manual recovery, then you've also lost the\n297\t// commit information, so this is likely the best you can do, but you should be\n298\t// aware that calling this can cause Raft log entries that were in the process\n299\t// of being replicated but not yet be committed to be committed.\n300\t//\n301\t// Note the FSM passed here is used for the snapshot operations and will be\n302\t// left in a state that should not be used by the application. Be sure to\n303\t// discard this FSM and any associated state and provide a fresh one when\n304\t// calling NewRaft later.\n305\t//\n306\t// A typical way to recover the cluster is to shut down all servers and then\n307\t// run RecoverCluster on every server using an identical configuration. When\n308\t// the cluster is then restarted, and election should occur and then Raft will\n309\t// resume normal operation. If it's desired to make a particular server the\n310\t// leader, this can be used to inject a new configuration with that server as\n311\t// the sole voter, and then join up other new clean-state peer servers using\n312\t// the usual APIs in order to bring the cluster back into a known state.\n313\tfunc RecoverCluster(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n314\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n315\t) error {\n316\t\t// Validate the Raft server config.\n317\t\tif err := ValidateConfig(conf); err != nil {\n318\t\t\treturn err\n319\t\t}\n320\t\n321\t\t// Sanity check the Raft peer configuration.\n322\t\tif err := checkConfiguration(configuration); err != nil {\n323\t\t\treturn err\n324\t\t}\n325\t\n326\t\t// Refuse to recover if there's no existing state. This would be safe to\n327\t\t// do, but it is likely an indication of an operator error where they\n328\t\t// expect data to be there and it's not. By refusing, we force them\n329\t\t// to show intent to start a cluster fresh by explicitly doing a\n330\t\t// bootstrap, rather than quietly fire up a fresh cluster here.\n=== api 819-905 ===\n819\tfunc (r *Raft) Apply(cmd []byte, timeout time.Duration) ApplyFuture {\n820\t\treturn r.ApplyLog(Log{Data: cmd}, timeout)\n821\t}\n822\t\n823\t// ApplyLog performs Apply but takes in a Log directly. The only values\n824\t// currently taken from the submitted Log are Data and Extensions. See\n825\t// Apply for details on error cases.\n826\tfunc (r *Raft) ApplyLog(log Log, timeout time.Duration) ApplyFuture {\n827\t\tmetrics.IncrCounter([]string{\"raft\", \"apply\"}, 1)\n828\t\n829\t\tvar timer <-chan time.Time\n830\t\tif timeout > 0 {\n831\t\t\ttimer = time.After(timeout)\n832\t\t}\n833\t\n834\t\t// Create a log future, no index or term yet\n835\t\tlogFuture := &logFuture{\n836\t\t\tlog: Log{\n837\t\t\t\tType:       LogCommand,\n838\t\t\t\tData:       log.Data,\n839\t\t\t\tExtensions: log.Extensions,\n840\t\t\t},\n841\t\t}\n842\t\tlogFuture.init()\n843\t\n844\t\tselect {\n845\t\tcase <-timer:\n846\t\t\treturn errorFuture{ErrEnqueueTimeout}\n847\t\tcase <-r.shutdownCh:\n848\t\t\treturn errorFuture{ErrRaftShutdown}\n849\t\tcase r.applyCh <- logFuture:\n850\t\t\treturn logFuture\n851\t\t}\n852\t}\n853\t\n854\t// Barrier is used to issue a command that blocks until all preceding\n855\t// operations have been applied to the FSM. It can be used to ensure the\n856\t// FSM reflects all queued writes. An optional timeout can be provided to\n857\t// limit the amount of time we wait for the command to be started. This\n858\t// must be run on the leader, or it will fail.\n859\tfunc (r *Raft) Barrier(timeout time.Duration) Future {\n860\t\tmetrics.IncrCounter([]string{\"raft\", \"barrier\"}, 1)\n861\t\tvar timer <-chan time.Time\n862\t\tif timeout > 0 {\n863\t\t\ttimer = time.After(timeout)\n864\t\t}\n865\t\n866\t\t// Create a log future, no index or term yet\n867\t\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\n868\t\tlogFuture.init()\n869\t\n870\t\tselect {\n871\t\tcase <-timer:\n872\t\t\treturn errorFuture{ErrEnqueueTimeout}\n873\t\tcase <-r.shutdownCh:\n874\t\t\treturn errorFuture{ErrRaftShutdown}\n875\t\tcase r.applyCh <- logFuture:\n876\t\t\treturn logFuture\n877\t\t}\n878\t}\n879\t\n880\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n881\t// to prevent returning stale data from the FSM after the peer has lost\n882\t// leadership.\n883\tfunc (r *Raft) VerifyLeader() Future {\n884\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n885\t\tverifyFuture := &verifyFuture{}\n886\t\tverifyFuture.init()\n887\t\tselect {\n888\t\tcase <-r.shutdownCh:\n889\t\t\treturn errorFuture{ErrRaftShutdown}\n890\t\tcase r.verifyCh <- verifyFuture:\n891\t\t\treturn verifyFuture\n892\t\t}\n893\t}\n894\t\n895\t// GetConfiguration returns the latest configuration. This may not yet be\n896\t// committed. The main loop can access this directly.\n897\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n898\t\tconfigReq := &configurationsFuture{}\n899\t\tconfigReq.init()\n900\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n901\t\tconfigReq.respond(nil)\n902\t\treturn configReq\n903\t}\n904\t\n905\t// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n","exit_code":0,"status":"completed"}}
