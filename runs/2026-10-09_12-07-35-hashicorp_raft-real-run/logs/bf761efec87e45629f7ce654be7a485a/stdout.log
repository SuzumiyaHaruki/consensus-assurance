{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cd agent-source; awk 'NR>=468 && NR<=680 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"468\tfunc (r *Raft) runLeader() {\n469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n471\t\n472\t\t// Notify that we are the leader\n473\t\toverrideNotifyBool(r.leaderCh, true)\n474\t\n475\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n476\t\t// defer below runs, but this makes sure we always notify the same chan if\n477\t\t// ever for both gaining and losing leadership.\n478\t\tnotify := r.config().NotifyCh\n479\t\n480\t\t// Push to the notify channel if given\n481\t\tif notify != nil {\n482\t\t\tselect {\n483\t\t\tcase notify <- true:\n484\t\t\tcase <-r.shutdownCh:\n485\t\t\t\t// make sure push to the notify channel ( if given )\n486\t\t\t\tselect {\n487\t\t\t\tcase notify <- true:\n488\t\t\t\tdefault:\n489\t\t\t\t}\n490\t\t\t}\n491\t\t}\n492\t\n493\t\t// setup leader state. This is only supposed to be accessed within the\n494\t\t// leaderloop.\n495\t\tr.setupLeaderState()\n496\t\n497\t\t// Run a background go-routine to emit metrics on log age\n498\t\tstopCh := make(chan struct{})\n499\t\tgo emitLogStoreMetrics(r.logs, []string{\"raft\", \"leader\"}, oldestLogGaugeInterval, stopCh)\n500\t\n501\t\t// Cleanup state on step down\n502\t\tdefer func() {\n503\t\t\tclose(stopCh)\n504\t\n505\t\t\t// Since we were the leader previously, we update our\n506\t\t\t// last contact time when we step down, so that we are not\n507\t\t\t// reporting a last contact time from before we were the\n508\t\t\t// leader. Otherwise, to a client it would seem our data\n509\t\t\t// is extremely stale.\n510\t\t\tr.setLastContact()\n511\t\n512\t\t\t// Stop replication\n513\t\t\tfor _, p := range r.leaderState.replState {\n514\t\t\t\tclose(p.stopCh)\n515\t\t\t}\n516\t\n517\t\t\t// Respond to all inflight operations\n518\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n519\t\t\t\te.Value.(*logFuture).respond(ErrLeadershipLost)\n520\t\t\t}\n521\t\n522\t\t\t// Respond to any pending verify requests\n523\t\t\tfor future := range r.leaderState.notify {\n524\t\t\t\tfuture.respond(ErrLeadershipLost)\n525\t\t\t}\n526\t\n527\t\t\t// Clear all the state\n528\t\t\tr.leaderState.commitCh = nil\n529\t\t\tr.leaderState.commitment = nil\n530\t\t\tr.leaderState.inflight = nil\n531\t\t\tr.leaderState.replState = nil\n532\t\t\tr.leaderState.notify = nil\n533\t\t\tr.leaderState.stepDown = nil\n534\t\n535\t\t\t// If we are stepping down for some reason, no known leader.\n536\t\t\t// We may have stepped down due to an RPC call, which would\n537\t\t\t// provide the leader, so we cannot always blank this out.\n538\t\t\tr.leaderLock.Lock()\n539\t\t\tif r.leaderAddr == r.localAddr && r.leaderID == r.localID {\n540\t\t\t\tr.leaderAddr = \"\"\n541\t\t\t\tr.leaderID = \"\"\n542\t\t\t}\n543\t\t\tr.leaderLock.Unlock()\n544\t\n545\t\t\t// Notify that we are not the leader\n546\t\t\toverrideNotifyBool(r.leaderCh, false)\n547\t\n548\t\t\t// Push to the notify channel if given\n549\t\t\tif notify != nil {\n550\t\t\t\tselect {\n551\t\t\t\tcase notify <- false:\n552\t\t\t\tcase <-r.shutdownCh:\n553\t\t\t\t\t// On shutdown, make a best effort but do not block\n554\t\t\t\t\tselect {\n555\t\t\t\t\tcase notify <- false:\n556\t\t\t\t\tdefault:\n557\t\t\t\t\t}\n558\t\t\t\t}\n559\t\t\t}\n560\t\t}()\n561\t\n562\t\t// Start a replication routine for each peer\n563\t\tr.startStopReplication()\n564\t\n565\t\t// Dispatch a no-op log entry first. This gets this leader up to the latest\n566\t\t// possible commit index, even in the absence of client commands. This used\n567\t\t// to append a configuration entry instead of a noop. However, that permits\n568\t\t// an unbounded number of uncommitted configurations in the log. We now\n569\t\t// maintain that there exists at most one uncommitted configuration entry in\n570\t\t// any log, so we have to do proper no-ops here.\n571\t\tnoop := &logFuture{log: Log{Type: LogNoop}}\n572\t\tr.dispatchLogs([]*logFuture{noop})\n573\t\n574\t\t// Sit in the leader loop until we step down\n575\t\tr.leaderLoop()\n576\t}\n577\t\n578\t// startStopReplication will set up state and start asynchronous replication to\n579\t// new peers, and stop replication to removed peers. Before removing a peer,\n580\t// it'll instruct the replication routines to try to replicate to the current\n581\t// index. This must only be called from the main thread.\n582\tfunc (r *Raft) startStopReplication() {\n583\t\tinConfig := make(map[ServerID]bool, len(r.configurations.latest.Servers))\n584\t\tlastIdx := r.getLastIndex()\n585\t\n586\t\t// Start replication goroutines that need starting\n587\t\tfor _, server := range r.configurations.latest.Servers {\n588\t\t\tif server.ID == r.localID {\n589\t\t\t\tcontinue\n590\t\t\t}\n591\t\n592\t\t\tinConfig[server.ID] = true\n593\t\n594\t\t\ts, ok := r.leaderState.replState[server.ID]\n595\t\t\tif !ok {\n596\t\t\t\tr.logger.Info(\"added peer, starting replication\", \"peer\", server.ID)\n597\t\t\t\ts = &followerReplication{\n598\t\t\t\t\tpeer:                server,\n599\t\t\t\t\tcommitment:          r.leaderState.commitment,\n600\t\t\t\t\tstopCh:              make(chan uint64, 1),\n601\t\t\t\t\ttriggerCh:           make(chan struct{}, 1),\n602\t\t\t\t\ttriggerDeferErrorCh: make(chan *deferError, 1),\n603\t\t\t\t\tcurrentTerm:         r.getCurrentTerm(),\n604\t\t\t\t\tnextIndex:           lastIdx + 1,\n605\t\t\t\t\tlastContact:         time.Now(),\n606\t\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n607\t\t\t\t\tnotifyCh:            make(chan struct{}, 1),\n608\t\t\t\t\tstepDown:            r.leaderState.stepDown,\n609\t\t\t\t}\n610\t\n611\t\t\t\tr.leaderState.replState[server.ID] = s\n612\t\t\t\tr.goFunc(func() { r.replicate(s) })\n613\t\t\t\tasyncNotifyCh(s.triggerCh)\n614\t\t\t\tr.observe(PeerObservation{Peer: server, Removed: false})\n615\t\t\t} else if ok {\n616\t\n617\t\t\t\ts.peerLock.RLock()\n618\t\t\t\tpeer := s.peer\n619\t\t\t\ts.peerLock.RUnlock()\n620\t\n621\t\t\t\tif peer.Address != server.Address {\n622\t\t\t\t\tr.logger.Info(\"updating peer\", \"peer\", server.ID)\n623\t\t\t\t\ts.peerLock.Lock()\n624\t\t\t\t\ts.peer = server\n625\t\t\t\t\ts.peerLock.Unlock()\n626\t\t\t\t}\n627\t\t\t}\n628\t\t}\n629\t\n630\t\t// Stop replication goroutines that need stopping\n631\t\tfor serverID, repl := range r.leaderState.replState {\n632\t\t\tif inConfig[serverID] {\n633\t\t\t\tcontinue\n634\t\t\t}\n635\t\t\t// Replicate up to lastIdx and stop\n636\t\t\tr.logger.Info(\"removed peer, stopping replication\", \"peer\", serverID, \"last-index\", lastIdx)\n637\t\t\trepl.stopCh <- lastIdx\n638\t\t\tclose(repl.stopCh)\n639\t\t\tdelete(r.leaderState.replState, serverID)\n640\t\t\tr.observe(PeerObservation{Peer: repl.peer, Removed: true})\n641\t\t}\n642\t\n643\t\t// Update peers metric\n644\t\tmetrics.SetGauge([]string{\"raft\", \"peers\"}, float32(len(r.configurations.latest.Servers)))\n645\t}\n646\t\n647\t// configurationChangeChIfStable returns r.configurationChangeCh if it's safe\n648\t// to process requests from it, or nil otherwise. This must only be called\n649\t// from the main thread.\n650\t//\n651\t// Note that if the conditions here were to change outside of leaderLoop to take\n652\t// this from nil to non-nil, we would need leaderLoop to be kicked.\n653\tfunc (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n654\t\t// Have to wait until:\n655\t\t// 1. The latest configuration is committed, and\n656\t\t// 2. This leader has committed some entry (the noop) in this term\n657\t\t//    https://groups.google.com/forum/#!msg/raft-dev/t4xj6dJTP6E/d2D9LrWRza8J\n658\t\tif r.configurations.latestIndex == r.configurations.committedIndex &&\n659\t\t\tr.getCommitIndex() >= r.leaderState.commitment.startIndex {\n660\t\t\treturn r.configurationChangeCh\n661\t\t}\n662\t\treturn nil\n663\t}\n664\t\n665\t// leaderLoop is the hot loop for a leader. It is invoked\n666\t// after all the various leader setup is done.\n667\tfunc (r *Raft) leaderLoop() {\n668\t\t// stepDown is used to track if there is an inflight log that\n669\t\t// would cause us to lose leadership (specifically a RemovePeer of\n670\t\t// ourselves). If this is the case, we must not allow any logs to\n671\t\t// be processed in parallel, otherwise we are basing commit on\n672\t\t// only a single peer (ourself) and replicating to an undefined set\n673\t\t// of peers.\n674\t\tstepDown := false\n675\t\t// This is only used for the first lease check, we reload lease below\n676\t\t// based on the current config value.\n677\t\tlease := time.After(r.config().LeaderLeaseTimeout)\n678\t\n679\t\tfor r.getState() == Leader {\n680\t\t\tr.mainThreadSaturation.sleeping()\n","exit_code":0,"status":"completed"}}
