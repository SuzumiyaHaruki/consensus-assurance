55.0-alpha.16\",\n    \"implementation\": \"go version go1.23.5 linux/amd64\"\n  },\n  \"build_inputs\": [],\n  \"implementation\": {\n    \"name\": \"go_module\",\n    \"harness_kind\": \"go_test\",\n    \"harness_filename\": \"assurance_generated_test.go\",\n    \"default_execution_package\": \".\",\n    \"instructions\": \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\",\n    \"network\": \"Agent shell networking is disabled. Isolated target execution may communicate only inside its private network namespace.\",\n    \"support_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-11_12-59-37-dragonboat_raft-real-run/target-support\"\n  },\n  \"example\": {\n    \"rationale\": \"Investigate a sourced local uncertainty\",\n    \"sources\": [\n      {\n        \"id\": \"source\",\n        \"file\": \"REPLACE_WITH_CAPTURED_FILE\",\n        \"start_line\": 1,\n        \"end_line\": 1,\n        \"kind\": \"code_observation\"\n      }\n    ],\n    \"investigations\": [\n      {\n        \"ref\": \"@question\",\n        \"question\": \"Which applicable caller condition establishes this result?\",\n        \"source_ids\": [\n          \"source\"\n        ],\n        \"discriminator\": \"Trace the actual producer and the enclosing protection\"\n      }\n    ]\n  },\n  \"costs\": {\n    \"agent_calls\": 1,\n    \"target_executions\": 0,\n    \"process_seconds\": 0,\n    \"action_seconds\": 0,\n    \"unrecorded_action_ids\": [],\n    \"elapsed_seconds\": 2.4575555939995866\n  }\n}","exit_code":0,"status":"completed"}}
