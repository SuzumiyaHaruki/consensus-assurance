t\tdata, err := cc.Marshal()\n\t\tif err != nil {\n\t\t\tpanic(\"unexpected marshal error\")\n\t\t}\n\t\tents[i] = pb.Entry{\n\t\t\tType:  pb.ConfigChangeEntry,\n\t\t\tTerm:  1,\n\t\t\tIndex: uint64(i + 1),\n\t\t\tCmd:   data,\n\t\t}\n\t}\n\tr.log.append(ents)\n\tr.log.committed = uint64(len(ents))\n\tfor _, peer := range addresses {\n\t\tr.addNode(peer.NodeID)\n\t}\n}\n\nfunc getUpdateCommit(ud pb.Update) pb.UpdateCommit {\n\tuc := pb.UpdateCommit{\n\t\tReadyToRead: uint64(len(ud.ReadyToReads)),\n\t\tLastApplied: ud.LastApplied,\n\t}\n\tif len(ud.CommittedEntries) > 0 {\n\t\tuc.Processed = ud.CommittedEntries[len(ud.CommittedEntries)-1].Index\n\t}\n\tif len(ud.EntriesToSave) > 0 {\n\t\tlastEntry := ud.EntriesToSave[len(ud.EntriesToSave)-1]\n\t\tuc.StableLogTo, uc.StableLogTerm = lastEntry.Index, lastEntry.Term\n\t}\n\tif !pb.IsEmptySnapshot(ud.Snapshot) {\n\t\tuc.StableSnapshotTo = ud.Snapshot.Index\n\t\tuc.Processed = max(uc.Processed, uc.StableSnapshotTo)\n\t}\n\treturn uc\n}\n323:func (p *Peer) getUpdate(moreToApply bool, lastApplied uint64) pb.Update {\n409:func getUpdateCommit(ud pb.Update) pb.UpdateCommit {\n\t}\n\treturn l.logdb.Snapshot()\n}\n\nfunc (l *entryLog) firstNotAppliedIndex() uint64 {\n\treturn max(l.processed+1, l.firstIndex())\n}\n\nfunc (l *entryLog) toApplyIndexLimit() uint64 {\n\treturn l.committed + 1\n}\n\nfunc (l *entryLog) hasEntriesToApply() bool {\n\treturn l.toApplyIndexLimit() > l.firstNotAppliedIndex()\n}\n\nfunc (l *entryLog) hasMoreEntriesToApply(appliedTo uint64) bool {\n\treturn l.committed > appliedTo\n}\n\nfunc (l *entryLog) entriesToApply() []pb.Entry {\n\treturn l.getEntriesToApply(maxEntriesToApplySize)\n}\n\nfunc (l *entryLog) getEntriesToApply(limit uint64) []pb.Entry {\n\tif l.hasEntriesToApply() {\n\t\tif ents, err := l.getEntries(l.firstNotAppliedIndex(),\n\t\t\tl.toApplyIndexLimit(), limit); err != nil {\n\t\t\tpanic(err)\n\t\t} else {\n\t\t\treturn ents\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc (l *entryLog) entriesToSave() []pb.Entry {\n\treturn l.inmem.entriesToSave()\n}\n\nfunc (l *entryLog) tryAppend(index uint64, ents []pb.Entry) bool {\n\tconflictIndex := l.getConflictIndex(ents)\n\tif conflictIndex != 0 {\n\t\tif conflictIndex <= l.committed {\n\t\t\tplog.Panicf(\"entry %d conflicts with committed entry, committed %d\",\n\t\t\t\tconflictIndex, l.committed)\n\t\t}\n\t\tl.append(ents[conflictIndex-index-1:])\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc (l *entryLog) append(entries []pb.Entry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tif entries[0].Index <= l.committed {\n\t\tplog.Panicf(\"committed entries being changed, committed %d, first idx %d\",\n\t\t\tl.committed, entries[0].Index)\n\t}\n../agent-source/internal/raft/logentry.go:334:func (l *entryLog) commitUpdate(cu pb.UpdateCommit) {\n../agent-source/internal/raft/raft.go:302:func (r *raft) setApplied(applied uint64) {\nSourceAnchor {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\"\n  ],\n  \"title\": \"SourceAnchor\",\n  \"type\": \"object\"\n}\nCodeAnchor {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"boundary_complete\": {\n      \"anyOf\": [\n        {\n          \"type\": \"boolean\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Boundary Complete\"\n    },\n    \"kind\": {\n      \"default\": \"declaration\",\n      \"enum\": [\n        \"declaration\",\n        \"interface_member\",\n        \"callsite\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"symbol\": {\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"material_id\",\n    \"start_line\",\n    \"end_line\",\n    \"symbol\"\n  ],\n  \"title\": \"CodeAnchor\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The follower’s consumer matches replies by context, so a changed context could leave the original read pending. There are also two relevant protections: confirmation contexts go only to voters, and multi-node reads wait for an entry committed in the leader’s current term.\n\nI’ll probe the mismatch with three normally bootstrapped peers: elect a leader, submit one read from each follower, lose the first confirmation round, then deliver all later messages. A control will deliver both rounds normally. The measurement will identify each read by its origin node, independently of the returned context.\n"}}
