us of the snapshot to the local raft\n// node.\nfunc (p *Peer) ReportSnapshotStatus(nodeID uint64, reject bool) {\n\tp.raft.Handle(pb.Message{\n\t\tType:   pb.SnapshotStatus,\n\t\tFrom:   nodeID,\n\t\tReject: reject,\n\t})\n}\n\n// Handle processes the given message.\nfunc (p *Peer) Handle(m pb.Message) {\n\tif IsLocalMessageType(m.Type) {\n\t\tpanic(\"local message sent to Step\")\n\t}\n\n\t_, rok := p.raft.remotes[m.From]\n\t_, ook := p.raft.observers[m.From]\n\t_, wok := p.raft.witnesses[m.From]\n\n\tif rok || ook || wok || !isResponseMessageType(m.Type) {\n\t\tp.raft.Handle(m)\n\t}\n}\n\n// GetUpdate returns the current state of the Peer.\nfunc (p *Peer) GetUpdate(moreToApply bool, lastApplied uint64) pb.Update {\n\tud := p.getUpdate(moreToApply, lastApplied)\n\tvalidateUpdate(ud)\n\tud = setFastApply(ud)\n\tud.UpdateCommit = getUpdateCommit(ud)\n\treturn ud\n}\n\nfunc setFastApply(ud pb.Update) pb.Update {\n\tud.FastApply = true\n\tif !pb.IsEmptySnapshot(ud.Snapshot) {\n../agent-source/internal/raft/raft_etcd_test.go:1885:\t\tnt.send(pb.Message{From: tt.sm.nodeID, To: tt.sm.nodeID, Type: pb.ReadIndex, Hint: tt.wctx.Low, HintHigh: tt.wctx.High})\n../agent-source/internal/raft/raft_test.go:487:func TestObserverCanReadIndexQuorum1(t *testing.T) {\n../agent-source/internal/raft/raft_test.go:520:\tnt.send(pb.Message{From: 2, To: 2, Type: pb.ReadIndex, Hint: 12345})\n../agent-source/internal/raft/raft_test.go:529:func TestObserverCanReadIndexQuorum2(t *testing.T) {\n../agent-source/internal/raft/raft_test.go:557:\tnt.send(pb.Message{From: 3, To: 3, Type: pb.ReadIndex, Hint: 12345})\n../agent-source/internal/raft/raft_test.go:983:func TestWitnessCannotReadIndex(t *testing.T) {\n../agent-source/internal/raft/raft_test.go:986:\tnt.send(pb.Message{From: 1, To: 1, Type: pb.ReadIndex, Hint: 12345})\n../agent-source/internal/raft/raft_test.go:1279:\t\t{pb.BatchedReadIndex, false},\n../agent-source/internal/raft/raft_test.go:1288:\t\t{pb.ReadIndex, false},\n../agent-source/i