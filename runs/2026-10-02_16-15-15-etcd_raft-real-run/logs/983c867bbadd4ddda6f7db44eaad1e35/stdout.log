{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '25,58p' ../agent-source/raft_test.go; sed -n '455,475p' ../agent-source/log.go; python3 - <<'PY'\nimport json\nm=json.load(open('../audit-spec/v5.json'));print(json.dumps(next(b for b in m['behaviors'] if b['id']=='B_ELECT'),indent=2))\nPY\"","aggregated_output":"{\n  \"id\": \"B_ELECT\",\n  \"primary_activity\": \"A2\",\n  \"execution_owner\": \"raft.hup / campaign / stepCandidate / ProgressTracker\",\n  \"protocol_context\": \"Candidate or pre-candidate role, local term and active voter sets\",\n  \"trigger\": \"Election tick, Campaign, vote response or follower TimeoutNow\",\n  \"legal_preconditions\": [],\n  \"implementation_guards\": [\n    \"hup requires promotable node and no unapplied committed config changes.\",\n    \"Vote grants require canVote and log up-to-date; actual log comparison orders term before index.\",\n    \"Candidate accepts only corresponding response type; first vote per ID recorded and active voter majorities decide.\",\n    \"hasUnappliedConfChanges scans only the committed log after max(applied+1, firstIndex); an acknowledged applied frontier controls the scan independently of external application completion.\"\n  ],\n  \"reads\": [],\n  \"writes\": [\n    \"Pre-candidate preserves term and Vote; candidate increments term and sets self Vote.\",\n    \"Winning real election installs leader handlers, resets progress, appends current-term empty entry and broadcasts.\"\n  ],\n  \"durable_effects\": [],\n  \"external_effects\": [],\n  \"important_branches\": [],\n  \"async_boundaries\": [\n    \"Self vote response is delayed through msgsAfterAppend.\"\n  ],\n  \"produces_fact_ids\": [\n    \"F_LEADER_ROLE\"\n  ],\n  \"consumes_fact_ids\": [\n    \"F_APPLIED_ACK\"\n  ],\n  \"cross_activity_effects\": {},\n  \"existing_protections\": [],\n  \"source_ids\": [\n    \"src_election\",\n    \"src_transfer_roles\",\n    \"src_step\",\n    \"s