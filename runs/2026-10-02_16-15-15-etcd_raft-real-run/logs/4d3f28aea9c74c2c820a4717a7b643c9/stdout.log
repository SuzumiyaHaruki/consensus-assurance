operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"history_field\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"History Field\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}, \"required\": [\"checker_id\", \"trigger\", \"assertion\", \"description\"], \"title\": \"ObservableProperty\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
