{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '380,440p' ../agent-source/log.go; sed -n '493,558p' ../agent-source/log.go; sed -n '53,100p' ../agent-source/log_unstable.go; nl -ba ../agent-source/log_unstable.go | sed -n '16,36p'; nl -ba ../agent-source/rawnode.go | sed -n '264,324p'; nl -ba ../agent-source/raft.go | sed -n '1144,1200p'\"","aggregated_output":"\t\tl.logger.Panicf(\"unexpected error when getting the last term at %d: %v\", index, err)\n\t}\n\treturn entryID{term: t, index: index}\n}\n\nfunc (l *raftLog) term(i uint64) (uint64, error) {\n\t// Check the unstable log first, even before computing the valid term range,\n\t// which may need to access stable Storage. If we find the entry's term in\n\t// the unstable log, we know it was in the valid range.\n\tif t, ok := l.unstable.maybeTerm(i); ok {\n\t\treturn t, nil\n\t}\n\n\t// The valid term range is [firstIndex-1, lastIndex]. Even though the entry at\n\t// firstIndex-1 is compacted away, its term is available for matching purposes\n\t// when doing log appends.\n\tif i+1 < l.firstIndex() {\n\t\treturn 0, ErrCompacted\n\t}\n\tif i > l.lastIndex() {\n\t\treturn 0, ErrUnavailable\n\t}\n\n\tt, err := l.storage.Term(i)\n\tif err == nil {\n\t\treturn t, nil\n\t}\n\tif err == ErrCompacted || err == ErrUnavailable {\n\t\treturn 0, err\n\t}\n\tpanic(err) // TODO(bdarnell)\n}\n\nfunc (l *raftLog) entries(i uint64, maxSize entryEncodingSize) ([]pb.Entry, error) {\n\tif i > l.lastIndex() {\n\t\treturn nil, nil\n\t}\n\treturn l.slice(i, l.lastIndex()+1, maxSize)\n}\n\n// allEntries returns all entries in the log.\nfunc (l *raftLog) allEntries() []pb.Entry {\n\tents, err := l.entries(l.firstIndex(), noLimit)\n\tif err == nil {\n\t\treturn ents\n\t}\n\tif err == ErrCompacted { // try again if there was a racing compaction\n\t\treturn l.allEntries()\n\t}\n\t// TODO (xiangli): handle error?\n\tpanic(err)\n}\n\n// isUpToDate determines if a log with the given last entry is more up-to-date\n// by comparing the index and term of the last entries in the existing logs.\n//\n// If the logs have last entries with different terms, then the log with the\n// later term is more up-to-date. If the logs end with the same term, then\n// whichever log has the larger lastIndex is more up-to-date. If the logs are\n// the same, the given log is up-to-date.\nfunc (l *raftLog) isUpToDate(their entryID) bool {\n\treturn nil\n}\n\n// slice returns a slice of log entries from lo through hi-1, inclusive.\nfunc (l *raftLog) slice(lo, hi uint64, maxSize entryEncodingSize) ([]pb.Entry, error) {\n\tif err := l.mustCheckOutOfBounds(lo, hi); err != nil {\n\t\treturn nil, err\n\t}\n\tif lo == hi {\n\t\treturn nil, nil\n\t}\n\tif lo >= l.unstable.offset {\n\t\tents := limitSize(l.unstable.slice(lo, hi), maxSize)\n\t\t// NB: use the full slice expression to protect the unstable slice from\n\t\t// appends to the returned ents slice.\n\t\treturn ents[:len(ents):len(ents)], nil\n\t}\n\n\tcut := min(hi, l.unstable.offset)\n\tents, err := l.storage.Entries(lo, cut, uint64(maxSize))\n\tif err == ErrCompacted {\n\t\treturn nil, err\n\t} else if err == ErrUnavailable {\n\t\tl.logger.Panicf(\"entries[%d:%d) is unavailable from storage\", lo, cut)\n\t} else if err != nil {\n\t\tpanic(err) // TODO(pavelkalinnikov): handle errors uniformly\n\t}\n\tif hi <= l.unstable.offset {\n\t\treturn ents, nil\n\t}\n\n\t// Fast path to check if ents has reached the size limitation. Either the\n\t// returned slice is shorter than requested (which means the next entry would\n\t// bring it over the limit), or a single entry reaches the limit.\n\tif uint64(len(ents)) < cut-lo {\n\t\treturn ents, nil\n\t}\n\t// Slow path computes the actual total size, so that unstable entries are cut\n\t// optimally before being copied to ents slice.\n\tsize := entsSize(ents)\n\tif size >= maxSize {\n\t\treturn ents, nil\n\t}\n\n\tunstable := limitSize(l.unstable.slice(l.unstable.offset, hi), maxSize-size)\n\t// Total size of unstable may exceed maxSize-size only if len(unstable) == 1.\n\t// If this happens, ignore this extra entry.\n\tif len(unstable) == 1 && size+entsSize(unstable) > maxSize {\n\t\treturn ents, nil\n\t}\n\t// Otherwise, total size of unstable does not exceed maxSize-size, so total\n\t// size of ents+unstable does not exceed maxSize. Simply concatenate them.\n\treturn extend(ents, unstable), nil\n}\n\n// l.firstIndex <= lo <= hi <= l.firstIndex + len(l.entries)\nfunc (l *raftLog) mustCheckOutOfBounds(lo, hi uint64) error {\n\tif lo > hi {\n\t\tl.logger.Panicf(\"invalid slice %d > %d\", lo, hi)\n\t}\n\tfi := l.firstIndex()\n\tif lo < fi {\n\t\treturn ErrCompacted\n\t}\n\n\tlength := l.lastIndex() + 1 - fi\n// if it has a snapshot.\nfunc (u *unstable) maybeFirstIndex() (uint64, bool) {\n\tif u.snapshot != nil {\n\t\treturn u.snapshot.Metadata.Index + 1, true\n\t}\n\treturn 0, false\n}\n\n// maybeLastIndex returns the last index if it has at least one\n// unstable entry or snapshot.\nfunc (u *unstable) maybeLastIndex() (uint64, bool) {\n\tif l := len(u.entries); l != 0 {\n\t\treturn u.offset + uint64(l) - 1, true\n\t}\n\tif u.snapshot != nil {\n\t\treturn u.snapshot.Metadata.Index, true\n\t}\n\treturn 0, false\n}\n\n// maybeTerm returns the term of the entry at index i, if there\n// is any.\nfunc (u *unstable) maybeTerm(i uint64) (uint64, bool) {\n\tif i < u.offset {\n\t\tif u.snapshot != nil && u.snapshot.Metadata.Index == i {\n\t\t\treturn u.snapshot.Metadata.Term, true\n\t\t}\n\t\treturn 0, false\n\t}\n\n\tlast, ok := u.maybeLastIndex()\n\tif !ok {\n\t\treturn 0, false\n\t}\n\tif i > last {\n\t\treturn 0, false\n\t}\n\n\treturn u.entries[i-u.offset].Term, true\n}\n\n// nextEntries returns the unstable entries that are not already in the process\n// of being written to storage.\nfunc (u *unstable) nextEntries() []pb.Entry {\n\tinProgress := int(u.offsetInProgress - u.offset)\n\tif len(u.entries) == inProgress {\n\t\treturn nil\n\t}\n    16\t\n    17\timport pb \"go.etcd.io/raft/v3/raftpb\"\n    18\t\n    19\t// unstable contains \"unstable\" log entries and snapshot state that has\n    20\t// not yet been written to Storage. The type serves two roles. First, it\n    21\t// holds on to new log entries and an optional snapshot until they are\n    22\t// handed to a Ready struct for persistence. Second, it continues to\n    23\t// hold on to this state after it has been handed off to provide raftLog\n    24\t// with a view of the in-progress log entries and snapshot until their\n    25\t// writes have been stabilized and are guaranteed to be reflected in\n    26\t// queries of Storage. After this point, the corresponding log entries\n    27\t// and/or snapshot can be cleared from unstable.\n    28\t//\n    29\t// unstable.entries[i] has raft log position i+unstable.offset.\n    30\t// Note that unstable.offset may be less than the highest log\n    31\t// position in storage; this means that the next write to storage\n    32\t// might need to truncate the log before persisting unstable.entries.\n    33\ttype unstable struct {\n    34\t\t// the incoming unstable snapshot, if any.\n    35\t\tsnapshot *pb.Snapshot\n    36\t\t// all entries that have not yet been written to storage.\n   264\t// newStorageAppendRespMsg creates the message that should be returned to node\n   265\t// after the unstable log entries, hard state, and snapshot in the current Ready\n   266\t// (along with those in all prior Ready structs) have been saved to stable\n   267\t// storage.\n   268\tfunc newStorageAppendRespMsg(r *raft, rd Ready) pb.Message {\n   269\t\tm := pb.Message{\n   270\t\t\tType: pb.MsgStorageAppendResp,\n   271\t\t\tTo:   r.id,\n   272\t\t\tFrom: LocalAppendThread,\n   273\t\t\t// Dropped after term change, see below.\n   274\t\t\tTerm: r.Term,\n   275\t\t}\n   276\t\tif r.raftLog.hasNextOrInProgressUnstableEnts() {\n   277\t\t\t// If the raft log has unstable entries, attach the last index and term of the\n   278\t\t\t// append to the response message. This (index, term) tuple will be handed back\n   279\t\t\t// and consulted when the stability of those log entries is signaled to the\n   280\t\t\t// unstable. If the (index, term) match the unstable log by the time the\n   281\t\t\t// response is received (unstable.stableTo), the unstable log can be truncated.\n   282\t\t\t//\n   283\t\t\t// However, with just this logic, there would be an ABA problem[^1] that could\n   284\t\t\t// lead to the unstable log and the stable log getting out of sync temporarily\n   285\t\t\t// and leading to an inconsistent view. Consider the following example with 5\n   286\t\t\t// nodes, A B C D E:\n   287\t\t\t//\n   288\t\t\t//  1. A is the leader.\n   289\t\t\t//  2. A proposes some log entries but only B receives these entries.\n   290\t\t\t//  3. B gets the Ready and the entries are appended asynchronously.\n   291\t\t\t//  4. A crashes and C becomes leader after getting a vote from D and E.\n   292\t\t\t//  5. C proposes some log entries and B receives these entries, overwriting the\n   293\t\t\t//     previous unstable log entries that are in the process of being appended.\n   294\t\t\t//     The entries have a larger term than the previous entries but the same\n   295\t\t\t//     indexes. It begins appending these new entries asynchronously.\n   296\t\t\t//  6. C crashes and A restarts and becomes leader again after getting the vote\n   297\t\t\t//     from D and E.\n   298\t\t\t//  7. B receives the entries from A which are the same as the ones from step 2,\n   299\t\t\t//     overwriting the previous unstable log entries that are in the process of\n   300\t\t\t//     being appended from step 5. The entries have the original terms and\n   301\t\t\t//     indexes from step 2. Recall that log entries retain their original term\n   302\t\t\t//     numbers when a leader replicates entries from previous terms. It begins\n   303\t\t\t//     appending these new entries asynchronously.\n   304\t\t\t//  8. The asynchronous log appends from the first Ready complete and stableTo\n   305\t\t\t//     is called.\n   306\t\t\t//  9. However, the log entries from the second Ready are still in the\n   307\t\t\t//     asynchronous append pipeline and will overwrite (in stable storage) the\n   308\t\t\t//     entries from the first Ready at some future point. We can't truncate the\n   309\t\t\t//     unstable log yet or a future read from Storage might see the entries from\n   310\t\t\t//     step 5 before they have been replaced by the entries from step 7.\n   311\t\t\t//     Instead, we must wait until we are sure that the entries are stable and\n   312\t\t\t//     that no in-progress appends might overwrite them before removing entries\n   313\t\t\t//     from the unstable log.\n   314\t\t\t//\n   315\t\t\t// To prevent these kinds of problems, we also attach the current term to the\n   316\t\t\t// MsgStorageAppendResp (above). If the term has changed by the time the\n   317\t\t\t// MsgStorageAppendResp if returned, the response is ignored and the unstable\n   318\t\t\t// log is not truncated. The unstable log is only truncated when the term has\n   319\t\t\t// remained unchanged from the time that the MsgStorageAppend was sent to the\n   320\t\t\t// time that the MsgStorageAppendResp is received, indicating that no-one else\n   321\t\t\t// is in the process of truncating the stable log.\n   322\t\t\t//\n   323\t\t\t// However, this replaces a correctness problem with a liveness problem. If we\n   324\t\t\t// only attempted to truncate the unstable log when appending new entries but\n  1144\t\t\t\t// votes to win the election. When it regains connectivity, this response\n  1145\t\t\t\t// with \"pb.MsgAppResp\" of higher term would force leader to step down.\n  1146\t\t\t\t// However, this disruption is inevitable to free this stuck node with\n  1147\t\t\t\t// fresh election. This can be prevented with Pre-Vote phase.\n  1148\t\t\t\tr.send(pb.Message{To: m.From, Type: pb.MsgAppResp})\n  1149\t\t\t} else if m.Type == pb.MsgPreVote {\n  1150\t\t\t\t// Before Pre-Vote enable, there may have candidate with higher term,\n  1151\t\t\t\t// but less log. After update to Pre-Vote, the cluster may deadlock if\n  1152\t\t\t\t// we drop messages with a lower term.\n  1153\t\t\t\tlast := r.raftLog.lastEntryID()\n  1154\t\t\t\t// TODO(pav-kv): it should be ok to simply print %+v of the lastEntryID.\n  1155\t\t\t\tr.logger.Infof(\"%x [logterm: %d, index: %d, vote: %x] rejected %s from %x [logterm: %d, index: %d] at term %d\",\n  1156\t\t\t\t\tr.id, last.term, last.index, r.Vote, m.Type, m.From, m.LogTerm, m.Index, r.Term)\n  1157\t\t\t\tr.send(pb.Message{To: m.From, Term: r.Term, Type: pb.MsgPreVoteResp, Reject: true})\n  1158\t\t\t} else if m.Type == pb.MsgStorageAppendResp {\n  1159\t\t\t\tif m.Index != 0 {\n  1160\t\t\t\t\t// Don't consider the appended log entries to be stable because\n  1161\t\t\t\t\t// they may have been overwritten in the unstable log during a\n  1162\t\t\t\t\t// later term. See the comment in newStorageAppendResp for more\n  1163\t\t\t\t\t// about this race.\n  1164\t\t\t\t\tr.logger.Infof(\"%x [term: %d] ignored entry appends from a %s message with lower term [term: %d]\",\n  1165\t\t\t\t\t\tr.id, r.Term, m.Type, m.Term)\n  1166\t\t\t\t}\n  1167\t\t\t\tif m.Snapshot != nil {\n  1168\t\t\t\t\t// Even if the snapshot applied under a different term, its\n  1169\t\t\t\t\t// application is still valid. Snapshots carry committed\n  1170\t\t\t\t\t// (term-independent) state.\n  1171\t\t\t\t\tr.appliedSnap(m.Snapshot)\n  1172\t\t\t\t}\n  1173\t\t\t} else {\n  1174\t\t\t\t// ignore other cases\n  1175\t\t\t\tr.logger.Infof(\"%x [term: %d] ignored a %s message with lower term from %x [term: %d]\",\n  1176\t\t\t\t\tr.id, r.Term, m.Type, m.From, m.Term)\n  1177\t\t\t}\n  1178\t\t\treturn nil\n  1179\t\t}\n  1180\t\n  1181\t\tswitch m.Type {\n  1182\t\tcase pb.MsgHup:\n  1183\t\t\tif r.preVote {\n  1184\t\t\t\tr.hup(campaignPreElection)\n  1185\t\t\t} else {\n  1186\t\t\t\tr.hup(campaignElection)\n  1187\t\t\t}\n  1188\t\n  1189\t\tcase pb.MsgStorageAppendResp:\n  1190\t\t\tif m.Index != 0 {\n  1191\t\t\t\tr.raftLog.stableTo(entryID{term: m.LogTerm, index: m.Index})\n  1192\t\t\t}\n  1193\t\t\tif m.Snapshot != nil {\n  1194\t\t\t\tr.appliedSnap(m.Snapshot)\n  1195\t\t\t}\n  1196\t\n  1197\t\tcase pb.MsgStorageApplyResp:\n  1198\t\t\tif len(m.Entries) > 0 {\n  1199\t\t\t\tindex := m.Entries[len(m.Entries)-1].Index\n  1200\t\t\t\tr.appliedTo(index, entsSize(m.Entries))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The replacement history completed. While node 2’s storage held term 3 at index 3, its accepted logical log held term 2 there; the delayed term-2 completion preserved that view. After the current replacement write completed, storage also held term 2.\n\nI’ll propose a scoped obligation to preserve the accepted log view across delayed storage completion. It will require a fresh formal execution; the exploration is not property evidence.\n"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > storage_obligation.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v2.json'))\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None);f.pop('consumed_by',None)\nsources=[dict(id='src_log_term_view',file='log.go',start_line=385,end_line=411,kind='code_observation'),dict(id='src_log_slice_view',file='log.go',start_line=496,end_line=546,kind='code_observation'),dict(id='src_unstable_term_view',file='log_unstable.go',start_line=53,end_line=91,kind='code_observation'),dict(id='src_unstable_view_contract',file='log_unstable.go',start_line=19,end_line=33,kind='interface_statement'),dict(id='src_storage_completion_contract',file='rawnode.go',start_line=264,end_line=321,kind='interface_statement')]\nf=dict(id='F_ACCEPTED_HISTORY',meaning='The follower has installed the entries from a matching accepted append into its current logical log view; uncommitted conflicting suffixes can be replaced by a later accepted append. Installation is not durable completion.',identity={'object':'accepted local log entry','key':'raft instance, log index, entry term and payload, accepted leader-message context'},validity_context='After matching append processing in the current follower context, until an accepted replacement or snapshot changes this index. A storage-completion notification alone is not a new history-selection operation.',representation=['raftLog unstable overlay and underlying Storage','Entry.Index, Term, Type, Data'],invalidators=['B_ACCEPT_HISTORY','B_RECONSTRUCT'],reinterpreters=[],durability='May exist only in unstable memory; caller append work persists it. Earlier writes can temporarily expose a different value in Storage while the overlay retains the current logical value.',recovery='Only persisted state restored through Storage survives restart; this fact makes no crash-survival assertion for unstable entries.',source_ids=['src_append_handler','src_log_append','src_unstable_replace','src_log_term_view','src_log_slice_view','src_unstable_view_contract'],unknowns=[])\nm['facts'].append(f)\nm['behaviors'].append(dict(id='B_ACCEPT_HISTORY',primary_activity='A1',execution_owner='raft.handleAppendEntries / raftLog.maybeAppend / unstable.truncateAndAppend',protocol_context='Follower handling term-filtered leader MsgApp with previous entry anchor',trigger='Accepted append whose previous term/index match the current log',implementation_guards=['Step handles higher/lower term before follower dispatch.','maybeAppend requires previous term match and panics on conflict at/below committed; otherwise replaces only conflicting uncommitted suffix.'],writes=['Install appended suffix in unstable overlay and reset offsetInProgress for replaced entries.','Queue MsgAppResp through persistence; bound propagated commit by matched appended extent.'],produces_fact_ids=['F_ACCEPTED_HISTORY'],source_ids=['src_step','src_append_handler','src_log_append','src_unstable_replace'],unknowns=[]))\nm['behaviors'].append(dict(id='B_LOG_VIEW',primary_activity='A6',execution_owner='raftLog.term / raftLog.slice / unstable.maybeTerm',protocol_context='Current logical log combining unstable accepted history and caller Storage',trigger='Term lookup or entry slice retrieval',implementation_guards=['term consults unstable first; slice uses unstable for indexes at/above unstable.offset and Storage below it.'],consumes_fact_ids=['F_ACCEPTED_HISTORY'],external_effects=['Return term or entries from the logical overlay rather than unconditionally using Storage.'],cross_activity_effects={'A1':'Term comparison and entry retrieval feed append matching, commit term validation and replication.','A2':'lastEntryID/isUpToDate derive election log freshness from the same logical history.'},source_ids=['src_log_term_view','src_log_slice_view','src_unstable_term_view','src_log_commit','src_replication'],unknowns=[]))\nb=next(x for x in m['behaviors'] if x['id']=='B_STORAGE_FRONTIER')\nb['consumes_fact_ids']=['F_ACCEPTED_HISTORY']\nb['source_ids']+=['src_unstable_view_contract','src_storage_completion_contract','src_log_term_view','src_log_slice_view']\nb['existing_protections']=['Message raft term rejects old completion even if its entry term/index again match the current overlay; stableTo also checks current entry term/index.']\no=m['core_overview']\no['connection']['explanation']+=' The accepted follower append history is represented by the unstable overlay until replacement writes are reflected safely in Storage. Storage-completion validation controls when queries fall through to Storage: message raft term and entry term/index are distinct context checks. This persistence boundary feeds both term-based support validation and election log freshness.'\no['connection']['behavior_ids']+=['B_ACCEPT_HISTORY','B_LOG_VIEW']\no['connection']['fact_ids']+=['F_ACCEPTED_HISTORY']\nobj={x['id']:x for c in ['behaviors','facts'] for x in m[c]}\nfor k in ['formation','context','connection']:\n p=o[k];p['source_ids']=list(dict.fromkeys(p['source_ids']+[s for i in p['behavior_ids']+p['fact_ids'] for s in obj[i]['source_ids']]))\njson.dump(m,open('audit-map.json','w'),indent=2)\nq=dict(disposition='ready_for_check',preferred_check='controlled_schedule',question='Does a delayed append-completion notification preserve the current accepted logical log entry when storage temporarily contains an intervening conflicting version and the latest replacement write is still pending?',importance='If completion retires the current overlay too early, log lookup can return a conflicting older storage version. Such lookups feed append matching, commit term checks and election freshness. The selected responsibility is local history consistency across A2 context change, supporting A1; a wider consensus violation requires additional evidence.',source_ids=['src_append_handler','src_log_append','src_unstable_replace','src_step','src_raw_append','src_raw_storage_tail','src_unstable_view_contract','src_storage_completion_contract','src_log_term_view','src_log_slice_view','src_async_delivery'],participants=['Follower with ordered append worker','Successive actual leaders','Voting peers supporting elections'],objects=['Current accepted log entry','In-progress replacement append','Delayed local append-completion response','Logical log term and entry queries'],contexts=['AsyncStorageWrites with reliable FIFO append requests and FIFO local completion delivery; responses to distinct remote recipients may progress separately after their writes','Fixed voter set, network delay/loss and no process crash, no snapshot within the selected interval','Same index and original entry term recur in a later leader context after an intervening conflicting stored version'],event_paths=['Actual elections and replication -> follower accepts replacement -> Ready emits replacement storage request','Earlier append worker completion -> RawNode.Step(MsgStorageAppendResp) -> term validation -> unstable stabilization -> logical log lookup'],activity_classes=['A1','A2','A6'],behavior_ids=['B_ACCEPT_HISTORY','B_STORAGE_FRONTIER','B_LOG_VIEW'],fact_ids=['F_ACCEPTED_HISTORY'],supporting_behavior_ids={'B_ELECT':'Actual candidate/vote paths produce successive leader contexts instead of direct role assignment.','B_RESET':'Term transition changes the validation context for pending storage replies.','B_ACK_QUEUE':'Remote replication responses are delayed until their corresponding storage writes complete.','B_REPLICATION_SEND':'Actual append rejection/retry produces the latest replacement; no handcrafted protocol message is needed.','B_RECONSTRUCT':'Caller-supplied initial snapshot and HardState construct a common committed prefix.'},obligation_relation_kind='preservation',counterevidence=['Step ignores stale-term entry stabilization even if entry identity matches.','unstable.stableTo independently checks entry term/index.','Current-term completion after replacement persistence can safely retire the overlay.','Exploration 9e5d14f4513e4988a856d198246a176f observed preservation, but it has no fixed property comparison and is not formal Evidence.'],unknowns=[],priority=2,trigger_rationale='The completed actual-producer exploration reached conflicting Storage and current unstable history at the same index, then consumed an old completion. Fix an independent current accepted-entry oracle and fresh execution to assess the local contract without inferring a broader consensus consequence.')\nclaim='C_ACCEPTED_LOG_VIEW'\nbind='BIND_STORAGE_VIEW'\nground=dict(source_ids=['src_step','src_unstable_stable','src_log_term_view','src_log_slice_view'],expectation_ids=['src_unstable_view_contract','src_storage_completion_contract'],binding_ids=[bind],derivation='The unstable type contract requires retaining the in-progress logical view until writes are stabilized and guaranteed reflected by Storage queries. The storage-completion commentary explicitly requires waiting when in-progress appends can overwrite that view. Therefore, with a current accepted replacement pending and a different stored version, consuming an earlier completion must preserve the accepted entry returned by the logical log. This requirement concerns observable history consistency, not the particular implementation guard or unstable offset value.',applicability='Applicable to public RawNode asynchronous storage use with serialized calls, actual append producers, correctly ordered storage work and responses after write completion. Device durability is modeled by caller MemoryStorage without crash; the property does not claim crash recovery.',unresolved=[],conflicts=[],alternatives=['A different implementation could copy or reconstruct the accepted entry instead of retaining unstable memory; the oracle tests returned entry contents, not the storage strategy.'])\nob=dict(id=claim,kind='obligation',concern='implementation_semantics',description='Consuming a delayed append-completion notification must preserve the current accepted logical log entry while its replacement storage write is pending and Storage contains a conflicting intervening version, provided no new accepted append, snapshot or other history-changing operation occurs during that completion interval.',source_ids=['src_unstable_view_contract','src_storage_completion_contract','src_async_delivery'],scope=dict(description='Asynchronous local storage completion across leader-context changes with an accepted replacement not yet reflected in Storage.',assumptions=['Serialized RawNode calls.','Reliable FIFO append requests and FIFO local responses; remote responses delivered only after their writes.','Protocol messages produced by actual raft nodes; caller initializes a valid shared committed prefix.','No crash, snapshot, compaction or configuration activation during the selected preservation interval.'],excluded=['Byzantine or forged messages','Crash-atomic device behavior','General election safety or committed-entry agreement across nodes','General liveness or timing guarantees'],parameters={'storage_mode':'AsyncStorageWrites','faults':'finite network loss and response/write delays'}),pending=[],grounding=ground)\nbindings=[dict(id=bind,material_id='src_step',symbol='raft.Step',start_line=1158,end_line=1195,description='Dispatch of stale and current append completions determines whether unstable state is retired. Logical lookup consumers are separately cited for the observation boundary.',pending=[],associations=[dict(claim_id=claim,source_ids=['src_unstable_view_contract','src_storage_completion_contract','src_step','src_log_term_view','src_log_slice_view'],rationale='Binds the required preserved view to the real completion consumer and overlay-backed read path.')])]\nchanges={'B_STORAGE_FRONTIER':dict(impact='dependency',source_ids=['src_unstable_view_contract','src_storage_completion_contract','src_log_term_view','src_log_slice_view'],rationale='Make its preservation dependency on current accepted follower history explicit; add the existing term and entry identity protections.',preserves='The prior self-Match Candidate retains its original F_MATCH basis and source explanation; no changed requirement or evidence.',challenges={}), 'core_overview':dict(impact='clarification',source_ids=['src_unstable_view_contract','src_storage_completion_contract','src_log_term_view','src_log_slice_view'],rationale='Connect accepted history, storage retirement and actual log-view consumers; new fact/behaviors are independent additions.',preserves='Both core paths and prior self-Match conclusion remain unchanged in scope.',challenges={})}\ns=dict(action='obligation',rationale='Register current accepted-history preservation and fix a local implementation contract before a fresh direct check.',sources=sources,map_path='audit-map.json',map_changes=changes,question=q,obligation=ob,bindings=bindings,feedback=dict(ref_ids=['9e5d14f4513e4988a856d198246a176f','094ea077ebb340d39d82022bc7e733ad','src_unstable_view_contract','src_storage_completion_contract'],answered='Exploration 9e5d14f4513e4988a856d198246a176f completed actual leaders 1/term2, 3/term3, then 1/term4. At node 2, index 3 had logical term 2, stored term 3, two unstable entries and one pending replacement write. Consuming the delayed term-2 completion preserved logical term 2 and unstable offset 3. Completing current writes changed stored term to 2 and retired the overlay to offset 5. Final output reported no pending network/append/completion work and follower applied/commit 4. This remains construction knowledge. Registering the contract does not retroactively create Evidence.',remaining=['Execute a fresh fixed check with expected entry bytes captured from the actual accepted replacement work, an independent operation identity, and result observations after delayed and current completion.'],understanding='updated',rationale='The missing competing-write premise is now demonstrated by exploration. Finish this bounded responsibility with a fixed oracle and current correspondence review rather than adding another arbitrary schedule.'))\njson.dump(s,open('submission.json','w'),indent=2)\nPY\npython3 storage_obligation.py\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-02_16-15-15-etcd_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
