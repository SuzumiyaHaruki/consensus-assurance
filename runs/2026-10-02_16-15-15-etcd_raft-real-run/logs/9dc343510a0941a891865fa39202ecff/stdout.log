   ],\n      \"title\": \"StopSubmission\",\n      \"type\": \"object\"\n    },\n    \"UnderstandingChange\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"impact\": {\n          \"enum\": [\n            \"clarification\",\n            \"meaning\",\n            \"dependency\"\n          ],\n          \"title\": \"Impact\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"preserves\": {\n          \"default\": \"\",\n          \"description\": \"Shared sourced explanation of why the existing propositions, premises and observations still apply\",\n          \"title\": \"Preserves\",\n          \"type\": \"string\"\n        },\n        \"challenges\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Saved Candidate IDs and the concrete premise or interpretation challenged by this knowledge\",\n          \"title\": \"Challenges\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"impact\",\n        \"rationale\",\n        \"source_ids\"\n      ],\n      \"title\": \"UnderstandingChange\",\n      \"type\": \"object\"\n    }\n  },\n  \"discriminator\": {\n    \"mapping\": {\n      \"check\": \"#/$defs/CheckSubmission\",\n      \"continue\": \"#/$defs/CandidateSubmission\",\n      \"explained\": \"#/$defs/CandidateSubmission\",\n      \"explore\": \"#/$defs/ExploreSubmission\",\n      \"model\": \"#/$defs/ModelSubmission\",\n      \"obligation\": \"#/$defs/CandidateSubmission\",\n      \"pause\": \"#/$defs/CandidateSubmission\",\n      \"research\": \"#/$defs/ResearchSubmission\",\n      \"rev