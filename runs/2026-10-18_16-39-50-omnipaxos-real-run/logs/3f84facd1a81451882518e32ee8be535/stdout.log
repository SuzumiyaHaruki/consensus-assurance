{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos_storage/src/memory_storage.rs'","aggregated_output":"     1\tuse omnipaxos::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    storage::{Entry, StopSign, Storage, StorageOp, StorageResult},\n     4\t};\n     5\t/// An in-memory storage implementation for SequencePaxos.\n     6\t#[derive(Clone)]\n     7\tpub struct MemoryStorage<T>\n     8\twhere\n     9\t    T: Entry,\n    10\t{\n    11\t    /// Vector which contains all the logged entries in-memory.\n    12\t    log: Vec<T>,\n    13\t    /// Last promised round.\n    14\t    n_prom: Option<Ballot>,\n    15\t    /// Last accepted round.\n    16\t    acc_round: Option<Ballot>,\n    17\t    /// Length of the decided log.\n    18\t    ld: usize,\n    19\t    /// Garbage collected index.\n    20\t    trimmed_idx: usize,\n    21\t    /// Stored compact index\n    22\t    compacted_idx: usize,\n    23\t    /// Stored snapshot\n    24\t    snapshot: Option<T::Snapshot>,\n    25\t    /// Stored StopSign\n    26\t    stopsign: Option<StopSign>,\n    27\t}\n    28\t\n    29\timpl<T> Storage<T> for MemoryStorage<T>\n    30\twhere\n    31\t    T: Entry,\n    32\t{\n    33\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n    34\t        for op in ops {\n    35\t            match op {\n    36\t                StorageOp::AppendEntry(entry) => self.append_entry(entry)?,\n    37\t                StorageOp::AppendEntries(entries) => self.append_entries(entries)?,\n    38\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n    39\t                    self.append_on_prefix(from_idx, entries)?\n    40\t                }\n    41\t                StorageOp::SetPromise(bal) => self.set_promise(bal)?,\n    42\t                StorageOp::SetDecidedIndex(idx) => self.set_decided_idx(idx)?,\n    43\t                StorageOp::SetAcceptedRound(bal) => self.set_accepted_round(bal)?,\n    44\t                StorageOp::SetCompactedIdx(idx) => self.set_compacted_idx(idx)?,\n    45\t                StorageOp::Trim(idx) => self.trim(idx)?,\n    46\t                StorageOp::SetStopsign(ss) => self.set_stopsign(ss)?,\n    47\t                StorageOp::SetSnapshot(snap) => self.set_snapshot(snap)?,\n    48\t            }\n    49\t        }\n    50\t        Ok(())\n    51\t    }\n    52\t\n    53\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n    54\t        self.log.push(entry);\n    55\t        Ok(())\n    56\t    }\n    57\t\n    58\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n    59\t        let mut e = entries;\n    60\t        self.log.append(&mut e);\n    61\t        Ok(())\n    62\t    }\n    63\t\n    64\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n    65\t        self.log.truncate(from_idx - self.trimmed_idx);\n    66\t        self.append_entries(entries)\n    67\t    }\n    68\t\n    69\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n    70\t        self.n_prom = Some(n_prom);\n    71\t        Ok(())\n    72\t    }\n    73\t\n    74\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n    75\t        self.ld = ld;\n    76\t        Ok(())\n    77\t    }\n    78\t\n    79\t    fn get_decided_idx(&self) -> StorageResult<usize> {\n    80\t        Ok(self.ld)\n    81\t    }\n    82\t\n    83\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n    84\t        self.acc_round = Some(na);\n    85\t        Ok(())\n    86\t    }\n    87\t\n    88\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n    89\t        Ok(self.acc_round)\n    90\t    }\n    91\t\n    92\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n    93\t        let from = from - self.trimmed_idx;\n    94\t        let to = to - self.trimmed_idx;\n    95\t        Ok(self.log.get(from..to).unwrap_or(&[]).to_vec())\n    96\t    }\n    97\t\n    98\t    fn get_log_len(&self) -> StorageResult<usize> {\n    99\t        Ok(self.log.len())\n   100\t    }\n   101\t\n   102\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   103\t        Ok(match self.log.get((from - self.trimmed_idx)..) {\n   104\t            Some(s) => s.to_vec(),\n   105\t            None => vec![],\n   106\t        })\n   107\t    }\n   108\t\n   109\t    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n   110\t        Ok(self.n_prom)\n   111\t    }\n   112\t\n   113\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> {\n   114\t        self.stopsign = s;\n   115\t        Ok(())\n   116\t    }\n   117\t\n   118\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> {\n   119\t        Ok(self.stopsign.clone())\n   120\t    }\n   121\t\n   122\t    fn trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   123\t        let to_trim = (trimmed_idx - self.trimmed_idx).min(self.log.len());\n   124\t        self.log.drain(0..to_trim);\n   125\t        self.trimmed_idx = trimmed_idx;\n   126\t        Ok(())\n   127\t    }\n   128\t\n   129\t    fn set_compacted_idx(&mut self, compact_idx: usize) -> StorageResult<()> {\n   130\t        self.compacted_idx = compact_idx;\n   131\t        Ok(())\n   132\t    }\n   133\t\n   134\t    fn get_compacted_idx(&self) -> StorageResult<usize> {\n   135\t        Ok(self.compacted_idx)\n   136\t    }\n   137\t\n   138\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n   139\t        self.snapshot = snapshot;\n   140\t        Ok(())\n   141\t    }\n   142\t\n   143\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   144\t        Ok(self.snapshot.clone())\n   145\t    }\n   146\t}\n   147\t\n   148\timpl<T: Entry> Default for MemoryStorage<T> {\n   149\t    fn default() -> Self {\n   150\t        Self {\n   151\t            log: vec![],\n   152\t            n_prom: None,\n   153\t            acc_round: None,\n   154\t            ld: 0,\n   155\t            trimmed_idx: 0,\n   156\t            compacted_idx: 0,\n   157\t            snapshot: None,\n   158\t            stopsign: None,\n   159\t        }\n   160\t    }\n   161\t}\n","exit_code":0,"status":"completed"}}
