{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/storage/state_cache.rs'","aggregated_output":"     1\tuse super::{internal_storage::InternalStorageConfig, Entry, StopSign};\n     2\tuse crate::ballot_leader_election::Ballot;\n     3\t#[cfg(feature = \"unicache\")]\n     4\tuse crate::{unicache::*, util::NodeId};\n     5\t\n     6\t/// A simple in-memory storage for simple state values of OmniPaxos.\n     7\tpub(super) struct StateCache<T>\n     8\twhere\n     9\t    T: Entry,\n    10\t{\n    11\t    #[cfg(feature = \"unicache\")]\n    12\t    /// Id of this node\n    13\t    pub pid: NodeId,\n    14\t    /// The maximum number of entries to batch.\n    15\t    pub batch_size: usize,\n    16\t    /// Vector which contains all the logged entries in-memory.\n    17\t    pub batched_entries: Vec<T>,\n    18\t    /// Last promised round.\n    19\t    pub promise: Ballot,\n    20\t    /// Last accepted round.\n    21\t    pub accepted_round: Ballot,\n    22\t    /// Length of the decided log.\n    23\t    pub decided_idx: usize,\n    24\t    /// Length of the accepted log.\n    25\t    pub accepted_idx: usize,\n    26\t    /// Garbage collected index.\n    27\t    pub compacted_idx: usize,\n    28\t    /// Stopsign entry.\n    29\t    pub stopsign: Option<StopSign>,\n    30\t    #[cfg(feature = \"unicache\")]\n    31\t    /// Batch of entries that are processed (i.e., maybe encoded). Only used by the leader.\n    32\t    pub batched_processed_by_leader: Vec<T::EncodeResult>,\n    33\t    #[cfg(feature = \"unicache\")]\n    34\t    pub unicache: T::UniCache,\n    35\t}\n    36\t\n    37\timpl<T> StateCache<T>\n    38\twhere\n    39\t    T: Entry,\n    40\t{\n    41\t    pub(super) fn new(\n    42\t        config: InternalStorageConfig,\n    43\t        #[cfg(feature = \"unicache\")] pid: NodeId,\n    44\t    ) -> Self {\n    45\t        StateCache {\n    46\t            #[cfg(feature = \"unicache\")]\n    47\t            pid,\n    48\t            batch_size: config.batch_size,\n    49\t            batched_entries: Vec::with_capacity(config.batch_size),\n    50\t            promise: Ballot::default(),\n    51\t            accepted_round: Ballot::default(),\n    52\t            decided_idx: 0,\n    53\t            accepted_idx: 0,\n    54\t            compacted_idx: 0,\n    55\t            stopsign: None,\n    56\t            #[cfg(feature = \"unicache\")]\n    57\t            batched_processed_by_leader: Vec::with_capacity(config.batch_size),\n    58\t            #[cfg(feature = \"unicache\")]\n    59\t            unicache: T::UniCache::new(),\n    60\t        }\n    61\t    }\n    62\t\n    63\t    // Appends an entry to the end of the `batched_entries`. If the batch is full, the\n    64\t    // batch is flushed and return flushed entries. Else, return None.\n    65\t    pub(super) fn append_entry(&mut self, entry: T) -> Option<Vec<T>> {\n    66\t        #[cfg(feature = \"unicache\")]\n    67\t        {\n    68\t            let processed = self.unicache.try_encode(&entry);\n    69\t            self.batched_processed_by_leader.push(processed);\n    70\t        }\n    71\t        self.batched_entries.push(entry);\n    72\t        self.take_entries_if_batch_is_full()\n    73\t    }\n    74\t\n    75\t    // Appends entries to the end of the `batched_entries`. If the batch is full, the\n    76\t    // batch is flushed and return flushed entries. Else, return None.\n    77\t    pub(super) fn append_entries(&mut self, entries: Vec<T>) -> Option<Vec<T>> {\n    78\t        #[cfg(feature = \"unicache\")]\n    79\t        {\n    80\t            if self.promise.pid == self.pid {\n    81\t                // only try encoding if we're the leader\n    82\t                for entry in &entries {\n    83\t                    let processed = self.unicache.try_encode(entry);\n    84\t                    self.batched_processed_by_leader.push(processed);\n    85\t                }\n    86\t            }\n    87\t        }\n    88\t        self.batched_entries.extend(entries);\n    89\t        self.take_entries_if_batch_is_full()\n    90\t    }\n    91\t\n    92\t    // Flushes batched entries and appends a stopsign to the log. Returns the flushed\n    93\t    // entries if there were any\n    94\t    pub(super) fn append_stopsign(&mut self, ss: StopSign) -> Option<Vec<T>> {\n    95\t        self.stopsign = Some(ss);\n    96\t        if self.batched_entries.is_empty() {\n    97\t            None\n    98\t        } else {\n    99\t            Some(self.take_batched_entries())\n   100\t        }\n   101\t    }\n   102\t\n   103\t    // Return batched entries if the batch is full that need to be flushed in to storage.\n   104\t    fn take_entries_if_batch_is_full(&mut self) -> Option<Vec<T>> {\n   105\t        if self.batched_entries.len() >= self.batch_size {\n   106\t            Some(self.take_batched_entries())\n   107\t        } else {\n   108\t            None\n   109\t        }\n   110\t    }\n   111\t\n   112\t    // Clears the batched entries and returns the cleared entries. If the batch is empty,\n   113\t    // return an empty vector.\n   114\t    pub(super) fn take_batched_entries(&mut self) -> Vec<T> {\n   115\t        std::mem::take(&mut self.batched_entries)\n   116\t    }\n   117\t\n   118\t    #[cfg(feature = \"unicache\")]\n   119\t    pub(super) fn take_batched_processed(&mut self) -> Vec<T::EncodeResult> {\n   120\t        std::mem::take(&mut self.batched_processed_by_leader)\n   121\t    }\n   122\t\n   123\t    // Returns whether a stopsign is decided\n   124\t    pub(super) fn stopsign_is_decided(&self) -> bool {\n   125\t        self.stopsign.is_some() && self.decided_idx == self.accepted_idx\n   126\t    }\n   127\t}\n","exit_code":0,"status":"completed"}}
