{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/sequence_paxos/mod.rs'","aggregated_output":"     1\tuse super::{ballot_leader_election::Ballot, messages::sequence_paxos::*, util::LeaderState};\n     2\t#[cfg(feature = \"logging\")]\n     3\tuse crate::utils::logger::create_logger;\n     4\tuse crate::{\n     5\t    messages::Message,\n     6\t    storage::{\n     7\t        internal_storage::{InternalStorage, InternalStorageConfig},\n     8\t        Entry, Snapshot, StopSign, Storage,\n     9\t    },\n    10\t    util::{\n    11\t        FlexibleQuorum, LogSync, NodeId, Quorum, SequenceNumber, READ_ERROR_MSG, WRITE_ERROR_MSG,\n    12\t    },\n    13\t    ClusterConfig, CompactionErr, OmniPaxosConfig, ProposeErr,\n    14\t};\n    15\t#[cfg(feature = \"logging\")]\n    16\tuse slog::{debug, info, trace, warn, Logger};\n    17\tuse std::{fmt::Debug, vec};\n    18\t\n    19\tpub mod follower;\n    20\tpub mod leader;\n    21\t\n    22\t/// a Sequence Paxos replica. Maintains local state of the replicated log, handles incoming messages and produces outgoing messages that the user has to fetch periodically and send using a network implementation.\n    23\t/// User also has to periodically fetch the decided entries that are guaranteed to be strongly consistent and linearizable, and therefore also safe to be used in the higher level application.\n    24\t/// If snapshots are not desired to be used, use `()` for the type parameter `S`.\n    25\tpub(crate) struct SequencePaxos<T, B>\n    26\twhere\n    27\t    T: Entry,\n    28\t    B: Storage<T>,\n    29\t{\n    30\t    pub(crate) internal_storage: InternalStorage<B, T>,\n    31\t    pid: NodeId,\n    32\t    peers: Vec<NodeId>, // excluding self pid\n    33\t    state: (Role, Phase),\n    34\t    buffered_proposals: Vec<T>,\n    35\t    buffered_stopsign: Option<StopSign>,\n    36\t    outgoing: Vec<Message<T>>,\n    37\t    leader_state: LeaderState<T>,\n    38\t    latest_accepted_meta: Option<(Ballot, usize)>,\n    39\t    // Keeps track of sequence of accepts from leader where AcceptSync = 1\n    40\t    current_seq_num: SequenceNumber,\n    41\t    cached_promise_message: Option<Promise<T>>,\n    42\t    #[cfg(feature = \"logging\")]\n    43\t    logger: Logger,\n    44\t}\n    45\t\n    46\timpl<T, B> SequencePaxos<T, B>\n    47\twhere\n    48\t    T: Entry,\n    49\t    B: Storage<T>,\n    50\t{\n    51\t    /*** User functions ***/\n    52\t    /// Creates a Sequence Paxos replica.\n    53\t    pub(crate) fn with(config: SequencePaxosConfig, storage: B) -> Self {\n    54\t        let pid = config.pid;\n    55\t        let peers = config.peers;\n    56\t        let num_nodes = &peers.len() + 1;\n    57\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n    58\t        let max_peer_pid = peers.iter().max().unwrap();\n    59\t        let max_pid = *std::cmp::max(max_peer_pid, &pid) as usize;\n    60\t        let mut outgoing = Vec::with_capacity(config.buffer_size);\n    61\t        let (state, leader) = match storage\n    62\t            .get_promise()\n    63\t            .expect(\"storage error while trying to read promise\")\n    64\t        {\n    65\t            // if we recover a promise from storage then we must do failure recovery\n    66\t            Some(b) => {\n    67\t                let state = (Role::Follower, Phase::Recover);\n    68\t                for peer_pid in &peers {\n    69\t                    let prepreq = PrepareReq { n: b };\n    70\t                    outgoing.push(Message::SequencePaxos(PaxosMessage {\n    71\t                        from: pid,\n    72\t                        to: *peer_pid,\n    73\t                        msg: PaxosMsg::PrepareReq(prepreq),\n    74\t                    }));\n    75\t                }\n    76\t                (state, b)\n    77\t            }\n    78\t            None => ((Role::Follower, Phase::None), Ballot::default()),\n    79\t        };\n    80\t        let internal_storage_config = InternalStorageConfig {\n    81\t            batch_size: config.batch_size,\n    82\t        };\n    83\t        let mut paxos = SequencePaxos {\n    84\t            internal_storage: InternalStorage::with(\n    85\t                storage,\n    86\t                internal_storage_config,\n    87\t                #[cfg(feature = \"unicache\")]\n    88\t                pid,\n    89\t            ),\n    90\t            pid,\n    91\t            peers,\n    92\t            state,\n    93\t            buffered_proposals: vec![],\n    94\t            buffered_stopsign: None,\n    95\t            outgoing,\n    96\t            leader_state: LeaderState::<T>::with(leader, max_pid, quorum),\n    97\t            latest_accepted_meta: None,\n    98\t            current_seq_num: SequenceNumber::default(),\n    99\t            cached_promise_message: None,\n   100\t            #[cfg(feature = \"logging\")]\n   101\t            logger: {\n   102\t                if let Some(logger) = config.custom_logger {\n   103\t                    logger\n   104\t                } else {\n   105\t                    let s = config\n   106\t                        .logger_file_path\n   107\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   108\t                    create_logger(s.as_str())\n   109\t                }\n   110\t            },\n   111\t        };\n   112\t        paxos\n   113\t            .internal_storage\n   114\t            .set_promise(leader)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        #[cfg(feature = \"logging\")]\n   117\t        {\n   118\t            info!(paxos.logger, \"Paxos component pid: {} created!\", pid);\n   119\t            if let Quorum::Flexible(flex_quorum) = quorum {\n   120\t                if flex_quorum.read_quorum_size > num_nodes - flex_quorum.write_quorum_size + 1 {\n   121\t                    warn!(\n   122\t                        paxos.logger,\n   123\t                        \"Unnecessary overlaps in read and write quorums. Read and Write quorums only need to be overlapping by one node i.e., read_quorum_size + write_quorum_size = num_nodes + 1\");\n   124\t                }\n   125\t            }\n   126\t        }\n   127\t        paxos\n   128\t    }\n   129\t\n   130\t    pub(crate) fn get_state(&self) -> &(Role, Phase) {\n   131\t        &self.state\n   132\t    }\n   133\t\n   134\t    pub(crate) fn get_promise(&self) -> Ballot {\n   135\t        self.internal_storage.get_promise()\n   136\t    }\n   137\t\n   138\t    /// Initiates the trim process.\n   139\t    /// # Arguments\n   140\t    /// * `trim_idx` - Deletes all entries up to [`trim_idx`], if the [`trim_idx`] is `None` then the minimum index accepted by **ALL** servers will be used as the [`trim_idx`].\n   141\t    pub(crate) fn trim(&mut self, trim_idx: Option<usize>) -> Result<(), CompactionErr> {\n   142\t        match self.state {\n   143\t            (Role::Leader, _) => {\n   144\t                let min_all_accepted_idx = self.leader_state.get_min_all_accepted_idx();\n   145\t                let trimmed_idx = match trim_idx {\n   146\t                    Some(idx) if idx <= *min_all_accepted_idx => idx,\n   147\t                    None => {\n   148\t                        #[cfg(feature = \"logging\")]\n   149\t                        trace!(\n   150\t                            self.logger,\n   151\t                            \"No trim index provided, using min_las_idx: {:?}\",\n   152\t                            min_all_accepted_idx\n   153\t                        );\n   154\t                        *min_all_accepted_idx\n   155\t                    }\n   156\t                    _ => {\n   157\t                        return Err(CompactionErr::NotAllDecided(*min_all_accepted_idx));\n   158\t                    }\n   159\t                };\n   160\t                let result = self.internal_storage.try_trim(trimmed_idx);\n   161\t                if result.is_ok() {\n   162\t                    for pid in &self.peers {\n   163\t                        let msg = PaxosMsg::Compaction(Compaction::Trim(trimmed_idx));\n   164\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   165\t                            from: self.pid,\n   166\t                            to: *pid,\n   167\t                            msg,\n   168\t                        }));\n   169\t                    }\n   170\t                }\n   171\t                result.map_err(|e| {\n   172\t                    *e.downcast()\n   173\t                        .expect(\"storage error while trying to trim log\")\n   174\t                })\n   175\t            }\n   176\t            _ => Err(CompactionErr::NotCurrentLeader(self.get_current_leader())),\n   177\t        }\n   178\t    }\n   179\t\n   180\t    /// Trim the log and create a snapshot. ** Note: only up to the `decided_idx` can be snapshotted **\n   181\t    /// # Arguments\n   182\t    /// `idx` - Snapshots all entries with index < [`idx`], if the [`idx`] is None then the decided index will be used.\n   183\t    /// `local_only` - If `true`, only this server snapshots the log. If `false` all servers performs the snapshot.\n   184\t    pub(crate) fn snapshot(\n   185\t        &mut self,\n   186\t        idx: Option<usize>,\n   187\t        local_only: bool,\n   188\t    ) -> Result<(), CompactionErr> {\n   189\t        let result = self.internal_storage.try_snapshot(idx);\n   190\t        if !local_only && result.is_ok() {\n   191\t            // since it is decided, it is ok even for a follower to send this\n   192\t            for pid in &self.peers {\n   193\t                let msg = PaxosMsg::Compaction(Compaction::Snapshot(idx));\n   194\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   195\t                    from: self.pid,\n   196\t                    to: *pid,\n   197\t                    msg,\n   198\t                }));\n   199\t            }\n   200\t        }\n   201\t        result.map_err(|e| {\n   202\t            *e.downcast()\n   203\t                .expect(\"storage error while trying to snapshot log\")\n   204\t        })\n   205\t    }\n   206\t\n   207\t    /// Return the decided index.\n   208\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   209\t        self.internal_storage.get_decided_idx()\n   210\t    }\n   211\t\n   212\t    /// Return trim index from storage.\n   213\t    pub(crate) fn get_compacted_idx(&self) -> usize {\n   214\t        self.internal_storage.get_compacted_idx()\n   215\t    }\n   216\t\n   217\t    fn handle_compaction(&mut self, c: Compaction) {\n   218\t        // try trimming and snapshotting forwarded compaction. Errors are ignored as that the data will still be kept.\n   219\t        match c {\n   220\t            Compaction::Trim(idx) => {\n   221\t                let _ = self.internal_storage.try_trim(idx);\n   222\t            }\n   223\t            Compaction::Snapshot(idx) => {\n   224\t                let _ = self.snapshot(idx, true);\n   225\t            }\n   226\t        }\n   227\t    }\n   228\t\n   229\t    /// Detects if a Prepare, Promise, AcceptStopSign, Decide of a Stopsign, or PrepareReq message\n   230\t    /// has been sent but not been received. If so resends them. Note: We can't detect if a\n   231\t    /// StopSign's Decide message has been received so we always resend to be safe.\n   232\t    pub(crate) fn resend_message_timeout(&mut self) {\n   233\t        match self.state.0 {\n   234\t            Role::Leader => self.resend_messages_leader(),\n   235\t            Role::Follower => self.resend_messages_follower(),\n   236\t        }\n   237\t    }\n   238\t\n   239\t    /// Flushes any batched log entries and sends their corresponding Accept or Accepted messages.\n   240\t    pub(crate) fn flush_batch_timeout(&mut self) {\n   241\t        match self.state {\n   242\t            (Role::Leader, Phase::Accept) => self.flush_batch_leader(),\n   243\t            (Role::Follower, Phase::Accept) => self.flush_batch_follower(),\n   244\t            _ => (),\n   245\t        }\n   246\t    }\n   247\t\n   248\t    /// Moves the outgoing messages from this replica into the buffer. The messages should then be sent via the network implementation.\n   249\t    /// If `buffer` is empty, it gets swapped with the internal message buffer. Otherwise, messages are appended to the buffer. This prevents messages from getting discarded.\n   250\t    /// the buffer.\n   251\t    pub(crate) fn take_outgoing_msgs(&mut self, buffer: &mut Vec<Message<T>>) {\n   252\t        if buffer.is_empty() {\n   253\t            std::mem::swap(buffer, &mut self.outgoing);\n   254\t        } else {\n   255\t            // User has unsent messages in their buffer, must extend their buffer.\n   256\t            buffer.append(&mut self.outgoing);\n   257\t        }\n   258\t        self.leader_state.reset_latest_accept_meta();\n   259\t        self.latest_accepted_meta = None;\n   260\t    }\n   261\t\n   262\t    /// Handle an incoming message.\n   263\t    pub(crate) fn handle(&mut self, m: PaxosMessage<T>) {\n   264\t        match m.msg {\n   265\t            PaxosMsg::PrepareReq(prepreq) => self.handle_preparereq(prepreq, m.from),\n   266\t            PaxosMsg::Prepare(prep) => self.handle_prepare(prep, m.from),\n   267\t            PaxosMsg::Promise(prom) => match &self.state {\n   268\t                (Role::Leader, Phase::Prepare) => self.handle_promise_prepare(prom, m.from),\n   269\t                (Role::Leader, Phase::Accept) => self.handle_promise_accept(prom, m.from),\n   270\t                _ => {}\n   271\t            },\n   272\t            PaxosMsg::AcceptSync(acc_sync) => self.handle_acceptsync(acc_sync, m.from),\n   273\t            PaxosMsg::AcceptDecide(acc) => self.handle_acceptdecide(acc),\n   274\t            PaxosMsg::NotAccepted(not_acc) => self.handle_notaccepted(not_acc, m.from),\n   275\t            PaxosMsg::Accepted(accepted) => self.handle_accepted(accepted, m.from),\n   276\t            PaxosMsg::Decide(d) => self.handle_decide(d),\n   277\t            PaxosMsg::ProposalForward(proposals) => self.handle_forwarded_proposal(proposals),\n   278\t            PaxosMsg::Compaction(c) => self.handle_compaction(c),\n   279\t            PaxosMsg::AcceptStopSign(acc_ss) => self.handle_accept_stopsign(acc_ss),\n   280\t            PaxosMsg::ForwardStopSign(f_ss) => self.handle_forwarded_stopsign(f_ss),\n   281\t        }\n   282\t    }\n   283\t\n   284\t    /// Returns whether this Sequence Paxos has been reconfigured\n   285\t    pub(crate) fn is_reconfigured(&self) -> Option<StopSign> {\n   286\t        match self.internal_storage.get_stopsign() {\n   287\t            Some(ss) if self.internal_storage.stopsign_is_decided() => Some(ss),\n   288\t            _ => None,\n   289\t        }\n   290\t    }\n   291\t\n   292\t    /// Returns whether this Sequence Paxos instance is stopped, i.e. if it has been reconfigured.\n   293\t    fn accepted_reconfiguration(&self) -> bool {\n   294\t        self.internal_storage.get_stopsign().is_some()\n   295\t    }\n   296\t\n   297\t    /// Append an entry to the replicated log.\n   298\t    pub(crate) fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   299\t        if self.accepted_reconfiguration() {\n   300\t            Err(ProposeErr::PendingReconfigEntry(entry))\n   301\t        } else {\n   302\t            self.propose_entry(entry);\n   303\t            Ok(())\n   304\t        }\n   305\t    }\n   306\t\n   307\t    /// Propose a reconfiguration. Returns an error if already stopped or `new_config` is invalid.\n   308\t    /// `new_config` defines the cluster-wide configuration settings for the next cluster.\n   309\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   310\t    pub(crate) fn reconfigure(\n   311\t        &mut self,\n   312\t        new_config: ClusterConfig,\n   313\t        metadata: Option<Vec<u8>>,\n   314\t    ) -> Result<(), ProposeErr<T>> {\n   315\t        if self.accepted_reconfiguration() {\n   316\t            return Err(ProposeErr::PendingReconfigConfig(new_config, metadata));\n   317\t        }\n   318\t        #[cfg(feature = \"logging\")]\n   319\t        info!(\n   320\t            self.logger,\n   321\t            \"Accepting reconfiguration {:?}\", new_config.nodes\n   322\t        );\n   323\t        let ss = StopSign::with(new_config, metadata);\n   324\t        match self.state {\n   325\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n   326\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n   327\t            _ => self.forward_stopsign(ss),\n   328\t        }\n   329\t        Ok(())\n   330\t    }\n   331\t\n   332\t    fn get_current_leader(&self) -> NodeId {\n   333\t        self.get_promise().pid\n   334\t    }\n   335\t\n   336\t    /// Returns this node's own pid.\n   337\t    pub(crate) fn get_pid(&self) -> NodeId {\n   338\t        self.pid\n   339\t    }\n   340\t\n   341\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   342\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   343\t    pub(crate) fn reconnected(&mut self, pid: NodeId) {\n   344\t        if pid == self.pid {\n   345\t            return;\n   346\t        } else if pid == self.get_current_leader() {\n   347\t            self.state = (Role::Follower, Phase::Recover);\n   348\t        }\n   349\t        let prepreq = PrepareReq {\n   350\t            n: self.get_promise(),\n   351\t        };\n   352\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   353\t            from: self.pid,\n   354\t            to: pid,\n   355\t            msg: PaxosMsg::PrepareReq(prepreq),\n   356\t        }));\n   357\t    }\n   358\t\n   359\t    fn propose_entry(&mut self, entry: T) {\n   360\t        match self.state {\n   361\t            (Role::Leader, Phase::Prepare) => self.buffered_proposals.push(entry),\n   362\t            (Role::Leader, Phase::Accept) => self.accept_entry_leader(entry),\n   363\t            _ => self.forward_proposals(vec![entry]),\n   364\t        }\n   365\t    }\n   366\t\n   367\t    pub(crate) fn get_leader_state(&self) -> &LeaderState<T> {\n   368\t        &self.leader_state\n   369\t    }\n   370\t\n   371\t    pub(crate) fn forward_proposals(&mut self, mut entries: Vec<T>) {\n   372\t        let leader = self.get_current_leader();\n   373\t        if leader > 0 && self.pid != leader {\n   374\t            let pf = PaxosMsg::ProposalForward(entries);\n   375\t            let msg = Message::SequencePaxos(PaxosMessage {\n   376\t                from: self.pid,\n   377\t                to: leader,\n   378\t                msg: pf,\n   379\t            });\n   380\t            self.outgoing.push(msg);\n   381\t        } else {\n   382\t            self.buffered_proposals.append(&mut entries);\n   383\t        }\n   384\t    }\n   385\t\n   386\t    pub(crate) fn forward_stopsign(&mut self, ss: StopSign) {\n   387\t        let leader = self.get_current_leader();\n   388\t        if leader > 0 && self.pid != leader {\n   389\t            #[cfg(feature = \"logging\")]\n   390\t            trace!(self.logger, \"Forwarding StopSign to Leader {:?}\", leader);\n   391\t            let fs = PaxosMsg::ForwardStopSign(ss);\n   392\t            let msg = Message::SequencePaxos(PaxosMessage {\n   393\t                from: self.pid,\n   394\t                to: leader,\n   395\t                msg: fs,\n   396\t            });\n   397\t            self.outgoing.push(msg);\n   398\t        } else if self.buffered_stopsign.as_mut().is_none() {\n   399\t            self.buffered_stopsign = Some(ss);\n   400\t        }\n   401\t    }\n   402\t    /// Returns `LogSync`, a struct to help other servers synchronize their log to correspond to the\n   403\t    /// current state of our own log. The `common_prefix_idx` marks where in the log the other server\n   404\t    /// needs to be sync from.\n   405\t    fn create_log_sync(\n   406\t        &self,\n   407\t        common_prefix_idx: usize,\n   408\t        other_logs_decided_idx: usize,\n   409\t    ) -> LogSync<T> {\n   410\t        let decided_idx = self.internal_storage.get_decided_idx();\n   411\t        let (decided_snapshot, suffix, sync_idx) =\n   412\t            if T::Snapshot::use_snapshots() && decided_idx > common_prefix_idx {\n   413\t                // Note: We snapshot from the other log's decided index and not the common prefix because\n   414\t                // snapshots currently only work on decided entries.\n   415\t                let (delta_snapshot, compacted_idx) = self\n   416\t                    .internal_storage\n   417\t                    .create_diff_snapshot(other_logs_decided_idx)\n   418\t                    .expect(READ_ERROR_MSG);\n   419\t                let suffix = self\n   420\t                    .internal_storage\n   421\t                    .get_suffix(decided_idx)\n   422\t                    .expect(READ_ERROR_MSG);\n   423\t                (delta_snapshot, suffix, compacted_idx)\n   424\t            } else {\n   425\t                let suffix = self\n   426\t                    .internal_storage\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n   446\t}\n   447\t\n   448\t#[derive(PartialEq, Debug)]\n   449\tpub(crate) enum Role {\n   450\t    Follower,\n   451\t    Leader,\n   452\t}\n   453\t\n   454\t/// Configuration for `SequencePaxos`.\n   455\t/// # Fields\n   456\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   457\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   458\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   459\t/// * `buffer_size`: The buffer size for outgoing messages.\n   460\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   461\t/// * `logger_file_path`: The path where the default logger logs events.\n   462\t#[derive(Clone, Debug)]\n   463\tpub(crate) struct SequencePaxosConfig {\n   464\t    pid: NodeId,\n   465\t    peers: Vec<NodeId>,\n   466\t    buffer_size: usize,\n   467\t    pub(crate) batch_size: usize,\n   468\t    flexible_quorum: Option<FlexibleQuorum>,\n   469\t    #[cfg(feature = \"logging\")]\n   470\t    logger_file_path: Option<String>,\n   471\t    #[cfg(feature = \"logging\")]\n   472\t    custom_logger: Option<Logger>,\n   473\t}\n   474\t\n   475\timpl From<OmniPaxosConfig> for SequencePaxosConfig {\n   476\t    fn from(config: OmniPaxosConfig) -> Self {\n   477\t        let pid = config.server_config.pid;\n   478\t        let peers = config\n   479\t            .cluster_config\n   480\t            .nodes\n   481\t            .into_iter()\n   482\t            .filter(|x| *x != pid)\n   483\t            .collect();\n   484\t        SequencePaxosConfig {\n   485\t            pid,\n   486\t            peers,\n   487\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   488\t            buffer_size: config.server_config.buffer_size,\n   489\t            batch_size: config.server_config.batch_size,\n   490\t            #[cfg(feature = \"logging\")]\n   491\t            logger_file_path: config.server_config.logger_file_path,\n   492\t            #[cfg(feature = \"logging\")]\n   493\t            custom_logger: config.server_config.custom_logger,\n   494\t        }\n   495\t    }\n   496\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/ballot_leader_election.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/ballot_leader_election.rs'","aggregated_output":"     1\tuse std::cmp::Ordering;\n     2\t\n     3\t/// Ballot Leader Election algorithm for electing new leaders\n     4\tuse crate::{\n     5\t    sequence_paxos::{Phase, Role},\n     6\t    util::{defaults::*, ConfigurationId, FlexibleQuorum, Quorum},\n     7\t};\n     8\t\n     9\t#[cfg(feature = \"logging\")]\n    10\tuse crate::utils::logger::create_logger;\n    11\tuse crate::{\n    12\t    messages::ballot_leader_election::{\n    13\t        BLEMessage, HeartbeatMsg, HeartbeatReply, HeartbeatRequest,\n    14\t    },\n    15\t    util::NodeId,\n    16\t    OmniPaxosConfig,\n    17\t};\n    18\t#[cfg(feature = \"serde\")]\n    19\tuse serde::{Deserialize, Serialize};\n    20\t#[cfg(feature = \"logging\")]\n    21\tuse slog::{info, trace, Logger};\n    22\t\n    23\t/// Used to define a Sequence Paxos epoch\n    24\t#[derive(Clone, Copy, Eq, Debug, Default, PartialEq)]\n    25\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    26\tpub struct Ballot {\n    27\t    /// The identifier for the configuration that the replica with this ballot is part of.\n    28\t    pub config_id: ConfigurationId,\n    29\t    /// Ballot number\n    30\t    pub n: u32,\n    31\t    /// Custom priority parameter\n    32\t    pub priority: u32,\n    33\t    /// The pid of the process\n    34\t    pub pid: NodeId,\n    35\t}\n    36\t\n    37\timpl Ballot {\n    38\t    /// Creates a new Ballot\n    39\t    /// # Arguments\n    40\t    /// * `config_id` - The identifier for the configuration that the replica with this ballot is part of.\n    41\t    /// * `n` - Ballot number.\n    42\t    /// * `pid` -  Used as tiebreaker for total ordering of ballots.\n    43\t    pub fn with(config_id: ConfigurationId, n: u32, priority: u32, pid: NodeId) -> Ballot {\n    44\t        Ballot {\n    45\t            config_id,\n    46\t            n,\n    47\t            priority,\n    48\t            pid,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\timpl Ord for Ballot {\n    54\t    fn cmp(&self, other: &Self) -> Ordering {\n    55\t        (self.n, self.priority, self.pid).cmp(&(other.n, other.priority, other.pid))\n    56\t    }\n    57\t}\n    58\t\n    59\timpl PartialOrd for Ballot {\n    60\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n    61\t        Some(self.cmp(other))\n    62\t    }\n    63\t}\n    64\t\n    65\tconst INITIAL_ROUND: u32 = 1;\n    66\tconst RECOVERY_ROUND: u32 = 0;\n    67\t\n    68\t/// A Ballot Leader Election component. Used in conjunction with OmniPaxos to handle the election of a leader for a cluster of OmniPaxos servers,\n    69\t/// incoming messages and produces outgoing messages that the user has to fetch periodically and send using a network implementation.\n    70\t/// User also has to periodically fetch the decided entries that are guaranteed to be strongly consistent and linearizable, and therefore also safe to be used in the higher level application.\n    71\tpub(crate) struct BallotLeaderElection {\n    72\t    /// The identifier for the configuration that this instance is part of.\n    73\t    configuration_id: ConfigurationId,\n    74\t    /// Process identifier used to uniquely identify this instance.\n    75\t    pid: NodeId,\n    76\t    /// Vector that holds the pids of all the other servers.\n    77\t    peers: Vec<NodeId>,\n    78\t    /// The current round of the heartbeat cycle.\n    79\t    hb_round: u32,\n    80\t    /// The heartbeat replies this instance received during the current round.\n    81\t    heartbeat_replies: Vec<HeartbeatReply>,\n    82\t    /// Vector that holds all the received heartbeats from the previous heartbeat round, including the current node. Only used to display the connectivity of this node in the UI.\n    83\t    /// Represents nodes that are currently alive from the view of the current node.\n    84\t    prev_replies: Vec<HeartbeatReply>,\n    85\t    /// Holds the current ballot of this instance.\n    86\t    current_ballot: Ballot,\n    87\t    /// The current leader of this instance.\n    88\t    leader: Ballot,\n    89\t    /// A happy node either sees that it is, is connected to, or sees evidence of a potential leader\n    90\t    /// for the cluster. If a node is unhappy then it is seeking a new leader.\n    91\t    happy: bool,\n    92\t    /// The number of replicas inside the cluster whose heartbeats are needed to become and remain the leader.\n    93\t    quorum: Quorum,\n    94\t    /// Vector which holds all the outgoing messages of the BLE instance.\n    95\t    outgoing: Vec<BLEMessage>,\n    96\t    /// Logger used to output the status of the component.\n    97\t    #[cfg(feature = \"logging\")]\n    98\t    logger: Logger,\n    99\t}\n   100\t\n   101\timpl BallotLeaderElection {\n   102\t    /// Construct a new BallotLeaderElection node\n   103\t    pub(crate) fn with(config: BLEConfig, recovered_leader: Option<Ballot>) -> Self {\n   104\t        let config_id = config.configuration_id;\n   105\t        let pid = config.pid;\n   106\t        let peers = config.peers;\n   107\t        let num_nodes = &peers.len() + 1;\n   108\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n   109\t        let mut initial_ballot = Ballot::with(config_id, INITIAL_ROUND, config.priority, pid);\n   110\t        let initial_leader = match recovered_leader {\n   111\t            Some(b) if b != Ballot::default() => {\n   112\t                // Prevents a recovered server from retaining BLE leadership with the same ballot.\n   113\t                initial_ballot.n = RECOVERY_ROUND;\n   114\t                b\n   115\t            }\n   116\t            _ => initial_ballot,\n   117\t        };\n   118\t        let mut ble = BallotLeaderElection {\n   119\t            configuration_id: config_id,\n   120\t            pid,\n   121\t            peers,\n   122\t            hb_round: 0,\n   123\t            heartbeat_replies: Vec::with_capacity(num_nodes),\n   124\t            prev_replies: Vec::with_capacity(num_nodes),\n   125\t            current_ballot: initial_ballot,\n   126\t            leader: initial_leader,\n   127\t            happy: true,\n   128\t            quorum,\n   129\t            outgoing: Vec::with_capacity(config.buffer_size),\n   130\t            #[cfg(feature = \"logging\")]\n   131\t            logger: {\n   132\t                if let Some(logger) = config.custom_logger {\n   133\t                    logger\n   134\t                } else {\n   135\t                    let s = config\n   136\t                        .logger_file_path\n   137\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   138\t                    create_logger(s.as_str())\n   139\t                }\n   140\t            },\n   141\t        };\n   142\t        #[cfg(feature = \"logging\")]\n   143\t        {\n   144\t            info!(\n   145\t                ble.logger,\n   146\t                \"Ballot Leader Election component pid: {} created!\", pid\n   147\t            );\n   148\t        }\n   149\t        ble.new_hb_round();\n   150\t        ble\n   151\t    }\n   152\t\n   153\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   154\t    /// priority triggers a leader re-election.\n   155\t    pub(crate) fn set_priority(&mut self, p: u32) {\n   156\t        self.current_ballot.priority = p;\n   157\t    }\n   158\t\n   159\t    /// Returns reference to outgoing messages\n   160\t    pub(crate) fn outgoing_mut(&mut self) -> &mut Vec<BLEMessage> {\n   161\t        &mut self.outgoing\n   162\t    }\n   163\t\n   164\t    /// Handle an incoming message.\n   165\t    /// # Arguments\n   166\t    /// * `m` - the message to be handled.\n   167\t    pub(crate) fn handle(&mut self, m: BLEMessage) {\n   168\t        match m.msg {\n   169\t            HeartbeatMsg::Request(req) => self.handle_request(m.from, req),\n   170\t            HeartbeatMsg::Reply(rep) => self.handle_reply(rep),\n   171\t        }\n   172\t    }\n   173\t\n   174\t    /// Initiates a new heartbeat round.\n   175\t    pub(crate) fn new_hb_round(&mut self) {\n   176\t        self.prev_replies = std::mem::take(&mut self.heartbeat_replies);\n   177\t        self.hb_round += 1;\n   178\t        #[cfg(feature = \"logging\")]\n   179\t        trace!(\n   180\t            self.logger,\n   181\t            \"Initiate new heartbeat round: {}\",\n   182\t            self.hb_round\n   183\t        );\n   184\t        for peer in &self.peers {\n   185\t            let hb_request = HeartbeatRequest {\n   186\t                round: self.hb_round,\n   187\t            };\n   188\t            self.outgoing.push(BLEMessage {\n   189\t                from: self.pid,\n   190\t                to: *peer,\n   191\t                msg: HeartbeatMsg::Request(hb_request),\n   192\t            });\n   193\t        }\n   194\t    }\n   195\t\n   196\t    /// End of a heartbeat round. Returns current leader and election status.\n   197\t    pub(crate) fn hb_timeout(\n   198\t        &mut self,\n   199\t        seq_paxos_state: &(Role, Phase),\n   200\t        seq_paxos_promise: Ballot,\n   201\t    ) -> Option<Ballot> {\n   202\t        self.update_leader();\n   203\t        self.update_happiness(seq_paxos_state);\n   204\t        self.check_takeover();\n   205\t        self.new_hb_round();\n   206\t        if seq_paxos_promise > self.leader {\n   207\t            // Sync leader with Paxos promise in case ballot didn't make it to BLE followers\n   208\t            // or become_leader() was called.\n   209\t            self.leader = seq_paxos_promise;\n   210\t            if seq_paxos_promise.pid == self.pid {\n   211\t                self.current_ballot = seq_paxos_promise;\n   212\t            }\n   213\t            self.happy = true;\n   214\t        }\n   215\t        if self.leader == self.current_ballot {\n   216\t            Some(self.current_ballot)\n   217\t        } else {\n   218\t            None\n   219\t        }\n   220\t    }\n   221\t\n   222\t    fn update_leader(&mut self) {\n   223\t        let max_reply_ballot = self.heartbeat_replies.iter().map(|r| r.ballot).max();\n   224\t        if let Some(max) = max_reply_ballot {\n   225\t            if max > self.leader {\n   226\t                self.leader = max;\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n   232\t        self.happy = if self.leader == self.current_ballot {\n   233\t            let potential_followers = self\n   234\t                .heartbeat_replies\n   235\t                .iter()\n   236\t                .filter(|hb_reply| hb_reply.leader <= self.current_ballot)\n   237\t                .count();\n   238\t            let can_form_quorum = match seq_paxos_state {\n   239\t                (Role::Leader, Phase::Accept) => {\n   240\t                    self.quorum.is_accept_quorum(potential_followers + 1)\n   241\t                }\n   242\t                _ => self.quorum.is_prepare_quorum(potential_followers + 1),\n   243\t            };\n   244\t            if can_form_quorum {\n   245\t                true\n   246\t            } else {\n   247\t                let see_larger_happy_leader = self\n   248\t                    .heartbeat_replies\n   249\t                    .iter()\n   250\t                    .any(|r| r.leader > self.current_ballot && r.happy);\n   251\t                see_larger_happy_leader\n   252\t            }\n   253\t        } else {\n   254\t            self.heartbeat_replies\n   255\t                .iter()\n   256\t                .any(|r| r.ballot == self.leader && r.happy)\n   257\t        };\n   258\t    }\n   259\t\n   260\t    fn check_takeover(&mut self) {\n   261\t        if !self.happy {\n   262\t            let all_neighbors_unhappy = self.heartbeat_replies.iter().all(|r| !r.happy);\n   263\t            let im_quorum_connected = self\n   264\t                .quorum\n   265\t                .is_prepare_quorum(self.heartbeat_replies.len() + 1);\n   266\t            if all_neighbors_unhappy && im_quorum_connected {\n   267\t                // We increment past our leader instead of max of unhappy ballots because we\n   268\t                // assume we have already checked leader for this round so they should be equal\n   269\t                self.current_ballot.n = self.leader.n + 1;\n   270\t                self.leader = self.current_ballot;\n   271\t                self.happy = true;\n   272\t            }\n   273\t        }\n   274\t    }\n   275\t\n   276\t    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n   277\t        let hb_reply = HeartbeatReply {\n   278\t            round: req.round,\n   279\t            ballot: self.current_ballot,\n   280\t            leader: self.leader,\n   281\t            happy: self.happy,\n   282\t        };\n   283\t        self.outgoing.push(BLEMessage {\n   284\t            from: self.pid,\n   285\t            to: from,\n   286\t            msg: HeartbeatMsg::Reply(hb_reply),\n   287\t        });\n   288\t    }\n   289\t\n   290\t    fn handle_reply(&mut self, rep: HeartbeatReply) {\n   291\t        if rep.round == self.hb_round && rep.ballot.config_id == self.configuration_id {\n   292\t            self.heartbeat_replies.push(rep);\n   293\t        }\n   294\t    }\n   295\t\n   296\t    pub(crate) fn get_current_ballot(&self) -> Ballot {\n   297\t        self.current_ballot\n   298\t    }\n   299\t\n   300\t    pub(crate) fn get_ballots(&self) -> Vec<HeartbeatReply> {\n   301\t        self.prev_replies.clone()\n   302\t    }\n   303\t}\n   304\t\n   305\t/// Configuration for `BallotLeaderElection`.\n   306\t/// # Fields\n   307\t/// * `configuration_id`: The identifier for the configuration that this node is part of.\n   308\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   309\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   310\t/// * `priority`: Set custom priority for this node to be elected as the leader.\n   311\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   312\t/// * `buffer_size`: The buffer size for outgoing messages.\n   313\t/// * `logger_file_path`: The path where the default logger logs events.\n   314\t#[derive(Clone, Debug)]\n   315\tpub(crate) struct BLEConfig {\n   316\t    configuration_id: ConfigurationId,\n   317\t    pid: NodeId,\n   318\t    peers: Vec<NodeId>,\n   319\t    priority: u32,\n   320\t    flexible_quorum: Option<FlexibleQuorum>,\n   321\t    buffer_size: usize,\n   322\t    #[cfg(feature = \"logging\")]\n   323\t    logger_file_path: Option<String>,\n   324\t    #[cfg(feature = \"logging\")]\n   325\t    custom_logger: Option<Logger>,\n   326\t}\n   327\t\n   328\timpl From<OmniPaxosConfig> for BLEConfig {\n   329\t    fn from(config: OmniPaxosConfig) -> Self {\n   330\t        let pid = config.server_config.pid;\n   331\t        let peers = config\n   332\t            .cluster_config\n   333\t            .nodes\n   334\t            .into_iter()\n   335\t            .filter(|x| *x != pid)\n   336\t            .collect();\n   337\t\n   338\t        Self {\n   339\t            configuration_id: config.cluster_config.configuration_id,\n   340\t            pid,\n   341\t            peers,\n   342\t            priority: config.server_config.leader_priority,\n   343\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   344\t            buffer_size: BLE_BUFFER_SIZE,\n   345\t            #[cfg(feature = \"logging\")]\n   346\t            logger_file_path: config.server_config.logger_file_path,\n   347\t            #[cfg(feature = \"logging\")]\n   348\t            custom_logger: config.server_config.custom_logger,\n   349\t        }\n   350\t    }\n   351\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/sequence_paxos/leader.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/sequence_paxos/leader.rs'","aggregated_output":"     1\tuse super::super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    util::{LeaderState, PromiseMetaData},\n     4\t};\n     5\tuse crate::util::{AcceptedMetaData, WRITE_ERROR_MSG};\n     6\t\n     7\tuse super::*;\n     8\t\n     9\timpl<T, B> SequencePaxos<T, B>\n    10\twhere\n    11\t    T: Entry,\n    12\t    B: Storage<T>,\n    13\t{\n    14\t    /// Handle a new leader. Should be called when the leader election has elected a new leader with the ballot `n`\n    15\t    /*** Leader ***/\n    16\t    pub(crate) fn handle_leader(&mut self, n: Ballot) {\n    17\t        if n <= self.leader_state.n_leader || n <= self.internal_storage.get_promise() {\n    18\t            return;\n    19\t        }\n    20\t        #[cfg(feature = \"logging\")]\n    21\t        debug!(self.logger, \"Newly elected leader: {:?}\", n);\n    22\t        if self.pid == n.pid {\n    23\t            self.leader_state =\n    24\t                LeaderState::with(n, self.leader_state.max_pid, self.leader_state.quorum);\n    25\t            // Flush any pending writes\n    26\t            // Don't have to handle flushed entries here because we will sync with followers\n    27\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    28\t            self.internal_storage.set_promise(n).expect(WRITE_ERROR_MSG);\n    29\t            /* insert my promise */\n    30\t            let na = self.internal_storage.get_accepted_round();\n    31\t            let decided_idx = self.get_decided_idx();\n    32\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    33\t            let my_promise = Promise {\n    34\t                n,\n    35\t                n_accepted: na,\n    36\t                decided_idx,\n    37\t                accepted_idx,\n    38\t                log_sync: None,\n    39\t            };\n    40\t            self.leader_state.set_promise(my_promise, self.pid, true);\n    41\t            /* initialise longest chosen sequence and update state */\n    42\t            self.state = (Role::Leader, Phase::Prepare);\n    43\t            let prep = Prepare {\n    44\t                n,\n    45\t                decided_idx,\n    46\t                n_accepted: na,\n    47\t                accepted_idx,\n    48\t            };\n    49\t            /* send prepare */\n    50\t            for pid in &self.peers {\n    51\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    52\t                    from: self.pid,\n    53\t                    to: *pid,\n    54\t                    msg: PaxosMsg::Prepare(prep),\n    55\t                }));\n    56\t            }\n    57\t        } else {\n    58\t            self.become_follower();\n    59\t        }\n    60\t    }\n    61\t\n    62\t    pub(crate) fn become_follower(&mut self) {\n    63\t        self.state.0 = Role::Follower;\n    64\t    }\n    65\t\n    66\t    pub(crate) fn handle_preparereq(&mut self, prepreq: PrepareReq, from: NodeId) {\n    67\t        #[cfg(feature = \"logging\")]\n    68\t        debug!(self.logger, \"Incoming message PrepareReq from {}\", from);\n    69\t        if self.state.0 == Role::Leader && prepreq.n <= self.leader_state.n_leader {\n    70\t            self.leader_state.reset_promise(from);\n    71\t            self.leader_state.set_latest_accept_meta(from, None);\n    72\t            self.send_prepare(from);\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub(crate) fn handle_forwarded_proposal(&mut self, mut entries: Vec<T>) {\n    77\t        if !self.accepted_reconfiguration() {\n    78\t            match self.state {\n    79\t                (Role::Leader, Phase::Prepare) => self.buffered_proposals.append(&mut entries),\n    80\t                (Role::Leader, Phase::Accept) => self.accept_entries_leader(entries),\n    81\t                _ => self.forward_proposals(entries),\n    82\t            }\n    83\t        }\n    84\t    }\n    85\t\n    86\t    pub(crate) fn handle_forwarded_stopsign(&mut self, ss: StopSign) {\n    87\t        if self.accepted_reconfiguration() {\n    88\t            return;\n    89\t        }\n    90\t        match self.state {\n    91\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n    92\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n    93\t            _ => self.forward_stopsign(ss),\n    94\t        }\n    95\t    }\n    96\t\n    97\t    pub(crate) fn send_prepare(&mut self, to: NodeId) {\n    98\t        let prep = Prepare {\n    99\t            n: self.leader_state.n_leader,\n   100\t            decided_idx: self.internal_storage.get_decided_idx(),\n   101\t            n_accepted: self.internal_storage.get_accepted_round(),\n   102\t            accepted_idx: self.internal_storage.get_accepted_idx(),\n   103\t        };\n   104\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   105\t            from: self.pid,\n   106\t            to,\n   107\t            msg: PaxosMsg::Prepare(prep),\n   108\t        }));\n   109\t    }\n   110\t\n   111\t    pub(crate) fn accept_entry_leader(&mut self, entry: T) {\n   112\t        let accepted_metadata = self\n   113\t            .internal_storage\n   114\t            .append_entry_with_batching(entry)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        if let Some(metadata) = accepted_metadata {\n   117\t            self.leader_state\n   118\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   119\t            self.send_acceptdecide(metadata);\n   120\t        }\n   121\t    }\n   122\t\n   123\t    pub(crate) fn accept_entries_leader(&mut self, entries: Vec<T>) {\n   124\t        let accepted_metadata = self\n   125\t            .internal_storage\n   126\t            .append_entries_with_batching(entries)\n   127\t            .expect(WRITE_ERROR_MSG);\n   128\t        if let Some(metadata) = accepted_metadata {\n   129\t            self.leader_state\n   130\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   131\t            self.send_acceptdecide(metadata);\n   132\t        }\n   133\t    }\n   134\t\n   135\t    pub(crate) fn accept_stopsign_leader(&mut self, ss: StopSign) {\n   136\t        let accepted_metadata = self\n   137\t            .internal_storage\n   138\t            .append_stopsign(ss.clone())\n   139\t            .expect(WRITE_ERROR_MSG);\n   140\t        if let Some(metadata) = accepted_metadata {\n   141\t            self.send_acceptdecide(metadata);\n   142\t        }\n   143\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   144\t        self.leader_state.set_accepted_idx(self.pid, accepted_idx);\n   145\t        for pid in self.leader_state.get_promised_followers() {\n   146\t            self.send_accept_stopsign(pid, ss.clone(), false);\n   147\t        }\n   148\t    }\n   149\t\n   150\t    fn send_accsync(&mut self, to: NodeId) {\n   151\t        let current_n = self.leader_state.n_leader;\n   152\t        let PromiseMetaData {\n   153\t            n_accepted: prev_round_max_promise_n,\n   154\t            accepted_idx: prev_round_max_accepted_idx,\n   155\t            ..\n   156\t        } = &self.leader_state.get_max_promise_meta();\n   157\t        let PromiseMetaData {\n   158\t            n_accepted: followers_promise_n,\n   159\t            accepted_idx: followers_accepted_idx,\n   160\t            pid,\n   161\t            ..\n   162\t        } = self.leader_state.get_promise_meta(to);\n   163\t        let followers_decided_idx = self\n   164\t            .leader_state\n   165\t            .get_decided_idx(*pid)\n   166\t            .expect(\"Received PromiseMetaData but not found in ld\");\n   167\t        // Follower can have valid accepted entries depending on which leader they were previously following\n   168\t        let followers_valid_entries_idx = if *followers_promise_n == current_n {\n   169\t            *followers_accepted_idx\n   170\t        } else if *followers_promise_n == *prev_round_max_promise_n {\n   171\t            *prev_round_max_accepted_idx.min(followers_accepted_idx)\n   172\t        } else {\n   173\t            followers_decided_idx\n   174\t        };\n   175\t        let log_sync = self.create_log_sync(followers_valid_entries_idx, followers_decided_idx);\n   176\t        self.leader_state.increment_seq_num_session(to);\n   177\t        let acc_sync = AcceptSync {\n   178\t            n: current_n,\n   179\t            seq_num: self.leader_state.next_seq_num(to),\n   180\t            decided_idx: self.get_decided_idx(),\n   181\t            log_sync,\n   182\t            #[cfg(feature = \"unicache\")]\n   183\t            unicache: self.internal_storage.get_unicache(),\n   184\t        };\n   185\t        let msg = Message::SequencePaxos(PaxosMessage {\n   186\t            from: self.pid,\n   187\t            to,\n   188\t            msg: PaxosMsg::AcceptSync(acc_sync),\n   189\t        });\n   190\t        self.outgoing.push(msg);\n   191\t    }\n   192\t\n   193\t    fn send_acceptdecide(&mut self, accepted: AcceptedMetaData<T>) {\n   194\t        let decided_idx = self.internal_storage.get_decided_idx();\n   195\t        for pid in self.leader_state.get_promised_followers() {\n   196\t            let latest_accdec = self.get_latest_accdec_message(pid);\n   197\t            match latest_accdec {\n   198\t                // Modify existing AcceptDecide message to follower\n   199\t                Some(accdec) => {\n   200\t                    accdec.entries.extend(accepted.entries.iter().cloned());\n   201\t                    accdec.decided_idx = decided_idx;\n   202\t                }\n   203\t                // Add new AcceptDecide message to follower\n   204\t                None => {\n   205\t                    self.leader_state\n   206\t                        .set_latest_accept_meta(pid, Some(self.outgoing.len()));\n   207\t                    let acc = AcceptDecide {\n   208\t                        n: self.leader_state.n_leader,\n   209\t                        seq_num: self.leader_state.next_seq_num(pid),\n   210\t                        decided_idx,\n   211\t                        entries: accepted.entries.clone(),\n   212\t                    };\n   213\t                    self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   214\t                        from: self.pid,\n   215\t                        to: pid,\n   216\t                        msg: PaxosMsg::AcceptDecide(acc),\n   217\t                    }));\n   218\t                }\n   219\t            }\n   220\t        }\n   221\t    }\n   222\t\n   223\t    fn send_accept_stopsign(&mut self, to: NodeId, ss: StopSign, resend: bool) {\n   224\t        let seq_num = match resend {\n   225\t            true => self.leader_state.get_seq_num(to),\n   226\t            false => self.leader_state.next_seq_num(to),\n   227\t        };\n   228\t        let acc_ss = PaxosMsg::AcceptStopSign(AcceptStopSign {\n   229\t            seq_num,\n   230\t            n: self.leader_state.n_leader,\n   231\t            ss,\n   232\t        });\n   233\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   234\t            from: self.pid,\n   235\t            to,\n   236\t            msg: acc_ss,\n   237\t        }));\n   238\t    }\n   239\t\n   240\t    pub(crate) fn send_decide(&mut self, to: NodeId, decided_idx: usize, resend: bool) {\n   241\t        let seq_num = match resend {\n   242\t            true => self.leader_state.get_seq_num(to),\n   243\t            false => self.leader_state.next_seq_num(to),\n   244\t        };\n   245\t        let d = Decide {\n   246\t            n: self.leader_state.n_leader,\n   247\t            seq_num,\n   248\t            decided_idx,\n   249\t        };\n   250\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   251\t            from: self.pid,\n   252\t            to,\n   253\t            msg: PaxosMsg::Decide(d),\n   254\t        }));\n   255\t    }\n   256\t\n   257\t    fn handle_majority_promises(&mut self) {\n   258\t        let max_promise_sync = self.leader_state.take_max_promise_sync();\n   259\t        let decided_idx = self.leader_state.get_max_decided_idx();\n   260\t        let mut new_accepted_idx = self\n   261\t            .internal_storage\n   262\t            .sync_log(self.leader_state.n_leader, decided_idx, max_promise_sync)\n   263\t            .expect(WRITE_ERROR_MSG);\n   264\t        if !self.accepted_reconfiguration() {\n   265\t            if !self.buffered_proposals.is_empty() {\n   266\t                let entries = std::mem::take(&mut self.buffered_proposals);\n   267\t                new_accepted_idx = self\n   268\t                    .internal_storage\n   269\t                    .append_entries_without_batching(entries)\n   270\t                    .expect(WRITE_ERROR_MSG);\n   271\t            }\n   272\t            if let Some(ss) = self.buffered_stopsign.take() {\n   273\t                self.internal_storage\n   274\t                    .append_stopsign(ss)\n   275\t                    .expect(WRITE_ERROR_MSG);\n   276\t                new_accepted_idx = self.internal_storage.get_accepted_idx();\n   277\t            }\n   278\t        }\n   279\t        self.state = (Role::Leader, Phase::Accept);\n   280\t        self.leader_state\n   281\t            .set_accepted_idx(self.pid, new_accepted_idx);\n   282\t        for pid in self.leader_state.get_promised_followers() {\n   283\t            self.send_accsync(pid);\n   284\t        }\n   285\t    }\n   286\t\n   287\t    pub(crate) fn handle_promise_prepare(&mut self, prom: Promise<T>, from: NodeId) {\n   288\t        #[cfg(feature = \"logging\")]\n   289\t        debug!(\n   290\t            self.logger,\n   291\t            \"Handling promise from {} in Prepare phase\", from\n   292\t        );\n   293\t        if prom.n == self.leader_state.n_leader {\n   294\t            let received_majority = self.leader_state.set_promise(prom, from, true);\n   295\t            if received_majority {\n   296\t                self.handle_majority_promises();\n   297\t            }\n   298\t        }\n   299\t    }\n   300\t\n   301\t    pub(crate) fn handle_promise_accept(&mut self, prom: Promise<T>, from: NodeId) {\n   302\t        #[cfg(feature = \"logging\")]\n   303\t        {\n   304\t            let (r, p) = &self.state;\n   305\t            debug!(\n   306\t                self.logger,\n   307\t                \"Self role {:?}, phase {:?}. Incoming message Promise Accept from {}\", r, p, from\n   308\t            );\n   309\t        }\n   310\t        if prom.n == self.leader_state.n_leader {\n   311\t            self.leader_state.set_promise(prom, from, false);\n   312\t            self.send_accsync(from);\n   313\t        }\n   314\t    }\n   315\t\n   316\t    pub(crate) fn handle_accepted(&mut self, accepted: Accepted, from: NodeId) {\n   317\t        #[cfg(feature = \"logging\")]\n   318\t        trace!(\n   319\t            self.logger,\n   320\t            \"Got Accepted from {}, idx: {}, chosen_idx: {}, accepted: {:?}\",\n   321\t            from,\n   322\t            accepted.accepted_idx,\n   323\t            self.internal_storage.get_decided_idx(),\n   324\t            self.leader_state.accepted_indexes\n   325\t        );\n   326\t        if accepted.n == self.leader_state.n_leader && self.state == (Role::Leader, Phase::Accept) {\n   327\t            self.leader_state\n   328\t                .set_accepted_idx(from, accepted.accepted_idx);\n   329\t            if accepted.accepted_idx > self.internal_storage.get_decided_idx()\n   330\t                && self.leader_state.is_chosen(accepted.accepted_idx)\n   331\t            {\n   332\t                let decided_idx = accepted.accepted_idx;\n   333\t                self.internal_storage\n   334\t                    .set_decided_idx(decided_idx)\n   335\t                    .expect(WRITE_ERROR_MSG);\n   336\t                for pid in self.leader_state.get_promised_followers() {\n   337\t                    let latest_accdec = self.get_latest_accdec_message(pid);\n   338\t                    match latest_accdec {\n   339\t                        Some(accdec) => accdec.decided_idx = decided_idx,\n   340\t                        None => self.send_decide(pid, decided_idx, false),\n   341\t                    }\n   342\t                }\n   343\t            }\n   344\t        }\n   345\t    }\n   346\t\n   347\t    fn get_latest_accdec_message(&mut self, to: NodeId) -> Option<&mut AcceptDecide<T>> {\n   348\t        if let Some((bal, outgoing_idx)) = self.leader_state.get_latest_accept_meta(to) {\n   349\t            if bal == self.leader_state.n_leader {\n   350\t                if let Message::SequencePaxos(PaxosMessage {\n   351\t                    msg: PaxosMsg::AcceptDecide(accdec),\n   352\t                    ..\n   353\t                }) = self.outgoing.get_mut(outgoing_idx).unwrap()\n   354\t                {\n   355\t                    return Some(accdec);\n   356\t                } else {\n   357\t                    #[cfg(feature = \"logging\")]\n   358\t                    debug!(self.logger, \"Cached idx is not an AcceptedDecide!\");\n   359\t                }\n   360\t            }\n   361\t        }\n   362\t        None\n   363\t    }\n   364\t\n   365\t    pub(crate) fn handle_notaccepted(&mut self, not_acc: NotAccepted, from: NodeId) {\n   366\t        if self.state.0 == Role::Leader && self.leader_state.n_leader < not_acc.n {\n   367\t            self.leader_state.lost_promise(from);\n   368\t        }\n   369\t    }\n   370\t\n   371\t    pub(crate) fn resend_messages_leader(&mut self) {\n   372\t        match self.state.1 {\n   373\t            Phase::Prepare => {\n   374\t                // Resend Prepare\n   375\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   376\t                for peer in preparable_peers {\n   377\t                    self.send_prepare(peer);\n   378\t                }\n   379\t            }\n   380\t            Phase::Accept => {\n   381\t                // Resend AcceptStopSign or StopSign's decide\n   382\t                if let Some(ss) = self.internal_storage.get_stopsign() {\n   383\t                    let decided_idx = self.internal_storage.get_decided_idx();\n   384\t                    for follower in self.leader_state.get_promised_followers() {\n   385\t                        if self.internal_storage.stopsign_is_decided() {\n   386\t                            self.send_decide(follower, decided_idx, true);\n   387\t                        } else if self.leader_state.get_accepted_idx(follower)\n   388\t                            != self.internal_storage.get_accepted_idx()\n   389\t                        {\n   390\t                            self.send_accept_stopsign(follower, ss.clone(), true);\n   391\t                        }\n   392\t                    }\n   393\t                }\n   394\t                // Resend Prepare\n   395\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   396\t                for peer in preparable_peers {\n   397\t                    self.send_prepare(peer);\n   398\t                }\n   399\t            }\n   400\t            Phase::Recover => (),\n   401\t            Phase::None => (),\n   402\t        }\n   403\t    }\n   404\t\n   405\t    pub(crate) fn flush_batch_leader(&mut self) {\n   406\t        let accepted_metadata = self\n   407\t            .internal_storage\n   408\t            .flush_batch_and_get_entries()\n   409\t            .expect(WRITE_ERROR_MSG);\n   410\t        if let Some(metadata) = accepted_metadata {\n   411\t            self.leader_state\n   412\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   413\t            self.send_acceptdecide(metadata);\n   414\t        }\n   415\t    }\n   416\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/sequence_paxos/follower.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/sequence_paxos/follower.rs'","aggregated_output":"     1\tuse super::super::ballot_leader_election::Ballot;\n     2\t\n     3\tuse super::*;\n     4\t\n     5\tuse crate::util::{MessageStatus, WRITE_ERROR_MSG};\n     6\t\n     7\timpl<T, B> SequencePaxos<T, B>\n     8\twhere\n     9\t    T: Entry,\n    10\t    B: Storage<T>,\n    11\t{\n    12\t    /*** Follower ***/\n    13\t    pub(crate) fn handle_prepare(&mut self, prep: Prepare, from: NodeId) {\n    14\t        let old_promise = self.internal_storage.get_promise();\n    15\t        if old_promise < prep.n || (old_promise == prep.n && self.state.1 == Phase::Recover) {\n    16\t            // Flush any pending writes\n    17\t            // Don't have to handle flushed entries here because we will sync with followers\n    18\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    19\t            self.internal_storage\n    20\t                .set_promise(prep.n)\n    21\t                .expect(WRITE_ERROR_MSG);\n    22\t            self.state = (Role::Follower, Phase::Prepare);\n    23\t            self.current_seq_num = SequenceNumber::default();\n    24\t            let na = self.internal_storage.get_accepted_round();\n    25\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    26\t            let log_sync = if na > prep.n_accepted {\n    27\t                // I'm more up to date: send leader what he is missing after his decided index.\n    28\t                Some(self.create_log_sync(prep.decided_idx, prep.decided_idx))\n    29\t            } else if na == prep.n_accepted && accepted_idx > prep.accepted_idx {\n    30\t                // I'm more up to date and in same round: send leader what he is missing after his\n    31\t                // accepted index.\n    32\t                Some(self.create_log_sync(prep.accepted_idx, prep.decided_idx))\n    33\t            } else {\n    34\t                // I'm equally or less up to date\n    35\t                None\n    36\t            };\n    37\t            let promise = Promise {\n    38\t                n: prep.n,\n    39\t                n_accepted: na,\n    40\t                decided_idx: self.internal_storage.get_decided_idx(),\n    41\t                accepted_idx,\n    42\t                log_sync,\n    43\t            };\n    44\t            self.cached_promise_message = Some(promise.clone());\n    45\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    46\t                from: self.pid,\n    47\t                to: from,\n    48\t                msg: PaxosMsg::Promise(promise),\n    49\t            }));\n    50\t        }\n    51\t    }\n    52\t\n    53\t    pub(crate) fn handle_acceptsync(&mut self, accsync: AcceptSync<T>, from: NodeId) {\n    54\t        if self.check_valid_ballot(accsync.n) && self.state == (Role::Follower, Phase::Prepare) {\n    55\t            self.cached_promise_message = None;\n    56\t            let new_accepted_idx = self\n    57\t                .internal_storage\n    58\t                .sync_log(accsync.n, accsync.decided_idx, Some(accsync.log_sync))\n    59\t                .expect(WRITE_ERROR_MSG);\n    60\t            if self.internal_storage.get_stopsign().is_none() {\n    61\t                self.forward_buffered_proposals();\n    62\t            }\n    63\t            let accepted = Accepted {\n    64\t                n: accsync.n,\n    65\t                accepted_idx: new_accepted_idx,\n    66\t            };\n    67\t            self.state = (Role::Follower, Phase::Accept);\n    68\t            self.current_seq_num = accsync.seq_num;\n    69\t            let cached_idx = self.outgoing.len();\n    70\t            self.latest_accepted_meta = Some((accsync.n, cached_idx));\n    71\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    72\t                from: self.pid,\n    73\t                to: from,\n    74\t                msg: PaxosMsg::Accepted(accepted),\n    75\t            }));\n    76\t            #[cfg(feature = \"unicache\")]\n    77\t            self.internal_storage.set_unicache(accsync.unicache);\n    78\t        }\n    79\t    }\n    80\t\n    81\t    fn forward_buffered_proposals(&mut self) {\n    82\t        let proposals = std::mem::take(&mut self.buffered_proposals);\n    83\t        if !proposals.is_empty() {\n    84\t            self.forward_proposals(proposals);\n    85\t        }\n    86\t    }\n    87\t\n    88\t    pub(crate) fn handle_acceptdecide(&mut self, acc_dec: AcceptDecide<T>) {\n    89\t        if self.check_valid_ballot(acc_dec.n)\n    90\t            && self.state == (Role::Follower, Phase::Accept)\n    91\t            && self.handle_sequence_num(acc_dec.seq_num, acc_dec.n.pid) == MessageStatus::Expected\n    92\t        {\n    93\t            #[cfg(not(feature = \"unicache\"))]\n    94\t            let entries = acc_dec.entries;\n    95\t            #[cfg(feature = \"unicache\")]\n    96\t            let entries = self.internal_storage.decode_entries(acc_dec.entries);\n    97\t            let mut new_accepted_idx = self\n    98\t                .internal_storage\n    99\t                .append_entries_and_get_accepted_idx(entries)\n   100\t                .expect(WRITE_ERROR_MSG);\n   101\t            let flushed_after_decide =\n   102\t                self.update_decided_idx_and_get_accepted_idx(acc_dec.decided_idx);\n   103\t            if flushed_after_decide.is_some() {\n   104\t                new_accepted_idx = flushed_after_decide;\n   105\t            }\n   106\t            if let Some(idx) = new_accepted_idx {\n   107\t                self.reply_accepted(acc_dec.n, idx);\n   108\t            }\n   109\t        }\n   110\t    }\n   111\t\n   112\t    pub(crate) fn handle_accept_stopsign(&mut self, acc_ss: AcceptStopSign) {\n   113\t        if self.check_valid_ballot(acc_ss.n)\n   114\t            && self.state == (Role::Follower, Phase::Accept)\n   115\t            && self.handle_sequence_num(acc_ss.seq_num, acc_ss.n.pid) == MessageStatus::Expected\n   116\t        {\n   117\t            // Flush entries before appending stopsign. The accepted index is ignored here as\n   118\t            // it will be updated when appending stopsign.\n   119\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   120\t            let new_accepted_idx = self\n   121\t                .internal_storage\n   122\t                .set_stopsign(Some(acc_ss.ss))\n   123\t                .expect(WRITE_ERROR_MSG);\n   124\t            self.reply_accepted(acc_ss.n, new_accepted_idx);\n   125\t        }\n   126\t    }\n   127\t\n   128\t    pub(crate) fn handle_decide(&mut self, dec: Decide) {\n   129\t        if self.check_valid_ballot(dec.n)\n   130\t            && self.state.1 == Phase::Accept\n   131\t            && self.handle_sequence_num(dec.seq_num, dec.n.pid) == MessageStatus::Expected\n   132\t        {\n   133\t            let new_accepted_idx = self.update_decided_idx_and_get_accepted_idx(dec.decided_idx);\n   134\t            if let Some(idx) = new_accepted_idx {\n   135\t                self.reply_accepted(dec.n, idx);\n   136\t            }\n   137\t        }\n   138\t    }\n   139\t\n   140\t    /// To maintain decided index <= accepted index, batched entries may be flushed.\n   141\t    /// Returns `Some(new_accepted_idx)` if entries are flushed, otherwise `None`.\n   142\t    fn update_decided_idx_and_get_accepted_idx(&mut self, new_decided_idx: usize) -> Option<usize> {\n   143\t        if new_decided_idx <= self.internal_storage.get_decided_idx() {\n   144\t            return None;\n   145\t        }\n   146\t        if new_decided_idx > self.internal_storage.get_accepted_idx() {\n   147\t            let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   148\t            self.internal_storage\n   149\t                .set_decided_idx(new_decided_idx.min(new_accepted_idx))\n   150\t                .expect(WRITE_ERROR_MSG);\n   151\t            Some(new_accepted_idx)\n   152\t        } else {\n   153\t            self.internal_storage\n   154\t                .set_decided_idx(new_decided_idx)\n   155\t                .expect(WRITE_ERROR_MSG);\n   156\t            None\n   157\t        }\n   158\t    }\n   159\t\n   160\t    fn reply_accepted(&mut self, n: Ballot, accepted_idx: usize) {\n   161\t        let latest_accepted = self.get_latest_accepted_message(n);\n   162\t        match latest_accepted {\n   163\t            Some(acc) => acc.accepted_idx = accepted_idx,\n   164\t            None => {\n   165\t                let accepted = Accepted { n, accepted_idx };\n   166\t                let cached_idx = self.outgoing.len();\n   167\t                self.latest_accepted_meta = Some((n, cached_idx));\n   168\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   169\t                    from: self.pid,\n   170\t                    to: n.pid,\n   171\t                    msg: PaxosMsg::Accepted(accepted),\n   172\t                }));\n   173\t            }\n   174\t        }\n   175\t    }\n   176\t\n   177\t    fn get_latest_accepted_message(&mut self, n: Ballot) -> Option<&mut Accepted> {\n   178\t        if let Some((ballot, outgoing_idx)) = &self.latest_accepted_meta {\n   179\t            if *ballot == n {\n   180\t                if let Message::SequencePaxos(PaxosMessage {\n   181\t                    msg: PaxosMsg::Accepted(a),\n   182\t                    ..\n   183\t                }) = self.outgoing.get_mut(*outgoing_idx).unwrap()\n   184\t                {\n   185\t                    return Some(a);\n   186\t                } else {\n   187\t                    #[cfg(feature = \"logging\")]\n   188\t                    debug!(self.logger, \"Cached idx is not an Accepted message!\");\n   189\t                }\n   190\t            }\n   191\t        }\n   192\t        None\n   193\t    }\n   194\t\n   195\t    /// Also returns whether the message's ballot was promised\n   196\t    fn check_valid_ballot(&mut self, message_ballot: Ballot) -> bool {\n   197\t        let my_promise = self.internal_storage.get_promise();\n   198\t        match my_promise.cmp(&message_ballot) {\n   199\t            std::cmp::Ordering::Equal => true,\n   200\t            std::cmp::Ordering::Greater => {\n   201\t                let not_acc = NotAccepted { n: my_promise };\n   202\t                #[cfg(feature = \"logging\")]\n   203\t                trace!(\n   204\t                    self.logger,\n   205\t                    \"NotAccepted. My promise: {:?}, theirs: {:?}\",\n   206\t                    my_promise,\n   207\t                    message_ballot\n   208\t                );\n   209\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   210\t                    from: self.pid,\n   211\t                    to: message_ballot.pid,\n   212\t                    msg: PaxosMsg::NotAccepted(not_acc),\n   213\t                }));\n   214\t                false\n   215\t            }\n   216\t            std::cmp::Ordering::Less => {\n   217\t                // Should never happen, but to be safe send PrepareReq\n   218\t                #[cfg(feature = \"logging\")]\n   219\t                warn!(\n   220\t                    self.logger,\n   221\t                    \"Received non-prepare message from a leader I've never promised. My: {:?}, theirs: {:?}\", my_promise, message_ballot\n   222\t                );\n   223\t                self.reconnected(message_ballot.pid);\n   224\t                false\n   225\t            }\n   226\t        }\n   227\t    }\n   228\t\n   229\t    /// Also returns the MessageStatus of the sequence based on the incoming sequence number.\n   230\t    fn handle_sequence_num(&mut self, seq_num: SequenceNumber, from: NodeId) -> MessageStatus {\n   231\t        let msg_status = self.current_seq_num.check_msg_status(seq_num);\n   232\t        match msg_status {\n   233\t            MessageStatus::Expected => self.current_seq_num = seq_num,\n   234\t            MessageStatus::DroppedPreceding => self.reconnected(from),\n   235\t            MessageStatus::Outdated => (),\n   236\t        };\n   237\t        msg_status\n   238\t    }\n   239\t\n   240\t    pub(crate) fn resend_messages_follower(&mut self) {\n   241\t        match self.state.1 {\n   242\t            Phase::Prepare => {\n   243\t                // Resend Promise\n   244\t                match &self.cached_promise_message {\n   245\t                    Some(promise) => {\n   246\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   247\t                            from: self.pid,\n   248\t                            to: promise.n.pid,\n   249\t                            msg: PaxosMsg::Promise(promise.clone()),\n   250\t                        }));\n   251\t                    }\n   252\t                    None => {\n   253\t                        // Shouldn't be possible to be in prepare phase without having\n   254\t                        // cached the promise sent as a response to the prepare\n   255\t                        #[cfg(feature = \"logging\")]\n   256\t                        warn!(self.logger, \"In Prepare phase without a cached promise!\");\n   257\t                        self.state = (Role::Follower, Phase::Recover);\n   258\t                        self.send_preparereq_to_all_peers();\n   259\t                    }\n   260\t                }\n   261\t            }\n   262\t            Phase::Recover => {\n   263\t                // Resend PrepareReq\n   264\t                self.send_preparereq_to_all_peers();\n   265\t            }\n   266\t            Phase::Accept => (),\n   267\t            Phase::None => (),\n   268\t        }\n   269\t    }\n   270\t\n   271\t    fn send_preparereq_to_all_peers(&mut self) {\n   272\t        let prepreq = PrepareReq {\n   273\t            n: self.get_promise(),\n   274\t        };\n   275\t        for peer in &self.peers {\n   276\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   277\t                from: self.pid,\n   278\t                to: *peer,\n   279\t                msg: PaxosMsg::PrepareReq(prepreq),\n   280\t            }));\n   281\t        }\n   282\t    }\n   283\t\n   284\t    pub(crate) fn flush_batch_follower(&mut self) {\n   285\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   286\t        let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   287\t        if new_accepted_idx > accepted_idx {\n   288\t            self.reply_accepted(self.get_promise(), new_accepted_idx);\n   289\t        }\n   290\t    }\n   291\t}\n","exit_code":0,"status":"completed"}}
