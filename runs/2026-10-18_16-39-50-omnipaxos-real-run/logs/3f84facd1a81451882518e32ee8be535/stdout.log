    \"op\": {\n          \"default\": \"eq\",\n          \"enum\": [\n            \"eq\",\n            \"ne\"\n          ],\n          \"title\": \"Op\",\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Value\"\n        },\n        \"reference\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Reference\"\n        }\n      },\n      \"required\": [\n        \"field\"\n      ],\n      \"title\": \"Comparison\",\n      \"type\": \"object\"\n    },\n    \"EventComparison\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"event\": {\n","exit_code":0,"status":"completed"}}
