{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/src/event.rs omnipaxos_runtime/src/traits.rs'","aggregated_output":"     1\tuse core::time::Duration;\n     2\t\n     3\tuse futures::channel::oneshot;\n     4\t\n     5\tuse omnipaxos::{\n     6\t    storage::Entry,\n     7\t    util::{LogEntry, NodeId},\n     8\t    ClusterConfig, ProposeErr,\n     9\t};\n    10\t\n    11\t/// A state transition observed by the actor and broadcast on the event stream.\n    12\t#[derive(Debug, Clone)]\n    13\tpub enum OmniPaxosEvent {\n    14\t    /// A new leader was observed on this node.\n    15\t    LeaderElected {\n    16\t        /// The pid of the elected leader.\n    17\t        pid: NodeId,\n    18\t        /// Whether this node's phase is `Phase::Accept`.\n    19\t        accepted: bool,\n    20\t    },\n    21\t    /// The decided index advanced. The value is the new decided index.\n    22\t    Decided {\n    23\t        /// The new decided index.\n    24\t        new_decided_idx: usize,\n    25\t    },\n    26\t    /// A reconfiguration StopSign was decided.\n    27\t    Reconfigured {\n    28\t        /// The log index at which the StopSign was decided.\n    29\t        stop_sign_idx: usize,\n    30\t    },\n    31\t}\n    32\t\n    33\t/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n    34\t#[derive(Debug)]\n    35\tpub enum AppendError<T>\n    36\twhere\n    37\t    T: Entry,\n    38\t{\n    39\t    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n    40\t    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n    41\t    /// pending). Unlike the other variants, this is resolved immediately rather than\n    42\t    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n    43\t    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n    44\t    /// leader). If the failure happens on a different node than the origin, the origin\n    45\t    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n    46\t    /// require a new wire message.\n    47\t    Propose(ProposeErr<T>),\n    48\t    /// A leader change occurred after the entry was accepted at the given index but\n    49\t    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n    50\t    /// required to adopt any value a majority-overlapping quorum may have already\n    51\t    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n    52\t    /// new ballot -- we just stop waiting rather than confirm it. Check\n    53\t    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n    54\t    /// at that index if you need to know for sure before re-appending.\n    55\t    Superseded {\n    56\t        /// The log index the entry was assigned before the leader change.\n    57\t        log_entry_idx: usize,\n    58\t    },\n    59\t    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n    60\t    Timeout,\n    61\t    /// The actor has shut down before the entry could be decided.\n    62\t    Shutdown,\n    63\t    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n    64\t    /// outstanding `append_notify` calls; this one was rejected immediately rather\n    65\t    /// than queued. Nothing was proposed, so it's safe to retry (ideally after a\n    66\t    /// backoff, since the backlog needs time to drain).\n    67\t    TooManyOutstanding,\n    68\t}\n    69\t\n    70\t/// Error returned by [`OmniPaxosHandle::append`](super::OmniPaxosHandle::append) and\n    71\t/// [`OmniPaxosHandle::reconfigure`](super::OmniPaxosHandle::reconfigure). Distinct from\n    72\t/// [`AppendError`]: these calls don't track decision, so they only ever fail\n    73\t/// synchronously -- either the propose call itself was rejected, or the actor is gone.\n    74\t#[derive(Debug)]\n    75\tpub enum RuntimeProposeErr<T>\n    76\twhere\n    77\t    T: Entry,\n    78\t{\n    79\t    /// The underlying propose call failed (e.g. a reconfiguration is already pending,\n    80\t    /// or an invalid cluster config was proposed).\n    81\t    Propose(ProposeErr<T>),\n    82\t    /// The actor has shut down.\n    83\t    Shutdown,\n    84\t}\n    85\t\n    86\t/// Commands sent from an [`OmniPaxosHandle`](super::OmniPaxosHandle) to the actor task.\n    87\t///\n    88\t/// This type is `pub(crate)` because it is an implementation detail of the actor <-> handle\n    89\t/// protocol.\n    90\tpub(crate) enum Command<T>\n    91\twhere\n    92\t    T: Entry,\n    93\t{\n    94\t    Append {\n    95\t        entry: T,\n    96\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n    97\t    },\n    98\t    AppendNotify {\n    99\t        entry: T,\n   100\t        /// Overrides [`RuntimeConfig::append_notify_timeout`](super::RuntimeConfig::append_notify_timeout)\n   101\t        /// for this call only, if `Some`.\n   102\t        timeout: Option<Duration>,\n   103\t        reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n   104\t    },\n   105\t    CurrentLeader {\n   106\t        reply: oneshot::Sender<Option<(NodeId, bool)>>,\n   107\t    },\n   108\t    DecidedIdx {\n   109\t        reply: oneshot::Sender<usize>,\n   110\t    },\n   111\t    ReadDecidedSuffix {\n   112\t        from: usize,\n   113\t        reply: oneshot::Sender<Option<Vec<LogEntry<T>>>>,\n   114\t    },\n   115\t    SubscribeDecided {\n   116\t        from: usize,\n   117\t        tx: async_channel::Sender<LogEntry<T>>,\n   118\t    },\n   119\t    Reconfigure {\n   120\t        new_configuration: ClusterConfig,\n   121\t        metadata: Option<Vec<u8>>,\n   122\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n   123\t    },\n   124\t    TryBecomeLeader,\n   125\t    Reconnected {\n   126\t        pid: NodeId,\n   127\t    },\n   128\t}\n   129\tuse core::{future::Future, time::Duration};\n   130\t\n   131\tuse omnipaxos::storage::Entry;\n   132\t\n   133\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n   134\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n   135\t/// covers any `Entry` whose associated types are `Send`.\n   136\t#[cfg(not(feature = \"unicache\"))]\n   137\tpub trait ActorEntry: Entry<Snapshot: Send> + Send + 'static {}\n   138\t\n   139\t#[cfg(not(feature = \"unicache\"))]\n   140\timpl<T> ActorEntry for T where T: Entry<Snapshot: Send> + Send + 'static {}\n   141\t\n   142\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n   143\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n   144\t/// covers any `Entry` whose associated types are `Send`.\n   145\t#[cfg(feature = \"unicache\")]\n   146\tpub trait ActorEntry:\n   147\t    Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n   148\t{\n   149\t}\n   150\t\n   151\t#[cfg(feature = \"unicache\")]\n   152\timpl<T> ActorEntry for T where\n   153\t    T: Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n   154\t{\n   155\t}\n   156\t\n   157\t/// Abstraction over an async executor.\n   158\t///\n   159\t/// Implement this trait to run OmniPaxos on runtimes other than tokio. Two primitives\n   160\t/// are required: task spawning and a timer. The actor loop builds intervals on top of\n   161\t/// [`AsyncRuntime::sleep`], so no separate `interval` primitive is needed.\n   162\tpub trait AsyncRuntime: 'static {\n   163\t    /// The join handle returned by [`AsyncRuntime::spawn`]. The runtime is free to\n   164\t    /// return `()` if it does not need cancellation or joining.\n   165\t    type JoinHandle: Send + 'static;\n   166\t\n   167\t    /// Spawn a future onto the executor.\n   168\t    fn spawn<F>(future: F) -> Self::JoinHandle\n   169\t    where\n   170\t        F: Future<Output = ()> + Send + 'static;\n   171\t\n   172\t    /// Return a future that resolves after `duration` elapses.\n   173\t    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static;\n   174\t}\n","exit_code":0,"status":"completed"}}
