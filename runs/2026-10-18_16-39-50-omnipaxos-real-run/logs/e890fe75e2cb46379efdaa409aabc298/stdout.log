s!(p.msg, PaxosMsg::AcceptStopSign(_)))\n    });\n    route(&mut nodes, &mut q, |_| true);\n    settle(&mut nodes, &mut q);\n    // Deliver the leader's decision to 2, 3 and 4, never to node 5.\n    route(&mut nodes, &mut q, |m| !is_decide_to(m, 5));\n    settle(&mut nodes, &mut q);\n    let before: Vec<(usize, usize)> = nodes\n        .iter()\n        .map(|n| (n.get_accepted_idx(), n.get_decided_idx()))\n        .collect();\n    // Only ticks and delivery now; elections cannot fire (1000-tick timeout).\n    for _ in 0..150 {\n        for n in nodes.iter_mut() {\n            n.tick();\n        }\n        collect(&mut nodes, &mut q);\n        route(&mut nodes, &mut q, |_| true);\n    }\n    let n5 = &nodes[4];\n    let leader = n5.get_current_leader();\n    emit(format!(\n        \"{{\\\"run\\\":14,\\\"event\\\":\\\"resync\\\",\\\"before\\\":\\\"{:?}\\\",\\\"n5_accepted\\\":{},\\\"n5_decided\\\":{},\\\"n5_leader_pid\\\":{},\\\"n5_accept\\\":{},\\\"n5_promise_n\\\":{},\\\"leader_decided\\\":{},\\\"decided\\\":\\\"{}\\\"}}\",\n        before,\n        n5.get_accepted_idx(),\n        n5.get_decided_idx(),\n        leader.map(|(p, _)| p).unwrap_or(0),\n        leader.map(|(_, a)| a).unwrap_or(false),\n        n5.get_promise().n,\n        nodes[0].get_decided_idx(),\n        nodes\n            .iter()\n            .map(|n| n.get_decided_idx().to_string())\n            .collect::<Vec<_>>()\n            .join(\",\")\n    ));\n}\n","exit_code":0,"status":"completed"}}
