{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_16-39-50-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/utils/logger.rs && sed -n 1,40p omnipaxos/tests/consensus_test.rs'","aggregated_output":"     1\tuse slog::{o, Drain, Logger};\n     2\tuse std::{fs::OpenOptions, sync::Mutex};\n     3\t\n     4\t/// Creates an asynchronous logger which outputs to both the terminal and a specified file_path.\n     5\tpub fn create_logger(file_path: &str) -> Logger {\n     6\t    let path = std::path::Path::new(file_path);\n     7\t    let prefix = path.parent().unwrap(); // todo change unwrap\n     8\t    std::fs::create_dir_all(prefix).unwrap(); // todo change unwrap\n     9\t\n    10\t    let file = OpenOptions::new()\n    11\t        .create(true)\n    12\t        .write(true)\n    13\t        .truncate(true)\n    14\t        .open(file_path)\n    15\t        .unwrap(); // todo change unwrap\n    16\t\n    17\t    let term_decorator = slog_term::TermDecorator::new().build();\n    18\t    let file_decorator = slog_term::PlainSyncDecorator::new(file);\n    19\t\n    20\t    let term_fuse = slog_term::FullFormat::new(term_decorator).build().fuse();\n    21\t    let file_fuse = slog_term::FullFormat::new(file_decorator).build().fuse();\n    22\t\n    23\t    let both = Mutex::new(slog::Duplicate::new(term_fuse, file_fuse)).fuse();\n    24\t    let both = slog_async::Async::new(both).build().fuse();\n    25\t    Logger::root(both, o!())\n    26\t}\npub mod utils;\n\nuse kompact::prelude::{promise, Ask, FutureCollection};\nuse omnipaxos::{\n    storage::{Snapshot, StopSign, Storage},\n    ClusterConfig, OmniPaxosConfig,\n};\nuse serial_test::serial;\nuse utils::{\n    create_temp_dir, verification::*, StorageType, TestConfig, TestSystem, Value, ValueSnapshot,\n};\n\n/// Verifies the 3 properties that the Paxos algorithm offers\n/// Quorum, Validity, Uniform Agreement\n#[test]\n#[serial]\nfn consensus_test() {\n    let cfg = TestConfig::load(\"consensus_test\").expect(\"Test config loaded\");\n    let mut sys = TestSystem::with(cfg);\n\n    let first_node = sys.nodes.get(&1).unwrap();\n    let mut futures = vec![];\n    let vec_proposals = utils::create_proposals(1, cfg.num_proposals);\n    for v in &vec_proposals {\n        let (kprom, kfuture) = promise::<()>();\n        first_node.on_definition(|x| {\n            x.insert_decided_future(Ask::new(kprom, v.clone()));\n            x.paxos.append(v.clone()).expect(\"Failed to append\");\n        });\n        futures.push(kfuture);\n    }\n\n    sys.start_all_nodes();\n\n    match FutureCollection::collect_with_timeout::<Vec<_>>(futures, cfg.wait_timeout) {\n        Ok(_) => {}\n        Err(e) => panic!(\"Error on collecting futures of decided proposals: {}\", e),\n    }\n\n    let mut log = vec![];\n","exit_code":0,"status":"completed"}}
