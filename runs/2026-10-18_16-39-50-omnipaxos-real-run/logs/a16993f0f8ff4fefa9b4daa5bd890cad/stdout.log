{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 -c \\\"\nimport json\nd=json.load(open('submissions/11b123d320004ee084197d80a8a4be59/raw.json'))\nprint(json.dumps(d.get('experiment'),indent=1)[:5000])\n\\\"\"","aggregated_output":"{\n \"investigation_id\": \"b4ce39b510974e628f7333fe0525a25b-question-0\",\n \"previous_id\": \"d14c823abdca40f7a8e2161f6e9665d8-experiment\",\n \"revision_reason\": \"Extends acceptsync_covering_stopsign_inflates_accepted with a Decide for the inflated index 4 and an after_decide event recording accepted, decided, is_reconfigured and the entry kinds at indices 2 and 3. The covering AcceptSync, the before_sync and after_sync events and all other tests are unchanged.\",\n \"harness_path\": \"omnipaxos/tests/assurance_generated.rs\",\n \"test_names\": [\n  \"acceptsync_covering_stopsign_inflates_accepted\"\n ],\n \"source_ids\": [\n  \"core_sync_log\",\n  \"core_create_log_sync\",\n  \"core_handle_acceptsync\",\n  \"core_stopsign_decided\",\n  \"core_update_decided_clamp\"\n ],\n \"scope\": {\n  \"description\": \"Five OmniPaxos instances. Node 1 is made leader, appends entries 1 and 2 with full delivery, then reconfigures so every node accepts entries 1..2 and the StopSign. Node 5 is moved to Prepare under ballot 2 and receives an AcceptSync whose log_sync has sync_idx 3, an empty suffix and the StopSign, inflating the accepted index. It then receives a Decide for that inflated index on the same ballot with the next sequence number.\",\n  \"assumptions\": [\n   \"A Decide with the same ballot and the next sequence number is the message a leader would send once the inflated index is chosen.\",\n   \"If decided catches up with accepted while index 2 stays empty and the marker sits at 3, the deterministic case matches the randomized end state's shape.\",\n   \"No snapshots or trimming are involved.\"\n  ],\n  \"excluded\": [\n   \"Randomized loss, leadership churn, the next configuration being started, snapshots and flexible quorums.\"\n  ],\n  \"parameters\": {\n   \"nodes\": 5,\n   \"entries_before_reconfigure\": 2,\n   \"follower\": 5,\n   \"ballot_n\": 2,\n   \"sync_idx\": 3,\n   \"suffix_len\": 0,\n   \"decide_index\": 4\n  }\n },\n \"prefix\": \"The test acceptsync_covering_stopsign_inflates_accepted builds five nodes, makes node 1 leader, appends Value(1) and Value(2), reconfigures to configuration_id 2 and settles. It emits before_sync, sends node 5 a Prepare for ballot {config_id 1, n 2, priority 0, pid 9} and an AcceptSync with sequence counter 1, decided_idx 3 and a LogSync with sync_idx 3, empty suffix and the StopSign, then emits after_sync. New in this revision: it sends a Decide with the same ballot, sequence counter 2 and decided_idx 4, then emits after_decide with accepted, decided, is_reconfigured and the entry kinds at indices 2 and 3.\",\n \"prerequisites\": [\n  {\n   \"alias\": \"before\",\n   \"event\": \"before_sync\",\n   \"conditions\": [\n    {\n     \"field\": \"run\",\n     \"op\": \"eq\",\n     \"value\": 15\n    },\n    {\n     \"field\": \"accepted\",\n     \"op\": \"eq\",\n     \"value\": 3\n    },\n    {\n     \"field\": \"reconfig\",\n     \"op\": \"eq\",\n     \"value\": 1\n    }\n   ]\n  }\n ],\n \"comparisons\": [\n  {\n   \"event\": \"after_decide\",\n   \"identity_fields\": [\n    \"run\"\n   ],\n   \"admission_alias\": \"before\",\n   \"assertion\": {\n    \"field\": \"accepted\",\n    \"op\": \"eq\",\n    \"value\": 4\n   },\n   \"applicability_conditions\": [],\n   \"description\": \"After the inflated index is decided, the accepted index remains the inflated value while the readable log still has the hole, matching the randomized end state's shape.\"\n  }\n ]\n}\n","exit_code":0,"status":"completed"}}
