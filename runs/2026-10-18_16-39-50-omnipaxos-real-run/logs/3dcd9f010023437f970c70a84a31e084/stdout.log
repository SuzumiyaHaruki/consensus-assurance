\"Current explanation of the whole question, starting with the present conclusion and basis. Integrate still-applicable limits; do not prepend a revision log. Put this update's change explanation in AuditSubmission.rationale.\",\n   \"minLength\": 1,\n   \"title\": \"Rationale\",\n   \"type\": \"string\"\n  },\n  \"answers\": {\n   \"additionalProperties\": {\n    \"$ref\": \"#/$defs/GapAnswer\"\n   },\n   \"description\": \"Registered gap ID to an explanation and explicit model resolution judgment; resolved=false retains or reopens the gap; omitted IDs keep prior responses\",\n   \"title\": \"Answers\",\n   \"type\": \"object\"\n  },\n  \"knowledge\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/KnowledgeUse\"\n   },\n   \"title\": \"Knowledge\",\n   \"type\": \"array\"\n  },\n  \"counterevidence\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Counterevidence\",\n   \"type\": \"array\"\n  },\n  \"limitations\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Limitations\",\n   \"type\": \"array\"\n  },\n  \"joint_history\": {\n   \"default\": \"\",\n   \"description\": \"Explain compatibility when associating a separate producer experiment\",\n   \"title\": \"Joint History\",\n   \"type\": \"string\"\n  },\n  \"failure_attribution\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/FailureAttribution\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  }\n },\n \"required\": [\n  \"investigation_id\",\n  \"source_ids\",\n  \"conclusion\",\n  \"defect_claim\",\n  \"rationale\"\n ],\n \"title\": \"InterpretationUpdate\",\n \"type\": \"object\"\n}\n### KnowledgeUpdate\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Id\"\n  },\n  \"ref\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Ref\"\n  },\n  \"kind\": {\n   \"enum\": [\n    \"behavior\",\n    \"fact\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"statement\": {\n   \"minLength\": 1,\n   \"title\": \"Statement\",\n   \"type\": \"string\"\n  },\n  \"conditions\": {\n   \"minLength\": 1,\n   \"title\": \"Conditions\",\n   \"type\": \"string\"\n  },\n  \"source_ids\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Source Ids\",\n   \"type\": \"array\"\n  },\n  \"executions\": {\n   \"additionalProperties\": {\n    \"items\": {\n     \"type\": \"integer\"\n    },\n    \"type\": \"array\"\n   },\n   \"default\": {},\n   \"title\": \"Executions\",\n   \"type\": \"object\"\n  },\n  \"knowledge\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/KnowledgeUse\"\n   },\n   \"title\": \"Knowledge\",\n   \"type\": \"array\"\n  },\n  \"changed_premise\": {\n   \"default\": \"\",\n   \"description\": \"For a correction, explain the semantic difference; empty for unrelated or representational changes\",\n   \"title\": \"Changed Premise\",\n   \"type\": \"string\"\n  },\n  \"affected_uses\": {\n   \"description\": \"Saved investigation, experiment or interpretation IDs using the changed premise directly or through recorded knowledge revisions; never inferred from similar words\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Affected Uses\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"kind\",\n  \"statement\",\n  \"conditions\",\n  \"source_ids\"\n ],\n \"title\": \"KnowledgeUpdate\",\n \"type\": \"object\"\n}\n### QuestionUpdate\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Id\"\n  },\n  \"ref\": {\n   \"anyOf