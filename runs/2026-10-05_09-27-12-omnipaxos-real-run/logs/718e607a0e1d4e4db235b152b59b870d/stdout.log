{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/8c4dc87dc3104a0ab63e5a71d28e1a3a/plan.json; cat ../direct-checks/8c4dc87dc3104a0ab63e5a71d28e1a3a/omnipaxos_runtime/tests/assurance_generated.rs; grep 'CA_EVENT' ../logs/f6b6e1f52baa4f8991b6320420cee535/stdout.log; cat ../logs/f6b6e1f52baa4f8991b6320420cee535/stderr.log\"","aggregated_output":"{\n  \"description\": \"Delay every old-leader outbound link after a fully drained empty-log setup. Origin node 2 sends a real tagged append 101 to leader 1; its actual Assigned reply and replication messages remain queued. Nodes 2 and 3 prepare a higher ballot excluding node 1, then decide replacement 202. Release the entire FIFO 1->2 and observe append_notify completion and the live decided suffix at its returned one-based position. No fabricated messages, source substitutions, crashes or storage faults.\",\n  \"claim_id\": \"claim-notify-same-entry\",\n  \"binding_ids\": [\n    \"binding-notify-completion\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./omnipaxos_runtime\",\n    \"files\": {},\n    \"kind\": \"rust_test\",\n    \"source\": \"use std::{collections::VecDeque, future::Future, time::{Duration, Instant}};\\nuse omnipaxos::{OmniPaxos, OmniPaxosConfig, ClusterConfig, ServerConfig,\\n    storage::{Entry, NoSnapshot}, util::LogEntry,\\n    messages::{Message, async_runtime::AsyncRuntimeMsg, sequence_paxos::PaxosMsg}};\\nuse omnipaxos_runtime::{spawn_actor, AsyncRuntime, OmniPaxosHandle, RuntimeConfig};\\nuse omnipaxos_storage::memory_storage::MemoryStorage;\\n\\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\\nstruct Value(u64);\\nimpl Entry for Value { type Snapshot = NoSnapshot; }\\nstruct Runtime;\\nimpl AsyncRuntime for Runtime {\\n    type JoinHandle = tokio::task::JoinHandle<()>;\\n    fn spawn<F: Future<Output=()> + Send + 'static>(f: F) -> Self::JoinHandle { tokio::spawn(f) }\\n    fn sleep(d: Duration) -> impl Future<Output=()> + Send + 'static { tokio::time::sleep(d) }\\n}\\ntype Core = OmniPaxos<Value, MemoryStorage<Value>>;\\ntype Handle = OmniPaxosHandle<Value>;\\n\\nfn build(pid: u64) -> Core {\\n    OmniPaxosConfig {\\n        cluster_config: ClusterConfig { configuration_id: 1, nodes: vec![1,2,3], ..Default::default() },\\n        server_config: ServerConfig { pid, batch_size: 1, election_tick_timeout: 100_000,\\n            resend_message_tick_timeout: 100_000, flush_batch_tick_timeout: 10,\\n            ..Default::default() },\\n    }.build(MemoryStorage::default()).unwrap()\\n}\\n\\n// One caller-owned FIFO per directed link, shared by setup and the actor phase.\\nstruct Network {\\n    queues: Vec<VecDeque<Message<Value>>>,\\n    old_links_open: bool,\\n    proposal_route_open: bool,\\n    release_to_origin: bool,\\n    entry_id: Option<String>,\\n    assignment: Option<(String, usize, u32)>,\\n    old_value_emitted: bool,\\n    replacement_ballot: Option<u32>,\\n}\\nimpl Network {\\n    fn new() -> Self { Self { queues: (0..9).map(|_|VecDeque::new()).collect(),\\n        old_links_open:true, proposal_route_open:true, release_to_origin:false,\\n        entry_id:None,assignment:None,old_value_emitted:false,replacement_ballot:None } }\\n    fn enqueue(&mut self, m: Message<Value>) {\\n        let from=m.get_sender(); let to=m.get_receiver();\\n        if let Message::AsyncRuntime(a)=&m {\\n            match &a.msg {\\n                AsyncRuntimeMsg::TaggedProposal{entries} if from==2 && to==1 => {\\n                    assert_eq!(entries.len(),1);\\n                    assert_eq!(entries[0].1,Value(101));\\n                    let id=entries[0].0.0.to_string();\\n                    assert!(self.entry_id.is_none());\\n                    println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"admitted\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"proposed\\\\\\\":101,\\\\\\\"origin\\\\\\\":2,\\\\\\\"old_leader\\\\\\\":1}}\\\",id);\\n                    self.entry_id=Some(id);\\n                }\\n                AsyncRuntimeMsg::Assigned{ballot,entries} if from==1 && to==2 => {\\n                    assert_eq!(entries.len(),1);\\n                    let id=entries[0].0.0.to_string();\\n                    assert_eq!(Some(&id),self.entry_id.as_ref());\\n                    self.assignment=Some((id.clone(),entries[0].1,ballot.n));\\n                    println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"assigned_held\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"assigned_idx\\\\\\\":{},\\\\\\\"old_ballot\\\\\\\":{}}}\\\",id,entries[0].1,ballot.n);\\n                }\\n                _=>{}\\n            }\\n        }\\n        if let Message::SequencePaxos(p)=&m {\\n            match &p.msg {\\n                PaxosMsg::AcceptDecide(a) if from==1 => {\\n                    if a.entries.iter().any(|v|v.0==101) { self.old_value_emitted=true; }\\n                }\\n                PaxosMsg::AcceptDecide(a) if from==3 => {\\n                    if a.entries.iter().any(|v|v.0==202) { self.replacement_ballot=Some(a.n.n); }\\n                }\\n                _=>{}\\n            }\\n        }\\n        self.queues[((from-1)*3+to-1) as usize].push_back(m);\\n    }\\n    fn allowed(&self, from:u64,to:u64)->bool {\\n        self.old_links_open || (from!=1 && to!=1) ||\\n        (self.proposal_route_open && from==2 && to==1) ||\\n        (self.release_to_origin && from==1 && to==2)\\n    }\\n    fn ready(&mut self)->Vec<Message<Value>> {\\n        let mut out=Vec::new();\\n        for from in 1..=3 { for to in 1..=3 {\\n            if self.allowed(from,to) { out.extend(self.queues[((from-1)*3+to-1) as usize].drain(..)); }\\n        }}\\n        out\\n    }\\n    async fn pump(&mut self, h:&[Handle]) {\\n        for handle in h {\\n            let out=handle.outgoing_messages();\\n            while let Ok(m)=out.try_recv() { self.enqueue(m); }\\n            let events=handle.subscribe_events();\\n            while events.try_recv().is_ok() {}\\n        }\\n        for m in self.ready() { h[(m.get_receiver()-1) as usize].handle_incoming(m).await; }\\n        tokio::time::sleep(Duration::from_millis(2)).await;\\n    }\\n}\\n\\n#[tokio::test(flavor=\\\"current_thread\\\")]\\nasync fn genuine_delayed_assignment_after_replacement() {\\n    let mut core:Vec<Core>=(1..=3).map(build).collect();\\n    let mut net=Network::new();\\n    core[0].try_become_leader();\\n    // No proposals yet. Fully drain this fault-free initialization prefix.\\n    for _ in 0..100 {\\n        for c in &mut core {\\n            let mut out=Vec::new(); c.take_outgoing_messages(&mut out);\\n            for m in out { net.enqueue(m); }\\n        }\\n        let ready=net.ready();\\n        if ready.is_empty() { break; }\\n        for m in ready { core[(m.get_receiver()-1) as usize].handle_incoming(m); }\\n    }\\n    assert!(net.queues.iter().all(|q|q.is_empty()));\\n    for c in &core {\\n        assert_eq!(c.get_current_leader(),Some((1,true)));\\n        assert_eq!(c.get_decided_idx(),0); assert_eq!(c.get_accepted_idx(),0);\\n    }\\n    println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"setup\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"leader\\\\\\\":1,\\\\\\\"empty\\\\\\\":true,\\\\\\\"nodes\\\\\\\":3}}\\\");\\n    let cfg=RuntimeConfig { tick_period:Duration::from_millis(10),\\n        egress_period:Duration::from_millis(1), append_notify_timeout:Duration::from_secs(20),\\n        ..Default::default() };\\n    let h:Vec<Handle>=core.into_iter().map(|c|spawn_actor::<_,_,Runtime>(c,cfg.clone())).collect();\\n    net.old_links_open=false;\\n    let origin=h[1].clone();\\n    let pending=tokio::spawn(async move {origin.append_notify(Value(101)).await});\\n    let start=Instant::now();\\n    while net.assignment.is_none() || !net.old_value_emitted {\\n        assert!(start.elapsed()<Duration::from_secs(3),\\\"old assignment/append prerequisite missing\\\");\\n        net.pump(&h).await;\\n    }\\n    net.proposal_route_open=false;\\n    let (id,assigned_idx,old_ballot)=net.assignment.clone().unwrap();\\n    assert_eq!(assigned_idx,1);\\n    assert!(!pending.is_finished(),\\\"request completed before assignment delivery\\\");\\n    assert_eq!(h[1].decided_idx().await,0);\\n    assert_eq!(h[2].decided_idx().await,0);\\n    println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"old_unreplicated\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"accepted_message_observed\\\\\\\":true,\\\\\\\"old_outbound_delivered\\\\\\\":0}}\\\",id);\\n    h[2].try_become_leader().await;\\n    let start=Instant::now();\\n    loop {\\n        net.pump(&h).await;\\n        if h[2].current_leader().await==Some((3,true)) && h[1].current_leader().await==Some((3,true)) { break; }\\n        assert!(start.elapsed()<Duration::from_secs(3),\\\"new leader prerequisite missing\\\");\\n    }\\n    h[2].append(Value(202)).await.unwrap();\\n    let start=Instant::now();\\n    while h[1].decided_idx().await<1 || h[2].decided_idx().await<1 {\\n        assert!(start.elapsed()<Duration::from_secs(3),\\\"replacement decision prerequisite missing\\\");\\n        net.pump(&h).await;\\n    }\\n    let replacement=h[1].read_decided_suffix(0).await.unwrap();\\n    assert!(matches!(&replacement[0],LogEntry::Decided(Value(202))));\\n    let new_ballot=net.replacement_ballot.expect(\\\"replacement producer not observed\\\");\\n    assert!(new_ballot>old_ballot);\\n    assert!(!pending.is_finished(),\\\"unassigned pending call did not survive transition\\\");\\n    println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"replacement_decided\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"assigned_idx\\\\\\\":{},\\\\\\\"observed\\\\\\\":202,\\\\\\\"new_ballot\\\\\\\":{},\\\\\\\"old_ballot\\\\\\\":{},\\\\\\\"pending\\\\\\\":true}}\\\",id,assigned_idx,new_ballot,old_ballot);\\n    // Release the whole old-leader -> origin FIFO, including any preceding messages.\\n    net.release_to_origin=true;\\n    let start=Instant::now();\\n    while !pending.is_finished() && start.elapsed()<Duration::from_secs(2) { net.pump(&h).await; }\\n    if pending.is_finished() {\\n        let result=pending.await.unwrap();\\n        let (success,returned_idx,status)=match result {\\n            Ok(i)=>(true,i,\\\"ok\\\"),\\n            Err(omnipaxos_runtime::AppendError::Superseded{log_entry_idx})=>(false,log_entry_idx,\\\"superseded\\\"),\\n            Err(omnipaxos_runtime::AppendError::Timeout)=>(false,0,\\\"timeout\\\"),\\n            Err(_)=>(false,0,\\\"other_error\\\"),\\n        };\\n        let index=if success {returned_idx.checked_sub(1).expect(\\\"invalid returned position\\\")} else {assigned_idx-1};\\n        let observed=h[1].read_decided_suffix(index).await.unwrap();\\n        let observed_value=match &observed[0] {LogEntry::Decided(v)=>v.0,_=>panic!(\\\"result log entry not decided\\\")};\\n        println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"completion\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"success\\\\\\\":{},\\\\\\\"returned_idx\\\\\\\":{},\\\\\\\"status\\\\\\\":\\\\\\\"{}\\\\\\\",\\\\\\\"observed_value\\\\\\\":{},\\\\\\\"decided_idx\\\\\\\":{}}}\\\",id,success,returned_idx,status,observed_value,h[1].decided_idx().await);\\n    } else {\\n        println!(\\\"CA_EVENT {{\\\\\\\"event\\\\\\\":\\\\\\\"bounded_pending\\\\\\\",\\\\\\\"op_id\\\\\\\":\\\\\\\"old-request\\\\\\\",\\\\\\\"entry_id\\\\\\\":\\\\\\\"{}\\\\\\\"}}\\\",id);\\n        pending.abort();\\n        let _=pending.await;\\n    }\\n    drop(h); // Runtime shutdown also cancels any actor still blocked in its select loop.\\n}\\n\",\n    \"description\": \"Three real OmniPaxos nodes and three real ActorState loops, driven through public APIs. Caller-owned per-link FIFO queues implement partitions and delay. Real tokio task/time primitives implement the public AsyncRuntime trait. Core prefix is initialized with explicit try_become_leader and drained before spawning actors. Runtime and protocol ticks remain enabled; large legal election/resend thresholds avoid unrelated election churn during the short controlled history. Bounded event/outgoing channels are continually drained. The result event is absent if the operation remains pending in the observation window.\",\n    \"semantic_changes\": [\n      \"No target changes. Custom AsyncRuntime delegates directly to tokio spawn and sleep because selected crate default features need not expose TokioRuntime.\",\n      \"Caller transport replaces network I/O with FIFO queues, holding all old leader outbound messages then releasing only link 1->2 in original order.\",\n      \"Read observations are public API copies of the actual local decided log. Assigned positions are prefix lengths: returned k is compared at zero-based read index k-1, as established by append_tracked accepted_after.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"setup\",\n        \"event\": \"setup\",\n        \"conditions\": [\n          {\n            \"field\": \"empty\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"op_id\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"setup.op_id\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"assigned\",\n        \"event\": \"assigned_held\",\n        \"conditions\": [\n          {\n            \"field\": \"entry_id\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"admitted.entry_id\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"unreplicated\",\n        \"event\": \"old_unreplicated\",\n        \"conditions\": [\n          {\n            \"field\": \"entry_id\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"assigned.entry_id\"\n          },\n          {\n            \"field\": \"old_outbound_delivered\",\n            \"op\": \"eq\",\n            \"value\": 0,\n            \"reference\": null\n          },\n          {\n            \"field\": \"accepted_message_observed\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"replacement\",\n        \"event\": \"replacement_decided\",\n        \"conditions\": [\n          {\n            \"field\": \"entry_id\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"unreplicated.entry_id\"\n          },\n          {\n            \"field\": \"assigned_idx\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"assigned.assigned_idx\"\n          },\n          {\n            \"field\": \"pending\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"s-config\",\n        \"s-api\",\n        \"s-rt-api-contract\",\n        \"s-rt-wire\",\n        \"s-rt-lifecycle\",\n        \"s-rt-egress\",\n        \"s-rt-loop\",\n        \"s-rt-runtime-trait\",\n        \"s-rt-runtime-transport\",\n        \"s-follow\",\n        \"s-formation\"\n      ],\n      \"expectation_ids\": [\n        \"s-rt-api-contract\"\n      ],\n      \"binding_ids\": [\n        \"binding-notify-completion\"\n      ],\n      \"derivation\": \"Public core and actor construction, takeover, append and transport APIs supply all producer calls. Initialization requires all three nodes report leader 1 in Accept with zero accepted/decided entries and empty transport queues. After setup, all links originating at node 1 are deferred before the request, so its 101 cannot enter the new quorum; a genuine emitted AcceptDecide confirms local acceptance. Node 2 sends TaggedProposal before its route to node 1 closes. Nodes 2 and 3 remain mutually connected and form their own real quorum. Actual Assigned is retained unchanged. Changing transport policy never reorders within a directed link. Large timer thresholds are valid configuration, not disabled code. The test has one admitted target operation, no synthesized assignments and no private state access.\",\n      \"applicability\": \"Successful in-memory storage, batch size 1, one fixed valid configuration with three unique node IDs. Setup and replacement prerequisites are assertions/events, not inferred from test PASS.\",\n      \"unresolved\": [\n        \"The selected runtime crate requires its own trusted compilation preparation; build failures are not protocol results.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-notify-identity\",\n      \"checker_id\": \"notify-identity\",\n      \"event\": \"completion\",\n      \"binding_ids\": [\n        \"binding-notify-completion\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s-rt-api-contract\",\n          \"s-rt-assignment\",\n          \"s-runtime-drain\",\n          \"s-storage-load-read\"\n        ],\n        \"expectation_ids\": [\n          \"s-rt-api-contract\",\n          \"s-rt-error-contract\"\n        ],\n        \"binding_ids\": [\n          \"binding-notify-completion\"\n        ],\n        \"derivation\": \"Observe the return of the exact append_notify future that generated the captured tagged EntryId; independently read the decided entry at the returned position. Error outcomes are allowed by the implication. Missing completion remains unknown.\",\n        \"applicability\": \"Admitted operation in the recorded fixed-configuration history with genuine assignment, replacement decided state and completed future; success requires same proposed entry, errors are permitted.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"notify-identity\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"completion\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"observed_value\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admitted.proposed\"\n      },\n      \"antecedent\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"op_id\"\n      ],\n      \"description\": \"If this admitted append_notify returns Ok, the actual decided value at that returned position equals the proposed value. A different replacement value is forbidden; Timeout/Superseded does not violate the condition.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Only one fixed delayed-assignment history, no exhaustive interleavings or durability claims.\",\n    \"Bounded pending is not a liveness violation and does not count as a completed comparison.\",\n    \"New crate preparation may expose compilation prerequisites; semantic attribution requires current checker correspondence after execution.\"\n  ]\n}use std::{collections::VecDeque, future::Future, time::{Duration, Instant}};\nuse omnipaxos::{OmniPaxos, OmniPaxosConfig, ClusterConfig, ServerConfig,\n    storage::{Entry, NoSnapshot}, util::LogEntry,\n    messages::{Message, async_runtime::AsyncRuntimeMsg, sequence_paxos::PaxosMsg}};\nuse omnipaxos_runtime::{spawn_actor, AsyncRuntime, OmniPaxosHandle, RuntimeConfig};\nuse omnipaxos_storage::memory_storage::MemoryStorage;\n\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\nstruct Value(u64);\nimpl Entry for Value { type Snapshot = NoSnapshot; }\nstruct Runtime;\nimpl AsyncRuntime for Runtime {\n    type JoinHandle = tokio::task::JoinHandle<()>;\n    fn spawn<F: Future<Output=()> + Send + 'static>(f: F) -> Self::JoinHandle { tokio::spawn(f) }\n    fn sleep(d: Duration) -> impl Future<Output=()> + Send + 'static { tokio::time::sleep(d) }\n}\ntype Core = OmniPaxos<Value, MemoryStorage<Value>>;\ntype Handle = OmniPaxosHandle<Value>;\n\nfn build(pid: u64) -> Core {\n    OmniPaxosConfig {\n        cluster_config: ClusterConfig { configuration_id: 1, nodes: vec![1,2,3], ..Default::default() },\n        server_config: ServerConfig { pid, batch_size: 1, election_tick_timeout: 100_000,\n            resend_message_tick_timeout: 100_000, flush_batch_tick_timeout: 10,\n            ..Default::default() },\n    }.build(MemoryStorage::default()).unwrap()\n}\n\n// One caller-owned FIFO per directed link, shared by setup and the actor phase.\nstruct Network {\n    queues: Vec<VecDeque<Message<Value>>>,\n    old_links_open: bool,\n    proposal_route_open: bool,\n    release_to_origin: bool,\n    entry_id: Option<String>,\n    assignment: Option<(String, usize, u32)>,\n    old_value_emitted: bool,\n    replacement_ballot: Option<u32>,\n}\nimpl Network {\n    fn new() -> Self { Self { queues: (0..9).map(|_|VecDeque::new()).collect(),\n        old_links_open:true, proposal_route_open:true, release_to_origin:false,\n        entry_id:None,assignment:None,old_value_emitted:false,replacement_ballot:None } }\n    fn enqueue(&mut self, m: Message<Value>) {\n        let from=m.get_sender(); let to=m.get_receiver();\n        if let Message::AsyncRuntime(a)=&m {\n            match &a.msg {\n                AsyncRuntimeMsg::TaggedProposal{entries} if from==2 && to==1 => {\n                    assert_eq!(entries.len(),1);\n                    assert_eq!(entries[0].1,Value(101));\n                    let id=entries[0].0.0.to_string();\n                    assert!(self.entry_id.is_none());\n                    println!(\"CA_EVENT {{\\\"event\\\":\\\"admitted\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\",\\\"proposed\\\":101,\\\"origin\\\":2,\\\"old_leader\\\":1}}\",id);\n                    self.entry_id=Some(id);\n                }\n                AsyncRuntimeMsg::Assigned{ballot,entries} if from==1 && to==2 => {\n                    assert_eq!(entries.len(),1);\n                    let id=entries[0].0.0.to_string();\n                    assert_eq!(Some(&id),self.entry_id.as_ref());\n                    self.assignment=Some((id.clone(),entries[0].1,ballot.n));\n                    println!(\"CA_EVENT {{\\\"event\\\":\\\"assigned_held\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\",\\\"assigned_idx\\\":{},\\\"old_ballot\\\":{}}}\",id,entries[0].1,ballot.n);\n                }\n                _=>{}\n            }\n        }\n        if let Message::SequencePaxos(p)=&m {\n            match &p.msg {\n                PaxosMsg::AcceptDecide(a) if from==1 => {\n                    if a.entries.iter().any(|v|v.0==101) { self.old_value_emitted=true; }\n                }\n                PaxosMsg::AcceptDecide(a) if from==3 => {\n                    if a.entries.iter().any(|v|v.0==202) { self.replacement_ballot=Some(a.n.n); }\n                }\n                _=>{}\n            }\n        }\n        self.queues[((from-1)*3+to-1) as usize].push_back(m);\n    }\n    fn allowed(&self, from:u64,to:u64)->bool {\n        self.old_links_open || (from!=1 && to!=1) ||\n        (self.proposal_route_open && from==2 && to==1) ||\n        (self.release_to_origin && from==1 && to==2)\n    }\n    fn ready(&mut self)->Vec<Message<Value>> {\n        let mut out=Vec::new();\n        for from in 1..=3 { for to in 1..=3 {\n            if self.allowed(from,to) { out.extend(self.queues[((from-1)*3+to-1) as usize].drain(..)); }\n        }}\n        out\n    }\n    async fn pump(&mut self, h:&[Handle]) {\n        for handle in h {\n            let out=handle.outgoing_messages();\n            while let Ok(m)=out.try_recv() { self.enqueue(m); }\n            let events=handle.subscribe_events();\n            while events.try_recv().is_ok() {}\n        }\n        for m in self.ready() { h[(m.get_receiver()-1) as usize].handle_incoming(m).await; }\n        tokio::time::sleep(Duration::from_millis(2)).await;\n    }\n}\n\n#[tokio::test(flavor=\"current_thread\")]\nasync fn genuine_delayed_assignment_after_replacement() {\n    let mut core:Vec<Core>=(1..=3).map(build).collect();\n    let mut net=Network::new();\n    core[0].try_become_leader();\n    // No proposals yet. Fully drain this fault-free initialization prefix.\n    for _ in 0..100 {\n        for c in &mut core {\n            let mut out=Vec::new(); c.take_outgoing_messages(&mut out);\n            for m in out { net.enqueue(m); }\n        }\n        let ready=net.ready();\n        if ready.is_empty() { break; }\n        for m in ready { core[(m.get_receiver()-1) as usize].handle_incoming(m); }\n    }\n    assert!(net.queues.iter().all(|q|q.is_empty()));\n    for c in &core {\n        assert_eq!(c.get_current_leader(),Some((1,true)));\n        assert_eq!(c.get_decided_idx(),0); assert_eq!(c.get_accepted_idx(),0);\n    }\n    println!(\"CA_EVENT {{\\\"event\\\":\\\"setup\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"leader\\\":1,\\\"empty\\\":true,\\\"nodes\\\":3}}\");\n    let cfg=RuntimeConfig { tick_period:Duration::from_millis(10),\n        egress_period:Duration::from_millis(1), append_notify_timeout:Duration::from_secs(20),\n        ..Default::default() };\n    let h:Vec<Handle>=core.into_iter().map(|c|spawn_actor::<_,_,Runtime>(c,cfg.clone())).collect();\n    net.old_links_open=false;\n    let origin=h[1].clone();\n    let pending=tokio::spawn(async move {origin.append_notify(Value(101)).await});\n    let start=Instant::now();\n    while net.assignment.is_none() || !net.old_value_emitted {\n        assert!(start.elapsed()<Duration::from_secs(3),\"old assignment/append prerequisite missing\");\n        net.pump(&h).await;\n    }\n    net.proposal_route_open=false;\n    let (id,assigned_idx,old_ballot)=net.assignment.clone().unwrap();\n    assert_eq!(assigned_idx,1);\n    assert!(!pending.is_finished(),\"request completed before assignment delivery\");\n    assert_eq!(h[1].decided_idx().await,0);\n    assert_eq!(h[2].decided_idx().await,0);\n    println!(\"CA_EVENT {{\\\"event\\\":\\\"old_unreplicated\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\",\\\"accepted_message_observed\\\":true,\\\"old_outbound_delivered\\\":0}}\",id);\n    h[2].try_become_leader().await;\n    let start=Instant::now();\n    loop {\n        net.pump(&h).await;\n        if h[2].current_leader().await==Some((3,true)) && h[1].current_leader().await==Some((3,true)) { break; }\n        assert!(start.elapsed()<Duration::from_secs(3),\"new leader prerequisite missing\");\n    }\n    h[2].append(Value(202)).await.unwrap();\n    let start=Instant::now();\n    while h[1].decided_idx().await<1 || h[2].decided_idx().await<1 {\n        assert!(start.elapsed()<Duration::from_secs(3),\"replacement decision prerequisite missing\");\n        net.pump(&h).await;\n    }\n    let replacement=h[1].read_decided_suffix(0).await.unwrap();\n    assert!(matches!(&replacement[0],LogEntry::Decided(Value(202))));\n    let new_ballot=net.replacement_ballot.expect(\"replacement producer not observed\");\n    assert!(new_ballot>old_ballot);\n    assert!(!pending.is_finished(),\"unassigned pending call did not survive transition\");\n    println!(\"CA_EVENT {{\\\"event\\\":\\\"replacement_decided\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\",\\\"assigned_idx\\\":{},\\\"observed\\\":202,\\\"new_ballot\\\":{},\\\"old_ballot\\\":{},\\\"pending\\\":true}}\",id,assigned_idx,new_ballot,old_ballot);\n    // Release the whole old-leader -> origin FIFO, including any preceding messages.\n    net.release_to_origin=true;\n    let start=Instant::now();\n    while !pending.is_finished() && start.elapsed()<Duration::from_secs(2) { net.pump(&h).await; }\n    if pending.is_finished() {\n        let result=pending.await.unwrap();\n        let (success,returned_idx,status)=match result {\n            Ok(i)=>(true,i,\"ok\"),\n            Err(omnipaxos_runtime::AppendError::Superseded{log_entry_idx})=>(false,log_entry_idx,\"superseded\"),\n            Err(omnipaxos_runtime::AppendError::Timeout)=>(false,0,\"timeout\"),\n            Err(_)=>(false,0,\"other_error\"),\n        };\n        let index=if success {returned_idx.checked_sub(1).expect(\"invalid returned position\")} else {assigned_idx-1};\n        let observed=h[1].read_decided_suffix(index).await.unwrap();\n        let observed_value=match &observed[0] {LogEntry::Decided(v)=>v.0,_=>panic!(\"result log entry not decided\")};\n        println!(\"CA_EVENT {{\\\"event\\\":\\\"completion\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\",\\\"success\\\":{},\\\"returned_idx\\\":{},\\\"status\\\":\\\"{}\\\",\\\"observed_value\\\":{},\\\"decided_idx\\\":{}}}\",id,success,returned_idx,status,observed_value,h[1].decided_idx().await);\n    } else {\n        println!(\"CA_EVENT {{\\\"event\\\":\\\"bounded_pending\\\",\\\"op_id\\\":\\\"old-request\\\",\\\"entry_id\\\":\\\"{}\\\"}}\",id);\n        pending.abort();\n        let _=pending.await;\n    }\n    drop(h); // Runtime shutdown also cancels any actor still blocked in its select loop.\n}\ntest genuine_delayed_assignment_after_replacement ... CA_EVENT {\"event\":\"setup\",\"op_id\":\"old-request\",\"leader\":1,\"empty\":true,\"nodes\":3}\nCA_EVENT {\"event\":\"admitted\",\"op_id\":\"old-request\",\"entry_id\":\"43db97b7-53d4-47c6-a7b0-9cf04c2eb13a\",\"proposed\":101,\"origin\":2,\"old_leader\":1}\nCA_EVENT {\"event\":\"assigned_held\",\"op_id\":\"old-request\",\"entry_id\":\"43db97b7-53d4-47c6-a7b0-9cf04c2eb13a\",\"assigned_idx\":1,\"old_ballot\":1}\nCA_EVENT {\"event\":\"old_unreplicated\",\"op_id\":\"old-request\",\"entry_id\":\"43db97b7-53d4-47c6-a7b0-9cf04c2eb13a\",\"accepted_message_observed\":true,\"old_outbound_delivered\":0}\nCA_EVENT {\"event\":\"replacement_decided\",\"op_id\":\"old-request\",\"entry_id\":\"43db97b7-53d4-47c6-a7b0-9cf04c2eb13a\",\"assigned_idx\":1,\"observed\":202,\"new_ballot\":2,\"old_ballot\":1,\"pending\":true}\nCA_EVENT {\"event\":\"completion\",\"op_id\":\"old-request\",\"entry_id\":\"43db97b7-53d4-47c6-a7b0-9cf04c2eb13a\",\"success\":true,\"returned_idx\":1,\"status\":\"ok\",\"observed_value\":202,\"decided_idx\":1}\nwarning: profiles for the non root package will be ignored, specify profiles at the workspace root:\npackage:   /tmp/consensus-cargo/omnipaxos/Cargo.toml\nworkspace: /tmp/consensus-cargo/Cargo.toml\nwarning: profiles for the non root package will be ignored, specify profiles at the workspace root:\npackage:   /tmp/consensus-cargo/omnipaxos_storage/Cargo.toml\nworkspace: /tmp/consensus-cargo/Cargo.toml\n   Compiling omnipaxos_runtime v0.1.0 (/tmp/consensus-cargo/omnipaxos_runtime)\n    Finished `test` profile [unoptimized + debuginfo] target(s) in 2.07s\n     Running tests/assurance_generated.rs (.execution/cargo-target/debug/deps/assurance_generated-daef98fc34914d41)\n","exit_code":0,"status":"completed"}}
