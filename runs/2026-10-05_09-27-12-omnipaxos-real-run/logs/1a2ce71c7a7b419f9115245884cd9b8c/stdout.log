{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '260,680p'; nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '90,170p'\"","aggregated_output":"   260\t    /// Enqueue one outgoing message without awaiting. Appends behind any\n   261\t    /// already-buffered messages (preserves order), then tries to drain.\n   262\t    /// Used for both core protocol traffic (via [`Self::flush_outgoing`]) and\n   263\t    /// runtime control-plane messages (`TaggedProposal` / `Assigned`).\n   264\t    fn enqueue_outgoing(&mut self, msg: Message<T>) {\n   265\t        self.outgoing_buf.push(msg);\n   266\t        self.drain_outgoing_buf();\n   267\t    }\n   268\t\n   269\t    /// Pull newly-produced OmniPaxos/BLE messages into `outgoing_buf` and drain.\n   270\t    fn flush_outgoing(&mut self) {\n   271\t        self.op.take_outgoing_messages(&mut self.outgoing_buf);\n   272\t        self.drain_outgoing_buf();\n   273\t    }\n   274\t\n   275\t    /// Push newly-decided entries to a single, freshly-added subscriber. Used\n   276\t    /// only on the immediate catch-up path from `Command::SubscribeDecided`,\n   277\t    /// where there is no shared read to amortize against. Returns `false` if\n   278\t    /// the receiver was already closed.\n   279\t    fn push_to_sub(op: &mut OmniPaxos<T, B>, sub: &mut DecidedSub<T>) -> bool {\n   280\t        let decided = op.get_decided_idx();\n   281\t        if sub.next_idx >= decided {\n   282\t            return true;\n   283\t        }\n   284\t        let Some(entries) = op.read_decided_suffix(sub.next_idx) else {\n   285\t            return true;\n   286\t        };\n   287\t        for entry in entries {\n   288\t            match sub.tx.try_send(entry) {\n   289\t                Ok(()) => sub.next_idx += 1,\n   290\t                Err(async_channel::TrySendError::Full(_)) => return true,\n   291\t                Err(async_channel::TrySendError::Closed(_)) => return false,\n   292\t            }\n   293\t        }\n   294\t        true\n   295\t    }\n   296\t\n   297\t    /// Push newly-decided entries to every subscriber, reading the log suffix\n   298\t    /// **once** and fanning out. Each sub keeps its own cursor, so slow subs\n   299\t    /// don't block fast ones; the storage read is amortized across all subs\n   300\t    /// starting from the trailing sub's position.\n   301\t    fn push_to_all_subs(&mut self) {\n   302\t        if self.decided_subscribers.is_empty() {\n   303\t            return;\n   304\t        }\n   305\t        let cur = self.op.get_decided_idx();\n   306\t        let min_next = self\n   307\t            .decided_subscribers\n   308\t            .iter()\n   309\t            .map(|s| s.next_idx)\n   310\t            .min()\n   311\t            .expect(\"non-empty checked above\");\n   312\t        if min_next >= cur {\n   313\t            return;\n   314\t        }\n   315\t        // Read once, from the trailing sub's position. `entries[i]` is the log\n   316\t        // entry at position `min_next + i`.\n   317\t        let Some(entries) = self.op.read_decided_suffix(min_next) else {\n   318\t            return;\n   319\t        };\n   320\t        // Fan out; drop closed subscribers in place via retain_mut.\n   321\t        self.decided_subscribers.retain_mut(|sub| {\n   322\t            // sub.next_idx should always be >= min_next; guard defensively.\n   323\t            let start = sub.next_idx.saturating_sub(min_next);\n   324\t            for entry in entries.iter().skip(start) {\n   325\t                match sub.tx.try_send(entry.clone()) {\n   326\t                    Ok(()) => sub.next_idx += 1,\n   327\t                    Err(async_channel::TrySendError::Full(_)) => break,\n   328\t                    Err(async_channel::TrySendError::Closed(_)) => return false,\n   329\t                }\n   330\t            }\n   331\t            true\n   332\t        });\n   333\t    }\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`, but the entry went to `buffered_proposals`\n   366\t    /// or out as a `ProposalForward`, not the shared batch buffer — pushing a\n   367\t    /// placeholder for that case would desync `unconfirmed_local`'s FIFO\n   368\t    /// count. `accept_as_leader`'s stable-leader gate means only plain\n   369\t    /// `Command::Append` can hit this case.\n   370\t    fn append_tracked(\n   371\t        &mut self,\n   372\t        intent: TrackIntent,\n   373\t        entry: T,\n   374\t    ) -> Result<Option<(usize, Ballot)>, ProposeErr<T>> {\n   375\t        let accepted_before = self.op.get_accepted_idx();\n   376\t        let batched_before = self.op.get_batched_len();\n   377\t        self.op.append(entry)?;\n   378\t        let accepted_after = self.op.get_accepted_idx();\n   379\t        let batched_after = self.op.get_batched_len();\n   380\t        if accepted_after > accepted_before {\n   381\t            let ballot = self.op.get_promise();\n   382\t            if let TrackIntent::Local(id) = intent {\n   383\t                self.record_assignment(id, accepted_after, ballot);\n   384\t            }\n   385\t            Ok(Some((accepted_after, ballot)))\n   386\t        } else if batched_after > batched_before {\n   387\t            // Genuinely deferred by batching.\n   388\t            self.unconfirmed_local\n   389\t                .push_back((intent, self.op.get_promise()));\n   390\t            Ok(None)\n   391\t        } else {\n   392\t            // Went somewhere else entirely (forwarded, or buffered pending a\n   393\t            // Prepare -> Accept transition) -- nothing entered the shared\n   394\t            // batch buffer, so there's nothing to track here.\n   395\t            Ok(None)\n   396\t        }\n   397\t    }\n   398\t\n   399\t    /// Leader-side accept, for an entry we originate locally (`from: None`)\n   400\t    /// or received via `TaggedProposal` from follower `from`. Populates the\n   401\t    /// pending's `assigned` (or, if buffered by batching, queues a\n   402\t    /// `TrackIntent` for `reconcile_unconfirmed` to resolve later) and\n   403\t    /// returns `(id, assigned_idx)` if accepted immediately, so batch callers\n   404\t    /// can collect these and send one `Assigned` reply for the whole batch.\n   405\t    fn accept_as_leader(\n   406\t        &mut self,\n   407\t        id: EntryId,\n   408\t        entry: T,\n   409\t        from: Option<NodeId>,\n   410\t    ) -> Option<(EntryId, usize)> {\n   411\t        // Only accept while leadership is stable (Accept phase).\n   412\t        let stable_leader =\n   413\t            matches!(self.op.get_current_leader(), Some((pid, true)) if pid == self.pid);\n   414\t        if !stable_leader {\n   415\t            return None;\n   416\t        }\n   417\t        let intent = match from {\n   418\t            None => TrackIntent::Local(id),\n   419\t            Some(from) => TrackIntent::Remote { id, from },\n   420\t        };\n   421\t        match self.append_tracked(intent, entry) {\n   422\t            Ok(Some((after, _ballot))) => Some((id, after)),\n   423\t            Ok(None) => None,\n   424\t            Err(err) => {\n   425\t                self.resolve_pending_failed(id, err);\n   426\t                None\n   427\t            }\n   428\t        }\n   429\t    }\n   430\t\n   431\t    /// Matches everything buffered in `unconfirmed_local` to the index it's\n   432\t    /// assigned once its batch flushes and `get_accepted_idx()` advances.\n   433\t    /// FIFO correspondence is exact here regardless of what added to the\n   434\t    /// shared batch buffer (see `unconfirmed_local`'s doc comment), as long as\n   435\t    /// the ballot hasn't changed since the entry was buffered; if it has,\n   436\t    /// leadership moved on and this index may belong to different writes, so\n   437\t    /// we drop tracking for it and let the caller time out.\n   438\t    fn reconcile_unconfirmed(&mut self) {\n   439\t        let cur_ballot = self.op.get_promise();\n   440\t        let accepted = self.op.get_accepted_idx();\n   441\t        let mut idx = self.last_seen_accepted_idx;\n   442\t        // Entries from a single remote TaggedProposal batch can resolve\n   443\t        // across several different `idx` values here (their own batch may\n   444\t        // have been interleaved with others' writes); group by origin so\n   445\t        // each gets one `Assigned` reply instead of one message per entry.\n   446\t        let mut remote_assigned: HashMap<NodeId, Vec<(EntryId, usize)>> = HashMap::new();\n   447\t        while idx < accepted {\n   448\t            idx += 1;\n   449\t            let Some((intent, ballot)) = self.unconfirmed_local.pop_front() else {\n   450\t                break;\n   451\t            };\n   452\t            if ballot != cur_ballot {\n   453\t                // Leadership moved on since this was buffered; the index may\n   454\t                // belong to different writes. Drop tracking -- Local/Remote\n   455\t                // origins simply time out, matching the ballot-mismatch\n   456\t                // handling in `drain_notifiers` for already-assigned entries.\n   457\t                continue;\n   458\t            }\n   459\t            match intent {\n   460\t                TrackIntent::Untracked => {}\n   461\t                TrackIntent::Local(id) => self.record_assignment(id, idx, ballot),\n   462\t                TrackIntent::Remote { id, from } => {\n   463\t                    remote_assigned.entry(from).or_default().push((id, idx));\n   464\t                }\n   465\t            }\n   466\t        }\n   467\t        self.last_seen_accepted_idx = accepted;\n   468\t\n   469\t        for (from, entries) in remote_assigned {\n   470\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   471\t                from: self.pid,\n   472\t                to: from,\n   473\t                msg: AsyncRuntimeMsg::Assigned {\n   474\t                    ballot: cur_ballot,\n   475\t                    entries,\n   476\t                },\n   477\t            }));\n   478\t        }\n   479\t    }\n   480\t\n   481\t    /// Attempt to dispatch every pending entry that hasn't yet been sent or\n   482\t    /// accepted locally. Called from `Command::AppendNotify` and on each tick,\n   483\t    /// which lets a call issued *before* an election eventually succeed once a\n   484\t    /// leader is known.\n   485\t    fn try_dispatch_undispatched(&mut self) {\n   486\t        let Some((leader, accepted)) = self.op.get_current_leader() else {\n   487\t            return;\n   488\t        };\n   489\t        if leader == self.pid && !accepted {\n   490\t            // We're leader but not yet in Accept phase — leave entries undispatched\n   491\t            // and wait for the next tick.\n   492\t            return;\n   493\t        }\n   494\t        let entries: Vec<(EntryId, T)> = self\n   495\t            .pending\n   496\t            .iter_mut()\n   497\t            .filter_map(|p| p.undispatched.take().map(|entry| (p.id, entry)))\n   498\t            .collect();\n   499\t        if leader == self.pid {\n   500\t            for (id, entry) in entries {\n   501\t                self.accept_as_leader(id, entry, None);\n   502\t            }\n   503\t        } else if !entries.is_empty() {\n   504\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   505\t                from: self.pid,\n   506\t                to: leader,\n   507\t                msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   508\t            }));\n   509\t        }\n   510\t    }\n   511\t\n   512\t    fn handle_runtime_msg(&mut self, arm: AsyncRuntimeMessage<T>) {\n   513\t        match arm.msg {\n   514\t            AsyncRuntimeMsg::TaggedProposal { entries } => {\n   515\t                let cur = self.op.get_current_leader().map(|(p, _)| p);\n   516\t                if cur == Some(self.pid) {\n   517\t                    // Collect accepted assignments and reply to the origin with a\n   518\t                    // single batched `Assigned`.\n   519\t                    let from = arm.from;\n   520\t                    let assigned: Vec<(EntryId, usize)> = entries\n   521\t                        .into_iter()\n   522\t                        .filter_map(|(id, entry)| self.accept_as_leader(id, entry, Some(from)))\n   523\t                        .collect();\n   524\t                    if !assigned.is_empty() {\n   525\t                        let ballot = self.op.get_promise();\n   526\t                        self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   527\t                            from: self.pid,\n   528\t                            to: arm.from,\n   529\t                            msg: AsyncRuntimeMsg::Assigned {\n   530\t                                ballot,\n   531\t                                entries: assigned,\n   532\t                            },\n   533\t                        }));\n   534\t                    }\n   535\t                } else if let Some(new_leader) = cur {\n   536\t                    // Leadership drifted since sender chose us. Hop the whole batch\n   537\t                    // forward, preserving the original `from` so the leader replies\n   538\t                    // to the true origin.\n   539\t                    self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   540\t                        from: arm.from,\n   541\t                        to: new_leader,\n   542\t                        msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   543\t                    }));\n   544\t                }\n   545\t                // Else: no leader; drop. Originators will timeout.\n   546\t            }\n   547\t            AsyncRuntimeMsg::Assigned { ballot, entries } => {\n   548\t                for (id, assigned_idx) in entries {\n   549\t                    self.record_assignment(id, assigned_idx, ballot);\n   550\t                }\n   551\t            }\n   552\t        }\n   553\t    }\n   554\t\n   555\t    /// Given a `(batched_len, accepted_idx)` snapshot taken before some call\n   556\t    /// that may have silently added to the shared batch buffer (a forwarded\n   557\t    /// proposal, an incoming replication batch, a reconfiguration stopsign),\n   558\t    /// pushes a `TrackIntent::Untracked` placeholder in `unconfirmed_local`\n   559\t    /// for each newly-added entry, keeping its FIFO count accurate.\n   560\t    ///\n   561\t    /// Growth is `(accepted_after - accepted_before) + (batched_after -\n   562\t    /// batched_before)`, computed with signed arithmetic and clamped at 0:\n   563\t    /// `accepted_idx` can legitimately *decrease* when a follower's log is\n   564\t    /// truncated by an incoming `AcceptSync` from a new leader, which isn't a\n   565\t    /// case with anything new to track.\n   566\t    fn track_batch_growth(&mut self, batched_before: usize, accepted_before: usize) {\n   567\t        let batched_after = self.op.get_batched_len();\n   568\t        let accepted_after = self.op.get_accepted_idx();\n   569\t        let added = accepted_after as isize - accepted_before as isize + batched_after as isize\n   570\t            - batched_before as isize;\n   571\t        let ballot = self.op.get_promise();\n   572\t        for _ in 0..added.max(0) {\n   573\t            self.unconfirmed_local\n   574\t                .push_back((TrackIntent::Untracked, ballot));\n   575\t        }\n   576\t    }\n   577\t\n   578\t    /// Delivers an incoming `SequencePaxos`/BLE message to the core, tracking\n   579\t    /// any entries it silently adds to the shared batch buffer -- see\n   580\t    /// `track_batch_growth`.\n   581\t    fn handle_incoming_tracked(&mut self, m: Message<T>) {\n   582\t        let batched_before = self.op.get_batched_len();\n   583\t        let accepted_before = self.op.get_accepted_idx();\n   584\t        self.op.handle_incoming(m);\n   585\t        self.track_batch_growth(batched_before, accepted_before);\n   586\t    }\n   587\t\n   588\t    async fn handle_command(&mut self, cmd: Command<T>) {\n   589\t        match cmd {\n   590\t            Command::Append { entry, reply } => {\n   591\t                // Via append_tracked (not self.op.append) so a deferred write\n   592\t                // still gets its unconfirmed_local placeholder, keeping FIFO\n   593\t                // position exact for any append_notify entries batched alongside it.\n   594\t                let res = self\n   595\t                    .append_tracked(TrackIntent::Untracked, entry)\n   596\t                    .map(|_| ());\n   597\t                let _ = reply.send(res);\n   598\t            }\n   599\t            Command::AppendNotify {\n   600\t                entry,\n   601\t                timeout,\n   602\t                reply,\n   603\t            } => {\n   604\t                if self.pending.len() >= self.config.max_pending_appends {\n   605\t                    let _ = reply.send(Err(AppendError::TooManyOutstanding));\n   606\t                    return;\n   607\t                }\n   608\t                let id = EntryId(uuid::Uuid::new_v4());\n   609\t                let timeout = timeout.unwrap_or(self.config.append_notify_timeout);\n   610\t                self.pending.push_back(Pending {\n   611\t                    id,\n   612\t                    undispatched: Some(entry),\n   613\t                    assigned: None,\n   614\t                    deadline: Instant::now() + timeout,\n   615\t                    reply,\n   616\t                });\n   617\t                self.try_dispatch_undispatched();\n   618\t            }\n   619\t            Command::CurrentLeader { reply } => {\n   620\t                let _ = reply.send(self.op.get_current_leader());\n   621\t            }\n   622\t            Command::DecidedIdx { reply } => {\n   623\t                let _ = reply.send(self.op.get_decided_idx());\n   624\t            }\n   625\t            Command::ReadDecidedSuffix { from, reply } => {\n   626\t                let _ = reply.send(self.op.read_decided_suffix(from));\n   627\t            }\n   628\t            Command::SubscribeDecided { from, tx } => {\n   629\t                if self.decided_subscribers.len() >= self.config.max_decided_subscribers {\n   630\t                    // Reject: drop `tx` without storing it, closing the\n   631\t                    // subscriber's channel immediately with no entries delivered.\n   632\t                    return;\n   633\t                }\n   634\t                let mut sub = DecidedSub { next_idx: from, tx };\n   635\t                // Immediate catch-up: push whatever is already decided from `from`.\n   636\t                if Self::push_to_sub(&mut self.op, &mut sub) {\n   637\t                    self.decided_subscribers.push(sub);\n   638\t                }\n   639\t            }\n   640\t            Command::Reconfigure {\n   641\t                new_configuration,\n   642\t                metadata,\n   643\t                reply,\n   644\t            } => {\n   645\t                // Wrapped like handle_incoming_tracked: a stopsign accepted as\n   646\t                // leader is itself an untracked addition to the shared batch buffer.\n   647\t                let batched_before = self.op.get_batched_len();\n   648\t                let accepted_before = self.op.get_accepted_idx();\n   649\t                let res = self.op.reconfigure(new_configuration, metadata);\n   650\t                self.track_batch_growth(batched_before, accepted_before);\n   651\t                let _ = reply.send(res);\n   652\t            }\n   653\t            Command::TryBecomeLeader => {\n   654\t                self.op.try_become_leader();\n   655\t            }\n   656\t            Command::Reconnected { pid } => {\n   657\t                self.op.reconnected(pid);\n   658\t            }\n   659\t        }\n   660\t    }\n   661\t}\n   662\t\n   663\t/// Drives the actor. Runs until all handles are dropped (both `cmd_tx` and\n   664\t/// `incoming_tx` senders closed).\n   665\tpub(crate) async fn run<T, B, R>(mut state: ActorState<T, B>, _rt: PhantomData<fn() -> R>)\n   666\twhere\n   667\t    T: ActorEntry,\n   668\t    B: Storage<T> + Send + 'static,\n   669\t    R: AsyncRuntime,\n   670\t{\n   671\t    let mut tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   672\t    let mut egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   673\t\n   674\t    // async_channel::Receiver is !Unpin; keep it in a Pin<Box<...>> so the Stream\n   675\t    // impl works under select_biased!.\n   676\t    let cmd_rx = std::mem::replace(&mut state.cmd_rx, async_channel::bounded(1).1);\n   677\t    let incoming_rx = std::mem::replace(&mut state.incoming_rx, async_channel::bounded(1).1);\n   678\t    let mut cmd_rx = Box::pin(cmd_rx);\n   679\t    let mut incoming_rx = Box::pin(incoming_rx);\n   680\t\n    90\t    outgoing_rx: async_channel::Receiver<Message<T>>,\n    91\t    incoming_tx: async_channel::Sender<Message<T>>,\n    92\t    decided_channel_capacity: usize,\n    93\t}\n    94\t\n    95\timpl<T> Clone for OmniPaxosHandle<T>\n    96\twhere\n    97\t    T: Entry,\n    98\t{\n    99\t    fn clone(&self) -> Self {\n   100\t        Self {\n   101\t            cmd_tx: self.cmd_tx.clone(),\n   102\t            events_rx: self.events_rx.clone(),\n   103\t            outgoing_rx: self.outgoing_rx.clone(),\n   104\t            incoming_tx: self.incoming_tx.clone(),\n   105\t            decided_channel_capacity: self.decided_channel_capacity,\n   106\t        }\n   107\t    }\n   108\t}\n   109\t\n   110\timpl<T> OmniPaxosHandle<T>\n   111\twhere\n   112\t    T: Entry + Send + 'static,\n   113\t{\n   114\t    /// Append an entry and await its decided log index.\n   115\t    ///\n   116\t    /// Works from any node: the actor tags the entry with a unique id, routes it to\n   117\t    /// the current leader, and resolves the future when the assigned log index is\n   118\t    /// decided. If no leader is known yet, the call waits rather than failing fast --\n   119\t    /// it resolves once a leader is elected, or with `Timeout` if none is elected in\n   120\t    /// time. Fails with:\n   121\t    /// - [`AppendError::Timeout`] if the entry is not decided within\n   122\t    ///   [`RuntimeConfig::append_notify_timeout`] (including when no leader was ever\n   123\t    ///   elected in that time);\n   124\t    /// - [`AppendError::Propose`] if the underlying propose call itself failed (e.g. a\n   125\t    ///   reconfiguration is already pending) -- only when this node owns the pending\n   126\t    ///   call, otherwise it still resolves via `Timeout`;\n   127\t    /// - [`AppendError::Superseded`] if a leader change occurred before decision --\n   128\t    ///   a heuristic, not a certainty; see its doc comment for why, and check the\n   129\t    ///   returned index yourself if you need to know for sure;\n   130\t    /// - [`AppendError::TooManyOutstanding`] if [`RuntimeConfig::max_pending_appends`]\n   131\t    ///   outstanding calls are already queued.\n   132\t    ///\n   133\t    /// Uses [`RuntimeConfig::append_notify_timeout`] as the deadline; use\n   134\t    /// [`Self::append_notify_with_timeout`] to override it for a single call.\n   135\t    pub async fn append_notify(&self, entry: T) -> Result<usize, AppendError<T>> {\n   136\t        self.append_notify_inner(entry, None).await\n   137\t    }\n   138\t\n   139\t    /// Same as [`append_notify`](Self::append_notify), but `timeout` overrides\n   140\t    /// [`RuntimeConfig::append_notify_timeout`] for this call only -- e.g. to give a\n   141\t    /// latency-sensitive caller a shorter deadline, or a bulk/background caller a\n   142\t    /// longer one, without changing the default for every other call.\n   143\t    pub async fn append_notify_with_timeout(\n   144\t        &self,\n   145\t        entry: T,\n   146\t        timeout: Duration,\n   147\t    ) -> Result<usize, AppendError<T>> {\n   148\t        self.append_notify_inner(entry, Some(timeout)).await\n   149\t    }\n   150\t\n   151\t    async fn append_notify_inner(\n   152\t        &self,\n   153\t        entry: T,\n   154\t        timeout: Option<Duration>,\n   155\t    ) -> Result<usize, AppendError<T>> {\n   156\t        let (tx, rx) = oneshot::channel();\n   157\t        self.cmd_tx\n   158\t            .send(Command::AppendNotify {\n   159\t                entry,\n   160\t                timeout,\n   161\t                reply: tx,\n   162\t            })\n   163\t            .await\n   164\t            .map_err(|_| AppendError::Shutdown)?;\n   165\t        rx.await.unwrap_or(Err(AppendError::Shutdown))\n   166\t    }\n   167\t\n   168\t    /// Append an entry without waiting for decision. Mirrors the sync API.\n   169\t    pub async fn append(&self, entry: T) -> Result<(), RuntimeProposeErr<T>> {\n   170\t        let (tx, rx) = oneshot::channel();\n","exit_code":0,"status":"completed"}}
