{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/tests/async_runtime_test.rs | sed -n '1,110p;888,965p'; nl -ba ../agent-source/omnipaxos/src/messages.rs | tail -100; nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '250,275p'\"","aggregated_output":"     1\t//! Integration tests for the async runtime layer.\n     2\t//!\n     3\t//! Sets up a small in-process cluster where each node runs an OmniPaxos actor and messages\n     4\t//! are shuttled between them over in-memory channels, then exercises the async API.\n     5\t#![cfg(feature = \"tokio_runtime\")]\n     6\t\n     7\tuse std::{\n     8\t    collections::HashMap,\n     9\t    sync::{\n    10\t        atomic::{AtomicBool, Ordering},\n    11\t        Arc,\n    12\t    },\n    13\t    time::Duration,\n    14\t};\n    15\t\n    16\t#[cfg(feature = \"unicache\")]\n    17\tuse omnipaxos::unicache::UniCache;\n    18\tuse omnipaxos::{\n    19\t    messages::{sequence_paxos::PaxosMsg, Message},\n    20\t    storage::{Entry, Snapshot},\n    21\t    util::{LogEntry, NodeId},\n    22\t    ClusterConfig, OmniPaxosConfig, ProposeErr, ServerConfig,\n    23\t};\n    24\tuse omnipaxos_runtime::{\n    25\t    spawn_actor, AppendError, OmniPaxosEvent, OmniPaxosHandle, RuntimeConfig, RuntimeProposeErr,\n    26\t    TokioRuntime,\n    27\t};\n    28\tuse omnipaxos_storage::memory_storage::MemoryStorage;\n    29\tuse tokio::time::timeout;\n    30\t\n    31\t/// Minimal Entry type — avoids depending on the `macros` feature. Always derives serde\n    32\t/// traits (an unconditional dev-dependency here) rather than gating on this crate's own\n    33\t/// `serde` feature: under workspace-wide builds (`cargo check --workspace`), `omnipaxos`'s\n    34\t/// `serde` feature can be active (enabled by some other workspace member) independently of\n    35\t/// whether *this* crate's `serde` feature was requested, and `Entry::Snapshot` requires\n    36\t/// `Serialize + Deserialize` whenever the dependency's feature is on, regardless.\n    37\t#[derive(Clone, Debug, Default, PartialEq, serde::Serialize, serde::Deserialize)]\n    38\tstruct TestEntry(u64);\n    39\t\n    40\t#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\n    41\tstruct NoSnapshot;\n    42\t\n    43\timpl Snapshot<TestEntry> for NoSnapshot {\n    44\t    fn create(_entries: &[TestEntry]) -> Self {\n    45\t        NoSnapshot\n    46\t    }\n    47\t    fn merge(&mut self, _delta: Self) {}\n    48\t    fn use_snapshots() -> bool {\n    49\t        false\n    50\t    }\n    51\t}\n    52\t\n    53\t/// No-op UniCache so `cargo test --all-features` can compile without the macros crate.\n    54\t#[cfg(feature = \"unicache\")]\n    55\t#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\n    56\tstruct NoUniCache;\n    57\t\n    58\t#[cfg(feature = \"unicache\")]\n    59\timpl UniCache for NoUniCache {\n    60\t    type T = TestEntry;\n    61\t\n    62\t    fn new() -> Self {\n    63\t        NoUniCache\n    64\t    }\n    65\t\n    66\t    fn try_encode(&mut self, entry: &Self::T) -> <Self::T as Entry>::EncodeResult {\n    67\t        entry.clone()\n    68\t    }\n    69\t\n    70\t    fn decode(&mut self, processed: <Self::T as Entry>::EncodeResult) -> Self::T {\n    71\t        processed\n    72\t    }\n    73\t}\n    74\t\n    75\timpl Entry for TestEntry {\n    76\t    type Snapshot = NoSnapshot;\n    77\t\n    78\t    #[cfg(feature = \"unicache\")]\n    79\t    type Encoded = ();\n    80\t    #[cfg(feature = \"unicache\")]\n    81\t    type Encodable = TestEntry;\n    82\t    #[cfg(feature = \"unicache\")]\n    83\t    type NotEncodable = ();\n    84\t    #[cfg(feature = \"unicache\")]\n    85\t    type EncodeResult = TestEntry;\n    86\t    #[cfg(feature = \"unicache\")]\n    87\t    type UniCache = NoUniCache;\n    88\t}\n    89\t\n    90\tfn build_op(\n    91\t    pid: NodeId,\n    92\t    nodes: Vec<NodeId>,\n    93\t) -> omnipaxos::OmniPaxos<TestEntry, MemoryStorage<TestEntry>> {\n    94\t    let cluster_config = ClusterConfig {\n    95\t        configuration_id: 1,\n    96\t        nodes,\n    97\t        flexible_quorum: None,\n    98\t    };\n    99\t    // `..Default::default()` is needed only when the `logging` feature adds\n   100\t    // extra fields to `ServerConfig`; clippy flags it as redundant under\n   101\t    // feature combinations where it isn't (e.g. `logging` off).\n   102\t    #[allow(clippy::needless_update)]\n   103\t    let server_config = ServerConfig {\n   104\t        pid,\n   105\t        election_tick_timeout: 3,\n   106\t        resend_message_tick_timeout: 5,\n   107\t        buffer_size: 100,\n   108\t        batch_size: 1,\n   109\t        flush_batch_tick_timeout: 100,\n   110\t        leader_priority: 0,\n   888\t/// Regression test for `AppendError::Superseded` actually firing, and for the\n   889\t/// `idx` it carries being accurate and usable to manually verify what really\n   890\t/// happened -- the pattern its doc comment recommends.\n   891\t///\n   892\t/// Cuts one node's OUTGOING traffic entirely (so its own locally-accepted\n   893\t/// entry can never reach anyone) while leaving its INCOMING open (so it\n   894\t/// still learns of a new, higher-ballot leader and updates its own promise,\n   895\t/// which is what the ballot-based check needs to fire). Because the cut\n   896\t/// node's peers never hear about its locally-accepted entry, whichever\n   897\t/// *other* node they elect as the new leader starts from an empty log at\n   898\t/// that position -- this entry is genuinely lost, not just re-ballotted, so\n   899\t/// the test is deterministic rather than racing the (also valid) outcome\n   900\t/// where the entry survives reconciliation.\n   901\t#[tokio::test]\n   902\tasync fn append_notify_superseded_when_entry_truly_lost() {\n   903\t    // 0 = nothing blocked yet; set to the elected leader's pid once known.\n   904\t    let blocked_pid = Arc::new(std::sync::atomic::AtomicU64::new(0));\n   905\t    let filter_blocked_pid = blocked_pid.clone();\n   906\t    let handles = spawn_cluster_with_filter(3, 1, Duration::from_secs(5), move |msg| {\n   907\t        msg.get_sender() != filter_blocked_pid.load(Ordering::SeqCst)\n   908\t    })\n   909\t    .await;\n   910\t\n   911\t    // Wait for the cluster to elect a leader (whichever pid wins), then\n   912\t    // target that node.\n   913\t    let cut = wait_for_leader(&handles).await;\n   914\t    let cut_h = handles.get(&cut).unwrap().clone();\n   915\t\n   916\t    // Cut its outgoing before submitting -- the entry it's about to accept\n   917\t    // locally must never reach anyone else.\n   918\t    blocked_pid.store(cut, Ordering::SeqCst);\n   919\t\n   920\t    let notify_fut = tokio::spawn({\n   921\t        let h = cut_h.clone();\n   922\t        async move { h.append_notify(TestEntry(42)).await }\n   923\t    });\n   924\t\n   925\t    // Wait for one of the other nodes to elect a new leader (peers stop\n   926\t    // hearing `cut` and time out).\n   927\t    let new_leader = timeout(Duration::from_secs(5), async {\n   928\t        loop {\n   929\t            for (&pid, h) in &handles {\n   930\t                if pid == cut {\n   931\t                    continue;\n   932\t                }\n   933\t                if let Some((leader_pid, true)) = h.current_leader().await {\n   934\t                    if leader_pid != cut {\n   935\t                        return leader_pid;\n   936\t                    }\n   937\t                }\n   938\t            }\n   939\t            tokio::time::sleep(Duration::from_millis(5)).await;\n   940\t        }\n   941\t    })\n   942\t    .await\n   943\t    .expect(\"no new leader elected after cutting the old leader's outgoing\");\n   944\t\n   945\t    let res = timeout(Duration::from_secs(5), notify_fut)\n   946\t        .await\n   947\t        .expect(\"append_notify hung\")\n   948\t        .unwrap();\n   949\t    let idx = match res {\n   950\t        Err(AppendError::Superseded { log_entry_idx }) => log_entry_idx,\n   951\t        other => panic!(\"expected Superseded, got {other:?}\"),\n   952\t    };\n   953\t\n   954\t    // Demonstrate + verify the recovery pattern the doc comment recommends:\n   955\t    // submit a fresh entry (filling the now-vacant slot at `idx` under the\n   956\t    // new leader) and check the log there ourselves.\n   957\t    let new_leader_h = handles.get(&new_leader).unwrap().clone();\n   958\t    let refill_idx = timeout(\n   959\t        Duration::from_secs(3),\n   960\t        new_leader_h.append_notify(TestEntry(99)),\n   961\t    )\n   962\t    .await\n   963\t    .expect(\"refill append_notify hung\")\n   964\t    .expect(\"refill append_notify should succeed on the new leader\");\n   965\t    assert_eq!(\n   247\t        pub msg: HeartbeatMsg,\n   248\t    }\n   249\t}\n   250\t\n   251\t#[allow(missing_docs)]\n   252\t/// Message in OmniPaxos. Can be either a `SequencePaxos` message (for log replication),\n   253\t/// a `BLE` message (for leader election), or (when the `async_runtime` feature is enabled)\n   254\t/// an `AsyncRuntime` message used by the actor layer for `append_notify` correlation.\n   255\t#[derive(Clone, Debug)]\n   256\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   257\tpub enum Message<T>\n   258\twhere\n   259\t    T: Entry,\n   260\t{\n   261\t    SequencePaxos(PaxosMessage<T>),\n   262\t    BLE(BLEMessage),\n   263\t    #[cfg(feature = \"async_runtime\")]\n   264\t    AsyncRuntime(AsyncRuntimeMessage<T>),\n   265\t}\n   266\t\n   267\timpl<T> Message<T>\n   268\twhere\n   269\t    T: Entry,\n   270\t{\n   271\t    /// Get the sender id of the message\n   272\t    pub fn get_sender(&self) -> NodeId {\n   273\t        match self {\n   274\t            Message::SequencePaxos(p) => p.from,\n   275\t            Message::BLE(b) => b.from,\n   276\t            #[cfg(feature = \"async_runtime\")]\n   277\t            Message::AsyncRuntime(a) => a.from,\n   278\t        }\n   279\t    }\n   280\t\n   281\t    /// Get the receiver id of the message\n   282\t    pub fn get_receiver(&self) -> NodeId {\n   283\t        match self {\n   284\t            Message::SequencePaxos(p) => p.to,\n   285\t            Message::BLE(b) => b.to,\n   286\t            #[cfg(feature = \"async_runtime\")]\n   287\t            Message::AsyncRuntime(a) => a.to,\n   288\t        }\n   289\t    }\n   290\t}\n   291\t\n   292\t/// Messages exchanged between actor instances for `append_notify` correlation.\n   293\t/// These do not touch the core Paxos protocol — they run alongside it.\n   294\t#[cfg(feature = \"async_runtime\")]\n   295\tpub mod async_runtime {\n   296\t    use crate::{ballot_leader_election::Ballot, storage::Entry, util::NodeId};\n   297\t    #[cfg(feature = \"serde\")]\n   298\t    use serde::{Deserialize, Serialize};\n   299\t\n   300\t    /// A unique identifier for a tagged proposal, used to correlate a\n   301\t    /// forwarded entry with its assigned log index.\n   302\t    #[derive(Copy, Clone, Debug, Eq, PartialEq, Hash)]\n   303\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   304\t    pub struct EntryId(pub uuid::Uuid);\n   305\t\n   306\t    /// Wrapper carrying sender/receiver for an [`AsyncRuntimeMsg`].\n   307\t    #[derive(Clone, Debug)]\n   308\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   309\t    pub struct AsyncRuntimeMessage<T>\n   310\t    where\n   311\t        T: Entry,\n   312\t    {\n   313\t        /// Sender of `msg`.\n   314\t        pub from: NodeId,\n   315\t        /// Receiver of `msg`.\n   316\t        pub to: NodeId,\n   317\t        /// The runtime-message content.\n   318\t        pub msg: AsyncRuntimeMsg<T>,\n   319\t    }\n   320\t\n   321\t    /// Runtime-layer messages used by the actor to correlate `append_notify` calls\n   322\t    /// with the log index the leader eventually assigns.\n   323\t    #[allow(missing_docs)]\n   324\t    #[derive(Clone, Debug)]\n   325\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   326\t    pub enum AsyncRuntimeMsg<T>\n   327\t    where\n   328\t        T: Entry,\n   329\t    {\n   330\t        /// Follower actor → leader actor. Carries entries the originator(s) want\n   331\t        /// tracked, batched into one message. Replaces the untagged\n   332\t        /// `PaxosMsg::ProposalForward` path when the caller used `append_notify`.\n   333\t        TaggedProposal { entries: Vec<(EntryId, T)> },\n   334\t        /// Leader actor → originating follower actor. Carries, for each entry in a\n   335\t        /// previously received `TaggedProposal` batch that was actually accepted,\n   336\t        /// the log index the leader assigned, plus the single full ballot under\n   337\t        /// which the *whole batch* was accepted (one ballot, not per-entry: the\n   338\t        /// leader processes one incoming `TaggedProposal` synchronously with no\n   339\t        /// yield points, so every entry in it is necessarily accepted under the\n   340\t        /// same ballot).\n   341\t        Assigned {\n   342\t            ballot: Ballot,\n   343\t            entries: Vec<(EntryId, usize)>,\n   344\t        },\n   345\t    }\n   346\t}\n   250\t                Err(async_channel::TrySendError::Closed(_)) => {\n   251\t                    // Receiver dropped — user is not draining outgoing. Discard\n   252\t                    // everything remaining; nothing left to retry against.\n   253\t                    return;\n   254\t                }\n   255\t            }\n   256\t        }\n   257\t        self.outgoing_buf.extend(iter);\n   258\t    }\n   259\t\n   260\t    /// Enqueue one outgoing message without awaiting. Appends behind any\n   261\t    /// already-buffered messages (preserves order), then tries to drain.\n   262\t    /// Used for both core protocol traffic (via [`Self::flush_outgoing`]) and\n   263\t    /// runtime control-plane messages (`TaggedProposal` / `Assigned`).\n   264\t    fn enqueue_outgoing(&mut self, msg: Message<T>) {\n   265\t        self.outgoing_buf.push(msg);\n   266\t        self.drain_outgoing_buf();\n   267\t    }\n   268\t\n   269\t    /// Pull newly-produced OmniPaxos/BLE messages into `outgoing_buf` and drain.\n   270\t    fn flush_outgoing(&mut self) {\n   271\t        self.op.take_outgoing_messages(&mut self.outgoing_buf);\n   272\t        self.drain_outgoing_buf();\n   273\t    }\n   274\t\n   275\t    /// Push newly-decided entries to a single, freshly-added subscriber. Used\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"The assignment handler matches only `EntryId`, and notification completion runs on ticks rather than after each incoming message. This leaves a concrete question: could a delayed assignment arrive after a new leader has decided a different entry at that position and produce success? The existing supersession test completes the old call before refilling the position, so it does not answer this case.\n"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > runtime_obligation.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v1.json'))\n# Derived reverse indexes are omitted from authored map.\nfor a in m['activities']: a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None); f.pop('consumed_by',None)\ns=[]\ndef src(id,file,a,b,kind='code_observation'): s.append(dict(id=id,file=file,start_line=a,end_line=b,kind=kind))\nsrc('s-rt-api-contract','omnipaxos_runtime/src/handle.rs',114,165,'interface_statement')\nsrc('s-rt-error-contract','omnipaxos_runtime/src/event.rs',33,68,'interface_statement')\nsrc('s-rt-assignment','omnipaxos_runtime/src/actor.rs',335,479)\nsrc('s-rt-dispatch','omnipaxos_runtime/src/actor.rs',481,553)\nsrc('s-rt-admission','omnipaxos_runtime/src/actor.rs',588,618)\nsrc('s-rt-loop','omnipaxos_runtime/src/actor.rs',663,710)\nsrc('s-rt-egress','omnipaxos_runtime/src/actor.rs',232,273)\nsrc('s-rt-lifecycle','omnipaxos_runtime/src/handle.rs',282,324)\nsrc('s-rt-wire','omnipaxos/src/messages.rs',292,345,'interface_statement')\nsrc('s-rt-test-superseded','omnipaxos_runtime/tests/async_runtime_test.rs',888,964,'test_expectation')\nassignment=dict(id='b-rt-assignment',primary_activity='A7',execution_owner='ActorState at origin and current leader',protocol_context='Pending append EntryId and assigned (prefix length, ballot)',trigger='AppendNotify command, dispatch tick, TaggedProposal, batch reconciliation or Assigned reception',source_ids=['s-rt-assignment','s-rt-dispatch','s-rt-admission','s-rt-wire'],implementation_guards=['Pending admission is capped. Stable self leader in Accept is required by accept_as_leader. Batch reconciliation drops intent when its ballot differs from current promise. record_assignment matches only EntryId.'],writes=['Creates a unique EntryId; keeps undispatched entry until routing or local append. Records (accepted_after, ballot) immediately for local flushed append; deferred batch intent is reconciled later. Remote leader returns Assigned; origin records it without checking current ballot or sender.'],external_effects=['TaggedProposal to known leader; Assigned to origin for accepted entries.'],important_branches=['Unassigned pending calls are not superseded merely by ballot change. A pending EntryId persists until result or timeout.'],produces_fact_ids=['f-rt-assignment'],cross_activity_effects={'A1':'Uses accepted prefix position to associate a proposal with eventual decided prefix.','A2':'Assignment carries the acceptance ballot; incoming Assigned does not independently establish validity in the current ballot.'},unknowns=['Can a real old leader assignment remain deliverable after its unchosen entry has been replaced and decided under a new leader?'])\nnotify=dict(id='b-rt-notify',primary_activity='A7',execution_owner='Origin ActorState',protocol_context='Pending EntryId with optional assigned prefix length and ballot',trigger='Runtime tick after events, dispatch and batch reconciliation',source_ids=['s-runtime-drain','s-rt-loop','s-rt-api-contract','s-rt-error-contract'],reads=['Pending assigned index and ballot, current core decided index, promise and deadline'],implementation_guards=['Success when assigned index <= current decided prefix length. Otherwise a lower assignment ballot yields Superseded. Otherwise expiry yields Timeout.'],writes=['Removes completed pending call and sends oneshot result.'],external_effects=['append_notify future returns Ok(index), Superseded or Timeout.'],important_branches=['Success is selected before ballot supersession. Incoming messages and commands do not themselves drain notifiers.'],consumes_fact_ids=['f-rt-assignment','f-decided'],cross_activity_effects={'A1':'Interprets a decided boundary as completion of an individual proposal.','A2':'Supersession depends on ballot only when success branch did not match.'},existing_protections=['Assignments are correlated by EntryId. Missing assignments cannot produce success. Unassigned calls eventually time out.'],unknowns=['Does legal delayed assignment plus a replacement decision cause the origin to return success for an entry absent from that decided position?'])\nm['behaviors'] += [assignment,notify]\nm['facts'].append(dict(id='f-rt-assignment',meaning='Origin pending call records a leader-supplied or locally established association between its EntryId and an accepted prefix length under an assignment ballot.',identity={'operation':'Pending EntryId','origin':'origin actor instance'},validity_context='Record exists while the pending call survives. Receipt is correlated by EntryId; it does not itself establish that the same value occupies this position in a later ballot.',representation=['Pending.assigned: Option<(usize, Ballot)>','AsyncRuntimeMsg::Assigned'],durability='Volatile actor state and transport message; not core persisted log identity.',recovery='No pending-call reconstruction is implemented in the read actor constructor; actor termination drops pending replies.',source_ids=['s-runtime-pending','s-rt-assignment','s-rt-dispatch','s-rt-loop'],unknowns=[]))\nb=next(b for b in m['behaviors'] if b['id']=='b-client')\nb['unknowns']=['Batch tracking across untracked core writes and rejected remote proposals remains separate from the selected delayed-assignment question.']\nb['source_ids'] += ['s-rt-api-contract','s-rt-assignment','s-rt-dispatch','s-rt-loop']\nb['external_effects'].append('Async append_notify tags the request, records an assignment, then resolves on a tick from current decided boundary; detailed conditional behavior is in b-rt-assignment and b-rt-notify.')\nsurf=next(x for x in m['surfaces'] if x['entry_point']=='ActorState::drain_notifiers')\nsurf.update(disposition='mapped',behavior_ids=['b-rt-assignment','b-rt-notify'],reason='Assignment receipt matches EntryId without current-ballot validation; notifier tick checks decided prefix before supersession. Investigate a legal delayed assignment after a replacement decision.',source_ids=['s-runtime-drain','s-rt-assignment','s-rt-dispatch','s-rt-loop'])\nm['core_overview']['open_details']=[x if x\"'!='\"'Runtime assignment/completion correlation across changed ballots.' else 'Runtime delayed assignment can survive without a recorded ballot until Assigned arrives; whether it can falsely correlate a replacement decision remains unresolved.' for x in m['core_overview']['open_details']]\nfor a in m['activities']:\n if a['class_id']=='A7':\n  a['realization_summary']='Core append admits proposals for later decision. Async runtime tags append_notify requests, obtains local or remote assignments and resolves on ticks using the current decided boundary, supersession and timeout branches.'\n  a['source_ids']+=['s-rt-api-contract','s-rt-assignment','s-rt-dispatch','s-runtime-drain','s-rt-loop']\njson.dump(m,open('runtime-map.json','w'),indent=2)\nq=dict(question='Can append_notify return Ok for a proposal whose old-leader assignment arrives after a different entry has become decided at that assigned position?',importance='False success can make an application acknowledge a write absent from the replicated decided log; the core consensus log could remain consistent while client completion is incorrect.',disposition='ready_for_check',preferred_check='controlled_schedule',source_ids=['s-rt-api-contract','s-rt-error-contract','s-rt-assignment','s-rt-dispatch','s-runtime-drain','s-rt-loop','s-formation'],participants=['Origin follower actor','Old leader actor','New leader and quorum'],objects=['EntryId-tagged proposal','Assigned message','Decided entry at assigned prefix position'],contexts=['One configuration with stable identities, no compaction or crash','Old unchosen suffix excluded from new leader prepare quorum','Delayed genuine old leader message; per-link FIFO can be preserved'],event_paths=['Origin append_notify -> old leader TaggedProposal -> actual append -> delayed Assigned','New leader prepare quorum omitting old leader -> replacement append and decision -> origin receives genuine Assigned -> notification tick'],activity_classes=['A7','A1','A2'],behavior_ids=['b-rt-assignment','b-rt-notify'],fact_ids=['f-rt-assignment'],supporting_behavior_ids={'b-prepare':'New ballot selects history from a quorum excluding the old unchosen suffix.','b-decide':'Establishes the replacement decided prefix consumed by notification.','b-authority':'Changes origin promise before stale assignment arrives.','b-read':'Observes the actual decided entry for the returned assignment position.'},obligation_relation_kind='consumption',counterevidence=['EntryId prevents association with unrelated pending calls.','Batch reconciliation checks ballot equality.','Superseded is returned if assignment is already recorded and an intervening tick sees the new promise before the replacement is decided.','Existing supersession test waits for old call completion before replacement; it confirms that narrower guard path.','An old entry may legitimately survive a leadership change, so changed ballot alone is not a violation oracle.'],unknowns=['Clean execution must establish actual old entry acceptance, absence from new prepare quorum, replacement decision and late assignment for the same EntryId without forged messages or excluded FIFO constraints.'],priority=3,trigger_rationale='record_assignment admits an old real assignment by EntryId alone, while success checks position before ballot supersession. A fully assigned pending call is not necessary during authority transition. Source reading resolves guard ownership but cannot supply a legal executed history. This concrete identity/completion discriminator is more direct than the still-unclear cross-configuration routing contract; a controlled public-API check is justified.')\nclaim=dict(id='claim-notify-same-entry',kind='obligation',concern='implementation_semantics',description='For an admitted append_notify operation, an Ok assigned position must identify that operation\\\\'s proposed entry in the decided log; a different entry decided at that position under a later ballot must not satisfy the operation.',source_ids=['s-rt-api-contract','s-rt-wire','s-rt-error-contract','s-log-contract'],scope=dict(description='Async runtime client completion within one valid fixed configuration, genuine non-Byzantine protocol/runtime messages, and successful storage. Focus on a delayed assignment across leader change when an old unchosen entry is replaced.',assumptions=['Unique operation identity and distinct proposed values allow independent correlation.','No compaction obscures the compared entry.','Application transports actual messages to their intended recipients; delay and partition preserve per-directed-link FIFO among delivered messages.'],excluded=['No eventual-success or timing guarantee is imposed. Timeout, Superseded or a still-pending call is not itself a violation.','No claim of conflicting core decisions or persistent-storage failure.']),pending=[],grounding=dict(source_ids=['s-rt-api-contract','s-rt-wire','s-rt-error-contract','s-log-contract'],derivation='The public API promises to append an entry and await its decided log index. Wire identity associates the forwarded entry with the index actually assigned by the leader. Superseded documentation explicitly permits abandoning an uncertain operation after leadership change; it does not authorize successful completion for another entry. The obligation checks successful identity correspondence, not eventual commitment or mandatory supersession.',applicability='A public append_notify operation and its actual completion within the same configured log; assignment produced by captured code and no compaction.',unresolved=[],conflicts=[],alternatives=['Success after leader change is permitted if the same proposed entry was adopted and decided.']))\nsub=dict(action='obligation',rationale='Ground the client completion responsibility and prepare a controlled schedule around a genuine delayed assignment; source analysis has not established a violation.',sources=s,map_path='runtime-map.json',map_changes={'b-client':dict(impact='clarification',source_ids=['s-rt-api-contract','s-rt-assignment','s-rt-loop'],rationale='Replace generic runtime unread reminder with actual assignment/notification paths and independent remaining batching questions.',preserves='Core append admission and all existing core responsibilities remain unchanged.'),'f-decided':dict(impact='dependency',source_ids=['s-runtime-drain','s-rt-loop'],rationale='Add the runtime notification consumer that interprets the already-described local decided boundary.',preserves='The boundary meaning, identity, durability and core producers are unchanged; there are no prior candidates or obligations to revise.')},question=q,obligation=claim,bindings=[dict(id='binding-notify-completion',material_id='s-runtime-drain',symbol='drain_notifiers',start_line=201,end_line=222,description='Consumes assigned position and ballot to complete append_notify; success precedes supersession.',pending=[],associations=[dict(claim_id='claim-notify-same-entry',source_ids=['s-rt-api-contract','s-runtime-drain'],rationale='Public completion requirement is implemented by this result-producing function.')])],feedback=dict(ref_ids=['surface:ActorState::drain_notifiers','s-rt-assignment','s-rt-loop','s-rt-test-superseded'],answered='Assignment is matched by EntryId with no current-ballot check; only tick drains notifiers. An unassigned pending call survives authority change until timeout. Existing supersession coverage checks an already-assigned call and waits for its error before replacement.',remaining=['Execute a legal real-producer history with late assignment and a different decided entry; compare only success with actual log identity.'],understanding='updated',rationale='The ordering and producer guards narrow the question without presuming failure.'))\njson.dump(sub,open('runtime-obligation.json','