{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"'];\nfor k in ['CandidateSubmission','ClaimDraft','BindingDraft']:\n print(k,json.dumps(s.get(k),indent=2))\np=json.load(open('../product-schemas.json'))\nprint('graphdefs',list(p['GraphPatch']['\"'$defs'\"']))\nPY\"","aggregated_output":"CandidateSubmission {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\nClaimDraft {\n  \"additionalProperties\": false,\n  \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"obligation\",\n        \"assumption\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"concern\": {\n      \"default\": \"implementation_semantics\",\n      \"enum\": [\n        \"consensus_safety\",\n        \"bounded_liveness\",\n        \"implementation_semantics\"\n      ],\n      \"title\": \"Concern\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"description\": \"Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability\",\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"description\": \"Located materials; file kinds do not establish normative authority\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"scope\": {\n      \"$ref\": \"#/$defs/Scope\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    },\n    \"grounding\": {\n      \"$ref\": \"#/$defs/Grounding\",\n      \"default\": {\n        \"source_ids\": [],\n        \"expectation_ids\": [],\n        \"binding_ids\": [],\n        \"derivation\": \"\",\n        \"applicability\": \"\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      }\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"kind\",\n    \"description\",\n    \"source_ids\",\n    \"scope\",\n    \"pending\"\n  ],\n  \"title\": \"ClaimDraft\",\n  \"type\": \"object\"\n}\nBindingDraft {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"associations\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingAssociation\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Associations\",\n      \"type\": \"array\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"associations\",\n    \"id\",\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\",\n    \"description\",\n    \"pending\"\n  ],\n  \"title\": \"BindingDraft\",\n  \"type\": \"object\"\n}\ngraphdefs ['AuditQuestion', 'BindingAssociation', 'BindingDraft', 'ClaimDraft', 'CodeAnchor', 'Grounding', 'RelationDraft', 'Scope', 'UnitDraft']\n","exit_code":0,"status":"completed"}}
