omnipaxos_macros\"]\nunicache = [\"lru\", \"num-traits\", \"linked_hash_set\"]\nasync_runtime = [\"dep:uuid\"]\n# Explicit serde feature so it can chain uuid's serde support when both are on.\nserde = [\"dep:serde\", \"uuid?/serde\"]\n\ndefault = [\"macros\"]\n\n[profile.release]\nlto = true\n","exit_code":0,"status":"completed"}}
