{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '300,397p;680,790p'; cat ../agent-source/omnipaxos_runtime/Cargo.toml; nl -ba ../agent-source/omnipaxos_runtime/src/event.rs | head -115; grep -n 'Assigned\\\\|Superseded\\\\|stale' ../agent-source/omnipaxos_runtime/tests/*.rs\"","aggregated_output":"   300\t    /// starting from the trailing sub's position.\n   301\t    fn push_to_all_subs(&mut self) {\n   302\t        if self.decided_subscribers.is_empty() {\n   303\t            return;\n   304\t        }\n   305\t        let cur = self.op.get_decided_idx();\n   306\t        let min_next = self\n   307\t            .decided_subscribers\n   308\t            .iter()\n   309\t            .map(|s| s.next_idx)\n   310\t            .min()\n   311\t            .expect(\"non-empty checked above\");\n   312\t        if min_next >= cur {\n   313\t            return;\n   314\t        }\n   315\t        // Read once, from the trailing sub's position. `entries[i]` is the log\n   316\t        // entry at position `min_next + i`.\n   317\t        let Some(entries) = self.op.read_decided_suffix(min_next) else {\n   318\t            return;\n   319\t        };\n   320\t        // Fan out; drop closed subscribers in place via retain_mut.\n   321\t        self.decided_subscribers.retain_mut(|sub| {\n   322\t            // sub.next_idx should always be >= min_next; guard defensively.\n   323\t            let start = sub.next_idx.saturating_sub(min_next);\n   324\t            for entry in entries.iter().skip(start) {\n   325\t                match sub.tx.try_send(entry.clone()) {\n   326\t                    Ok(()) => sub.next_idx += 1,\n   327\t                    Err(async_channel::TrySendError::Full(_)) => break,\n   328\t                    Err(async_channel::TrySendError::Closed(_)) => return false,\n   329\t                }\n   330\t            }\n   331\t            true\n   332\t        });\n   333\t    }\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`, but the entry went to `buffered_proposals`\n   366\t    /// or out as a `ProposalForward`, not the shared batch buffer — pushing a\n   367\t    /// placeholder for that case would desync `unconfirmed_local`'s FIFO\n   368\t    /// count. `accept_as_leader`'s stable-leader gate means only plain\n   369\t    /// `Command::Append` can hit this case.\n   370\t    fn append_tracked(\n   371\t        &mut self,\n   372\t        intent: TrackIntent,\n   373\t        entry: T,\n   374\t    ) -> Result<Option<(usize, Ballot)>, ProposeErr<T>> {\n   375\t        let accepted_before = self.op.get_accepted_idx();\n   376\t        let batched_before = self.op.get_batched_len();\n   377\t        self.op.append(entry)?;\n   378\t        let accepted_after = self.op.get_accepted_idx();\n   379\t        let batched_after = self.op.get_batched_len();\n   380\t        if accepted_after > accepted_before {\n   381\t            let ballot = self.op.get_promise();\n   382\t            if let TrackIntent::Local(id) = intent {\n   383\t                self.record_assignment(id, accepted_after, ballot);\n   384\t            }\n   385\t            Ok(Some((accepted_after, ballot)))\n   386\t        } else if batched_after > batched_before {\n   387\t            // Genuinely deferred by batching.\n   388\t            self.unconfirmed_local\n   389\t                .push_back((intent, self.op.get_promise()));\n   390\t            Ok(None)\n   391\t        } else {\n   392\t            // Went somewhere else entirely (forwarded, or buffered pending a\n   393\t            // Prepare -> Accept transition) -- nothing entered the shared\n   394\t            // batch buffer, so there's nothing to track here.\n   395\t            Ok(None)\n   396\t        }\n   397\t    }\n   680\t\n   681\t    loop {\n   682\t        select_biased! {\n   683\t            _ = tick_fut => {\n   684\t                state.op.tick();\n   685\t                state.detect_and_emit_events().await;\n   686\t                state.try_dispatch_undispatched();\n   687\t                state.reconcile_unconfirmed();\n   688\t                state.drain_notifiers();\n   689\t                state.push_to_all_subs();\n   690\t                tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   691\t            }\n   692\t            _ = egress_fut => {\n   693\t                state.flush_outgoing();\n   694\t                egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   695\t            }\n   696\t            in_msg = incoming_rx.next() => {\n   697\t                match in_msg {\n   698\t                    Some(Message::AsyncRuntime(arm)) => state.handle_runtime_msg(arm),\n   699\t                    Some(m) => state.handle_incoming_tracked(m),\n   700\t                    None => break,\n   701\t                }\n   702\t            }\n   703\t            cmd = cmd_rx.next() => {\n   704\t                match cmd {\n   705\t                    Some(c) => state.handle_command(c).await,\n   706\t                    None => break,\n   707\t                }\n   708\t            }\n   709\t        }\n   710\t    }\n   711\t}\n   712\t\n   713\t/// Drops the oldest elements of `buf` until its length is at most `cap`, preserving\n   714\t/// the relative order of what remains. A no-op if `buf` is already within `cap`.\n   715\tfn trim_oldest<M>(buf: &mut Vec<M>, cap: usize) {\n   716\t    if buf.len() > cap {\n   717\t        let excess = buf.len() - cap;\n   718\t        buf.drain(..excess);\n   719\t    }\n   720\t}\n   721\t\n   722\t#[cfg(test)]\n   723\tmod tests {\n   724\t    use super::trim_oldest;\n   725\t\n   726\t    #[test]\n   727\t    fn trim_oldest_drops_front_keeps_cap_most_recent() {\n   728\t        let mut buf = vec![1, 2, 3, 4, 5];\n   729\t        trim_oldest(&mut buf, 3);\n   730\t        assert_eq!(buf, vec![3, 4, 5]);\n   731\t    }\n   732\t\n   733\t    #[test]\n   734\t    fn trim_oldest_is_noop_when_within_cap() {\n   735\t        let mut buf = vec![1, 2, 3];\n   736\t        trim_oldest(&mut buf, 5);\n   737\t        assert_eq!(buf, vec![1, 2, 3]);\n   738\t    }\n   739\t\n   740\t    #[test]\n   741\t    fn trim_oldest_is_noop_when_exactly_at_cap() {\n   742\t        let mut buf = vec![1, 2, 3];\n   743\t        trim_oldest(&mut buf, 3);\n   744\t        assert_eq!(buf, vec![1, 2, 3]);\n   745\t    }\n   746\t\n   747\t    #[test]\n   748\t    fn trim_oldest_can_drop_everything() {\n   749\t        let mut buf = vec![1, 2, 3];\n   750\t        trim_oldest(&mut buf, 0);\n   751\t        assert!(buf.is_empty());\n   752\t    }\n   753\t}\n[package]\nname = \"omnipaxos_runtime\"\nversion = \"0.1.0\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"Async runtime actor layer for OmniPaxos.\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\nkeywords = [\"omnipaxos\", \"paxos\", \"consensus\", \"distributed-systems\", \"async\"]\ncategories = [\"asynchronous\", \"concurrency\", \"network-programming\"]\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nomnipaxos = { version = \"0.2.3\", path = \"../omnipaxos\", features = [\"async_runtime\"] }\nfutures = \"0.3\"\nasync-channel = \"2\"\nfutures-timer = \"3\"\nuuid = { version = \"1\", features = [\"v4\"] }\ntokio = { version = \"1\", optional = true, features = [\"rt\", \"time\", \"sync\", \"macros\"] }\n\n[dev-dependencies]\nomnipaxos_storage = { version = \"0.2.2\", path = \"../omnipaxos_storage\" }\ntokio = { version = \"1\", features = [\"rt-multi-thread\", \"sync\", \"time\", \"macros\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\n\n[features]\ntokio_runtime = [\"dep:tokio\"]\nunicache = [\"omnipaxos/unicache\"]\nserde = [\"omnipaxos/serde\"]\nlogging = [\"omnipaxos/logging\"]\n     1\tuse core::time::Duration;\n     2\t\n     3\tuse futures::channel::oneshot;\n     4\t\n     5\tuse omnipaxos::{\n     6\t    storage::Entry,\n     7\t    util::{LogEntry, NodeId},\n     8\t    ClusterConfig, ProposeErr,\n     9\t};\n    10\t\n    11\t/// A state transition observed by the actor and broadcast on the event stream.\n    12\t#[derive(Debug, Clone)]\n    13\tpub enum OmniPaxosEvent {\n    14\t    /// A new leader was observed on this node.\n    15\t    LeaderElected {\n    16\t        /// The pid of the elected leader.\n    17\t        pid: NodeId,\n    18\t        /// Whether this node's phase is `Phase::Accept`.\n    19\t        accepted: bool,\n    20\t    },\n    21\t    /// The decided index advanced. The value is the new decided index.\n    22\t    Decided {\n    23\t        /// The new decided index.\n    24\t        new_decided_idx: usize,\n    25\t    },\n    26\t    /// A reconfiguration StopSign was decided.\n    27\t    Reconfigured {\n    28\t        /// The log index at which the StopSign was decided.\n    29\t        stop_sign_idx: usize,\n    30\t    },\n    31\t}\n    32\t\n    33\t/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n    34\t#[derive(Debug)]\n    35\tpub enum AppendError<T>\n    36\twhere\n    37\t    T: Entry,\n    38\t{\n    39\t    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n    40\t    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n    41\t    /// pending). Unlike the other variants, this is resolved immediately rather than\n    42\t    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n    43\t    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n    44\t    /// leader). If the failure happens on a different node than the origin, the origin\n    45\t    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n    46\t    /// require a new wire message.\n    47\t    Propose(ProposeErr<T>),\n    48\t    /// A leader change occurred after the entry was accepted at the given index but\n    49\t    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n    50\t    /// required to adopt any value a majority-overlapping quorum may have already\n    51\t    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n    52\t    /// new ballot -- we just stop waiting rather than confirm it. Check\n    53\t    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n    54\t    /// at that index if you need to know for sure before re-appending.\n    55\t    Superseded {\n    56\t        /// The log index the entry was assigned before the leader change.\n    57\t        log_entry_idx: usize,\n    58\t    },\n    59\t    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n    60\t    Timeout,\n    61\t    /// The actor has shut down before the entry could be decided.\n    62\t    Shutdown,\n    63\t    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n    64\t    /// outstanding `append_notify` calls; this one was rejected immediately rather\n    65\t    /// than queued. Nothing was proposed, so it's safe to retry (ideally after a\n    66\t    /// backoff, since the backlog needs time to drain).\n    67\t    TooManyOutstanding,\n    68\t}\n    69\t\n    70\t/// Error returned by [`OmniPaxosHandle::append`](super::OmniPaxosHandle::append) and\n    71\t/// [`OmniPaxosHandle::reconfigure`](super::OmniPaxosHandle::reconfigure). Distinct from\n    72\t/// [`AppendError`]: these calls don't track decision, so they only ever fail\n    73\t/// synchronously -- either the propose call itself was rejected, or the actor is gone.\n    74\t#[derive(Debug)]\n    75\tpub enum RuntimeProposeErr<T>\n    76\twhere\n    77\t    T: Entry,\n    78\t{\n    79\t    /// The underlying propose call failed (e.g. a reconfiguration is already pending,\n    80\t    /// or an invalid cluster config was proposed).\n    81\t    Propose(ProposeErr<T>),\n    82\t    /// The actor has shut down.\n    83\t    Shutdown,\n    84\t}\n    85\t\n    86\t/// Commands sent from an [`OmniPaxosHandle`](super::OmniPaxosHandle) to the actor task.\n    87\t///\n    88\t/// This type is `pub(crate)` because it is an implementation detail of the actor <-> handle\n    89\t/// protocol.\n    90\tpub(crate) enum Command<T>\n    91\twhere\n    92\t    T: Entry,\n    93\t{\n    94\t    Append {\n    95\t        entry: T,\n    96\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n    97\t    },\n    98\t    AppendNotify {\n    99\t        entry: T,\n   100\t        /// Overrides [`RuntimeConfig::append_notify_timeout`](super::RuntimeConfig::append_notify_timeout)\n   101\t        /// for this call only, if `Some`.\n   102\t        timeout: Option<Duration>,\n   103\t        reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n   104\t    },\n   105\t    CurrentLeader {\n   106\t        reply: oneshot::Sender<Option<(NodeId, bool)>>,\n   107\t    },\n   108\t    DecidedIdx {\n   109\t        reply: oneshot::Sender<usize>,\n   110\t    },\n   111\t    ReadDecidedSuffix {\n   112\t        from: usize,\n   113\t        reply: oneshot::Sender<Option<Vec<LogEntry<T>>>>,\n   114\t    },\n   115\t    SubscribeDecided {\n291:/// `TaggedProposal`, used to never get an `Assigned` reply if the leader\n294:/// only sent `Assigned` for entries accepted *immediately*. `batch_size = 2`\n882:        | Err(AppendError::Superseded { .. })\n888:/// Regression test for `AppendError::Superseded` actually firing, and for the\n950:        Err(AppendError::Superseded { log_entry_idx }) => log_entry_idx,\n951:        other => panic!(\"expected Superseded, got {other:?}\"),\n1046:/// Notify-path (`TaggedProposal` / `Assigned`) backpressure is covered by\n1137:/// Regression test: `TaggedProposal` / `Assigned` used to go out via\n1145:/// drain so accepting that proposal must enqueue an `Assigned` against a\n1176:    // --- Phase 2: Assigned on a full leader outgoing channel ---\n1187:        .expect(\"leader stalled enqueueing Assigned on a full outgoing channel\");\n1191:    // (Ok, Timeout, or Superseded from leadership churn during the pause) --\n","exit_code":0,"status":"completed"}}
