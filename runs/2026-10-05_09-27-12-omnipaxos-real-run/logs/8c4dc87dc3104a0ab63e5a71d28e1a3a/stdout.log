{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"grep -n 'pub .*fn' ../agent-source/omnipaxos_runtime/src/handle.rs; cat ../agent-source/omnipaxos_runtime/src/lib.rs; cat ../agent-source/Cargo.toml; cat ../build-inputs/targets/omnipaxos/assurance_generated/basis.json | head -60; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"'];print(json.dumps(s['CheckSubmission'],indent=2))\nPY\"","aggregated_output":"135:    pub async fn append_notify(&self, entry: T) -> Result<usize, AppendError<T>> {\n143:    pub async fn append_notify_with_timeout(\n169:    pub async fn append(&self, entry: T) -> Result<(), RuntimeProposeErr<T>> {\n182:    pub async fn current_leader(&self) -> Option<(NodeId, bool)> {\n196:    pub async fn decided_idx(&self) -> usize {\n210:    pub async fn read_decided_suffix(&self, from: usize) -> Option<Vec<LogEntry<T>>> {\n224:    pub async fn reconfigure(\n245:    pub async fn try_become_leader(&self) {\n250:    pub async fn reconnected(&self, pid: NodeId) {\n257:    pub fn subscribe_events(&self) -> async_channel::Receiver<OmniPaxosEvent> {\n271:    pub async fn subscribe_decided(&self, from: usize) -> async_channel::Receiver<LogEntry<T>> {\n284:    pub fn outgoing_messages(&self) -> async_channel::Receiver<Message<T>> {\n289:    pub async fn handle_incoming(&self, m: Message<T>) {\n295:pub fn spawn_actor<T, B, R>(op: OmniPaxos<T, B>, cfg: RuntimeConfig) -> OmniPaxosHandle<T>\n//! Async runtime actor layer for OmniPaxos.\n//!\n//! The [`AsyncRuntime`] trait abstracts over the async executor so this crate can be used\n//! on top of any runtime. A ready-to-use [`TokioRuntime`] is provided behind the\n//! `tokio_runtime` feature.\n//!\n//! The main entry point is [`spawn_actor`], which takes an\n//! [`OmniPaxos`](omnipaxos::OmniPaxos) instance and returns an [`OmniPaxosHandle`]. The\n//! handle is cloneable and provides `async` methods to append entries and observe state\n//! transitions.\n//!\n//! The runtime does NOT own message transport: use [`OmniPaxosHandle::outgoing_messages`]\n//! to drain outgoing messages and [`OmniPaxosHandle::handle_incoming`] to deliver\n//! incoming ones. This keeps the crate free of I/O dependencies and lets users plug in\n//! any transport (TCP, QUIC, in-process channels, etc.).\n\n#![deny(missing_docs)]\n\nmod actor;\nmod event;\nmod handle;\nmod traits;\n\n#[cfg(feature = \"tokio_runtime\")]\nmod tokio_rt;\n\npub use event::{AppendError, OmniPaxosEvent, RuntimeProposeErr};\npub use handle::{spawn_actor, OmniPaxosHandle, RuntimeConfig};\npub use omnipaxos::messages::EntryId;\npub use traits::{ActorEntry, AsyncRuntime};\n\n#[cfg(feature = \"tokio_runtime\")]\npub use tokio_rt::TokioRuntime;\n[workspace]\nresolver = \"2\"\nmembers = [\n    \"omnipaxos\",\n    \"omnipaxos_storage\",\n    \"omnipaxos_macros\",\n    \"omnipaxos_runtime\",\n    \"omnipaxos_ui\",\n    \"examples/kv_store\",\n    \"examples/kv_store_async\",\n    \"examples/dashboard\",\n]\n\n[profile.release]\nlto = true\n{\n  \"snapshot_id\": \"d250f12902644004915d0c5133d5f7a9\",\n  \"source_files\": {\n    \".gitignore\": \"8409c7441e162cb655b6af32877544b2b1240f7bdf0b1758839b035cfd5fa882\",\n    \"Cargo.toml\": \"60d6df52da137a445b9e3bf769e033d90f9210be286f5a65b015703b386768ec\",\n    \"LICENSE\": \"c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4\",\n    \"README.md\": \"11e56a09ff34ab461544976dab476bf5270b9cac00f4639edc905601d113bfd4\",\n    \"check.sh\": \"d4717fdb4f924f9e4b67dfc217e515294593d0480977f5fdfa72438e796e3f05\",\n    \"crates-checklist.md\": \"f801eae0a16d86f9f3deb5aad51c8cd11923b867b1f97f63affa58f605d04fde\",\n    \"overview.png\": \"9bb01aa69929b0ed96317985ea4f02ce4e5ba8a6e8141dc2eecbec7ba0e414b7\",\n    \"pull_request_template.md\": \"fb23b3d0861b35d32b10fd9482dd00f33d0a29b79b53c37208bd2cb49f51dc40\",\n    \"rustfmt.toml\": \"b664564e1dafbcc95328f88939fd014f1578f587f70b8d08733c18570555602b\",\n   