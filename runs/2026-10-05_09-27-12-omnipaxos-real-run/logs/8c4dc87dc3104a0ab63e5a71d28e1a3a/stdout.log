sequence-quorum\",\n        \"s-storage-load-read\",\n        \"s-log-contract\",\n        \"s-reconfig-contract\"\n      ],\n      \"participants\": [\n        \"Origin follower actor\",\n        \"Old leader actor\",\n        \"New leader and quorum\"\n      ],\n      \"objects\": [\n        \"EntryId-tagged proposal\",\n        \"Assigned message\",\n        \"Decided entry at assigned prefix position\"\n      ],\n      \"contexts\": [\n        \"One configuration with stable identities, no compaction or crash\",\n        \"Old unchosen suffix excluded from new leader prepare quorum\",\n        \"Delayed genuine old leader message; per-link FIFO can be preserved\"\n      ],\n      \"event_paths\": [\n        \"Origin append_notify -> old leader TaggedProposal -> actual append -> delayed Assigned\",\n        \"New leader prepare quorum omitting old leader -> replacement append and decision -> origin receives genuine Assigned -> notification tick\"\n      ],\n      \"activity_classes\": [\n        \"A7\",\n        \"A1\",\n        \"A2\"\n      ],\n      \"behavior_ids\": [\n        \"b-rt-assignment\",\n        \"b-rt-notify\"\n      ],\n      \"fact_ids\": [\n        \"f-rt-assignment\"\n      ],\n      \"supporting_behavior_ids\": {\n        \"b-prepare\": \"New ballot selects history from a quorum excluding the old unchosen suffix.\",\n        \"b-decide\": \"Establishes the replacement decided prefix consumed by notification.\",\n        \"b-authority\": \"Changes origin promise before stale assignment arrives.\",\n        \"b-read\": \"Observes the actual decided entry for the returned assignment position.\"\n      },\n      \"obligation_relation_kind\": \"consumption\",\n      \"counterevidence\": [\n        \"EntryId prevents association with unrelated pending calls.\",\n        \"Batch reconciliation checks ballot equality.\",\n        \"Superseded is returned if assignment is already recorded and an intervening tick sees the new promise before the replacement is decided.\",\n        \"Existing supersession test waits for old call completion before replacement; it confirms that narrower guard path.\",\n        \"An old entry may legitimately survive a leadership change, so changed ballot alone is not a violation oracle.\"\n      ],\n      \"unknowns\": [\n        \"Clean execution must establish actual old entry acceptance, absence from new prepare quorum, replacement decision and late assignment for the same EntryId without forged messages or excluded FIFO constraints.\"\n      ],\n      \"priority\": 3,\n      \"trigger_rationale\": \"record_assignment admits an old real assignment by EntryId alone, while success checks position before ballot supersession. A fully assigned pending call is not necessary during authority transition. Source reading resolves guard ownership but cannot supply a legal executed history. This concrete identity/completion discriminator is more direct than the still-unclear cross-configuration routing contract; a controlled public-API check is justified.\"\n    },\n    \"status\": \"escalated\",\n    \"parent_candidate_id\": null,\n    \"fork_reason\": \"\",\n    \"stop_reason\": \"Ground the client completion responsibility and prepare a controlled schedule around a genuine delayed assignment; source analysis has not established a violation.\",\n    \"resume_conditions\": [],\n    \"obligation_id\": \"claim-notify-same-entry\",\n    \"result_claim_ids\": [],\n    \"open_issue_ids\": [],\n    \"executions\": [],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"question_candidates\",\n      \"match\": {\n        \"id\": \"6852d4d265fa40f4a9fc812db9cbf110\"\n      }\n    }\n  }\n]\nunits [\n  {\n    \"id\": \"unit-claim-notify-same-entry\",\n    \"candidate_id\": \"6852d4d265fa40f4a9fc812db9cbf110\",\n    \"obligation_ids\": [\n      \"claim-notify-same-entry\"\n    ],\n    \"binding_ids\": [\n      \"binding-notify-completion\"\n    ],\n    \"relation_ids\": [],\n    \"scope\": {\n      \"description\": \"Async runtime client completion within one valid fixed configuration, genuine non-Byzantine protocol/runtime messages, and successful storage. Focus on a delayed assignment across leader change when an old unchosen entry is replaced.\",\n      \"assumptions\": [\n        \"Unique operation identity and distinct proposed values allow independent correlation.\",\n        \"No compaction obscures the compared entry.\",\n        \"Application transports actual messages to their intended recipients; delay and partition preserve per-directed-link FIFO among delivered messages.\"\n      ],\n      \"excluded\": [\n        \"No eventual-success or timing guarantee is imposed. Timeout, Superseded or a still-pending call is not itself a violation.\",\n        \"No claim of conflicting core decisions or persistent-storage failure.\"\n      ],\n      \"parameters\": {}\n    },\n    \"rationale\": \"Ground the client completion responsibility and prepare a controlled schedule around a genuine delayed assignment; source analysis has not established a violation.\",\n    \"status\": \"pending\",\n    \"previous_id\": null,\n    \"version\": 1,\n    \"boundary_changes\": [],\n    \"obligation_checks\": {},\n    \"remaining_obligation_ids\": [\n      \"claim-notify-same-entry\"\n    ],\n    \"recheck_reasons\": [],\n    \"coverage_limitations\": [],\n    \"progress\": [\n      {\n        \"claim_id\": \"claim-notify-same-entry\",\n        \"record_status\": \"no_fixed_check\"\n      }\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"units\",\n      \"match\": {\n        \"id\": \"unit-claim-notify-same-entry\",\n        \"version\": 1\n      }\n    }\n  }\n]\nclaims [\n  {\n    \"id\": \"claim-notify-same-entry\",\n    \"kind\": \"obligation\",\n    \"concern\": \"implementation_semantics\",\n    \"description\": \"For an admitted append_notify operation, an Ok assigned position must identify that operation's proposed entry in the decided log; a different entry decided at that position under a later ballot must not satisfy the operation.\",\n    \"scope\": {\n      \"description\": \"Async runtime client completion within one valid fixed configuration, genuine non-Byzantine protocol/runtime messages, and successful storage. Focus on a delayed assignment across leader change when an old unchosen entry is replaced.\",\n      \"assumptions\": [\n        \"Unique operation identity and distinct proposed values allow independent correlation.\",\n        \"No compaction obscures the compared entry.\",\n        \"Application transports actual messages to their intended recipients; delay and partition preserve per-directed-link FIFO among delivered messages.\"\n      ],\n      \"excluded\": [\n        \"No eventual-success or timing guarantee is imposed. Timeout, Superseded or a still-pending call is not itself a violation.\",\n        \"No claim of conflicting core decisions or persistent-storage failure.\"\n      ],\n      \"parameters\": {}\n    },\n    \"source\": \"Candidate derived from attributed implementation responsibilities\",\n    \"source_ids\": [\n      \"s-rt-api-contract\",\n      \"s-rt-wire\",\n      \"s-rt-error-contract\",\n      \"s-log-contract\"\n    ],\n    \"pending\": [],\n    \"assessment\": \"unassessed\",\n    \"candidate\": true,\n    \"grounding\": {\n      \"source_ids\": [\n        \"s-rt-api-contract\",\n        \"s-rt-wire\",\n        \"s-rt-error-contract\",\n        \"s-log-contract\"\n      ],\n      \"expectation_ids\": [],\n      \"binding_ids\": [\n        \"binding-notify-completion\"\n      ],\n      \"derivation\": \"The public API promises to append an entry and await its decided log index. Wire identity associates the forwarded entry with the index actually assigned by the leader. Superseded documentation explicitly permits abandoning an uncertain operation after leadership change; it does not authorize successful completion for another entry. The obligation checks successful identity correspondence, not eventual commitment or mandatory supersession.\",\n      \"applicability\": \"A public append_notify operation and its actual completion within the same configured log; assignment produced by captured code and no compaction.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Success after leader change is permitted if the same proposed entry was adopted and decided.\"\n      ]\n    },\n    \"version\": 1,\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"claims\",\n      \"match\": {\n        \"id\": \"claim-notify-same-entry\",\n        \"version\": 1\n      }\n    }\n  }\n]\npending_work [\n  {\n    \"id\": \"unit-claim-notify-same-entry\",\n    \"candidate_id\": \"6852d4d265fa40f4a9fc812db9cbf110\",\n    \"kind\": \"unit\",\n    \"remaining\": [\n      \"claim-notify-same-entry\"\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"units\",\n      \"match\": {\n        \"id\": \"unit-claim-notify-same-entry\"\n      }\n    }\n  }\n]\nbuild_inputs [\n  {\n    \"record\": \"build-inputs/targets/omnipaxos/assurance_generated/basis.json\",\n    \"manifest\": \"omnipaxos/Cargo.toml\",\n    \"test_target\": \"assurance_generated\",\n    \"resolved_features\": [\n      \"async_runtime\",\n      \"default\",\n      \"logging\",\n      \"macros\",\n      \"omnipaxos_macros\",\n      \"serde\",\n      \"slog\",\n      \"slog-async\",\n      \"slog-term\"\n    ],\n    \"feature_evidence\": \"metadata resolution; selected test compilation is recorded separately\",\n    \"compilations\": [],\n    \"status\": \"inputs_fixed\",\n    \"latest_preparation\": null\n  }\n]\n{\n  \"$defs\": {\n    \"Comparison\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"field\": {\n          \"title\": \"Field\",\n          \"type\": \"string\"\n        },\n        \"op\": {\n          \"d