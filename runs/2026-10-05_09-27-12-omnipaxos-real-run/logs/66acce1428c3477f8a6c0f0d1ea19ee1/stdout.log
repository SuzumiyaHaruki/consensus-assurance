{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > persistent_rollback.rs <<'RS'\nuse omnipaxos::{ballot_leader_election::Ballot, storage::{Entry, NoSnapshot, Storage, StorageOp}};\nuse omnipaxos_storage::persistent_storage::{PersistentStorage, PersistentStorageConfig};\nuse serde::{Deserialize, Serialize, Serializer};\nuse serde_json::json;\nuse std::sync::atomic::{AtomicUsize, Ordering};\n\nstatic SERIALIZATION_ERRORS: AtomicUsize = AtomicUsize::new(0);\n#[derive(Clone, Debug, Deserialize, PartialEq)]\nstruct Value(u64);\nimpl Serialize for Value {\n    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {\n        if self.0 == 999 {\n            SERIALIZATION_ERRORS.fetch_add(1, Ordering::SeqCst);\n            return Err(serde::ser::Error::custom(\\\"selected entry cannot be serialized\\\"));\n        }\n        serializer.serialize_u64(self.0)\n    }\n}\nimpl Entry for Value { type Snapshot = NoSnapshot; }\nfn event(v: serde_json::Value) { println\"'!(\"CA_EVENT {}\", v); }\n\n#[test]\nfn persistent_returned_error_rollback() {\n    // Database lives only in this clean execution workspace; close before cleanup.\n    let root = tempfile::Builder::new().prefix(\"rollback-check-\").tempdir_in(\".\").unwrap();\n    let path = root.path().join(\"db\").to_string_lossy().into_owned();\n    let config = || PersistentStorageConfig::with_path(path.clone());\n    let mut storage = PersistentStorage::<Value>::open(config());\n    let old_ballot=Ballot::with(1,1,0,1);\n    let failed_ballot=Ballot::with(1,2,0,1);\n    storage.append_entry(Value(7)).unwrap();\n    storage.set_promise(old_ballot).unwrap();\n    let before_len=storage.get_log_len().unwrap();\n    let before_promise=storage.get_promise().unwrap().unwrap();\n    let before_prefix=storage.get_entries(0,before_len).unwrap();\n    assert_eq!(before_len,1);\n    assert_eq!(before_promise,old_ballot);\n    assert_eq!(before_prefix,vec![Value(7)]);\n    event(json!({\"event\":\"storage_admitted\",\"op_id\":\"failed-transaction\",\"before_len\":before_len,\n        \"before_promise_n\":before_promise.n,\"before_first\":before_prefix[0].0,\"error_value\":999}));\n    let result=storage.write_atomically(vec![StorageOp::SetPromise(failed_ballot),\n        StorageOp::AppendEntry(Value(11)),StorageOp::AppendEntry(Value(999))]);\n    let returned_error=result.is_err();\n    let error_count=SERIALIZATION_ERRORS.load(Ordering::SeqCst);\n    let error_text=result.err().map(|e|e.to_string()).unwrap_or_default();\n    event(json!({\"event\":\"storage_returned\",\"op_id\":\"failed-transaction\",\"returned_error\":returned_error,\n        \"serialization_error_observed\":error_count>0,\"error_text\":error_text}));\n    assert!(returned_error && error_count>0,\"selected serialization failure was not reached\");\n    let immediate_len=storage.get_log_len().unwrap();\n    let immediate_promise=storage.get_promise().unwrap().unwrap();\n    let prefix=storage.get_entries(0,1).unwrap();\n    event(json!({\"event\":\"immediate_state\",\"op_id\":\"failed-transaction\",\"log_len\":immediate_len,\n        \"promise_n\":immediate_promise.n,\"first\":prefix[0].0}));\n    // This independent transaction contains neither failed append nor failed promise.\n    let independent=storage.write_atomically(vec![StorageOp::SetDecidedIndex(0)]);\n    let independent_ok=independent.is_ok();\n    event(json!({\"event\":\"independent_completed\",\"op_id\":\"failed-transaction\",\"success\":independent_ok,\n        \"requested_decided_idx\":0}));\n    independent.unwrap();\n    let after_len=storage.get_log_len().unwrap();\n    let after_promise=storage.get_promise().unwrap().unwrap();\n    let after_entries=storage.get_entries(0,after_len).unwrap();\n    event(json!({\"event\":\"after_independent\",\"op_id\":\"failed-transaction\",\"log_len\":after_len,\n        \"promise_n\":after_promise.n,\"entries\":after_entries.iter().map(|v|v.0).collect::<Vec<_>>(),\n        \"decided_idx\":storage.get_decided_idx().unwrap()}));\n    drop(storage);\n    let reopened=PersistentStorage::<Value>::open(config());\n    let reopened_len=reopened.get_log_len().unwrap();\n    let reopened_promise=reopened.get_promise().unwrap().unwrap();\n    event(json!({\"event\":\"reopened_state\",\"op_id\":\"failed-transaction\",\"log_len\":reopened_len,\n        \"promise_n\":reopened_promise.n,\"entries\":reopened.get_entries(0,reopened_len).unwrap().iter().map(|v|v.0).collect::<Vec<_>>()}));\n    drop(reopened);\n    root.close().unwrap();\n}\nRS\ncat > make_persistent_check.py <<'\"'PY'\nimport json\nbinding=['binding-storage-rollback']\nss=['s-storage-contract','s-entry-contract','s-persistent-open','s-persistent-batch','s-persistent-atomic','s-persistent-read']\ng=dict(source_ids=ss,expectation_ids=['s-storage-contract'],binding_ids=binding,derivation='The direct Storage interface owes all-or-rollback on returned Err. Setup persists one entry and a promise, then the submitted batch queues a new promise and a good append before a final entry serializer returns a normal error. Public reads sample live cursor and database metadata; a following transaction changes only decided index, so failed promise/appends must remain absent. Reopen distinguishes persistent effects from live cursor alone.',applicability='One isolated persistent database, successful setup and ordinary I/O, no crashes or concurrency; Entry serialization can return Err through the implemented trait.',unresolved=[],conflicts=[],alternatives=['The database itself may remain unchanged at the initial Err even when the cursor changed; both are observed separately.','Dropping the object before reuse may discard pending writes; this check explicitly covers a live backend under its returned-error contract.'])\nprereqs=[dict(alias='admitted',event='storage_admitted',conditions=[]),dict(alias='failed',event='storage_returned',conditions=[dict(field='op_id',reference='admitted.op_id'),dict(field='returned_error',value=True),dict(field='serialization_error_observed',value=True)]),dict(alias='later',event='independent_completed',conditions=[dict(field='op_id',reference='failed.op_id'),dict(field='success',value=True)])]\nmon=[];props=[]\nfor check,event,field,expected in [('rollback-live-length','immediate_state','log_len','admitted.before_len'),('rollback-later-promise','after_independent','promise_n','admitted.before_promise_n')]:\n mon.append(dict(id='monitor-'+check,checker_id=check,event=event,binding_ids=binding,grounding=g,admission_alias='admitted',applicability_conditions=[]))\n props.append(dict(checker_id=check,kind='event_assertion',identity_fields=['op_id'],trigger=dict(field='event',value=event),assertion=dict(field=field,reference=expected),description='Failed write_atomically must preserve the corresponding pre-call observable; subsequent unrelated successful transaction must not publish failed writes.'))\n# Later-transaction prerequisite is relevant only to the second monitor; use applicability? It would\n# follow the immediate result, so do not make it a global prerequisite. The harness explicitly\n# asserts its success before emitting the later result; retain it as a diagnostic event.\nprereqs=prereqs[:2]\np=dict(description='Fixed direct PersistentStorage API check of returned-error rollback. After successful initial entry 7 and ballot 1, submit promise ballot 2, append 11, then an entry 999 whose Serialize returns Err. Observe live length immediately, execute an unrelated SetDecidedIndex(0) transaction, read database promise/log, close and reopen. Two comparisons test distinct observables of the same rollback responsibility.',claim_id='claim-storage-error-rollback',binding_ids=binding,harness=dict(kind='rust_test',execution_package='./omnipaxos',source='',files={},description='Actual PersistentStorage backed by RocksDB in a unique execution-workspace directory, with a user-defined Entry serializer returning a deterministic ordinary error for one selected value. No backend or dependency code modifications, no process crash or private access. The database is closed before cleanup. Prerequisite events identify successful setup and actual selected error; subsequent transaction success is checked in code and retained as a diagnostic event before the later result.',semantic_changes=['Use the public Entry serialization extension point to supply a returned error; all other entry values serialize normally.','Direct backend calls isolate the explicit Storage interface contract; no claim that the whole Paxos core continues after its storage panic.','Observe get_log_len from the live object and promise/entry data from backend public readers, then reopen as a diagnostic.'],prerequisites=prereqs,legality=g),monitors=mon,observable_properties=props,uncertainties=['Compilation of the default omnipaxos target enables its existing persistent-storage dev dependency; preparation is not semantic evidence.','No cluster consequence, crash recovery failure, or RocksDB atomic-commit failure is inferred from a local backend contract violation.','Reopened state is retained as diagnostic corroboration of persistence after the later successful call, not a separate requirement.'])\njson.dump(p,open('persistent-check-plan.json','w'),indent=2)\ns=dict(action='check',unit_id='unit-claim-storage-error-rollback',rationale='Use a controlled entry serializer error to measure live state and delayed failed-transaction effects against the accepted Storage rollback contract.',plan_path='persistent-check-plan.json',harness_path='persistent_rollback.rs')\njson.dump(s,open('persistent-check.json','w'),indent=2)\nPY\npython3 make_persistent_check.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));z=subprocess.run(r['validation']['command']+['persistent-check.json'],capture_output=True,text=True);print(z.stdout);print(z.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
