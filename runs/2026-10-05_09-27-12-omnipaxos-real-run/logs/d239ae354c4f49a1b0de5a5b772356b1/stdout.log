\n   261\t}\n   262\t\n   263\t/// An error returning the proposal that was failed due to that the current configuration is stopped.\n   264\t#[derive(Copy, Clone, Debug)]\n   265\tpub struct ErrHelper {}\n   266\timpl std::error::Error for ErrHelper {}\n   267\timpl std::fmt::Display for ErrHelper {\n   268\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n   269\t        std::fmt::Debug::fmt(self, f)\n   270\t    }\n   271\t}\n   272\t\n   273\timpl<T> Storage<T> for PersistentStorage<T>\n   274\twhere\n   275\t    T: Entry + Serialize + for<'a> Deserialize<'a>,\n   276\t    T::Snapshot: Serialize + for<'a> Deserialize<'a>,\n   277\t{\n   278\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n   279\t        for op in ops {\n   280\t            match op {\n   281\t                StorageOp::AppendEntry(entry) => self.batch_append_entry(entry)?,\n   282\t                StorageOp::AppendEntries(entries) => self.batch_append_entries(entries)?,\n   283\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n   284\t                    self.batch_append_on_prefix(from_idx, entries)?\n   285\t                }\n   286\t                StorageOp::SetPromise(bal) => self.batch_set_promise(bal)?,\n   287\t                StorageOp::SetDecidedIndex(idx) => self.batch_set_decided_idx(idx)?,\n   288\t                StorageOp::SetAcceptedRound(bal) => self.batch_set_accepted_round(bal)?,\n   289\t                StorageOp::SetCompactedIdx(idx) => self.batch_set_compacted_idx(idx)?,\n   290\t                StorageOp::Trim(idx) => self.batch_trim(idx)?,\n   291\t                StorageOp::SetStopsign(ss) => self.batch_set_stopsign(ss)?,\n   292\t                StorageOp::SetSnapshot(snap) => self.batch_set_snapshot(snap)?,\n   293\t            }\n   294\t        }\n   295\t        Ok(self.db.write(std::mem::take(&mut self.write_batch))?)\n   296\t    }\n   297\t\n   298\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n   299\t        let entry_bytes = bincode::serialize(&entry)?;\n   300\t        self.db.put_cf(\n   301\t            self.get_log_handle(),\n   302\t            self.next_log_key.to_be_bytes(),\n   303\t            entry_bytes,\n   304\t        )?;\n   305\t        self.next_log_key += 1;\n   306\t        Ok(())\n   307\t    }\n   308\t\n   309\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n   310\t        let mut batch = WriteBatchWithTransaction::<false>::default();\n   311\t        for entry in entries {\n   312\t            batch.put_cf(\n   313\t                self.get_log_handle(),\n   314\t                self.next_log_key.to_be_bytes(),\n   315\t                bincode::serialize(&entry)?,\n   316\t            );\n   317\t            self.next_log_key += 1;\n   318\t        }\n   319\t        self.db.write(batch)?;\n   320\t        Ok(())\n   321\t    }\n   322\t\n   323\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n   324\t        // Don't need to delete entries that will be overwritten.\n   325\t        let delete_idx = from_idx + entries.len();\n   326\t        if delete_idx < self.next_log_key {\n   327\t            let from_key = delete_idx.to_be_bytes();\n   328\t            let to_key = self.next_log_key.to_be_bytes();\n   329\t            self.db\n   330\t                .delete_range_cf(self.get_log_handle(), from_key, to_key)?;\n   331\t        }\n   332\t        self.next_log_key = from_idx;\n   333\t        self.append_entries(entries)\n   334\t    }\n   335\t\n   336\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n   337\t        // Check if the log has entries up to the requested endpoint.\n   338\t        if to > self.next_log_key || from >= to {\n   339\t            return Ok(vec![]); // Do an early return\n   340\t        }\n   341\t\n   342\t        let mut iter = self.db.raw_iterator_cf(self.get_log_handle());\n   343\t        let mut entries = Vec::with_capacity(to - from);\n   344\t        iter.seek(from.to_be_bytes());\n   345\t        for _ in from..to {\n   346\t            let entry_bytes = iter.value().ok_or(ErrHelper {})?;\n   347\t            entries.push(bincode::deserialize(entry_bytes)?);\n   348\t            iter.next();\n   349\t        }\n   350\t        Ok(entries)\n   351\t    }\n   352\t\n   353\t    fn get_log_len(&self) -> StorageResult<usize> {\n   354\t        Ok(self.next_log_key - self.get_compacted_idx()?)\n   355\t    }\n   356\t\n   357\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   358\t        self.get_entries(from, self.next_log_key)\n   359\t    }\n   360\t\n     1\t/// This file contains unit-style tests that check the atomicity of storage operations during\n     2\t/// handling of different messages, while injecting storage errors.\n     3\t/// We verify this way, that OmniPaxos successfully rolls back changes to a consistent state,\n     4\t/// when interrupted by a single storage error, before panicking.\n     5\t///\n     6\t/// Each test here follows the structure:\n     7\t///     1. Set up a new OmniPaxos instance.\n     8\t///     2. Give it any prerequisite messages that are needed to create the state required for the\n     9\t///        test.\n    10\t///     3. Schedule a failure in the mock-broken storage.\n    11\t///     4. Give it the test message and catch the ensuing panic.\n    12\t///     5. Check if the storage is in a consistent state.\n    13\tpub mod utils;\n    14\t\n    15\tuse crate::utils::StorageType;\n    16\t#[cfg(not(feature = \"unicache\"))]\n    17\tuse omnipaxos::messages::sequence_paxos::{AcceptDecide, Compaction};\n    18\t#[cfg(feature = \"unicache\")]\n    19\tuse omnipaxos::storage::Entry;\n    20\t#[cfg(feature = \"unicache\")]\n    21\tuse omnipaxos::unicache::UniCache;\n    22\tuse omnipaxos::{\n    23\t    messages::{\n    24\t        ballot_leader_election::{BLEMessage, HeartbeatMsg, HeartbeatReply},\n    25\t        sequence_paxos::{AcceptSync, PaxosMessage, PaxosMsg, Prepare, Promise},\n    26\t        Message,\n    27\t    },\n    28\t    storage::{Snapshot, SnapshotType, Storage},\n    29\t    util::{LogSync, NodeId, SequenceNumber},\n    30\t    OmniPaxos, OmniPaxosConfig,\n    31\t};\n    32\tuse omnipaxos_storage::memory_storage::MemoryStorage;\n    33\tuse serial_test::serial;\n    34\tuse std::{\n    35\t    panic::{catch_unwind, AssertUnwindSafe},\n    36\t    sync::{Arc, Mutex},\n    37\t};\n    38\tuse utils::{BrokenStorageConfig, TestConfig, Value, ValueSnapshot};\n    39\t\n    40\ttype MemoryStore = Arc<Mutex<MemoryStorage<Value>>>;\n    41\ttype BrokenStore = Arc<Mutex<BrokenStorageConfig>>;\n    42\t\n    43\t/// Creates a new OmniPaxos instance with `BrokenStorage` in its initial state.\n    44\t/// Also returns an `Arc<Mutex<_>>` pointer to the underlying `MemoryStorage` and\n    45\t/// `BrokenStorageConfig` to enable injecting storage errors.\n    46\tfn basic_setup() -> (\n    47\t    MemoryStore,\n    48\t    BrokenStore,\n    49\t    OmniPaxos<Value, StorageType<Value>>,\n    50\t) {\n    51\t    let cfg = TestConfig::load(\"atomic_storage_test\").expect(\"Test config loaded\");\n    52\t    let storage = StorageType::with(cfg.storage_type, \"\");\n    53\t    let (mem_storage, storage_conf) = if let StorageType::Broken(ref s, ref c) = storage {\n    54\t        (s.clone(), c.clone())\n    55\t    } else {\n    56\t        panic!(\"using wrong storage for atomic_storage_test\")\n    57\t    };\n    58\t    let mut op_config = OmniPaxosConfig::default();\n    59\t    op_config.server_config.pid = 1;\n    60\t    op_config.cluster_config.nodes = (1..=cfg.num_nodes as NodeId).collect();\n    61\t    op_config.cluster_config.configuration_id = 1;\n    62\t    op_config.server_config.election_tick_timeout = 1; // set tick timeout to 1 as we need to trigger leader change when we call tick() in the tests.\n    63\t    let op = op_config.build(storage).unwrap();\n    64\t    (mem_storage, storage_conf, op)\n    65\t}\n    66\t\n    67\t/// Creates a new OmniPaxos instance with `BrokenStorage` in a `LEADER ACCEPT` state.\n    68\t/// Also returns an `Arc<Mutex<_>>` pointer to the underlying `MemoryStorage` and\n    69\t/// `BrokenStorageConfig` to enable injecting storage errors.\n    70\tfn _setup_leader() -> (\n    71\t    MemoryStore,\n    72\t    BrokenStore,\n    73\t    OmniPaxos<Value, StorageType<Value>>,\n    74\t) {\n    75\t    let (mem_storage, storage_conf, mut op) = setup_follower();\n    76\t    let mut n = mem_storage.lock().unwrap().get_promise().unwrap().unwrap();\n    77\t    let n_old = n;\n    78\t    let setup_msg = Message::<Value>::BLE(BLEMessage {\n    79\t        from: 2,\n    80\t        to: 1,\n    81\t        msg: HeartbeatMsg::Reply(HeartbeatReply {\n    82\t            round: 1,\n    83\t            ballot: n_old,\n    84\t            leader: n_old,\n    85\t            happy: true,\n    86\t        }),\n    87\t    });\n    88\t    op.handle_incoming(setup_msg);\n    89\t    op.tick(); // trigger leader change\n    90\t    let setup_msg = Message::<Value>::BLE(BLEMessage {\n    91\t        from: 2,\n    92\t        to: 1,\n    93\t        msg: HeartbeatMsg::Reply(HeartbeatReply {\n    94\t            round: 2,\n    95\t            ballot: n_old,\n    96\t            leader: n_old,\n    97\t            happy: false,\n    98\t        }),\n    99\t    });\n   100\t    op.handle_incoming(setup_msg);\n   101\t    op.tick(); // trigger leader change\n   102\t    let setup_msg = Message::<Value>::BLE(BLEMessage {\n   103\t        from: 2,\n   104\t        to: 1,\n   105\t        msg: HeartbeatMsg::Reply(HeartbeatReply {\n   106\t            round: 3,\n   107\t            ballot: n_old,\n   108\t            leader: n_old,\n   109\t            happy: false,\n   110\t        }),\n   111\t    });\n   112\t    op.handle_incoming(setup_msg);\n   113\t    op.tick(); // trigger leader change\n   114\t    let mut msgs = vec![];\n   115\t    op.take_outgoing_messages(&mut msgs);\n   116\t    for msg in msgs {\n   117\t        if let Message::SequencePaxos(ref px_msg) = msg {\n   118\t            if let PaxosMsg::Prepare(prep) = px_msg.msg {\n   119\t                n = prep.n;\n   120\t            }\n   121\t        }\n   122\t    }\n   123\t    let setup_msg = Message::<Value>::SequencePaxos(PaxosMessage {\n   124\t        from: 2,\n   125\t        to: 1,\n   126\t        msg: PaxosMsg::Promise(Promise {\n   127\t            n,\n   128\t            decided_idx: 0,\n   129\t            accepted_idx: 0,\n   130\t            n_accepted: n_old,\n   131\t            log_sync: None,\n   132\t        }),\n   133\t    });\n   134\t    op.handle_incoming(setup_msg);\n   135\t    assert!(\n   136\t        op.get_current_leader().expect(\"should have leader\").0 == 1,\n   137\t        \"should be leader\"\n   138\t    );\n   139\t    (mem_storage, storage_conf, op)\n   140\t}\n   141\t\n   142\t/// Creates a new OmniPaxos instance with `BrokenStorage` in a `FOLLOWER ACCEPT` state.\n   143\t/// Also returns an `Arc<Mutex<_>>` pointer to the underlying `MemoryStorage` and\n   144\t/// `BrokenStorageConfig` to enable injecting storage errors.\n   145\t/// The next expected sequence number is `SequenceNumber{session: 1, counter: 2}`.\n   146\tfn setup_follower() -> (\n   147\t    MemoryStore,\n   148\t    BrokenStore,\n   149\t    OmniPaxos<Value, StorageType<Value>>,\n   150\t) {\n   151\t    let (mem_storage, storage_conf, mut op) = basic_setup();\n   152\t    let mut n = mem_storage.lock().unwrap().get_promise().unwrap().unwrap();\n   153\t    n.config_id = 1;\n   154\t    n.n += 1;\n   155\t    n.pid = 2;\n   156\t    let setup_msg = Message::<Value>::SequencePaxos(PaxosMessage {\n   157\t        from: 2,\n   158\t        to: 1,\n   159\t        msg: PaxosMsg::Prepare(Prepare {\n   160\t            decided_idx: 0,\n   161\t            accepted_idx: 0,\n   162\t            n_accepted: mem_storage\n   163\t                .lock()\n   164\t                .unwrap()\n   165\t                .get_accepted_round()\n   166\t                .unwrap()\n   167\t                .unwrap_or_default(),\n   168\t            n,\n   169\t        }),\n   170\t    });\nnl: write error: Broken pipe\n[package]\nname = \"omnipaxos_storage\"\nversion = \"0.2.2\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"Storage implementations for OmniPaxos.\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nomnipaxos = { version = \"0.2.3\", path = \"../omnipaxos\", features = [\"serde\"] }\nserde = { version = \"1.0\", features = [\"derive\"], optional= true }\nbincode = { version = \"1.3.3\", optional = true }\nzerocopy = { version = \"0.6.1\", optional = true }\nrocksdb = { version = \"0.21.0\", optional = true }\n[profile.release]\nlto = true\n\n[features]\npersistent_storage = [\"dep:rocksdb\", \"dep:serde\", \"dep:bincode\", \"dep:zerocopy\"]\n13:    persistent_storage::{PersistentStorage, PersistentStorageConfig},\n252:    fn write_atomically(\n257:            StorageType::Persistent(persist_s) => persist_s.write_atomically(ops),\n258:            StorageType::Memory(mem_s) => mem_s.write_atomically(ops),\n260:                // NOTE: Can't properly test for atomicity since we can't tick between writes in batch.\n262:                mem_s.lock().unwrap().write_atomically(ops)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The controller has confirmed the scoped async completion defect. A separate source discrepancy is now worth checking: `Storage::write_atomically` promises rollback on `Err`, but `PersistentStorage` advances an in-memory log cursor and retains a write batch while serialization can fail. I’ll test that backend contract directly, without assuming a cluster-level consequence.\n"}}
