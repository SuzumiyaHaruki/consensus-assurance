x;d.phase=\"restarted\";d.create();d.drain()\n d.must(d.n.Campaign())\n for i:=0;i<10 && d.n.BasicStatus().RaftState!=StateLeader;i++{d.one()}\n if d.n.BasicStatus().RaftState!=StateLeader{t.Fatal(\"restart election prerequisite\")}\n d.emit(\"read_invoked\",map[string]interface{}{\"context\":\"after-restart\",\"commit\":d.n.BasicStatus().Commit,\"applied\":d.applied,\"value\":d.value,\"term\":d.n.BasicStatus().Term})\n d.n.ReadIndex([]byte(\"after-restart\"));d.drain()\n d.emit(\"end\",map[string]interface{}{\"served\":d.served,\"value\":d.value,\"applied\":d.applied})\n}\nGO\npython3 - <<'\"'PY'\nimport json,subprocess\np=dict(action='explore',question='Can singleton ReadIndex return a stale completed read after a legal crash loses only non-synced commit metadata, while durable prior commands are replayed in bounded application batches? The caller waits for applied strictly greater than the returned index. Distinguish legal persistence/recovery premises from any observed difference.',rationale='The singleton fast path bypasses the current-term commit guard. Ready.MustSync permits commit-only nondurable writes. This exploration constructs the pre-crash writes, actual synchronized log/HardState prefix and snapshot, then reconstructs solely that durable state. It never fabricates a committed index. Two writes share one durable append so the conservative strict application-index condition can be met before the last completed write is replayed. RawNode has no background lifecycle; all state mutation uses public APIs and caller-owned storage.',harness_path='singleton_explore_test.go',sources=[dict(id=i,file=f,start_line=a,end_line=b,kind=k) for i,f,a,b,k in [('s-read-client-contract','node.go',218,229,'interface_statement'),('s-read-ready-contract','node.go',68,74,'interface_statement'),('s-mustsync-contract','node.go',112,115,'interface_statement'),('s-mustsync-producer','rawnode.go',191,200,'code_observation'),('s-snapshot-create','storage.go',227,247,'code_observatio