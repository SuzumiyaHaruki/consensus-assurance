{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nR='internal/raft/raft.go'\nsrc('M-formation',R,864,929);src('M-transitions',R,931,1133);src('M-term',R,1316,1564);src('M-members',R,1149,1314);src('M-read',R,1616,1741);src('M-confirm',R,1771,1790);src('M-readqueue','internal/raft/readindex.go',21,123);src('M-dispatch',R,2079,2163);src('M-heartbeat',R,374,427);src('M-producer',R,815,851);src('M-forward',R,1862,1983);src('M-tick',R,559,630);src('M-transfer',R,1742,1769);src('M-checkquorum',R,1595,1614);src('M-recovery',R,237,292);src('M-restore',R,437,527);src('M-log','internal/raft/logentry.go',290,399);src('M-peer','internal/raft/peer.go',69,207);src('M-update','internal/raft/peer.go',209,365);src('M-engine','engine.go',1298,1375);src('M-node','node.go',996,1115);src('M-batches','request.go',842,937);src('M-admit','node.go',1225,1234);src('M-config','node.go',254,317);src('M-rsmconfig','internal/rsm/statemachine.go',960,975);src('M-rsmrecover','internal/rsm/statemachine.go',242,259);src('M-rsmapply','internal/rsm/statemachine.go',998,1043);src('M-observer','config/config.go',162,176,'interface_statement');src('M-readapi','nodehost.go',855,875,'interface_statement')\nbeh=[]\ndef behavior(i,a,trigger,s,**kw):\n d=dict(id=i,primary_activity=a,execution_owner='Per-cluster Raft peer under node.raftMu / step worker',protocol_context='Cluster identity, current term, role and applied membership',trigger=trigger,source_ids=s);d.update(kw);beh.append(d)\nbehavior('B-formation','A1','Leader proposals and replication responses; followers receive replication/heartbeat messages',['M-formation','M-term','M-read','M-log','M-heartbeat'],implementation_guards=['Leader transfer drops proposals; pending configuration changes replaced with no-op entries','Previous index/term must match before appending; committed conflicts panic','Commit aggregation includes remotes and witnesses, excludes observers; counted index must have current term'],writes=['Leader assigns term/index, appends, updates self match; accepted responses update remote match','Follower appends matching suffix and advances commit only through received prefix; heartbeat advances through leader-clamped match'],external_effects=['Replication broadcast after proposal or successful commit; negative response drives retry'],consumes_fact_ids=['F-context'],produces_fact_ids=['F-commit'],async_boundaries=['Messages leave through Peer.GetUpdate; persistence and dispatch owned by engine'])\nbehavior('B-authority','A2','Election ticks, vote requests/responses, higher/lower term messages, quorum check and leadership transfer',['M-transitions','M-term','M-tick','M-transfer','M-checkquorum','M-peer'],implementation_guards=['Peer filters responses from unknown members; candidate ignores observer votes','Vote limited by current vote and log freshness; election blocked while committed entries remain unapplied','Higher term steps down except recent-leader vote suppression; lower term messages discarded','Transfer requires full member; catch-up precedes TimeoutNow; timeout aborts transfer'],writes=['New term clears vote; reset clears accumulated votes, read-index queue, transfer and remote match tracking','Leader appends current-term no-op and reconstructs pending configuration status'],produces_fact_ids=['F-context'],cross_activity_effects={'A1':'Only current authority consumes current-term replies; prior committed history survives reset'},unknowns=['Interaction of membership callbacks and queued prior replies across membership transitions remains to be investigated'])\nbehavior('B-membership','A4','Committed configuration entry application, rejection, or restored snapshot membership',['M-members','M-config','M-rsmconfig','M-restore','M-observer'],execution_owner='RSM applies membership under its lock then node callback takes raftMu',writes=['Add/remove voting, observer and witness records; observer promotion inherits progress','Remove local leader steps it down; remove peer can trigger commit recalculation','Clear pending configuration latch on application or rejection'],cross_activity_effects={'A1':'Applied maps define quorum and eligible replication support','A2':'Self removal and observer promotion change eligibility/role'},unknowns=['Detailed membership acceptance constraints in members.handleConfigChange are unread'])\nbehavior('B-history','A6','Engine processes Peer.GetUpdate and acknowledges with Peer.Commit',['M-engine','M-node','M-update','M-log'],execution_owner='Engine step worker and LogDB; Peer.Commit under raftMu',consumes_fact_ids=['F-commit'],durable_effects=['SaveRaftState receives entries, term/vote/commit and snapshot update'],important_branches=['Replication messages can precede disk save; other messages sent by processRaftUpdate after save','FastApply permitted only when committed entries do not overlap unsaved suffix and no snapshot'],external_effects=['Queue committed entries for application; dispatch messages; mark update processed'],async_boundaries=['Application worker runs independently from step worker; LastApplied is separately reported'],unknowns=['Storage implementation crash atomicity and transport ordering require deeper source investigation'])\nbehavior('B-recovery','A3','Launch from persisted state or install snapshot and RSM recovery',['M-recovery','M-restore','M-log','M-rsmrecover','M-config'],writes=['Load term/vote/commit with range check','Reject old snapshot; matching snapshot term advances commit; otherwise replace in-memory log context','Restore membership after state machine recovery, rebuild progress and registry'],cross_activity_effects={'A1':'Recovered committed prefix constrains future appends','A2':'Restored members determine eligible authority and self removal'},unknowns=['Snapshot file validation and exact asynchronous recovery admission are not yet traced'])\nbehavior('B-application','A5','Committed entries queued by engine reach RSM',['M-node','M-engine','M-rsmapply','M-rsmconfig'],execution_owner='RSM application worker',consumes_fact_ids=['F-commit'],writes=['Application updates and session response bookkeeping; applied index reported to peer'],external_effects=['Node application callbacks notify pending requests; configuration callbacks modify peer membership'],cross_activity_effects={'A2':'Applied watermark gates election when committed work remains unapplied'},unknowns=['All session retry and on-disk/concurrent state-machine variants remain unread'])\nbehavior('B-read-admit','A2','Local ReadIndex or forwarded ReadIndex received by leader',['M-read','M-producer','M-forward','M-readqueue','M-peer'],consumes_fact_ids=['F-context','F-commit'],produces_fact_ids=['F-readpending'],implementation_guards=['Multi-voter leader needs current-term committed entry','ReadIndex from witness dropped; follower needs known leader','Nonzero-context heartbeats sent only to voting members'],writes=['Append pending context with origin and committed index; duplicate context ignored'],external_effects=['Broadcast heartbeat carrying request context; follower forwards to known leader','Single-voter branch releases immediately; multi-voter not-ready branch reports dropped request'],unknowns=[])\nbehavior('B-read-confirm','A2','Heartbeat response with nonzero low context reaches leader; confirm attains quorum count',['M-readqueue','M-confirm','M-read','M-dispatch'],consumes_fact_ids=['F-readpending'],implementation_guards=['Term and known-member dispatch precede handling','Distinct sender confirmation count plus leader reaches quorum'],writes=['Confirmation removes all queued requests through acknowledged context and raises their index to that context index'],external_effects=['Local released records use each saved context; remote released records use each saved origin but the incoming confirmation context'],cross_activity_effects={'A7':'Response context is used to associate read readiness with caller batch'},unknowns=['Does the remote branch preserve correlation for earlier requests released by confirmation of a later context?'])\nbehavior('B-read-consume','A7','Node batches read requests; follower receives ReadIndexResp; update publishes ReadyToRead',['M-admit','M-forward','M-batches','M-node','M-readapi'],execution_owner='Step worker and pendingReadIndex under its mutex',writes=['Generate nonzero random low context and tick-derived high context; map batch by full SystemCtx','Response fields become ReadyToRead context; only matching batch gets index'],external_effects=['Notify completed only after positive ready index is applied and deadline not expired; otherwise timeout handling'],cross_activity_effects={'A2':'Consumes leader authority confirmation using the returned full context'},unknowns=['Effects of miscorrelated remote readiness need a legal multi-request history and execution witness'])\nfacts=[dict(id='F-context',meaning='Peer current term, role and remembered vote/leader determine dispatch and election authority; role alone does not establish continued quorum contact.',identity={'cluster':'clusterID','node':'nodeID'},validity_context='Current peer state until subsequent term/role transition',representation=['raft.term','raft.state','raft.vote','raft.leaderID'],durability='Term and vote emitted in State; role and leader volatile',recovery='newRaft loads persisted term/vote and restarts nonleader',source_ids=['M-transitions','M-term','M-recovery']),dict(id='F-commit',meaning='Local log.committed is the prefix marked committed by current-term quorum aggregation, accepted leader propagation, or snapshot recovery; this is distinct from applied completion.',identity={'cluster':'clusterID','node':'nodeID','prefix':'log.committed'},validity_context='Local history, current membership and dispatch context; committed entries may not be overwritten',representation=['entryLog.committed'],durability='State.Commit emitted to LogDB; durable only through engine save',recovery='Load state range checked; snapshot can establish prefix',source_ids=['M-formation','M-term','M-log','M-restore','M-engine']),dict(id='F-readpending',meaning='A queued readStatus preserves the admitted full context, origin and captured committed index awaiting leadership confirmation; it does not itself establish quorum confirmation or client completion.',identity={'cluster':'clusterID','leader':'nodeID','context':'SystemCtx High and Low'},validity_context='Current leader readIndex instance; reset abandons the queue. Admission requires current-term commit in the multi-voter branch.',representation=['readIndex.pending[SystemCtx]','readIndex.queue','readStatus.ctx/from/index/confirmed'],durability='Volatile',recovery='No reconstruction; reset allocates fresh readIndex',invalidators=['B-authority','B-read-confirm'],source_ids=['M-read','M-readqueue','M-transitions'],unknowns=['Remote release may emit confirming context instead of saved context'])]\nroles=json.load(open('../research.json'))['activity_roles']\nactivities=[]\nfor a,v in roles.items():\n bs=[b for b in beh if b['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=v['relation'],realization_summary=' '.join(b['trigger']+'.' for b in bs),entry_points=[b['id'] for b in bs],source_ids=sorted(set(x for b in bs for x in b['source_ids']))))\ncore=dict(status='usable',rationale='Representative formation and authority paths and their supporting persistence, membership, recovery and consumption boundaries are traced; detailed variants remain open, not claimed complete.',formation=dict(explanation='Peer.ProposeEntries enters leader handler, assigns current term and sequential index, updates self match, and broadcasts replication. Followers check previous term/index, reject mismatches, append a matching suffix and cap propagated commit. Leader counts remote and witness matches at majority position, excluding observers, and only advances by counting a current-term index. Acknowledgments retry rejected replication and successful commit is propagated. Engine exports updates, saves state/entries before dependent outbound responses, queues committed entries for RSM application and acknowledges processed state separately from applied state. RSM applies commands/session semantics and callbacks report completion.',behavior_ids=['B-formation','B-history','B-application'],fact_ids=['F-commit'],source_ids=['M-formation','M-term','M-read','M-engine','M-node','M-update','M-rsmapply']),context=dict(explanation='Ticks initiate campaigns only for eligible nonremoved full members and only after committed work is applied. Candidate increments term and self-votes; vote grants check saved vote and log freshness; known eligible responses elect a majority. Becoming leader resets replication progress, reconstructs pending configuration status and appends a no-op. Higher terms step down with a recent-leader vote-suppression exception; stale terms are discarded. CheckQuorum steps down when voters are inactive; transfer suppresses proposals and waits for target catch-up before TimeoutNow. Reset abandons prior votes, pending read confirmations and transfer but preserves committed history. Snapshot recovery restores membership; self removal steps down.',behavior_ids=['B-authority','B-membership','B-recovery'],fact_ids=['F-context'],source_ids=['M-transitions','M-term','M-peer','M-tick','M-transfer','M-checkquorum','M-members','M-restore']),connection=dict(explanation='Authority reset prevents counting prior-term progress, while the surviving committed log constrains election freshness and future replication. Applied membership defines voting support; single pending configuration and election blocking on unapplied commit connect application timing to quorum overlap. ReadIndex separately requires a current-term commit before asking voters to confirm authority. A matching heartbeat quorum releases queued read statuses; emitted readiness then needs a matching caller context and locally applied index. Pending confirmations are volatile and reset on authority changes; request completion is separately timed and correlated.',behavior_ids=['B-authority','B-membership','B-read-admit','B-read-confirm','B-read-consume'],fact_ids=['F-context','F-commit','F-readpending'],source_ids=['M-members','M-term','M-transitions','M-read','M-readqueue','M-confirm','M-batches']),core_gaps=[],open_details=['Remote ReadIndex response context differs from local release when one confirmation releases a prefix.','Snapshot storage/transport and asynchronous recovery variants need deeper reading.','Membership acceptance validation and in-flight support across configuration transitions remain open.'])\nmapobj=dict(version=1,target_profile=dict(system_boundary='Captured Dragonboat Go module: NodeHost/node/engine, internal raft and RSM; application and transport/storage implementations have additional local contracts not yet exhaustively read.',protocol_contexts=['Per cluster Raft term and applied membership','Full voters, nonvoting observers, voting witnesses'],external_interfaces=['NodeHost.ReadIndex and ReadLocal','Peer message/update interface','LogDB and application state-machine interfaces'],ownership=['Raft mutation serialized by node raftMu; engine owns update persistence/dispatch; RSM application asynchronous'],source_ids=['M-peer','M-engine','M-node','M-observer','M-readapi']),activities=activities,behaviors=beh,facts=facts,core_overview=core,surfaces=[dict(entry_point='raft.handleReadIndexLeaderConfirmation',disposition='mapped',behavior_ids=['B-read-confirm'],reason='Remote branch copies incoming context while local branch copies each released record context; investigate legal coalesced prefix.',source_ids=['M-confirm','M-readqueue'],high_consequence=False),dict(entry_point='raft.handleLeaderHeartbeatResp