4(len(t.CommittedDeps))\n   869\t\tif wlen := binary.PutVarint(bs, alen2); wlen >= 0 {\n   870\t\t\twire.Write(b[0:wlen])\n   871\t\t}\n   872\t\tfor i := int64(0); i < alen2; i++ {\n   873\t\t\tbs = b[:4]\n   874\t\t\ttmp32 = t.CommittedDeps[i]\n   875\t\t\tbs[0] = byte(tmp32)\n   876\t\t\tbs[1] = byte(tmp32 >> 8)\n   877\t\t\tbs[2] = byte(tmp32 >> 16)\n   878\t\t\tbs[3] = byte(tmp32 >> 24)\n   879\t\t\twire.Write(bs)\n   880\t\t}\n   881\t}\n   882\t\n   883\tfunc (t *PreAcceptReply) Unmarshal(rr io.Reader) error {\n   884\t\tvar wire byteReader\n   885\t\tvar ok bool\n   886\t\tif wire, ok = rr.(byteReader); !ok {\n   887\t\t\twire = bufio.NewReader(rr)\n   888\t\t}\n   889\t\tvar b [21]byte\n   890\t\tvar bs []byte\n   891\t\tbs = b[:21]\n   892\t\tif _, err := io.ReadAtLeast(wire, bs, 21); err != nil {\n   893\t\t\treturn err\n   894\t\t}\n   895\t\tt.Replica = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n   896\t\tt.Instance = int32((uint32(bs[4]) | (uint32(bs[5]) << 8) | (uint32(bs[6]) << 16) | (uint32(bs[7]) << 24)))\n   897\t\tt.Ballot = int32((uint32(bs[8]) | (uint32(bs[9]) << 8) | (uint32(bs[10]) << 16) | (uint32(bs[11]) << 24)))\n   898\t\tt.VBallot = int32((uint32(bs[12]) | (uint32(bs[13]) << 8) | (uint32(bs[14]) << 16) | (uint32(bs[15]) << 24)))\n   899\t\tt.Seq = int32((uint32(bs[16]) | (uint32(bs[17]) << 8) | (uint32(bs[18]) << 16) | (uint32(bs[19]) << 24)))\n   900\t\tt.Status = int8(bs[20])\n   901\t\talen1, err := binary.ReadVarint(wire)\n   902\t\tif err != nil {\n   903\t\t\treturn err\n   904\t\t}\n   905\t\tt.Deps = make([]int32, alen1)\n   906\t\tfor i := int64(0); i < alen1; i++ {\n   907\t\t\tbs = b[:4]\n   908\t\t\tif _, err := io.ReadAtLeast(wire, bs, 4); err != nil {\n   909\t\t\t\treturn err\n   910\t\t\t}\n   911\t\t\tt.Deps[i] = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n   912\t\t}\n   913\t\talen2, err := binary.ReadVarint(wire)\n   914\t\tif err != nil {\n   915\t\t\treturn err\n   916\t\t}\n   917\t\tt.CommittedDeps = make([]int32, alen2)\n   918\t\tfor i := int64(0); i < alen2; i++ {\n   919\t\t\tif _, err := io.ReadAtLeast(wire, bs, 4); err != nil {\n   920\t\t\t\treturn err\n   921\t\t\t}\n   922\t\t\tt.CommittedDeps[i] = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n   923\t\t}\n   924\t\treturn nil\n   925\t}\n   926\t\n   927\tfunc (t *PreAcceptOK) New() fastrpc.Serializable {\n   724\tfunc (r *Replica) handlePropose(propose *defs.GPropose) {\n   725\t\t//TODO!! Handle client retries\n   726\t\n   727\t\tbatchSize := len(r.ProposeChan) + 1\n   728\t\tr.M.Lock()\n   729\t\tr.Stats.M[\"totalBatching\"]++\n   730\t\tr.Stats.M[\"totalBatchingSize\"] += batchSize\n   731\t\tr.M.Unlock()\n   732\t\n   733\t\tr.crtInstance[r.Id]++\n   734\t\n   735\t\tcmds := make([]state.Command, batchSize)\n   736\t\tproposals := make([]*defs.GPropose, batchSize)\n   737\t\tcmds[0] = propose.Command\n   738\t\tproposals[0] = propose\n   739\t\tfor i := 1; i < batchSize; i++ {\n   740\t\t\tprop := <-r.ProposeChan\n   741\t\t\tcmds[i] = prop.Command\n   742\t\t\tproposals[i] = prop\n   743\t\t}\n   744\t\n   745\t\tr.startPhase1(cmds, r.Id, r.crtInstance[r.Id], r.Id, proposals)\n   746\t\n   747\t\tcpcounter += len(cmds)\n   748\t\n   749\t}\n   750\t\n   751\tfunc (r *Replica) startPhase1(cmds []state.Command, replica int32, instance int32, ballot int32, proposals []*defs.GPropose) {\n   752\t\t// init command attributes\n   753\t\tseq := int32(0)\n   754\t\tdeps := make([]int32, r.N)\n   755\t\tfor q := 0; q < r.N; q++ {\n   756\t\t\tdeps[q] = -1\n   757\t\t}\n   758\t\tseq, deps, _ = r.updateAttributes(cmds, seq, deps, replica, instance)\n   759\t\tcomDeps := make([]int32, r.N)\n   760\t\tfor i := 0; i < r.N; i++ {\n   761\t\t\tcomDeps[i] = -1\n   762\t\t}\n   763\t\n   764\t\tinst := r.newInstance(replica, instance, cmds, ballot, ballot, PREACCEPTED, seq, deps)\n   765\t\tinst.lb = r.newLeaderBookkeeping(proposals, deps, comDeps, deps, ballot, cmds, PREACCEPTED, -1)\n   766\t\tr.InstanceSpace[replica][instance] = inst\n   767\t\n   768\t\tr.updateConflicts(cmds, replica, instance, seq)\n   769\t\n   770\t\tif seq >= r.maxSeq {\n   771\t\t\tr.maxSeq = seq\n   772\t\t}\n   773\t\n   774\t\tr.recordInstanceMetadata(r.InstanceSpace[r.Id][instance])\n   775\t\tr.recordCommands(cmds)\n   776\t\tr.sync()\n   777\t\n   778\t\tr.bcastPreAccept(replica, instance)\n   779\t}\n   780\t\n   781\tfunc (r *Replica) handlePreAccept(preAccept *PreAccept) {\n   974\tfunc (r *Replica) handleAccept(accept *Accept) {\n   975\t\tinst := r.InstanceSpace[accept.Replica][accept.Instance]\n   976\t\n   977\t\tif accept.Ballot > r.maxRecvBallot {\n   978\t\t\tr.maxRecvBallot = accept.Ballot\n   979\t\t}\n   980\t\n   981\t\tif accept.Instance > r.crtInstance[accept.Replica] {\n   982\t\t\tr.crtInstance[accept.Replica] = accept.Instance\n   983\t\t}\n   984\t\n   985\t\tif inst == nil {\n   986\t\t\tinst = r.newInstanceDefault(accept.Replica, accept.Instance)\n   987\t\t\tr.InstanceSpace[accept.Replica][accept.Instance] = inst\n   988\t\t}\n   989\t\n   990\t\tif accept.Ballot < inst.bal {\n   991\t\t\tr.Printf(\"Smaller ballot %d < %d\\n\", accept.Ballot, inst.bal)\n   992\t\t} else if inst.Status >= COMMITTED {\n   993\t\t\tr.Printf(\"Already committed / executed \\n\")\n   994\t\t} else {\n   995\t\t\tinst.Deps = accept.Deps\n   996\t\t\tinst.Seq = accept.Seq\n   997\t\t\tinst.bal = accept.Ballot\n   998\t\t\tinst.vbal = accept.Ballot\n   999\t\t\tr.recordInstanceMetadata(r.InstanceSpace[accept.Replica][accept.Instance])\n  1000\t\t\tr.sync()\n  1001\t\t}\n  1002\t\n  1003\t\treply := &AcceptReply{accept.Replica, accept.Instance, inst.bal}\n  1004\t\tr.replyAccept(accept.LeaderId, reply)\n  1005\t\n  1006\t}\n  1007\t\n  1008\tfunc (r *Replica) handleAcceptReply(areply *AcceptReply) {\n  1009\t\tinst := r.InstanceSpace[areply.Replica][areply.Instance]\n  1010\t\tlb := inst.lb\n  1011\t\n  1012\t\tif areply.Ballot > r.maxRecvBallot {\n  1013\t\t\tr.maxRecvBallot = areply.Ballot\n  1014\t\t}\n  1015\t\n  1016\t\tif lb.status != ACCEPTED {\n  1017\t\t\treturn\n  1018\t\t}\n  1019\t\n  1020\t\tif lb.lastTriedBallot != areply.Ballot {\n  1021\t\t\treturn\n  1022\t\t}\n  1023\t\n  1024\t\tif areply.Ballot > lb.lastTriedBallot {\n  1025\t\t\tlb.nacks++\n  1026\t\t\tif lb.nacks+1 > r.N>>1 {\n  1027\t\t\t\tif r.IsLeader {\n  1028\t\t\t\t\tr.makeBallot(areply.Replica, areply.Instance)\n  1029\t\t\t\t\tr.bcastPrepare(areply.Replica, areply.Instance)\n  1030\t\t\t\t}\n  1031\t\t\t}\n  1032\t\t\treturn\n  1033\t\t}\n  1034\t\n  1035\t\tinst.lb.acceptOKs++\n  1036\t\n  1037\t\tif inst.lb.acceptOKs+1 > r.N/2 {\n  1038\t\t\tlb.status = COMMITTED\n  1039\t\t\tinst.Status = COMMITTED\n  1040\t\t\tr.updateCommitted(areply.Replica)\n  1041\t\t\tr.recordInstanceMetadata(inst)\n  1042\t\t\tr.sync()\n  1043\t\n  1044\t\t\tif inst.lb.clientProposals != nil && !r.Dreply {\n  1045\t\t\t\tfor i := 0; i < len(inst.lb.clientProposals); i++ {\n  1046\t\t\t\t\tr.ReplyProposeTS(\n  1047\t\t\t\t\t\t&defs.ProposeReplyTS{\n  1048\t\t\t\t\t\t\tTRUE,\n  1049\t\t\t\t\t\t\tinst.lb.clientProposals[i].CommandId,\n  1050\t\t\t\t\t\t\tstate.NIL(),\n  1051\t\t\t\t\t\t\tinst.lb.clientProposals[i].Timestamp},\n  1052\t\t\t\t\t\tinst.lb.clientProposals[i].Reply,\n  1053\t\t\t\t\t\tinst.lb.clientProposals[i].Mutex)\n  1054\t\t\t\t}\n  1055\t\t\t}\n  1056\t\n  1057\t\t\tr.bcastCommit(areply.Replica, areply.Instance)\n  1058\t\t\tr.M.Lock()\n  1059\t\t\tif inst.proposeTime != 0 {\n  1060\t\t\t\tr.Stats.M[\"totalCommitTime\"] += int(time.Now().UnixNano() - inst.proposeTime)\n  1061\t\t\t}\n  1062\t\t\tr.M.Unlock()\n  1063\t\t}\n  1064\t}\n  1065\t\n  1066\tfunc (r *Replica) handleCommit(commit *Commit) {\n  1508\tfunc (r *Replica) newInstanceDefault(replica int32, instance int32) *Instance {\n  1509\t\treturn r.newInstance(replica, instance, nil, -1, -1, NONE, -1, nil)\n  1510\t}\n  1511\t\n  1512\tfunc (r *Replica) newInstance(replica int32, instance int32, cmds []state.Command, cballot int32, lballot int32, status int8, seq int32, deps []int32) *Instance {\n  1513\t\treturn &Instance{cmds, cballot, lballot, status, seq, deps, nil, 0, 0, nil, time.Now().UnixNano(), &instanceId{replica, instance}}\n  1514\t}\n  1515\t\n  1516\tfunc (r *Replica) newLeaderBookkeepingDefault() *LeaderBookkeeping {\n  1517\t\treturn r.newLeaderBookkeeping(nil, r.newNilDeps(), r.newNilDeps(), r.newNilDeps(), 0, nil, NONE, -1)\n  1518\t}\n  1519\t\n  1520\tfunc (r *Replica) newLeaderBookkeeping(p []*defs.GPropose, originalDeps []int32, committedDeps []int32, deps []int32, lastTriedBallot int32, cmds []state.Command, status int8, seq int32) *LeaderBookkeeping {\n  1521\t\treturn &LeaderBookkeeping{p, -1, true, 0, 0, 0, originalDeps, committedDeps, nil, true, false, make([]bool, r.N), 0, false, lastTriedBallot, cmds, status, seq, deps, false}\n  1522\t}\n  1523\t\n  1524\tfunc (r *Replica) newNilDeps() []int32 {\n  1525\t\tnildeps := make([]int32, r.N)\n  1526\t\tfor i := 0; i < r.N; i++ {\n  1527\t\t\tnildeps[i] = -1\n  1528\t\t}\n  1529\t\treturn nildeps\n  1530\t}\n   215\tfunc (r *Replica) SendMsg(peerId int32, code uint8, msg fastrpc.Serializable) {\n   216\t\tr.M.Lock()\n   217\t\tdefer r.M.Unlock()\n   218\t\n   219\t\tw := r.PeerWriters[peerId]\n   220\t\tif w == nil {\n   221\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   222\t\t\treturn\n   223\t\t}\n   224\t\tw.WriteByte(code)\n   225\t\tmsg.Marshal(w)\n   226\t\tw.Flush()\n   227\t}\n   228\t\n   229\tfunc (r *Replica) SendClientMsg(id int32, code uint8, msg fastrpc.Serializable) {\n   230\t\tr.M.Lock()\n   231\t\tdefer r.M.Unlock()\n   232\t\n   233\t\tw := r.ClientWriters[id]\n   234\t\tif w == nil {\n   235\t\t\tr.Printf(\"Connection to client %d lost!\", id)\n   236\t\t\treturn\n   237\t\t}\n   238\t\tw.WriteByte(code)\n   239\t\tmsg.Marshal(w)\n   240\t\tw.Flush()\n   241\t}\n   242\t\n   243\tfunc (r *Replica) SendMsgNoFlush(peerId int32, code uint8, msg fastrpc.Serializable) {\n   448\t\t\t\tnow := time.Now().UnixNano()\n   449\t\t\t\tr.Ewma[rid] = 0.99*r.Ewma[rid] + 0.01*float64(now-gbeaconReply.Timestamp)\n   450\t\t\t\tbreak\n   451\t\n   452\t\t\tdefault:\n   453\t\t\t\tp, exists := r.RPC.Get(msgType)\n   454\t\t\t\tif exists {\n   455\t\t\t\t\tobj := p.Obj.New()\n   456\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   457\t\t\t\t\t\tbreak\n   458\t\t\t\t\t}\n   459\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   460\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDurationID(rid))\n   461\t\t\t\t\t\tp.Chan <- obj\n   462\t\t\t\t\t}(obj)\n   463\t\t\t\t} else {\n   464\t\t\t\t\tr.Fatal(\"Error: received unknown message type \", msgType, \" from \", rid)\n   465\t\t\t\t}\n   466\t\t\t}\n   467\t\t}\n   468\t\n","exit_code":0,"status":"completed"}}
