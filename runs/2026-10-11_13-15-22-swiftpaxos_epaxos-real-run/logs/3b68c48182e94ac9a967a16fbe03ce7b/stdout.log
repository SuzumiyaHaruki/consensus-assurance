{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"nl -ba ../agent-source/epaxos/epaxos.go | sed -n '1,240p'; nl -ba ../agent-source/epaxos/epaxos.go | sed -n '435,495p'; nl -ba ../agent-source/replica/replica.go | sed -n '1,220p'\"","aggregated_output":"     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t\t\"encoding/binary\"\n     5\t\t\"io\"\n     6\t\t\"sync\"\n     7\t\t\"time\"\n     8\t\n     9\t\t\"github.com/imdea-software/swiftpaxos/config\"\n    10\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    11\t\t\"github.com/imdea-software/swiftpaxos/replica\"\n    12\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    13\t\tfastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n    14\t\t\"github.com/imdea-software/swiftpaxos/state\"\n    15\t)\n    16\t\n    17\tconst MAX_INSTANCE = 10 * 1024 * 1024\n    18\t\n    19\tconst MAX_DEPTH_DEP = 10\n    20\tconst TRUE = uint8(1)\n    21\tconst FALSE = uint8(0)\n    22\tconst ADAPT_TIME_SEC = 10\n    23\t\n    24\tconst COMMIT_GRACE_PERIOD = 10 * 1e9 // 10 second(s)\n    25\t\n    26\tconst BF_K = 4\n    27\tconst BF_M_N = 32.0\n    28\t\n    29\tconst HT_INIT_SIZE = 200000\n    30\t\n    31\t// main differences with the original code base\n    32\t// - fix N=3 case\n    33\t// - add vbal variable (TLA spec. is wrong)\n    34\t// - remove checkpoints (need to fix them first)\n    35\t// - remove short commits (with N>7 propagating committed dependencies is necessary)\n    36\t// - must run with thriftiness on (recovery is incorrect otherwise)\n    37\t// - when conflicts are transitive skip waiting prior commuting commands\n    38\t\n    39\tvar cpMarker []state.Command\n    40\tvar cpcounter = 0\n    41\t\n    42\ttype Replica struct {\n    43\t\t*replica.Replica\n    44\t\tprepareChan           chan fastrpc.Serializable\n    45\t\tpreAcceptChan         chan fastrpc.Serializable\n    46\t\tacceptChan            chan fastrpc.Serializable\n    47\t\tcommitChan            chan fastrpc.Serializable\n    48\t\tprepareReplyChan      chan fastrpc.Serializable\n    49\t\tpreAcceptReplyChan    chan fastrpc.Serializable\n    50\t\tpreAcceptOKChan       chan fastrpc.Serializable\n    51\t\tacceptReplyChan       chan fastrpc.Serializable\n    52\t\ttryPreAcceptChan      chan fastrpc.Serializable\n    53\t\ttryPreAcceptReplyChan chan fastrpc.Serializable\n    54\t\tprepareRPC            uint8\n    55\t\tprepareReplyRPC       uint8\n    56\t\tpreAcceptRPC          uint8\n    57\t\tpreAcceptReplyRPC     uint8\n    58\t\tacceptRPC             uint8\n    59\t\tacceptReplyRPC        uint8\n    60\t\tcommitRPC             uint8\n    61\t\ttryPreAcceptRPC       uint8\n    62\t\ttryPreAcceptReplyRPC  uint8\n    63\t\t// the space of all instances (used and not yet used)\n    64\t\tInstanceSpace [][]*Instance\n    65\t\t// highest active instance numbers that this replica knows about\n    66\t\tcrtInstance []int32\n    67\t\t// highest committed instance per replica that this replica knows about\n    68\t\tCommittedUpTo []int32\n    69\t\t// instance up to which all commands have been executed (including iteslf)\n    70\t\tExecedUpTo       []int32\n    71\t\texec             *Exec\n    72\t\tconflicts        []map[state.Key]*InstPair\n    73\t\tmaxSeqPerKey     map[state.Key]int32\n    74\t\tmaxSeq           int32\n    75\t\tlatestCPReplica  int32\n    76\t\tlatestCPInstance int32\n    77\t\t// for synchronizing when sending replies to clients\n    78\t\t// from multiple go-routines\n    79\t\tclientMutex        *sync.Mutex\n    80\t\tinstancesToRecover chan *instanceId\n    81\t\t// does this replica think it is the leader\n    82\t\tIsLeader      bool\n    83\t\tmaxRecvBallot int32\n    84\t\tbatchWait     int\n    85\t\ttransconf     bool\n    86\t}\n    87\t\n    88\ttype InstPair struct {\n    89\t\tlast      int32\n    90\t\tlastWrite int32\n    91\t}\n    92\t\n    93\ttype Instance struct {\n    94\t\tCmds           []state.Command\n    95\t\tbal, vbal      int32\n    96\t\tStatus         int8\n    97\t\tSeq            int32\n    98\t\tDeps           []int32\n    99\t\tlb             *LeaderBookkeeping\n   100\t\tIndex, Lowlink int\n   101\t\tbfilter        any\n   102\t\tproposeTime    int64\n   103\t\tid             *instanceId\n   104\t}\n   105\t\n   106\ttype instanceId struct {\n   107\t\treplica  int32\n   108\t\tinstance int32\n   109\t}\n   110\t\n   111\ttype LeaderBookkeeping struct {\n   112\t\tclientProposals   []*defs.GPropose\n   113\t\tballot            int32\n   114\t\tallEqual          bool\n   115\t\tpreAcceptOKs      int\n   116\t\tacceptOKs         int\n   117\t\tnacks             int\n   118\t\toriginalDeps      []int32\n   119\t\tcommittedDeps     []int32\n   120\t\tprepareReplies    []*PrepareReply\n   121\t\tpreparing         bool\n   122\t\ttryingToPreAccept bool\n   123\t\tpossibleQuorum    []bool\n   124\t\ttpaReps           int\n   125\t\ttpaAccepted       bool\n   126\t\tlastTriedBallot   int32\n   127\t\tcmds              []state.Command\n   128\t\tstatus            int8\n   129\t\tseq               int32\n   130\t\tdeps              []int32\n   131\t\tleaderResponded   bool\n   132\t}\n   133\t\n   134\tfunc New(alias string, id int, peerAddrList []string, exec, beacon, durable bool, batchWait int, transconf bool, failures int, conf *config.Config, logger *dlog.Logger) *Replica {\n   135\t\tr := &Replica{\n   136\t\t\treplica.New(alias, id, failures, peerAddrList, true, exec, false, conf, logger),\n   137\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   138\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   139\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   140\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   141\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   142\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE*3),\n   143\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE*3),\n   144\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE*2),\n   145\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   146\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   147\t\t\t0, 0, 0, 0, 0, 0, 0, 0, 0,\n   148\t\t\tmake([][]*Instance, len(peerAddrList)),\n   149\t\t\tmake([]int32, len(peerAddrList)),\n   150\t\t\tmake([]int32, len(peerAddrList)),\n   151\t\t\tmake([]int32, len(peerAddrList)),\n   152\t\t\tnil,\n   153\t\t\tmake([]map[state.Key]*InstPair, len(peerAddrList)),\n   154\t\t\tmake(map[state.Key]int32),\n   155\t\t\t0,\n   156\t\t\t0,\n   157\t\t\t-1,\n   158\t\t\tnew(sync.Mutex),\n   159\t\t\tmake(chan *instanceId, defs.CHAN_BUFFER_SIZE),\n   160\t\t\tfalse,\n   161\t\t\t-1,\n   162\t\t\tbatchWait,\n   163\t\t\ttransconf,\n   164\t\t}\n   165\t\n   166\t\tr.Beacon = beacon\n   167\t\tr.Durable = durable\n   168\t\n   169\t\tfor i := 0; i < r.N; i++ {\n   170\t\t\tr.InstanceSpace[i] = make([]*Instance, MAX_INSTANCE) // FIXME\n   171\t\t\tr.crtInstance[i] = -1\n   172\t\t\tr.ExecedUpTo[i] = -1\n   173\t\t\tr.CommittedUpTo[i] = -1\n   174\t\t\tr.conflicts[i] = make(map[state.Key]*InstPair, HT_INIT_SIZE)\n   175\t\t}\n   176\t\n   177\t\tr.exec = &Exec{r}\n   178\t\n   179\t\tcpMarker = make([]state.Command, 0)\n   180\t\n   181\t\t//register RPCs\n   182\t\tr.prepareRPC = r.RPC.Register(new(Prepare), r.prepareChan)\n   183\t\tr.prepareReplyRPC = r.RPC.Register(new(PrepareReply), r.prepareReplyChan)\n   184\t\tr.preAcceptRPC = r.RPC.Register(new(PreAccept), r.preAcceptChan)\n   185\t\tr.preAcceptReplyRPC = r.RPC.Register(new(PreAcceptReply), r.preAcceptReplyChan)\n   186\t\tr.acceptRPC = r.RPC.Register(new(Accept), r.acceptChan)\n   187\t\tr.acceptReplyRPC = r.RPC.Register(new(AcceptReply), r.acceptReplyChan)\n   188\t\tr.commitRPC = r.RPC.Register(new(Commit), r.commitChan)\n   189\t\tr.tryPreAcceptRPC = r.RPC.Register(new(TryPreAccept), r.tryPreAcceptChan)\n   190\t\tr.tryPreAcceptReplyRPC = r.RPC.Register(new(TryPreAcceptReply), r.tryPreAcceptReplyChan)\n   191\t\n   192\t\tr.Stats.M[\"weird\"], r.Stats.M[\"conflicted\"], r.Stats.M[\"slow\"], r.Stats.M[\"fast\"], r.Stats.M[\"totalCommitTime\"], r.Stats.M[\"totalBatching\"], r.Stats.M[\"totalBatchingSize\"] = 0, 0, 0, 0, 0, 0, 0\n   193\t\n   194\t\tgo r.run()\n   195\t\n   196\t\treturn r\n   197\t}\n   198\t\n   199\tfunc (r *Replica) recordInstanceMetadata(inst *Instance) {\n   200\t\tif !r.Durable {\n   201\t\t\treturn\n   202\t\t}\n   203\t\n   204\t\tb := make([]byte, 9+r.N*4)\n   205\t\tbinary.LittleEndian.PutUint32(b[0:4], uint32(inst.bal))\n   206\t\tbinary.LittleEndian.PutUint32(b[0:4], uint32(inst.vbal))\n   207\t\tb[4] = byte(inst.Status)\n   208\t\tbinary.LittleEndian.PutUint32(b[5:9], uint32(inst.Seq))\n   209\t\tl := 9\n   210\t\tfor _, dep := range inst.Deps {\n   211\t\t\tbinary.LittleEndian.PutUint32(b[l:l+4], uint32(dep))\n   212\t\t\tl += 4\n   213\t\t}\n   214\t\tr.StableStore.Write(b[:])\n   215\t}\n   216\t\n   217\tfunc (r *Replica) recordCommands(cmds []state.Command) {\n   218\t\tif !r.Durable {\n   219\t\t\treturn\n   220\t\t}\n   221\t\n   222\t\tif cmds == nil {\n   223\t\t\treturn\n   224\t\t}\n   225\t\tfor i := 0; i < len(cmds); i++ {\n   226\t\t\tcmds[i].Marshal(io.Writer(r.StableStore))\n   227\t\t}\n   228\t}\n   229\t\n   230\tfunc (r *Replica) sync() {\n   231\t\tif !r.Durable {\n   232\t\t\treturn\n   233\t\t}\n   234\t\n   235\t\tr.StableStore.Sync()\n   236\t}\n   237\t\n   238\tvar fastClockChan chan bool\n   239\tvar slowClockChan chan bool\n   240\t\n   435\tfunc isInitialBallot(ballot int32, replica int32, instance int32) bool {\n   436\t\treturn ballot == replica\n   437\t}\n   438\t\n   439\tfunc (r *Replica) makeBallot(replica int32, instance int32) {\n   440\t\tlb := r.InstanceSpace[replica][instance].lb\n   441\t\tn := r.Id\n   442\t\tif r.Id != replica {\n   443\t\t\tn += int32(r.N)\n   444\t\t}\n   445\t\tif r.IsLeader {\n   446\t\t\tfor n < r.maxRecvBallot {\n   447\t\t\t\tn += int32(r.N)\n   448\t\t\t}\n   449\t\t}\n   450\t\tlb.lastTriedBallot = n\n   451\t}\n   452\t\n   453\tfunc (r *Replica) replyPrepare(replicaId int32, reply *PrepareReply) {\n   454\t\tr.SendMsg(replicaId, r.prepareReplyRPC, reply)\n   455\t}\n   456\t\n   457\tfunc (r *Replica) replyPreAccept(replicaId int32, reply *PreAcceptReply) {\n   458\t\tr.SendMsg(replicaId, r.preAcceptReplyRPC, reply)\n   459\t}\n   460\t\n   461\tfunc (r *Replica) replyAccept(replicaId int32, reply *AcceptReply) {\n   462\t\tr.SendMsg(replicaId, r.acceptReplyRPC, reply)\n   463\t}\n   464\t\n   465\tfunc (r *Replica) replyTryPreAccept(replicaId int32, reply *TryPreAcceptReply) {\n   466\t\tr.SendMsg(replicaId, r.tryPreAcceptReplyRPC, reply)\n   467\t}\n   468\t\n   469\tfunc (r *Replica) bcastPrepare(replica int32, instance int32) {\n   470\t\tdefer func() {\n   471\t\t\tif err := recover(); err != nil {\n   472\t\t\t\tr.Println(\"Prepare bcast failed:\", err)\n   473\t\t\t}\n   474\t\t}()\n   475\t\tlb := r.InstanceSpace[replica][instance].lb\n   476\t\targs := &Prepare{r.Id, replica, instance, lb.lastTriedBallot}\n   477\t\n   478\t\tn := r.N - 1\n   479\t\tq := r.Id\n   480\t\tfor sent := 0; sent < n; {\n   481\t\t\tq = (q + 1) % int32(r.N)\n   482\t\t\tif q == r.Id {\n   483\t\t\t\tbreak\n   484\t\t\t}\n   485\t\t\tif !r.Alive[q] {\n   486\t\t\t\tcontinue\n   487\t\t\t}\n   488\t\t\tr.SendMsg(q, r.prepareRPC, args)\n   489\t\t\tsent++\n   490\t\t}\n   491\t\n   492\t}\n   493\t\n   494\tfunc (r *Replica) bcastPreAccept(replica int32, instance int32) {\n   495\t\tdefer func() {\n     1\tpackage replica\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"encoding/binary\"\n     6\t\t\"encoding/json\"\n     7\t\t\"io\"\n     8\t\t\"math\"\n     9\t\t\"net\"\n    10\t\t\"os\"\n    11\t\t\"sort\"\n    12\t\t\"strings\"\n    13\t\t\"sync\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/imdea-software/swiftpaxos/config\"\n    17\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    18\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    19\t\tfastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n    20\t\t\"github.com/imdea-software/swiftpaxos/state\"\n    21\t)\n    22\t\n    23\ttype Replica struct {\n    24\t\t*dlog.Logger\n    25\t\n    26\t\tM     sync.Mutex\n    27\t\tN     int\n    28\t\tF     int\n    29\t\tId    int32\n    30\t\tAlias string\n    31\t\n    32\t\tPeerAddrList       []string\n    33\t\tPeers              []net.Conn\n    34\t\tPeerReaders        []*bufio.Reader\n    35\t\tPeerWriters        []*bufio.Writer\n    36\t\tClientWriters      map[int32]*bufio.Writer\n    37\t\tConfig             *config.Config\n    38\t\tAlive              []bool\n    39\t\tPreferredPeerOrder []int32\n    40\t\n    41\t\tState       *state.State\n    42\t\tRPC         *fastrpc.Table\n    43\t\tStableStore *os.File\n    44\t\tStats       *defs.Stats\n    45\t\tShutdown    bool\n    46\t\tListener    net.Listener\n    47\t\tProposeChan chan *defs.GPropose\n    48\t\tBeaconChan  chan *defs.GBeacon\n    49\t\n    50\t\tThrifty bool\n    51\t\tExec    bool\n    52\t\tLRead   bool\n    53\t\tDreply  bool\n    54\t\tBeacon  bool\n    55\t\tDurable bool\n    56\t\n    57\t\tEwma      []float64\n    58\t\tLatencies []int64\n    59\t\n    60\t\tDt *defs.LatencyTable\n    61\t}\n    62\t\n    63\tfunc New(alias string, id, f int, addrs []string, thrifty, exec, lread bool, config *config.Config, l *dlog.Logger) *Replica {\n    64\t\tn := len(addrs)\n    65\t\tr := &Replica{\n    66\t\t\tLogger: l,\n    67\t\n    68\t\t\tN:     n,\n    69\t\t\tF:     f,\n    70\t\t\tId:    int32(id),\n    71\t\t\tAlias: alias,\n    72\t\n    73\t\t\tPeerAddrList:       addrs,\n    74\t\t\tPeers:              make([]net.Conn, n),\n    75\t\t\tPeerReaders:        make([]*bufio.Reader, n),\n    76\t\t\tPeerWriters:        make([]*bufio.Writer, n),\n    77\t\t\tClientWriters:      make(map[int32]*bufio.Writer),\n    78\t\t\tConfig:             config,\n    79\t\t\tAlive:              make([]bool, n),\n    80\t\t\tPreferredPeerOrder: make([]int32, n),\n    81\t\n    82\t\t\tState:       state.InitState(),\n    83\t\t\tRPC:         fastrpc.NewTableId(defs.RPC_TABLE),\n    84\t\t\tStableStore: nil,\n    85\t\t\tStats:       &defs.Stats{make(map[string]int)},\n    86\t\t\tShutdown:    false,\n    87\t\t\tListener:    nil,\n    88\t\t\tProposeChan: make(chan *defs.GPropose, defs.CHAN_BUFFER_SIZE),\n    89\t\t\tBeaconChan:  make(chan *defs.GBeacon, defs.CHAN_BUFFER_SIZE),\n    90\t\n    91\t\t\tThrifty: thrifty,\n    92\t\t\tExec:    exec,\n    93\t\t\tLRead:   lread,\n    94\t\t\tDreply:  true,\n    95\t\t\tBeacon:  false,\n    96\t\t\tDurable: false,\n    97\t\n    98\t\t\tEwma:      make([]float64, n),\n    99\t\t\tLatencies: make([]int64, n),\n   100\t\n   101\t\t\tDt: defs.NewLatencyTable(defs.LatencyConf, defs.IP(), addrs),\n   102\t\t}\n   103\t\n   104\t\tfor i := 0; i < r.N; i++ {\n   105\t\t\tr.PreferredPeerOrder[i] = int32((int(r.Id) + 1 + i) % r.N)\n   106\t\t\tr.Ewma[i] = 0.0\n   107\t\t\tr.Latencies[i] = 0\n   108\t\t}\n   109\t\n   110\t\treturn r\n   111\t}\n   112\t\n   113\tfunc (r *Replica) Ping(args *defs.PingArgs, reply *defs.PingReply) error {\n   114\t\treturn nil\n   115\t}\n   116\t\n   117\tfunc (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n   118\t\treturn nil\n   119\t}\n   120\t\n   121\tfunc (r *Replica) FastQuorumSize() int {\n   122\t\treturn r.F + (r.F+1)/2\n   123\t}\n   124\t\n   125\tfunc (r *Replica) SlowQuorumSize() int {\n   126\t\treturn (r.N + 1) / 2\n   127\t}\n   128\t\n   129\tfunc (r *Replica) WriteQuorumSize() int {\n   130\t\treturn r.F + 1\n   131\t}\n   132\t\n   133\tfunc (r *Replica) ReadQuorumSize() int {\n   134\t\treturn r.N - r.F\n   135\t}\n   136\t\n   137\tfunc (r *Replica) ConnectToPeers() {\n   138\t\tvar b [4]byte\n   139\t\tbs := b[:4]\n   140\t\tdone := make(chan bool)\n   141\t\n   142\t\tgo r.waitForPeerConnections(done)\n   143\t\n   144\t\tfor i := 0; i < int(r.Id); i++ {\n   145\t\t\tfor {\n   146\t\t\t\tif conn, err := net.Dial(\"tcp\", r.PeerAddrList[i]); err == nil {\n   147\t\t\t\t\tr.Peers[i] = conn\n   148\t\t\t\t\tbreak\n   149\t\t\t\t}\n   150\t\t\t\ttime.Sleep(1e9)\n   151\t\t\t}\n   152\t\t\tbinary.LittleEndian.PutUint32(bs, uint32(r.Id))\n   153\t\t\tif _, err := r.Peers[i].Write(bs); err != nil {\n   154\t\t\t\tr.Println(\"Write id error:\", err)\n   155\t\t\t\tcontinue\n   156\t\t\t}\n   157\t\t\tr.Alive[i] = true\n   158\t\t\tr.PeerReaders[i] = bufio.NewReader(r.Peers[i])\n   159\t\t\tr.PeerWriters[i] = bufio.NewWriter(r.Peers[i])\n   160\t\t\tr.Printf(\"OUT Connected to %d\", i)\n   161\t\t}\n   162\t\t<-done\n   163\t\tr.Printf(\"Replica %d: done connecting to peers\", r.Id)\n   164\t\tr.Printf(\"Node list %v\", r.PeerAddrList)\n   165\t\n   166\t\tfor rid, reader := range r.PeerReaders {\n   167\t\t\tif int32(rid) == r.Id {\n   168\t\t\t\tcontinue\n   169\t\t\t}\n   170\t\t\tgo r.replicaListener(rid, reader)\n   171\t\t}\n   172\t}\n   173\t\n   174\tfunc (r *Replica) ConnectToPeersNoListeners() {\n   175\t\tvar b [4]byte\n   176\t\tbs := b[:4]\n   177\t\tdone := make(chan bool)\n   178\t\n   179\t\tgo r.waitForPeerConnections(done)\n   180\t\n   181\t\tfor i := 0; i < int(r.Id); i++ {\n   182\t\t\tfor {\n   183\t\t\t\tif conn, err := net.Dial(\"tcp\", r.PeerAddrList[i]); err == nil {\n   184\t\t\t\t\tr.Peers[i] = conn\n   185\t\t\t\t\tbreak\n   186\t\t\t\t}\n   187\t\t\t\ttime.Sleep(1e9)\n   188\t\t\t}\n   189\t\t\tbinary.LittleEndian.PutUint32(bs, uint32(r.Id))\n   190\t\t\tif _, err := r.Peers[i].Write(bs); err != nil {\n   191\t\t\t\tr.Println(\"Write id error:\", err)\n   192\t\t\t\tcontinue\n   193\t\t\t}\n   194\t\t\tr.Alive[i] = true\n   195\t\t\tr.PeerReaders[i] = bufio.NewReader(r.Peers[i])\n   196\t\t\tr.PeerWriters[i] = bufio.NewWriter(r.Peers[i])\n   197\t\t}\n   198\t\t<-done\n   199\t\tr.Printf(\"Replica id: %d. Do