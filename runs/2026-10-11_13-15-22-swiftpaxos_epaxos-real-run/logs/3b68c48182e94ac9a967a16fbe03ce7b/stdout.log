\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Id\"\n    },\n    \"knowledge\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/KnowledgeUse\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Knowledge\"\n    },\n    \"counterevidence\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Counterevidence\"\n    },\n    \"limitations\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Limitations\"\n    },\n    \"resume_conditions\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Resume Conditions\"\n    }\n  },\n  \"title\": \"QuestionUpdate\",\n  \"type\": \"object\"\n}\nSourceRange {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"file\": {\n      \"title\": \"File\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"document_statement\",\n        \"interface_statement\",\n        \"test_expectation\",\n        \"code_observation\",\n        \"protocol_candidate\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"file\",\n    \"start_line\",\n    \"end_line\",\n    \"kind\"\n  ],\n  \"title\": \"SourceRange\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
