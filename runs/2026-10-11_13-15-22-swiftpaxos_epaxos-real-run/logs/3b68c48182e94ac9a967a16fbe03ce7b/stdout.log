y\": {\n      \"default\": \"\",\n      \"title\": \"Responsibility\",\n      \"type\": \"string\"\n    },\n    \"prerequisites\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventRequirement\"\n      },\n      \"title\": \"Prerequisites\",\n      \"type\": \"array\"\n    },\n    \"comparisons\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventComparison\"\n      },\n      \"title\": \"Comparisons\",\n      \"type\": \"array\"\n    },\n    \"knowledge\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/KnowledgeUse\"\n      },\n      \"title\": \"Knowledge\",\n      \"type\": \"array\"\n    },\n    \"previous_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Id\"\n    },\n    \"revision_reason\": {\n      \"default\": \"\",\n      \"title\": \"Revision Reason\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"investigation_id\",\n    \"harness_path\",\n    \"source_ids\",\n    \"scope\",\n    \"prefix\"\n  ],\n  \"title\": \"ExperimentRequest\",\n  \"type\": \"object\"\n}\nScope {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"assumptions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Assumptions\",\n      \"type\": \"array\"\n    },\n    \"excluded\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Excluded\",\n      \"type\": \"array\"\n    },\n    \"parameters\": {\n      \"additionalProperties\": true,\n      \"default\": {},\n      \"title\": \"Parameters\",\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"description\"\n  ],\n  \"title\": \"Scope\",\n  \"type\":