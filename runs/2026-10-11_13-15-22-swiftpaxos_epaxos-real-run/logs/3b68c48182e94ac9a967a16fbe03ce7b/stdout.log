 > r.maxRecvBallot {\n  1176\t\t\tr.maxRecvBallot = prepare.Ballot\n  1177\t\t}\n  1178\t\n  1179\t\tif inst == nil {\n  1180\t\t\tr.InstanceSpace[prepare.Replica][prepare.Instance] = r.newInstanceDefault(prepare.Replica, prepare.Instance)\n  1181\t\t\tinst = r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1182\t\t}\n  1183\t\n  1184\t\tif prepare.Ballot < inst.bal {\n  1185\t\t\tr.Printf(\"Joined higher ballot %d < %d\", prepare.Ballot, inst.bal)\n  1186\t\t} else if inst.bal < prepare.Ballot {\n  1187\t\t\tr.Printf(\"Joining ballot %d \", prepare.Ballot)\n  1188\t\t\tinst.bal = prepare.Ballot\n  1189\t\t}\n  1190\t\n  1191\t\tpreply = &PrepareReply{\n  1192\t\t\tr.Id,\n  1193\t\t\tprepare.Replica,\n  1194\t\t\tprepare.Instance,\n  1195\t\t\tinst.bal,\n  1196\t\t\tinst.vbal,\n  1197\t\t\tinst.Status,\n  1198\t\t\tinst.Cmds,\n  1199\t\t\tinst.Seq,\n  1200\t\t\tinst.Deps}\n  1201\t\tr.replyPrepare(prepare.LeaderId, preply)\n  1202\t}\n  1203\t\n  1204\tfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n  1205\t\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n  1206\t\tlb := inst.lb\n  1207\t\n  1208\t\tif preply.Ballot > r.maxRecvBallot {\n  1209\t\t\tr.maxRecvBallot = preply.Ballot\n  1210\t\t}\n  1211\t\n  1212\t\tif inst == nil || lb == nil || !lb.preparing {\n  1213\t\t\treturn\n  1214\t\t}\n  1215\t\n  1216\t\tif preply.Ballot != lb.lastTriedBallot {\n  1217\t\t\tlb.nacks++\n  1218\t\t\treturn\n  1219\t\t}\n  1220\t\n  1221\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1222\t\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n  1223\t\t\treturn\n  1224\t\t}\n  1225\t\n  1226\t\tlb.preparing = false\n  1227\t\n  1228\t\t// Deal with each sub-cases in order of the (corrected) TLA specification\n  1229\t\t// only replies from the highest ballot are taken into account\n  1230\t\t// 1 -> committed/executed\n  1231\t\t// 2 -> accepted\n  1232\t\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n  1233\t\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n  1234\t\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n  1235\t\t// 6 -> none of the above\n  1236\t\tpreAcceptCount := 0\n  1237\t\tsubCase := 0\n  1238\t\tallEqual := true\n  1239\t\tfor _, element := range lb.prepareReplies {\n  1240\t\t\tif element.VBallot >= lb.ballot {\n  1241\t\t\t\tlb.ballot = element.VBallot\n  1242\t\t\t\tlb.cmds = element.Command\n  1243\t\t\t\tlb.seq = element.Seq\n  1244\t\t\t\tlb.deps = element.Deps\n  1245\t\t\t\tlb.status = element.Status\n  1246\t\t\t}\n  1247\t\t\tif element.AcceptorId == element.Replica {\n  1248\t\t\t\tlb.leaderResponded = true\n  1249\t\t\t}\n  1250\t\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n  1251\t\t\t\tpreAcceptCount++\n  1252\t\t\t}\n  1253\t\t}\n  1254\t\n  1255\t\tif lb.status >= COMMITTED { // 1\n  1256\t\t\tsubCase = 1\n  1257\t\t} else if lb.status == ACCEPTED { // 2\n  1258\t\t\tsubCase = 2\n  1259\t\t} else if lb.status == PREACCEPTED || lb.status == PREACCEPTED_EQ {\n  1260\t\t\tfor _, element := range lb.prepareReplies {\n  1261\t\t\t\tif element.VBallot == lb.ballot && element.Status >= PREACCEPTED {\n  1262\t\t\t\t\t_, _, equal := r.mergeAttributes(lb.seq, lb.deps, element.Seq, element.Deps)\n  1263\t\t\t\t\tif !equal {\n  1264\t\t\t\t\t\tallEqual = false\n  1265\t\t\t\t\t\tbreak\n  1266\t\t\t\t\t}\n  1267\t\t\t\t}\n  1268\t\t\t}\n  1269\t\t\tif preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1270\t\t\t\tsubCase = 3\n  1271\t\t\t} else if preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1272\t\t\t\tsubCase = 4\n  1273\t\t\t} else if preAcceptCount > 0 && (lb.leaderResponded || !allEqual || preAcceptCount < r.Replica.SlowQuorumSize()-1) {\n  1274\t\t\t\tsubCase = 5\n  1275\t\t\t} else {\n  1276\t\t\t\tpanic(\"Cannot occur\")\n  1277\t\t\t}\n  1278\t\t} else if lb.status == NONE {\n  1279\t\t\tsubCase = 6\n  1280\t\t} else {\n  1281\t\t\tpanic(\"Status unknown\")\n  1282\t\t}\n  1283\t\n  1284\t\t// if subCase != 5 {\n  1285\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d\\n\", preply.Replica, preply.Instance, subCase)\n  1286\t\t// } else {\n  1287\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d with (leaderResponded=%t, allEqual=%t, enough=%t)\\n\",\n  1288\t\t// \t\tpreply.Replica, preply.Instance, subCase, lb.leaderResponded, allEqual, preAcceptCount < r.Replica.SlowQuorumSize()-1)\n  1289\t\t// }\n  1290\t\n  1291\t\tinst.Cmds = lb.cmds\n  1292\t\tinst.bal = lb.lastTriedBallot\n  1293\t\tinst.vbal = lb.lastTriedBallot\n  1294\t\tinst.Seq = lb.seq\n  1295\t\tinst.Deps = lb.deps\n  1296\t\tinst.Status = lb.status\n  1297\t\n  1298\t\tif subCase == 1 {\n  1299\t\t\t// nothing to do\n  1300\t\t} else if subCase == 2 || subCase == 3 {\n  1301\t\t\tinst.Status = ACCEPTED\n  1302\t\t\tlb.status = ACCEPTED\n  1303\t\t\tr.bcastAccept(preply.Replica, preply.Instance)\n  1304\t\t} else if subCase == 4 {\n  1305\t\t\tlb.tryingToPreAccept = true\n  1306\t\t\tr.bcastTryPreAccept(preply.Replica, preply.Instance)\n  1307\t\t} else { // subCase 5 and 6\n  1308\t\t\tcmd := state.NOOP()\n  1309\t\t\tif inst.lb.cmds != nil {\n  1310\t\t\t\tcmd = inst.lb.cmds\n  1311\t\t\t}\n  1312\t\t\tr.startPhase1(cmd, preply.Replica, preply.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1313\t\t}\n  1314\t}\n  1315\t\n  1316\tfunc (r *Replica) handleTryPreAccept(tpa *TryPreAccept) {\n   781\tfunc (r *Replica) handlePreAccept(preAccept *PreAccept) {\n   782\t\tinst := r.InstanceSpace[preAccept.Replica][preAccept.Instance]\n   783\t\n   784\t\tif preAccept.Seq >= r.maxSeq {\n   785\t\t\tr.maxSeq = preAccept.Seq + 1\n   786\t\t}\n   787\t\n   788\t\tif preAccept.Ballot > r.maxRecvBallot {\n   789\t\t\tr.maxRecvBallot = preAccept.Ballot\n   790\t\t}\n   791\t\n   792\t\tif preAccept.Instance > r.crtInstance[preAccept.Replica] {\n   793\t\t\tr.crtInstance[preAccept.Replica] = preAccept.Instance\n   794\t\t}\n   795\t\n   796\t\tif inst == nil {\n   797\t\t\tinst = r.newInstanceDefault(preAccept.Replica, preAccept.Instance)\n   798\t\t\tr.InstanceSpace[preAccept.Replica][preAccept.Instance] = inst\n   799\t\t}\n   800\t\n   801\t\tif inst != nil && preAccept.Ballot < inst.bal {\n   802\t\t\treturn\n   803\t\t}\n   804\t\n   805\t\tinst.bal = preAccept.Ballot\n   806\t\n   807\t\tif inst.Status >= ACCEPTED {\n   808\t\t\tif inst.Cmds == nil {\n   809\t\t\t\tr.InstanceSpace[preAccept.LeaderId][preAccept.Instance].Cmds = preAccept.Command\n   810\t\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n   811\t\t\t\tr.recordCommands(preAccept.Command)\n   812\t\t\t\tr.sync()\n   813\t\t\t}\n   814\t\n   815\t\t} else {\n   816\t\t\tseq, deps, changed := r.updateAttributes(preAccept.Command, preAccept.Seq, preAccept.Deps, preAccept.Replica, preAccept.Instance)\n   817\t\t\tstatus := PREACCEPTED_EQ\n   818\t\t\tif changed {\n   819\t\t\t\tstatus = PREACCEPTED\n   820\t\t\t}\n   821\t\t\tinst.Cmds = preAccept.Command\n   822\t\t\tinst.Seq = seq\n   823\t\t\tinst.Deps = deps\n   824\t\t\tinst.bal = preAccept.Ballot\n   825\t\t\tinst.vbal = preAccept.Ballot\n   826\t\t\tinst.Status = status\n   827\t\n   828\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n   829\t\t\tr.recordInstanceMetadata(r.InstanceSpace[preAccept.Replica][preAccept.Instance])\n   830\t\t\tr.recordCommands(preAccept.Command)\n   831\t\t\tr.sync()\n   832\t\n   833\t\t}\n   834\t\n   835\t\treply := &PreAcceptReply{\n   836\t\t\tpreAccept.Replica,\n   837\t\t\tpreAccept.Instance,\n   838\t\t\tinst.bal,\n   839\t\t\tinst.vbal,\n   840\t\t\tinst.Seq,\n   841\t\t\tinst.Deps,\n   842\t\t\tr.CommittedUpTo,\n   843\t\t\tinst.Status}\n   844\t\tr.replyPreAccept(preAccept.LeaderId, reply)\n   845\t}\n   846\t\n   847\tfunc (r *Replica) handlePreAcceptReply(pareply *PreAcceptReply) {\n   848\t\tinst := r.InstanceSpace[pareply.Replica][pareply.Instance]\n   849\t\tlb := inst.lb\n   850\t\n   851\t\tif pareply.Ballot > r.maxRecvBallot {\n   852\t\t\tr.maxRecvBallot = pareply.Ballot\n   853\t\t}\n   854\t\n   855\t\tif lb.lastTriedBallot > pareply.Ballot {\n   856\t\t\treturn\n   857\t\t}\n   858\t\n   859\t\tif lb.lastTriedBallot < pareply.Ballot {\n   860\t\t\tlb.nacks++\n   861\t\t\tif lb.nacks+1 > r.N>>1 {\n   862\t\t\t\tif r.IsLeader {\n   863\t\t\t\t\tr.makeBallot(pareply.Replica, pareply.Instance)\n   864\t\t\t\t\tr.bcastPrepare(pareply.Replica, pareply.Instance)\n   865\t\t\t\t}\n   866\t\t\t}\n   867\t\t\treturn\n   868\t\t}\n   869\t\n   870\t\tif lb.status != PREACCEPTED && lb.status != PREACCEPTED_EQ {\n   871\t\t\treturn\n   872\t\t}\n   873\t\n   874\t\tinst.lb.preAcceptOKs++\n   875\t\n   876\t\tif pareply.VBallot > lb.ballot {\n   877\t\t\tlb.ballot = pareply.VBallot\n   878\t\t\tlb.seq = pareply.Seq\n   879\t\t\tlb.deps = pareply.Deps\n   880\t\t\tlb.status = pareply.Status\n   881\t\t}\n   882\t\n   883\t\tisInitialBallot := isInitialBallot(lb.lastTriedBallot, pareply.Replica, pareply.Instance)\n   884\t\n   885\t\tseq, deps, allEqual := r.mergeAttributes(lb.seq, lb.deps, pareply.Seq, pareply.Deps)\n   886\t\tif r.N <= 3 && r.Thrifty {\n   887\t\t\t// no need to check for equality\n   888\t\t} else {\n   889\t\t\tinst.lb.allEqual = inst.lb.allEqual && allEqual\n   890\t\t\tif !allEqual {\n   891\t\t\t\tr.M.Lock()\n   892\t\t\t\tr.Stats.M[\"conflicted\"]++\n   893\t\t\t\tr.M.Unlock()\n   894\t\t\t}\n   895\t\t}\n   896\t\n   897\t\tallCommitted := true\n   898\t\tif r.N > 7 {\n   899\t\t\tfor q := 0; q < r.N; q++ {\n   900\t\t\t\tif inst.lb.committedDeps[q] < pareply.CommittedDeps[q] {\n   901\t\t\t\t\tinst.lb.committedDeps[q] = pareply.CommittedDeps[q]\n   902\t\t\t\t}\n   903\t\t\t\tif inst.lb.committedDeps[q] < r.CommittedUpTo[q] {\n   904\t\t\t\t\tinst.lb.committedDeps[q] = r.CommittedUpTo[q]\n   905\t\t\t\t}\n   906\t\t\t\tif inst.lb.committedDeps[q] < inst.Deps[q] {\n   907\t\t\t\t\tallCommitted = false\n   908\t\t\t\t}\n   909\t\t\t}\n   910\t\t}\n   911\t\n   912\t\tif lb.status <= PREACCEPTED_EQ {\n   913\t\t\tlb.deps = deps\n   914\t\t\tlb.seq = seq\n   915\t\t}\n   916\t\n   917\t\tprecondition := inst.lb.allEqual && allCommitted && isInitialBallot\n   918\t\n   919\t\tif inst.lb.preAcceptOKs >= (r.Replica.FastQuorumSize()-1) && precondition {\n   920\t\t\tlb.status = COMMITTED\n","exit_code":0,"status":"completed"}}
