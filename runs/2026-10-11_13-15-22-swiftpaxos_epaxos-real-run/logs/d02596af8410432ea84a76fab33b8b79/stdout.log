25\t\t\t\tfor idx := 0; idx < len(w.Cmds); idx++ {\n   126\t\t\t\t\tshouldRespond := e.r.Dreply && w.lb != nil && w.lb.clientProposals != nil\n   127\t\t\t\t\tif w.Cmds[idx].Op == state.NONE {\n   128\t\t\t\t\t\t// nothing to do\n   129\t\t\t\t\t} else if shouldRespond {\n   130\t\t\t\t\t\tval := w.Cmds[idx].Execute(e.r.State)\n   131\t\t\t\t\t\te.r.ReplyProposeTS(\n   132\t\t\t\t\t\t\t&defs.ProposeReplyTS{\n   133\t\t\t\t\t\t\t\tTRUE,\n   134\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].CommandId,\n   135\t\t\t\t\t\t\t\tval,\n   136\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].Timestamp},\n   137\t\t\t\t\t\t\tw.lb.clientProposals[idx].Reply,\n   138\t\t\t\t\t\t\tw.lb.clientProposals[idx].Mutex)\n   139\t\t\t\t\t} else if w.Cmds[idx].Op == state.PUT {\n   140\t\t\t\t\t\tw.Cmds[idx].Execute(e.r.State)\n   141\t\t\t\t\t}\n   142\t\t\t\t}\n   143\t\t\t\tw.Status = EXECUTED\n   144\t\t\t}\n   145\t\t\tstack = stack[0:l]\n   146\t\t}\n   147\t\n   148\t\treturn true\n   149\t}\n   150\t\n","exit_code":0,"status":"completed"}}
