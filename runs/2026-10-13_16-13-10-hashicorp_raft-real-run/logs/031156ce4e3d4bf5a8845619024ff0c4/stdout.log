{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1000 && NR<=1110 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"1000\t\t\terr := &deferError{}\n1001\t\t\terr.init()\n1002\t\t\trepl.triggerDeferErrorCh <- err\n1003\t\t\tselect {\n1004\t\t\tcase err := <-err.errCh:\n1005\t\t\t\tif err != nil {\n1006\t\t\t\t\tdoneCh <- err\n1007\t\t\t\t\treturn\n1008\t\t\t\t}\n1009\t\t\tcase <-stopCh:\n1010\t\t\t\tdoneCh <- nil\n1011\t\t\t\treturn\n1012\t\t\t}\n1013\t\t}\n1014\t\n1015\t\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n1016\t\t// messaging for read-only queries. If this is implemented, the lease\n1017\t\t// has to be reset as well, in case leadership is transferred. This\n1018\t\t// implementation also has a lease, but it serves another purpose and\n1019\t\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n1020\t\t// setup in a similar way to the one in the thesis, but in practice\n1021\t\t// it's a timer that just tells the leader how often to check\n1022\t\t// heartbeats are still coming in.\n1023\t\n1024\t\t// Step 3: send TimeoutNow message to target server.\n1025\t\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n1026\t\tif err != nil {\n1027\t\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n1028\t\t}\n1029\t\tdoneCh <- err\n1030\t}\n1031\t\n1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n1033\t// within the last leader lease interval. If not, we need to step down,\n1034\t// as we may have lost connectivity. Returns the maximum duration without\n1035\t// contact. This must only be called from the main thread.\n1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n1037\t\t// Track contacted nodes, we can always contact ourself\n1038\t\tcontacted := 0\n1039\t\n1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n1042\t\t// changes between iterations below.\n1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n1044\t\n1045\t\t// Check each follower\n1046\t\tvar maxDiff time.Duration\n1047\t\tnow := time.Now()\n1048\t\tfor _, server := range r.configurations.latest.Servers {\n1049\t\t\tif server.Suffrage == Voter {\n1050\t\t\t\tif server.ID == r.localID {\n1051\t\t\t\t\tcontacted++\n1052\t\t\t\t\tcontinue\n1053\t\t\t\t}\n1054\t\t\t\tf := r.leaderState.replState[server.ID]\n1055\t\t\t\tdiff := now.Sub(f.LastContact())\n1056\t\t\t\tif diff <= leaseTimeout {\n1057\t\t\t\t\tcontacted++\n1058\t\t\t\t\tif diff > maxDiff {\n1059\t\t\t\t\t\tmaxDiff = diff\n1060\t\t\t\t\t}\n1061\t\t\t\t} else {\n1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n1065\t\t\t\t\t} else {\n1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n1067\t\t\t\t\t}\n1068\t\t\t\t}\n1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n1070\t\t\t}\n1071\t\t}\n1072\t\n1073\t\t// Verify we can contact a quorum\n1074\t\tquorum := r.quorumSize()\n1075\t\tif contacted < quorum {\n1076\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n1077\t\t\tr.setState(Follower)\n1078\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n1079\t\t}\n1080\t\treturn maxDiff\n1081\t}\n1082\t\n1083\t// quorumSize is used to return the quorum size. This must only be called on\n1084\t// the main thread.\n1085\t// TODO: revisit usage\n1086\tfunc (r *Raft) quorumSize() int {\n1087\t\tvoters := 0\n1088\t\tfor _, server := range r.configurations.latest.Servers {\n1089\t\t\tif server.Suffrage == Voter {\n1090\t\t\t\tvoters++\n1091\t\t\t}\n1092\t\t}\n1093\t\treturn voters/2 + 1\n1094\t}\n1095\t\n1096\t// restoreUserSnapshot is used to manually consume an external snapshot, such\n1097\t// as if restoring from a backup. We will use the current Raft configuration,\n1098\t// not the one from the snapshot, so that we can restore into a new cluster. We\n1099\t// will also use the higher of the index of the snapshot, or the current index,\n1100\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n1101\t// so that the snapshot will be sent to followers and used for any new joiners.\n1102\t// This can only be run on the leader, and returns a future that can be used to\n1103\t// block until complete.\n1104\tfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n1105\t\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n1106\t\n1107\t\t// Sanity check the version.\n1108\t\tversion := meta.Version\n1109\t\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n1110\t\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n","exit_code":0,"status":"completed"}}
