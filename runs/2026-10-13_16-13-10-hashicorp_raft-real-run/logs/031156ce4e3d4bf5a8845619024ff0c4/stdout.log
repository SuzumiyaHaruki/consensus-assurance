tStopReplication()\n1240\t}\n1241\t\n1242\t// dispatchLog is called on the leader to push a log to disk, mark it\n1243\t// as inflight and begin replication of it.\n1244\tfunc (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n1245\t\tnow := time.Now()\n1246\t\tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n1247\t\n1248\t\tterm := r.getCurrentTerm()\n1249\t\tlastIndex := r.getLastIndex()\n1250\t\n1251\t\tn := len(applyLogs)\n1252\t\tlogs := make([]*Log, n)\n1253\t\tmetrics.SetGauge([]string{\"raft\", \"leader\", \"dispatchNumLogs\"}, float32(n))\n1254\t\n1255\t\tfor idx, applyLog := range applyLogs {\n1256\t\t\tapplyLog.dispatch = now\n1257\t\t\tlastIndex++\n1258\t\t\tapplyLog.log.Index = lastIndex\n1259\t\t\tapplyLog.log.Term = term\n1260\t\t\tapplyLog.log.AppendedAt = now\n1261\t\t\tlogs[idx] = &applyLog.log\n1262\t\t\tr.leaderState.inflight.PushBack(applyLog)\n1263\t\t}\n1264\t\n1265\t\t// Write the log entry locally\n1266\t\tif err := r.logs.StoreLogs(logs); err != nil {\n1267\t\t\tr.logger.Error(\"failed to commit logs\", \"error\", err)\n1268\t\t\tfor _, applyLog := range applyLogs {\n1269\t\t\t\tapplyLog.respond(err)\n1270\t\t\t}\n1271\t\t\tr.setState(Follower)\n1272\t\t\treturn\n1273\t\t}\n1274\t\tr.leaderState.commitment.match(r.localID, lastIndex)\n1275\t\n1276\t\t// Update the last log since it's on disk now\n1277\t\tr.setLastLog(lastIndex, term)\n1278\t\n1279\t\t// Notify the replicators of the new log\n1280\t\tfor _, f := range r.leaderState.replState {\n1281\t\t\tasyncNotifyCh(f.triggerCh)\n1282\t\t}\n1283\t}\n1284\t\n1285\t// processLogs is used to apply all the committed entries that haven't been\n1286\t// applied up to the given index limit.\n1287\t// This can be called from both leaders and followers.\n1288\t// Followers call this from AppendEntries, for n entries at a time, and always\n1289\t// pass futures=nil.\n1290\t// Leaders call this when entries are committed. They pass the futures from any\n1291\t// inflight logs.\n1292\tfunc (r *Raft) processLogs(index uint64, futures map[uint64]*logFuture) {\n1293\t\t// Reject logs we've applied already\n1294\t\tlastApplied := r.getLastApplied()\n1295\t\tif index <= lastApplied {\n1296\t\t\tr.logger.Warn(\"skipping application of old log\", \"index\", index)\n1297\t\t\treturn\n1298\t\t}\n1299\t\n1300\t\tapplyBatch := func(batch []*commitTuple) {\n1301\t\t\tselect {\n1302\t\t\tcase r.fsmMutateCh <- batch:\n1303\t\t\tcase <-r.shutdownCh:\n1304\t\t\t\tfor _, cl := range batch {\n1305\t\t\t\t\tif cl.future != nil {\n1306\t\t\t\t\t\tcl.future.respond(ErrRaftShutdown)\n1307\t\t\t\t\t}\n1308\t\t\t\t}\n1309\t\t\t}\n1310\t\t}\n1311\t\n1312\t\t// Store maxAppendEntries for this call in case it ever becomes reloadable. We\n1313\t\t// need to use the same value for all lines here to get the expected result.\n1314\t\tmaxAppendEntries := r.config().MaxAppendEntries\n1315\t\n1316\t\tbatch := make([]*commitTuple, 0, maxAppendEntries)\n1317\t\n1318\t\t// Apply all the preceding logs\n1319\t\tfor idx := lastApplied + 1; idx <= index; idx++ {\n1320\t\t\tvar preparedLog *commitTuple\n1321\t\t\t// Get the log, either from the future or from our log store\n1322\t\t\tfuture, futureOk := futures[idx]\n1323\t\t\tif futureOk {\n1324\t\t\t\tpreparedLog = r.prepareLog(&future.log, future)\n1325\t\t\t} else {\n1326\t\t\t\tl := new(Log)\n1327\t\t\t\tif err := r.logs.GetLog(idx, l); err != nil {\n1328\t\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", idx, \"error\", err)\n1329\t\t\t\t\tpanic(err)\n1330\t\t\t\t}\n1331\t\t\t\tpreparedLog = r.prepareLog(l, nil)\n1332\t\t\t}\n1333\t\n1334\t\t\tswitch {\n1335\t\t\tcase preparedLog != nil:\n1336\t\t\t\t// If we have a log ready to send to the FSM add it to the batch.\n1337\t\t\t\t// The FSM thread will respond to the future.\n1338\t\t\t\tbatch = append(batch, preparedLog)\n1339\t\n1340\t\t\t\t// If we have filled up a batch, send it to the FSM\n1341\t\t\t\tif len(batch) >= maxAppendEntries {\n1342\t\t\t\t\tapplyBatch(batch)\n1343\t\t\t\t\tbatch = make([]*commitTuple, 0, maxAppendEntries)\n1344\t\t\t\t}\n1345\t\n1346\t\t\tcase futureOk:\n1347\t\t\t\t// Invoke the future if given.\n1348\t\t\t\tfuture.respond(nil)\n1349\t\t\t}\n1350\t\t}\n1351\t\n1352\t\t// If there are any remaining logs in the batch apply them\n1353\t\tif len(batch) != 0 {\n1354\t\t\tapplyBatch(batch)\n1355\t\t}\n1356\t\n1357\t\t// Update the lastApplied index and term\n1358\t\tr.setLastApplied(index)\n1359\t}\n1360\t\n1361\t// processLog is invoked to process the application of a single committed log entry.\n1362\tfunc (r *Raft) prepareLog(l *Log, future *logFuture) *commitTuple {\n1363\t\tswitch l.Type {\n1364\t\tcase LogBarrier:\n1365\t\t\t// Barrier is handled by the FSM\n1366\t\t\tfallthrough\n1367\t\n1368\t\tcase LogCommand:\n1369\t\t\treturn &commitTuple{l, future}\n1370\t\n1371\t\tcase LogConfiguration:\n1372\t\t\t// Only support this with the v2 configuration format\n1373\t\t\tif r.protocolVersion > 2 {\n1374\t\t\t\treturn &commitTuple{l, future}\n1375\t\t\t}\n1376\t\tcase LogAddPeerDeprecated:\n1377\t\tcase LogRemovePeerDeprecated:\n1378\t\tcase LogNoop:\n1379\t\t\t// Ignore the no-op\n1380\t\n1381\t\tdefault:\n1382\t\t\tpanic(fmt.Errorf(\"unrecognized log type: %#v\", l))\n1383\t\t}\n1384\t\n1385\t\treturn nil\n1386\t}\n1387\t\n1388\t// processRPC is called to handle an incoming RPC request. This must only be\n1389\t// called from the main thread.\n1390\tfunc (r *Raft) processRPC(rpc RPC) {\n1391\t\tif err := r.checkRPCHeader(rpc); err != nil {\n1392\t\t\trpc.Respond(nil, err)\n1393\t\t\treturn\n1394\t\t}\n1395\t\n1396\t\tswitch cmd := rpc.Command.(type) {\n1397\t\tcase *AppendEntriesRequest:\n1398\t\t\tr.appendEntries(rpc, cmd)\n1399\t\tcase *RequestVoteRequest:\n1400\t\t\tr.requestVote(rpc, cmd)\n","exit_code":0,"status":"completed"}}
