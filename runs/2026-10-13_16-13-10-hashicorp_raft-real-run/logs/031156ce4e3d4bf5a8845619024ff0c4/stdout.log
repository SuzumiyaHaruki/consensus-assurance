erID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n947\t\tif r.protocolVersion < 2 {\n948\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n949\t\t}\n950\t\n951\t\treturn r.requestConfigChange(configurationChangeRequest{\n952\t\t\tcommand:       AddVoter,\n953\t\t\tserverID:      id,\n954\t\t\tserverAddress: address,\n955\t\t\tprevIndex:     prevIndex,\n956\t\t}, timeout)\n957\t}\n958\t\n959\t// AddNonvoter will add the given server to the cluster but won't assign it a\n960\t// vote. The server will receive log entries, but it won't participate in\n961\t// elections or log entry commitment. If the server is already in the cluster,\n962\t// this updates the server's address. This must be run on the leader or it will\n963\t// fail. For prevIndex and timeout, see AddVoter.\n964\tfunc (r *Raft) AddNonvoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n965\t\tif r.protocolVersion < 3 {\n966\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n967\t\t}\n968\t\n969\t\treturn r.requestConfigChange(configurationChangeRequest{\n970\t\t\tcommand:       AddNonvoter,\n971\t\t\tserverID:      id,\n972\t\t\tserverAddress: address,\n973\t\t\tprevIndex:     prevIndex,\n974\t\t}, timeout)\n975\t}\n976\t\n977\t// RemoveServer will remove the given server from the cluster. If the current\n978\t// leader is being removed, it will cause a new election to occur. This must be\n979\t// run on the leader or it will fail. For prevIndex and timeout, see AddVoter.\n980\tfunc (r *Raft) RemoveServer(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n981\t\tif r.protocolVersion < 2 {\n982\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n983\t\t}\n984\t\n985\t\treturn r.requestConfigChange(configurationChangeRequest{\n986\t\t\tcommand:   RemoveServer,\n987\t\t\tserverID:  id,\n988\t\t\tprevIndex: prevIndex,\n989\t\t}, timeout)\n990\t}\n991\t\n992\t// DemoteVoter will take away a server's vote, if it has one