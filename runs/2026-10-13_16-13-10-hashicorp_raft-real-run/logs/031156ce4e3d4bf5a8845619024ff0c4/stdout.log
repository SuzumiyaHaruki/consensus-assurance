{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=30 && NR<=150 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go && echo \\\"=====\\\" && awk 'NR>=1976 && NR<=2130 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"30\t)\n31\t\n32\t// getRPCHeader returns an initialized RPCHeader struct for the given\n33\t// Raft instance. This structure is sent along with RPC requests and\n34\t// responses.\n35\tfunc (r *Raft) getRPCHeader() RPCHeader {\n36\t\treturn RPCHeader{\n37\t\t\tProtocolVersion: r.config().ProtocolVersion,\n38\t\t\tID:              []byte(r.config().LocalID),\n39\t\t\tAddr:            r.trans.EncodePeer(r.config().LocalID, r.localAddr),\n40\t\t}\n41\t}\n42\t\n43\t// checkRPCHeader houses logic about whether this instance of Raft can process\n44\t// the given RPC message.\n45\tfunc (r *Raft) checkRPCHeader(rpc RPC) error {\n46\t\t// Get the header off the RPC message.\n47\t\twh, ok := rpc.Command.(WithRPCHeader)\n48\t\tif !ok {\n49\t\t\treturn fmt.Errorf(\"RPC does not have a header\")\n50\t\t}\n51\t\theader := wh.GetRPCHeader()\n52\t\n53\t\t// First check is to just make sure the code can understand the\n54\t\t// protocol at all.\n55\t\tif header.ProtocolVersion < ProtocolVersionMin ||\n56\t\t\theader.ProtocolVersion > ProtocolVersionMax {\n57\t\t\treturn ErrUnsupportedProtocol\n58\t\t}\n59\t\n60\t\t// Second check is whether we should support this message, given the\n61\t\t// current protocol we are configured to run. This will drop support\n62\t\t// for protocol version 0 starting at protocol version 2, which is\n63\t\t// currently what we want, and in general support one version back. We\n64\t\t// may need to revisit this policy depending on how future protocol\n65\t\t// changes evolve.\n66\t\tif header.ProtocolVersion < r.config().ProtocolVersion-1 {\n67\t\t\treturn ErrUnsupportedProtocol\n68\t\t}\n69\t\n70\t\treturn nil\n71\t}\n72\t\n73\t// getSnapshotVersion returns the snapshot version that should be used when\n74\t// creating snapshots, given the protocol version in use.\n75\tfunc getSnapshotVersion(protocolVersion ProtocolVersion) SnapshotVersion {\n76\t\t// Right now we only have two versions and they are backwards compatible\n77\t\t// so we don't need to look at the protocol version.\n78\t\treturn 1\n79\t}\n80\t\n81\t// commitTuple is used to send an index that was committed,\n82\t// with an optional associated future that should be invoked.\n83\ttype commitTuple struct {\n84\t\tlog    *Log\n85\t\tfuture *logFuture\n86\t}\n87\t\n88\t// leaderState is state that is used while we are a leader.\n89\ttype leaderState struct {\n90\t\tleadershipTransferInProgress int32 // indicates that a leadership transfer is in progress.\n91\t\tcommitCh                     chan struct{}\n92\t\tcommitment                   *commitment\n93\t\tinflight                     *list.List // list of logFuture in log index order\n94\t\treplState                    map[ServerID]*followerReplication\n95\t\tnotify                       map[*verifyFuture]struct{}\n96\t\tstepDown                     chan struct{}\n97\t}\n98\t\n99\t// setLeader is used to modify the current leader Address and ID of the cluster\n100\tfunc (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {\n101\t\tr.leaderLock.Lock()\n102\t\toldLeaderAddr := r.leaderAddr\n103\t\tr.leaderAddr = leaderAddr\n104\t\toldLeaderID := r.leaderID\n105\t\tr.leaderID = leaderID\n106\t\tr.leaderLock.Unlock()\n107\t\tif oldLeaderAddr != leaderAddr || oldLeaderID != leaderID {\n108\t\t\tr.observe(LeaderObservation{Leader: leaderAddr, LeaderAddr: leaderAddr, LeaderID: leaderID})\n109\t\t}\n110\t}\n111\t\n112\t// requestConfigChange is a helper for the above functions that make\n113\t// configuration change requests. 'req' describes the change. For timeout,\n114\t// see AddVoter.\n115\tfunc (r *Raft) requestConfigChange(req configurationChangeRequest, timeout time.Duration) IndexFuture {\n116\t\tvar timer <-chan time.Time\n117\t\tif timeout > 0 {\n118\t\t\ttimer = time.After(timeout)\n119\t\t}\n120\t\tfuture := &configurationChangeFuture{\n121\t\t\treq: req,\n122\t\t}\n123\t\tfuture.init()\n124\t\tselect {\n125\t\tcase <-timer:\n126\t\t\treturn errorFuture{ErrEnqueueTimeout}\n127\t\tcase r.configurationChangeCh <- future:\n128\t\t\treturn future\n129\t\tcase <-r.shutdownCh:\n130\t\t\treturn errorFuture{ErrRaftShutdown}\n131\t\t}\n132\t}\n133\t\n134\t// run the main thread that handles leadership and RPC requests.\n135\tfunc (r *Raft) run() {\n136\t\tfor {\n137\t\t\t// Check if we are doing a shutdown\n138\t\t\tselect {\n139\t\t\tcase <-r.shutdownCh:\n140\t\t\t\t// Clear the leader to prevent forwarding\n141\t\t\t\tr.setLeader(\"\", \"\")\n142\t\t\t\treturn\n143\t\t\tdefault:\n144\t\t\t}\n145\t\n146\t\t\tswitch r.getState() {\n147\t\t\tcase Follower:\n148\t\t\t\tr.runFollower()\n149\t\t\tcase Candidate:\n150\t\t\t\tr.runCandidate()\n=====\n1976\tfunc (r *Raft) electSelf() <-chan *voteResult {\n1977\t\t// Create a response channel\n1978\t\trespCh := make(chan *voteResult, len(r.configurations.latest.Servers))\n1979\t\n1980\t\t// Increment the term\n1981\t\tnewTerm := r.getCurrentTerm() + 1\n1982\t\n1983\t\tr.setCurrentTerm(newTerm)\n1984\t\t// Construct the request\n1985\t\tlastIdx, lastTerm := r.getLastEntry()\n1986\t\treq := &RequestVoteRequest{\n1987\t\t\tRPCHeader: r.getRPCHeader(),\n1988\t\t\tTerm:      newTerm,\n1989\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n1990\t\t\tCandidate:          r.trans.EncodePeer(r.localID, r.localAddr),\n1991\t\t\tLastLogIndex:       lastIdx,\n1992\t\t\tLastLogTerm:        lastTerm,\n1993\t\t\tLeadershipTransfer: r.candidateFromLeadershipTransfer.Load(),\n1994\t\t}\n1995\t\n1996\t\t// Construct a function to ask for a vote\n1997\t\taskPeer := func(peer Server) {\n1998\t\t\tr.goFunc(func() {\n1999\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n2000\t\t\t\tresp := &voteResult{voterID: peer.ID}\n2001\t\t\t\terr := r.trans.RequestVote(peer.ID, peer.Address, req, &resp.RequestVoteResponse)\n2002\t\t\t\tif err != nil {\n2003\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n2004\t\t\t\t\t\t\"target\", peer,\n2005\t\t\t\t\t\t\"error\", err,\n2006\t\t\t\t\t\t\"term\", req.Term)\n2007\t\t\t\t\tresp.Term = req.Term\n2008\t\t\t\t\tresp.Granted = false\n2009\t\t\t\t}\n2010\t\t\t\trespCh <- resp\n2011\t\t\t})\n2012\t\t}\n2013\t\n2014\t\t// For each peer, request a vote\n2015\t\tfor _, server := range r.configurations.latest.Servers {\n2016\t\t\tif server.Suffrage == Voter {\n2017\t\t\t\tif server.ID == r.localID {\n2018\t\t\t\t\tr.logger.Debug(\"voting for self\", \"term\", req.Term, \"id\", r.localID)\n2019\t\n2020\t\t\t\t\t// Persist a vote for ourselves\n2021\t\t\t\t\tif err := r.persistVote(req.Term, req.RPCHeader.Addr); err != nil {\n2022\t\t\t\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n2023\t\t\t\t\t\treturn nil\n2024\t\n2025\t\t\t\t\t}\n2026\t\t\t\t\t// Include our own vote\n2027\t\t\t\t\trespCh <- &voteResult{\n2028\t\t\t\t\t\tRequestVoteResponse: RequestVoteResponse{\n2029\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n2030\t\t\t\t\t\t\tTerm:      req.Term,\n2031\t\t\t\t\t\t\tGranted:   true,\n2032\t\t\t\t\t\t},\n2033\t\t\t\t\t\tvoterID: r.localID,\n2034\t\t\t\t\t}\n2035\t\t\t\t} else {\n2036\t\t\t\t\tr.logger.Debug(\"asking for vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n2037\t\t\t\t\taskPeer(server)\n2038\t\t\t\t}\n2039\t\t\t}\n2040\t\t}\n2041\t\n2042\t\treturn respCh\n2043\t}\n2044\t\n2045\t// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\n2046\t// ourself. This will not increment the current term. The\n2047\t// response channel returned is used to wait for all the responses (including a\n2048\t// vote for ourself).\n2049\t// This must only be called from the main thread.\n2050\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n2051\t\n2052\t\t// At this point transport should support pre-vote\n2053\t\t// but check just in case\n2054\t\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\n2055\t\tif !prevoteTransSupported {\n2056\t\t\tpanic(\"preElection is not possible if the transport don't support pre-vote\")\n2057\t\t}\n2058\t\n2059\t\t// Create a response channel\n2060\t\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\n2061\t\n2062\t\t// Propose the next term without actually changing our state\n2063\t\tnewTerm := r.getCurrentTerm() + 1\n2064\t\n2065\t\t// Construct the request\n2066\t\tlastIdx, lastTerm := r.getLastEntry()\n2067\t\treq := &RequestPreVoteRequest{\n2068\t\t\tRPCHeader:    r.getRPCHeader(),\n2069\t\t\tTerm:         newTerm,\n2070\t\t\tLastLogIndex: lastIdx,\n2071\t\t\tLastLogTerm:  lastTerm,\n2072\t\t}\n2073\t\n2074\t\t// Construct a function to ask for a vote\n2075\t\taskPeer := func(peer Server) {\n2076\t\t\tr.goFunc(func() {\n2077\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"preElectSelf\"}, time.Now())\n2078\t\t\t\tresp := &preVoteResult{voterID: peer.ID}\n2079\t\n2080\t\t\t\terr := prevoteTrans.RequestPreVote(peer.ID, peer.Address, req, &resp.RequestPreVoteResponse)\n2081\t\n2082\t\t\t\t// If the target server do not support Pre-vote RPC we count this as a granted vote to allow\n2083\t\t\t\t// the cluster to progress.\n2084\t\t\t\tif err != nil && strings.Contains(err.Error(), rpcUnexpectedCommandError) {\n2085\t\t\t\t\tr.logger.Error(\"target does not support pre-vote RPC, treating as granted\",\n2086\t\t\t\t\t\t\"target\", peer,\n2087\t\t\t\t\t\t\"error\", err,\n2088\t\t\t\t\t\t\"term\", req.Term)\n2089\t\t\t\t\tresp.Term = req.Term\n2090\t\t\t\t\tresp.Granted = true\n2091\t\t\t\t} else if err != nil {\n2092\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n2093\t\t\t\t\t\t\"target\", peer,\n2094\t\t\t\t\t\t\"error\", err,\n2095\t\t\t\t\t\t\"term\", req.Term)\n2096\t\t\t\t\tresp.Term = req.Term\n2097\t\t\t\t\tresp.Granted = false\n2098\t\t\t\t}\n2099\t\t\t\trespCh <- resp\n2100\t\n2101\t\t\t})\n2102\t\t}\n2103\t\n2104\t\t// For each peer, request a vote\n2105\t\tfor _, server := range r.configurations.latest.Servers {\n2106\t\t\tif server.Suffrage == Voter {\n2107\t\t\t\tif server.ID == r.localID {\n2108\t\t\t\t\tr.logger.Debug(\"pre-voting for self\", \"term\", req.Term, \"id\", r.localID)\n2109\t\n2110\t\t\t\t\t// cast a pre-vote for our self\n2111\t\t\t\t\trespCh <- &preVoteResult{\n2112\t\t\t\t\t\tRequestPreVoteResponse: RequestPreVoteResponse{\n2113\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n2114\t\t\t\t\t\t\tTerm:      req.Term,\n2115\t\t\t\t\t\t\tGranted:   true,\n2116\t\t\t\t\t\t},\n2117\t\t\t\t\t\tvoterID: r.localID,\n2118\t\t\t\t\t}\n2119\t\t\t\t} else {\n2120\t\t\t\t\tr.logger.Debug(\"asking for pre-vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n2121\t\t\t\t\taskPeer(server)\n2122\t\t\t\t}\n2123\t\t\t}\n2124\t\t}\n2125\t\n2126\t\treturn respCh\n2127\t}\n2128\t\n2129\t// persistVote is used to persist our vote for safety.\n2130\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n","exit_code":0,"status":"completed"}}
