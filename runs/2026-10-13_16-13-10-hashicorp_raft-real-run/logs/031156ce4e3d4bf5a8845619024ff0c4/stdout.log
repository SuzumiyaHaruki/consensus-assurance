{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=388 && NR<=665 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' replication.go\"","aggregated_output":"388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n389\t\tvar failures uint64\n390\t\treq := AppendEntriesRequest{\n391\t\t\tRPCHeader: r.getRPCHeader(),\n392\t\t\tTerm:      s.currentTerm,\n393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n395\t\t}\n396\t\n397\t\tvar resp AppendEntriesResponse\n398\t\tfor {\n399\t\t\t// Wait for the next heartbeat interval or forced notify\n400\t\t\tselect {\n401\t\t\tcase <-s.notifyCh:\n402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n403\t\t\tcase <-stopCh:\n404\t\t\t\treturn\n405\t\t\t}\n406\t\n407\t\t\ts.peerLock.RLock()\n408\t\t\tpeer := s.peer\n409\t\t\ts.peerLock.RUnlock()\n410\t\n411\t\t\tstart := time.Now()\n412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n415\t\t\t\t\tnextBackoffTime, \"error\", err)\n416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n417\t\t\t\tfailures++\n418\t\t\t\tselect {\n419\t\t\t\tcase <-time.After(nextBackoffTime):\n420\t\t\t\tcase <-stopCh:\n421\t\t\t\t\treturn\n422\t\t\t\t}\n423\t\t\t} else {\n424\t\t\t\tif failures > 0 {\n425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n426\t\t\t\t}\n427\t\t\t\ts.setLastContact()\n428\t\t\t\tfailures = 0\n429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n431\t\n432\t\t\t\tif !r.noLegacyTelemetry {\n433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n435\t\t\t\t}\n436\t\n437\t\t\t\ts.notifyAll(resp.Success)\n438\t\t\t}\n439\t\t}\n440\t}\n441\t\n442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n443\t// and want to switch to a higher performance pipeline mode of replication.\n444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n445\t// back to the standard replication which can handle more complex situations.\n446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n447\t\ts.peerLock.RLock()\n448\t\tpeer := s.peer\n449\t\ts.peerLock.RUnlock()\n450\t\n451\t\t// Create a new pipeline\n452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n453\t\tif err != nil {\n454\t\t\treturn err\n455\t\t}\n456\t\tdefer pipeline.Close()\n457\t\n458\t\t// Log start and stop of pipeline\n459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n461\t\n462\t\t// Create a shutdown and finish channel\n463\t\tstopCh := make(chan struct{})\n464\t\tfinishCh := make(chan struct{})\n465\t\n466\t\t// Start a dedicated decoder\n467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n468\t\n469\t\t// Start pipeline sends at the last good nextIndex\n470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n471\t\n472\t\tshouldStop := false\n473\tSEND:\n474\t\tfor !shouldStop {\n475\t\t\tselect {\n476\t\t\tcase <-finishCh:\n477\t\t\t\tbreak SEND\n478\t\t\tcase maxIndex := <-s.stopCh:\n479\t\t\t\t// Make a best effort to replicate up to this index\n480\t\t\t\tif maxIndex > 0 {\n481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n482\t\t\t\t}\n483\t\t\t\tbreak SEND\n484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n487\t\t\t\tif !shouldStop {\n488\t\t\t\t\tdeferErr.respond(nil)\n489\t\t\t\t} else {\n490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n491\t\t\t\t}\n492\t\t\tcase <-s.triggerCh:\n493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n498\t\t\t}\n499\t\t}\n500\t\n501\t\t// Stop our decoder, and wait for it to finish\n502\t\tclose(stopCh)\n503\t\tselect {\n504\t\tcase <-finishCh:\n505\t\tcase <-r.shutdownCh:\n506\t\t}\n507\t\treturn nil\n508\t}\n509\t\n510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n511\t// pipelineReplicate.\n512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n513\t\t// Create a new append request\n514\t\treq := new(AppendEntriesRequest)\n515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n516\t\t\treturn true\n517\t\t}\n518\t\n519\t\t// Pipeline the append entries\n520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n522\t\t\treturn true\n523\t\t}\n524\t\n525\t\t// Increase the next send log to avoid re-sending old logs\n526\t\tif n := len(req.Entries); n > 0 {\n527\t\t\tlast := req.Entries[n-1]\n528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n529\t\t}\n530\t\treturn false\n531\t}\n532\t\n533\t// pipelineDecode is used to decode the responses of pipelined requests.\n534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n535\t\tdefer close(finishCh)\n536\t\trespCh := p.Consumer()\n537\t\tfor {\n538\t\t\tselect {\n539\t\t\tcase ready := <-respCh:\n540\t\t\t\ts.peerLock.RLock()\n541\t\t\t\tpeer := s.peer\n542\t\t\t\ts.peerLock.RUnlock()\n543\t\n544\t\t\t\treq, resp := ready.Request(), ready.Response()\n545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n546\t\n547\t\t\t\t// Check for a newer term, stop running\n548\t\t\t\tif resp.Term > req.Term {\n549\t\t\t\t\tr.handleStaleTerm(s)\n550\t\t\t\t\treturn\n551\t\t\t\t}\n552\t\n553\t\t\t\t// Update the last contact\n554\t\t\t\ts.setLastContact()\n555\t\n556\t\t\t\t// Abort pipeline if not successful\n557\t\t\t\tif !resp.Success {\n558\t\t\t\t\treturn\n559\t\t\t\t}\n560\t\n561\t\t\t\t// Update our replication state\n562\t\t\t\tupdateLastAppended(s, req)\n563\t\t\tcase <-stopCh:\n564\t\t\t\treturn\n565\t\t\t}\n566\t\t}\n567\t}\n568\t\n569\t// setupAppendEntries is used to setup an append entries request.\n570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n571\t\treq.RPCHeader = r.getRPCHeader()\n572\t\treq.Term = s.currentTerm\n573\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n574\t\treq.Leader = r.trans.EncodePeer(r.localID, r.localAddr)\n575\t\treq.LeaderCommitIndex = r.getCommitIndex()\n576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n577\t\t\treturn err\n578\t\t}\n579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n580\t\t\treturn err\n581\t\t}\n582\t\treturn nil\n583\t}\n584\t\n585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n586\t// AppendEntriesRequest given the next index to replicate.\n587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n588\t\t// Guard for the first index, since there is no 0 log entry\n589\t\t// Guard against the previous index being a snapshot as well\n590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n591\t\tif nextIndex == 1 {\n592\t\t\treq.PrevLogEntry = 0\n593\t\t\treq.PrevLogTerm = 0\n594\t\n595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n596\t\t\treq.PrevLogEntry = lastSnapIdx\n597\t\t\treq.PrevLogTerm = lastSnapTerm\n598\t\n599\t\t} else {\n600\t\t\tvar l Log\n601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n603\t\t\t\treturn err\n604\t\t\t}\n605\t\n606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n607\t\t\treq.PrevLogEntry = l.Index\n608\t\t\treq.PrevLogTerm = l.Term\n609\t\t}\n610\t\treturn nil\n611\t}\n612\t\n613\t// setNewLogs is used to setup the logs which should be appended for a request.\n614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n617\t\t// becomes reloadable.\n618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n622\t\t\toldLog := new(Log)\n623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n625\t\t\t\treturn err\n626\t\t\t}\n627\t\t\treq.Entries = append(req.Entries, oldLog)\n628\t\t}\n629\t\treturn nil\n630\t}\n631\t\n632\t// appendStats is used to emit stats about an AppendEntries invocation.\n633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n637\t\n638\t\tif !skipLegacy {\n639\t\t\t// Duplicated information. Kept for backward compatibility.\n640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n642\t\t}\n643\t}\n644\t\n645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n648\t\ts.notifyAll(false) // No longer leader\n649\t\tasyncNotifyCh(s.stepDown)\n650\t}\n651\t\n652\t// updateLastAppended is used to update follower replication state after a\n653\t// successful AppendEntries RPC.\n654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n656\t\t// Mark any inflight logs as committed\n657\t\tif logs := req.Entries; len(logs) > 0 {\n658\t\t\tlast := logs[len(logs)-1]\n659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n661\t\t}\n662\t\n663\t\t// Notify still leader\n664\t\ts.notifyAll(true)\n665\t}\n","exit_code":0,"status":"completed"}}
