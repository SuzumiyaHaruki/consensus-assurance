{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1440 && NR<=1603 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"1440\tfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n1441\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n1442\t\t// Setup a response\n1443\t\tresp := &AppendEntriesResponse{\n1444\t\t\tRPCHeader:      r.getRPCHeader(),\n1445\t\t\tTerm:           r.getCurrentTerm(),\n1446\t\t\tLastLog:        r.getLastIndex(),\n1447\t\t\tSuccess:        false,\n1448\t\t\tNoRetryBackoff: false,\n1449\t\t}\n1450\t\tvar rpcErr error\n1451\t\tdefer func() {\n1452\t\t\trpc.Respond(resp, rpcErr)\n1453\t\t}()\n1454\t\n1455\t\t// Ignore an older term\n1456\t\tif a.Term < r.getCurrentTerm() {\n1457\t\t\treturn\n1458\t\t}\n1459\t\n1460\t\t// Increase the term if we see a newer one, also transition to follower\n1461\t\t// if we ever get an appendEntries call\n1462\t\tif a.Term > r.getCurrentTerm() || (r.getState() != Follower && !r.candidateFromLeadershipTransfer.Load()) {\n1463\t\t\t// Ensure transition to follower\n1464\t\t\tr.setState(Follower)\n1465\t\t\tr.setCurrentTerm(a.Term)\n1466\t\t\tresp.Term = a.Term\n1467\t\t}\n1468\t\n1469\t\t// Save the current leader\n1470\t\tif len(a.Addr) > 0 {\n1471\t\t\tr.setLeader(r.trans.DecodePeer(a.Addr), ServerID(a.ID))\n1472\t\t} else {\n1473\t\t\tr.setLeader(r.trans.DecodePeer(a.Leader), ServerID(a.ID))\n1474\t\t}\n1475\t\t// Verify the last log entry\n1476\t\tif a.PrevLogEntry > 0 {\n1477\t\t\tlastIdx, lastTerm := r.getLastEntry()\n1478\t\n1479\t\t\tvar prevLogTerm uint64\n1480\t\t\tif a.PrevLogEntry == lastIdx {\n1481\t\t\t\tprevLogTerm = lastTerm\n1482\t\t\t} else {\n1483\t\t\t\tvar prevLog Log\n1484\t\t\t\tif err := r.logs.GetLog(a.PrevLogEntry, &prevLog); err != nil {\n1485\t\t\t\t\tr.logger.Warn(\"failed to get previous log\",\n1486\t\t\t\t\t\t\"previous-index\", a.PrevLogEntry,\n1487\t\t\t\t\t\t\"last-index\", lastIdx,\n1488\t\t\t\t\t\t\"error\", err)\n1489\t\t\t\t\tresp.NoRetryBackoff = true\n1490\t\t\t\t\treturn\n1491\t\t\t\t}\n1492\t\t\t\tprevLogTerm = prevLog.Term\n1493\t\t\t}\n1494\t\n1495\t\t\tif a.PrevLogTerm != prevLogTerm {\n1496\t\t\t\tr.logger.Warn(\"previous log term mis-match\",\n1497\t\t\t\t\t\"ours\", prevLogTerm,\n1498\t\t\t\t\t\"remote\", a.PrevLogTerm)\n1499\t\t\t\tresp.NoRetryBackoff = true\n1500\t\t\t\treturn\n1501\t\t\t}\n1502\t\t}\n1503\t\n1504\t\t// Process any new entries\n1505\t\tif len(a.Entries) > 0 {\n1506\t\t\tstart := time.Now()\n1507\t\n1508\t\t\t// Delete any conflicting entries, skip any duplicates\n1509\t\t\tlastLogIdx, _ := r.getLastLog()\n1510\t\t\tvar newEntries []*Log\n1511\t\t\tfor i, entry := range a.Entries {\n1512\t\t\t\tif entry.Index > lastLogIdx {\n1513\t\t\t\t\tnewEntries = a.Entries[i:]\n1514\t\t\t\t\tbreak\n1515\t\t\t\t}\n1516\t\t\t\tvar storeEntry Log\n1517\t\t\t\tif err := r.logs.GetLog(entry.Index, &storeEntry); err != nil {\n1518\t\t\t\t\tr.logger.Warn(\"failed to get log entry\",\n1519\t\t\t\t\t\t\"index\", entry.Index,\n1520\t\t\t\t\t\t\"error\", err)\n1521\t\t\t\t\treturn\n1522\t\t\t\t}\n1523\t\t\t\tif entry.Term != storeEntry.Term {\n1524\t\t\t\t\tr.logger.Warn(\"clearing log suffix\", \"from\", entry.Index, \"to\", lastLogIdx)\n1525\t\t\t\t\tif err := r.logs.DeleteRange(entry.Index, lastLogIdx); err != nil {\n1526\t\t\t\t\t\tr.logger.Error(\"failed to clear log suffix\", \"error\", err)\n1527\t\t\t\t\t\treturn\n1528\t\t\t\t\t}\n1529\t\t\t\t\tif entry.Index <= r.configurations.latestIndex {\n1530\t\t\t\t\t\tr.setLatestConfiguration(r.configurations.committed, r.configurations.committedIndex)\n1531\t\t\t\t\t}\n1532\t\t\t\t\tnewEntries = a.Entries[i:]\n1533\t\t\t\t\tbreak\n1534\t\t\t\t}\n1535\t\t\t}\n1536\t\n1537\t\t\tif n := len(newEntries); n > 0 {\n1538\t\t\t\t// Append the new entries\n1539\t\t\t\tif err := r.logs.StoreLogs(newEntries); err != nil {\n1540\t\t\t\t\tr.logger.Error(\"failed to append to logs\", \"error\", err)\n1541\t\t\t\t\t// TODO: leaving r.getLastLog() in the wrong\n1542\t\t\t\t\t// state if there was a truncation above\n1543\t\t\t\t\treturn\n1544\t\t\t\t}\n1545\t\n1546\t\t\t\t// Handle any new configuration changes\n1547\t\t\t\tfor _, newEntry := range newEntries {\n1548\t\t\t\t\tif err := r.processConfigurationLogEntry(newEntry); err != nil {\n1549\t\t\t\t\t\tr.logger.Warn(\"failed to append entry\",\n1550\t\t\t\t\t\t\t\"index\", newEntry.Index,\n1551\t\t\t\t\t\t\t\"error\", err)\n1552\t\t\t\t\t\trpcErr = err\n1553\t\t\t\t\t\treturn\n1554\t\t\t\t\t}\n1555\t\t\t\t}\n1556\t\n1557\t\t\t\t// Update the lastLog\n1558\t\t\t\tlast := newEntries[n-1]\n1559\t\t\t\tr.setLastLog(last.Index, last.Term)\n1560\t\t\t}\n1561\t\n1562\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"storeLogs\"}, start)\n1563\t\t}\n1564\t\n1565\t\t// Update the commit index\n1566\t\tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n1567\t\t\tstart := time.Now()\n1568\t\t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n1569\t\t\tr.setCommitIndex(idx)\n1570\t\t\tif r.configurations.latestIndex <= idx {\n1571\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n1572\t\t\t}\n1573\t\t\tr.processLogs(idx, nil)\n1574\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n1575\t\t}\n1576\t\n1577\t\t// Everything went well, set success\n1578\t\tresp.Success = true\n1579\t\tr.setLastContact()\n1580\t}\n1581\t\n1582\t// processConfigurationLogEntry takes a log entry and updates the latest\n1583\t// configuration if the entry results in a new configuration. This must only be\n1584\t// called from the main thread, or from NewRaft() before any threads have begun.\n1585\tfunc (r *Raft) processConfigurationLogEntry(entry *Log) error {\n1586\t\tswitch entry.Type {\n1587\t\tcase LogConfiguration:\n1588\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n1589\t\t\tr.setLatestConfiguration(DecodeConfiguration(entry.Data), entry.Index)\n1590\t\n1591\t\tcase LogAddPeerDeprecated, LogRemovePeerDeprecated:\n1592\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n1593\t\t\tconf, err := decodePeers(entry.Data, r.trans)\n1594\t\t\tif err != nil {\n1595\t\t\t\treturn err\n1596\t\t\t}\n1597\t\t\tr.setLatestConfiguration(conf, entry.Index)\n1598\t\t}\n1599\t\treturn nil\n1600\t}\n1601\t\n1602\t// requestVote is invoked when we get a request vote RPC call.\n1603\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n","exit_code":0,"status":"completed"}}
