{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1104 && NR<=1203 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"1104\tfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n1105\t\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n1106\t\n1107\t\t// Sanity check the version.\n1108\t\tversion := meta.Version\n1109\t\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n1110\t\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n1111\t\t}\n1112\t\n1113\t\t// We don't support snapshots while there's a config change\n1114\t\t// outstanding since the snapshot doesn't have a means to\n1115\t\t// represent this state.\n1116\t\tcommittedIndex := r.configurations.committedIndex\n1117\t\tlatestIndex := r.configurations.latestIndex\n1118\t\tif committedIndex != latestIndex {\n1119\t\t\treturn fmt.Errorf(\"cannot restore snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n1120\t\t\t\tlatestIndex, committedIndex)\n1121\t\t}\n1122\t\n1123\t\t// Cancel any inflight requests.\n1124\t\tfor {\n1125\t\t\te := r.leaderState.inflight.Front()\n1126\t\t\tif e == nil {\n1127\t\t\t\tbreak\n1128\t\t\t}\n1129\t\t\te.Value.(*logFuture).respond(ErrAbortedByRestore)\n1130\t\t\tr.leaderState.inflight.Remove(e)\n1131\t\t}\n1132\t\n1133\t\t// We will overwrite the snapshot metadata with the current term,\n1134\t\t// an index that's greater than the current index, or the last\n1135\t\t// index in the snapshot. It's important that we leave a hole in\n1136\t\t// the index so we know there's nothing in the Raft log there and\n1137\t\t// replication will fault and send the snapshot.\n1138\t\tterm := r.getCurrentTerm()\n1139\t\tlastIndex := r.getLastIndex()\n1140\t\tif meta.Index > lastIndex {\n1141\t\t\tlastIndex = meta.Index\n1142\t\t}\n1143\t\tlastIndex++\n1144\t\n1145\t\t// Dump the snapshot. Note that we use the latest configuration,\n1146\t\t// not the one that came with the snapshot.\n1147\t\tsink, err := r.snapshots.Create(version, lastIndex, term,\n1148\t\t\tr.configurations.latest, r.configurations.latestIndex, r.trans)\n1149\t\tif err != nil {\n1150\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n1151\t\t}\n1152\t\tn, err := io.Copy(sink, reader)\n1153\t\tif err != nil {\n1154\t\t\tsink.Cancel()\n1155\t\t\treturn fmt.Errorf(\"failed to write snapshot: %v\", err)\n1156\t\t}\n1157\t\tif n != meta.Size {\n1158\t\t\tsink.Cancel()\n1159\t\t\treturn fmt.Errorf(\"failed to write snapshot, size didn't match (%d != %d)\", n, meta.Size)\n1160\t\t}\n1161\t\tif err := sink.Close(); err != nil {\n1162\t\t\treturn fmt.Errorf(\"failed to close snapshot: %v\", err)\n1163\t\t}\n1164\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n1165\t\n1166\t\t// Restore the snapshot into the FSM. If this fails we are in a\n1167\t\t// bad state so we panic to take ourselves out.\n1168\t\tfsm := &restoreFuture{ID: sink.ID()}\n1169\t\tfsm.ShutdownCh = r.shutdownCh\n1170\t\tfsm.init()\n1171\t\tselect {\n1172\t\tcase r.fsmMutateCh <- fsm:\n1173\t\tcase <-r.shutdownCh:\n1174\t\t\treturn ErrRaftShutdown\n1175\t\t}\n1176\t\tif err := fsm.Error(); err != nil {\n1177\t\t\tpanic(fmt.Errorf(\"failed to restore snapshot: %v\", err))\n1178\t\t}\n1179\t\n1180\t\t// We set the last log so it looks like we've stored the empty\n1181\t\t// index we burned. The last applied is set because we made the\n1182\t\t// FSM take the snapshot state, and we store the last snapshot\n1183\t\t// in the stable store since we created a snapshot as part of\n1184\t\t// this process.\n1185\t\tr.setLastLog(lastIndex, term)\n1186\t\tr.setLastApplied(lastIndex)\n1187\t\tr.setLastSnapshot(lastIndex, term)\n1188\t\n1189\t\t// Remove old logs if r.logs is a MonotonicLog