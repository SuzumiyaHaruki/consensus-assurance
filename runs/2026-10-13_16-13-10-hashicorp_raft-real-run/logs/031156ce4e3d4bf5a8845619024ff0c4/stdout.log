{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1000 && NR<=1105 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' api.go\"","aggregated_output":"1000\t\t}\n1001\t\n1002\t\treturn r.requestConfigChange(configurationChangeRequest{\n1003\t\t\tcommand:   DemoteVoter,\n1004\t\t\tserverID:  id,\n1005\t\t\tprevIndex: prevIndex,\n1006\t\t}, timeout)\n1007\t}\n1008\t\n1009\t// Shutdown is used to stop the Raft background routines.\n1010\t// This is not a graceful operation. Provides a future that\n1011\t// can be used to block until all background routines have exited.\n1012\tfunc (r *Raft) Shutdown() Future {\n1013\t\tr.shutdownLock.Lock()\n1014\t\tdefer r.shutdownLock.Unlock()\n1015\t\n1016\t\tif !r.shutdown {\n1017\t\t\tclose(r.shutdownCh)\n1018\t\t\tr.shutdown = true\n1019\t\t\tr.setState(Shutdown)\n1020\t\t\treturn &shutdownFuture{r}\n1021\t\t}\n1022\t\n1023\t\t// avoid closing transport twice\n1024\t\treturn &shutdownFuture{nil}\n1025\t}\n1026\t\n1027\t// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n1028\t// that can be used to block until complete, and that contains a function that\n1029\t// can be used to open the snapshot.\n1030\tfunc (r *Raft) Snapshot() SnapshotFuture {\n1031\t\tfuture := &userSnapshotFuture{}\n1032\t\tfuture.init()\n1033\t\tselect {\n1034\t\tcase r.userSnapshotCh <- future:\n1035\t\t\treturn future\n1036\t\tcase <-r.shutdownCh:\n1037\t\t\tfuture.respond(ErrRaftShutdown)\n1038\t\t\treturn future\n1039\t\t}\n1040\t}\n1041\t\n1042\t// Restore is used to manually force Raft to consume an external snapshot, such\n1043\t// as if restoring from a backup. We will use the current Raft configuration,\n1044\t// not the one from the snapshot, so that we can restore into a new cluster. We\n1045\t// will also use the max of the index of the snapshot, or the current index,\n1046\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n1047\t// so that the snapshot will be sent to followers and used for any new joiners.\n1048\t// This can only be run on the leader, and blocks until the restore is complete\n1049\t// or an error occurs.\n1050\t//\n1051\t// WARNING! This operation has the leader take on the state of the snapshot and\n1052\t// then sets itself up so that it replicates that to its followers though the\n1053\t// install snapshot process. This involves a potentially dangerous period where\n1054\t// the leader commits ahead of its followers, so should only be used for disaster\n1055\t// recovery into a fresh cluster, and should not be used in normal operations.\n1056\tfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n1057\t\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n1058\t\tvar timer <-chan time.Time\n1059\t\tif timeout > 0 {\n1060\t\t\ttimer = time.After(timeout)\n1061\t\t}\n1062\t\n1063\t\t// Perform the restore.\n1064\t\trestore := &userRestoreFuture{\n1065\t\t\tmeta:   meta,\n1066\t\t\treader: reader,\n1067\t\t}\n1068\t\trestore.init()\n1069\t\tselect {\n1070\t\tcase <-timer:\n1071\t\t\treturn ErrEnqueueTimeout\n1072\t\tcase <-r.shutdownCh:\n1073\t\t\treturn ErrRaftShutdown\n1074\t\tcase r.userRestoreCh <- restore:\n1075\t\t\t// If the restore is ingested then wait for it to complete.\n1076\t\t\tif err := restore.Error(); err != nil {\n1077\t\t\t\treturn err\n1078\t\t\t}\n1079\t\t}\n1080\t\n1081\t\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n1082\t\t// followers have gotten the restore and replicated at least this new\n1083\t\t// entry, which shows that we've also faulted and installed the\n1084\t\t// snapshot with the contents of the restore.\n1085\t\tnoop := &logFuture{\n1086\t\t\tlog: Log{\n1087\t\t\t\tType: LogNoop,\n1088\t\t\t},\n1089\t\t}\n1090\t\tnoop.init()\n1091\t\tselect {\n1092\t\tcase <-timer:\n1093\t\t\treturn ErrEnqueueTimeout\n1094\t\tcase <-r.shutdownCh:\n1095\t\t\treturn ErrRaftShutdown\n1096\t\tcase r.applyCh <- noop:\n1097\t\t\treturn noop.Error()\n1098\t\t}\n1099\t}\n1100\t\n1101\t// State returns the state of this raft peer.\n1102\tfunc (r *Raft) State() RaftState {\n1103\t\treturn r.getState()\n1104\t}\n1105\t\n","exit_code":0,"status":"completed"}}
