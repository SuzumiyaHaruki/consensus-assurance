ate.\n49\t\tCreate(version SnapshotVersion, index, term uint64, configuration Configuration,\n50\t\t\tconfigurationIndex uint64, trans Transport) (SnapshotSink, error)\n51\t\n52\t\t// List is used to list the available snapshots in the store.\n53\t\t// It should return then in descending order, with the highest index first.\n54\t\tList() ([]*SnapshotMeta, error)\n55\t\n56\t\t// Open takes a snapshot ID and provides a ReadCloser. Once close is\n57\t\t// called it is assumed the snapshot is no longer needed.\n58\t\tOpen(id string) (*SnapshotMeta, io.ReadCloser, error)\n59\t}\n60\t\n61\t// SnapshotSink is returned by StartSnapshot. The FSM will Write state\n62\t// to the sink and call Close on completion. On error, Cancel will be invoked.\n63\ttype SnapshotSink interface {\n64\t\tio.WriteCloser\n65\t\tID() string\n66\t\tCancel() error\n67\t}\n68\t\n69\t// runSnapshots is a long running goroutine used to manage taking\n70\t// new snapshots of the FSM. It runs in parallel to the FSM and\n71\t// main goroutines, so that snapshots do not block normal operation.\n72\tfunc (r *Raft) runSnapshots() {\n73\t\tfor {\n74\t\t\tselect {\n75\t\t\tcase <-randomTimeout(r.config().SnapshotInterval):\n76\t\t\t\t// Check if we should snapshot\n77\t\t\t\tif !r.shouldSnapshot() {\n78\t\t\t\t\tcontinue\n79\t\t\t\t}\n80\t\n81\t\t\t\t// Trigger a snapshot\n82\t\t\t\tif _, err := r.takeSnapshot(); err != nil {\n83\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n84\t\t\t\t}\n85\t\n86\t\t\tcase future := <-r.userSnapshotCh:\n87\t\t\t\t// User-triggered, run immediately\n88\t\t\t\tid, err := r.takeSnapshot()\n89\t\t\t\tif err != nil {\n90\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n91\t\t\t\t} else {\n92\t\t\t\t\tfuture.opener = func() (*SnapshotMeta, io.ReadCloser, error) {\n93\t\t\t\t\t\treturn r.snapshots.Open(id)\n94\t\t\t\t\t}\n95\t\t\t\t}\n96\t\t\t\tfuture.respond(err)\n97\t\n98\t\t\tcase <-r.shutdownCh:\n99\t\t\t\treturn\n100\t\t\t}\n101\t\t}\n102\t}\n103\t\n104\t// shouldSnapshot checks if we meet the conditions to take\n105\t// a new snapshot.\n106\tfunc (r *Raft) shouldSnapshot() bool {\n107\t\t// Check the last snapshot index\n108\t\tlastSnap, _ := r.getLastSnapshot()\n109\t\n110\t\t// Check the last log index\n111\t\tlastIdx, err := r.logs.LastIndex()\n112\t\tif err != nil {\n113\t\t\tr.logger.Error(\"failed to get last log index\", \"error\", err)\n114\t\t\treturn false\n115\t\t}\n116\t\n117\t\t// Compare the delta to the threshold\n118\t\tdelta := lastIdx - lastSnap\n119\t\treturn delta >= r.config().SnapshotThreshold\n120\t}\n121\t\n122\t// takeSnapshot is used to take a new snapshot. This must only be called from\n123\t// the snapshot thread, never the main thread. This returns the ID of the new\n124\t// snapshot, along with an error.\n125\tfunc (r *Raft) takeSnapshot() (string, error) {\n126\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n127\t\n128\t\t// Create a request for the FSM to perform a snapshot.\n129\t\tsnapReq := &reqSnapshotFuture{}\n130\t\tsnapReq.init()\n","exit_code":0,"status":"completed"}}
