{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=700 && NR<=1000 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"700\t\n701\t\t\t\t// When we are leaving leaderLoop, we are no longer\n702\t\t\t\t// leader, so we should stop transferring.\n703\t\t\t\tleftLeaderLoop := make(chan struct{})\n704\t\t\t\tdefer func() { close(leftLeaderLoop) }()\n705\t\n706\t\t\t\tstopCh := make(chan struct{})\n707\t\t\t\tdoneCh := make(chan error, 1)\n708\t\n709\t\t\t\t// This is intentionally being setup outside of the\n710\t\t\t\t// leadershipTransfer function. Because the TimeoutNow\n711\t\t\t\t// call is blocking and there is no way to abort that\n712\t\t\t\t// in case eg the timer expires.\n713\t\t\t\t// The leadershipTransfer function is controlled with\n714\t\t\t\t// the stopCh and doneCh.\n715\t\t\t\t// No matter how this exits, have this function set\n716\t\t\t\t// leadership transfer to false before we return\n717\t\t\t\t//\n718\t\t\t\t// Note that this leaves a window where callers of\n719\t\t\t\t// LeadershipTransfer() and LeadershipTransferToServer()\n720\t\t\t\t// may start executing after they get their future but before\n721\t\t\t\t// this routine has set leadershipTransferInProgress back to false.\n722\t\t\t\t// It may be safe to modify things such that setLeadershipTransferInProgress\n723\t\t\t\t// is set to false before calling future.Respond, but that still needs\n724\t\t\t\t// to be tested and this situation mirrors what callers already had to deal with.\n725\t\t\t\tgo func() {\n726\t\t\t\t\tdefer r.setLeadershipTransferInProgress(false)\n727\t\t\t\t\tselect {\n728\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n729\t\t\t\t\t\tclose(stopCh)\n730\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n731\t\t\t\t\t\tr.logger.Debug(err.Error())\n732\t\t\t\t\t\tfuture.respond(err)\n733\t\t\t\t\t\t<-doneCh\n734\t\t\t\t\tcase <-leftLeaderLoop:\n735\t\t\t\t\t\tclose(stopCh)\n736\t\t\t\t\t\terr := fmt.Errorf(\"lost leadership during transfer (expected)\")\n737\t\t\t\t\t\tr.logger.Debug(err.Error())\n738\t\t\t\t\t\tfuture.respond(nil)\n739\t\t\t\t\t\t<-doneCh\n740\t\t\t\t\tcase err := <-doneCh:\n741\t\t\t\t\t\tif err != nil {\n742\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n743\t\t\t\t\t\t\tfuture.respond(err)\n744\t\t\t\t\t\t} else {\n745\t\t\t\t\t\t\t// Wait for up to ElectionTimeout before flagging the\n746\t\t\t\t\t\t\t// leadership transfer as done and unblocking applies in\n747\t\t\t\t\t\t\t// the leaderLoop.\n748\t\t\t\t\t\t\tselect {\n749\t\t\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n750\t\t\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n751\t\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n752\t\t\t\t\t\t\t\tfuture.respond(err)\n753\t\t\t\t\t\t\tcase <-leftLeaderLoop:\n754\t\t\t\t\t\t\t\tr.logger.Debug(\"lost leadership during transfer (expected)\")\n755\t\t\t\t\t\t\t\tfuture.respond(nil)\n756\t\t\t\t\t\t\t}\n757\t\t\t\t\t\t}\n758\t\t\t\t\t}\n759\t\t\t\t}()\n760\t\n761\t\t\t\t// leaderState.replState is accessed here before\n762\t\t\t\t// starting leadership transfer asynchronously because\n763\t\t\t\t// leaderState is only supposed to be accessed in the\n764\t\t\t\t// leaderloop.\n765\t\t\t\tid := future.ID\n766\t\t\t\taddress := future.Address\n767\t\t\t\tif id == nil {\n768\t\t\t\t\ts := r.pickServer()\n769\t\t\t\t\tif s != nil {\n770\t\t\t\t\t\tid = &s.ID\n771\t\t\t\t\t\taddress = &s.Address\n772\t\t\t\t\t} else {\n773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n774\t\t\t\t\t\tcontinue\n775\t\t\t\t\t}\n776\t\t\t\t}\n777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n778\t\t\t\tif !ok {\n779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n780\t\t\t\t\tcontinue\n781\t\t\t\t}\n782\t\t\t\tr.setLeadershipTransferInProgress(true)\n783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n784\t\n785\t\t\tcase <-r.leaderState.commitCh:\n786\t\t\t\tr.mainThreadSaturation.working()\n787\t\t\t\t// Process the newly committed entries\n788\t\t\t\toldCommitIndex := r.getCommitIndex()\n789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n790\t\t\t\tr.setCommitIndex(commitIndex)\n791\t\n792\t\t\t\t// New configuration has been committed, set it as the committed\n793\t\t\t\t// value.\n794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n798\t\t\t\t\t\tstepDown = true\n799\t\t\t\t\t}\n800\t\t\t\t}\n801\t\n802\t\t\t\tstart := time.Now()\n803\t\t\t\tvar groupReady []*list.Element\n804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n805\t\t\t\tvar lastIdxInGroup uint64\n806\t\n807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n810\t\t\t\t\tidx := commitLog.log.Index\n811\t\t\t\t\tif idx > commitIndex {\n812\t\t\t\t\t\t// Don't go past the committed index\n813\t\t\t\t\t\tbreak\n814\t\t\t\t\t}\n815\t\n816\t\t\t\t\t// Measure the commit time\n817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n818\t\t\t\t\tgroupReady = append(groupReady, e)\n819\t\t\t\t\tgroupFutures[idx] = commitLog\n820\t\t\t\t\tlastIdxInGroup = idx\n821\t\t\t\t}\n822\t\n823\t\t\t\t// Process the group\n824\t\t\t\tif len(groupReady) != 0 {\n825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n826\t\n827\t\t\t\t\tfor _, e := range groupReady {\n828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n829\t\t\t\t\t}\n830\t\t\t\t}\n831\t\n832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n834\t\n835\t\t\t\t// Count the number of logs enqueued\n836\t\t\t\tmetrics.SetGauge([]string{\"raft\", \"commitNumLogs\"}, float32(len(groupReady)))\n837\t\n838\t\t\t\tif stepDown {\n839\t\t\t\t\tif r.config().ShutdownOnRemove {\n840\t\t\t\t\t\tr.logger.Info(\"removed ourself, shutting down\")\n841\t\t\t\t\t\tr.Shutdown()\n842\t\t\t\t\t} else {\n843\t\t\t\t\t\tr.logger.Info(\"removed ourself, transitioning to follower\")\n844\t\t\t\t\t\tr.setState(Follower)\n845\t\t\t\t\t}\n846\t\t\t\t}\n847\t\n848\t\t\tcase v := <-r.verifyCh:\n849\t\t\t\tr.mainThreadSaturation.working()\n850\t\t\t\tif v.quorumSize == 0 {\n851\t\t\t\t\t// Just dispatched, start the verification\n852\t\t\t\t\tr.verifyLeader(v)\n853\t\t\t\t} else if v.votes < v.quorumSize {\n854\t\t\t\t\t// Early return, means there must be a new leader\n855\t\t\t\t\tr.logger.Warn(\"new leader elected, stepping down\")\n856\t\t\t\t\tr.setState(Follower)\n857\t\t\t\t\tdelete(r.leaderState.notify, v)\n858\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n859\t\t\t\t\t\trepl.cleanNotify(v)\n860\t\t\t\t\t}\n861\t\t\t\t\tv.respond(ErrNotLeader)\n862\t\n863\t\t\t\t} else {\n864\t\t\t\t\t// Quorum of members agree, we are still leader\n865\t\t\t\t\tdelete(r.leaderState.notify, v)\n866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n867\t\t\t\t\t\trepl.cleanNotify(v)\n868\t\t\t\t\t}\n869\t\t\t\t\tv.respond(nil)\n870\t\t\t\t}\n871\t\n872\t\t\tcase future := <-r.userRestoreCh:\n873\t\t\t\tr.mainThreadSaturation.working()\n874\t\t\t\tif r.getLeadershipTransferInProgress() {\n875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n877\t\t\t\t\tcontinue\n878\t\t\t\t}\n879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n880\t\t\t\tfuture.respond(err)\n881\t\n882\t\t\tcase future := <-r.configurationsCh:\n883\t\t\t\tr.mainThreadSaturation.working()\n884\t\t\t\tif r.getLeadershipTransferInProgress() {\n885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n887\t\t\t\t\tcontinue\n888\t\t\t\t}\n889\t\t\t\tfuture.configurations = r.configurations.Clone()\n890\t\t\t\tfuture.respond(nil)\n891\t\n892\t\t\tcase future := <-r.configurationChangeChIfStable():\n893\t\t\t\tr.mainThreadSaturation.working()\n894\t\t\t\tif r.getLeadershipTransferInProgress() {\n895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n897\t\t\t\t\tcontinue\n898\t\t\t\t}\n899\t\t\t\tr.appendConfigurationEntry(future)\n900\t\n901\t\t\tcase b := <-r.bootstrapCh:\n902\t\t\t\tr.mainThreadSaturation.working()\n903\t\t\t\tb.respond(ErrCantBootstrap)\n904\t\n905\t\t\tcase newLog := <-r.applyCh:\n906\t\t\t\tr.mainThreadSaturation.working()\n907\t\t\t\tif r.getLeadershipTransferInProgress() {\n908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n910\t\t\t\t\tcontinue\n911\t\t\t\t}\n912\t\t\t\t// Group commit, gather all the ready commits\n913\t\t\t\tready := []*logFuture{newLog}\n914\t\t\tGROUP_COMMIT_LOOP:\n915\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n916\t\t\t\t\tselect {\n917\t\t\t\t\tcase newLog := <-r.applyCh:\n918\t\t\t\t\t\tready = append(ready, newLog)\n919\t\t\t\t\tdefault:\n920\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n921\t\t\t\t\t}\n922\t\t\t\t}\n923\t\n924\t\t\t\t// Dispatch the logs\n925\t\t\t\tif stepDown {\n926\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n927\t\t\t\t\tfor i := range ready {\n928\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n929\t\t\t\t\t}\n930\t\t\t\t} else {\n931\t\t\t\t\tr.dispatchLogs(ready)\n932\t\t\t\t}\n933\t\n934\t\t\tcase <-lease:\n935\t\t\t\tr.mainThreadSaturation.working()\n936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n937\t\t\t\tmaxDiff := r.checkLeaderLease()\n938\t\n939\t\t\t\t// Next check interval should adjust for the last node we've\n940\t\t\t\t// contacted, without going negative\n941\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n942\t\t\t\tif checkInterval < minCheckInterval {\n943\t\t\t\t\tcheckInterval = minCheckInterval\n944\t\t\t\t}\n945\t\n946\t\t\t\t// Renew the lease timer\n947\t\t\t\tlease = time.After(checkInterval)\n948\t\n949\t\t\tcase <-r.leaderNotifyCh:\n950\t\t\t\tfor _, repl := range r.leaderState.replState {\n951\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n952\t\t\t\t}\n953\t\n954\t\t\tcase <-r.followerNotifyCh:\n955\t\t\t\t//  Ignore since we are not a follower\n956\t\n957\t\t\tcase <-r.shutdownCh:\n958\t\t\t\treturn\n959\t\t\t}\n960\t\t}\n961\t}\n962\t\n963\t// verifyLeader must be called from the main thread for safety.\n964\t// Causes the followers to attempt an immediate heartbeat.\n965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n966\t\t// Current leader always votes for self\n967\t\tv.votes = 1\n968\t\n969\t\t// Set the quorum size, hot-path for single node\n970\t\tv.quorumSize = r.quorumSize()\n971\t\tif v.quorumSize == 1 {\n972\t\t\tv.respond(nil)\n973\t\t\treturn\n974\t\t}\n975\t\n976\t\t// Track this request\n977\t\tv.notifyCh = r.verifyCh\n978\t\tr.leaderState.notify[v] = struct{}{}\n979\t\n980\t\t// Trigger immediate heartbeats\n981\t\tfor _, repl := range r.leaderState.replState {\n982\t\t\trepl.notifyLock.Lock()\n983\t\t\trepl.notify[v] = struct{}{}\n984\t\t\trepl.notifyLock.Unlock()\n985\t\t\tasyncNotifyCh(repl.notifyCh)\n986\t\t}\n987\t}\n988\t\n989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n991\t\t// make sure we are not already stopped\n992\t\tselect {\n993\t\tcase <-stopCh:\n994\t\t\tdoneCh <- nil\n995\t\t\treturn\n996\t\tdefault:\n997\t\t}\n998\t\n999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n1000\t\t\terr := &deferError{}\n","exit_code":0,"status":"completed"}}
