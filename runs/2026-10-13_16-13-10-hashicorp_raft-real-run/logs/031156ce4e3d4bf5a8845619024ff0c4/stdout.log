{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1100 && NR<=1290 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' api.go\"","aggregated_output":"1100\t\n1101\t// State returns the state of this raft peer.\n1102\tfunc (r *Raft) State() RaftState {\n1103\t\treturn r.getState()\n1104\t}\n1105\t\n1106\t// LeaderCh is used to get a channel which delivers signals on acquiring or\n1107\t// losing leadership. It sends true if we become the leader, and false if we\n1108\t// lose it.\n1109\t//\n1110\t// Receivers can expect to receive a notification only if leadership\n1111\t// transition has occurred.\n1112\t//\n1113\t// If receivers aren't ready for the signal, signals may drop and only the\n1114\t// latest leadership transition. For example, if a receiver receives subsequent\n1115\t// `true` values, they may deduce that leadership was lost and regained while\n1116\t// the receiver was processing first leadership transition.\n1117\tfunc (r *Raft) LeaderCh() <-chan bool {\n1118\t\treturn r.leaderCh\n1119\t}\n1120\t\n1121\t// String returns a string representation of this Raft node.\n1122\tfunc (r *Raft) String() string {\n1123\t\treturn fmt.Sprintf(\"Node at %s [%v]\", r.localAddr, r.getState())\n1124\t}\n1125\t\n1126\t// LastContact returns the time of last contact by a leader.\n1127\t// This only makes sense if we are currently a follower.\n1128\tfunc (r *Raft) LastContact() time.Time {\n1129\t\tr.lastContactLock.RLock()\n1130\t\tlast := r.lastContact\n1131\t\tr.lastContactLock.RUnlock()\n1132\t\treturn last\n1133\t}\n1134\t\n1135\t// Stats is used to return a map of various internal stats. This\n1136\t// should only be used for informative purposes or debugging.\n1137\t//\n1138\t// Keys are: \"state\", \"term\", \"last_log_index\", \"last_log_term\",\n1139\t// \"commit_index\", \"applied_index\", \"fsm_pending\",\n1140\t// \"last_snapshot_index\", \"last_snapshot_term\",\n1141\t// \"latest_configuration\", \"last_contact\", and \"num_peers\".\n1142\t//\n1143\t// The value of \"state\" is a numeric constant representing one of\n1144\t// the possible leadership states the node is in at any given time.\n1145\t// the possible states are: \"Follower\", \"Candidate\", \"Leader\", \"Shutdown\".\n1146\t//\n1147\t// The value of \"latest_configuration\" is a string which contains\n1148\t// the id of each server, its suffrage status, and its address.\n1149\t//\n1150\t// The value of \"last_contact\" is either \"never\" if there\n1151\t// has been no contact with a leader, \"0\" if the node is in the\n1152\t// leader state, or the time since last contact with a leader\n1153\t// formatted as a string.\n1154\t//\n1155\t// The value of \"num_peers\" is the number of other voting servers in the\n1156\t// cluster, not including this node. If this node isn't part of the\n1157\t// configuration then this will be \"0\".\n1158\t//\n1159\t// All other values are uint64s, formatted as strings.\n1160\tfunc (r *Raft) Stats() map[string]string {\n1161\t\ttoString := func(v uint64) string {\n1162\t\t\treturn strconv.FormatUint(v, 10)\n1163\t\t}\n1164\t\tlastLogIndex, lastLogTerm := r.getLastLog()\n1165\t\tlastSnapIndex, lastSnapTerm := r.getLastSnapshot()\n1166\t\ts := map[string]string{\n1167\t\t\t\"state\":                r.getState().String(),\n1168\t\t\t\"term\":                 toString(r.getCurrentTerm()),\n1169\t\t\t\"last_log_index\":       toString(lastLogIndex),\n1170\t\t\t\"last_log_term\":        toString(lastLogTerm),\n1171\t\t\t\"commit_index\":         toString(r.getCommitIndex()),\n1172\t\t\t\"applied_index\":        toString(r.getLastApplied()),\n1173\t\t\t\"fsm_pending\":          toString(uint64(len(r.fsmMutateCh))),\n1174\t\t\t\"last_snapshot_index\":  toString(lastSnapIndex),\n1175\t\t\t\"last_snapshot_term\":   toString(lastSnapTerm),\n1176\t\t\t\"protocol_version\":     toString(uint64(r.protocolVersion)),\n1177\t\t\t\"protocol_version_min\": toString(uint64(ProtocolVersionMin)),\n1178\t\t\t\"protocol_version_max\": toString(uint64(ProtocolVersionMax)),\n1179\t\t\t\"snapshot_version_min\": toString(uint64(SnapshotVersionMin)),\n1180\t\t\t\"snapshot_version_max\": toString(uint64(SnapshotVersionMax)),\n1181\t\t}\n1182\t\n1183\t\tfuture := r.GetConfiguration()\n1184\t\tif err := future.Error(); err != nil {\n1185\t\t\tr.logger.Warn(\"could not get configuration for stats\", \"error\", err)\n1186\t\t} else {\n1187\t\t\tconfiguration := future.Configuration()\n1188\t\t\ts[\"latest_configuration_index\"] = toString(future.Index())\n1189\t\t\ts[\"latest_configuration\"] = fmt.Sprintf(\"%+v\", configuration.Servers)\n1190\t\n1191\t\t\t// This is a legacy metric that we've seen people use in the wild.\n1192\t\t\thasUs := false\n1193\t\t\tnumPeers := 0\n1194\t\t\tfor _, server := range configuration.Servers {\n1195\t\t\t\tif server.Suffrage == Voter {\n1196\t\t\t\t\tif server.ID == r.localID {\n1197\t\t\t\t\t\thasUs = true\n1198\t\t\t\t\t} else {\n1199\t\t\t\t\t\tnumPeers++\n1200\t\t\t\t\t}\n1201\t\t\t\t}\n1202\t\t\t}\n1203\t\t\tif !hasUs {\n1204\t\t\t\tnumPeers = 0\n1205\t\t\t}\n1206\t\t\ts[\"num_peers\"] = toString(uint64(numPeers))\n1207\t\t}\n1208\t\n1209\t\tlast := r.LastContact()\n1210\t\tif r.getState() == Leader {\n1211\t\t\ts[\"last_contact\"] = \"0\"\n1212\t\t} else if last.IsZero() {\n1213\t\t\ts[\"last_contact\"] = \"never\"\n1214\t\t} else {\n1215\t\t\ts[\"last_contact\"] = fmt.Sprintf(\"%v\", time.Now().Sub(last))\n1216\t\t}\n1217\t\treturn s\n1218\t}\n1219\t\n1220\t// CurrentTerm returns the current term.\n1221\tfunc (r *Raft) CurrentTerm() uint64 {\n1222\t\treturn r.getCurrentTerm()\n1223\t}\n1224\t\n1225\t// LastIndex returns the last index in stable storage,\n1226\t// either from the last log or from the last snapshot.\n1227\tfunc (r *Raft) LastIndex() uint64 {\n1228\t\treturn r.getLastIndex()\n1229\t}\n1230\t\n1231\t// CommitIndex returns the committed index.\n1232\t// This API maybe helpful for server to implement the read index optimization\n1233\t// as described in the Raft paper.\n1234\tfunc (r *Raft) CommitIndex() uint64 {\n1235\t\treturn r.getCommitIndex()\n1236\t}\n1237\t\n1238\t// AppliedIndex returns the last index applied to the FSM. This is generally\n1239\t// lagging behind the last index, especially for indexes that are persisted but\n1240\t// have not yet been considered committed by the leader. NOTE - this reflects\n1241\t// the last index that was sent to the application's FSM over the apply channel\n1242\t// but DOES NOT mean that the application's FSM has yet consumed it and applied\n1243\t// it to its internal state. Thus, the application's state may lag behind this\n1244\t// index.\n1245\tfunc (r *Raft) AppliedIndex() uint64 {\n1246\t\treturn r.getLastApplied()\n1247\t}\n1248\t\n1249\t// LeadershipTransfer will transfer leadership to a server in the cluster.\n1250\t// This can only be called from the leader, or it will fail. The leader will\n1251\t// stop accepting client requests, make sure the target server is up to date\n1252\t// and starts the transfer with a TimeoutNow message. This message has the same\n1253\t// effect as if the election timeout on the target server fires. Since\n1254\t// it is unlikely that another server is starting an election, it is very\n1255\t// likely that the target server is able to win the election.  Note that raft\n1256\t// protocol version 3 is not sufficient to use LeadershipTransfer. A recent\n1257\t// version of that library has to be used that includes this feature.  Using\n1258\t// transfer leadership is safe however in a cluster where not every node has\n1259\t// the latest version. If a follower cannot be promoted, it will fail\n1260\t// gracefully.\n1261\tfunc (r *Raft) LeadershipTransfer() Future {\n1262\t\tif r.protocolVersion < 3 {\n1263\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n1264\t\t}\n1265\t\n1266\t\treturn r.initiateLeadershipTransfer(nil, nil)\n1267\t}\n1268\t\n1269\t// LeadershipTransferToServer does the same as LeadershipTransfer but takes a\n1270\t// server in the arguments in case a leadership should be transitioned to a\n1271\t// specific server in the cluster.  Note that raft protocol version 3 is not\n1272\t// sufficient to use LeadershipTransfer. A recent version of that library has\n1273\t// to be used that includes this feature. Using transfer leadership is safe\n1274\t// however in a cluster where not every node has the latest version. If a\n1275\t// follower cannot be promoted, it will fail gracefully.\n1276\tfunc (r *Raft) LeadershipTransferToServer(id ServerID, address ServerAddress) Future {\n1277\t\tif r.protocolVersion < 3 {\n1278\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n1279\t\t}\n1280\t\n1281\t\treturn r.initiateLeadershipTransfer(&id, &address)\n1282\t}\n","exit_code":0,"status":"completed"}}
