urn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n221\t\t}\n222\t\treturn nil\n223\t}\n224\t\n225\t// nextConfiguration generates a new Configuration from the current one and a\n226\t// configuration change request. It's split from appendConfigurationEntry so\n227\t// that it can be unit tested easily.\n228\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n229\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n230\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n231\t\t}\n232\t\n233\t\tconfiguration := current.Clone()\n234\t\tswitch change.command {\n235\t\tcase AddVoter:\n236\t\t\tnewServer := Server{\n237\t\t\t\tSuffrage: Voter,\n238\t\t\t\tID:       change.serverID,\n239\t\t\t\tAddress:  change.serverAddress,\n240\t\t\t}\n241\t\t\tfound := false\n242\t\t\tfor i, server := range configuration.Servers {\n243\t\t\t\tif server.ID == change.serverID {\n244\t\t\t\t\tif server.Suffrage == Voter {\n245\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n246\t\t\t\t\t} else {\n247\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n248\t\t\t\t\t}\n249\t\t\t\t\tfound = true\n250\t\t\t\t\tbreak\n251\t\t\t\t}\n252\t\t\t}\n253\t\t\tif !found {\n254\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n255\t\t\t}\n256\t\tcase AddNonvoter:\n257\t\t\tnewServer := Server{\n258\t\t\t\tSuffrage: Nonvoter,\n259\t\t\t\tID:       change.serverID,\n260\t\t\t\tAddress:  change.serverAddress,\n261\t\t\t}\n262\t\t\tfound := false\n263\t\t\tfor i, server := range configuration.Servers {\n264\t\t\t\tif server.ID == change.serverID {\n265\t\t\t\t\tif server.Suffrage != Nonvoter {\n266\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n267\t\t\t\t\t} else {\n268\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n269\t\t\t\t\t}\n270\t\t\t\t\tfound = true\n271\t\t\t\t\tbreak\n272\t\t\t\t}\n273\t\t\t}\n274\t\t\tif !found {\n275\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n276\t\t\t}\n277\t\tcase DemoteVoter:\n278\t\t\tfor i, server := range configuration.Servers {\n279\t\t\t\tif server.ID == change.serverID {\n280\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n281\t\t\t\t\tbreak\n282\t\t\t\t}\n283\t\t\t}\n284\t\tcase RemoveServer:\n285\t\t\tfor i, server := range configuration.Servers {\n286\t\t\t\tif server.ID == change.serverID {\n287\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n288\t\t\t\t\tbreak\n289\t\t\t\t}\n290\t\t\t}\n291\t\tcase Promote:\n292\t\t\tfor i, server := range configuration.Servers {\n293\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n294\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n295\t\t\t\t\tbreak\n296\t\t\t\t}\n297\t\t\t}\n298\t\t}\n299\t\n300\t\t// Make sure we didn't do something bad like remove the last voter\n301\t\tif err := checkConfiguration(configuration); err != nil {\n302\t\t\treturn Configuration{}, err\n303\t\t}\n304\t\n305\t\treturn configuration, nil\n306\t}\n307\t\n308\t// encodePeers is used to serialize a Configuration into the old peers format.\n309\t// This is here for backwards compatibility when operating with a mix of old\n310\t// servers and should be removed once we deprecate support for protocol version 1.\n311\tfunc encodePeers(configuration Configuration, trans Transport) []byte {\n312\t\t// Gather up all the voters, other suffrage types are not supported by\n","exit_code":0,"status":"completed"}}
