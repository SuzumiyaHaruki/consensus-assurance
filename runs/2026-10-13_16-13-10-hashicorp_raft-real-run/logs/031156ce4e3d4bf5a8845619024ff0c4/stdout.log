ft-real-run/target-support\"\n  },\n  \"example\": {\n    \"rationale\": \"Investigate a sourced local uncertainty\",\n    \"sources\": [\n      {\n        \"id\": \"source\",\n        \"file\": \"REPLACE_WITH_CAPTURED_FILE\",\n        \"start_line\": 1,\n        \"end_line\": 1,\n        \"kind\": \"code_observation\"\n      }\n    ],\n    \"investigations\": [\n      {\n        \"ref\": \"@question\",\n        \"question\": \"Which applicable caller condition establishes this result?\",\n        \"source_ids\": [\n          \"source\"\n        ],\n        \"discriminator\": \"Trace the actual producer and the enclosing protection\"\n      }\n    ]\n  },\n  \"optional_experiment\": {\n    \"investigation_id\": \"@question\",\n    \"harness_path\": \"assurance_generated_test.go\",\n    \"source_ids\": [\n      \"source\"\n    ],\n    \"scope\": {\n      \"description\": \"Observe the sourced local behavior\"\n    },\n    \"prefix\": \"Describe actual initialization and producer calls in the draft harness, including supplied state\"\n  },\n  \"costs\": {\n    \"agent_calls\": 1,\n    \"target_executions\": 0,\n    \"process_seconds\": 0,\n    \"action_seconds\": 0,\n    \"unrecorded_action_ids\": [],\n    \"elapsed_seconds\": 2.28006403299878\n  }\n}","exit_code":0,"status":"completed"}}
