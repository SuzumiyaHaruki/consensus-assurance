{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=1 && NR<=300 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' replication.go\"","aggregated_output":"1\t// Copyright (c) HashiCorp, Inc.\n2\t// SPDX-License-Identifier: MPL-2.0\n3\t\n4\tpackage raft\n5\t\n6\timport (\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"sync\"\n10\t\t\"sync/atomic\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/hashicorp/go-metrics/compat\"\n14\t)\n15\t\n16\tconst (\n17\t\tmaxFailureScale = 12\n18\t\tfailureWait     = 10 * time.Millisecond\n19\t)\n20\t\n21\tvar (\n22\t\t// ErrLogNotFound indicates a given log entry is not available.\n23\t\tErrLogNotFound = errors.New(\"log not found\")\n24\t\n25\t\t// ErrPipelineReplicationNotSupported can be returned by the transport to\n26\t\t// signal that pipeline replication is not supported in general, and that\n27\t\t// no error message should be produced.\n28\t\tErrPipelineReplicationNotSupported = errors.New(\"pipeline replication not supported\")\n29\t)\n30\t\n31\t// followerReplication is in charge of sending snapshots and log entries from\n32\t// this leader during this particular term to a remote follower.\n33\ttype followerReplication struct {\n34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n36\t\t// platforms.\n37\t\n38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n39\t\t// requests.\n40\t\tcurrentTerm uint64\n41\t\n42\t\t// nextIndex is the index of the next log entry to send to the follower,\n43\t\t// which may fall past the end of the log.\n44\t\tnextIndex uint64\n45\t\n46\t\t// peer contains the network address and ID of the remote follower.\n47\t\tpeer Server\n48\t\t// peerLock protects 'peer'\n49\t\tpeerLock sync.RWMutex\n50\t\n51\t\t// commitment tracks the entries acknowledged by followers so that the\n52\t\t// leader's commit index can advance. It is updated on successful\n53\t\t// AppendEntries responses.\n54\t\tcommitment *commitment\n55\t\n56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n57\t\t// removed from the cluster. In the follower removed case, it carries a log\n58\t\t// index; replication should be attempted with a best effort up through that\n59\t\t// index, before exiting.\n60\t\tstopCh chan uint64\n61\t\n62\t\t// triggerCh is notified every time new entries are appended to the log.\n63\t\ttriggerCh chan struct{}\n64\t\n65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n66\t\t// deferErr, the sender can be notified when the replication is done.\n67\t\ttriggerDeferErrorCh chan *deferError\n68\t\n69\t\t// lastContact is updated to the current time whenever any response is\n70\t\t// received from the follower (successful or not). This is used to check\n71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n72\t\tlastContact time.Time\n73\t\t// lastContactLock protects 'lastContact'.\n74\t\tlastContactLock sync.RWMutex\n75\t\n76\t\t// failures counts the number of failed RPCs since the last success, which is\n77\t\t// used to apply backoff.\n78\t\tfailures uint64\n79\t\n80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n81\t\t// this server is still leader.\n82\t\tnotifyCh chan struct{}\n83\t\t// notify is a map of futures to be resolved upon receipt of an\n84\t\t// acknowledgement, then cleared from this map.\n85\t\tnotify map[*verifyFuture]struct{}\n86\t\t// notifyLock protects 'notify'.\n87\t\tnotifyLock sync.Mutex\n88\t\n89\t\t// stepDown is used to indicate to the leader that we\n90\t\t// should step down based on information from a follower.\n91\t\tstepDown chan struct{}\n92\t\n93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n94\t\t// It is private to this replication goroutine.\n95\t\tallowPipeline bool\n96\t}\n97\t\n98\t// notifyAll is used to notify all the waiting verify futures\n99\t// if the follower believes we are still the leader.\n100\tfunc (s *followerReplication) notifyAll(leader bool) {\n101\t\t// Clear the waiting notifies minimizing lock time\n102\t\ts.notifyLock.Lock()\n103\t\tn := s.notify\n104\t\ts.notify = make(map[*verifyFuture]struct{})\n105\t\ts.notifyLock.Unlock()\n106\t\n107\t\t// Submit our votes\n108\t\tfor v := range n {\n109\t\t\tv.vote(leader)\n110\t\t}\n111\t}\n112\t\n113\t// cleanNotify is used to delete notify, .\n114\tfunc (s *followerReplication) cleanNotify(v *verifyFuture) {\n115\t\ts.notifyLock.Lock()\n116\t\tdelete(s.notify, v)\n117\t\ts.notifyLock.Unlock()\n118\t}\n119\t\n120\t// LastContact returns the time of last contact.\n121\tfunc (s *followerReplication) LastContact() time.Time {\n122\t\ts.lastContactLock.RLock()\n123\t\tlast := s.lastContact\n124\t\ts.lastContactLock.RUnlock()\n125\t\treturn last\n126\t}\n127\t\n128\t// setLastContact sets the last contact to the current time.\n129\tfunc (s *followerReplication) setLastContact() {\n130\t\ts.lastContactLock.Lock()\n131\t\ts.lastContact = time.Now()\n132\t\ts.lastContactLock.Unlock()\n133\t}\n134\t\n135\t// replicate is a long running routine that replicates log entries to a single\n136\t// follower.\n137\tfunc (r *Raft) replicate(s *followerReplication) {\n138\t\t// Start an async heartbeating routing\n139\t\tstopHeartbeat := make(chan struct{})\n140\t\tdefer close(stopHeartbeat)\n141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n142\t\n143\tRPC:\n144\t\tshouldStop := false\n145\t\tfor !shouldStop {\n146\t\t\tselect {\n147\t\t\tcase maxIndex := <-s.stopCh:\n148\t\t\t\t// Make a best effort to replicate up to this index\n149\t\t\t\tif maxIndex > 0 {\n150\t\t\t\t\tr.replicateTo(s, maxIndex)\n151\t\t\t\t}\n152\t\t\t\treturn\n153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n156\t\t\t\tif !shouldStop {\n157\t\t\t\t\tdeferErr.respond(nil)\n158\t\t\t\t} else {\n159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n160\t\t\t\t}\n161\t\t\tcase <-s.triggerCh:\n162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n165\t\t\t// followers quickly learn the leader's commit index when\n166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n167\t\t\t// can't do this to keep them unblocked by disk IO on the\n168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n172\t\t\t}\n173\t\n174\t\t\t// If things looks healthy, switch to pipeline mode\n175\t\t\tif !shouldStop && s.allowPipeline {\n176\t\t\t\tgoto PIPELINE\n177\t\t\t}\n178\t\t}\n179\t\treturn\n180\t\n181\tPIPELINE:\n182\t\t// Disable until re-enabled\n183\t\ts.allowPipeline = false\n184\t\n185\t\t// Replicates using a pipeline for high performance. This method\n186\t\t// is not able to gracefully recover from errors, and so we fall back\n187\t\t// to standard mode on failure.\n188\t\tif err := r.pipelineReplicate(s); err != nil {\n189\t\t\tif err != ErrPipelineReplicationNotSupported {\n190\t\t\t\ts.peerLock.RLock()\n191\t\t\t\tpeer := s.peer\n192\t\t\t\ts.peerLock.RUnlock()\n193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n194\t\t\t}\n195\t\t}\n196\t\tgoto RPC\n197\t}\n198\t\n199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n200\t// given last index.\n201\t// If the follower log is behind, we take care to bring them up to date.\n202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n203\t\t// Create the base request\n204\t\tvar req AppendEntriesRequest\n205\t\tvar resp AppendEntriesResponse\n206\t\tvar start time.Time\n207\t\tvar peer Server\n208\t\n209\tSTART:\n210\t\t// Prevent an excessive retry rate on errors\n211\t\tif s.failures > 0 {\n212\t\t\tselect {\n213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n214\t\t\tcase <-r.shutdownCh:\n215\t\t\t}\n216\t\t}\n217\t\n218\t\ts.peerLock.RLock()\n219\t\tpeer = s.peer\n220\t\ts.peerLock.RUnlock()\n221\t\n222\t\t// Setup the request\n223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n224\t\t\tgoto SEND_SNAP\n225\t\t} else if err != nil {\n226\t\t\treturn\n227\t\t}\n228\t\n229\t\t// Make the RPC call\n230\t\tstart = time.Now()\n231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n233\t\t\ts.failures++\n234\t\t\treturn\n235\t\t}\n236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n237\t\n238\t\t// Check for a newer term, stop running\n239\t\tif resp.Term > req.Term {\n240\t\t\tr.handleStaleTerm(s)\n241\t\t\treturn true\n242\t\t}\n243\t\n244\t\t// Update the last contact\n245\t\ts.setLastContact()\n246\t\n247\t\t// Update s based on success\n248\t\tif resp.Success {\n249\t\t\t// Update our replication state\n250\t\t\tupdateLastAppended(s, &req)\n251\t\n252\t\t\t// Clear any failures, allow pipelining\n253\t\t\ts.failures = 0\n254\t\t\ts.allowPipeline = true\n255\t\t} else {\n256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n257\t\t\tif resp.NoRetryBackoff {\n258\t\t\t\ts.failures = 0\n259\t\t\t} else {\n260\t\t\t\ts.failures++\n261\t\t\t}\n262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n263\t\t}\n264\t\n265\tCHECK_MORE:\n266\t\t// Poll the stop channel here in case we are looping and have been asked\n267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n268\t\t// where we are asked to replicate to a given index and then shutdown,\n269\t\t// it's better to not loop in here to send lots of entries to a straggler\n270\t\t// that's leaving the cluster anyways.\n271\t\tselect {\n272\t\tcase <-s.stopCh:\n273\t\t\treturn true\n274\t\tdefault:\n275\t\t}\n276\t\n277\t\t// Check if there are more logs to replicate\n278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n279\t\t\tgoto START\n280\t\t}\n281\t\treturn\n282\t\n283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n284\t\t// is too far behind, and we must ship a snapshot down instead\n285\tSEND_SNAP:\n286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n287\t\t\treturn true\n288\t\t} else if err != nil {\n289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n290\t\t\treturn\n291\t\t}\n292\t\n293\t\t// Check if there is more to replicate\n294\t\tgoto CHECK_MORE\n295\t}\n296\t\n297\t// sendLatestSnapshot is used to send the latest snapshot we have\n298\t// down to our follower.\n299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n300\t\t// Get the snapshots\n","exit_code":0,"status":"completed"}}
