tries:   64,\n323-\t\tShutdownOnRemove:   true,\n324-\t\tTrailingLogs:       10240,\n325-\t\tSnapshotInterval:   120 * time.Second,\n326-\t\tSnapshotThreshold:  8192,\n327-\t\tLeaderLeaseTimeout: 500 * time.Millisecond,\n328-\t\tLogLevel:           \"DEBUG\",\n329-\t}\n330-}\n331-\n332-// ValidateConfig is used to validate a sane configuration\n333-func ValidateConfig(config *Config) error {\n334-\t// We don't actually support running as 0 in the library any more, but\n335-\t// we do understand it.\n336-\tprotocolMin := ProtocolVersionMin\n337-\tif protocolMin == 0 {\n338-\t\tprotocolMin = 1\n339-\t}\n340-\tif config.ProtocolVersion < protocolMin ||\n341-\t\tconfig.ProtocolVersion > ProtocolVersionMax {\n342-\t\treturn fmt.Errorf(\"ProtocolVersion %d must be >= %d and <= %d\",\n343-\t\t\tconfig.ProtocolVersion, protocolMin, ProtocolVersionMax)\n344-\t}\n345-\tif len(config.LocalID) == 0 {\n346-\t\treturn fmt.Errorf(\"LocalID cannot be empty\")\n","exit_code":0,"status":"completed"}}
