{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_16-13-10-hashicorp_raft-real-run/agent-source && awk 'NR>=2130 && NR<=2241 {printf \\\"%d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' raft.go\"","aggregated_output":"2130\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n2131\t\tif err := r.stable.SetUint64(keyLastVoteTerm, term); err != nil {\n2132\t\t\treturn err\n2133\t\t}\n2134\t\tif err := r.stable.Set(keyLastVoteCand, candidate); err != nil {\n2135\t\t\treturn err\n2136\t\t}\n2137\t\treturn nil\n2138\t}\n2139\t\n2140\t// setCurrentTerm is used to set the current term in a durable manner.\n2141\tfunc (r *Raft) setCurrentTerm(t uint64) {\n2142\t\t// Persist to disk first\n2143\t\tif err := r.stable.SetUint64(keyCurrentTerm, t); err != nil {\n2144\t\t\tpanic(fmt.Errorf(\"failed to save current term: %v\", err))\n2145\t\t}\n2146\t\tr.raftState.setCurrentTerm(t)\n2147\t}\n2148\t\n2149\t// setState is used to update the current state. Any state\n2150\t// transition causes the known leader to be cleared. This means\n2151\t// that leader should be set only after updating the state.\n2152\tfunc (r *Raft) setState(state RaftState) {\n2153\t\tr.setLeader(\"\", \"\")\n2154\t\toldState := r.raftState.getState()\n2155\t\tr.raftState.setState(state)\n2156\t\tif oldState != state {\n2157\t\t\tr.observe(state)\n2158\t\t}\n2159\t}\n2160\t\n2161\t// pickServer returns the follower that is most up to date and participating in quorum.\n2162\t// Because it accesses leaderstate, it should only be called from the leaderloop.\n2163\tfunc (r *Raft) pickServer() *Server {\n2164\t\tvar pick *Server\n2165\t\tvar current uint64\n2166\t\tfor _, server := range r.configurations.latest.Servers {\n2167\t\t\tif server.ID == r.localID || server.Suffrage != Voter {\n2168\t\t\t\tcontinue\n2169\t\t\t}\n2170\t\t\tstate, ok := r.leaderState.replState[server.ID]\n2171\t\t\tif !ok {\n2172\t\t\t\tcontinue\n2173\t\t\t}\n2174\t\t\tnextIdx := atomic.LoadUint64(&state.nextIndex)\n2175\t\t\tif nextIdx > current {\n2176\t\t\t\tcurrent = nextIdx\n2177\t\t\t\ttmp := server\n2178\t\t\t\tpick = &tmp\n2179\t\t\t}\n2180\t\t}\n2181\t\treturn pick\n2182\t}\n2183\t\n2184\t// initiateLeadershipTransfer starts the leadership on the leader side, by\n2185\t// sending a message to the leadershipTransferCh, to make sure it runs in the\n2186\t// mainloop.\n2187\tfunc (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n2188\t\tfuture := &leadershipTransferFuture{ID: id, Address: address}\n2189\t\tfuture.init()\n2190\t\n2191\t\tif id != nil && *id == r.localID {\n2192\t\t\terr := fmt.Errorf(\"cannot transfer leadership to itself\")\n2193\t\t\tr.logger.Info(err.Error())\n2194\t\t\tfuture.respond(err)\n2195\t\t\treturn future\n2196\t\t}\n2197\t\n2198\t\tselect {\n2199\t\tcase r.leadershipTransferCh <- future:\n2200\t\t\treturn future\n2201\t\tcase <-r.shutdownCh:\n2202\t\t\treturn errorFuture{ErrRaftShutdown}\n2203\t\tdefault:\n2204\t\t\treturn errorFuture{ErrEnqueueTimeout}\n2205\t\t}\n2206\t}\n2207\t\n2208\t// timeoutNow is what happens when a server receives a TimeoutNowRequest.\n2209\tfunc (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n2210\t\tr.setLeader(\"\", \"\")\n2211\t\tr.setState(Candidate)\n2212\t\tr.candidateFromLeadershipTransfer.Store(true)\n2213\t\trpc.Respond(&TimeoutNowResponse{}, nil)\n2214\t}\n2215\t\n2216\t// setLatestConfiguration stores the latest configuration and updates a copy of it.\n2217\tfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n2218\t\tr.configurations.latest = c\n2219\t\tr.configurations.latestIndex = i\n2220\t\tr.latestConfiguration.Store(c.Clone())\n2221\t}\n2222\t\n2223\t// setCommittedConfiguration stores the committed configuration.\n2224\tfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n2225\t\tr.configurations.committed = c\n2226\t\tr.configurations.committedIndex = i\n2227\t}\n2228\t\n2229\t// getLatestConfiguration reads the configuration from a copy of the main\n2230\t// configuration, which means it can be accessed independently from the main\n2231\t// loop.\n2232\tfunc (r *Raft) getLatestConfiguration() Configuration {\n2233\t\t// this switch catches the case where this is called without having set\n2234\t\t// a configuration previously.\n2235\t\tswitch c := r.latestConfiguration.Load().(type) {\n2236\t\tcase Configuration:\n2237\t\t\treturn c\n2238\t\tdefault:\n2239\t\t\treturn Configuration{}\n2240\t\t}\n2241\t}\n","exit_code":0,"status":"completed"}}
