napshot\n1858\t\tvar reqConfiguration Configuration\n1859\t\tvar reqConfigurationIndex uint64\n1860\t\tif req.SnapshotVersion > 0 {\n1861\t\t\treqConfiguration = DecodeConfiguration(req.Configuration)\n1862\t\t\treqConfigurationIndex = req.ConfigurationIndex\n1863\t\t} else {\n1864\t\t\treqConfiguration, rpcErr = decodePeers(req.Peers, r.trans)\n1865\t\t\tif rpcErr != nil {\n1866\t\t\t\tr.logger.Error(\"failed to install snapshot\", \"error\", rpcErr)\n1867\t\t\t\treturn\n1868\t\t\t}\n1869\t\t\treqConfigurationIndex = req.LastLogIndex\n1870\t\t}\n1871\t\tversion := getSnapshotVersion(r.protocolVersion)\n1872\t\tsink, err := r.snapshots.Create(version, req.LastLogIndex, req.LastLogTerm,\n1873\t\t\treqConfiguration, reqConfigurationIndex, r.trans)\n1874\t\tif err != nil {\n1875\t\t\tr.logger.Error(\"failed to create snapshot to install\", \"error\", err)\n1876\t\t\trpcErr = fmt.Errorf(\"failed to create snapshot: %v\", err)\n1877\t\t\treturn\n1878\t\t}\n1879\t\n1880\t\t// Separately track the progress of streaming a snapshot over the network\n1881\t\t// because this too can take a long time.\n1882\t\tcountingRPCReader := newCountingReader(rpc.Reader)\n1883\t\n1884\t\t// Spill the remote snapshot to disk\n1885\t\ttransferMonitor := startSnapshotRestoreMonitor(r.logger, countingRPCReader, req.Size, true)\n1886\t\tn, err := io.Copy(sink, countingRPCReader)\n1887\t\ttransferMonitor.StopAndWait()\n1888\t\tif err != nil {\n1889\t\t\tsink.Cancel()\n1890\t\t\tr.logger.Error(\"failed to copy snapshot\", \"error\", err)\n1891\t\t\trpcErr = err\n1892\t\t\treturn\n1893\t\t}\n1894\t\n1895\t\t// Check that we received it all\n1896\t\tif n != req.Size {\n1897\t\t\tsink.Cancel()\n1898\t\t\tr.logger.Error(\"failed to receive whole snapshot\",\n1899\t\t\t\t\"received\", hclog.Fmt(\"%d / %d\", n, req.Size))\n1900\t\t\trpcErr = fmt.Errorf(\"short read\")\n1901\t\t\treturn\n1902\t\t}\n1903\t\n1904\t\t// Finalize the snapshot\n1905\t\tif err := sink.Close(); err != nil {\n1906\t\t\tr.logger.Error(\"failed to finalize snapshot\", \"error\", err)\n1907\t\t\trpcErr = err\n1908\t\t\treturn\n1909\t\t}\n1910\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n1911\t\n1912\t\t// Restore snapshot\n1913\t\tfuture := &restoreFuture{ID: sink.ID()}\n1914\t\tfuture.ShutdownCh = r.shutdownCh\n1915\t\tfuture.init()\n1916\t\tselect {\n1917\t\tcase r.fsmMutateCh <- future:\n1918\t\tcase <-r.shutdownCh:\n1919\t\t\tfuture.respond(ErrRaftShutdown)\n1920\t\t\treturn\n1921\t\t}\n1922\t\n1923\t\t// Wait for the restore to happen\n1924\t\tif err := future.Error(); err != nil {\n1925\t\t\tr.logger.Error(\"failed to restore snapshot\", \"error\", err)\n1926\t\t\trpcErr = err\n1927\t\t\treturn\n1928\t\t}\n1929\t\n1930\t\t// Update the lastApplied so we don't replay old logs\n1931\t\tr.setLastApplied(req.LastLogIndex)\n1932\t\n1933\t\t// Update the last stable snapshot info\n1934\t\tr.setLastSnapshot(req.LastLogIndex, req.LastLogTerm)\n1935\t\n1936\t\t// Restore the peer set\n1937\t\tr.setLatestConfiguration(reqConfiguration, reqConfigurationIndex)\n1938\t\tr.setCommittedConfiguration(reqConfiguration, reqConfigurationIndex)\n1939\t\n1940\t\t// Clear old logs if r.logs is a MonotonicLogStore. Otherwise compact the\n1941\t\t// logs. In both cases, log any errors and continue.\n1942\t\tif mlogs, ok := r.logs.(MonotonicLogStore); ok && mlogs.IsMonotonic() {\n1943\t\t\tif err := r.removeOldLogs(); err != nil {\n1944\t\t\t\tr.logger.Error(\"failed to reset logs\", \"error\", err)\n1945\t\t\t}\n1946\t\t} else if err := r.compactLogs(req.LastLogIndex); err != nil {\n1947\t\t\tr.logger.Error(\"failed to compact logs\", \"error\", err)\n1948\t\t}\n1949\t\n1950\t\tr.logger.Info(\"Installed remote snapshot\")\n1951\t\tresp.Success = true\n1952\t\tr.setLastContact()\n1953\t}\n1954\t\n1955\t// setLastContact is used to set the last contact time to now\n1956\tfunc (r *Raft) setLastContact() {\n1957\t\tr.lastContactLock.Lock()\n1958\t\tr.lastContact = time.Now()\n1959\t\tr.lastContactLock.Unlock()\n1960\t}\n1961\t\n1962\ttype voteResult struct {\n1963\t\tRequestVoteResponse\n1964\t\tvoterID ServerID\n1965\t}\n1966\t\n1967\ttype preVoteResult struct {\n1968\t\tRequestPreVoteResponse\n1969\t\tvoterID ServerID\n1970\t}\n1971\t\n1972\t// electSelf is used to send a RequestVote RPC to all peers, and vote for\n1973\t// ourself. This has the side affecting of incrementing the current term. The\n1974\t// response channel returned is used to wait for all the responses (including a\n1975\t// vote for ourself). This must only be called from the main thread.\n1976\tfunc (r *Raft) electSelf() <-chan *voteResult {\n","exit_code":0,"status":"completed"}}
