  "input": {
    "rationale": "The transfer finding's normative half is unanchored in the same way the verification finding's was until last turn: its rationale leans on the call being offered as a way to move leadership to a named server in the cluster, and the declared source range starts at the function rather than at the documentation above it. That promise is what makes a vote-less target a defect rather than an operator error - the caller names a server the cluster contains and is told the transfer did not fail - so the range should be cited like the code half, exactly as I did for VerifyLeader. This adds that range as a source and records the documented purpose as a behaviour, including the note that the documentation already warns about mixed-version clusters, which is the shape of the case this finding exercises. Nothing else changes, no claim is added, and no execution is spent.",
    "sources": [
      {
        "id": "xferdoc",
        "file": "api.go",
        "start_line": 1269,
        "end_line": 1275,
        "kind": "document_statement"
      }
    ],
    "investigations": [],
    "knowledge": [
      {
        "id": null,
        "ref": "@transfer_documented_purpose",
        "kind": "behavior",
        "statement": "The documentation for LeadershipTransferToServer states that it does the same as LeadershipTransfer but takes a specific server in the cluster as an argument, that the leader stops accepting requests, makes sure the target is up to date and starts the transfer with a TimeoutNow message, and that the use is safe in a cluster where not every node runs the latest version because a follower that cannot be promoted fails gracefully. That is the promise the transfer finding is measured against: the call is offered as a way to hand leadership to a named member of the cluster, so a target that holds no vote being accepted and the caller being told the transfer did not fail is a mismatch with the documented purpose rather than an operator mistake.",
        "conditions": "This revision, the public LeadershipTransferToServer call as documented at the cited range; the statement records the documented purpose, and the warning about mixed versions is the documentation's own, not an inference from the run.",
        "source_ids": [
          "xferdoc",
          "xferapi",
          "timeoutnow",
          "xferprevoteskip",
          "electself"
        ],
