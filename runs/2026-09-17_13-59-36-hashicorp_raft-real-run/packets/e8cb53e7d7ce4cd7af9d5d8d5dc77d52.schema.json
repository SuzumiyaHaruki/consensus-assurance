        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CoveragePoint"
          },
          "title": "Points",
          "type": "array"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "preferred_check",
        "requests",
        "question",
        "importance",
        "source_ids",
        "participants",
        "objects",
        "contexts",
        "event_paths",
        "points",
        "trigger_rationale"
