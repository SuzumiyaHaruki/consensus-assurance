{
  "$defs": {
    "AuditQuestion": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "explained_by_existing_mechanism",
                "concrete_suspicion",
                "needs_specific_evidence",
                "ready_for_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition"
        },
        "preferred_check": {
          "anyOf": [
            {
              "enum": [
                "source_review",
                "direct_test",
                "controlled_schedule",
                "local_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preferred Check"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/ReadRequest"
          },
          "title": "Requests",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "activity_classes": {
          "items": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7"
            ],
            "type": "string"
          },
          "title": "Activity Classes",
          "type": "array"
        },
        "behavior_ids": {
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "obligation_relation_kind": {
          "anyOf": [
            {
              "enum": [
                "establishment",
                "preservation",
                "consumption",
                "recovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Obligation Relation Kind"
        },
        "counterevidence": {
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "priority": {
          "description": "System consequence and audit significance, justified in importance; not proof",
          "maximum": 3,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "preferred_check",
        "requests",
        "question",
        "importance",
        "source_ids",
        "participants",
        "objects",
        "contexts",
        "event_paths",
        "activity_classes",
        "behavior_ids",
        "fact_ids",
        "obligation_relation_kind",
        "counterevidence",
        "unknowns",
        "priority",
        "trigger_rationale"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "minItems": 1,
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "associations",
        "anchor",
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "BindingSplit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "JSON pointer to one diagnosed, unaccepted binding",
          "title": "Path",
          "type": "string"
        },
        "bindings": {
          "description": "Complete replacement BindingDraft objects, each anchored in supplied code; preserve the entire original behavior range and associations",
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Bindings",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bindings",
        "rationale"
      ],
      "title": "BindingSplit",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending",
        "grounding"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "boundary_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Boundary Complete"
        },
        "kind": {
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "boundary_complete",
        "kind",
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "GraphPatch": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 15,
          "title": "Claims",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 20,
          "title": "Bindings",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDraft"
          },
          "maxItems": 30,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitDraft"
          },
          "maxItems": 5,
          "title": "Units",
          "type": "array"
        },
        "expected_versions": {
          "type": "array",
          "description": " Dictionary entries; keys must be unique. Use typed values.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "claims",
        "bindings",
        "relations",
        "units",
        "expected_versions",
        "rationale",
        "gaps"
      ],
      "title": "GraphPatch",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "expectation_ids": {
          "description": "Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.",
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object",
      "required": [
        "source_ids",
        "expectation_ids",
        "binding_ids",
        "derivation",
        "applicability",
        "unresolved",
        "conflicts",
        "alternatives"
      ]
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    },
    "RelationDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "depends_all",
            "conditional_on",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "group",
        "rationale",
        "pending",
        "grounding"
      ],
      "title": "RelationDraft",
      "type": "object"
    },
    "Replacement": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "One exact JSON pointer from repair_targets",
          "title": "Path",
          "type": "string"
        },
        "value_json": {
          "description": "JSON encoding of the replacement value, not a whole new response",
          "title": "Value Json",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value_json"
      ],
      "title": "Replacement",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "parameters": {
          "type": "array",
          "description": " Dictionary entries; keys must be unique. value_json encodes a JSON value.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value_json": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value_json"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description",
        "assumptions",
        "excluded",
        "parameters"
      ],
      "title": "Scope",
      "type": "object"
    },
    "UnitDraft": {
      "additionalProperties": false,
      "properties": {
        "audit_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "obligation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Obligation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Binding Ids",
          "type": "array"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Relation Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "audit_question",
        "id",
        "obligation_ids",
        "binding_ids",
        "relation_ids",
        "scope",
        "rationale"
      ],
      "title": "UnitDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft_patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphPatch"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit alternative scope/location proposal for a graph_patch draft; preserve existing claims, relations, checked obligations and fault scope. This is not a mechanical field replacement and is fully revalidated."
    },
    "binding_splits": {
      "items": {
        "$ref": "#/$defs/BindingSplit"
      },
      "maxItems": 4,
      "title": "Binding Splits",
      "type": "array"
    },
    "replacements": {
      "items": {
        "$ref": "#/$defs/Replacement"
      },
      "maxItems": 24,
      "title": "Replacements",
      "type": "array"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/ReadRequest"
      },
      "maxItems": 12,
      "title": "Requests",
      "type": "array"
    },
    "change_request": {
      "description": "Explicit stop for a semantic/scope decision, not a queued follow-up. Leave empty for material reads or permitted representation/association repairs; do not combine with those actions.",
      "title": "Change Request",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "draft_patch",
    "binding_splits",
    "replacements",
    "requests",
    "change_request",
    "rationale"
  ],
  "title": "OutputRepair",
  "type": "object"
}