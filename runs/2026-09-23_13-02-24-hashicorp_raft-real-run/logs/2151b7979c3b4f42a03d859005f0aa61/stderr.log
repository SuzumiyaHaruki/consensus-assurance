nowns":["Local and remote consumed facts are alternative producer paths, not jointly required per call.","Other match producers and their guarantees are unread."],"source_ids":["commitment.go:1:104","raft.go:1244:1291","replication.go:646:665"]},{"id":"B_commit_configuration","primary_activity":"A4","execution_owner":"Caller of commitment.setConfiguration under commitment mutex","protocol_context":"Existing leader-local commitment object with a replacement configuration","trigger":"setConfiguration invocation","legal_preconditions":["Selection and activation of the supplied configuration are established by unread callers."],"implementation_guards":["Includes only servers with Voter suffrage."],"important_branches":["Retained IDs preserve match values; new voter IDs start at zero.","Previously advanced commitment index is not lowered."],"async_boundaries":["commitCh notification"],"produces_fact_ids":["F_commit_threshold"],"consumes_fact_ids":["F_leader_commit_context"],"existing_protections":["Configuration replacement and recalculation share the mutex."],"unknowns":["Activation timing, caller guards, and the history linking configuration changes to log decisions."],"source_ids":["commitment.go:1:104"]},{"id":"B_commit_consume","primary_activity":"A1","execution_owner":"Main Raft leader loop","protocol_context":"Leader loop commitCh case","trigger":"Receipt from leaderState.commitCh","legal_preconditions":["The loop iteration entered while local role was Leader."],"implementation_guards":["Reads the synchronized commitment index rather than a value carried by the notification.","Selects inflight entries only up to the commitment index."],"important_branches":["Configuration commitment is recognized only when latestIndex crosses the old/new commit interval.","The supplied excerpt ends before group removal and subsequent stepDown handling."],"async_boundaries":["Commit notification receipt","processLogs implementation is unread"],"produces_fact_ids":[],"consumes_fact_