not yet established.\",\n        \"source_ids\": [\n          \"M-follower\"\n        ],\n        \"high_consequence\": true\n      },\n      {\n        \"entry_point\": \"Raft.restoreUserSnapshot / RecoverCluster\",\n        \"disposition\": \"deferred\",\n        \"behavior_ids\": [],\n        \"reason\": \"Manual destructive history replacement differs from ordinary consensus recovery; inspect caller contract before treating it as a fault.\",\n        \"source_ids\": [\n          \"M-client\"\n        ],\n        \"high_consequence\": true\n      }\n    ],\n    \"core_regions\": [\n      {\n        \"activity\": \"A1\",\n        \"entries\": [\n          {\n            \"class_id\": \"A1\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Qualified support for decision formation and legal advancement\",\n            \"realization_summary\": \"Leader dispatch, voter-index aggregation and follower propagation connect stored support to commit decisions.\",\n            \"entry_points\": [\n              \"B-replicate\",\n              \"B-quorum\",\n              \"B-commit-consume\"\n            ],\n            \"behavior_ids\": [\n              \"B-replicate\",\n              \"B-quorum\",\n              \"B-commit-consume\"\n            ],\n            \"variants\": [],\n            \"unknowns\": [],\n            \"source_ids\": [\n              \"M-apply\",\n              \"M-commit\",\n              \"M-follower\",\n              \"M-leader\",\n              \"M-leader-loop\",\n              \"M-reply\",\n              \"M-send\",\n              \"M-snapshot-send\",\n              \"M-update\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [\n          {\n            \"class_id\": \"A2\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Context validity and acquisition, transfer or loss of authority\",\n            \"realization_summary\": \"Election attempts acquire authority; term/lease/role transitions retire tenure state. Verification checks continued authority through a separate callback tally.\",\n            \"entry_points\": [\n              \"B-election\",\n              \"B-tenure\",\n              \"B-transfer\",\n              \"B-verify-start\",\n              \"B-verify-support\",\n              \"B-verify-finish\"\n            ],\n            \"behavior_ids\": [\n              \"B-election\",\n              \"B-tenure\",\n              \"B-transfer\",\n              \"B-verify-start\",\n              \"B-verify-support\",\n              \"B-verify-finish\"\n            ],\n            \"variants\": [],\n            \"unknowns\": [],\n            \"source_ids\": [\n              \"M-durable\",\n              \"M-elect-send\",\n              \"M-election\",\n              \"M-follower\",\n              \"M-follower-loop\",\n              \"M-heartbeat\",\n              \"M-leader\",\n              \"M-leader-loop\",\n              \"M-lease\",\n              \"M-notify\",\n              \"M-prevote\",\n              \"M-prevote-send\",\n              \"M-snapshot-send\",\n              \"M-timeout-now\",\n              \"M-transfer\",\n              \"M-update\",\n              \"M-verify\",\n              \"M-verify-vote\",\n              \"M-vote\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      }\n    ]\n  },\n  \"capacity\": {\n    \"remaining\": {\n      \"agent_calls\": 37,\n      \"experiments\": 8,\n      \"audit_units\": 4,\n      \"semantic_reviews\": 6,\n      \"revisions\": 4\n    },\n    \"remaining_seconds\": 1907.2522170089978,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  },\n  \"conclusions\": [],\n  \"costs\": {\n    \"agent_calls\": 3,\n    \"agent_seconds\": 491.152631,\n    \"rejected_calls\": 0,\n    \"rejected_call_seconds\": 0,\n    \"formal_executions\": 0,\n    \"formal_execution_seconds\": 0,\n    \"target_action_cost\": {\n      \"known_seconds\": 0,\n      \"unrecorded_check_ids\": [],\n      \"process_unrecorded_check_ids\": []\n    },\n    \"elapsed_seconds\": 492.74778299100217,\n    \"interpretation\": \"formal_execution_seconds is controlled target process time (checks and explorations); target_action_cost includes preparation only where recorded. Parent actions and child steps are not added together. Rejected calls may contain useful investigation; wall time is not token cost\"\n  },\n  \"map_handoffs\": [],\n  \"handoffs\": [\n    {\n      \"operation_id\": \"62d14b6128e34d3594daf78bc66aab6c\",\n      \"action\": \"research\",\n      \"candidate_ids\": [],\n      \"answered_preview\": \"Initial source-backed backbone: A1 uses a leader-owned commitment object created per leadership tenure, configured voter match indexes, monotone match updates, majority order statistic and the current-term startIndex restriction. Local Stor…\",\n      \"ref_ids\": [\n        \"M-election\",\n        \"M-vote\",\n        \"M-elect-send\",\n        \"M-leader\",\n        \"M-commit\",\n        \"M-apply\",\n        \"M-follower\",\n        \"M-send\",\n        \"M-reply\",\n        \"M-update\",\n        \"M-consume\",\n        \"M-fsm\",\n        \"M-restart\",\n        \"M-install\",\n        \"M-verify\",\n        \"M-lease\",\n        \"M-notify\",\n        \"M-heartbeat\",\n        \"M-verify-vote\",\n        \"M-verify-api\",\n        \"M-suffrage\"\n      ],\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"selections\",\n        \"match\": {\n          \"operation_id\": \"62d14b6128e34d3594daf78bc66aab6c\"\n        }\n      },\n      \"feedback\": {\n        \"ref_ids\": [\n          \"M-election\",\n          \"M-vote\",\n          \"M-elect-send\",\n          \"M-leader\",\n          \"M-commit\",\n          \"M-apply\",\n          \"M-follower\",\n          \"M-send\",\n          \"M-reply\",\n          \"M-update\",\n          \"M-consume\",\n          \"M-fsm\",\n          \"M-restart\",\n          \"M-install\",\n          \"M-verify\",\n          \"M-lease\",\n          \"M-notify\",\n          \"M-heartbeat\",\n          \"M-verify-vote\",\n          \"M-verify-api\",\n          \"M-suffrage\"\n        ],\n        \"answered\": \"Initial source-backed backbone: A1 uses a leader-owned commitment object created per leadership tenure, configured voter match indexes, monotone match updates, majority order statistic and the current-term startIndex restriction. Local StoreLogs success and successful AppendEntries replies establish match support. Main-loop commit notification advances commitIndex and sends committed commands through processLogs to the asynchronous FSM consumer; follower append processing propagates the leader commit index. A2 obtains authority through voter-only requests, per-election response channels, majority tally, persistent term/vote and last-log freshness checks. Higher-term requests or replies and insufficient recent voter contact cause loss of leadership. Leadership cleanup stops replication and fails still-inflight operations; replicators retain the old commitment object and stepDown channel, while the next tenure creates new ones. Membership changes wait for the previous configuration and a current-term entry to commit, then change voter eligibility immediately on append; matching retained voter IDs preserve their indexes. Restart reloads term, last log, snapshot and configuration history. Snapshot install waits for FSM restore before replacing snapshot/applied/configuration context. These are implementation observations, not proof of preservation across every path. Two concrete discrepancies warrant retention: follower appendEntries limits propagated commitment by getLastIndex rather than the end of the request-validated prefix, whereas setNewLogs bounds each batch independently of LeaderCommitIndex; and verifyLeader registers its future with every replication worker although quorumSize counts voters. notifyAll passes anonymous success booleans to verifyFuture.vote without a suffrage check. The latter differs from commitment and leader-lease filtering.\",\n        \"remaining\": [\n          \"Complete a usable AuditSpec map with direct producer/consumer relationships and sourced surfaces; leadership transfer, snapshot sending/compaction, transport ordering and client completion boundaries still need representative supporting reads before declaring core readiness.\",\n          \"Follower prefix question: determine whether a permitted election/retry history can deliver a bounded batch wholly within the shared prefix while the recipient retains a divergent uncommitted suffix and LeaderCommitIndex extends beyond that batch. Source request construction and retry scheduling may constrain this. FSM.Apply promises majority-committed entries, but no execution or legal witness has yet established a discrepancy.\",\n          \"Verification eligibility question: determine whether successful nonvoter responses can complete VerifyLeader after another voter majority acquires authority, before the old leader lease check steps down. The explicit lease filter and normal term propagation are counterevidence requiring timing and legal-history analysis. The API promises a leadership check useful against stale FSM reads; suffrage documentation explicitly addresses election and commitment, so verification applicability requires a composed explanation rather than an assumed identical quorum contract.\",\n          \"Storage-error surface: follower appendEntries explicitly notes stale last-log metadata after truncation followed by StoreLogs failure. Fault-contract applicability, subsequent recovery and consequences remain unread; retain without assuming a defect.\"\n        ],\n        \"understanding\": \"updated\",\n        \"rationale\": \"Preserve initial acquired mechanisms and specific discrepancies before selecting a principal Fact. No Candidate, obligation, execution result or complete-map readiness is asserted.\",\n        \"question_updates\": {}\n      }\n    }\n  ],\n  \"pending_work\": [\n    {\n      \"id\": \"324bee1b720648a6af48200af143e19a\",\n      \"kind\": \"candidate\",\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"question_candidates\",\n        \"match\": {\n          \"id\": \"324bee1b720648a6af48200af143e19a\"\n        }\n      }\n    }\n  ],\n  \"current\": {\n    \"phase\": \"executed\",\n    \"operation_id\": \"c9b90256572541038c4b6ffda0cd9000\",\n    \"action\": \"continue\"\n  },\n  \"latest_decision\": {\n    \"operation_id\": \"c9b90256572541038c4b6ffda0cd9000\",\n    \"action\": \"continue\",\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"selections\",\n      \"match\": {\n        \"operation_id\": \"c9b90256572541038c4b6ffda0cd9000\"\n      }\n    }\n  },\n  \"stop\": {},\n  \"stop_reason\": \"Not started\",\n  \"explorations\": [],\n  \"review_issues\": [],\n  \"run_id\": \"213c8068eec74675868f6d69ce1af9d8\",\n  \"snapshot_id\": \"028c8d82c6e34b3ebfe7a23a76856bae\",\n  \"elapsed_seconds\": 492.74778299100217,\n  \"source_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/agent-source\",\n  \"draft_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/draft\",\n  \"state_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/state.json\",\n  \"product_schemas\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/product-schemas.json\",\n  \"submission_schema\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/submission.schema.json\",\n  \"method_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/audit-method.md\",\n  \"build_inputs\": [],\n  \"directed_question\": null,\n  \"tools\": {\n    \"agent\": \"codex-cli 0.155.0-alpha.16\",\n    \"implementation\": \"go version go1.23.5 linux/amd64\"\n  },\n  \"implementation\": {\n    \"name\": \"go_module\",\n    \"harness_kind\": \"go_test\",\n    \"default_execution_package\": \".\",\n    \"harness_filename\": \"assurance_generated_test.go\",\n    \"instructions\": \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\",\n    \"support_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run/target-support\"\n  },\n  \"validation\": {\n    \"command\": [\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python\",\n      \"-I\",\n      \"-B\",\n      \"-c\",\n      \"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\",\n      \"validate\",\n      \"--run\",\n      \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-22-21-hashicorp_raft-real-run\",\n      \"--submission\"\n    ],\n    \"read_only_paths\": [\n      \"/home/nitro/Desktop/consensus-assurance/src\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/lib/python3.10/site-packages\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/pyvenv.cfg\"\n    ]\n  },\n  \"rejected_drafts\": [],\n  \"records\": {\n    \"path\": \"state.json\",\n    \"keys\": {\n      \"materials\": \"id\",\n      \"checks\": \"id\",\n      \"semantic_reviews\": \"id\",\n      \"selections\": \"operation_id\"\n    },\n    \"paths_relative_to\": \"research.json directory\"\n  },\n  \"review_contracts\": [],\n  \"review_questions\": {}\n}","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/references/experiments.md; sed -n '1,230p' ../agent-source/inmem_transport.go; grep -n -A60 'type ReloadableConfig' ../agent-source/config.go; grep -n 'LeaderLeaseTimeout\\\\|HeartbeatTimeout' ../agent-source/config.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/guide.md /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/resources/skills/evidence-review/references/experiments.md; sed -n '1,230p' ../agent-source/inmem_transport.go; grep -n -A60 'type ReloadableConfig' ../agent-source/config.go; grep -n 'LeaderLeaseTimeout\\\\|HeartbeatTimeout' ../agent-source/config.go\"","aggregated_output":"SEMANTIC REVIEW Use the supplied contract against fixed inputs, source dependencies and observations. One checker_correspondence review covers requirement versus encoded predicate, entry/caller duties, oracle, identity, legal history, observation path/completion and counterevidence. Use experiments.md for these criteria, including wait/cleanup ownership and finite progress observations; unexamined continuation triggers remain gaps under the stated scheduling assumptions. Applicability and decomposition need separate answers only for concrete issues. No issue found is provisional, not proof or an independent vote.\n\nCURRENT VERSION Cite unchanged established parts and focus on the increment: what changed, which premise it answers, what the new execution observed and what remains unanswered. Verify that the fixed entry, prefix and schedule still exercise the original discriminator: stronger setup must not exclude the investigated premise. A narrower scope cannot settle its parent; substantive changes use the existing revision rules. New inputs require fresh execution and correspondence; old review success cannot certify them. Scope/cause/consequence questions outside the checked proposition are independent limits, not additional confirmation gates. Never alter a requirement or weaken a predicate merely to obtain a passing test.\n\nISSUES Fixed Claim, Harness and Monitor conflicts have exact issue/condition records. Address the listed issue with a sourced resolution and, where supplied, condition dispositions; do not answer the same conflict separately in several products. A no_issue_found item alone clears nothing. Preserve current counterevidence as an open issue, explained alternatives in rationale and independent limits in limitations. Resolution applies to its answering version and descendants; it does not legalize an older driver. Shared semantic issues follow actual dependencies, not checker names.\n\nREPAIR Distinguish review aspect from challenged component. F4 repairs unreached experiment prerequisites. Ordinary technical repair preserves shared property descriptions, events, identities, predicates and legality; it needs no preliminary review or encoding refactor unless an actual dispute/change requires one. Tool, parser and framework failures are not semantic feedback. Executed harness changes require a new artifact, fresh execution and current correspondence. Driver/configuration/initialization repairs name repair_issue_ids, preserve the requirement and oracle, and replace only sourced current premises. Changed observation/oracle encoding uses explicit correction; changed normative meaning/applicability uses F2, and proposition-preserving dependency expansion uses F3. Resolve against the actual changed component, never an unrelated edit. If additional source evidence answers the issue without changing inputs, resolve on that executed version instead of manufacturing a harness rewrite. Remaining issues and the current version's missing correspondence stay visible independently.\nEXECUTION Observe actual implementation effects under explicit inputs, caller policy and authorized isolation. Contract applicability may remain unresolved during exploration; execution permission may not. A changed value or tests_passed is not a violation oracle. Exploration remains construction knowledge: a later requirement needs a separately fixed check, fresh execution and correspondence review, not retroactive relabelling. Missing capability, compilation failure, timeout, panic and a completed property comparison remain distinct. Retain failures; never precompute expected observations or alter protocol behavior to create a finding.\n\nCOMPLETION Initialization, driver compliance and observation validity belong in prerequisites, controls or diagnostics, not duplicate properties. Check a wait's return or record actual attainment when it establishes a necessary premise; when waiting is the investigated behavior, requiring success would discard the failure history. Sleep establishes elapsed time, not synchronization, completion or a coherent snapshot; a printed readiness flag is not a prerequisite witness. A diagnostic control need not satisfy the principal scenario's premises or acquire a separate obligation: select formal applicability from independently declared input/policy fields before execution, retaining control output. Distinct formal scenarios need their actual admission and premises; incompatible histories may need separate checks. Never select scenarios by observed results or missing premises after execution. Role readiness does not imply that earlier work drained. Across preparation, policy changes and delivery, preserve caller/transport duties; prefer one policy-selected delivery path and record the identity, provenance and order needed for attribution. Distinguish receipt, per-message-type queueing and dispatch; preserve the replaced layer's ordering without assuming global FIFO or arbitrary reordering. Legal in-flight work need not be emptied. End controlled work independently of the forbidden behavior. Observe admission, completion and final state for the same operation before treating absence as bounded holds. Missing completion, identity, result events and tool timeout remain unknown. A finite window records non-completion, not a deadline violation or infinite stalling. A repeatable suffix must account for behavior-determining state, schedule, queues, timers and callbacks; equal business fields do not close execution. A rescue stimulus may itself be required caller work.\n\nCORRELATION Monitor.admission_alias selects the declared prerequisite admitting operations whose completion is owed, not the first array entry. Harness.prerequisites contains prerequisites only; monitors select independent results. During construction, compare ObservableProperty.identity_fields with the actual prerequisite and result events together. Shared setup may support multiple operations through explicit plan relationships; neither duplicate identical events mechanically nor rely on controller-supplied identity. Do not repeat results as prerequisites or each identity equality as a Comparison. References declare predecessor relationships; unrelated prerequisites have no implicit order. Assertions may use any declared alias actually preceding the result. Missing identity/reference fields or nonunique associations remain unknown. Independent applicability precedes unrelated history requirements; alias-dependent applicability follows correlation. Match operations separately. A complete violating witness survives missing results in demonstrably independent operations with partial coverage; same-witness ambiguity or potentially global parse loss blocks attribution. Process success, observed differences and complete correlation are separate facts. Associate input and output by independent identity, not compared values or a context expected to change. Unsupported temporal expressions remain an explicit limitation.\n\nMEANING Distinguish the written obligation, the proposition encoded by applicability/trigger/antecedent/assertion, and what this execution actually compared. Type, count or numeric-position equality may be necessary without establishing content or identity equality. Record comparisons and scope limits separately. Identify live object, copy, cache or caller-maintained observations, their writers and the synchronization or ownership boundary supporting the read; multiple fields must represent the state the proposition needs. Include ownership of injection flags, counters and sampling itself. An export discrepancy need not mean active protocol state changed. Match observation to the claim: stopping may change the behavior; neither shutdown sampling, locks, public APIs, dual reads nor race detection are universally required. Challenge specific unreliable reads, not all concurrent checks. Keep unresolved contracts, counterevidence, input legality and observation differences explicit; CheckRun owns execution status. An implementation/requirement discrepancy is the subject, not a conflict between requirement sources. Real contradictions remain conflicts.\n\nCONFIRMATION Reconstruct decisive relationships from the fixed test, actual constructors/producers and raw events; the plan's legality account is a claim to verify. Check prepared state, substituted calls and identity/context/generation across stages; constructible inputs or isolated fragments do not establish one legal history. Preserve relevant queues, callbacks, lock ownership and caller/transport duties. For waiting, missing replies or retained resources, trace waiter, result/cancel/close producer, normal shutdown entry and the observation's shutdown phase. Verify which owner/caller actually performs cleanup: no local timeout does not prove permanent waiting, and an available Close method does not prove it ran. A direct post-stop handler call differs from production dispatch still reaching it. Sourced local interface or exit duties need no whole-deployment proof. Review oracle, parsing, reached premises and completion together. Use rationale, source_ids, counterevidence, challenged_components and exact ReviewIssues for discrepancies; choose driver repair, encoding or F2/F3 by what changes, never weaken the written responsibility to rescue confirmation. Incompatible inputs are attribution gaps. Local functions, injectable storage, bounded initialization and substitute schedules remain valid when the sourced proposition permits them. Preserve measurements while correspondence is pending; complete local counterexamples survive independent wider-history or endpoint limits. New source counterevidence may challenge prior confirmation; an unobserved wider endpoint remains a limit.\nNECESSITY For S implies E, compare S when independently established E is false, or use equivalent supported implication encoding; never strengthen to S equals E or filter the result through applicability. In a complete implication comparison, observed S=false retains holds but supports only that S did not occur here, not E or universal consistency; S=true actually tests E. Missing results, identity or prerequisites are not observed falsity and cannot supply holds. Do not require every conditional branch to execute before confirming a complete local counterexample, or infer eventual success from a permitted pending control.\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"sync\"\n\t\"time\"\n)\n\n// NewInmemAddr returns a new in-memory addr with\n// a randomly generate UUID as the ID.\nfunc NewInmemAddr() ServerAddress {\n\treturn ServerAddress(generateUUID())\n}\n\n// inmemPipeline is used to pipeline requests for the in-mem transport.\ntype inmemPipeline struct {\n\ttrans    *InmemTransport\n\tpeer     *InmemTransport\n\tpeerAddr ServerAddress\n\n\tdoneCh       chan AppendFuture\n\tinprogressCh chan *inmemPipelineInflight\n\n\tshutdown     bool\n\tshutdownCh   chan struct{}\n\tshutdownLock sync.RWMutex\n}\n\ntype inmemPipelineInflight struct {\n\tfuture *appendFuture\n\trespCh <-chan RPCResponse\n}\n\n// InmemTransport Implements the Transport interface, to allow Raft to be\n// tested in-memory without going over a network.\ntype InmemTransport struct {\n\tsync.RWMutex\n\tconsumerCh chan RPC\n\tlocalAddr  ServerAddress\n\tpeers      map[ServerAddress]*InmemTransport\n\tpipelines  []*inmemPipeline\n\ttimeout    time.Duration\n}\n\n// NewInmemTransportWithTimeout is used to initialize a new transport and\n// generates a random local address if none is specified. The given timeout\n// will be used to decide how long to wait for a connected peer to process the\n// RPCs that we're sending it. See also Connect() and Consumer().\nfunc NewInmemTransportWithTimeout(addr ServerAddress, timeout time.Duration) (ServerAddress, *InmemTransport) {\n\tif string(addr) == \"\" {\n\t\taddr = NewInmemAddr()\n\t}\n\ttrans := &InmemTransport{\n\t\tconsumerCh: make(chan RPC, 16),\n\t\tlocalAddr:  addr,\n\t\tpeers:      make(map[ServerAddress]*InmemTransport),\n\t\ttimeout:    timeout,\n\t}\n\treturn addr, trans\n}\n\n// NewInmemTransport is used to initialize a new transport\n// and generates a random local address if none is specified\nfunc NewInmemTransport(addr ServerAddress) (ServerAddress, *InmemTransport) {\n\treturn NewInmemTransportWithTimeout(addr, 500*time.Millisecond)\n}\n\n// SetHeartbeatHandler is used to set optional fast-path for\n// heartbeats, not supported for this transport.\nfunc (i *InmemTransport) SetHeartbeatHandler(cb func(RPC)) {\n}\n\n// Consumer implements the Transport interface.\nfunc (i *InmemTransport) Consumer() <-chan RPC {\n\treturn i.consumerCh\n}\n\n// LocalAddr implements the Transport interface.\nfunc (i *InmemTransport) LocalAddr() ServerAddress {\n\treturn i.localAddr\n}\n\n// AppendEntriesPipeline returns an interface that can be used to pipeline\n// AppendEntries requests.\nfunc (i *InmemTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {\n\ti.Lock()\n\tdefer i.Unlock()\n\n\tpeer, ok := i.peers[target]\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"failed to connect to peer: %v\", target)\n\t}\n\tpipeline := newInmemPipeline(i, peer, target)\n\ti.pipelines = append(i.pipelines, pipeline)\n\treturn pipeline, nil\n}\n\n// AppendEntries implements the Transport interface.\nfunc (i *InmemTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*AppendEntriesResponse)\n\t*resp = *out\n\treturn nil\n}\n\n// RequestVote implements the Transport interface.\nfunc (i *InmemTransport) RequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*RequestVoteResponse)\n\t*resp = *out\n\treturn nil\n}\n\nfunc (i *InmemTransport) RequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*RequestPreVoteResponse)\n\t*resp = *out\n\treturn nil\n}\n\n// InstallSnapshot implements the Transport interface.\nfunc (i *InmemTransport) InstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error {\n\trpcResp, err := i.makeRPC(target, args, data, 10*i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*InstallSnapshotResponse)\n\t*resp = *out\n\treturn nil\n}\n\n// TimeoutNow implements the Transport interface.\nfunc (i *InmemTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, 10*i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*TimeoutNowResponse)\n\t*resp = *out\n\treturn nil\n}\n\nfunc (i *InmemTransport) makeRPC(target ServerAddress, args interface{}, r io.Reader, timeout time.Duration) (rpcResp RPCResponse, err error) {\n\ti.RLock()\n\tpeer, ok := i.peers[target]\n\ti.RUnlock()\n\n\tif !ok {\n\t\terr = fmt.Errorf(\"failed to connect to peer: %v\", target)\n\t\treturn\n\t}\n\n\t// Send the RPC over\n\trespCh := make(chan RPCResponse, 1)\n\treq := RPC{\n\t\tCommand:  args,\n\t\tReader:   r,\n\t\tRespChan: respCh,\n\t}\n\tselect {\n\tcase peer.consumerCh <- req:\n\tcase <-time.After(timeout):\n\t\terr = fmt.Errorf(\"send timed out\")\n\t\treturn\n\t}\n\n\t// Wait for a response\n\tselect {\n\tcase rpcResp = <-respCh:\n\t\tif rpcResp.Error != nil {\n\t\t\terr = rpcResp.Error\n\t\t}\n\tcase <-time.After(timeout):\n\t\terr = fmt.Errorf(\"command timed out\")\n\t}\n\treturn\n}\n\n// EncodePeer implements the Transport interface.\nfunc (i *InmemTransport) EncodePeer(id ServerID, p ServerAddress) []byte {\n\treturn []byte(p)\n}\n\n// DecodePeer implements the Transport interface.\nfunc (i *InmemTransport) DecodePeer(buf []byte) ServerAddress {\n\treturn ServerAddress(buf)\n}\n\n// Connect is used to connect this transport to another transport for\n// a given peer name. This allows for local routing.\nfunc (i *InmemTransport) Connect(peer ServerAddress, t Transport) {\n\ttrans := t.(*InmemTransport)\n\ti.Lock()\n\tdefer i.Unlock()\n\ti.peers[peer] = trans\n}\n\n// Disconnect is used to remove the ability to route to a given peer.\nfunc (i *InmemTransport) Disconnect(peer ServerAddress) {\n\ti.Lock()\n\tdefer i.Unlock()\n\tdelete(i.peers, peer)\n\n\t// Disconnect any pipelines\n\tn := len(i.pipelines)\n\tfor idx := 0; idx < n; idx++ {\n\t\tif i.pipelines[idx].peerAddr == peer {\n267:type ReloadableConfig struct {\n268-\t// TrailingLogs controls how many logs we leave after a snapshot. This is used\n269-\t// so that we can quickly replay logs on a follower instead of being forced to\n270-\t// send an entire snapshot. The value passed here updates the setting at runtime\n271-\t// which will take effect as soon as the next snapshot completes and truncation\n272-\t// occurs.\n273-\tTrailingLogs uint64\n274-\n275-\t// SnapshotInterval controls how often we check if we should perform a snapshot.\n276-\t// We randomly stagger between this value and 2x this value to avoid the entire\n277-\t// cluster from performing a snapshot at once.\n278-\tSnapshotInterval time.Duration\n279-\n280-\t// SnapshotThreshold controls how many outstanding logs there must be before\n281-\t// we perform a snapshot. This is to prevent excessive snapshots when we can\n282-\t// just replay a small set of logs.\n283-\tSnapshotThreshold uint64\n284-\n285-\t// HeartbeatTimeout specifies the time in follower state without\n286-\t// a leader before we attempt an election.\n287-\tHeartbeatTimeout time.Duration\n288-\n289-\t// ElectionTimeout specifies the time in candidate state without\n290-\t// a leader before we attempt an election.\n291-\tElectionTimeout time.Duration\n292-}\n293-\n294-// apply sets the reloadable fields on the passed Config to the values in\n295-// `ReloadableConfig`. It returns a copy of Config with the fields from this\n296-// ReloadableConfig set.\n297-func (rc *ReloadableConfig) apply(to Config) Config {\n298-\tto.TrailingLogs = rc.TrailingLogs\n299-\tto.SnapshotInterval = rc.SnapshotInterval\n300-\tto.SnapshotThreshold = rc.SnapshotThreshold\n301-\tto.HeartbeatTimeout = rc.HeartbeatTimeout\n302-\tto.ElectionTimeout = rc.ElectionTimeout\n303-\treturn to\n304-}\n305-\n306-// fromConfig copies the reloadable fields from the passed Config.\n307-func (rc *ReloadableConfig) fromConfig(from Config) {\n308-\trc.TrailingLogs = from.TrailingLogs\n309-\trc.SnapshotInterval = from.SnapshotInterval\n310-\trc.SnapshotThreshold = from.SnapshotThreshold\n311-\trc.HeartbeatTimeout = from.HeartbeatTimeout\n312-\trc.ElectionTimeout = from.ElectionTimeout\n313-}\n314-\n315-// DefaultConfig returns a Config with usable defaults.\n316-func DefaultConfig() *Config {\n317-\treturn &Config{\n318-\t\tProtocolVersion:    ProtocolVersionMax,\n319-\t\tHeartbeatTimeout:   1000 * time.Millisecond,\n320-\t\tElectionTimeout:    1000 * time.Millisecond,\n321-\t\tCommitTimeout:      50 * time.Millisecond,\n322-\t\tMaxAppendEntries:   64,\n323-\t\tShutdownOnRemove:   true,\n324-\t\tTrailingLogs:       10240,\n325-\t\tSnapshotInterval:   120 * time.Second,\n326-\t\tSnapshotThreshold:  8192,\n327-\t\tLeaderLeaseTimeout: 500 * time.Millisecond,\n149:\t// HeartbeatTimeout specifies the time in follower state without contact\n151:\tHeartbeatTimeout time.Duration\n201:\t// LeaderLeaseTimeout is used to control how long the \"lease\" lasts\n205:\tLeaderLeaseTimeout time.Duration\n285:\t// HeartbeatTimeout specifies the time in follower state without\n287:\tHeartbeatTimeout time.Duration\n301:\tto.HeartbeatTimeout = rc.HeartbeatTimeout\n311:\trc.HeartbeatTimeout = from.HeartbeatTimeout\n319:\t\tHeartbeatTimeout:   1000 * time.Millisecond,\n327:\t\tLeaderLeaseTimeout: 500 * time.Millisecond,\n348:\tif config.HeartbeatTimeout < 5*time.Millisecond {\n349:\t\treturn fmt.Errorf(\"HeartbeatTimeout is too low\")\n366:\tif config.LeaderLeaseTimeout < 5*time.Millisecond {\n367:\t\treturn fmt.Errorf(\"LeaderLeaseTimeout is too low\")\n369:\tif config.LeaderLeaseTimeout > config.HeartbeatTimeout {\n370:\t\treturn fmt.Errorf(\"LeaderLeaseTimeout (%s) cannot be larger than heartbeat timeout (%s)\", config.LeaderLeaseTimeout, config.HeartbeatTimeout)\n372:\tif config.ElectionTimeout < config.HeartbeatTimeout {\n373:\t\treturn fmt.Errorf(\"ElectionTimeout (%s) must be equal or greater than Heartbeat Timeout (%s)\", config.ElectionTimeout, config.HeartbeatTimeout)\n","exit_code":0,"status":"completed"}}
