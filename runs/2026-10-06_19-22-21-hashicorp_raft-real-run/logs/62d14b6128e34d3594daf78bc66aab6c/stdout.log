d.(type) {\n\tcase *AppendEntriesRequest:\n\t\tr.appendEntries(rpc, cmd)\n\tcase *RequestVoteRequest:\n\t\tr.requestVote(rpc, cmd)\n\tcase *RequestPreVoteRequest:\n\t\tr.requestPreVote(rpc, cmd)\n\tcase *InstallSnapshotRequest:\n\t\tr.installSnapshot(rpc, cmd)\n\tcase *TimeoutNowRequest:\n\t\tr.timeoutNow(rpc, cmd)\n\tdefault:\n\t\tr.logger.Error(\"got unexpected command\",\n\t\t\t\"command\", hclog.Fmt(\"%#v\", rpc.Command))\n\n\t\trpc.Respond(nil, fmt.Errorf(rpcUnexpectedCommandError))\n\t}\n}\n\n// processHeartbeat is a special handler used just for heartbeat requests\n// so that they can be fast-pathed if a transport supports it. This must only\n// be called from the main thread.\nfunc (r *Raft) processHeartbeat(rpc RPC) {\n\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"processHeartbeat\"}, time.Now())\n\n\t// Check if we are shutdown, just ignore the RPC\n\tselect {\n\tcase <-r.shutdownCh:\n\t\treturn\n\tdefault:\n\t}\n\n\t// Ensure we are only handling a heartbeat\n\tswitch cmd := rpc.Command.(type) {\n\tcase *AppendEntriesRequest:\n\t\tr.appendEntries(rpc, cmd)\n\tdefault:\n\t\tr.logger.Error(\"expected heartbeat, got\", \"command\", hclog.Fmt(\"%#v\", rpc.Command))\n\t\trpc.Respond(nil, fmt.Errorf(\"unexpected command\"))\n\t}\n}\n\n// appendEntries is invoked when we get an append entries RPC call. This must\n// only be called from the main thread.\nfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport \"fmt\"\n\n// ServerSuffrage determines whether a Server in a Configuration gets a vote.\ntype ServerSuffrage int\n\n// Note: Don't renumber these, since the numbers are written into the log.\nconst (\n\t// Voter is a server whose vote is counted in elections and whose match index\n\t// is used in advancing the leader's commit index.\n\tVoter ServerSuffrage = iota\n\t// Nonvoter is a server that receives log entries but is not considered for\n\t// elections or commitment purposes.\n\tNonvoter\n\t// Staging is a server that acts like a Nonvoter. A configuration change\n\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n\t// into a Voter.\n\t// Deprecated: use Nonvoter instead.\n\tStaging\n)\n\nfunc (s ServerSuffrage) String() string {\n\tswitch s {\n\tcase Voter:\n\t\treturn \"Voter\"\n\tcase Nonvoter:\n\t\treturn \"Nonvoter\"\n\tcase Staging:\n\t\treturn \"Staging\"\n\t}\n\treturn \"ServerSuffrage\"\n}\n\n// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n// to store configuration updates made in the replicated log. In general this is only\n// necessary for FSMs that mutate durable state directly instead of applying changes\n// in memory and snapshotting periodically. By storing configuration changes, the\n// persistent FSM state can behave as a complete snapshot, and be able to recover\n// without an external snapshot just for persisting the raft configuration.\ntype ConfigurationStore interface {\n\t// ConfigurationStore is a superset of the FSM functionality\n\tFSM\n\n\t// StoreConfiguration is invoked once a log entry containing a configuration\n\t// change is committed. It takes the index at which the configuration was\n\t// written and the configuration value.\n\tStoreConfiguration(index uint64, configuration Configuration)\n}\n\ntype nopConfigurationStore struct{}\n\nfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n\n// ServerID is a unique string identifying a server for all time.\ntype ServerID string\n\n// ServerAddress is a network address for a server that a transport can contact.\ntype ServerAddress string\n\n// Server tracks the information about a single server in a configuration.\ntype Server struct {\n\t// Suffrage determines whether the server gets a vote.\n\tSuffrage ServerSuffrage\n\t// ID is a unique string identifying this server for all time.\n\tID ServerID\n\t// Address is its network address that a transport can contact.\n\tAddress ServerAddress\n}\n\n// Configuration tracks which servers are in the cluster, and whether they have\n// votes. This should include the local server, if it's a member of the cluster.\n// The servers are listed no particular order, but each should only appear once.\n// These entries are appended to the log during membership changes.\ntype Configuration struct {\n\tServers []Server\n}\n\n// Clone makes a deep copy of a Configuration.\nfunc (c *Configuration) Clone() (copy Configuration) {\n\tcopy.Servers = append(copy.Servers, c.Servers...)\n\treturn\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nsources=[]\ndef s(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k))\ns('M-election','raft.go',285,440)\ns('M-vote','raft.go',1603,1735)\ns('M-elect-send','raft.go',1976,2049)\ns('M-leader','raft.go',455,665)\ns('M-commit','commitment.go',11,112)\ns('M-apply','raft.go',1203,1388)\ns('M-follower','raft.go',1440,1600)\ns('M-send','replication.go',570,631)\ns('M-reply','replication.go',202,297)\ns('M-update','replication.go',646,667)\ns('M-consume','fsm.go',15,43,'interface_statement')\ns('M-fsm','fsm.go',84,160)\ns('M-restart','api.go',500,707)\ns('M-install','raft.go',1814,1953)\ns('M-verify','raft.go',965,987)\ns('M-lease','raft.go',1036,1095)\ns('M-notify','replication.go',98,111)\ns('M-heartbeat','replication.go',388,442)\ns('M-verify-vote','future.go',274,293)\ns('M-verify-api','api.go',880,894,'interface_statement')\ns('M-suffrage','configuration.go',7,23,'interface_statement')\nfeedback={\n 'ref_ids':[x['id'] for x in sources],\n 'answered':'Initial source-backed backbone: A1 uses a leader-owned commitment object created per leadership tenure, configured voter match indexes, monotone match updates, majority order statistic and the current-term startIndex restriction. Local StoreLogs success and successful AppendEntries replies establish match support. Main-loop commit notification advances commitIndex and sends committed commands through processLogs to the asynchronous FSM consumer; follower append processing propagates the leader commit index. A2 obtains authority through voter-only requests, per-election response channels, majority tally, persistent term/vote and last-log freshness checks. Higher-term requests or replies and insufficient recent voter contact cause loss of leadership. Leadership cleanup stops replication and fails still-inflight operations; replicators retain the old commitment object and stepDown channel, while the next tenure creates new ones. Membership changes wait for the previous configuration and a current-term entry to commit, then change voter eligibility immediately on append; matching retained voter IDs preserve their indexes. Restart reloads term, last log, snapshot and configuration history. Snapshot install waits for FSM restore before replacing snapshot/applied/configuration context. These are implementation observations, not proof of preservation across every path. Two concrete discrepancies warrant retention: follower appendEntries limits propagated commitment by getLastIndex rather than the end of the request-validated prefix, whereas setNewLogs bounds each batch independently of LeaderCommitIndex; and verifyLeader registers its future with every replication worker although quorumSize counts voters. notifyAll passes anonymous success booleans to verifyFuture.vote without a suffrage check. The latter differs from commitment and leader-lease filtering.',\n 'remaining':[\n 'Complete a usable AuditSpec map with direct producer/consumer relationships and sourced surfaces; leadership transfer, snapshot sending/compaction, transport ordering and client completion boundaries still need representative supporting reads before declaring core readiness.',\n 'Follower prefix question: determine whether a permitted election/retry history can deliver a bounded batch wholly within the shared prefix while the recipient retains a divergent uncommitted suffix and LeaderCommitIndex extends beyond that batch. Source request construction and retry scheduling may constrain this. FSM.Apply promises majority-committed entries, but no execution or legal witness has yet established a discrepancy.',\n 'Verification eligibility question: determine whether successful nonvoter responses can complete VerifyLeader after another voter majority acquires authority, before the old leader lease check steps down. The explicit lease filter and normal term propagation are counterevidence requiring timing and legal-history analysis. The API promises a leadership check useful against stale FSM reads; suffrage documentation explicitly addresses election and commitment, so verification applicability requires a composed explanation rather than an assumed identical quorum contract.',\n 'Storage-error surface: follower appendEntries explicitly notes stale last-log metadata after truncation followed by StoreLogs failure. Fault-contract applicability, subsequent recovery and consequences remain unread; retain without assuming a defect.'\n ],\n 'understanding':'updated',\n 'rationale':'Preserve initial acquired mechanisms and specific discrepancies before selecting a principal Fact. No Candidate, obligation, execution result or complete-map readiness is asserted.'\n}\njson.dump(dict(action='research',rationale='Retain first-run source investigation and two sourced discriminators while completing the required two-core map.',sources=sources,feedback=feedback),open('submission.json','w'),indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
