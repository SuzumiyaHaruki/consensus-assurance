age': 'after_three_heartbeat_rounds', 'state': 'StateLeader', 'term': 1}\n44 {'commit': 1, 'context_hex': '726561642d32', 'event': 'request', 'operation': 2, 'scenario': 'nonempty', 'term': 1}\n49 {'commit': 1, 'event': 'sample', 'operation': 1, 'outputs': [{'context_hex': '726561642d31', 'index': 1, 'position': 0}, {'context_hex': '726561642d32', 'index': 1, 'position': 1}], 'pending_contexts_hex': [], 'scenario': 'nonempty', 'stage': 'after_fresh_request_drain', 'state': 'StateLeader', 'term': 1}\nInterpretationUpdate {\"additionalProperties\": false, \"properties\": {\"investigation_id\": {\"title\": \"Investigation Id\", \"type\": \"string\"}, \"experiment_id\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Experiment Id\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"executions\": {\"additionalProperties\": {\"items\": {\"type\": \"integer\"}, \"type\": \"array\"}, \"default\": {}, \"title\": \"Executions\", \"type\": \"object\"}, \"conclusion\": {\"enum\": [\"explained\", \"conditional\", \"violated\", \"holds\", \"unresolved\"], \"title\": \"Conclusion\", \"type\": \"string\"}, \"rationale\": {\"minLength\": 1, \"title\": \"Rationale\", \"type\": \"string\"}, \"answers\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Registered gap ID to its explicit sourced or observed answer\", \"title\": \"Answers\", \"type\": \"object\"}, \"knowledge\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/KnowledgeUse\"}, \"title\": \"Knowledge\", \"type\": \"array\"}, \"counterevidence\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Counterevidence\", \"type\": \"array\"}, \"limitations\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Limitations\", \"type\": \"array\"}, \"joint_history\": {\"default\": \"\", \"description\": \"Explain compatibility when associating a separate producer experiment\", \"title\": \"Joint History\", \"type\": \"string\"}, \"failure_attribution\": {\"anyOf\": [{\"$ref\": \"#/$defs/FailureAttribution\"}, {\"type\": \"null\"}], \"default\": null}, \"report_title\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Report Title\"}, \"report_answer\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Report Answer\"}}, \"required\": [\"investigation_id\", \"source_ids\", \"conclusion\", \"rationale\"], \"title\": \"InterpretationUpdate\", \"type\": \"object\"}\nKnowledgeUpdate {\"additionalProperties\": false, \"properties\": {\"id\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Id\"}, \"ref\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Ref\"}, \"kind\": {\"enum\": [\"behavior\", \"fact\"], \"title\": \"Kind\", \"type\": \"string\"}, \"statement\": {\"minLength\": 1, \"title\": \"Statement\", \"type\": \"string\"}, \"conditions\": {\"minLength\": 1, \"title\": \"Conditions\", \"type\": \"string\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"executions\": {\"additionalProperties\": {\"items\": {\"type\": \"integer\"}, \"type\": \"array\"}, \"default\": {}, \"title\": \"Executions\", \"type\": \"object\"}, \"changed_premise\": {\"default\": \"\", \"description\": \"For a correction, explain the semantic difference; empty for unrelated or representational changes\", \"title\": \"Changed Premise\", \"type\": \"string\"}, \"affected_uses\": {\"description\": \"Saved investigation, experiment or interpretation IDs using the changed premise; never inferred from similar words\", \"items\": {\"type\": \"string\"}, \"title\": \"Affected Uses\", \"type\": \"array\"}}, \"required\": [\"kind\", \"statement\", \"conditions\", \"source_ids\"], \"title\": \"KnowledgeUpdate\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
