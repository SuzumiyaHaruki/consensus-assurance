{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"cat > read_context_test.go <<'EOF'\npackage raft\n\nimport (\n \\\"encoding/hex\\\"\n \\\"encoding/json\\\"\n \\\"fmt\\\"\n \\\"testing\\\"\n pb \\\"go.etcd.io/raft/v3/raftpb\\\"\n)\n\nfunc TestAssuranceReadContext(t *testing.T) {\n emit := func(v map[string]interface{}) { b, err := json.Marshal(v); if err \"'!= nil { t.Fatal(err) }; fmt.Println(\"CA_EVENT \" + string(b)) }\n for _, scenario := range []string{\"empty\", \"nonempty\"} {\n  n := newNetwork(nil, nil, nil)\n  n.send(pb.Message{From:1, To:1, Type:pb.MsgHup})\n  leader := n.peers[1].(*raft)\n  if leader.state != StateLeader || !leader.committedEntryInCurrentTerm() { t.Fatal(\"election prefix did not establish a committed current-term entry\") }\n  phase := \"initial\"\n  n.msgHook = func(m pb.Message) bool {\n   if m.Type == pb.MsgHeartbeat || m.Type == pb.MsgHeartbeatResp {\n    emit(map[string]interface{}{\"event\":\"wire\", \"scenario\":scenario, \"phase\":phase, \"type\":m.Type.String(), \"from\":m.From, \"to\":m.To, \"term\":m.Term, \"context_hex\":hex.EncodeToString(m.Context)})\n   }\n   return true\n  }\n  ctx := []byte{}\n  if scenario == \"nonempty\" { ctx = []byte(\"read-1\") }\n  emit(map[string]interface{}{\"event\":\"request\", \"scenario\":scenario, \"operation\":1, \"context_hex\":hex.EncodeToString(ctx), \"term\":leader.Term, \"commit\":leader.raftLog.committed, \"state\":leader.state.String()})\n  n.send(pb.Message{From:1, To:1, Type:pb.MsgReadIndex, Entries:[]pb.Entry{{Data:ctx}}})\n  snapshot := func(stage string) {\n   outputs := []map[string]interface{}{}\n   for i, rs := range leader.readStates { outputs = append(outputs, map[string]interface{}{\"position\":i,\"index\":rs.Index,\"context_hex\":hex.EncodeToString(rs.RequestCtx)}) }\n   queue := []string{}\n   for _, k := range leader.readOnly.readIndexQueue { queue = append(queue, hex.EncodeToString([]byte(k))) }\n   emit(map[string]interface{}{\"event\":\"sample\", \"scenario\":scenario, \"stage\":stage, \"operation\":1, \"term\":leader.Term, \"commit\":leader.raftLog.committed, \"state\":leader.state.String(), \"outputs\":outputs, \"pending_contexts_hex\":queue})\n  }\n  snapshot(\"after_request_drain\")\n  phase = \"heartbeats\"\n  for i:=0; i<3; i++ { n.send(pb.Message{From:1,To:1,Type:pb.MsgBeat}) }\n  snapshot(\"after_three_heartbeat_rounds\")\n  phase = \"fresh_request\"\n  fresh := []byte(\"read-2\")\n  emit(map[string]interface{}{\"event\":\"request\", \"scenario\":scenario, \"operation\":2, \"context_hex\":hex.EncodeToString(fresh), \"term\":leader.Term,\"commit\":leader.raftLog.committed})\n  n.send(pb.Message{From:1,To:1,Type:pb.MsgReadIndex,Entries:[]pb.Entry{{Data:fresh}}})\n  snapshot(\"after_fresh_request_drain\")\n }\n}\nEOF\npython3 - <<'\"'PY'\nimport json\nsources=[('read-api','node.go',218,229,'interface_statement'),('read-admission','raft.go',1346,1364,'code_observation'),('read-ack','raft.go',1571,1607,'code_observation'),('read-queue','read_only.go',52,120,'code_observation'),('read-producer','raft.go',2142,2160,'code_observation'),('heartbeat-context','raft.go',721,737,'code_observation'),('heartbeat-reply','raft.go',1830,1833,'code_observation'),('test-transport','raft_test.go',3934,4013,'code_observation'),('test-append-completion','raft_test.go',58,93,'code_observation')]\ns={'rationale':'Probe the sourced empty-context read acknowledgment discrepancy with a real election and a fresh-context control, preserving the documented request-loss and retry qualification rather than asserting a universal completion guarantee.', 'sources':[dict(id=i,file=f,start_line=a,end_line=b,kind=k) for i,f,a,b,k in sources], 'investigations':[{'ref':'@read-context','question':'Does an empty ReadIndex context prevent completion in a healthy stable multi-voter leader, and what does the documented fresh-context retry obligation imply for defect applicability?', 'source_ids':[x[0] for x in sources], 'hypothesis':'The leader queues an empty context and broadcasts it, but skips every resulting empty-context heartbeat acknowledgment. A subsequent nonempty request may release the earlier queued request.', 'discriminator':'Compare independent empty and nonempty contexts after identical elected-leader prefixes, inspect heartbeat contexts and readStates after message drain and three complete heartbeat rounds, then submit a fresh unique request. Investigate whether the API permits the initial context and whether its explicit loss/retry qualification defeats the candidate liveness claim.', 'counterevidence':['Node.ReadIndex explicitly permits request loss without notice and requires retries with fresh contexts. Queue advancement can release earlier pending requests when a later request obtains a quorum.'], 'limitations':['No unconditional bounded completion requirement has been established. No state-machine read or stale value is claimed.']}], 'experiment':{'investigation_id':'@read-context','harness_path':'read_context_test.go','source_ids':[x[0] for x in sources], 'scope':{'description':'Synchronous three-instance Raft test-network read-context probe with no dropped messages and no crashes.', 'assumptions':['Initial voter membership is supplied by the existing newNetwork(nil,nil,nil) test constructor.','The existing test transport simulates completion of append dependencies without persisting durable bytes; the probe makes no crash-recovery claim.','Single-threaded ownership provides coherent observations of internal readStates, term, commit and pending queue.'], 'excluded':['FSM read execution','Recovery and storage failures','A universal read completion bound'], 'parameters':{'voters':3,'heartbeat_rounds':3,'contexts':['empty','read-1'],'fresh_context':'read-2'}}, 'prefix':'Create three new Raft instances with the existing test constructor and empty logs; deliver a local campaign and all resulting actual election/append messages. Require leader state and a committed current-term entry before issuing the first read. Deliver all messages without filtering. Observe output in sequence independently of returned context. Send three local heartbeat triggers with full delivery, then a second unique nonempty read request. Repeat the same schedule in an independent network with a nonempty initial context.'}}\nopen('read_context_update.json','w').write(json.dumps(s,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
