interfaces.\ntype assuranceBatchingFSM struct{ assuranceFSM }\n\nfunc (f *assuranceBatchingFSM) ApplyBatch(logs []*Log) []interface{} {\n\tout := make([]interface{}, len(logs))\n\tfor _, l := range logs {\n\t\tf.rec.record(\"apply\", l)\n\t}\n\treturn out\n","exit_code":0,"status":"completed"}}
