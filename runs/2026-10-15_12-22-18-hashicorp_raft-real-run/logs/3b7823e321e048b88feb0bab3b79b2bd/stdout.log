",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"barrier\\\"},{\\\"field\\\":\\\"batch_apply_ch\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":False}],\n    \\\"description\\\":\\\"Barrier with the default unbuffered applyCh: every post-shutdown call answered, the contrast that the batched case is measured against.\\\"},\n   {\\\"event\\\":\\\"assurance_shutdown_result\\\",\\\"identity_fields\\\":[\\\"trial\\\",\\\"kind\\\"],\\\"admission_alias\\\":\\\"setup\\\",\n    \\\"assertion\\\":{\\\"field\\\":\\\"post_responded\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n    \\\"applicability_conditions\\\":[{\\\"field\\\":\\\"shutdown\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},{\\\"field\\\":\\\"kind\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"apply\\\"},{\\\"field\\\":\\\"batch_apply_ch\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":False}],\n    \\\"description\\\":\\\"Apply with the default unbuffered applyCh: same contrast.\\\"},\n   {\\\"event\\\":\\\"assurance_shutdown_result\\\",\\\"identity_fields\\\":[\\\"trial\\\",\\\"kind\\\"],\\\"admission_alias\\\":\\\"setup\\\",\n    \\\"assertion\\\":{\\\"field\\\":\\\"post_responded\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":False},\n    \\\"applicability_conditions\\\":[{\\\"field\\\":\\\"shutdown\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},{\\\"field\\\":\\\"kind\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"verify\\\"}],\n    \\\"description\\\":\\\"VerifyLeader, whose channel is always buffered: the strand re-measured in the same run as the new cases.\\\"}]}}\njson.dump(d,open('update.json','w'),indent=2,ensure_ascii=False); open('update.json','a').write('\\\\n')\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run --submission update.json 2>&1 | tail -2\"","aggregat