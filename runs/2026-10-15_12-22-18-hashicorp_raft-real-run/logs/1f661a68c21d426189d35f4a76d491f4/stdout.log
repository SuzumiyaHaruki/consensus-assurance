{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\nold=\\\"\t// Sample leadership continuously from the partition onwards.\\\"\nnew='''\tassuranceEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":          \\\"assurance_stall_setup\\\",\n\t\t\\\"trial\\\":          trial,\n\t\t\\\"leader_id\\\":      string(leader.id),\n\t\t\\\"nonvoter_id\\\":    string(nv.id),\n\t\t\\\"voter_count\\\":    voterCount,\n\t\t\\\"nonvoter_count\\\": nonvoterCount,\n\t\t\\\"quorum_size\\\":    quorum,\n\t\t\\\"stall_delay_ms\\\": leader.slow.delay.Milliseconds(),\n\t\t\\\"heartbeat_ms\\\":   leader.raft.config().HeartbeatTimeout.Milliseconds(),\n\t\t\\\"lease_ms\\\":       leader.raft.config().LeaderLeaseTimeout.Milliseconds(),\n\t})\n\n\t// Sample leadership continuously from the partition onwards.'''\nassert old in s\ns=s.replace(old,new,1)\nopen(p,'w').write(s)\nPY\ngofmt -w assurance_generated_test.go && cp assurance_generated_test.go tmp/probe/ && cd tmp/probe && go vet . && echo VET_OK\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
