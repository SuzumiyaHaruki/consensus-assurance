{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\n# distinct identity for batched cases: offset the trial id\ns=s.replace('''\tfor trial := 0; trial < 3; trial++ {\n\t\tassuranceRunShutdownTrial(t, trial, \\\"barrier\\\", true, true)\n\t\tassuranceRunShutdownTrial(t, trial, \\\"apply\\\", true, true)\n\t}''','''\tfor trial := 0; trial < 3; trial++ {\n\t\tassuranceRunShutdownTrial(t, 100+trial, \\\"barrier\\\", true, true)\n\t\tassuranceRunShutdownTrial(t, 100+trial, \\\"apply\\\", true, true)\n\t}''')\n# record the flag on the setup event too\nold='''\t\t\\\"post_calls\\\": postCalls,\n\t\t\\\"local_id\\\":  string(r.localID),'''\nnew='''\t\t\\\"post_calls\\\":     postCalls,\n\t\t\\\"batch_apply_ch\\\": batched,\n\t\t\\\"local_id\\\":       string(r.localID),'''\nif old in s:\n    s=s.replace(old,new,1)\nelse:\n    import re\n    s=s.replace('\\\"post_calls\\\": postCalls,','\\\"post_calls\\\": postCalls,\\\\n\\\\t\\\\t\\\"batch_apply_ch\\\": batched,',1)\nopen(p,'w').write(s)\nPY\ngofmt -w assurance_generated_test.go && grep -n \\\"batch_apply_ch\\\" assurance_generated_test.go | head && cp assurance_generated_test.go tmp/probe/ && cd tmp/probe && go vet . && echo VET_OK\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
