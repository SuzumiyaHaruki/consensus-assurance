}\n15 {'trial': 2, 'kind': 'barrier', 'shutdown': True, 'calls': 64, 'returned': 64, 'stuck': 0, 'any_stuck': False, 'shutdown_error': '', 'node_state': 'shutdown', 'outcomes': {'leadership lost while committing log': 1, 'nil': 63}}\n17 {'trial': 2, 'kind': 'apply', 'shutdown': True, 'calls': 64, 'returned': 64, 'stuck': 0, 'any_stuck': False, 'shutdown_error': '', 'node_state': 'shutdown', 'outcomes': {'nil': 64}}\n19 {'trial': 99, 'kind': 'verify', 'shutdown': False, 'calls': 64, 'returned': 64, 'stuck': 0, 'any_stuck': False, 'shutdown_error': '', 'node_state': 'running', 'outcomes': {'nil': 64}}\n21 {'trial': 99, 'kind': 'barrier', 'shutdown': False, 'calls': 64, 'returned': 64, 'stuck': 0, 'any_stuck': False, 'shutdown_error': '', 'node_state': 'running', 'outcomes': {'nil': 64}}\n23 {'trial': 99, 'kind': 'apply', 'shutdown': False, 'calls': 64, 'returned': 64, 'stuck': 0, 'any_stuck': False, 'shutdown_error': '', 'node_state': 'running', 'outcomes': {'nil': 64}}\n","exit_code":0,"status":"completed"}}
