{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run/draft && cp ../fixed-experiments/29a71a7377a44fdbac949d4808f7b847-experiment/assurance_generated_test.go assurance_generated_test.go && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\ns=s.replace(\\\"func TestAssuranceVerifyRegisteredThenStalled(t *testing.T) {\\\",\\\"func TestAssuranceVerifyRegisteredThenStalled(t *testing.T) {\\\\n\\\\tif true {\\\\n\\\\t\\\\tassuranceRunStaleReadTrials(t)\\\\n\\\\t\\\\treturn\\\\n\\\\t}\\\")\nhelper='''\n// assuranceValues returns the FSM-visible values applied by a node, most recent last.\nfunc assuranceValues(n *assuranceProbeNode) []string {\n\tout := []string{}\n\tfor _, raw := range getMockFSM(n.raft.fsm).Logs() {\n\t\tout = append(out, string(raw))\n\t}\n\treturn out\n}\n\nfunc assuranceLastValue(n *assuranceProbeNode) string {\n\tvals := assuranceValues(n)\n\tif len(vals) == 0 {\n\t\treturn \\\"<none>\\\"\n\t}\n\treturn vals[len(vals)-1]\n}\n\n// assuranceRunStaleReadTrials shows the consequence end to end: commit a value,\n// partition the leader, let a successor commit a different value, then read the\n// stalled leader's own FSM after its VerifyLeader returned success.\nfunc assuranceRunStaleReadTrials(t *testing.T) {\n\tfor _, reconnectAfterMs := range []int{300, 350, 400, 450, 500} {\n\t\tassuranceRunStaleReadTrial(t, reconnectAfterMs)\n\t}\n}\n\nfunc assuranceRunStaleReadTrial(t *testing.T, reconnectAfterMs int) {\n\tvar voters Configuration\n\tvar nodes []*assuranceProbeNode\n\tfor i := 0; i < 3; i++ {\n\t\tn := assuranceNewNode()\n\t\tnodes = append(nodes, n)\n\t\tvoters.Servers = append(voters.Servers, Server{Suffrage: Voter, ID: n.id, Address: n.addr})\n\t}\n\tnv := assuranceNewNode()\n\tnodes = append(nodes, nv)\n\tfor _, a := range nodes {\n\t\tfor _, b := range nodes {\n\t\t\tif a \"'!= b {\n\t\t\t\tassuranceConnect(a, b)\n\t\t\t}\n\t\t}\n\t}\n\tfor _, n := range nodes[:3] {\n\t\tassuranceStartNode(t, n, &voters, true)\n\t}\n\tassuranceStartNode(t, nv, nil, false)\n\tdefer func() {\n\t\tfor _, n := range nodes {\n\t\t\t_ = n.raft.Shutdown().Error()\n\t\t\t_ = n.trans.Close()\n\t\t}\n\t}()\n\n\tleader := assuranceWaitLeader(t, nodes[:3], 10*time.Second)\n\tif err := leader.raft.AddNonvoter(nv.id, nv.addr, 0, 5*time.Second).Error(); err != nil {\n\t\tt.Fatalf(\"AddNonvoter failed: %v\", err)\n\t}\n\tdeadline := time.Now().Add(5 * time.Second)\n\tfor time.Now().Before(deadline) && !assuranceHasServer(leader.raft.getLatestConfiguration(), nv.id) {\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\ttime.Sleep(200 * time.Millisecond)\n\n\t// Commit a value everywhere before the partition.\n\tif err := leader.raft.Apply([]byte(\"old\"), 5*time.Second).Error(); err != nil {\n\t\tt.Fatalf(\"apply old: %v\", err)\n\t}\n\ttime.Sleep(200 * time.Millisecond)\n\n\tlatest := leader.raft.getLatestConfiguration()\n\tvoterCount := 0\n\tfor _, s := range latest.Servers {\n\t\tif s.Suffrage == Voter {\n\t\t\tvoterCount++\n\t\t}\n\t}\n\tquorum := voterCount/2 + 1\n\tleaderTermBefore := leader.raft.getCurrentTerm()\n\n\tassuranceEmit(t, map[string]interface{}{\n\t\t\"event\":              \"assurance_stale_read_setup\",\n\t\t\"reconnect_after_ms\": reconnectAfterMs,\n\t\t\"leader_id\":          string(leader.id),\n\t\t\"nonvoter_id\":        string(nv.id),\n\t\t\"voter_count\":        voterCount,\n\t\t\"quorum_size\":        quorum,\n\t\t\"leader_value\":       assuranceLastValue(leader),\n\t\t\"lease_ms\":           leader.raft.config().LeaderLeaseTimeout.Milliseconds(),\n\t\t\"stall_delay_ms\":     leader.slow.delay.Milliseconds(),\n\t})\n\n\t// Partition the leader from both other voters and from the non-voter.\n\tfor _, n := range nodes[:3] {\n\t\tif n != leader {\n\t\t\tassuranceDisconnect(leader, n)\n\t\t\tassuranceDisconnect(nv, n)\n\t\t}\n\t}\n\tassuranceDisconnect(leader, nv)\n\n\tstartAt := time.Now()\n\tverify := leader.raft.VerifyLeader()\n\ttime.Sleep(30 * time.Millisecond)\n\tatomic.StoreInt32(leader.slow.armed, 1)\n\t_ = leader.raft.Apply([]byte(\"blocked\"), 5*time.Second)\n\n\t// Let a successor take over and commit a different value.\n\tvar successor *assuranceProbeNode\n\tdeadline = time.Now().Add(2 * time.Second)\n\tfor time.Now().Before(deadline) {\n\t\tfor _, n := range nodes[:3] {\n\t\t\tif n != leader && n.raft.State() == Leader {\n\t\t\t\tsuccessor = n\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif successor != nil {\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\tsuccessorValue := \"<no successor>\"\n\tsuccessorTerm := uint64(0)\n\tif successor != nil {\n\t\tsuccessorTerm = successor.raft.getCurrentTerm()\n\t\tif err := successor.raft.Apply([]byte(\"new\"), 5*time.Second).Error(); err == nil {\n\t\t\ttime.Sleep(100 * time.Millisecond)\n\t\t\tsuccessorValue = assuranceLastValue(successor)\n\t\t} else {\n\t\t\tsuccessorValue = \"<apply failed>\"\n\t\t}\n\t}\n\n\t// Give the stalled leader the non-voter'\"'s acknowledgement.\n\ttime.Sleep(time.Duration(reconnectAfterMs) * time.Millisecond)\n\tassuranceConnect(leader, nv)\n\n\tverifyDone := make(chan error, 1)\n\tgo func() { verifyDone <- verify.Error() }()\n\tverifyErr := \\\"pending\\\"\n\tselect {\n\tcase err := <-verifyDone:\n\t\tif err == nil {\n\t\t\tverifyErr = \\\"nil\\\"\n\t\t} else {\n\t\t\tverifyErr = err.Error()\n\t\t}\n\tcase <-time.After(4 * time.Second):\n\t}\n\n\tleaderValue := assuranceLastValue(leader)\n\tassuranceEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":              \\\"assurance_stale_read_result\\\",\n\t\t\\\"reconnect_after_ms\\\": reconnectAfterMs,\n\t\t\\\"leader_id\\\":          string(leader.id),\n\t\t\\\"verify_error\\\":       verifyErr,\n\t\t\\\"leader_value\\\":       leaderValue,\n\t\t\\\"successor_value\\\":    successorValue,\n\t\t\\\"stale_values_differ\\\": verifyErr == \\\"nil\\\" && leaderValue \"'!= successorValue,\n\t\t\"successor_term\":     successorTerm,\n\t\t\"leader_term_after\":  leader.raft.getCurrentTerm(),\n\t\t\"leader_term_before\": leaderTermBefore,\n\t\t\"leader_state_after\": leader.raft.State().String(),\n\t\t\"stalls_triggered\":   atomic.LoadInt32(leader.slow.stalls),\n\t\t\"elapsed_ms\":         time.Since(startAt).Milliseconds(),\n\t})\n}\n'\"'''\ns=s.rstrip()+\\\"\\\\n\\\"+helper\nopen(p,'w').write(s)\nPY\ngofmt -w assurance_generated_test.go && cp assurance_generated_test.go tmp/probe/ && cd tmp/probe && go vet . 2>&1 | head -5\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
