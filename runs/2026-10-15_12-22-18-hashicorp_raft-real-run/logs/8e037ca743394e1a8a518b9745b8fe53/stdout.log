er.raft.LeadershipTransferToServer(target.id, target.addr)\n200:\ttransferErr := \"pending\"\n201:\tdone := make(chan error, 1)\n202:\tgo func() { done <- future.Error() }()\n203:\tselect {\n204:\tcase err := <-done:\n205:\t\tif err == nil {\n206:\t\t\ttransferErr = \"nil\"\n207:\t\t} else {\n208:\t\t\ttransferErr = err.Error()\n209:\t\t}\n210:\tcase <-time.After(5 * time.Second):\n211:\t}\n212:\treturnedAt := time.Now()\n213:\n214:\t// Wait up to 1500ms for the requested target, and separately for any\n215:\t// leader, recording both without filtering on the transfer result.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\n\ns=s.replace('import (\\\\n\\\\t\\\"encoding/json\\\"\\\\n\\\\t\\\"testing\\\"','import (\\\\n\\\\t\\\"encoding/json\\\"\\\\n\\\\t\\\"sync\\\"\\\\n\\\\t\\\"testing\\\"',1)\n\nold=\\\"\tfuture := leader.raft.LeadershipTransferToServer(target.id, target.addr)\\\\n\ttransferErr := \\\\\\\"pending\\\\\\\"\\\"\nnew='''\tcallAt := time.Now()\n\tfuture := leader.raft.LeadershipTransferToServer(target.id, target.addr)\n\n\t// Sample leadership continuously while the transfer plays out, so a\n\t// leaderless interval is observed rather than inferred from endpoints.\n\tvar (\n\t\tsamplesMu            sync.Mutex\n\t\tsampledTotal         int\n\t\tleaderlessSamples    int\n\t\toldLeaderDownSamples int\n\t\tfirstLeaderlessMs    int64 = -1\n\t\tlastLeaderlessMs     int64\n\t)\n\tstopSampling := make(chan struct{})\n\tgo func() {\n\t\ttick := time.NewTicker(time.Millisecond)\n\t\tdefer tick.Stop()\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase <-stopSampling:\n\t\t\t\treturn\n\t\t\tcase <-tick.C:\n\t\t\t\tids := assuranceLeaderIDs(nodes)\n\t\t\t\tms := time.Since(callAt).Milliseconds()\n\t\t\t\tsamplesMu.Lock()\n\t\t\t\tsampledTotal++\n\t\t\t\tif len(ids) == 0 {\n\t\t\t\t\tleaderlessSamples++\n\t\t\t\t\tif firstLeaderlessMs < 0 {\n\t\t\t\t\t\tfirstLeaderlessMs = ms\n\t\t\t\t\t}\n\t\t\t\t\tlastLeaderlessMs = ms\n\t\t\t\t}\n\t\t\t\tif leader.raft.State() \"'!= Leader {\n\t\t\t\t\toldLeaderDownSamples++\n\t\t\t\t}\n\t\t\t\tsamplesMu.Unlock()\n\t\t\t}\n\t\t}\n\t}()\n\n\ttransferErr := \"pending\"'\"'''\nassert old in s\ns=s.replace(old,new,1)\n\nold2='''\tleaderIDsEndpoint := assuranceLeaderIDs(nodes)\n\tmaxTermAfter := assuranceMaxTerm(nodes)\n'''\nnew2='''\tleaderIDsEndpoint := assuranceLeaderIDs(nodes)\n\tmaxTermAfter := assuranceMaxTerm(nodes)\n\tclose(stopSampling)\n\ttime.Sleep(5 * time.Millisecond)\n\n\tsamplesMu.Lock()\n\tsampled := sampledTotal\n\tleaderless := leaderlessSamples\n\toldLeaderDown := oldLeaderDownSamples\n\tleaderlessFirst := firstLeaderlessMs\n\tleaderlessLast := lastLeaderlessMs\n\tsamplesMu.Unlock()\n'''\nassert old2 in s\ns=s.replace(old2,new2,1)\n\nold3='''\t\t\\\"election_timeout_ms\\\":      leader.raft.config().ElectionTimeout.Milliseconds(),\n\t})'''\nnew3='''\t\t\\\"election_timeout_ms\\\":                 leader.raft.config().ElectionTimeout.Milliseconds(),\n\t\t\\\"sampled_total\\\":                       sampled,\n\t\t\\\"leaderless_samples\\\":                  leaderless,\n\t\t\\\"leaderless_observed\\\":                 leaderless > 0,\n\t\t\\\"leaderless_first_ms\\\":                 leaderlessFirst,\n\t\t\\\"leaderless_last_ms\\\":                  leaderlessLast,\n\t\t\\\"old_leader_down_samples\\\":             oldLeaderDown,\n\t\t\\\"old_leader_lost_leadership_observed\\\": oldLeaderDown > 0,\n\t\t\\\"target_is_leader_at_endpoint\\\":        target.raft.State() == Leader,\n\t})'''\nassert old3 in s\ns=s.replace(old3,new3,1)\nopen(p,'w').write(s)\nPY\ngofmt -l assurance_generated_test.go; mkdir -p tmp/probe && cp -r ../agent-source/. tmp/probe/ && cp assurance_generated_test.go tmp/probe/ && cd tmp/probe && go vet .\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
