{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_12-22-18-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\n# 1) longer window, more calls, interleaved shutdown, post-shutdown control\ns=s.replace('''\tconst calls = 64''','''\tconst calls = 128\n\tconst window = 4 * time.Second\n\tconst postCalls = 8''')\ns=s.replace('''\tassuranceEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":    \\\"assurance_shutdown_setup\\\",\n\t\t\\\"trial\\\":    trial,\n\t\t\\\"kind\\\":     kind,\n\t\t\\\"shutdown\\\": shutdown,\n\t\t\\\"calls\\\":    calls,\n\t\t\\\"local_id\\\": string(r.localID),\n\t})''','''\tassuranceEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":     \\\"assurance_shutdown_setup\\\",\n\t\t\\\"trial\\\":     trial,\n\t\t\\\"kind\\\":      kind,\n\t\t\\\"shutdown\\\":  shutdown,\n\t\t\\\"calls\\\":     calls,\n\t\t\\\"window_ms\\\": window.Milliseconds(),\n\t\t\\\"post_calls\\\": postCalls,\n\t\t\\\"local_id\\\":  string(r.localID),\n\t})''')\ns=s.replace('''\t\t\tcase <-time.After(1500 * time.Millisecond):''','''\t\t\tcase <-time.After(window):''')\ns=s.replace('''\tvar shutdownErr string\n\tshutdownDone := make(chan struct{})\n\tif shutdown {\n\t\tgo func() {\n\t\t\tif err := r.Shutdown().Error(); err \"'!= nil {\n\t\t\t\tshutdownErr = err.Error()\n\t\t\t}\n\t\t\tclose(shutdownDone)\n\t\t}()\n\t} else {\n\t\tclose(shutdownDone)\n\t}\n\n\t<-shutdownDone\n\tif shutdown {\n\t\t// Give every future a generous window after shutdown has returned.\n\t\ttime.Sleep(400 * time.Millisecond)\n\t}\n\twg.Wait()'\"''','''\t// Let the callers fill the channel, then shut down underneath them.\n\tvar shutdownErr string\n\tshutdownDone := make(chan struct{})\n\tif shutdown {\n\t\tgo func() {\n\t\t\ttime.Sleep(2 * time.Millisecond)\n\t\t\tif err := r.Shutdown().Error(); err \"'!= nil {\n\t\t\t\tshutdownErr = err.Error()\n\t\t\t}\n\t\t\tclose(shutdownDone)\n\t\t}()\n\t} else {\n\t\tclose(shutdownDone)\n\t}\n\n\t<-shutdownDone\n\n\t// Calls that arrive after shutdown has returned are a separate question:\n\t// the documented answer for them is an immediate error.\n\tpostReturned := 0\n\tpostOutcomes := map[string]int{}\n\tif shutdown {\n\t\tfor i := 0; i < postCalls; i++ {\n\t\t\tf := assuranceCall(r, kind)\n\t\t\tdone := make(chan error, 1)\n\t\t\tgo func() { done <- f.Error() }()\n\t\t\tselect {\n\t\t\tcase err := <-done:\n\t\t\t\tpostReturned++\n\t\t\t\tif err == nil {\n\t\t\t\t\tpostOutcomes[\"nil\"]++\n\t\t\t\t} else {\n\t\t\t\t\tpostOutcomes[err.Error()]++\n\t\t\t\t}\n\t\t\tcase <-time.After(500 * time.Millisecond):\n\t\t\t\tpostOutcomes[\"stuck\"]++\n\t\t\t}\n\t\t}\n\t}\n\n\twg.Wait()'\"''')\ns=s.replace('''\tstate := \\\"running\\\"''','''\tstate := \\\"running\\\"''')\ns=s.replace('''\t\t\\\"outcomes\\\":       detail,\n\t})''','''\t\t\\\"outcomes\\\":       detail,\n\t\t\\\"window_ms\\\":      window.Milliseconds(),\n\t\t\\\"post_returned\\\":  postReturned,\n\t\t\\\"post_calls\\\":     postCalls,\n\t\t\\\"post_responded\\\": postReturned == postCalls,\n\t\t\\\"post_outcomes\\\":  postOutcomes,\n\t})''')\ns=s.replace('''\tkinds := []string{\\\"verify\\\", \\\"barrier\\\", \\\"apply\\\"}\n\tfor trial := 0; trial < 3; trial++ {''','''\tkinds := []string{\\\"verify\\\", \\\"barrier\\\", \\\"apply\\\"}\n\tfor trial := 0; trial < 3; trial++ {''')\nopen(p,'w').write(s)\nPY\ngofmt -w assurance_generated_test.go && cp assurance_generated_test.go tmp/probe/ && cd tmp/probe && go vet . && echo VET_OK && timeout 300 go test -v -run TestAssuranceShutdownFutureCompletion -count=1 . 2>&1 | grep CA_EVENT | python3 -c \\\"\nimport sys,json\nfor line in sys.stdin:\n    d=json.loads(line.split('CA_EVENT ',1)[1])\n    if d.get('event')=='assurance_shutdown_result':\n        print({k:d.get(k) for k in ('trial','kind','shutdown','calls','returned','stuck','post_returned','post_outcomes','outcomes')})\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
