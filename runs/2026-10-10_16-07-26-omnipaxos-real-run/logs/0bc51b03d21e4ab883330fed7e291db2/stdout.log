n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"source_ids\"\n      ],\n      \"title\": \"UnderstandingChange\",\n      \"type\": \"object\"\n    },\n    \"UnitDraft\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"candidate_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Candidate Id\"\n        },\n        \"audit_question\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/AuditQuestion\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"obligation_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"maxItems\": 1,\n          \"minItems\": 1,\n          \"title\": \"Obligation Ids\",\n          \"type\": \"array\"\n        },\n        \"binding_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Binding Ids\",\n          \"type\": \"array\"\n        },\n        \"relation_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Relation Ids\",\n          \"type\": \"array\"\n        },\n        \"scope\": {\n          \"$ref\": \"#/$defs/Scope\"\n        },\n        \"rationale\": {\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"obligation_ids\",\n        \"binding_ids\",\n        \"scope\",\n        \"rationale\"\n      ],\n      \"title\": \"UnitDraft\",\n      \"type\": \"object\"\n    }\n  },\n  \"discriminator\": {\n    \"mapping\": {\n      \"check\": \"#/$defs/CheckSubmission\",\n      \"continue\": \"#/$defs/CandidateSubmission\",\n      \"explained\": \"#/$defs/CandidateSubmission\",\n      \"explore\": \"#/$defs/ExploreSubmission\",\n      \"obligation\": \"#/$defs/CandidateSubmission\",\n      \"pause\": \"#/$defs/CandidateSubmission\",\n      \"research\": \"#/$defs/ResearchSubmission\",\n      \"revise_check\": \"#/$defs/CheckSubmission\",\n      \"stop\": \"#/$defs/StopSubmission\"\n    },\n    \"propertyName\": \"action\"\n  },\n  \"oneOf\": [\n    {\n      \"$ref\": \"#/$defs/CandidateSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/CheckSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ResearchSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ExploreSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/StopSubmission\"\n    }\n  ]\n}","exit_code":0,"status":"completed"}}
