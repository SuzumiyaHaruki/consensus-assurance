  \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"sources\": {\n          \"default\": [],\n          \"items\": {\n            \"$ref\": \"#/$defs/SourceRange\"\n          },\n          \"title\": \"Sources\",\n          \"type\": \"array\"\n        },\n        \"feedback\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/ResearchFeedback\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"review\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/ResultReview\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"map_path\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Map Path\"\n        },\n        \"map_changes\": {\n          \"additionalProperties\": {\n            \"$ref\": \"#/$defs/UnderstandingChange\"\n          },\n          \"default\": {},\n          \"title\": \"Map Changes\",\n          \"type\": \"object\"\n        },\n        \"repair_of\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Retained rejected operation whose draft this submission repairs\",\n          \"title\": \"Repair Of\"\n        },\n        \"action\": {\n          \"const\": \"stop\",\n          \"title\": \"Action\",\n          \"type\": \"string\"\n        },\n        \"scope\": {\n          \"enum\": [\n            \"candidate\",\n            \"family\",\n            \"focus\",\n            