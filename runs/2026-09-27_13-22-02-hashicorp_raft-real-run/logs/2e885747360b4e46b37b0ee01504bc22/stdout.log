EntriesPipeline returns an interface that can be used to pipeline\n    88\t// AppendEntries requests.\n    89\tfunc (i *InmemTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {\n    90\t\ti.Lock()\n    91\t\tdefer i.Unlock()\n    92\t\n    93\t\tpeer, ok := i.peers[target]\n    94\t\tif !ok {\n    95\t\t\treturn nil, fmt.Errorf(\"failed to connect to peer: %v\", target)\n    96\t\t}\n    97\t\tpipeline := newInmemPipeline(i, peer, target)\n    98\t\ti.pipelines = append(i.pipelines, pipeline)\n    99\t\treturn pipeline, nil\n   100\t}\n   101\t\n   102\t// AppendEntries implements the Transport interface.\n   103\tfunc (i *InmemTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n   104\t\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n   105\t\tif err != nil {\n   106\t\t\treturn err\n   107\t\t}\n   108\t\n   109\t\t// Copy the result back\n   110\t\tout := rpcResp.Response.(*AppendEntriesResponse)\n   111\t\t*resp = *out\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// RequestVote implements the Transport interface.\n   290\t\t\t\t\tcase <-i.shutdownCh:\n   291\t\t\t\t\t\treturn\n   292\t\t\t\t\t}\n   293\t\n   294\t\t\t\tcase <-timeoutCh:\n   295\t\t\t\t\tinp.future.respond(fmt.Errorf(\"command timed out\"))\n   296\t\t\t\t\tselect {\n   297\t\t\t\t\tcase i.doneCh <- inp.future:\n   298\t\t\t\t\tcase <-i.shutdownCh:\n   299\t\t\t\t\t\treturn\n   300\t\t\t\t\t}\n   301\t\n   302\t\t\t\tcase <-i.shutdownCh:\n   303\t\t\t\t\treturn\n   304\t\t\t\t}\n   305\t\t\tcase <-i.shutdownCh:\n   306\t\t\t\treturn\n   307\t\t\t}\n   308\t\t}\n   309\t}\n   310\t\n   311\tfunc (i *inmemPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n   312\t\t// Create a new future\n   313\t\tfuture := &appendFuture{\n   314\t\t\tstart: time.Now(),\n   315\t\t\targs:  args,\n   316\t\t\tresp:  resp,\n   317\t\t}\n   318\t\tfuture.init()\n   319\t\n   320\t\t// Handle a timeout\n   321\t\tvar timeout <-chan time.Time\n   322\t\tif i.trans.timeout > 0 {\n   323\t\t\ttimeout = time.After(i.trans.timeout)\n   324\t\t}\n   325\t\n   326\t\t// Send the RPC over\n   327\t\trespCh := make(chan RPCResponse, 1)\n   328\t\trpc := RPC{\n   329\t\t\tCommand:  args,\n   330\t\t\tRespChan: respCh,\n   331\t\t}\n   332\t\n   333\t\t// Check if we have been already shutdown, otherwise the random choose\n   334\t\t// made by select statement below might pick consumerCh even if\n   335\t\t// shutdownCh was closed.\n   336\t\ti.shutdownLock.RLock()\n   337\t\tshutdown := i.shutdown\n   338\t\ti.shutdownLock.RUnlock()\n   339\t\tif shutdown {\n   340\t\t\treturn nil, ErrPipelineShutdown\n   341\t\t}\n   342\t\n   343\t\tselect {\n   344\t\tcase i.peer.consumerCh <- rpc:\n   345\t\tcase <-timeout:\n   346\t\t\treturn nil, fmt.Errorf(\"command enqueue timeout\")\n   347\t\tcase <-i.shutdownCh:\n   348\t\t\treturn nil, ErrPipelineShutdown\n   349\t\t}\n   350\t\n   351\t\t// Send to be decoded\n   352\t\tselect {\n   353\t\tcase i.inprogressCh <- &inmemPipelineInflight{future, respCh}:\n   354\t\t\treturn future, nil\n   355\t\tcase <-i.shutdownCh:\n   356\t\t\treturn nil, ErrPipelineShutdown\n   357\t\t}\n   358\t}\n   359\t\n   360\tfunc (i *inmemPipeline) Consumer() <-chan AppendFuture {\n   361\t\treturn i.doneCh\n   362\t}\n   363\t\n   364\tfunc (i *inmemPipeline) Close() error {\n   365\t\ti.shutdownLock.Lock()\n   366\t\tdefer i.shutdownLock.Unlock()\n   367\t\tif i.shutdown {\n   368\t\t\treturn nil\n   369\t\t}\n   370\t\n   371\t\ti.shutdown = true\n   372\t\tclose(i.shutdownCh)\n   373\t\treturn nil\n   374\t}\n   125\t// AppendFuture is used to return information about a pipelined AppendEntries request.\n   126\ttype AppendFuture interface {\n   127\t\tFuture\n   128\t\n   129\t\t// Start returns the time that the append request was started.\n   130\t\t// It is always OK to call this method.\n   131\t\tStart() time.Time\n   132\t\n   133\t\t// Request holds the parameters of the AppendEntries call.\n   134\t\t// It is always OK to call this method.\n   135\t\tRequest() *AppendEntriesRequest\n   136\t\n   137\t\t// Response holds the results of the AppendEntries call.\n   138\t\t// This method must only be called after the Error\n   139\t\t// method returns, and will only be valid on success.\n   140\t\tResponse() *AppendEntriesResponse\n   141\t}\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"ref_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Ref Ids\",\n      \"type\": \"array\"\n    },\n    \"answered\": {\n      \"minLength\": 1,\n      \"title\": \"Answered\",\n      \"type\": \"string\"\n    },\n    \"remaining\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Remaining\",\n      \"type\": \"array\"\n    },\n    \"understanding\": {\n      \"enum\": [\n        \"updated\",\n        \"unchanged\",\n        \"deferred\"\n      ],\n      \"title\": \"Understanding\",\n      \"type\": \"string\"\n    },\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"ref_ids\",\n    \"answered\",\n    \"remaining\",\n    \"understanding\",\n    \"rationale\"\n  ],\n  \"title\": \"ResearchFeedback\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
