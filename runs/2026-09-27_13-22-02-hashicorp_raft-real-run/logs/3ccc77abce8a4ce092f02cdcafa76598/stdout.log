     \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Explicit complete questions for saved Candidates sharing the changed map basis; Unit semantics still require F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"const\": \"research\",\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"graph_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Graph Path\"\n    },\n    \"scope_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Scope Path\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\"\n  ],\n  \"title\": \"ResearchSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
