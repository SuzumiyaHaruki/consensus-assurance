{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/raft.go | sed -n '468,535p;680,700p'; nl -ba ../native-source/replication.go | sed -n '195,210p;305,320p'; nl -ba ../native-source/raft.go | sed -n '1550,1585p'; head -100 ../native-support/assurance_support_test.go\"","aggregated_output":"   468\tfunc (r *Raft) runLeader() {\n   469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n   471\t\n   472\t\t// Notify that we are the leader\n   473\t\toverrideNotifyBool(r.leaderCh, true)\n   474\t\n   475\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n   476\t\t// defer below runs, but this makes sure we always notify the same chan if\n   477\t\t// ever for both gaining and losing leadership.\n   478\t\tnotify := r.config().NotifyCh\n   479\t\n   480\t\t// Push to the notify channel if given\n   481\t\tif notify != nil {\n   482\t\t\tselect {\n   483\t\t\tcase notify <- true:\n   484\t\t\tcase <-r.shutdownCh:\n   485\t\t\t\t// make sure push to the notify channel ( if given )\n   486\t\t\t\tselect {\n   487\t\t\t\tcase notify <- true:\n   488\t\t\t\tdefault:\n   489\t\t\t\t}\n   490\t\t\t}\n   491\t\t}\n   492\t\n   493\t\t// setup leader state. This is only supposed to be accessed within the\n   494\t\t// leaderloop.\n   495\t\tr.setupLeaderState()\n   496\t\n   497\t\t// Run a background go-routine to emit metrics on log age\n   498\t\tstopCh := make(chan struct{})\n   499\t\tgo emitLogStoreMetrics(r.logs, []string{\"raft\", \"leader\"}, oldestLogGaugeInterval, stopCh)\n   500\t\n   501\t\t// Cleanup state on step down\n   502\t\tdefer func() {\n   503\t\t\tclose(stopCh)\n   504\t\n   505\t\t\t// Since we were the leader previously, we update our\n   506\t\t\t// last contact time when we step down, so that we are not\n   507\t\t\t// reporting a last contact time from before we were the\n   508\t\t\t// leader. Otherwise, to a client it would seem our data\n   509\t\t\t// is extremely stale.\n   510\t\t\tr.setLastContact()\n   511\t\n   512\t\t\t// Stop replication\n   513\t\t\tfor _, p := range r.leaderState.replState {\n   514\t\t\t\tclose(p.stopCh)\n   515\t\t\t}\n   516\t\n   517\t\t\t// Respond to all inflight operations\n   518\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   519\t\t\t\te.Value.(*logFuture).respond(ErrLeadershipLost)\n   520\t\t\t}\n   521\t\n   522\t\t\t// Respond to any pending verify requests\n   523\t\t\tfor future := range r.leaderState.notify {\n   524\t\t\t\tfuture.respond(ErrLeadershipLost)\n   525\t\t\t}\n   526\t\n   527\t\t\t// Clear all the state\n   528\t\t\tr.leaderState.commitCh = nil\n   529\t\t\tr.leaderState.commitment = nil\n   530\t\t\tr.leaderState.inflight = nil\n   531\t\t\tr.leaderState.replState = nil\n   532\t\t\tr.leaderState.notify = nil\n   533\t\t\tr.leaderState.stepDown = nil\n   534\t\n   535\t\t\t// If we are stepping down for some reason, no known leader.\n   680\t\t\tr.mainThreadSaturation.sleeping()\n   681\t\n   682\t\t\tselect {\n   683\t\t\tcase rpc := <-r.rpcCh:\n   684\t\t\t\tr.mainThreadSaturation.working()\n   685\t\t\t\tr.processRPC(rpc)\n   686\t\n   687\t\t\tcase <-r.leaderState.stepDown:\n   688\t\t\t\tr.mainThreadSaturation.working()\n   689\t\t\t\tr.setState(Follower)\n   690\t\n   691\t\t\tcase future := <-r.leadershipTransferCh:\n   692\t\t\t\tr.mainThreadSaturation.working()\n   693\t\t\t\tif r.getLeadershipTransferInProgress() {\n   694\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   695\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   696\t\t\t\t\tcontinue\n   697\t\t\t\t}\n   698\t\n   699\t\t\t\tr.logger.Debug(\"starting leadership transfer\", \"id\", future.ID, \"address\", future.Address)\n   700\t\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   201\t// If the follower log is behind, we take care to bring them up to date.\n   202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n   203\t\t// Create the base request\n   204\t\tvar req AppendEntriesRequest\n   205\t\tvar resp AppendEntriesResponse\n   206\t\tvar start time.Time\n   207\t\tvar peer Server\n   208\t\n   209\tSTART:\n   210\t\t// Prevent an excessive retry rate on errors\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer snapshot.Close()\n  1550\t\t\t\t\t\t\t\"index\", newEntry.Index,\n  1551\t\t\t\t\t\t\t\"error\", err)\n  1552\t\t\t\t\t\trpcErr = err\n  1553\t\t\t\t\t\treturn\n  1554\t\t\t\t\t}\n  1555\t\t\t\t}\n  1556\t\n  1557\t\t\t\t// Update the lastLog\n  1558\t\t\t\tlast := newEntries[n-1]\n  1559\t\t\t\tr.setLastLog(last.Index, last.Term)\n  1560\t\t\t}\n  1561\t\n  1562\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"storeLogs\"}, start)\n  1563\t\t}\n  1564\t\n  1565\t\t// Update the commit index\n  1566\t\tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n  1567\t\t\tstart := time.Now()\n  1568\t\t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n  1569\t\t\tr.setCommitIndex(idx)\n  1570\t\t\tif r.configurations.latestIndex <= idx {\n  1571\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1572\t\t\t}\n  1573\t\t\tr.processLogs(idx, nil)\n  1574\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n  1575\t\t}\n  1576\t\n  1577\t\t// Everything went well, set success\n  1578\t\tresp.Success = true\n  1579\t\tr.setLastContact()\n  1580\t}\n  1581\t\n  1582\t// processConfigurationLogEntry takes a log entry and updates the latest\n  1583\t// configuration if the entry results in a new configuration. This must only be\n  1584\t// called from the main thread, or from NewRaft() before any threads have begun.\n  1585\tfunc (r *Raft) processConfigurationLogEntry(entry *Log) error {\npackage raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\n// AssuranceMessage identifies one actual RPC and its delivery boundary.\n// Payload records actual input/output; callers supply their own discriminator.\ntype AssuranceMessage struct {\n\tID       uint64 `json:\"message_id\"`\n\tSender   string `json:\"sender\"`\n\tReceiver string `json:\"receiver\"`\n\tKind     string `json:\"kind\"`\n\tPhase    string `json:\"event\"`\n\tPayload  string `json:\"payload\"`\n\tError    string `json:\"error,omitempty\"`\n}\n\ntype AssuranceCluster struct {\n\tNodes      []*Raft\n\tTransports []*InmemTransport\n\tdone       chan struct{}\n\tworkers    sync.WaitGroup\n\tsequence   uint64\n\temit       sync.Mutex\n\tgate       func(AssuranceMessage) <-chan struct{}\n}\n\ntype assuranceTransport struct {\n\t*InmemTransport\n\tinbox chan RPC\n}\n\nfunc (t *assuranceTransport) Consumer() <-chan RPC { return t.inbox }\n\nfunc (c *AssuranceCluster) boundary(m AssuranceMessage) bool {\n\tc.emit.Lock()\n\traw, err := json.Marshal(m)\n\tif err != nil {\n\t\tc.emit.Unlock()\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(raw))\n\tc.emit.Unlock()\n\tvar release <-chan struct{}\n\tif c.gate != nil {\n\t\trelease = c.gate(m)\n\t}\n\tif release != nil {\n\t\tselect {\n\t\tcase <-release:\n\t\tcase <-c.done:\n\t\t\treturn false\n\t\t}\n\t}\n\tselect {\n\tcase <-c.done:\n\t\treturn false\n\tdefault:\n\t\treturn true\n\t}\n}\n\nfunc (c *AssuranceCluster) forward(t *assuranceTransport, receiver ServerID, rpc RPC) {\n\tdefer c.workers.Done()\n\tdata, err := json.Marshal(rpc.Command)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tm := AssuranceMessage{ID: atomic.AddUint64(&c.sequence, 1), Receiver: string(receiver),\n\t\tKind: fmt.Sprintf(\"%T\", rpc.Command), Phase: \"request_delivery\", Payload: string(data)}\n\tif h, ok := rpc.Command.(WithRPCHeader); ok {\n\t\tm.Sender = string(h.GetRPCHeader().ID)\n\t}\n\tif !c.boundary(m) {\n\t\treturn\n\t}\n\tresponse := make(chan RPCResponse, 1)\n\tactual := rpc\n\tactual.RespChan = response\n\tselect {\n\tcase t.inbox <- actual:\n\tcase <-c.done:\n\t\treturn\n\t}\n\tvar result RPCResponse\n\tselect {\n\tcase result = <-response:\n\tcase <-c.done:\n\t\treturn\n\t}\n\tdata, err = json.Marshal(result.Response)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n","exit_code":0,"status":"completed"}}
