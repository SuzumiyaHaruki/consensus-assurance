   \"title\": \"Unit Id\"\n        },\n        \"research_ref\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Accepted Candidate or surface:<entry_point> for pre-obligation history exploration\",\n          \"title\": \"Research Ref\"\n        },\n        \"model_path\": {\n          \"title\": \"Model Path\",\n          \"type\": \"string\"\n        },\n        \"behavior_path\": {\n          \"title\": \"Behavior Path\",\n          \"type\": \"string\"\n        },\n        \"properties_path\": {\n          \"title\": \"Properties Path\",\n          \"type\": \"string\"\n        },\n        \"previous_model_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Previous Model Id\"\n        },\n        \"encoding_revision\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/EncodingRevision\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"model_path\",\n        \"behavior_path\",\n        \"properties_path\"\n      ],\n      \"title\": \"ModelSubmission\",\n      \"type\": \"object\"\n    },\n    \"ReadRequest\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"file\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"File\"\n        },\n        \"start_line\": {\n          \"anyOf\": [\n            {\n          