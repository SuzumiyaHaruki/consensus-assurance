ndaries=['verifyCh connects vote to main thread'])\nbeh('b-stepdown','Raft main thread','Replication worker signals leaderState.stepDown',['src-stale-stepdown','src-stepdown-consume','src-leader-cleanup'],writes=['Set state Follower; leader cleanup closes replication stops and discards state'],external_effects=['Pending verifies receive ErrLeadershipLost during cleanup'],existing_protections=['Independent response-term checks signal this channel'],unknowns=['Schedule and progress bounds of ordinary replication under delayed replies are not established.'])\nroles=json.load(open('../research.json'))['activity_roles']\nacts=[]\nfor a,r in roles.items():\n acts.append(dict(class_id=a,applicability='applicable' if a in ['A2','A4','A7'] else 'unknown',purpose=r['relation'],realization_summary={'A2':'Leader lease consumption and response-driven authority loss are partially mapped.','A4':'Lease eligibility is filtered by latest configuration Voter suffrage; configuration activation is not mapped.','A7':'VerifyLeader promises a leadership check usable to prevent stale FSM reads; application usage is not mapped.'}.get(a,'Outside this initial contact-marker lifecycle map.'),source_ids={'A2':['src-lease','src-heartbeat'],'A4':['src-lease'],'A7':['src-verify-contract']}.get(a,[]),unknowns=['This partial map does not establish activity-wide coverage.']))\nm=dict(version=1,target_profile=dict(system_boundary='Captured Go raft package, scoped to per-peer leader contact bookkeeping, lease checks and alternate role-loss paths.',protocol_contexts=['Local leader term and replication generation; latest voter configuration; remote current term'],external_interfaces=['AppendEntries transport RPC','VerifyLeader Future','LeaderLeaseTimeout configuration'],ownership=['Main thread owns lease decision; heartbeat and replication workers refresh per-peer contact under a mutex.'],variants=['Ordinary replication, independent heartbeat, pipeline responses and snapshot transfer have distinct qualification paths.'],source_ids=['src-contact','src-lease','src-verify-contract'],unknowns=['Transport fault guarantees, startup/election prefix, storage recovery and application consumers have not been established.']),activities=acts,behaviors=bs,facts=[dict(id=F,meaning='For this replication object the marker is a locally sampled time written during initialization or a reached contact-refresh branch. It does not uniformly assert remote agreement with the leader term or successful replication.',identity={'replication_object':'One followerReplication allocation','peer':'s.peer server identity within that allocation'},validity_context='Local leader-state generation. Initialization supplies a grace marker; concurrent RPC completion paths overwrite it. Lease interpretation is relative to current local time and latest configuration.',representation=['followerReplication.lastContact protected by lastContactLock; initialization occurs before publication'],durability='Volatile; no durable authority assertion.',recovery='A fresh replication object receives a fresh marker; crash/restart behavior is not mapped.',source_ids=['src-contact','src-initialize','src-heartbeat','src-append-reply','src-snapshot-reply','src-pipeline-reply','src-lease'],invalidators=['b-stepdown'],unknowns=['Configuration changes may replace or remove peer context; unread branches must be mapped before claiming applicability across membership changes.','Other consumers beyond acquired LastContact call sites are not exhaustively mapped.'])],surfaces=[dict(entry_point='Raft.checkLeaderLease',disposition='mapped',behavior_ids=['b-lease-consume'],reason='Concrete contact-marker consumer for authority retention.',source_ids=['src-lease'],high_consequence=True),dict(entry_point='Raft.startStopReplication membership update/removal branches',disposition='deferred',reason='Only allocation branch acquired; fixed-membership scope proposed.',source_ids=['src-initialize'],high_consequence=True),dict(entry_point='Raft.pro