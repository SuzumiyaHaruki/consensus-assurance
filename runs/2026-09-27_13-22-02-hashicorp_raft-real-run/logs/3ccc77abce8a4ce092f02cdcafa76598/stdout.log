41\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   561\t\t\t\t// Update our replication state\n   562\t\t\t\tupdateLastAppended(s, req)\n   563\t\t\tcase <-stopCh:\n   564\t\t\t\treturn\n   565\t\t\t}\n   566\t\t}\n   567\t}\n   568\t\n   580\t// it'll instruct the replication routines to try to replicate to the current\n   581\t// index. This must only be called from the main thread.\n   582\tfunc (r *Raft) startStopReplication() {\n   583\t\tinConfig := make(map[ServerID]bool, len(r.configurations.latest.Servers))\n   584\t\tlastIdx := r.getLastIndex()\n   585\t\n   586\t\t// Start replication goroutines that need starting\n   587\t\tfor _, server := range r.configurations.latest.Servers {\n   588\t\t\tif server.ID == r.localID {\n   589\t\t\t\tcontinue\n   590\t\t\t}\n   591\t\n   592\t\t\tinConfig[server.ID] = true\n   593\t\n   594\t\t\ts, ok := r.leaderState.replState[server.ID]\n   595\t\t\tif !ok {\n   596\t\t\t\tr.logger.Info(\"added peer, starting replication\", \"peer\", server.ID)\n   597\t\t\t\ts = &followerReplication{\n   598\t\t\t\t\tpeer:                server,\n   599\t\t\t\t\tcommitment:          r.leaderState.commitment,\n   600\t\t\t\t\tstopCh:              make(chan uint64, 1),\n   601\t\t\t\t\ttriggerCh:           make(chan struct{}, 1),\n   602\t\t\t\t\ttriggerDeferErrorCh: make(chan *deferError, 1),\n   603\t\t\t\t\tcurrentTerm:         r.getCurrentTerm(),\n   604\t\t\t\t\tnextIndex:           lastIdx + 1,\n   605\t\t\t\t\tlastContact:         time.Now(),\n   606\t\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n   607\t\t\t\t\tnotifyCh:            make(chan struct{}, 1),\n   608\t\t\t\t\tstepDown:            r.leaderState.stepDown,\n   609\t\t\t\t}\n   610\t\n   611\t\t\t\tr.leaderState.replState[server.ID] = s\n   612\t\t\t\tr.goFunc(func() { r.replicate(s) })\n   613\t\t\t\tasyncNotifyCh(s.triggerCh)\n   614\t\t\t\tr.observe(PeerObservation{Peer: server, Removed: false})\n   615\t\t\t} else if ok {\n   616\t\n   617\t\t\t\ts.peerLock.RLock()\n   618\t\t\t\tpeer := s.peer\n   619\t\t\t\ts.peerLock.RUnlock()\n   620\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"The heartbeat and replication paths treat higher-term replies differently: heartbeats refresh `lastContact` without checking the reply term, while replication checks it first. The lease consumer uses contact recency, and its documented contract is about connectivity. I’ll preserve this as a scoped question while retaining the other step-down mechanisms; the asymmetry alone does not establish a violation."}}
