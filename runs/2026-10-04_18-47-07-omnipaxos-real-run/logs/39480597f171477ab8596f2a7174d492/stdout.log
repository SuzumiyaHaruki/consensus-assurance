{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > storage_check.rs <<'RS'\nuse std::sync::atomic::{AtomicUsize, Ordering};\nuse omnipaxos::{ballot_leader_election::Ballot, storage::{Entry, Snapshot, Storage, StorageOp}};\nuse omnipaxos_storage::persistent_storage::{PersistentStorage, PersistentStorageConfig};\nuse serde::{Serialize, Serializer, Deserialize};\n\nstatic SERIALIZATION_ERRORS: AtomicUsize = AtomicUsize::new(0);\n#[derive(Clone, Debug, PartialEq, Deserialize)]\n#[serde(transparent)]\nstruct Value(u64);\nimpl Serialize for Value {\n    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok,S::Error> {\n        if self.0 == 99 {\n            SERIALIZATION_ERRORS.fetch_add(1,Ordering::SeqCst);\n            Err(serde::ser::Error::custom(\\\"declared entry encoding failure\\\"))\n        } else { serializer.serialize_u64(self.0) }\n    }\n}\n#[derive(Clone,Debug,Serialize,Deserialize)]\nstruct NoSnapshot;\nimpl Snapshot<Value> for NoSnapshot {\n    fn create(_: &[Value]) -> Self { Self }\n    fn merge(&mut self,_:Self) {}\n    fn use_snapshots() -> bool { false }\n}\nimpl Entry for Value { type Snapshot = NoSnapshot; }\n\n#[test]\nfn atomic_error_preserves_extent() {\n    SERIALIZATION_ERRORS.store(0,Ordering::SeqCst);\n    // The runner owns this disposable workspace; no captured database is opened.\n    let directory=tempfile::Builder::new().prefix(\\\"rollback-check-\\\").tempdir_in(\\\".\\\").unwrap();\n    let path=directory.path().join(\\\"db\\\").to_string_lossy().into_owned();\n    let mut storage=PersistentStorage::<Value>::new(PersistentStorageConfig::with_path(path.clone()));\n    storage.append_entry(Value(7)).unwrap();\n    let before_len=storage.get_log_len().unwrap();\n    let before_entries=storage.get_entries(0,before_len).unwrap();\n    let before_promise=storage.get_promise().unwrap();\n    assert_eq\"'!(before_entries,vec![Value(7)]);\n    assert_eq!(before_len,1);\n    assert!(before_promise.is_none());\n    println!(\"CA_EVENT {{'\"\\\\\\\"event\\\\\\\":\\\\\\\"atomic_admitted\\\\\\\",\\\\\\\"transaction\\\\\\\":\\\\\\\"error-after-staging\\\\\\\",\\\\\\\"before_len\\\\\\\":{},\\\\\\\"healthy_prefix\\\\\\\":true,\\\\\\\"fault_value\\\\\\\":99}}\\\",before_len);\n    let attempted_promise=Ballot::with(1,2,0,1);\n    let result=storage.write_atomically(vec\"'![\n        StorageOp::SetPromise(attempted_promise),\n        StorageOp::AppendEntries(vec![Value(8),Value(99)]),\n    ]);\n    let returned_error=result.is_err();\n    let error_text=result.err().map(|e|e.to_string()).unwrap_or_default();\n    let after_len=storage.get_log_len().unwrap();\n    let after_promise=storage.get_promise().unwrap();\n    let original_prefix=storage.get_entries(0,1).unwrap();\n    println!(\"CA_EVENT {{'\"\\\\\\\"event\\\\\\\":\\\\\\\"atomic_result\\\\\\\",\\\\\\\"transaction\\\\\\\":\\\\\\\"error-after-staging\\\\\\\",\\\\\\\"returned_error\\\\\\\":{},\\\\\\\"after_len\\\\\\\":{},\\\\\\\"serialization_errors\\\\\\\":{},\\\\\\\"original_prefix_unchanged\\\\\\\":{},\\\\\\\"promise_unchanged\\\\\\\":{},\\\\\\\"error\\\\\\\":{}}}\\\",returned_error,after_len,SERIALIZATION_ERRORS.load(Ordering::SeqCst),original_prefix==before_entries,after_promise==before_promise,serde_json::to_string(&error_text).unwrap());\n\n    // Diagnostic only: a later unrelated successful operation tests whether\n    // rejected staging remains. The formal predicate above is already observed.\n    storage.write_atomically(vec\"'![StorageOp::SetDecidedIndex(0)]).unwrap();\n    let later_promise=storage.get_promise().unwrap();\n    let later_len=storage.get_log_len().unwrap();\n    println!(\"CA_EVENT {{'\"\\\\\\\"event\\\\\\\":\\\\\\\"later_commit_diagnostic\\\\\\\",\\\\\\\"transaction\\\\\\\":\\\\\\\"error-after-staging\\\\\\\",\\\\\\\"len\\\\\\\":{},\\\\\\\"rejected_promise_visible\\\\\\\":{}}}\\\",later_len,later_promise==Some(attempted_promise));\n    drop(storage);\n    let reopened=PersistentStorage::<Value>::open(PersistentStorageConfig::with_path(path));\n    println\"'!(\"CA_EVENT {{'\"\\\\\\\"event\\\\\\\":\\\\\\\"reopen_diagnostic\\\\\\\",\\\\\\\"transaction\\\\\\\":\\\\\\\"error-after-staging\\\\\\\",\\\\\\\"len\\\\\\\":{},\\\\\\\"rejected_promise_visible\\\\\\\":{}}}\\\",reopened.get_log_len().unwrap(),reopened.get_promise().unwrap()==Some(attempted_promise));\n    drop(reopened);\n    directory.close().unwrap();\n}\nRS\npython3 - <<'PY'\nimport json\np={'description':'Observe same-instance log extent immediately after write_atomically returns a serializer error following a successfully staged entry. Preserve immediate database metadata and later unrelated-commit/reopen observations as diagnostics, without expanding the formal length oracle.','claim_id':'claim-storage-rollback','binding_ids':['bind-storage-rollback'],'harness':{'execution_package':'omnipaxos','kind':'rust_test','source':'','files':{},'description':'Open a fresh real PersistentStorage in a disposable workspace directory. Append one valid entry, then invoke write_atomically with a promise change and two entries, the second of which deterministically returns a serde error. Compare live get_log_len before/after the returned result. Drop storage before reopen and cleanup to respect RocksDB ownership.','semantic_changes':['No target or database replacement. Use real persistent backend and native serialization calls.','Test Entry implements Serialize with a deterministic normal error for value 99; valid values serialize as u64. This supplies a fault through the declared fallible interface.','An atomic counter reports whether the failing serializer actually ran.'],'prerequisites':[{'alias':'admission','event':'atomic_admitted','conditions':[{'field':'healthy_prefix','value':True},{'field':'fault_value','value':99}]}],'legality':{'source_ids':['src-persistent-config','src-persistent-recovery','src-persistent-atomic-declaration','src-persistent-batching','src-persistent-extent','src-storage-contract','src-core-dev-storage'],'expectation_ids':['src-storage-contract'],'derivation':'The selected core crate already enables the persistent_storage dependency through its original dev-dependencies; no feature flags or manifests are changed. PersistentStorage accepts generic Entry + Serialize + Deserialize types and propagates bincode errors. A deterministic serializer Err, rather than panic or injected storage mutation, exercises the actual fallible helper path. Initial append and read establish a healthy existing extent. Ordered StorageOps are public API inputs; no core protocol history is needed to invoke this independently grounded storage rollback responsibility.','applicability':'Single writer and same live storage object, no crash or concurrent access, healthy local RocksDB and error returned during later-entry serialization. The directory is newly created under the disposable workspace, opened via the configured path, and closed before cleanup.','unresolved':['Active persistent_storage compilation is determined by the trusted selected-target build. Native dependency build failure would leave observations unknown.','Core panic behavior and cluster consequences are outside this local interface check.']}},'monitors':[{'id':'monitor-atomic-extent','checker_id':'atomic-extent','event':'atomic_result','admission_alias':'admission','binding_ids':['bind-storage-rollback'],'grounding':{'source_ids':['src-persistent-atomic-declaration','src-persistent-batching','src-persistent-extent'],'expectation_ids':['src-storage-contract'],'binding_ids':['bind-storage-rollback'],'derivation':'The actual write_atomically Result supplies the antecedent. get_log_len before and immediately after the same call supplies the rollback comparison; transaction identity is a separate label. This getter reads cached next_log_key minus persisted compaction state, so the result establishes an observable API-state discrepancy, not immediate durable log mutation. Later commit/reopen output is diagnostic and is not a second formal property.','applicability':'Compare only returned Err outcomes after independent valid-state admission. There is no requirement that every call fail or that failed calls later succeed.','unresolved':['No whole-cluster safety attribution follows solely from this getter comparison.']}}],'observable_properties':[{'checker_id':'atomic-extent','kind':'event_implication','trigger':{'field':'event','value':'atomic_result'},'antecedent':{'field':'returned_error','value':True},'assertion':{'field':'after_len','reference':'admission.before_len'},'identity_fields':['transaction'],'description':'A returned error from an atomic transaction must leave same-instance observable log extent unchanged.'}],'uncertainties':['This formal oracle checks immediate observable extent; persistence and future-commit diagnostics do not broaden the obligation result.','A compilation or database initialization failure is not a property violation.']}\njson.dump(p,open('storage-plan.json','w'),indent=2)\ns={'action':'check','unit_id':'unit-claim-storage-rollback','rationale':'Execute the accepted rollback responsibility with a real serializer error and direct before/after Storage queries.','plan_path':'storage-plan.json','harness_path':'storage_check.rs'}\njson.dump(s,open('submission-09.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-04_18-47-07-omnipaxos-real-run --submission submission-09.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
