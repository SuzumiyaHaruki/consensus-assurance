) {\n   423\t            self.storage.write_atomically(vec![\n   424\t                StorageOp::Trim(new_compacted_idx),\n   425\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   426\t            ])?;\n   427\t            self.state_cache.compacted_idx = new_compacted_idx;\n   428\t        }\n   429\t        Ok(())\n   430\t    }\n   431\t\n   432\t    pub(crate) fn try_snapshot(&mut self, snapshot_idx: Option<usize>) -> StorageResult<()> {\n   433\t        let decided_idx = self.get_decided_idx();\n   434\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   435\t        let new_compacted_idx = match snapshot_idx {\n   436\t            Some(i) => match i.cmp(&decided_idx) {\n   437\t                Ordering::Less => i,\n   438\t                Ordering::Equal => log_decided_idx,\n   439\t                Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   440\t            },\n   441\t            None => log_decided_idx,\n   442\t        };\n   443\t        if new_compacted_idx > self.get_compacted_idx() {\n   444\t            let snapshot = self.create_snapshot(new_compacted_idx)?;\n   445\t            self.storage.write_atomically(vec![\n   446\t                StorageOp::Trim(new_compacted_idx),\n   447\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   448\t                StorageOp::SetSnapshot(Some(snapshot)),\n   449\t            ])?;\n   450\t            self.state_cache.compacted_idx = new_compacted_idx;\n   451\t        }\n   452\t        Ok(())\n   453\t    }\n   454\t\n   455\t    pub(crate) fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   135\t        self.internal_storage.get_promise()\n   136\t    }\n   137\t\n   138\t    /// Initiates the trim process.\n   139\t    /// # Arguments\n   140\t    /// * `trim_idx` - Deletes all entries up to [`trim_idx`], if the [`trim_idx`] is `None` then the minimum index accepted by **ALL** servers will be used as the [`trim_idx`].\n   141\t    pub(crate) fn trim(&mut self, trim_idx: Option<usize>) -> Result<(), CompactionErr> {\n   142\t        match self.state {\n   143\t            (Role::Leader, _) => {\n   144\t                let min_all_accepted_idx = self.leader_state.get_min_all_accepted_idx();\n   145\t                let trimmed_idx = match trim_idx {\n   146\t                    Some(idx) if idx <= *min_all_accepted_idx => idx,\n   147\t                    None => {\n   148\t                        #[cfg(feature = \"logging\")]\n   149\t                        trace!(\n   150\t                            self.logger,\n   151\t                            \"No trim index provided, using min_las_idx: {:?}\",\n   152\t                            min_all_accepted_idx\n   153\t                        );\n   154\t                        *min_all_accepted_idx\n   155\t                    }\n   156\t                    _ => {\n   157\t                        return Err(CompactionErr::NotAllDecided(*min_all_accepted_idx));\n   158\t                    }\n   159\t                };\n   160\t                let result = self.internal_storage.try_trim(trimmed_idx);\n   161\t                if result.is_ok() {\n   162\t                    for pid in &self.peers {\n   163\t                        let msg = PaxosMsg::Compaction(Compaction::Trim(trimmed_idx));\n   164\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   165\t                            from: self.pid,\n   166\t                            to: *pid,\n   167\t                            msg,\n   168\t                        }));\n   169\t                    }\n   170\t                }\n   171\t                result.map_err(|e| {\n   172\t                    *e.downcast()\n   173\t                        .expect(\"storage error while trying to trim log\")\n   174\t                })\n   175\t            }\n   176\t            _ => Err(CompactionErr::NotCurrentLeader(self.get_current_leader())),\n   177\t        }\n   178\t    }\n   179\t\n   180\t    /// Trim the log and create a snapshot. ** Note: only up to the `decided_idx` can be snapshotted **\n   181\t    /// # Arguments\n   182\t    /// `idx` - Snapshots all entries with index < [`idx`], if the [`idx`] is None then the decided index will be used.\n   183\t    /// `local_only` - If `true`, only this server snapshots the log. If `false` all servers performs the snapshot.\n   184\t    pub(crate) fn snapshot(\n   185\t        &mut self,\n   186\t        idx: Option<usize>,\n   187\t        local_only: bool,\n   188\t    ) -> Result<(), CompactionErr> {\n   189\t        let result = self.internal_storage.try_snapshot(idx);\n   190\t        if !local_only && result.is_ok() {\n   191\t            // since it is decided, it is ok even for a follower to send this\n   192\t            for pid in &self.peers {\n   193\t                let msg = PaxosMsg::Compaction(Compaction::Snapshot(idx));\n   194\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   195\t                    from: self.pid,\n   196\t                    to: *pid,\n   197\t                    msg,\n   198\t                }));\n   199\t            }\n   200\t        }\n   201\t        result.map_err(|e| {\n   202\t            *e.downcast()\n   203\t                .expect(\"storage error while trying to snapshot log\")\n   204\t        })\n   205\t    }\n   206\t\n   207\t    /// Return the decided index.\n   208\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   209\t        self.internal_storage.get_decided_idx()\n   210\t    }\n   211\t\n   212\t    /// Return trim index from storage.\n   213\t    pub(crate) fn get_compacted_idx(&self) -> usize {\n   214\t        self.internal_storage.get_compacted_idx()\n   215\t    }\n../agent-source/omnipaxos_runtime/README.md:4:methods to append entries, subscribe to decided entries, and observe leader/reconfiguration\n../agent-source/omnipaxos_runtime/tests/async_r