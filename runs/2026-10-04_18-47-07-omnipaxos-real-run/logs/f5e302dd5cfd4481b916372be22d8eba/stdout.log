{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > subscription_map.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v2.json')); sources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\npush=src('src-subscriber-push','omnipaxos_runtime/src/actor.rs',275,333)\ncontract=src('src-subscription-contract','omnipaxos_runtime/src/handle.rs',261,279,'interface_statement')\nsnap=src('src-snapshot-producer','omnipaxos/src/storage/internal_storage.rs',367,383)\ncompact=src('src-compaction','omnipaxos/src/storage/internal_storage.rs',414,452)\napi=src('src-snapshot-api','omnipaxos/src/omni_paxos.rs',242,258,'interface_statement')\ntest=src('test-stream-order','omnipaxos_runtime/tests/async_runtime_test.rs',1198,1244,'test_expectation')\n# Reconcile only the relationships whose previously open premise has been answered.\nfor b in m['behaviors']:\n if b['id']=='b-runtime-notify':\n  b['unknowns']=[]\n  b['important_branches']=['When synchronization replaces an unchosen assigned entry and advances decided extent before the next drain, the pending assignment remains and the numeric-success arm precedes supersession; the success predicate does not establish entry correspondence.']\n if b['id']=='b-runtime-assign':\n  b['unknowns']=['Remote and deferred-batch assignment lifecycles across authority changes remain separate.']\n  b['important_branches']=['Incoming core synchronization does not clear already recorded Pending.assigned. It remains until a notifier outcome or actor shutdown.']\n if b['id']=='b-runtime-loop':\n  b['unknowns']=['Backpressure-specific progress remains separate.']\nfor f in m['facts']:\n if f['id']=='f-runtime-assignment':f['unknowns']=['Remote and deferred-batch assignment provenance under authority changes.']\n\ndef bh(i,a,o,c,t,ss,**kw):m['behaviors'].append(dict(id=i,primary_activity=a,execution_owner=o,protocol_context=c,trigge