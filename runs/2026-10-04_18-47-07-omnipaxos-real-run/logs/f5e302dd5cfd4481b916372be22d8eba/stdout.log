iginal log order?'])\nm['facts'].append(dict(id='f-sub-cursor',meaning='Subscriber cursor equals its requested starting index plus the count of LogEntry values successfully enqueued for that subscriber.',identity={'subscriber':'One DecidedSub instance','owner':'Origin runtime actor'},validity_context='From subscription creation until receiver closure/removal; the count includes compacted summary markers.',representation=['DecidedSub.next_idx'],durability='Volatile actor state.',recovery='No subscription reconstruction at actor restart; a new subscription starts at caller-provided from.',source_ids=[push,contract,'src-runtime-loop'],unknowns=['Whether this count denotes the next original log position when read output contains a compacted prefix summary.']))\nm['surfaces'].append(dict(entry_point='ActorState::push_to_all_subs',disposition='mapped',behavior_ids=['b-subscriber'],reason='read_decided_suffix compresses a compacted prefix into one vector element, while fanout interprets vector offsets and successful-send counts as original log positions.',source_ids=[push,'src-read'],high_consequence=True))\nfor a in m['activities']:\n a.pop('behavior_ids',None)\n if a['class_id']=='A5':\n  a['realization_summary']='Public reads classify decided entries and compacted prefix summaries. Runtime subscriptions consume these vectors using per-subscriber counters and expose ordered streams.';a['source_ids'] += [push,contract]\nfor f in m['facts']:f.pop('established_by',None);f.pop('consumed_by',None)\nm['core_overview']['open_details']=[x for x in m['core_overview']['open_details'] if 'Actor assignment consumption' not in x]\nm['core_overview']['open_details'].append('Subscriber cursor count versus original log position after compaction.')\nm['core_overview']['connection']['explanation'] += ' For the already read runtime consumer, stored assignment alone does not imply entry preservation: core synchronization can replace unchosen history while Pending.assigned stays unchanged, a