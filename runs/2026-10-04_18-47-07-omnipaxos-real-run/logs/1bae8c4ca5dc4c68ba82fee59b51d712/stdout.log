{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nr=json.load(open('../research.json'))\nfor k in ['capacity','assessments','pending_work']:print(k,json.dumps(r[k],indent=2))\nPY\ncat ../agent-source/README.md | head -90\ncat ../agent-source/docs/omnipaxos/index.md\nnl -ba ../agent-source/omnipaxos/tests/reconnect_test.rs | head -210\nnl -ba ../agent-source/omnipaxos/tests/sync_test.rs | head -180\"","aggregated_output":"     1\tpub mod utils;\n     2\t\n     3\tuse crate::utils::STOPSIGN_ID;\n     4\tuse kompact::prelude::{promise, Ask, FutureCollection};\n     5\tuse omnipaxos::{storage::StopSign, util::NodeId, ClusterConfig};\n     6\tuse serial_test::serial;\n     7\tuse utils::{\n     8\t    verification::{verify_log, verify_stopsign},\n     9\t    TestConfig, TestSystem, Value,\n    10\t};\n    11\t\n    12\t/// The state of the leader's and follower's log at the time of a sync\n    13\t#[derive(Default)]\n    14\tstruct SyncTest {\n    15\t    leaders_log: Vec<Value>,\n    16\t    leaders_dec_idx: usize,\n    17\t    leaders_compacted_idx: Option<usize>,\n    18\t    leaders_ss: Option<StopSign>,\n    19\t    followers_log: Vec<Value>,\n    20\t    followers_dec_idx: usize,\n    21\t    followers_compacted_idx: Option<usize>,\n    22\t}\n    23\t\n    24\t/// Tests that a leader whose log consists of everything a log can be made up of (snapshot, decided entries,\n    25\t/// undecided entries, stopsign), correctly syncs a follower who is missing decided entries and\n    26\t/// has invalid undecided entries.\n    27\t#[test]\n    28\t#[serial]\n    29\tfn sync_full_test() {\n    30\t    // Define leader's log\n    31\t    let leaders_log = [1, 2, 3, 4, 5, 10, 11, 12]\n    32\t        .into_iter()\n    33\t        .map(Value::with_id)\n    34\t        .collect();\n    35\t    let leaders_dec_idx = 5;\n    36\t    let leaders_compacted_idx = 2;\n    37\t    let cluster_config = ClusterConfig::default();\n    38\t    let mut leaders_ss = StopSign::with(cluster_config, None);\n    39\t    leaders_ss.next_config.configuration_id = 2;\n    40\t    leaders_ss.next_config.nodes = vec![1, 2, 3];\n    41\t\n    42\t    // Define follower's log\n    43\t    let followers_log = [1, 2, 3, 6, 7, 8, 9]\n    44\t        .into_iter()\n    45\t        .map(Value::with_id)\n    46\t        .collect();\n    47\t    let followers_dec_idx = 3;\n    48\t\n    49\t    let test = SyncTest {\n    50\t        leaders_log,\n    51\t        leaders_dec_idx,\n    52\t        leaders_compacted_idx: Some(leaders_compacted_idx),\n    53\t        leaders_ss: Some(leaders_ss),\n    54\t        followers_log,\n    55\t        followers_dec_idx,\n    56\t        ..Default::default()\n    57\t    };\n    58\t    sync_test(test);\n    59\t}\n    60\t\n    61\t/// Tests that a leader, who has a decided stopsign, correctly syncs a follower who is missing\n    62\t/// decided entries and has invalid undecided entries.\n    63\t#[test]\n    64\t#[serial]\n    65\tfn sync_decided_ss_test() {\n    66\t    // Define leader's log\n    67\t    let leaders_log = [1, 2, 3, 4, 5].into_iter().map(Value::with_id).collect();\n    68\t    let leaders_dec_idx = 6;\n    69\t    let cluster_config = ClusterConfig::default();\n    70\t    let mut leaders_ss = StopSign::with(cluster_config, None);\n    71\t    leaders_ss.next_config.configuration_id = 2;\n    72\t    leaders_ss.next_config.nodes = vec![1, 2, 3];\n    73\t\n    74\t    // Define follower's log\n    75\t    let followers_log = [1, 2, 3, 6, 7].into_iter().map(Value::with_id).collect();\n    76\t    let followers_dec_idx = 3;\n    77\t\n    78\t    let test = SyncTest {\n    79\t        leaders_log,\n    80\t        leaders_ss: Some(leaders_ss),\n    81\t        leaders_dec_idx,\n    82\t        followers_log,\n    83\t        followers_dec_idx,\n    84\t        ..Default::default()\n    85\t    };\n    86\t    sync_test(test);\n    87\t}\n    88\t\n    89\t/// Tests that a leader whose log consists of only a stopsign correctly syncs the follower.\n    90\t#[test]\n    91\t#[serial]\n    92\tfn sync_only_stopsign_test() {\n    93\t    // Define leader's log\n    94\t    let leaders_dec_idx = 1;\n    95\t    let cluster_config = ClusterConfig::default();\n    96\t    let mut leaders_ss = StopSign::with(cluster_config, None);\n    97\t    leaders_ss.next_config.configuration_id = 2;\n    98\t    leaders_ss.next_config.nodes = vec![1, 2, 3];\n    99\t\n   100\t    // Define follower's log\n   101\t    let followers_dec_idx = 0;\n   102\t\n   103\t    let test = SyncTest {\n   104\t        leaders_ss: Some(leaders_ss),\n   105\t        leaders_dec_idx,\n   106\t        followers_dec_idx,\n   107\t        ..Default::default()\n   108\t    };\n   109\t    sync_test(test);\n   110\t}\n   111\t\n   112\t/// Tests that the leader syncs the follower using a decided snapshot which the follower correctly\n   113\t/// merges onto their empty log.\n   114\t#[test]\n   115\t#[serial]\n   116\tfn sync_only_snapshot_test() {\n   117\t    // Define leader's log\n   118\t    let leaders_log: Vec<Value> = [1, 2, 3].into_iter().map(Value::with_id).collect();\n   119\t    let leaders_dec_idx = 3;\n   120\t    let leaders_compacted_idx = 3;\n   121\t\n   122\t    // Define follower's log\n   123\t    let followers_dec_idx = 0;\n   124\t\n   125\t    let test = SyncTest {\n   126\t        leaders_log,\n   127\t        leaders_dec_idx,\n   128\t        leaders_compacted_idx: Some(leaders_compacted_idx),\n   129\t        followers_dec_idx,\n   130\t        ..Default::default()\n   131\t    };\n   132\t    sync_test(test);\n   133\t}\n   134\t\n   135\t/// Tests that the leader syncs the follower using a decided snapshot which correctly merges onto\n   136\t/// the partly-snapshotted decided entries of the follower.\n   137\t#[test]\n   138\t#[serial]\n   139\tfn sync_follower_snapshot_test() {\n   140\t    // Define leader's log\n   141\t    let leaders_log = [1, 2, 3, 4, 5].into_iter().map(Value::with_id).collect();\n   142\t    let leaders_dec_idx = 5;\n   143\t\n   144\t    // Define follower's log\n   145\t    let followers_log = [1, 2, 3, 4].into_iter().map(Value::with_id).collect();\n   146\t    let followers_dec_idx = 4;\n   147\t    let followers_compacted_idx = 3;\n   148\t\n   149\t    let test = SyncTest {\n   150\t        leaders_log,\n   151\t        leaders_dec_idx,\n   152\t        followers_log,\n   153\t        followers_dec_idx,\n   154\t        followers_compacted_idx: Some(followers_compacted_idx),\n   155\t        ..Default::default()\n   156\t    };\n   157\t    sync_test(test);\n   158\t}\n   159\t\n   160\t/// Creates a TestSystem cluster which sets up a scenario such that a follower is\n   161\t/// disconnected from the cluster, is reconnected, and is synced by the leader. The state of the\n   162\t/// leader's and follower's log at the time of the sync is given by the SyncTest argument.\n   163\tfn sync_test(test: SyncTest) {\n   164\t    // Start a Kompact system\n   165\t    let cfg = TestConfig::load(\"sync_test\").expect(\"Test config couldn't be loaded\");\n   166\t    let sys = TestSystem::with(cfg);\n   167\t    sys.start_all_nodes();\n   168\t\n   169\t    let (followers_decided, followers_accepted) =\n   170\t        test.followers_log.split_at(test.followers_dec_idx);\n   171\t    let leaders_ss_is_decided =\n   172\t        test.leaders_ss.is_some() && test.leaders_dec_idx > test.leaders_log.len();\n   173\t    let leaders_log_dec_idx = if leaders_ss_is_decided {\n   174\t        test.leaders_dec_idx - 1\n   175\t    } else {\n   176\t        test.leaders_dec_idx\n   177\t    };\n   178\t    let leaders_new_decided = &test.leaders_log[test.followers_dec_idx..leaders_log_dec_idx];\n   179\t    let leaders_accepted = &test.leaders_log[leaders_log_dec_idx..];\n   180\t    let followers_missing_entries = &test.leaders_log[test.followers_dec_idx..];\n","exit_code":0,"status":"completed"}}
