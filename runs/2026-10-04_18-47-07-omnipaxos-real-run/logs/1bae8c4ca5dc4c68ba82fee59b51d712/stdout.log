to_key = self.next_log_key.to_be_bytes();\n   211\t            let log = self.db.cf_handle(LOG).unwrap();\n   212\t            self.write_batch.delete_range_cf(log, from_key, to_key);\n   213\t        }\n   214\t        self.next_log_key = from_idx;\n   215\t        self.batch_append_entries(entries)\n   216\t    }\n   217\t\n   218\t    fn batch_set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   219\t        let prom_bytes = bincode::serialize(&n_prom)?;\n   220\t        self.write_batch.put(NPROM, prom_bytes);\n   221\t        Ok(())\n   222\t    }\n   223\t\n   224\t    fn batch_set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n   225\t        let ld_bytes = usize::as_bytes(&ld);\n   226\t        self.write_batch.put(DECIDE, ld_bytes);\n   227\t        Ok(())\n   228\t    }\n   229\t\n   230\t    fn batch_set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n   231\t        let acc_bytes = bincode::serialize(&na)?;\n   232\t        self.write_batch.put(ACC, acc_bytes);\n   233\t        Ok(())\n   234\t    }\n   235\t\n   236\t    fn batch_set_compacted_idx(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   237\t        let trim_bytes = usize::as_bytes(&trimmed_idx);\n   238\t        self.write_batch.put(TRIM, trim_bytes);\n   239\t        Ok(())\n   240\t    }\n   241\t\n   242\t    fn batch_trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   243\t        let from_key = 0_usize.to_be_bytes();\n   244\t        let to_key = trimmed_idx.to_be_bytes();\n   245\t        let log = self.db.cf_handle(LOG).unwrap();\n   246\t        self.write_batch.delete_range_cf(log, from_key, to_key);\n   247\t        Ok(())\n   248\t    }\n   249\t\n   250\t    fn batch_set_stopsign(&mut self, ss: Option<StopSign>) -> StorageResult<()> {\n   251\t        let stopsign = bincode::serialize(&ss)?;\n   252\t        self.write_batch.put(STOPSIGN, stopsign);\n   253\t        Ok(())\n   254\t    }\n   255\t\n   256\t    fn batch_set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n   257\t        let s = bincode::serialize(&snapshot)?;\n   258\t        self.write_batch.put(SNAPSHOT, s);\n   259\t        Ok(())\n","exit_code":0,"status":"completed"}}
