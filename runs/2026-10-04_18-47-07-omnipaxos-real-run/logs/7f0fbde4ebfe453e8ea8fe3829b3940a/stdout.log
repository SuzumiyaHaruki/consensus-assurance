{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nprint(json.load(open('../state.json'))['method_paths'])\nPY\nnl -ba ../agent-source/omnipaxos/src/ballot_leader_election.rs | sed -n '175,295p'\nnl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '100,135p'\nnl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '77,165p'\"","aggregated_output":"['system.md', 'skills/consensus-analysis/SKILL.md', 'skills/consensus-analysis/guide.md', 'skills/consensus-analysis/references/activity-classes.md', 'skills/consensus-analysis/references/behavior-facts.md', 'skills/evidence-review/SKILL.md', 'skills/evidence-review/guide.md', 'skills/evidence-review/references/experiments.md', 'tasks/audit.md']\n   175\t    pub(crate) fn new_hb_round(&mut self) {\n   176\t        self.prev_replies = std::mem::take(&mut self.heartbeat_replies);\n   177\t        self.hb_round += 1;\n   178\t        #[cfg(feature = \"logging\")]\n   179\t        trace!(\n   180\t            self.logger,\n   181\t            \"Initiate new heartbeat round: {}\",\n   182\t            self.hb_round\n   183\t        );\n   184\t        for peer in &self.peers {\n   185\t            let hb_request = HeartbeatRequest {\n   186\t                round: self.hb_round,\n   187\t            };\n   188\t            self.outgoing.push(BLEMessage {\n   189\t                from: self.pid,\n   190\t                to: *peer,\n   191\t                msg: HeartbeatMsg::Request(hb_request),\n   192\t            });\n   193\t        }\n   194\t    }\n   195\t\n   196\t    /// End of a heartbeat round. Returns current leader and election status.\n   197\t    pub(crate) fn hb_timeout(\n   198\t        &mut self,\n   199\t        seq_paxos_state: &(Role, Phase),\n   200\t        seq_paxos_promise: Ballot,\n   201\t    ) -> Option<Ballot> {\n   202\t        self.update_leader();\n   203\t        self.update_happiness(seq_paxos_state);\n   204\t        self.check_takeover();\n   205\t        self.new_hb_round();\n   206\t        if seq_paxos_promise > self.leader {\n   207\t            // Sync leader with Paxos promise in case ballot didn't make it to BLE followers\n   208\t            // or become_leader() was called.\n   209\t            self.leader = seq_paxos_promise;\n   210\t            if seq_paxos_promise.pid == self.pid {\n   211\t                self.current_ballot = seq_paxos_promise;\n   212\t            }\n   213\t            self.happy = true;\n   214\t        }\n   215\t        if self.leader == self.current_ballot {\n   216\t            Some(self.current_ballot)\n   217\t        } else {\n   218\t            None\n   219\t        }\n   220\t    }\n   221\t\n   222\t    fn update_leader(&mut self) {\n   223\t        let max_reply_ballot = self.heartbeat_replies.iter().map(|r| r.ballot).max();\n   224\t        if let Some(max) = max_reply_ballot {\n   225\t            if max > self.leader {\n   226\t                self.leader = max;\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n   232\t        self.happy = if self.leader == self.current_ballot {\n   233\t            let potential_followers = self\n   234\t                .heartbeat_replies\n   235\t                .iter()\n   236\t                .filter(|hb_reply| hb_reply.leader <= self.current_ballot)\n   237\t                .count();\n   238\t            let can_form_quorum = match seq_paxos_state {\n   239\t                (Role::Leader, Phase::Accept) => {\n   240\t                    self.quorum.is_accept_quorum(potential_followers + 1)\n   241\t                }\n   242\t                _ => self.quorum.is_prepare_quorum(potential_followers + 1),\n   243\t            };\n   244\t            if can_form_quorum {\n   245\t                true\n   246\t            } else {\n   247\t                let see_larger_happy_leader = self\n   248\t                    .heartbeat_replies\n   249\t                    .iter()\n   250\t                    .any(|r| r.leader > self.current_ballot && r.happy);\n   251\t                see_larger_happy_leader\n   252\t            }\n   253\t        } else {\n   254\t            self.heartbeat_replies\n   255\t                .iter()\n   256\t                .any(|r| r.ballot == self.leader && r.happy)\n   257\t        };\n   258\t    }\n   259\t\n   260\t    fn check_takeover(&mut self) {\n   261\t        if !self.happy {\n   262\t            let all_neighbors_unhappy = self.heartbeat_replies.iter().all(|r| !r.happy);\n   263\t            let im_quorum_connected = self\n   264\t                .quorum\n   265\t                .is_prepare_quorum(self.heartbeat_replies.len() + 1);\n   266\t            if all_neighbors_unhappy && im_quorum_connected {\n   267\t                // We increment past our leader instead of max of unhappy ballots because we\n   268\t                // assume we have already checked leader for this round so they should be equal\n   269\t                self.current_ballot.n = self.leader.n + 1;\n   270\t                self.leader = self.current_ballot;\n   271\t                self.happy = true;\n   272\t            }\n   273\t        }\n   274\t    }\n   275\t\n   276\t    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n   277\t        let hb_reply = HeartbeatReply {\n   278\t            round: req.round,\n   279\t            ballot: self.current_ballot,\n   280\t            leader: self.leader,\n   281\t            happy: self.happy,\n   282\t        };\n   283\t        self.outgoing.push(BLEMessage {\n   284\t            from: self.pid,\n   285\t            to: from,\n   286\t            msg: HeartbeatMsg::Reply(hb_reply),\n   287\t        });\n   288\t    }\n   289\t\n   290\t    fn handle_reply(&mut self, rep: HeartbeatReply) {\n   291\t        if rep.round == self.hb_round && rep.ballot.config_id == self.configuration_id {\n   292\t            self.heartbeat_replies.push(rep);\n   293\t        }\n   294\t    }\n   295\t\n   100\t}\n   101\t\n   102\timpl ClusterConfig {\n   103\t    /// Checks that all the fields of the cluster config are valid.\n   104\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   105\t        let num_nodes = self.nodes.len();\n   106\t        valid_config!(num_nodes > 1, \"Need more than 1 node\");\n   107\t        valid_config!(self.configuration_id != 0, \"Configuration ID cannot be 0\");\n   108\t        if let Some(FlexibleQuorum {\n   109\t            read_quorum_size,\n   110\t            write_quorum_size,\n   111\t        }) = self.flexible_quorum\n   112\t        {\n   113\t            valid_config!(\n   114\t                read_quorum_size + write_quorum_size > num_nodes,\n   115\t                \"The quorums must overlap i.e., the sum of their sizes must exceed the # of nodes\"\n   116\t            );\n   117\t            valid_config!(\n   118\t                read_quorum_size >= 2 && read_quorum_size <= num_nodes,\n   119\t                \"Read quorum must be in range 2 to # of nodes in the cluster\"\n   120\t            );\n   121\t            valid_config!(\n   122\t                write_quorum_size >= 2 && write_quorum_size <= num_nodes,\n   123\t                \"Write quorum must be in range 2 to # of nodes in the cluster\"\n   124\t            );\n   125\t            valid_config!(\n   126\t                read_quorum_size >= write_quorum_size,\n   127\t                \"Read quorum size must be >= the write quorum size.\"\n   128\t            );\n   129\t        }\n   130\t        Ok(())\n   131\t    }\n   132\t\n   133\t    /// Checks all configuration fields and builds a local OmniPaxos node with settings for this\n   134\t    /// node defined in `server_config` and using storage `with_storage`.\n   135\t    pub fn build_for_server<T, B>(\n    77\t    pub(crate) fn read_decided_suffix(\n    78\t        &self,\n    79\t        from_idx: usize,\n    80\t    ) -> StorageResult<Option<Vec<LogEntry<T>>>> {\n    81\t        let decided_idx = self.get_decided_idx();\n    82\t        if from_idx < decided_idx {\n    83\t            self.read(from_idx..decided_idx)\n    84\t        } else {\n    85\t            Ok(None)\n    86\t        }\n    87\t    }\n    88\t\n    89\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n    90\t    pub(crate) fn read<R>(&self, r: R) -> StorageResult<Option<Vec<LogEntry<T>>>>\n    91\t    where\n    92\t        R: RangeBounds<usize>,\n    93\t    {\n    94\t        let from_idx = match r.start_bound() {\n    95\t            Bound::Included(i) => *i,\n    96\t            Bound::Excluded(e) => *e + 1,\n    97\t            Bound::Unbounded => 0,\n    98\t        };\n    99\t        let to_idx = match r.end_bound() {\n   100\t            Bound::Included(i) => *i + 1,\n   101\t            Bound::Excluded(e) => *e,\n   102\t            Bound::Unbounded => self.get_accepted_idx(),\n   103\t        };\n   104\t        if to_idx == 0 {\n   105\t            return Ok(None);\n   106\t        }\n   107\t        let compacted_idx = self.get_compacted_idx();\n   108\t        let accepted_idx = self.get_accepted_idx();\n   109\t        // use to_idx-1 when getting the entry type as to_idx is exclusive\n   110\t        let to_type = match self.get_entry_type(to_idx - 1, compacted_idx, accepted_idx)? {\n   111\t            Some(IndexEntry::Compacted) => {\n   112\t                return Ok(Some(vec![self.create_compacted_entry(compacted_idx)?]))\n   113\t            }\n   114\t            Some(from_type) => from_type,\n   115\t            _ => return Ok(None),\n   116\t        };\n   117\t        let from_type = match self.get_entry_type(from_idx, compacted_idx, accepted_idx)? {\n   118\t            Some(from_type) => from_type,\n   119\t            _ => return Ok(None),\n   120\t        };\n   121\t        match (from_type, to_type) {\n   122\t            (IndexEntry::Entry, IndexEntry::Entry) => {\n   123\t                Ok(Some(self.create_read_log_entries(from_idx, to_idx)?))\n   124\t            }\n   125\t            (IndexEntry::Entry, IndexEntry::StopSign(ss)) => {\n   126\t                let mut entries = self.create_read_log_entries(from_idx, to_idx - 1)?;\n   127\t                entries.push(LogEntry::StopSign(ss, self.stopsign_is_decided()));\n   128\t                Ok(Some(entries))\n   129\t            }\n   130\t            (IndexEntry::Compacted, IndexEntry::Entry) => {\n   131\t                let mut entries = Vec::with_capacity(to_idx - compacted_idx + 1);\n   132\t                let compacted = self.create_compacted_entry(compacted_idx)?;\n   133\t                entries.push(compacted);\n   134\t                let mut e = self.create_read_log_entries(compacted_idx, to_idx)?;\n   135\t                entries.append(&mut e);\n   136\t                Ok(Some(entries))\n   137\t            }\n   138\t            (IndexEntry::Compacted, IndexEntry::StopSign(ss)) => {\n   139\t                let mut entries = Vec::with_capacity(to_idx - compacted_idx + 1);\n   140\t                let compacted = self.create_compacted_entry(compacted_idx)?;\n   141\t                entries.push(compacted);\n   142\t                let mut e = self.create_read_log_entries(compacted_idx, to_idx - 1)?;\n   143\t                entries.append(&mut e);\n   144\t                entries.push(LogEntry::StopSign(ss, self.stopsign_is_decided()));\n   145\t                Ok(Some(entries))\n   146\t            }\n   147\t            (IndexEntry::StopSign(ss), IndexEntry::StopSign(_)) => {\n   148\t                Ok(Some(vec![LogEntry::StopSign(\n   149\t                    ss,\n   150\t                    self.stopsign_is_decided(),\n   151\t                )]))\n   152\t            }\n   153\t            e => {\n   154\t                unimplemented!(\"{}\", format!(\"Unexpected read combination: {:?}\", e))\n   155\t            }\n   156\t        }\n   157\t    }\n   158\t\n   159\t    fn get_entry_type(\n   160\t        &self,\n   161\t        idx: usize,\n   162\t        compacted_idx: usize,\n   163\t        accepted_idx: usize,\n   164\t    ) -> StorageResult<Option<IndexEntry>> {\n   165\t        if idx < compacted_idx {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > build_initial.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nL=src('src-leader','omnipaxos/src/sequence_paxos/leader.rs',14,415)\nF=src('src-follower','omnipaxos/src/sequence_paxos/follower.rs',13,290)\nM=src('src-sequence','omnipaxos/src/sequence_paxos/mod.rs',53,463)\nU=src('src-support','omnipaxos/src/util.rs',96,259)\nS=src('src-sync','omnipaxos/src/storage/internal_storage.rs',313,359)\nN=src('src-order','omnipaxos/src/util.rs',370,390)\nA=src('src-api','omnipaxos/src/omni_paxos.rs',345,441)\nB=src('src-ble','omnipaxos/src/ballot_leader_election.rs',175,293)\nC=src('src-config','omnipaxos/src/omni_paxos.rs',102,131)\nR=src('src-read','omnipaxos/src/storage/internal_storage.rs',77,157)\nD=src('doc-log','docs/omnipaxos/log.md',1,33,'document_statement')\nT=src('doc-transport','docs/omnipaxos/communication.md',1,25,'document_statement')\nQ=src('doc-reconfiguration','docs/omnipaxos/reconfiguration.md',1,47,'document_statement')\nbeh=[]\ndef bh(i,act,owner,context,trigger,ss,**kw):\n beh.append(dict(id=i,primary_activity=act,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss,**kw))\nbh('b-prepare','A2','SequencePaxos leader and follower','Configuration-local ballot and prepare phase','handle_leader and handle_prepare',[L,F,U],implementation_guards=['New leader ballot exceeds remembered leader and promise; follower accepts higher promise or equal promise in Recover.'],writes=['Flush pending batches; persist promise; reset leader support on local leadership; reset follower sequence on prepare.'],external_effects=['Queue Prepare or Promise containing accepted round, accepted index and decided index; selected history may include log sync.'],produces_fact_ids=['f-promise'],unknowns=['Full initialization and durable recovery contract still