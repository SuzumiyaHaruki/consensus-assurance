{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/sequence_paxos/leader.rs | sed -n '300,490p'; nl -ba ../agent-source/omnipaxos/src/util.rs | sed -n '1,360p'\"","aggregated_output":"   300\t\n   301\t    pub(crate) fn handle_promise_accept(&mut self, prom: Promise<T>, from: NodeId) {\n   302\t        #[cfg(feature = \"logging\")]\n   303\t        {\n   304\t            let (r, p) = &self.state;\n   305\t            debug!(\n   306\t                self.logger,\n   307\t                \"Self role {:?}, phase {:?}. Incoming message Promise Accept from {}\", r, p, from\n   308\t            );\n   309\t        }\n   310\t        if prom.n == self.leader_state.n_leader {\n   311\t            self.leader_state.set_promise(prom, from, false);\n   312\t            self.send_accsync(from);\n   313\t        }\n   314\t    }\n   315\t\n   316\t    pub(crate) fn handle_accepted(&mut self, accepted: Accepted, from: NodeId) {\n   317\t        #[cfg(feature = \"logging\")]\n   318\t        trace!(\n   319\t            self.logger,\n   320\t            \"Got Accepted from {}, idx: {}, chosen_idx: {}, accepted: {:?}\",\n   321\t            from,\n   322\t            accepted.accepted_idx,\n   323\t            self.internal_storage.get_decided_idx(),\n   324\t            self.leader_state.accepted_indexes\n   325\t        );\n   326\t        if accepted.n == self.leader_state.n_leader && self.state == (Role::Leader, Phase::Accept) {\n   327\t            self.leader_state\n   328\t                .set_accepted_idx(from, accepted.accepted_idx);\n   329\t            if accepted.accepted_idx > self.internal_storage.get_decided_idx()\n   330\t                && self.leader_state.is_chosen(accepted.accepted_idx)\n   331\t            {\n   332\t                let decided_idx = accepted.accepted_idx;\n   333\t                self.internal_storage\n   334\t                    .set_decided_idx(decided_idx)\n   335\t                    .expect(WRITE_ERROR_MSG);\n   336\t                for pid in self.leader_state.get_promised_followers() {\n   337\t                    let latest_accdec = self.get_latest_accdec_message(pid);\n   338\t                    match latest_accdec {\n   339\t                        Some(accdec) => accdec.decided_idx = decided_idx,\n   340\t                        None => self.send_decide(pid, decided_idx, false),\n   341\t                    }\n   342\t                }\n   343\t            }\n   344\t        }\n   345\t    }\n   346\t\n   347\t    fn get_latest_accdec_message(&mut self, to: NodeId) -> Option<&mut AcceptDecide<T>> {\n   348\t        if let Some((bal, outgoing_idx)) = self.leader_state.get_latest_accept_meta(to) {\n   349\t            if bal == self.leader_state.n_leader {\n   350\t                if let Message::SequencePaxos(PaxosMessage {\n   351\t                    msg: PaxosMsg::AcceptDecide(accdec),\n   352\t                    ..\n   353\t                }) = self.outgoing.get_mut(outgoing_idx).unwrap()\n   354\t                {\n   355\t                    return Some(accdec);\n   356\t                } else {\n   357\t                    #[cfg(feature = \"logging\")]\n   358\t                    debug!(self.logger, \"Cached idx is not an AcceptedDecide!\");\n   359\t                }\n   360\t            }\n   361\t        }\n   362\t        None\n   363\t    }\n   364\t\n   365\t    pub(crate) fn handle_notaccepted(&mut self, not_acc: NotAccepted, from: NodeId) {\n   366\t        if self.state.0 == Role::Leader && self.leader_state.n_leader < not_acc.n {\n   367\t            self.leader_state.lost_promise(from);\n   368\t        }\n   369\t    }\n   370\t\n   371\t    pub(crate) fn resend_messages_leader(&mut self) {\n   372\t        match self.state.1 {\n   373\t            Phase::Prepare => {\n   374\t                // Resend Prepare\n   375\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   376\t                for peer in preparable_peers {\n   377\t                    self.send_prepare(peer);\n   378\t                }\n   379\t            }\n   380\t            Phase::Accept => {\n   381\t                // Resend AcceptStopSign or StopSign's decide\n   382\t                if let Some(ss) = self.internal_storage.get_stopsign() {\n   383\t                    let decided_idx = self.internal_storage.get_decided_idx();\n   384\t                    for follower in self.leader_state.get_promised_followers() {\n   385\t                        if self.internal_storage.stopsign_is_decided() {\n   386\t                            self.send_decide(follower, decided_idx, true);\n   387\t                        } else if self.leader_state.get_accepted_idx(follower)\n   388\t                            != self.internal_storage.get_accepted_idx()\n   389\t                        {\n   390\t                            self.send_accept_stopsign(follower, ss.clone(), true);\n   391\t                        }\n   392\t                    }\n   393\t                }\n   394\t                // Resend Prepare\n   395\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   396\t                for peer in preparable_peers {\n   397\t                    self.send_prepare(peer);\n   398\t                }\n   399\t            }\n   400\t            Phase::Recover => (),\n   401\t            Phase::None => (),\n   402\t        }\n   403\t    }\n   404\t\n   405\t    pub(crate) fn flush_batch_leader(&mut self) {\n   406\t        let accepted_metadata = self\n   407\t            .internal_storage\n   408\t            .flush_batch_and_get_entries()\n   409\t            .expect(WRITE_ERROR_MSG);\n   410\t        if let Some(metadata) = accepted_metadata {\n   411\t            self.leader_state\n   412\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   413\t            self.send_acceptdecide(metadata);\n   414\t        }\n   415\t    }\n   416\t}\n     1\tuse super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    messages::sequence_paxos::Promise,\n     4\t    storage::{Entry, SnapshotType, StopSign},\n     5\t};\n     6\t#[cfg(feature = \"serde\")]\n     7\tuse serde::{Deserialize, Serialize};\n     8\tuse std::{cmp::Ordering, fmt::Debug, marker::PhantomData};\n     9\t\n    10\t/// Struct used to help another server synchronize their log with the current state of our own log.\n    11\t#[derive(Clone, Debug)]\n    12\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    13\tpub struct LogSync<T>\n    14\twhere\n    15\t    T: Entry,\n    16\t{\n    17\t    /// The decided snapshot.\n    18\t    pub decided_snapshot: Option<SnapshotType<T>>,\n    19\t    /// The log suffix.\n    20\t    pub suffix: Vec<T>,\n    21\t    /// The index of the log where the entries from `suffix` should be applied at (also the compacted idx of `decided_snapshot` if it exists).\n    22\t    pub sync_idx: usize,\n    23\t    /// The accepted StopSign.\n    24\t    pub stopsign: Option<StopSign>,\n    25\t}\n    26\t\n    27\t#[derive(Debug, Clone, Default)]\n    28\t/// Promise without the log update\n    29\tpub(crate) struct PromiseMetaData {\n    30\t    pub n_accepted: Ballot,\n    31\t    pub accepted_idx: usize,\n    32\t    pub decided_idx: usize,\n    33\t    pub pid: NodeId,\n    34\t}\n    35\t\n    36\timpl PartialOrd for PromiseMetaData {\n    37\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n    38\t        let ordering = if self.n_accepted == other.n_accepted\n    39\t            && self.accepted_idx == other.accepted_idx\n    40\t            && self.pid == other.pid\n    41\t        {\n    42\t            Ordering::Equal\n    43\t        } else if self.n_accepted > other.n_accepted\n    44\t            || (self.n_accepted == other.n_accepted && self.accepted_idx > other.accepted_idx)\n    45\t        {\n    46\t            Ordering::Greater\n    47\t        } else {\n    48\t            Ordering::Less\n    49\t        };\n    50\t        Some(ordering)\n    51\t    }\n    52\t}\n    53\t\n    54\timpl PartialEq for PromiseMetaData {\n    55\t    fn eq(&self, other: &Self) -> bool {\n    56\t        self.n_accepted == other.n_accepted\n    57\t            && self.accepted_idx == other.accepted_idx\n    58\t            && self.pid == other.pid\n    59\t    }\n    60\t}\n    61\t\n    62\t#[derive(Debug, Clone)]\n    63\t/// The promise state of a node.\n    64\tenum PromiseState {\n    65\t    /// Not promised to any leader\n    66\t    NotPromised,\n    67\t    /// Promised to my ballot\n    68\t    Promised(PromiseMetaData),\n    69\t    /// Promised to a leader who's ballot is greater than mine\n    70\t    PromisedHigher,\n    71\t}\n    72\t\n    73\t#[derive(Debug, Clone)]\n    74\tpub(crate) struct LeaderState<T>\n    75\twhere\n    76\t    T: Entry,\n    77\t{\n    78\t    pub n_leader: Ballot,\n    79\t    promises_meta: Vec<PromiseState>,\n    80\t    // the sequence number of accepts for each follower where AcceptSync has sequence number = 1\n    81\t    follower_seq_nums: Vec<SequenceNumber>,\n    82\t    pub accepted_indexes: Vec<usize>,\n    83\t    max_promise_meta: PromiseMetaData,\n    84\t    max_promise_sync: Option<LogSync<T>>,\n    85\t    latest_accept_meta: Vec<Option<(Ballot, usize)>>, //  index in outgoing\n    86\t    pub max_pid: usize,\n    87\t    // The number of promises needed in the prepare phase to become synced and\n    88\t    // the number of accepteds needed in the accept phase to decide an entry.\n    89\t    pub quorum: Quorum,\n    90\t}\n    91\t\n    92\timpl<T> LeaderState<T>\n    93\twhere\n    94\t    T: Entry,\n    95\t{\n    96\t    pub fn with(n_leader: Ballot, max_pid: usize, quorum: Quorum) -> Self {\n    97\t        Self {\n    98\t            n_leader,\n    99\t            promises_meta: vec![PromiseState::NotPromised; max_pid],\n   100\t            follower_seq_nums: vec![SequenceNumber::default(); max_pid],\n   101\t            accepted_indexes: vec![0; max_pid],\n   102\t            max_promise_meta: PromiseMetaData::default(),\n   103\t            max_promise_sync: None,\n   104\t            latest_accept_meta: vec![None; max_pid],\n   105\t            max_pid,\n   106\t            quorum,\n   107\t        }\n   108\t    }\n   109\t\n   110\t    fn pid_to_idx(pid: NodeId) -> usize {\n   111\t        (pid - 1) as usize\n   112\t    }\n   113\t\n   114\t    // Resets `pid`'s accept sequence to indicate they are in the next session of accepts\n   115\t    pub fn increment_seq_num_session(&mut self, pid: NodeId) {\n   116\t        let idx = Self::pid_to_idx(pid);\n   117\t        self.follower_seq_nums[idx].session += 1;\n   118\t        self.follower_seq_nums[idx].counter = 0;\n   119\t    }\n   120\t\n   121\t    pub fn next_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   122\t        let idx = Self::pid_to_idx(pid);\n   123\t        self.follower_seq_nums[idx].counter += 1;\n   124\t        self.follower_seq_nums[idx]\n   125\t    }\n   126\t\n   127\t    pub fn get_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   128\t        self.follower_seq_nums[Self::pid_to_idx(pid)]\n   129\t    }\n   130\t\n   131\t    pub fn set_promise(&mut self, prom: Promise<T>, from: NodeId, check_max_prom: bool) -> bool {\n   132\t        let promise_meta = PromiseMetaData {\n   133\t            n_accepted: prom.n_accepted,\n   134\t            accepted_idx: prom.accepted_idx,\n   135\t            decided_idx: prom.decided_idx,\n   136\t            pid: from,\n   137\t        };\n   138\t        if check_max_prom && promise_meta > self.max_promise_meta {\n   139\t            self.max_promise_meta = promise_meta.clone();\n   140\t            self.max_promise_sync = prom.log_sync;\n   141\t        }\n   142\t        self.promises_meta[Self::pid_to_idx(from)] = PromiseState::Promised(promise_meta);\n   143\t        let num_promised = self\n   144\t            .promises_meta\n   145\t            .iter()\n   146\t            .filter(|p| matches!(p, PromiseState::Promised(_)))\n   147\t            .count();\n   148\t        self.quorum.is_prepare_quorum(num_promised)\n   149\t    }\n   150\t\n   151\t    pub fn reset_promise(&mut self, pid: NodeId) {\n   152\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::NotPromised;\n   153\t    }\n   154\t\n   155\t    /// Node `pid` seen with ballot greater than my ballot\n   156\t    pub fn lost_promise(&mut self, pid: NodeId) {\n   157\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::PromisedHigher;\n   158\t    }\n   159\t\n   160\t    pub fn take_max_promise_sync(&mut self) -> Option<LogSync<T>> {\n   161\t        std::mem::take(&mut self.max_promise_sync)\n   162\t    }\n   163\t\n   164\t    pub fn get_max_promise_meta(&self) -> &PromiseMetaData {\n   165\t        &self.max_promise_meta\n   166\t    }\n   167\t\n   168\t    pub fn get_max_decided_idx(&self) -> usize {\n   169\t        self.promises_meta\n   170\t            .iter()\n   171\t            .filter_map(|p| match p {\n   172\t                PromiseState::Promised(m) => Some(m.decided_idx),\n   173\t                _ => None,\n   174\t            })\n   175\t            .max()\n   176\t            .unwrap_or_default()\n   177\t    }\n   178\t\n   179\t    pub fn get_promise_meta(&self, pid: NodeId) -> &PromiseMetaData {\n   180\t        match &self.promises_meta[Self::pid_to_idx(pid)] {\n   181\t            PromiseState::Promised(metadata) => metadata,\n   182\t            _ => panic!(\"No Metadata found for promised follower\"),\n   183\t        }\n   184\t    }\n   185\t\n   186\t    pub fn get_min_all_accepted_idx(&self) -> &usize {\n   187\t        self.accepted_indexes\n   188\t            .iter()\n   189\t            .min()\n   190\t            .expect(\"Should be all initialised to 0!\")\n   191\t    }\n   192\t\n   193\t    pub fn reset_latest_accept_meta(&mut self) {\n   194\t        self.latest_accept_meta = vec![None; self.max_pid];\n   195\t    }\n   196\t\n   197\t    pub fn get_promised_followers(&self) -> Vec<NodeId> {\n   198\t        self.promises_meta\n   199\t            .iter()\n   200\t            .enumerate()\n   201\t            .filter_map(|(idx, x)| match x {\n   202\t                PromiseState::Promised(_) if idx != Self::pid_to_idx(self.n_leader.pid) => {\n   203\t                    Some((idx + 1) as NodeId)\n   204\t                }\n   205\t                _ => None,\n   206\t            })\n   207\t            .collect()\n   208\t    }\n   209\t\n   210\t    /// The pids of peers which have not promised a higher ballot than mine.\n   211\t    pub(crate) fn get_preparable_peers(&self, peers: &[NodeId]) -> Vec<NodeId> {\n   212\t        peers\n   213\t            .iter()\n   214\t            .filter_map(|pid| {\n   215\t                let idx = Self::pid_to_idx(*pid);\n   216\t                match self.promises_meta.get(idx).unwrap() {\n   217\t                    PromiseState::NotPromised => Some(*pid),\n   218\t                    _ => None,\n   219\t                }\n   220\t            })\n   221\t            .collect()\n   222\t    }\n   223\t\n   224\t    pub fn set_latest_accept_meta(&mut self, pid: NodeId, idx: Option<usize>) {\n   225\t        let meta = idx.map(|x| (self.n_leader, x));\n   226\t        self.latest_accept_meta[Self::pid_to_idx(pid)] = meta;\n   227\t    }\n   228\t\n   229\t    pub fn set_accepted_idx(&mut self, pid: NodeId, idx: usize) {\n   230\t        self.accepted_indexes[Self::pid_to_idx(pid)] = idx;\n   231\t    }\n   232\t\n   233\t    pub fn get_latest_accept_meta(&self, pid: NodeId) -> Option<(Ballot, usize)> {\n   234\t        self.latest_accept_meta\n   235\t            .get(Self::pid_to_idx(pid))\n   236\t            .unwrap()\n   237\t            .as_ref()\n   238\t            .copied()\n   239\t    }\n   240\t\n   241\t    pub fn get_decided_idx(&self, pid: NodeId) -> Option<usize> {\n   242\t        match self.promises_meta.get(Self::pid_to_idx(pid)).unwrap() {\n   243\t            PromiseState::Promised(metadata) => Some(metadata.decided_idx),\n   244\t            _ => None,\n   245\t        }\n   246\t    }\n   247\t\n   248\t    pub fn get_accepted_idx(&self, pid: NodeId) -> usize {\n   249\t        *self.accepted_indexes.get(Self::pid_to_idx(pid)).unwrap()\n   250\t    }\n   251\t\n   252\t    pub fn is_chosen(&self, idx: usize) -> bool {\n   253\t        let num_accepted = self\n   254\t            .accepted_indexes\n   255\t            .iter()\n   256\t            .filter(|la| **la >= idx)\n   257\t            .count();\n   258\t        self.quorum.is_accept_quorum(num_accepted)\n   259\t    }\n   260\t}\n   261\t\n   262\t/// The entry read in the log.\n   263\t#[derive(Debug, Clone)]\n   264\tpub enum LogEntry<T>\n   265\twhere\n   266\t    T: Entry,\n   267\t{\n   268\t    /// The entry is decided.\n   269\t    Decided(T),\n   270\t    /// The entry is NOT decided. Might be removed from the log at a later time.\n   271\t    Undecided(T),\n   272\t    /// The entry has been trimmed.\n   273\t    Trimmed(TrimmedIndex),\n   274\t    /// The entry has been snapshotted.\n   275\t    Snapshotted(SnapshottedEntry<T>),\n   276\t    /// This Sequence Paxos instance has been stopped for reconfiguration. The accompanying bool\n   277\t    /// indicates whether the reconfiguration has been decided or not. If it is `true`, then the OmniPaxos instance for the new configuration can be started.\n   278\t    StopSign(StopSign, bool),\n   279\t}\n   280\t\n   281\timpl<T: PartialEq + Entry> PartialEq for LogEntry<T>\n   282\twhere\n   283\t    <T as Entry>::Snapshot: PartialEq,\n   284\t{\n   285\t    fn eq(&self, other: &Self) -> bool {\n   286\t        match (self, other) {\n   287\t            (LogEntry::Decided(v1), LogEntry::Decided(v2)) => v1 == v2,\n   288\t            (LogEntry::Undecided(v1), LogEntry::Undecided(v2)) => v1 == v2,\n   289\t            (LogEntry::Trimmed(idx1), LogEntry::Trimmed(idx2)) => idx1 == idx2,\n   290\t            (LogEntry::Snapshotted(s1), LogEntry::Snapshotted(s2)) => s1 == s2,\n   291\t            (LogEntry::StopSign(ss1, b1), LogEntry::StopSign(ss2, b2)) => ss1 == ss2 && b1 == b2,\n   292\t            _ => false,\n   293\t        }\n   294\t    }\n   295\t}\n   296\t\n   297\t/// Convenience struct for checking if a certain index exists, is compacted or is a StopSign.\n   298\t#[derive(Debug, Clone)]\n   299\tpub(crate) enum IndexEntry {\n   300\t    Entry,\n   301\t    Compacted,\n   302\t    StopSign(StopSign),\n   303\t}\n   304\t\n   305\t#[allow(missing_docs)]\n   306\t#[derive(Debug, Clone)]\n   307\tpub struct SnapshottedEntry<T>\n   308\twhere\n   309\t    T: Entry,\n   310\t{\n   311\t    pub trimmed_idx: TrimmedIndex,\n   312\t    pub snapshot: T::Snapshot,\n   313\t    _p: PhantomData<T>,\n   314\t}\n   315\t\n   316\timpl<T> SnapshottedEntry<T>\n   317\twhere\n   318\t    T: Entry,\n   319\t{\n   320\t    pub(crate) fn with(trimmed_idx: usize, snapshot: T::Snapshot) -> Self {\n   321\t        Self {\n   322\t            trimmed_idx,\n   323\t            snapshot,\n   324\t            _p: PhantomData,\n   325\t        }\n   326\t    }\n   327\t}\n   328\t\n   329\timpl<T: Entry> PartialEq for SnapshottedEntry<T>\n   330\twhere\n   331\t    <T as Entry>::Snapshot: PartialEq,\n   332\t{\n   333\t    fn eq(&self, other: &Self) -> bool {\n   334\t        self.trimmed_idx == other.trimmed_idx && self.snapshot == other.snapshot\n   335\t    }\n   336\t}\n   337\t\n   338\tpub(crate) mod defaults {\n   339\t    pub(crate) const BUFFER_SIZE: usize = 100000;\n   340\t    pub(crate) const BLE_BUFFER_SIZE: usize = 100;\n   341\t    pub(crate) const ELECTION_TIMEOUT: u64 = 1;\n   342\t    pub(crate) const RESEND_MESSAGE_TIMEOUT: u64 = 100;\n   343\t    pub(crate) const FLUSH_BATCH_TIMEOUT: u64 = 200;\n   344\t}\n   345\t\n   346\t#[allow(missing_docs)]\n   347\tpub type TrimmedIndex = usize;\n   348\t\n   349\t/// ID for an OmniPaxos node\n   350\tpub type NodeId = u64;\n   351\t/// ID for an OmniPaxos configuration (i.e., the set of servers in an OmniPaxos cluster)\n   352\tpub type ConfigurationId = u32;\n   353\t\n   354\t/// Error message to display when there was an error reading to the storage implementation.\n   355\tpub const READ_ERROR_MSG: &str = \"Error reading from storage.\";\n   356\t/// Error message to display when there was an error writing to the storage implementation.\n   357\tpub const WRITE_ERROR_MSG: &str = \"Error writing to storage.\";\n   358\t\n   359\t/// Used for checking the ordering of message sequences in the accept phase\n   360\t#[derive(PartialEq, Eq)]\n","exit_code":0,"status":"completed"}}
