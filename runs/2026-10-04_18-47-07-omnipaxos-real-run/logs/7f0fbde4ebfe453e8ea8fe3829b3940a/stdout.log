sage<T>>) {\n321:    pub fn read(&self, idx: usize) -> Option<LogEntry<T>> {\n334:    pub fn read_entries<R>(&self, r: R) -> Option<Vec<LogEntry<T>>>\n345:    pub fn read_decided_suffix(&self, from_idx: usize) -> Option<Vec<LogEntry<T>>> {\n353:    pub fn handle_incoming(&mut self, m: Message<T>) {\n366:    pub fn is_reconfigured(&self) -> Option<StopSign> {\n371:    pub fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n379:    pub fn reconfigure(\n384:        if let Err(config_error) = new_configuration.validate() {\n396:    pub fn reconnected(&mut self, pid: NodeId) {\n403:    pub fn tick(&mut self) {\n418:    pub fn try_become_leader(&mut self) {\n428:    pub fn set_priority(&mut self, p: u32) {\n435:    fn election_timeout(&mut self) {\n445:    pub fn get_ui_states(&self) -> ui::OmniPaxosStates {\n491:    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n26:pub struct Ballot {\n43:    pub fn with(config_id: ConfigurationId, n: u32, priority: u32, pid: NodeId) -> Ballot {\n54:    fn cmp(&self, other: &Self) -> Ordering {\n60:    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n71:pub(crate) struct BallotLeaderElection {\n103:    pub(crate) fn with(config: BLEConfig, recovered_leader: Option<Ballot>) -> Self {\n155:    pub(crate) fn set_priority(&mut self, p: u32) {\n160:    pub(crate) fn outgoing_mut(&mut self) -> &mut Vec<BLEMessage> {\n167:    pub(crate) fn handle(&mut self, m: BLEMessage) {\n175:    pub(crate) fn new_hb_round(&mut self) {\n197:    pub(crate) fn hb_timeout(\n222:    fn update_leader(&mut self) {\n231:    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n260:    fn check_takeover(&mut self) {\n276:    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n290:    fn handle_reply(&mut self, rep: HeartbeatReply) {\n296:    pub(crate) fn get_current_ballot(&self) -> Ballot {\n300:    pub(crate) fn get_ballots(&self) -> Vec<HeartbeatReply> {\n329:    fn from(config: OmniPaxosC