 na,\n    36\t                decided_idx,\n    37\t                accepted_idx,\n    38\t                log_sync: None,\n    39\t            };\n    40\t            self.leader_state.set_promise(my_promise, self.pid, true);\n    41\t            /* initialise longest chosen sequence and update state */\n    42\t            self.state = (Role::Leader, Phase::Prepare);\n    43\t            let prep = Prepare {\n    44\t                n,\n    45\t                decided_idx,\n    46\t                n_accepted: na,\n    47\t                accepted_idx,\n    48\t            };\n    49\t            /* send prepare */\n    50\t            for pid in &self.peers {\n    51\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    52\t                    from: self.pid,\n    53\t                    to: *pid,\n    54\t                    msg: PaxosMsg::Prepare(prep),\n    55\t                }));\n    56\t            }\n    57\t        } else {\n    58\t            self.become_follower();\n    59\t        }\n    60\t    }\n    61\t\n    62\t    pub(crate) fn become_follower(&mut self) {\n    63\t        self.state.0 = Role::Follower;\n    64\t    }\n    65\t\n    66\t    pub(crate) fn handle_preparereq(&mut self, prepreq: PrepareReq, from: NodeId) {\n    67\t        #[cfg(feature = \"logging\")]\n    68\t        debug!(self.logger, \"Incoming message PrepareReq from {}\", from);\n    69\t        if self.state.0 == Role::Leader && prepreq.n <= self.leader_state.n_leader {\n    70\t            self.leader_state.reset_promise(from);\n    71\t            self.leader_state.set_latest_accept_meta(from, None);\n    72\t            self.send_prepare(from);\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub(crate) fn handle_forwarded_proposal(&mut self, mut entries: Vec<T>) {\n    77\t        if !self.accepted_reconfiguration() {\n    78\t            match self.state {\n    79\t                (Role::Leader, Phase::Prepare) => self.buffered_proposals