{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '300,370p'; nl -ba ../agent-source/omnipaxos/src/util.rs | sed -n '359,450p'; nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '345,443p'\"","aggregated_output":"   300\t    }\n   301\t\n   302\t    // Append entries without batching, return the accepted index\n   303\t    pub(crate) fn append_entries_without_batching(\n   304\t        &mut self,\n   305\t        entries: Vec<T>,\n   306\t    ) -> StorageResult<usize> {\n   307\t        let num_new_entries = entries.len();\n   308\t        self.storage.append_entries(entries)?;\n   309\t        self.state_cache.accepted_idx += num_new_entries;\n   310\t        Ok(self.state_cache.accepted_idx)\n   311\t    }\n   312\t\n   313\t    pub(crate) fn sync_log(\n   314\t        &mut self,\n   315\t        accepted_round: Ballot,\n   316\t        decided_idx: usize,\n   317\t        log_sync: Option<LogSync<T>>,\n   318\t    ) -> StorageResult<usize> {\n   319\t        self.state_cache.accepted_round = accepted_round;\n   320\t        self.state_cache.decided_idx = decided_idx;\n   321\t        let mut sync_txn: Vec<StorageOp<T>> = vec![\n   322\t            StorageOp::SetAcceptedRound(accepted_round),\n   323\t            StorageOp::SetDecidedIndex(decided_idx),\n   324\t        ];\n   325\t        if let Some(sync) = log_sync {\n   326\t            match sync.decided_snapshot {\n   327\t                Some(SnapshotType::Complete(c)) => {\n   328\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   329\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   330\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   331\t                    sync_txn.push(StorageOp::SetSnapshot(Some(c)));\n   332\t                }\n   333\t                Some(SnapshotType::Delta(d)) => {\n   334\t                    let mut snapshot = self.create_decided_snapshot()?;\n   335\t                    snapshot.merge(d);\n   336\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   337\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   338\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   339\t                    sync_txn.push(StorageOp::SetSnapshot(Some(snapshot)));\n   340\t                }\n   341\t                None => (),\n   342\t            }\n   343\t            self.state_cache.accepted_idx = sync.sync_idx + sync.suffix.len();\n   344\t            sync_txn.push(StorageOp::AppendOnPrefix(sync.sync_idx, sync.suffix));\n   345\t            match sync.stopsign {\n   346\t                Some(ss) => {\n   347\t                    self.state_cache.stopsign = Some(ss.clone());\n   348\t                    self.state_cache.accepted_idx += 1;\n   349\t                    sync_txn.push(StorageOp::SetStopsign(Some(ss)));\n   350\t                }\n   351\t                None if self.state_cache.stopsign.is_some() => {\n   352\t                    self.state_cache.stopsign = None;\n   353\t                    sync_txn.push(StorageOp::SetStopsign(None));\n   354\t                }\n   355\t                None => (),\n   356\t            }\n   357\t        }\n   358\t        self.storage.write_atomically(sync_txn)?;\n   359\t        Ok(self.state_cache.accepted_idx)\n   360\t    }\n   361\t\n   362\t    fn create_decided_snapshot(&mut self) -> StorageResult<T::Snapshot> {\n   363\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   364\t        self.create_snapshot(log_decided_idx)\n   365\t    }\n   366\t\n   367\t    pub(crate) fn create_snapshot(&self, compact_idx: usize) -> StorageResult<T::Snapshot> {\n   368\t        let current_compacted_idx = self.get_compacted_idx();\n   369\t        if compact_idx < current_compacted_idx {\n   370\t            Err(CompactionErr::TrimmedIndex(current_compacted_idx))?\n   359\t/// Used for checking the ordering of message sequences in the accept phase\n   360\t#[derive(PartialEq, Eq)]\n   361\tpub(crate) enum MessageStatus {\n   362\t    /// Expected message sequence progression\n   363\t    Expected,\n   364\t    /// Identified a message sequence break\n   365\t    DroppedPreceding,\n   366\t    /// An already identified message sequence break\n   367\t    Outdated,\n   368\t}\n   369\t\n   370\t/// Keeps track of the ordering of messages in the accept phase\n   371\t#[derive(Copy, Clone, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\n   372\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   373\tpub struct SequenceNumber {\n   374\t    /// Meant to refer to a TCP session\n   375\t    pub session: u64,\n   376\t    /// The sequence number with respect to a session\n   377\t    pub counter: u64,\n   378\t}\n   379\t\n   380\timpl SequenceNumber {\n   381\t    /// Compares this sequence number with the sequence number of an incoming message.\n   382\t    pub(crate) fn check_msg_status(&self, msg_seq_num: SequenceNumber) -> MessageStatus {\n   383\t        if msg_seq_num.session == self.session && msg_seq_num.counter == self.counter + 1 {\n   384\t            MessageStatus::Expected\n   385\t        } else if msg_seq_num <= *self {\n   386\t            MessageStatus::Outdated\n   387\t        } else {\n   388\t            MessageStatus::DroppedPreceding\n   389\t        }\n   390\t    }\n   391\t}\n   392\t\n   393\tpub(crate) struct LogicalClock {\n   394\t    time: u64,\n   395\t    timeout: u64,\n   396\t}\n   397\t\n   398\timpl LogicalClock {\n   399\t    pub fn with(timeout: u64) -> Self {\n   400\t        Self { time: 0, timeout }\n   401\t    }\n   402\t\n   403\t    pub fn tick_and_check_timeout(&mut self) -> bool {\n   404\t        self.time += 1;\n   405\t        if self.time == self.timeout {\n   406\t            self.time = 0;\n   407\t            true\n   408\t        } else {\n   409\t            false\n   410\t        }\n   411\t    }\n   412\t}\n   413\t\n   414\t/// Flexible quorums can be used to increase/decrease the read and write quorum sizes,\n   415\t/// for different latency vs fault tolerance tradeoffs.\n   416\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n   417\t#[cfg_attr(any(feature = \"serde\", feature = \"toml_config\"), derive(Deserialize))]\n   418\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n   419\tpub struct FlexibleQuorum {\n   420\t    /// The number of nodes a leader needs to consult to get an up-to-date view of the log.\n   421\t    pub read_quorum_size: usize,\n   422\t    /// The number of acknowledgments a leader needs to commit an entry to the log\n   423\t    pub write_quorum_size: usize,\n   424\t}\n   425\t\n   426\t/// The type of quorum used by the OmniPaxos cluster.\n   427\t#[derive(Copy, Clone, Debug)]\n   428\tpub(crate) enum Quorum {\n   429\t    /// Both the read quorum and the write quorums are a majority of nodes\n   430\t    Majority(usize),\n   431\t    /// The read and write quorum sizes are defined by a `FlexibleQuorum`\n   432\t    Flexible(FlexibleQuorum),\n   433\t}\n   434\t\n   435\timpl Quorum {\n   436\t    pub(crate) fn with(flexible_quorum_config: Option<FlexibleQuorum>, num_nodes: usize) -> Self {\n   437\t        match flexible_quorum_config {\n   438\t            Some(FlexibleQuorum {\n   439\t                read_quorum_size,\n   440\t                write_quorum_size,\n   441\t            }) => Quorum::Flexible(FlexibleQuorum {\n   442\t                read_quorum_size,\n   443\t                write_quorum_size,\n   444\t            }),\n   445\t            None => Quorum::Majority(num_nodes / 2 + 1),\n   446\t        }\n   447\t    }\n   448\t\n   449\t    pub(crate) fn is_prepare_quorum(&self, num_nodes: usize) -> bool {\n   450\t        match self {\n   345\t    pub fn read_decided_suffix(&self, from_idx: usize) -> Option<Vec<LogEntry<T>>> {\n   346\t        self.seq_paxos\n   347\t            .internal_storage\n   348\t            .read_decided_suffix(from_idx)\n   349\t            .expect(\"storage error while trying to read decided log suffix\")\n   350\t    }\n   351\t\n   352\t    /// Handle an incoming message\n   353\t    pub fn handle_incoming(&mut self, m: Message<T>) {\n   354\t        match m {\n   355\t            Message::SequencePaxos(p) => self.seq_paxos.handle(p),\n   356\t            Message::BLE(b) => self.ble.handle(b),\n   357\t            #[cfg(feature = \"async_runtime\")]\n   358\t            Message::AsyncRuntime(_) => {\n   359\t                // Runtime-layer messages are consumed by the actor before reaching here.\n   360\t                // If one leaks through (e.g. user hand-delivered), silently ignore.\n   361\t            }\n   362\t        }\n   363\t    }\n   364\t\n   365\t    /// Returns whether this Sequence Paxos has been reconfigured\n   366\t    pub fn is_reconfigured(&self) -> Option<StopSign> {\n   367\t        self.seq_paxos.is_reconfigured()\n   368\t    }\n   369\t\n   370\t    /// Append an entry to the replicated log.\n   371\t    pub fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   372\t        self.seq_paxos.append(entry)\n   373\t    }\n   374\t\n   375\t    /// Propose a cluster reconfiguration. Returns an error if the current configuration has already been stopped\n   376\t    /// by a previous reconfiguration request or if the `new_configuration` is invalid.\n   377\t    /// `new_configuration` defines the cluster-wide configuration settings for the **next** cluster.\n   378\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   379\t    pub fn reconfigure(\n   380\t        &mut self,\n   381\t        new_configuration: ClusterConfig,\n   382\t        metadata: Option<Vec<u8>>,\n   383\t    ) -> Result<(), ProposeErr<T>> {\n   384\t        if let Err(config_error) = new_configuration.validate() {\n   385\t            return Err(ProposeErr::ConfigError(\n   386\t                config_error,\n   387\t                new_configuration,\n   388\t                metadata,\n   389\t            ));\n   390\t        }\n   391\t        self.seq_paxos.reconfigure(new_configuration, metadata)\n   392\t    }\n   393\t\n   394\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   395\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   396\t    pub fn reconnected(&mut self, pid: NodeId) {\n   397\t        self.seq_paxos.reconnected(pid)\n   398\t    }\n   399\t\n   400\t    /// Increments the internal logical clock. This drives the processes for leader changes, resending dropped messages, and flushing batched log entries.\n   401\t    /// Each of these is triggered every `election_tick_timeout`, `resend_message_tick_timeout`, and `flush_batch_tick_timeout` number of calls to this function\n   402\t    /// (See how to configure these timeouts in `ServerConfig`).\n   403\t    pub fn tick(&mut self) {\n   404\t        if self.election_clock.tick_and_check_timeout() {\n   405\t            self.election_timeout();\n   406\t        }\n   407\t        if self.resend_message_clock.tick_and_check_timeout() {\n   408\t            self.seq_paxos.resend_message_timeout();\n   409\t        }\n   410\t        if self.flush_batch_clock.tick_and_check_timeout() {\n   411\t            self.seq_paxos.flush_batch_timeout();\n   412\t        }\n   413\t    }\n   414\t\n   415\t    /// Manually attempt to become the leader by incrementing this instance's Ballot. Calling this\n   416\t    /// function may not result in gainig leadership if other instances are competing for\n   417\t    /// leadership with higher Ballots.\n   418\t    pub fn try_become_leader(&mut self) {\n   419\t        let mut my_ballot = self.ble.get_current_ballot();\n   420\t        let promise = self.seq_paxos.get_promise();\n   421\t        my_ballot.n = promise.n + 1;\n   422\t        self.seq_paxos.handle_leader(my_ballot);\n   423\t    }\n   424\t\n   425\t    /*** BLE calls ***/\n   426\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   427\t    /// priority triggers a leader re-election.\n   428\t    pub fn set_priority(&mut self, p: u32) {\n   429\t        self.ble.set_priority(p)\n   430\t    }\n   431\t\n   432\t    /// If the heartbeat of a leader is not received when election_timeout() is called, the server might attempt to become the leader.\n   433\t    /// It is also used for the election process, where the server checks if it can become the leader.\n   434\t    /// For instance if `election_timeout()` is called every 100ms, then if the leader fails, the servers will detect it after 100ms and elect a new server after another 100ms if possible.\n   435\t    fn election_timeout(&mut self) {\n   436\t        if let Some(new_leader) = self\n   437\t            .ble\n   438\t            .hb_timeout(self.seq_paxos.get_state(), self.seq_paxos.get_promise())\n   439\t        {\n   440\t            self.seq_paxos.handle_leader(new_leader);\n   441\t        }\n   442\t    }\n   443\t\n","exit_code":0,"status":"completed"}}
