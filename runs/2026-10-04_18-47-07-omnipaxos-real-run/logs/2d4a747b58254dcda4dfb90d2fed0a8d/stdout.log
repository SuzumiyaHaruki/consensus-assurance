"protections\": []\n      },\n      {\n        \"behavior_id\": \"b-election\",\n        \"activity\": \"A2\",\n        \"unknowns\": [\n          \"Heartbeat reply accumulation counts vector entries; participant uniqueness and duplicate-delivery assumptions need source investigation.\"\n        ],\n        \"source_ids\": [\n          \"src-api\",\n          \"src-ble\"\n        ],\n        \"protections\": []\n      }\n    ],\n    \"surfaces\": [\n      {\n        \"entry_point\": \"SequencePaxos::handle_acceptsync\",\n        \"disposition\": \"mapped\",\n        \"behavior_ids\": [\n          \"b-follow\"\n        ],\n        \"reason\": \"Does same-ballot recovery admit stale synchronization history after a later decision? Ballot/phase checks protect ordinary delivery; legal overlapping sessions and transport duties remain unresolved.\",\n        \"source_ids\": [\n          \"src-follower\",\n          \"src-leader\",\n          \"src-sync\",\n          \"src-order\"\n        ],\n        \"high_consequence\": true\n      },\n      {\n        \"entry_point\": \"BallotLeaderElection::handle_reply\",\n        \"disposition\": \"mapped\",\n        \"behavior_ids\": [\n          \"b-election\"\n        ],\n        \"reason\": \"What ensures heartbeat support counts distinct eligible participants when replies are appended to a vector?\",\n        \"source_ids\": [\n          \"src-ble\"\n        ],\n        \"high_consequence\": false\n      }\n    ],\n    \"core_regions\": [\n      {\n        \"activity\": \"A1\",\n        \"entries\": [\n          {\n            \"class_id\": \"A1\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Qualified support for decision formation and legal advancement\",\n            \"realization_summary\": \"Prepare quorum selects accepted history; acceptance quorum advances decided prefix.\",\n            \"entry_points\": [],\n            \"behavior_ids\": [\n              \"b-formation\",\n              \"b