{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"grep -RniE 'fifo|reorder|duplicat|reliable|TCP|ordering' ../agent-source/docs ../agent-source/omnipaxos/src ../agent-source/omnipaxos_runtime/README.md | head -65; nl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '1,77p;175,223p'; cat ../agent-source/omnipaxos/src/storage/state_cache.rs | head -120; nl -ba ../agent-source/omnipaxos/src/storage/mod.rs | sed -n '95,270p'\"","aggregated_output":"    95\t}\n    96\t\n    97\t/// The Result type returned by the storage API.\n    98\tpub type StorageResult<T> = Result<T, Box<dyn Error>>;\n    99\t\n   100\t/// The write operations of the storge implementation.\n   101\t#[derive(Debug)]\n   102\tpub enum StorageOp<T: Entry> {\n   103\t    /// Appends an entry to the end of the log.\n   104\t    AppendEntry(T),\n   105\t    /// Appends entries to the end of the log.\n   106\t    AppendEntries(Vec<T>),\n   107\t    /// Appends entries to the log from the prefix specified by the given index.\n   108\t    AppendOnPrefix(usize, Vec<T>),\n   109\t    /// Sets the round that has been promised.\n   110\t    SetPromise(Ballot),\n   111\t    /// Sets the decided index in the log.\n   112\t    SetDecidedIndex(usize),\n   113\t    /// Sets the latest accepted round.\n   114\t    SetAcceptedRound(Ballot),\n   115\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   116\t    SetCompactedIdx(usize),\n   117\t    /// Removes elements up to the given idx from storage.\n   118\t    Trim(usize),\n   119\t    /// Sets the StopSign used for reconfiguration.\n   120\t    SetStopsign(Option<StopSign>),\n   121\t    /// Sets the snapshot.\n   122\t    SetSnapshot(Option<T::Snapshot>),\n   123\t}\n   124\t\n   125\t/// Trait for implementing the storage backend of Sequence Paxos.\n   126\tpub trait Storage<T>\n   127\twhere\n   128\t    T: Entry,\n   129\t{\n   130\t    /// **Atomically** perform all storage operations in order.\n   131\t    /// For correctness, the operations must be atomic i.e., either all operations are performed\n   132\t    /// successfully or all get rolled back. If the `StorageResult` returns as `Err`, the\n   133\t    /// operations are assumed to have been rolled back to the previous state before this function\n   134\t    /// call.\n   135\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()>;\n   136\t\n   137\t    /// Appends an entry to the end of the log.\n   138\t    fn append_entry(&mut self, entry: T) -> StorageResult<()>;\n   139\t\n   140\t    /// Appends the entries of `entries` to the end of the log.\n   141\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()>;\n   142\t\n   143\t    /// Appends the entries of `entries` to the prefix from index `from_index` (inclusive) in the log.\n   144\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()>;\n   145\t\n   146\t    /// Sets the round that has been promised.\n   147\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()>;\n   148\t\n   149\t    /// Sets the decided index in the log.\n   150\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()>;\n   151\t\n   152\t    /// Returns the decided index in the log.\n   153\t    fn get_decided_idx(&self) -> StorageResult<usize>;\n   154\t\n   155\t    /// Sets the latest accepted round.\n   156\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()>;\n   157\t\n   158\t    /// Returns the latest round in which entries have been accepted, returns `None` if no\n   159\t    /// entries have been accepted.\n   160\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>>;\n   161\t\n   162\t    /// Returns the entries in the log in the index interval of [from, to).\n   163\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   164\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>>;\n   165\t\n   166\t    /// Returns the current length of the log (without the trimmed/snapshotted entries).\n   167\t    fn get_log_len(&self) -> StorageResult<usize>;\n   168\t\n   169\t    /// Returns the suffix of entries in the log from index `from` (inclusive).\n   170\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   171\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>>;\n   172\t\n   173\t    /// Returns the round that has been promised.\n   174\t    fn get_promise(&self) -> StorageResult<Option<Ballot>>;\n   175\t\n   176\t    /// Sets the StopSign used for reconfiguration.\n   177\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()>;\n   178\t\n   179\t    /// Returns the stored StopSign, returns `None` if no StopSign has been stored.\n   180\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>>;\n   181\t\n   182\t    /// Removes elements up to the given [`idx`] from storage.\n   183\t    fn trim(&mut self, idx: usize) -> StorageResult<()>;\n   184\t\n   185\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   186\t    fn set_compacted_idx(&mut self, idx: usize) -> StorageResult<()>;\n   187\t\n   188\t    /// Returns the garbage collector index from storage.\n   189\t    fn get_compacted_idx(&self) -> StorageResult<usize>;\n   190\t\n   191\t    /// Sets the snapshot.\n   192\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()>;\n   193\t\n   194\t    /// Returns the stored snapshot.\n   195\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>>;\n   196\t}\n   197\t\n   198\t/// A place holder type for when not using snapshots. You should not use this type, it is only internally when deriving the Entry implementation.\n   199\t#[derive(Copy, Clone, Debug, Eq, PartialEq)]\n   200\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   201\tpub struct NoSnapshot;\n   202\t\n   203\timpl<T: Entry> Snapshot<T> for NoSnapshot {\n   204\t    fn create(_entries: &[T]) -> Self {\n   205\t        panic!(\"NoSnapshot should not be created\");\n   206\t    }\n   207\t\n   208\t    fn merge(&mut self, _delta: Self) {\n   209\t        panic!(\"NoSnapshot should not be merged\");\n   210\t    }\n   211\t\n   212\t    fn use_snapshots() -> bool {\n   213\t        false\n   214\t    }\n   215\t}\n","exit_code":0,"status":"completed"}}
