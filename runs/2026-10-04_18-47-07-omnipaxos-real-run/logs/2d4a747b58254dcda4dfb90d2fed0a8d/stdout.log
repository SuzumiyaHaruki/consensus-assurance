{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '1,280p'; cat ../agent-source/omnipaxos_runtime/src/event.rs | head -140; cat ../agent-source/omnipaxos_runtime/Cargo.toml; grep -nE 'supersed|leader|notify|batch' ../agent-source/omnipaxos_runtime/tests/async_runtime_test.rs | head -75; cat ../agent-source/omnipaxos_runtime/src/traits.rs\"","aggregated_output":"     1\tuse core::time::Duration;\n     2\tuse std::marker::PhantomData;\n     3\t\n     4\tuse futures::channel::oneshot;\n     5\t\n     6\tuse omnipaxos::{\n     7\t    messages::Message,\n     8\t    storage::{Entry, Storage},\n     9\t    util::{LogEntry, NodeId},\n    10\t    ClusterConfig, OmniPaxos,\n    11\t};\n    12\t\n    13\tuse super::{\n    14\t    actor::{run, ActorConfig, ActorState},\n    15\t    event::{AppendError, Command, OmniPaxosEvent, RuntimeProposeErr},\n    16\t    traits::{ActorEntry, AsyncRuntime},\n    17\t};\n    18\t\n    19\t/// Configuration for the async runtime actor.\n    20\t#[derive(Debug, Clone)]\n    21\tpub struct RuntimeConfig {\n    22\t    /// How often the actor calls `tick()` on the underlying OmniPaxos.\n    23\t    /// Should match the tick timeout budget used when building `ServerConfig`.\n    24\t    pub tick_period: Duration,\n    25\t    /// How often outgoing messages are drained and forwarded on the `outgoing_messages`\n    26\t    /// channel.\n    27\t    pub egress_period: Duration,\n    28\t    /// Bounded capacity for the actor's command channel.\n    29\t    pub cmd_channel_capacity: usize,\n    30\t    /// Bounded capacity for the outgoing message channel.\n    31\t    pub outgoing_capacity: usize,\n    32\t    /// Bounded capacity for the incoming message channel.\n    33\t    pub incoming_capacity: usize,\n    34\t    /// Bounded capacity for the event channel.\n    35\t    pub event_capacity: usize,\n    36\t    /// How long an `append_notify` call waits for its entry to be decided before\n    37\t    /// resolving with [`AppendError::Timeout`](super::AppendError::Timeout).\n    38\t    pub append_notify_timeout: Duration,\n    39\t    /// Bounded capacity for each per-subscriber decided-log stream returned by\n    40\t    /// [`OmniPaxosHandle::subscribe_decided`].\n    41\t    pub decided_channel_capacity: usize,\n    42\t    /// Maximum number of concurrently outstanding `append_notify` calls (i.e.\n    43\t    /// calls that have not yet resolved). Once reached, further `append_notify`\n    44\t    /// calls are rejected immediately with [`AppendError::TooManyOutstanding`]\n    45\t    /// rather than queued, so a stalled cluster (e.g. no leader) can't grow this\n    46\t    /// backlog without bound.\n    47\t    pub max_pending_appends: usize,\n    48\t    /// Maximum number of concurrent [`OmniPaxosHandle::subscribe_decided`]\n    49\t    /// subscribers. Once reached, a new subscription is rejected: the returned\n    50\t    /// receiver's channel is closed immediately without delivering any entries.\n    51\t    pub max_decided_subscribers: usize,\n    52\t    /// Fallback cap on how many outgoing messages the actor buffers internally\n    53\t    /// while waiting for room on the (bounded) `outgoing_messages` channel,\n    54\t    /// used only if that channel's own capacity can't be read. Past this cap,\n    55\t    /// the *oldest* buffered messages are dropped rather than growing without\n    56\t    /// bound -- safe because OmniPaxos already tolerates lost messages via its\n    57\t    /// own resend/retry mechanisms.\n    58\t    pub max_outgoing_buffered: usize,\n    59\t}\n    60\t\n    61\timpl Default for RuntimeConfig {\n    62\t    fn default() -> Self {\n    63\t        Self {\n    64\t            tick_period: Duration::from_millis(10),\n    65\t            egress_period: Duration::from_millis(1),\n    66\t            cmd_channel_capacity: 1024,\n    67\t            outgoing_capacity: 10_000,\n    68\t            incoming_capacity: 10_000,\n    69\t            event_capacity: 1024,\n    70\t            append_notify_timeout: Duration::from_secs(5),\n    71\t            decided_channel_capacity: 1024,\n    72\t            max_pending_appends: 1024,\n    73\t            max_decided_subscribers: 128,\n    74\t            max_outgoing_buffered: 10_000,\n    75\t        }\n    76\t    }\n    77\t}\n    78\t\n    79\t/// A cloneable, `Send + Sync` handle to an OmniPaxos actor running in the background.\n    80\t///\n    81\t/// All state-mutating and read methods are `async`. Users must drive message transport\n    82\t/// externally via [`OmniPaxosHandle::outgoing_messages`] and\n    83\t/// [`OmniPaxosHandle::handle_incoming`]. Dropping every clone shuts the actor down.\n    84\tpub struct OmniPaxosHandle<T>\n    85\twhere\n    86\t    T: Entry,\n    87\t{\n    88\t    cmd_tx: async_channel::Sender<Command<T>>,\n    89\t    events_rx: async_channel::Receiver<OmniPaxosEvent>,\n    90\t    outgoing_rx: async_channel::Receiver<Message<T>>,\n    91\t    incoming_tx: async_channel::Sender<Message<T>>,\n    92\t    decided_channel_capacity: usize,\n    93\t}\n    94\t\n    95\timpl<T> Clone for OmniPaxosHandle<T>\n    96\twhere\n    97\t    T: Entry,\n    98\t{\n    99\t    fn clone(&self) -> Self {\n   100\t        Self {\n   101\t            cmd_tx: self.cmd_tx.clone(),\n   102\t            events_rx: self.events_rx.clone(),\n   103\t            outgoing_rx: self.outgoing_rx.clone(),\n   104\t            incoming_tx: self.incoming_tx.clone(),\n   105\t            decided_channel_capacity: self.decided_channel_capacity,\n   106\t        }\n   107\t    }\n   108\t}\n   109\t\n   110\timpl<T> OmniPaxosHandle<T>\n   111\twhere\n   112\t    T: Entry + Send + 'static,\n   113\t{\n   114\t    /// Append an entry and await its decided log index.\n   115\t    ///\n   116\t    /// Works from any node: the actor tags the entry with a unique id, routes it to\n   117\t    /// the current leader, and resolves the future when the assigned log index is\n   118\t    /// decided. If no leader is known yet, the call waits rather than failing fast --\n   119\t    /// it resolves once a leader is elected, or with `Timeout` if none is elected in\n   120\t    /// time. Fails with:\n   121\t    /// - [`AppendError::Timeout`] if the entry is not decided within\n   122\t    ///   [`RuntimeConfig::append_notify_timeout`] (including when no leader was ever\n   123\t    ///   elected in that time);\n   124\t    /// - [`AppendError::Propose`] if the underlying propose call itself failed (e.g. a\n   125\t    ///   reconfiguration is already pending) -- only when this node owns the pending\n   126\t    ///   call, otherwise it still resolves via `Timeout`;\n   127\t    /// - [`AppendError::Superseded`] if a leader change occurred before decision --\n   128\t    ///   a heuristic, not a certainty; see its doc comment for why, and check the\n   129\t    ///   returned index yourself if you need to know for sure;\n   130\t    /// - [`AppendError::TooManyOutstanding`] if [`RuntimeConfig::max_pending_appends`]\n   131\t    ///   outstanding calls are already queued.\n   132\t    ///\n   133\t    /// Uses [`RuntimeConfig::append_notify_timeout`] as the deadline; use\n   134\t    /// [`Self::append_notify_with_timeout`] to override it for a single call.\n   135\t    pub async fn append_notify(&self, entry: T) -> Result<usize, AppendError<T>> {\n   136\t        self.append_notify_inner(entry, None).await\n   137\t    }\n   138\t\n   139\t    /// Same as [`append_notify`](Self::append_notify), but `timeout` overrides\n   140\t    /// [`RuntimeConfig::append_notify_timeout`] for this call only -- e.g. to give a\n   141\t    /// latency-sensitive caller a shorter deadline, or a bulk/background caller a\n   142\t    /// longer one, without changing the default for every other call.\n   143\t    pub async fn append_notify_with_timeout(\n   144\t        &self,\n   145\t        entry: T,\n   146\t        timeout: Duration,\n   147\t    ) -> Result<usize, AppendError<T>> {\n   148\t        self.append_notify_inner(entry, Some(timeout)).await\n   149\t    }\n   150\t\n   151\t    async fn append_notify_inner(\n   152\t        &self,\n   153\t        entry: T,\n   154\t        timeout: Option<Duration>,\n   155\t    ) -> Result<usize, AppendError<T>> {\n   156\t        let (tx, rx) = oneshot::channel();\n   157\t        self.cmd_tx\n   158\t            .send(Command::AppendNotify {\n   159\t                entry,\n   160\t                timeout,\n   161\t                reply: tx,\n   162\t            })\n   163\t            .await\n   164\t            .map_err(|_| AppendError::Shutdown)?;\n   165\t        rx.await.unwrap_or(Err(AppendError::Shutdown))\n   166\t    }\n   167\t\n   168\t    /// Append an entry without waiting for decision. Mirrors the sync API.\n   169\t    pub async fn append(&self, entry: T) -> Result<(), RuntimeProposeErr<T>> {\n   170\t        let (tx, rx) = oneshot::channel();\n   171\t        self.cmd_tx\n   172\t            .send(Command::Append { entry, reply: tx })\n   173\t            .await\n   174\t            .map_err(|_| RuntimeProposeErr::Shutdown)?;\n   175\t        match rx.await {\n   176\t            Ok(res) => res.map_err(RuntimeProposeErr::Propose),\n   177\t            Err(_) => Err(RuntimeProposeErr::Shutdown),\n   178\t        }\n   179\t    }\n   180\t\n   181\t    /// Ask the actor for the current leader.\n   182\t    pub async fn current_leader(&self) -> Option<(NodeId, bool)> {\n   183\t        let (tx, rx) = oneshot::channel();\n   184\t        if self\n   185\t            .cmd_tx\n   186\t            .send(Command::CurrentLeader { reply: tx })\n   187\t            .await\n   188\t            .is_err()\n   189\t        {\n   190\t            return None;\n   191\t        }\n   192\t        rx.await.unwrap_or(None)\n   193\t    }\n   194\t\n   195\t    /// Ask the actor for the current decided index.\n   196\t    pub async fn decided_idx(&self) -> usize {\n   197\t        let (tx, rx) = oneshot::channel();\n   198\t        if self\n   199\t            .cmd_tx\n   200\t            .send(Command::DecidedIdx { reply: tx })\n   201\t            .await\n   202\t            .is_err()\n   203\t        {\n   204\t            return 0;\n   205\t        }\n   206\t        rx.await.unwrap_or(0)\n   207\t    }\n   208\t\n   209\t    /// Ask the actor for a slice of the decided log starting at `from`.\n   210\t    pub async fn read_decided_suffix(&self, from: usize) -> Option<Vec<LogEntry<T>>> {\n   211\t        let (tx, rx) = oneshot::channel();\n   212\t        if self\n   213\t            .cmd_tx\n   214\t            .send(Command::ReadDecidedSuffix { from, reply: tx })\n   215\t            .await\n   216\t            .is_err()\n   217\t        {\n   218\t            return None;\n   219\t        }\n   220\t        rx.await.unwrap_or(None)\n   221\t    }\n   222\t\n   223\t    /// Propose a cluster reconfiguration.\n   224\t    pub async fn reconfigure(\n   225\t        &self,\n   226\t        new_configuration: ClusterConfig,\n   227\t        metadata: Option<Vec<u8>>,\n   228\t    ) -> Result<(), RuntimeProposeErr<T>> {\n   229\t        let (tx, rx) = oneshot::channel();\n   230\t        self.cmd_tx\n   231\t            .send(Command::Reconfigure {\n   232\t                new_configuration,\n   233\t                metadata,\n   234\t                reply: tx,\n   235\t            })\n   236\t            .await\n   237\t            .map_err(|_| RuntimeProposeErr::Shutdown)?;\n   238\t        match rx.await {\n   239\t            Ok(res) => res.map_err(RuntimeProposeErr::Propose),\n   240\t            Err(_) => Err(RuntimeProposeErr::Shutdown),\n   241\t        }\n   242\t    }\n   243\t\n   244\t    /// Attempt to become the leader by incrementing the local ballot.\n   245\t    pub async fn try_become_leader(&self) {\n   246\t        let _ = self.cmd_tx.send(Command::TryBecomeLeader).await;\n   247\t    }\n   248\t\n   249\t    /// Notify the actor that a previously disconnected peer is reachable again.\n   250\t    pub async fn reconnected(&self, pid: NodeId) {\n   251\t        let _ = self.cmd_tx.send(Command::Reconnected { pid }).await;\n   252\t    }\n   253\t\n   254\t    /// Subscribe to state-transition events. Each event is delivered to exactly one\n   255\t    /// receiver: if you clone the returned receiver, the clones share the queue.\n   256\t    /// For fan-out to multiple independent subscribers, wrap in a broadcasting task.\n   257\t    pub fn subscribe_events(&self) -> async_channel::Receiver<OmniPaxosEvent> {\n   258\t        self.events_rx.clone()\n   259\t    }\n   260\t\n   261\t    /// Subscribe to decided log entries, starting at `from`. Returns a receiver\n   262\t    /// that emits [`LogEntry`]s in log order — both the backlog already decided\n   263\t    /// at subscription time and entries decided later.\n   264\t    ///\n   265\t    /// Each call creates an independent subscription with its own cursor;\n   266\t    /// multiple subscribers can coexist, up to [`RuntimeConfig::max_decided_subscribers`]\n   267\t    /// — beyond that, the returned receiver's channel is closed immediately\n   268\t    /// without delivering any entries. Dropping the receiver ends the\n   269\t    /// subscription; slow subscribers apply backpressure by causing the actor\n   270\t    /// to defer pushes rather than blocking the actor loop.\n   271\t    pub async fn subscribe_decided(&self, from: usize) -> async_channel::Receiver<LogEntry<T>> {\n   272\t        let (tx, rx) = async_channel::bounded(self.decided_channel_capacity);\n   273\t        // If the actor is gone, `rx` stays open but never receives — the\n   274\t        // caller's stream drops naturally when the sender is dropped here.\n   275\t        let _ = self\n   276\t            .cmd_tx\n   277\t            .send(Command::SubscribeDecided { from, tx })\n   278\t            .await;\n   279\t        rx\n   280\t    }\nuse core::time::Duration;\n\nuse futures::channel::oneshot;\n\nuse omnipaxos::{\n    storage::Entry,\n    util::{LogEntry, NodeId},\n    ClusterConfig, ProposeErr,\n};\n\n/// A state transition observed by the actor and broadcast on the event stream.\n#[derive(Debug, Clone)]\npub enum OmniPaxosEvent {\n    /// A new leader was observed on this node.\n    LeaderElected {\n        /// The pid of the elected leader.\n        pid: NodeId,\n        /// Whether this node's phase is `Phase::Accept`.\n        accepted: bool,\n    },\n    /// The decided index advanced. The value is the new decided index.\n    Decided {\n        /// The new decided index.\n        new_decided_idx: usize,\n    },\n    /// A reconfiguration StopSign was decided.\n    Reconfigured {\n        /// The log index at which the StopSign was decided.\n        stop_sign_idx: usize,\n    },\n}\n\n/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n#[derive(Debug)]\npub enum AppendError<T>\nwhere\n    T: Entry,\n{\n    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n    /// pending). Unlike the other variants, this is resolved immediately rather than\n    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n    /// leader). If the failure happens on a different node than the origin, the origin\n    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n    /// require a new wire message.\n    Propose(ProposeErr<T>),\n    /// A leader change occurred after the entry was accepted at the given index but\n    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n    /// required to adopt any value a majority-overlapping quorum may have already\n    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n    /// new ballot -- we just stop waiting rather than confirm it. Check\n    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n    /// at that index if you need to know for sure before re-appending.\n    Superseded {\n        /// The log index the entry was assigned before the leader change.\n        log_entry_idx: usize,\n    },\n    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n    Timeout,\n    /// The actor has shut down before the entry could be decided.\n    Shutdown,\n    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n    /// outstanding `append_notify` calls; this one was rejected immediately rather\n    /// than queued. Nothing was proposed, so it's safe to retry (ideally after a\n    /// backoff, since the backlog needs time to drain).\n    TooManyOutstanding,\n}\n\n/// Error returned by [`OmniPaxosHandle::append`](super::OmniPaxosHandle::append) and\n/// [`OmniPaxosHandle::reconfigure`](super::OmniPaxosHandle::reconfigure). Distinct from\n/// [`AppendError`]: these calls don't track decision, so they only ever fail\n/// synchronously -- either the propose call itself was rejected, or the actor is gone.\n#[derive(Debug)]\npub enum RuntimeProposeErr<T>\nwhere\n    T: Entry,\n{\n    /// The underlying propose call failed (e.g. a reconfiguration is already pending,\n    /// or an invalid cluster config was proposed).\n    Propose(ProposeErr<T>),\n    /// The actor has shut down.\n    Shutdown,\n}\n\n/// Commands sent from an [`OmniPaxosHandle`](super::OmniPaxosHandle) to the actor task.\n///\n/// This type is `pub(crate)` because it is an implementation detail of the actor <-> handle\n/// protocol.\npub(crate) enum Command<T>\nwhere\n    T: Entry,\n{\n    Append {\n        entry: T,\n        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n    },\n    AppendNotify {\n        entry: T,\n        /// Overrides [`RuntimeConfig::append_notify_timeout`](super::RuntimeConfig::append_notify_timeout)\n        /// for this call only, if `Some`.\n        timeout: Option<Duration>,\n        reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n    },\n    CurrentLeader {\n        reply: oneshot::Sender<Option<(NodeId, bool)>>,\n    },\n    DecidedIdx {\n        reply: oneshot::Sender<usize>,\n    },\n    ReadDecidedSuffix {\n        from: usize,\n        reply: oneshot::Sender<Option<Vec<LogEntry<T>>>>,\n    },\n    SubscribeDecided {\n        from: usize,\n        tx: async_channel::Sender<LogEntry<T>>,\n    },\n    Reconfigure {\n        new_configuration: ClusterConfig,\n        metadata: Option<Vec<u8>>,\n        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n    },\n    TryBecomeLeader,\n    Reconnected {\n        pid: NodeId,\n    },\n}\n[package]\nname = \"omnipaxos_runtime\"\nversion = \"0.1.0\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"Async runtime actor layer for OmniPaxos.\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\nkeywords = [\"omnipaxos\", \"paxos\", \"consensus\", \"distributed-systems\", \"async\"]\ncategories = [\"asynchronous\", \"concurrency\", \"network-programming\"]\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nomnipaxos = { version = \"0.2.3\", path = \"../omnipaxos\", features = [\"async_runtime\"] }\nfutures = \"0.3\"\nasync-channel = \"2\"\nfutures-timer = \"3\"\nuuid = { version = \"1\", features = [\"v4\"] }\ntokio = { version = \"1\", optional = true, features = [\"rt\", \"time\", \"sync\", \"macros\"] }\n\n[dev-dependencies]\nomnipaxos_storage = { version = \"0.2.2\", path = \"../omnipaxos_storage\" }\ntokio = { version = \"1\", features = [\"rt-multi-thread\", \"sync\", \"time\", \"macros\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\n\n[features]\ntokio_runtime = [\"dep:tokio\"]\nunicache = [\"omnipaxos/unicache\"]\nserde = [\"omnipaxos/serde\"]\nlogging = [\"omnipaxos/logging\"]\n108:        batch_size: 1,\n109:        flush_batch_tick_timeout: 100,\n110:        leader_priority: 0,\n162:    batch_size: usize,\n163:    append_notify_timeout: Duration,\n173:        append_notify_timeout,\n190:            batch_size,\n191:            flush_batch_tick_timeout: 100,\n192:            leader_priority: 0,\n226:async fn wait_for_leader(handles: &HashMap<NodeId, OmniPaxosHandle<TestEntry>>) -> NodeId {\n231:            if let Some((pid, true)) = h.current_leader().await {\n236:            panic!(\"no leader elected within {:?}\", deadline);\n243:async fn append_notify_resolves_after_decision() {\n245:    let leader = wait_for_leader(&handles).await;\n246:    let leader_h = handles.get(&leader).unwrap().clone();\n250:        leader_h.append_notify(TestEntry(42)),\n253:    .expect(\"append_notify did not resolve in time\")\n254:    .expect(\"append_notify returned error\");\n258:    let entries = leader_h.read_decided_suffix(0).await.expect(\"no entries\");\n263:async fn append_notify_from_follower_resolves() {\n265:    let leader = wait_for_leader(&handles).await;\n266:    let follower_pid = *handles.keys().find(|&&p| p != leader).unwrap();\n271:        follower.append_notify(TestEntry(99)),\n274:    .expect(\"follower append_notify did not resolve in time\")\n275:    .expect(\"follower append_notify returned error\");\n279:        \"expected non-zero decided idx from follower append_notify, got {idx}\"\n286:        \"follower's decided suffix should be non-empty after append_notify\"\n290:/// Regression test: a follower's `append_notify`, forwarded to the leader via\n291:/// `TaggedProposal`, used to never get an `Assigned` reply if the leader\n292:/// deferred it by batching -- the leader's own `accept_as_leader` returned\n294:/// only sent `Assigned` for entries accepted *immediately*. `batch_size = 2`\n296:/// batch, so it can only flush once `flush_batch_tick_timeout` forces it --\n299:async fn append_notify_from_follower_resolves_when_batched_and_deferred() {\n301:    let leader = wait_for_leader(&handles).await;\n302:    let follower_pid = *handles.keys().find(|&&p| p != leader).unwrap();\n307:        follower_h.append_notify(TestEntry(7)),\n310:    .expect(\"append_notify hung\")\n312:        \"append_notify should eventually succeed even when deferred by \\\n313:             batching on a remote leader\",\n318:/// Regression test: a follower's plain `.append()` is routed to the leader\n320:/// tracking layer -- and enters the exact same shared per-node batch buffer\n321:/// as a concurrently-batched `append_notify` entry, with no placeholder in\n323:/// tracked entry was assigned once the batch flushed -- but only when the\n325:/// the batch always resolves correctly, since it's provably the last one\n327:/// ones after it, batch_size sized so multiple untracked entries are needed\n328:/// to fill the batch: with more than one competitor after it, the tracked\n333:/// entry pushed *first* or *last* in the batch always resolves correctly\n340:async fn append_notify_index_correct_when_batched_with_forwarded_proposal() {\n342:    let leader = wait_for_leader(&handles).await;\n344:        let mut followers = handles.keys().copied().filter(|&p| p != leader);\n347:    let h_notify = handles.get(&f2).unwrap().clone();\n354:    // leader before the next one is submitted -- submission order alone\n355:    // doesn't imply leader-arrival order.\n364:    let n1 = tokio::spawn(async move { h_notify.append_notify(send_n).await });\n374:        .expect(\"append_notify hung\")\n376:        .expect(\"append_notify should succeed\");\n378:    let leader_h = handles.get(&leader).unwrap().clone();\n381:            if leader_h.decided_idx().await >= idx {\n382:                return leader_h\n400:/// Regression test: `append_tracked` used to infer \"deferred by batching\"\n404:/// the shared batch buffer at all. That pushed a spurious placeholder into\n407:/// same node becomes leader. Forces exactly that: a plain append while still\n408:/// a follower, then promotes that node to leader and checks two\n409:/// batch-deferred `append_notify` entries resolve to their real content.\n411:async fn append_notify_index_correct_after_follower_plain_append_then_becomes_leader() {\n413:    let leader1 = wait_for_leader(&handles).await;\n414:    let candidate = *handles.keys().find(|&&p| p != leader1).unwrap();\n423:    // Force `candidate` to become the new leader.\n424:    candidate_h.try_become_leader().await;\n427:            if let Some((pid, true)) = candidate_h.current_leader().await {\n436:    .expect(\"candidate never became its own stable leader\");\n438:    // Two tracked entries: with batch_size=2, the first defers and the\n445:        async move { h.append_notify(send1).await }\n450:        candidate_h.append_notify(entry2.clone()),\n453:    .expect(\"append_notify(entry2) hung\")\nuse core::{future::Future, time::Duration};\n\nuse omnipaxos::storage::Entry;\n\n/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n/// the actor boundary. Users normally do not implement this manually — a blanket impl\n/// covers any `Entry` whose associated types are `Send`.\n#[cfg(not(feature = \"unicache\"))]\npub trait ActorEntry: Entry<Snapshot: Send> + Send + 'static {}\n\n#[cfg(not(feature = \"unicache\"))]\nimpl<T> ActorEntry for T where T: Entry<Snapshot: Send> + Send + 'static {}\n\n/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n/// the actor boundary. Users normally do not implement this manually — a blanket impl\n/// covers any `Entry` whose associated types are `Send`.\n#[cfg(feature = \"unicache\")]\npub trait ActorEntry:\n    Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n{\n}\n\n#[cfg(feature = \"unicache\")]\nimpl<T> ActorEntry for T where\n    T: Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n{\n}\n\n/// Abstraction over an async executor.\n///\n/// Implement this trait to run OmniPaxos on runtimes other than tokio. Two primitives\n/// are required: task spawning and a timer. The actor loop builds intervals on top of\n/// [`AsyncRuntime::sleep`], so no separate `interval` primitive is needed.\npub trait AsyncRuntime: 'static {\n    /// The join handle returned by [`AsyncRuntime::spawn`]. The runtime is free to\n    /// return `()` if it does not need cancellation or joining.\n    type JoinHandle: Send + 'static;\n\n    /// Spawn a future onto the executor.\n    fn spawn<F>(future: F) -> Self::JoinHandle\n    where\n        F: Future<Output = ()> + Send + 'static;\n\n    /// Return a future that resolves after `duration` elapses.\n    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The runtime exposes a more concrete question: `append_notify` promises the submitted entry’s decided index, but its completion handler checks the numeric decided index before checking whether the assignment ballot was superseded. I’ll retain that distinction and investigate whether a legal leader change can replace an undecided entry before the notifier runs. The core’s quorum adoption rules are relevant counterevidence.\n"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"grep -nE 'fn |transaction|flush' ../agent-source/omnipaxos_storage/src/persistent_storage.rs | head -65; nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '334,390p;585,725p'; nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '280,415p'; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']['CandidateSubmission']; print(json.dumps(s,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"grep -nE 'fn |transaction|flush' ../agent-source/omnipaxos_storage/src/persistent_storage.rs | head -65; nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '334,390p;585,725p'; nl -ba ../agent-source/omnipaxos_runtime/src/handle.rs | sed -n '280,415p'; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']['CandidateSubmission']; print(json.dumps(s,indent=2))\nPY\"","aggregated_output":"32:    pub fn get_path(&self) -> &String {\n37:    pub fn set_path(&mut self, path: String) {\n42:    pub fn get_log_options(&self) -> Options {\n47:    pub fn set_log_options(&mut self, log_opts: Options) {\n52:    pub fn get_database_options(&self) -> Options {\n57:    pub fn set_database_options(&mut self, opts: Options) {\n62:    pub fn with(path: String, log_options: Options, rocksdb_options: Options) -> Self {\n71:    pub fn with_path(path: String) -> Self {\n84:    fn default() -> Self {\n120:    pub fn open(storage_config: PersistentStorageConfig) -> Self {\n168:    pub fn new(storage_config: PersistentStorageConfig) -> Self {\n177:    fn get_log_handle(&self) -> ColumnFamilyRef<'_> {\n183:    fn batch_append_entry(&mut self, entry: T) -> StorageResult<()> {\n193:    fn batch_append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n205:    fn batch_append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n218:    fn batch_set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n224:    fn batch_set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n230:    fn batch_set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n236:    fn batch_set_compacted_idx(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n242:    fn batch_trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n250:    fn batch_set_stopsign(&mut self, ss: Option<StopSign>) -> StorageResult<()> {\n256:    fn batch_set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n268:    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n278:    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n298:    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n309:    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n323:    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n336:    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n353:    fn get_log_len(&self) -> StorageResult<usize> {\n357:    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n361:    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n369:    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n375:    fn get_decided_idx(&self) -> StorageResult<usize> {\n383:    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n389:    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n400:    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n406:    fn get_compacted_idx(&self) -> StorageResult<usize> {\n414:    fn set_compacted_idx(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n420:    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> {\n428:    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> {\n434:    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n443:    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n449:    fn trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`, but the entry went to `buffered_proposals`\n   366\t    /// or out as a `ProposalForward`, not the shared batch buffer — pushing a\n   367\t    /// placeholder for that case would desync `unconfirmed_local`'s FIFO\n   368\t    /// count. `accept_as_leader`'s stable-leader gate means only plain\n   369\t    /// `Command::Append` can hit this case.\n   370\t    fn append_tracked(\n   371\t        &mut self,\n   372\t        intent: TrackIntent,\n   373\t        entry: T,\n   374\t    ) -> Result<Option<(usize, Ballot)>, ProposeErr<T>> {\n   375\t        let accepted_before = self.op.get_accepted_idx();\n   376\t        let batched_before = self.op.get_batched_len();\n   377\t        self.op.append(entry)?;\n   378\t        let accepted_after = self.op.get_accepted_idx();\n   379\t        let batched_after = self.op.get_batched_len();\n   380\t        if accepted_after > accepted_before {\n   381\t            let ballot = self.op.get_promise();\n   382\t            if let TrackIntent::Local(id) = intent {\n   383\t                self.record_assignment(id, accepted_after, ballot);\n   384\t            }\n   385\t            Ok(Some((accepted_after, ballot)))\n   386\t        } else if batched_after > batched_before {\n   387\t            // Genuinely deferred by batching.\n   388\t            self.unconfirmed_local\n   389\t                .push_back((intent, self.op.get_promise()));\n   390\t            Ok(None)\n   585\t        self.track_batch_growth(batched_before, accepted_before);\n   586\t    }\n   587\t\n   588\t    async fn handle_command(&mut self, cmd: Command<T>) {\n   589\t        match cmd {\n   590\t            Command::Append { entry, reply } => {\n   591\t                // Via append_tracked (not self.op.append) so a deferred write\n   592\t                // still gets its unconfirmed_local placeholder, keeping FIFO\n   593\t                // position exact for any append_notify entries batched alongside it.\n   594\t                let res = self\n   595\t                    .append_tracked(TrackIntent::Untracked, entry)\n   596\t                    .map(|_| ());\n   597\t                let _ = reply.send(res);\n   598\t            }\n   599\t            Command::AppendNotify {\n   600\t                entry,\n   601\t                timeout,\n   602\t                reply,\n   603\t            } => {\n   604\t                if self.pending.len() >= self.config.max_pending_appends {\n   605\t                    let _ = reply.send(Err(AppendError::TooManyOutstanding));\n   606\t                    return;\n   607\t                }\n   608\t                let id = EntryId(uuid::Uuid::new_v4());\n   609\t                let timeout = timeout.unwrap_or(self.config.append_notify_timeout);\n   610\t                self.pending.push_back(Pending {\n   611\t                    id,\n   612\t                    undispatched: Some(entry),\n   613\t                    assigned: None,\n   614\t                    deadline: Instant::now() + timeout,\n   615\t                    reply,\n   616\t                });\n   617\t                self.try_dispatch_undispatched();\n   618\t            }\n   619\t            Command::CurrentLeader { reply } => {\n   620\t                let _ = reply.send(self.op.get_current_leader());\n   621\t            }\n   622\t            Command::DecidedIdx { reply } => {\n   623\t                let _ = reply.send(self.op.get_decided_idx());\n   624\t            }\n   625\t            Command::ReadDecidedSuffix { from, reply } => {\n   626\t                let _ = reply.send(self.op.read_decided_suffix(from));\n   627\t            }\n   628\t            Command::SubscribeDecided { from, tx } => {\n   629\t                if self.decided_subscribers.len() >= self.config.max_decided_subscribers {\n   630\t                    // Reject: drop `tx` without storing it, closing the\n   631\t                    // subscriber's channel immediately with no entries delivered.\n   632\t                    return;\n   633\t                }\n   634\t                let mut sub = DecidedSub { next_idx: from, tx };\n   635\t                // Immediate catch-up: push whatever is already decided from `from`.\n   636\t                if Self::push_to_sub(&mut self.op, &mut sub) {\n   637\t                    self.decided_subscribers.push(sub);\n   638\t                }\n   639\t            }\n   640\t            Command::Reconfigure {\n   641\t                new_configuration,\n   642\t                metadata,\n   643\t                reply,\n   644\t            } => {\n   645\t                // Wrapped like handle_incoming_tracked: a stopsign accepted as\n   646\t                // leader is itself an untracked addition to the shared batch buffer.\n   647\t                let batched_before = self.op.get_batched_len();\n   648\t                let accepted_before = self.op.get_accepted_idx();\n   649\t                let res = self.op.reconfigure(new_configuration, metadata);\n   650\t                self.track_batch_growth(batched_before, accepted_before);\n   651\t                let _ = reply.send(res);\n   652\t            }\n   653\t            Command::TryBecomeLeader => {\n   654\t                self.op.try_become_leader();\n   655\t            }\n   656\t            Command::Reconnected { pid } => {\n   657\t                self.op.reconnected(pid);\n   658\t            }\n   659\t        }\n   660\t    }\n   661\t}\n   662\t\n   663\t/// Drives the actor. Runs until all handles are dropped (both `cmd_tx` and\n   664\t/// `incoming_tx` senders closed).\n   665\tpub(crate) async fn run<T, B, R>(mut state: ActorState<T, B>, _rt: PhantomData<fn() -> R>)\n   666\twhere\n   667\t    T: ActorEntry,\n   668\t    B: Storage<T> + Send + 'static,\n   669\t    R: AsyncRuntime,\n   670\t{\n   671\t    let mut tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   672\t    let mut egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   673\t\n   674\t    // async_channel::Receiver is !Unpin; keep it in a Pin<Box<...>> so the Stream\n   675\t    // impl works under select_biased!.\n   676\t    let cmd_rx = std::mem::replace(&mut state.cmd_rx, async_channel::bounded(1).1);\n   677\t    let incoming_rx = std::mem::replace(&mut state.incoming_rx, async_channel::bounded(1).1);\n   678\t    let mut cmd_rx = Box::pin(cmd_rx);\n   679\t    let mut incoming_rx = Box::pin(incoming_rx);\n   680\t\n   681\t    loop {\n   682\t        select_biased! {\n   683\t            _ = tick_fut => {\n   684\t                state.op.tick();\n   685\t                state.detect_and_emit_events().await;\n   686\t                state.try_dispatch_undispatched();\n   687\t                state.reconcile_unconfirmed();\n   688\t                state.drain_notifiers();\n   689\t                state.push_to_all_subs();\n   690\t                tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   691\t            }\n   692\t            _ = egress_fut => {\n   693\t                state.flush_outgoing();\n   694\t                egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   695\t            }\n   696\t            in_msg = incoming_rx.next() => {\n   697\t                match in_msg {\n   698\t                    Some(Message::AsyncRuntime(arm)) => state.handle_runtime_msg(arm),\n   699\t                    Some(m) => state.handle_incoming_tracked(m),\n   700\t                    None => break,\n   701\t                }\n   702\t            }\n   703\t            cmd = cmd_rx.next() => {\n   704\t                match cmd {\n   705\t                    Some(c) => state.handle_command(c).await,\n   706\t                    None => break,\n   707\t                }\n   708\t            }\n   709\t        }\n   710\t    }\n   711\t}\n   712\t\n   713\t/// Drops the oldest elements of `buf` until its length is at most `cap`, preserving\n   714\t/// the relative order of what remains. A no-op if `buf` is already within `cap`.\n   715\tfn trim_oldest<M>(buf: &mut Vec<M>, cap: usize) {\n   716\t    if buf.len() > cap {\n   717\t        let excess = buf.len() - cap;\n   718\t        buf.drain(..excess);\n   719\t    }\n   720\t}\n   721\t\n   722\t#[cfg(test)]\n   723\tmod tests {\n   724\t    use super::trim_oldest;\n   725\t\n   280\t    }\n   281\t\n   282\t    /// Returns a receiver from which outgoing messages should be drained and forwarded\n   283\t    /// by the application's transport.\n   284\t    pub fn outgoing_messages(&self) -> async_channel::Receiver<Message<T>> {\n   285\t        self.outgoing_rx.clone()\n   286\t    }\n   287\t\n   288\t    /// Deliver an incoming message from the network to the actor.\n   289\t    pub async fn handle_incoming(&self, m: Message<T>) {\n   290\t        let _ = self.incoming_tx.send(m).await;\n   291\t    }\n   292\t}\n   293\t\n   294\t/// Spawn the actor and return a handle to it.\n   295\tpub fn spawn_actor<T, B, R>(op: OmniPaxos<T, B>, cfg: RuntimeConfig) -> OmniPaxosHandle<T>\n   296\twhere\n   297\t    T: ActorEntry,\n   298\t    B: Storage<T> + Send + 'static,\n   299\t    R: AsyncRuntime,\n   300\t{\n   301\t    let (cmd_tx, cmd_rx) = async_channel::bounded(cfg.cmd_channel_capacity);\n   302\t    let (outgoing_tx, outgoing_rx) = async_channel::bounded(cfg.outgoing_capacity);\n   303\t    let (incoming_tx, incoming_rx) = async_channel::bounded(cfg.incoming_capacity);\n   304\t    let (event_tx, events_rx) = async_channel::bounded(cfg.event_capacity);\n   305\t\n   306\t    let state = ActorState::new(\n   307\t        op,\n   308\t        cmd_rx,\n   309\t        incoming_rx,\n   310\t        outgoing_tx,\n   311\t        event_tx,\n   312\t        ActorConfig::from(&cfg),\n   313\t    );\n   314\t\n   315\t    R::spawn(run::<T, B, R>(state, PhantomData::<fn() -> R>));\n   316\t\n   317\t    OmniPaxosHandle {\n   318\t        cmd_tx,\n   319\t        events_rx,\n   320\t        outgoing_rx,\n   321\t        incoming_tx,\n   322\t        decided_channel_capacity: cfg.decided_channel_capacity,\n   323\t    }\n   324\t}\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
