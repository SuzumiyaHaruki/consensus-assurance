{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_storage/src/persistent_storage.rs | sed -n '110,175p;275,298p;360,405p'; nl -ba ../agent-source/omnipaxos/src/ballot_leader_election.rs | sed -n '103,155p'; nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '400,489p'; nl -ba ../agent-source/omnipaxos_runtime/src/event.rs | sed -n '28,64p'\"","aggregated_output":"   110\t    /// A placeholder for the T: Entry\n   111\t    t: PhantomData<T>,\n   112\t}\n   113\t\n   114\timpl<T: Entry> PersistentStorage<T>\n   115\twhere\n   116\t    T: Entry + Serialize + for<'a> Deserialize<'a>,\n   117\t    T::Snapshot: Serialize + for<'a> Deserialize<'a>,\n   118\t{\n   119\t    /// Creates or opens an existing storage\n   120\t    pub fn open(storage_config: PersistentStorageConfig) -> Self {\n   121\t        // Create database with log column\n   122\t        let path = storage_config.path;\n   123\t        let log_cf = ColumnFamilyDescriptor::new(LOG, storage_config.log_options);\n   124\t        let db_opts = storage_config.rocksdb_options;\n   125\t        let db = rocksdb::DB::open_cf_descriptors(&db_opts, path, vec![log_cf])\n   126\t            .expect(\"Failed to create RocksDB\");\n   127\t        let log_handle = db\n   128\t            .cf_handle(LOG)\n   129\t            .expect(\"Failed to create RocksDB log column family\");\n   130\t\n   131\t        // Create next log key from the state of the database\n   132\t        let mut log_iter = db.raw_iterator_cf(log_handle);\n   133\t        log_iter.seek_to_last();\n   134\t        let next_log_key = if log_iter.valid() {\n   135\t            // There's a max key in the database. Next key is 1 greater.\n   136\t            let key = log_iter.key().unwrap();\n   137\t            assert_eq!(\n   138\t                key.len(),\n   139\t                8,\n   140\t                \"Couldn't recover storage: Log key has unexpected format.\"\n   141\t            );\n   142\t            usize::from_be_bytes([\n   143\t                key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7],\n   144\t            ]) + 1\n   145\t        } else {\n   146\t            // No max key in the database. Either there's no entry yet added or they have been\n   147\t            // trimmed away.\n   148\t            match db\n   149\t                .get(TRIM)\n   150\t                .expect(\"Couldn't recover storage: Reading compacted_idx failed.\")\n   151\t            {\n   152\t                Some(bytes) => usize::read_from(bytes.as_bytes())\n   153\t                    .expect(\"Couldn't recover storage: Commpacted index has unexpected format.\"),\n   154\t                None => 0,\n   155\t            }\n   156\t        };\n   157\t        drop(log_iter);\n   158\t\n   159\t        Self {\n   160\t            db,\n   161\t            write_batch: WriteBatchWithTransaction::<false>::default(),\n   162\t            next_log_key,\n   163\t            t: PhantomData,\n   164\t        }\n   165\t    }\n   166\t\n   167\t    /// Creates a new storage instance, panics if a RocksDB instance already exists in the given path\n   168\t    pub fn new(storage_config: PersistentStorageConfig) -> Self {\n   169\t        std::fs::metadata(storage_config.path.clone()).expect_err(&format!(\n   170\t            \"Cannot create new instance, database already exists in {}\",\n   171\t            storage_config.path\n   172\t        ));\n   173\t        Self::open(storage_config)\n   174\t    }\n   175\t\n   275\t    T: Entry + Serialize + for<'a> Deserialize<'a>,\n   276\t    T::Snapshot: Serialize + for<'a> Deserialize<'a>,\n   277\t{\n   278\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n   279\t        for op in ops {\n   280\t            match op {\n   281\t                StorageOp::AppendEntry(entry) => self.batch_append_entry(entry)?,\n   282\t                StorageOp::AppendEntries(entries) => self.batch_append_entries(entries)?,\n   283\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n   284\t                    self.batch_append_on_prefix(from_idx, entries)?\n   285\t                }\n   286\t                StorageOp::SetPromise(bal) => self.batch_set_promise(bal)?,\n   287\t                StorageOp::SetDecidedIndex(idx) => self.batch_set_decided_idx(idx)?,\n   288\t                StorageOp::SetAcceptedRound(bal) => self.batch_set_accepted_round(bal)?,\n   289\t                StorageOp::SetCompactedIdx(idx) => self.batch_set_compacted_idx(idx)?,\n   290\t                StorageOp::Trim(idx) => self.batch_trim(idx)?,\n   291\t                StorageOp::SetStopsign(ss) => self.batch_set_stopsign(ss)?,\n   292\t                StorageOp::SetSnapshot(snap) => self.batch_set_snapshot(snap)?,\n   293\t            }\n   294\t        }\n   295\t        Ok(self.db.write(std::mem::take(&mut self.write_batch))?)\n   296\t    }\n   297\t\n   298\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n   360\t\n   361\t    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n   362\t        let promise = self.db.get_pinned(NPROM)?;\n   363\t        match promise {\n   364\t            Some(pinned_bytes) => Ok(Some(bincode::deserialize(&pinned_bytes)?)),\n   365\t            None => Ok(None),\n   366\t        }\n   367\t    }\n   368\t\n   369\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   370\t        let prom_bytes = bincode::serialize(&n_prom)?;\n   371\t        self.db.put(NPROM, prom_bytes)?;\n   372\t        Ok(())\n   373\t    }\n   374\t\n   375\t    fn get_decided_idx(&self) -> StorageResult<usize> {\n   376\t        let decided = self.db.get_pinned(DECIDE)?;\n   377\t        match decided {\n   378\t            Some(ld_bytes) => Ok(usize::read_from(ld_bytes.as_bytes()).ok_or(ErrHelper {})?),\n   379\t            None => Ok(0),\n   380\t        }\n   381\t    }\n   382\t\n   383\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n   384\t        let ld_bytes = usize::as_bytes(&ld);\n   385\t        self.db.put(DECIDE, ld_bytes)?;\n   386\t        Ok(())\n   387\t    }\n   388\t\n   389\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n   390\t        let accepted = self.db.get_pinned(ACC)?;\n   391\t        match accepted {\n   392\t            Some(acc_bytes) => {\n   393\t                let ballot = bincode::deserialize(&acc_bytes)?;\n   394\t                Ok(Some(ballot))\n   395\t            }\n   396\t            None => Ok(None),\n   397\t        }\n   398\t    }\n   399\t\n   400\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n   401\t        let acc_bytes = bincode::serialize(&na)?;\n   402\t        self.db.put(ACC, acc_bytes)?;\n   403\t        Ok(())\n   404\t    }\n   405\t\n   103\t    pub(crate) fn with(config: BLEConfig, recovered_leader: Option<Ballot>) -> Self {\n   104\t        let config_id = config.configuration_id;\n   105\t        let pid = config.pid;\n   106\t        let peers = config.peers;\n   107\t        let num_nodes = &peers.len() + 1;\n   108\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n   109\t        let mut initial_ballot = Ballot::with(config_id, INITIAL_ROUND, config.priority, pid);\n   110\t        let initial_leader = match recovered_leader {\n   111\t            Some(b) if b != Ballot::default() => {\n   112\t                // Prevents a recovered server from retaining BLE leadership with the same ballot.\n   113\t                initial_ballot.n = RECOVERY_ROUND;\n   114\t                b\n   115\t            }\n   116\t            _ => initial_ballot,\n   117\t        };\n   118\t        let mut ble = BallotLeaderElection {\n   119\t            configuration_id: config_id,\n   120\t            pid,\n   121\t            peers,\n   122\t            hb_round: 0,\n   123\t            heartbeat_replies: Vec::with_capacity(num_nodes),\n   124\t            prev_replies: Vec::with_capacity(num_nodes),\n   125\t            current_ballot: initial_ballot,\n   126\t            leader: initial_leader,\n   127\t            happy: true,\n   128\t            quorum,\n   129\t            outgoing: Vec::with_capacity(config.buffer_size),\n   130\t            #[cfg(feature = \"logging\")]\n   131\t            logger: {\n   132\t                if let Some(logger) = config.custom_logger {\n   133\t                    logger\n   134\t                } else {\n   135\t                    let s = config\n   136\t                        .logger_file_path\n   137\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   138\t                    create_logger(s.as_str())\n   139\t                }\n   140\t            },\n   141\t        };\n   142\t        #[cfg(feature = \"logging\")]\n   143\t        {\n   144\t            info!(\n   145\t                ble.logger,\n   146\t                \"Ballot Leader Election component pid: {} created!\", pid\n   147\t            );\n   148\t        }\n   149\t        ble.new_hb_round();\n   150\t        ble\n   151\t    }\n   152\t\n   153\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   154\t    /// priority triggers a leader re-election.\n   155\t    pub(crate) fn set_priority(&mut self, p: u32) {\n   400\t    /// or received via `TaggedProposal` from follower `from`. Populates the\n   401\t    /// pending's `assigned` (or, if buffered by batching, queues a\n   402\t    /// `TrackIntent` for `reconcile_unconfirmed` to resolve later) and\n   403\t    /// returns `(id, assigned_idx)` if accepted immediately, so batch callers\n   404\t    /// can collect these and send one `Assigned` reply for the whole batch.\n   405\t    fn accept_as_leader(\n   406\t        &mut self,\n   407\t        id: EntryId,\n   408\t        entry: T,\n   409\t        from: Option<NodeId>,\n   410\t    ) -> Option<(EntryId, usize)> {\n   411\t        // Only accept while leadership is stable (Accept phase).\n   412\t        let stable_leader =\n   413\t            matches!(self.op.get_current_leader(), Some((pid, true)) if pid == self.pid);\n   414\t        if !stable_leader {\n   415\t            return None;\n   416\t        }\n   417\t        let intent = match from {\n   418\t            None => TrackIntent::Local(id),\n   419\t            Some(from) => TrackIntent::Remote { id, from },\n   420\t        };\n   421\t        match self.append_tracked(intent, entry) {\n   422\t            Ok(Some((after, _ballot))) => Some((id, after)),\n   423\t            Ok(None) => None,\n   424\t            Err(err) => {\n   425\t                self.resolve_pending_failed(id, err);\n   426\t                None\n   427\t            }\n   428\t        }\n   429\t    }\n   430\t\n   431\t    /// Matches everything buffered in `unconfirmed_local` to the index it's\n   432\t    /// assigned once its batch flushes and `get_accepted_idx()` advances.\n   433\t    /// FIFO correspondence is exact here regardless of what added to the\n   434\t    /// shared batch buffer (see `unconfirmed_local`'s doc comment), as long as\n   435\t    /// the ballot hasn't changed since the entry was buffered; if it has,\n   436\t    /// leadership moved on and this index may belong to different writes, so\n   437\t    /// we drop tracking for it and let the caller time out.\n   438\t    fn reconcile_unconfirmed(&mut self) {\n   439\t        let cur_ballot = self.op.get_promise();\n   440\t        let accepted = self.op.get_accepted_idx();\n   441\t        let mut idx = self.last_seen_accepted_idx;\n   442\t        // Entries from a single remote TaggedProposal batch can resolve\n   443\t        // across several different `idx` values here (their own batch may\n   444\t        // have been interleaved with others' writes); group by origin so\n   445\t        // each gets one `Assigned` reply instead of one message per entry.\n   446\t        let mut remote_assigned: HashMap<NodeId, Vec<(EntryId, usize)>> = HashMap::new();\n   447\t        while idx < accepted {\n   448\t            idx += 1;\n   449\t            let Some((intent, ballot)) = self.unconfirmed_local.pop_front() else {\n   450\t                break;\n   451\t            };\n   452\t            if ballot != cur_ballot {\n   453\t                // Leadership moved on since this was buffered; the index may\n   454\t                // belong to different writes. Drop tracking -- Local/Remote\n   455\t                // origins simply time out, matching the ballot-mismatch\n   456\t                // handling in `drain_notifiers` for already-assigned entries.\n   457\t                continue;\n   458\t            }\n   459\t            match intent {\n   460\t                TrackIntent::Untracked => {}\n   461\t                TrackIntent::Local(id) => self.record_assignment(id, idx, ballot),\n   462\t                TrackIntent::Remote { id, from } => {\n   463\t                    remote_assigned.entry(from).or_default().push((id, idx));\n   464\t                }\n   465\t            }\n   466\t        }\n   467\t        self.last_seen_accepted_idx = accepted;\n   468\t\n   469\t        for (from, entries) in remote_assigned {\n   470\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   471\t                from: self.pid,\n   472\t                to: from,\n   473\t                msg: AsyncRuntimeMsg::Assigned {\n   474\t                    ballot: cur_ballot,\n   475\t                    entries,\n   476\t                },\n   477\t            }));\n   478\t        }\n   479\t    }\n   480\t\n   481\t    /// Attempt to dispatch every pending entry that hasn't yet been sent or\n   482\t    /// accepted locally. Called from `Command::AppendNotify` and on each tick,\n   483\t    /// which lets a call issued *before* an election eventually succeed once a\n   484\t    /// leader is known.\n   485\t    fn try_dispatch_undispatched(&mut self) {\n   486\t        let Some((leader, accepted)) = self.op.get_current_leader() else {\n   487\t            return;\n   488\t        };\n   489\t        if leader == self.pid && !accepted {\n    28\t        /// The log index at which the StopSign was decided.\n    29\t        stop_sign_idx: usize,\n    30\t    },\n    31\t}\n    32\t\n    33\t/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n    34\t#[derive(Debug)]\n    35\tpub enum AppendError<T>\n    36\twhere\n    37\t    T: Entry,\n    38\t{\n    39\t    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n    40\t    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n    41\t    /// pending). Unlike the other variants, this is resolved immediately rather than\n    42\t    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n    43\t    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n    44\t    /// leader). If the failure happens on a different node than the origin, the origin\n    45\t    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n    46\t    /// require a new wire message.\n    47\t    Propose(ProposeErr<T>),\n    48\t    /// A leader change occurred after the entry was accepted at the given index but\n    49\t    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n    50\t    /// required to adopt any value a majority-overlapping quorum may have already\n    51\t    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n    52\t    /// new ballot -- we just stop waiting rather than confirm it. Check\n    53\t    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n    54\t    /// at that index if you need to know for sure before re-appending.\n    55\t    Superseded {\n    56\t        /// The log index the entry was assigned before the leader change.\n    57\t        log_entry_idx: usize,\n    58\t    },\n    59\t    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n    60\t    Timeout,\n    61\t    /// The actor has shut down before the entry could be decided.\n    62\t    Shutdown,\n    63\t    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n    64\t    /// outstanding `append_notify` calls; this one was rejected immediately rather\n","exit_code":0,"status":"completed"}}
