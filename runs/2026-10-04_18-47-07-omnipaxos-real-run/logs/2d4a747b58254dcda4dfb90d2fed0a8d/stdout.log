{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '1,290p'; nl -ba ../agent-source/omnipaxos_storage/src/memory_storage.rs | head -210; nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '35,82p'\"","aggregated_output":"     1\tuse core::time::Duration;\n     2\tuse std::{\n     3\t    collections::{HashMap, VecDeque},\n     4\t    marker::PhantomData,\n     5\t    time::Instant,\n     6\t};\n     7\t\n     8\tuse futures::{channel::oneshot, select_biased, FutureExt, StreamExt};\n     9\t\n    10\tuse omnipaxos::{\n    11\t    ballot_leader_election::Ballot,\n    12\t    messages::{\n    13\t        async_runtime::{AsyncRuntimeMessage, AsyncRuntimeMsg, EntryId},\n    14\t        Message,\n    15\t    },\n    16\t    storage::{Entry, Storage},\n    17\t    util::{LogEntry, NodeId},\n    18\t    OmniPaxos, ProposeErr,\n    19\t};\n    20\t\n    21\tuse super::{\n    22\t    event::{AppendError, Command, OmniPaxosEvent},\n    23\t    handle::RuntimeConfig,\n    24\t    traits::{ActorEntry, AsyncRuntime},\n    25\t};\n    26\t\n    27\t/// Actor-loop-relevant subset of [`RuntimeConfig`]. Excludes the channel-capacity\n    28\t/// fields, which are only needed once, to construct the channels in `spawn_actor`\n    29\t/// before the actor itself is built — mirrors how `SequencePaxosConfig` in the core\n    30\t/// crate trims down the public `OmniPaxosConfig` to just what that component needs.\n    31\tpub(crate) struct ActorConfig {\n    32\t    tick_period: Duration,\n    33\t    egress_period: Duration,\n    34\t    append_notify_timeout: Duration,\n    35\t    max_pending_appends: usize,\n    36\t    max_decided_subscribers: usize,\n    37\t    max_outgoing_buffered: usize,\n    38\t}\n    39\t\n    40\timpl From<&RuntimeConfig> for ActorConfig {\n    41\t    fn from(cfg: &RuntimeConfig) -> Self {\n    42\t        Self {\n    43\t            tick_period: cfg.tick_period,\n    44\t            egress_period: cfg.egress_period,\n    45\t            append_notify_timeout: cfg.append_notify_timeout,\n    46\t            max_pending_appends: cfg.max_pending_appends,\n    47\t            max_decided_subscribers: cfg.max_decided_subscribers,\n    48\t            max_outgoing_buffered: cfg.max_outgoing_buffered,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\t/// A pending `append_notify` awaiting decision. Uniform representation regardless\n    54\t/// of whether the entry was accepted locally (we are leader) or forwarded (we are\n    55\t/// follower). The `assigned` field is filled in by either code path; the drain\n    56\t/// loop treats every pending item the same way.\n    57\tstruct Pending<T>\n    58\twhere\n    59\t    T: Entry,\n    60\t{\n    61\t    id: EntryId,\n    62\t    /// The entry, retained until dispatched (accepted locally or sent as a\n    63\t    /// `TaggedProposal`). While `Some`, `try_dispatch_undispatched` retries it\n    64\t    /// each tick — this is what lets `append_notify` be called before a\n    65\t    /// leader is known.\n    66\t    undispatched: Option<T>,\n    67\t    /// `(assigned_idx, ballot_at_assignment)`. `None` until either:\n    68\t    ///   (a) we accepted the entry ourselves as leader, or\n    69\t    ///   (b) we received `AsyncRuntimeMsg::Assigned` from the leader.\n    70\t    assigned: Option<(usize, Ballot)>,\n    71\t    deadline: Instant,\n    72\t    reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n    73\t}\n    74\t\n    75\t/// What to do, once its index is known, for a write buffered in the shared\n    76\t/// batch buffer. Every code path that can add to that buffer pushes one of\n    77\t/// these (see `track_untracked_batch_growth`), keeping `unconfirmed_local`'s\n    78\t/// FIFO position in sync with the buffer regardless of source.\n    79\tenum TrackIntent {\n    80\t    /// Not tracked: a plain `Command::Append`, or an entry that entered the\n    81\t    /// buffer via core-internal protocol handling we have no id for (a\n    82\t    /// forwarded proposal, replicated entries, a reconfiguration stopsign).\n    83\t    Untracked,\n    84\t    /// Resolve a pending `append_notify` we own directly, via `self.pending`,\n    85\t    /// once this index is known.\n    86\t    Local(EntryId),\n    87\t    /// Reply with `AsyncRuntimeMsg::Assigned` to `from` once this index is\n    88\t    /// known -- used for entries that arrived via a remote `TaggedProposal`\n    89\t    /// and got deferred by batching rather than accepted immediately (the\n    90\t    /// immediate case is handled inline by `handle_runtime_msg` instead).\n    91\t    Remote { id: EntryId, from: NodeId },\n    92\t}\n    93\t\n    94\tpub(crate) struct ActorState<T, B>\n    95\twhere\n    96\t    T: Entry,\n    97\t    B: Storage<T>,\n    98\t{\n    99\t    pub(crate) op: OmniPaxos<T, B>,\n   100\t    pub(crate) cmd_rx: async_channel::Receiver<Command<T>>,\n   101\t    pub(crate) incoming_rx: async_channel::Receiver<Message<T>>,\n   102\t    pub(crate) outgoing_tx: async_channel::Sender<Message<T>>,\n   103\t    pub(crate) event_tx: async_channel::Sender<OmniPaxosEvent>,\n   104\t    pub(crate) config: ActorConfig,\n   105\t\n   106\t    pid: NodeId,\n   107\t    outgoing_buf: Vec<Message<T>>,\n   108\t    pending: VecDeque<Pending<T>>,\n   109\t    decided_subscribers: Vec<DecidedSub<T>>,\n   110\t    last_leader: Option<(NodeId, bool)>,\n   111\t    last_decided_idx: usize,\n   112\t    last_reconfigured: bool,\n   113\t    /// One entry per write currently sitting in the shared per-node batch\n   114\t    /// buffer, in the order it was added, awaiting the flush that assigns it\n   115\t    /// an index. Popping one entry per unit of `get_accepted_idx()` advance\n   116\t    /// (`reconcile_unconfirmed`) lines up with what actually flushed. Paired\n   117\t    /// with the ballot in effect when buffered so a leader change before the\n   118\t    /// flush is detected rather than mis-assigned.\n   119\t    unconfirmed_local: VecDeque<(TrackIntent, Ballot)>,\n   120\t    last_seen_accepted_idx: usize,\n   121\t}\n   122\t\n   123\t/// A single subscriber to the decided-log stream. `next_idx` is the next log\n   124\t/// index the actor must deliver; incremented on every successful `try_send`.\n   125\tstruct DecidedSub<T>\n   126\twhere\n   127\t    T: Entry,\n   128\t{\n   129\t    next_idx: usize,\n   130\t    tx: async_channel::Sender<LogEntry<T>>,\n   131\t}\n   132\t\n   133\timpl<T, B> ActorState<T, B>\n   134\twhere\n   135\t    T: Entry,\n   136\t    B: Storage<T>,\n   137\t{\n   138\t    pub(crate) fn new(\n   139\t        op: OmniPaxos<T, B>,\n   140\t        cmd_rx: async_channel::Receiver<Command<T>>,\n   141\t        incoming_rx: async_channel::Receiver<Message<T>>,\n   142\t        outgoing_tx: async_channel::Sender<Message<T>>,\n   143\t        event_tx: async_channel::Sender<OmniPaxosEvent>,\n   144\t        config: ActorConfig,\n   145\t    ) -> Self {\n   146\t        let last_decided_idx = op.get_decided_idx();\n   147\t        let last_leader = op.get_current_leader();\n   148\t        let pid = op.get_pid();\n   149\t        let accepted_idx = op.get_accepted_idx();\n   150\t        Self {\n   151\t            op,\n   152\t            cmd_rx,\n   153\t            incoming_rx,\n   154\t            outgoing_tx,\n   155\t            event_tx,\n   156\t            config,\n   157\t            pid,\n   158\t            outgoing_buf: Vec::new(),\n   159\t            pending: VecDeque::new(),\n   160\t            decided_subscribers: Vec::new(),\n   161\t            last_leader,\n   162\t            last_decided_idx,\n   163\t            last_reconfigured: false,\n   164\t            unconfirmed_local: VecDeque::new(),\n   165\t            last_seen_accepted_idx: accepted_idx,\n   166\t        }\n   167\t    }\n   168\t\n   169\t    async fn detect_and_emit_events(&mut self) {\n   170\t        let cur = self.op.get_current_leader();\n   171\t        if cur != self.last_leader {\n   172\t            if let Some((pid, accepted)) = cur {\n   173\t                let _ = self\n   174\t                    .event_tx\n   175\t                    .send(OmniPaxosEvent::LeaderElected { pid, accepted })\n   176\t                    .await;\n   177\t            }\n   178\t            self.last_leader = cur;\n   179\t        }\n   180\t        let d = self.op.get_decided_idx();\n   181\t        if d > self.last_decided_idx {\n   182\t            let _ = self\n   183\t                .event_tx\n   184\t                .send(OmniPaxosEvent::Decided { new_decided_idx: d })\n   185\t                .await;\n   186\t            self.last_decided_idx = d;\n   187\t        }\n   188\t        if !self.last_reconfigured {\n   189\t            if let Some(_ss) = self.op.is_reconfigured() {\n   190\t                let _ = self\n   191\t                    .event_tx\n   192\t                    .send(OmniPaxosEvent::Reconfigured {\n   193\t                        stop_sign_idx: self.op.get_decided_idx(),\n   194\t                    })\n   195\t                    .await;\n   196\t                self.last_reconfigured = true;\n   197\t            }\n   198\t        }\n   199\t    }\n   200\t\n   201\t    fn drain_notifiers(&mut self) {\n   202\t        let decided = self.op.get_decided_idx();\n   203\t        let now = Instant::now();\n   204\t        let cur_ballot = self.op.get_promise();\n   205\t        let old = std::mem::take(&mut self.pending);\n   206\t        for p in old {\n   207\t            match p.assigned {\n   208\t                Some((idx, _)) if idx <= decided => {\n   209\t                    let _ = p.reply.send(Ok(idx));\n   210\t                }\n   211\t                Some((idx, ballot)) if ballot < cur_ballot => {\n   212\t                    let _ = p\n   213\t                        .reply\n   214\t                        .send(Err(AppendError::Superseded { log_entry_idx: idx }));\n   215\t                }\n   216\t                _ if now > p.deadline => {\n   217\t                    let _ = p.reply.send(Err(AppendError::Timeout));\n   218\t                }\n   219\t                _ => self.pending.push_back(p),\n   220\t            }\n   221\t        }\n   222\t    }\n   223\t\n   224\t    /// Effective cap for `outgoing_buf`: the channel's own capacity when known,\n   225\t    /// else [`ActorConfig::max_outgoing_buffered`].\n   226\t    fn outgoing_buf_cap(&self) -> usize {\n   227\t        self.outgoing_tx\n   228\t            .capacity()\n   229\t            .unwrap_or(self.config.max_outgoing_buffered)\n   230\t    }\n   231\t\n   232\t    /// Non-blocking drain of `outgoing_buf` onto `outgoing_tx`. Uses `try_send`\n   233\t    /// so a merely-full channel (slow consumer) doesn't block the actor loop;\n   234\t    /// unsent messages stay in `outgoing_buf` (in order) for the next attempt.\n   235\t    /// If the buffer exceeds [`Self::outgoing_buf_cap`], oldest messages are\n   236\t    /// dropped — see [`RuntimeConfig::max_outgoing_buffered`].\n   237\t    fn drain_outgoing_buf(&mut self) {\n   238\t        let cap = self.outgoing_buf_cap();\n   239\t        trim_oldest(&mut self.outgoing_buf, cap);\n   240\t\n   241\t        let pending = std::mem::take(&mut self.outgoing_buf);\n   242\t        let mut iter = pending.into_iter();\n   243\t        for msg in iter.by_ref() {\n   244\t            match self.outgoing_tx.try_send(msg) {\n   245\t                Ok(()) => {}\n   246\t                Err(async_channel::TrySendError::Full(msg)) => {\n   247\t                    self.outgoing_buf.push(msg);\n   248\t                    break;\n   249\t                }\n   250\t                Err(async_channel::TrySendError::Closed(_)) => {\n   251\t                    // Receiver dropped — user is not draining outgoing. Discard\n   252\t                    // everything remaining; nothing left to retry against.\n   253\t                    return;\n   254\t                }\n   255\t            }\n   256\t        }\n   257\t        self.outgoing_buf.extend(iter);\n   258\t    }\n   259\t\n   260\t    /// Enqueue one outgoing message without awaiting. Appends behind any\n   261\t    /// already-buffered messages (preserves order), then tries to drain.\n   262\t    /// Used for both core protocol traffic (via [`Self::flush_outgoing`]) and\n   263\t    /// runtime control-plane messages (`TaggedProposal` / `Assigned`).\n   264\t    fn enqueue_outgoing(&mut self, msg: Message<T>) {\n   265\t        self.outgoing_buf.push(msg);\n   266\t        self.drain_outgoing_buf();\n   267\t    }\n   268\t\n   269\t    /// Pull newly-produced OmniPaxos/BLE messages into `outgoing_buf` and drain.\n   270\t    fn flush_outgoing(&mut self) {\n   271\t        self.op.take_outgoing_messages(&mut self.outgoing_buf);\n   272\t        self.drain_outgoing_buf();\n   273\t    }\n   274\t\n   275\t    /// Push newly-decided entries to a single, freshly-added subscriber. Used\n   276\t    /// only on the immediate catch-up path from `Command::SubscribeDecided`,\n   277\t    /// where there is no shared read to amortize against. Returns `false` if\n   278\t    /// the receiver was already closed.\n   279\t    fn push_to_sub(op: &mut OmniPaxos<T, B>, sub: &mut DecidedSub<T>) -> bool {\n   280\t        let decided = op.get_decided_idx();\n   281\t        if sub.next_idx >= decided {\n   282\t            return true;\n   283\t        }\n   284\t        let Some(entries) = op.read_decided_suffix(sub.next_idx) else {\n   285\t            return true;\n   286\t        };\n   287\t        for entry in entries {\n   288\t            match sub.tx.try_send(entry) {\n   289\t                Ok(()) => sub.next_idx += 1,\n   290\t                Err(async_channel::TrySendError::Full(_)) => return true,\n     1\tuse omnipaxos::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    storage::{Entry, StopSign, Storage, StorageOp, StorageResult},\n     4\t};\n     5\t/// An in-memory storage implementation for SequencePaxos.\n     6\t#[derive(Clone)]\n     7\tpub struct MemoryStorage<T>\n     8\twhere\n     9\t    T: Entry,\n    10\t{\n    11\t    /// Vector which contains all the logged entries in-memory.\n    12\t    log: Vec<T>,\n    13\t    /// Last promised round.\n    14\t    n_prom: Option<Ballot>,\n    15\t    /// Last accepted round.\n    16\t    acc_round: Option<Ballot>,\n    17\t    /// Length of the decided log.\n    18\t    ld: usize,\n    19\t    /// Garbage collected index.\n    20\t    trimmed_idx: usize,\n    21\t    /// Stored compact index\n    22\t    compacted_idx: usize,\n    23\t    /// Stored snapshot\n    24\t    snapshot: Option<T::Snapshot>,\n    25\t    /// Stored StopSign\n    26\t    stopsign: Option<StopSign>,\n    27\t}\n    28\t\n    29\timpl<T> Storage<T> for MemoryStorage<T>\n    30\twhere\n    31\t    T: Entry,\n    32\t{\n    33\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n    34\t        for op in ops {\n    35\t            match op {\n    36\t                StorageOp::AppendEntry(entry) => self.append_entry(entry)?,\n    37\t                StorageOp::AppendEntries(entries) => self.append_entries(entries)?,\n    38\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n    39\t                    self.append_on_prefix(from_idx, entries)?\n    40\t                }\n    41\t                StorageOp::SetPromise(bal) => self.set_promise(bal)?,\n    42\t                StorageOp::SetDecidedIndex(idx) => self.set_decided_idx(idx)?,\n    43\t                StorageOp::SetAcceptedRound(bal) => self.set_accepted_round(bal)?,\n    44\t                StorageOp::SetCompactedIdx(idx) => self.set_compacted_idx(idx)?,\n    45\t                StorageOp::Trim(idx) => self.trim(idx)?,\n    46\t                StorageOp::SetStopsign(ss) => self.set_stopsign(ss)?,\n    47\t                StorageOp::SetSnapshot(snap) => self.set_snapshot(snap)?,\n    48\t            }\n    49\t        }\n    50\t        Ok(())\n    51\t    }\n    52\t\n    53\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n    54\t        self.log.push(entry);\n    55\t        Ok(())\n    56\t    }\n    57\t\n    58\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n    59\t        let mut e = entries;\n    60\t        self.log.append(&mut e);\n    61\t        Ok(())\n    62\t    }\n    63\t\n    64\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n    65\t        self.log.truncate(from_idx - self.trimmed_idx);\n    66\t        self.append_entries(entries)\n    67\t    }\n    68\t\n    69\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n    70\t        self.n_prom = Some(n_prom);\n    71\t        Ok(())\n    72\t    }\n    73\t\n    74\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n    75\t        self.ld = ld;\n    76\t        Ok(())\n    77\t    }\n    78\t\n    79\t    fn get_decided_idx(&self) -> StorageResult<usize> {\n    80\t        Ok(self.ld)\n    81\t    }\n    82\t\n    83\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n    84\t        self.acc_round = Some(na);\n    85\t        Ok(())\n    86\t    }\n    87\t\n    88\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n    89\t        Ok(self.acc_round)\n    90\t    }\n    91\t\n    92\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n    93\t        let from = from - self.trimmed_idx;\n    94\t        let to = to - self.trimmed_idx;\n    95\t        Ok(self.log.get(from..to).unwrap_or(&[]).to_vec())\n    96\t    }\n    97\t\n    98\t    fn get_log_len(&self) -> StorageResult<usize> {\n    99\t        Ok(self.log.len())\n   100\t    }\n   101\t\n   102\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   103\t        Ok(match self.log.get((from - self.trimmed_idx)..) {\n   104\t            Some(s) => s.to_vec(),\n   105\t            None => vec![],\n   106\t        })\n   107\t    }\n   108\t\n   109\t    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n   110\t        Ok(self.n_prom)\n   111\t    }\n   112\t\n   113\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> {\n   114\t        self.stopsign = s;\n   115\t        Ok(())\n   116\t    }\n   117\t\n   118\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> {\n   119\t        Ok(self.stopsign.clone())\n   120\t    }\n   121\t\n   122\t    fn trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   123\t        let to_trim = (trimmed_idx - self.trimmed_idx).min(self.log.len());\n   124\t        self.log.drain(0..to_trim);\n   125\t        self.trimmed_idx = trimmed_idx;\n   126\t        Ok(())\n   127\t    }\n   128\t\n   129\t    fn set_compacted_idx(&mut self, compact_idx: usize) -> StorageResult<()> {\n   130\t        self.compacted_idx = compact_idx;\n   131\t        Ok(())\n   132\t    }\n   133\t\n   134\t    fn get_compacted_idx(&self) -> StorageResult<usize> {\n   135\t        Ok(self.compacted_idx)\n   136\t    }\n   137\t\n   138\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n   139\t        self.snapshot = snapshot;\n   140\t        Ok(())\n   141\t    }\n   142\t\n   143\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   144\t        Ok(self.snapshot.clone())\n   145\t    }\n   146\t}\n   147\t\n   148\timpl<T: Entry> Default for MemoryStorage<T> {\n   149\t    fn default() -> Self {\n   150\t        Self {\n   151\t            log: vec![],\n   152\t            n_prom: None,\n   153\t            acc_round: None,\n   154\t            ld: 0,\n   155\t            trimmed_idx: 0,\n   156\t            compacted_idx: 0,\n   157\t            snapshot: None,\n   158\t            stopsign: None,\n   159\t        }\n   160\t    }\n   161\t}\n    35\t    pub cluster_config: ClusterConfig,\n    36\t    pub server_config: ServerConfig,\n    37\t}\n    38\t\n    39\timpl OmniPaxosConfig {\n    40\t    /// Checks that all the fields of the cluster config are valid.\n    41\t    pub fn validate(&self) -> Result<(), ConfigError> {\n    42\t        self.cluster_config.validate()?;\n    43\t        self.server_config.validate()?;\n    44\t        valid_config!(\n    45\t            self.cluster_config.nodes.contains(&self.server_config.pid),\n    46\t            \"Nodes must include own server pid\"\n    47\t        );\n    48\t        Ok(())\n    49\t    }\n    50\t\n    51\t    /// Creates a new `OmniPaxosConfig` from a `toml` file.\n    52\t    #[cfg(feature = \"toml_config\")]\n    53\t    pub fn with_toml(file_path: &str) -> Result<Self, ConfigError> {\n    54\t        let config_file = fs::read_to_string(file_path)?;\n    55\t        let config: OmniPaxosConfig = toml::from_str(&config_file)?;\n    56\t        config.validate()?;\n    57\t        Ok(config)\n    58\t    }\n    59\t\n    60\t    /// Checks all configuration fields and returns the local OmniPaxos node if successful.\n    61\t    pub fn build<T, B>(self, storage: B) -> Result<OmniPaxos<T, B>, ConfigError>\n    62\t    where\n    63\t        T: Entry,\n    64\t        B: Storage<T>,\n    65\t    {\n    66\t        self.validate()?;\n    67\t        // Use stored ballot as initial BLE leader\n    68\t        let recovered_leader = storage\n    69\t            .get_promise()\n    70\t            .expect(\"storage error while trying to read promise\");\n    71\t        Ok(OmniPaxos {\n    72\t            ble: BallotLeaderElection::with(self.clone().into(), recovered_leader),\n    73\t            election_clock: LogicalClock::with(self.server_config.election_tick_timeout),\n    74\t            resend_message_clock: LogicalClock::with(\n    75\t                self.server_config.resend_message_tick_timeout,\n    76\t            ),\n    77\t            flush_batch_clock: LogicalClock::with(self.server_config.flush_batch_tick_timeout),\n    78\t            seq_paxos: SequencePaxos::with(self.into(), storage),\n    79\t        })\n    80\t    }\n    81\t}\n    82\t\n","exit_code":0,"status":"completed"}}
