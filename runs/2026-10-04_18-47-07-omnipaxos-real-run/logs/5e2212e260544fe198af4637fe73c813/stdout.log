  \"src-persistent-recovery\",\n        \"src-persistent-txn\",\n        \"src-read\",\n        \"src-read-classify\",\n        \"src-runtime-assignment\",\n        \"src-runtime-completion\",\n        \"src-runtime-config\",\n        \"src-runtime-egress\",\n        \"src-runtime-loop\",\n        \"src-runtime-routing\",\n        \"src-runtime-spawn\",\n        \"src-storage-contract\",\n        \"src-superseded-contract\",\n        \"src-support\",\n        \"src-sync\"\n      ],\n      \"participants\": [\n        \"Origin actor and old leader\",\n        \"New leader\",\n        \"Quorum peers\"\n      ],\n      \"objects\": [\n        \"Pending operation EntryId\",\n        \"Assignment index and ballot\",\n        \"Decided log entry\"\n      ],\n      \"contexts\": [\n        \"Three-node fixed configuration\",\n        \"Non-compacted log with reliable storage\",\n        \"Higher ballot while client operation remains pending\"\n      ],\n      \"event_paths\": [\n        \"append_notify -> append_tracked -> record_assignment\",\n        \"higher ballot Prepare/Promise quorum -> sync_log -> AcceptSync\",\n        \"handle_incoming_tracked -> later tick -> drain_notifiers\"\n      ],\n      \"activity_classes\": [\n        \"A7\",\n        \"A1\",\n        \"A2\"\n      ],\n      \"behavior_ids\": [\n        \"b-runtime-assign\",\n        \"b-runtime-notify\"\n      ],\n      \"fact_ids\": [\n        \"f-runtime-assignment\"\n      ],\n      \"supporting_behavior_ids\": {\n        \"b-formation\": \"Quorum chooses replacement history and advances its decided prefix.\",\n        \"b-prepare\": \"Establishes newer ballot and invalidates old authority.\",\n        \"b-follow\": \"Applies higher-ballot synchronized history at origin.\",\n        \"b-storage\": \"Stores the synchronized replacement and decision metadata.\",\n        \"b-read\": \"Observes actual decided content independently of completion result.\",\n        \"b-runtime-loop\": \"Allows incoming protocol work between notifier drains.\"\n      },\n      \"obligation_relation_kind\": \"consumption\",\n      \"counterevidence\": [\n        \"Superseded rejects old assignments if index is not yet decided.\",\n        \"Quorum adoption preserves entries represented in selected prior history; a ballot change alone is insufficient.\",\n        \"Deferred batch assignments have an additional ballot check.\"\n      ],\n      \"unknowns\": [\n        \"Need actual legal history proving original entry never reached the quorum selecting replacement, origin applied replacement, and pending future had not already resolved Superseded.\"\n      ],\n      \"priority\": 3,\n      \"trigger_rationale\": \"Direct interface promise and success-before-supersession branch give a precise operation-correspondence discriminator. A legal three-node history can test it without duplicate or reordered same-link delivery assumptions; this is stronger grounded than the unresolved same-ballot transport or heartbeat-duplication questions.\"\n    },\n    \"status\": \"escalated\",\n    \"parent_candidate_id\": null,\n    \"fork_reason\": \"\",\n    \"stop_reason\": \"Finish the usable backbone and select the newly sourced client-completion question, whose normative contract is explicit and whose discriminator does not require uncertain transport duplication assumptions.\",\n    \"resume_conditions\": [],\n    \"obligation_id\": \"claim-notify-correspondence\",\n    \"result_claim_ids\": [],\n    \"open_issue_ids\": [],\n    \"executions\": [],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"question_candidates\",\n      \"match\": {\n        \"id\": \"aaa4b601803146088adba458a414a811\"\n      }\n    }\n  }\n]\nunits [\n  {\n    \"id\": \"unit-claim-notify-correspondence\",\n    \"candidate_id\": \"aaa4b601803146088adba458a414a811\",\n    \"obligation_ids\": [\n      \"claim-notify-correspondence\"\n    ],\n    \"binding_ids\": [\n      \"bind-notify\"\n    ],\n    \"relation_ids\": [],\n    \"scope\": {\n      \"description\": \"Pending append notifications in a fixed valid cluster, including leadership changes, with no log compaction, no storage failures and unique payloads so operation content is observable.\",\n      \"assumptions\": [\n        \"Correct peer identities and unmodified messages produced by the implementation.\",\n        \"Configured runtime timers and caller-driven transport execute; network may temporarily isolate a peer.\"\n      ],\n      \"excluded\": [\n        \"No guarantee that a pending or superseded operation must succeed.\",\n        \"No claim of conflicting consensus decisions.\",\n        \"Crash recovery, compaction, batching and reconfiguration are outside the initial check.\"\n      ],\n      \"parameters\": {}\n    },\n    \"rationale\": \"Finish the usable backbone and select the newly sourced client-completion question, whose normative contract is explicit and whose discriminator does not require uncertain transport duplication assumptions.\",\n    \"status\": \"pending\",\n    \"previous_id\": null,\n    \"version\": 1,\n    \"boundary_changes\": [],\n    \"obligation_checks\": {},\n    \"remaining_obligation_ids\": [\n      \"claim-notify-correspondence\"\n    ],\n    \"recheck_reasons\": [],\n    \"coverage_limitations\": [],\n    \"progress\": [\n      {\n        \"claim_id\": \"claim-notify-correspondence\",\n        \"record_status\": \"no_fixed_check\"\n      }\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"units\",\n      \"match\": {\n        \"id\": \"unit-claim-notify-correspondence\",\n        \"version\": 1\n      }\n    }\n  }\n]\nclaims [\n  {\n    \"id\": \"claim-notify-correspondence\",\n    \"kind\": \"obligation\",\n    \"concern\": \"implementation_semantics\",\n    \"description\": \"If append_notify for an entry returns Ok(k), the decided log entry denoted by k must be that submitted entry; decision of a different entry at the