peating their full argument\",\n          \"title\": \"Derivation\",\n          \"type\": \"string\"\n        },\n        \"applicability\": {\n          \"default\": \"\",\n          \"description\": \"Conditions for this component, including any added assumptions or omitted protections\",\n          \"title\": \"Applicability\",\n          \"type\": \"string\"\n        },\n        \"unresolved\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unresolved\",\n          \"type\": \"array\"\n        },\n        \"conflicts\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Conflicts\",\n          \"type\": \"array\"\n        },\n        \"alternatives\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Alternatives\",\n          \"type\": \"array\"\n        }\n      },\n      \"title\": \"Grounding\",\n      \"type\": \"object\"\n    },\n    \"Harness\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"files\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Additional generated files with relative destinations and fixed source text\",\n          \"title\": \"Files\",\n          \"type\": \"object\"\n        },\n        \"kind\": {\n          \"description\": \"Harness kind advertised by the configured execution backend\",\n          \"title\": \"Kind\",\n          \"type\": \"string\"\n        },\n        \"source\": {\n          \"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\",\n          \"minLength\": 1,\n          \"title\": \"Source\",\n          \"type\": \"string\"\n        },\n        \"description\": {\n          \"title\": \"Description\",\n          \"type\": \"st