      \"kind\",\n        \"description\",\n        \"source_ids\",\n        \"scope\",\n        \"pending\"\n      ],\n      \"title\": \"ClaimDraft\",\n      \"type\": \"object\"\n    },\n    \"CodeAnchor\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"boundary_complete\": {\n          \"anyOf\": [\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Boundary Complete\"\n        },\n        \"kind\": {\n          \"default\": \"declaration\",\n          \"enum\": [\n            \"declaration\",\n            \"interface_member\",\n            \"callsite\"\n          ],\n          \"title\": \"Kind\",\n          \"type\": \"string\"\n        },\n        \"material_id\": {\n          \"title\": \"Material Id\",\n          \"type\": \"string\"\n        },\n        \"start_line\": {\n          \"minimum\": 1,\n          \"title\": \"Start Line\",\n          \"type\": \"integer\"\n        },\n        \"end_line\": {\n          \"minimum\": 1,\n          \"title\": \"End Line\",\n          \"type\": \"integer\"\n        },\n        \"symbol\": {\n          \"title\": \"Symbol\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"material_id\",\n        \"start_line\",\n        \"end_line\",\n        \"symbol\"\n      ],\n      \"title\": \"CodeAnchor\",\n      \"type\": \"object\"\n    },\n    \"ConditionDisposition\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"condition_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Stable ID from the supplied condition records; preferred for new output\",\n          \"title\": \"Condition Id\"\n        },\n        \"condition\": {\n          \"default\": \"\",\n          \"description\": \"Legacy exact-text reference; do not paraphrase it to bypass unresolved conditions\",\n          \"title\": \"Condition\",\n          \"type\": \"string\"\n        },\n        \"applies_to\": {\n          \"enum\": [\n            \"old_judgment\",\n            \"current_judgment\",\n            \"independent_scope\"\n          ],\n          \"title\": \"Applies To\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"description\": \"Explain the responsibility and range to which this condition applies, preserving counterevidence\",\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"applies_to\",\n        \"rationale\",\n        \"source_ids\"\n      ],\n      \"title\": \"ConditionDisposition\",\n      \"type\": \"object\"\n    },\n    \"EncodingRevision\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"old_direct_check_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Old Direct Check Id\"\n        },\n        \"issue_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          