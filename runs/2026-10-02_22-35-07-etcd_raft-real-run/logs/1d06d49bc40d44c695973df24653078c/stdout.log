{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/rafttest/interaction_env.go | sed -n '25,125p'; nl -ba ../agent-source/rafttest/interaction_env_handler_add_nodes.go | sed -n '85,140p'; nl -ba ../agent-source/doc.go | sed -n '240,258p'; nl -ba ../agent-source/rafttest/interaction_env_handler_compact.go | sed -n '27,100p'\"","aggregated_output":"    25\t)\n    26\t\n    27\t// InteractionOpts groups the options for an InteractionEnv.\n    28\ttype InteractionOpts struct {\n    29\t\tOnConfig func(*raft.Config)\n    30\t\n    31\t\t// SetRandomizedElectionTimeout is used to plumb this function down from the\n    32\t\t// raft test package.\n    33\t\tSetRandomizedElectionTimeout func(node *raft.RawNode, timeout int)\n    34\t}\n    35\t\n    36\t// Node is a member of a raft group tested via an InteractionEnv.\n    37\ttype Node struct {\n    38\t\t*raft.RawNode\n    39\t\tStorage\n    40\t\n    41\t\tConfig     *raft.Config\n    42\t\tAppendWork []pb.Message // []MsgStorageAppend\n    43\t\tApplyWork  []pb.Message // []MsgStorageApply\n    44\t\tHistory    []pb.Snapshot\n    45\t}\n    46\t\n    47\t// InteractionEnv facilitates testing of complex interactions between the\n    48\t// members of a raft group.\n    49\ttype InteractionEnv struct {\n    50\t\tOptions  *InteractionOpts\n    51\t\tNodes    []Node\n    52\t\tMessages []pb.Message // in-flight messages\n    53\t\n    54\t\tOutput *RedirectLogger\n    55\t}\n    56\t\n    57\t// NewInteractionEnv initializes an InteractionEnv. opts may be nil.\n    58\tfunc NewInteractionEnv(opts *InteractionOpts) *InteractionEnv {\n    59\t\tif opts == nil {\n    60\t\t\topts = &InteractionOpts{}\n    61\t\t}\n    62\t\treturn &InteractionEnv{\n    63\t\t\tOptions: opts,\n    64\t\t\tOutput: &RedirectLogger{\n    65\t\t\t\tBuilder: &strings.Builder{},\n    66\t\t\t},\n    67\t\t}\n    68\t}\n    69\t\n    70\tfunc (env *InteractionEnv) withIndent(f func()) {\n    71\t\torig := env.Output.Builder\n    72\t\tenv.Output.Builder = &strings.Builder{}\n    73\t\tf()\n    74\t\n    75\t\tscanner := bufio.NewScanner(strings.NewReader(env.Output.Builder.String()))\n    76\t\tfor scanner.Scan() {\n    77\t\t\torig.WriteString(\"  \" + scanner.Text() + \"\\n\")\n    78\t\t}\n    79\t\tenv.Output.Builder = orig\n    80\t}\n    81\t\n    82\t// Storage is the interface used by InteractionEnv. It is comprised of raft's\n    83\t// Storage interface plus access to operations that maintain the log and drive\n    84\t// the Ready handling loop.\n    85\ttype Storage interface {\n    86\t\traft.Storage\n    87\t\tSetHardState(state pb.HardState) error\n    88\t\tApplySnapshot(pb.Snapshot) error\n    89\t\tCompact(newFirstIndex uint64) error\n    90\t\tAppend([]pb.Entry) error\n    91\t}\n    92\t\n    93\t// raftConfigStub sets up a raft.Config stub with reasonable testing defaults.\n    94\t// In particular, no limits are set. It is not a complete config: ID and Storage\n    95\t// must be set for each node using the stub as a template.\n    96\tfunc raftConfigStub() raft.Config {\n    97\t\treturn raft.Config{\n    98\t\t\tElectionTick:    3,\n    99\t\t\tHeartbeatTick:   1,\n   100\t\t\tMaxSizePerMsg:   math.MaxUint64,\n   101\t\t\tMaxInflightMsgs: math.MaxInt32,\n   102\t\t}\n   103\t}\n   104\t\n   105\tfunc defaultEntryFormatter(b []byte) string {\n   106\t\treturn fmt.Sprintf(\"%q\", b)\n   107\t}\n    85\t\t\treturn s.snapshotOverride()\n    86\t\t}\n    87\t\treturn s.Storage.Snapshot()\n    88\t}\n    89\t\n    90\tvar _ raft.Storage = snapOverrideStorage{}\n    91\t\n    92\t// AddNodes adds n new nodes initialized from the given snapshot (which may be\n    93\t// empty), and using the cfg as template. They will be assigned consecutive IDs.\n    94\tfunc (env *InteractionEnv) AddNodes(n int, cfg raft.Config, snap pb.Snapshot) error {\n    95\t\tbootstrap := !reflect.DeepEqual(snap, pb.Snapshot{})\n    96\t\tfor i := 0; i < n; i++ {\n    97\t\t\tid := uint64(1 + len(env.Nodes))\n    98\t\t\ts := snapOverrideStorage{\n    99\t\t\t\tStorage: raft.NewMemoryStorage(),\n   100\t\t\t\t// When you ask for a snapshot, you get the most recent snapshot.\n   101\t\t\t\t//\n   102\t\t\t\t// TODO(tbg): this is sort of clunky, but MemoryStorage itself will\n   103\t\t\t\t// give you some fixed snapshot and also the snapshot changes\n   104\t\t\t\t// whenever you compact the logs and vice versa, so it's all a bit\n   105\t\t\t\t// awkward to use.\n   106\t\t\t\tsnapshotOverride: func() (pb.Snapshot, error) {\n   107\t\t\t\t\tsnaps := env.Nodes[int(id-1)].History\n   108\t\t\t\t\treturn snaps[len(snaps)-1], nil\n   109\t\t\t\t},\n   110\t\t\t}\n   111\t\t\tif bootstrap {\n   112\t\t\t\t// NB: we could make this work with 1, but MemoryStorage just\n   113\t\t\t\t// doesn't play well with that and it's not a loss of generality.\n   114\t\t\t\tif snap.Metadata.Index <= 1 {\n   115\t\t\t\t\treturn errors.New(\"index must be specified as > 1 due to bootstrap\")\n   116\t\t\t\t}\n   117\t\t\t\tsnap.Metadata.Term = 1\n   118\t\t\t\tif err := s.ApplySnapshot(snap); err != nil {\n   119\t\t\t\t\treturn err\n   120\t\t\t\t}\n   121\t\t\t\tfi, err := s.FirstIndex()\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn err\n   124\t\t\t\t}\n   125\t\t\t\t// At the time of writing and for *MemoryStorage, applying a\n   126\t\t\t\t// snapshot also truncates appropriately, but this would change with\n   127\t\t\t\t// other storage engines potentially.\n   128\t\t\t\tif exp := snap.Metadata.Index + 1; fi != exp {\n   129\t\t\t\t\treturn fmt.Errorf(\"failed to establish first index %d; got %d\", exp, fi)\n   130\t\t\t\t}\n   131\t\t\t}\n   132\t\t\tcfg := cfg // fork the config stub\n   133\t\t\tcfg.ID, cfg.Storage = id, s\n   134\t\t\tif env.Options.OnConfig != nil {\n   135\t\t\t\tenv.Options.OnConfig(&cfg)\n   136\t\t\t\tif cfg.ID != id {\n   137\t\t\t\t\t// This could be supported but then we need to do more work\n   138\t\t\t\t\t// translating back and forth -- not worth it.\n   139\t\t\t\t\treturn errors.New(\"OnConfig must not change the ID\")\n   140\t\t\t\t}\n   240\t\t// apply thread\n   241\t\tgo func() {\n   242\t\t  for {\n   243\t\t    select {\n   244\t\t    case m := <-toApply:\n   245\t\t      for _, entry := range m.CommittedEntries {\n   246\t\t        process(entry)\n   247\t\t        if entry.Type == raftpb.EntryConfChange {\n   248\t\t          var cc raftpb.ConfChange\n   249\t\t          cc.Unmarshal(entry.Data)\n   250\t\t          s.Node.ApplyConfChange(cc)\n   251\t\t        }\n   252\t\t      }\n   253\t\t      send(m.Responses)\n   254\t\t    case <-s.done:\n   255\t\t      return\n   256\t\t    }\n   257\t\t  }\n   258\t\t}\n    27\t\tif err != nil {\n    28\t\t\treturn err\n    29\t\t}\n    30\t\treturn env.Compact(idx, newFirstIndex)\n    31\t}\n    32\t\n    33\t// Compact truncates the log on the node at index idx so that the supplied new\n    34\t// first index results.\n    35\tfunc (env *InteractionEnv) Compact(idx int, newFirstIndex uint64) error {\n    36\t\tif err := env.Nodes[idx].Compact(newFirstIndex); err != nil {\n    37\t\t\treturn err\n    38\t\t}\n    39\t\treturn env.RaftLog(idx)\n    40\t}\n","exit_code":0,"status":"completed"}}
