sage) bool {\n  3063\t\t\tif m.Type != pb.MsgAppResp || m.From != 3 || m.Reject {\n  3064\t\t\t\treturn true\n  3065\t\t\t}\n  3066\t\t\tfiltered = m\n  3067\t\t\treturn false\n  3068\t\t}\n  3069\t\t// Transfer leadership to 3 when node 3 is lack of snapshot.\n  3070\t\tnt.send(pb.Message{From: 3, To: 1, Type: pb.MsgTransferLeader})\n  3071\t\trequire.Equal(t, StateLeader, lead.state)\n  3072\t\trequire.NotEqual(t, pb.Message{}, filtered)\n  3073\t\n  3074\t\t// Apply snapshot and resume progress\n  3075\t\tfollower := nt.peers[3].(*raft)\n  3076\t\tsnap := follower.raftLog.nextUnstableSnapshot()\n  3077\t\tnt.storage[3].ApplySnapshot(*snap)\n  3078\t\tfollower.appliedSnap(snap)\n  3079\t\tnt.msgHook = nil\n  3080\t\tnt.send(filtered)\n  3081\t\n  3082\t\tcheckLeaderTransferState(t, lead, StateFollower, 3)\n  3083\t}\n  3084\t\n  3085\tfunc TestLeaderTransferToSelf(t *testing.T) {\n  3086\t\tnt := newNetwork(nil, nil, nil)\n  3087\t\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})\n  3088\t\n  3089\t\tlead := nt.peers[1].(*raft)\n  3090\t\n  3091\t\t// Transfer leadership to self, there will be noop.\n  3092\t\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgTransferLeader})\n  3093\t\tcheckLeaderTransferState(t, lead, StateLeader, 1)\n  3094\t}\n  3095\t\n  3096\tfunc TestLeaderTransferToNonExistingNode(t *testing.T) {\n  3097\t\tnt := newNetwork(nil, nil, nil)\n  3098\t\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})\n  3099\t\n  3100\t\tlead := nt.peers[1].(*raft)\n  3101\t\t// Transfer leadership to non-existing node, there will be noop.\n  3102\t\tnt.send(pb.Message{From: 4, To: 1, Type: pb.MsgTransferLeader})\n  3103\t\tcheckLeaderTransferState(t, lead, StateLeader, 1)\n  3104\t}\n  3105\t\n  3106\tfunc TestLeaderTransferTimeout(t *testing.T) {\n  3107\t\tnt := newNetwork(nil, nil, nil)\n  3108\t\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})\n  3109\t\n  3110\t\tnt.isolate(3)\nCandidateSubmission {\n  \"additionalProperties\": false,\n  \"pr