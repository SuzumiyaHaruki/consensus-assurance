{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/rawnode_test.go | sed -n '715,850p'; grep -nE 'MsgStorageAppend|durab|AsyncStorage' ../agent-source/raftpb/raft.proto ../agent-source/rafttest/interaction_env.go ../agent-source/rafttest/interaction_env_handler_process_ready.go 2>/dev/null; ls ../agent-source/rafttest\"","aggregated_output":"   715\t\n   716\t// TestNodeAdvance from node_test.go has no equivalent in rawNode because there is\n   717\t// no dependency check between Ready() and Advance()\n   718\tfunc TestRawNodeStatus(t *testing.T) {\n   719\t\ts := newTestMemoryStorage(withPeers(1))\n   720\t\trn, err := NewRawNode(newTestConfig(1, 10, 1, s))\n   721\t\trequire.NoError(t, err)\n   722\t\trequire.Nil(t, rn.Status().Progress)\n   723\t\trequire.NoError(t, rn.Campaign())\n   724\t\n   725\t\trd := rn.Ready()\n   726\t\ts.Append(rd.Entries)\n   727\t\trn.Advance(rd)\n   728\t\tstatus := rn.Status()\n   729\t\trequire.Equal(t, uint64(1), status.Lead)\n   730\t\trequire.Equal(t, StateLeader, status.RaftState)\n   731\t\trequire.Equal(t, *rn.raft.trk.Progress[1], status.Progress[1])\n   732\t\n   733\t\texpCfg := tracker.Config{Voters: quorum.JointConfig{\n   734\t\t\tquorum.MajorityConfig{1: {}},\n   735\t\t\tnil,\n   736\t\t}}\n   737\t\trequire.Equal(t, expCfg, status.Config)\n   738\t}\n   739\t\n   740\t// TestRawNodeCommitPaginationAfterRestart is the RawNode version of\n   741\t// TestNodeCommitPaginationAfterRestart. The anomaly here was even worse as the\n   742\t// Raft group would forget to apply entries:\n   743\t//\n   744\t//   - node learns that index 11 is committed\n   745\t//   - nextCommittedEnts returns index 1..10 in CommittedEntries (but index 10\n   746\t//     already exceeds maxBytes), which isn't noticed internally by Raft\n   747\t//   - Commit index gets bumped to 10\n   748\t//   - the node persists the HardState, but crashes before applying the entries\n   749\t//   - upon restart, the storage returns the same entries, but `slice` takes a\n   750\t//     different code path and removes the last entry.\n   751\t//   - Raft does not emit a HardState, but when the app calls Advance(), it bumps\n   752\t//     its internal applied index cursor to 10 (when it should be 9)\n   753\t//   - the next Ready asks the app to apply index 11 (omitting index 10), losing a\n   754\t//     write.\n   755\tfunc TestRawNodeCommitPaginationAfterRestart(t *testing.T) {\n   756\t\ts := &ignoreSizeHintMemStorage{\n   757\t\t\tMemoryStorage: newTestMemoryStorage(withPeers(1)),\n   758\t\t}\n   759\t\tpersistedHardState := pb.HardState{\n   760\t\t\tTerm:   1,\n   761\t\t\tVote:   1,\n   762\t\t\tCommit: 10,\n   763\t\t}\n   764\t\n   765\t\ts.hardState = persistedHardState\n   766\t\ts.ents = make([]pb.Entry, 10)\n   767\t\tvar size uint64\n   768\t\tfor i := range s.ents {\n   769\t\t\tent := pb.Entry{\n   770\t\t\t\tTerm:  1,\n   771\t\t\t\tIndex: uint64(i + 1),\n   772\t\t\t\tType:  pb.EntryNormal,\n   773\t\t\t\tData:  []byte(\"a\"),\n   774\t\t\t}\n   775\t\n   776\t\t\ts.ents[i] = ent\n   777\t\t\tsize += uint64(ent.Size())\n   778\t\t}\n   779\t\n   780\t\tcfg := newTestConfig(1, 10, 1, s)\n   781\t\t// Set a MaxSizePerMsg that would suggest to Raft that the last committed entry should\n   782\t\t// not be included in the initial rd.CommittedEntries. However, our storage will ignore\n   783\t\t// this and *will* return it (which is how the Commit index ended up being 10 initially).\n   784\t\tcfg.MaxSizePerMsg = size - uint64(s.ents[len(s.ents)-1].Size()) - 1\n   785\t\n   786\t\ts.ents = append(s.ents, pb.Entry{\n   787\t\t\tTerm:  1,\n   788\t\t\tIndex: uint64(11),\n   789\t\t\tType:  pb.EntryNormal,\n   790\t\t\tData:  []byte(\"boom\"),\n   791\t\t})\n   792\t\n   793\t\trawNode, err := NewRawNode(cfg)\n   794\t\trequire.NoError(t, err)\n   795\t\n   796\t\tfor highestApplied := uint64(0); highestApplied != 11; {\n   797\t\t\trd := rawNode.Ready()\n   798\t\t\tn := len(rd.CommittedEntries)\n   799\t\t\trequire.NotZero(t, n, \"stopped applying entries at index %d\", highestApplied)\n   800\t\t\tnext := rd.CommittedEntries[0].Index\n   801\t\t\trequire.False(t, highestApplied != 0 && highestApplied+1 != next,\n   802\t\t\t\t\"attempting to apply index %d after index %d, leaving a gap\", next, highestApplied)\n   803\t\n   804\t\t\thighestApplied = rd.CommittedEntries[n-1].Index\n   805\t\t\trawNode.Advance(rd)\n   806\t\t\trawNode.Step(pb.Message{\n   807\t\t\t\tType:   pb.MsgHeartbeat,\n   808\t\t\t\tTo:     1,\n   809\t\t\t\tFrom:   2, // illegal, but we get away with it\n   810\t\t\t\tTerm:   1,\n   811\t\t\t\tCommit: 11,\n   812\t\t\t})\n   813\t\t}\n   814\t}\n   815\t\n   816\t// TestRawNodeBoundedLogGrowthWithPartition tests a scenario where a leader is\n   817\t// partitioned from a quorum of nodes. It verifies that the leader's log is\n   818\t// protected from unbounded growth even as new entries continue to be proposed.\n   819\t// This protection is provided by the MaxUncommittedEntriesSize configuration.\n   820\tfunc TestRawNodeBoundedLogGrowthWithPartition(t *testing.T) {\n   821\t\tconst maxEntries = 16\n   822\t\tdata := []byte(\"testdata\")\n   823\t\ttestEntry := pb.Entry{Data: data}\n   824\t\tmaxEntrySize := maxEntries * payloadSize(testEntry)\n   825\t\tt.Log(\"maxEntrySize\", maxEntrySize)\n   826\t\n   827\t\ts := newTestMemoryStorage(withPeers(1))\n   828\t\tcfg := newTestConfig(1, 10, 1, s)\n   829\t\tcfg.MaxUncommittedEntriesSize = uint64(maxEntrySize)\n   830\t\trawNode, err := NewRawNode(cfg)\n   831\t\trequire.NoError(t, err)\n   832\t\n   833\t\t// Become the leader and apply empty entry.\n   834\t\trawNode.Campaign()\n   835\t\tfor {\n   836\t\t\trd := rawNode.Ready()\n   837\t\t\ts.Append(rd.Entries)\n   838\t\t\trawNode.Advance(rd)\n   839\t\t\tif len(rd.CommittedEntries) > 0 {\n   840\t\t\t\tbreak\n   841\t\t\t}\n   842\t\t}\n   843\t\n   844\t\t// Simulate a network partition while we make our proposals by never\n   845\t\t// committing anything. These proposals should not cause the leader's\n   846\t\t// log to grow indefinitely.\n   847\t\tfor i := 0; i < 1024; i++ {\n   848\t\t\trawNode.Propose(data)\n   849\t\t}\n   850\t\n../agent-source/raftpb/raft.proto:61:\tMsgStorageAppend     = 19;\n../agent-source/raftpb/raft.proto:62:\tMsgStorageAppendResp = 20;\n../agent-source/raftpb/raft.proto:81:\t// (type=MsgStorageAppendResp,index=100,logTerm=5) means the local node wrote\n../agent-source/raftpb/raft.proto:83:\t// 100 was 5. This doesn't always mean that the corresponding MsgStorageAppend\n../agent-source/raftpb/raft.proto:85:\t// stable at the time of processing the corresponding MsgStorageAppend.\n../agent-source/raftpb/raft.proto:90:\t// (type=MsgStorageAppend,vote=5,term=10) means the local node is voting for\n../agent-source/raftpb/raft.proto:91:\t// peer 5 in term 10. For MsgStorageAppends, the term, vote, and commit fields\n../agent-source/raftpb/raft.proto:106:\t// is complete. Populated for MsgStorageAppend and MsgStorageApply messages.\n../agent-source/rafttest/interaction_env.go:42:\tAppendWork []pb.Message // []MsgStorageAppend\n../agent-source/rafttest/interaction_env_handler_process_ready.go:51:\tif !n.Config.AsyncStorageWrites {\n../agent-source/rafttest/interaction_env_handler_process_ready.go:62:\t\t\tif !n.Config.AsyncStorageWrites {\n../agent-source/rafttest/interaction_env_handler_process_ready.go:66:\t\t\tcase raftpb.MsgStorageAppend:\n../agent-source/rafttest/interaction_env_handler_process_ready.go:78:\tif !n.Config.AsyncStorageWrites {\ndoc.go\ninteraction_env.go\ninteraction_env_handler.go\ninteraction_env_handler_add_nodes.go\ninteraction_env_handler_campaign.go\ninteraction_env_handler_compact.go\ninteraction_env_handler_deliver_msgs.go\ninteraction_env_handler_forget_leader.go\ninteraction_env_handler_log_level.go\ninteraction_env_handler_process_append_thread.go\ninteraction_env_handler_pr