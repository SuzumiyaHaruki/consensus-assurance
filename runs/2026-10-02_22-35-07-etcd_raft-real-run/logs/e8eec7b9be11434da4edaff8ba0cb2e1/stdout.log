{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nr=json.load(open('../research.json'))\nfor k in ['capacity','assessments','pending_work']:print(k,json.dumps(r[k]))\nPY\nnl -ba ../agent-source/raft.go | sed -n '291,340p'; nl -ba ../agent-source/rawnode_test.go | sed -n '20,100p'; grep -nE 'AsyncStorageWrites|msgsAfterAppend|before.*persist|persist.*before' ../agent-source/rawnode_test.go | head -50\"","aggregated_output":"capacity {\"remaining\": {\"agent_calls\": 29, \"experiments\": 12, \"audit_units\": 4, \"semantic_reviews\": 8, \"revisions\": 6}, \"remaining_seconds\": 263.21028153500083, \"new_obligation\": true, \"direct_execution\": true, \"source_investigation\": true, \"exhausted\": []}\nassessments [{\"claim_id\": \"claim-autoleave-continuation\", \"direct_check_id\": \"4b82b66fa96f4bc3b93a10833dc75da1\", \"experiment_check_id\": \"97aac198d2bc4b10be4e3104e70bb614\", \"confirmed\": true, \"outcome\": \"violated\", \"blockers\": [], \"bounded_complete\": true, \"reviewed_complete\": true, \"correspondence\": \"no_issue_found\", \"review_ids\": [\"ddddee2e281947f7a1e152273f6f9836\"], \"open_issue_ids\": [], \"record\": {\"path\": \"state.json\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"97aac198d2bc4b10be4e3104e70bb614\", \"claim_id\": \"claim-autoleave-continuation\"}}}, {\"claim_id\": \"claim-node-conf-admission\", \"direct_check_id\": \"f8fa8ddc6b3f46e89c9b1bd5a5482a49\", \"experiment_check_id\": \"0658bc3db0044fef9d8fa246d1dff118\", \"confirmed\": true, \"outcome\": \"violated\", \"blockers\": [], \"bounded_complete\": true, \"reviewed_complete\": true, \"correspondence\": \"no_issue_found\", \"review_ids\": [\"fb3e7ff25d384af1a14ccd3ae126bab8\"], \"open_issue_ids\": [], \"record\": {\"path\": \"state.json\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"0658bc3db0044fef9d8fa246d1dff118\", \"claim_id\": \"claim-node-conf-admission\"}}}]\npending_work []\n   291\tfunc (c *Config) validate() error {\n   292\t\tif c.ID == None {\n   293\t\t\treturn errors.New(\"cannot use none as id\")\n   294\t\t}\n   295\t\tif IsLocalMsgTarget(c.ID) {\n   296\t\t\treturn errors.New(\"cannot use local target as id\")\n   297\t\t}\n   298\t\n   299\t\tif c.HeartbeatTick <= 0 {\n   300\t\t\treturn errors.New(\"heartbeat tick must be greater than 0\")\n   301\t\t}\n   302\t\n   303\t\tif c.ElectionTick <= c.HeartbeatTick {\n   304\t\t\treturn errors.New(\"election tick must be greater than heartbeat tick\")\n   305\t\t}\n   306\t\n   307\t\tif c.Storage == nil {\n   308\t\t\treturn errors.New(\"storage cannot be nil\")\n   309\t\t}\n   310\t\n   311\t\tif c.MaxUncommittedEntriesSize == 0 {\n   312\t\t\tc.MaxUncommittedEntriesSize = noLimit\n   313\t\t}\n   314\t\n   315\t\t// default MaxCommittedSizePerReady to MaxSizePerMsg because they were\n   316\t\t// previously the same parameter.\n   317\t\tif c.MaxCommittedSizePerReady == 0 {\n   318\t\t\tc.MaxCommittedSizePerReady = c.MaxSizePerMsg\n   319\t\t}\n   320\t\n   321\t\tif c.MaxInflightMsgs <= 0 {\n   322\t\t\treturn errors.New(\"max inflight messages must be greater than 0\")\n   323\t\t}\n   324\t\tif c.MaxInflightBytes == 0 {\n   325\t\t\tc.MaxInflightBytes = noLimit\n   326\t\t} else if c.MaxInflightBytes < c.MaxSizePerMsg {\n   327\t\t\treturn errors.New(\"max inflight bytes must be >= max message size\")\n   328\t\t}\n   329\t\n   330\t\tif c.Logger == nil {\n   331\t\t\tc.Logger = getLogger()\n   332\t\t}\n   333\t\n   334\t\tif c.ReadOnlyOption == ReadOnlyLeaseBased && !c.CheckQuorum {\n   335\t\t\treturn errors.New(\"CheckQuorum must be enabled when ReadOnlyOption is ReadOnlyLeaseBased\")\n   336\t\t}\n   337\t\n   338\t\treturn nil\n   339\t}\n   340\t\n    20\t\t\"math\"\n    21\t\t\"testing\"\n    22\t\n    23\t\t\"github.com/stretchr/testify/assert\"\n    24\t\t\"github.com/stretchr/testify/require\"\n    25\t\n    26\t\t\"go.etcd.io/raft/v3/quorum\"\n    27\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    28\t\t\"go.etcd.io/raft/v3/tracker\"\n    29\t)\n    30\t\n    31\t// rawNodeAdapter is essentially a lint that makes sure that RawNode implements\n    32\t// \"most of\" Node. The exceptions (some of which are easy to fix) are listed\n    33\t// below.\n    34\ttype rawNodeAdapter struct {\n    35\t\t*RawNode\n    36\t}\n    37\t\n    38\tvar _ Node = (*rawNodeAdapter)(nil)\n    39\t\n    40\t// TransferLeadership is to test when node specifies lead, which is pointless, can just be filled in.\n    41\tfunc (a *rawNodeAdapter) TransferLeadership(_ context.Context, _, transferee uint64) {\n    42\t\ta.RawNode.TransferLeader(transferee)\n    43\t}\n    44\t\n    45\t// ForgetLeader takes a context, RawNode doesn't need it.\n    46\tfunc (a *rawNodeAdapter) ForgetLeader(context.Context) error { return a.RawNode.ForgetLeader() }\n    47\t\n    48\t// Stop when node has a goroutine, RawNode doesn't need this.\n    49\tfunc (a *rawNodeAdapter) Stop() {}\n    50\t\n    51\t// Status retirns RawNode's status as *Status.\n    52\tfunc (a *rawNodeAdapter) Status() Status { return a.RawNode.Status() }\n    53\t\n    54\t// Advance is when RawNode takes a Ready. It doesn't really have to do that I think? It can hold on\n    55\t// to it internally. But maybe that approach is frail.\n    56\tfunc (a *rawNodeAdapter) Advance() { a.RawNode.Advance(Ready{}) }\n    57\t\n    58\t// Ready when RawNode returns a Ready, not a chan of one.\n    59\tfunc (a *rawNodeAdapter) Ready() <-chan Ready { return nil }\n    60\t\n    61\t// Node takes more contexts. Easy enough to fix.\n    62\t\n    63\tfunc (a *rawNodeAdapter) Campaign(context.Context) error { return a.RawNode.Campaign() }\n    64\tfunc (a *rawNodeAdapter) ReadIndex(_ context.Context, rctx []byte) error {\n    65\t\ta.RawNode.ReadIndex(rctx)\n    66\t\t// RawNode swallowed the error in ReadIndex, it probably should not do that.\n    67\t\treturn nil\n    68\t}\n    69\tfunc (a *rawNodeAdapter) Step(_ context.Context, m pb.Message) error { return a.RawNode.Step(m) }\n    70\tfunc (a *rawNodeAdapter) Propose(_ context.Context, data []byte) error {\n    71\t\treturn a.RawNode.Propose(data)\n    72\t}\n    73\tfunc (a *rawNodeAdapter) ProposeConfChange(_ context.Context, cc pb.ConfChangeI) error {\n    74\t\treturn a.RawNode.ProposeConfChange(cc)\n    75\t}\n    76\t\n    77\t// TestRawNodeStep ensures that RawNode.Step ignore local message.\n    78\tfunc TestRawNodeStep(t *testing.T) {\n    79\t\tfor i, msgn := range pb.MessageType_name {\n    80\t\t\tt.Run(msgn, func(t *testing.T) {\n    81\t\t\t\ts := NewMemoryStorage()\n    82\t\t\t\ts.SetHardState(pb.HardState{Term: 1, Commit: 1})\n    83\t\t\t\ts.Append([]pb.Entry{{Term: 1, Index: 1}})\n    84\t\t\t\trequire.NoError(t, s.ApplySnapshot(pb.Snapshot{Metadata: pb.SnapshotMetadata{\n    85\t\t\t\t\tConfState: pb.ConfState{\n    86\t\t\t\t\t\tVoters: []uint64{1},\n    87\t\t\t\t\t},\n    88\t\t\t\t\tIndex: 1,\n    89\t\t\t\t\tTerm:  1,\n    90\t\t\t\t}}), \"#%d\", i)\n    91\t\t\t\t// Append an empty entry to make sure the non-local messages (like\n    92\t\t\t\t// vote requests) are ignored and don't trigger assertions.\n    93\t\t\t\trawNode, err := NewRawNode(newTestConfig(1, 10, 1, s))\n    94\t\t\t\trequire.NoError(t, err, \"#%d\", i)\n    95\t\t\t\tmsgt := pb.MessageType(i)\n    96\t\t\t\terr = rawNode.Step(pb.Message{Type: msgt})\n    97\t\t\t\t// LocalMsg should be ignored.\n    98\t\t\t\tif IsLocalMsg(msgt) {\n    99\t\t\t\t\tassert.Equal(t, ErrStepLocalMsg, err, \"#%d\", i)\n   100\t\t\t\t}\n748://   - the node persists the HardState, but crashes before applying the entries\n","exit_code":0,"status":"completed"}}
