t64, log *Log) error {"},{"file":"log_cache.go","line":62,"declaration":"func (c *LogCache) StoreLog(log *Log) error {"},{"file":"log_cache.go","line":66,"declaration":"func (c *LogCache) StoreLogs(logs []*Log) error {"},{"file":"raft.go","line":35,"declaration":"func (r *Raft) getRPCHeader() RPCHeader {"},{"file":"raft.go","line":45,"declaration":"func (r *Raft) checkRPCHeader(rpc RPC) error {"},{"file":"raft.go","line":75,"declaration":"func getSnapshotVersion(protocolVersion ProtocolVersion) SnapshotVersion {"},{"file":"raft.go","line":83,"declaration":"type commitTuple struct {"},{"file":"raft.go","line":89,"declaration":"type leaderState struct {"},{"file":"raft.go","line":100,"declaration":"func (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {"},{"file":"replication.go","line":33,"declaration":"type followerReplication struct {"},{"file":"replication.go","line":100,"declaration":"func (s *followerReplication) notifyAll(leader bool) {"},{"file":"replication.go","line":114,"declaration":"func (s *followerReplication) cleanNotify(v *verifyFuture) {"},{"file":"replication.go","line":121,"declaration":"func (s *followerReplication) LastContact() time.Time {"},{"file":"replication.go","line":129,"declaration":"func (s *followerReplication) setLastContact() {"},{"file":"replication.go","line":137,"declaration":"func (r *Raft) replicate(s *followerReplication) {"}],"lookup_request":"Request a focused ReadingPlan for an unlisted path or symbol; omitted files are not absent from the repository","file_metadata":[{"file":"commands.go","lines":223,"content_digest":"44cf24bfd7cdde1123e73c7bc8c51fed84a2d0448f30da29b09b7bdc10e834c3","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8","read_ranges":[[1,130]],"attached_ranges":[[1,130]]},{"file":"inmem_store.go","lines":133,"content_digest":"f3b96b27f9e685c41216ec03342988da4fd2bc256c0e6154ba8021bd791fc59b","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8","read_ranges":[[1,133