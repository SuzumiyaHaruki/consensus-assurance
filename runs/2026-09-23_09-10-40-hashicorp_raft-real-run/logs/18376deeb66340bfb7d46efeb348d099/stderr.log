{
  "reading_purpose": "dependency",
  "plan": {
    "description": "Measure the accepted conditional predecessor-integrity obligation through actual sequential appendEntries calls, with a retained-predecessor control.",
    "claim_id": "O_append_predecessor_integrity",
    "binding_ids": ["BIND_append_predecessor_integrity", "BIND_last_entry_representation"],
