stablished unique authority.","identity":{"node":"Raft instance","campaign":"runCandidate invocation and voteCh"},"established_by":["B_candidate_results"],"consumed_by":[],"validity_context":"Established on the granted-vote threshold branch; campaign-result provenance remains unresolved.","representation":["Role assignment","Local leader address and ID"],"invalidators":["B_append_entries","B_leader_stepdown"],"reinterpreters":[],"durability":"No durable leadership assignment is established by the supplied code.","recovery":"Election and startup reconstruction require further reading.","source_ids":["raft.go:285:441"],"unknowns":["Other role-changing paths are unread.","runLeader consumes local role through an unread dispatcher; it is not represented as a fact consumer here."]}],"surfaces":[{"entry_point":"Raft.runCandidate","disposition":"mapped","behavior_ids":["B_candidate_results"],"reason":"Result consumption is mapped; election-result establishment remains deferred.","source_ids":["raft.go:285:441"],"high_consequence":true},{"entry_point":"Raft.appendEntries","disposition":"mapped","behavior_ids":["B_append_entries"],"reason":"Success and partial-failure branches are mapped without asserting storage consistency.","source_ids":["raft.go:1440:1584"],"high_consequence":true},{"entry_point":"Raft.handleStaleTerm and leaderLoop stepDown case","disposition":"mapped","behavior_ids":["B_stale_term_request","B_leader_stepdown"],"reason":"Notification and role-change consumption are explicitly separate.","source_ids":["replication.go:646:665","raft.go:667:826"],"high_consequence":true}]},"activity_focus":["A1","A2"],"directed_question":null,"parameters":{},"materials":[{"id":"raft.go:285:441","file":"raft.go","start_line":285,"end_line":441,"kind":"code_observation","text":"func (r *Raft) runCandidate() {\n\tterm := r.getCurrentTerm() + 1\n\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n\n\t// Start vote for us, and set a timeout\n\tvar voteCh <-chan *voteResult\n\tvar prevoteCh <-chan *preVoteResult\n\n\t// check if pre-vote is active and that this is not a leader transfer.\n\t// Leader transfer do not perform prevote by design\n\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n\t\tprevoteCh = r.preElectSelf()\n\t} else {\n\t\tvoteCh = r.electSelf()\n\t}\n\n\t// Make sure the leadership transfer flag is reset after each run. Having this\n\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n\t// which will make other servers vote even though they have a leader already.\n\t// It is important to reset that flag, because this privilege could be abused\n\t// otherwise.\n\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n\n\telectionTimeout := r.config().ElectionTimeout\n\telectionTimer := randomTimeout(electionTimeout)\n\n\t// Tally the votes, need a simple majority\n\tpreVoteGrantedVotes := 0\n\tpreVoteRefusedVotes := 0\n\tgrantedVotes := 0\n\tvotesNeeded := r.quorumSize()\n\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n\n\tfor r.getState() == Candidate {\n\t\tr.mainThreadSaturation.sleeping()\n\n\t\tselect {\n\t\tcase rpc := <-r.rpcCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tr.processRPC(rpc)\n\t\tcase preVote := <-prevoteCh:\n\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n\t\t\t// Check if the term is greater than ours, bail\n\t\t\tif preVote.Term > term {\n\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n\t\t\t\tr.setState(Follower)\n\t\t\t\tr.setCurrentTerm(preVote.Term)\n\t\t\t\treturn\n\t\t\t}\n\n\t\t\t// Check if the preVote is granted\n\t\t\tif preVote.Granted {\n\t\t\t\tpreVoteGrantedVotes++\n\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n\t\t\t} else {\n\t\t\t\tpreVoteRefusedVotes++\n\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n\t\t\t}\n\n\t\t\t// Check if we've won the pre-vote and proceed to election if so\n\t\t\tif preVoteGrantedVotes >= votesNeeded {\n\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n\t\t\t\tpreVoteGrantedVotes = 0\n\t\t\t\tpreVoteRefusedVotes = 0\n\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n\t\t\t\tprevoteCh = nil\n\t\t\t\tvoteCh = r.electSelf()\n\t\t\t}\n\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n\t\t\t// prevote.\n\t\t\tif preVoteRefusedVotes >= votesNeeded {\n\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n\t\t\t}\n\t\tcase vote := <-voteCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Check if the term is greater than ours, bail\n\t\t\tif vote.Term > r.getCurrentTerm() {\n\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n\t\t\t\tr.setState(Follower)\n\t\t\t\tr.setCurrentTerm(vote.Term)\n\t\t\t\treturn\n\t\t\t}\n\n\t\t\t// Check if the vote is granted\n\t\t\tif vote.Granted {\n\t\t\t\tgrantedVotes++\n\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n\t\t\t}\n\n\t\t\t// Check if we've become the leader\n\t\t\tif grantedVotes >= votesNeeded {\n\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n\t\t\t\tr.setState(Leader)\n\t\t\t\tr.setLeader(r.localAddr, r.localID)\n\t\t\t\treturn\n\t\t\t}\n\t\tcase c := <-r.configurationChangeCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Reject any operations since we are not the leader\n\t\t\tc.respond(ErrNotLeader)\n\n\t\tcase a := <-r.applyCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Reject any operations since we are not the leader\n\t\t\ta.respond(ErrNotLeader)\n\n\t\tcase v := <-r.verifyCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Reject any operations since we are not the leader\n\t\t\tv.respond(ErrNotLeader)\n\n\t\tcase ur := <-r.userRestoreCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Reject any restores since we are not the leader\n\t\t\tur.respond(ErrNotLeader)\n\n\t\tcase l := <-r.leadershipTransferCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Reject any operations since we are not the leader\n\t\t\tl.respond(ErrNotLeader)\n\n\t\tcase c := <-r.configurationsCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tc.configurations = r.configurations.Clone()\n\t\t\tc.respond(nil)\n\n\t\tcase b := <-r.bootstrapCh:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\tb.respond(ErrCantBootstrap)\n\n\t\tcase <-r.leaderNotifyCh:\n\t\t\t//  Ignore since we are not the leader\n\n\t\tcase <-r.followerNotifyCh:\n\t\t\tif electionTimeout != r.config().ElectionTimeout {\n\t\t\t\telectionTimeout = r.config().ElectionTimeout\n\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n\t\t\t}\n\n\t\tcase <-electionTimer:\n\t\t\tr.mainThreadSaturation.working()\n\t\t\t// Election failed! Restart the election. We simply return,\n\t\t\t// which will kick us back into runCandidate\n\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n\t\t\treturn\n\n\t\tcase <-r.shutdownCh:\n\t\t\treturn\n\t\t}\n\t}\n}\n","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800"},{"id":"raft.go:1440:1584","file":"raft.go","start_line":1440,"end_line":1584,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"raft.go:827:1100","file":"raft.go","start_line":827,"end_line":1100,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"raft.go:1585:1820","file":"raft.go","start_line":1585,"end_line":1820,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"raft.go:1900:2241","file":"raft.go","start_line":1900,"end_line":2241,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"commands.go:1:223","file":"commands.go","start_line":1,"end_line":223,"kind":"interface_statement","text":"// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\n// RPCHeader is a common sub-structure used to pass along protocol version and\n// other information about the cluster. For older Raft implementations before\n// versioning was added this will default to a zero-valued structure when read\n// by newer Raft versions.\ntype RPCHeader struct {\n\t// ProtocolVersion is the version of the protocol the sender is\n\t// speaking.\n\tProtocolVersion ProtocolVersion\n\t// ID is the ServerID of the node sending the RPC Request or Response\n\tID []byte\n\t// Addr is the ServerAddr of the node sending the RPC Request or Response\n\tAddr []byte\n}\n\n// WithRPCHeader is an interface that exposes the RPC header.\ntype WithRPCHeader interface {\n\tGetRPCHeader() RPCHeader\n}\n\n// AppendEntriesRequest is the command used to append entries to the\n// replicated log.\ntype AppendEntriesRequest struct {\n\tRPCHeader\n\n\t// Provide the current term and leader\n\tTerm uint64\n\n\t// Deprecated: use RPCHeader.Addr instead\n\tLeader []byte\n\n\t// Provide the previous entries for integrity checking\n\tPrevLogEntry uint64\n\tPrevLogTerm  uint64\n\n\t// New entries to commit\n\tEntries []*Log\n\n\t// Commit index on the leader\n\tLeaderCommitIndex uint64\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *AppendEntriesRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// AppendEntriesResponse is the response returned from an\n// AppendEntriesRequest.\ntype AppendEntriesResponse struct {\n\tRPCHeader\n\n\t// Newer term if leader is out of date\n\tTerm uint64\n\n\t// Last Log is a hint to help accelerate rebuilding slow nodes\n\tLastLog uint64\n\n\t// We may not succeed if we have a conflicting entry\n\tSuccess bool\n\n\t// There are scenarios where this request didn't succeed\n\t// but there's no need to wait/back-off the next attempt.\n\tNoRetryBackoff bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *AppendEntriesResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// RequestVoteRequest is the command used by a candidate to ask a Raft peer\n// for a vote in an election.\ntype RequestVoteRequest struct {\n\tRPCHeader\n\n\t// Provide the term and our id\n\tTerm uint64\n\n\t// Deprecated: use RPCHeader.Addr instead\n\tCandidate []byte\n\n\t// Used to ensure safety\n\tLastLogIndex uint64\n\tLastLogTerm  uint64\n\n\t// Used to indicate to peers if this vote was triggered by a leadership\n\t// transfer. It is required for leadership transfer to work, because servers\n\t// wouldn't vote otherwise if they are aware of an existing leader.\n\tLeadershipTransfer bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *RequestVoteRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// RequestVoteResponse is the response returned from a RequestVoteRequest.\ntype RequestVoteResponse struct {\n\tRPCHeader\n\n\t// Newer term if leader is out of date.\n\tTerm uint64\n\n\t// Peers is deprecated, but required by servers that only understand\n\t// protocol version 0. This is not populated in protocol version 2\n\t// and later.\n\tPeers []byte\n\n\t// Is the vote granted.\n\tGranted bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *RequestVoteResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// RequestPreVoteRequest is the command used by a candidate to ask a Raft peer\n// for a vote in an election.\ntype RequestPreVoteRequest struct {\n\tRPCHeader\n\n\t// Provide the term and our id\n\tTerm uint64\n\n\t// Used to ensure safety\n\tLastLogIndex uint64\n\tLastLogTerm  uint64\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *RequestPreVoteRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// RequestPreVoteResponse is the response returned from a RequestPreVoteRequest.\ntype RequestPreVoteResponse struct {\n\tRPCHeader\n\n\t// Newer term if leader is out of date.\n\tTerm uint64\n\n\t// Is the vote granted.\n\tGranted bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *RequestPreVoteResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// InstallSnapshotRequest is the command sent to a Raft peer to bootstrap its\n// log (and state machine) from a snapshot on another peer.\ntype InstallSnapshotRequest struct {\n\tRPCHeader\n\tSnapshotVersion SnapshotVersion\n\n\tTerm   uint64\n\tLeader []byte\n\n\t// These are the last index/term included in the snapshot\n\tLastLogIndex uint64\n\tLastLogTerm  uint64\n\n\t// Peer Set in the snapshot.\n\t// but remains here in case we receive an InstallSnapshot from a leader\n\t// that's running old code.\n\t// Deprecated: This is deprecated in favor of Configuration\n\tPeers []byte\n\n\t// Cluster membership.\n\tConfiguration []byte\n\t// Log index where 'Configuration' entry was originally written.\n\tConfigurationIndex uint64\n\n\t// Size of the snapshot\n\tSize int64\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *InstallSnapshotRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// InstallSnapshotResponse is the response returned from an\n// InstallSnapshotRequest.\ntype InstallSnapshotResponse struct {\n\tRPCHeader\n\n\tTerm    uint64\n\tSuccess bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *InstallSnapshotResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// TimeoutNowRequest is the command used by a leader to signal another server to\n// start an election.\ntype TimeoutNowRequest struct {\n\tRPCHeader\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *TimeoutNowRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// TimeoutNowResponse is the response to TimeoutNowRequest.\ntype TimeoutNowResponse struct {\n\tRPCHeader\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *TimeoutNowResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}","content_digest":"44cf24bfd7cdde1123e73c7bc8c51fed84a2d0448f30da29b09b7bdc10e834c3"},{"id":"raft.go:1101:1439","file":"raft.go","start_line":1101,"end_line":1439,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"configuration.go:1:260","file":"configuration.go","start_line":1,"end_line":260,"kind":"interface_statement","content_digest":"7e3e1e0a708f3f3b17691549962c94d78955a840922fc0f42867c515cd27ec66","source_view_id":"source-view-2"},{"id":"transport.go:1:141","file":"transport.go","start_line":1,"end_line":141,"kind":"interface_statement","text":"// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"io\"\n\t\"time\"\n)\n\n// RPCResponse captures both a response and a potential error.\ntype RPCResponse struct {\n\tResponse interface{}\n\tError    error\n}\n\n// RPC has a command, and provides a response mechanism.\ntype RPC struct {\n\tCommand  interface{}\n\tReader   io.Reader // Set only for InstallSnapshot\n\tRespChan chan<- RPCResponse\n}\n\n// Respond is used to respond with a response, error or both\nfunc (r *RPC) Respond(resp interface{}, err error) {\n\tr.RespChan <- RPCResponse{resp, err}\n}\n\n// Transport provides an interface for network transports\n// to allow Raft to communicate with other nodes.\ntype Transport interface {\n\t// Consumer returns a channel that can be used to\n\t// consume and respond to RPC requests.\n\tConsumer() <-chan RPC\n\n\t// LocalAddr is used to return our local address to distinguish from our peers.\n\tLocalAddr() ServerAddress\n\n\t// AppendEntriesPipeline returns an interface that can be used to pipeline\n\t// AppendEntries requests.\n\tAppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error)\n\n\t// AppendEntries sends the appropriate RPC to the target node.\n\tAppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error\n\n\t// RequestVote sends the appropriate RPC to the target node.\n\tRequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error\n\n\t// InstallSnapshot is used to push a snapshot down to a follower. The data is read from\n\t// the ReadCloser and streamed to the client.\n\tInstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error\n\n\t// EncodePeer is used to serialize a peer's address.\n\tEncodePeer(id ServerID, addr ServerAddress) []byte\n\n\t// DecodePeer is used to deserialize a peer's address.\n\tDecodePeer([]byte) ServerAddress\n\n\t// SetHeartbeatHandler is used to setup a heartbeat handler\n\t// as a fast-pass. This is to avoid head-of-line blocking from\n\t// disk IO. If a Transport does not support this, it can simply\n\t// ignore the call, and push the heartbeat onto the Consumer channel.\n\tSetHeartbeatHandler(cb func(rpc RPC))\n\n\t// TimeoutNow is used to start a leadership transfer to the target node.\n\tTimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error\n}\n\n// WithPreVote is an interface that a transport may provide which\n// allows a transport to support a PreVote request.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithPreVote interface {\n\t// RequestPreVote sends the appropriate RPC to the target node.\n\tRequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error\n}\n\n// WithClose is an interface that a transport may provide which\n// allows a transport to be shut down cleanly when a Raft instance\n// shuts down.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithClose interface {\n\t// Close permanently closes a transport, stopping\n\t// any associated goroutines and freeing other resources.\n\tClose() error\n}\n\n// LoopbackTransport is an interface that provides a loopback transport suitable for testing\n// e.g. InmemTransport. It's there so we don't have to rewrite tests.\ntype LoopbackTransport interface {\n\tTransport   // Embedded transport reference\n\tWithPeers   // Embedded peer management\n\tWithClose   // with a close routine\n\tWithPreVote // with a prevote\n}\n\n// WithPeers is an interface that a transport may provide which allows for connection and\n// disconnection. Unless the transport is a loopback transport, the transport specified to\n// \"Connect\" is likely to be nil.\ntype WithPeers interface {\n\tConnect(peer ServerAddress, t Transport) // Connect a peer\n\tDisconnect(peer ServerAddress)           // Disconnect a given peer\n\tDisconnectAll()                          // Disconnect all peers, possibly to reconnect them later\n}\n\n// AppendPipeline is used for pipelining AppendEntries requests. It is used\n// to increase the replication throughput by masking latency and better\n// utilizing bandwidth.\ntype AppendPipeline interface {\n\t// AppendEntries is used to add another request to the pipeline.\n\t// The send may block which is an effective form of back-pressure.\n\tAppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error)\n\n\t// Consumer returns a channel that can be used to consume\n\t// response futures when they are ready.\n\tConsumer() <-chan AppendFuture\n\n\t// Close closes the pipeline and cancels all inflight RPCs\n\tClose() error\n}\n\n// AppendFuture is used to return information about a pipelined AppendEntries request.\ntype AppendFuture interface {\n\tFuture\n\n\t// Start returns the time that the append request was started.\n\t// It is always OK to call this method.\n\tStart() time.Time\n\n\t// Request holds the parameters of the AppendEntries call.\n\t// It is always OK to call this method.\n\tRequest() *AppendEntriesRequest\n\n\t// Response holds the results of the AppendEntries call.\n\t// This method must only be called after the Error\n\t// method returns, and will only be valid on success.\n\tResponse() *AppendEntriesResponse\n}","content_digest":"e7ee18e82646ef6c26a4cbad105c94494ef11a92468c3cd594db342e0be100b1"},{"id":"raft.go:1814:1899","file":"raft.go","start_line":1814,"end_line":1899,"kind":"code_observation","content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","source_view_id":"source-view-4"},{"id":"configuration.go:261:372","file":"configuration.go","start_line":261,"end_line":372,"kind":"code_observation","content_digest":"7e3e1e0a708f3f3b17691549962c94d78955a840922fc0f42867c515cd27ec66","source_view_id":"source-view-2"}],"required_material_ids":["commands.go:1:223","configuration.go:1:260","configuration.go:261:372","raft.go:1101:1439","raft.go:1440:1584","raft.go:1585:1820","raft.go:1814:1899","raft.go:1900:2241","raft.go:285:441","raft.go:827:1100","transport.go:1:141"],"source_rule":"Orientation, provenance IDs and declaration hints are navigation, not source evidence. Only attached exact source supports current implementation judgments.","selected_question":{"disposition":null,"preferred_check":"source_review","requests":[{"file":"raft.go","start_line":827,"end_line":1100,"reason":"Locate quorumSize in this previously acquired navigation range and establish its exact membership basis. The preceding requested range did not contain its declaration."},{"file":"raft.go","start_line":1440,"end_line":1584,"reason":"Reattach AppendEntries handling to determine whether any term or membership mutation can leave the current candidate invocation eligible to count its existing campaign results."},{"file":"raft.go","start_line":1814,"end_line":1899,"reason":"Inspect snapshot acceptance and role-transition guards before the attached configuration-installation suffix; determine whether snapshot installation can change campaign membership without terminating Candidate state."},{"file":"configuration.go","start_line":261,"end_line":372,"reason":"Complete nextConfiguration and inspect configuration decoding helpers to distinguish validated membership changes from reconstruction paths whose uniqueness conditions remain unresolved."}],"question":"When B_candidate_results establishes F_local_leader_assignment, what ensures that counted affirmative results represent distinct eligible voters responding to the selected campaign, including the transition from pre-vote to election?","importance":"Incorrect contributor identity or campaign correlation could permit local leadership assignment without the intended election support. This investigation concerns the local counting boundary; competing leaders, decision safety and client consequences remain unestablished.","source_ids":["raft.go:285:441","raft.go:1900:2241","raft.go:1585:1820","raft.go:1101:1439","commands.go:1:223","configuration.go:1:260","transport.go:1:141"],"participants":["Local candidate","Campaign result-producing workers","Configured voters","RPC handlers"],"objects":["Invocation-local campaign response channels","Vote and pre-vote counters","Request terms and response terms","Latest membership and quorum threshold","Transport request-response pairing"],"contexts":["One runCandidate invocation","Optional pre-vote followed by election","Delayed asynchronous campaign responses","Pre-vote compatibility fallback for unsupported RPCs","RPC processing interleaved with campaign-result consumption"],"event_paths":["Latest configuration -> campaign dispatch -> worker-local response channel -> result counting -> local Leader assignment","Pre-vote threshold -> disable prevoteCh -> electSelf with a fresh channel -> real-vote threshold","Candidate RPC dispatch -> possible term or membership mutation -> next candidate-loop iteration"],"activity_classes":["A2","A4"],"behavior_ids":["B_candidate_results"],"fact_ids":["F_local_leader_assignment"],"obligation_relation_kind":"establishment","counterevidence":["electSelf and preElectSelf allocate fresh response channels. Each remote worker sends exactly one result to its captured channel, separating successive campaigns.","Both dispatch loops select only Voter entries. Configuration documents unique server entries, and checkConfiguration rejects duplicate IDs and addresses; applicability of that validation to all installed configurations remains unresolved.","Real-vote and pre-vote counters are separate. Successful pre-vote disables prevoteCh and invokes electSelf; synthesized compatibility pre-votes cannot directly satisfy the real-vote counter.","Real-election transport errors force Granted=false. Self-vote publication follows successful persistVote; persistence failure returns a nil election channel.","electSelf calls setCurrentTerm before dispatch. setCurrentTerm writes stable storage before updating memory and panics on a write error.","For the attached requestVote handler, a grant follows rejection of older requests and adoption of a newer request term, so the response term equals the accepted request term. Duplicate grants additionally require matching saved candidate bytes. This observation does not establish the semantics of every compatible peer implementation.","requestPreVote rejects older requests and reports the proposed request term when it exceeds the receiver's current term. Its grant does not persist a vote or advance the receiver's current term.","A higher-term RequestVote handled during a campaign sets Follower before updating the term. runCandidate tests its role before its next select iteration.","Transport.RequestVote names the target and supplies a response output, and RequestVoteResponse is documented as the response to that request. Concrete adapter correlation remains unread; absence of response-term equality checking alone does not demonstrate miscorrelation.","timeoutNow sets Candidate and the transfer flag without changing term or membership. Its interaction with an already-running campaign is not by itself evidence that an old response belongs to a different election."],"unknowns":["Which membership quorumSize uses and whether dispatch, threshold calculation and later consumption retain compatible membership contexts.","Whether AppendEntries or snapshot RPC processing can mutate campaign membership or term while leaving the current campaign eligible for counting.","Whether configuration uniqueness validation applies to every relevant bootstrap, decoding, recovery and installation path.","Which concrete transport variants establish target and request-response correlation; the currently selected adapter remains unknown.","Whether compatible older peers have response-term semantics different from the attached handlers; the interface does not expressly require term equality.","The complete applicable local election expectation remains unresolved pending quorum and context-mutation inspection.","Legal-history reachability and broader authority, decision and client consequences remain unestablished."],"priority":1,"trigger_rationale":"The new source establishes explicit configuration uniqueness requirements and validation, and resolves response-term behavior for the attached handlers. The decisive remaining local discriminator is whether membership and quorum remain aligned throughout a campaign, including RPC-driven mutations. Inspecting those paths can explain the counting mechanism or identify a separately grounded relation without assuming that absent deduplication is defective."},"source_receipt":{"id":"7b0d88a9ef494a0f87bf798b2152f2fd","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","purpose":"depth","status":"complete","items":[{"request":{"file":"raft.go","start_line":827,"end_line":1100,"reason":"Locate quorumSize in this previously acquired navigation range and establish its exact membership basis. The preceding requested range did not contain its declaration."},"status":"cached","material_ids":["raft.go:827:1100"],"new_chars":0,"new_chunks":0,"reason":"","file_metadata":{"file":"raft.go","lines":2241,"content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8"}},{"request":{"file":"raft.go","start_line":1440,"end_line":1584,"reason":"Reattach AppendEntries handling to determine whether any term or membership mutation can leave the current candidate invocation eligible to count its existing campaign results."},"status":"cached","material_ids":["raft.go:1440:1584"],"new_chars":0,"new_chunks":0,"reason":"","file_metadata":{"file":"raft.go","lines":2241,"content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8"}},{"request":{"file":"raft.go","start_line":1814,"end_line":1899,"reason":"Inspect snapshot acceptance and role-transition guards before the attached configuration-installation suffix; determine whether snapshot installation can change campaign membership without terminating Candidate state."},"status":"cached","material_ids":["raft.go:1814:1899"],"new_chars":0,"new_chunks":0,"reason":"","file_metadata":{"file":"raft.go","lines":2241,"content_digest":"54d43df5197fd71cd0f6ae4eee1ba28efb139a5223eb14b756c606bdb0b8a800","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8"}},{"request":{"file":"configuration.go","start_line":261,"end_line":372,"reason":"Complete nextConfiguration and inspect configuration decoding helpers to distinguish validated membership changes from reconstruction paths whose uniqueness conditions remain unresolved."},"status":"acquired","material_ids":["configuration.go:261:372"],"new_chars":3271,"new_chunks":0,"reason":"","file_metadata":{"file":"configuration.go","lines":372,"content_digest":"7e3e1e0a708f3f3b17691549962c94d78955a840922fc0f42867c515cd27ec66","snapshot_id":"5f759884c4f9410eabf0d135ec4a3308","encoding":"utf-8"}}],"partial_policy":"independent_ranges_with_explicit_defer","related_ids":["d77e9988be9440e08c99284c81617f53","F_local_leader_assignment","B_candidate_results"],"reason":"When B_candidate_results establishes F_local_leader_assignment, what ensures that counted affirmative results represent distinct eligible voters responding to the selected campaign, including the transition from pre-vote to election?","original_requests":[{"file":"raft.go","start_line":827,"end_line":1100,"reason":"Locate quorumSize in this previously acquired navigation range and establish its exact membership basis. The preceding requested range did not contain its declaration."},{"file":"raft.go","start_line":1440,"end_line":1584,"reason":"Reattach AppendEntries handling to determine whether any term or membership mutation can leave the current candidate invocation eligible to count its existing campaign results."},{"file":"raft.go","start_line":1814,"end_line":1899,"reason":"Inspect snapshot acceptance and role-transition guards before the attached configuration-installation suffix; determine whether snapshot installation can change campaign membership without terminating Candidate state."},{"file":"configuration.go","start_line":261,"end_line":372,"reason":"Complete nextConfiguration and inspect configuration decoding helpers to distinguish validated membership changes from reconstruction paths whose uniqueness conditions remain unresolved."}],"allowance":{"unique_chars":187918,"unique_chunks":20,"total_chars":240000,"total_chunks":40,"reserved_for_other_chars":0,"available_chars":52082,"available_chunks":20,"purpose":"depth","allocation_reason":"Protect finite breadth exploration capacity","accounting":"Unique normalized source lines including one logical separator per line; not prompt tokens or a bill"},"attempt":1},"candidate_dispositions":[{"id":"13863110a71a42bcab5d50aff38b327d","parent_candidate_id":null,"fork_reason":"","question":"When ordinary replication is blocked but heartbeat exchanges continue, what does F_heartbeat_exchange_observed establish for the leader-lease consumer, and does counting responses that reject the request or report a higher term satisfy the lease's applicable contract?","fact_ids":["F_heartbeat_exchange_observed"],"lifecycle":"consumption","status":"explained","reason":"Continue and dispose the existing candidate. The attached configuration contract, contact-field documentation, helper implementations, and lease consumer resolve the principal discriminator without assuming authority from responsiveness. The recorded check ID has no supplied result or evidence and contributes no validation. Further transport or higher-term investigation could answer distinct questions, but is unnecessary to explain why rejection alone does not violate this connectivity lease contract.","resume_conditions":[],"obligation_id":null,"unit_id":null,"unit_status":null,"archived_unit_status":null,"scope":{"contexts":["Ordinary replication blocked while heartbeat exchanges complete","Heartbeat response rejects the request or reports a higher term","Lease timer consumes recent contact timestamps"],"event_paths":["Raft.heartbeat -> followerReplication.setLastContact -> followerReplication.LastContact -> Raft.checkLeaderLease"]},"check_ids":["5befe53f73474bcaa1fc7fc16f12660c","82ee9fff70f442a4a6429cd4e8461467"],"evidence_ids":[],"current_result":null,"remaining_discriminators":["Transport request-response correlation and the selected adapter's guarantees remain unread; the conclusion assumes the returned response corresponds to the contacted peer.","Contact initialization, worker replacement, and outstanding-call teardown ordering remain unresolved.","Whether another mechanism invalidates contact or completes stepdown before a particular lease consumption remains unresolved.","Reachability of sustained higher-term heartbeat responses while ordinary replication remains blocked has not been demonstrated in a legal execution.","Any independent requirement to react to higher-term heartbeat responses must be grounded separately; the connectivity contract does not settle that requirement.","Broader client, authority, and decision consequences of retaining the local Leader role remain untested."]},{"id":"919be91a21f54c4d950c930726d00d4f","parent_candidate_id":null,"fork_reason":"","question":"Does F_append_handler_success establish predecessor integrity after an earlier invocation successfully deleted a conflicting suffix but failed before refreshing last-log metadata? Check whether a subsequent otherwise admissible request receives success for a deleted predecessor, independently comparing the response with retained logs and the snapshot boundary.","fact_ids":["F_append_handler_success"],"lifecycle":"establishment","status":"escalated","reason":"","resume_conditions":[],"obligation_id":"O_append_predecessor_integrity","unit_id":"unit-O_append_predecessor_integrity","unit_status":"checked","archived_unit_status":"checked","scope":{"description":"Check the local predecessor-integrity relation across two actual handler invocations on the same receiver. Establish initially consistent stored history and metadata; the first invocation deletes an uncommitted conflicting suffix successfully and encounters a replacement-write error. Before any repair, deliver a subsequent otherwise admissible request naming the deleted cached endpoint. Compare its response with independently observed retained storage and snapshot metadata. This is a conditional interface-boundary check; legal sender-history reachability remains unresolved.","assumptions":["Successful DeleteRange removes the inclusive requested suffix.","The selected fault case makes StoreLogs return an error without restoring the deleted predecessor; this is an explicit experiment condition, not an observed production-adapter behavior.","The deleted suffix is uncommitted, and the snapshot boundary lies strictly below the named deleted predecessor.","No intervening append, snapshot installation, restart, or metadata repair occurs between the two invocations.","The later request has an acceptable term and correctly formed fields. An empty Entries list and LeaderCommitIndex=0 isolate predecessor validation without claiming this sequence is generated by an ordinary leader."],"excluded":["Proof that a concrete production adapter realizes the injected failure","Proof of a legal distributed history generating both requests","Quorum support, commitment, application, client-visible loss, and overall consensus correctness","The separate post-storage configuration-processing failure branch","Crash durability of the test adapter"],"parameters":{}},"check_ids":["6937d6557554435cb1ddf75401bb6ba6","5670f5c407ec47bc8b85b35073b409a6","8824572c21254da4a0a99b8bf64f455f","d008412d68d646be8a29b7125cc02304","207dee504afb424296e5e7b12fc84f3c"],"evidence_ids":["a387fb3d1af04010a084854e69502b6d"],"current_result":{"outcome":"violated","bounded_complete":true,"confirmed":true,"blockers":[],"boundaries":["Proof that a concrete production adapter realizes the injected failure","Proof of a legal distributed history generating both requests","Quorum support, commitment, application, client-visible loss, and overall consensus correctness","The separate post-storage configuration-processing failure branch","Crash durability of the test adapter","The injected adapter fault is conditional evidence, not an observation of production storage behavior.","The second request is tested at the receiving interface; its generation in a legal distributed sender history remains unresolved.","Direct invocation excludes concurrent node activity, transport dispatch, restart, snapshot installation, and intervening repair.","An empty-request response does not establish advancement of commitment.match, application, client-visible loss, or overall consensus failure.","The control's Go assertion is a test expectation for a retained matching predecessor; it is separate from the selected obligation comparison.","The error-producing store is an explicit fault adapter. InmemStore.StoreLogs itself always succeeds, and the supplied interface does not establish which production adapters exhibit the selected no-rollback failure semantics.","The harness bypasses NewRaft validation and startup, initializes only path-relevant receiver state, and supplies no functioning network transport, FSM or snapshot store. The review accepts this only for the declared isolated handler boundary, not as a constructor-valid deployment or an equivalent full-node execution.","The two requests are not evidence of a legal sender history. In particular, the same named term-2 sender first supplies term-2 replacements at indexes 2 and 3 and later names index 3 at term 1. The check does not explain how an ordinary leader generates that sequence. The supplied replication code derives predecessor terms from sender history and backs nextIndex down after rejection; header acceptance does not establish protocol-history legality.","The observed execution excludes intervening repair, restart, snapshot installation and concurrent node activity by construction. It does not establish whether full-node dispatch permits this sequence before repair.","An empty successful request does not advance nextIndex or commitment.match in the supplied updateLastAppended implementation. No quorum, commitment, application, client-visible loss or broader consensus consequence was observed.","This review covers the supplied check, harness and correlated execution only. The fixed scenario labels and prerequisite values are not a general-purpose monitor for arbitrary AppendEntries histories. The configuration-processing failure branch, snapshot-supported predecessors and other fault outcomes remain untested.","No formal model or calibration is required for this direct check, and none is inferred. The no-issue judgment concerns scoped semantic correspondence, not implementation correctness, independent replication of the experiment or resolution of unrelated semantic issues."],"level":"implementation_obligation"},"remaining_discriminators":[]},{"id":"884f7b204d454684b14ddab2bb99c9e6","parent_candidate_id":null,"fork_reason":"","question":"When F_heartbeat_exchange_observed forwards an affirmative contribution from a configured nonvoter, can that contribution substitute for a required voter in verification completion? First check this eligibility relation under fixed membership and one leader generation; retain request freshness and broader leadership consequences as unresolved.","fact_ids":["F_heartbeat_exchange_observed"],"lifecycle":"consumption","status":"escalated","reason":"","resume_conditions":[],"obligation_id":"O_verify_voter_support","unit_id":"unit-O_verify_voter_support","unit_status":"blocked","archived_unit_status":"blocked","scope":{"description":"Check contributor eligibility at the verification aggregation boundary. Establish a fixed configuration containing three voters, including the local leader, and at least one nonvoter. Register a verification through Raft.verifyLeader and deliver an affirmative notification from the nonvoter's actual replication object while withholding all remote voter contributions. Observe whether verification reaches its successful quorum branch. Independently identify contributors by configured ServerID and Suffrage.","assumptions":["The local node is a voter and is executing one leader generation.","Membership, peer identities, and replication objects remain unchanged throughout the check.","Each delivered affirmative contribution is correlated with its originating replication object.","Remote voter notifications and unrelated replication notifications are withheld until the stopping observation.","An affirmative nonvoter notification is an explicit boundary input; its generation through a complete distributed execution is not assumed established."],"excluded":["Legal distributed history establishing an obsolete leader and producing the selected responses","Stale FSM reads or other client-visible consequences","Request freshness and responses to exchanges initiated before verification registration","Membership changes, replication-object replacement, and cross-generation contributions","Transport correlation and production deployment exposure","Overall consensus correctness"],"parameters":{}},"check_ids":["ed024cb8a4544f0bb3379643aa960f5e","8d1468c4ca0f4c45a322512cd2ddb588","9bb52f8882604ff0a94f27e1c9a82e0e","15a1258bc2ef41288f7c0a0211eccc73","08abaa5a20d24e95a0c142e2a2c90078"],"evidence_ids":["9e682e1592ea4033ad7e34b68f021e0b"],"current_result":{"outcome":"violated","bounded_complete":true,"confirmed":false,"blockers":["Open review issue 33dab19bc1db4bb197e4ddee7f25afd2 [api.go:800:1000,api.go:500:640,raft.go:455:666,raft.go:667:826,raft.go:827:1100,replication.go:1:202,future.go:1:314,commitment.go:1:104]: The saved assertion compares success for equality with input.expected_success for both operations. For verify-V1, expected_success is true, so unsuccessful or pending completion would be attributed to check_verify_voter_support even though no nonvoter supplied a contribution.; The observable property's description explicitly states that failure of the permitted control alone does not establish nonvoter substitution; the executable equality does not preserve that distinction."],"boundaries":["Legal distributed history establishing an obsolete leader and producing the selected responses","Stale FSM reads or other client-visible consequences","Request freshness and responses to exchanges initiated before verification registration","Membership changes, replication-object replacement, and cross-generation contributions","Transport correlation and production deployment exposure","Overall consensus correctness","Distributed response reachability, request freshness, membership changes, generation transitions, transport correlation, and stale-read consequences remain unresolved.","The primary can remain pending at the completed boundary endpoint; this establishes only absence of success through that endpoint.","Marker failure, timeout, missing registration, changed leader state, or failed goroutine join produces no property result.","Internal completion is measured directly; public VerifyLeader dispatch and client observation are not exercised.","The encoding issue does not negate the observed verify-N mismatch: that witness violates the intended one-way eligibility condition as well as the current equality.","The API's voter-eligibility expectation remains an explicit inference from combined responsibilities. The separate connectivity lease is not a prerequisite checked by verification completion and does not establish an alternative voter-backed verification mechanism here.","The fixture bypasses NewRaft validation, elections, runLeader's no-op dispatch, transport, and replication worker startup. Its result establishes an internal aggregation-boundary behavior, not a legal distributed history or public-call reproduction.","Request freshness, membership transitions, generation changes, stale leadership, stale reads, and production exposure remain unresolved. Eligibility alone would not exclude those other bad outcomes.","Go test PASS reports successful harness execution; the emitted nonvoter observations contain the property mismatch.","The available revision schema cannot express a direct-check predicate replacement. A controller-supported checker encoding revision and actual recheck are required; no graph F2 change is proposed."],"level":"implementation_test"},"remaining_discriminators":["Open review issue 33dab19bc1db4bb197e4ddee7f25afd2 [api.go:800:1000,api.go:500:640,raft.go:455:666,raft.go:667:826,raft.go:827:1100,replication.go:1:202,future.go:1:314,commitment.go:1:104]: The saved assertion compares success for equality with input.expected_success for both operations. For verify-V1, expected_success is true, so unsuccessful or pending completion would be attributed to check_verify_voter_support even though no nonvoter supplied a contribution.; The observable property's description explicitly states that failure of the permitted control alone does not establish nonvoter substitution; the executable equality does not preserve that distinction."]},{"id":"d77e9988be9440e08c99284c81617f53","parent_candidate_id":null,"fork_reason":"","question":"When B_candidate_results establishes F_local_leader_assignment, what ensures that counted affirmative results represent distinct eligible voters responding to the selected campaign, including the transition from pre-vote to election?","fact_ids":["F_local_leader_assignment"],"lifecycle":"establishment","status":"active","reason":"","resume_conditions":[],"obligation_id":null,"unit_id":null,"unit_status":null,"archived_unit_status":null,"scope":{"contexts":["One runCandidate invocation","Optional pre-vote followed by election","Delayed asynchronous campaign responses","Pre-vote compatibility fallback for unsupported RPCs","RPC processing interleaved with campaign-result consumption"],"event_paths":["Latest configuration -> campaign dispatch -> worker-local response channel -> result counting -> local Leader assignment","Pre-vote threshold -> disable prevoteCh -> electSelf with a fresh channel -> real-vote threshold","Candidate RPC dispatch -> possible term or membership mutation -> next candidate-loop iteration"]},"check_ids":["43de870df34a4574a1c8ebbc948bb8fe","5006ddabee13445ba3c7651ea753f653","d4f88426e53c4d3d96dead8d0bac57ad"],"evidence_ids":[],"current_result":null,"remaining_discriminators":["Which membership quorumSize uses and whether dispatch, threshold calculation and later consumption retain compatible membership contexts.","Whether AppendEntries or snapshot RPC processing can mutate campaign membership or term while leaving the current campaign eligible for counting.","Whether configuration uniqueness validation applies to every relevant bootstrap, decoding, recovery and installation path.","Which concrete transport variants establish target and request-response correlation; the currently selected adapter remains unknown.","Whether compatible older peers have response-term semantics different from the attached handlers; the interface does not expressly require term equality.","The complete applicable local election expectation remains unresolved pending quorum and context-mutation inspection.","Legal-history reachability and broader authority, decision and client consequences remain unestablished."]}],"existing_objects":[{"id":"O_append_predecessor_integrity","version":1},{"id":"O_verify_voter_support","version":1},{"id":"BIND_append_predecessor_integrity","version":1},{"id":"BIND_last_entry_representation","version":1},{"id":"BIND_verify_registration","version":1},{"id":"BIND_verify_quorum","version":1},{"id":"BIND_verify_replication_membership","version":1},{"id":"BIND_verify_notification","version":1},{"id":"BIND_verify_vote","version":1},{"id":"unit-O_append_predecessor_integrity","version":1},{"id":"unit-O_verify_voter_support","version":1}],"pending_enrichment":[],"file_lookup":[{"file":".github/CODEOWNERS","lines":13},{"file":".github/dependabot.yml","lines":7},{"file":".github/stale.yml","lines":40},{"file":".github