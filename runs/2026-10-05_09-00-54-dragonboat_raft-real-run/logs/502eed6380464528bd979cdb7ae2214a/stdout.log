membership','Propose, Replicate, ReplicateResp and heartbeat dispatch',['src_formation','src_replication','src_responses','src_commit_term','src_history'],implementation_guards=['Leader selects quorum match from remotes and witnesses, excluding observers; direct replica-count commitment requires a current-term entry.','Follower checks preceding log term; conflicting committed entries panic; commitTo is monotonic.'],writes=['Leader assigns term/index and updates self match; accepted peer responses advance peer match.','Follower appends matching suffix and advances committed to min(message commit, replicated endpoint).'],external_effects=['Replication responses, rejection hints, replication broadcasts on newly advanced commit; heartbeat replies echo context.'],async_boundaries=['Messages are buffered for Peer update extraction, not sent by Handle itself.'],produces_fact_ids=['F_commit'],unknowns=['Detailed witness payload persistence and snapshot retry states remain unread.'])\nb('B_authority','A2','raft state transitions and message dispatch','Per cluster term, local role and current membership','Election tick, RequestVote/Response, newer-term traffic, same-term leader traffic, CheckQuorum or transfer',['src_transition','src_message_terms','src_election_guard','src_candidate_votes','src_vote_admission','src_response_types','src_tick','src_quorum_loss','src_read_responses'],implementation_guards=['Peer.Handle filters responses from unknown members; candidate excludes observer votes; vote map counts each sender once.','Vote grant requires available/same vote and an up-to-date log. Campaign blocked while committed index exceeds the applied index.','Tick campaigns only for present full voters; transfer target must be in remotes; checkQuorum can step leader down.'],writes=['Reset clears transient votes, read-index queue, transfer state, progress and pending config flag; term changes clear voted-for. Log and committed prefix remain.','Leader promotion appends current-term no-op and reconstructs pending config status from uncommitted history.'],external_effects=['Campaign sends vote requests; leader transfer sends TimeoutNow after catch-up and suppresses new proposals until completed or aborted.'],consumes_fact_ids=['F_commit'],cross_activity_effects={'A1':'Authority changes discard transient support; retained log constrains future voting and current-term replica counting.'},unknowns=['Quiescence timing variants and transport restart ordering remain open.'])\nb('B_members','A4','rsm membership and node.ApplyConfigChange under raftMu','Applied configuration entry and ordered-configuration option','StateMachine handles committed ConfigChangeEntry',['src_membership_rules','src_rsm_config','src_rsm_dispatch','src_rsm_applied','src_node_completion','src_cc_dispatch','src_membership'],implementation_guards=['Reject stale ordered config IDs, removed-node readdition, invalid role conversions, duplicate members/addresses, invalid observer promotions and deletion of last full node.'],writes=['Update RSM membership then invoke node callback to apply accepted membership to peer or clear pending change on rejection.','Publish lastApplied for a batch only after handleEntry and configuration callback return.'],external_effects=['Registry update/removal and configuration request completion; local removal requests node shutdown.'],cross_activity_effects={'A1':'Changes eligible replication quorum and can trigger leader commit after removal.','A2':'Membership used by next campaign is updated before externally visible applied batch index; leader steps down on self removal.'},unknowns=['Snapshot recovery publishes its applied index through a different path; overlap with active stepping needs further analysis.'])\nb('B_persist','A6','engine step worker and node update consumer','Peer update batch and LogDB','node.stepNode/GetUpdate followed by engine.processSteps',['src_engine_order','src_update_admission','src_node_updates','src_apply_queue','src_raft_init','src_launch'],implementation_guards=['FastApply is false for snapshots or overlap between committed and newly saved entries.','SaveRaftState precedes processRaftUpdate and sending non-free-order responses; Replicate/Ping messages may be sent before storage.'],writes=['Persist update state/entries/snapshot via LogDB; append saved entries to logReader; acknowledge update to Peer.'],consumes_fact_ids=['F_commit'],cross_activity_effects={'A1':'Followers do not emit ordinary replication/vote responses through node.sendMessages until the update persistence call returns.','A2':'newRaft loads saved state and membership before initial role reset.'},unknowns=['LogDB crash durability and backend implementations have not been traced.'])\nb('B_apply','A5','engine apply worker and rsm.StateMachine','Committed per-node entry stream','Queued committed entry tasks',['src_node_updates','src_apply_queue','src_rsm_dispatch','src_rsm_applied','src_node_completion'],implementation_guards=['Applied entries processed in order; batch publication checks contiguous indices and nondecreasing terms.'],writes=['Dispatch configuration, session and application entries; publish lastApplied after handling task entries.'],external_effects=['Application results call node.ApplyUpdate; final entry can notify read-index pending requests.'],consumes_fact_ids=['F_commit'],cross_activity_effects={'A2':'Node feeds RSM GetLastApplied to raft before handling new events, releasing campaign guard only after published application.'},unknowns=['Session duplicate-result caching and on-disk replay variants not fully mapped.'])\nb('B_recover','A3','raft restore, node snapshot pipeline and rsm.Recover','Snapshot index, term and embedded membership','InstallSnapshot then persisted recovery task',['src_restore','src_engine_order','src_node_updates','src_rsm_recover','src_rsm_restore','src_node_completion','src_node_recover','src_recover_status','src_start_close'],implementation_guards=['Ignore snapshots at/below committed; matching snapshot term can advance commit without installing.','Initial node stepping waits for initialized flag; apply task processing waits while recovery is incomplete.'],writes=['Full restore changes log history and committed/processed index; later RSM recovery restores state, sessions and embedded membership, then invokes RestoreRemotes under raftMu.'],external_effects=['Recovery completion schedules apply worker; initial completion sets initialized status.'],async_boundaries=['Snapshot reception/log restoration, persistence, RSM recovery and peer membership restoration are separate boundaries.'],produces_fact_ids=['F_commit'],cross_activity_effects={'A1':'Recovered log boundary and peer progress reconstruct participation.','A2':'Snapshot membership can remove local node or promote an observer; new membership is applied through RestoreRemotes.'},unknowns=['Can active stepping observe snapshot lastApplied after RSM apply but before RestoreRemotes, and what prevents unsafe campaign in that interval?'])\nb('B_read_accept','A1','raft leader and readIndex queue','Current-term committed leader; request SystemCtx and originating peer','Leader receives ReadIndex',['src_read_messages','src_read_confirm','src_read_broadcast'],implementation_guards=['Multi-voter leader requires committed current-term entry; witness requester excluded; duplicate contexts not inserted twice.'],writes=['Capture committed index, original context and origin in readStatus.'],external_effects=['Nonzero-context heartbeat broadcasts go only to voting members; ordinary heartbeat retries use latest pending context.','Single-quorum path directly emits readiness, with special observer reply.'],produces_fact_ids=['F_pending_read'],consumes_fact_ids=['F_commit'])\nb('B_read_confirm','A1','readIndex.confirm and leader confirmation response handler','Pending contexts in queue order and current-term voting responses','Nonzero-context HeartbeatResp from admitted peer',['src_read_confirm','src_read_re