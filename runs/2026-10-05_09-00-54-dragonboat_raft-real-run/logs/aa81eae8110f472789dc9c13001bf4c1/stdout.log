nge []uint64{2,3} {\n  ctx:=expected[origin]\n  status,ok:=peers[1].raft.readIndex.pending[ctx]\n  if !ok || status.from!=origin || status.ctx!=ctx { t.Fatal(\"leader admission differs from caller request\") }\n  assuranceEvent(t,map[string]interface{}{\"event\":\"admitted\", \"scenario\":scenario, \"origin\":origin, \"expected_context\":assuranceContext(ctx), \"term\":term, \"leader\":uint64(1), \"pending_count\":len(peers[1].raft.readIndex.pending), \"current_term_committed\":peers[1].raft.hasCommittedEntryAtCurrentTerm(), \"first_round_drops\":dropped})\n }\n drain()\n // End after finite queue exhaustion, independently of whether contexts match.\n for _, origin:=range []uint64{2,3} {\n  assuranceEvent(t,map[string]interface{}{\"event\":\"diagnostic\", \"scenario\":scenario, \"origin\":origin, \"wire_count\":wireCount[origin], \"ready_count\":readyCount[origin], \"release_count\":releaseCount[origin], \"leader_pending\":len(peers[1].raft.readIndex.pending), \"remaining_messages\":len(queue)})\n }\n}\nGO\ncat > build_check.py <<'\"'PY'\nimport json\nG=lambda src,exp,why:dict(source_ids=src,expectation_ids=exp,derivation=why,applicability='Accepted C_remote_read_context scope; fixed unchanged three-voter configuration, term and one request per remote origin.',unresolved=[],conflicts=[],alternatives=[])\nlegality=G(['src_launch','src_launch_bootstrap','src_memory_storage','src_peer_updates','src_engine_order','src_node_completion','src_context_admission','src_vote_admission','src_transport_loss','src_transport_order','src_context_generation'],['src_forwarded_read_expectation'],'Launch all peers with a common initial configuration and empty TestLogDB, persist each extracted update into its in-memory LogDB before messages, apply only bootstrap configuration and empty no-op entries, acknowledge updates and notify applied index. Tick only node 1 until a real election and current-term commit complete. Use Peer.ReadIndex on followers and Peer.Handle for every delivered me