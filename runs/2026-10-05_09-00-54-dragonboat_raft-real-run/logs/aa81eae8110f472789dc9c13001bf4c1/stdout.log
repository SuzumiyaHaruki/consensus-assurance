turnedTo %d, current applied %d, committed %d\",\n\t\t\t\tcu.Processed, l.processed, l.committed)\n\t\t}\n\t\tl.processed = cu.Processed\n\t}\n\tif cu.LastApplied > 0 {\n\t\tif cu.LastApplied > l.committed {\n\t\t\tplog.Panicf(\"invalid last applied %d, committed %d\",\n\t\t\t\tcu.LastApplied, l.committed)\n\t\t}\n\t\tif cu.LastApplied > l.processed {\n\t\t\tplog.Panicf(\"invalid last applied %d, processed %d\",\n\t\t\t\tcu.LastApplied, l.processed)\n\t\t}\n\t\tl.inmem.appliedLogTo(cu.LastApplied)\n\t}\n}\n\nfunc (l *entryLog) matchTerm(index uint64, term uint64) bool {\n252:func (p *Peer) HasUpdate(moreToApply bool) bool {\n263:\tif pst := r.raftState(); !pb.IsEmptyState(pst) &&\n288:\tif !pb.IsEmptyState(ud.State) {\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"check\",\n        \"revise_check\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"unit_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Unit Id\"\n    },\n    \"candidate\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CandidateSubmission\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"plan_path\": {\n      \"title\": \"Plan Path\",\n      \"type\": \"string\"\n    },\n    \"harness_path\": {\n      \"title\": \"Harness Path\",\n      \"type\": \"string\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Destination path to draft source path for helpers\",\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    },\n    \"previous_check_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Check Id\"\n    },\n    \"repair_issue_ids\": {\n      \"description\": \"Exact issues whose driver premises the new harness legality answers; admission does not resolve them\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Repair Issue Ids\",\n      \"type\": \"array\"\n    },\n    \"encoding_revision\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/EncodingRevision\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"plan_path\",\n    \"harness_path\"\n  ],\n  \"title\": \"CheckSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > read_context_test.go <<'GO'\npackage raft\n\nimport (\n \\\"encoding/json\\\"\n \\\"fmt\\\"\n \\\"testing\\\"\n\n \\\"github.com/lni/dragonboat/v3/config\\\"\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\n)\n\nfunc assuranceContext(c pb.SystemCtx) string { return fmt.Sprintf(\\\"%d:%d\\\", c.Low, c.High) }\nfunc assuranceEvent(t *testing.T, e map[string]interface{}) {\n t.Helper()\n b, err := json.Marshal(e)\n if err \"'!= nil { t.Fatal(err) }\n fmt.Println(\"CA_EVENT \" + string(b))\n}\n\n// This driver replaces storage, application scheduling and transport only.\n// All elections, forwarding, confirmation and response handling use Peer APIs.\nfunc TestAssuranceRemoteReadContext(t *testing.T) {\n const scenario = \"prefix_release\"\n peers := map[uint64]*Peer{}\n dbs := map[uint64]*TestLogDB{}\n applied := map[uint64]uint64{}\n expected := map[uint64]pb.SystemCtx{2: {Low: 1101, High: 30}, 3: {Low: 2202, High: 30}}\n addresses := []PeerAddress{{NodeID: 1, Address: \"n1:1234\"}, {NodeID: 2, Address: \"n2:1234\"}, {NodeID: 3, Address: \"n3:1234\"}}\n queue := []pb.Message{}\n dropFirst := false\n observed := false\n dropped := 0\n wireCount := map[uint64]int{}\n readyCount := map[uint64]int{}\n releaseCount := map[uint64]int{}\n var term uint64\n\n for id := uint64(1); id <= 3; id++ {\n  dbs[id] = NewTestLogDB().(*TestLogDB)\n  peers[id] = Launch(config.Config{NodeID: id, ClusterID: 1, ElectionRTT: 10, HeartbeatRTT: 1, CheckQuorum: true}, dbs[id], nil, append([]PeerAddress(nil), addresses...), true, true)\n }\n // Peer and TestLogDB allocate no background workers or external resources.\n // No production state is mutated by the driver outside documented APIs.\n flush := func(id uint64) {\n  p := peers[id]\n  ud := p.GetUpdate(true, applied[id])\n  if !pb.IsEmptySnapshot(ud.Snapshot) { t.Fatal(\"unexpected snapshot\") }\n  if err := dbs[id].Append(ud.EntriesToSave); err != nil { t.Fatal(err) }\n  if !pb.IsEmptyState(ud.State) { dbs[id].SetState(ud.State) }\n  for _, e := range ud.CommittedEntries {\n   if e.Index != applied[id]+1 { t.Fatalf(\"application gap at node %d\", id) }\n   if e.Type == pb.ConfigChangeEntry {\n    var cc pb.ConfigChange\n    if err := cc.Unmarshal(e.Cmd); err != nil { t.Fatal(err) }\n    if !cc.Initialize || cc.Type != pb.AddNode { t.Fatal(\"unexpected configuration change\") }\n    p.ApplyConfigChange(cc)\n   } else if len(e.Cmd) != 0 { t.Fatal(\"unexpected application payload\") }\n   applied[id] = e.Index\n  }\n  for _, rr := range ud.ReadyToReads {\n   if observed {\n    readyCount[id]++\n    assuranceEvent(t, map[string]interface{}{\"event\":\"ready\", \"scenario\":scenario, \"origin\":id, \"context\":assuranceContext(rr.SystemCtx), \"index\":rr.Index, \"applied\":applied[id], \"term\":p.raft.term})\n   } else { t.Fatal(\"readiness before requests\") }\n  }\n  for _, m := range ud.Messages {\n   if observed && m.Type == pb.ReadIndexResp {\n    wireCount[m.To]++\n    assuranceEvent(t, map[string]interface{}{\"event\":\"wire\", \"scenario\":scenario, \"origin\":m.To, \"from\":m.From, \"context\":assuranceContext(pb.SystemCtx{Low:m.Hint, High:m.HintHigh}), \"term\":m.Term, \"index\":m.LogIndex})\n   }\n   if dropFirst && m.Type == pb.Heartbeat && m.Hint == expected[2].Low && m.HintHigh == expected[2].High {\n    dropped++\n    assuranceEvent(t, map[string]interface{}{\"event\":\"loss\", \"scenario\":scenario, \"from\":m.From, \"to\":m.To, \"context\":assuranceContext(expected[2])})\n    continue\n   }\n   // Copy message entry storage before acknowledging its update.\n   m.Entries = append([]pb.Entry(nil), m.Entries...)\n   queue = append(queue, m)\n  }\n  p.Commit(ud)\n  p.NotifyRaftLastApplied(applied[id])\n }\n deliver := func() {\n  if len(queue)==0 { t.Fatal(\"empty delivery queue\") }\n  m := queue[0]\n  queue = queue[1:]\n  p := peers[m.To]\n  before := map[uint64]bool{}\n  if observed && m.To==1 && m.Type==pb.HeartbeatResp {\n   for origin, ctx := range expected { _, before[origin] = p.raft.readIndex.pending[ctx] }\n  }\n  p.Handle(m)\n  for origin, existed := range before {\n   _, remains := p.raft.readIndex.pending[expected[origin]]\n   if existed && !remains {\n    if !p.raft.isLeader() || p.raft.term!=term { t.Fatal(\"authority changed during confirmation\") }\n    releaseCount[origin]++\n    assuranceEvent(t, map[string]interface{}{\"event\":\"released\", \"scenario\":scenario, \"origin\":origin, \"removed\":true, \"term\":p.raft.term, \"response_from\":m.From, \"confirming_context\":assuranceContext(pb.SystemCtx{Low:m.Hint, High:m.HintHigh})})\n   }\n  }\n  flush(m.To)\n }\n drain := func() {\n  for steps:=0; len(queue)>0; steps++ {\n   if steps>=500 { t.Fatal(\"message drain bound reached\") }\n   deliver()\n  }\n }\n for id:=uint64(1); id<=3; id++ { flush(id) }\n drain()\n for ticks:=0; !peers[1].raft.isLeader() && ticks<50; ticks++ {\n  peers[1].Tick()\n  flush(1)\n  drain()\n }\n if !peers[1].raft.isLeader() || !peers[1].raft.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"current-term committed leader not reached\") }\n term=peers[1].raft.term\n for id:=uint64(1); id<=3; id++ {\n  p:=peers[id]\n  if p.raft.term!=term || p.raft.leaderID!=1 || applied[id]!=p.raft.log.committed || p.raft.numVotingMembers()!=3 { t.Fatalf(\"prefix incomplete at node %d\",id) }\n }\n observed=true\n dropFirst=true\n peers[2].ReadIndex(expected[2])\n flush(2)\n drain()\n dropFirst=false\n if dropped!=2 || len(peers[1].raft.readIndex.pending)!=1 { t.Fatal(\"first pending request / first round loss not established\") }\n peers[3].ReadIndex(expected[3])\n flush(3)\n if len(queue)!=1 || queue[0].Type!=pb.ReadIndex || queue[0].From!=3 || queue[0].To!=1 { t.Fatal(\"second forwarded request not reached\") }\n deliver()\n if len(peers[1].raft.readIndex.pending)!=2 || len(peers[1].raft.readIndex.queue)!=2 { t.Fatal(\"coexisting requests not reached\") }\n for _, origin:=range []uint64{2,3} {\n  ctx:=expected[origin]\n  status,ok:=peers[1].raft.readIndex.pending[ctx]\n  if !ok || status.from!=origin || status.ctx!=ctx { t.Fatal(\"leader admission differs from caller request\") }\n  assuranceEvent(t,map[string]interface{}{\"event\":\"admitted\", \"scenario\":scenario, \"origin\":origin, \"expected_context\":assuranceContext(ctx), \"term\":term, \"leader\":uint64(1), \"pending_count\":len(peers[1].raft.readIndex.pending), \"current_term_committed\":peers[1].raft.hasCommittedEntryAtCurrentTerm(), \"first_round_drops\":dropped})\n }\n drain()\n // End after finite queue exhaustion, independently of whether contexts match.\n for _, origin:=range []uint64{2,3} {\n  assuranceEvent(t,map[string]interface{}{\"event\":\"diagnostic\", \"scenario\":scenario, \"origin\":origin, \"wire_count\":wireCount[origin], \"ready_count\":readyCount[origin], \"release_count\":releaseCount[origin], \"leader_pending\":len(peers[1].raft.readIndex.pending), \"remaining_messages\":len(queue)})\n }\n}\nGO\ncat > build_check.py <<'\"'PY'\nimport json\nG=lambda src,exp,why:dict(source_ids=src,expectation_ids=exp,derivation=why,applicability='Accepted C_remote_read_context scope; fixed unchanged three-voter configuration, term and one request per remote origin.',unresolved=[],conflicts=[],alternatives=[])\nlegality=G(['src_launch','src_launch_bootstrap','src_memory_storage','src_peer_updates','src_engine_order','src_node_completion','src_context_admission','src_vote_admission','src_transport_loss','src_transport_order','src_context_generation'],['src_forwarded_read_expectation'],'Launch all peers with a common initial configuration and empty TestLogDB, persist each extracted update into its in-memory LogDB before messages, apply only bootstrap configuration and empty no-op entries, acknowledge updates and notify applied index. Tick only node 1 until a real election and current-term commit complete. Use Peer.ReadIndex on followers and Peer.Handle for every delivered message; no test-only campaign guard replacement. Drop the two generated first-context heartbeats at the outbound boundary as an allowed send loss, then deliver all remaining generated traffic in queue order. This does not synthesize votes or heartbeat replies. Contexts are fixed distinct nonzero legal Peer inputs; caller random generation is substituted, not its uniqueness constraint. Peers/TestLogDB have no background workers or external resources to shut down.')\nmonitorG=G(['src_confirmation_emission','src_read_receive','src_read_complete'],['src_confirm_expectation','src_forwarded_read_expectation','src_receive_expectation'],'Compare observed wire and ReadyToRead contexts with the context supplied by the driver at admitted. Correlate by scenario and origin only, which are unique since each follower originates one request. Removal from leader pending during the actual HeartbeatResp handler in unchanged authority records release before result delivery. Do not filter by context equality or outcome.')\npr=[dict(alias='admitted',event='admitted',conditions=[dict(field='current_term_committed',value=True),dict(field='pending_count',value=2),dict(field='first_round_drops',value=2)]),dict(alias='released',event='released',conditions=[dict(field='removed',value=True),dict(field='term',reference='admitted.term')])]\nprops=[];mons=[]\nfor event,binding in [('wire','bind_read_emission'),('ready','bind_read_receive')]:\n checker='check_'+event+'_context'\n mons.append(dict(id='monitor_'+event,checker_id=checker,event=event,binding_ids=[binding],grounding=monitorG,admission_alias='released',applicability_conditions=[]))\n props.append(dict(checker_id=checker,kind='event_assertion',trigger=dict(field='event',value=event),assertion=dict(field='context',reference='admitted.expected_context'),identity_fields=['scenario','origin'],description='The '+event+' observation for each released remote request preserves its supplied context; higher read index is allowed.'))\nplan=dict(description='Establish a three-voter leader through normal Peer initialization and traffic, lose only the first remote read heartbeat round, then allow a second remote read to confirm the queued prefix. Observe actual response encoding and ReadyToRead at each origin, plus release and setup diagnostics, for C_remote_read_context.',claim_id='C_remote_read_context',binding_ids=['bind_read_emission','bind_read_receive'],harness=dict(kind='go_test',source='',files={},execution_package='internal/raft',description='Single TestAssuranceRemoteReadContext using captured raft Peer, TestLogDB and real generated messages.',semantic_changes=['Storage is the captured in-memory TestLogDB; no crash or durability conclusion.','Sequential update/application driver handles bootstrap configuration entries and empty no-op entries through Peer APIs; no application state-machine payloads or NodeHost client objects are used.','Transport is a FIFO generated-message queue with explicit first-context outbound heartbeat loss; no protocol handler, response content or source file is replaced.','Read-only inspection of live peer state supplies prerequisites and release identity. Fixed unique contexts replace random caller context generation.'],prerequisites=pr,legality=legality),monitors=mons,observable_properties=props,uncertainties=['The check observes internal Peer ReadyToRead, not pendingReadIndex request notification or application lookup.','No assertion of timeout, eventual success or infinite stalling is made; only completed context comparisons are formal properties.','In-memory storage and a deterministic schedule do not cover crashes, dynamic membership or role transitions.'])\njson.dump(plan,open('read_context_plan.json','w'),indent=2)\nx=dict(action='check',unit_id='unit-C_remote_read_context',plan_path='read_context_plan.json',harness_path='read_context_test.go',rationale='Execute a fixed producer-to-consumer history for the accepted correlation obligation, preserving actual peer admission and independent origin identity.',sources=[dict(id='src_update_extract',file='internal/raft/peer.go',start_line=323,end_line=358,kind='code_observation'),dict(id='src_message_finalization',file='internal/raft/raft.go',start_line=649,end_line=667,kind='code_observation')])\njson.dump(x,open('submission4.json','w'),indent=2)\nPY\npython3 build_check.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));p=subprocess.run(r['validation']['command']+['submission4.json'],capture_output=True,text=True);print(p.stdout);print(p.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
