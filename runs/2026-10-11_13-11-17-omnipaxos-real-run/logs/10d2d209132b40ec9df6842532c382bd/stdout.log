tle\": \"Requirement\"\n    },\n    \"responsibility\": {\n      \"default\": \"\",\n      \"title\": \"Responsibility\",\n      \"type\": \"string\"\n    },\n    \"prerequisites\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventRequirement\"\n      },\n      \"title\": \"Prerequisites\",\n      \"type\": \"array\"\n    },\n    \"comparisons\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventComparison\"\n      },\n      \"title\": \"Comparisons\",\n      \"type\": \"array\"\n    },\n    \"knowledge\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/KnowledgeUse\"\n      },\n      \"title\": \"Knowledge\",\n      \"type\": \"array\"\n    },\n    \"previous_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Id\"\n    },\n    \"revision_reason\": {\n      \"default\": \"\",\n      \"title\": \"Revision Reason\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"investigation_id\",\n    \"harness_path\",\n    \"source_ids\",\n    \"scope\",\n    \"prefix\"\n  ],\n  \"title\": \"ExperimentRequest\",\n  \"type\": \"object\"\n}\nScope {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"assumptions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Assumptions\",\n      \"type\": \"array\"\n    },\n    \"excluded\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Excluded\",\n      \"type\": \"array\"\n    },\n    \"parameters\": {\n      \"additionalProperties\": true,\n      \"default\": {},\n      \"title\": \"Parameters\",\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"description\"\n  ],\n  \"title\": \"Scope\",\n  \"type\": \"object\"\n}\nComparison {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"field\": {\n      \"title\": \"Field\",\n      \"type\": \"string\"\n    },\n    \"op\": {\n      \"default\": \"eq\",\n      \"enum\": [\n        \"eq\",\n        \"ne\"\n      ],\n      \"title\": \"Op\",\n      \"type\": \"string\"\n    },\n    \"value\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"boolean\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Value\"\n    },\n    \"reference\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Reference\"\n    }\n  },\n  \"required\": [\n    \"field\"\n  ],\n  \"title\": \"Comparison\",\n  \"type\": \"object\"\n}\nEventComparison {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"event\": {\n      \"title\": \"Event\",\n      \"type\": \"string\"\n    },\n    \"identity_fields\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Identity Fields\",\n      \"type\": \"array\"\n    },\n    \"admission_alias\": {\n      \"title\": \"Admission Alias\",\n      \"type\": \"string\"\n    },\n    \"assertion\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"antecedent\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"applicability_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Comparison\"\n      },\n      \"title\": \"Applicability Conditions\",\n      \"type\": \"array\"\n    },\n    \"description\": {\n      \"default\": \"\",\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"event\",\n    \"identity_fields\",\n    \"admission_alias\",\n    \"assertion\"\n  ],\n  \"title\": \"EventComparison\",\n  \"type\": \"object\"\n}\nEventRequirement {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"alias\": {\n      \"title\": \"Alias\",\n      \"type\": \"string\"\n    },\n    \"event\": {\n      \"title\": \"Event\",\n      \"type\": \"string\"\n    },\n    \"conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Comparison\"\n      },\n      \"title\": \"Conditions\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"alias\",\n    \"event\"\n  ],\n  \"title\": \"EventRequirement\",\n  \"type\": \"object\"\n}\nSourceRange {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"file\": {\n      \"title\": \"File\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"document_statement\",\n        \"interface_statement\",\n        \"test_expectation\",\n        \"code_observation\",\n        \"protocol_candidate\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"file\",\n    \"start_line\",\n    \"end_line\",\n    \"kind\"\n  ],\n  \"title\": \"SourceRange\",\n  \"type\": \"object\"\n}\nQuestionUpdate {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Id\"\n    },\n    \"ref\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Ref\"\n    },\n    \"question\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Question\"\n    },\n    \"source_ids\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Source Ids\"\n    },\n    \"hypothesis\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Hypothesis\"\n    },\n    \"discriminator\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Discriminator\"\n    },\n    \"disposition\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"active\",\n            \"paused\",\n            \"explained\",\n            \"closed\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Disposition\"\n    },\n    \"parent_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Id\"\n    },\n    \"knowledge\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/KnowledgeUse\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Knowledge\"\n    },\n    \"counterevidence\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Counterevidence\"\n    },\n    \"limitations\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Limitations\"\n    },\n    \"resume_conditions\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Resume Conditions\"\n    }\n  },\n  \"title\": \"QuestionUpdate\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
