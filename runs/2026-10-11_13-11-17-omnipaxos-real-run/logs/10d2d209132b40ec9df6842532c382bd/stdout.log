}],\n 'experiment':{'investigation_id':'@snapshot_sync','harness_path':'snapshot_sync.rs','source_ids':ids,\n 'scope':{'description':'Three-node in-process cluster with real BLE and Sequence Paxos, MemoryStorage, deterministic message draining, unique-key map snapshots, and one temporary network partition.',\n 'assumptions':['MemoryStorage is used without crashes or write failures.','Node 1 is disconnected only after all nodes publicly expose the first decided entry.','The partition and reconnection occur between logical timer ticks; no timeout or permanent liveness claim is made.','Snapshot merge uses standard map overwrite semantics as documented.'],\n 'excluded':['Persistence crash windows','Application worker execution','Reconfiguration','Byzantine messages'],\n 'parameters':{'nodes':[1,2,3],'configuration_id':1,'initialization_ticks':40,'isolated_node':1,'preferred_leader':3}},\n 'prefix':'Build all instances from empty MemoryStorage through OmniPaxosConfig; drive 40 real logical ticks with complete delivery; append key 101 at leader 3 and drain until all nodes decide index 1. Partition node 1; append keys 202 and 303 at leader 3 and deliver remaining messages to obtain majority-decided index 3. Restore the transport and call node 1 reconnected(3); deliver all resulting original messages. In the control only, snapshot the leader locally at decided index 3 before restoration. All prefixes run independently from empty state in the same invocation.',\n 'responsibility':'A snapshot represents decided log entries and synchronization must preserve their key/value meaning. SnapshotType::Delta represents changes since an earlier snapshot; the receiver must merge it with the corresponding earlier local prefix, as distinct from reading a range of missing entries.',\n 'prerequisites':[{'alias':'admitted','event':'admission'}],\n 'comparisons':[{'event':'endpoint','identity_fields':['case','receiver'],'admission_alias':'admitted','assertion':{'field':'actual_state','op':'eq','reference':'admitted.expected_state'},'description':'The receiver public decided state must equal the actual leader decided state captured before reconnection for this same independently initialized case.'},\n {'event':'endpoint','identity_fields':['case','receiver'],'admission_alias':'admitted','assertion':{'field':'actual_decided','op':'eq','reference':'admitted.expected_decided'},'description':'Record whether recovery reached the leader decided boundary; contents are compared separately.'}]}}\nopen('snapshot_update.json','w').write(json.dumps(s,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cat > snapshot_sync.rs <<'RS'\nuse std::collections::BTreeMap;\nuse omnipaxos::{OmniPaxos, OmniPaxosConfig};\nuse omnipaxos::storage::{Entry, Snapshot};\nuse omnipaxos::messages::Message;\nuse omnipaxos::util::LogEntry;\nuse omnipaxos_storage::memory_storage::MemoryStorage;\nuse serde::{Serialize, Deserialize};\nuse serde_json::{json, Value};\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct Put { key: u64, value: u64 }\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct KvSnapshot(BTreeMap<u64, u64>);\nimpl Entry for Put { type Snapshot = KvSnapshot; }\nimpl Snapshot<Put> for KvSnapshot {\n    fn create(entries: &[Put]) -> Self {\n        let mut map = BTreeMap::new();\n        for entry in entries { map.insert(entry.key, entry.value); }\n        Self(map)\n    }\n    fn merge(&mut self, delta: Self) { self.0.extend(delta.0); }\n    fn use_snapshots() -> bool { true }\n}\ntype Node = OmniPaxos<Put, MemoryStorage<Put>>;\nfn emit(value: Value) { println\"'!(\"CA_EVENT {}\", value); }\nfn view(node: &Node) -> Value {\n    let entries = node.read_decided_suffix(0);\n    let raw = format!(\"{:?}\", entries);\n    let mut map = BTreeMap::new();\n    if let Some(entries) = entries {\n        for entry in entries {\n            match entry {\n                LogEntry::Decided(p) => { map.insert(p.key, p.value); }\n                LogEntry::Snapshotted(s) => { map.extend(s.snapshot.0); }\n                other => panic!(\"Unexpected decided representation: {:?}\", other),\n            }\n        }\n    }\n    json!({\"pid\":node.get_pid(), \"decided\":node.get_decided_idx(),\n        \"accepted\":node.get_accepted_idx(), \"compacted\":node.get_compacted_idx(),\n        \"state\":serde_json::to_string(&map).unwrap(), \"raw\":raw})\n}\nfn pump(nodes: &mut [Node], case: &str, phase: &str, isolated: Option<u64>) {\n    for _ in 0..100 {\n        let mut messages: Vec<Message<Put>> = Vec::new();\n        for node in nodes.iter_mut() { node.take_outgoing_messages(&mut messages); }\n        if messages.is_empty() { return; }\n        for message in messages {\n            let from = message.get_sender();\n            let to = message.get_receiver();\n            let dropped = isolated.map_or(false, |pid| from == pid || to == pid);\n            if phase != \"initialization\" {\n                emit(json!({\"event\":\"transport\", \"case\":case, \"phase\":phase,\n                    \"from\":from, \"to\":to, \"dropped\":dropped, \"message\":message}));\n            }\n            if !dropped { nodes[(to-1) as usize].handle_incoming(message); }\n        }\n    }\n    panic!(\"Message drain did not quiesce\");\n}\nfn run(case: &str, complete_snapshot: bool) {\n    let mut nodes: Vec<Node> = (1..=3).map(|pid| {\n        let mut config = OmniPaxosConfig::default();\n        config.cluster_config.configuration_id = 1;\n        config.cluster_config.nodes = vec![1,2,3];\n        config.server_config.pid = pid;\n        config.server_config.election_tick_timeout = 5;\n        config.server_config.leader_priority = if pid == 3 { 10 } else { 0 };\n        config.server_config.custom_logger = Some(slog::Logger::root(slog::Discard, slog::o!()));\n        config.build(MemoryStorage::default()).unwrap()\n    }).collect();\n    for _ in 0..40 {\n        for node in &mut nodes { node.tick(); }\n        pump(&mut nodes, case, \"initialization\", None);\n    }\n    for node in &nodes { assert_eq!(node.get_current_leader(), Some((3,true))); }\n    nodes[2].append(Put { key:101, value:1001 }).unwrap();\n    pump(&mut nodes, case, \"first_decision\", None);\n    for node in &nodes { assert_eq!(node.get_decided_idx(),1); }\n    emit(json!({\"event\":\"before_disconnect\", \"case\":case,\n        \"nodes\":nodes.iter().map(view).collect::<Vec<_>>()}));\n    emit(json!({\"event\":\"disconnect\", \"case\":case, \"isolated_pid\":1}));\n    nodes[2].append(Put { key:202, value:2002 }).unwrap();\n    nodes[2].append(Put { key:303, value:3003 }).unwrap();\n    pump(&mut nodes, case, \"partition\", Some(1));\n    assert_eq!(nodes[0].get_decided_idx(),1);\n    assert_eq!(nodes[0].get_accepted_idx(),1);\n    assert_eq!(nodes[2].get_decided_idx(),3);\n    assert_eq!(nodes[1].get_decided_idx(),3);\n    if complete_snapshot { nodes[2].snapshot(Some(3),true).unwrap(); }\n    let leader = view(&nodes[2]);\n    emit(json!({\"event\":\"admission\", \"case\":case, \"receiver\":1,\n        \"leader\":leader, \"receiver_before\":view(&nodes[0]),\n        \"expected_state\":leader[\"state\"], \"expected_decided\":leader[\"decided\"],\n        \"leader_compacted_for_control\":complete_snapshot}));\n    // The transport now restores node 1'\"'s connections after the recorded partition.\n    nodes[0].reconnected(3);\n    pump(&mut nodes, case, \\\"reconnection\\\", None);\n    let after = view(&nodes[0]);\n    emit(json\"'!({\"event\":\"endpoint\", \"case\":case, \"receiver\":1,\n        \"actual_state\":after[\"state\"], \"actual_decided\":after[\"decided\"],\n        \"receiver_after\":after, \"leader_after\":view(&nodes[2])}));\n}\n#[test]\nfn snapshot_sync_preserves_decided_state() {\n    run(\"delta_after_partition\", false);\n    run(\"complete_snapshot_control\", true);\n}\nRS\npython3 - <<'\"'PY'\nimport json\nsources=[]\ndef src(id,file,start,end,kind='code_observation'):\n sources.append(dict(id=id,file=file,start_line=start,end_line=end,kind=kind))\nsrc('sync_receiver','omnipaxos/src/storage/internal_storage.rs',312,411)\nsrc('sync_sender','omnipaxos/src/sequence_paxos/mod.rs',398,437)\nsrc('sync_leader','omnipaxos/src/sequence_paxos/leader.rs',142,191)\nsrc('prepare_recovery','omnipaxos/src/sequence_paxos/follower.rs',12,81)\nsrc('snapshot_contract','omnipaxos/src/storage/mod.rs',83,115,'interface_statement')\nsrc('storage_read_contract','omnipaxos/src/storage/mod.rs',186,190,'interface_statement')\nsrc('snapshot_docs','doc