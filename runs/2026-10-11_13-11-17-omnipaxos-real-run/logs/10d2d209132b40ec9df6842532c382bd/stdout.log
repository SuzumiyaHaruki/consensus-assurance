ption<SnapshotType<T>>, usize)> {\n   393\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   394\t        let compacted_idx = self.get_compacted_idx();\n   395\t        let snapshot = if from_idx <= compacted_idx {\n   396\t            // Some entries in range are compacted, snapshot entire decided log\n   397\t            if compacted_idx < log_decided_idx {\n   398\t                Some(SnapshotType::Complete(\n   399\t                    self.create_snapshot(log_decided_idx)?,\n   400\t                ))\n   401\t            } else {\n   402\t                // Entire decided log already snapshotted\n   403\t                self.get_snapshot()?.map(|s| SnapshotType::Complete(s))\n   404\t            }\n   405\t        } else {\n   406\t            let diff_entries = self.get_entries(from_idx, log_decided_idx)?;\n   407\t            Some(SnapshotType::Delta(T::Snapshot::create(\n   408\t                diff_entries.as_slice(),\n   409\t            )))\n   410\t        };\n   411\t        Ok((snapshot, log_decided_idx))\n   412\t    }\n   413\t\n   414\t    pub(crate) fn try_trim(&mut self, idx: usize) -> StorageResult<()> {\n   415\t        let decided_idx = self.get_decided_idx();\n   416\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   417\t        let new_compacted_idx = match idx.cmp(&decided_idx) {\n   418\t            Ordering::Less => idx,\n   419\t            Ordering::Equal => log_decided_idx,\n   420\t            Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   421\t        };\n   422\t        if new_compacted_idx > self.get_compacted_idx() {\n   423\t            self.storage.write_atomically(vec![\n   424\t                StorageOp::Trim(new_compacted_idx),\n   425\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   426\t            ])?;\n   427\t            self.state_cache.compacted_idx = new_compacted_idx;\n   428\t        }\n   429\t        Ok(())\n   430\t    }\n   431\t\n   432\t    pub(crate) fn try_snapshot(&mut self, snapshot_idx: Option<usize>) -> StorageResult<()> {\n   433\t        let decided_idx = self.get_decided_idx();\n   434\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   435\t        let new_compacted_idx = match snapshot_idx {\n   436\t            Some(i) => match i.cmp(&decided_idx) {\n   437\t                Ordering::Less => i,\n   438\t                Ordering::Equal => log_decided_idx,\n   439\t                Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   440\t            },\n   441\t            None => log_decided_idx,\n   442\t        };\n   443\t        if new_compacted_idx > self.get_compacted_idx() {\n   444\t            let snapshot = self.create_snapshot(new_compacted_idx)?;\n   445\t            self.storage.write_atomically(vec![\n   446\t                StorageOp::Trim(new_compacted_idx),\n   447\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   448\t                StorageOp::SetSnapshot(Some(snapshot)),\n   449\t            ])?;\n   450\t            self.state_cache.compacted_idx = new_compacted_idx;\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n   446\t}\n   447\t\n   448\t#[derive(PartialEq, Debug)]\n   449\tpub(crate) enum Role {\n   450\t    Follower,\n   451\t    Leader,\n   452\t}\n   453\t\n   454\t/// Configuration for `SequencePaxos`.\n   455\t/// # Fields\n   456\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   457\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   458\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   459\t/// * `buffer_size`: The buffer size for outgoing messages.\n   460\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   461\t/// * `logger_file_path`: The path where the default logger logs events.\n   462\t#[derive(Clone, Debug)]\n   463\tpub(crate) struct SequencePaxosConfig {\n   464\t    pid: NodeId,\n   465\t    peers: Vec<NodeId>,\n   466\t    buffer_size: usize,\n   467\t    pub(crate) batch_size: usize,\n   468\t    flexible_quorum: Option<FlexibleQuorum>,\n   469\t    #[cfg(feature = \"logging\")]\n   470\t    logger_file_path: Option<String>,\n   471\t    #[cfg(feature = \"logging\")]\n   472\t    custom_logger: Option<Logger>,\n   473\t}\n   474\t\n   475\timpl From<OmniPaxosConfig> for SequencePaxosConfig {\n   476\t    fn from(config: OmniPaxosConfig) -> Self {\n   477\t        let pid = config.server_config.pid;\n   478\t        let peers = config\n   479\t            .cluster_config\n   480\t            .nodes\n   481\t            .into_iter()\n   482\t            .filter(|x| *x != pid)\n   483\t            .collect();\n   484\t        SequencePaxosConfig {\n   485\t            pid,\n   486\t            peers,\n","exit_code":0,"status":"completed"}}
