resend {\n   225\t            true => self.leader_state.get_seq_num(to),\n   226\t            false => self.leader_state.next_seq_num(to),\n   227\t        };\n   228\t        let acc_ss = PaxosMsg::AcceptStopSign(AcceptStopSign {\n   229\t            seq_num,\n   230\t            n: self.leader_state.n_leader,\n   231\t            ss,\n   232\t        });\n   233\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   234\t            from: self.pid,\n   235\t            to,\n   236\t            msg: acc_ss,\n   237\t        }));\n   238\t    }\n   239\t\n   240\t    pub(crate) fn send_decide(&mut self, to: NodeId, decided_idx: usize, resend: bool) {\n   241\t        let seq_num = match resend {\n   242\t            true => self.leader_state.get_seq_num(to),\n   243\t            false => self.leader_state.next_seq_num(to),\n   244\t        };\n   245\t        let d = Decide {\n   246\t            n: self.leader_state.n_leader,\n   247\t            seq_num,\n   248\t            decided_idx,\n   249\t        };\n   250\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   251\t            from: self.pid,\n   252\t            to,\n   253\t            msg: PaxosMsg::Decide(d),\n   254\t        }));\n   255\t    }\n   256\t\n   257\t    fn handle_majority_promises(&mut self) {\n   258\t        let max_promise_sync = self.leader_state.take_max_promise_sync();\n   259\t        let decided_idx = self.leader_state.get_max_decided_idx();\n   260\t        let mut new_accepted_idx = self\n   261\t            .internal_storage\n   262\t            .sync_log(self.leader_state.n_leader, decided_idx, max_promise_sync)\n   263\t            .expect(WRITE_ERROR_MSG);\n   264\t        if !self.accepted_reconfiguration() {\n   265\t            if !self.buffered_proposals.is_empty() {\n   266\t                let entries = std::mem::take(&mut self.buffered_proposals);\n   267\t                new_accepted_idx = self\n   268\t                    .internal_storage\n   269\t                    .append_entries_without_batching(entries)\n   270\t                    .expect(WRITE_ERROR_MSG);\n   271\t            }\n   272\t            if let Some(ss) = self.buffered_stopsign.take() {\n   273\t                self.internal_storage\n   274\t                    .append_stopsign(ss)\n   275\t                    .expect(WRITE_ERROR_MSG);\n   276\t                new_accepted_idx = self.internal_storage.get_accepted_idx();\n   277\t            }\n   278\t        }\n   279\t        self.state = (Role::Leader, Phase::Accept);\n   280\t        self.leader_state\n   281\t            .set_accepted_idx(self.pid, new_accepted_idx);\n   282\t        for pid in self.leader_state.get_promised_followers() {\n   283\t            self.send_accsync(pid);\n   284\t        }\n   285\t    }\n   286\t\n   287\t    pub(crate) fn handle_promise_prepare(&mut self, prom: Promise<T>, from: NodeId) {\n   288\t        #[cfg(feature = \"logging\")]\n   289\t        debug!(\n   290\t            self.logger,\n   291\t            \"Handling promise from {} in Prepare phase\", from\n   292\t        );\n   293\t        if prom.n == self.leader_state.n_leader {\n   294\t            let received_majority = self.leader_state.set_promise(prom, from, true);\n   295\t            if received_majority {\n   296\t                self.handle_majority_promises();\n   297\t            }\n   298\t        }\n   299\t    }\n   300\t\n   301\t    pub(crate) fn handle_promise_accept(&mut self, prom: Promise<T>, from: NodeId) {\n   302\t        #[cfg(feature = \"logging\")]\n   303\t        {\n   304\t            let (r, p) = &self.state;\n   305\t            debug!(\n   306\t                self.logger,\n   307\t                \"Self role {:?}, phase {:?}. Incoming message Promise Accept from {}\", r, p, from\n   308\t            );\n   309\t        }\n   310\t        if prom.n == self.leader_state.n_leader {\n   311\t            self.leader_state.set_promise(prom, from, false);\n   312\t            self.send_accsync(from);\n   313\t        }\n   314\t    }\n   315\t\n   316\t    pub(crate) fn handle_accepted(&mut self, accepted: Accepted, from: NodeId) {\n   317\t        #[cfg(feature = \"logging\")]\n   318\t        trace!(\n   319\t            self.logger,\n   320\t            \"Got Accepted from {}, idx: {}, chosen_idx: {}, accepted: {:?}\",\n   321\t            from,\n   322\t            accepted.accepted_idx,\n   323\t            self.internal_storage.get_decided_idx(),\n   324\t            self.leader_state.accepted_indexes\n   325\t        );\n   326\t        if accepted.n == self.leader_state.n_leader && self.state == (Role::Leader, Phase::Accept) {\n   327\t            self.leader_state\n   328\t                .set_accepted_idx(from, accepted.accepted_idx);\n   329\t            if accepted.accepted_idx > self.internal_storage.get_decided_idx()\n   330\t                && self.leader_state.is_chosen(accepted.accepted_idx)\n   331\t            {\n   332\t                let decided_idx = accepted.accepted_idx;\n   333\t                self.internal_storage\n   334\t                    .set_decided_idx(decided_idx)\n   335\t                    .expect(WRITE_ERROR_MSG);\n   336\t                for pid in self.leader_state.get_promised_followers() {\n   337\t                    let latest_accdec = self.get_latest_accdec_message(pid);\n   338\t                    match latest_accdec {\n   339\t                        Some(accdec) => accdec.decided_idx = decided_idx,\n   340\t                        None => self.send_decide(pid, decided_idx, false),\n   341\t                    }\n   342\t                }\n   343\t            }\n   344\t        }\n   345\t    }\n   346\t\n   347\t    fn get_latest_accdec_message(&mut self, to: NodeId) -> Option<&mut AcceptDecide<T>> {\n   348\t        if let Some((bal, outgoing_idx)) = self.leader_state.get_latest_accept_meta(to) {\n   349\t            if bal == self.leader_state.n_leader {\n   350\t                if let Message::SequencePaxos(PaxosMessage {\n   351\t                    msg: PaxosMsg::AcceptDecide(accdec),\n   352\t                    ..\n   353\t                }) = self.outgoing.get_mut(outgoing_idx).unwrap()\n   354\t                {\n   355\t                    return Some(accdec);\n   356\t                } else {\n   357\t                    #[cfg(feature = \"logging\")]\n   358\t                    debug!(self.logger, \"Cached idx is not an AcceptedDecide!\");\n   359\t                }\n   360\t            }\n   361\t        }\n   362\t        None\n   363\t    }\n   364\t\n   365\t    pub(crate) fn handle_notaccepted(&mut self, not_acc: NotAccepted, from: NodeId) {\n   366\t        if self.state.0 == Role::Leader && self.leader_state.n_leader < not_acc.n {\n   367\t            self.leader_state.lost_promise(from);\n   368\t        }\n   369\t    }\n   370\t\n   371\t    pub(crate) fn resend_messages_leader(&mut self) {\n   372\t        match self.state.1 {\n   373\t            Phase::Prepare => {\n   374\t                // Resend Prepare\n   375\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   376\t                for peer in preparable_peers {\n   377\t                    self.send_prepare(peer);\n   378\t                }\n   379\t            }\n   380\t            Phase::Accept => {\n   381\t                // Resend AcceptStopSign or StopSign's decide\n   382\t                if let Some(ss) = self.internal_storage.get_stopsign() {\n   383\t                    let decided_idx = self.internal_storage.get_decided_idx();\n   384\t                    for follower in self.leader_state.get_promised_followers() {\n   385\t                        if self.internal_storage.stopsign_is_decided() {\n   386\t                            self.send_decide(follower, decided_idx, true);\n   387\t                        } else if self.leader_state.get_accepted_idx(follower)\n   388\t                            != self.internal_storage.get_accepted_idx()\n   389\t                        {\n   390\t                            self.send_accept_stopsign(follower, ss.clone(), true);\n   391\t                        }\n   392\t                    }\n   393\t                }\n   394\t                // Resend Prepare\n   395\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   396\t                for peer in preparable_peers {\n   397\t                    self.send_prepare(peer);\n   398\t                }\n   399\t            }\n   400\t            Phase::Recover => (),\n   401\t            Phase::None => (),\n   402\t        }\n   403\t    }\n   404\t\n   405\t    pub(crate) fn flush_batch_leader(&mut self) {\n   406\t        let accepted_metadata = self\n   407\t            .internal_storage\n   408\t            .flush_batch_and_get_entries()\n   409\t            .expect(WRITE_ERROR_MSG);\n   410\t        if let Some(metadata) = accepted_metadata {\n   411\t            self.leader_state\n   412\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   413\t            self.send_acceptdecide(metadata);\n   414\t        }\n   415\t    }\n   416\t}\n","exit_code":0,"status":"completed"}}
