n\\t}\\n\\treturn out\\n}\\nfunc authorityEvent(v map[string]interface{}) {\\n\\tb, _ := json.Marshal(v)\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc authorityWait(t *testing.T, f Future) error {\\n\\tt.Helper()\\n\\tdone := make(chan error, 1)\\n\\tgo func() { done <- f.Error() }()\\n\\tselect {\\n\\tcase err := <-done:\\n\\t\\treturn err\\n\\tcase <-time.After(10 * time.Second):\\n\\t\\tt.Fatal(\\\"future observation deadline\\\")\\n\\t\\treturn nil\\n\\t}\\n}\\nfunc authorityPoll(t *testing.T, what string, p func() bool) {\\n\\tt.Helper()\\n\\tdeadline := time.Now().Add(10 * time.Second)\\n\\tfor time.Now().Before(deadline) {\\n\\t\\tif p() {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t\\ttime.Sleep(5 * time.Millisecond)\\n\\t}\\n\\tt.Fatalf(\\\"precondition not reached: %s\\\", what)\\n}\\nfunc TestAssuranceVerifySupersededAuthority(t *testing.T) {\\n\\tconst op = \\\"superseded-verify-1\\\"\\n\\tvar nodes []*Raft\\n\\tvar fsms []*MockFSM\\n\\ttrans := make([]*authorityTransport, 4)\\n\\tconfig := Configuration{}\\n\\tfor i := range trans {\\n\\t\\tid := ServerID(fmt.Sprintf(\\\"authority-%d\\\", i))\\n\\t\\taddr := ServerAddress(id)\\n\\t\\t_, base := NewInmemTransportWithTimeout(addr, 50*time.Millisecond)\\n\\t\\ttrans[i] = &authorityTransport{InmemTransport: base, successes: map[ServerID]int{}}\\n\\t\\tsuffrage := Voter\\n\\t\\tif i == 3 {\\n\\t\\t\\tsuffrage = Nonvoter\\n\\t\\t}\\n\\t\\tconfig.Servers = append(config.Servers, Server{ID: id, Address: addr, Suffrage: suffrage})\\n\\t}\\n\\tfor i := range trans {\\n\\t\\tfor j := range trans {\\n\\t\\t\\tif i != j {\\n\\t\\t\\t\\ttrans[i].Connect(trans[j].LocalAddr(), trans[j].InmemTransport)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tdefer func() {\\n\\t\\tvar pending []Future\\n\\t\\tfor _, r := range nodes {\\n\\t\\t\\tpending = append(pending, r.Shutdown())\\n\\t\\t}\\n\\t\\tfor _, tr := range trans {\\n\\t\\t\\ttr.Close()\\n\\t\\t}\\n\\t\\tfor _, f := range pending {\\n\\t\\t\\tauthorityWait(t, f)\\n\\t\\t}\\n\\t}()\\n\\tfor i := range trans {\\n\\t\\tc := DefaultConfig()\\n\\t\\tc.LocalID = config.Servers[i].ID\\n\\t\\tc.CommitTimeout = 10 * time.Millisecond\\n\\t\\tc.HeartbeatTimeout = 150 * time.Millisecond\\n\\t\\tc.ElectionTimeout = 150 * time.Millisecond\\n\\t\\tc.LeaderLeaseTimeout = 150 * time.Millisecond\\n\\t\\tif i == 0 {\\n\\t\\t\\tc.HeartbeatTimeout = 3 * time.Second\\n\\t\\t\\tc.ElectionTimeout = 3 * time.Second\\n\\t\\t\\tc.LeaderLeaseTimeout = 3 * time.Second\\n\\t\\t}\\n\\t\\tif i == 3 {\\n\\t\\t\\tc.HeartbeatTimeout = 3 * time.Second\\n\\t\\t\\tc.ElectionTimeout = 3 * time.Second\\n\\t\\t\\tc.LeaderLeaseTimeout = 3 * time.Second\\n\\t\\t}\\n\\t\\tstore := NewInmemStore()\\n\\t\\tsnap := NewInmemSnapshotStore()\\n\\t\\tfsm := &MockFSM{}\\n\\t\\tif i == 0 {\\n\\t\\t\\tinitial := Configuration{Servers: []Server{config.Servers[0]}}\\n\\t\\t\\tif err := BootstrapCluster(c, store, store, snap, trans[i], initial); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tr, err := NewRaft(c, fsm, store, store, snap, trans[i])\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t\\tnodes = append(nodes, r)\\n\\t\\tfsms = append(fsms, fsm)\\n\\t}\\n\\told := nodes[0]\\n\\tauthorityPoll(t, \\\"initial single-voter election\\\", func() bool { return old.State() == Leader })\\n\\tfor i := 1; i <= 2; i++ {\\n\\t\\ts := config.Servers[i]\\n\\t\\tif err := authorityWait(t, old.AddVoter(s.ID, s.Address, 0, time.Second)); err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\ts := config.Servers[3]\\n\\tif err := authorityWait(t, old.AddNonvoter(s.ID, s.Address, 0, time.Second)); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tprefix := old.Apply([]byte(\\\"common-prefix\\\"), time.Second)\\n\\tif err := authorityWait(t, prefix); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tauthorityPoll(t, \\\"all nodes have final membership and committed prefix\\\", func() bool {\\n\\t\\tfor _, r := range nodes {\\n\\t\\t\\tif !reflect.DeepEqual(r.getLatestConfiguration(), config) || r.CommitIndex() < prefix.Index() {\\n\\t\\t\\t\\treturn false\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn true\\n\\t})\\n\\tif err := authorityWait(t, old.VerifyLeader()); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tauthorityEvent(map[string]interface{}{\\\"event\\\": \\\"connected_control\\\", \\\"operation\\\": \\\"connected-control\\\", \\\"success\\\": true, \\\"term\\\": old.CurrentTerm()})\\n\\toldTerm := old.CurrentTerm()\\n\\tauthorityEvent(map[string]interface{}{\\\"event\\\": \\\"stable_prefix\\\", \\\"operation\\\": op, \\\"old_term\\\": oldTerm, \\\"prefix_index\\\": prefix.Index(), \\\"configuration\\\": config})\\n\\t// Disconnect every RPC route crossing {old leader, nonvoter} and {two voters}.\\n\\t// Already admitted requests are allowed to finish. No state is assigned and\\n\\t// every worker, lease timer and negative-response path remains enabled.\\n\\tfor _, i := range []int{0, 3} {\\n\\t\\tfor _, j := range []int{1, 2} {\\n\\t\\t\\ttrans[i].Disconnect(trans[j].LocalAddr())\\n\\t\\t\\ttrans[j].Disconnect(trans[i].LocalAddr())\\n\\t\\t}\\n\\t}\\n\\tvar replacement *Raft\\n\\tri := -1\\n\\tauthorityPoll(t, \\\"higher-term elected replacement\\\", func() bool {\\n\\t\\tfor _, i := range []int{1, 2} {\\n\\t\\t\\tif nodes[i].State() == Leader && nodes[i].CurrentTerm() > oldTerm {\\n\\t\\t\\t\\treplacement = nodes[i]\\n\\t\\t\\t\\tri = i\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn false\\n\\t})\\n\\tcommand := replacement.Apply([]byte(\\\"replacement-command\\\"), time.Second)\\n\\tif err := authorityWait(t, command); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tfsms[ri].Lock()\\n\\tseen := false\\n\\tfor _, data := range fsms[ri].logs {\\n\\t\\tif string(data) == \\\"replacement-command\\\" {\\n\\t\\t\\tseen = true\\n\\t\\t}\\n\\t}\\n\\tfsms[ri].Unlock()\\n\\treplacementTerm := replacement.CurrentTerm()\\n\\tif !seen || replacementTerm <= oldTerm || replacement.State() != Leader {\\n\\t\\tt.Fatal(\\\"replacement authority prerequisite not established\\\")\\n\\t}\\n\\tauthorityEvent(map[string]interface{}{\\\"event\\\": \\\"superseding_command\\\", \\\"operation\\\": op, \\\"old_term\\\": oldTerm, \\\"new_term\\\": replacementTerm, \\\"new_leader\\\": replacement.localID, \\\"command_index\\\": command.Index(), \\\"command_applied\\\": seen, \\\"higher_term\\\": replacementTerm > oldTerm})\\n\\t// A newer term on the old node would complicate the selected continuity\\n\\t// premise. Leave that schedule incomplete rather than changing the oracle.\\n\\tif old.CurrentTerm() != oldTerm {\\n\\t\\tt.Fatal(\\\"old-node term changed before verification admission\\\")\\n\\t}\\n\\tbefore := trans[0].counts()\\n\\tauthorityEvent(map[string]interface{}{\\\"event\\\": \\\"verification_admitted\\\", \\\"operation\\\": op, \\\"new_term\\\": replacementTerm, \\\"old_term\\\": old.CurrentTerm(), \\\"state\\\": old.State().String(), \\\"before\\\": before})\\n\\tfuture := old.VerifyLeader()\\n\\tdone := make(chan error, 1)\\n\\tgo func() { done <- future.Error() }()\\n\\tforced := false\\n\\tvar result error\\n\\tselect {\\n\\tcase result = <-done:\\n\\tcase <-time.After(700 * time.Millisecond):\\n\\t\\t// Stop the controlled operation independently of its forbidden outcome.\\n\\t\\tforced = true\\n\\t\\tshutdown := old.Shutdown()\\n\\t\\tselect {\\n\\t\\tcase result = <-done:\\n\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\tt.Fatal(\\\"verification completion missing after shutdown\\\")\\n\\t\\t}\\n\\t\\tif err := authorityWait(t, shutdown); err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\tauthorityEvent(map[string]interface{}{\\\"event\\\": \\\"verification_result\\\", \\\"operation\\\": op, \\\"success\\\": result == nil, \\\"error\\\": fmt.Sprint(result), \\\"shutdown_forced\\\": forced, \\\"old_term\\\": old.CurrentTerm(), \\\"new_term\\\": replacementTerm, \\\"state\\\": old.State().String(), \\\"after\\\": trans[0].counts()})\\n}\\n\",\n    \"description\": \"Start node 0 as a real single-voter leader; publicly add two voters and a nonvoter, apply a common prefix, and wait for all four commit indexes and latest memberships. Freeze membership by issuing no further changes. Disconnect both directions across {0,3}/{1,2}. Let actual workers elect a higher-term leader among 1,2 and apply a command. Invoke node 0 VerifyLeader only afterward. Record its exact Future.Error result. If still pending after 700ms, shut down node 0 and await completion. Initial control succeeds while fully connected.\",\n    \"semantic_changes\": [\n      \"No target changes or critical state assignments. In-memory transport wrapper disables optional pipelining and records successful append responses by target ID.\",\n      \"Different valid per-node election/lease durations: old node and nonvoter use 3 seconds, other voters 150ms; all use 10ms commit timeout. These permit replacement election before the old lease expires; no lease worker is paused.\",\n      \"Network cuts use real InmemTransport.Disconnect, affecting every RPC crossing the partition. Already admitted requests may complete.\",\n      \"MockFSM records actual callback data; read-only locked inspection confirms the replacement command.\",\n      \"Read-only atomic latest-configuration and commit-index observations confirm installed membership/prefix; no private role or term writes.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"superseded\",\n        \"event\": \"superseding_command\",\n        \"conditions\": [\n          {\n            \"field\": \"higher_term\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"command_applied\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"invocation\",\n        \"event\": \"verification_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"new_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"superseded.new_term\"\n          },\n          {\n            \"field\": \"old_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"superseded.old_term\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"s_verify\",\n        \"s_notify\",\n        \"s_future\",\n        \"s_loop\",\n        \"s_lease\",\n        \"s_election\",\n        \"s_campaign\",\n        \"s_commit\",\n        \"s_fsm\",\n        \"s_inmem_transport_probe\",\n        \"s_transport_disconnect\",\n        \"s_mockfsm\",\n        \"s_config_timeouts\",\n        \"s_membership_api\"\n      ],\n      \"expectation_ids\": [\n        \"i_verify\",\n        \"i_future\"\n      ],\n      \"binding_ids\": [\n        \"bind_verify_entry\",\n        \"bind_verify_tally\"\n      ],\n      \"derivation\": \"The public VerifyLeader contract explicitly ensures the peer is still leader and allows use to prevent stale FSM reads after loss of leadership. Future.Error is its observable completion status. Rather than inventing a requirement to collect a particular number of fresh replies, this obligation establishes the antecedent of lost authority independently: another configured voter won a higher-term election and applied a new command before invocation, with no subsequent reacquisition by the old node. A nil verification result then contradicts the promised authority check regardless of the particular tally mechanism. The nonvoter path is the suspected producer of insufficient support, not the normative source of the obligation.\",\n      \"applicability\": \"Ordinary online API use in a mixed-membership cluster. Network partition delays or prevents cross-partition RPCs but does not fabricate response contents, terms, votes or commits. A local role still reading Leader is precisely the stale authority condition the API must check; it cannot be assumed to validate itself.\",\n      \"unresolved\": [\n        \"The measured comparison is bounded to the submitted partition and timing configuration; successful execution is not overall correctness.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Voter-only lease check or negative/newer-term RPC may step down the old node and return error; either prevents the forbidden success.\",\n        \"A valid alternative authority mechanism would also satisfy the API, but local state and isolated nonvoter success cannot undo an independently observed higher-term election.\",\n        \"Pending verification is permitted; a finite observation deadline alone is not a violation.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor_superseded_verify\",\n      \"checker_id\": \"verify_no_success_after_supersession\",\n      \"event\": \"verification_result\",\n      \"binding_ids\": [\n        \"bind_verify_entry\",\n        \"bind_verify_tally\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s_verify\",\n          \"s_notify\",\n          \"s_future\",\n          \"s_loop\",\n          \"s_lease\",\n          \"s_election\",\n          \"s_campaign\",\n          \"s_commit\",\n          \"s_fsm\",\n          \"s_inmem_transport_probe\",\n          \"s_transport_disconnect\",\n          \"s_mockfsm\",\n          \"s_config_timeouts\",\n          \"s_membership_api\"\n        ],\n        \"expectation_ids\": [\n          \"i_verify\",\n          \"i_future\"\n        ],\n        \"binding_ids\": [\n          \"bind_verify_entry\",\n          \"bind_verify_tally\"\n        ],\n        \"derivation\": \"The public VerifyLeader contract explicitly ensures the peer is still leader and allows use to prevent stale FSM reads after loss of leadership. Future.Error is its observable completion status. Rather than inventing a requirement to collect a particular number of fresh replies, this obligation establishes the antecedent of lost authority independently: another configured voter won a higher-term election and applied a new command before invocation, with no subsequent reacquisition by the old node. A nil verification result then contradicts the promised authority check regardless of the particular tally mechanism. The nonvoter path is the suspected producer of insufficient support, not the normative source of the obligation.\",\n        \"applicability\": \"Ordinary online API use in a mixed-membership cluster. Network partition delays or prevents cross-partition RPCs but does not fabricate response contents, terms, votes or commits. A local role still reading Leader is precisely the stale authority condition the API must check; it cannot be assumed to validate itself.\",\n        \"unresolved\": [\n          \"The measured comparison is bounded to the submitted partition and timing configuration; successful execution is not overall correctness.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Voter-only lease check or negative/newer-term RPC may step down the old node and return error; either prevents the forbidden success.\",\n          \"A valid alternative authority mechanism would also satisfy the API, but local state and isolated nonvoter success cannot undo an independently observed higher-term election.\",\n          \"Pending verification is permitted; a finite observation deadline alone is not a violation.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"invocation\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"verify_no_success_after_supersession\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"verification_result\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"operation\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For each admitted verification following actual higher-term authority and applied command, its observed public completion must not be successful. Errors including shutdown are permitted; missing prerequisite/result is incomplete, not a violation.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Only public VerifyLeader authority semantics are checked; stale application reads and conflicting logs are excluded.\",\n    \"The result is not correlated using an expected-to-change term: operation is the independent identity; term relationships are predecessor conditions.\",\n    \"Response counts are diagnostic only. Delayed pre-partition replies could affect the mechanism but cannot restore authority after the independently established newer election.\",\n    \"The transport has no heartbeat fast-path and optional pipelining is disabled; other transport modes are not covered.\"\n  ]\n}{\n  \"direct_check_id\": \"519e1b7b7bdc4d2ca2774233ed412354\",\n  \"experiment_check_id\": \"1d135dea815c487cadfbd26b759bf129\",\n  \"scope\": {\n    \"description\": \"Public leadership-verification safety under a network partition separating the old leader and a nonvoter from the two remaining voters in a three-voter configuration. A higher-term elected leader and completed new command precede invocation on the old leader. The proposition forbids success, but permits errors or remaining pending until bounded harness shutdown.\",\n    \"assumptions\": [\n      \"Non-Byzantine actual Raft workers and transports; requests may be unavailable across a declared partition.\",\n      \"Static, consistently installed membership and stable participant IDs; no forced recovery, restore, or membership change during the comparison.\",\n      \"Observe real election and successful command application in the same execution; do not assign terms or role state.\",\n      \"The original leader has not rejoined or won another election before completion.\"\n    ],\n    \"excluded\": [\n      \"General liveness or deadline guarantees.\",\n      \"Proof of stale application reads, conflicting committed logs, crash durability, or every transport variant.\",\n      \"Treating absence of remote responses alone as proof of lost authority.\"\n    ],\n    \"parameters\": {\n      \"voters\": 3,\n      \"nonvoters\": 1,\n      \"required_order\": \"higher-term authority and applied command -> old-leader VerifyLeader invocation -> result\"\n    }\n  },\n  \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-09-28_12-40-13-hashicorp_raft-real-run/logs/1d135dea815c487cadfbd26b759bf129/stdout.log\",\n  \"parsing_errors\": [],\n  \"prerequisites\": {\n    \"status\": \"matched\",\n    \"reason\": \"Declared prerequisites established\",\n    \"matched_indices\": [\n      2,\n      3\n    ],\n    \"alias_indices\": {\n      \"superseded\": 2,\n      \"invocation\": 3\n    }\n  },\n  \"properties\": [\n    {\n      \"monitor_id\": \"monitor_superseded_verify\",\n      \"checker_id\": \"verify_no_success_after_supersession\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        4\n      ],\n      \"valid_witness_indices\": [\n        4\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        4\n      ],\n      \"outside_applicability_indices\": [],\n      \"correlations\": {\n        \"4\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            2,\n            3\n          ],\n          \"alias_indices\": {\n            \"superseded\": 2,\n            \"invocation\": 3\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"No target changes or critical state assignments. In-memory transport wrapper disables optional pipelining and records successful append responses by target ID.\",\n    \"Different valid per-node election/lease durations: old node and nonvoter use 3 seconds, other voters 150ms; all use 10ms commit timeout. These permit replacement election before the old lease expires; no lease worker is paused.\",\n    \"Network cuts use real InmemTransport.Disconnect, affecting every RPC crossing the partition. Already admitted requests may complete.\",\n    \"MockFSM records actual callback data; read-only locked inspection confirms the replacement command.\",\n    \"Read-only atomic latest-configuration and commit-index observations confirm installed membership/prefix; no private role or term writes.\"\n  ],\n  \"blockers\": [\n    \"Direct oracle correspondence is unreviewed\"\n  ],\n  \"boundaries\": [\n    \"General liveness or deadline guarantees.\",\n    \"Proof of stale application reads, conflicting committed logs, crash durability, or every transport variant.\",\n    \"Treating absence of remote responses alone as proof of lost authority.\",\n    \"Only public VerifyLeader authority semantics are checked; stale application reads and conflicting logs are excluded.\",\n    \"The result is not correlated using an expected-to-change term: operation is the independent identity; term relationships are predecessor conditions.\",\n    \"Response counts are diagnostic only. Delayed pre-partition replies could affect the mechanism but cannot restore authority after the independently established newer election.\",\n    \"The transport has no heartbeat fast-path and optional pipelining is disabled; other transport modes are not covered.\",\n    \"A successful exploration with unchanged term and no replacement leader does not establish this antecedent.\",\n    \"The stronger legal prefix and public result require a new submitted check.\",\n    \"The measured comparison is bounded to the submitted partition and timing configuration; successful execution is not overall correctness.\"\n  ],\n  \"reviewed_complete\": false,\n  \"bounded_complete\": true,\n  \"confirmed\": false,\n  \"outcome\": \"violated\",\n  \"level\": \"implementation_test\",\n  \"claim_id\": \"o_verify_superseded_authority\",\n  \"claim_version\": 1,\n  \"framework_revision\": \"native-products-v27\",\n  \"finding_ids\": {\n    \"verify_no_success_after_supersession\": \"7518bb7f85a845018ff3761f9d4e5b98\"\n  },\n  \"finding_id\": \"7518bb7f85a845018ff3761f9d4e5b98\"\n}{\"Time\":\"2026-09-28T12:58:37.034014524+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"2026-09-28T12:58:37.033+0800 [INFO]  raft: election won: term=2 tally=1\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.034026129+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"2026-09-28T12:58:37.033+0800 [INFO]  raft: entering leader state: leader=\\\"Node at authority-0 [Leader]\\\"\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.057286027+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"connected_control\\\",\\\"operation\\\":\\\"connected-control\\\",\\\"success\\\":true,\\\"term\\\":2}\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.057368744+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"CA_EVENT {\\\"configuration\\\":{\\\"Servers\\\":[{\\\"Suffrage\\\":0,\\\"ID\\\":\\\"authority-0\\\",\\\"Address\\\":\\\"authority-0\\\"},{\\\"Suffrage\\\":0,\\\"ID\\\":\\\"authority-1\\\",\\\"Address\\\":\\\"authority-1\\\"},{\\\"Suffrage\\\":0,\\\"ID\\\":\\\"authority-2\\\",\\\"Address\\\":\\\"authority-2\\\"},{\\\"Suffrage\\\":1,\\\"ID\\\":\\\"authority-3\\\",\\\"Address\\\":\\\"authority-3\\\"}]},\\\"event\\\":\\\"stable_prefix\\\",\\\"old_term\\\":2,\\\"operation\\\":\\\"superseded-verify-1\\\",\\\"prefix_index\\\":6}\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.249635114+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"2026-09-28T12:58:37.248+0800 [INFO]  raft: election won: term=3 tally=2\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.249643736+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"2026-09-28T12:58:37.248+0800 [INFO]  raft: entering leader state: leader=\\\"Node at authority-2 [Leader]\\\"\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.250282678+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"CA_EVENT {\\\"command_applied\\\":true,\\\"command_index\\\":8,\\\"event\\\":\\\"superseding_command\\\",\\\"higher_term\\\":true,\\\"new_leader\\\":\\\"authority-2\\\",\\\"new_term\\\":3,\\\"old_term\\\":2,\\\"operation\\\":\\\"superseded-verify-1\\\"}\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.250544038+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"CA_EVENT {\\\"before\\\":{\\\"authority-1\\\":6,\\\"authority-2\\\":4,\\\"authority-3\\\":16},\\\"event\\\":\\\"verification_admitted\\\",\\\"new_term\\\":3,\\\"old_term\\\":2,\\\"operation\\\":\\\"superseded-verify-1\\\",\\\"state\\\":\\\"Leader\\\"}\\n\"}\n{\"Time\":\"2026-09-28T12:58:37.250614194+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifySupersededAuthority\",\"Output\":\"CA_EVENT {\\\"afte