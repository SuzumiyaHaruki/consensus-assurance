al_effects=['Commands call FSM.Apply or ApplyBatch; future succeeds after callback and carries its response.'],important_branches=['No-op handled without FSM mutation; configuration delivered only for supported protocol; batch response count mismatch panics.'],async_boundaries=['lastApplied in main loop tracks enqueue progress; FSM execution and public future completion are later.'],cross_activity_effects={'A7':'ApplyFuture.Error success is separate from FSM response, which can itself be an application error.'})\nB('b_campaign','A2','main candidate loop and one RPC goroutine per voter','one election response channel per campaign and proposed term','follower timeout or TimeoutNow',['s_election','s_campaign','s_timeout'],consumes_fact_ids=['f_vote'],produces_fact_ids=['f_authority'],implementation_guards=['Follower requires local voter membership to campaign normally. electSelf sends only to voters; self vote is persisted.'],writes=['Optional prevote precedes durable term increment and real election; counts grants against voter majority.'],important_branches=['Pre-vote unsupported by remote can count as pre-grant but still requires real election; transfer bypasses prevote; higher response term falls back to follower; timeout creates new campaign channel.'],existing_protections=['Late replies remain on their original campaign channel.'])\nB('b_vote','A2','receiving Raft RPC owner','candidate identity/address and requested term, local latest membership and last entry','RequestVote or RequestPreVote',['s_vote','s_campaign','i_store'],produces_fact_ids=['f_vote'],implementation_guards=['Known other leader rejects except transfer; known candidate must belong and be voter; lower term rejected; log recency checked for new vote.'],durable_effects=['Real vote persists term and candidate before granting; currentTerm persisted before memory update.'],important_branches=['Duplicate real vote for same stored candidate can be granted; different candidate rejected; prevote does not persist vote or change current term; old protocol omits identity checks.'],unknowns=['Crash/error between separate stable term and candidate writes requires a specific storage fault contract.'])\nB('b_leadership','A2','main leader loop','one leadership tenure, captured worker state and inflight futures','entry to leader state, RPC transition, lease failure, stepDown or removal',['s_leader','s_loop','s_lease','s_append','s_transfer','s_timeout'],consumes_fact_ids=['f_authority'],writes=['Creates fresh commitment and workers; dispatches current-term no-op; clears leadership-specific state on exit.'],external_effects=['Fails outstanding inflight and verify futures with ErrLeadershipLost; closes worker stop channels.'],existing_protections=['Lease checks only voters; committed local removal causes shutdown or follower transition; transfer blocks new writes and attempts target catch-up before TimeoutNow.'],cross_activity_effects={'A1':'New tenure must rebuild match support and commit its current-term entry before advancing.','A7':'Leadership loss does not prove an inflight write will never be committed later.'})\nB('b_membership','A4','main loop, startup log scan and commitment mutex','latest versus committed configuration indexes','configuration API or received/replayed configuration entry',['s_config','s_leader','s_dispatch','s_append','s_start','s_loop'],implementation_guards=['One uncommitted configuration at a time and current-term commit required before leader admits next change; checks unique nonempty IDs/addresses and at least one voter; optional prevIndex checks base.'],writes=['Latest configuration takes effect after append; commitment switches voter set; replication includes nonvoters; commit records configuration and may remove local leader.'],cross_activity_effects={'A1':'Voter set determines commitment aggregation; all participants still receive replication.','A2':'Latest membership determines campaign targets and quorum, while snapshot/log reconstruct it.'},important_branches=['Truncation can revert latest to committed. AddVoter directly creates Voter, not staging; old membership proposal is not treated as current API behavior.'])\nB('b_recovery','A3','NewRaft constructor and snapshot receiver with FSM worker','saved term, snapshot index/term/configuration and remaining suffix','startup or InstallSnapshot',['s_start','s_install','s_fsm','s_bootstrap'],produces_fact_ids=['f_installed'],writes=['Startup initializes follower, reloads term/last log, restores newest usable snapshot and scans later configuration entries.'],durable_effects=['InstallSnapshot finalizes sink before FSM restore; only then updates snapshot/applied/configuration metadata and returns success.'],important_branches=['Lower-term snapshot rejected; copy/size/close/restore failure fails response; startup can explicitly skip FSM restoration; compaction failure is logged after install.'],cross_activity_effects={'A1':'Installed snapshot success can produce match support at snapshot index.','A2':'Reconstructed log/snapshot identity feeds vote recency and eligibility.'})\nB('b_snapshot','A6','snapshot worker, main configuration owner and FSM worker','FSM snapshot index/term with committed configuration','takeSnapshot',['s_snapshot','s_fsm'],consumes_fact_ids=['f_applied'],durable_effects=['Persist and close snapshot before recording last snapshot and compacting.'],implementation_guards=['Refuses snapshot if FSM snapshot index precedes committed configuration index.'],cross_activity_effects={'A3':'Produces stored state and membership metadata consumed during startup or remote installation.'})\nB('b_restore','A3','leader main loop, FSM worker and API caller','explicit disaster-recovery operation with current membership','Restore API',['s_restore','i_restore'],writes=['Aborts inflight futures; creates snapshot at max(current index, supplied index)+1 using current term/configuration; restores FSM; advances local last log/applied/snapshot.'],important_branches=['Outstanding configuration prevents restore; API waits for subsequent no-op replication before success.'],cross_activity_effects={'A1':'Intentional log hole forces snapshot fallback during subsequent replication.'},unknowns=['Public restore call body read at api.go:1056-1099; this map limits normative conclusions to its documented disaster-recovery scope.'])\nB('b_contact','A2','independent per-peer heartbeat goroutine','captured replication term and peer, shared verification notify map','timer or forced notify',['s_heartbeat','s_notify','s_match','s_replicate'],produces_fact_ids=['f_verify_ack'],writes=['On successful transport call records last contact and calls notifyAll(resp.Success).'],important_branches=['Heartbeat transport error backs off; heartbeat branch does not compare response term; normal append and snapshot paths can also notify waiting futures.'],existing_protections=['False notification stops a pending verify tally early; heartbeat worker stops when its stop channel closes.'],unknowns=['Whether delayed or nonvoter acknowledgements can cause an externally false verification requires a same-history discriminator.'])\nB('b_verify','A2','leader main loop, replication notify owner and verifyFuture mutex','one verifyFuture with voter-derived quorum size','VerifyLeader registration, acknowledgement tally and verifyCh consumption',['i_verify','s_verify','s_future','s_notify','s_loop','s_lease'],consumes_fact_ids=['f_verify_ack'],produces_fact_ids=['f_verified'],writes=['Starts tally at one self vote, registers request on every replState entry, increments tally for true notifications.'],important_branches=['Single-voter threshold succeeds immediately; first false notification returns request early; main loop succeeds on tally reaching threshold or steps down otherwise.'],existing_protections=['notifyAll clears per-worker registrations; vote disables further notifications after threshold/negative result; cleanup removes registrations.'],unknowns=['No suffrage filter observed in registration or notifyAll; applicability of voter eligibility to this authority check needs explicit derivation from VerifyLeader contract.'])\nfacts=[]\ndef F(i,m,ident,ctx,rep,dur,rec,ss,**kw):\n d=dict(id=i,meaning=m,identity=ident,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=ss);d.update(kw);facts.append(d)\nF('f_append_ok','Receiver accepted this AppendEntries under its term and prefix checks; empty heartbeat success asserts no persisted prefix.',{'request':'AppendEntries request and its transport response'},'request term and supplied prefix/entries',['AppendEntriesResponse.Success'],'Entries stored before success when new entries exist.','Later log/snapshot reconstruction, not response replay.',['s_append'])\nF('f_match','Captured commitment object has recorded a voter ID as matched through an index after local store success or successful replication handling.',{'owner':'commitment object','participant':'ServerID','prefix':'match index'},'one leadership tenure and current voter map',['commitment.matchIndexes'],'Volatile accounting; underlying store durability depends on backend.','Reset each leadership; rebuild from replies and local storage.',['s_commit','s_dispatch','s_match','s_replicate'],reinterpreters=['b_membership'],invalidators=['b_leadership'])\nF('f_commit','This leadership commitment object advanced its index using its current voter match order statistic and current-term startIndex threshold.',{'owner':'commitment object','index':'commitIndex'},'same tenure, latest voter set',['commitment.commitIndex','commitCh notification'],'Volatile decision index over persisted/reported prefixes.','New leader rebuilds support and commits current-term entry; follower consumes leader commit.',['s_commit','s_loop','s_append'],invalidators=['b_leadership'])\nF('f_applied','FSM command callback has returned for the given log; originating future is completed with callback response.',{'log':'index and term','operation':'optional logFuture'},'FSM worker ordered consumption',['future.response','future.respond(nil)'],'Depends on application FSM and snapshots.','FSM restoration from snapshot, then subsequent committed log processing.',['s_fsm','i_future'],unknowns=['Application-specific durability and semantics are injected, not established here.'])\nF('f_vote','A real RequestVote grant was returned or self-vote enqueued after stored vote checks/writes for the campaign.',{'candidate':'candidate address bytes','term':'requested term','voter':'RPC target ServerID'},'real election; not a pre-vote promise',['RequestVoteResponse.Granted','lastVoteTerm','lastVoteCand'],'Stored vote precedes new grant; individual stable operations are separate.','Duplicate checks read stable term and candidate.',['s_vote','s_campaign'])\nF('f_authority','Local candidate counted enough grants for its voter-derived threshold and changed local role to Leader.',{'node':'localID','campaign':'response channel and current term'},'local campaign result, not an eternal claim of leadership',['RaftState Leader','leader address/ID'],'Role is volatile.','Starts as follower and must reacquire role.',['s_election','s_campaign'],invalidators=['b_leadership','b_append'])\nF('f_installed','Receiver finalized snapshot storage, completed FSM restore, updated snapshot and configuration metadata, and returned install success.',{'snapshot':'LastLogIndex and LastLogTerm','request':'InstallSnapshot RPC'},'accepted request term and supplied snapshot configuration',['InstallSnapshotResponse.Success'],'Snapshot sink finalized before response.','Constructor can load snapshot metadata and restore FSM.',['s_install','s_start'])\nF('f_verify_ack','A replication worker delivered a boolean notification to each verifyFuture currently in its notify map; true records response success, without a suffrage check at delivery.',{'registration':'verifyFuture pointer in worker notify map','participant':'followerReplication peer'},'captured worker term; request registration and RPC production can occur at different times',['notifyAll(bool)','verifyFuture.vote(bool)'],'Volatile.','Not reconstructed; pending verification fails on leader exit.',['s_notify','s_heartbeat','s_match','s_replicate'],unknowns=['Request/reply-to-registration temporal relation and participant eligibility need a controlled check.'])\nF('f_verified','Main leader loop returned nil for a verifyFuture whose tally reached its stored threshold, or single-voter shortcut returned nil.',{'operation':'verifyFuture pointer'},'local leadership loop, voter-derived threshold and accepted boolean notifications',['verifyFuture.Error() returns nil'],'No durable record.','No replay.',['s_verify','s_future','s_loop','i_verify'],unknowns=['This observed condition alone does not establish the API promise that authority remains valid.'])\nroles=json.load(open('../research.json'))['activity_roles']\nactivities=[]\nfor a,role in roles.items():\n bs=[b for b in beh if b['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=role['relation'],realization_summary='; '.join(b['execution_owner']+' handles '+b['trigger'] for b in bs),entry_points=[b['trigger'] for b in bs],source_ids=sorted(set(s for b in bs for s in b['source_ids']))))\ndef path(ex,b,f,s):return dict(explanation=ex,behavior_ids=b,fact_ids=f,source_ids=s)\nover=dict(status='usable',rationale='Representative command formation, real election production, tenure replacement, membership activation, recovery and completion are connected through read producers and consumers. This is a navigation basis, not proof of correctness or complete backend coverage.',\n formation=path('ApplyLog enqueues a future; leader assigns term/index and stores locally before reporting its match. Per-peer workers send stored entries with a previous index/term; receivers reject stale terms or mismatched prefixes and store new suffixes before success. Ordinary and pipelined success advance the captured commitment object; snapshot install is a separate support producer. Only IDs in its voter map count. The majority order statistic must reach the first index of this leader term. commitCh makes the main loop record commit and enqueue ordered logs to the FSM; the FSM finishes command futures after actual callbacks. Subsequent append requests carry LeaderCommitIndex to followers. Enqueue, persistence, quorum recording, FSM enqueue and public completion remain distinct.', ['b_apply','b_dispatch','b_append','b_replication','b_commit','b_consume'],['f_append_ok','f_match','f_commit','f_applied'],['s_apply','s_dispatch','s_append','s_replicate','s_pipeline','s_commit','s_loop','s_fsm']),\n context=path('A voting follower times out into a campaign; optional pre-vote only gates the real election. electSelf persists the new term and self-vote and requests one response from each other configured voter. Real vote receivers check membership, known leader, term, previous vote and log recency; accepted grants produce a local majority transition to Leader. Each campaign owns its response channel. Leadership constructs new commitment/worker state and appends a no-op. Higher-term regular replication responses signal stepDown; incoming nonstale append and higher-term voting requests can change role. Lease failure and committed removal also end tenure. Transfer blocks writes, catches up a target and invokes TimeoutNow. Startup reloads term, snapshot and configuration suffix as follower. Fast-path heartbeat callbacks share append handling; their concurrency deserves separate deeper review.', ['b_campaign','b_vote','b_leadership','b_membership','b_recovery','b_contact'],['f_vote','f_authority','f_installed'],['s_election','s_campaign','s_vote','s_leader','s_lease','s_transfer','s_timeout','s_start','s_fastpath']),\n connection=path('Persisted logs and snapshot history survive role changes and constrain vote recency, while volatile match support is tenure-specific. Old workers retain their old commitment pointer; cleanup closes them and clears the main-loop state. A new leader rebuilds support and needs a current-term entry before committing inherited history. Latest membership governs votes and match eligibility, changes on configuration append, and can revert on suffix truncation; admitted changes wait for a stable configuration and current-term commit. Already enqueued committed FSM work is separate from remaining inflight futures, which fail on leadership loss without promising rollback. Snapshots bind an applied prefix to committed membership. Explicit disaster Restore is a documented exceptional authority operation. VerifyLeader uses a separate acknowledgement tally: its threshold is voter-derived, but registration spans all replication peers; this is an unresolved authority-support relationship rather than log-commit support.', ['b_leadership','b_dispatch','b_replication','b_membership','b_recovery','b_snapshot','b_restore','b_verify','b_contact'],['f_match','f_commit','f_authority','f_applied','f_verify_ack','f_verified'],['s_leader','s_commit','s_dispatch','s_append','s_snapshot','s_restore','i_restore','s_verify','s_notify','i_apply']),\n core_gaps=[],open_details=['Concrete transport reply identity and pipeline error guarantees beyond the inspected interface and decoder.','StableStore partial-write/crash contracts and concrete backend durability.','Fast-path heartbeat races with slow main-loop storage and context updates.','Forced RecoverCluster implementation, detailed snapshot compaction and legacy protocol combinations.','VerifyLeader eligibility and freshness require a discriminating legal history; no execution evidence exists.'])\nmapobj=dict(version=1,target_profile=dict(system_boundary='Captured HashiCorp Raft Go library, internal state loops and injected Transport, LogStore, StableStore, SnapshotStore and FSM interfaces. Concrete deployments and application FSM semantics are outside this initial map.',protocol_contexts=['current term and campaign channel','leadership-specific commitment and replication workers','latest/committed configuration indexes','log index/term and snapshot prefix'],external_interfaces=['ApplyLog','VerifyLeader','membership APIs','BootstrapCluster','Restore','Transport RPCs'],ownership=['Main Raft loop owns role-dependent protocol handling; replication and heartbeat workers report support; commitment mutex aggregates; FSM and snapshot workers consume committed work.','NetworkTransport can invoke heartbeat callback outside main-loop dispatch.'],selection_injection=['NewRaft receives transport, stores and FSM; this does not externalize unread in-repository implementations.'],variants=['optional prevote','pipelined replication','batch FSM','legacy protocol configuration encoding','explicit startup snapshot-restore bypass'],source_ids=['s_start','i_transport','s_fastpath','s_fsm'],unknowns=['Concrete durable backend and deployment fault assumptions have not been selected.']),activities=activities,behaviors=beh,facts=facts,core_overview=over,surfaces=[dict(entry_point='VerifyLeader / verifyLeader / notifyAll',disposition='mapped',behavior_ids=['b_verify','b_contact'],reason='Compare voter threshold against registration and delivery from nonvoter replication workers. Acknowledgement is not independently established valid authority.',source_ids=['s_verify','s_notify','s_future','i_verify','i_suffrage'],high_consequence=True),dict(entry_point='NetworkTransport heartbeat fast-path',disposition='deferred',reason='Callback concurrency and heartbeat response-term handling may affect context loss while ordinary replication is blocked; examine after the selected eligibility discriminator.',source_ids=['s_fastpath','s_heartbeat','s_rpc'],high_consequence=True),dict(entry_point='persistVote stable writes',disposition='deferred',reason='Separate term/candidate writes need concrete failure and recovery semantics before deriving a crash-safety proposition.',source_ids=['s_campaign','i_store'],high_consequence=True),dict(entry_point='RecoverCluster',disposition='UNCLASSIFIED_PROTOCOL_RESPONSIBILITY',reason='Forced-recovery entry point located but implementation not yet traced; exceptional recovery is outside the ordinary operation backbone.',source_ids=[],high_consequence=True)])\nPath('audit-map.json').write_text(json.dumps(mapobj,indent=2)+'\\\\n')\nq=dict(question='Can a nonvoter replication acknowledgement be consumed as sufficient support for a successful VerifyLeader authority check when no remote voter supports that check?',importance='VerifyLeader is documented as preventing stale FSM reads after leadership loss. If nonvoter support can substitute for voting authority, successful verification may be weaker than its public contract. This does not yet establish stale application output or conflicting committed logs.',source_ids=['i_verify','i_suffrage','s_verify','s_notify','s_future','s_loop','s_lease','s_leader','s_heartbeat'],participants=['local leader','remote voters','remote nonvoter'],objects=['verifyFuture','followerReplication.notify','latest configuration'],contexts=['Stable mixed voter/nonvoter membership in a single leadership tenure','per-operation verification registration and subsequent public completion'],event_paths=['VerifyLeader -> verifyLeader -> every replState.notify -> heartbeat/replication notifyAll -> verifyFuture.vote -> leaderLoop -> future.Error'],activity_classes=['A2'],behavior_ids=['b_contact','b_verify'],fact_ids=['f_verify_ack'],supporting_behavior_ids={'b_membership':'Replication includes nonvoters while voter membership determines quorum.','b_leadership':'Lease and role exit can prevent or invalidate success and must remain enabled in a real history.','b_campaign':'A legal elected prefix is needed before any authority-loss history.','b_append':'Actual receiver behavior determines whether nonvoter acknowledgement is produced.'},obligation_relation_kind='consumption',counterevidence=['checkLeaderLease counts only voters and can cause stepdown.','Negative acknowledgement can terminate verification early; normal replication can signal stale-term stepDown.','Log commitment filters voter IDs and is not directly affected by this tally.','A successful check before a competing election does not alone show lost authority or stale reads.'],unknowns=['Applicable requirement: derive authority-check eligibility from public VerifyLeader promise without equating it to log commitment.','Actual producer: run nonvoter receiver and correlate its real response with verification consumption.','Initial prefix: obtain a real elected leader and installed stable mixed membership.','Same-execution history: control partitions and finite delays while retaining lease, negative responses and regular replication protection.','Observed endpoint: measure the selected public future and, for any stronger stale-read claim, a competing authority or read history.'],priority=3,trigger_rationale='Source registration spans all replState entries and notifyAll/vote carry no suffrage check; quorumSize and independent lease path count only Voter entries. This is a concrete producer/consumer eligibility mismatch to investigate, not a proved violation.',disposition='concrete_suspicion',preferred_check='controlled_schedule')\nsubmission=dict(action='continue',rationale='Initial sourced overview now connects both core relationships. Select verification eligibility as the next discriminator because an actual acknowledgement producer and public consumer are located, voter-only protections are known, and mixed membership can be produced through public APIs. Compared with heartbeat concurrency (higher scheduling ambiguity) and partial stable-write recovery (unselected backend fault contract), this direction has a more direct observable endpoint. First establish a local real-producer comparison and derive a conditional obligation; retain a separate gap for actual authority loss. No formal evidence or overall correctness conclusion is claimed.',sources=sources,map_path='audit-map.json',question=q)\nPath('submission.json').write_text(json.dumps(submission,indent=2)+'\\\\n')\nprint('Wrote audit-map.json and submission.json')\ntry:\n import jsonschema\n jsonschema.validate(mapobj,json.load(open('../product-schemas.json'))['ConsensusAuditSpec'])\n jsonschema.validate(submission,json.load(open('../native-submission.schema.json')))\n print('Both products pass local JSON Schema validation')\nexcept ImportError: print('jsonschema module unavailable; JSON serialization completed')\nPY\npython3 build_submission.py\"","aggregated_output":"Wrote audit-map.json and submission.json\nBoth products pass local JSON Schema validation\n","exit_code":0,"status":"completed"}}
