": 35,\n      \"experiments\": 7,\n      \"model_checks\": 6,\n      \"audit_units\": 3,\n      \"semantic_reviews\": 6,\n      \"revisions\": 4,\n      \"reachability_checks\": 3\n    },\n    \"remaining_seconds\": 1578.071596587999,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"model_execution\": false,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  }\n}\n{\n  \"$defs\": {\n    \"Comparison\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"field\": {\n          \"title\": \"Field\",\n          \"type\": \"string\"\n        },\n        \"op\": {\n          \"default\": \"eq\",\n          \"enum\": [\n            \"eq\",\n            \"ne\"\n          ],\n          \"title\": \"Op\",\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Value\"\n        },\n        \"reference\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Reference\"\n        }\n      },\n      \"required\": [\n        \"field\"\n      ],\n      \"title\": \"Comparison\",\n      \"type\": \"object\"\n    },\n    \"EventMonitor\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"checker_id\": {\n          \"title\": \"Checker Id\",\n          \"type\": \"string\"\n        },\n        \"event\": {\n          \"title\": \"Event\",\n          \"type\": \"string\"\n      