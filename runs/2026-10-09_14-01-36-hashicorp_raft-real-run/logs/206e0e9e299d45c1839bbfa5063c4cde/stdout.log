erials(engine, references, issues=None, paths=None):\n590:    existing = {m.id:m for m in state.materials}\n602:        material = Material(id=ref.id,file=ref.file,start_line=ref.start_line,end_line=ref.end_line,\n608:                paths=[paths[index] if paths else '/sources/'+str(index)],message=message,\n741:        if not engine.config.allow_agent_materials:\n748:            if not any(m.id == pack_id for m in state.materials):\n749:                state.materials.append(Material(id=pack_id, file='protocol:' + engine.config.protocol,\n","exit_code":0,"status":"completed"}}
