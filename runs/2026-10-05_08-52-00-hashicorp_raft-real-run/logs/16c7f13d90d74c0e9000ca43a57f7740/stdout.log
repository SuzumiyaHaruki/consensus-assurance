items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Uncertainties\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"description\",\n    \"claim_id\",\n    \"binding_ids\",\n    \"harness\",\n    \"monitors\",\n    \"observable_properties\"\n  ],\n  \"title\": \"DirectCheckPlan\",\n  \"type\": \"object\"\n}\n['Comparison', 'EventMonitor', 'EventRequirement', 'Grounding', 'Harness', 'ObservableProperty']\nHarness {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"execution_package\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Optional single local Go package or Rust crate directory; the controller fixes the effective package at acceptance\",\n      \"title\": \"Execution Package\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Additional generated files with relative destinations and fixed source text\",\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    },\n    \"kind\": {\n      \"description\": \"Harness kind advertised by the configured execution backend\",\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"source\": {\n      \"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\",\n      \"minLength\": 1,\n      \"title\": \"Source\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"semantic_changes\": {\n      \"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Semantic Changes\",\n      \"type\": \"array\"\n    },\n    \"prerequisites\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventRequirement\"\n      },\n      \"title\": \"Prerequisites\",\n      \"type\": \"array\"\n    },\n    \"legality\": {\n      \"$ref\": \"#/$defs/Grounding\",\n      \"default\": {\n        \"source_ids\": [],\n        \"expectation_ids\": [],\n        \"binding_ids\": [],\n        \"derivation\": \"\",\n        \"applicability\": \"\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      }\n    }\n  },\n  \"required\": [\n    \"kind\",\n    \"source\",\n    \"description\",\n    \"semantic_changes\"\n  ],\n  \"title\": \"Harness\",\n  \"type\": \"object\"\n}\nObservableProperty {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"checker_id\": {\n      \"title\": \"Checker Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"default\": \"event_assertion\",\n      \"enum\": [\n        \"event_assertion\",\n        \"event_implication\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"trigger\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"assertion\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"antecedent\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"identity_fields\": {\n      \"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Identity Fields\",\n      \"type\": \"array\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"checker_id\",\n    \"trigger\",\n    \"assertion\",\n    \"description\"\n  ],\n  \"title\": \"ObservableProperty\",\n  \"type\": \"object\"\n}\nComparison {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"field\": {\n      \"title\": \"Field\",\n      \"type\": \"string\"\n    },\n    \"op\": {\n      \"default\": \"eq\",\n      \"enum\": [\n        \"eq\",\n        \"ne\"\n      ],\n      \"title\": \"Op\",\n      \"type\": \"string\"\n    },\n    \"value\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"boolean\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Value\"\n    },\n    \"reference\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Reference\"\n    }\n  },\n  \"required\": [\n    \"field\"\n  ],\n  \"title\": \"Comparison\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
