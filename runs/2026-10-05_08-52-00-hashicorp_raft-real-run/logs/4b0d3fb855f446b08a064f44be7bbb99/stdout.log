{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '274,307p' ../agent-source/future.go; sed -n '879,908p' ../agent-source/api.go; grep -n 'VerifyLeader\\\\|verifyLeader\\\\|verifyFuture' ../agent-source/*test.go; sed -n '1104,1202p' ../agent-source/raft.go; sed -n '2210,2245p' ../agent-source/raft.go; sed -n '185,285p' ../agent-source/configuration.go\"","aggregated_output":"func (v *verifyFuture) vote(leader bool) {\n\tv.voteLock.Lock()\n\tdefer v.voteLock.Unlock()\n\n\t// Guard against having notified already\n\tif v.notifyCh == nil {\n\t\treturn\n\t}\n\n\tif leader {\n\t\tv.votes++\n\t\tif v.votes >= v.quorumSize {\n\t\t\tv.notifyCh <- v\n\t\t\tv.notifyCh = nil\n\t\t}\n\t} else {\n\t\tv.notifyCh <- v\n\t\tv.notifyCh = nil\n\t}\n}\n\n// appendFuture is used for waiting on a pipelined append\n// entries RPC.\ntype appendFuture struct {\n\tdeferError\n\tstart time.Time\n\targs  *AppendEntriesRequest\n\tresp  *AppendEntriesResponse\n}\n\nfunc (a *appendFuture) Start() time.Time {\n\treturn a.start\n}\n\n\n// VerifyLeader is used to ensure this peer is still the leader. It may be used\n// to prevent returning stale data from the FSM after the peer has lost\n// leadership.\nfunc (r *Raft) VerifyLeader() Future {\n\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n\tverifyFuture := &verifyFuture{}\n\tverifyFuture.init()\n\tselect {\n\tcase <-r.shutdownCh:\n\t\treturn errorFuture{ErrRaftShutdown}\n\tcase r.verifyCh <- verifyFuture:\n\t\treturn verifyFuture\n\t}\n}\n\n// GetConfiguration returns the latest configuration. This may not yet be\n// committed. The main loop can access this directly.\nfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n\tconfigReq := &configurationsFuture{}\n\tconfigReq.init()\n\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n\tconfigReq.respond(nil)\n\treturn configReq\n}\n\n// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n//\n// Deprecated: Use AddVoter/AddNonvoter instead.\nfunc (r *Raft) AddPeer(peer ServerAddress) Future {\n../agent-source/raft_test.go:40:\t// TODO (slackpad) - Barrier, VerifyLeader, and GetConfiguration can get\n../agent-source/raft_test.go:578:\t\t\tleader.VerifyLeader()\n../agent-source/raft_test.go:1866:func TestRaft_VerifyLeader(t *testing.T) {\n../agent-source/raft_test.go:1875:\tverify := leader.VerifyLeader()\n../agent-source/raft_test.go:1883:func TestRaft_VerifyLeader_Single(t *testing.T) {\n../agent-source/raft_test.go:1892:\tverify := leader.VerifyLeader()\n../agent-source/raft_test.go:1900:func TestRaft_VerifyLeader_Fail(t *testing.T) {\n../agent-source/raft_test.go:1928:\tverify := leader.VerifyLeader()\n../agent-source/raft_test.go:1940:func TestRaft_VerifyLeader_PartialConnect(t *testing.T) {\n../agent-source/raft_test.go:1966:\tverify := leader.VerifyLeader()\nfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n\n\t// Sanity check the version.\n\tversion := meta.Version\n\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n\t}\n\n\t// We don't support snapshots while there's a config change\n\t// outstanding since the snapshot doesn't have a means to\n\t// represent this state.\n\tcommittedIndex := r.configurations.committedIndex\n\tlatestIndex := r.configurations.latestIndex\n\tif committedIndex != latestIndex {\n\t\treturn fmt.Errorf(\"cannot restore snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n\t\t\tlatestIndex, committedIndex)\n\t}\n\n\t// Cancel any inflight requests.\n\tfor {\n\t\te := r.leaderState.inflight.Front()\n\t\tif e == nil {\n\t\t\tbreak\n\t\t}\n\t\te.Value.(*logFuture).respond(ErrAbortedByRestore)\n\t\tr.leaderState.inflight.Remove(e)\n\t}\n\n\t// We will overwrite the snapshot metadata with the current term,\n\t// an index that's greater than the current index, or the last\n\t// index in the snapshot. It's important that we leave a hole in\n\t// the index so we know there's nothing in the Raft log there and\n\t// replication will fault and send the snapshot.\n\tterm := r.getCurrentTerm()\n\tlastIndex := r.getLastIndex()\n\tif meta.Index > lastIndex {\n\t\tlastIndex = meta.Index\n\t}\n\tlastIndex++\n\n\t// Dump the snapshot. Note that we use the latest configuration,\n\t// not the one that came with the snapshot.\n\tsink, err := r.snapshots.Create(version, lastIndex, term,\n\t\tr.configurations.latest, r.configurations.latestIndex, r.trans)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n\t}\n\tn, err := io.Copy(sink, reader)\n\tif err != nil {\n\t\tsink.Cancel()\n\t\treturn fmt.Errorf(\"failed to write snapshot: %v\", err)\n\t}\n\tif n != meta.Size {\n\t\tsink.Cancel()\n\t\treturn fmt.Errorf(\"failed to write snapshot, size didn't match (%d != %d)\", n, meta.Size)\n\t}\n\tif err := sink.Close(); err != nil {\n\t\treturn fmt.Errorf(\"failed to close snapshot: %v\", err)\n\t}\n\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n\n\t// Restore the snapshot into the FSM. If this fails we are in a\n\t// bad state so we panic to take ourselves out.\n\tfsm := &restoreFuture{ID: sink.ID()}\n\tfsm.ShutdownCh = r.shutdownCh\n\tfsm.init()\n\tselect {\n\tcase r.fsmMutateCh <- fsm:\n\tcase <-r.shutdownCh:\n\t\treturn ErrRaftShutdown\n\t}\n\tif err := fsm.Error(); err != nil {\n\t\tpanic(fmt.Errorf(\"failed to restore snapshot: %v\", err))\n\t}\n\n\t// We set the last log so it looks like we've stored the empty\n\t// index we burned. The last applied is set because we made the\n\t// FSM take the snapshot state, and we store the last snapshot\n\t// in the stable store since we created a snapshot as part of\n\t// this process.\n\tr.setLastLog(lastIndex, term)\n\tr.setLastApplied(lastIndex)\n\tr.setLastSnapshot(lastIndex, term)\n\n\t// Remove old logs if r.logs is a MonotonicLogStore. Log any errors and continue.\n\tif logs, ok := r.logs.(MonotonicLogStore); ok && logs.IsMonotonic() {\n\t\tif err := r.removeOldLogs(); err != nil {\n\t\t\tr.logger.Error(\"failed to remove old logs\", \"error\", err)\n\t\t}\n\t}\n\n\tr.logger.Info(\"restored user snapshot\", \"index\", lastIndex)\n\treturn nil\n}\n\n// appendConfigurationEntry changes the configuration and adds a new\n// configuration entry to the log. This must only be called from the\n// main thread.\n\tr.setLeader(\"\", \"\")\n\tr.setState(Candidate)\n\tr.candidateFromLeadershipTransfer.Store(true)\n\trpc.Respond(&TimeoutNowResponse{}, nil)\n}\n\n// setLatestConfiguration stores the latest configuration and updates a copy of it.\nfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n\tr.configurations.latest = c\n\tr.configurations.latestIndex = i\n\tr.latestConfiguration.Store(c.Clone())\n}\n\n// setCommittedConfiguration stores the committed configuration.\nfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n\tr.configurations.committed = c\n\tr.configurations.committedIndex = i\n}\n\n// getLatestConfiguration reads the configuration from a copy of the main\n// configuration, which means it can be accessed independently from the main\n// loop.\nfunc (r *Raft) getLatestConfiguration() Configuration {\n\t// this switch catches the case where this is called without having set\n\t// a configuration previously.\n\tswitch c := r.latestConfiguration.Load().(type) {\n\tcase Configuration:\n\t\treturn c\n\tdefault:\n\t\treturn Configuration{}\n\t}\n}\nfunc inConfiguration(configuration Configuration, id ServerID) bool {\n\tfor _, server := range configuration.Servers {\n\t\tif server.ID == id {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// checkConfiguration tests a cluster membership configuration for common\n// errors.\nfunc checkConfiguration(configuration Configuration) error {\n\tidSet := make(map[ServerID]bool)\n\taddressSet := make(map[ServerAddress]bool)\n\tvar voters int\n\tfor _, server := range configuration.Servers {\n\t\tif server.ID == \"\" {\n\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n\t\t}\n\t\tif server.Address == \"\" {\n\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n\t\t}\n\t\tif idSet[server.ID] {\n\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n\t\t}\n\t\tidSet[server.ID] = true\n\t\tif addressSet[server.Address] {\n\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n\t\t}\n\t\taddressSet[server.Address] = true\n\t\tif server.Suffrage == Voter {\n\t\t\tvoters++\n\t\t}\n\t}\n\tif voters == 0 {\n\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n\t}\n\treturn nil\n}\n\n// nextConfiguration generates a new Configuration from the current one and a\n// configuration change request. It's split from appendConfigurationEntry so\n// that it can be unit tested easily.\nfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n\t}\n\n\tconfiguration := current.Clone()\n\tswitch change.command {\n\tcase AddVoter:\n\t\tnewServer := Server{\n\t\t\tSuffrage: Voter,\n\t\t\tID:       change.serverID,\n\t\t\tAddress:  change.serverAddress,\n\t\t}\n\t\tfound := false\n\t\tfor i, server := range configuration.Servers {\n\t\t\tif server.ID == change.serverID {\n\t\t\t\tif server.Suffrage == Voter {\n\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n\t\t\t\t} else {\n\t\t\t\t\tconfiguration.Servers[i] = newServer\n\t\t\t\t}\n\t\t\t\tfound = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n\t\t}\n\tcase AddNonvoter:\n\t\tnewServer := Server{\n\t\t\tSuffrage: Nonvoter,\n\t\t\tID:       change.serverID,\n\t\t\tAddress:  change.serverAddress,\n\t\t}\n\t\tfound := false\n\t\tfor i, server := range configuration.Servers {\n\t\t\tif server.ID == change.serverID {\n\t\t\t\tif server.Suffrage != Nonvoter {\n\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n\t\t\t\t} else {\n\t\t\t\t\tconfiguration.Servers[i] = newServer\n\t\t\t\t}\n\t\t\t\tfound = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif !found {\n\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n\t\t}\n\tcase DemoteVoter:\n\t\tfor i, server := range configuration.Servers {\n\t\t\tif server.ID == change.serverID {\n\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\tcase RemoveServer:\n\t\tfor i, server := range configuration.Servers {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nsrc('s-election','raft.go',285,440)\nsrc('s-follower','raft.go',135,259)\nsrc('s-leader','raft.go',455,580)\nsrc('s-repl-owners','raft.go',582,665)\nsrc('s-leader-loop','raft.go',667,963)\nsrc('s-verify','raft.go',965,988)\nsrc('s-lease','raft.go',1032,1095)\nsrc('s-votes','raft.go',1603,1810)\nsrc('s-election-producer','raft.go',1976,2150)\nsrc('s-append','raft.go',1440,1581)\nsrc('s-config-log','raft.go',1585,1600)\nsrc('s-dispatch','raft.go',1203,1290)\nsrc('s-process','raft.go',1292,1386)\nsrc('s-commit','commitment.go',11,104)\nsrc('s-replicate','replication.go',137,386)\nsrc('s-repl-result','replication.go',534,630)\nsrc('s-match','replication.go',646,670)\nsrc('s-heartbeat','replication.go',388,443)\nsrc('s-notify','replication.go',98,111)\nsrc('s-verify-vote','future.go',273,296)\nsrc('s-api-verify','api.go',879,894,'interface_statement')\nsrc('s-api-apply','api.go',803,881,'interface_statement')\nsrc('s-start','api.go',500,707)\nsrc('s-install','raft.go',1814,1954)\nsrc('s-snapshot','snapshot.go',125,250)\nsrc('s-fsm','fsm.go',14,267)\nsrc('s-config','configuration.go',8,81,'interface_statement')\nsrc('s-config-validate','configuration.go',194,285)\nsrc('s-transport','transport.go',29,138,'interface_statement')\nsrc('s-logstore','log.go',108,144,'interface_statement')\nsrc('s-restore','raft.go',1104,1201)\nB=[]\ndef beh(i,a,owner,ctx,trig,ss,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss);d.update(kw);B.append(d)\nbeh('b-election','A2','Raft main loop; per-peer vote RPC goroutines','Latest voter configuration and one election attempt','Follower contact timeout starts candidacy; pre-vote or transfer bypass precedes electSelf', ['s-election','s-follower','s-votes','s-election-producer'],implementation_guards=['Only configured voters are solicited; each attempt has its own reply channel.','Vote recipient checks candidate eligibility, known leader, term, log freshness and persisted prior vote.','A higher returned term ends candidacy; election timeout creates a new attempt.'],writes=['Persist current term and vote before including self support; majority of grants sets Leader.'],async_boundaries=['Replies to abandoned election channels are not consumed by new attempts.'],cross_activity_effects={'A1':'Acquired leadership permits entry creation but fresh commitment still requires a current-term entry.'},unknowns=['StableStore partial write/crash semantics for the separately persisted vote term and candidate remain unread.'])\nbeh('b-leader-context','A2','Raft main loop','One acquired leader term','runLeader creates fresh commitment, inflight list, replication map and channels; exit cleans up', ['s-leader','s-repl-owners','s-leader-loop','s-lease'],writes=['First no-op establishes startIndex entry.','Cleanup stops old workers, fails remaining inflight and verify futures, and clears active leader state.'],important_branches=['New-term RPC or replication stale-term signal and failed voter lease can force follower state.','Old workers retain their original commitment and stepDown channels, not a new term tracker.'],cross_activity_effects={'A1':'Fresh per-term match accounting prevents old replication replies from qualifying new-term decisions.','A7':'Leadership loss errors leave uncertain command commitment, as documented by Apply.'})\nbeh('b-dispatch','A1','Raft main loop and per-peer replicators','Active leader term and current configuration','Apply admission or leader no-op/configuration dispatch', ['s-dispatch','s-repl-owners','s-replicate','s-repl-result','s-match'],writes=['Assign index and term, enqueue inflight, persist logs, then credit local match and notify replicators.','Successful append responses update nextIndex and report last sent entry to the captured commitment tracker.'],important_branches=['Local store error fails futures and sets Follower.','Rejection backs nextIndex down; missing retained logs switches to snapshot transfer; newer response term signals stepdown.','CommitTimeout sends ordinary replication even without new commands; separate heartbeats carry no commit index.'],produces_fact_ids=['f-match'],async_boundaries=['Network request/response and optional pipeline run outside main loop.'])\nbeh('b-commit','A1','commitment mutex; Raft main-loop commit channel consumer','One leader tracker and its latest voter set','match or setConfiguration recalculates majority index; notification wakes leader loop',['s-commit','s-leader-loop'],implementation_guards=['Only current voter IDs are recorded; match values increase monotonically.','Quorum index must reach startIndex before commitment advances.'],writes=['Set commitment index and notify; main loop updates Raft commit index and committed configuration, then processes inflight prefix.'],consumes_fact_ids=['f-match'],produces_fact_ids=['f-committed'],cross_activity_effects={'A5':'Committed inflight prefix is queued to FSM processing.','A2':'Committed removal of local voter triggers shutdown or follower transition.'})\nbeh('b-follower-append','A1','Raft RPC handler','Incoming leader term and local retained log/snapshot','AppendEntries through normal RPC or heartbeat dispatch',['s-append','s-config-log','s-process'],implementation_guards=['Reject old term; newer term or ordinary non-follower state transitions to follower.','Check previous index/term; delete conflicting suffix before storing replacement entries.'],writes=['Revert latest configuration to committed when truncating through latest configuration.','On success set commit index to min(leader commit index, local last index), update committed configuration and process prefix.'],produces_fact_ids=['f-committed'],cross_activity_effects={'A2':'Append request changes term/state and known leader before log matching.','A4':'Accepted configuration entries update latest/committed metadata.'},unknowns=['Whether producer backtracking and transport ordering always prevent follower commitment beyond the prefix established by this request.','After successful suffix deletion followed by StoreLogs error, cached last-log metadata is left unchanged; supported fault recovery remains unresolved.'])\nbeh('b-membership','A4','Raft main loop','Latest and committed configurations with their log indices','Stable configuration channel admits membership change; follower/new-start scan consumes configuration logs',['s-config','s-config-validate','s-dispatch','s-repl-owners','s-config-log'],implementation_guards=['Admission requires prior configuration committed and this leader current-term entry committed.','Configuration validation requires unique nonempty IDs/addresses and at least one voter; prevIndex guards stale caller updates.'],writes=['New latest configuration immediately changes commitment voter map and starts/stops replication; existing retained voter matches survive setConfiguration.'],cross_activity_effects={'A1':'Voter membership controls majority accounting.','A2':'Latest voters control election participation and lease quorum; nonvoters still receive replication.'})\nbeh('b-recovery','A3','Raft initialization or main RPC loop, FSM goroutine','Snapshot plus surviving log suffix','Startup restoration or follower InstallSnapshot',['s-start','s-install','s-replicate'],writes=['Startup restores term and last log, tries snapshots newest first, restores configuration, then scans suffix for configuration entries.','InstallSnapshot checks term/version/size, finalizes snapshot, waits for FSM restore, updates applied/snapshot indices and configuration, then compacts logs.'],cross_activity_effects={'A1':'Successful snapshot response credits sender match index.','A2':'Installed snapshot term can force follower state.','A6':'Monotonic stores remove old logs; other stores compact with trailing retention.'},unknowns=['Delayed same-term snapshots versus already applied state need further history analysis.'])\nbeh('b-snapshot','A6','Snapshot goroutine with main-loop configuration query and FSM snapshot callback','Applied FSM position and committed configuration','Periodic or user snapshot request',['s-snapshot','s-fsm'],implementation_guards=['Reject snapshot position earlier than committed configuration index; persist and close before updating stable snapshot metadata and compacting.'],writes=['Snapshot stores applied index/term and committed configuration; compaction retains configured trailing logs.'],cross_activity_effects={'A3':'Snapshots supply restart and lagging follower reconstruction.'})\nbeh('b-fsm','A5','Raft main loop queues work; runFSM serially invokes application','Ordered commit tuples and restore requests','processLogs of newly committed prefix; FSM mutation channel',['s-process','s-fsm','s-api-apply'],consumes_fact_ids=['f-committed'],writes=['Read each unapplied log, queue commands/barriers/configurations as applicable, and advance lastApplied after queueing.','FSM Apply/ApplyBatch returns responses before their futures complete; barriers are acknowledged in ordered FSM work.'],important_branches=['No-op logs need no FSM mutation.','Restore serially replaces FSM and local FSM indices.'],cross_activity_effects={'A7':'Apply completion is distinct from commit and from main-loop lastApplied queue position.'})\nbeh('b-verify','A2','Raft main loop, replication workers, verifyFuture vote mutex','One VerifyLeader future while node remains in leader loop','API submits future; first leader-loop visit calls verifyLeader',['s-api-verify','s-verify','s-verify-vote','s-notify','s-heartbeat','s-match','s-leader-loop','s-repl-owners','s-lease'],implementation_guards=['Threshold derives from voter-only quorumSize; initializes one self vote.','Future notification is emitted once; failure votes cause early stepdown and error; leader cleanup fails remaining futures.'],writes=['Registers future in every replication worker without checking suffrage.','Worker drains its notification set and supplies bool support; future counter contains no voter identity or eligibility field.','Second main-loop visit responds nil when votes reach threshold.'],produces_fact_ids=['f-verify-count'],consumes_fact_ids=['f-verify-count'],cross_activity_effects={'A7':'Successful future is exposed as leadership verification for avoiding stale FSM reads.'},unknowns=['Can nonvoter responses complete verification without fresh voter quorum support under a legal partition schedule before lease stepdown?','Does contract require voter quorum confirmation per call, or is stronger stale-read endpoint history necessary to attribute a failure?'])\nbeh('b-restore','A3','Leader main loop and FSM goroutine','Explicit user restore, stable configuration','User-provided snapshot restore request',['s-restore'],implementation_guards=['Reject unsupported version or outstanding configuration change; wait for FSM restore and panic on restore failure.'],writes=['Abort inflight commands; use current configuration and term with a newly burned higher index; set last log, applied and snapshot indices.'],cross_activity_effects={'A1':'Index gap forces future replication to transfer snapshot rather than replay old data.','A7':'Inflight commands fail with ErrAbortedByRestore.'})\nroles=json.load(open('../research.json'))['activity_roles']\nactivities=[]\nfor a,r in roles.items():\n bs=[b for b in B if b['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=r['relation'],realization_summary='; '.join(b['trigger'] for b in bs) if bs else 'Apply and VerifyLeader expose future-based completion and role errors; underlying callbacks are supplied by callers.',source_ids=sorted(set(x for b in bs for x in b['source_ids'])) if bs else ['s-api-apply','s-api-verify']))\nfacts=[dict(id='f-match',meaning='Tracker records the greatest reported replicated log index for each presently included voter.',identity={'tracker':'leader-term commitment instance','participant':'ServerID'},validity_context='Only voter IDs in this tracker configuration; reported persistence is inferred from local store completion or successful peer response.',representation=['commitment.matchIndexes'],durability='Volatile tracker; underlying peer logs are separately persisted.',recovery='Recreated with zero match indices on each leader term.',source_ids=['s-commit','s-dispatch','s-match']),dict(id='f-committed',meaning='Raft records a commit-index prefix for processing; this alone does not say that the FSM has applied it.',identity={'node':'Raft instance','prefix':'commit index'},validity_context='Leader majority calculation or follower accepted leader commit propagation in its term/log context.',representation=['raftState.commitIndex'],durability='Volatile index; log and snapshot retain history.',recovery='Startup restores snapshot applied position; subsequent consensus propagates commit knowledge.',source_ids=['s-commit','s-leader-loop','s-append','s-start']),dict(id='f-verify-count',meaning='Verification future has counted self and affirmative replication notifications up to its voter-derived numeric threshold.',identity={'operation':'verifyFuture pointer'},validity_context='One future registered while leader; counted notifications do not themselves retain peer suffrage or term.',representation=['verifyFuture.votes','verifyFuture.quorumSize','verifyFuture.notifyCh'],durability='Volatile only.',recovery='No recovery; leader exit fails pending tracked futures.',source_ids=['s-verify','s-notify','s-verify-vote','s-leader-loop'])]\nformation='Leader assigns term/index, stores locally and replicates to all configured peers. Successful append or snapshot responses report match indices to the leader-term tracker. Only configured voters contribute to its majority, and the majority index must reach the first current-term entry. The main loop consumes commit notifications, updates committed configuration and queues the committed prefix. Followers validate previous log context, repair conflicting suffixes, accept leader commit propagation and queue their prefix. runFSM serializes actual application and responds to local futures afterward; queue position alone is not completion.'\ncontext='Follower timeout can start a voter election. Optional pre-vote precedes durable term increment and persisted self vote. Requests are scoped to one election reply channel; recipient eligibility, freshness, leader and prior-vote checks constrain grants. Majority establishes leadership. Higher terms, failed voter lease, replication stale-term signal or committed local removal end authority. Leader exit stops workers and fails pending work; new leadership creates a fresh commitment object and no-op. Transfer catches up a selected peer then sends TimeoutNow; it bypasses pre-vote and temporarily prevents new leader client work.'\nconnection='Election log freshness preserves prior eligible history, while committing a new-term no-op establishes the new leader commitment boundary. Old election reply channels and old replication commitment objects remain separate from new attempts/terms. Latest logged configuration controls election and quorum membership before its commitment, but a further configuration requires prior configuration and current-term entry commitment. Conflicting follower suffix removal restores committed membership; snapshots restore configuration and applied prefix before suffix scanning or resumed participation. Already queued committed work remains FSM work across role change, while uncommitted leader futures become uncertain errors. VerifyLeader is a separate authority consumer using replication notifications; its voter-derived threshold and all-peer registration require eligibility investigation.'\npath=lambda e,bs,ss:dict(explanation=e,behavior_ids=bs,source_ids=ss)\nM=dict(version=1,target_profile=dict(system_boundary='Captured HashiCorp Raft Go implementation, including injected storage, transport and FSM interfaces and in-repository implementations; callers own deterministic FSM and external resource implementations.',protocol_contexts=['Term-scoped leader/follower/candidate roles','Latest and committed log configurations','Log indices, snapshot prefix and asynchronous FSM consumption'],external_interfaces=['Transport','LogStore','StableStore','SnapshotStore','FSM','Apply','VerifyLeader'],ownership=['Raft main goroutine owns role/configuration and dispatch; replication and FSM goroutines cross explicit channels.'],source_ids=['s-start','s-transport','s-fsm','s-logstore']),activities=activities,behaviors=B,facts=facts,core_overview=dict(formation=path(formation,['b-dispatch','b-commit','b-follower-append','b-fsm'],['s-dispatch','s-commit','s-replicate','s-append','s-process','s-fsm']),context=path(context,['b-election','b-leader-context'],['s-election','s-election-producer','s-votes','s-leader','s-leader-loop','s-lease']),connection=path(connection,['b-membership','b-recovery','b-verify'],['s-repl-owners','s-config-log','s-start','s-install','s-verify']),status='usable',core_gaps=[],open_details=['Transport-specific dispatch/order and cancellation contracts remain to be read before constructing schedules.','Storage partial failures and crash recovery atomicity remain unresolved.','Verification nonvoter eligibility is a sourced discrepancy, not an established violation.'],rationale='Both formation and authority paths and their old-work handling have been traced with support for configuration, persistence, recovery and application; deeper local premises remain explicit.'),surfaces=[dict(entry_point='Raft.verifyLeader',disposition='mapped',behavior_ids=['b-verify'],reason='Why does authority verification register nonvoters although threshold and lease use only voters?',source_ids=['s-verify','s-repl-owners','s-lease'],high_consequence=True),dict(entry_point='Raft.appendEntries',disposition='mapped',behavior_ids=['b-follower-append'],reason='Can commitment use an unverified local suffix, or does sender backtracking and ordered delivery exclude the history? Separately, what fault contract governs cached last-log metadata after a failed replacement write?',source_ids=['s-append','s-replicate'],high_consequence=True),dict(entry_point='Raft.persistVote',disposition='deferred',reason='What atomicity/recovery assumptions connect separately persisted vote term and candidate after an interrupted write?',source_ids=['s-election-producer'],high_consequence=True),dict(entry_point='Raft.installSnapshot',disposition='mapped',behavior_ids=['b-recovery'],reason='What producer and transport conditions prevent delayed snapshot restoration from replacing newer applied state?',source_ids=['s-install','s-replicate'],high_consequence=True)])\njson.dump(M,open('map.json','w'),indent=2)\nQ=dict(question='Can VerifyLeader return success based on nonvoter acknowledgements when eligible voters have not confirmed this authority?',importance='A false positive in the documented stale-read prevention API could allow a former leader to serve stale FSM state; actual stale-read consequence and legal overlap remain unproved.',source_ids=['s-api-verify','s-verify','s-notify','s-verify-vote','s-repl-owners','s-lease','s-config'],participants=['Leader','Voting replicas','Nonvoting replicas'],objects=['verifyFuture','followerReplication','Configuration'],contexts=['Stable mixed voter/nonvoter configuration','Partitioned leader before lease-induced stepdown'],event_paths=['VerifyLeader -> leaderLoop -> verifyLeader -> replication notifyAll -> verifyFuture.vote -> leaderLoop completion'],activity_classes=['A2'],behavior_ids=['b-verify'],fact_ids=['f-verify-count'],supporting_behavior_ids={'b-membership':'Establishes peer suffrage and starts replication to nonvoters.','b-leader-context':'Lease and stepdown cleanup may independently reject a verification before it completes.','b-election':'A later voter-majority election is needed to establish the stronger former-leader stale-read consequence.'},obligation_relation_kind='establishment',counterevidence=['quorumSize counts only voters.','checkLeaderLease also counts only voters and eventually steps down when their contact is lost.','Negative replication responses and leader cleanup can fail a pending future; successful counting alone has not been executed.'],unknowns=['Which applicable API or test expectation fixes voter-quorum responsibility for verification?','Can a legal transport schedule isolate voter responses while preserving nonvoter acknowledgements and the operation completion window?','Do existing verification tests or transport notification paths impose an additional eligibility restriction?'],trigger_rationale='Source shows all-peer registration with a voter-only threshold, unlike explicit suffrage filtering in commitment and lease. Read existing verification expectations and actual transport lifecycle before selecting a small eligibility check or stronger cluster history.',disposition='needs_specific_evidence',preferred_check='source_review')\nS=dict(action='continue',rationale='Establish the two core relationships and retain a sourced authority-eligibility question without assuming violation or inventing a history.',sources=sources,map_path='map.json',question=Q)\njson.dump(S,open('submission.json','w'),indent=2)\nPY\npython3 build_submission.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));p=subprocess.run(r['validation']['command']+['submission.json'],capture_output=True,text=True);print(p.stdout);print(p.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
