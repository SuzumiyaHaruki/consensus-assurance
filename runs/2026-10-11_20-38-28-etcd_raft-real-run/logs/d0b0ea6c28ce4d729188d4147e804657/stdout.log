\t}\n\treturn l.storage.Snapshot()\n}\n\nfunc (l *raftLog) firstIndex() uint64 {\n\tif i, ok := l.unstable.maybeFirstIndex(); ok {\n\t\treturn i\n","exit_code":0,"status":"completed"}}
