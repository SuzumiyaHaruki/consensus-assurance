{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-11_20-38-28-etcd_raft-real-run/draft && python3 - <<'EOF'\np='assurance_generated_test.go'\ns=open(p).read()\nold='''\t\tpending := []pb.Message{}\n\t\tfor i := 0; i < ticks; i++ {\n\t\t\tfor _, id := range []uint64{1, 2, 3} {\n\t\t\t\tnodes[id].tick()\n\t\t\t}\n\t\t\tpending = append(pending, leader.readMessages()...)\n\t\t\tpending = append(pending, f2.readMessages()...)\n\t\t\tpending = append(pending, f3.readMessages()...)\n\t\t\tpending = assurancePump(t, nodes, pending, 400)\n\t\t}'''\nnew='''\t\tpending := []pb.Message{}\n\t\tfor i := 0; i < ticks; i++ {\n\t\t\t// Tick each node and deliver its messages before ticking the next\n\t\t\t// one, so that a vote request reaches its peers before their own\n\t\t\t// timers fire. Every node is ticked once per round.\n\t\t\tfor _, id := range []uint64{1, 2, 3} {\n\t\t\t\tnodes[id].tick()\n\t\t\t\tpending = append(pending, nodes[id].readMessages()...)\n\t\t\t\tpending = assurancePump(t, nodes, pending, 400)\n\t\t\t}\n\t\t}'''\nassert old in s\ns=s.replace(old,new,1)\ns=s.replace('run(\\\"stepdown-false\\\", false, 300)','run(\\\"stepdown-false\\\", false, 80)').replace('run(\\\"stepdown-true\\\", true, 300)','run(\\\"stepdown-true\\\", true, 80)')\nopen(p,'w').write(s)\nprint('patched')\nEOF\ncp assurance_generated_test.go scratch/src/ && cd scratch/src && timeout 300 go test -json -count=1 -timeout=120s -run '\"'^TestAssurance'\"' . 2>&1 | python3 -c \\\"\nimport sys,json\nfor line in sys.stdin:\n    try: o=json.loads(line)\n    except Exception: continue\n    out=o.get('Output','')\n    if 'progress_window' in out or 'removal_applied' in out: print(out.rstrip().replace('CA_EVENT ',''))\n    elif o.get('Action') in ('pass','fail') and o.get('Test'): print(o.get('Action'), out.rstrip()[:300])\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
