{\n    \"type\": \"string\"\n   },\n   \"title\": \"Semantic Changes\",\n   \"type\": \"array\"\n  },\n  \"requirement\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Requirement\"\n  },\n  \"responsibility\": {\n   \"default\": \"\",\n   \"title\": \"Responsibility\",\n   \"type\": \"string\"\n  },\n  \"prerequisites\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/EventRequirement\"\n   },\n   \"title\": \"Prerequisites\",\n   \"type\": \"array\"\n  },\n  \"comparisons\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/EventComparison\"\n   },\n   \"title\": \"Comparisons\",\n   \"type\": \"array\"\n  },\n  \"knowledge\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/KnowledgeUse\"\n   },\n   \"title\": \"Knowledge\",\n   \"type\": \"array\"\n  },\n  \"previous_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Previous Id\"\n  },\n  \"revision_reason\": {\n   \"default\": \"\",\n   \"title\": \"Revision Reason\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"investigation_id\",\n  \"harness_path\",\n  \"source_ids\",\n  \"scope\",\n  \"prefix\"\n ],\n \"title\": \"ExperimentRequest\",\n \"type\": \"object\"\n}\n==================== Comparison\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"field\": {\n   \"title\": \"Field\",\n   \"type\": \"string\"\n  },\n  \"op\": {\n   \"default\": \"eq\",\n   \"enum\": [\n    \"eq\",\n    \"ne\"\n   ],\n   \"title\": \"Op\",\n   \"type\": \"string\"\n  },\n  \"value\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"integer\"\n    },\n    {\n     \"type\": \"boolean\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Value\"\n  },\n  \"reference\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Reference\"\n  }\n },\n \"required\": [\n  \"field\"\n ],\n \"title\": \"Comparison\",\n \"type\": \"object\"\n}\n==================== EventComparison\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"event\": {\n   \"title\": \"Event\",\n   \"type\": \"string\"\n  },\n  \"identity_fields\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Identity Fields\",\n   \"type\": \"array\"\n  },\n  \"admission_alias\": {\n   \"title\": \"Admission Alias\",\n   \"type\": \"string\"\n  },\n  \"assertion\": {\n   \"$ref\": \"#/$defs/Comparison\"\n  },\n  \"antecedent\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/Comparison\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"applicability_conditions\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/Comparison\"\n   },\n   \"title\": \"Applicability Conditions\",\n   \"type\": \"array\"\n  },\n  \"description\": {\n   \"default\": \"\",\n   \"title\": \"Description\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"event\",\n  \"identity_fields\",\n  \"admission_alias\",\n  \"assertion\"\n ],\n \"title\": \"EventComparison\",\n \"type\": \"object\"\n}\n==================== EventRequirement\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"alias\": {\n   \"title\": \"Alias\",\n   \"type\": \"string\"\n  },\n  \"event\": {\n   \"title\": \"Event\",\n   \"type\": \"string\"\n  },\n  \"conditions\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/Comparison\"\n   },\n   \"title\": \"Conditions\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"alias\",\n  \"event\"\n ],\n \"title\": \"EventRequirement\",\n \"type\": \"object\"\n}\n==================== CodeAnchor\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"source_ids\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Source Ids\",\n   \"type\": \"array\"\n  },\n  \"boundary_complete\": {\n   \"anyOf\": [\n    {\n     \"type\": \"boolean\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Boundary Complete\"\n  },\n  \"kind\": {\n   \"default\": \"declaration\",\n   \"enum\": [\n    \"declaration\",\n    \"interface_member\",\n    \"callsite\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"material_id\": {\n   \"title\": \"Material Id\",\n   \"type\": \"string\"\n  },\n  \"start_line\": {\n   \"minimum\": 1,\n   \"title\": \"Start Line\",\n   \"type\": \"integer\"\n  },\n  \"end_line\": {\n   \"minimum\": 1,\n   \"title\": \"End Line\",\n   \"type\": \"integer\"\n  },\n  \"symbol\": {\n   \"title\": \"Symbol\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"material_id\",\n  \"start_line\",\n  \"end_line\",\n  \"symbol\"\n ],\n \"title\": \"CodeAnchor\",\n \"type\": \"object\"\n}\n==================== FailureAttribution\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"check_id\": {\n   \"title\": \"Check Id\",\n   \"type\": \"string\"\n  },\n  \"witness_indices\": {\n   \"additionalProperties\": {\n    \"items\": {\n     \"type\": \"integer\"\n    },\n    \"type\": \"array\"\n   },\n   \"title\": \"Witness Indices\",\n   \"type\": \"object\"\n  },\n  \"failure_stream\": {\n   \"enum\": [\n    \"stdout\",\n    \"stderr\"\n   ],\n   \"title\": \"Failure Stream\",\n   \"type\": \"string\"\n  },\n  \"failure_lines\": {\n   \"maxItems\": 2,\n   \"minItems\": 2,\n   \"prefixItems\": [\n    {\n     \"type\": \"integer\"\n    },\n    {\n     \"type\": \"integer\"\n    }\n   ],\n   \"title\": \"Failure Lines\",\n   \"type\": \"array\"\n  },\n  \"harness_lines\": {\n   \"maxItems\": 2,\n   \"minItems\": 2,\n   \"prefixItems\": [\n    {\n     \"type\": \"integer\"\n    },\n    {\n     \"type\": \"integer\"\n    }\n   ],\n   \"title\": \"Harness Lines\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"check_id\",\n  \"witness_indices\",\n  \"failure_stream\",\n  \"failure_lines\",\n  \"harness_lines\"\n ],\n \"title\": \"FailureAttribution\",\n \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
