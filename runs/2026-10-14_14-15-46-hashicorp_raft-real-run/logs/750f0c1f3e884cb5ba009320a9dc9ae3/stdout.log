{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_14-15-46-hashicorp_raft-real-run/draft; python3 - <<'PYEOF'\np='assurance_generated_test.go'\ns=open(p).read()\nextra = '''\n// TestAssurance_VerifyLeaderPreexistingCandidate asks whether the separation\n// between a cut-off leader's confirmation window and a competing election\n// survives when a voter is already campaigning before the leader is isolated.\n//\n// The cluster keeps every node on the same settings, so the only difference\n// from the plain uniform case is history: one voter is isolated first and left\n// to campaign at a higher term while the others still have the leader in view,\n// and only then is the leader isolated together with the nonvoter. If a peer's\n// knowledge of the leader lapses at the same moment as the leader's lease, the\n// pre-existing candidate could win before the confirmations stop; the source\n// reading predicts it cannot, because a node with a known leader refuses the\n// vote request before it looks at terms.\nfunc TestAssurance_VerifyLeaderPreexistingCandidate(t *testing.T) {\n\tfor i := 0; i < 20; i++ {\n\t\tcaRunPreexistingCandidateTrial(t, i, true)\n\t}\n\tfor i := 20; i < 22; i++ {\n\t\tcaRunPreexistingCandidateTrial(t, i, false)\n\t}\n}\n\nfunc caRunPreexistingCandidateTrial(t *testing.T, trial int, adverse bool) {\n\tt.Helper()\n\n\tconf := DefaultConfig()\n\tconf.HeartbeatTimeout = 50 * time.Millisecond\n\tconf.ElectionTimeout = 50 * time.Millisecond\n\tconf.LeaderLeaseTimeout = 50 * time.Millisecond\n\tconf.CommitTimeout = 5 * time.Millisecond\n\n\trafts, trans, addrs, _ := caManualCluster(t, []*Config{conf, conf, conf, conf})\n\tdefer func() {\n\t\tfor _, r := range rafts {\n\t\t\t_ = r.Shutdown().Error()\n\t\t}\n\t}()\n\n\tvar leader *Raft\n\tdeadline := time.Now().Add(5 * time.Second)\n\tfor time.Now().Before(deadline) {\n\t\tfor _, r := range rafts {\n\t\t\tif r.getState() == Leader {\n\t\t\t\tleader = r\n\t\t\t}\n\t\t}\n\t\tif leader \"'!= nil {\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\tif leader == nil {\n\t\tt.Fatalf(\"trial %d: no leader elected\", trial)\n\t}\n\tif leader != rafts[0] {\n\t\tif err := leader.LeadershipTransferToServer(rafts[0].localID, rafts[0].localAddr).Error(); err != nil {\n\t\t\tt.Fatalf(\"trial %d: transfer: %v\", trial, err)\n\t\t}\n\t\tdeadline = time.Now().Add(5 * time.Second)\n\t\tfor time.Now().Before(deadline) {\n\t\t\tif rafts[0].getState() == Leader {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ttime.Sleep(5 * time.Millisecond)\n\t\t}\n\t}\n\tleader = rafts[0]\n\tif leader.getState() != Leader {\n\t\tt.Fatalf(\"trial %d: node 0 is %s\", trial, leader.getState())\n\t}\n\tnonvoter := rafts[3]\n\tif err := leader.DemoteVoter(nonvoter.localID, 0, 0).Error(); err != nil {\n\t\tt.Fatalf(\"trial %d: demote: %v\", trial, err)\n\t}\n\ttime.Sleep(100 * time.Millisecond)\n\n\tbaseVerified, baseErr, baseVotes, baseQuorum, baseReturned := caVerify(leader, 2*time.Second)\n\tcampaigner := rafts[1]\n\tcampaignTerm := campaigner.getCurrentTerm()\n\tcandidateBefore := false\n\tif adverse {\n\t\t// Isolate one voter and let it campaign at a higher term while the\n\t\t// others still have the leader in view.\n\t\tisolateOne := [][2]int{{1, 0}, {1, 2}, {1, 3}, {0, 1}, {2, 1}, {3, 1}}\n\t\tfor _, pair := range isolateOne {\n\t\t\ttrans[pair[0]].Disconnect(addrs[pair[1]])\n\t\t}\n\t\tdeadline = time.Now().Add(3 * time.Second)\n\t\tfor time.Now().Before(deadline) {\n\t\t\tif campaigner.getState() == Candidate && campaigner.getCurrentTerm() > leader.getCurrentTerm() {\n\t\t\t\tcandidateBefore = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ttime.Sleep(5 * time.Millisecond)\n\t\t}\n\t\tcampaignTerm = campaigner.getCurrentTerm()\n\t\tif err := leader.Apply([]byte(\"pre-partition\"), 0).Error(); err != nil {\n\t\t\tt.Fatalf(\"trial %d: apply: %v\", trial, err)\n\t\t}\n\t} else {\n\t\tif err := leader.Apply([]byte(\"pre-partition\"), 0).Error(); err != nil {\n\t\t\tt.Fatalf(\"trial %d: apply: %v\", trial, err)\n\t\t}\n\t}\n\n\tcaEmit(t, map[string]interface{}{\n\t\t\"event\":               \"verify_baseline\",\n\t\t\"trial\":               trial,\n\t\t\"adverse\":             adverse,\n\t\t\"preexisting_candidate\": candidateBefore,\n\t\t\"campaigner_term\":     campaignTerm,\n\t\t\"leader_term\":         leader.getCurrentTerm(),\n\t\t\"verified\":            baseVerified,\n\t\t\"error\":               baseErr,\n\t\t\"votes\":               baseVotes,\n\t\t\"quorum_size\":         baseQuorum,\n\t\t\"returned\":            baseReturned,\n\t})\n\n\t// Now isolate the leader and the nonvoter from both remaining voters.\n\tisolate := [][2]int{{0, 1}, {0, 2}, {3, 1}, {3, 2}, {1, 0}, {2, 0}, {1, 3}, {2, 3}}\n\tfor _, pair := range isolate {\n\t\ttrans[pair[0]].Disconnect(addrs[pair[1]])\n\t}\n\tpartitionedAt := time.Now()\n\n\tvar polls, confirmed, confirmedAfterLeader int\n\tvar lastConfirmedMs int64 = -1\n\tvar firstPeerLeaderMs int64 = -1\n\tvar leaderSteppedDown bool\n\tfor i := 0; i < 400; i++ {\n\t\tif leader.getState() != Leader {\n\t\t\tleaderSteppedDown = true\n\t\t\tbreak\n\t\t}\n\t\tpeerLeader := rafts[1].getState() == Leader || rafts[2].getState() == Leader\n\t\telapsed := time.Since(partitionedAt).Milliseconds()\n\t\tif peerLeader && firstPeerLeaderMs < 0 {\n\t\t\tfirstPeerLeaderMs = elapsed\n\t\t}\n\t\tverified, _, _, _, returned := caVerify(leader, 500*time.Millisecond)\n\t\telapsed = time.Since(partitionedAt).Milliseconds()\n\t\tpolls++\n\t\tif returned && verified {\n\t\t\tconfirmed++\n\t\t\tlastConfirmedMs = elapsed\n\t\t\tif peerLeader {\n\t\t\t\tconfirmedAfterLeader++\n\t\t\t}\n\t\t}\n\t\ttime.Sleep(2 * time.Millisecond)\n\t}\n\n\tcaEmit(t, map[string]interface{}{\n\t\t\"event\":                           \"verify_exposure\",\n\t\t\"trial\":                           trial,\n\t\t\"adverse\":                         adverse,\n\t\t\"preexisting_candidate\":           candidateBefore,\n\t\t\"polls\":                           polls,\n\t\t\"confirmations\":                   confirmed,\n\t\t\"last_confirmation_ms\":            lastConfirmedMs,\n\t\t\"first_peer_leader_ms\":            firstPeerLeaderMs,\n\t\t\"confirmations_after_peer_leader\": confirmedAfterLeader,\n\t\t\"confirmation_after_peer_leader\":  confirmedAfterLeader > 0,\n\t\t\"leader_stepped_down\":             leaderSteppedDown,\n\t\t\"leader_term\":                     leader.getCurrentTerm(),\n\t\t\"campaigner_state\":                rafts[1].getState().String(),\n\t\t\"campaigner_term\":                 rafts[1].getCurrentTerm(),\n\t\t\"leader_applied_index\":            leader.getLastApplied(),\n\t})\n}\n'\"'''\ns = s + extra\nopen(p,'w').write(s)\nprint('appended')\nPYEOF\ngofmt -w assurance_generated_test.go && cp assurance_generated_test.go _probe/src/ && cd _probe/src && P=/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_14-15-46-hashicorp_raft-real-run/draft/_probe && GOCACHE=\"'$P/gocache TMPDIR=$P/tmp GOFLAGS=-mod=mod timeout 300 go test -v -run \"''^TestAssurance_VerifyLeaderPreexistingCandidate\" -count=1 -timeout 300s . 2>&1 | grep -E \"CA_EVENT|''^--- |''^ok |''^FAIL|'\"\\\\.go:[0-9]+:\\\" | python3 -c \\\"\nimport sys,json\na=[];c=[]\nfor line in sys.stdin:\n    line=line.strip()\n    if not line.startswith('CA_EVENT '):\n        print(line); continue\n    e=json.loads(line[len('CA_EVENT '):])\n    if e['event']\"'!='\"'verify_exposure': continue\n    row=(e['trial'],e['preexisting_candidate'],e['first_peer_leader_ms'],e['last_confirmation_ms'],e['confirmations_after_peer_leader'],e['confirmation_after_peer_leader'],e['campaigner_state'],e['leader_term'],e['campaigner_term'])\n    (a if e['adverse'] else c).append(row)\nfor r in a: print('adverse t%d precand=%s peer_leader=%dms last_conf=%dms after=%d overlap=%s campaigner=%s leader_term=%d campaigner_term=%d'%r)\nfor r in c: print('plain   t%d precand=%s peer_leader=%dms last_conf=%dms after=%d overlap=%s campaigner=%s'%(r[0],r[1],r[2],r[3],r[4],r[5],r[6]))\nprint('adverse overlap %d/%d ; plain overlap %d/%d'%(sum(1 for r in a if r[5]),len(a),sum(1 for r in c if r[5]),len(c)))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
