ue\n    e=json.loads(line[len('CA_EVENT '):])\n    if e['event']\"'!='\"'verify_exposure_adv': continue\n    a.append((e['trial'],e['preexisting_candidate'],e['campaigner_state'],e['campaigner_term'],e['leader_term'],e['first_peer_leader_ms'],e['last_confirmation_ms'],e['confirmation_after_peer_leader'],e['confirmations_after_peer_leader']))\nfor r in a: print('t%d precand=%s campaigner=%s/%d leader_term=%d peer_leader=%dms last_conf=%dms overlap=%s after=%d'%r)\nprint('precand true %d/%d ; overlap %d/%d'%(sum(1 for r in a if r[1]),len(a),sum(1 for r in a if r[7]),len(a)))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
