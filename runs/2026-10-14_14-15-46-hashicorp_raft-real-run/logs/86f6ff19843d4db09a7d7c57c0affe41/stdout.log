x41 t6 precand=True campaigner=Candidate/3 leader_term=2 peer_leader=-1ms last_conf=50ms conf=18 overlap=False stepped=True\nidx43 t7 precand=True campaigner=Candidate/4 leader_term=3 peer_leader=-1ms last_conf=48ms conf=20 overlap=False stepped=True\nidx45 t8 precand=True campaigner=Candidate/4 leader_term=3 peer_leader=-1ms last_conf=47ms conf=17 overlap=False stepped=True\nidx47 t9 precand=True campaigner=Candidate/3 leader_term=2 peer_leader=-1ms last_conf=49ms conf=19 overlap=False stepped=True\nidx49 t10 precand=True campaigner=Candidate/4 leader_term=3 peer_leader=-1ms last_conf=47ms conf=17 overlap=False stepped=True\nidx51 t11 precand=True campaigner=Candidate/4 leader_term=3 peer_leader=-1ms last_conf=49ms conf=19 overlap=False stepped=True\nprecand 12/12 ; overlap 0/12\n{\"comparison_index\": 0, \"outcome\": \"violated\", \"witness_indices\": [29, 31, 33, 35, 37, 39, 41, 43, 45, 47, 49, 51], \"valid_witness_indices\": [29, 31, 33, 35, 37, 39, 41, 43, 45, 47, 49, 51], \"comparison_complete\": true, \"evaluated_indices\": [29, 31, 33, 35, 37, 39, 41, 43, 45, 47, 49, 51], \"missing_indices\": []}\n","exit_code":0,"status":"completed"}}
