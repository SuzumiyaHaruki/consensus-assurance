s *snapshotState) setRecovering() {\n../agent-source/snapshotstate.go:89:func (rs *snapshotState) clearRecovering() {\n../agent-source/snapshotstate.go:161:func (rs *snapshotState) setRecoverReq(t rsm.Task) {\n../agent-source/snapshotstate.go:165:func (rs *snapshotState) getRecoverReq() (rsm.Task, bool) {\n../agent-source/snapshotstate.go:221:func (rs *snapshotState) getRecoverCompleted() (rsm.Task, bool) {\n../agent-source/engine.go:287:func (w *ssWorker) recover(j job) {\n../agent-source/engine.go:564:func (p *workerPool) canRecover(clusterID uint64) bool {\n../agent-source/engine.go:615:func (p *workerPool) startRecovering(n *node) {\n../agent-source/engine.go:690:func (p *workerPool) getRecoverJob(clusterID uint64) (job, bool) {\n../agent-source/engine.go:1430:func (e *engine) setRecoverReady(clusterID uint64) {\n","exit_code":0,"status":"completed"}}
