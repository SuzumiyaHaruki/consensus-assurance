"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n  