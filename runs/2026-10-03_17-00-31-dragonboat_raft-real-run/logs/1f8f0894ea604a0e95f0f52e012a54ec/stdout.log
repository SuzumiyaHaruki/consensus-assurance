{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '324,375p' ../agent-source/internal/rsm/statemachine.go; sed -n '649,682p' ../agent-source/internal/rsm/statemachine.go; sed -n '1971,1987p' ../agent-source/internal/raft/raft.go; sed -n '2014,2029p' ../agent-source/internal/raft/raft.go; sed -n '1792,1861p' ../agent-source/internal/raft/raft.go\"","aggregated_output":"func (s *StateMachine) recover(ss pb.Snapshot, init bool) error {\n\ts.mu.Lock()\n\tdefer s.mu.Unlock()\n\tif s.GetLastApplied() >= ss.Index {\n\t\treturn raft.ErrSnapshotOutOfDate\n\t}\n\tif s.aborted {\n\t\treturn sm.ErrSnapshotStopped\n\t}\n\tif ss.Witness || ss.Dummy {\n\t\ts.apply(ss)\n\t\treturn nil\n\t}\n\tif !s.OnDiskStateMachine() {\n\t\treturn s.doRecover(ss, init)\n\t}\n\tif s.recoverRequired(ss, init) {\n\t\ts.checkRecoverOnDiskSM(ss, init)\n\t\tif err := s.doRecover(ss, init); err != nil {\n\t\t\treturn err\n\t\t}\n\t\ts.applyOnDisk(ss, init)\n\t} else {\n\t\ts.apply(ss)\n\t}\n\treturn nil\n}\n\nfunc (s *StateMachine) doRecover(ss pb.Snapshot, init bool) error {\n\tindex := ss.Index\n\tplog.Debugf(\"%s recovering from %s, init %t\", s.id(), s.ssid(index), init)\n\ts.logMembership(\"members\", index, ss.Membership.Addresses)\n\ts.logMembership(\"observers\", index, ss.Membership.Observers)\n\ts.logMembership(\"witnesses\", index, ss.Membership.Witnesses)\n\tif err := s.snapshotter.Load(ss, s.sessions, s.sm); err != nil {\n\t\tplog.Errorf(\"%s failed to load %s, %v\", s.id(), s.ssid(index), err)\n\t\tif err == sm.ErrSnapshotStopped {\n\t\t\ts.aborted = true\n\t\t}\n\t\treturn err\n\t}\n\ts.apply(ss)\n\treturn nil\n}\n\nfunc (s *StateMachine) apply(ss pb.Snapshot) {\n\ts.members.set(ss.Membership)\n\ts.lastApplied.Lock()\n\tdefer s.lastApplied.Unlock()\n\ts.lastApplied.index, s.lastApplied.term = ss.Index, ss.Term\n\ts.index, s.term = ss.Index, ss.Term\n}\n}\n\n// GetSyncedIndex returns the index value that is known to have been\n// synchronized.\nfunc (s *StateMachine) GetSyncedIndex() uint64 {\n\treturn atomic.LoadUint64(&s.syncedIndex)\n}\n\nfunc (s *StateMachine) setSyncedIndex(index uint64) {\n\tif s.GetSyncedIndex() > index {\n\t\tpanic(\"synced index moving backward\")\n\t}\n\tatomic.StoreUint64(&s.syncedIndex, index)\n}\n\nfunc (s *StateMachine) setApplied(index uint64, term uint64) {\n\tif s.index+1 != index {\n\t\tplog.Panicf(\"%s, applied index %d, new index %d\",\n\t\t\ts.id(), s.index, index)\n\t}\n\tif s.term > term {\n\t\tplog.Panicf(\"%s, applied term %d, new term %d\", s.id(), s.term, term)\n\t}\n\ts.index, s.term = index, term\n}\n\nfunc (s *StateMachine) setLastApplied(entries []pb.Entry) {\n\tif len(entries) > 0 {\n\t\tindex := uint64(0)\n\t\tterm := uint64(0)\n\t\tfor idx, e := range entries {\n\t\t\tif e.Index == 0 || e.Term == 0 {\n\t\t\t\tplog.Panicf(\"invalid entry, %v\", e)\n\t\t\t}\nfunc (r *raft) handleFollowerTimeoutNow(m pb.Message) {\n\t// the last paragraph, p29 of the raft thesis mentions that this is nothing\n\t// different from the clock moving forward quickly\n\tplog.Debugf(\"%s TimeoutNow received\", r.describe())\n\tr.electionTick = r.randomizedElectionTimeout\n\tr.isLeaderTransferTarget = true\n\tr.tick()\n\tif r.isLeaderTransferTarget {\n\t\tr.isLeaderTransferTarget = false\n\t}\n}\n\n//\n// handler functions used by candidate\n//\n\nfunc (r *raft) doubleCheckTermMatched(msgTerm uint64) {\nfunc (r *raft) handleCandidateReplicate(m pb.Message) {\n\tr.becomeFollower(r.term, m.From)\n\tr.handleReplicateMessage(m)\n}\n\nfunc (r *raft) handleCandidateInstallSnapshot(m pb.Message) {\n\tr.becomeFollower(r.term, m.From)\n\tr.handleInstallSnapshotMessage(m)\n}\n\nfunc (r *raft) handleCandidateHeartbeat(m pb.Message) {\n\tr.becomeFollower(r.term, m.From)\n\tr.handleHeartbeatMessage(m)\n}\n\nfunc (r *raft) handleCandidateRequestVoteResp(m pb.Message) {\nfunc (r *raft) handleLeaderSnapshotStatus(m pb.Message, rp *remote) {\n\tif rp.state != remoteSnapshot {\n\t\treturn\n\t}\n\tif m.Hint == 0 {\n\t\tif m.Reject {\n\t\t\trp.clearPendingSnapshot()\n\t\t\tplog.Warningf(\"%s snapshot failed, %s is now in wait state\",\n\t\t\t\tr.describe(), NodeID(m.From))\n\t\t} else {\n\t\t\tplog.Debugf(\"%s snapshot succeeded, %s in wait state now, next %d\",\n\t\t\t\tr.describe(), NodeID(m.From), rp.next)\n\t\t}\n\t\trp.becomeWait()\n\t} else {\n\t\trp.setSnapshotAck(m.Hint, m.Reject)\n\t\tr.snapshotting = true\n\t}\n}\n\nfunc (r *raft) handleLeaderUnreachable(m pb.Message, rp *remote) {\n\tplog.Debugf(\"%s received Unreachable, %s entered retry state\",\n\t\tr.describe(), NodeID(m.From))\n\tr.enterRetryState(rp)\n}\n\nfunc (r *raft) handleLeaderRateLimit(m pb.Message) {\n\tif r.rl.Enabled() {\n\t\tr.rl.SetFollowerState(m.From, m.Hint)\n\t} else {\n\t\tplog.Warningf(\"%s dropped rate limit msg, rl disabled\", r.describe())\n\t}\n}\n\nfunc (r *raft) enterRetryState(rp *remote) {\n\tif rp.state == remoteReplicate {\n\t\trp.becomeRetry()\n\t}\n}\n\nfunc (r *raft) checkPendingSnapshotAck() {\n\tif r.isLeader() && r.snapshotting {\n\t\tcheck := func(m map[uint64]*remote) {\n\t\t\tfor from, rp := range m {\n\t\t\t\tif rp.state == remoteSnapshot {\n\t\t\t\t\tif rp.delayed.tick() {\n\t\t\t\t\t\tr.Handle(pb.Message{\n\t\t\t\t\t\t\tType:   pb.SnapshotStatus,\n\t\t\t\t\t\t\tFrom:   from,\n\t\t\t\t\t\t\tReject: rp.delayed.rejected,\n\t\t\t\t\t\t\tHint:   0,\n\t\t\t\t\t\t})\n\t\t\t\t\t\trp.clearSnapshotAck()\n\t\t\t\t\t} else {\n\t\t\t\t\t\tr.snapshotting = true\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tr.snapshotting = false\n\t\tcheck(r.remotes)\n\t\tcheck(r.observers)\n\t\tcheck(r.witnesses)\n\t}\n}\n\n//\n// message handlers used by observer, re-route them to follower handlers\n//\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nsrc('M-log-rules','internal/raft/logentry.go',290,399)\nsrc('M-read-client','request.go',823,969)\nsrc('M-node-callbacks','node.go',238,318)\nsrc('M-node-events','node.go',1132,1167)\nsrc('M-node-read-entry','node.go',1225,1234)\nsrc('M-follower-read','internal/raft/raft.go',1936,1963)\nsrc('M-read-api','nodehost.go',855,873,'interface_statement')\nsrc('M-rsm-recover','internal/rsm/statemachine.go',242,260)\nsrc('M-rsm-install','internal/rsm/statemachine.go',324,375)\nsrc('M-rsm-apply','internal/rsm/statemachine.go',876,909)\nsrc('M-rsm-config','internal/rsm/statemachine.go',960,976)\nsrc('M-rsm-members','internal/rsm/membership.go',119,354)\nsrc('M-timers','internal/raft/raft.go',559,630)\nsrc('M-transfer','internal/raft/raft.go',1742,1769)\nsrc('M-quorum-check','internal/raft/raft.go',1603,1614)\nsrc('M-quorum-pop','internal/raft/raft.go',374,396)\nsrc('M-send-term','internal/raft/raft.go',649,667)\nsrc('M-raft-init','internal/raft/raft.go',237,292)\nsrc('M-replicate-send','internal/raft/raft.go',718,813)\nsrc('M-snapshot-retry','internal/raft/raft.go',1792,1859)\nsrc('M-candidate-stepdown','internal/raft/raft.go',1971,2027)\nsrc('M-free-order','node.go',969,971)\nsrc('M-read-receiver-test','internal/raft/raft_test.go',2431,2449,'test_expectation')\nB=[]\ndef b(i,a,owner,ctx,trig,sources,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=sources);d.update(kw);B.append(d)\nb('B-replicate','A1','raft leader/follower dispatched through Peer.Handle','cluster, current term, applied voting membership','Leader proposal or peer replication response; follower Replicate request',['M-core-commit','M-core-dispatch','M-core-read','M-log-rules','M-replicate-send','M-quorum-pop'],implementation_guards=['Proposal rejected during leadership transfer; at most one pending config change proposal is retained.', 'Follower requires matching predecessor term; conflicts at or below committed panic.', 'Leader aggregates only remotes and witnesses; commit requires selected index term equals current term.'],writes=['Entry term/index assigned; follower suffix merged; remote match updated; log.committed advanced monotonically.'],external_effects=['Replicate and ReplicateResp messages; commit changes broadcast to peers.'],important_branches=['Rejected replication decreases next and retries; heartbeat response resumes waiting remote and sends missing suffix.', 'Single voter can commit on append; observers replicate but do not contribute to commit quorum.'],async_boundaries=['Messages buffered until Peer.GetUpdate; durability and delivery handled by engine.'],produces_fact_ids=['F-committed'],consumes_fact_ids=['F-committed'],cross_activity_effects={'A6':'Commit relies on log term lookup and post-save acknowledgements.', 'A5':'Committed entries become eligible for application.'})\nb('B-authority','A2','raft state transitions, election and message dispatcher','cluster term, role, leader identity and voting population','Election timeout, RequestVote/response, higher-term message, same-term leader message to candidate, quorum check or transfer',['M-core-commit','M-core-dispatch','M-response-routing','M-timers','M-transfer','M-quorum-check','M-candidate-stepdown','M-send-term','M-quorum-pop'],implementation_guards=['Election blocked while committed entries exceed applied; witnesses/observers do not campaign.', 'Vote requires eligible prior vote and up-to-date last log term/index; observer vote replies are excluded and votes deduplicated.', 'Lower-term messages ignored; higher-term RequestVote may be ignored within check-quorum lease unless transfer hint; network responses from unknown participants rejected by Peer.Handle.'],writes=['Reset term/vote when term changes; clear pending readIndex, votes, transfer and remote progress on reset; retain log and committed prefix.', 'New leader appends current-term no-op and reconstructs pending config status from log.'],external_effects=['Vote messages, replication after election; TimeoutNow only to known full voter caught up to leader last index.'],important_branches=['CheckQuorum steps down on insufficient active voters; transfer blocks proposals and times out.', 'Forwarded proposal/read requests are termless; normal outgoing protocol responses carry sender term.'],cross_activity_effects={'A1':'New-term support is reconstructed rather than carrying remote matches/votes over; preserved committed history constrains future candidates.', 'A7':'Unconfirmed readIndex state is discarded on reset; client timeout remains separate.'})\nb('B-read-confirm','A2','leader raft/readIndex','current leader term and pending SystemCtx queue','ReadIndex request, heartbeat response carrying a queued context, periodic heartbeat',['M-core-read','M-read-queue','M-heartbeat-producer','M-core-commit'],implementation_guards=['Multi-voter leader requires a current-term committed entry; witness-origin request rejected.', 'Nonzero-context heartbeats sent only to voting members; confirm deduplicates sender and counts leader implicitly.', 'Unknown context confirms nothing.'],writes=['Queue records each context, source and captured committed index.', 'Quorum confirmation returns and deletes queue prefix through confirmed context; released indices raised to latest confirmed request index.'],external_effects=['Released statuses passed to response/local-read routing.'],important_branches=['Single voter directly produces local readiness, with special observer response.', 'Periodic heartbeat repeats latest pending context; reset replaces the whole readIndex object.'],produces_fact_ids=['F-read-release'],consumes_fact_ids=['F-committed'],cross_activity_effects={'A1':'A current-term committed entry plus fresh voter acknowledgements supports the read boundary.', 'A7':'Queue retirement must be routed back to the correct requester context.'})\nb('B-read-route','A2','leader handleReadIndexLeaderConfirmation and follower read response handler','released readStatus source/context, active term','readIndex.confirm returns statuses; receiver handles ReadIndexResp',['M-read-reply','M-follower-read','M-send-term','M-core-dispatch'],consumes_fact_ids=['F-read-release'],writes=['Receiver adds ReadyToRead using received message context and LogIndex.'],external_effects=['Local statuses use s.ctx; remote statuses send to s.from but encode the triggering heartbeat context m.Hint/m.HintHigh.'],existing_protections=['Term checks precede network response consumption.', 'Receiver preserves received context without guessing other pending operations.'],unknowns=['Whether a legal overlapping forwarded-read schedule causes a released earlier context to lose its own routed readiness, and the precise local correlation responsibility.'],cross_activity_effects={'A7':'ReadyToRead contexts are keys used to associate client batches.'})\nb('B-client-read','A7','node and pendingReadIndex','local client RequestState batches keyed by SystemCtx','NodeHost.ReadIndex admission; node step drains queue; ReadyToReads and applied-index callbacks',['M-read-api','M-read-client','M-node-read-entry','M-node-events','M-node-consume','M-node-callbacks'],writes=['Generate nonzero random Low plus tick-derived High; store batch before Peer.ReadIndex.', 'addReady updates index only on exact context match; applied marks ready and notifies only when index > 0 and index <= applied.'],external_effects=['Completion, timeout or drop notification on each RequestState; successful readiness permits ReadLocal.'],important_branches=['No leader or no current-term commitment can drop requests; deadlines may timeout requests.', 'Multiple step drains can create multiple pending contexts; no single-outstanding-context guard in these paths.'],async_boundaries=['Request queue, protocol messages, application completion and caller ResultC.'],cross_activity_effects={'A2':'Client correlation consumes the context exported by authority confirmation.'})\nb('B-persist','A6','engine processSteps, node and Peer','per-node Update with entries, state, messages and committed entries','Step worker obtains Update',['M-engine-order','M-node-consume','M-peer','M-free-order','M-log-rules'],writes=['SaveRaftState persists updates before normal messages; Peer.Commit marks saved/processed portions and clears buffered messages.'],external_effects=['Replicate/Ping sent before save; vote/replication responses and other messages after save.', 'FastApply may enqueue already durable committed history before save; overlapping newly saved committed entries and snapshots require post-save apply.'],consumes_fact_ids=['F-committed'],async_boundaries=['LogDB persistence boundary; state-machine task queue; transport sends.'],unknowns=['Specific LogDB implementations and crash fault injection paths are not yet audited.'])\nb('B-membership','A4','RSM membership then node.ApplyConfigChange under raftMu','committed config entry and local membership ConfigChangeId','Application of committed membership entry',['M-rsm-config','M-rsm-members','M-node-callbacks','M-membership','M-core-commit','M-core-dispatch'],writes=['Validate ordered config id when configured, disallow removed identity reuse and invalid role/address changes; accepted entry updates membership and peer maps.', 'Observer promotion inherits replication progress; removal recomputes quorum and may advance commit; local leader removal steps down.'],important_branches=['Rejected config invokes RejectConfigChange to clear pending state; accepted changes notify registry and request completion.', 'Snapshot recovery restores membership through separate callback.'],cross_activity_effects={'A1':'Quorum population changes only after accepted application.', 'A2':'Local authority and pending proposal eligibility depend on applied membership; campaigns wait for applied progress.'})\nb('B-recovery','A3','raft restore, RSM Recover and node.RestoreRemotes','snapshot index/term/membership plus persisted node state','Startup or snapshot install and state-machine recovery completion',['M-recovery','M-raft-init','M-rsm-recover','M-rsm-install','M-node-callbacks','M-snapshot-retry','M-replicate-send','M-log-rules'],writes=['Startup loads persisted term/vote/commit and members; transitions to configured role.', 'Stale snapshot rejected; matching snapshot term advances commit only, otherwise log restore sets committed/processed snapshot index.', 'RSM loads snapshot and applied membership; successful recovery then calls node.RestoreRemotes.'],external_effects=['Replication response after snapshot handling; compaction makes active peers eligible for snapshot transfer.'],important_branches=['Snapshot transfer status controls wait/retry state and delayed acknowledgements; state-machine recovery callback separately restores remotes.', 'Witness/dummy snapshot uses metadata apply; disk state-machine recovery has additional eligibility checks.'],produces_fact_ids=['F-committed'],cross_activity_effects={'A1':'Snapshot committed boundary and restored membership constrain subsequent replication.', 'A2':'Restored removal can step down leader; observer promotion changes role.'},unknowns=['Detailed disk-state-machine recovery and snapshot transport interleavings remain open.'])\nb('B-apply','A5','RSM StateMachine and node callbacks','committed entry sequence and application state','Queued committed entries executed by RSM',['M-rsm-apply','M-rsm-config','M-node-callbacks','M-node-events','M-node-consume'],consumes_fact_ids=['F-committed'],external_effects=['Application entry invokes session/update handling; callbacks correlate proposal result by ClientID/SeriesID/Key.', 'No-op and update callbacks may notify pending reads; step loop also supplies latest applied index.'],important_branches=['Config entries validate/apply membership separately; ignored and disk-init entries have distinct callbacks.'],async_boundaries=['Commit queue/application queue and caller completion.'],unknowns=['Session duplicate suppression and disk/concurrent state machine completion details are not exhaustively traced.'])\nF=[dict(id='F-committed',meaning='This local log has a monotonically established committed prefix ending at committed; ordinary leader advancement uses current-term quorum replication, follower advancement uses leader propagation, and restore/startup provide separate history paths.',identity={'cluster':'clusterID','node':'nodeID','boundary':'log.committed'},validity_context='Local entryLog including its snapshot boundary, across term transitions; not a statement that all entries have been applied.',representation=['entryLog.committed','persisted State.Commit','snapshot index'],durability='In-memory until update persistence; log/state saved by engine before normal acknowledgements.',recovery='Loaded from persisted State with range checks or restored snapshot.',source_ids=['M-core-commit','M-core-dispatch','M-log-rules','M-recovery','M-engine-order'],unknowns=[]),dict(id='F-read-release',meaning='A pending read status is included in the queue prefix released by confirmation of a queued context after sufficient distinct recorded confirmations plus the leader; its original source and context remain in the returned status, while its index is raised to that of the confirmed context.',identity={'context':'readStatus.ctx SystemCtx','origin':'readStatus.from','leader':'owning raft node'},validity_context='One leader readIndex instance after current-term commitment check for multi-voter admission; queue entries are volatile and discarded on reset.',representation=['readIndex.pending','readIndex.queue','returned []*readStatus'],durability='Volatile; not persisted.',recovery='No restoration; reset creates empty readIndex.',source_ids=['M-read-queue','M-core-read','M-core-commit'],invalidators=['B-authority'],unknowns=[])]\nroles=json.load(open('../research.json'))['activity_roles']\nA=[]\nfor a,role in roles.items():\n bs=[v for v in B if v['primary_activity']==a]\n A.append(dict(class_id=a,applicability='applicable',purpose=role['relation'],realization_summary=' '.join(v['execution_owner']+': '+v['trigger']+'.' for v in bs),entry_points=[v['execution_owner'] for v in bs],source_ids=list(dict.fromkeys(s for v in bs for s in v['source_ids']))))\ndef path(t,bs,fs,ss):return dict(explanation=t,behavior_ids=bs,fact_ids=fs,source_ids=ss)\ncore=dict(status='usable',rationale='Representative formation, authority changes, stale-work handling and their persistence/membership/application connections have been traced. Local read-response correlation and deeper fault variants remain questions, not unexplained core ownership.',formation=path('Peer routes proposals to leader. Leader assigns term/index, appends, and sends predecessor-qualified replication; followers match predecessor and protect committed history. Acknowledgements update per-peer matches; majority of full voters and witnesses selects an index whose term must equal current leader term. Commit is propagated via replication and bounded heartbeat commit. Engine persists state and entries before acknowledgement messages, and queues committed entries according to FastApply durability overlap. RSM applies entries and membership, then node callbacks report proposal/read completion. Rejection responses retry earlier suffix; compaction selects snapshot for active peers.', ['B-replicate','B-persist','B-apply','B-recovery'],['F-committed'],['M-core-commit','M-core-dispatch','M-log-rules','M-engine-order','M-node-consume','M-rsm-apply','M-replicate-send']),context=path('Election timers initiate campaign only for eligible full voters without committed-but-unapplied work. New term resets transient votes/progress/read confirmations; vote granting checks log freshness and prior vote, and candidate forms authority from deduplicated quorum replies. Higher-term protocol messages normally cause stepdown, with check-quorum vote suppression exception; lower terms are ignored. Same-term leader messages demote candidates. Quorum checks, removal and transfer govern loss/change of leadership. Transfer waits for target catchup and triggers target election via TimeoutNow, while blocking proposals until completion or timeout.', ['B-authority','B-membership'],[],['M-core-commit','M-core-dispatch','M-response-routing','M-timers','M-transfer','M-quorum-check','M-candidate-stepdown']),connection=path('Terms qualify newly counted support, but established committed history survives authority reset and constrains future logs and votes. Membership becomes active through RSM application; campaign defers when applied state lags commit, so a new leader does not simply form using its old unapplied membership. New leader reconstructs pending config status and commits a current-term no-op before multi-voter ReadIndex admission. Pending read contexts are reset with authority; within one leader context, voter heartbeat confirmation releases queue prefixes for local readiness or forwarded replies, and clients require exact context plus applied index. Old network responses are term-filtered and unknown responders rejected; pending client work may independently drop or timeout.', ['B-authority','B-membership','B-read-confirm','B-read-route','B-client-read','B-recovery'],['F-committed','F-read-release'],['M-core-commit','M-core-dispatch','M-peer','M-heartbeat-producer','M-read-reply','M-read-client','M-node-callbacks']),open_details=['Forwarded replies use triggering confirmation context for every released queue status; exact correlation under overlapping reads remains unresolved.', 'Disk/concurrent state machine crash/recovery, storage implementations, session deduplication and membership-change message interleavings remain deeper variants.'],core_gaps=[])\nmapobj=dict(version=1,target_profile=dict(system_boundary='Captured Dragonboat Go implementation: Peer/raft core, node/engine orchestration, RSM membership and request completion; application state machine and transport/storage implementations are interfaces with in-repository mechanisms not yet fully read.',protocol_contexts=['ClusterID, NodeID, term, role, applied membership','Log index/term and snapshot boundary','SystemCtx for pending read batches'],external_interfaces=['NodeHost.ReadIndex and RequestState.ResultC','Peer message/update interface','LogDB SaveRaftState','RSM application callbacks'],source_ids=['M-peer','M-read-api','M-engine-order','M-node-callbacks']),activities=A,behaviors=B,facts=F,core_overview=core,surfaces=[dict(entry_point='raft.handleReadIndexLeaderConfirmation',disposition='mapped',behavior_ids=['B-read-route'],reason='Does queue-prefix release preserve each forwarded request identity through response consumption?',source_ids=['M-read-reply','M-read-queue'],high_consequence=True),dict(entry_point='StateMachine.recover',disposition='mapped',behavior_ids=['B-recovery'],reason='Disk snapshot recovery and transport completion interleavings need deeper examination beyond representative install path.',source_ids=['M-rsm-install'],high_consequence=True)])\nopen('map.json','w').write(json.dumps(mapobj,indent=2)+'\\\\n')\nquestion=dict(question='When a later heartbeat context confirms multiple pending forwarded reads, does routing the released statuses preserve each original request context through follower readiness, or can an earlier read be retired under another context?',importance='A wrong context can prevent a qualified read batch from consuming its confirmation. This is a local identity/correlation responsibility; no linearizability violation or unlimited stalling is inferred.',trigger_rationale='readIndex.confirm returns original per-status contexts, local completion uses s.ctx, but remote reply uses the single triggering m.Hint/m.HintHigh. Re