nd.\n\tReportUnreachable(id uint64)\n\t// ReportSnapshot reports the status of the sent snapshot. The id is the raft ID of the follower\n\t// who is meant to receive the snapshot, and the status is SnapshotFinish or SnapshotFailure.\n\t// Calling ReportSnapshot with SnapshotFinish is a no-op. But, any failure in applying a\n\t// snapshot (for e.g., while streaming it from leader to follower), should be reported to the\n\t// leader with SnapshotFailure. When leader sends a snapshot to a follower, it pauses any raft\n\t// log probes until the follower can apply the snapshot and advance its state. If the follower\n\t// can't do that, for e.g., due to a crash, it could end up in a limbo, never getting any\n\t// updates from the leader. Therefore, it is crucial that the application ensures that any\n\t\t\treturn ErrProposalDropped\n\t\t}\n\t\tr.bcastAppend()\n\t\treturn nil\n\tcase pb.MsgReadIndex:\n\t\t// only one voting member (the leader) in the cluster\n\t\tif r.trk.IsSingleton() {\n\t\t\tif resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.To != None {\n\t\t\t\tr.send(resp)\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\n\t\t// Postpone read only request when this leader has not committed\n\t\t// any log entry at its term.\n\t\tif !r.committedEntryInCurrentTerm() {\n\t\t\tr.pendingReadIndexMessages = append(r.pendingReadIndexMessages, m)\n\t\t\treturn nil\n\t\t}\n\n\t\tsendMsgReadIndexResponse(r, m)\n\n\t\treturn nil\n\tcase pb.MsgForgetLeader:\n\t\treturn nil // noop on leader\n\n\tr.logger.Infof(\"%x switched to configuration %s\", r.id, r.trk.Config)\n\tcs := r.trk.ConfState()\n\tpr, ok := r.trk.Progress[r.id]\n\n\t// Update whether the node itself is a learner, resetting to false when the\n\t// node is removed.\n\tr.isLearner = ok && pr.IsLearner\n\n\tif (!ok || r.isLearner) && r.state == StateLeader {\n\t\t// This node is leader and was removed or demoted, step down if requested.\n\t\t//\n\t\t// We prevent demotions at the time writing but hypothetically we handle\n\t\t// them the same way as removing the leader.\n\t\t//\n\t\t// TODO(tbg): ask follower with largest Match to TimeoutNow (to avoid\n\t\t// interruption). This might still drop some proposals but it's better than\n\t\t// nothing.\n\t\tif r.stepDownOnRemoval {\n\t\t\tr.becomeFollower(r.Term, None)\n\t\t}\n\t\treturn cs\n\t}\n\n\t// The remaining steps only make sense if this node is the leader and there\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The exploration completed the removal and later-write history. With `StepDownOnRemoval=false`, the removed node stayed in leader state and returned ReadIndex 3 after the remaining node applied a write at index 5. With the option enabled, it returned no ReadState.\n\nI’ll submit a formal check of the narrower library question: whether safe-read output is released using only local state when the serving node is no longer the sole voter and has obtained no fresh support. The exploration alone is not property evidence, and it did not observe a client read result.\n"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\ns=Path('removed_read_explore_test.go').read_text()\ns=s.replace('   n.peers[1].rn.ReadIndex([]byte(\\\"removed-read\\\"));n.drain()','''   deliveredBefore:=len(n.delivered)\n   n.peers[1].rn.ReadIndex([]byte(\\\"removed-read\\\"));n.drain()\n   freshSupport:=0\n   for _,m:=range n.delivered[deliveredBefore:] { if m.From==2 && m.To==1 && ((m.Type==pb.MsgHeartbeatResp && string(m.Context)==\\\"removed-read\\\") || (m.Type==pb.MsgReadIndexResp && len(m.Entries)==1 && string(m.Entries[0].Data)==\\\"removed-read\\\")) {freshSupport++} }\n   _,ownVoter:=n.peers[1].rn.Status().Config.Voters[0][1]''')\ns=s.replace('\\\"event\\\":\\\"after_read\\\",\\\"read_count\\\":count', '\\\"event\\\":\\\"after_read\\\",\\\"read_count\\\":count')\ns=s.replace('\\\"event\\\":\\\"after_read\\\",\\\"step_down\\\":stepDown,','\\\"event\\\":\\\"after_read\\\",\\\"step_down\\\":stepDown,\\\"released\\\":count>0,\\\"own_voter\\\":ownVoter,\\\"fresh_support\\\":freshSupport,\\\"eligible_support\\\":ownVoter || freshSupport>0,')\nPath('removed_read_check_test.go').write_text(s)\nPY\ncat > removal_product.py <<'PY'\nimport json\nfrom pathlib import Path\nm=json.load(open('../audit-spec/v3.json'))\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n for k in ['established_by','consumed_by']:f.pop(k,None)\nm['behaviors'].append(dict(id='b-singleton-read',primary_activity='A1',execution_owner='stepLeader MsgReadIndex singleton branch',protocol_context='StateLeader and tracker.IsSingleton(), which checks cardinality but not local identity',trigger='ReadIndex on a node still in leader state',consumes_fact_ids=['f-config'],implementation_guards=['IsSingleton checks one incoming voter and empty outgoing configuration.','Unlike MsgProp, the shortcut does not require local progress membership.'],external_effects=['responseToReadIndexReq immediately emits local committed index and request context without heartbeat confirmation.'],source_ids=['s-leader-entry','s-tracker','s-read-result','s-read-entry'],unknowns=['Compatibility of retained leader role after local removal with safe-read output needs a scoped interface check.'],cross_activity_effects={'A2':'When StepDownOnRemoval is false, removed leader role may survive even though sole eligible voter is another node.','A7':'The shortcut exports a ReadState barrier; a client result is not observed by this behavior.'}))\nPath('removal-map.json').write_text(json.dumps(m,indent=2)+'\\\\n')\nss=['s-api','s-recovery-config','s-config','s-config-restore','s-apply','s-leader-entry','s-tracker','s-read-result','s-read-entry','s-removal-option','s-read-mode','s-read-contract','s-confchange-api','s-role','s-replicate']\nq=dict(question='Can a removed node retained as leader with StepDownOnRemoval=false use the singleton safe-read shortcut when the only active voter is a different node, releasing a ReadState without fresh support?',importance='Local role and voter eligibility can diverge after removal. Treating another-node singleton as local authority can export a read barrier without current quorum support; actual client stale-read consequences are not established here.',source_ids=ss,participants=['Removed RawNode','Remaining sole voter','Caller applying committed configuration entries'],objects=['Applied singleton configuration','Request-specific ReadState'],contexts=['ReadOnlySafe','Committed removal from two voters to the other sole voter','StepDownOnRemoval=false with true control','Continued public RawNode ReadIndex calls after removal'],event_paths=['Real election -> propose/remove local leader -> both apply committed removal -> remaining voter campaigns and applies later write -> removed node ReadIndex -> drain Ready'],activity_classes=['A1','A2'],behavior_ids=['b-config','b-singleton-read'],fact_ids=['f-config'],supporting_behavior_ids={'b-proposal':'Produces the real committed removal entry under the old voter configuration.','b-election':'Actual campaigns establish initial and remaining-node leadership; no role assignment.'},obligation_relation_kind='consumption',counterevidence=['StepDownOnRemoval=true demotes the removed leader.','Proposal path checks local membership, but read singleton branch only checks voter cardinality.','An application may stop routing reads to removed nodes; no such routing layer is supplied by RawNode.','Read requests may be lost, so no-output control is permitted, not a liveness violation.'],unknowns=['Formal fresh execution and correspondence are required; exploration is not property evidence.','No application client return or stale state-machine value is measured.'],priority=3,trigger_rationale='Exploration 4d73d083187f41999c27b05b1222ce12 completed the actual removal/write history and observed a removed StateLeader emitting index 3 after the remaining voter applied index 5; this motivates a narrower authority-support obligation, not a global linearizability conclusion.',disposition='ready_for_check',preferred_check='controlled_schedule')\nclaim=dict(id='claim-removed-safe-read',kind='obligation',concern='implementation_semantics',description='A ReadOnlySafe request must not release a ReadState solely on the serving node local state when that node is not an eligible voter in the active singleton configuration and it has obtained no fresh support from the sole eligible voter for that request.',source_ids=['s-read-mode','s-read-contract','s-read-entry','s-confchange-api','s-removal-option','s-leader-entry','s-tracker'],scope=dict(description='Public RawNode safe-read output after locally applied committed removal leaves another node as sole voter. Continued invocation of the library API is in scope; no integration routing layer is assumed.',assumptions=['Serialized calls and application of committed configuration through ApplyConfChange.','Distinct nonempty read context; static singleton configuration after removal; no lease-based reads.','StepDownOnRemoval=false is the target configuration; true is a permitted no-output control.','Caller continues using the removed RawNode rather than imposing an external shutdown policy.'],excluded=['Client-return linearizability, physical persistence or arbitrary crashes.','Progress guarantee for the true-option control.','A claim that every deployment continues serving removed nodes.']),pending=[],grounding=dict(source_ids=['s-leader-entry','s-tracker','s-recovery-config','s-read-result'],expectation_ids=['s-read-mode','s-read-contract','s-read-entry','s-confchange-api','s-removal-option'],binding_ids=['binding-singleton-authority'],derivation='ReadOnlySafe guarantees reads through quorum communication; Node/RawNode describe the returned request-specific index as a safe application barrier. A sole voter can supply local quorum authority only if it is the serving node. Config changes take effect when applied, and StepDownOnRemoval makes role demotion optional without declaring that unsafe read results are permitted. Therefore a removed node with no fresh sole-voter support cannot use only local state as safe authority. This requirement allows silence/forwarding/rejection and does not infer liveness or demand a stale client result.',applicability='At the RawNode library boundary, ReadIndex has no stated membership precondition or automatic Stop, and ApplyConfChange documentation requires applying the removal rather than forbidding later API calls. External routing that stops removed nodes is a deployment mitigation outside this scope. The check uses actual committed removal, callbacks, elections and ordered storage; it does not arbitrarily install a config.',unresolved=['No external service contract is inspected; deployment consequences remain excluded.'],conflicts=[],alternatives=['Enabling StepDownOnRemoval is an existing protection and will be measured as a no-output control.']))\nbinding=dict(id='binding-singleton-authority',material_id='s-leader-entry',symbol='stepLeader',start_line=1346,end_line=1354,description='Singleton read branch immediately exports committed index without checking which node is the voter.',pending=[],associations=[dict(claim_id=claim['id'],source_ids=['s-read-mode','s-read-contract','s-leader-entry','s-tracker','s-removal-option'],rationale='Safe-read quorum responsibility applies at the public API; cardinality-only shortcut is the concrete consumer of applied voter eligibility.')])\ncandidate=dict(action='obligation',map_path='removal-map.json',rationale='Use the completed exploration to form a narrowly scoped library authority requirement and test it formally; preserve wider application consequences as unproved.',question=q,obligation=claim,bindings=[binding])\ng=dict(source_ids=ss+['s-storage-writes','s-confchange-representation'],expectation_ids=['s-read-mode','s-read-contract','s-confchange-api','s-removal-option','s-async-config-contract'],binding_ids=['binding-singleton-authority'],derivation='Initialize two RawNodes through public Storage snapshot/HardState methods, actually campaign node 1, propose ConfChangeRemoveNode(1), and invoke ApplyConfChange only from actual MsgStorageApply committed entries. Both nodes must report sole voter 2. Campaign node 2 and propose a distinct write; record its actual application before invoking removed node ReadIndex. StepDownOnRemoval is the only paired variant. No roles, terms, commit positions or membership maps are assigned directly. Async append and application workers run FIFO and return responses after their work. A read request is issued once and all available work drains regardless of whether it emits a ReadState.',applicability='No clocks or network loss are needed after the committed removal; node 2 does not send protocol traffic to removed node 1 under its installed config. Caller keeps the RawNode alive, which is the exact library API scope rather than an assumed deployment routing policy. MemoryStorage substitutes for caller persistence; callback application is recorded before response. No crash or client read return is modeled.',unresolved=['External shutdown/routing mitigations are not tested.'],conflicts=[],alternatives=['StepDownOnRemoval=true is exercised without requiring a ReadState or treating silence as a violation.'])\nmg=dict(source_ids=['s-read-entry','s-read-result','s-leader-entry','s-tracker','s-recovery-config'],expectation_ids=['s-read-mode','s-read-contract'],binding_ids=['binding-singleton-authority'],derivation='before_read is emitted after real committed removal and later write application, before invoking ReadIndex. after_read is emitted after that synchronous API call returns and all generated protocol work drains. Operation identity is step_down (the two independent executions). eligible_support is measured from the current voter membership and authentic newly delivered heartbeat/read-index responses from voter 2 with the request context; both raw components are also emitted. released is count of actual matching Ready.ReadStates > 0. The necessity implication compares output only when eligible_support is false. No-output control completes the API observation interval without claiming a completed client read or owed liveness. write_index/read_index remain raw context and are not the oracle.',applicability='Active configuration is verified to contain only voter 2 before request, no later config change occurs, and every delivered message is logged by the deterministic transport. Identity does not filter on the compared output or support. The two subtests are independent, not combined into one protocol history.',unresolved=['This is a library ReadState release comparison, not a client state-machine result.'],conflicts=[],alternatives=['An integration can avoid calling ReadIndex after removal; this does not alter the tested library output.'])\nplan=dict(description='Formally repeat the explored committed-removal history, observing voter eligibility and fresh support at a subsequent ReadOnlySafe call; compare automatic stepdown enabled/disabled.',claim_id=claim['id'],binding_ids=['binding-singleton-authority'],harness=dict(kind='go_test',source='',files={},description='Two public RawNode histories with actual elections, committed removal application, later write application and removed-node read invocation.',semantic_changes=['No target modification.','MemoryStorage and deterministic ordered workers implement caller duties.','Caller continues invoking the removed RawNode; external service shutdown is not modeled.'],prerequisites=[dict(alias='admitted',event='before_read',conditions=[])],legality=g),monitors=[dict(id='monitor-removed-safe-read',checker_id='removed-safe-read-support',event='after_read',admission_alias='admitted',binding_ids=['binding-singleton-authority'],grounding=mg,applicability_conditions=[])],observable_properties=[dict(checker_id='removed-safe-read-support',kind='event_implication',trigger=dict(field='event',value='after_read'),antecedent=dict(field='eligible_support',value=False),assertion=dict(field='released',value=False),identity_fields=['step_down'],description='Without local voter eligibility or fresh sole-voter support, no safe ReadState may be released; no-output is permitted.')],uncertainties=['No external application client return is measured.','Continued invocation on removed RawNode is the explicit library scope; integration shutdown mitigations are excluded.'])\nPath('removal-check-plan.json').write_text(json.dumps(plan,indent=2)+'\\\\n')\nsub=dict(action='check',candidate=candidate,rationale='The trusted exploration provides a legal-history lead; this separate formal check compares only safe-read authority support and permits no-output control.',plan_path='removal-check-plan.json',harness_path='removed_read_check_test.go')\nPath('submission.json').write_text(json.dumps(sub,indent=2)+'\\\\n')\nPY\npython3 removal_product.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));x=subprocess.run(r['validation']['command']+['submission.json'],capture_output=True,text=True);print(x.stdout);print(x.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
