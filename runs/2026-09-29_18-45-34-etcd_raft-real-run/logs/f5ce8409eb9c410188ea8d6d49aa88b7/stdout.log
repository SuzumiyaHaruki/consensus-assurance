{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\nfrom pathlib import Path\nbindings=['binding-read-context']\nsource=['s-read-entry','s-api','s-read-context','s-transfer-read','s-follower','s-read-result','s-role','s-read-release','s-ready-storage','s-storage-writes','s-status-observation','s-config-validation']\nlegality=dict(source_ids=source,expectation_ids=['s-read-contract','s-read-mode','s-async-config-contract'],binding_ids=bindings,derivation='For claim-read-context-correlation, initialize two RawNodes using the already examined public snapshot bootstrap, then actually campaign node 1 and process all Ready storage responses and peer traffic to complete its term entry. ReadIndex(old) is executed and drained; the driver retains an actual follower MsgHeartbeatResp already delivered in that same history and checks that the old context produced a ReadState. Only then it calls ReadIndex(fresh) with distinct immutable nonempty bytes. It accepts leader Ready but withholds the generated fresh heartbeat in its wire queue, replays the exact earlier response through RawNode.Step, and collects leader Ready.ReadStates. It then drains the wire independently of any observed forbidden output and observes genuine fresh reply and ReadState completion.',applicability='Static two voters, ReadOnlySafe, unchanged term, no crash or membership change. Serialized public APIs; AsyncStorageWrites storage/apply work is completed before attached responses are delivered and same-target work is FIFO. No ticks fire in the finite replay interval. Leader election and both heartbeat-response producers are actual target execution. Initial shared compacted prefix is constructed via public Storage methods, not claimed to have been produced from genesis. MemoryStorage substitutes for caller storage completion; application is no-op and completes before response.',unresolved=['This does not observe a client state-machine read or whole-system linearizability.'],conflicts=[],alternatives=['Same-context retries have version-qualified semantics and are not used.','Lease and singleton paths are excluded rather than treated as quorum-required paths.'])\nmg=dict(source_ids=source,expectation_ids=['s-read-contract','s-read-mode','s-read-memory-test'],binding_ids=bindings,derivation='The old_completed prerequisite records a real delivered old-context heartbeat response and exactly one old ReadState. admitted identifies the fresh request and declares causal dependence through its prior_context reference. stale_processed records completion of replay Step and draining its leader Ready outputs; fresh_replies_before is counted from delivered messages and fresh_read_count from actual Ready.ReadStates. The result is emitted after the later genuine-response path completes and carries the saved pre-quorum count, so the absence check is not inferred from a tool timeout or an uncompleted read. The necessity implication tests only that zero fresh quorum responses in this two-voter scope cannot yield the fresh ReadState as a consequence of stale support. It does not equate missing responses with permanent failure. Distinct operation identity includes the requested context and unchanged leader term; compared values are read counts, not identity fields.',applicability='Top-level result completed requires at least one actual fresh ReadState and one delivered genuine fresh response; otherwise completion_gap leaves admission unanswered. The withheld fresh heartbeat is later released regardless of the measured pre-quorum outcome. All target reads and message objects are observed without altering target logic.',unresolved=['Only one old-context replay and one new request are measured; same-context reuse, term transitions and joint configuration remain unmeasured.'],conflicts=[],alternatives=['The old response still updates activity/flow-control state; the oracle forbids only credit toward the fresh read result, not all effects of the old response.'])\nplan=dict(description='Complete old safe read, retain its authentic follower heartbeat response, then replay it while a distinct fresh read waits with its heartbeat withheld. Finish genuine fresh heartbeat response and ReadState completion.',claim_id='claim-read-context-correlation',binding_ids=bindings,harness=dict(kind='go_test',source='',files={},description='Public RawNode same-execution read-context replay with asynchronous ordered storage, old read completion, finite fresh heartbeat delay and genuine-response completion control.',semantic_changes=['No target changes or internal state assignment.','MemoryStorage provides deterministic caller storage completion; no disk durability or client application value is measured.','Exact duplicate old heartbeat response is injected through RawNode.Step while fresh network work is finitely delayed.'],prerequisites=[dict(alias='old',event='old_completed',conditions=[dict(field='old_read_count',value=1)]),dict(alias='admitted',event='admitted',conditions=[dict(field='prior_context',reference='old.reply_context'),dict(field='contexts_distinct',value=True)]),dict(alias='replay',event='stale_processed',conditions=[dict(field='replayed_context',reference='admitted.prior_context')])],legality=legality),monitors=[dict(id='monitor-read-context',checker_id='read-context-isolation',event='completed',binding_ids=bindings,grounding=mg,admission_alias='admitted',applicability_conditions=[])],observable_properties=[dict(checker_id='read-context-isolation',kind='event_implication',trigger=dict(field='event',value='completed'),antecedent=dict(field='fresh_replies_before',value=0),assertion=dict(field='prequorum_fresh_reads',value=0),identity_fields=['operation','leader','follower','term','fresh_context'],description='With the fresh follower reply withheld, replay of completed-context support must not produce the fresh ReadState; later genuine fresh completion makes this a complete bounded schedule.')],uncertainties=['No client-return or physical application value is observed.','Scope excludes context reuse, leader change, singleton and lease-based reads.','The shared bootstrap prefix is constructed through public storage initialization; elections and reply producers are executed.'])\nPath('read-check-plan.json').write_text(json.dumps(plan,indent=2)+'\\\\n')\nsub=dict(action='check',unit_id='unit-claim-read-context-correlation',rationale='Run an actual old-response producer and completed read before a fresh distinct request; delay only the fresh heartbeat, measure replay effects, then independently complete the genuine response path.',plan_path='read-check-plan.json',harness_path='read_context_test.go')\nPath('submission.json').write_text(json.dumps(sub,indent=2)+'\\\\n')\nr=json.load(open('../research.json'));x=subprocess.run(r['validation']['command']+['submission.json'],capture_output=True,text=True);print(x.stdout);print(x.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
