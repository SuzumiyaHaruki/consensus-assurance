d\": [\"kind\", \"source\", \"description\", \"semantic_changes\"], \"title\": \"Harness\", \"type\": \"object\"}, \"ObservableProperty\": {\"additionalProperties\": false, \"properties\": {\"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"kind\": {\"default\": \"event_assertion\", \"enum\": [\"event_assertion\", \"event_implication\", \"stable_support\"], \"title\": \"Kind\", \"type\": \"string\"}, \"trigger\": {\"$ref\": \"#/$defs/Comparison\"}, \"assertion\": {\"$ref\": \"#/$defs/Comparison\"}, \"antecedent\": {\"anyOf\": [{\"$ref\": \"#/$defs/Comparison\"}, {\"type\": \"null\"}], \"default\": null}, \"identity_fields\": {\"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"history_field\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"History Field\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}, \"required\": [\"checker_id\", \"trigger\", \"assertion\", \"description\"], \"title\": \"ObservableProperty\", \"type\": \"object\"}}, \"additionalProperties\": false, \"description\": \"Concrete investigation of an accepted requirement; execution determines the observed result.\", \"properties\": {\"description\": {\"description\": \"This check\\u2019s discriminator, prefix, controls and observations; reference the accepted claim rather than restating it\", \"title\": \"Description\", \"type\": \"string\"}, \"claim_id\": {\"title\": \"Claim Id\", \"type\": \"string\"}, \"binding_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"harness\": {\"$ref\": \"#/$defs/Harness\"}, \"monitors\": {\"items\": {\"$ref\": \"#/$defs/EventMonitor\"}, \"minItems\": 1, \"title\": \"Monitors\", \"type\": \"array\"}, \"observable_properties\": {\"description\": \"Direct route supports event_assertion and event_implication. Correlate prerequisite fields by alias; history properties require a local_model fallback.\", \"items\": {\"$ref\": \"#/$defs/ObservableProperty\"}, \"minItems\": 1, \"title\": \"Observable Properties\", \"type\": \"array\"}, \"uncertainties\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Uncertainties\", \"type\": \"array\"}}, \"required\": [\"description\", \"claim_id\", \"binding_ids\", \"harness\", \"monitors\", \"observable_properties\"], \"title\": \"DirectCheckPlan\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
