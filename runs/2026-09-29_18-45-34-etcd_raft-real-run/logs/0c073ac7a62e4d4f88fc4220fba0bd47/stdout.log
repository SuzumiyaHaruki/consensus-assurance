,\"append_work_count\":1,\"direct_acks\":0,\"entry_index\":3,\"entry_term\":2,\"event\":\"completed\",\"follower\":2,\"follower_commit\":3,\"leader\":1,\"leader_commit\":3,\"message_term\":2,\"nested_acks\":1,\"phase\":\"original\",\"published_acks\":1,\"scenario\":\"duplicate_pending\",\"stored_at_end\":true,\"stored_before_ready\":false}\n\nCA_EVENT {\"all_published_backed\":true,\"append_entries\":0,\"append_work_count\":1,\"direct_acks\":0,\"entry_index\":3,\"entry_term\":2,\"event\":\"completed\",\"follower\":2,\"follower_commit\":3,\"leader\":1,\"leader_commit\":3,\"message_term\":2,\"nested_acks\":1,\"phase\":\"duplicate\",\"published_acks\":1,\"scenario\":\"duplicate_pending\",\"stored_at_end\":true,\"stored_before_ready\":false}\n\nCA_EVENT {\"all_published_backed\":true,\"append_entries\":0,\"append_work_count\":1,\"direct_acks\":0,\"entry_index\":3,\"entry_term\":2,\"event\":\"completed\",\"follower\":2,\"follower_commit\":3,\"leader\":1,\"leader_commit\":3,\"message_term\":2,\"nested_acks\":1,\"phase\":\"stored_retry\",\"published_acks\":1,\"scenario\":\"duplicate_pending\",\"stored_at_end\":true,\"stored_before_ready\":true}\n\n{'Time': '2026-09-29T19:02:54.017591497+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Test': 'TestAssuranceAsyncDuplicateAppend', 'Elapsed': 0}\n{'Time': '2026-09-29T19:02:54.017962207+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Elapsed': 0.009}\nproperties [{'checker_id': 'no-immediate-pending', 'kind': 'event_implication', 'trigger': {'field': 'event', 'op': 'eq', 'value': 'completed', 'reference': None}, 'assertion': {'field': 'direct_acks', 'op': 'eq', 'value': 0, 'reference': None}, 'antecedent': {'field': 'stored_before_ready', 'op': 'eq', 'value': False, 'reference': None}, 'identity_fields': ['scenario', 'phase', 'leader', 'follower', 'entry_index', 'entry_term', 'message_term'], 'history_field': None, 'description': 'When the accepted append was still absent from local storage at Ready extraction, no matching positive response may be directly deliverable.'}, {'checker_id': 'published-support-backed', 'kind': 'event_assertion', 'trigger': {'field': 'event', 'op': 'eq', 'value': 'completed', 'reference': None}, 'assertion': {'field': 'all_published_backed', 'op': 'eq', 'value': True, 'reference': None}, 'antecedent': None, 'identity_fields': ['scenario', 'phase', 'leader', 'follower', 'entry_index', 'entry_term', 'message_term'], 'history_field': None, 'description': 'Every matching response published by the three captured batches has the exact acknowledged entry present in storage at publication.'}]\nmonitors [('completed', 'admitted', []), ('completed', 'admitted', [])]\nprerequisites [{'alias': 'producer', 'event': 'produced', 'conditions': []}, {'alias': 'admitted', 'event': 'admitted', 'conditions': [{'field': 'producer_term', 'op': 'eq', 'value': None, 'reference': 'producer.message_term'}]}]\nresolution {\"additionalProperties\": false, \"properties\": {\"condition_dispositions\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/ConditionDisposition\"}, \"title\": \"Condition Dispositions\", \"type\": \"array\"}, \"issue_id\": {\"title\": \"Issue Id\", \"type\": \"string\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"evidence_ids\": {\"description\": \"Accepted execution, artifact, evidence or review IDs answering this issue; Material IDs belong in source_ids\", \"items\": {\"type\": \"string\"}, \"title\": \"Evidence Ids\", \"type\": \"array\"}, \"rationale\": {\"description\": \"Why actual evidence answers this specific issue; describing current behavior alone is insufficient\", \"title\": \"Rationale\", \"type\": \"string\"}, \"residual_issue_ids\": {\"description\": \"Other independent open issues that remain; never the resolved issue or its unresolved children\", \"items\": {\"type\": \"string\"}, \"title\": \"Residual Issue Ids\", \"type\": \"array\"}, \"scope_limitations\": {\"description\": \"Independent boundaries retained by the related review item\", \"items\": {\"type\": \"string\"}, \"title\": \"Scope Limitations\", \"type\": \"array\"}}, \"required\": [\"issue_id\", \"source_ids\", \"rationale\", \"residual_issue_ids\", \"scope_limitations\"], \"title\": \"IssueResolution\", \"type\": \"object\"}\nevidence [{\"direct_check_id\": \"83b99221f457497c9690fb8c13a0d793\", \"id\": \"5de31333928a45b5abcedfb676539337\", \"check_id\": \"c95ee11a6a44469f8e7db1a75f3aafb4\", \"model_id\": null, \"snapshot_id\": \"a03420efa5184367a5330bd94e1fc3f5\", \"claim_id\": \"claim-async-append-dependency\", \"origin\": \"executed\", \"level\": \"implementation_test\", \"scope\": {\"description\": \"Library-to-caller message publication dependency for positive remote MsgAppResp under the asynchronous storage interface, with a legal accepted append followed by a duplicate before local storage completion.\", \"assumptions\": [\"Serialized RawNode calls.\", \"Message duplication is exact and originates from an actual leader-produced MsgApp in the same execution.\", \"The caller processes local append messages reliably and in order and releases attached responses only after completion.\", \"No crash, membership change or malformed network message is needed.\"], \"excluded\": [\"Synchronous Ready message ordering dispute.\", \"Disk crash persistence, global agreement after restart and client-visible application results.\", \"Liveness under indefinite local storage delay.\"], \"parameters\": {}}, \"description\": \"Measured holds comparison; current confirmation: False\", \"assessment\": \"inconclusive\", \"stale_reason\": null, \"calibration_id\": null, \"search_fingerprint\": \"\", \"checker_id\": \"no-immediate-pending\", \"claim_version\": 1, \"applicability\": \"current\"}, {\"direct_check_id\": \"83b99221f457497c9690fb8c13a0d793\", \"id\": \"b32734d150dc40298fda098f323eecce\", \"check_id\": \"c95ee11a6a44469f8e7db1a75f3aafb4\", \"model_id\": null, \"snapshot_id\": \"a03420efa5184367a5330bd94e1fc3f5\", \"claim_id\": \"claim-async-append-dependency\", \"origin\": \"executed\", \"level\": \"implementation_test\", \"scope\": {\"description\": \"Library-to-caller message publication dependency for positive remote MsgAppResp under the asynchronous storage interface, with a legal accepted append followed by a duplicate before local storage completion.\", \"assumptions\": [\"Serialized RawNode calls.\", \"Message duplication is exact and originates from an actual leader-produced MsgApp in the same execution.\", \"The caller processes local append messages reliably and in order and releases attached responses only after completion.\", \"No crash, membership change or malformed network message is needed.\"], \"excluded\": [\"Synchronous Ready message ordering dispute.\", \"Disk crash persistence, global agreement after restart and client-visible application results.\", \"Liveness under indefinite local storage delay.\"], \"par\n  }\n  if !work { return }\n }\n n.t.Fatal(\"schedule failed to quiesce within 500 transitions\")\n}\nfunc (n *assuranceNetwork) stored(id,index,term uint64,data []byte) bool {\n last,err:=n.peers[id].storage.LastIndex()\n n.must(err)\n if index>last { return false }\n es,err:=n.peers[id].storage.Entries(index,index+1,^uint64(0))\n return err==nil && len(es)==1 && es[0].Term==term && string(es[0].Data)==string(data)\n}\ntype assuranceObservation struct {\n phase string; rd Ready; pending bool; direct,nested,appendCount,appendEntries int\n delivered int; allBacked bool\n}\nfunc TestAssuranceAsyncDuplicateAppend(t *testing.T) {\n n:=&assuranceNetwork{t:t,peers:map[uint64]*assurancePeer{}}\n for _,id:=range []uint64{1,2} {\n  s:=NewMemoryStorage()\n  // Publicly supported manual bootstrap from a shared compacted prefix.\n  n.must(s.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{Index:1,Term:1,ConfState:pb.ConfState{Voters:[]uint64{1,2}}}}))\n  n.must(s.SetHardState(pb.HardState{Term:1,Commit:1}))\n  rn,err:=NewRawNode(&Config{ID:id,Storage:s,Applied:1,ElectionTick:10,HeartbeatTick:1,MaxSizePerMsg:4096,MaxInflightMsgs:16,AsyncStorageWrites:true})\n  n.must(err); n.peers[id]=&assurancePeer{rn:rn,storage:s}\n }\n n.must(n.peers[1].rn.Campaign()); n.drain()\n if n.peers[1].rn.BasicStatus().RaftState!=StateLeader { t.Fatal(\"producer did not become leader\") }\n data:=[]byte(\"assurance-duplicate-append\")\n n.must(n.peers[1].rn.Propose(data))\n // Process only the leader until its actual append message is captured.\n if !n.peers[1].rn.HasReady() { t.Fatal(\"proposal produced no Ready\") }\n n.process(1,n.peers[1].rn.Ready())\n var app pb.Message; found:=false\n for i,m:=range n.wire {\n  if m.Type==pb.MsgApp && m.From==1 && m.To==2 && len(m.Entries)>0 && string(m.Entries[len(m.Entries)-1].Data)==string(data) {\n   app=m; n.wire=append(n.wire[:i],n.wire[i+1:]...); found=true; break\n  }\n }\n if !found { t.Fatal(\"no actual leader append for proposal\") }\n target:=app.Entries[len(app.Entries)-1]\n base:=func(event,phase string) map[string]interface{} { return map[string]interface{}{\"event\":event,\"scenario\":\"duplicate_pending\",\"phase\":phase,\"leader\":app.From,\"follower\":app.To,\"entry_index\":target.Index,\"entry_term\":target.Term,\"message_term\":app.Term} }\n matches:=func(m pb.Message) bool { return m.Type==pb.MsgAppResp && !m.Reject && m.From==app.To && m.To==app.From && m.Term==app.Term && m.Index==target.Index }\n capture:=func(phase string) *assuranceObservation {\n  e:=base(\"produced\",phase); e[\"payload\"]=string(target.Data); e[\"previous_index\"]=app.Index; assuranceEmit(e)\n  n.must(n.peers[2].rn.Step(app))\n  o:=&assuranceObservation{phase:phase,pending:!n.stored(2,target.Index,target.Term,target.Data),allBacked:true}\n  e=base(\"admitted\",phase); e[\"stored_before_ready\"]=!o.pending; e[\"producer_term\"]=app.Term; assuranceEmit(e)\n  if !n.peers[2].rn.HasReady() { t.Fatal(\"accepted append has no Ready\") }\n  o.rd=n.peers[2].rn.Ready()\n  for _,m:=range o.rd.Messages {\n   if matches(m) { o.direct++ }\n   if m.Type==pb.MsgStorageAppend {\n    o.appendCount++; o.appendEntries+=len(m.Entries)\n    for _,r:=range m.Responses { if matches(r) { o.nested++ } }\n   }\n  }\n  e=base(\"ready_observed\",phase); e[\"stored_before_ready\"]=!o.pending; e[\"direct_acks\"]=o.direct; e[\"nested_acks\"]=o.nested; e[\"append_work_count\"]=o.appendCount; e[\"append_entries\"]=o.appendEntries; assuranceEmit(e)\n  return o\n }\n // The first Ready accepts entries without executing its local storage work.\n first:=capture(\"original\")\n duplicate:=capture(\"duplicate\")\n publish:=func(o *assuranceObservation,m pb.Message) {\n  if matches(m) {\n   backed:=n.stored(2,target.Index,target.Term,target.Data)\n   o.delivered++; o.allBacked=o.allBacked&&backed\n   e:=base(\"ack_published\",o.phase); e[\"stored\"]=backed; e[\"ack_index\"]=m.Index; e[\"ack_term\"]=m.Term; assuranceEmit(e)\n  }\n  n.wire=append(n.wire,m)\n }\n // Immediate messages are legally publishable before local work. Do this even\n // if the measured routing is wrong, so the schedule does not assume the oracle.\n for _,o:=range []*assuranceObservation{first,duplicate} {\n  for _,m:=range o.rd.Messages { if !IsLocalMsgTarget(m.To) { publish(o,m) } }\n }\n finish:=func(o *assuranceObservation) {\n  for _,m:=range o.rd.Messages {\n   if m.Type==pb.MsgStorageAppend {\n    n.appendWork(2,m)\n    for _,r:=range m.Responses { publish(o,r) }\n   } else if m.Type==pb.MsgStorageApply {\n    for _,r:=range m.Responses { publish(o,r) }\n   }\n  }\n }\n // All same-target work completes in Ready order, including response-only work.\n finish(first); finish(duplicate); n.drain()\n // A permitted control repeats the identical append after storage completion.\n control:=capture(\"stored_retry\")\n for _,m:=range control.rd.Messages { if !IsLocalMsgTarget(m.To) { publish(control,m) } }\n finish(control); n.drain()\n for _,o:=range []*assuranceObservation{first,duplicate,control} {\n  e:=base(\"completed\",o.phase)\n  e[\"stored_before_ready\"]=!o.pending; e[\"direct_acks\"]=o.direct; e[\"nested_acks\"]=o.nested; e[\"append_work_count\"]=o.appendCount; e[\"append_entries\"]=o.appendEntries\n  e[\"published_acks\"]=o.delivered; e[\"all_published_backed\"]=o.allBacked; e[\"stored_at_end\"]=n.stored(2,target.Index,target.Term,target.Data)\n  e[\"leader_commit\"]=n.peers[1].rn.BasicStatus().Commit; e[\"follower_commit\"]=n.peers[2].rn.BasicStatus().Commit\n  if o.delivered==0 || !n.stored(2,target.Index,target.Term,target.Data) { e[\"event\"]=\"completion_gap\" }\n  assuranceEmit(e)\n }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The corrected run reached all three operations. The duplicate arrived while storage was pending and produced a batch with zero new entries, one storage message, and one attached acknowledgment—none directly deliverable. All three acknowledgments were published after the target entry was present in storage.\n\nI’ll resolve the observation issue for this version. This supports a bounded result for the tested schedule, not a general crash-safety conclusion.\n"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\nfrom pathlib import Path\nss=['s-storage-bounds','s-storage-writes','s-api','s-async-config-contract','s-ready-contract','s-ready-storage','s-follower','s-send','s-role','s-status-observation']\nlimitations=['This establishes publication dependency in one static two-voter, single-entry history with original, duplicate-pending and stored-retry deliveries; it is not exhaustive consensus safety.','MemoryStorage completion substitutes for caller durability; no disk crash or recovery endpoint is exercised.','The produced event is a provenance record for each delivery of the same captured leader message, not three separate leader proposals.','The secondary all_published_backed comparison partly validates the caller driver; the primary top-level versus attached Ready observation is the discriminating implementation measurement.','No later-term reply, reconfiguration, client return or external application result is checked. Synchronous ordering ambiguity remains outside scope.']\nrationale='Review of fixed artifact 83b99221f457497c9690fb8c13a0d793 and run c95ee11a6a44469f8e7db1a75f3aafb4 covers claim-async-append-dependency v1 and both v1 bindings. The public async interface makes top-level Ready messages immediately deliverable but requires ordered append work and durable completion before attached responses. The driver starts from a shared compacted snapshot via public storage APIs, actually campaigns node 1, drains vote/append storage and response traffic, proposes the payload and captures the resulting MsgApp(index 3, entry term/message term 2, predecessor 2). It redelivers those exact bytes while node 2 original append work is withheld; no critical raft state is assigned. Same-worker work is then completed in Ready order. There are no timer firings during this finite schedule; omitted ticks neither supply nor invalidate the measured storage dependency. The corrected stored helper first reads LastIndex, so absent index 3 can be observed safely; the new stored_before_ready=false antecedent is logically identical to the original pending=true condition. Identity fields correlate scenario/phase/endpoints/entry/message context across produced, admitted and completed; the explicit producer_term reference establishes producer-before-admission. Phase distinguishes deliveries rather than inventing separate entries. All three admissions and independent completed events occurred. Original and duplicate report stored_before_ready=false and direct_acks=0; the duplicate reports append_entries=0, append_work_count=1 and nested_acks=1. Each ack_published reports stored=true; each completed reports one published acknowledgment and exact entry stored at end. The stored_retry control begins with storage already present. No completion-gap event or nonzero exit occurred. The schedule publishes top-level messages before executing delayed local work even if the oracle would fail, so it does not assume the safety property. The primary implication is one-way and does not require acknowledgments before persistence or infer progress from a pending state. A bounded holds interpretation is supported; source protections (msgsAfterAppend and response-only needStorageAppendMsg) explain it without claiming wider agreement or crash durability.'\nsub=dict(action='review',artifact_id='83b99221f457497c9690fb8c13a0d793',rationale='Complete correspondence review of the corrected executed check and resolve only the observation-bounds issue for this answering version.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ss,rationale=rationale,counterevidence=[],limitations=limitations)],resolutions=[dict(issue_id='8178c42684824a00b28c4cf37110d7d3',source_ids=['s-storage-bounds','s-api','s-ready-storage'],evidence_ids=['83b99221f457497c9690fb8c13a0d793','c95ee11a6a44469f8e7db1a75f3aafb4','5de31333928a45b5abcedfb676539337','b32734d150dc40298fda098f323eecce'],rationale='The fixed v2 helper queries LastIndex and returns absent when the target exceeds it; Entries is invoked only in range. Fresh execution reached original and duplicate admissions with stored_before_ready=false and all three completed response observations without panic. This directly answers the invalid observation call identified in v1, preserving the requirement, schedule, correlation and logically equivalent predicate. Resolution applies to v2 and does not retroactively attribute the failed v1 run.',residual_issue_ids=[],scope_limitations=limitations)],feedback=dict(ref_ids=['83b99221f457497c9690fb8c13a0d793','c95ee11a6a44469f8e7db1a75f3aafb4','s-ready-storage','s-step','s-role'],answered='The response-only duplicate Ready retained its storage dependency in the measured execution: zero entries, one append work item, one attached positive acknowledgment and no immediate acknowledgment while storage was pending. The corrected observation completed all three deliveries and supplies the answering version for the bounds issue.',remaining=['Delayed append completion across an actual term transition has a separate validity question: Step rejects old-term entry stabilization but preserves snapshot completion; this schedule did not exercise that boundary.','Synchronous Ready ordering and read-request context retry semantics remain independent frontier items.'],understanding='unchanged',rationale='Retain this bounded result independently. Next follow delayed storage completion through the term transition and actual unstable-log consumer, where an old completion could otherwise discard a newer pending suffix. This extends source understanding at an already mapped A2/A6 connection rather than repeating the settled duplicate barrier.',question_updates={'d94b839a783246bf8997425e94ed2c35':dict(unknowns=['Unmeasured configurations, term transitions and physical crash durability remain outside the completed publication-dependency schedule.'],resume_conditions=[])}))\nPath('submission.json').write_text(json.dumps(sub,indent=2)+'\\\\n')\nr=json.load(open('../research.json')); x=subprocess.run(r['validation']['command']+['submission.json'],capture_output=True,text=True); print(x.stdout);print(x.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
