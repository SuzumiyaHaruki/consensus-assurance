{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfor l in open('../logs/2fadfea226ea44849ea7bdf5022f1caf/stdout.log'):\n r=json.loads(l)\n if 'CA_EVENT' in r.get('Output','') or r.get('Action')=='pass':print(r.get('Output',r))\np=json.load(open('../direct-checks/4a35f44714db44c3bb53d3471f771b90/plan.json'));print('properties',p['observable_properties']);print('prereq',p['harness']['prerequisites']);print('monitor',[(m['event'],m['admission_alias']) for m in p['monitors']])\nPY\ncat ../direct-checks/4a35f44714db44c3bb53d3471f771b90/assurance_generated_test.go\"","aggregated_output":"CA_EVENT {\"event\":\"before_read\",\"remaining_term\":3,\"removed_commit\":3,\"removed_role\":\"StateLeader\",\"removed_term\":2,\"step_down\":false,\"write_index\":5}\n\nCA_EVENT {\"eligible_support\":false,\"event\":\"after_read\",\"fresh_support\":0,\"own_voter\":false,\"read_count\":1,\"read_index\":3,\"released\":true,\"removed_role\":\"StateLeader\",\"step_down\":false,\"write_index\":5}\n\n{'Time': '2026-09-29T19:22:21.575567895+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Test': 'TestAssuranceRemovedLeaderRead/false', 'Elapsed': 0}\nCA_EVENT {\"event\":\"before_read\",\"remaining_term\":3,\"removed_commit\":3,\"removed_role\":\"StateFollower\",\"removed_term\":2,\"step_down\":true,\"write_index\":5}\n\nCA_EVENT {\"eligible_support\":false,\"event\":\"after_read\",\"fresh_support\":0,\"own_voter\":false,\"read_count\":0,\"read_index\":0,\"released\":false,\"removed_role\":\"StateFollower\",\"step_down\":true,\"write_index\":5}\n\n{'Time': '2026-09-29T19:22:21.575695125+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Test': 'TestAssuranceRemovedLeaderRead/true', 'Elapsed': 0}\n{'Time': '2026-09-29T19:22:21.575710195+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Test': 'TestAssuranceRemovedLeaderRead', 'Elapsed': 0}\n{'Time': '2026-09-29T19:22:21.575839924+08:00', 'Action': 'pass', 'Package': 'go.etcd.io/raft/v3', 'Elapsed': 0.015}\nproperties [{'checker_id': 'removed-safe-read-support', 'kind': 'event_implication', 'trigger': {'field': 'event', 'op': 'eq', 'value': 'after_read', 'reference': None}, 'assertion': {'field': 'released', 'op': 'eq', 'value': False, 'reference': None}, 'antecedent': {'field': 'eligible_support', 'op': 'eq', 'value': False, 'reference': None}, 'identity_fields': ['step_down'], 'history_field': None, 'description': 'Without local voter eligibility or fresh sole-voter support, no safe ReadState may be released; no-output is permitted.'}]\nprereq [{'alias': 'admitted', 'event': 'before_read', 'conditions': []}]\nmonitor [('after_read', 'admitted')]\npackage raft\n\nimport (\n \"encoding/json\"\n \"fmt\"\n \"testing\"\n pb \"go.etcd.io/raft/v3/raftpb\"\n)\n\ntype assurancePeer struct { rn *RawNode; storage *MemoryStorage }\ntype assuranceNetwork struct { t *testing.T; peers map[uint64]*assurancePeer; wire []pb.Message; reads map[uint64][]ReadState; delivered []pb.Message; applied map[uint64][]pb.Entry }\nfunc assuranceEmit(v map[string]interface{}) { b,err:=json.Marshal(v); if err!=nil { panic(err) }; fmt.Println(\"CA_EVENT \"+string(b)) }\nfunc (n *assuranceNetwork) must(err error) { n.t.Helper(); if err!=nil { n.t.Fatal(err) } }\nfunc (n *assuranceNetwork) appendWork(id uint64,m pb.Message) {\n p:=n.peers[id]\n if m.Snapshot!=nil { n.must(p.storage.ApplySnapshot(*m.Snapshot)) }\n n.must(p.storage.Append(m.Entries))\n hs:=pb.HardState{Term:m.Term,Vote:m.Vote,Commit:m.Commit}\n if !IsEmptyHardState(hs) { n.must(p.storage.SetHardState(hs)) }\n}\nfunc (n *assuranceNetwork) process(id uint64,rd Ready) {\n n.reads[id]=append(n.reads[id],rd.ReadStates...)\n for _,m:=range rd.Messages {\n  switch m.Type {\n  case pb.MsgStorageAppend:\n   n.appendWork(id,m); n.wire=append(n.wire,m.Responses...)\n  case pb.MsgStorageApply:\n   // Apply configuration entries through the public callback before completion.\n   for _,e:=range m.Entries {\n    if e.Type==pb.EntryConfChange { var cc pb.ConfChange; n.must(cc.Unmarshal(e.Data)); n.peers[id].rn.ApplyConfChange(cc) }\n    if e.Type==pb.EntryConfChangeV2 { var cc pb.ConfChangeV2; n.must(cc.Unmarshal(e.Data)); n.peers[id].rn.ApplyConfChange(cc) }\n    n.applied[id]=append(n.applied[id],e)\n   }\n   n.wire=append(n.wire,m.Responses...)\n  default: n.wire=append(n.wire,m)\n  }\n }\n}\nfunc (n *assuranceNetwork) drain() {\n for turn:=0;turn<500;turn++ {\n  work:=false\n  for _,id:=range []uint64{1,2} { p:=n.peers[id]; if p.rn.HasReady() { work=true; n.process(id,p.rn.Ready()) } }\n  if len(n.wire)>0 {\n   work=true; m:=n.wire[0]; n.wire=n.wire[1:]\n   n.delivered=append(n.delivered,m)\n   p:=n.peers[m.To]; if p==nil { n.t.Fatalf(\"unknown destination %d\",m.To) }; n.must(p.rn.Step(m))\n  }\n  if !work { return }\n }\n n.t.Fatal(\"schedule failed to quiesce within 500 transitions\")\n}\nfunc (n *assuranceNetwork) stored(id,index,term uint64,data []byte) bool {\n last,err:=n.peers[id].storage.LastIndex()\n n.must(err)\n if index>last { return false }\n es,err:=n.peers[id].storage.Entries(index,index+1,^uint64(0))\n return err==nil && len(es)==1 && es[0].Term==term && string(es[0].Data)==string(data)\n}\nfunc TestAssuranceRemovedLeaderRead(t *testing.T) {\n for _,stepDown:=range []bool{false,true} {\n  t.Run(fmt.Sprint(stepDown),func(t *testing.T){\n   n:=&assuranceNetwork{t:t,peers:map[uint64]*assurancePeer{},reads:map[uint64][]ReadState{},applied:map[uint64][]pb.Entry{}}\n   for _,id:=range []uint64{1,2} {\n    storage:=NewMemoryStorage()\n    n.must(storage.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{Index:1,Term:1,ConfState:pb.ConfState{Voters:[]uint64{1,2}}}}))\n    n.must(storage.SetHardState(pb.HardState{Term:1,Commit:1}))\n    rn,err:=NewRawNode(&Config{ID:id,Storage:storage,Applied:1,ElectionTick:10,HeartbeatTick:1,MaxSizePerMsg:4096,MaxInflightMsgs:16,AsyncStorageWrites:true,ReadOnlyOption:ReadOnlySafe,StepDownOnRemoval:stepDown})\n    n.must(err);n.peers[id]=&assurancePeer{rn:rn,storage:storage}\n   }\n   n.must(n.peers[1].rn.Campaign());n.drain()\n   n.must(n.peers[1].rn.ProposeConfChange(pb.ConfChange{Type:pb.ConfChangeRemoveNode,NodeID:1}));n.drain()\n   for _,id:=range []uint64{1,2} {\n    st:=n.peers[id].rn.Status()\n    if len(st.Config.Voters[0])!=1 {t.Fatal(\"not singleton after committed removal\")}\n    if _,ok:=st.Config.Voters[0][2];!ok {t.Fatal(\"remaining voter mismatch\")}\n   }\n   n.must(n.peers[2].rn.Campaign());n.drain()\n   if n.peers[2].rn.BasicStatus().RaftState!=StateLeader {t.Fatal(\"remaining voter did not become leader\")}\n   payload:=[]byte(\"post-removal-write\")\n   n.must(n.peers[2].rn.Propose(payload));n.drain()\n   writeIndex:=uint64(0)\n   for _,e:=range n.applied[2] {if string(e.Data)==string(payload){writeIndex=e.Index}}\n   if writeIndex==0 {t.Fatal(\"write application did not complete\")}\n   before:=n.peers[1].rn.BasicStatus()\n   assuranceEmit(map[string]interface{}{\"event\":\"before_read\",\"step_down\":stepDown,\"write_index\":writeIndex,\"removed_role\":before.RaftState.String(),\"removed_term\":before.Term,\"remaining_term\":n.peers[2].rn.BasicStatus().Term,\"removed_commit\":before.Commit})\n   deliveredBefore:=len(n.delivered)\n   n.peers[1].rn.ReadIndex([]byte(\"removed-read\"));n.drain()\n   freshSupport:=0\n   for _,m:=range n.delivered[deliveredBefore:] { if m.From==2 && m.To==1 && ((m.Type==pb.MsgHeartbeatResp && string(m.Context)==\"removed-read\") || (m.Type==pb.MsgReadIndexResp && len(m.Entries)==1 && string(m.Entries[0].Data)==\"removed-read\")) {freshSupport++} }\n   _,ownVoter:=n.peers[1].rn.Status().Config.Voters[0][1]\n   count:=0;readIndex:=uint64(0)\n   for _,r:=range n.reads[1] {if string(r.RequestCtx)==\"removed-read\" {count++;readIndex=r.Index}}\n   assuranceEmit(map[string]interface{}{\"event\":\"after_read\",\"step_down\":stepDown,\"released\":count>0,\"own_voter\":ownVoter,\"fresh_support\":freshSupport,\"eligible_support\":ownVoter || freshSupport>0,\"write_index\":writeIndex,\"read_count\":count,\"read_index\":readIndex,\"removed_role\":n.peers[1].rn.BasicStatus().RaftState.String()})\n  })\n }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The formal run measured the same discrepancy: with stepdown disabled, the removed node emitted one ReadState while `own_voter=false` and `fresh_support=0`. The enabled-stepdown control emitted none.\n\nThe scope remains the public `RawNode` API under continued calls after removal. An integration that stops serving removed nodes can avoid the path. The check did not observe a stale client value, and ReadIndex 3 versus applied index 5 was context—not the oracle.\n"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\nfrom pathlib import Path\nr=json.load(open('../research.json'));c=next(c for c in r['candidates'] if c.get('obligation_id')=='claim-removed-safe-read'); cid=c['id']\nss=['s-read-mode','s-read-contract','s-read-entry','s-confchange-api','s-removal-option','s-recovery-config','s-leader-entry','s-tracker','s-read-result','s-api','s-config','s-config-restore','s-storage-writes','s-async-config-contract']\nsub=dict(action='review',artifact_id='c63b27b22e0a438aa42519065b815ed0',rationale='Complete correspondence of the fixed authority-support check, preserving the public RawNode scope and distinguishing the measured discrepancy from client-level consequences.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ss,rationale='Reviewed artifact c63b27b22e0a438aa42519065b815ed0, its claim-removed-safe-read/binding-singleton-authority/unit v1 basis, and execution 2fadfea226ea44849ea7bdf5022f1caf. Applicability is the public ReadOnlySafe RawNode promise: quorum communication supports a request-specific safe barrier. ReadIndex has no stated local-membership precondition, ApplyConfChange requires applying committed removals, and StepDownOnRemoval is an optional role-demotion setting rather than a waiver of safe-read output semantics. Continuing to invoke the removed RawNode is an explicit scope condition; no external service routing contract is assumed. The driver creates a common compacted prefix through public MemoryStorage, actually campaigns node 1 and commits ConfChangeRemoveNode(1), applies that entry through actual MsgStorageApply callbacks on both nodes, and verifies their sole incoming voter is node 2. It then actually campaigns node 2 and observes application of its new write. This is one legal history per option, with no internal role/config/log assignment after public initialization. Async append writes and application finish before their Responses are queued, and FIFO processing preserves caller duties. Ticks are omitted only over this finite schedule; neither side needs timeout progress because Campaign is invoked explicitly. The read call follows the write application observation. before_read admits exactly one operation per step_down boolean, and after_read follows the actual API return plus complete drain of generated Ready/messages; this is completion of the library observation interval, not an assertion of successful client read completion. The boolean identity separates independent variants, not compared output values. own_voter is read from the installed config, fresh_support counts actual newly delivered context-matching messages from the sole voter, and released counts matching Ready.ReadStates. Neither support nor release is precomputed. The implication evaluates release only when independent eligibility/support is false, and permits no output. For step_down=false, execution reports StateLeader at term 2 after remaining voter is term 3, own_voter=false, fresh_support=0, eligible_support=false, released=true, read_count=1 and read_index=3. For true it reports StateFollower, no eligible support and released=false. Both subtests finish normally. In this actual history there is no hidden route for contemporaneous authority: the remaining singleton excludes node 1 from its protocol sends, and no fresh voter message is delivered during the read interval. Source switchToConfig retains leader role when false; IsSingleton tests cardinality only; the read branch immediately emits local commit. The paired option changes role and blocks this observed path. Thus the measured failure corresponds to the accepted local authority-support requirement. It does not rely on the stronger and unchecked oracle that every returned index must equal or exceed the later write index, nor infer global linearizability from those numbers.',counterevidence=[],limitations=['Continued API invocation after removal is necessary to reproduce this library behavior. Integrations that stop or stop routing reads to removed nodes can avoid it.','Intentional role retention with StepDownOnRemoval=false is allowed; the discrepancy concerns safe-read release under that role, not role retention itself.','The true control produces a permitted pending/lost read and is not evidence of guaranteed liveness or completed client read.','No stale application value or externally returned client response was observed. ReadIndex 3 versus later applied write 5 is supporting context, not a separate stale-read finding.','Scope is static singleton-after-removal with ReadOnlySafe, two initial voters and no crash. Joint transitions, physical persistence and other deployment modes remain unmeasured.','The common initial compacted prefix is constructed through documented public initialization; the removal, later election, write and read all execute in one subsequent history.'])],feedback=dict(ref_ids=['c63b27b22e0a438aa42519065b815ed0','2fadfea226ea44849ea7bdf5022f1caf','s-removal-option','s-recovery-config','s-leader-entry','s-tracker','s-read-contract'],answered='Formal execution measured a safe ReadState release by a removed RawNode without local voter eligibility or fresh support from the remaining sole voter when StepDownOnRemoval=false. The true-option control demoted the node and emitted no ReadState. This review attributes the comparison to the accepted library authority-support responsibility, without assigning a client stale-read consequence.',remaining=['A deployment-level stale-read claim would require its routing/removal policy, application barrier interpretation and actual returned value; those inputs are absent from this library-focused check.','Synchronous persistence ordering and version-qualified same-context retry applicability remain unresolved independent boundaries.'],understanding='unchanged',rationale='Preserve this completed local result independently of the two earlier bounded no-violation checks. The most informative wider discriminator would be an actual integrating application endpoint, but none is supplied as a selected authorized target in this snapshot. Further variations of this already measured singleton branch would not establish that missing deployment relation.',question_updates={cid:dict(unknowns=['Client-visible consequences and external removed-node routing/shutdown policy are outside the checked library requirement.','Other configurations and read modes remain unmeasured.'],resume_conditions=[])}))\nPath('submission.json').write_text(json.dumps(sub,indent=2)+'\\\\n')\nx=subprocess.run(r['validation']['command']+['submission.json'],capture_output=True,text=True);print(x.stdout);print(x.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
