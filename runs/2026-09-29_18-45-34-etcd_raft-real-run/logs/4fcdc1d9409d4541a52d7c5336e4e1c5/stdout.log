t_id\": {\n          \"title\": \"Artifact Id\",\n          \"type\": \"string\"\n        },\n        \"review_items\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/ArtifactReviewItem\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Review Items\",\n          \"type\": \"array\"\n        },\n        \"resolutions\": {\n          \"default\": [],\n          \"items\": {\n            \"$ref\": \"#/$defs/IssueResolution\"\n          },\n          \"title\": \"Resolutions\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"artifact_id\",\n        \"review_items\"\n      ],\n      \"title\": \"ReviewSubmission\",\n      \"type\": \"object\"\n    },\n    \"Scope\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"description\": {\n          \"title\": \"Description\",\n          \"type\": \"string\"\n        },\n        \"assumptions\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Assumptions\",\n          \"type\": \"array\"\n        },\n        \"excluded\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Excluded\",\n          \"type\": \"array\"\n        },\n        \"parameters\": {\n          \"additionalProperties\": true,\n          \"default\": {},\n          \"title\": \"Parameters\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"description\"\n      ],\n      \"title\": \"Scope\",\n      \"type\": \"object\"\n    },\n    \"SemanticSubmission\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"sources\": {\n          \"default\": [],\n          \"items\": {\n    