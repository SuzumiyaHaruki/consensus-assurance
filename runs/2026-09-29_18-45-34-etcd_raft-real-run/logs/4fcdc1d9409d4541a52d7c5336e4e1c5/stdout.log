.go\n../agent-source/rafttest/interaction_env_handler_deliver_msgs.go\n../agent-source/rafttest/interaction_env_handler_propose.go\n../agent-source/rafttest/interaction_env_handler_report_unreachable.go\n../agent-source/rafttest/network_test.go\n../agent-source/rafttest/interaction_env_handler_propose_conf_change.go\n../agent-source/rafttest/node.go\n../agent-source/rafttest/interaction_env_handler.go\n../agent-source/rafttest/interaction_env_handler_process_append_thread.go\n../agent-source/rafttest/interaction_env_handler_add_nodes.go\n../agent-source/rafttest/interaction_env_handler_tick.go\n../agent-source/rafttest/interaction_env_handler_compact.go\n../agent-source/rafttest/interaction_env_logger.go\n../agent-source/rafttest/interaction_env_handler_status.go\n../agent-source/rawnode_test.go\n../agent-source/.go-version\n../agent-source/README.md\n../agent-source/diff_test.go\n../agent-source/util.go\n../agent-source/.golangci.yaml\n../agent-source/scripts/fix.sh\n../agent-source/scripts/verify_genproto.sh\n../agent-source/scripts/test_lib.sh\n../agent-source/scripts/test.sh\n../agent-source/scripts/genproto.sh\n../agent-source/node_util_test.go\n../agent-source/state_trace.go\nfind: ‘standard output’: Broken pipe\nfind: write error\n/bin/bash: line 1: python: command not found\n","exit_code":127,"status":"failed"}}
