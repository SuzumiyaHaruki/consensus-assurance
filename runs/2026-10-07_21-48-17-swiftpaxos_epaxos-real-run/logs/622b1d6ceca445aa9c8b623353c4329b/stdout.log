ity\",\n      \"Automatic recovery timing or eventual completion\"\n    ],\n    \"parameters\": {\n      \"membership\": \"odd membership with configured f=(N-1)/2\",\n      \"thrifty\": true\n    }\n  },\n  \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_21-48-17-swiftpaxos_epaxos-real-run/logs/60e27f33b9834b7d87fa2fe866557a2e/stdout.log\",\n  \"parsing_errors\": [],\n  \"prerequisites\": {\n    \"status\": \"matched\",\n    \"reason\": \"Declared prerequisites established\",\n    \"matched_indices\": [\n      6\n    ],\n    \"alias_indices\": {\n      \"accepted\": 6\n    }\n  },\n  \"properties\": [\n    {\n      \"monitor_id\": \"monitor_accept_phase\",\n      \"checker_id\": \"accepted_phase\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        11\n      ],\n      \"valid_witness_indices\": [\n        11\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        11\n      ],\n      \"outside_applicability_indices\": [],\n      \"correlations\": {\n        \"11\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            6\n          ],\n          \"alias_indices\": {\n            \"accepted\": 6\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"Constructor-equivalent bounded in-memory replicas instead of New network startup; initialized fields follow S_init/S_base.\",\n    \"Actual SendMsg writes to bufio.Writer over bytes.Buffer rather than TCP. Decode uses registered message New/Unmarshal.\",\n    \"Handler calls use an explicit serial schedule; recovery trigger is injected for a known unresolved slot instead of waiting on the execution scanner timer.\",\n    \"No protocol field is patched after initialization; proposals and all later messages use implementation producers.\"\n  ],\n  \"conditions\": {\n    \"plan_uncertainties\": [\n      \"The checker does not compare command/attribute content; these are logged as counterevidence and diagnostics.\",\n      \"It does not observe the later recovery selection or full-cluster safety consequence.\",\n      \"PrepareReply codec value-ballot omission is a separate sourced lead, not checked here.\"\n    ],\n    \"grounding_unresolved\": [\n      \"No separate protocol specification is used; applicability rests on the internal acceptance and recovery interface semantics.\",\n      \"The local report discrepancy alone does not establish a global agreement violation.\",\n      \"No end-to-end TCP deployment or timed recovery loop is run.\",\n      \"Source execution goroutine races are outside this serial local handler property.\",\n      \"No separate protocol specification is used; applicability rests on the internal acceptance and recovery interface semantics.\",\n      \"The local report discrepancy alone does not establish a global agreement violation.\"\n    ],\n    \"review_limitations\": []\n  },\n  \"blockers\": [\n    \"Direct oracle correspondence is unreviewed\"\n  ],\n  \"boundaries\": [\n    \"Full-cluster agreement or application output divergence\",\n    \"Whether subsequent recovery actually selects a different tuple\",\n    \"Promise/value-ballot wire preservation as a separate responsibility\",\n    \"Automatic recovery timing or eventual completion\",\n    \"The checker does not compare command/attribute content; these are logged as counterevidence and diagnostics.\",\n    \"It does not observe the later recovery selection or full-cluster safety consequence.\",\n    \"PrepareReply codec value-ballot omission is a separate sourced lead, not checked here.\",\n    \"No separate protocol specification is used; applicability rests on the internal acceptance and recovery interface semantics.\",\n    \"The local report discrepancy alone does not establish a global agreement violation.\",\n    \"No end-to-end TCP deployment or timed recovery loop is run.\",\n    \"Source execution goroutine races are outside this serial local handler property.\"\n  ],\n  \"review_ids\": [],\n  \"execution_attribution\": null,\n  \"open_issue_ids\": [],\n  \"correspondence\": null,\n  \"reviewed_complete\": false,\n  \"bounded_complete\": true,\n  \"confirmed\": false,\n  \"outcome\": \"violated\",\n  \"level\": \"implementation_test\",\n  \"claim_id\": \"O_accepted_phase_report\",\n  \"claim_version\": 1,\n  \"framework_revision\": \"audit-products-v58\",\n  \"finding_ids\": {\n    \"accepted_phase\": \"02841e73b84b483a99ca3a995e5526c6\"\n  },\n  \"finding_id\": \"02841e73b84b483a99ca3a995e5526c6\"\n}\nclaims {\n  \"id\": \"O_accepted_phase_report\",\n  \"kind\": \"obligation\",\n  \"concern\": \"implementation_semantics\",\n  \"description\": \"After an acceptor admits an Accept for an existing uncommitted instance and acknowledges that request at its ballot, a subsequent successful higher-ballot Prepare must report that instance as ACCEPTED if no intervening protocol action has replaced its value or advanced its phase. This preserves the accepted-versus-preaccepted distinction required by recovery selection.\",\n  \"scope\": {\n    \"description\": \"Local acceptance-phase history exported by PrepareReply after admitted acceptance; no intervening value/phase change for the same instance.\",\n    \"assumptions\": [\n      \"Fixed non-Byzantine membership; requests are emitted by actual protocol producers.\",\n      \"No crash/restart or durable-store recovery in this history.\",\n      \"No concurrent mutation while a handler or its serialized reply is observed.\"\n    ],\n    \"excluded\": [\n      \"Full-cluster agreement or application output divergence\",\n      \"Whether subsequent recovery actually selects a different tuple\",\n      \"Promise/value-ballot wire preservation as a separate responsibility\",\n      \"Automatic recovery timing or eventual completion\"\n    ],\n    \"parameters\": {\n      \"membership\": \"odd membership with configured f=(N-1)/2\",\n      \"thrifty\": true\n    }\n  },\n  \"source\": \"Candidate derived from attributed implementation responsibilities\",\n  \"source_ids\": [\n    \"S_accept\",\n    \"S_accept_reply\",\n    \"S_prepare\",\n    \"S_recover_select\",\n    \"S_wire\",\n    \"S_try\"\n  ],\n  \"pending\": [],\n  \"assessment\": \"unassessed\",\n  \"candidate\": true,\n  \"grounding\": {\n    \"source_ids\": [\n      \"S_accept\",\n      \"S_accept_reply\",\n      \"S_prepare\",\n      \"S_recover_select\",\n      \"S_wire\",\n      \"S_try\"\n    ],\n    \"expectation_ids\": [\n      \"S_recover_select\",\n      \"S_try\",\n      \"S_accept_reply\",\n      \"S_wire\"\n    ],\n    \"binding_ids\": [\n      \"binding_accept_report\"\n    ],\n    \"derivation\": \"This is a local phase-history interface obligation, derived from the actual consumer rather than from the EPaxos name. The coordinator counts a matching-ballot AcceptReply as acceptance support (S_accept_reply). PrepareReply exposes Status as the phase of the retained value (S_wire, S_prepare). Recovery explicitly gives ACCEPTED a preservation branch before preacceptance/restart (S_recover_select 1228-1235,1255-1312), and S_try 1357-1360 states accepted history must not regress to preaccepted. Therefore an admitted and acknowledged Accept must establish acceptance that a later Prepare can recognize, absent an intervening value-changing request or decision. bal/vbal alone cannot substitute for Status at this consumer because its branch tests Status. This requirement concerns one acceptor report, not whether a quorum eventually decides a different value.\",\n    \"applicability\": \"Initialized fixed-membership EPaxos acceptor, non-durable operation, existing uncommitted command and admitted Accept with matching acknowledgment. No intervening request changes that same instance value/phase; next Prepare has a greater ballot. Independent instances may progress.\",\n    \"unresolved\": [\n      \"No separate protocol specification is used; applicability rests on the internal acceptance and recovery interface semantics.\",\n      \"The local report discrepancy alone does not establish a global agreement violation.\"\n    ],\n    \"conflicts\": [],\n    \"alternatives\": [\n      \"The original coordinator retains ACCEPTED status and other replicas could preserve the value during recovery.\",\n      \"Command and ordering fields may remain intact even if phase reporting fails.\"\n    ]\n  },\n  \"version\": 1\n}\n{\n  \"description\": \"Producer-derived slow acceptance followed by higher Prepare. Observe acknowledgment and report for the same (origin,instance,acceptor); compare only reported phase against ACCEPTED. Retain command/ordering attributes as diagnostics, not duplicate properties.\",\n  \"claim_id\": \"O_accepted_phase_report\",\n  \"binding_ids\": [\n    \"binding_accept_report\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./epaxos\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package epaxos\\n\\nimport (\\n \\\"bufio\\\"\\n \\\"bytes\\\"\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"sync\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/imdea-software/swiftpaxos/dlog\\\"\\n base \\\"github.com/imdea-software/swiftpaxos/replica\\\"\\n \\\"github.com/imdea-software/swiftpaxos/replica/defs\\\"\\n rpc \\\"github.com/imdea-software/swiftpaxos/rpc\\\"\\n \\\"github.com/imdea-software/swiftpaxos/state\\\"\\n)\\n\\n// Single-owner handler schedule. SendMsg and all message codecs are unchanged.\\n// Each directed link is a byte stream; receive consumes its next actual message.\\ntype assuranceNetwork struct {\\n replicas []*Replica\\n links [][]*bytes.Buffer\\n}\\n\\nfunc assuranceNewNetwork(n int) *assuranceNetwork {\\n net := &assuranceNetwork{replicas: make([]*Replica,n), links:make([][]*bytes.Buffer,n)}\\n for id:=0; id<n; id++ {\\n  br:= &base.Replica{Logger:dlog.New(\\\"\\\",false), N:n,F:(n-1)/2,Id:int32(id),\\n   Alive:make([]bool,n),PreferredPeerOrder:make([]int32,n),PeerWriters:make([]*bufio.Writer,n),\\n   State:state.InitState(),RPC:rpc.NewTableId(defs.RPC_TABLE),Stats:&defs.Stats{M:make(map[string]int)},\\n   ProposeChan:make(chan *defs.GPropose,16),Thrifty:true,Exec:true,Dreply:true}\\n  r:= &Replica{Replica:br, InstanceSpace:make([][]*Instance,n),crtInstance:make([]int32,n),\\n   CommittedUpTo:make([]int32,n),ExecedUpTo:make([]int32,n),conflicts:make([]map[state.Key]*InstPair,n),\\n   maxSeqPerKey:make(map[state.Key]int32),latestCPInstance:-1,clientMutex:new(sync.Mutex),\\n   instancesToRecover:make(chan *instanceId,16),maxRecvBallot:-1}\\n  r.exec=&Exec{r}\\n  r.prepareRPC=r.RPC.Register(new(Prepare),nil)\\n  r.prepareReplyRPC=r.RPC.Register(new(PrepareReply),nil)\\n  r.preAcceptRPC=r.RPC.Register(new(PreAccept),nil)\\n  r.preAcceptReplyRPC=r.RPC.Register(new(PreAcceptReply),nil)\\n  r.acceptRPC=r.RPC.Register(new(Accept),nil)\\n  r.acceptReplyRPC=r.RPC.Register(new(AcceptReply),nil)\\n  r.commitRPC=r.RPC.Register(new(Commit),nil)\\n  r.tryPreAcceptRPC=r.RPC.Register(new(TryPreAccept),nil)\\n  r.tryPreAcceptReplyRPC=r.RPC.Register(new(TryPreAcceptReply),nil)\\n  net.links[id]=make([]*bytes.Buffer,n)\\n  for peer:=0;peer<n;peer++ {\\n   r.InstanceSpace[peer]=make([]*Instance,16)\\n   r.crtInstance[peer]=-1;r.CommittedUpTo[peer]=-1;r.ExecedUpTo[peer]=-1\\n   r.conflicts[peer]=make(map[state.Key]*InstPair)\\n   r.PreferredPeerOrder[peer]=int32((id+1+peer)%n)\\n   r.Alive[peer]=peer!=id\\n   net.links[id][peer]=new(bytes.Buffer)\\n   r.PeerWriters[peer]=bufio.NewWriter(net.links[id][peer])\\n  }\\n  net.replicas[id]=r\\n }\\n return net\\n}\\n\\nfunc assuranceEvent(t *testing.T, fields map[string]any) {\\n t.Helper(); b,err:=json.Marshal(fields);if err!=nil {t.Fatal(err)}\\n fmt.Println(\\\"CA_EVENT \\\"+string(b))\\n}\\n\\nfunc (n *assuranceNetwork) receive(t *testing.T,from,to int) rpc.Serializable {\\n t.Helper()\\n stream:=n.links[from][to]\\n code,err:=stream.ReadByte();if err!=nil {t.Fatalf(\\\"missing message %d -> %d: %v\\\",from,to,err)}\\n pair,ok:=n.replicas[to].RPC.Get(code);if !ok {t.Fatalf(\\\"unknown message code %d\\\",code)}\\n msg:=pair.Obj.New();if err:=msg.Unmarshal(stream);err!=nil {t.Fatalf(\\\"decode %d -> %d: %v\\\",from,to,err)}\\n assuranceEvent(t,map[string]any{\\\"event\\\":\\\"delivery\\\",\\\"from\\\":from,\\\"to\\\":to,\\\"message_type\\\":fmt.Sprintf(\\\"%T\\\",msg),\\\"message\\\":msg})\\n return msg\\n}\\n\\nfunc assurancePropose(r *Replica, commandID int32, value string) {\\n r.handlePropose(&defs.GPropose{Propose:&defs.Propose{CommandId:commandID,ClientId:r.Id,\\n  Command:state.Command{Op:state.PUT,K:17,V:state.Value(value)}},Mutex:new(sync.Mutex)})\\n}\\n\\nfunc TestAssuranceAcceptedHistory(t *testing.T) {\\n n:=assuranceNewNetwork(5)\\n r0,r1,r2:=n.replicas[0],n.replicas[1],n.replicas[2]\\n // An independently proposed conflicting command remains pending at replica 1.\\n // Its broadcasts remain buffered; no message is dropped or forged.\\n assurancePropose(r1,101,\\\"prior\\\")\\n assurancePropose(r0,100,\\\"target\\\")\\n pa1,ok:=n.receive(t,0,1).(*PreAccept);if !ok {t.Fatal(\\\"expected PreAccept\\\")}\\n r1.handlePreAccept(pa1)\\n pa2,ok:=n.receive(t,0,2).(*PreAccept);if !ok {t.Fatal(\\\"expected PreAccept\\\")}\\n r2.handlePreAccept(pa2)\\n pr1,ok:=n.receive(t,1,0).(*PreAcceptReply);if !ok {t.Fatal(\\\"expected PreAcceptReply\\\")}\\n r0.handlePreAcceptReply(pr1)\\n pr2,ok:=n.receive(t,2,0).(*PreAcceptReply);if !ok {t.Fatal(\\\"expected PreAcceptReply\\\")}\\n r0.handlePreAcceptReply(pr2)\\n if r0.InstanceSpace[0][0].lb.status!=ACCEPTED {t.Fatal(\\\"producer did not enter slow acceptance\\\")}\\n a,ok:=n.receive(t,0,2).(*Accept);if !ok {t.Fatal(\\\"expected producer-generated Accept\\\")}\\n before:=r2.InstanceSpace[a.Replica][a.Instance]\\n if before==nil || before.Status>=COMMITTED || a.Ballot<before.bal {t.Fatal(\\\"Accept admission premise not met\\\")}\\n if a.Replica!=0 || a.Instance!=0 || len(before.Cmds)!=1 || string(before.Cmds[0].V)!=\\\"target\\\" {t.Fatal(\\\"wrong target identity or command\\\")}\\n r2.handleAccept(a)\\n ack,ok:=n.receive(t,2,0).(*AcceptReply);if !ok {t.Fatal(\\\"expected AcceptReply\\\")}\\n if ack.Replica!=a.Replica || ack.Instance!=a.Instance || ack.Ballot!=a.Ballot {t.Fatal(\\\"Accept was not acknowledged at its ballot\\\")}\\n // Consumption is real, but a single remote reply is not a five-node majority.\\n r0.handleAcceptReply(ack)\\n assuranceEvent(t,map[string]any{\\\"event\\\":\\\"accepted_ack\\\",\\\"origin\\\":a.Replica,\\\"instance\\\":a.Instance,\\\"acceptor\\\":2,\\n  \\\"ballot\\\":ack.Ballot,\\\"seq\\\":a.Seq,\\\"deps\\\":a.Deps,\\\"command\\\":\\\"target\\\",\\\"coordinator_accept_count\\\":r0.InstanceSpace[0][0].lb.acceptOKs,\\n  \\\"admitted\\\":true,\\\"expected_status\\\":ACCEPTED})\\n // Deliver the older message on link 1 -> 2 before the later Prepare.\\n seed,ok:=n.receive(t,1,2).(*PreAccept);if !ok {t.Fatal(\\\"expected pending independent PreAccept\\\")}\\n r2.handlePreAccept(seed)\\n seedReply,ok:=n.receive(t,2,1).(*PreAcceptReply);if !ok {t.Fatal(\\\"expected independent reply\\\")}\\n r1.handlePreAcceptReply(seedReply)\\n if r1.crtInstance[a.Replica]<a.Instance || r1.InstanceSpace[a.Replica][a.Instance].Status>=COMMITTED {t.Fatal(\\\"slot is not eligible for recovery scan\\\")}\\n // The recovery entry produces the next Prepare for the known stalled slot.\\n // No prepare replies are fed to the recovery coordinator: self-vbal selection\\n // is outside this local history-reporting proposition.\\n r1.startRecoveryForInstance(a.Replica,a.Instance)\\n prepare,ok:=n.receive(t,1,2).(*Prepare);if !ok {t.Fatal(\\\"expected generated Prepare\\\")}\\n if prepare.Replica!=a.Replica || prepare.Instance!=a.Instance || prepare.Ballot<=a.Ballot {t.Fatal(\\\"wrong recovery context\\\")}\\n r2.handlePrepare(prepare)\\n report,ok:=n.receive(t,2,1).(*PrepareReply);if !ok {t.Fatal(\\\"expected PrepareReply\\\")}\\n if report.AcceptorId!=2 || report.Replica!=a.Replica || report.Instance!=a.Instance || report.Ballot!=prepare.Ballot {t.Fatal(\\\"report identity/context mismatch\\\")}\\n assuranceEvent(t,map[string]any{\\\"event\\\":\\\"prepare_report\\\",\\\"origin\\\":report.Replica,\\\"instance\\\":report.Instance,\\\"acceptor\\\":report.AcceptorId,\\n  \\\"promise\\\":report.Ballot,\\\"value_ballot\\\":report.VBallot,\\\"status\\\":report.Status,\\\"seq\\\":report.Seq,\\\"deps\\\":report.Deps,\\\"commands\\\":report.Command,\\n  \\\"completed\\\":true})\\n // No workers, sockets, files, or timers were started. Pending byte streams are\\n // the explicit undelivered suffix of this finite schedule, not blocked workers.\\n}\\n\",\n    \"description\": \"TestAssuranceAcceptedHistory invokes unmodified handlers and codecs over per-directed-link byte streams. Emits admitted acknowledgment and actual serialized PrepareReply; no goroutines or resources needing asynchronous cleanup are started.\",\n    \"semantic_changes\": [\n      \"Constructor-equivalent bounded in-memory replicas instead of New network startup; initialized fields follow S_init/S_base.\",\n      \"Actual SendMsg writes to bufio.Writer over bytes.Buffer rather than TCP. Decode uses registered message New/Unmarshal.\",\n      \"Handler calls use an explicit serial schedule; recovery trigger is injected for a known unresolved slot instead of waiting on the execution scanner timer.\",\n      \"No protocol field is patched after initialization; proposals and all later messages use implementation producers.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"accepted\",\n        \"event\": \"accepted_ack\",\n        \"conditions\": [\n          {\n            \"field\": \"admitted\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"coordinator_accept_count\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S_init\",\n        \"S_base\",\n        \"S_propose\",\n        \"S_fast\",\n        \"S_attributes\",\n        \"S_send\",\n        \"S_accept\",\n        \"S_accept_reply\",\n        \"S_prepare\",\n        \"S_start_recovery\",\n        \"S_recovery_trigger\",\n        \"S_transport\",\n        \"S_receive\",\n        \"S_wire\",\n        \"S_rpc_codec\",\n        \"S_prepare_codec\",\n        \"S_preaccept_codec\",\n        \"S_client_types\"\n      ],\n      \"expectation_ids\": [\n        \"S_accept_reply\",\n        \"S_recover_select\"\n      ],\n      \"binding_ids\": [\n        \"binding_accept_report\"\n      ],\n      \"derivation\": \"The harness initializes five replicas with constructor-equivalent empty protocol arrays and fixed N=5,F=2,Thrifty=true,Dreply=true,Durable=false. Array/channel capacities are reduced to 16 with only two used slots; no target code is replaced. Actual handlePropose calls create a pending conflicting command on row 1 and target command on row 0. The coordinator receives two actual decoded PreAcceptReply messages with different attributes and emits Accept through unchanged SendMsg/Marshal. Replica 2 admits it, sends matching AcceptReply, and coordinator 0 consumes that reply. The older independent row-1 PreAccept on link 1->2 and its reply are delivered before Prepare, preserving that directed byte-stream order. Replica 1 already knows the target slot, with status below COMMITTED and crtInstance covering it, which is the execution scanner eligibility for eventual recovery. The harness directly schedules startRecoveryForInstance as the recovery event and does not claim a measured timer threshold. It delivers the emitted higher Prepare to replica 2 and decodes its actual response. No target-instance mutation occurs between admitted acceptance and Prepare, apart from Prepare raising its promise. Pending messages remain undelivered in a finite asynchronous prefix; this is not a claim of fair infinite execution. Every delivered protocol payload was serialized by the source implementation. No test expected status is written to protocol state.\",\n      \"applicability\": \"Single-owner deterministic handler schedule models one permitted finite dispatch ordering. Real socket startup, execution worker and wall-clock timer loops are omitted; local entry and known stalled-slot prerequisites are explicitly checked. No application execution or completion guarantee is assumed.\",\n      \"unresolved\": [\n        \"No end-to-end TCP deployment or timed recovery loop is run.\",\n        \"Source execution goroutine races are outside this serial local handler property.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Deferred messages may later repair global progress, but cannot retroactively change the completed PrepareReply.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor_accept_phase\",\n      \"checker_id\": \"accepted_phase\",\n      \"event\": \"prepare_report\",\n      \"binding_ids\": [\n        \"binding_accept_report\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S_accept\",\n          \"S_accept_reply\",\n          \"S_prepare\",\n          \"S_recover_select\",\n          \"S_wire\",\n          \"S_try\"\n        ],\n        \"expectation_ids\": [\n          \"S_recover_select\",\n          \"S_try\",\n          \"S_accept_reply\",\n          \"S_wire\"\n        ],\n        \"binding_ids\": [\n          \"binding_accept_report\"\n        ],\n        \"derivation\": \"This is a local phase-history interface obligation, derived from the actual consumer rather than from the EPaxos name. The coordinator counts a matching-ballot AcceptReply as acceptance support (S_accept_reply). PrepareReply exposes Status as the phase of the retained value (S_wire, S_prepare). Recovery explicitly gives ACCEPTED a preservation branch before preacceptance/restart (S_recover_select 1228-1235,1255-1312), and S_try 1357-1360 states accepted history must not regress to preaccepted. Therefore an admitted and acknowledged Accept must establish acceptance that a later Prepare can recognize, absent an intervening value-changing request or decision. bal/vbal alone cannot substitute for Status at this consumer because its branch tests Status. This requirement concerns one acceptor report, not whether a quorum eventually decides a different value.\",\n        \"applicability\": \"Initialized fixed-membership EPaxos acceptor, non-durable operation, existing uncommitted command and admitted Accept with matching acknowledgment. No intervening request changes that same instance value/phase; next Prepare has a greater ballot. Independent instances may progress.\",\n        \"unresolved\": [\n          \"No separate protocol specification is used; applicability rests on the internal acceptance and recovery interface semantics.\",\n          \"The local report discrepancy alone does not establish a global agreement violation.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"The original coordinator retains ACCEPTED status and other replicas could preserve the value during recovery.\",\n          \"Command and ordering fields may remain intact even if phase reporting fails.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"accepted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"accepted_phase\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"status\",\n        \"op\": \"eq\",\n        \"value\": 3,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"origin\",\n        \"instance\",\n        \"acceptor\"\n      ],\n      \"description\": \"For each acknowledged acceptance admitted by accepted_ack, its completed higher-Prepare report must retain ACCEPTED phase (constant 3 in S_wire). Identity is independent of the phase and changing ballot.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The checker does not compare command/attribute content; these are logged as counterevidence and diagnostics.\",\n    \"It does not observe the later recovery selection or full-cluster safety consequence.\",\n    \"PrepareReply codec value-ballot omission is a separate sourced lead, not checked here.\"\n  ]\n}     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t \"bufio\"\n     5\t \"bytes\"\n     6\t \"encoding/json\"\n     7\t \"fmt\"\n     8\t \"sync\"\n     9\t \"testing\"\n    10\t\n    11\t \"github.com/imdea-software/swiftpaxos/dlog\"\n    12\t base \"github.com/imdea-software/swiftpaxos/replica\"\n    13\t \"github.com/imdea-software/swiftpaxos/replica/defs\"\n    14\t rpc \"github.com/imdea-software/swiftpaxos/rpc\"\n    15\t \"github.com/imdea-software/swiftpaxos/state\"\n    16\t)\n    17\t\n    18\t// Single-owner handler schedule. SendMsg and all message codecs are unchanged.\n    19\t// Each directed link is a byte stream; receive consumes its next actual message.\n    20\ttype assuranceNetwork struct {\n    21\t replicas []*Replica\n    22\t links [][]*bytes.Buffer\n    23\t}\n    24\t\n    25\tfunc assuranceNewNetwork(n int) *assuranceNetwork {\n    26\t net := &assuranceNetwork{replicas: make([]*Replica,n), links:make([][]*bytes.Buffer,n)}\n    27\t for id:=0; id<n; id++ {\n    28\t  br:= &base.Replica{Logger:dlog.New(\"\",false), N:n,F:(n-1)/2,Id:int32(id),\n    29\t   Alive:make([]bool,n),PreferredPeerOrder:make([]int32,n),PeerWriters:make([]*bufio.Writer,n),\n    30\t   State:state.InitState(),RPC:rpc.NewTableId(defs.RPC_TABLE),Stats:&defs.Stats{M:make(map[string]int)},\n    31\t   ProposeChan:make(chan *defs.GPropose,16),Thrifty:true,Exec:true,Dreply:true}\n    32\t  r:= &Replica{Replica:br, InstanceSpace:make([][]*Instance,n),crtInstance:make([]int32,n),\n    33\t   CommittedUpTo:make([]int32,n),ExecedUpTo:make([]int32,n),conflicts:make([]map[state.Key]*InstPair,n),\n    34\t   maxSeqPerKey:make(map[state.Key]int32),latestCPInstance:-1,clientMutex:new(sync.Mutex),\n    35\t   instancesToRecover:make(chan *instanceId,16),maxRecvBallot:-1}\n    36\t  r.exec=&Exec{r}\n    37\t  r.prepareRPC=r.RPC.Register(new(Prepare),nil)\n    38\t  r.prepareReplyRPC=r.RPC.Register(new(PrepareReply),nil)\n    39\t  r.preAcceptRPC=r.RPC.Register(new(PreAccept),nil)\n    40\t  r.preAcceptReplyRPC=r.RPC.Register(new(PreAcceptReply),nil)\n    41\t  r.acceptRPC=r.RPC.Register(new(Accept),nil)\n    42\t  r.acceptReplyRPC=r.RPC.Register(new(AcceptReply),nil)\n    43\t  r.commitRPC=r.RPC.Register(new(Commit),nil)\n    44\t  r.tryPreAcceptRPC=r.RPC.Register(new(TryPreAccept),nil)\n    45\t  r.tryPreAcceptReplyRPC=r.RPC.Register(new(TryPreAcceptReply),nil)\n    46\t  net.links[id]=make([]*bytes.Buffer,n)\n    47\t  for peer:=0;peer<n;peer++ {\n    48\t   r.InstanceSpace[peer]=make([]*Instance,16)\n    49\t   r.crtInstance[peer]=-1;r.CommittedUpTo[peer]=-1;r.ExecedUpTo[peer]=-1\n    50\t   r.conflicts[peer]=make(map[state.Key]*InstPair)\n    51\t   r.PreferredPeerOrder[peer]=int32((id+1+peer)%n)\n    52\t   r.Alive[peer]=peer!=id\n    53\t   net.links[id][peer]=new(bytes.Buffer)\n    54\t   r.PeerWriters[peer]=bufio.NewWriter(net.links[id][peer])\n    55\t  }\n    56\t  net.replicas[id]=r\n    57\t }\n    58\t return net\n    59\t}\n    60\t\n    61\tfunc assuranceEvent(t *testing.T, fields map[string]any) {\n    62\t t.Helper(); b,err:=json.Marshal(fields);if err!=nil {t.Fatal(err)}\n    63\t fmt.Println(\"CA_EVENT \"+string(b))\n    64\t}\n    65\t\n    66\tfunc (n *assuranceNetwork) receive(t *testing.T,from,to int) rpc.Serializable {\n    67\t t.Helper()\n    68\t stream:=n.links[from][to]\n    69\t code,err:=stream.ReadByte();if err!=nil {t.Fatalf(\"missing message %d -> %d: %v\",from,to,err)}\n    70\t pair,ok:=n.replicas[to].RPC.Get(code);if !ok {t.Fatalf(\"unknown message code %d\",code)}\n    71\t msg:=pair.Obj.New();if err:=msg.Unmarshal(stream);err!=nil {t.Fatalf(\"decode %d -> %d: %v\",from,to,err)}\n    72\t assuranceEvent(t,map[string]any{\"event\":\"delivery\",\"from\":from,\"to\":to,\"message_type\":fmt.Sprintf(\"%T\",msg),\"message\":msg})\n    73\t return msg\n    74\t}\n    75\t\n    76\tfunc assurancePropose(r *Replica, commandID int32, value string) {\n    77\t r.handlePropose(&defs.GPropose{Propose:&defs.Propose{CommandId:commandID,ClientId:r.Id,\n    78\t  Command:state.Command{Op:state.PUT,K:17,V:state.Value(value)}},Mutex:new(sync.Mutex)})\n    79\t}\n    80\t\n    81\tfunc TestAssuranceAcceptedHistory(t *testing.T) {\n    82\t n:=assuranceNewNetwork(5)\n    83\t r0,r1,r2:=n.replicas[0],n.replicas[1],n.replicas[2]\n    84\t // An independently proposed conflicting command remains pending at replica 1.\n    85\t // Its broadcasts remain buffered; no message is dropped or forged.\n    86\t assurancePropose(r1,101,\"prior\")\n    87\t assurancePropose(r0,100,\"target\")\n    88\t pa1,ok:=n.receive(t,0,1).(*PreAccept);if !ok {t.Fatal(\"expected PreAccept\")}\n    89\t r1.handlePreAccept(pa1)\n    90\t pa2,ok:=n.receive(t,0,2).(*PreAccept);if !ok {t.Fatal(\"expected PreAccept\")}\n    91\t r2.handlePreAccept(pa2)\n    92\t pr1,ok:=n.receive(t,1,0).(*PreAcceptReply);if !ok {t.Fatal(\"expected PreAcceptReply\")}\n    93\t r0.handlePreAcceptReply(pr1)\n    94\t pr2,ok:=n.receive(t,2,0).(*PreAcceptReply);if !ok {t.Fatal(\"expected PreAcceptReply\")}\n    95\t r0.handlePreAcceptReply(pr2)\n    96\t if r0.InstanceSpace[0][0].lb.status!=ACCEPTED {t.Fatal(\"producer did not enter slow acceptance\")}\n    97\t a,ok:=n.receive(t,0,2).(*Accept);if !ok {t.Fatal(\"expected producer-generated Accept\")}\n    98\t before:=r2.InstanceSpace[a.Replica][a.Instance]\n    99\t if before==nil || before.Status>=COMMITTED || a.Ballot<before.bal {t.Fatal(\"Accept admission premise not met\")}\n   100\t if a.Replica!=0 || a.Instance!=0 || len(before.Cmds)!=1 || string(before.Cmds[0].V)!=\"target\" {t.Fatal(\"wrong target identity or command\")}\n   101\t r2.handleAccept(a)\n   102\t ack,ok:=n.receive(t,2,0).(*AcceptReply);if !ok {t.Fatal(\"expected AcceptReply\")}\n   103\t if ack.Replica!=a.Replica || ack.Instance!=a.Instance || ack.Ballot!=a.Ballot {t.Fatal(\"Accept was not acknowledged at its ballot\")}\n   104\t // Consumption is real, but a single remote reply is not a five-node majority.\n   105\t r0.handleAcceptReply(ack)\n   106\t assuranceEvent(t,map[string]any{\"event\":\"accepted_ack\",\"origin\":a.Replica,\"instance\":a.Instance,\"acceptor\":2,\n   107\t  \"ballot\":ack.Ballot,\"seq\":a.Seq,\"deps\":a.Deps,\"command\":\"target\",\"coordinator_accept_count\":r0.InstanceSpace[0][0].lb.acceptOKs,\n   108\t  \"admitted\":true,\"expected_status\":ACCEPTED})\n   109\t // Deliver the older message on link 1 -> 2 before the later Prepare.\n   110\t seed,ok:=n.receive(t,1,2).(*PreAccept);if !ok {t.Fatal(\"expected pending independent PreAccept\")}\n   111\t r2.handlePreAccept(seed)\n   112\t seedReply,ok:=n.receive(t,2,1).(*PreAcceptReply);if !ok {t.Fatal(\"expected independent reply\")}\n   113\t r1.handlePreAcceptReply(seedReply)\n   114\t if r1.crtInstance[a.Replica]<a.Instance || r1.InstanceSpace[a.Replica][a.Instance].Status>=COMMITTED {t.Fatal(\"slot is not eligible for recovery scan\")}\n   115\t // The recovery entry produces the next Prepare for the known stalled slot.\n   116\t // No prepare replies are fed to the recovery coordinator: self-vbal selection\n   117\t // is outside this local history-reporting proposition.\n   118\t r1.startRecoveryForInstance(a.Replica,a.Instance)\n   119\t prepare,ok:=n.receive(t,1,2).(*Prepare);if !ok {t.Fatal(\"expected generated Prepare\")}\n   120\t if prepare.Replica!=a.Replica || prepare.Instance!=a.Instance || prepare.Ballot<=a.Ballot {t.Fatal(\"wrong recovery context\")}\n   121\t r2.handlePrepare(prepare)\n   122\t report,ok:=n.receive(t,2,1).(*PrepareReply);if !ok {t.Fatal(\"expected PrepareReply\")}\n   123\t if report.AcceptorId!=2 || report.Replica!=a.Replica || report.Instance!=a.Instance || report.Ballot!=prepare.Ballot {t.Fatal(\"report identity/context mismatch\")}\n   124\t assuranceEvent(t,map[string]any{\"event\":\"prepare_report\",\"origin\":report.Replica,\"instance\":report.Instance,\"acceptor\":report.AcceptorId,\n   125\t  \"promise\":report.Ballot,\"value_ballot\":report.VBallot,\"status\":report.Status,\"seq\":report.Seq,\"deps\":report.Deps,\"commands\":report.Command,\n   126\t  \"completed\":true})\n   127\t // No workers, sockets, files, or timers were started. Pending byte streams are\n   128\t // the explicit undelivered suffix of this finite schedule, not blocked workers.\n   129\t}\n","exit_code":0,"status":"completed"}}
