          \"claim_id\": \"O_prepare_value_ballot\"\n        }\n      }\n    }\n  ],\n  \"pending_work\": [\n    {\n      \"id\": \"c1ed709a89224ed2aa4ed4b56ad7e25b\",\n      \"kind\": \"review_issue\",\n      \"source_ids\": [\n        \"S_prepare\",\n        \"S_prepare_codec\",\n        \"S_prepare_new\",\n        \"S_receive\",\n        \"S_recover_select\"\n      ],\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"review_issues\",\n        \"match\": {\n          \"id\": \"c1ed709a89224ed2aa4ed4b56ad7e25b\"\n        }\n      }\n    }\n  ],\n  \"review_issues\": [\n    {\n      \"conditions\": [],\n      \"resolution_basis\": {\n        \"condition_dispositions\": [],\n        \"issue_id\": \"c1ed709a89224ed2aa4ed4b56ad7e25b\",\n        \"source_ids\": [\n          \"S_prepare\",\n          \"S_prepare_codec\",\n          \"S_prepare_new\",\n          \"S_receive\",\n          \"S_recover_select\",\n          \"S_accept\",\n          \"S_wire\"\n        ],\n        \"evidence_ids\": [\n          \"60e27f33b9834b7d87fa2fe866557a2e\",\n          \"fe4123fad9df42eaa262ca8e63173da3\",\n          \"86de9f55ad84458b9ff6ce6afbac40da\"\n        ],\n        \"rationale\": \"The challenged broad interpretation was that Prepare faithfully transports local vbal. S_prepare_codec/S_prepare_new show that is false; map v2 records the distinction and the parent unknown explicitly retains downstream attribution with independent wire/self-vbal effects. O_accepted_phase_report v1 does not depend on vbal preservation: it compares Status=3 after an acknowledged Accept with a later report for the same instance. The exact retained run 60e27f33b9834b7d87fa2fe866557a2e has actual value ballot 0 and status 2, and the codec explicitly encodes/decodes Status. Its fixed harness uses real codec bytes and does not run recovery selection. Thus the field omission neither changes admission nor identity nor the observed status inequality. Resolve this issue as a challenge to applicability of that existing local result, while retaining the broad recovery-choice gap as an independent scope limit. No old driver is legalized by new input and no requirement, oracle or evidence is revised.\",\n        \"residual_issue_ids\": [],\n        \"scope_limitations\": [\n          \"The broader acceptance-history Candidate still cannot attribute a later recovery decision solely to the missing phase; global consequences remain untested.\",\n          \"PrepareReply value-ballot loss is independently assessed under O_prepare_value_ballot.\"\n        ]\n      },\n      \"prior_review_ids\": [],\n      \"parent_issue_id\": null,\n      \"challenged_components\": [],\n      \"id\": \"c1ed709a89224ed2aa4ed4b56ad7e25b\",\n      \"review_id\": \"5a2b2f345fc443bcb65aca976b19061d\",\n      \"target_id\": \"11ad458fb92b4f9ba03f0760f37a2a7f\",\n      \"target_version\": 1,\n      \"aspect\": \"applicability\",\n      \"source_ids\": [\n        \"S_prepare\",\n        \"S_prepare_codec\",\n        \"S_prepare_new\",\n        \"S_receive\",\n        \"S_recover_select\"\n      ],\n      \"explanation\": \"F_history: The broad acceptance-history question must not assume that the Prepare wire path transmits local vbal. The producer constructs it but the codec omits it; downstream outcome attribution needs this independent mechanism.; B_prepare_wire: The broad acceptance-history question must not assume that the Prepare wire path transmits local vbal. The producer constructs it but the codec omits it; downstream outcome attribution needs this independent mechanism.; A2: The broad acceptance-history question must not assume that the Prepare wire path transmits local vbal. The producer constructs it but the codec omits it; downstream outcome attribution needs this independent mechanism.; core_overview: The broad acceptance-history question must not assume that the Prepare wire path transmits local vbal. The producer constructs it but the codec omits it; downstream outcome attribution needs this independent mechanism.\",\n      \"disposition\": \"investigation\",\n      \"reason\": \"New implementation knowledge challenges the retained proposition; original observations remain unchanged\",\n      \"resolved_by\": \"1af41b1adb2145d29aba3e6f12ebecba\",\n      \"resolution_checks\": [\n        \"60e27f33b9834b7d87fa2fe866557a2e\"\n      ]\n    }\n  ]\n}\nfunc (r *Replica) startRecoveryForInstance(replica int32, instance int32) {\n\tinst := r.InstanceSpace[replica][instance]\n\tif inst == nil {\n\t\tinst = r.newInstanceDefault(replica, instance)\n\t\tr.InstanceSpace[replica][instance] = inst\n\t} else if inst.Status >= COMMITTED && inst.Cmds != nil {\n\t\tr.Printf(\"No need to recover %d.%d\", replica, instance)\n\t\treturn\n\t}\n\n\t// no TLA guidance here (some difference with the original implementation)\n\tvar proposals []*defs.GPropose = nil\n\tif inst.lb != nil {\n\t\tproposals = inst.lb.clientProposals\n\t}\n\tinst.lb = r.newLeaderBookkeepingDefault()\n\tlb := inst.lb\n\tlb.clientProposals = proposals\n\tlb.ballot = inst.vbal\n\tlb.seq = inst.Seq\n\tlb.cmds = inst.Cmds\n\tlb.deps = inst.Deps\n\tlb.status = inst.Status\n\tr.makeBallot(replica, instance)\n\n\tinst.bal = lb.lastTriedBallot\n\tinst.vbal = lb.lastTriedBallot\n\tpreply := &PrepareReply{\n\t\tr.Id,\n\t\treplica,\n\t\tinstance,\n\t\tinst.bal,\n\t\tinst.vbal,\n\t\tinst.Status,\n\t\tinst.Cmds,\n\t\tinst.Seq,\n\t\tinst.Deps}\n\n\tlb.prepareReplies = append(lb.prepareReplies, preply)\n\tlb.leaderResponded = r.Id == replica\n\n\tr.bcastPrepare(replica, instance)\n}\nfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n\tlb := inst.lb\n\n\tif preply.Ballot > r.maxRecvBallot {\n\t\tr.maxRecvBallot = preply.Ballot\n\t}\n\n\tif inst == nil || lb == nil || !lb.preparing {\n\t\treturn\n\t}\n\n\tif preply.Ballot != lb.lastTriedBallot {\n\t\tlb.nacks++\n\t\treturn\n\t}\n\n\tlb.prepareReplies = append(lb.prepareReplies, preply)\n\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n\t\treturn\n\t}\n\n\tlb.preparing = false\n\n\t// Deal with each sub-cases in order of the (corrected) TLA specification\n\t// only replies from the highest ballot are taken into account\n\t// 1 -> committed/executed\n\t// 2 -> accepted\n\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n\t// 6 -> none of the above\n\tpreAcceptCount := 0\n\tsubCase := 0\n\tallEqual := true\n\tfor _, element := range lb.prepareReplies {\n\t\tif element.VBallot >= lb.ballot {\n\t\t\tlb.ballot = element.VBallot\n\t\t\tlb.cmds = element.Command\n\t\t\tlb.seq = element.Seq\n\t\t\tlb.deps = element.Deps\n\t\t\tlb.status = element.Status\n\t\t}\n\t\tif element.AcceptorId == element.Replica {\n\t\t\tlb.leaderResponded = true\n\t\t}\n\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n\t\t\tpreAcceptCount++\n\t\t}\n\t}\n\n\tif lb.status >= COMMITTED { // 1\n\t\tsubCase = 1\n\t} else if lb.status == ACCEPTED { // 2\n","exit_code":0,"status":"completed"}}
