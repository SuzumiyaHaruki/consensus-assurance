{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_00-04-05-etcd_raft-real-run/ && python3 - <<'PY'\nimport json, os\ns = json.load(open('state.json'))\nmats = {m['id'] for m in s['materials']}\ncache = {}\ndef events(rid):\n    if rid not in cache:\n        p = f\\\"logs/{rid}/observations.json\\\"\n        cache[rid] = len(json.load(open(p))['events']) if os.path.exists(p) else None\n    return cache[rid]\nprobs, receipts = [], set()\ndef check(owner, rid, idxs):\n    n = events(rid)\n    if n is None:\n        probs.append(f\\\"{owner}: missing receipt {rid}\\\"); return\n    receipts.add(rid)\n    for i in idxs:\n        if not (0 <= i < n):\n            probs.append(f\\\"{owner}: index {i} out of range for {rid} (events={n})\\\")\nfor i in s['interpretations']:\n    for rid, idxs in (i.get('executions') or {}).items():\n        check(i['id'], rid, idxs)\n    for sid in (i.get('source_ids') or []):\n        if sid not in mats: probs.append(f\\\"{i['id']}: source {sid} missing\\\")\nfor k in s['knowledge']:\n    for rid, idxs in (k.get('executions') or {}).items():\n        check(k['id'], rid, idxs)\n    for sid in (k.get('source_ids') or []):\n        if sid not in mats: probs.append(f\\\"{k['id']}: source {sid} missing\\\")\nfor inv in s['investigations']:\n    for sid in (inv.get('source_ids') or []):\n        if sid not in mats: probs.append(f\\\"{inv['id']}: source {sid} missing\\\")\n# uncited executions: every experiment receipt should be cited somewhere\ncited = receipts\nallrec = set()\nfor f in os.listdir('logs'):\n    p = f\\\"logs/{f}/observations.json\\\"\n    if os.path.exists(p): allrec.add(f)\nprint('problems:', probs if probs else 'none')\nprint('receipts cited:', len(cited), '| receipts in logs:', len(allrec), '| uncited:', sorted(allrec - cited)[:10])\nprint('questions:', len(s['investigations']), '| interpretations:', len(s['interpretations']),\n      '| knowledge:', len(s['knowledge']), '| experiments:', len(s['experiments']), '| gaps:', len(s['gaps']))\nq_wo = [q['id'][:12] for q in s['investigations'] if not any(i['investigation_id']==q['id'] for i in s['interpretations'])]\nprint('questions without interpretation:', q_wo)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
