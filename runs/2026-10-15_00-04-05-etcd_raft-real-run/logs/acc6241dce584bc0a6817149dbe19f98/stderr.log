	otherHeartbeats := find(tick, pb.MsgHeartbeat, 3)
	if len(otherHeartbeats) != 1 {
		t.Fatalf("expected one heartbeat for node 3, got %d", len(otherHeartbeats))
	}
	if err := other.Step(otherHeartbeats[0]); err != nil {
		t.Fatalf("step heartbeat on 3: %v", err)
	}
	hb := heartbeats[0]
	if err := follower.Step(hb); err != nil {
		t.Fatalf("step heartbeat on 2: %v", err)
	}
	emit(map[string]any{
		"event": "heartbeat_delivered", "to": 2, "sender": 1,
		"term": hb.GetTerm(), "commit": hb.GetCommit(), "lead_after": lead(follower),
	})
