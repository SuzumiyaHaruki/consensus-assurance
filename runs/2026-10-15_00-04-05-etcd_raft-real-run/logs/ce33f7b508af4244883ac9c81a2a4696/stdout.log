{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/src/consensus_assurance; sed -n '1,120p' workflow/observations.py\"","aggregated_output":"\"\"\"Finite, non-evaluating event correlation and fully observed safety monitors.\"\"\"\nfrom consensus_assurance.core.types import Comparison\nfrom consensus_assurance.core.events import MISSING, field, compare, match_prerequisites, prerequisite_chain, comparison_requirements\n\n\ndef compare_events(events, comparison, requirements, comparison_index=0):\n    \"\"\"Keep existential witnesses separate from completeness of the observed scope.\"\"\"\n    results, missing, correlations, outside, diagnostics = [], [], {}, [], []\n    admission = None\n    admission_dependencies = []\n    admission_error = ''\n    selected = []\n    if requirements is not None:\n        try:\n            selected = comparison_requirements(comparison, requirements)\n            admission = next(r for r in selected if r.alias == comparison.admission_alias)\n            admission_dependencies = prerequisite_chain(selected,\n                [c.reference.partition('.')[0] for c in admission.conditions if c.reference])\n        except ValueError as exc:\n            admission_error = str(exc)\n    def gap(index, reason):\n        missing.append(index)\n        diagnostics.append({'event_index':index, 'identity':{k:field(events[index],k)\n            for k in comparison.identity_fields if field(events[index],k) is not MISSING}, 'reason':reason})\n    for index, event in enumerate(events):\n        if event.get('event') != comparison.event:\n            continue\n        independent = [c for c in comparison.applicability_conditions if not c.reference]\n        if any(compare(event,c) is False for c in independent):\n            outside.append(index)\n            continue\n        absent = [k for k in comparison.identity_fields if field(event,k) is MISSING]\n        absent += [c.field for c in independent if compare(event,c) is None]\n        if absent:\n            gap(index, 'Missing identity or applicability fields: '+', '.join(dict.fromkeys(absent)))\n            continue\n        aliases = {}\n        if requirements is not None:\n            linked = match_prerequisites(events, selected, index, comparison.identity_fields)\n            correlations[str(index)] = linked\n            if linked['status'] != 'matched':\n                gap(index, linked['reason'])\n                continue\n            aliases = {alias:events[i] for alias,i in linked['alias_indices'].items()}\n        applicability = [compare(event,c,aliases) for c in comparison.applicability_conditions if c.reference]\n        if any(value is False for value in applicability):\n            outside.append(index)\n            continue\n        if any(value is None for value in applicability):\n            gap(index, 'Missing alias-dependent applicability fields')\n            continue\n        value = compare(event,comparison.assertion,aliases)\n        if comparison.antecedent is not None:\n            antecedent = compare(event,comparison.antecedent,aliases) if comparison.antecedent else None\n            value = None if antecedent is None or value is None else not antecedent or value\n        if value is None:\n            gap(index, 'Missing required result fields: '+comparison.assertion.field+\n                (' or '+comparison.antecedent.field if comparison.antecedent else ''))\n        else:\n            results.append((index,value))\n    violations = [index for index,value in results if value is False]\n    # A missing result in the same operation can affect its witness. Unknown\n    # identity is not evidence of independence; distinct runner streams are.\n    def independent_operation(left, right):\n        a, b = events[left], events[right]\n        if a.get('_ca_stream') is not None and b.get('_ca_stream') is not None and a['_ca_stream'] != b['_ca_stream']:\n            return True\n        return any(field(a,k) is not MISSING and field(b,k) is not MISSING\n            and compare(a, Comparison(field=k,reference='other.'+k), {'other':b}) is False\n            for k in comparison.identity_fields)\n    for index,value in results:\n        if any(other != value and not independent_operation(index,j) for j,other in results):\n            gap(index, 'Contradictory same-operation result observations')\n    if admission and not admission_error:\n        for index,event in enumerate(events):\n            if event.get('event') != admission.event:continue\n            if any(compare(event,c) is False for c in admission.conditions if not c.reference):continue\n            aliases={}\n            if admission_dependencies:\n                linked=match_prerequisites(events,admission_dependencies,index,comparison.identity_fields)\n                if linked['status']!='matched':\n                    gap(index,'Operation admission history: '+linked['reason'])\n                    continue\n                aliases={alias:events[i] for alias,i in linked['alias_indices'].items()}\n            checks=[compare(event,c,aliases) for c in admission.conditions]\n            if any(v is False for v in checks):continue\n            if any(v is None for v in checks) or any(field(event,k) is MISSING for k in comparison.identity_fields):\n                gap(index, 'Missing operation admission fields or identity')\n                continue\n            if not any(r>index and event.get('_ca_stream')==events[r].get('_ca_stream') and\n                    all(field(event,k) is not MISSING and compare(event,Comparison(field=k,reference='result.'+k),{'result':events[r]}) is True for k in comparison.identity_fields)\n                    and (r in outside or correlations.get(str(r),{}).get('alias_indices',{}).get(admission.alias)==index)\n                    for r in [i for i,_ in results]+outside):\n                gap(index, 'Admitted operation has no complete applicable result observation')\n    valid = [index for index in violations if not admission_error and all(independent_operation(index,m) for m in missing)]\n    complete = bool(results) and not missing and not admission_error\n    limitations = [f\"Event {d['event_index']} {d['identity']}: {d['reason']}\" for d in diagnostics]\n    if admission_error:limitations.append(admission_error)\n    if not results and not missing:\n        limitations.append('No applicable completed result event was reached')\n    return {'comparison_index':comparison_index,\n        'outcome':'violated' if valid else 'unknown' if missing or not results or admission_error else 'holds',\n        'witness_indices':violations, 'valid_witness_indices':valid, 'witness_complete':bool(valid),\n        'comparison_complete':complete, 'missing_indices':sorted(set(missing)),\n        'evaluated_indices':[index for index,_ in results], 'outside_applicability_indices':outside,\n        'correlations':correlations, 'diagnostics':diagnostics, 'limitations':limitations,\n        'reason':'Independent applicability, correlated prerequisites and fully observed result comparison'}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/src/consensus_assurance; sed -n '1,120p' core/events.py; echo =====; sed -n '1,80p' workflow/experiments.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/src/consensus_assurance; sed -n '1,120p' core/events.py; echo =====; sed -n '1,80p' workflow/experiments.py\"","aggregated_output":"\"\"\"Bounded event lookup and correlation, independent of workflow and tools.\"\"\"\nfrom .types import EventRequirement, Comparison\nfrom .diagnostics import Diagnostic, DiagnosticError\n\nMISSING = object()\n\n\ndef field(event, path):\n    '''Retrieve a nested field from an event dictionary using dot-separated path.'''\n    value = event\n    for key in path.split('.'):\n        if not isinstance(value,dict) or key not in value:\n            return MISSING\n        value = value[key]\n    return value\n\n\ndef compare(event, condition, aliases=None):\n    '''Compare a field in an event against a condition, optionally using aliases for other events.'''\n    left = field(event,condition.field)\n    right = condition.value\n    if condition.reference:\n        alias, sep, path = condition.reference.partition('.')\n        if not sep or alias not in (aliases or {}): return None\n        right = field(aliases[alias],path) # type: ignore\n    if left is MISSING or right is MISSING: return None\n    equal = type(left) is type(right) and left == right\n    return equal if condition.op == 'eq' else not equal\n\n\ndef event_requirements(requirements, reference=None):\n    '''Order and validate a list of event requirements, ensuring unique aliases and no causal cycles.'''\n    requirements = [EventRequirement.model_validate(r) for r in requirements]\n    aliases = {r.alias for r in requirements}\n    if len(aliases) != len(requirements) or any(not a or '.' in a for a in aliases):\n        raise ValueError('Prerequisite aliases must be unique nonempty names')\n    references = [c.reference for r in requirements for c in r.conditions if c.reference]\n    if reference: references.append(reference)\n    if any(ref.partition('.')[0] not in aliases or not ref.partition('.')[2] for ref in references):\n        raise ValueError('Comparison references an unavailable prerequisite alias or field')\n    ordered, pending = [], list(requirements)\n    while pending:\n        ready = next((r for r in pending if all(not c.reference or c.reference.partition('.')[0] in {a.alias for a in ordered} for c in r.conditions)),None)\n        if ready is None: raise ValueError('Prerequisite references contain a causal cycle')\n        ordered.append(ready); pending.remove(ready)\n    return ordered\n\n\ndef prerequisite_chain(requirements, aliases):\n    \"\"\"Select explicitly used aliases and their transitive producer dependencies.\"\"\"\n    ordered = event_requirements(requirements)\n    wanted = set(aliases)\n    if not wanted <= {r.alias for r in ordered}:\n        raise ValueError('Use a declared admission alias and prerequisite references')\n    for req in reversed(ordered):\n        if req.alias in wanted:\n            wanted.update(c.reference.partition('.')[0] for c in req.conditions if c.reference)\n    return [r for r in ordered if r.alias in wanted]\n\n\ndef comparison_requirements(comparison, requirements):\n    conditions = [comparison.assertion, *comparison.applicability_conditions]\n    selected = prerequisite_chain(requirements, [comparison.admission_alias,\n        *(c.reference.partition('.')[0] for c in conditions if c.reference)])\n    for condition in conditions:\n        event_requirements(selected, condition.reference)\n    conflicts = [r.alias for r in selected if r.event == comparison.event]\n    if conflicts:\n        raise DiagnosticError([Diagnostic(code='comparison_prerequisites', category='semantic',\n            message='Result events cannot establish their own prerequisites; conflicting aliases: ' + ', '.join(conflicts),\n            details={'conflicting_aliases': conflicts, 'prerequisite_aliases': [r.alias for r in selected]})])\n    return selected\n\n\ndef match_prerequisites(events, requirements, witness_index=None, identity_fields=()):\n    '''Match a sequence of events against a set of ordered prerequisites, optionally using a witness event for identity checks.'''\n    if not requirements:\n        return {'status':'unknown','reason':'No correlated prerequisite specification','matched_indices':[], 'alias_indices':{}}\n    try: ordered = event_requirements(requirements)\n    except ValueError as exc:\n        return {'status':'unknown','reason':str(exc),'matched_indices':[], 'alias_indices':{}}\n    missing, matches, absent = False, [], set()\n    witness = events[witness_index] if witness_index is not None else None\n    witness_stream = witness.get('_ca_stream') if witness is not None else None\n    def search(step, indices):\n        nonlocal missing\n        if step == len(ordered):\n            matches.append(indices); return\n        req = ordered[step]\n        aliases = {alias:events[index] for alias,index in indices.items()}\n        predecessors = [indices[c.reference.partition('.')[0]] for c in req.conditions if c.reference]\n        selected_streams = {events[index].get('_ca_stream') for index in indices.values()}\n        for index,event in enumerate(events[:witness_index] if witness_index is not None else events):\n            if event.get('event') != req.event or index in indices.values(): continue\n            stream = event.get('_ca_stream')\n            if witness is not None and stream != witness_stream: continue\n            if selected_streams and stream not in selected_streams: continue\n            if any(index <= prior for prior in predecessors): continue\n            identity = [compare(event,Comparison(field=k,reference='witness.'+k),{'witness':witness}) for k in identity_fields] if witness is not None else []\n            if any(v is False for v in identity): continue\n            checks = identity + [compare(event,c,aliases) for c in req.conditions]\n            if any(v is False for v in checks): continue\n            if any(v is None for v in checks):\n                missing = True\n                absent.update(req.alias+'.'+k for k,v in zip(identity_fields,identity) if v is None)\n                absent.update(req.alias+'.'+c.field+(' / '+c.reference if c.reference else '')\n                    for c in req.conditions if compare(event,c,aliases) is None)\n                continue\n            search(step+1,{**indices,req.alias:index})\n            if len(matches) >= (2 if witness is not None else 1): return\n    search(0,{})\n    ambiguous = witness is not None and (len(matches)>1 or missing)\n    status = 'unknown' if ambiguous else 'matched' if matches else 'unknown' if missing else 'not_reached'\n    indices = matches[0] if status=='matched' else {}\n    reason = ('Ambiguous prerequisite association' if ambiguous else 'Declared prerequisites established' if indices\n        else 'Missing prerequisite fields' if missing else 'No corresponding prerequisite events reached: '+', '.join(r.alias+'/'+r.event for r in ordered))\n    return {'status':status,'reason':reason+('; missing '+', '.join(sorted(absent)) if absent else ''),\n        'matched_indices':list(indices.values()),'alias_indices':indices}\n=====\n\"\"\"Fixed inputs and finite observations; interpretations never rewrite executions.\"\"\"\nfrom pathlib import Path\nimport time\nfrom consensus_assurance.core.types import FixedExperiment, FailureAttribution\nfrom consensus_assurance.core.types import CheckRun, ExecutionStatus, Origin, now\nfrom consensus_assurance.core.events import event_requirements, match_prerequisites, comparison_requirements\nfrom consensus_assurance.core.diagnostics import Diagnostic, DiagnosticError\nfrom consensus_assurance.adapters.storage.files import write_json\nfrom consensus_assurance.adapters.storage.snapshot import capture\nfrom consensus_assurance.adapters.runners.experiment import run_experiment, extract_events, install_harness\nfrom .observations import compare_events\n\n\ndef artifact(state, id):\n    raw = next((a for a in state.experiments if a.id == id), None)\n    if raw is None:\n        raise ValueError('Unknown fixed experiment: ' + str(id))\n    return FixedExperiment.model_validate(raw)\n\n\ndef validate_basis(state, basis, implementation):\n    from .knowledge import require_sources, require_uses\n    from .locations import locate\n    require_sources(state, basis.source_ids)\n    require_uses(state, basis.knowledge)\n    if implementation is None or basis.harness.kind != implementation.harness_kind:\n        raise ValueError('Unsupported experiment harness')\n    materials = {m.id: m for m in state.materials}\n    for anchor in basis.anchors:\n        located, error = locate(anchor, materials)\n        if error:\n            raise ValueError(error)\n        from consensus_assurance.core.types import CodeAnchor\n        anchor.anchor = CodeAnchor.model_validate(located)\n    if basis.requirement:\n        missing = [name for name, present in (('responsibility', basis.responsibility.strip()),\n                                             ('anchors', basis.anchors)) if not present]\n        if missing:\n            raise DiagnosticError([Diagnostic(code='requirement_basis', category='semantic',\n                paths=['/experiment/' + name for name in missing], details={'missing_fields': missing},\n                message='A requirement needs sourced applicability reasoning in responsibility and verified code anchors; '\n                        'missing fields: ' + ', '.join(missing))])\n    declared = event_requirements(basis.harness.prerequisites)\n    for index, comparison in enumerate(basis.comparisons):\n        try:\n            comparison_requirements(comparison, declared)\n            conditions = comparison.applicability_conditions\n            assertion = comparison.assertion\n            if assertion.field in comparison.identity_fields:\n                raise ValueError('Compared value cannot establish independent operation identity')\n            if any(c.field == assertion.field for c in conditions):\n                raise ValueError('Applicability cannot filter on the compared result')\n            antecedent = comparison.antecedent\n            if antecedent and (antecedent.reference or antecedent.field in comparison.identity_fields or\n                    any(c.field == antecedent.field for c in conditions)):\n                raise ValueError('An observed antecedent cannot establish identity or applicability')\n        except ValueError as exc:\n            diagnostics = exc.diagnostics if isinstance(exc, DiagnosticError) else [\n                Diagnostic(code='comparison', category='semantic', message=str(exc))]\n            raise DiagnosticError([d.model_copy(update={\n                'paths': ['/experiment/comparisons/' + str(index)],\n                'details': {**d.details, 'comparison_index': index, 'event': comparison.event,\n                            'admission_alias': comparison.admission_alias},\n                'message': f'Comparison {index} (result event {comparison.event!r}, '\n                           f'admission alias {comparison.admission_alias!r}): {d.message}'})\n                for d in diagnostics]) from exc\n\n\ndef fixed_files(root, fixed, *, write=False):\n    folder = root / 'fixed-experiments' / fixed.id\n    values = {fixed.harness_filename: fixed.basis.harness.source, **fixed.basis.harness.files}\n    for name, value in values.items():\n        path = folder / name\n        if write:\n            path.parent.mkdir(parents=True, exist_ok=True)\n            if path.exists() and path.read_text() != value:\n                raise ValueError('Retained experiment bytes changed')\n            path.write_text(value)\n        elif (not path.is_file() or path.is_symlink() or\n                any(p.is_symlink() for p in path.parents if p.is_relative_to(root)) or path.read_text() != value):\n","exit_code":0,"status":"completed"}}
