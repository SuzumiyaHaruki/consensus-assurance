tity_fields=()):\n./core/events.py:99:            identity = [compare(event,Comparison(field=k,reference='witness.'+k),{'witness':witness}) for k in identity_fields] if witness is not None else []\n./core/events.py:105:                absent.update(req.alias+'.'+k for k,v in zip(identity_fields,identity) if v is None)\n./core/types.py:210:    identity_fields: list[str] = Field(min_length=1)\n./core/types.py:211:    admission_alias: str\n","exit_code":0,"status":"completed"}}
