{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_00-04-05-etcd_raft-real-run; python3 - <<'PY'\nimport json,os\nst=json.load(open('state.json'))\nruns={c['id']:c for c in st['checks']}\ncounts={}\nfor cid,c in runs.items():\n    p=os.path.join('logs',cid,'observations.json')\n    if os.path.isfile(p):\n        d=json.load(open(p)); counts[cid]=len(d.get('events',[]))\nbad=[]\nfor r in st['interpretations']:\n    d=r.get('record',r)\n    iid=d['id']\n    for cid,idxs in (d.get('executions') or {}).items():\n        if cid not in runs: bad.append((iid,cid,'missing receipt'))\n        elif cid not in counts: bad.append((iid,cid,'no observations'))\n        else:\n            for i in idxs:\n                if i>=counts[cid]: bad.append((iid,cid,f'index {i} >= {counts[cid]}'))\nprint('interpretations',len(st['interpretations']),'receipts with observations',len(counts))\nprint('problems',bad if bad else 'none')\n# also: fixed experiments referenced exist on disk\nfor e in st['experiments']:\n    d=e.get('record',e)\n    hid=d.get('id')\n    h=os.path.join('fixed-experiments',hid,'assurance_generated_test.go')\n    if not os.path.isfile(h): print('MISSING harness',hid)\nprint('experiments',len(st['experiments']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
