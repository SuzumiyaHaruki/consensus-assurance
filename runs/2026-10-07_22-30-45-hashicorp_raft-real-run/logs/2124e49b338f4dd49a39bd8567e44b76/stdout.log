{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../product-schemas.json'))['ConsensusAuditSpec'];print(json.dumps({k:v for k,v in s.items() if k\"'!='\"'\"'$defs'\"'},indent=2))\nfor k,v in s['\"'$defs'\"'].items():\n print('\\\\n'+k, 'required=',v.get('required'),json.dumps(v.get('properties',{})))\nPY\"","aggregated_output":"{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"version\": {\n      \"default\": 1,\n      \"title\": \"Version\",\n      \"type\": \"integer\"\n    },\n    \"target_profile\": {\n      \"$ref\": \"#/$defs/TargetProfile\"\n    },\n    \"activities\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/Activity\"\n      },\n      \"maxItems\": 7,\n      \"title\": \"Activities\",\n      \"type\": \"array\"\n    },\n    \"behaviors\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Behavior\"\n      },\n      \"title\": \"Behaviors\",\n      \"type\": \"array\"\n    },\n    \"facts\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Fact\"\n      },\n      \"title\": \"Facts\",\n      \"type\": \"array\"\n    },\n    \"surfaces\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Surface\"\n      },\n      \"title\": \"Surfaces\",\n      \"type\": \"array\"\n    },\n    \"core_overview\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CoreOverview\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"target_profile\"\n  ],\n  \"title\": \"ConsensusAuditSpec\",\n  \"type\": \"object\"\n}\n\nActivity required= ['class_id', 'applicability', 'purpose', 'realization_summary'] {\"class_id\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Class Id\", \"type\": \"string\"}, \"applicability\": {\"enum\": [\"applicable\", \"externalized\", \"not_applicable\", \"unknown\"], \"title\": \"Applicability\", \"type\": \"string\"}, \"purpose\": {\"title\": \"Purpose\", \"type\": \"string\"}, \"realization_summary\": {\"title\": \"Realization Summary\", \"type\": \"string\"}, \"entry_points\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Entry Points\", \"type\": \"array\"}, \"behavior_ids\": {\"description\": \"Derived from Behavior.primary_activity\", \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\", \"x-controller-derived\": true}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}}\n\nBehavior required= ['id', 'primary_activity', 'execution_owner', 'protocol_context', 'trigger', 'source_ids'] {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"primary_activity\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Primary Activity\", \"type\": \"string\"}, \"execution_owner\": {\"title\": \"Execution Owner\", \"type\": \"string\"}, \"protocol_context\": {\"title\": \"Protocol Context\", \"type\": \"string\"}, \"trigger\": {\"title\": \"Trigger\", \"type\": \"string\"}, \"legal_preconditions\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Legal Preconditions\", \"type\": \"array\"}, \"implementation_guards\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Implementation Guards\", \"type\": \"array\"}, \"reads\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Reads\", \"type\": \"array\"}, \"writes\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Writes\", \"type\": \"array\"}, \"durable_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Durable Effects\", \"type\": \"array\"}, \"external_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Effects\", \"type\": \"array\"}, \"important_branches\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Important Branches\", \"type\": \"array\"}, \"async_boundaries\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Async Boundaries\", \"type\": \"array\"}, \"produces_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Produces Fact Ids\", \"type\": \"array\"}, \"consumes_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Consumes Fact Ids\", \"type\": \"array\"}, \"cross_activity_effects\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee\", \"propertyNames\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"]}, \"title\": \"Cross Activity Effects\", \"type\": \"object\"}, \"existing_protections\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Existing Protections\", \"type\": \"array\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"description\": \"Unresolved implementation or interface relationships; check exclusions and execution progress belong to Scope/CheckRun\", \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}\n\nCoreOverview required= ['rationale'] {\"formation\": {\"$ref\": \"#/$defs/CorePath\"}, \"context\": {\"$ref\": \"#/$defs/CorePath\"}, \"connection\": {\"$ref\": \"#/$defs/CorePath\"}, \"open_details\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Open Details\", \"type\": \"array\"}, \"core_gaps\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Core Gaps\", \"type\": \"array\"}, \"status\": {\"default\": \"incomplete\", \"enum\": [\"incomplete\", \"usable\", \"blocked\"], \"title\": \"Status\", \"type\": \"string\"}, \"rationale\": {\"title\": \"Rationale\", \"type\": \"string\"}}\n\nCorePath required= None {\"explanation\": {\"default\": \"\", \"title\": \"Explanation\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Fact Ids\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}}\n\nFact required= ['id', 'meaning', 'identity', 'validity_context', 'representation', 'durability', 'recovery', 'source_ids'] {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"meaning\": {\"title\": \"Meaning\", \"type\": \"string\"}, \"identity\": {\"additionalProperties\": {\"type\": \"string\"}, \"title\": \"Identity\", \"type\": \"object\"}, \"established_by\": {\"description\": \"Derived from Behavior.produces_fact_ids; never infer an unread producer\", \"items\": {\"type\": \"string\"}, \"title\": \"Established By\", \"type\": \"array\", \"x-controller-derived\": true}, \"consumed_by\": {\"description\": \"Derived from Behavior.consumes_fact_ids\", \"items\": {\"type\": \"string\"}, \"title\": \"Consumed By\", \"type\": \"array\", \"x-controller-derived\": true}, \"validity_context\": {\"title\": \"Validity Context\", \"type\": \"string\"}, \"representation\": {\"items\": {\"type\": \"string\"}, \"title\": \"Representation\", \"type\": \"array\"}, \"invalidators\": {\"description\": \"Existing Behavior IDs only. Unread events or suspected invalidators belong in unknowns.\", \"items\": {\"type\": \"string\"}, \"title\": \"Invalidators\", \"type\": \"array\"}, \"reinterpreters\": {\"description\": \"Existing Behavior IDs only, not event descriptions or Activity IDs.\", \"items\": {\"type\": \"string\"}, \"title\": \"Reinterpreters\", \"type\": \"array\"}, \"durability\": {\"title\": \"Durability\", \"type\": \"string\"}, \"recovery\": {\"title\": \"Recovery\", \"type\": \"string\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"description\": \"Unknown establishment, consumption or validity in this implementation; known weak guarantees belong to meaning/context/durability\", \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}\n\nSurface required= ['entry_point', 'disposition', 'reason'] {\"entry_point\": {\"title\": \"Entry Point\", \"type\": \"string\"}, \"disposition\": {\"enum\": [\"mapped\", \"externalized\", \"infrastructure\", \"deferred\", \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"], \"title\": \"Disposition\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"high_consequence\": {\"default\": false, \"title\": \"High Consequence\", \"type\": \"boolean\"}}\n\nTargetProfile required= ['system_boundary'] {\"system_boundary\": {\"title\": \"System Boundary\", \"type\": \"string\"}, \"protocol_contexts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Protocol Contexts\", \"type\": \"array\"}, \"external_interfaces\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Interfaces\", \"type\": \"array\"}, \"ownership\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Ownership\", \"type\": \"array\"}, \"selection_injection\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Selection Injection\", \"type\": \"array\"}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}\n","exit_code":0,"status":"completed"}}
