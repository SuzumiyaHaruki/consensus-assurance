../agent-source/replication.go:614:func (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n../agent-source/replication.go:633:func appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n../agent-source/replication.go:646:func (r *Raft) handleStaleTerm(s *followerReplication) {\n../agent-source/replication.go:655:func updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n../agent-source/state.go:13:type RaftState uint32\n../agent-source/state.go:29:func (s RaftState) String() string {\n../agent-source/state.go:47:type raftState struct {\n../agent-source/state.go:79:func (r *raftState) getState() RaftState {\n../agent-source/state.go:84:func (r *raftState) setState(s RaftState) {\n../agent-source/state.go:89:func (r *raftState) getCurrentTerm() uint64 {\n../agent-source/state.go:93:func (r *raftState) setCurrentTerm(term uint64) {\n../agent-source/state.go:97:func (r *raftState) getLastLog() (index, term uint64) {\n../agent-source/state.go:105:func (r *raftState) setLastLog(index, term uint64) {\n../agent-source/state.go:112:func (r *raftState) getLastSnapshot() (index, term uint64) {\n../agent-source/state.go:120:func (r *raftState) setLastSnapshot(index, term uint64) {\n../agent-source/state.go:127:func (r *raftState) getCommitIndex() uint64 {\n../agent-source/state.go:131:func (r *raftState) setCommitIndex(index uint64) {\n../agent-source/state.go:135:func (r *raftState) getLastApplied() uint64 {\n../agent-source/state.go:139:func (r *raftState) setLastApplied(index uint64) {\n../agent-source/state.go:145:func (r *raftState) goFunc(f func()) {\n../agent-source/state.go:153:func (r *raftState) waitShutdown() {\n../agent-source/state.go:159:func (r *raftState) getLastIndex() uint64 {\n../agent-source/state.go:167:func (r *raftState) getLastEntry() (uint64, uint64) {\n../agent-source/snapshot.go:15:type SnapshotMeta struct {\n../agent-source/snapshot.go:45:type SnapshotStore interface {\n../agent-source/snapshot.go:63:type SnapshotSink interface {\n../agent-source/snapshot.go:72:func (r *Raft) runSnapshots() {\n../agent-source/snapshot.go:106:func (r *Raft) shouldSnapshot() bool {\n../agent-source/snapshot.go:125:func (r *Raft) takeSnapshot() (string, error) {\n../agent-source/snapshot.go:216:func (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n../agent-source/snapshot.go:252:func (r *Raft) compactLogs(snapIdx uint64) error {\n../agent-source/snapshot.go:264:func (r *Raft) removeOldLogs() error {\n../agent-source/fsm.go:16:type FSM interface {\n../agent-source/fsm.go:54:type BatchingFSM interface {\n../agent-source/fsm.go:74:type FSMSnapshot interface {\n../agent-source/fsm.go:86:func (r *Raft) runFSM() {\n../agent-source/fsm.go:269:func fsmRestoreAndMeasure(logger hclog.Logger, fsm FSM, source io.ReadCloser, snapshotSize int64) error {\n../agent-source/commitment.go:14:type commitment struct {\n../agent-source/commitment.go:35:func newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n../agent-source/commitment.go:53:func (c *commitment) setConfiguration(configuration Configuration) {\n../agent-source/commitment.go:67:func (c *commitment) getCommitIndex() uint64 {\n../agent-source/commitment.go:77:func (c *commitment) match(server ServerID, matchIndex uint64) {\n../agent-source/commitment.go:88:func (c *commitment) recalculate() {\n   960\t\t}\n   961\t}\n   962\t\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n   988\t\n   989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n   580\t\t\treturn err\n   581\t\t}\n   582\t\treturn nil\n   583\t}\n   584\t\n   585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n   634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n   635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n   636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n   637\t\n   638\t\tif !skipLegacy {\n   639\t\t\t// Duplicated information. Kept for backward compatibility.\n   640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n   641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n   642\t\t}\n   643\t}\n   644\t\n   645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n   878\t}\n   879\t\n   880\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   881\t// to prevent returning stale data from the FSM after the peer has lost\n   882\t// leadership.\n   883\tfunc (r *Raft) VerifyLeader() Future {\n   884\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   885\t\tverifyFuture := &verifyFuture{}\n   886\t\tverifyFuture.init()\n   887\t\tselect {\n   888\t\tcase <-r.shutdownCh:\n   889\t\t\treturn errorFuture{ErrRaftShutdown}\n   890\t\tcase r.verifyCh <- verifyFuture:\n   891\t\t\treturn verifyFuture\n   892\t\t}\n   893\t}\n   894\t\n   895\t// GetConfiguration returns the latest configuration. This may not yet be\n   896\t// committed. The main loop can access this directly.\n   897\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n   898\t\tconfigReq := &configurationsFuture{}\n   899\t\tconfigReq.init()\n   900\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n","exit_code":0,"status":"completed"}}
