{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '2210,2245p' ../agent-source/raft.go; cat ../agent-source/state.go; sed -n '660,741p' ../agent-source/net_transport.go; sed -n '100,170p' ../agent-source/log.go; sed -n '110,160p' ../agent-source/future.go; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']\nprint(json.dumps(s['CandidateSubmission'],indent=2))\nPY\"","aggregated_output":"\tr.setLeader(\"\", \"\")\n\tr.setState(Candidate)\n\tr.candidateFromLeadershipTransfer.Store(true)\n\trpc.Respond(&TimeoutNowResponse{}, nil)\n}\n\n// setLatestConfiguration stores the latest configuration and updates a copy of it.\nfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n\tr.configurations.latest = c\n\tr.configurations.latestIndex = i\n\tr.latestConfiguration.Store(c.Clone())\n}\n\n// setCommittedConfiguration stores the committed configuration.\nfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n\tr.configurations.committed = c\n\tr.configurations.committedIndex = i\n}\n\n// getLatestConfiguration reads the configuration from a copy of the main\n// configuration, which means it can be accessed independently from the main\n// loop.\nfunc (r *Raft) getLatestConfiguration() Configuration {\n\t// this switch catches the case where this is called without having set\n\t// a configuration previously.\n\tswitch c := r.latestConfiguration.Load().(type) {\n\tcase Configuration:\n\t\treturn c\n\tdefault:\n\t\treturn Configuration{}\n\t}\n}\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\n// RaftState captures the state of a Raft node: Follower, Candidate, Leader,\n// or Shutdown.\ntype RaftState uint32\n\nconst (\n\t// Follower is the initial state of a Raft node.\n\tFollower RaftState = iota\n\n\t// Candidate is one of the valid states of a Raft node.\n\tCandidate\n\n\t// Leader is one of the valid states of a Raft node.\n\tLeader\n\n\t// Shutdown is the terminal state of a Raft node.\n\tShutdown\n)\n\nfunc (s RaftState) String() string {\n\tswitch s {\n\tcase Follower:\n\t\treturn \"Follower\"\n\tcase Candidate:\n\t\treturn \"Candidate\"\n\tcase Leader:\n\t\treturn \"Leader\"\n\tcase Shutdown:\n\t\treturn \"Shutdown\"\n\tdefault:\n\t\treturn \"Unknown\"\n\t}\n}\n\n// raftState is used to maintain various state variables\n// and provides an interface to set/get the variables in a\n// thread safe manner.\ntype raftState struct {\n\t// currentTerm commitIndex, lastApplied,  must be kept at the top of\n\t// the struct so they're 64 bit aligned which is a requirement for\n\t// atomic ops on 32 bit platforms.\n\n\t// The current term, cache of StableStore\n\tcurrentTerm uint64\n\n\t// Highest committed log entry\n\tcommitIndex uint64\n\n\t// Last applied log to the FSM\n\tlastApplied uint64\n\n\t// protects 4 next fields\n\tlastLock sync.Mutex\n\n\t// Cache the latest snapshot index/term\n\tlastSnapshotIndex uint64\n\tlastSnapshotTerm  uint64\n\n\t// Cache the latest log from LogStore\n\tlastLogIndex uint64\n\tlastLogTerm  uint64\n\n\t// Tracks running goroutines\n\troutinesGroup sync.WaitGroup\n\n\t// The current state\n\tstate RaftState\n}\n\nfunc (r *raftState) getState() RaftState {\n\tstateAddr := (*uint32)(&r.state)\n\treturn RaftState(atomic.LoadUint32(stateAddr))\n}\n\nfunc (r *raftState) setState(s RaftState) {\n\tstateAddr := (*uint32)(&r.state)\n\tatomic.StoreUint32(stateAddr, uint32(s))\n}\n\nfunc (r *raftState) getCurrentTerm() uint64 {\n\treturn atomic.LoadUint64(&r.currentTerm)\n}\n\nfunc (r *raftState) setCurrentTerm(term uint64) {\n\tatomic.StoreUint64(&r.currentTerm, term)\n}\n\nfunc (r *raftState) getLastLog() (index, term uint64) {\n\tr.lastLock.Lock()\n\tindex = r.lastLogIndex\n\tterm = r.lastLogTerm\n\tr.lastLock.Unlock()\n\treturn\n}\n\nfunc (r *raftState) setLastLog(index, term uint64) {\n\tr.lastLock.Lock()\n\tr.lastLogIndex = index\n\tr.lastLogTerm = term\n\tr.lastLock.Unlock()\n}\n\nfunc (r *raftState) getLastSnapshot() (index, term uint64) {\n\tr.lastLock.Lock()\n\tindex = r.lastSnapshotIndex\n\tterm = r.lastSnapshotTerm\n\tr.lastLock.Unlock()\n\treturn\n}\n\nfunc (r *raftState) setLastSnapshot(index, term uint64) {\n\tr.lastLock.Lock()\n\tr.lastSnapshotIndex = index\n\tr.lastSnapshotTerm = term\n\tr.lastLock.Unlock()\n}\n\nfunc (r *raftState) getCommitIndex() uint64 {\n\treturn atomic.LoadUint64(&r.commitIndex)\n}\n\nfunc (r *raftState) setCommitIndex(index uint64) {\n\tatomic.StoreUint64(&r.commitIndex, index)\n}\n\nfunc (r *raftState) getLastApplied() uint64 {\n\treturn atomic.LoadUint64(&r.lastApplied)\n}\n\nfunc (r *raftState) setLastApplied(index uint64) {\n\tatomic.StoreUint64(&r.lastApplied, index)\n}\n\n// Start a goroutine and properly handle the race between a routine\n// starting and incrementing, and exiting and decrementing.\nfunc (r *raftState) goFunc(f func()) {\n\tr.routinesGroup.Add(1)\n\tgo func() {\n\t\tdefer r.routinesGroup.Done()\n\t\tf()\n\t}()\n}\n\nfunc (r *raftState) waitShutdown() {\n\tr.routinesGroup.Wait()\n}\n\n// getLastIndex returns the last index in stable storage.\n// Either from the last log or from the last snapshot.\nfunc (r *raftState) getLastIndex() uint64 {\n\tr.lastLock.Lock()\n\tdefer r.lastLock.Unlock()\n\treturn max(r.lastLogIndex, r.lastSnapshotIndex)\n}\n\n// getLastEntry returns the last index and term in stable storage.\n// Either from the last log or from the last snapshot.\nfunc (r *raftState) getLastEntry() (uint64, uint64) {\n\tr.lastLock.Lock()\n\tdefer r.lastLock.Unlock()\n\tif r.lastLogIndex >= r.lastSnapshotIndex {\n\t\treturn r.lastLogIndex, r.lastLogTerm\n\t}\n\treturn r.lastSnapshotIndex, r.lastSnapshotTerm\n}\n\tisHeartbeat := false\n\tvar labels []metrics.Label\n\tswitch rpcType {\n\tcase rpcAppendEntries:\n\t\tvar req AppendEntriesRequest\n\t\tif err := dec.Decode(&req); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trpc.Command = &req\n\n\t\tleaderAddr := req.RPCHeader.Addr\n\t\tif len(leaderAddr) == 0 {\n\t\t\tleaderAddr = req.Leader\n\t\t}\n\n\t\t// Check if this is a heartbeat\n\t\tif req.Term != 0 && leaderAddr != nil &&\n\t\t\treq.PrevLogEntry == 0 && req.PrevLogTerm == 0 &&\n\t\t\tlen(req.Entries) == 0 && req.LeaderCommitIndex == 0 {\n\t\t\tisHeartbeat = true\n\t\t}\n\n\t\tif isHeartbeat {\n\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"Heartbeat\"}}\n\t\t} else {\n\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"AppendEntries\"}}\n\t\t}\n\tcase rpcRequestVote:\n\t\tvar req RequestVoteRequest\n\t\tif err := dec.Decode(&req); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trpc.Command = &req\n\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"RequestVote\"}}\n\tcase rpcRequestPreVote:\n\t\tvar req RequestPreVoteRequest\n\t\tif err := dec.Decode(&req); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trpc.Command = &req\n\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"RequestPreVote\"}}\n\tcase rpcInstallSnapshot:\n\t\tvar req InstallSnapshotRequest\n\t\tif err := dec.Decode(&req); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trpc.Command = &req\n\t\trpc.Reader = io.LimitReader(r, req.Size)\n\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"InstallSnapshot\"}}\n\tcase rpcTimeoutNow:\n\t\tvar req TimeoutNowRequest\n\t\tif err := dec.Decode(&req); err != nil {\n\t\t\treturn err\n\t\t}\n\t\trpc.Command = &req\n\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"TimeoutNow\"}}\n\tdefault:\n\t\treturn fmt.Errorf(\"unknown rpc type %d\", rpcType)\n\t}\n\n\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"net\", \"rpcDecode\"}, decodeStart, labels)\n\n\tprocessStart := time.Now()\n\n\t// Check for heartbeat fast-path\n\tif isHeartbeat {\n\t\tn.heartbeatFnLock.Lock()\n\t\tfn := n.heartbeatFn\n\t\tn.heartbeatFnLock.Unlock()\n\t\tif fn != nil {\n\t\t\tfn(rpc)\n\t\t\tgoto RESP\n\t\t}\n\t}\n\n\t// Dispatch the RPC\n\tselect {\n\tcase n.consumeCh <- rpc:\n\tcase <-n.shutdownCh:\n\t\treturn ErrTransportShutdown\n\t}\n\n\t// logs are present on the leader which might impact follower's ability to\n\t// catch up after restoring a large snapshot. We should never rely on this\n\t// being in the past when appending on a follower or reading a log back since\n\t// the clock skew can mean a follower could see a log with a future timestamp.\n\t// In general too the leader is not required to persist the log before\n\t// delivering to followers although the current implementation happens to do\n\t// this.\n\tAppendedAt time.Time\n}\n\n// LogStore is used to provide an interface for storing\n// and retrieving logs in a durable fashion.\ntype LogStore interface {\n\t// FirstIndex returns the first index written. 0 for no entries.\n\tFirstIndex() (uint64, error)\n\n\t// LastIndex returns the last index written. 0 for no entries.\n\tLastIndex() (uint64, error)\n\n\t// GetLog gets a log entry at a given index.\n\tGetLog(index uint64, log *Log) error\n\n\t// StoreLog stores a log entry.\n\tStoreLog(log *Log) error\n\n\t// StoreLogs stores multiple log entries. By default the logs stored may not be contiguous with previous logs (i.e. may have a gap in Index since the last log written). If an implementation can't tolerate this it may optionally implement `MonotonicLogStore` to indicate that this is not allowed. This changes Raft's behaviour after restoring a user snapshot to remove all previous logs instead of relying on a \"gap\" to signal the discontinuity between logs before the snapshot and logs after.\n\tStoreLogs(logs []*Log) error\n\n\t// DeleteRange deletes a range of log entries. The range is inclusive.\n\tDeleteRange(min, max uint64) error\n}\n\n// MonotonicLogStore is an optional interface for LogStore implementations that\n// cannot tolerate gaps in between the Index values of consecutive log entries. For example,\n// this may allow more efficient indexing because the Index values are densely populated. If true is\n// returned, Raft will avoid relying on gaps to trigger re-synching logs on followers after a\n// snapshot is restored. The LogStore must have an efficient implementation of\n// DeleteLogs for the case where all logs are removed, as this must be called after snapshot restore when gaps are not allowed.\n// We avoid deleting all records for LogStores that do not implement MonotonicLogStore\n// because although it's always correct to do so, it has a major negative performance impact on the BoltDB store that is currently\n// the most widely used.\ntype MonotonicLogStore interface {\n\tIsMonotonic() bool\n}\n\nfunc oldestLog(s LogStore) (Log, error) {\n\tvar l Log\n\n\t// We might get unlucky and have a truncate right between getting first log\n\t// index and fetching it so keep trying until we succeed or hard fail.\n\tvar lastFailIdx uint64\n\tvar lastErr error\n\tfor {\n\t\tfirstIdx, err := s.FirstIndex()\n\t\tif err != nil {\n\t\t\treturn l, err\n\t\t}\n\t\tif firstIdx == 0 {\n\t\t\treturn l, ErrLogNotFound\n\t\t}\n\t\tif firstIdx == lastFailIdx {\n\t\t\t// Got same index as last time around which errored, don't bother trying\n\t\t\t// to fetch it again just return the error.\n\t\t\treturn l, lastErr\n\t\t}\n\t\terr = s.GetLog(firstIdx, &l)\n\t\tif err == nil {\n\t\t\t// We found the oldest log, break the loop\n\t\t\tbreak\n\t\t}\n\t\t// We failed, keep trying to see if there is a new firstIndex\n\tif d.errCh == nil {\n\t\tpanic(\"waiting for response on nil channel\")\n\t}\n\tselect {\n\tcase d.err = <-d.errCh:\n\tcase <-d.ShutdownCh:\n\t\td.err = ErrRaftShutdown\n\t}\n\treturn d.err\n}\n\nfunc (d *deferError) respond(err error) {\n\tif d.errCh == nil {\n\t\treturn\n\t}\n\tif d.responded {\n\t\treturn\n\t}\n\td.errCh <- err\n\tclose(d.errCh)\n\td.responded = true\n}\n\n// There are several types of requests that cause a configuration entry to\n// be appended to the log. These are encoded here for leaderLoop() to process.\n// This is internal to a single server.\ntype configurationChangeFuture struct {\n\tlogFuture\n\treq configurationChangeRequest\n}\n\n// bootstrapFuture is used to attempt a live bootstrap of the cluster. See the\n// Raft object's BootstrapCluster member function for more details.\ntype bootstrapFuture struct {\n\tdeferError\n\n\t// configuration is the proposed bootstrap configuration to apply.\n\tconfiguration Configuration\n}\n\n// logFuture is used to apply a log entry and waits until\n// the log is considered committed.\ntype logFuture struct {\n\tdeferError\n\tlog      Log\n\tresponse interface{}\n\tdispatch time.Time\n}\n\nfunc (l *logFuture) Response() interface{} {\n\treturn l.response\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nsrc('s-contract','README.md',71,99,'document_statement')\nsrc('s-apply-contract','docs/apply.md',1,10,'document_statement')\nsrc('s-config-contract','configuration.go',8,80,'interface_statement')\nsrc('s-config-change','configuration.go',140,308)\nsrc('s-transport','transport.go',17,110,'interface_statement')\nsrc('s-store','log.go',110,148,'interface_statement')\nsrc('s-stable','stable.go',5,19,'interface_statement')\nsrc('s-follower','raft.go',135,259)\nsrc('s-candidate','raft.go',285,440)\nsrc('s-election','raft.go',1976,2161)\nsrc('s-vote','raft.go',1603,1810)\nsrc('s-leader-setup','raft.go',455,580)\nsrc('s-repl-membership','raft.go',582,665)\nsrc('s-leader-loop','raft.go',667,961)\nsrc('s-verify-register','raft.go',963,987)\nsrc('s-lease','raft.go',1032,1094)\nsrc('s-config-append','raft.go',1200,1240)\nsrc('s-dispatch','raft.go',1242,1285)\nsrc('s-apply','raft.go',1287,1386)\nsrc('s-append','raft.go',1437,1600)\nsrc('s-commitment','commitment.go',11,104)\nsrc('s-replication','replication.go',127,295)\nsrc('s-repl-snapshot','replication.go',297,404)\nsrc('s-heartbeat','replication.go',406,468)\nsrc('s-pipeline','replication.go',470,613)\nsrc('s-repl-input','replication.go',615,681)\nsrc('s-repl-notify','replication.go',89,111)\nsrc('s-repl-result','replication.go',698,726)\nsrc('s-verify-future','future.go',236,293)\nsrc('s-future-contract','future.go',12,56,'interface_statement')\nsrc('s-verify-api','api.go',880,893,'interface_statement')\nsrc('s-client-api','api.go',802,877)\nsrc('s-fsm','fsm.go',15,262)\nsrc('s-recovery','api.go',495,705)\nsrc('s-install','raft.go',1810,1954)\nsrc('s-snapshot','snapshot.go',120,259)\nsrc('s-user-restore','raft.go',1096,1200)\nsrc('s-heartbeat-dispatch','net_transport.go',660,740)\nsrc('s-rpc-dispatch','raft.go',1388,1435)\nsrc('s-verify-tests','raft_test.go',1866,1974,'test_expectation')\nsrc('s-state','state.go',40,192)\nB=[]\ndef beh(i,act,owner,context,trigger,ss,**kw):\n d=dict(id=i,primary_activity=act,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss);d.update(kw);B.append(d)\nbeh('B-election','A2','Main Raft loop, with per-peer vote RPC workers','Latest voter configuration, one campaign channel per candidate attempt','Follower timeout or TimeoutNow; optional pre-vote before election',['s-follower','s-candidate','s-election','s-vote'],implementation_guards=['Only a local voter campaigns; remote requests reject ineligible known candidates, stale terms and less up-to-date logs. Known leader suppresses ordinary vote requests; leadership transfer bypasses that suppression.','Each attempt asks each configured voter once and owns a fresh buffered response channel. Real election persists term and self vote before counting self. Majority of latest voters wins.'],writes=['Persisted currentTerm; lastVoteTerm and lastVoteCand; role and known leader'],durable_effects=['Term is persisted before its in-memory update. Vote writes term and candidate separately before returning granted.'],async_boundaries=['Old campaign replies go to the abandoned attempt channel; request workers can finish after an election attempt ends.'],important_branches=['Higher response terms step down; election timeout retries; pre-vote does not persist a new term. Vote storage error denies that vote.'],cross_activity_effects={'A1':'Election freshness and persistent vote checks constrain which log may drive subsequent formation.'},unknowns=['Crash/error atomicity across separate vote-key writes has not been investigated.'])\nbeh('B-leader-lifetime','A2','Main Raft loop','One acquired leadership term','Election wins; runLeader initializes and defers cleanup',['s-leader-setup','s-repl-membership'],writes=['Fresh commitment object with startIndex=lastIndex+1; fresh commit channel, replication map, pending futures and stepDown channel'],external_effects=['Starts per-peer replicators and dispatches a current-term noop. On exit closes replication stop channels and responds ErrLeadershipLost to remaining inflight and verification futures.'],async_boundaries=['Replication workers retain the commitment and stepDown objects from their leader lifetime. Cleanup requests exit without synchronously joining every RPC.'],existing_protections=['A later term uses a different commitment object and notification channel, so delayed old replies cannot update that new tracker.'],cross_activity_effects={'A1':'A current-term noop and fresh support tracker connect authority acquisition to legal commit advancement.','A7':'Unresolved client operations get leadership-loss completion; operations already sent to the FSM have a separate completion owner.'})\nbeh('B-dispatch','A1','Leader main loop','Leader lifetime and latest local log','Accepted Apply or configuration entry or initial noop',['s-dispatch','s-client-api'],implementation_guards=['Leader loop rejects applies during transfer; nonleader loops reject client writes.'],writes=['Assigns monotonically increasing indices and current term; puts futures on inflight queue; updates cached last log after storage success'],durable_effects=['StoreLogs precedes local commitment.match.'],external_effects=['Notifies each replicator after successful local storage; storage failure returns errors and steps down.'],produces_fact_ids=['F-match'],unknowns=['Partial storage errors and post-failure configuration-append effects are unread fault cases.'])\nbeh('B-replicate','A1','Per-follower replication worker and pipeline decoder','Captured leader term and commitment object, current peer identity','New-log trigger, CommitTimeout, explicit catch-up request, pipeline response',['s-replication','s-pipeline','s-repl-input','s-repl-result'],implementation_guards=['Higher reply term signals the captured stepDown channel; failed normal replies reduce nextIndex and retry; successful nonempty append updates match only through the sent last entry.'],reads=['Leader commit index, durable logs, snapshot boundary, MaxAppendEntries'],writes=['Follower nextIndex; monotonic commitment match for the peer; last contact'],async_boundaries=['Normal transport request/reply or asynchronous pipeline futures; pipeline decoder is stopped before routine returns. Heartbeat is separate from disk-backed replication.'],important_branches=['Missing local log switches to snapshot transfer. CommitTimeout propagates commit position when client traffic stops.'],produces_fact_ids=['F-match'],cross_activity_effects={'A2':'Successful replies also call notifyAll(true); higher-term replies call notifyAll(false) and signal leadership loss.','A3':'Backtracking and snapshot fallback resynchronize lagging followers.'},unknowns=['Pipeline transport error/completion semantics and in-flight address replacement have not been fully traced.'])\nbeh('B-commitment','A1','Mutex-protected commitment object shared by leader and replicators','One leader lifetime; voter set from latest configuration','Local or follower match advances, or configuration changes',['s-commitment'],implementation_guards=['Only IDs in matchIndexes count; match indices only increase. Sorted voter indices select strict majority. Commit index advances only if quorum index reaches startIndex.'],writes=['matchIndexes and commitIndex under commitment mutex'],external_effects=['Nonblocking notification on commitCh only when commit index increases.'],consumes_fact_ids=['F-match'],produces_fact_ids=['F-commit-frontier'])\nbeh('B-leader-consume','A1','Leader main loop','Current leader lifetime','commitCh notification',['s-leader-loop','s-apply'],reads=['Current commitment frontier and inflight queue'],writes=['Raft commit index; committed configuration when crossed; removes committed inflight futures'],external_effects=['processLogs forwards committed entries to FSM; committed local removal causes shutdown or stepdown.'],consumes_fact_ids=['F-commit-frontier'],cross_activity_effects={'A4':'A committed configuration changes committed membership and can remove local leadership.','A5':'Committed log batches enter the FSM queue.','A7':'Command completion belongs to FSM processing after this enqueue, not to commitCh.'})\nbeh('B-append','A1','Follower RPC handler, usually main loop; empty fast heartbeat may be concurrent','Request term, previous-log identity, local log/snapshot and configuration','AppendEntries dispatch',['s-append','s-rpc-dispatch','s-heartbeat-dispatch'],implementation_guards=['Rejects old term and mismatching previous-log term/index; newer term makes follower; ordinary same-term append also makes nonfollower step down except transfer candidate.'],durable_effects=['Conflicting suffix is deleted; duplicate same-term entries skipped; new entries persisted before success.'],writes=['Leader identity, cached last log, latest/committed configuration, local commit index, last contact'],important_branches=['Commit advancement uses min(LeaderCommitIndex, local getLastIndex), not explicitly the last index checked by this request.','Truncating an uncommitted configuration restores the committed configuration before processing replacement entries.','Empty heartbeat fast path has previous index/term zero, no entries and commit index zero, so it cannot itself commit logs.'],external_effects=['processLogs enqueues newly considered committed entries before successful reply.'],cross_activity_effects={'A2':'Term/role and known-leader updates establish current request context.','A4':'Log conflict and received configuration entries alter participant eligibility.','A5':'Follower commitment directly drives FSM delivery.'},unknowns=['Whether a legal request can advertise a commit frontier beyond its checked prefix while a divergent local suffix remains; producer/backtracking and snapshot histories must be composed before alleging unsafe application.'])\nbeh('B-configuration','A4','Main loop, or constructor before startup','Latest and committed configuration with their log indices','Configuration API request, received configuration log, suffix replacement or snapshot reconstruction',['s-config-contract','s-config-change','s-config-append','s-repl-membership','s-append','s-recovery','s-install'],implementation_guards=['At least one voter; unique nonempty IDs and addresses; optional prevIndex compare. Leader admits next change only after latest configuration and a current-term entry are committed.'],writes=['Latest configuration immediately after leader append; commitment voter set reset retaining indices for surviving voter IDs; replication starts/stops for all configured peers.','Received later configuration implies previous configuration committed; suffix replacement falls back to committed config. Snapshot reconstruction supplies both configurations.'],cross_activity_effects={'A1':'Only voter IDs enter commitment match map; current membership changes eligible replication support.','A2':'Election quorum and leader lease use latest voter membership; nonvoters still have replication workers.'},unknowns=['Address changes and removal/readdition with outstanding replication replies remain unexamined.'])\nbeh('B-fsm','A5','Dedicated runFSM goroutine','Ordered committed tuples; snapshot restore boundary','fsmMutateCh command batch or restore future',['s-apply','s-fsm','s-future-contract'],implementation_guards=['processLogs skips indices already submitted using Raft.lastApplied. FSM Apply/Snapshot/Restore execution is serialized.'],writes=['FSM state and FSM-local lastIndex/term; command future response'],external_effects=['Calls deterministic client FSM Apply/ApplyBatch; responds after application. Barrier bypasses application but finishes behind earlier work. ConfigurationStore is optional.'],async_boundaries=['Raft.lastApplied advances after enqueue; it is distinct from FSM-local completion. Snapshots use FSM-local completed index.'],cross_activity_effects={'A7':'ApplyFuture.Error completion precedes legal Response/Index access.','A6':'Snapshots capture completed FSM state, not just leader commitment.'})\nbeh('B-recovery','A3','Constructor before startup; main loop install handler and FSM restore owner','Snapshot index/term and configuration plus retained log suffix','NewRaft restart or InstallSnapshot request',['s-recovery','s-install','s-repl-snapshot','s-store','s-state'],implementation_guards=['Constructor reads durable term and log end; tries snapshots newest first and scans later logs for configurations. Install rejects older terms or unsupported snapshot versions; verifies stream size and completes restore future before success.'],writes=['Last-applied and last-snapshot coordinates, latest/committed configurations; replication success advances peer nextIndex/match to snapshot index.'],external_effects=['FSM restore discards previous state; old logs compacted, or all removed for monotonic store.'],produces_fact_ids=['F-match'],cross_activity_effects={'A1':'A successful installed snapshot supplies peer match support through its index.','A2':'Recovered history and term constrain the next campaign freshness; incoming newer snapshot term changes authority.','A4':'Snapshot configuration reconstructs participant eligibility.'},unknowns=['Same-term delayed/duplicate snapshot delivery and retained conflicting suffix histories have not been reconstructed.'])\nbeh('B-snapshot','A6','Snapshot goroutine, synchronized with FSM and main-loop configuration request','Completed FSM prefix and committed configuration','Periodic threshold or public Snapshot',['s-snapshot','s-fsm'],implementation_guards=['Snapshot prefix must be at least the committed configuration index. FSM snapshot future and configuration future supply their respective owner snapshots.'],durable_effects=['Creates and persists snapshot with configuration, finalizes sink, then compacts logs.'],external_effects=['Always releases obtained FSMSnapshot.'],cross_activity_effects={'A3':'Retained snapshots are replay/rejoin inputs.','A1':'Compaction makes missing-log replication take snapshot fallback.'})\nbeh('B-user-restore','A3','Leader main loop plus FSM goroutine','Explicit caller restore of external backup','Restore request while leader',['s-user-restore','s-leader-loop'],implementation_guards=['Rejects during leadership transfer or while configuration uncommitted; checks version and exact size.'],writes=['Uses current configuration and term; burns an index greater than old/snapshot index; updates lastLog, lastApplied and lastSnapshot after FSM restore.'],external_effects=['Aborts inflight applies with ErrAbortedByRestore; gaps or monotonic-store log deletion cause follower snapshot catch-up.'],cross_activity_effects={'A7':'This explicit operation intentionally replaces prior application history; ordinary replication must not be judged as if it were this caller-authorized reset.'})\nbeh('B-verify-admit','A2','Leader main loop','One VerifyLeader future and voter-count quorum at admission','Public VerifyLeader enqueues a new future; leaderLoop calls verifyLeader',['s-verify-api','s-verify-register','s-leader-loop','s-lease','s-repl-membership'],writes=['votes=1 for self; quorumSize from number of configured voters; tracks future and registers it in every replication worker notify map.'],implementation_guards=['Follower/candidate requests fail. Single-voter threshold succeeds immediately.'],external_effects=['For larger quorum asynchronously notifies each registered worker to heartbeat.'],produces_fact_ids=['F-verify-tally'],cross_activity_effects={'A4':'Threshold filters by Voter while registration iterates replState, populated for all peer suffrages.'})\nbeh('B-verify-notify','A2','Replication/heartbeat workers; verifyFuture.vote protected by voteLock','A pending future registered on a peer worker','Successful append/snapshot, heartbeat reply or newer-term replication failure calls notifyAll',['s-repl-notify','s-repl-result','s-heartbeat','s-repl-snapshot','s-verify-future'],writes=['notifyAll swaps peer notify map under notifyLock, then calls vote on each future; vote increments votes on true.'],implementation_guards=['nil notifyCh suppresses callbacks after a result has already been signaled; one notify-map entry per future per worker.'],external_effects=['On threshold or false callback sends same future to verifyCh then clears notifyCh.'],important_branches=['Transport heartbeat errors do not vote; a successful RPC passes resp.Success. Snapshot/append success also provides true notifications. No peer ID or suffrage is passed into vote.'],produces_fact_ids=['F-verify-tally'],unknowns=['Whether nonvoter-only positive callbacks can be consumed as successful leader verification under a legal partition/schedule despite voter-only lease enforcement.'])\nbeh('B-verify-complete','A2','Leader main loop','Requeued VerifyLeader future','Receives future with nonzero quorumSize',['s-leader-loop','s-verify-register','s-verify-future'],reads=['votes and quorumSize'],external_effects=['Below threshold steps down and returns ErrNotLeader; at threshold returns nil; both remove pending registrations. Leader exit returns ErrLeadershipLost for pending verification.'],consumes_fact_ids=['F-verify-tally'],cross_activity_effects={'A7':'nil future result is public confirmation used to avoid stale reads per VerifyLeader documentation.'})\nbeh('B-lease','A2','Leader main loop','Latest voter configuration; local LeaderLeaseTimeout','Lease timer',['s-lease','s-leader-loop','s-heartbeat'],implementation_guards=['Only voters with recent contact count, including local voter; lack of majority steps down.'],reads=['Per-worker synchronized lastContact'],external_effects=['Periodic stepdown independently bounds local leadership retention after contact loss.'],unknowns=['Ordering of lease checks relative to a newly admitted verification can matter; a later lease failure does not by itself establish correctness of an earlier successful verification.'])\nF=[dict(id='F-match',meaning='For each voter ID tracked by one commitment object, the highest index reported matched by local successful storage, successful append reply, or successful snapshot installation; reports increase monotonically within that tracker.',identity={'owner':'commitment object belonging to one leader lifetime','peer':'ServerID'},validity_context='Eligible only while that object is consumed by its leader lifetime and the ID remains a voter in its current matchIndexes. This accounting assertion does not prove durable storage correctness.',representation=['commitment.matchIndexes[ServerID]'],invalidators=['B-leader-lifetime'],reinterpreters=['B-configuration'],durability='Volatile support accounting; reported log/snapshot data resides in injected stores.',recovery='New leadership creates zero-valued support for configured voters and collects fresh reports.',source_ids=['s-commitment','s-dispatch','s-repl-result','s-repl-snapshot','s-leader-setup']),dict(id='F-commit-frontier',meaning='The commitment object has computed a strict-majority voter match index at or above its first current-term log index, and retains the greatest such index.',identity={'owner':'commitment object / leadership lifetime'},validity_context='Computed over latest configured voters; valid consumption is by the leader main loop owning this object. It is a support-derived index, not FSM completion.',representation=['commitment.commitIndex','commitment.startIndex'],invalidators=['B-leader-lifetime'],reinterpreters=['B-configuration'],durability='Volatile; actual logs and snapshots are durable through their stores.',recovery='Recomputed in each leader lifetime; prior decided history constrains elections via retained log/snapshot and voting freshness.',source_ids=['s-commitment','s-leader-setup','s-leader-loop','s-vote']),dict(id='F-verify-tally',meaning='One verification future records its initial self count plus affirmative notifyAll callbacks received before its notification channel is cleared; quorumSize was computed from the voter count at admission. The tally itself carries no participant identity or suffrage.',identity={'operation':'verifyFuture object','owner':'leader lifetime registering the future'},validity_context='Pending verification registered by verifyLeader; callback count is interpreted by leaderLoop against captured quorumSize. It does not itself assert that every callback came from a voter or that a voter majority confirmed authority.',representation=['verifyFuture.votes','verifyFuture.quorumSize','verifyFuture.notifyCh','followerReplication.notify'],invalidators=['B-leader-lifetime'],reinterpreters=[],durability='Volatile per-request state.',recovery='Pending futures receive leadership-loss error on leader exit; fresh calls allocate new futures.',source_ids=['s-verify-register','s-repl-notify','s-verify-future','s-leader-loop'])]\nactivities=[]\nentries={\n'A1':('Form and propagate committed log decisions','Leader storage and replication reports feed a voter-only commitment tracker; current-term threshold admits commit advancement; followers accept leader commit positions after prefix checks.',['Raft.dispatchLogs','commitment.recalculate','Raft.appendEntries'],['s-dispatch','s-commitment','s-append']),\n'A2':('Acquire and maintain authority in an eligible context','Term-persistent elections use voter membership and log freshness; leader lifetimes isolate support and pending work. VerifyLeader and lease are distinct authority consumers.',['Raft.runCandidate','Raft.requestVote','Raft.runLeader','Raft.verifyLeader','Raft.checkLeaderLease'],['s-candidate','s-vote','s-leader-setup','s-verify-register','s-lease']),\n'A3':('Recover eligible participation','Constructor and follower snapshot installation reconstruct state; replication backs up or installs snapshots; explicit user restore is a separate caller-authorized replacement.',['NewRaft','Raft.installSnapshot','Raft.restoreUserSnapshot'],['s-recovery','s-install','s-user-restore']),\n'A4':('Control participant eligibility','Latest logged configuration controls voting and commitment immediately; committed configuration is retained for rollback and snapshots; all peers, including nonvoters, replicate.',['nextConfiguration','Raft.appendConfigurationEntry','Raft.startStopReplication'],['s-config-change','s-config-append','s-repl-membership']),\n'A5':('Consume decisions in the application FSM','Dedicated FSM goroutine serializes Apply, configuration callbacks, barriers and restore. Enqueue position differs from completed application.',['Raft.processLogs','Raft.runFSM'],['s-apply','s-fsm']),\n'A6':('Preserve and reconstruct protocol history','Injected durable log/stable/snapshot interfaces hold terms, votes and history. Library coordinates writes, compaction, and startup replay; in-repository stores remain implementation surfaces.',['Raft.persistVote','Raft.takeSnapshot','LogStore','StableStore'],['s-election','s-snapshot','s-store','s-stable']),\n'A7':('Define invocation and observed completion','Client futures report asynchronously; Apply completion is tied to FSM response, loss of leadership can leave write outcome ambiguous, and VerifyLeader claims protection against stale reads.',['Raft.Apply','Raft.Barrier','Raft.VerifyLeader','Future.Error'],['s-client-api','s-verify-api','s-future-contract'])}\nfor i,(p,r,e,s) in entries.items():activities.append(dict(class_id=i,applicability='applicable',purpose=p,realization_summary=r,entry_points=e,source_ids=s))\nformation='Apply admission reaches the leader main loop, which assigns term/index and stores logs before reporting self support. Per-peer replication sends bounded batches with previous index/term, retries rejected prefixes and falls back to snapshots for missing history. Follower append persists nonduplicate entries before success. The leader-lifetime commitment tracker counts only current voters, advances at a majority index only after the first entry of this term is supported, and notifies the main loop. That loop advances commit/configuration state and enqueues committed tuples for runFSM; FSM application supplies command responses. Replication CommitTimeout carries the leader commit frontier to idle followers; their processLogs path feeds the same serialized FSM consumer.'\ncontext='A follower without recent contact campaigns only if it is a voter. Per-attempt pre-vote/election channels isolate replies; real elections persist term and vote, and remote handlers enforce term, candidate eligibility, prior vote and log freshness. A winning majority creates a fresh leader commitment/replication lifetime and appends a current-term noop. Newer-term RPCs, replication rejection signals, voter-only lease loss or committed local removal can end leadership. Cleanup stops old workers and rejects pending futures; surviving old replies refer to old tracker/channel objects. Already enqueued FSM work has its own owner and may complete after stepdown. Persistent logs/snapshots and vote freshness carry prior decided history into later campaigns; new leaders collect fresh replication support.'\nconnection='The authority context selects both the log that may be advanced and the eligible voters whose support can advance it. Membership is logged, normally one uncommitted change at a time, and updates the commitment voter set and replication workers immediately; followers roll back latest membership with a conflicting suffix. Elections compare retained log/snapshot history, while the current-term commitment threshold prevents using mere old-term support as fresh authority. Recovery reconstructs history and configuration before campaigning. Heartbeats confirm contact but carry no commit index; VerifyLeader consumes separate per-request callbacks and lease checks count recent voter contacts. Verification registration includes nonvoter replication workers despite a voter-derived threshold, retained as an unresolved eligibility question rather than a guarantee.'\nm=dict(version=1,target_profile=dict(system_boundary='Captured HashiCorp Raft Go module: leader/follower protocol loops, replication, configuration, persistence coordination, snapshots and FSM/future APIs. Caller implements FSM and may inject stores/transports; in-repository implementations remain in scope and are not externalized merely by injection.',protocol_contexts=['Term and leader lifetime','Latest and committed membership','Per-peer replication stream','Log/snapshot index and term','Per-client future'],external_interfaces=['FSM','LogStore','StableStore','SnapshotStore','Transport','Apply/Barrier/VerifyLeader and configuration APIs'],ownership=['Main loop owns configurations and leaderState; heartbeat fast path is an explicit concurrent exception for empty requests.','Replication workers own progress with specific locks/atomics; commitment has its own mutex; FSM and snapshot work use separate goroutines.'],selection_injection=['Client-selected stores, FSM and transport','Config timeouts, MaxAppendEntries, protocol version, pre-vote and snapshot settings'],variants=['Normal and pipeline replication','Voters and nonvoters','Snapshot recovery and explicit user restore','Legacy protocol/snapshot compatibility paths read only at backbone level'],source_ids=['s-recovery','s-transport','s-fsm','s-store','s-config-contract','s-heartbeat-dispatch'],unknowns=['Full transport pipeline/error behavior and built-in store failure semantics remain unread.']),activities=activities,behaviors=B,facts=F,core_overview=dict(status='usable',formation=dict(explanation=formation,behavior_ids=['B-dispatch','B-replicate','B-commitment','B-leader-consume','B-append','B-fsm'],fact_ids=['F-match','F-commit-frontier'],source_ids=['s-dispatch','s-replication','s-commitment','s-leader-loop','s-append','s-fsm']),context=dict(explanation=context,behavior_ids=['B-election','B-leader-lifetime','B-lease','B-recovery'],source_ids=['s-follower','s-candidate','s-election','s-vote','s-leader-setup','s-lease','s-recovery']),connection=dict(explanation=connection,behavior_ids=['B-configuration','B-leader-lifetime','B-recovery','B-verify-admit','B-verify-notify','B-verify-complete'],fact_ids=['F-match','F-commit-frontier','F-verify-tally'],source_ids=['s-config-append','s-repl-membership','s-commitment','s-append','s-recovery','s-verify-register','s-verify-future']),open_details=['Verification acknowledgment eligibility with nonvoters and independent lease timing.','Follower commit bound versus request-checked prefix under recovery/backtracking histories.','Storage failures between separate vote-key updates; pipeline error and peer-address transition details.'],core_gaps=[],rationale='Representative formation and context lifecycles, their producers/consumers and necessary membership/recovery/completion paths are traced. Usable navigation does not mean exhaustive coverage or correctness.'),surfaces=[dict(entry_point='Raft.appendEntries commit-index calculation',disposition='mapped',behavior_ids=['B-append'],reason='Local log end can exceed request-checked prefix. Need a legal producer/recovery history preserving a conflicting suffix before considering an obligation.',source_ids=['s-append','s-repl-input','s-install'],high_consequence=True),dict(entry_point='Raft.persistVote separate StableStore writes',disposition='deferred',reason='Vote term and candidate persist separately, and error handling denies the current vote. Crash/error recovery semantics and subsequent candidate interpretation require investigation.',source_ids=['s-election','s-vote','s-stable'],high_consequence=True),dict(entry_point='NetworkTransport pipeline and built-in stores',disposition='deferred',reason='Interfaces and heartbeat routing read; full pipeline error/close ownership and in-memory/file persistence implementation remain to be traced.',source_ids=['s-transport','s-heartbeat-dispatch','s-store'],high_consequence=True)])\nq=dict(question='Can VerifyLeader consume affirmative acknowledgments from Nonvoter replication workers as the voter majority needed to confirm current leadership, and can that produce successful verification without eligible authority support under a legal history?',importance='A false positive in the documented stale-read protection can expose stale FSM state after a voter majority has moved to another leader; local acknowledgment eligibility is the first discriminator, not yet an observed cluster consequence.',source_ids=['s-verify-api','s-verify-register','s-verify-future','s-repl-notify','s-heartbeat','s-repl-membership','s-config-contract','s-leader-loop','s-lease'],participants=['Local leader voter','Other configured voters','Configured Nonvoter replica'],objects=['verifyFuture','followerReplication.notify','latest Configuration'],contexts=['Stable mixed voter/nonvoter configuration','One leader lifetime and one verification invocation','Voter contact unavailable while nonvoter replies remain possible'],event_paths=['VerifyLeader -> leaderLoop -> verifyLeader -> per-peer notify registration','heartbeat/append success -> notifyAll -> verifyFuture.vote -> leaderLoop verification completion'],activity_classes=['A2'],behavior_ids=['B-verify-admit','B-verify-notify','B-verify-complete'],fact_ids=['F-verify-tally'],supporting_behavior_ids={'B-configuration':'Establishes suffrage and creates replication workers for both voters and nonvoters.','B-lease':'Independent voter-only contact timer may end leadership; must preserve its ordering rather than assume it cannot run.','B-election':'Supplies legal acquisition/loss history if demonstrating an actual obsolete leader rather than only local eligibility.'},obligation_relation_kind='consumption',counterevidence=['commitment.recalculate and checkLeaderLease explicitly restrict support to voters; this is not evidence that those paths have the same discrepancy.','Leader cleanup fails pending verification and nonleader admission rejects requests.','A negative callback or higher-term RPC can prevent success; a legal check must control actual message scheduling rather than inject contradictory replies.','API promises leader verification but does not explicitly spell out per-request voter accounting; applicability must be derived from the actual authority mechanism and source contract.'],unknowns=['Determine whether the scoped responsibility should be expressed as eligible acknowledgment accounting or as stale-leader verification, without treating an arbitrary disconnected leader as already obsolete.','Construct a legal prefix and reply schedule that preserves the independent lease/stepdown paths while distinguishing a nonvoter callback from an eligible voter acknowledgment.'],priority=3,trigger_rationale='Source discrepancy is direct: voter-only quorumSize, all-peer verification registration, identity-free callback tally, and nil completion at threshold. Contract reading and a small local callback experiment can distinguish eligibility before a costly full partition test; the follower prefix lead requires substantially more legal-history reconstruction.',disposition='concrete_suspicion',preferred_check='controlled_schedule')\ns=dict(action='continue',map_path='audit-map.json',rationale='Establish initial two-core-path navigation and select the sourced verification eligibility discrepancy. Retain independent follower-prefix and persistence leads without asserting defects or executing fabricated histories.',sources=sources,question=q,feedback=dict(ref_ids=['B-verify-admit','B-verify-notify','B-verify-complete','F-verify-tally','s-verify-register','s-config-contract','s-lease','s-verify-api'],answered='The first backbone trace connects term-owned commitment, voter eligibility, replication, recovery and FSM completion. VerifyLeader initializes a voter-count threshold but registers the future on every nonlocal replication worker, and notifyAll supplies identity-free positive callbacks to the tally. No suffrage check appears on that inspected registration-to-completion path. Voter-only commitment and lease enforcement are distinct protections and remain contrary evidence against a broader claim that nonvoters generally form consensus.',remaining=q['unknowns'],understanding='updated',rationale='This is source-based selection, not a violation result. Next investigation must ground the precise responsibility and legal schedule before fixing a check.'))\nfor name,d in [('audit-map.json',m),('submission.json',s)]:\n with open(name,'w') as f:json.dump(d,f,indent=2);f.write('\\\\n')\nPY\npython3 build_submission.py\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\ns=json.load(open('submission.json'))\nfor a in s['sources']:\n n=len((Path('../agent-source')/a['file']).read_text().splitlines())\n if a['end_line']>n:print(a['id'],a['end_line'],n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nsrc('s-contract','README.md',71,99,'document_statement')\nsrc('s-apply-contract','docs/apply.md',1,10,'document_statement')\nsrc('s-config-contract','configuration.go',8,80,'interface_statement')\nsrc('s-config-change','configuration.go',140,308)\nsrc('s-transport','transport.go',17,110,'interface_statement')\nsrc('s-store','log.go',110,148,'interface_statement')\nsrc('s-stable','stable.go',5,19,'interface_statement')\nsrc('s-follower','raft.go',135,259)\nsrc('s-candidate','raft.go',285,440)\nsrc('s-election','raft.go',1976,2161)\nsrc('s-vote','raft.go',1603,1810)\nsrc('s-leader-setup','raft.go',455,580)\nsrc('s-repl-membership','raft.go',582,665)\nsrc('s-leader-loop','raft.go',667,961)\nsrc('s-verify-register','raft.go',963,987)\nsrc('s-lease','raft.go',1032,1094)\nsrc('s-config-append','raft.go',1200,1240)\nsrc('s-dispatch','raft.go',1242,1285)\nsrc('s-apply','raft.go',1287,1386)\nsrc('s-append','raft.go',1437,1600)\nsrc('s-commitment','commitment.go',11,104)\nsrc('s-replication','replication.go',127,295)\nsrc('s-repl-snapshot','replication.go',297,404)\nsrc('s-heartbeat','replication.go',406,468)\nsrc('s-pipeline','replication.go',470,613)\nsrc('s-repl-input','replication.go',615,681)\nsrc('s-repl-notify','replication.go',89,111)\nsrc('s-repl-result','replication.go',698,726)\nsrc('s-verify-future','future.go',236,293)\nsrc('s-future-contract','future.go',12,56,'interface_statement')\nsrc('s-verify-api','api.go',880,893,'interface_statement')\nsrc('s-client-api','api.go',802,877)\nsrc('s-fsm','fsm.go',15,262)\nsrc('s-recovery','api.go',495,705)\nsrc('s-install','raft.go',1810,1954)\nsrc('s-snapshot','snapshot.go',120,259)\nsrc('s-user-restore','raft.go',1096,1200)\nsrc('s-heartbeat-dispatch','net_transport.go',660,740)\nsrc('s-rpc-dispatch','raft.go',1388,1435)\nsrc('s-verify-tests','raft_test.go',1866,1974,'test_expectation')\nsrc('s-state','state.go',40,192)\nB=[]\ndef beh(i,act,owner,context,trigger,ss,**kw):\n d=dict(id=i,primary_activity=act,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss);d.update(kw);B.append(d)\nbeh('B-election','A2','Main Raft loop, with per-peer vote RPC workers','Latest voter configuration, one campaign channel per candidate attempt','Follower timeout or TimeoutNow; optional pre-vote before election',['s-follower','s-candidate','s-election','s-vote'],implementation_guards=['Only a local voter campaigns; remote requests reject ineligible known candidates, stale terms and less up-to-date logs. Known leader suppresses ordinary vote requests; leadership transfer bypasses that suppression.','Each attempt asks each configured voter once and owns a fresh buffered response channel. Real election persists term and self vote before counting self. Majority of latest voters wins.'],writes=['Persisted currentTerm; lastVoteTerm and lastVoteCand; role and known leader'],durable_effects=['Term is persisted before its in-memory update. Vote writes term and candidate separately before returning granted.'],async_boundaries=['Old campaign replies go to the abandoned attempt channel; request workers can finish after an election attempt ends.'],important_branches=['Higher response terms step down; election timeout retries; pre-vote does not persist a new term. Vote storage error denies that vote.'],cross_activity_effects={'A1':'Election freshness and persistent vote checks constrain which log may drive subsequent formation.'},unknowns=['Crash/error atomicity across separate vote-key writes has not been investigated.'])\nbeh('B-leader-lifetime','A2','Main Raft loop','One acquired leadership term','Election wins; runLeader initializes and defers cleanup',['s-leader-setup','s-repl-membership'],writes=['Fresh commitment object with startIndex=lastIndex+1; fresh commit channel, replication map, pending futures and stepDown channel'],external_effects=['Starts per-peer replicators and dispatches a current-term noop. On exit closes replication stop channels and responds ErrLeadershipLost to remaining inflight and verification futures.'],async_boundaries=['Replication workers retain the commitment and stepDown objects from their leader lifetime. Cleanup requests exit without synchronously joining every RPC.'],existing_protections=['A later term uses a different commitment object and notification channel, so delayed old replies cannot update that new tracker.'],cross_activity_effects={'A1':'A current-term noop and fresh support tracker connect authority acquisition to legal commit advancement.','A7':'Unresolved client operations get leadership-loss completion; operations already sent to the FSM have a separate completion owner.'})\nbeh('B-dispatch','A1','Leader main loop','Leader lifetime and latest local log','Accepted Apply or configuration entry or initial noop',['s-dispatch','s-client-api'],implementation_guards=['Leader loop rejects applies during transfer; nonleader loops reject client writes.'],writes=['Assigns monotonically increasing indices and current term; puts futures on inflight queue; updates cached last log after storage success'],durable_effects=['StoreLogs precedes local commitment.match.'],external_effects=['Notifies each replicator after successful local storage; storage failure returns errors and steps down.'],produces_fact_ids=['F-match'],unknowns=['Partial storage errors and post-failure configuration-append effects are unread fault cases.'])\nbeh('B-replicate','A1','Per-follower replication worker and pipeline decoder','Captured leader term and commitment object, current peer identity','New-log trigger, CommitTimeout, explicit catch-up request, pipeline response',['s-replication','s-pipeline','s-repl-input','s-repl-result'],implementation_guards=['Higher reply term signals the captured stepDown channel; failed normal replies reduce nextIndex and retry; successful nonempty append updates match only through the sent last entry.'],reads=['Leader commit index, durable logs, snapshot boundary, MaxAppendEntries'],writes=['Follower nextIndex; monotonic commitment match for the peer; last contact'],async_boundaries=['Normal transport request/reply or asynchronous pipeline futures; pipeline decoder is stopped before routine returns. Heartbeat is separate from disk-backed replication.'],important_branches=['Missing local log switches to snapshot transfer. CommitTimeout propagates commit position when client traffic stops.'],produces_fact_ids=['F-match'],cross_activity_effects={'A2':'Successful replies also call notifyAll(true); higher-term replies call notifyAll(false) and signal leadership loss.','A3':'Backtracking and snapshot fallback resynchronize lagging followers.'},unknowns=['Pipeline transport error/completion semantics and in-flight address replacement have not been fully traced.'])\nbeh('B-commitment','A1','Mutex-protected commitment object shared by leader and replicators','One leader lifetime; voter set from latest configuration','Local or follower match advances, or configuration changes',['s-commitment'],implementation_guards=['Only IDs in matchIndexes count; match indices only increase. Sorted voter indices select strict majority. Commit index advances only if quorum index reaches startIndex.'],writes=['matchIndexes and commitIndex under commitment mutex'],external_effects=['Nonblocking notification on commitCh only when commit index increases.'],consumes_fact_ids=['F-match'],produces_fact_ids=['F-commit-frontier'])\nbeh('B-leader-consume','A1','Leader main loop','Current leader lifetime','commitCh notification',['s-leader-loop','s-apply'],reads=['Current commitment frontier and inflight queue'],writes=['Raft commit index; committed configuration when crossed; removes committed inflight futures'],external_effects=['processLogs forwards committed entries to FSM; committed local removal causes shutdown or stepdown.'],consumes_fact_ids=['F-commit-frontier'],cross_activity_effects={'A4':'A committed configuration changes committed membership and can remove local leadership.','A5':'Committed log batches enter the FSM queue.','A7':'Command completion belongs to FSM processing after this enqueue, not to commitCh.'})\nbeh('B-append','A1','Follower RPC handler, usually main loop; empty fast heartbeat may be concurrent','Request term, previous-log identity, local log/snapshot and configuration','AppendEntries dispatch',['s-append','s-rpc-dispatch','s-heartbeat-dispatch'],implementation_guards=['Rejects old term and mismatching previous-log term/index; newer term makes follower; ordinary same-term append also makes nonfollower step down except transfer candidate.'],durable_effects=['Conflicting suffix is deleted; duplicate same-term entries skipped; new entries persisted before success.'],writes=['Leader identity, cached last log, latest/committed configuration, local commit index, last contact'],important_branches=['Commit advancement uses min(LeaderCommitIndex, local getLastIndex), not explicitly the last index checked by this request.','Truncating an uncommitted configuration restores the committed configuration before processing replacement entries.','Empty heartbeat fast path has previous index/term zero, no entries and commit index zero, so it cannot itself commit logs.'],external_effects=['processLogs enqueues newly considered committed entries before successful reply.'],cross_activity_effects={'A2':'Term/role and known-leader updates establish current request context.','A4':'Log conflict and received configuration entries alter participant eligibility.','A5':'Follower commitment directly drives FSM delivery.'},unknowns=['Whether a legal request can advertise a commit frontier beyond its checked prefix while a divergent local suffix remains; producer/backtracking and snapshot histories must be composed before alleging unsafe application.'])\nbeh('B-configuration','A4','Main loop, or constructor before startup','Latest and committed configuration with their log indices','Configuration API request, received configuration log, suffix replacement or snapshot reconstruction',['s-config-contract','s-config-change','s-config-append','s-repl-membership','s-append','s-recovery','s-install'],implementation_guards=['At least one voter; unique nonempty IDs and addresses; optional prevIndex compare. Leader admits next change only after latest configuration and a current-term entry are committed.'],writes=['Latest configuration immediately after leader append; commitment voter set reset retaining indices for surviving voter IDs; replication starts/stops for all configured peers.','Received later configuration implies previous configuration committed; suffix replacement falls back to committed config. Snapshot reconstruction supplies both configurations.'],cross_activity_effects={'A1':'Only voter IDs enter commitment match map; current membership changes eligible replication support.','A2':'Election quorum and leader lease use latest voter membership; nonvoters still have replication workers.'},unknowns=['Address changes and removal/readdition with outstanding replication replies remain unexamined.'])\nbeh('B-fsm','A5','Dedicated runFSM goroutine','Ordered committed tuples; snapshot restore boundary','fsmMutateCh command batch or restore future',['s-apply','s-fsm','s-future-contract'],implementation_guards=['processLogs skips indices already submitted using Raft.lastApplied. FSM Apply/Snapshot/Restore execution is serialized.'],writes=['FSM state and FSM-local lastIndex/term; command future response'],external_effects=['Calls deterministic client FSM Apply/ApplyBatch; responds after application. Barrier bypasses application but finishes behind earlier work. ConfigurationStore is optional.'],async_boundaries=['Raft.lastApplied advances after enqueue; it is distinct from FSM-local completion. Snapshots use FSM-local completed index.'],cross_activity_effects={'A7':'ApplyFuture.Error completion precedes legal Response/Index access.','A6':'Snapshots capture completed FSM state, not just leader commitment.'})\nbeh('B-recovery','A3','Constructor before startup; main loop install handler and FSM restore owner','Snapshot index/term and configuration plus retained log suffix','NewRaft restart or InstallSnapshot request',['s-recovery','s-install','s-repl-snapshot','s-store','s-state'],implementation_guards=['Constructor reads durable term and log end; tries snapshots newest first and scans later logs for configurations. Install rejects older terms or unsupported snapshot versions; verifies stream size and completes restore future before success.'],writes=['Last-applied and last-snapshot coordinates, latest/committed configurations; replication success advances peer nextIndex/match to snapshot index.'],external_effects=['FSM restore discards previous state; old logs compacted, or all removed for monotonic store.'],produces_fact_ids=['F-match'],cross_activity_effects={'A1':'A successful installed snapshot supplies peer match support through its index.','A2':'Recovered history and term constrain the next campaign freshness; incoming newer snapshot term changes authority.','A4':'Snapshot configuration reconstructs participant eligibility.'},unknowns=['Same-term delayed/duplicate snapshot delivery and retained conflicting suffix histories have not been reconstructed.'])\nbeh('B-snapshot','A6','Snapshot goroutine, synchronized with FSM and main-loop configuration request','Completed FSM prefix and committed configuration','Periodic threshold or public Snapshot',['s-snapshot','s-fsm'],implementation_guards=['Snapshot prefix must be at least the committed configuration index. FSM snapshot future and configuration future supply their respective owner snapshots.'],durable_effects=['Creates and persists snapshot with configuration, finalizes sink, then compacts logs.'],external_effects=['Always releases obtained FSMSnapshot.'],cross_activity_effects={'A3':'Retained snapshots are replay/rejoin inputs.','A1':'Compaction makes missing-log replication take snapshot fallback.'})\nbeh('B-user-restore','A3','Leader main loop plus FSM goroutine','Explicit caller restore of external backup','Restore request while leader',['s-user-restore','s-leader-loop'],implementation_guards=['Rejects during leadership transfer or while configuration uncommitted; checks version and exact size.'],writes=['Uses current configuration and term; burns an index greater than old/snapshot index; updates lastLog, lastApplied and lastSnapshot after FSM restore.'],external_effects=['Aborts inflight applies with ErrAbortedByRestore; gaps or monotonic-store log deletion cause follower snapshot catch-up.'],cross_activity_effects={'A7':'This explicit operation intentionally replaces prior application history; ordinary replication must not be judged as if it were this caller-authorized reset.'})\nbeh('B-verify-admit','A2','Leader main loop','One VerifyLeader future and voter-count quorum at admission','Public VerifyLeader enqueues a new future; leaderLoop calls verifyLeader',['s-verify-api','s-verify-register','s-leader-loop','s-lease','s-repl-membership'],writes=['votes=1 for self; quorumSize from number of configured voters; tracks future and registers it in every replication worker notify map.'],implementation_guards=['Follower/candidate requests fail. Single-voter threshold succeeds immediately.'],external_effects=['For larger quorum asynchronously notifies each registered worker to heartbeat.'],produces_fact_ids=['F-verify-tally'],cross_activity_effects={'A4':'Threshold filters by Voter while registration iterates replState, populated for all peer suffrages.'})\nbeh('B-verify-notify','A2','Replication/heartbeat workers; verifyFuture.vote protected by voteLock','A pending future registered on a peer worker','Successful append/snapshot, heartbeat reply or newer-term replication failure calls notifyAll',['s-repl-notify','s-repl-result','s-heartbeat','s-repl-snapshot','s-verify-future'],writes=['notifyAll swaps peer notify map under notifyLock, then calls vote on each future; vote increments votes on true.'],implementation_guards=['nil notifyCh suppresses callbacks after a result has already been signaled; one notify-map entry per future per worker.'],external_effects=['On threshold or false callback sends same future to verifyCh then clears notifyCh.'],important_branches=['Transport heartbeat errors do not vote; a successful RPC passes resp.Success. Snapshot/append success also provides true notifications. No peer ID or suffrage is passed into vote.'],produces_fact_ids=['F-verify-tally'],unknowns=['Whether nonvoter-only positive callbacks can be consumed as successful leader verification under a legal partition/schedule despite voter-only lease enforcement.'])\nbeh('B-verify-complete','A2','Leader main loop','Requeued VerifyLeader future','Receives future with nonzero quorumSize',['s-leader-loop','s-verify-register','s-verify-future'],reads=['votes and quorumSize'],external_effects=['Below threshold steps down and returns ErrNotLeader; at threshold returns nil; both remove pending registrations. Leader exit returns ErrLeadershipLost for pending verification.'],consumes_fact_ids=['F-verify-tally'],cross_activity_effects={'A7':'nil future result is public confirmation used to avoid stale reads per VerifyLeader documentation.'})\nbeh('B-lease','A2','Leader main loop','Latest voter configuration; local LeaderLeaseTimeout','Lease timer',['s-lease','s-leader-loop','s-heartbeat'],implementation_guards=['Only voters with recent contact count, including local voter; lack of majority steps down.'],reads=['Per-worker synchronized lastContact'],external_effects=['Periodic stepdown independently bounds local leadership retention after contact loss.'],unknowns=['Ordering of lease checks relative to a newly admitted verification can matter; a later lease failure does not by itself establish correctness of an earlier successful verification.'])\nF=[dict(id='F-match',meaning='For each voter ID tracked by one commitment object, the highest index reported matched by local successful storage, successful append reply, or successful snapshot installation; reports increase monotonically within that tracker.',identity={'owner':'commitment object belonging to one leader lifetime','peer':'ServerID'},validity_context='Eligible only while that object is consumed by its leader lifetime and the ID remains a voter in its current matchIndexes. This accounting assertion does not prove durable storage correctness.',representation=['commitment.matchIndexes[ServerID]'],invalidators=['B-leader-lifetime'],reinterpreters=['B-configuration'],durability='Volatile support accounting; reported log/snapshot data resides in injected stores.',recovery='New leadership creates zero-valued support for configured voters and collects fresh reports.',source_ids=['s-commitment','s-dispatch','s-repl-result','s-repl-snapshot','s-leader-setup']),dict(id='F-commit-frontier',meaning='The commitment object has computed a strict-majority voter match index at or above its first current-term log index, and retains the greatest such index.',identity={'owner':'commitment object / leadership lifetime'},validity_context='Computed over latest configured voters; valid consumption is by the leader main loop owning this object. It is a support-derived index, not FSM completion.',representation=['commitment.commitIndex','commitment.startIndex'],invalidators=['B-leader-lifetime'],reinterpreters=['B-configuration'],durability='Volatile; actual logs and snapshots are durable through their stores.',recovery='Recomputed in each leader lifetime; prior decided history constrains elections via retained log/snapshot and voting freshness.',source_ids=['s-commitment','s-leader-setup','s-leader-loop','s-vote']),dict(id='F-verify-tally',meaning='One verification future records its initial self count plus affirmative notifyAll callbacks received before its notification channel is cleared; quorumSize was computed from the voter count at admission. The tally itself carries no participant identity or suffrage.',identity={'operation':'verifyFuture object','owner':'leader lifetime registering the future'},validity_context='Pending verification registered by verifyLeader; callback count is interpreted by leaderLoop against captured quorumSize. It does not itself assert that every callback came from a voter or that a voter majority confirmed authority.',representation=['verifyFuture.votes','verifyFuture.quorumSize','verifyFuture.notifyCh','followerReplication.notify'],invalidators=['B-leader-lifetime'],reinterpreters=[],durability='Volatile per-request state.',recovery='Pending futures receive leadership-loss error on leader exit; fresh calls allocate new futures.',source_ids=['s-verify-register','s-repl-notify','s-verify-future','s-leader-loop'])]\nactivities=[]\nentries={\n'A1':('Form and propagate committed log decisions','Leader storage and replication reports feed a voter-only commitment tracker; current-term threshold admits commit advancement; followers accept leader commit positions after prefix checks.',['Raft.dispatchLogs','commitment.recalculate','Raft.appendEntries'],['s-dispatch','s-commitment','s-append']),\n'A2':('Acquire and maintain authority in an eligible context','Term-persistent elections use voter membership and log freshness; leader lifetimes isolate support and pending work. VerifyLeader and lease are distinct authority consumers.',['Raft.runCandidate','Raft.requestVote','Raft.runLeader','Raft.verifyLeader','Raft.checkLeaderLease'],['s-candidate','s-vote','s-leader-setup','s-verify-register','s-lease']),\n'A3':('Recover eligible participation','Constructor and follower snapshot installation reconstruct state; replication backs up or installs snapshots; explicit user restore is a separate caller-authorized replacement.',['NewRaft','Raft.installSnapshot','Raft.restoreUserSnapshot'],['s-recovery','s-install','s-user-restore']),\n'A4':('Control participant eligibility','Latest logged configuration controls voting and commitment immediately; committed configuration is retained for rollback and snapshots; all peers, including nonvoters, replicate.',['nextConfiguration','Raft.appendConfigurationEntry','Raft.startStopReplication'],['s-config-change','s-config-append','s-repl-membership']),\n'A5':('Consume decisions in the application FSM','Dedicated FSM goroutine serializes Apply, configuration callbacks, barriers and restore. Enqueue position differs from completed application.',['Raft.processLogs','Raft.runFSM'],['s-apply','s-fsm']),\n'A6':('Preserve and reconstruct protocol history','Injected durable log/stable/snapshot interfaces hold terms, votes and history. Library coordinates writes, compaction, and startup replay; in-repository stores remain implementation surfaces.',['Raft.persistVote','Raft.takeSnapshot','LogStore','StableStore'],['s-election','s-snapshot','s-store','s-stable']),\n'A7':('Define invocation and observed completion','Client futures report asynchronously; Apply completion is tied to FSM response, loss of leadership can leave write outcome ambiguous, and VerifyLeader claims protection against stale reads.',['Raft.Apply','Raft.Barrier','Raft.VerifyLeader','Future.Error'],['s-client-api','s-verify-api','s-future-contract'])}\nfor i,(p,r,e,s) in entries.items():activities.append(dict(class_id=i,applicability='applicable',purpose=p,realization_summary=r,entry_points=e,source_ids=s))\nformation='Apply admission reaches the leader main loop, which assigns term/index and stores logs before reporting self support. Per-peer replication sends bounded batches with previous index/term, retries rejected prefixes and falls back to snapshots for missing history. Follower append persists nonduplicate entries before success. The leader-lifetime commitment tracker counts only current voters, advances at a majority index only after the first entry of this term is supported, and notifies the main loop. That loop advances commit/configuration state and enqueues committed tuples for runFSM; FSM application supplies command responses. Replication CommitTimeout carries the leader commit frontier to idle followers; their processLogs path feeds the same serialized FSM consumer.'\ncontext='A follower without recent contact campaigns only if it is a voter. Per-attempt pre-vote/election channels isolate replies; real elections persist term and vote, and remote handlers enforce term, candidate eligibility, prior vote and log freshness. A winning majority creates a fresh leader commitment/replication lifetime and appends a current-term noop. Newer-term RPCs, replication rejection signals, voter-only lease loss or committed local removal can end leadership. Cleanup stops old workers and rejects pending futures; surviving old replies refer to old tracker/channel objects. Already enqueued FSM work has its own owner and may complete after stepdown. Persistent logs/snapshots and vote freshness carry prior decided history into later campaigns; new leaders collect fresh replication support.'\nconnection='The authority context selects both the log that may be advanced and the eligible voters whose support can advance it. Membership is logged, normally one uncommitted change at a time, and updates the commitment voter set and replication workers immediately; followers roll back latest membership with a conflicting suffix. Elections compare retained log/snapshot history, while the current-term commitment threshold prevents using mere old-term support as fresh authority. Recovery reconstructs history and configuration before campaigning. Heartbeats confirm contact but carry no commit index; VerifyLeader consumes separate per-request callbacks and lease checks count recent voter contacts. Verification registration includes nonvoter replication workers despite a voter-derived threshold, retained as an unresolved eligibility question rather than a guarantee.'\nm=dict(version=1,target_profile=dict(system_boundary='Captured HashiCorp Raft Go module: leader/follower protocol loops, replication, configuration, persistence coordination, snapshots and FSM/future APIs. Caller implements FSM and may inject stores/transports; in-repository implementations remain in scope and are not externalized merely by injection.',protocol_contexts=['Term and leader lifetime','Latest and committed membership','Per-peer replication stream','Log/snapshot index and term','Per-client future'],external_interfaces=['FSM','LogStore','StableStore','SnapshotStore','Transport','Apply/Barrier/VerifyLeader and configuration APIs'],ownership=['Main loop owns configurations and leaderState; heartbeat fast path is an explicit concurrent exception for empty requests.','Replication workers own progress with specific locks/atomics; commitment has its own mutex; FSM and snapshot work use separate goroutines.'],selection_injection=['Client-selected stores, FSM and transport','Config timeouts, MaxAppendEntries, protocol version, pre-vote and snapshot settings'],variants=['Normal and pipeline replication','Voters and nonvoters','Snapshot recovery and explicit user restore','Legacy protocol/snapshot compatibility paths read only at backbone level'],source_ids=['s-recovery','s-transport','s-fsm','s-store','s-config-contract','s-heartbeat-dispatch'],unknowns=['Full transport pipeline/error behavior and built-in store failure semantics remain unread.']),activities=activities,behaviors=B,facts=F,core_overview=dict(status='usable',formation=dict(explanation=formation,behavior_ids=['B-dispatch','B-replicate','B-commitment','B-leader-consume','B-append','B-fsm'],fact_ids=['F-match','F-commit-frontier'],source_ids=['s-dispatch','s-replication','s-commitment','s-leader-loop','s-append','s-fsm']),context=dict(explanation=context,behavior_ids=['B-election','B-leader-lifetime','B-lease','B-recovery'],source_ids=['s-follower','s-candidate','s-election','s-vote','s-leader-setup','s-lease','s-recovery']),connection=dict(explanation=connection,behavior_ids=['B-configuration','B-leader-lifetime','B-recovery','B-verify-admit','B-verify-notify','B-verify-complete'],fact_ids=['F-match','F-commit-frontier','F-verify-tally'],source_ids=['s-config-append','s-repl-membership','s-commitment','s-append','s-recovery','s-verify-register','s-verify-future']),open_details=['Verification acknowledgment eligibility with nonvoters and independent lease timing.','Follower commit bound versus request-checked prefix under recovery/backtracking histories.','Storage failures between separate vote-key updates; pipeline error and peer-address transition details.'],core_gaps=[],rationale='Representative formation and context lifecycles, their producers/consumers and necessary membership/recovery/completion paths are traced. Usable navigation does not mean exhaustive coverage or correctness.'),surfaces=[dict(entry_point='Raft.appendEntries commit-index calculation',disposition='mapped',behavior_ids=['B-append'],reason='Local log end can exceed request-checked prefix. Need a legal producer/recovery history preserving a conflicting suffix before considering an obligation.',source_ids=['s-append','s-repl-input','s-install'],high_consequence=True),dict(entry_point='Raft.persistVote separate StableStore writes',disposition='deferred',reason='Vote term and candidate persist separately, and error handling denies the current vote. Crash/error recovery semantics and subsequent candidate interpretation require investigation.',source_ids=['s-election','s-vote','s-stable'],high_consequence=True),dict(entry_point='NetworkTransport pipeline and built-in stores',disposition='deferred',reason='Interfaces and heartbeat routing read; full pipeline error/close ownership and in-memory/file persistence implementation remain to be traced.',source_ids=['s-transport','s-heartbeat-dispatch','s-store'],high_consequence=True)])\nq=dict(question='Can VerifyLeader consume affirmative acknowledgments from Nonvoter replication workers as the voter majority needed to confirm current leadership, and can that produce successful verification without eligible authority support under a legal history?',importance='A false positive in the documented stale-read protection can expose stale FSM state after a voter majority has moved to another leader; local acknowledgment eligibility is the first discriminator, not yet an observed cluster consequence.',source_ids=['s-verify-api','s-verify-register','s-verify-future','s-repl-notify','s-heartbeat','s-repl-membership','s-config-contract','s-leader-loop','s-lease'],participants=['Local leader voter','Other configured voters','Configured Nonvoter replica'],objects=['verifyFuture','followerReplication.notify','latest Configuration'],contexts=['Stable mixed voter/nonvoter configuration','One leader lifetime and one verification invocation','Voter contact unavailable while nonvoter replies remain possible'],event_paths=['VerifyLeader -> leaderLoop -> verifyLeader -> per-peer notify registration','heartbeat/append success -> notifyAll -> verifyFuture.vote -> leaderLoop verification completion'],activity_classes=['A2'],behavior_ids=['B-verify-admit','B-verify-notify','B-verify-complete'],fact_ids=['F-verify-tally'],supporting_behavior_ids={'B-configuration':'Establishes suffrage and creates replication workers for both voters and nonvoters.','B-lease':'Independent voter-only contact timer may end leadership; must preserve its ordering rather than assume it cannot run.','B-election':'Supplies legal acquisition/loss history if demonstrating an actual obsolete leader rather than only local eligibility.'},obligation_relation_kind='consumption',counterevidence=['commitment.recalculate and checkLeaderLease explicitly restrict support to voters; this is not evidence that those paths have the same discrepancy.','Leader cleanup fails pending verification and nonleader admission rejects requests.','A negative callback or higher-term RPC can prevent success; a legal check must control actual message scheduling rather than inject contradictory replies.','API promises leader verification but does not explicitly spell out per-request voter accounting; applicability must be derived from the actual authority mechanism and source contract.'],unknowns=['Determine whether the scoped responsibility should be expressed as eligible acknowledgment accounting or as stale-leader verification, without treating an arbitrary disconnected leader as already obsolete.','Construct a legal prefix and reply schedule that preserves the independent lease/stepdown paths while distinguishing a nonvoter callback from an eligible voter acknowledgment.'],priority=3,trigger_rationale='Source discrepancy is direct: voter-only quorumSize, all-peer verification registration, identity-free callback tally, and nil completion at threshold. Contract reading and a small local callback experiment can distinguish eligibility before a costly full partition test; the follower prefix lead requires substantially more legal-history reconstruction.',disposition='concrete_suspicion',preferred_check='controlled_schedule')\ns=dict(action='continue',map_path='audit-map.json',rationale='Establish initial two-core-path navigation and select the sourced verification eligibility discrepancy. Retain independent follower-prefix and persistence leads without asserting defects or executing fabricated histories.',sources=sources,question=q,feedback=dict(ref_ids=['B-verify-admit','B-verify-notify','B-verify-complete','F-verify-tally','s-verify-register','s-config-contract','s-lease','s-verify-api'],answered='The first backbone trace connects term-owned commitment, voter eligibility, replication, recovery and FSM completion. VerifyLeader initializes a voter-count threshold but registers the future on every nonlocal replication worker, and notifyAll supplies identity-free positive callbacks to the tally. No suffrage check appears on that inspected registration-to-completion path. Voter-only commitment and lease enforcement are distinct protections and remain contrary evidence against a broader claim that nonvoters generally form consensus.',remaining=q['unknowns'],understanding='updated',rationale='This is source-based selection, not a violation result. Next investigation must ground the precise responsibility and legal schedule before fixing a check.'))\nfor name,d in [('audit-map.json',m),('submission.json',s)]:\n with open(name,'w') as f:json.dump(d,f,indent=2);f.write('\\\\n')\nPY\npython3 build_submission.py\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\ns=json.load(open('submission.json'))\nfor a in s['sources']:\n n=len((Path('../agent-source')/a['file']).read_text().splitlines())\n if a['end_line']>n:print(a['id'],a['end_line'],n)\nPY\"","aggregated_output":"s-stable 19 18\ns-repl-input 681 665\ns-repl-result 726 665\ns-state 192 174\n","exit_code":0,"status":"completed"}}
