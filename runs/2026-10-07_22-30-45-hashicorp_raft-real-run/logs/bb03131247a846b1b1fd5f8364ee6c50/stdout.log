{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']; print(json.dumps(s['CheckSubmission'],indent=2))\np=json.load(open('../product-schemas.json'))['DirectCheckPlan'];print('\\\\nPLAN',json.dumps({k:v for k,v in p.items() if k\"'!='\"'\"'$defs'\"'}))\nfor k,v in p['\"'$defs'\"'].items():\n print('\\\\n'+k, 'required', v.get('required'),json.dumps(v.get('properties',{})))\nPY\"","aggregated_output":"{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"check\",\n        \"revise_check\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"unit_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Unit Id\"\n    },\n    \"candidate\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CandidateSubmission\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"plan_path\": {\n      \"title\": \"Plan Path\",\n      \"type\": \"string\"\n    },\n    \"harness_path\": {\n      \"title\": \"Harness Path\",\n      \"type\": \"string\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Destination path to draft source path for helpers\",\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    },\n    \"previous_check_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Check Id\"\n    },\n    \"repair_issue_ids\": {\n      \"description\": \"Exact issues whose driver premises the new harness legality answers; admission does not resolve them\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Repair Issue Ids\",\n      \"type\": \"array\"\n    },\n    \"encoding_revision\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/EncodingRevision\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"plan_path\",\n    \"harness_path\"\n  ],\n  \"title\": \"CheckSubmission\",\n  \"type\": \"object\"\n}\n\nPLAN {\"additionalProperties\": false, \"description\": \"Concrete investigation of an accepted requirement; execution determines the observed result.\", \"properties\": {\"description\": {\"description\": \"This check\\u2019s discriminator, prefix, controls and observations; reference the accepted claim rather than restating it\", \"title\": \"Description\", \"type\": \"string\"}, \"claim_id\": {\"title\": \"Claim Id\", \"type\": \"string\"}, \"binding_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"harness\": {\"$ref\": \"#/$defs/Harness\"}, \"monitors\": {\"items\": {\"$ref\": \"#/$defs/EventMonitor\"}, \"minItems\": 1, \"title\": \"Monitors\", \"type\": \"array\"}, \"observable_properties\": {\"description\": \"Direct route supports event_assertion and event_implication. Correlate prerequisite fields by alias; observe prerequisites and results from the same legal history. Unsupported general temporal properties must remain an explicit limitation.\", \"items\": {\"$ref\": \"#/$defs/ObservableProperty\"}, \"minItems\": 1, \"title\": \"Observable Properties\", \"type\": \"array\"}, \"uncertainties\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Uncertainties\", \"type\": \"array\"}}, \"required\": [\"description\", \"claim_id\", \"binding_ids\", \"harness\", \"monitors\", \"observable_properties\"], \"title\": \"DirectCheckPlan\", \"type\": \"object\"}\n\nComparison required ['field'] {\"field\": {\"title\": \"Field\", \"type\": \"string\"}, \"op\": {\"default\": \"eq\", \"enum\": [\"eq\", \"ne\"], \"title\": \"Op\", \"type\": \"string\"}, \"value\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"integer\"}, {\"type\": \"boolean\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Value\"}, \"reference\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Reference\"}}\n\nEventMonitor required ['id', 'checker_id', 'event', 'binding_ids', 'grounding'] {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"event\": {\"title\": \"Event\", \"type\": \"string\"}, \"binding_ids\": {\"items\": {\"type\": \"string\"}, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"grounding\": {\"$ref\": \"#/$defs/Grounding\"}, \"applicability_conditions\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/Comparison\"}, \"title\": \"Applicability Conditions\", \"type\": \"array\"}, \"admission_alias\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\", \"title\": \"Admission Alias\"}}\n\nEventRequirement required ['alias', 'event'] {\"alias\": {\"title\": \"Alias\", \"type\": \"string\"}, \"event\": {\"title\": \"Event\", \"type\": \"string\"}, \"conditions\": {\"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\", \"items\": {\"$ref\": \"#/$defs/Comparison\"}, \"title\": \"Conditions\", \"type\": \"array\"}}\n\nGrounding required None {\"source_ids\": {\"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\", \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"expectation_ids\": {\"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\", \"items\": {\"type\": \"string\"}, \"title\": \"Expectation Ids\", \"type\": \"array\"}, \"binding_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"derivation\": {\"default\": \"\", \"description\": \"This component\\u2019s sourced reasoning; cite accepted IDs instead of repeating their full argument\", \"title\": \"Derivation\", \"type\": \"string\"}, \"applicability\": {\"default\": \"\", \"description\": \"Conditions for this component, including any added assumptions or omitted protections\", \"title\": \"Applicability\", \"type\": \"string\"}, \"unresolved\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unresolved\", \"type\": \"array\"}, \"conflicts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Conflicts\", \"type\": \"array\"}, \"alternatives\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Alternatives\", \"type\": \"array\"}}\n\nHarness required ['kind', 'source', 'description', 'semantic_changes'] {\"execution_package\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Optional single local Go package or Rust crate directory; the controller fixes the effective package at acceptance\", \"title\": \"Execution Package\"}, \"files\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Additional generated files with relative destinations and fixed source text\", \"title\": \"Files\", \"type\": \"object\"}, \"kind\": {\"description\": \"Harness kind advertised by the configured execution backend\", \"title\": \"Kind\", \"type\": \"string\"}, \"source\": {\"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\", \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}, \"semantic_changes\": {\"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\", \"items\": {\"type\": \"string\"}, \"title\": \"Semantic Changes\", \"type\": \"array\"}, \"prerequisites\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/EventRequirement\"}, \"title\": \"Prerequisites\", \"type\": \"array\"}, \"legality\": {\"$ref\": \"#/$defs/Grounding\", \"default\": {\"source_ids\": [], \"expectation_ids\": [], \"binding_ids\": [], \"derivation\": \"\", \"applicability\": \"\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}}}\n\nObservableProperty required ['checker_id', 'trigger', 'assertion', 'description'] {\"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"kind\": {\"default\": \"event_assertion\", \"enum\": [\"event_assertion\", \"event_implication\"], \"title\": \"Kind\", \"type\": \"string\"}, \"trigger\": {\"$ref\": \"#/$defs/Comparison\"}, \"assertion\": {\"$ref\": \"#/$defs/Comparison\"}, \"antecedent\": {\"anyOf\": [{\"$ref\": \"#/$defs/Comparison\"}, {\"type\": \"null\"}], \"default\": null}, \"identity_fields\": {\"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The API explicitly presents `VerifyLeader` as protection against stale reads. I’ll test that promise with real Raft nodes: first elect a leader, then partition it with a nonvoter while the other voters elect a higher-term leader and complete a write. Before invoking verification on the old leader, the harness will check that earlier voter replies have finished their callback paths, so they cannot explain a success.\n"}}
