n      \"Transport timeouts, connection allocation, and receiver storage blocking remain unexpanded.\",\n      \"No claim about commits, linearizable reads, or deployment outcomes is supported.\"\n    ],\n    \"priority\": 2,\n    \"trigger_rationale\": \"Cross-path comparison found different response-term handling on independent workers updating shared contact evidence. The actual consumer checks only elapsed contact time; contract applicability and alternate step-down paths must be resolved before an obligation.\"\n  },\n  \"sources\": [\n    {\n      \"id\": \"s-stepdown-consume\",\n      \"file\": \"raft.go\",\n      \"start_line\": 680,\n      \"end_line\": 689,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-replication-loop\",\n      \"file\": \"replication.go\",\n      \"start_line\": 137,\n      \"end_line\": 197,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-heartbeat-dispatch-shape\",\n      \"file\": \"net_transport.go\",\n      \"start_line\": 660,\n      \"end_line\": 686,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-heartbeat-dispatch\",\n      \"file\": \"net_transport.go\",\n      \"start_line\": 720,\n      \"end_line\": 764,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-verify-api\",\n      \"file\": \"api.go\",\n      \"start_line\": 880,\n      \"end_line\": 892,\n      \"kind\": \"interface_statement\"\n    },\n    {\n      \"id\": \"s-notify-votes\",\n      \"file\": \"replication.go\",\n      \"start_line\": 98,\n      \"end_line\": 110,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-vote-result\",\n      \"file\": \"future.go\",\n      \"start_line\": 272,\n      \"end_line\": 293,\n      \"kind\": \"code_observation\"\n    },\n    {\n      \"id\": \"s-heartbeat-handler\",\n      \"file\": \"raft.go\",\n      \"start_line\": 1415,\n      \"end_line\": 1435,\n      \"kind\": \"code_observation\"\n    }\n  ],\n  \"rat