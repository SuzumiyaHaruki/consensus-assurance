eview\",\n    \"requests\": [],\n    \"question\": \"When a heartbeat receives an error-free rejection carrying a newer term while ordinary replication is delayed, what authority meaning, if any, may the lease consumer assign to the refreshed contact timestamp, and which independent mechanism forces step-down?\",\n    \"importance\": \"Potential continued leader status under stale authority could affect availability or caller interpretation of leadership. Neither divergent decisions nor stale reads have been established; those require separate endpoint evidence.\",\n    \"source_ids\": [\n      \"s-constructor\",\n      \"s-heartbeat\",\n      \"s-repl-context\",\n      \"s-spawn\",\n      \"s-append-response\",\n      \"s-pipeline-response\",\n      \"s-stale\",\n      \"s-lease\",\n      \"s-lease-contract\",\n      \"s-receiver\",\n      \"s-verify\",\n      \"s-verify-result\",\n      \"s-stepdown-consume\",\n      \"s-replication-loop\",\n      \"s-heartbeat-dispatch-shape\",\n      \"s-heartbeat-dispatch\",\n      \"s-verify-api\",\n      \"s-notify-votes\",\n      \"s-vote-result\",\n      \"s-heartbeat-handler\"\n    ],\n    \"participants\": [\n      \"Local leader worker\",\n      \"Remote peer with a newer current term\"\n    ],\n    \"objects\": [\n      \"followerReplication.lastContact\",\n      \"AppendEntries response\",\n      \"LeaderLeaseTimeout\"\n    ],\n    \"contexts\": [\n      \"One replication object and its fixed request term\",\n      \"Latest configuration voter quorum\",\n      \"Crash-only message delay; no forged peer responses\"\n    ],\n    \"event_paths\": [\n      \"Older-term appendEntries rejection -> error-free heartbeat response -> setLastContact -> checkLeaderLease\",\n      \"Ordinary/pipelined newer-term response -> handleStaleTerm -> stepDown notification\",\n      \"Heartbeat rejection -> notifyAll(false) -> pending VerifyLeader processing\"\n    ],\n    \"activity_classes\": [\n      \"A2\"\n    ],\n    \"behavior_ids\":