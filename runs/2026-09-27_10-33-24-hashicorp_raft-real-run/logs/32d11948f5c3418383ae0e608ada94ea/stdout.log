{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/raft.go | sed -n '930,1005p;1032,1098p;1440,1505p'\nnl -ba ../native-source/api.go | sed -n '490,605p'\nnl -ba ../native-source/config.go | sed -n '195,210p'\nnl -ba ../native-source/replication.go | sed -n '30,100p;137,162p'\nrg -n 'func New|type .*Store' ../native-source/{inmem_store.go,inmem_snapshot.go,file_snapshot.go,net_transport.go,inmem_transport.go}\"","aggregated_output":"   930\t\t\t\t} else {\n   931\t\t\t\t\tr.dispatchLogs(ready)\n   932\t\t\t\t}\n   933\t\n   934\t\t\tcase <-lease:\n   935\t\t\t\tr.mainThreadSaturation.working()\n   936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n   937\t\t\t\tmaxDiff := r.checkLeaderLease()\n   938\t\n   939\t\t\t\t// Next check interval should adjust for the last node we've\n   940\t\t\t\t// contacted, without going negative\n   941\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n   942\t\t\t\tif checkInterval < minCheckInterval {\n   943\t\t\t\t\tcheckInterval = minCheckInterval\n   944\t\t\t\t}\n   945\t\n   946\t\t\t\t// Renew the lease timer\n   947\t\t\t\tlease = time.After(checkInterval)\n   948\t\n   949\t\t\tcase <-r.leaderNotifyCh:\n   950\t\t\t\tfor _, repl := range r.leaderState.replState {\n   951\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n   952\t\t\t\t}\n   953\t\n   954\t\t\tcase <-r.followerNotifyCh:\n   955\t\t\t\t//  Ignore since we are not a follower\n   956\t\n   957\t\t\tcase <-r.shutdownCh:\n   958\t\t\t\treturn\n   959\t\t\t}\n   960\t\t}\n   961\t}\n   962\t\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n   988\t\n   989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   991\t\t// make sure we are not already stopped\n   992\t\tselect {\n   993\t\tcase <-stopCh:\n   994\t\t\tdoneCh <- nil\n   995\t\t\treturn\n   996\t\tdefault:\n   997\t\t}\n   998\t\n   999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n  1000\t\t\terr := &deferError{}\n  1001\t\t\terr.init()\n  1002\t\t\trepl.triggerDeferErrorCh <- err\n  1003\t\t\tselect {\n  1004\t\t\tcase err := <-err.errCh:\n  1005\t\t\t\tif err != nil {\n  1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n  1033\t// within the last leader lease interval. If not, we need to step down,\n  1034\t// as we may have lost connectivity. Returns the maximum duration without\n  1035\t// contact. This must only be called from the main thread.\n  1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n  1037\t\t// Track contacted nodes, we can always contact ourself\n  1038\t\tcontacted := 0\n  1039\t\n  1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n  1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n  1042\t\t// changes between iterations below.\n  1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n  1044\t\n  1045\t\t// Check each follower\n  1046\t\tvar maxDiff time.Duration\n  1047\t\tnow := time.Now()\n  1048\t\tfor _, server := range r.configurations.latest.Servers {\n  1049\t\t\tif server.Suffrage == Voter {\n  1050\t\t\t\tif server.ID == r.localID {\n  1051\t\t\t\t\tcontacted++\n  1052\t\t\t\t\tcontinue\n  1053\t\t\t\t}\n  1054\t\t\t\tf := r.leaderState.replState[server.ID]\n  1055\t\t\t\tdiff := now.Sub(f.LastContact())\n  1056\t\t\t\tif diff <= leaseTimeout {\n  1057\t\t\t\t\tcontacted++\n  1058\t\t\t\t\tif diff > maxDiff {\n  1059\t\t\t\t\t\tmaxDiff = diff\n  1060\t\t\t\t\t}\n  1061\t\t\t\t} else {\n  1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n  1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n  1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1065\t\t\t\t\t} else {\n  1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1067\t\t\t\t\t}\n  1068\t\t\t\t}\n  1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n  1070\t\t\t}\n  1071\t\t}\n  1072\t\n  1073\t\t// Verify we can contact a quorum\n  1074\t\tquorum := r.quorumSize()\n  1075\t\tif contacted < quorum {\n  1076\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n  1077\t\t\tr.setState(Follower)\n  1078\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n  1079\t\t}\n  1080\t\treturn maxDiff\n  1081\t}\n  1082\t\n  1083\t// quorumSize is used to return the quorum size. This must only be called on\n  1084\t// the main thread.\n  1085\t// TODO: revisit usage\n  1086\tfunc (r *Raft) quorumSize() int {\n  1087\t\tvoters := 0\n  1088\t\tfor _, server := range r.configurations.latest.Servers {\n  1089\t\t\tif server.Suffrage == Voter {\n  1090\t\t\t\tvoters++\n  1091\t\t\t}\n  1092\t\t}\n  1093\t\treturn voters/2 + 1\n  1094\t}\n  1095\t\n  1096\t// restoreUserSnapshot is used to manually consume an external snapshot, such\n  1097\t// as if restoring from a backup. We will use the current Raft configuration,\n  1098\t// not the one from the snapshot, so that we can restore into a new cluster. We\n  1440\tfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n  1441\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n  1442\t\t// Setup a response\n  1443\t\tresp := &AppendEntriesResponse{\n  1444\t\t\tRPCHeader:      r.getRPCHeader(),\n  1445\t\t\tTerm:           r.getCurrentTerm(),\n  1446\t\t\tLastLog:        r.getLastIndex(),\n  1447\t\t\tSuccess:        false,\n  1448\t\t\tNoRetryBackoff: false,\n  1449\t\t}\n  1450\t\tvar rpcErr error\n  1451\t\tdefer func() {\n  1452\t\t\trpc.Respond(resp, rpcErr)\n  1453\t\t}()\n  1454\t\n  1455\t\t// Ignore an older term\n  1456\t\tif a.Term < r.getCurrentTerm() {\n  1457\t\t\treturn\n  1458\t\t}\n  1459\t\n  1460\t\t// Increase the term if we see a newer one, also transition to follower\n  1461\t\t// if we ever get an appendEntries call\n  1462\t\tif a.Term > r.getCurrentTerm() || (r.getState() != Follower && !r.candidateFromLeadershipTransfer.Load()) {\n  1463\t\t\t// Ensure transition to follower\n  1464\t\t\tr.setState(Follower)\n  1465\t\t\tr.setCurrentTerm(a.Term)\n  1466\t\t\tresp.Term = a.Term\n  1467\t\t}\n  1468\t\n  1469\t\t// Save the current leader\n  1470\t\tif len(a.Addr) > 0 {\n  1471\t\t\tr.setLeader(r.trans.DecodePeer(a.Addr), ServerID(a.ID))\n  1472\t\t} else {\n  1473\t\t\tr.setLeader(r.trans.DecodePeer(a.Leader), ServerID(a.ID))\n  1474\t\t}\n  1475\t\t// Verify the last log entry\n  1476\t\tif a.PrevLogEntry > 0 {\n  1477\t\t\tlastIdx, lastTerm := r.getLastEntry()\n  1478\t\n  1479\t\t\tvar prevLogTerm uint64\n  1480\t\t\tif a.PrevLogEntry == lastIdx {\n  1481\t\t\t\tprevLogTerm = lastTerm\n  1482\t\t\t} else {\n  1483\t\t\t\tvar prevLog Log\n  1484\t\t\t\tif err := r.logs.GetLog(a.PrevLogEntry, &prevLog); err != nil {\n  1485\t\t\t\t\tr.logger.Warn(\"failed to get previous log\",\n  1486\t\t\t\t\t\t\"previous-index\", a.PrevLogEntry,\n  1487\t\t\t\t\t\t\"last-index\", lastIdx,\n  1488\t\t\t\t\t\t\"error\", err)\n  1489\t\t\t\t\tresp.NoRetryBackoff = true\n  1490\t\t\t\t\treturn\n  1491\t\t\t\t}\n  1492\t\t\t\tprevLogTerm = prevLog.Term\n  1493\t\t\t}\n  1494\t\n  1495\t\t\tif a.PrevLogTerm != prevLogTerm {\n  1496\t\t\t\tr.logger.Warn(\"previous log term mis-match\",\n  1497\t\t\t\t\t\"ours\", prevLogTerm,\n  1498\t\t\t\t\t\"remote\", a.PrevLogTerm)\n  1499\t\t\t\tresp.NoRetryBackoff = true\n  1500\t\t\t\treturn\n  1501\t\t\t}\n  1502\t\t}\n  1503\t\n  1504\t\t// Process any new entries\n  1505\t\tif len(a.Entries) > 0 {\n   490\t\t\treturn true, nil\n   491\t\t}\n   492\t\n   493\t\treturn false, nil\n   494\t}\n   495\t\n   496\t// NewRaft is used to construct a new Raft node. It takes a configuration, as well\n   497\t// as implementations of various interfaces that are required. If we have any\n   498\t// old state, such as snapshots, logs, peers, etc, all those will be restored\n   499\t// when creating the Raft node.\n   500\tfunc NewRaft(conf *Config, fsm FSM, logs LogStore, stable StableStore, snaps SnapshotStore, trans Transport) (*Raft, error) {\n   501\t\t// Validate the configuration.\n   502\t\tif err := ValidateConfig(conf); err != nil {\n   503\t\t\treturn nil, err\n   504\t\t}\n   505\t\n   506\t\t// Ensure we have a LogOutput.\n   507\t\tlogger := conf.getOrCreateLogger()\n   508\t\n   509\t\t// Try to restore the current term.\n   510\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   511\t\tif err != nil && err.Error() != \"not found\" {\n   512\t\t\treturn nil, fmt.Errorf(\"failed to load current term: %v\", err)\n   513\t\t}\n   514\t\n   515\t\t// Read the index of the last log entry.\n   516\t\tlastIndex, err := logs.LastIndex()\n   517\t\tif err != nil {\n   518\t\t\treturn nil, fmt.Errorf(\"failed to find last log: %v\", err)\n   519\t\t}\n   520\t\n   521\t\t// Get the last log entry.\n   522\t\tvar lastLog Log\n   523\t\tif lastIndex > 0 {\n   524\t\t\tif err = logs.GetLog(lastIndex, &lastLog); err != nil {\n   525\t\t\t\treturn nil, fmt.Errorf(\"failed to get last log at index %d: %v\", lastIndex, err)\n   526\t\t\t}\n   527\t\t}\n   528\t\n   529\t\t// Make sure we have a valid server address and ID.\n   530\t\tprotocolVersion := conf.ProtocolVersion\n   531\t\tlocalAddr := trans.LocalAddr()\n   532\t\tlocalID := conf.LocalID\n   533\t\n   534\t\t// TODO (slackpad) - When we deprecate protocol version 2, remove this\n   535\t\t// along with the AddPeer() and RemovePeer() APIs.\n   536\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   537\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   538\t\t}\n   539\t\n   540\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   541\t\tapplyCh := make(chan *logFuture)\n   542\t\tif conf.BatchApplyCh {\n   543\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   544\t\t}\n   545\t\n   546\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   547\t\t// Create Raft struct.\n   548\t\tr := &Raft{\n   549\t\t\tprotocolVersion:       protocolVersion,\n   550\t\t\tapplyCh:               applyCh,\n   551\t\t\tfsm:                   fsm,\n   552\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   553\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   554\t\t\tleaderCh:              make(chan bool, 1),\n   555\t\t\tlocalID:               localID,\n   556\t\t\tlocalAddr:             localAddr,\n   557\t\t\tlogger:                logger,\n   558\t\t\tlogs:                  logs,\n   559\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   560\t\t\tconfigurations:        configurations{},\n   561\t\t\trpcCh:                 trans.Consumer(),\n   562\t\t\tsnapshots:             snaps,\n   563\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n   564\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n   565\t\t\tshutdownCh:            make(chan struct{}),\n   566\t\t\tstable:                stable,\n   567\t\t\ttrans:                 trans,\n   568\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n   569\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n   570\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   571\t\t\tobservers:             make(map[uint64]*Observer),\n   572\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   573\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   574\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   575\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   576\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   577\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   578\t\t}\n   579\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   580\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   581\t\t}\n   582\t\n   583\t\tr.conf.Store(*conf)\n   584\t\n   585\t\t// Initialize as a follower.\n   586\t\tr.setState(Follower)\n   587\t\n   588\t\t// Restore the current term and the last log.\n   589\t\tr.setCurrentTerm(currentTerm)\n   590\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   591\t\n   592\t\t// Attempt to restore a snapshot if there are any.\n   593\t\tif err := r.restoreSnapshot(); err != nil {\n   594\t\t\treturn nil, err\n   595\t\t}\n   596\t\n   597\t\t// Scan through the log for any configuration change entries.\n   598\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   599\t\tfor index := snapshotIndex + 1; index <= lastLog.Index; index++ {\n   600\t\t\tvar entry Log\n   601\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   603\t\t\t\tpanic(err)\n   604\t\t\t}\n   605\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   195\t\t// SnapshotThreshold controls how many outstanding logs there must be before\n   196\t\t// we perform a snapshot. This is to prevent excessive snapshotting by\n   197\t\t// replaying a small set of logs instead. The value passed here is the initial\n   198\t\t// setting used. This can be tuned during operation using ReloadConfig.\n   199\t\tSnapshotThreshold uint64\n   200\t\n   201\t\t// LeaderLeaseTimeout is used to control how long the \"lease\" lasts\n   202\t\t// for being the leader without being able to contact a quorum\n   203\t\t// of nodes. If we reach this interval without contact, we will\n   204\t\t// step down as leader.\n   205\t\tLeaderLeaseTimeout time.Duration\n   206\t\n   207\t\t// LocalID is a unique ID for this server across all time. When running with\n   208\t\t// ProtocolVersion < 3, you must set this to be the same as the network\n   209\t\t// address of your transport.\n   210\t\tLocalID ServerID\n    30\t\n    31\t// followerReplication is in charge of sending snapshots and log entries from\n    32\t// this leader during this particular term to a remote follower.\n    33\ttype followerReplication struct {\n    34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n    35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n    36\t\t// platforms.\n    37\t\n    38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n    39\t\t// requests.\n    40\t\tcurrentTerm uint64\n    41\t\n    42\t\t// nextIndex is the index of the next log entry to send to the follower,\n    43\t\t// which may fall past the end of the log.\n    44\t\tnextIndex uint64\n    45\t\n    46\t\t// peer contains the network address and ID of the remote follower.\n    47\t\tpeer Server\n    48\t\t// peerLock protects 'peer'\n    49\t\tpeerLock sync.RWMutex\n    50\t\n    51\t\t// commitment tracks the entries acknowledged by followers so that the\n    52\t\t// leader's commit index can advance. It is updated on successful\n    53\t\t// AppendEntries responses.\n    54\t\tcommitment *commitment\n    55\t\n    56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n    57\t\t// removed from the cluster. In the follower removed case, it carries a log\n    58\t\t// index; replication should be attempted with a best effort up through that\n    59\t\t// index, before exiting.\n    60\t\tstopCh chan uint64\n    61\t\n    62\t\t// triggerCh is notified every time new entries are appended to the log.\n    63\t\ttriggerCh chan struct{}\n    64\t\n    65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n    66\t\t// deferErr, the sender can be notified when the replication is done.\n    67\t\ttriggerDeferErrorCh chan *deferError\n    68\t\n    69\t\t// lastContact is updated to the current time whenever any response is\n    70\t\t// received from the follower (successful or not). This is used to check\n    71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n    72\t\tlastContact time.Time\n    73\t\t// lastContactLock protects 'lastContact'.\n    74\t\tlastContactLock sync.RWMutex\n    75\t\n    76\t\t// failures counts the number of failed RPCs since the last success, which is\n    77\t\t// used to apply backoff.\n    78\t\tfailures uint64\n    79\t\n    80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n    81\t\t// this server is still leader.\n    82\t\tnotifyCh chan struct{}\n    83\t\t// notify is a map of futures to be resolved upon receipt of an\n    84\t\t// acknowledgement, then cleared from this map.\n    85\t\tnotify map[*verifyFuture]struct{}\n    86\t\t// notifyLock protects 'notify'.\n    87\t\tnotifyLock sync.Mutex\n    88\t\n    89\t\t// stepDown is used to indicate to the leader that we\n    90\t\t// should step down based on information from a follower.\n    91\t\tstepDown chan struct{}\n    92\t\n    93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n    94\t\t// It is private to this replication goroutine.\n    95\t\tallowPipeline bool\n    96\t}\n    97\t\n    98\t// notifyAll is used to notify all the waiting verify futures\n    99\t// if the follower believes we are still the leader.\n   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n../native-source/inmem_store.go:14:type InmemStore struct {\n../native-source/inmem_store.go:25:func NewInmemStore() *InmemStore {\n../native-source/inmem_transport.go:15:func NewInmemAddr() ServerAddress {\n../native-source/inmem_transport.go:53:func NewInmemTransportWithTimeout(addr ServerAddress, timeout time.Duration) (ServerAddress, *InmemTransport) {\n../native-source/inmem_transport.go:68:func NewInmemTransport(addr ServerAddress) (ServerAddress, *InmemTransport) {\n../native-source/net_transport.