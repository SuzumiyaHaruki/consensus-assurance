{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/raft.go | sed -n '635,663p;750,774p;879,909p'\ncat ../native-source/saturation.go | head -75\"","aggregated_output":"   635\t\t\t// Replicate up to lastIdx and stop\n   636\t\t\tr.logger.Info(\"removed peer, stopping replication\", \"peer\", serverID, \"last-index\", lastIdx)\n   637\t\t\trepl.stopCh <- lastIdx\n   638\t\t\tclose(repl.stopCh)\n   639\t\t\tdelete(r.leaderState.replState, serverID)\n   640\t\t\tr.observe(PeerObservation{Peer: repl.peer, Removed: true})\n   641\t\t}\n   642\t\n   643\t\t// Update peers metric\n   644\t\tmetrics.SetGauge([]string{\"raft\", \"peers\"}, float32(len(r.configurations.latest.Servers)))\n   645\t}\n   646\t\n   647\t// configurationChangeChIfStable returns r.configurationChangeCh if it's safe\n   648\t// to process requests from it, or nil otherwise. This must only be called\n   649\t// from the main thread.\n   650\t//\n   651\t// Note that if the conditions here were to change outside of leaderLoop to take\n   652\t// this from nil to non-nil, we would need leaderLoop to be kicked.\n   653\tfunc (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n   654\t\t// Have to wait until:\n   655\t\t// 1. The latest configuration is committed, and\n   656\t\t// 2. This leader has committed some entry (the noop) in this term\n   657\t\t//    https://groups.google.com/forum/#!msg/raft-dev/t4xj6dJTP6E/d2D9LrWRza8J\n   658\t\tif r.configurations.latestIndex == r.configurations.committedIndex &&\n   659\t\t\tr.getCommitIndex() >= r.leaderState.commitment.startIndex {\n   660\t\t\treturn r.configurationChangeCh\n   661\t\t}\n   662\t\treturn nil\n   663\t}\n   750\t\t\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n   751\t\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n   752\t\t\t\t\t\t\t\tfuture.respond(err)\n   753\t\t\t\t\t\t\tcase <-leftLeaderLoop:\n   754\t\t\t\t\t\t\t\tr.log