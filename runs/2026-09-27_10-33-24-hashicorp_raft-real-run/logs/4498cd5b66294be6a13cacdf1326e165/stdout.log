      \"type\": \"string\"\n    },\n    \"harness_path\": {\n      \"title\": \"Harness Path\",\n      \"type\": \"string\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\",\n    \"harness_path\"\n  ],\n  \"title\": \"ExploreSubmission\",\n  \"type\": \"object\"\n}\n   388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n   389\t\tvar failures uint64\n   390\t\treq := AppendEntriesRequest{\n   391\t\t\tRPCHeader: r.getRPCHeader(),\n   392\t\t\tTerm:      s.currentTerm,\n   393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n   395\t\t}\n   396\t\n   397\t\tvar resp AppendEntriesResponse\n   398\t\tfor {\n   399\t\t\t// Wait for the next heartbeat interval or forced notify\n   400\t\t\tselect {\n   401\t\t\tcase <-s.notifyCh:\n   402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n   403\t\t\tcase <-stopCh:\n   404\t\t\t\treturn\n   405\t\t\t}\n   406\t\n   407\t\t\ts.peerLock.RLock()\n   408\t\t\tpeer := s.peer\n   409\t\t\ts.peerLock.RUnlock()\n   410\t\n   411\t\t\tstart := time.Now()\n   412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n   414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n   415\t\t\t\t\tnextBackoffTime, \"error\", err)\n   416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n   417\t\t\t\tfailures++\n   418\t\t\t\tselect {\n   419\t\t\t\tcase <-time.After(nextBackoffTime):\n   420\t\t\t\tcase <-stopCh:\n   421\t\t\t\t\treturn\n   422\t\t\t\t}\n   423\t\t\t} else {\n   424\t\t\t\tif failures > 0 {\n   425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n   426\t\t\t\t}\n   427\t\t\t\ts.setLastContact()\n   428\t\t\t\tfailures = 0\n   429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n   431\t\n   432\t\t\t\tif !r.noLegacyTelemetry {\n   433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n   434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n   435\t\t\t\t}\n   436\t\n   437\t\t\t\ts.notifyAll(resp.Success)\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   848\t\t\tcase v := <-r.verifyCh:\n   849\t\t\t\tr.mainThreadSaturation.working()\n   850\t\t\t\tif v.quorumSize == 0 {\n   851\t\t\t\t\t// Just dispatched, start the verification\n   852\t\t\t\t\tr.verifyLeader(v)\n   853\t\t\t\t} else if v.votes < v.quorumSize {\n   854\t\t\t\t\t// Early return, means there must be a new leader\n   855\t\t\t\t\tr.logger.Warn(\"new leader elected, stepping down\")\n   856\t\t\t\t\tr.setState(Follower)\n   857\t\t\t\t\tdelete(r.leaderState.notify, v)\n   858\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   859\t\t\t\t\t\trepl.cleanNotify(v)\n   860\t\t\t\t\t}\n   861\t\t\t\t\tv.respond(ErrNotLeader)\n   862\t\n   863\t\t\t\t} else {\n   864\t\t\t\t\t// Quorum of members agree, we are still leader\n   865\t\t\t\t\tdelete(r.leaderState.notify, v)\n   866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   867\t\t\t\t\t\trepl.cleanNotify(v)\n   868\t\t\t\t\t}\n   869\t\t\t\t\tv.respond(nil)\n   870\t\t\t\t}\n   871\t\n   872\t\t\tcase future := <-r.userRestoreCh:\n   873\t\t\t\tr.mainThreadSaturation.working()\n   874\t\t\t\tif r.getLeadershipTransferInProgress() {\n   875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   877\t\t\t\t\tcontinue\n   878\t\t\t\t}\n   879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n../native-source/raft.go:35:func (r *Raft) getRPCHeader() RPCHeader {\n../native-source/transport.go:31:type Transport interface {\n../native-source/future.go:238:type verifyFuture struct {\n../native-source/api.go:709:func (r *Raft) config() Config {\n../native-source/inmem_transport.go:203:func (i *InmemTransport) EncodePeer(id ServerID, p ServerAddress) []byte {\n","exit_code":0,"status":"completed"}}
