symbol\": \"leaderLoop\",\n    \"start_line\": 848,\n    \"end_line\": 870,\n    \"description\": \"Consumes counted support and returns nil on the future.\",\n    \"pending\": [],\n    \"associations\": [\n      {\n        \"claim_id\": \"verify-no-success-after-replacement\",\n        \"source_ids\": [\n          \"s-verify-api\",\n          \"s-verify-result-full\"\n        ],\n        \"rationale\": \"Consumes counted support and returns nil on the future. API purpose supplies the expectation; this code supplies behavior only.\"\n      }\n    ]\n  },\n  {\n    \"id\": \"bind-verify-vote\",\n    \"material_id\": \"s-vote-result\",\n    \"symbol\": \"vote\",\n    \"start_line\": 274,\n    \"end_line\": 292,\n    \"description\": \"Serializes positive counter increments and sends threshold notification.\",\n    \"pending\": [],\n    \"associations\": [\n      {\n        \"claim_id\": \"verify-no-success-after-replacement\",\n        \"source_ids\": [\n          \"s-verify-api\",\n          \"s-vote-result\"\n        ],\n        \"rationale\": \"Serializes positive counter increments and sends threshold notification. API purpose supplies the expectation; this code supplies behavior only.\"\n      }\n    ]\n  },\n  {\n    \"id\": \"bind-replacement-win\",\n    \"material_id\": \"s-candidate-win\",\n    \"symbol\": \"runCandidate\",\n    \"start_line\": 363,\n    \"end_line\": 385,\n    \"description\": \"Counts actual votes and transitions replacement node to Leader.\",\n    \"pending\": [],\n    \"associations\": [\n      {\n        \"claim_id\": \"verify-no-success-after-replacement\",\n        \"source_ids\": [\n          \"s-verify-api\",\n          \"s-candidate-win\"\n        ],\n        \"rationale\": \"Counts actual votes and transitions replacement node to Leader. API purpose supplies the expectation; this code supplies behavior only.\"\n      }\n    ]\n  }\n]\n   285\tfunc (r *Raft) runCandidate() {\n   286\t\tterm := r.getCurrentTerm() + 1\n   287\t\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n   288\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n   289\t\n   290\t\t// Start vote for us, and set a timeout\n   291\t\tvar voteCh <-chan *voteResult\n   292\t\tvar prevoteCh <-chan *preVoteResult\n   293\t\n   294\t\t// check if pre-vote is active and that this is not a leader transfer.\n   295\t\t// Leader transfer do not perform prevote by design\n   296\t\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n   297\t\t\tprevoteCh = r.preElectSelf()\n   298\t\t} else {\n   299\t\t\tvoteCh = r.electSelf()\n   300\t\t}\n   301\t\n   302\t\t// Make sure the leadership transfer flag is reset after each run. Having this\n   303\t\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n   304\t\t// which will make other servers vote even though they have a leader already.\n   305\t\t// It is important to reset that flag, because this privilege could be abused\n   306\t\t// otherwise.\n   307\t\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n   308\t\n   309\t\telectionTimeout := r.config().ElectionTimeout\n   310\t\telectionTimer := randomTimeout(electionTimeout)\n   311\t\n   312\t\t// Tally the votes, need a simple majority\n   313\t\tpreVoteGrantedVotes := 0\n   314\t\tpreVoteRefusedVotes := 0\n   315\t\tgrantedVotes := 0\n   316\t\tvotesNeeded := r.quorumSize()\n   317\t\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n   318\t\n   319\t\tfor r.getState() == Candidate {\n   320\t\t\tr.mainThreadSaturation.sleeping()\n   321\t\n   322\t\t\tselect {\n   323\t\t\tcase rpc := <-r.rpcCh:\n   324\t\t\t\tr.mainThreadSaturation.working()\n   325\t\t\t\tr.processRPC(rpc)\n   326\t\t\tcase preVote := <-prevoteCh:\n   327\t\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n   328\t\t\t\tr.mainThreadSaturation.working()\n   329\t\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   330\t\t\t\t// Check if the term is greater than ours, bail\n   331\t\t\t\tif preVote.Term > term {\n   332\t\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n   333\t\t\t\t\tr.setState(Follower)\n   334\t\t\t\t\tr.setCurrentTerm(preVote.Term)\n   335\t\t\t\t\treturn\n   336\t\t\t\t}\n   337\t\n   338\t\t\t\t// Check if the preVote is granted\n   339\t\t\t\tif preVote.Granted {\n   340\t\t\t\t\tpreVoteGrantedVotes++\n   341\t\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   342\t\t\t\t} else {\n   343\t\t\t\t\tpreVoteRefusedVotes++\n   344\t\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   345\t\t\t\t}\n   346\t\n   347\t\t\t\t// Check if we've won the pre-vote and proceed to election if so\n   348\t\t\t\tif preVoteGrantedVotes >= votesNeeded {\n   349\t\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n   350\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   351\t\t\t\t\tpreVoteGrantedVotes = 0\n   352\t\t\t\t\tpreVoteRefusedVotes = 0\n   353\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   354\t\t\t\t\tprevoteCh = nil\n   355\t\t\t\t\tvoteCh = r.electSelf()\n   356\t\t\t\t}\n   357\t\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n   358\t\t\t\t// prevote.\n   359\t\t\t\tif preVoteRefusedVotes >= votesNeeded {\n   360\t\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n   361\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   362\t\t\t\t}\n   363\t\t\tcase vote := <-voteCh:\n   364\t\t\t\tr.mainThreadSaturation.working()\n   365\t\t\t\t// Check if the term is greater than ours, bail\n   366\t\t\t\tif vote.Term > r.getCurrentTerm() {\n   367\t\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n   368\t\t\t\t\tr.setState(Follower)\n   369\t\t\t\t\tr.setCurrentTerm(vote.Term)\n   370\t\t\t\t\treturn\n   371\t\t\t\t}\n   372\t\n   373\t\t\t\t// Check if the vote is granted\n   374\t\t\t\tif vote.Granted {\n   375\t\t\t\t\tgrantedVotes++\n   376\t\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n   377\t\t\t\t}\n   378\t\n   379\t\t\t\t// Check if we've become the leader\n   380\t\t\t\tif grantedVotes >= votesNeeded {\n   381\t\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n   382\t\t\t\t\tr.setState(Leader)\n   383\t\t\t\t\tr.setLeader(r.localAddr, r.localID)\n   384\t\t\t\t\treturn\n   385\t\t\t\t}\n   386\t\t\tcase c := <-r.configurationChangeCh:\n   387\t\t\t\tr.mainThreadSaturation.working()\n   388\t\t\t\t// Reject any operations since we are not the leader\n   389\t\t\t\tc.respond(ErrNotLeader)\n   390\t\n   391\t\t\tcase a := <-r.applyCh:\n   392\t\t\t\tr.mainThreadSaturation.working()\n   393\t\t\t\t// Reject any operations since we are not the leader\n   394\t\t\t\ta.respond(ErrNotLeader)\n   395\t\n   396\t\t\tcase v := <-r.verifyCh:\n   397\t\t\t\tr.mainThreadSaturation.working()\n   398\t\t\t\t// Reject any operations since we are not the leader\n   399\t\t\t\tv.respond(ErrNotLeader)\n   400\t\n   401\t\t\tcase ur := <-r.userRestoreCh:\n   402\t\t\t\tr.mainThreadSaturation.working()\n   403\t\t\t\t// Reject any restores since we are not the leader\n   404\t\t\t\tur.respond(ErrNotLeader)\n   405\t\n   406\t\t\tcase l := <-r.leadershipTransferCh:\n   407\t\t\t\tr.mainThreadSaturation.working()\n   408\t\t\t\t// Reject any operations since we are not the leader\n   409\t\t\t\tl.respond(ErrNotLeader)\n   410\t\n   411\t\t\tcase c := <-r.configurationsCh:\n   412\t\t\t\tr.mainThreadSaturation.working()\n   413\t\t\t\tc.configurations = r.configurations.Clone()\n   414\t\t\t\tc.respond(nil)\n   415\t\n   416\t\t\tcase b := <-r.bootstrapCh:\n   417\t\t\t\tr.mainThreadSaturation.working()\n   418\t\t\t\tb.respond(ErrCantBootstrap)\n   419\t\n   420\t\t\tcase <-r.leaderNotifyCh:\n   421\t\t\t\t//  Ignore since we are not the leader\n   422\t\n   423\t\t\tcase <-r.followerNotifyCh:\n   424\t\t\t\tif electionTimeout != r.config().ElectionTimeout {\n   425\t\t\t\t\telectionTimeout = r.config().ElectionTimeout\n   426\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   427\t\t\t\t}\n   428\t\n   429\t\t\tcase <-electionTimer:\n   430\t\t\t\tr.mainThreadSaturation.working()\n   431\t\t\t\t// Election failed! Restart the election. We simply return,\n   432\t\t\t\t// which will kick us back into runCandidate\n   433\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n   434\t\t\t\treturn\n   435\t\n   436\t\t\tcase <-r.shutdownCh:\n   437\t\t\t\treturn\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   665\t// leaderLoop is the hot loop for a leader. It is invoked\n   666\t// after all the various leader setup is done.\n   667\tfunc (r *Raft) leaderLoop() {\n   668\t\t// stepDown is used to track if there is an inflight log that\n   669\t\t// would cause us to lose leadership (specifically a RemovePeer of\n   670\t\t// ourselves). If this is the case, we must not allow any logs to\n   671\t\t// be processed in parallel, otherwise we are basing commit on\n   672\t\t// only a single peer (ourself) and replicating to an undefined set\n   673\t\t// of peers.\n   674\t\tstepDown := false\n   675\t\t// This is only used for the first lease check, we reload lease below\n   676\t\t// based on the current config value.\n   677\t\tlease := time.After(r.config().LeaderLeaseTimeout)\n   678\t\n   679\t\tfor r.getState() == Leader {\n   680\t\t\tr.mainThreadSaturation.sleeping()\n   681\t\n   682\t\t\tselect {\n   683\t\t\tcase rpc := <-r.rpcCh:\n   684\t\t\t\tr.mainThreadSaturation.working()\n   685\t\t\t\tr.processRPC(rpc)\n   686\t\n   687\t\t\tcase <-r.leaderState.stepDown:\n   688\t\t\t\tr.mainThreadSaturation.working()\n   689\t\t\t\tr.setState(Follower)\n   690\t\n   691\t\t\tcase future := <-r.leadershipTransferCh:\n   692\t\t\t\tr.mainThreadSaturation.working()\n   693\t\t\t\tif r.getLeadershipTransferInProgress() {\n   694\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   695\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   696\t\t\t\t\tcontinue\n   697\t\t\t\t}\n   698\t\n   699\t\t\t\tr.logger.Debug(\"starting leadership transfer\", \"id\", future.ID, \"address\", future.Address)\n   700\t\n   701\t\t\t\t// When we are leaving leaderLoop, we are no longer\n   702\t\t\t\t// leader, so we should stop transferring.\n   703\t\t\t\tleftLeaderLoop := make(chan struct{})\n   704\t\t\t\tdefer func() { close(leftLeaderLoop) }()\n   705\t\n   706\t\t\t\tstopCh := make(chan struct{})\n   707\t\t\t\tdoneCh := make(chan error, 1)\n   708\t\n   709\t\t\t\t// This is intentionally being setup outside of the\n   710\t\t\t\t// leadershipTransfer function. Because the TimeoutNow\n   711\t\t\t\t// call is blocking and there is no way to abort that\n   712\t\t\t\t// in case eg the timer expires.\n   713\t\t\t\t// The leadershipTransfer function is controlled with\n   714\t\t\t\t// the stopCh and doneCh.\n   715\t\t\t\t// No matter how this exits, have this function set\n   716\t\t\t\t// leadership transfer to false before we return\n   717\t\t\t\t//\n   718\t\t\t\t// Note that this leaves a window where callers of\n   719\t\t\t\t// LeadershipTransfer() and LeadershipTransferToServer()\n   720\t\t\t\t// may start executing after they get their future but before\n   721\t\t\t\t// this routine has set leadershipTransferInProgress back to false.\n   722\t\t\t\t// It may be safe to modify things such that setLeadershipTransferInProgress\n   723\t\t\t\t// is set to false before calling future.Respond, but that still needs\n   724\t\t\t\t// to be tested and this situation mirrors what callers already had to deal with.\n   725\t\t\t\tgo func() {\n   726\t\t\t\t\tdefer r.setLeadershipTransferInProgress(false)\n   727\t\t\t\t\tselect {\n   728\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n   729\t\t\t\t\t\tclose(stopCh)\n   730\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n   731\t\t\t\t\t\tr.logger.Debug(err.Error())\n   732\t\t\t\t\t\tfuture.respond(err)\n   733\t\t\t\t\t\t<-doneCh\n   734\t\t\t\t\tcase <-leftLeaderLoop:\n   735\t\t\t\t\t\tclose(stopCh)\n   736\t\t\t\t\t\terr := fmt.Errorf(\"lost leadership during transfer (expected)\")\n   737\t\t\t\t\t\tr.logger.Debug(err.Error())\n   738\t\t\t\t\t\tfuture.respond(nil)\n   739\t\t\t\t\t\t<-doneCh\n   740\t\t\t\t\tcase err := <-doneCh:\n   741\t\t\t\t\t\tif err != nil {\n   742\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n   743\t\t\t\t\t\t\tfuture.respond(err)\n   744\t\t\t\t\t\t} else {\n   745\t\t\t\t\t\t\t// Wait for up to ElectionTimeout before flagging the\n   746\t\t\t\t\t\t\t// leadership transfer as done and unblocking applies in\n   747\t\t\t\t\t\t\t// the leaderLoop.\n   748\t\t\t\t\t\t\tselect {\n   749\t\t\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n   750\t\t\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n   751\t\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n   752\t\t\t\t\t\t\t\tfuture.respond(err)\n   753\t\t\t\t\t\t\tcase <-leftLeaderLoop:\n   754\t\t\t\t\t\t\t\tr.logger.Debug(\"lost leadership during transfer (expected)\")\n   755\t\t\t\t\t\t\t\tfuture.respond(nil)\n   756\t\t\t\t\t\t\t}\n   757\t\t\t\t\t\t}\n   758\t\t\t\t\t}\n   759\t\t\t\t}()\n   760\t\n   761\t\t\t\t// leaderState.replState is accessed here before\n   762\t\t\t\t// starting leadership transfer asynchronously because\n   763\t\t\t\t// leaderState is only supposed to be accessed in the\n   764\t\t\t\t// leaderloop.\n   765\t\t\t\tid := future.ID\n   766\t\t\t\taddress := future.Address\n   767\t\t\t\tif id == nil {\n   768\t\t\t\t\ts := r.pickServer()\n   769\t\t\t\t\tif s != nil {\n   770\t\t\t\t\t\tid = &s.ID\n   771\t\t\t\t\t\taddress = &s.Address\n   772\t\t\t\t\t} else {\n   773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n   774\t\t\t\t\t\tcontinue\n   775\t\t\t\t\t}\n   776\t\t\t\t}\n   777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n   778\t\t\t\tif !ok {\n   779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n   780\t\t\t\t\tcontinue\n   781\t\t\t\t}\n   782\t\t\t\tr.setLeadershipTransferInProgress(true)\n   783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n   784\t\n   785\t\t\tcase <-r.leaderState.commitCh:\n   786\t\t\t\tr.mainThreadSaturation.working()\n   787\t\t\t\t// Process the newly committed entries\n   788\t\t\t\toldCommitIndex := r.getCommitIndex()\n   789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n   790\t\t\t\tr.setCommitIndex(commitIndex)\n   791\t\n   792\t\t\t\t// New configuration has been committed, set it as the committed\n   793\t\t\t\t// value.\n   794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n   795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n   796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n   797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n   798\t\t\t\t\t\tstepDown = true\n   799\t\t\t\t\t}\n   800\t\t\t\t}\n   801\t\n   802\t\t\t\tstart := time.Now()\n   803\t\t\t\tvar groupReady []*list.Element\n   804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n   805\t\t\t\tvar lastIdxInGroup uint64\n   806\t\n   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   811\t\t\t\t\tif idx > commitIndex {\n   812\t\t\t\t\t\t// Don't go past the committed index\n   813\t\t\t\t\t\tbreak\n   814\t\t\t\t\t}\n   815\t\n   816\t\t\t\t\t// Measure the commit time\n   817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n   818\t\t\t\t\tgroupReady = append(groupReady, e)\n   819\t\t\t\t\tgroupFutures[idx] = commitLog\n   820\t\t\t\t\tlastIdxInGroup = idx\n   821\t\t\t\t}\n   822\t\n   823\t\t\t\t// Process the group\n   824\t\t\t\tif len(groupReady) != 0 {\n   825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n   826\t\n   827\t\t\t\t\tfor _, e := range groupReady {\n   828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n   829\t\t\t\t\t}\n   830\t\t\t\t}\n   831\t\n   832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n   833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n   834\t\n   835\t\t\t\t// Count the number of logs enqueued\n   836\t\t\t\tmetrics.SetGauge([]string{\"raft\", \"commitNumLogs\"}, float32(len(groupReady)))\n   837\t\n   838\t\t\t\tif stepDown {\n   839\t\t\t\t\tif r.config().ShutdownOnRemove {\n   840\t\t\t\t\t\tr.logger.Info(\"removed ourself, shutting down\")\n   841\t\t\t\t\t\tr.Shutdown()\n   842\t\t\t\t\t} else {\n   843\t\t\t\t\t\tr.logger.Info(\"removed ourself, transitioning to follower\")\n   844\t\t\t\t\t\tr.setState(Follower)\n   845\t\t\t\t\t}\n   846\t\t\t\t}\n   847\t\n   848\t\t\tcase v := <-r.verifyCh:\n   849\t\t\t\tr.mainThreadSaturation.working()\n   850\t\t\t\tif v.quorumSize == 0 {\n   851\t\t\t\t\t// Just dispatched, start the verification\n   852\t\t\t\t\tr.verifyLeader(v)\n   853\t\t\t\t} else if v.votes < v.quorumSize {\n   854\t\t\t\t\t// Early return, means there must be a new leader\n   855\t\t\t\t\tr.logger.Warn(\"new leader elected, stepping down\")\n   856\t\t\t\t\tr.setState(Follower)\n   857\t\t\t\t\tdelete(r.leaderState.notify, v)\n   858\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   859\t\t\t\t\t\trepl.cleanNotify(v)\n   860\t\t\t\t\t}\n   861\t\t\t\t\tv.respond(ErrNotLeader)\n   862\t\n   863\t\t\t\t} else {\n   864\t\t\t\t\t// Quorum of members agree, we are still leader\n   865\t\t\t\t\tdelete(r.leaderState.notify, v)\n   866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   867\t\t\t\t\t\trepl.cleanNotify(v)\n   868\t\t\t\t\t}\n   869\t\t\t\t\tv.respond(nil)\n   870\t\t\t\t}\n   871\t\n   872\t\t\tcase future := <-r.userRestoreCh:\n   873\t\t\t\tr.mainThreadSaturation.working()\n   874\t\t\t\tif r.getLeadershipTransferInProgress() {\n   875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   877\t\t\t\t\tcontinue\n   878\t\t\t\t}\n   879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n   880\t\t\t\tfuture.respond(err)\n   881\t\n   882\t\t\tcase future := <-r.configurationsCh:\n   883\t\t\t\tr.mainThreadSaturation.working()\n   884\t\t\t\tif r.getLeadershipTransferInProgress() {\n   885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   887\t\t\t\t\tcontinue\n   888\t\t\t\t}\n   889\t\t\t\tfuture.configurations = r.configurations.Clone()\n   890\t\t\t\tfuture.respond(nil)\n   891\t\n   892\t\t\tcase future := <-r.configurationChangeChIfStable():\n   893\t\t\t\tr.mainThreadSaturation.working()\n   894\t\t\t\tif r.getLeadershipTransferInProgress() {\n   895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   897\t\t\t\t\tcontinue\n   898\t\t\t\t}\n   899\t\t\t\tr.appendConfigurationEntry(future)\n   900\t\n   901\t\t\tcase b := <-r.bootstrapCh:\n   902\t\t\t\tr.mainThreadSaturation.working()\n   903\t\t\t\tb.respond(ErrCantBootstrap)\n   904\t\n   905\t\t\tcase newLog := <-r.applyCh:\n   906\t\t\t\tr.mainThreadSaturation.working()\n   907\t\t\t\tif r.getLeadershipTransferInProgress() {\n   908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n   910\t\t\t\t\tcontinue\n   911\t\t\t\t}\n   912\t\t\t\t// Group commit, gather all the ready commits\n   913\t\t\t\tready := []*logFuture{newLog}\n   914\t\t\tGROUP_COMMIT_LOOP:\n   915\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n   916\t\t\t\t\tselect {\n   917\t\t\t\t\tcase newLog := <-r.applyCh:\n   918\t\t\t\t\t\tready = append(ready, newLog)\n   919\t\t\t\t\tdefault:\n   920\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n   921\t\t\t\t\t}\n   922\t\t\t\t}\n   923\t\n   924\t\t\t\t// Dispatch the logs\n   925\t\t\t\tif stepDown {\n   926\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n   927\t\t\t\t\tfor i := range ready {\n   928\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n   929\t\t\t\t\t}\n   930\t\t\t\t} else {\n   931\t\t\t\t\tr.dispatchLogs(ready)\n   932\t\t\t\t}\n   933\t\n   934\t\t\tcase <-lease:\n   935\t\t\t\tr.mainThreadSaturation.working()\n   936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n   937\t\t\t\tmaxDiff := r.checkLeaderLease()\n   938\t\n   939\t\t\t\t// Next check interval should adjust for the last node we've\n   940\t\t\t\t// contacted, without going negative\n   941\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n   942\t\t\t\tif checkInterval < minCheckInterval {\n   943\t\t\t\t\tcheckInterval = minCheckInterval\n   944\t\t\t\t}\n   945\t\n   946\t\t\t\t// Renew the lease timer\n   947\t\t\t\tlease = time.After(checkInterval)\n   948\t\n   949\t\t\tcase <-r.leaderNotifyCh:\n   950\t\t\t\tfor _, repl := range r.leaderState.replState {\n   951\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n   952\t\t\t\t}\n   953\t\n   954\t\t\tcase <-r.followerNotifyCh:\n   955\t\t\t\t//  Ignore since we are not a follower\n   956\t\n   957\t\t\tcase <-r.shutdownCh:\n   958\t\t\t\treturn\n   959\t\t\t}\n   960\t\t}\n   961\t}\n","exit_code":0,"status":"completed"}}
