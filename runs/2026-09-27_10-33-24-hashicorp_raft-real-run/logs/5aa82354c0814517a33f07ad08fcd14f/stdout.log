\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyPublicCompletionExploration\",\"Elapsed\":0}\n{\"Time\":\"2026-09-27T10:49:13.938989639+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-09-27T10:49:13.940798883+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"ok  \\tgithub.com/hashicorp/raft\\t0.020s\\n\"}\n{\"Time\":\"2026-09-27T10:49:13.94083373+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Elapsed\":0.021}\n\n\n  1602\t// requestVote is invoked when we get a request vote RPC call.\n  1603\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n  1604\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n  1605\t\tr.observe(*req)\n  1606\t\n  1607\t\t// Setup a response\n  1608\t\tresp := &RequestVoteResponse{\n  1609\t\t\tRPCHeader: r.getRPCHeader(),\n  1610\t\t\tTerm:      r.getCurrentTerm(),\n  1611\t\t\tGranted:   false,\n  1612\t\t}\n  1613\t\tvar rpcErr error\n  1614\t\tdefer func() {\n  1615\t\t\trpc.Respond(resp, rpcErr)\n  1616\t\t}()\n  1617\t\n  1618\t\t// Version 0 servers will panic unless the peers is present. It's only\n  1619\t\t// used on them to produce a warning message.\n  1620\t\tif r.protocolVersion < 2 {\n  1621\t\t\tresp.Peers = encodePeers(r.configurations.latest, r.trans)\n  1622\t\t}\n  1623\t\n  1624\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1625\t\t// check the LeadershipTransfer flag is set. Usually votes are rejected if\n  1626\t\t// there is a known leader. But if the leader initiated a leadership transfer,\n  1627\t\t// vote!\n  1628\t\tvar candidate ServerAddress\n  1629\t\tvar candidateBytes []byte\n  1630\t\tif len(req.RPCHeader.Addr) > 0 {\n  1631\t\t\tcandidate = r.trans.DecodePeer(req.RPCHeader.Addr)\n  1632\t\t\tcandidateBytes = req.RPCHeader.Addr\n  1633\t\t} else {\n  1634\t\t\tcandidate = r.trans.DecodePeer(req.Candidate)\n  1635\t\t\tcandidateBytes = req.Candidate\n  1636\t\t}\n  1637\t\n  1638\t\t// For older raft version ID is not part of the packed message\n  1639\t\t// We assume that the peer is part of the configuration and skip this check\n  1640\t\tif len(req.ID) > 0 {\n  1641\t\t\tcandidateID := ServerID(req.ID)\n  1642\t\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1643\t\t\t// Grant the vote\n  1644\t\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1645\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not in configuration\",\n  1646\t\t\t\t\t\"from\", candidate)\n  1647\t\t\t\treturn\n  1648\t\t\t}\n  1649\t\t}\n  1650\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate && !req.LeadershipTransfer {\n  1651\t\t\tr.logger.Warn(\"rejecting vote request since we have a leader\",\n  1652\t\t\t\t\"from\", candidate,\n  1653\t\t\t\t\"leader\", leaderAddr,\n  1654\t\t\t\t\"leader-id\", string(leaderID))\n  1655\t\t\treturn\n  1656\t\t}\n  1657\t\n  1658\t\t// Ignore an older term\n  1659\t\tif req.Term < r.getCurrentTerm() {\n  1660\t\t\treturn\n  1661\t\t}\n  1662\t\n  1663\t\t// Increase the term if we see a newer one\n  1664\t\tif req.Term > r.getCurrentTerm() {\n  1665\t\t\t// Ensure transition to follower\n  1666\t\t\tr.logger.Debug(\"lost leadership because received a requestVote with a newer term\")\n  1667\t\t\tr.setState(Follower)\n  1668\t\t\tr.setCurrentTerm(req.Term)\n  1669\t\n  1670\t\t\tresp.Term = req.Term\n  1671\t\t}\n  1672\t\n  1673\t\t// if we get a request for vote from a nonVoter  and the request term is higher,\n  1674\t\t// step down and update term, but reject the vote request\n  1675\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1676\t\t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n  1677\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n  1678\t\tif len(req.ID) > 0 {\n  1679\t\t\tcandidateID := ServerID(req.ID)\n  1680\t\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1681\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n  1682\t\t\t\treturn\n  1683\t\t\t}\n  1684\t\t}\n  1685\t\t// Check if we have voted yet\n  1686\t\tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n  1687\t\tif err != nil && err.Error() != \"not found\" {\n  1688\t\t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n  1689\t\t\treturn\n  1690\t\t}\n  1691\t\tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n  1692\t\tif err != nil && err.Error() != \"not found\" {\n  1693\t\t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n  1694\t\t\treturn\n  1695\t\t}\n  1696\t\n  1697\t\t// Check if we've voted in this election before\n  1698\t\tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n  1699\t\t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n  1700\t\t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n  1701\t\t\t\tr.logger.Warn(\"duplicate requestVote from\", \"candidate\", candidate)\n  1702\t\t\t\tresp.Granted = true\n  1703\t\t\t}\n  1704\t\t\treturn\n  1705\t\t}\n  1706\t\n  1707\t\t// Reject if their term is older\n  1708\t\tlastIdx, lastTerm := r.getLastEntry()\n  1709\t\tif lastTerm > req.LastLogTerm {\n  1710\t\t\tr.logger.Warn(\"rejecting vote request since our last term is greater\",\n  1711\t\t\t\t\"candidate\", candidate,\n  1712\t\t\t\t\"last-term\", lastTerm,\n  1713\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1714\t\t\treturn\n  1715\t\t}\n  1716\t\n  1717\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1718\t\t\tr.logger.Warn(\"rejecting vote request since our last index is greater\",\n  1719\t\t\t\t\"candidate\", candidate,\n  1720\t\t\t\t\"last-index\", lastIdx,\n  1721\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1722\t\t\treturn\n  1723\t\t}\n  1724\t\n  1725\t\t// Persist a vote for safety\n  1726\t\tif err := r.persistVote(req.Term, candidateBytes); err != nil {\n  1727\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  1728\t\t\treturn\n  1729\t\t}\n  1730\t\n  1731\t\tresp.Granted = true\n  1732\t\tr.setLastContact()\n  1733\t}\n  1734\t\n  1735\t// requestPreVote is invoked when we get a request Pre-Vote RPC call.\n285:func (r *Raft) runCandidate() {\n291:\tvar voteCh <-chan *voteResult\n292:\tvar prevoteCh <-chan *preVoteResult\n297:\t\tprevoteCh = r.preElectSelf()\n299:\t\tvoteCh = r.electSelf()\n326:\t\tcase preVote := <-prevoteCh:\n354:\t\t\t\tprevoteCh = nil\n355:\t\t\t\tvoteCh = r.electSelf()\n363:\t\tcase vote := <-voteCh:\n1972:// electSelf is used to send a RequestVote RPC to all peers, and vote for\n1976:func (r *Raft) electSelf() <-chan *voteResult {\n1999:\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n","exit_code":0,"status":"completed"}}
