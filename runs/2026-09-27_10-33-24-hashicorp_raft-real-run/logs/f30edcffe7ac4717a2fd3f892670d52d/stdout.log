{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat ../direct-checks/973ac7105eae4590a963ef51f7c9992a/plan.json\ncat ../direct-checks/973ac7105eae4590a963ef51f7c9992a/assurance_generated_test.go'","aggregated_output":"{\n  \"description\": \"Compare completed public verification success against independently observed replacement election preceding admission; fresh path is a permitted observational control, not a success liveness assertion.\",\n  \"claim_id\": \"verify-no-success-after-replacement\",\n  \"binding_ids\": [\n    \"bind-verify-register\",\n    \"bind-verify-complete\",\n    \"bind-verify-vote\",\n    \"bind-replacement-win\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"sync/atomic\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/hashicorp/go-hclog\\\"\\n)\\n\\n// The transport executes the receiver handler, then controls delivery of its actual reply. The replacement election uses actual follower timeout, candidate tally and peer vote handlers.\\ntype assuranceProducedTransport struct {\\n\\tTransport\\n\\treceiver *Raft\\n\\tvoter    *Raft\\n\\tproduced *AppendEntriesResponse\\n\\tentered  chan struct{}\\n\\trelease  chan struct{}\\n\\tcalls    int32\\n}\\n\\nfunc (a *assuranceProducedTransport) EncodePeer(_ ServerID, addr ServerAddress) []byte {\\n\\treturn []byte(addr)\\n}\\nfunc (a *assuranceProducedTransport) DecodePeer(b []byte) ServerAddress { return ServerAddress(b) }\\nfunc (a *assuranceProducedTransport) AppendEntries(_ ServerID, _ ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\\n\\tn := atomic.AddInt32(&a.calls, 1)\\n\\tresponseCh := make(chan RPCResponse, 1)\\n\\ta.receiver.appendEntries(RPC{Command: req, RespChan: responseCh}, req)\\n\\tresult := <-responseCh\\n\\tif result.Error != nil {\\n\\t\\treturn result.Error\\n\\t}\\n\\tactual := result.Response.(*AppendEntriesResponse)\\n\\tif n == 1 {\\n\\t\\ta.produced = actual\\n\\t\\tclose(a.entered)\\n\\t\\t<-a.release\\n\\t}\\n\\t*resp = *actual\\n\\treturn nil\\n}\\nfunc (a *assuranceProducedTransport) RequestVote(id ServerID, _ ServerAddress, req *RequestVoteRequest, resp *RequestVoteResponse) error {\\n\\tif id != \\\"N\\\" {\\n\\t\\treturn errors.New(\\\"controlled partition to L\\\")\\n\\t}\\n\\tch := make(chan RPCResponse, 1)\\n\\ta.voter.requestVote(RPC{Command: req, RespChan: ch}, req)\\n\\tresult := <-ch\\n\\tif result.Error != nil {\\n\\t\\treturn result.Error\\n\\t}\\n\\t*resp = *result.Response.(*RequestVoteResponse)\\n\\treturn nil\\n}\\nfunc assuranceVerifyEvent(t *testing.T, fields map[string]interface{}) {\\n\\tt.Helper()\\n\\tb, err := json.Marshal(fields)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc TestAssuranceVerifyAfterElection(t *testing.T) {\\n\\tfor _, delayed := range []bool{true, false} {\\n\\t\\tname := \\\"fresh\\\"\\n\\t\\tif delayed {\\n\\t\\t\\tname = \\\"elected_before_verify\\\"\\n\\t\\t}\\n\\t\\tt.Run(name, func(t *testing.T) {\\n\\t\\t\\ttr := &assuranceProducedTransport{entered: make(chan struct{}), release: make(chan struct{})}\\n\\t\\t\\tcfg := DefaultConfig()\\n\\t\\t\\tcfg.LocalID = \\\"L\\\"\\n\\t\\t\\tcfg.HeartbeatTimeout = time.Hour\\n\\t\\t\\tcfg.LeaderLeaseTimeout = time.Hour\\n\\t\\t\\tcfg.ElectionTimeout = time.Hour\\n\\t\\t\\tif err := ValidateConfig(cfg); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tr := &Raft{trans: tr, localID: \\\"L\\\", localAddr: \\\"L\\\", stable: NewInmemStore(), logger: hclog.NewNullLogger(), verifyCh: make(chan *verifyFuture, 4), shutdownCh: make(chan struct{}), noLegacyTelemetry: true, mainThreadSaturation: newSaturationMetric([]string{\\\"assurance\\\"}, time.Hour)}\\n\\t\\t\\tr.conf.Store(*cfg)\\n\\t\\t\\tr.setCurrentTerm(7)\\n\\t\\t\\tr.setState(Leader)\\n\\t\\t\\treceiver := &Raft{trans: tr, localID: \\\"F\\\", localAddr: \\\"F\\\", stable: NewInmemStore(), logger: hclog.NewNullLogger()}\\n\\t\\t\\tfc := *cfg\\n\\t\\t\\tfc.LocalID = \\\"F\\\"\\n\\t\\t\\tfc.HeartbeatTimeout = 5 * time.Millisecond\\n\\t\\t\\tfc.ElectionTimeout = 200 * time.Millisecond\\n\\t\\t\\tfc.LeaderLeaseTimeout = 5 * time.Millisecond\\n\\t\\t\\tif err := ValidateConfig(&fc); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\treceiver.conf.Store(fc)\\n\\t\\t\\treceiver.preVoteDisabled = true\\n\\t\\t\\treceiver.mainThreadSaturation = newSaturationMetric([]string{\\\"assurance_follower\\\"}, time.Hour)\\n\\t\\t\\treceiver.setState(Follower)\\n\\t\\t\\treceiver.setCurrentTerm(7)\\n\\t\\t\\ttr.receiver = receiver\\n\\t\\t\\tr.configurations.latest = Configuration{Servers: []Server{{ID: \\\"L\\\", Address: \\\"L\\\", Suffrage: Voter}, {ID: \\\"F\\\", Address: \\\"F\\\", Suffrage: Voter}, {ID: \\\"N\\\", Address: \\\"N\\\", Suffrage: Voter}}}\\n\\t\\t\\ts := &followerReplication{currentTerm: 7, peer: Server{ID: \\\"F\\\", Address: \\\"F\\\", Suffrage: Voter}, notifyCh: make(chan struct{}, 1), notify: make(map[*verifyFuture]struct{})}\\n\\t\\t\\tr.leaderState.replState = map[ServerID]*followerReplication{\\\"F\\\": s, \\\"N\\\": {peer: Server{ID: \\\"N\\\", Address: \\\"N\\\", Suffrage: Voter}, notifyCh: make(chan struct{}, 1), notify: make(map[*verifyFuture]struct{})}}\\n\\t\\t\\treceiver.configurations = r.configurations\\n\\t\\t\\treceiver.configurations.latestIndex = 1\\n\\t\\t\\treceiver.configurations.committed = receiver.configurations.latest\\n\\t\\t\\treceiver.configurations.committedIndex = 1\\n\\t\\t\\tvoter := &Raft{trans: tr, localID: \\\"N\\\", localAddr: \\\"N\\\", stable: NewInmemStore(), logger: hclog.NewNullLogger(), protocolVersion: cfg.ProtocolVersion}\\n\\t\\t\\tnc := *cfg\\n\\t\\t\\tnc.LocalID = \\\"N\\\"\\n\\t\\t\\tvoter.conf.Store(nc)\\n\\t\\t\\tvoter.setCurrentTerm(7)\\n\\t\\t\\tvoter.setState(Follower)\\n\\t\\t\\tvoter.configurations = receiver.configurations\\n\\t\\t\\ttr.voter = voter\\n\\t\\t\\tr.leaderState.notify = make(map[*verifyFuture]struct{})\\n\\t\\t\\tr.leaderState.commitment = &commitment{startIndex: 1}\\n\\t\\t\\tstop, workerDone, loopDone := make(chan struct{}), make(chan struct{}), make(chan struct{})\\n\\t\\t\\tgo func() { defer close(loopDone); r.leaderLoop() }()\\n\\t\\t\\tvar future Future\\n\\t\\t\\tif delayed {\\n\\t\\t\\t\\ts.notifyCh <- struct{}{}\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tfuture = r.VerifyLeader()\\n\\t\\t\\t}\\n\\t\\t\\tgo func() { defer close(workerDone); r.heartbeat(s, stop) }()\\n\\t\\t\\tselect {\\n\\t\\t\\tcase <-tr.entered:\\n\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\tt.Fatal(\\\"reply production timeout\\\")\\n\\t\\t\\t}\\n\\t\\t\\tassuranceVerifyEvent(t, map[string]interface{}{\\\"event\\\": \\\"reply_produced\\\", \\\"operation\\\": name, \\\"reply_term\\\": tr.produced.Term, \\\"success\\\": tr.produced.Success, \\\"before_invocation\\\": delayed})\\n\\t\\t\\tif delayed {\\n\\t\\t\\t\\telectionDone := make(chan struct{})\\n\\t\\t\\t\\tgo func() { defer close(electionDone); receiver.runFollower(); receiver.runCandidate() }()\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase <-electionDone:\\n\\t\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\t\\tt.Fatal(\\\"replacement election timeout\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\treceiver.routinesGroup.Wait()\\n\\t\\t\\t\\tstoredVote, err := voter.stable.GetUint64(keyLastVoteTerm)\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tassuranceVerifyEvent(t, map[string]interface{}{\\\"event\\\": \\\"replacement_election_completed\\\", \\\"operation\\\": name, \\\"receiver_term\\\": receiver.getCurrentTerm(), \\\"receiver_is_leader\\\": receiver.getState() == Leader, \\\"voter_term\\\": voter.getCurrentTerm(), \\\"voter_persisted_vote_term\\\": storedVote})\\n\\t\\t\\t\\tif receiver.getState() != Leader {\\n\\t\\t\\t\\t\\tt.Fatal(\\\"replacement election did not establish leader\\\")\\n\\t\\t\\t\\t}\\n\\n\\t\\t\\t\\tfuture = r.VerifyLeader()\\n\\t\\t\\t\\t// The first heartbeat is blocked; only actual registration sends this notification.\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase <-s.notifyCh:\\n\\t\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\t\\tt.Fatal(\\\"registration timeout\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tassuranceVerifyEvent(t, map[string]interface{}{\\\"event\\\": \\\"public_verification_admitted\\\", \\\"operation\\\": name, \\\"calls_before_release\\\": atomic.LoadInt32(&tr.calls), \\\"elected_term\\\": receiver.getCurrentTerm()})\\n\\t\\t\\tclose(stop)\\n\\t\\t\\tclose(tr.release)\\n\\t\\t\\tselect {\\n\\t\\t\\tcase <-workerDone:\\n\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\tt.Fatal(\\\"worker completion timeout\\\")\\n\\t\\t\\t}\\n\\t\\t\\tresult := make(chan error, 1)\\n\\t\\t\\tgo func() { result <- future.Error() }()\\n\\t\\t\\tcompleted, success := false, false\\n\\t\\t\\terrText := \\\"\\\"\\n\\t\\t\\tselect {\\n\\t\\t\\tcase err := <-result:\\n\\t\\t\\t\\tcompleted = true\\n\\t\\t\\t\\tsuccess = err == nil\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\terrText = err.Error()\\n\\t\\t\\t\\t}\\n\\t\\t\\tcase <-time.After(300 * time.Millisecond):\\n\\t\\t\\t}\\n\\t\\t\\tclose(r.shutdownCh)\\n\\t\\t\\tselect {\\n\\t\\t\\tcase <-loopDone:\\n\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\tt.Fatal(\\\"leader loop shutdown timeout\\\")\\n\\t\\t\\t}\\n\\t\\t\\tassuranceVerifyEvent(t, map[string]interface{}{\\\"event\\\": \\\"public_verification_observed\\\", \\\"operation\\\": name, \\\"completed\\\": completed, \\\"success\\\": success, \\\"error\\\": errText, \\\"receiver_term\\\": receiver.getCurrentTerm(), \\\"reply_term\\\": tr.produced.Term, \\\"calls\\\": atomic.LoadInt32(&tr.calls)})\\n\\t\\t})\\n\\t}\\n}\\n\",\n    \"description\": \"Actual handler reply held through F follower timeout and candidate election with N persisted vote, then actual L VerifyLeader admission and leaderLoop completion. Stop heartbeat before release, observe Future.Error for 300ms, then stop leaderLoop independently.\",\n    \"semantic_changes\": [\n      \"Manual initial leader/configuration and worker wiring; no NewRaft startup or runLeader noop.\",\n      \"Injected transport executes receiver handlers and partitions election RPCs to L.\",\n      \"Only F heartbeat worker is run; N replication and normal append workers are not scheduled.\",\n      \"Heartbeat and leader lease timers on L are one hour; replacement F uses a validated 5ms heartbeat timeout and 200ms election timeout.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"reply\",\n        \"event\": \"reply_produced\",\n        \"conditions\": [\n          {\n            \"field\": \"before_invocation\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"success\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"reply_term\",\n            \"op\": \"eq\",\n            \"value\": 7,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"election\",\n        \"event\": \"replacement_election_completed\",\n        \"conditions\": [\n          {\n            \"field\": \"receiver_is_leader\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"receiver_term\",\n            \"op\": \"eq\",\n            \"value\": 8,\n            \"reference\": null\n          },\n          {\n            \"field\": \"voter_persisted_vote_term\",\n            \"op\": \"eq\",\n            \"value\": 8,\n            \"reference\": null\n          },\n          {\n            \"field\": \"receiver_term\",\n            \"op\": \"ne\",\n            \"value\": null,\n            \"reference\": \"reply.reply_term\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"admission\",\n        \"event\": \"public_verification_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"calls_before_release\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          },\n          {\n            \"field\": \"elected_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"election.receiver_term\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"s-verify\",\n        \"s-vote-result\",\n        \"s-verify-result-full\",\n        \"s-candidate-win\",\n        \"s-election-producer\",\n        \"s-vote-handler\"\n      ],\n      \"expectation_ids\": [\n        \"s-verify-api\",\n        \"s-verify-doc\"\n      ],\n      \"binding_ids\": [\n        \"bind-verify-register\",\n        \"bind-verify-complete\",\n        \"bind-verify-vote\",\n        \"bind-replacement-win\"\n      ],\n      \"derivation\": \"VerifyLeader is specified to ensure the peer is still leader and prevent stale data after leadership loss. Under a static three-voter configuration, actual election of F in term 8 by its own vote and N vote before invocation means L in term 7 cannot validly confirm continued authority during this operation absent reacquisition. Therefore a completed verification on L must not report success solely on an earlier term-7 reply. This is a necessary negative condition in the observed replacement-election context, not a requirement for all replies to be fresh or for verification eventually to complete.\",\n      \"applicability\": \"Fixed voters L,F,N; pre-vote disabled for the replacement election; no L reelection, configuration change or newer reply during the verification interval; delayed genuine F response.\",\n      \"unresolved\": [\n        \"Initial L leader state and committed configuration are fixtures; startup/election prefix not executed.\",\n        \"Ordinary replication and full runLeader setup are omitted; the controlled window represents their delay, without claiming all production schedules admit it.\",\n        \"Application reads and committed-log safety are excluded.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Newer responses or incoming RPCs could step L down; those are absent in this selected schedule.\",\n        \"Pending verification is allowed. The oracle does not require eventual failure or success.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-verification-result\",\n      \"checker_id\": \"check-verification-authority\",\n      \"event\": \"public_verification_observed\",\n      \"binding_ids\": [\n        \"bind-verify-register\",\n        \"bind-verify-complete\",\n        \"bind-verify-vote\",\n        \"bind-replacement-win\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s-verify\",\n          \"s-vote-result\",\n          \"s-verify-result-full\",\n          \"s-candidate-win\",\n          \"s-election-producer\",\n          \"s-vote-handler\"\n        ],\n        \"expectation_ids\": [\n          \"s-verify-api\",\n          \"s-verify-doc\"\n        ],\n        \"binding_ids\": [\n          \"bind-verify-register\",\n          \"bind-verify-complete\",\n          \"bind-verify-vote\",\n          \"bind-replacement-win\"\n        ],\n        \"derivation\": \"VerifyLeader is specified to ensure the peer is still leader and prevent stale data after leadership loss. Under a static three-voter configuration, actual election of F in term 8 by its own vote and N vote before invocation means L in term 7 cannot validly confirm continued authority during this operation absent reacquisition. Therefore a completed verification on L must not report success solely on an earlier term-7 reply. This is a necessary negative condition in the observed replacement-election context, not a requirement for all replies to be fresh or for verification eventually to complete.\",\n        \"applicability\": \"Fixed voters L,F,N; pre-vote disabled for the replacement election; no L reelection, configuration change or newer reply during the verification interval; delayed genuine F response.\",\n        \"unresolved\": [\n          \"Initial L leader state and committed configuration are fixtures; startup/election prefix not executed.\",\n          \"Ordinary replication and full runLeader setup are omitted; the controlled window represents their delay, without claiming all production schedules admit it.\",\n          \"Application reads and committed-log safety are excluded.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Newer responses or incoming RPCs could step L down; those are absent in this selected schedule.\",\n          \"Pending verification is allowed. The oracle does not require eventual failure or success.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"operation\",\n          \"op\": \"eq\",\n          \"value\": \"elected_before_verify\",\n          \"reference\": null\n        },\n        {\n          \"field\": \"completed\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        },\n        {\n          \"field\": \"calls\",\n          \"op\": \"eq\",\n          \"value\": 1,\n          \"reference\": null\n        }\n      ]\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"check-verification-authority\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"public_verification_observed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"operation\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For a completed verification correlated to the prior reply, actual newer election and admission events, success must be false. A timeout or missing prerequisite is incomplete, not a violation or holds result.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Initial L leader state and committed configuration are fixtures; startup/election prefix not executed.\",\n    \"Ordinary replication and full runLeader setup are omitted; the controlled window represents their delay, without claiming all production schedules admit it.\",\n    \"Application reads and committed-log safety are excluded.\"\n  ]\n}package raft\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/hashicorp/go-hclog\"\n)\n\n// The transport executes the receiver handler, then controls delivery of its actual reply. The replacement election uses actual follower timeout, candidate tally and peer vote handlers.\ntype assuranceProducedTransport struct {\n\tTransport\n\treceiver *Raft\n\tvoter    *Raft\n\tproduced *AppendEntriesResponse\n\tentered  chan struct{}\n\trelease  chan struct{}\n\tcalls    int32\n}\n\nfunc (a *assuranceProducedTransport) EncodePeer(_ ServerID, addr ServerAddress) []byte {\n\treturn []byte(addr)\n}\nfunc (a *assuranceProducedTransport) DecodePeer(b []byte) ServerAddress { return ServerAddress(b) }\nfunc (a *assuranceProducedTransport) AppendEntries(_ ServerID, _ ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n\tn := atomic.AddInt32(&a.calls, 1)\n\tresponseCh := make(chan RPCResponse, 1)\n\ta.receiver.appendEntries(RPC{Command: req, RespChan: responseCh}, req)\n\tresult := <-responseCh\n\tif result.Error != nil {\n\t\treturn result.Error\n\t}\n\tactual := result.Response.(*AppendEntriesResponse)\n\tif n == 1 {\n\t\ta.produced = actual\n\t\tclose(a.entered)\n\t\t<-a.release\n\t}\n\t*resp = *actual\n\treturn nil\n}\nfunc (a *assuranceProducedTransport) RequestVote(id ServerID, _ ServerAddress, req *RequestVoteRequest, resp *RequestVoteResponse) error {\n\tif id != \"N\" {\n\t\treturn errors.New(\"controlled partition to L\")\n\t}\n\tch := make(chan RPCResponse, 1)\n\ta.voter.requestVote(RPC{Command: req, RespChan: ch}, req)\n\tresult := <-ch\n\tif result.Error != nil {\n\t\treturn result.Error\n\t}\n\t*resp = *result.Response.(*RequestVoteResponse)\n\treturn nil\n}\nfunc assuranceVerifyEvent(t *testing.T, fields map[string]interface{}) {\n\tt.Helper()\n\tb, err := json.Marshal(fields)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(b))\n}\nfunc TestAssuranceVerifyAfterElection(t *testing.T) {\n\tfor _, delayed := range []bool{true, false} {\n\t\tname := \"fresh\"\n\t\tif delayed {\n\t\t\tname = \"elected_before_verify\"\n\t\t}\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\ttr := &assuranceProducedTransport{entered: make(chan struct{}), release: make(chan struct{})}\n\t\t\tcfg := DefaultConfig()\n\t\t\tcfg.LocalID = \"L\"\n\t\t\tcfg.HeartbeatTimeout = time.Hour\n\t\t\tcfg.LeaderLeaseTimeout = time.Hour\n\t\t\tcfg.ElectionTimeout = time.Hour\n\t\t\tif err := ValidateConfig(cfg); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tr := &Raft{trans: tr, localID: \"L\", localAddr: \"L\", stable: NewInmemStore(), logger: hclog.NewNullLogger(), verifyCh: make(chan *verifyFuture, 4), shutdownCh: make(chan struct{}), noLegacyTelemetry: true, mainThreadSaturation: newSaturationMetric([]string{\"assurance\"}, time.Hour)}\n\t\t\tr.conf.Store(*cfg)\n\t\t\tr.setCurrentTerm(7)\n\t\t\tr.setState(Leader)\n\t\t\treceiver := &Raft{trans: tr, localID: \"F\", localAddr: \"F\", stable: NewInmemStore(), logger: hclog.NewNullLogger()}\n\t\t\tfc := *cfg\n\t\t\tfc.LocalID = \"F\"\n\t\t\tfc.HeartbeatTimeout = 5 * time.Millisecond\n\t\t\tfc.ElectionTimeout = 200 * time.Millisecond\n\t\t\tfc.LeaderLeaseTimeout = 5 * time.Millisecond\n\t\t\tif err := ValidateConfig(&fc); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\treceiver.conf.Store(fc)\n\t\t\treceiver.preVoteDisabled = true\n\t\t\treceiver.mainThreadSaturation = newSaturationMetric([]string{\"assurance_follower\"}, time.Hour)\n\t\t\treceiver.setState(Follower)\n\t\t\treceiver.setCurrentTerm(7)\n\t\t\ttr.receiver = receiver\n\t\t\tr.configurations.latest = Configuration{Servers: []Server{{ID: \"L\", Address: \"L\", Suffrage: Voter}, {ID: \"F\", Address: \"F\", Suffrage: Voter}, {ID: \"N\", Address: \"N\", Suffrage: Voter}}}\n\t\t\ts := &followerReplication{currentTerm: 7, peer: Server{ID: \"F\", Address: \"F\", Suffrage: Voter}, notifyCh: make(chan struct{}, 1), notify: make(map[*verifyFuture]struct{})}\n\t\t\tr.leaderState.replState = map[ServerID]*followerReplication{\"F\": s, \"N\": {peer: Server{ID: \"N\", Address: \"N\", Suffrage: Voter}, notifyCh: make(chan struct{}, 1), notify: make(map[*verifyFuture]struct{})}}\n\t\t\treceiver.configurations = r.configurations\n\t\t\treceiver.configurations.latestIndex = 1\n\t\t\treceiver.configurations.committed = receiver.configurations.latest\n\t\t\treceiver.configurations.committedIndex = 1\n\t\t\tvoter := &Raft{trans: tr, localID: \"N\", localAddr: \"N\", stable: NewInmemStore(), logger: hclog.NewNullLogger(), protocolVersion: cfg.ProtocolVersion}\n\t\t\tnc := *cfg\n\t\t\tnc.LocalID = \"N\"\n\t\t\tvoter.conf.Store(nc)\n\t\t\tvoter.setCurrentTerm(7)\n\t\t\tvoter.setState(Follower)\n\t\t\tvoter.configurations = receiver.configurations\n\t\t\ttr.voter = voter\n\t\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n\t\t\tr.leaderState.commitment = &commitment{startIndex: 1}\n\t\t\tstop, workerDone, loopDone := make(chan struct{}), make(chan struct{}), make(chan struct{})\n\t\t\tgo func() { defer close(loopDone); r.leaderLoop() }()\n\t\t\tvar future Future\n\t\t\tif delayed {\n\t\t\t\ts.notifyCh <- struct{}{}\n\t\t\t} else {\n\t\t\t\tfuture = r.VerifyLeader()\n\t\t\t}\n\t\t\tgo func() { defer close(workerDone); r.heartbeat(s, stop) }()\n\t\t\tselect {\n\t\t\tcase <-tr.entered:\n\t\t\tcase <-time.After(2 * time.Second):\n\t\t\t\tt.Fatal(\"reply production timeout\")\n\t\t\t}\n\t\t\tassuranceVerifyEvent(t, map[string]interface{}{\"event\": \"reply_produced\", \"operation\": name, \"reply_term\": tr.produced.Term, \"success\": tr.produced.Success, \"before_invocation\": delayed})\n\t\t\tif delayed {\n\t\t\t\telectionDone := make(chan struct{})\n\t\t\t\tgo func() { defer close(electionDone); receiver.runFollower(); receiver.runCandidate() }()\n\t\t\t\tselect {\n\t\t\t\tcase <-electionDone:\n\t\t\t\tcase <-time.After(2 * time.Second):\n\t\t\t\t\tt.Fatal(\"replacement election timeout\")\n\t\t\t\t}\n\t\t\t\treceiver.routinesGroup.Wait()\n\t\t\t\tstoredVote, err := voter.stable.GetUint64(keyLastVoteTerm)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tassuranceVerifyEvent(t, map[string]interface{}{\"event\": \"replacement_election_completed\", \"operation\": name, \"receiver_term\": receiver.getCurrentTerm(), \"receiver_is_leader\": receiver.getState() == Leader, \"voter_term\": voter.getCurrentTerm(), \"voter_persisted_vote_term\": storedVote})\n\t\t\t\tif receiver.getState() != Leader {\n\t\t\t\t\tt.Fatal(\"replacement election did not establish leader\")\n\t\t\t\t}\n\n\t\t\t\tfuture = r.VerifyLeader()\n\t\t\t\t// The first heartbeat is blocked; only actual registration sends this notification.\n\t\t\t\tselect {\n\t\t\t\tcase <-s.notifyCh:\n\t\t\t\tcase <-time.After(2 * time.Second):\n\t\t\t\t\tt.Fatal(\"registration timeout\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tassuranceVerifyEvent(t, map[string]interface{}{\"event\": \"public_verification_admitted\", \"operation\": name, \"calls_before_release\": atomic.LoadInt32(&tr.calls), \"elected_term\": receiver.getCurrentTerm()})\n\t\t\tclose(stop)\n\t\t\tclose(tr.release)\n\t\t\tselect {\n\t\t\tcase <-workerDone:\n\t\t\tcase <-time.After(2 * time.Second):\n\t\t\t\tt.Fatal(\"worker completion timeout\")\n\t\t\t}\n\t\t\tresult := make(chan error, 1)\n\t\t\tgo func() { result <- future.Error() }()\n\t\t\tcompleted, success := false, false\n\t\t\terrText := \"\"\n\t\t\tselect {\n\t\t\tcase err := <-result:\n\t\t\t\tcompleted = true\n\t\t\t\tsuccess = err == nil\n\t\t\t\tif err != nil {\n\t\t\t\t\terrText = err.Error()\n\t\t\t\t}\n\t\t\tcase <-time.After(300 * time.Millisecond):\n\t\t\t}\n\t\t\tclose(r.shutdownCh)\n\t\t\tselect {\n\t\t\tcase <-loopDone:\n\t\t\tcase <-time.After(2 * time.Second):\n\t\t\t\tt.Fatal(\"leader loop shutdown timeout\")\n\t\t\t}\n\t\t\tassuranceVerifyEvent(t, map[string]interface{}{\"event\": \"public_verification_observed\", \"operation\": name, \"completed\": completed, \"success\": success, \"error\": errText, \"receiver_term\": receiver.getCurrentTerm(), \"reply_term\": tr.produced.Term, \"calls\": atomic.LoadInt32(&tr.calls)})\n\t\t})\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The checker reports a violation in the controlled fixture: F became leader in term 8 before `VerifyLeader` was invoked on L, and L’s future then returned success from the held term-7 reply. I’ve checked the saved harness and event ordering. This is a bounded API observation; the initial state was injected, full replication scheduling was omitted, and no application read was executed."}}
