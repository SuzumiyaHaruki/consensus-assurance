expected the leader to step down\")\n  1922\t\t\t}\n  1923\t\tcase <-time.After(conf.HeartbeatTimeout * 3):\n  1924\t\t\tc.FailNowf(\"timeout waiting for leader to step down\")\n  1925\t\t}\n  1926\t\n  1927\t\t// Verify we are leader\n  1928\t\tverify := leader.VerifyLeader()\n  1929\t\n  1930\t\tif err := verify.Error(); err != ErrNotLeader && err != ErrLeadershipLost {\n  1931\t\t\tt.Fatalf(\"err: %v\", err)\n  1932\t\t}\n  1933\t\n  1934\t\t// Ensure the known leader is cleared\n  1935\t\tif l, _ := leader.LeaderWithID(); l != \"\" {\n  1936\t\t\tt.Fatalf(\"bad: %v\", l)\n  1937\t\t}\n  1938\t}\n  1939\t\n  1940\tfunc TestRaft_VerifyLeader_PartialConnect(t *testing.T) {\n  1941\t\t// Make a cluster\n  1942\t\tconf := inmemConfig(t)\n  1943\t\tc := MakeCluster(3, t, conf)\n  1944\t\tdefer c.Close()\n  1945\t\n  1946\t\t// Get the leader\n  1947\t\tleader := c.Leader()\n  1948\t\n  1949\t\t// Wait until we have a followers\n  1950\t\tlimit := time.Now().Add(c.longstopTimeout)\n  1951\t\tvar followers []*Raft\n  1952\t\tfor time.Now().Before(limit) && len(followers) != 2 {\n  1953\t\t\tc.WaitEvent(nil, c.conf.CommitTimeout)\n  1954\t\t\tfollowers = c.GetInState(Follower)\n  1955\t\t}\n  1956\t\tif len(followers) != 2 {\n  1957\t\t\tt.Fatalf(\"expected two followers but got: %v\", followers)\n  1958\t\t}\n  1959\t\n  1960\t\t// Force partial disconnect\n  1961\t\tfollower := followers[0]\n  1962\t\tt.Logf(\"[INFO] Disconnecting %v\", follower)\n  1963\t\tc.Disconnect(follower.localAddr)\n  1964\t\n  1965\t\t// Verify we are leader\n  1966\t\tverify := leader.VerifyLeader()\n  1967\t\n  1968\t\t// Wait for the leader to step down\n  1969\t\tif err := verify.Error(); err != nil {\n  1970\t\t\tt.Fatalf(\"err: %v\", err)\n  1971\t\t}\n  1972\t}\n  1973\t\n  1974\tfunc TestRaft_NotifyCh(t *testing.T) {\n  1975\t\tch := make(chan bool, 1)\n  1976\t\tconf := inmemConfig(t)\n  1977\t\tconf.NotifyCh = ch\n  1978\t\tc := MakeCluster(1, t, conf)\n  1979\t\tdefer c.Close()\n  1980\t\n    40\t### Leader Write\n    41\t\n    42\tMost write operations must be performed on the leader.\n    43\t\n    44\t* RequestConfigChange - update the raft peer list configuration\n    45\t* Apply - apply a log entry to the log on a majority of peers, and the FSM. See [raft apply](apply.md) for more details.\n    46\t* Barrier - a special Apply that does not modify the FSM, used to wait for previous logs to be applied\n    47\t* LeadershipTransfer - stop accepting client requests, and tell a different peer to start a leadership election\n    48\t* Restore (Snapshot) - overwrite the cluster state with the contents of the snapshot (excluding cluster configuration)\n    49\t* VerifyLeader - send a heartbeat to all voters to confirm the peer is still the leader\n    50\t\n    51\t### Follower Write\n    52\t\n    53\t* BootstrapCluster - store the cluster configuration in the local log store\n{\n  \"version\": 1,\n  \"target_profile\": {\n    \"system_boundary\": \"The repository Go raft package, including replication and lease consumers plus built-in storage and transport variants. Application FSM and deployment adapter selection remain caller responsibilities; built-in implementations are inside the available audit boundary.\",\n    \"protocol_contexts\": [\n      \"Raft current term and per-follower replication currentTerm\",\n      \"Peer ServerID/address and latest configuration voter membership\",\n      \"Per-replication-object lastContact timestamp\"\n    ],\n    \"external_interfaces\": [\n      \"FSM\",\n      \"LogStore\",\n      \"StableStore\",\n      \"SnapshotStore\",\n      \"Transport\"\n    ],\n    \"ownership\": [\n      \"replicate launches a separate heartbeat goroutine for a followerReplication object\",\n      \"checkLeaderLease is owned by the main Raft thread\",\n      \"NewRaft restores current term and last log through injected stores\"\n    ],\n    \"selection_injection\": [\n      \"NewRaft receives all five interfaces from its caller; no deployed adapter choice is supplied.\",\n      \"NetworkTransport selects an injected stream and timeout; InmemTransport has its own queue and timeout.\"\n    ],\n    \"variants\": [\n      \"Ordinary AppendEntries and pipelined AppendEntries response processing\",\n      \"Pre-vote disabled by configuration or missing WithPreVote transport capability\",\n      \"BatchApplyCh optionally buffers admission\",\n      \"Built-in InmemStore, InmemSnapshotStore and FileSnapshotStore constructors; their failure semantics remain unexpanded\",\n      \"NetworkTransport and InmemTransport; the latter does not support heartbeat fast-path registration\"\n    ],\n    \"source_ids\": [\n      \"s-constructor\",\n      \"s-spawn\",\n      \"s-repl-context\",\n      \"s-network\",\n      \"s-inmem-transport\",\n      \"s-memory-store\",\n      \"s-memory-snapshot\",\n      \"s-file-snapshot\"\n    ],\n    \"unknowns\": [\n      \"Concrete deployed configuration, adapters and FSM are unspecified.\",\n      \"Startup, storage failure semantics, snapshot publication and network fast-path dispatch need deeper reading.\"\n    ]\n  },\n  \"activities\": [\n    {\n      \"class_id\": \"A2\",\n      \"applicability\": \"applicable\",\n      \"purpose\": \"Authority maintenance and interpretation of peer responses\",\n      \"realization_summary\": \"Heartbeat response completion feeds the lease connectivity consumer; stale AppendEntries rejection has been read separately.\",\n      \"entry_points\": [\n        \"Raft.heartbeat\",\n        \"Raft.checkLeaderLease\",\n        \"Raft.appendEntries\"\n      ],\n      \"behavior_ids\": [\n        \"b-heartbeat-contact\",\n        \"b-lease-consume\",\n        \"b-reject-old-append\"\n      ],\n      \"variants\": [],\n      \"unknowns\": [\n        \"Election, transfer, full step-down and verification completion paths remain partial.\"\n      ],\n      \"source_ids\": [\n        \"s-heartbeat\",\n        \"s-lease\",\n        \"s-receive