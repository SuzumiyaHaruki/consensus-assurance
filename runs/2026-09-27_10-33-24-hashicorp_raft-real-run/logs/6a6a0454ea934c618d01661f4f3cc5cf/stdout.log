,\n      \"consumed_by\": [\n        \"b-lease-consume\"\n      ],\n      \"validity_context\": \"Volatile contact observation for the same replication object; lease consumer bounds age separately.\",\n      \"representation\": [\n        \"followerReplication.lastContact\"\n      ],\n      \"invalidators\": [],\n      \"reinterpreters\": [],\n      \"durability\": \"Volatile timestamp protected by lastContactLock; no persistence claimed.\",\n      \"recovery\": \"No recovery semantics established; initialization and object replacement remain unread.\",\n      \"source_ids\": [\n        \"s-heartbeat\",\n        \"s-repl-context\",\n        \"s-lease\"\n      ],\n      \"unknowns\": [\n        \"Other timestamp producers exist and are not included as producers of this heartbeat-specific fact.\",\n        \"Address/configuration replacement and initial contact assignments remain to be mapped.\"\n      ]\n    }\n  ],\n  \"surfaces\": [\n    {\n      \"entry_point\": \"Raft.heartbeat\",\n      \"disposition\": \"mapped\",\n      \"behavior_ids\": [\n        \"b-heartbeat-contact\"\n      ],\n      \"reason\": \"Mapped only error-free heartbeat contact production.\",\n      \"source_ids\": [\n        \"s-heartbeat\"\n      ],\n      \"high_consequence\": true\n    },\n    {\n      \"entry_point\": \"Raft.checkLeaderLease\",\n      \"disposition\": \"mapped\",\n      \"behavior_ids\": [\n        \"b-lease-consume\"\n      ],\n      \"reason\": \"Mapped timestamp consumption, not overall authority correctness.\",\n      \"source_ids\": [\n        \"s-lease\"\n      ],\n      \"high_consequence\": true\n    },\n    {\n      \"entry_point\": \"Raft.appendEntries\",\n      \"disposition\": \"mapped\",\n      \"behavior_ids\": [\n        \"b-reject-old-append\"\n      ],\n      \"reason\": \"Only older-term rejection branch is recovered.\",\n      \"source_ids\": [\n        \"s-receiver\"\n      ],\n      \"high_consequence\": true\n    },\n    {\n      \"entry_point\": \"Raft.verifyLeader\",\n      \"disposition\": \"deferred\",\n      \"behavior_ids\": [],\n      \"reason\": \"Read initial request setup; future vote aggregation and completion require expansion.\",\n      \"source_ids\": [\n        \"s-verify\",\n        \"s-verify-result\"\n      ],\n      \"high_consequence\": true\n    },\n    {\n      \"entry_point\": \"Raft.replicateTo / Raft.pipelineDecode\",\n      \"disposition\": \"deferred\",\n      \"behavior_ids\": [],\n      \"reason\": \"Term guards provide counterevidence; full worker and step-down lifetime need tracing.\",\n      \"source_ids\": [\n        \"s-append-response\",\n        \"s-pipeline-response\",\n        \"s-stale\"\n      ],\n      \"high_consequence\": true\n    },\n    {\n      \"entry_point\": \"NewRaft storage restoration\",\n      \"disposition\": \"deferred\",\n      \"behavior_ids\": [],\n      \"reason\": \"Constructor read, but built-in failure and recovery semantics remain unexpanded.\",\n      \"source_ids\": [\n        \"s-constructor\"\n      ],\n      \"high_consequence\": true\n    }\n  ]\n}","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"Both explored orderings produced a notification for the same verification future with two votes from one RPC plus the local vote. That establishes a local association result only: the harness supplied the response after registration, so it did not test reuse of an already-produced reply. I’ll map the aggregation and completion boundary while preserving that missing causal step."}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > map_verify.py <<'PY'\nimport json\nfrom pathlib import Path\nimport jsonschema\nm=json.load(open('../audit-spec/v1.json'));m['version']=2\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None);f.pop('consumed_by',None)\nm['behaviors'] += [dict(id='b-verify-positive-threshold',primary_activity='A2',execution_owner='Response-processing goroutine calling verifyFuture.vote(true)',protocol_context='One verifyFuture object with nonnil notifyCh and threshold initialized by verifyLeader',trigger='A positive vote call while this future remains active',legal_preconditions=['verifyLeader initialized self-vote, quorumSize and notifyCh for a multi-voter configuration','A replication notification dispatcher captured this future in its pending set'],implementation_guards=['voteLock serializes votes','nil notifyCh suppresses later votes','Threshold notification is sent only when votes >= quorumSize'],reads=['v.notifyCh','v.votes','v.quorumSize'],writes=['Increment v.votes','Clear v.notifyCh after sending threshold notification'],external_effects=['Send the same future pointer to main-thread verifyCh'],async_boundaries=['Channel send while voteLock is held','Pending-set capture in notifyAll happens under a separate lock'],produces_fact_ids=['f-verify-threshold'],source_ids=['s-vote-result','s-verify','s-notify-votes'],unknowns=['Full provenance and time of each supporting peer response are not represented by vote parameters.','Negative-vote notifications follow a separate branch and do not establish this positive-threshold fact.','Other response producers, configurations and replication-object lifetimes are only partially read.']),dict(id='b-verify-success-consume',primary_activity='A7',execution_owner='Raft leader main loop',protocol_context='Received verification future with nonzero quorumSize and votes >= quorumSize',trigger='Receive future pointer from verifyCh in leader loop',implementation_guards=['Zero quorumSize routes to initial registration','Below-threshold notification routes to ErrNotLeader and Follower transition'],reads=['v.votes','v.quorumSize'],writes=['Remove future from leaderState.notify and all follower pending sets'],external_effects=['v.respond(nil) completes verification successfully'],consumes_fact_ids=['f-verify-threshold'],cross_activity_effects={'A2':'Interprets threshold support as continued leadership for this verification operation.'},source_ids=['s-verify-result-full'],unknowns=['Future.Error delivery and all leader-loop exits have not been expanded.','Successful verification does not itself apply the FSM or observe a client read.'])]\nm['facts'].append(dict(id='f-verify-threshold',meaning='For this verifyFuture object, positive vote calls have raised its counter to at least the threshold captured at registration, and that object has been sent to the verification result channel. This states counted support, not freshness or correctness of peer authority.',identity={'verification':'verifyFuture pointer','threshold':'quorumSize captured by verifyLeader'},validity_context='One active multi-voter verification object; positive branch under voteLock before notifyCh is cleared.',representation=['v.votes','v.quorumSize','future pointer sent on r.verifyCh'],durability='Volatile; no persisted verification support.',recovery='No restoration of this future established; leader-exit cancellation remains unexpanded.',source_ids=['s-vote-result','s-verify','s-verify-result-full'],unknowns=['Upstream peer response production and registration-relative age need mapping.','Membership and term are not fields on verifyFuture; lifetime protection requires separate reading.']))\nm['activities'].append(dict(class_id='A7',applicability='applicable',purpose='Client verification completion semantics',realization_summary='Leader loop converts counted verification support into successful future completion; public API describes prevention of stale data after leadership loss.',entry_points=['Raft.VerifyLeader','leaderLoop verification result branch'],source_ids=['s-verify-api','s-verify-result-full'],unknowns=['Application read ordering, FSM freshness, future delivery and shutdown paths remain partial.']))\nm['surfaces'].append(dict(entry_point='verifyFuture.vote / leaderLoop verification completion',disposition='mapped',behavior_ids=['b-verify-positive-threshold','b-verify-success-consume'],reason='Positive threshold establishment and success consumption are mapped; upstream response provenance remains partial.',source_ids=['s-vote-result','s-verify-result-full'],high_consequence=True))\nPath('audit-map-v2.json').write_text(json.dumps(m,indent=2)+'\\\\n')\nq=dict(audit_spec_version=2,disposition='concrete_suspicion',preferred_check='controlled_schedule',question='Can verification support counted from a reply produced before registration cause successful VerifyLeader completion after the local peer has already lost leadership, or do request ordering and independent transition paths prevent that history?',importance='The API advertises leadership verification for avoiding stale data after leadership loss. Support freshness may affect that use; a counter reaching quorum alone does not establish an incorrect verification return or stale application read.',source_ids=['s-verify-api','s-verify','s-vote-result','s-notify-votes','s-heartbeat','s-verify-result-full','s-verify-doc','s-verify-tests'],participants=['Local purported leader','Voting peers'],objects=['verifyFuture','Pending notification sets','Heartbeat reply'],contexts=['Verification registration relative to remote reply production and later delivery','Same future identity and captured quorum','Crash-only message delay, static membership initially'],event_paths=['verifyLeader registration -> per-peer pending set -> notifyAll -> vote(true) threshold -> main-thread success branch'],activity_classes=