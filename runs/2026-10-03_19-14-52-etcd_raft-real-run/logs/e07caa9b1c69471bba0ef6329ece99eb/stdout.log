te consumes only its matching vote-response type; first response per voter counted; current voter quorum determines result'],writes=['Term, Vote, state, lead, step and tick callbacks; resets progress, vote tally, readOnly and pendingConfIndex'],external_effects=['Winning pre-election starts real election; winning election appends empty current-term entry and broadcasts','Real higher-term messages normally cause follower transition; pre-vote and in-lease exceptions are explicit'],async_boundaries=['Self vote and remote vote replies wait in msgsAfterAppend'],produces_fact_ids=['F-authority'],existing_protections=['Step ignores old-term responses; same-term candidate append/heartbeat/snapshot steps down'],unknowns=['Interactions of optimized Advance-before-application with election configuration scanning remain unexamined'])\nbeh('B-leadercommit','A1','raft stepLeader/maybeCommit','Leader current term and current voter configuration','Proposal or append response',['S-proposal','S-reset','S-ack','S-tracker','S-quorum','S-majority','S-commitguard'],implementation_guards=['Reject proposals when removed or transfer active; cap uncommitted payload','Require known progress for response sender; old terms filtered by Step','maybeCommit requires a larger quorum index whose log term equals current term'],reads=['Progress.Match of voters, raftLog and Term'],writes=['Term/index assigned on append; self acknowledgment queued; per-peer Match and committed index'],external_effects=['Successful response-based commit releases pending reads and broadcasts append; redundant successful responses need not repeat these effects','Replication response updates free inflights and may resume sending or complete transfer catch-up'],produces_fact_ids=['F-commit'],consumes_fact_ids=['F-authority'],unknowns=['Configuration-triggered commit has different read-release effects; legal first-current-term history remains unresolved'])\nbeh('B-followerlog','A1','raft handleAppendEntries/handleHeartbeat','F