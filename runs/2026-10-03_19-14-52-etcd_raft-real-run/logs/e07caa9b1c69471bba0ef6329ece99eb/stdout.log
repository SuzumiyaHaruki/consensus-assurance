Point\", \"type\": \"string\"}, \"disposition\": {\"enum\": [\"mapped\", \"externalized\", \"infrastructure\", \"deferred\", \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"], \"title\": \"Disposition\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"high_consequence\": {\"default\": false, \"title\": \"High Consequence\", \"type\": \"boolean\"}}, \"required\": [\"entry_point\", \"disposition\", \"reason\"], \"title\": \"Surface\", \"type\": \"object\"}, \"TargetProfile\": {\"additionalProperties\": false, \"properties\": {\"system_boundary\": {\"title\": \"System Boundary\", \"type\": \"string\"}, \"protocol_contexts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Protocol Contexts\", \"type\": \"array\"}, \"external_interfaces\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Interfaces\", \"type\": \"array\"}, \"ownership\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Ownership\", \"type\": \"array\"}, \"selection_injection\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Selection Injection\", \"type\": \"array\"}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}, \"required\": [\"system_boundary\"], \"title\": \"TargetProfile\", \"type\": \"object\"}}, \"additionalProperties\": false, \"properties\": {\"version\": {\"default\": 1, \"title\": \"Version\", \"type\": \"integer\"}, \"target_profile\": {\"$ref\": \"#/$def