        \"type\": \"string\"\n      },\n      \"title\": \"Uncertainties\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"description\",\n    \"claim_id\",\n    \"binding_ids\",\n    \"harness\",\n    \"monitors\",\n    \"observable_properties\"\n  ],\n  \"title\": \"DirectCheckPlan\",\n  \"type\": \"object\"\n}\n\nTYPE Comparison REQUIRED ['field']\n{\"field\": {\"title\": \"Field\", \"type\": \"string\"}, \"op\": {\"default\": \"eq\", \"enum\": [\"eq\", \"ne\"], \"title\": \"Op\", \"type\": \"string\"}, \"value\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"integer\"}, {\"type\": \"boolean\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Value\"}, \"reference\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Reference\"}}\n\nTYPE EventMonitor REQUIRED ['id', 'checker_id', 'event', 'binding_ids', 'grounding']\n{\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"event\": {\"title\": \"Event\", \"type\": \"string\"}, \"binding_ids\": {\"items\": {\"type\": \"string\"}, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"grounding\": {\"$ref\": \"#/$defs/Grounding\"}, \"applicability_conditions\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/Comparison\"}, \"title\": \"Applicability Conditions\", \"type\": \"array\"}, \"admission_alias\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\", \"title\": \"Admission Alias\"}}\n\nTYPE EventRequirement REQUIRED ['alias', 'event']\n{\"alias\": {\"title\": \"Alias\", \"type\": \"string\"}, \"event\": {\"title\": \"Event\", \"type\": \"string\"}, \"conditions\": {\"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\", \"items\": {\"$ref\": \"#/$defs/Comparison\"}, \"title\": \"Conditions\", \"type\": \"array\"}}\n\nTYPE Grounding REQUIRED None\n{\"source_ids\": {\"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\", \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"expectation_ids\": {\"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\", \"items\": {\"type\": \"string\"}, \"title\": \"Expectation Ids\", \"type\": \"array\"}, \"binding_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"derivation\": {\"default\": \"\", \"description\": \"This component\\u2019s sourced reasoning; cite accepted IDs instead of repeating their full argument\", \"title\": \"Derivation\", \"type\": \"string\"}, \"applicability\": {\"default\": \"\", \"description\": \"Conditions for this component, including any added assumptions or omitted protections\", \"title\": \"Applicability\", \"type\": \"string\"}, \"unresolved\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unresolved\", \"type\": \"array\"}, \"conflicts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Conflicts\", \"type\": \"array\"}, \"alternatives\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Alternatives\", \"type\": \"array\"}}\n\nTYPE Harness REQUIRED ['kind', 'source', 'description', 'semantic_changes']\n{\"execution_package\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Optional single Go package directory; the controller fixes the effective package at acceptance\", \"title\": \"Execution Package\"}, \"files\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Additional generated files with relative destinations and fixed source text\", \"title\": \"Files\", \"type\": \"object\"}, \"kind\": {\"description\": \"Harness kind advertised by the configured execution backend\", \"title\": \"Kind\", \"type\": \"string\"}, \"source\": {\"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\", \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}, \"semantic_changes\": {\"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\", \"items\": {\"type\": \"string\"}, \"title\": \"Semantic Changes\", \"type\": \"array\"}, \"prerequisites\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/EventRequirement\"}, \"title\": \"Prerequisites\", \"type\": \"array\"}, \"legality\": {\"$ref\": \"#/$defs/Grounding\", \"default\": {\"source_ids\": [], \"expectation_ids\": [], \"binding_ids\": [], \"derivation\": \"\", \"applicability\": \"\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}}}\n\nTYPE ObservableProperty REQUIRED ['checker_id', 'trigger', 'assertion', 'description']\n{\"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"kind\": {\"default\": \"event_assertion\", \"enum\": [\"event_assertion\", \"event_implication\"], \"title\": \"Kind\", \"type\": \"string\"}, \"trigger\": {\"$ref\": \"#/$defs/Comparison\"}, \"assertion\": {\"$ref\": \"#/$defs/Comparison\"}, \"antecedent\": {\"anyOf\": [{\"$ref\": \"#/$defs/Comparison\"}, {\"type\": \"null\"}], \"default\": null}, \"identity_fields\": {\"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}\n","exit_code":0,"status":"completed"}}
