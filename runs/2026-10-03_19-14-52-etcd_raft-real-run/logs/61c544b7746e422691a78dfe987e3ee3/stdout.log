rness Path\",\n      \"type\": \"string\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Destination path to draft source path for helpers\",\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    },\n    \"previous_check_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Check Id\"\n    },\n    \"repair_issue_ids\": {\n      \"description\": \"Exact issues whose driver premises the new harness legality answers; admission does not resolve them\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Repair Issue Ids\",\n      \"type\": \"array\"\n    },\n    \"encoding_revision\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/EncodingRevision\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"plan_path\",\n    \"harness_path\"\n  ],\n  \"title\": \"CheckSubmission\",\n  \"type\": \"object\"\n}\nClaimDraft {\n  \"additionalProperties\": false,\n  \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"obligation\",\n        \"assumption\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"concern\": {\n      \"default\": \"implementation_semantics\",\n      \"enum\": [\n        \"consensus_safety\",\n        \"bounded_liveness\",\n        \"implementation_semantics\"\n      ],\n      \"title\": \"Concern\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"description\": \"Required relation across applicable objects and contexts;