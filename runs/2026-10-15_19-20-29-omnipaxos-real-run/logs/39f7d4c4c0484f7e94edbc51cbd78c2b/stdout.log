nsistent = log_indices_consistent(&c, &logs[0].1);\n    emit(\n        \"case_result_batched\",\n        json!({\n            \"case\": \"batched_mixed_proposals\",\n            \"decided_everywhere\": decided_everywhere,\n            \"all_logs_equal\": all_logs_equal,\n            \"all_values_present\": all_values_present,\n            \"index_content_consistent\": index_content_consistent,\n            \"decided_len\": logs[0].1.len(),\n        }),\n    );\n    assert!(\n        decided_everywhere,\n        \"not every node decided all {total} entries: {:?}\",\n        c.alive()\n            .iter()\n            .map(|p| (*p, c.decided_idx(*p)))\n            .collect::<Vec<_>>()\n    );\n}\n\nfn log_indices_consistent(c: &Cluster, values: &[u64]) -> bool {\n    c.alive().iter().all(|p| {\n        values\n            .iter()\n            .enumerate()\n            .all(|(idx, v)| c.decided_at(*p, idx) == Some(*v))\n    })\n}\n\n/// Case: a leader change plus recovery of the old leader must not change or shorten the decided\n/// prefix on any node.\n#[test]\nfn leader_change_and_recovery_preserve_decided_prefix() {\n    let mut c = Cluster::new(3, 2);\n    assert!(\n        c.pump_until(2000, |c| c.leader().is_some()),\n        \"no leader was elected in the leader-change case\"\n    );\n    let l1 = c.leader().unwrap();\n    for i in 0..6u64 {\n        assert!(c.append(l1, TestEntry(i)), \"phase A proposal {i} rejected\");\n    }\n    assert!(\n        c.pump_until(6000, |c| c.alive()\n            .iter()\n            .all(|p| c.decided_idx(*p) == 6)),\n        \"phase A prefix was not decided everywhere\"\n    );\n    let prefix = c.decided_values(l1);\n    emit(\n        \"leader_change_admitted\",\n        json!({\n            \"case\": \"leader_change_prefix\",\n            \"initial_leader\": l1,\n            \"prefix_len\": prefix.len(),\n            \"prefix\": format!(\"{prefix:?}\"),\n        }),\n    );\n\n    c.crash(l1);\n    let new_leader_found = c.pump_until(4000, |c| c.leader().is_some());\n    let l2 = c.leader().unwrap_or(l1);\n    for i in 200..204u64 {\n        assert!(c.append(l2, TestEntry(i)), \"phase B proposal {i} rejected\");\n    }\n    let decided_everywhere = c.pump_until(6000, |c| {\n        c.alive().iter().all(|p| c.decided_idx(*p) == 10)\n    });\n    let logs_after_change: Vec<(NodeId, Vec<u64>)> = c\n        .alive()\n        .iter()\n        .map(|p| (*p, c.decided_values(*p)))\n        .collect();\n    let all_logs_equal = logs_after_change\n        .iter()\n        .all(|(_, v)| *v == logs_after_change[0].1);\n    let prefix_preserved = logs_after_change\n        .iter()\n        .all(|(_, v)| v.len() >= prefix.len() && v[..prefix.len()] == prefix[..]);\n    emit(\n        \"case_result_leader_change\",\n        json!({\n            \"case\": \"leader_change_prefix\",\n            \"new_leader_found\": new_leader_found,\n            \"new_leader\": l2,\n            \"decided_everywhere\": decided_everywhere,\n            \"prefix_preserved\": prefix_preserved,\n            \"all_logs_equal\": all_logs_equal,\n            \"decided_len\": logs_after_change[0].1.len(),\n        }),\n    );\n\n    // Bring the old leader back from its persisted storage and check it converges without changing\n    // anything that was already decided.\n    c.recover(l1);\n    let caught_up = c.pump_until(8000, |c| {\n        c.alive()\n            .iter()\n            .all(|p| c.decided_idx(*p) == 10 && c.decided_values(*p) == logs_after_change[0].1)\n    });\n    let recovered_log = c.decided_values(l1);\n    emit(\n        \"case_result_leader_change_recovered\",\n        json!({\n            \"case\": \"leader_change_prefix\",\n            \"recovered_caught_up\": caught_up,\n            \"recovered_prefix_preserved\": recovered_log.len() >= prefix.len()\n                && recovered_log[..prefix.len()] == prefix[..],\n            \"recovered_all_logs_equal\": c\n                .alive()\n                .iter()\n                .all(|p| c.decided_values(*p) == recovered_log),\n        }),\n    );\n}\nRSEOF\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run && cp draft/assurance_generated.rs draft/tmp/ws/omnipaxos/tests/assurance_generated.rs && cd draft/tmp/ws && CARGO_TARGET_DIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/target timeout 400 cargo test --offline --locked -p omnipaxos --features async_runtime,serde,logging,macros --test assurance_generated -- --nocapture --test-threads=1 2>&1 | grep \"CA_EVENT'\"\\\\|test result\\\\|\"'^error'\"\\\\|panicked\\\" | tail -14\"","aggregated_output":"CA_EVENT {\"batch_size\":4,\"case\":\"batched_mixed_proposals\",\"event\":\"batched_admitted\",\"follower\":1,\"leader\":3,\"proposals\":16}\nCA_EVENT {\"all_logs_equal\":true,\"all_values_present\":true,\"case\":\"batched_mixed_proposals\",\"decided_everywhere\":true,\"decided_len\":16,\"event\":\"case_result_batched\",\"index_content_consistent\":true}\nCA_EVENT {\"case\":\"leader_change_prefix\",\"event\":\"leader_change_admitted\",\"initial_leader\":3,\"prefix\":\"[0, 1, 2, 3, 4, 5]\",\"prefix_len\":6}\nCA_EVENT {\"all_logs_equal\":true,\"case\":\"leader_change_prefix\",\"decided_everywhere\":true,\"decided_len\":10,\"event\":\"case_result_leader_change\",\"new_leader\":2,\"new_leader_found\":true,\"prefix_preserved\":true}\nCA_EVENT {\"case\":\"leader_change_prefix\",\"event\":\"case_result_leader_change_recovered\",\"recovered_all_logs_equal\":true,\"recovered_caught_up\":true,\"recovered_prefix_preserved\":true}\nCA_EVENT {\"batch_size\":3,\"case\":\"stale_decided_vs_compacted_follower\",\"entries_per_batch\":3,\"event\":\"setup\",\"healthy_follower\":2,\"initial_leader\":3,\"stale_node\":1}\nCA_EVENT {\"case\":\"stale_decided_vs_compacted_follower\",\"event\":\"case_admitted\",\"f_accepted_idx\":6,\"f_decided_idx\":6,\"v_accepted_idx\":6,\"v_decided_idx\":3}\nCA_EVENT {\"case\":\"stale_decided_vs_compacted_follower\",\"event\":\"trim_applied\",\"healthy_follower_compacted_idx\":6,\"old_leader_compacted_idx\":6,\"stale_node_compacted_idx\":0,\"trim_idx\":6}\nCA_EVENT {\"case\":\"stale_decided_vs_compacted_follower\",\"event\":\"new_leader_established\",\"healthy_follower_accepted_idx\":6,\"healthy_follower_ballot\":\"Ballot { config_id: 1, n: 2, priority: 0, pid: 2 }\",\"healthy_follower_compacted_idx\":6,\"healthy_follower_decided_idx\":6,\"healthy_follower_is_leader\":true,\"stale_node_accepted_idx\":6,\"stale_node_decided_idx\":3,\"stale_node_promise\":\"Ballot { config_id: 1, n: 2, priority: 0, pid: 2 }\"}\nthread 'stale_decided_node_prepares_against_compacted_follower' (165) panicked at omnipaxos_storage/src/memory_storage.rs:103:31:\nCA_EVENT {\"case\":\"stale_decided_vs_compacted_follower\",\"event\":\"log_sync_outcome\",\"healthy_follower_compacted_idx\":6,\"messages_delivered_this_step\":0,\"outcome\":\"aborted_panic\",\"panic_message\":\"attempt to subtract with overflow\",\"stale_node_accepted_idx\":6,\"stale_node_decided_idx\":3}\nCA_EVENT {\"attempted_messages\":99,\"case\":\"stale_decided_vs_compacted_follower\",\"delivered_messages\":80,\"dropped_messages\":18,\"event\":\"run_summary\"}\ntest result: ok. 3 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in 0.02s\n","exit_code":0,"status":"completed"}}
