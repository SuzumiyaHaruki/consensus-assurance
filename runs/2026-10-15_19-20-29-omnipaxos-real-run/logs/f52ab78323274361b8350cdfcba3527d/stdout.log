         configuration_id,\\\"\\\"\\\")\ns=s.replace(\\\"\\\"\\\"    fn recover(&mut self, pid: NodeId) {\n        let store = self.stores[&pid].clone();\n        let (n, batch) = (self.n, self.batch);\n        self.ops\n            .insert(pid, build_op(pid, nodes_vec(n), batch, store));\n    }\\\"\\\"\\\",\\\"\\\"\\\"    fn recover(&mut self, pid: NodeId) {\n        let store = self.stores[&pid].clone();\n        let (n, batch, configuration_id) = (self.n, self.batch, self.configuration_id);\n        self.ops.insert(\n            pid,\n            build_op(pid, nodes_vec(n), batch, configuration_id, store),\n        );\n    }\\\"\\\"\\\")\nopen(p,'w').write(s)\nprint('refactor done')\nEOF\ncat >> assurance_generated.rs <<'RSEOF'\n\n/// Case: once the current configuration is stopped, the next configuration listed in the StopSign\n/// can be started and reaches decisions on its own.\n#[test]\nfn next_configuration_starts_after_stopsign() {\n    let mut c2 = Cluster::with_config(3, 2, 2);\n    let leader_found = c2.pump_until(2000, |c| c.leader().is_some());\n    let leader = c2.leader();\n    let decided = match leader {\n        Some(leader) => {\n            for i in 0..4u64 {\n                assert\"'!(\n                    c2.append(leader, TestEntry(i)),\n                    \"next-configuration proposal {i} rejected\"\n                );\n            }\n            c2.pump_until(6000, |c| c.alive().iter().all(|p| c.decided_idx(*p) == 4))\n        }\n        None => false,\n    };\n    let logs_equal = match leader {\n        Some(_) => {\n            let logs: Vec<(NodeId, Vec<u64>)> = c2\n                .alive()\n                .iter()\n                .map(|p| (*p, c2.decided_values(*p)))\n                .collect();\n            logs.iter().all(|(_, v)| *v == logs[0].1) && logs[0].1.len() == 4\n        }\n        None => false,\n    };\n    emit(\n        \"case_result_next_config\",\n        json!({\n            \"case\": \"next_configuration_starts\",\n            \"configuration_id\": c2.configuration_id,\n            \"leader_found\": leader_found,\n            \"entries_decided\": decided,\n            \"logs_equal\": logs_equal,\n        }),\n    );\n}\nRSEOF\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run && cp draft/assurance_generated.rs draft/tmp/ws/omnipaxos/tests/assurance_generated.rs && cd draft/tmp/ws && CARGO_TARGET_DIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/target timeout 400 cargo test --offline --locked -p omnipaxos --features async_runtime,serde,logging,macros --test assurance_generated -- --nocapture --test-threads=1 2>&1 | grep \"CA_EVENT'\"\\\\|test result\\\\|\"'^error'\"\\\\|panicked\\\" | tail -6\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
