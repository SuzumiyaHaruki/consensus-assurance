{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/storage/internal_storage.rs'","aggregated_output":"     1\tuse super::state_cache::StateCache;\n     2\tuse crate::{\n     3\t    ballot_leader_election::Ballot,\n     4\t    storage::{Entry, Snapshot, SnapshotType, StopSign, Storage, StorageOp, StorageResult},\n     5\t    util::{AcceptedMetaData, IndexEntry, LogEntry, LogSync, SnapshottedEntry},\n     6\t    CompactionErr,\n     7\t};\n     8\t#[cfg(feature = \"unicache\")]\n     9\tuse crate::{unicache::*, util::NodeId};\n    10\tuse std::{\n    11\t    cmp::Ordering,\n    12\t    marker::PhantomData,\n    13\t    ops::{Bound, RangeBounds},\n    14\t};\n    15\t\n    16\tpub(crate) struct InternalStorageConfig {\n    17\t    pub(crate) batch_size: usize,\n    18\t}\n    19\t\n    20\t/// Internal representation of storage. Serves as the interface between Sequence Paxos and the\n    21\t/// storage back-end.\n    22\tpub(crate) struct InternalStorage<I, T>\n    23\twhere\n    24\t    I: Storage<T>,\n    25\t    T: Entry,\n    26\t{\n    27\t    storage: I,\n    28\t    state_cache: StateCache<T>,\n    29\t    _t: PhantomData<T>,\n    30\t}\n    31\t\n    32\timpl<I, T> InternalStorage<I, T>\n    33\twhere\n    34\t    I: Storage<T>,\n    35\t    T: Entry,\n    36\t{\n    37\t    pub(crate) fn with(\n    38\t        storage: I,\n    39\t        config: InternalStorageConfig,\n    40\t        #[cfg(feature = \"unicache\")] pid: NodeId,\n    41\t    ) -> Self {\n    42\t        let mut internal_store = InternalStorage {\n    43\t            storage,\n    44\t            state_cache: StateCache::new(\n    45\t                config,\n    46\t                #[cfg(feature = \"unicache\")]\n    47\t                pid,\n    48\t            ),\n    49\t            _t: Default::default(),\n    50\t        };\n    51\t        internal_store.load_cache();\n    52\t        internal_store\n    53\t    }\n    54\t\n    55\t    fn load_cache(&mut self) {\n    56\t        self.state_cache.promise = self\n    57\t            .storage\n    58\t            .get_promise()\n    59\t            .expect(\"Failed to load cache from storage.\")\n    60\t            .unwrap_or_default();\n    61\t        self.state_cache.decided_idx = self.storage.get_decided_idx().unwrap();\n    62\t        self.state_cache.accepted_round = self\n    63\t            .storage\n    64\t            .get_accepted_round()\n    65\t            .unwrap()\n    66\t            .unwrap_or_default();\n    67\t        self.state_cache.compacted_idx = self.storage.get_compacted_idx().unwrap();\n    68\t        self.state_cache.stopsign = self.storage.get_stopsign().unwrap();\n    69\t        self.state_cache.accepted_idx =\n    70\t            self.storage.get_log_len().unwrap() + self.state_cache.compacted_idx;\n    71\t        if self.state_cache.stopsign.is_some() {\n    72\t            self.state_cache.accepted_idx += 1;\n    73\t        }\n    74\t    }\n    75\t\n    76\t    /// Read all decided entries from `from_idx` in the log. Returns `None` if `from_idx` is out of bounds.\n    77\t    pub(crate) fn read_decided_suffix(\n    78\t        &self,\n    79\t        from_idx: usize,\n    80\t    ) -> StorageResult<Option<Vec<LogEntry<T>>>> {\n    81\t        let decided_idx = self.get_decided_idx();\n    82\t        if from_idx < decided_idx {\n    83\t            self.read(from_idx..decided_idx)\n    84\t        } else {\n    85\t            Ok(None)\n    86\t        }\n    87\t    }\n    88\t\n    89\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n    90\t    pub(crate) fn read<R>(&self, r: R) -> StorageResult<Option<Vec<LogEntry<T>>>>\n    91\t    where\n    92\t        R: RangeBounds<usize>,\n    93\t    {\n    94\t        let from_idx = match r.start_bound() {\n    95\t            Bound::Included(i) => *i,\n    96\t            Bound::Excluded(e) => *e + 1,\n    97\t            Bound::Unbounded => 0,\n    98\t        };\n    99\t        let to_idx = match r.end_bound() {\n   100\t            Bound::Included(i) => *i + 1,\n   101\t            Bound::Excluded(e) => *e,\n   102\t            Bound::Unbounded => self.get_accepted_idx(),\n   103\t        };\n   104\t        if to_idx == 0 {\n   105\t            return Ok(None);\n   106\t        }\n   107\t        let compacted_idx = self.get_compacted_idx();\n   108\t        let accepted_idx = self.get_accepted_idx();\n   109\t        // use to_idx-1 when getting the entry type as to_idx is exclusive\n   110\t        let to_type = match self.get_entry_type(to_idx - 1, compacted_idx, accepted_idx)? {\n   111\t            Some(IndexEntry::Compacted) => {\n   112\t                return Ok(Some(vec![self.create_compacted_entry(compacted_idx)?]))\n   113\t            }\n   114\t            Some(from_type) => from_type,\n   115\t            _ => return Ok(None),\n   116\t        };\n   117\t        let from_type = match self.get_entry_type(from_idx, compacted_idx, accepted_idx)? {\n   118\t            Some(from_type) => from_type,\n   119\t            _ => return Ok(None),\n   120\t        };\n   121\t        match (from_type, to_type) {\n   122\t            (IndexEntry::Entry, IndexEntry::Entry) => {\n   123\t                Ok(Some(self.create_read_log_entries(from_idx, to_idx)?))\n   124\t            }\n   125\t            (IndexEntry::Entry, IndexEntry::StopSign(ss)) => {\n   126\t                let mut entries = self.create_read_log_entries(from_idx, to_idx - 1)?;\n   127\t                entries.push(LogEntry::StopSign(ss, self.stopsign_is_decided()));\n   128\t                Ok(Some(entries))\n   129\t            }\n   130\t            (IndexEntry::Compacted, IndexEntry::Entry) => {\n   131\t                let mut entries = Vec::with_capacity(to_idx - compacted_idx + 1);\n   132\t                let compacted = self.create_compacted_entry(compacted_idx)?;\n   133\t                entries.push(compacted);\n   134\t                let mut e = self.create_read_log_entries(compacted_idx, to_idx)?;\n   135\t                entries.append(&mut e);\n   136\t                Ok(Some(entries))\n   137\t            }\n   138\t            (IndexEntry::Compacted, IndexEntry::StopSign(ss)) => {\n   139\t                let mut entries = Vec::with_capacity(to_idx - compacted_idx + 1);\n   140\t                let compacted = self.create_compacted_entry(compacted_idx)?;\n   141\t                entries.push(compacted);\n   142\t                let mut e = self.create_read_log_entries(compacted_idx, to_idx - 1)?;\n   143\t                entries.append(&mut e);\n   144\t                entries.push(LogEntry::StopSign(ss, self.stopsign_is_decided()));\n   145\t                Ok(Some(entries))\n   146\t            }\n   147\t            (IndexEntry::StopSign(ss), IndexEntry::StopSign(_)) => {\n   148\t                Ok(Some(vec![LogEntry::StopSign(\n   149\t                    ss,\n   150\t                    self.stopsign_is_decided(),\n   151\t                )]))\n   152\t            }\n   153\t            e => {\n   154\t                unimplemented!(\"{}\", format!(\"Unexpected read combination: {:?}\", e))\n   155\t            }\n   156\t        }\n   157\t    }\n   158\t\n   159\t    fn get_entry_type(\n   160\t        &self,\n   161\t        idx: usize,\n   162\t        compacted_idx: usize,\n   163\t        accepted_idx: usize,\n   164\t    ) -> StorageResult<Option<IndexEntry>> {\n   165\t        if idx < compacted_idx {\n   166\t            Ok(Some(IndexEntry::Compacted))\n   167\t        } else if idx + 1 < accepted_idx {\n   168\t            Ok(Some(IndexEntry::Entry))\n   169\t        } else if idx + 1 == accepted_idx {\n   170\t            match self.get_stopsign() {\n   171\t                Some(ss) => Ok(Some(IndexEntry::StopSign(ss))),\n   172\t                _ => Ok(Some(IndexEntry::Entry)),\n   173\t            }\n   174\t        } else {\n   175\t            Ok(None)\n   176\t        }\n   177\t    }\n   178\t\n   179\t    fn create_read_log_entries(&self, from: usize, to: usize) -> StorageResult<Vec<LogEntry<T>>> {\n   180\t        let decided_idx = self.get_decided_idx();\n   181\t        let entries = self\n   182\t            .get_entries(from, to)?\n   183\t            .into_iter()\n   184\t            .enumerate()\n   185\t            .map(|(idx, e)| {\n   186\t                let log_idx = idx + from;\n   187\t                if log_idx < decided_idx {\n   188\t                    LogEntry::Decided(e)\n   189\t                } else {\n   190\t                    LogEntry::Undecided(e)\n   191\t                }\n   192\t            })\n   193\t            .collect();\n   194\t        Ok(entries)\n   195\t    }\n   196\t\n   197\t    fn create_compacted_entry(&self, compacted_idx: usize) -> StorageResult<LogEntry<T>> {\n   198\t        self.storage.get_snapshot().map(|snap| match snap {\n   199\t            Some(s) => LogEntry::Snapshotted(SnapshottedEntry::with(compacted_idx, s)),\n   200\t            None => LogEntry::Trimmed(compacted_idx),\n   201\t        })\n   202\t    }\n   203\t\n   204\t    // Append entry, if the batch size is reached, flush the batch and return the actual\n   205\t    // accepted index (not including the batched entries)\n   206\t    pub(crate) fn append_entry_with_batching(\n   207\t        &mut self,\n   208\t        entry: T,\n   209\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   210\t        let append_res = self.state_cache.append_entry(entry);\n   211\t        self.flush_if_full_batch(append_res)\n   212\t    }\n   213\t\n   214\t    // Append entries in batch, if the batch size is reached, flush the batch and return the\n   215\t    // accepted index and the flushed entries. If the batch size is not reached, return None.\n   216\t    pub(crate) fn append_entries_with_batching(\n   217\t        &mut self,\n   218\t        entries: Vec<T>,\n   219\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   220\t        let append_res = self.state_cache.append_entries(entries);\n   221\t        self.flush_if_full_batch(append_res)\n   222\t    }\n   223\t\n   224\t    // Flushes batched entries and appends a stopsign to the log. Returns the AcceptedMetaData\n   225\t    // associated with any flushed entries if there were any.\n   226\t    pub(crate) fn append_stopsign(\n   227\t        &mut self,\n   228\t        ss: StopSign,\n   229\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   230\t        let append_res = self.state_cache.append_stopsign(ss.clone());\n   231\t        let accepted_entries_metadata = self.flush_if_full_batch(append_res)?;\n   232\t        self.storage.set_stopsign(Some(ss))?;\n   233\t        self.state_cache.accepted_idx += 1;\n   234\t        Ok(accepted_entries_metadata)\n   235\t    }\n   236\t\n   237\t    fn flush_if_full_batch(\n   238\t        &mut self,\n   239\t        append_res: Option<Vec<T>>,\n   240\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   241\t        if let Some(flushed_entries) = append_res {\n   242\t            let accepted_idx = self.append_entries_without_batching(flushed_entries.clone())?;\n   243\t            Ok(Some(AcceptedMetaData {\n   244\t                accepted_idx,\n   245\t                #[cfg(not(feature = \"unicache\"))]\n   246\t                entries: flushed_entries,\n   247\t                #[cfg(feature = \"unicache\")]\n   248\t                entries: self.state_cache.take_batched_processed(),\n   249\t            }))\n   250\t        } else {\n   251\t            Ok(None)\n   252\t        }\n   253\t    }\n   254\t\n   255\t    // Append entries in batch, if the batch size is reached, flush the batch and return the\n   256\t    // accepted index. If the batch size is not reached, return None.\n   257\t    pub(crate) fn append_entries_and_get_accepted_idx(\n   258\t        &mut self,\n   259\t        entries: Vec<T>,\n   260\t    ) -> StorageResult<Option<usize>> {\n   261\t        let append_res = self.state_cache.append_entries(entries);\n   262\t        if let Some(flushed_entries) = append_res {\n   263\t            let accepted_idx = self.append_entries_without_batching(flushed_entries)?;\n   264\t            Ok(Some(accepted_idx))\n   265\t        } else {\n   266\t            Ok(None)\n   267\t        }\n   268\t    }\n   269\t\n   270\t    #[cfg(feature = \"unicache\")]\n   271\t    pub(crate) fn decode_entries(\n   272\t        &mut self,\n   273\t        encoded_entries: Vec<<T as Entry>::EncodeResult>,\n   274\t    ) -> Vec<T> {\n   275\t        encoded_entries\n   276\t            .into_iter()\n   277\t            .map(|x| self.state_cache.unicache.decode(x))\n   278\t            .collect()\n   279\t    }\n   280\t\n   281\t    pub(crate) fn flush_batch(&mut self) -> StorageResult<usize> {\n   282\t        #[cfg(feature = \"unicache\")]\n   283\t        {\n   284\t            // clear the processed batch\n   285\t            self.state_cache.batched_processed_by_leader.clear();\n   286\t        }\n   287\t        let flushed_entries = self.state_cache.take_batched_entries();\n   288\t        self.append_entries_without_batching(flushed_entries)\n   289\t    }\n   290\t\n   291\t    pub(crate) fn flush_batch_and_get_entries(\n   292\t        &mut self,\n   293\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   294\t        let flushed_entries = if !self.state_cache.batched_entries.is_empty() {\n   295\t            Some(self.state_cache.take_batched_entries())\n   296\t        } else {\n   297\t            None\n   298\t        };\n   299\t        self.flush_if_full_batch(flushed_entries)\n   300\t    }\n   301\t\n   302\t    // Append entries without batching, return the accepted index\n   303\t    pub(crate) fn append_entries_without_batching(\n   304\t        &mut self,\n   305\t        entries: Vec<T>,\n   306\t    ) -> StorageResult<usize> {\n   307\t        let num_new_entries = entries.len();\n   308\t        self.storage.append_entries(entries)?;\n   309\t        self.state_cache.accepted_idx += num_new_entries;\n   310\t        Ok(self.state_cache.accepted_idx)\n   311\t    }\n   312\t\n   313\t    pub(crate) fn sync_log(\n   314\t        &mut self,\n   315\t        accepted_round: Ballot,\n   316\t        decided_idx: usize,\n   317\t        log_sync: Option<LogSync<T>>,\n   318\t    ) -> StorageResult<usize> {\n   319\t        self.state_cache.accepted_round = accepted_round;\n   320\t        self.state_cache.decided_idx = decided_idx;\n   321\t        let mut sync_txn: Vec<StorageOp<T>> = vec![\n   322\t            StorageOp::SetAcceptedRound(accepted_round),\n   323\t            StorageOp::SetDecidedIndex(decided_idx),\n   324\t        ];\n   325\t        if let Some(sync) = log_sync {\n   326\t            match sync.decided_snapshot {\n   327\t                Some(SnapshotType::Complete(c)) => {\n   328\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   329\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   330\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   331\t                    sync_txn.push(StorageOp::SetSnapshot(Some(c)));\n   332\t                }\n   333\t                Some(SnapshotType::Delta(d)) => {\n   334\t                    let mut snapshot = self.create_decided_snapshot()?;\n   335\t                    snapshot.merge(d);\n   336\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   337\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   338\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   339\t                    sync_txn.push(StorageOp::SetSnapshot(Some(snapshot)));\n   340\t                }\n   341\t                None => (),\n   342\t            }\n   343\t            self.state_cache.accepted_idx = sync.sync_idx + sync.suffix.len();\n   344\t            sync_txn.push(StorageOp::AppendOnPrefix(sync.sync_idx, sync.suffix));\n   345\t            match sync.stopsign {\n   346\t                Some(ss) => {\n   347\t                    self.state_cache.stopsign = Some(ss.clone());\n   348\t                    self.state_cache.accepted_idx += 1;\n   349\t                    sync_txn.push(StorageOp::SetStopsign(Some(ss)));\n   350\t                }\n   351\t                None if self.state_cache.stopsign.is_some() => {\n   352\t                    self.state_cache.stopsign = None;\n   353\t                    sync_txn.push(StorageOp::SetStopsign(None));\n   354\t                }\n   355\t                None => (),\n   356\t            }\n   357\t        }\n   358\t        self.storage.write_atomically(sync_txn)?;\n   359\t        Ok(self.state_cache.accepted_idx)\n   360\t    }\n   361\t\n   362\t    fn create_decided_snapshot(&mut self) -> StorageResult<T::Snapshot> {\n   363\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   364\t        self.create_snapshot(log_decided_idx)\n   365\t    }\n   366\t\n   367\t    pub(crate) fn create_snapshot(&self, compact_idx: usize) -> StorageResult<T::Snapshot> {\n   368\t        let current_compacted_idx = self.get_compacted_idx();\n   369\t        if compact_idx < current_compacted_idx {\n   370\t            Err(CompactionErr::TrimmedIndex(current_compacted_idx))?\n   371\t        }\n   372\t        let entries = self\n   373\t            .storage\n   374\t            .get_entries(current_compacted_idx, compact_idx)?;\n   375\t        let delta = T::Snapshot::create(entries.as_slice());\n   376\t        match self.storage.get_snapshot()? {\n   377\t            Some(mut s) => {\n   378\t                s.merge(delta);\n   379\t                Ok(s)\n   380\t            }\n   381\t            None => Ok(delta),\n   382\t        }\n   383\t    }\n   384\t\n   385\t    // Creates a Delta snapshot of entries from `from_idx` to the end of the decided log and also\n   386\t    // returns the compacted idx of the created snapshot. If the range of entries contains entries\n   387\t    // which have already been compacted a valid delta cannot be created, so creates a Complete\n   388\t    // snapshot of the entire decided log instead.\n   389\t    pub(crate) fn create_diff_snapshot(\n   390\t        &self,\n   391\t        from_idx: usize,\n   392\t    ) -> StorageResult<(Option<SnapshotType<T>>, usize)> {\n   393\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   394\t        let compacted_idx = self.get_compacted_idx();\n   395\t        let snapshot = if from_idx <= compacted_idx {\n   396\t            // Some entries in range are compacted, snapshot entire decided log\n   397\t            if compacted_idx < log_decided_idx {\n   398\t                Some(SnapshotType::Complete(\n   399\t                    self.create_snapshot(log_decided_idx)?,\n   400\t                ))\n   401\t            } else {\n   402\t                // Entire decided log already snapshotted\n   403\t                self.get_snapshot()?.map(|s| SnapshotType::Complete(s))\n   404\t            }\n   405\t        } else {\n   406\t            let diff_entries = self.get_entries(from_idx, log_decided_idx)?;\n   407\t            Some(SnapshotType::Delta(T::Snapshot::create(\n   408\t                diff_entries.as_slice(),\n   409\t            )))\n   410\t        };\n   411\t        Ok((snapshot, log_decided_idx))\n   412\t    }\n   413\t\n   414\t    pub(crate) fn try_trim(&mut self, idx: usize) -> StorageResult<()> {\n   415\t        let decided_idx = self.get_decided_idx();\n   416\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   417\t        let new_compacted_idx = match idx.cmp(&decided_idx) {\n   418\t            Ordering::Less => idx,\n   419\t            Ordering::Equal => log_decided_idx,\n   420\t            Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   421\t        };\n   422\t        if new_compacted_idx > self.get_compacted_idx() {\n   423\t            self.storage.write_atomically(vec![\n   424\t                StorageOp::Trim(new_compacted_idx),\n   425\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   426\t            ])?;\n   427\t            self.state_cache.compacted_idx = new_compacted_idx;\n   428\t        }\n   429\t        Ok(())\n   430\t    }\n   431\t\n   432\t    pub(crate) fn try_snapshot(&mut self, snapshot_idx: Option<usize>) -> StorageResult<()> {\n   433\t        let decided_idx = self.get_decided_idx();\n   434\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   435\t        let new_compacted_idx = match snapshot_idx {\n   436\t            Some(i) => match i.cmp(&decided_idx) {\n   437\t                Ordering::Less => i,\n   438\t                Ordering::Equal => log_decided_idx,\n   439\t                Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   440\t            },\n   441\t            None => log_decided_idx,\n   442\t        };\n   443\t        if new_compacted_idx > self.get_compacted_idx() {\n   444\t            let snapshot = self.create_snapshot(new_compacted_idx)?;\n   445\t            self.storage.write_atomically(vec![\n   446\t                StorageOp::Trim(new_compacted_idx),\n   447\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   448\t                StorageOp::SetSnapshot(Some(snapshot)),\n   449\t            ])?;\n   450\t            self.state_cache.compacted_idx = new_compacted_idx;\n   451\t        }\n   452\t        Ok(())\n   453\t    }\n   454\t\n   455\t    pub(crate) fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   456\t        self.state_cache.promise = n_prom;\n   457\t        self.storage.set_promise(n_prom)\n   458\t    }\n   459\t\n   460\t    pub(crate) fn set_decided_idx(&mut self, idx: usize) -> StorageResult<()> {\n   461\t        self.state_cache.decided_idx = idx;\n   462\t        self.storage.set_decided_idx(idx)\n   463\t    }\n   464\t\n   465\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   466\t        self.state_cache.decided_idx\n   467\t    }\n   468\t\n   469\t    fn get_decided_idx_without_stopsign(&self) -> usize {\n   470\t        match self.stopsign_is_decided() {\n   471\t            true => self.get_decided_idx() - 1,\n   472\t            false => self.get_decided_idx(),\n   473\t        }\n   474\t    }\n   475\t\n   476\t    pub(crate) fn get_accepted_round(&self) -> Ballot {\n   477\t        self.state_cache.accepted_round\n   478\t    }\n   479\t\n   480\t    pub(crate) fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n   481\t        self.storage.get_entries(from, to)\n   482\t    }\n   483\t\n   484\t    /// The length of the replicated log, as if log was never compacted.\n   485\t    pub(crate) fn get_accepted_idx(&self) -> usize {\n   486\t        self.state_cache.accepted_idx\n   487\t    }\n   488\t\n   489\t    /// The number of entries currently buffered for batching, not yet reflected\n   490\t    /// in `get_accepted_idx()`.\n   491\t    pub(crate) fn get_batched_len(&self) -> usize {\n   492\t        self.state_cache.batched_entries.len()\n   493\t    }\n   494\t\n   495\t    pub(crate) fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   496\t        self.storage.get_suffix(from)\n   497\t    }\n   498\t\n   499\t    pub(crate) fn get_promise(&self) -> Ballot {\n   500\t        self.state_cache.promise\n   501\t    }\n   502\t\n   503\t    pub(crate) fn set_stopsign(&mut self, ss: Option<StopSign>) -> StorageResult<usize> {\n   504\t        if ss.is_some() && self.state_cache.stopsign.is_none() {\n   505\t            self.state_cache.accepted_idx += 1;\n   506\t        } else if ss.is_none() && self.state_cache.stopsign.is_some() {\n   507\t            self.state_cache.accepted_idx -= 1;\n   508\t        }\n   509\t        self.state_cache.stopsign.clone_from(&ss);\n   510\t        self.storage.set_stopsign(ss)?;\n   511\t        Ok(self.state_cache.accepted_idx)\n   512\t    }\n   513\t\n   514\t    pub(crate) fn get_stopsign(&self) -> Option<StopSign> {\n   515\t        self.state_cache.stopsign.clone()\n   516\t    }\n   517\t\n   518\t    // Returns whether a stopsign is decided\n   519\t    pub(crate) fn stopsign_is_decided(&self) -> bool {\n   520\t        self.state_cache.stopsign_is_decided()\n   521\t    }\n   522\t\n   523\t    pub(crate) fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   524\t        self.storage.get_snapshot()\n   525\t    }\n   526\t\n   527\t    pub(crate) fn get_compacted_idx(&self) -> usize {\n   528\t        self.state_cache.compacted_idx\n   529\t    }\n   530\t\n   531\t    #[cfg(feature = \"unicache\")]\n   532\t    pub(crate) fn get_unicache(&self) -> T::UniCache {\n   533\t        self.state_cache.unicache.clone()\n   534\t    }\n   535\t\n   536\t    #[cfg(feature = \"unicache\")]\n   537\t    pub(crate) fn set_unicache(&mut self, unicache: T::UniCache) {\n   538\t        self.state_cache.unicache = unicache;\n   539\t    }\n   540\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/ballot_leader_election.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/ballot_leader_election.rs'","aggregated_output":"     1\tuse std::cmp::Ordering;\n     2\t\n     3\t/// Ballot Leader Election algorithm for electing new leaders\n     4\tuse crate::{\n     5\t    sequence_paxos::{Phase, Role},\n     6\t    util::{defaults::*, ConfigurationId, FlexibleQuorum, Quorum},\n     7\t};\n     8\t\n     9\t#[cfg(feature = \"logging\")]\n    10\tuse crate::utils::logger::create_logger;\n    11\tuse crate::{\n    12\t    messages::ballot_leader_election::{\n    13\t        BLEMessage, HeartbeatMsg, HeartbeatReply, HeartbeatRequest,\n    14\t    },\n    15\t    util::NodeId,\n    16\t    OmniPaxosConfig,\n    17\t};\n    18\t#[cfg(feature = \"serde\")]\n    19\tuse serde::{Deserialize, Serialize};\n    20\t#[cfg(feature = \"logging\")]\n    21\tuse slog::{info, trace, Logger};\n    22\t\n    23\t/// Used to define a Sequence Paxos epoch\n    24\t#[derive(Clone, Copy, Eq, Debug, Default, PartialEq)]\n    25\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    26\tpub struct Ballot {\n    27\t    /// The identifier for the configuration that the replica with this ballot is part of.\n    28\t    pub config_id: ConfigurationId,\n    29\t    /// Ballot number\n    30\t    pub n: u32,\n    31\t    /// Custom priority parameter\n    32\t    pub priority: u32,\n    33\t    /// The pid of the process\n    34\t    pub pid: NodeId,\n    35\t}\n    36\t\n    37\timpl Ballot {\n    38\t    /// Creates a new Ballot\n    39\t    /// # Arguments\n    40\t    /// * `config_id` - The identifier for the configuration that the replica with this ballot is part of.\n    41\t    /// * `n` - Ballot number.\n    42\t    /// * `pid` -  Used as tiebreaker for total ordering of ballots.\n    43\t    pub fn with(config_id: ConfigurationId, n: u32, priority: u32, pid: NodeId) -> Ballot {\n    44\t        Ballot {\n    45\t            config_id,\n    46\t            n,\n    47\t            priority,\n    48\t            pid,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\timpl Ord for Ballot {\n    54\t    fn cmp(&self, other: &Self) -> Ordering {\n    55\t        (self.n, self.priority, self.pid).cmp(&(other.n, other.priority, other.pid))\n    56\t    }\n    57\t}\n    58\t\n    59\timpl PartialOrd for Ballot {\n    60\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n    61\t        Some(self.cmp(other))\n    62\t    }\n    63\t}\n    64\t\n    65\tconst INITIAL_ROUND: u32 = 1;\n    66\tconst RECOVERY_ROUND: u32 = 0;\n    67\t\n    68\t/// A Ballot Leader Election component. Used in conjunction with OmniPaxos to handle the election of a leader for a cluster of OmniPaxos servers,\n    69\t/// incoming messages and produces outgoing messages that the user has to fetch periodically and send using a network implementation.\n    70\t/// User also has to periodically fetch the decided entries that are guaranteed to be strongly consistent and linearizable, and therefore also safe to be used in the higher level application.\n    71\tpub(crate) struct BallotLeaderElection {\n    72\t    /// The identifier for the configuration that this instance is part of.\n    73\t    configuration_id: ConfigurationId,\n    74\t    /// Process identifier used to uniquely identify this instance.\n    75\t    pid: NodeId,\n    76\t    /// Vector that holds the pids of all the other servers.\n    77\t    peers: Vec<NodeId>,\n    78\t    /// The current round of the heartbeat cycle.\n    79\t    hb_round: u32,\n    80\t    /// The heartbeat replies this instance received during the current round.\n    81\t    heartbeat_replies: Vec<HeartbeatReply>,\n    82\t    /// Vector that holds all the received heartbeats from the previous heartbeat round, including the current node. Only used to display the connectivity of this node in the UI.\n    83\t    /// Represents nodes that are currently alive from the view of the current node.\n    84\t    prev_replies: Vec<HeartbeatReply>,\n    85\t    /// Holds the current ballot of this instance.\n    86\t    current_ballot: Ballot,\n    87\t    /// The current leader of this instance.\n    88\t    leader: Ballot,\n    89\t    /// A happy node either sees that it is, is connected to, or sees evidence of a potential leader\n    90\t    /// for the cluster. If a node is unhappy then it is seeking a new leader.\n    91\t    happy: bool,\n    92\t    /// The number of replicas inside the cluster whose heartbeats are needed to become and remain the leader.\n    93\t    quorum: Quorum,\n    94\t    /// Vector which holds all the outgoing messages of the BLE instance.\n    95\t    outgoing: Vec<BLEMessage>,\n    96\t    /// Logger used to output the status of the component.\n    97\t    #[cfg(feature = \"logging\")]\n    98\t    logger: Logger,\n    99\t}\n   100\t\n   101\timpl BallotLeaderElection {\n   102\t    /// Construct a new BallotLeaderElection node\n   103\t    pub(crate) fn with(config: BLEConfig, recovered_leader: Option<Ballot>) -> Self {\n   104\t        let config_id = config.configuration_id;\n   105\t        let pid = config.pid;\n   106\t        let peers = config.peers;\n   107\t        let num_nodes = &peers.len() + 1;\n   108\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n   109\t        let mut initial_ballot = Ballot::with(config_id, INITIAL_ROUND, config.priority, pid);\n   110\t        let initial_leader = match recovered_leader {\n   111\t            Some(b) if b != Ballot::default() => {\n   112\t                // Prevents a recovered server from retaining BLE leadership with the same ballot.\n   113\t                initial_ballot.n = RECOVERY_ROUND;\n   114\t                b\n   115\t            }\n   116\t            _ => initial_ballot,\n   117\t        };\n   118\t        let mut ble = BallotLeaderElection {\n   119\t            configuration_id: config_id,\n   120\t            pid,\n   121\t            peers,\n   122\t            hb_round: 0,\n   123\t            heartbeat_replies: Vec::with_capacity(num_nodes),\n   124\t            prev_replies: Vec::with_capacity(num_nodes),\n   125\t            current_ballot: initial_ballot,\n   126\t            leader: initial_leader,\n   127\t            happy: true,\n   128\t            quorum,\n   129\t            outgoing: Vec::with_capacity(config.buffer_size),\n   130\t            #[cfg(feature = \"logging\")]\n   131\t            logger: {\n   132\t                if let Some(logger) = config.custom_logger {\n   133\t                    logger\n   134\t                } else {\n   135\t                    let s = config\n   136\t                        .logger_file_path\n   137\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   138\t                    create_logger(s.as_str())\n   139\t                }\n   140\t            },\n   141\t        };\n   142\t        #[cfg(feature = \"logging\")]\n   143\t        {\n   144\t            info!(\n   145\t                ble.logger,\n   146\t                \"Ballot Leader Election component pid: {} created!\", pid\n   147\t            );\n   148\t        }\n   149\t        ble.new_hb_round();\n   150\t        ble\n   151\t    }\n   152\t\n   153\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   154\t    /// priority triggers a leader re-election.\n   155\t    pub(crate) fn set_priority(&mut self, p: u32) {\n   156\t        self.current_ballot.priority = p;\n   157\t    }\n   158\t\n   159\t    /// Returns reference to outgoing messages\n   160\t    pub(crate) fn outgoing_mut(&mut self) -> &mut Vec<BLEMessage> {\n   161\t        &mut self.outgoing\n   162\t    }\n   163\t\n   164\t    /// Handle an incoming message.\n   165\t    /// # Arguments\n   166\t    /// * `m` - the message to be handled.\n   167\t    pub(crate) fn handle(&mut self, m: BLEMessage) {\n   168\t        match m.msg {\n   169\t            HeartbeatMsg::Request(req) => self.handle_request(m.from, req),\n   170\t            HeartbeatMsg::Reply(rep) => self.handle_reply(rep),\n   171\t        }\n   172\t    }\n   173\t\n   174\t    /// Initiates a new heartbeat round.\n   175\t    pub(crate) fn new_hb_round(&mut self) {\n   176\t        self.prev_replies = std::mem::take(&mut self.heartbeat_replies);\n   177\t        self.hb_round += 1;\n   178\t        #[cfg(feature = \"logging\")]\n   179\t        trace!(\n   180\t            self.logger,\n   181\t            \"Initiate new heartbeat round: {}\",\n   182\t            self.hb_round\n   183\t        );\n   184\t        for peer in &self.peers {\n   185\t            let hb_request = HeartbeatRequest {\n   186\t                round: self.hb_round,\n   187\t            };\n   188\t            self.outgoing.push(BLEMessage {\n   189\t                from: self.pid,\n   190\t                to: *peer,\n   191\t                msg: HeartbeatMsg::Request(hb_request),\n   192\t            });\n   193\t        }\n   194\t    }\n   195\t\n   196\t    /// End of a heartbeat round. Returns current leader and election status.\n   197\t    pub(crate) fn hb_timeout(\n   198\t        &mut self,\n   199\t        seq_paxos_state: &(Role, Phase),\n   200\t        seq_paxos_promise: Ballot,\n   201\t    ) -> Option<Ballot> {\n   202\t        self.update_leader();\n   203\t        self.update_happiness(seq_paxos_state);\n   204\t        self.check_takeover();\n   205\t        self.new_hb_round();\n   206\t        if seq_paxos_promise > self.leader {\n   207\t            // Sync leader with Paxos promise in case ballot didn't make it to BLE followers\n   208\t            // or become_leader() was called.\n   209\t            self.leader = seq_paxos_promise;\n   210\t            if seq_paxos_promise.pid == self.pid {\n   211\t                self.current_ballot = seq_paxos_promise;\n   212\t            }\n   213\t            self.happy = true;\n   214\t        }\n   215\t        if self.leader == self.current_ballot {\n   216\t            Some(self.current_ballot)\n   217\t        } else {\n   218\t            None\n   219\t        }\n   220\t    }\n   221\t\n   222\t    fn update_leader(&mut self) {\n   223\t        let max_reply_ballot = self.heartbeat_replies.iter().map(|r| r.ballot).max();\n   224\t        if let Some(max) = max_reply_ballot {\n   225\t            if max > self.leader {\n   226\t                self.leader = max;\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n   232\t        self.happy = if self.leader == self.current_ballot {\n   233\t            let potential_followers = self\n   234\t                .heartbeat_replies\n   235\t                .iter()\n   236\t                .filter(|hb_reply| hb_reply.leader <= self.current_ballot)\n   237\t                .count();\n   238\t            let can_form_quorum = match seq_paxos_state {\n   239\t                (Role::Leader, Phase::Accept) => {\n   240\t                    self.quorum.is_accept_quorum(potential_followers + 1)\n   241\t                }\n   242\t                _ => self.quorum.is_prepare_quorum(potential_followers + 1),\n   243\t            };\n   244\t            if can_form_quorum {\n   245\t                true\n   246\t            } else {\n   247\t                let see_larger_happy_leader = self\n   248\t                    .heartbeat_replies\n   249\t                    .iter()\n   250\t                    .any(|r| r.leader > self.current_ballot && r.happy);\n   251\t                see_larger_happy_leader\n   252\t            }\n   253\t        } else {\n   254\t            self.heartbeat_replies\n   255\t                .iter()\n   256\t                .any(|r| r.ballot == self.leader && r.happy)\n   257\t        };\n   258\t    }\n   259\t\n   260\t    fn check_takeover(&mut self) {\n   261\t        if !self.happy {\n   262\t            let all_neighbors_unhappy = self.heartbeat_replies.iter().all(|r| !r.happy);\n   263\t            let im_quorum_connected = self\n   264\t                .quorum\n   265\t                .is_prepare_quorum(self.heartbeat_replies.len() + 1);\n   266\t            if all_neighbors_unhappy && im_quorum_connected {\n   267\t                // We increment past our leader instead of max of unhappy ballots because we\n   268\t                // assume we have already checked leader for this round so they should be equal\n   269\t                self.current_ballot.n = self.leader.n + 1;\n   270\t                self.leader = self.current_ballot;\n   271\t                self.happy = true;\n   272\t            }\n   273\t        }\n   274\t    }\n   275\t\n   276\t    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n   277\t        let hb_reply = HeartbeatReply {\n   278\t            round: req.round,\n   279\t            ballot: self.current_ballot,\n   280\t            leader: self.leader,\n   281\t            happy: self.happy,\n   282\t        };\n   283\t        self.outgoing.push(BLEMessage {\n   284\t            from: self.pid,\n   285\t            to: from,\n   286\t            msg: HeartbeatMsg::Reply(hb_reply),\n   287\t        });\n   288\t    }\n   289\t\n   290\t    fn handle_reply(&mut self, rep: HeartbeatReply) {\n   291\t        if rep.round == self.hb_round && rep.ballot.config_id == self.configuration_id {\n   292\t            self.heartbeat_replies.push(rep);\n   293\t        }\n   294\t    }\n   295\t\n   296\t    pub(crate) fn get_current_ballot(&self) -> Ballot {\n   297\t        self.current_ballot\n   298\t    }\n   299\t\n   300\t    pub(crate) fn get_ballots(&self) -> Vec<HeartbeatReply> {\n   301\t        self.prev_replies.clone()\n   302\t    }\n   303\t}\n   304\t\n   305\t/// Configuration for `BallotLeaderElection`.\n   306\t/// # Fields\n   307\t/// * `configuration_id`: The identifier for the configuration that this node is part of.\n   308\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   309\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   310\t/// * `priority`: Set custom priority for this node to be elected as the leader.\n   311\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   312\t/// * `buffer_size`: The buffer size for outgoing messages.\n   313\t/// * `logger_file_path`: The path where the default logger logs events.\n   314\t#[derive(Clone, Debug)]\n   315\tpub(crate) struct BLEConfig {\n   316\t    configuration_id: ConfigurationId,\n   317\t    pid: NodeId,\n   318\t    peers: Vec<NodeId>,\n   319\t    priority: u32,\n   320\t    flexible_quorum: Option<FlexibleQuorum>,\n   321\t    buffer_size: usize,\n   322\t    #[cfg(feature = \"logging\")]\n   323\t    logger_file_path: Option<String>,\n   324\t    #[cfg(feature = \"logging\")]\n   325\t    custom_logger: Option<Logger>,\n   326\t}\n   327\t\n   328\timpl From<OmniPaxosConfig> for BLEConfig {\n   329\t    fn from(config: OmniPaxosConfig) -> Self {\n   330\t        let pid = config.server_config.pid;\n   331\t        let peers = config\n   332\t            .cluster_config\n   333\t            .nodes\n   334\t            .into_iter()\n   335\t            .filter(|x| *x != pid)\n   336\t            .collect();\n   337\t\n   338\t        Self {\n   339\t            configuration_id: config.cluster_config.configuration_id,\n   340\t            pid,\n   341\t            peers,\n   342\t            priority: config.server_config.leader_priority,\n   343\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   344\t            buffer_size: BLE_BUFFER_SIZE,\n   345\t            #[cfg(feature = \"logging\")]\n   346\t            logger_file_path: config.server_config.logger_file_path,\n   347\t            #[cfg(feature = \"logging\")]\n   348\t            custom_logger: config.server_config.custom_logger,\n   349\t        }\n   350\t    }\n   351\t}\n","exit_code":0,"status":"completed"}}
