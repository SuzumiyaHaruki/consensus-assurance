or::Parse(ref err) => write!(f, \"{}\", err),\n   242\t            ConfigError::InvalidConfig(ref str) => write!(f, \"Invalid config: {}\", str),\n   243\t        }\n   244\t    }\n   245\t}\n   246\t\n   247\timpl error::Error for ConfigError {\n   248\t    fn source(&self) -> Option<&(dyn error::Error + 'static)> {\n   249\t        match *self {\n   250\t            #[cfg(feature = \"toml_config\")]\n   251\t            ConfigError::ReadFile(ref err) => Some(err),\n   252\t            #[cfg(feature = \"toml_config\")]\n   253\t            ConfigError::Parse(ref err) => Some(err),\n   254\t            ConfigError::InvalidConfig(_) => Some(self),\n   255\t        }\n   256\t    }\n   257\t}\n   258\t\n   259\t#[cfg(feature = \"toml_config\")]\n   260\timpl From<io::Error> for ConfigError {\n   261\t    fn from(err: io::Error) -> ConfigError {\n   262\t        ConfigError::ReadFile(err)\n   263\t    }\n   264\t}\n   265\t\n   266\t#[cfg(feature = \"toml_config\")]\n   267\timpl From<toml::de::Error> for ConfigError {\n   268\t    fn from(err: toml::de::Error) -> ConfigError {\n   269\t        ConfigError::Parse(err)\n   270\t    }\n   271\t}\n   272\t\n   273\t#[allow(missing_docs)]\n   274\tmacro_rules! valid_config {\n   275\t    ($pred:expr,$err_str:expr) => {\n   276\t        if !$pred {\n   277\t            return Err(ConfigError::InvalidConfig($err_str.to_owned()));\n   278\t        }\n   279\t    };\n   280\t}\n   281\tpub(crate) use valid_config;\n","exit_code":0,"status":"completed"}}
