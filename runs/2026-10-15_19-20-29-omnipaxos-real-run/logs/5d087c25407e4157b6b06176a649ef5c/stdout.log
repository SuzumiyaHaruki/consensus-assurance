anges since an earlier snapshot.\n    69\t#[allow(missing_docs)]\n    70\t#[derive(Clone, Debug)]\n    71\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    72\tpub enum SnapshotType<T>\n    73\twhere\n    74\t    T: Entry,\n    75\t{\n    76\t    Complete(T::Snapshot),\n    77\t    Delta(T::Snapshot),\n    78\t}\n    79\t\n    80\t/// Trait for implementing snapshot operations for log entries of type `T` in OmniPaxos.\n    81\tpub trait Snapshot<T>: Clone + Debug\n    82\twhere\n    83\t    T: Entry,\n    84\t{\n    85\t    /// Create a snapshot from the log `entries`.\n    86\t    fn create(entries: &[T]) -> Self;\n    87\t\n    88\t    /// Merge another snapshot `delta` into self.\n    89\t    fn merge(&mut self, delta: Self);\n    90\t\n    91\t    /// Whether `T` is snapshottable. If not, simply return `false` and leave the other functions `unimplemented!()`.\n    92\t    fn use_snapshots() -> bool;\n    93\t\n    94\t    //fn size_hint() -> usize;  // TODO: To let the system know trade-off of using entries vs snapshot?\n    95\t}\n    96\t\n    97\t/// The Result type returned by the storage API.\n    98\tpub type StorageResult<T> = Result<T, Box<dyn Error>>;\n    99\t\n   100\t/// The write operations of the storge implementation.\n   101\t#[derive(Debug)]\n   102\tpub enum StorageOp<T: Entry> {\n   103\t    /// Appends an entry to the end of the log.\n   104\t    AppendEntry(T),\n   105\t    /// Appends entries to the end of the log.\n   106\t    AppendEntries(Vec<T>),\n   107\t    /// Appends entries to the log from the prefix specified by the given index.\n   108\t    AppendOnPrefix(usize, Vec<T>),\n   109\t    /// Sets the round that has been promised.\n   110\t    SetPromise(Ballot),\n   111\t    /// Sets the decided index in the log.\n   112\t    SetDecidedIndex(usize),\n   113\t    /// Sets the latest accepted round.\n   114\t    SetAcceptedRound(Ballot),\n   115\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   116\t    SetCompactedIdx(usize),\n   117\t    /// Removes elements up to the given idx from storage.\n   118\t    Trim(usize),\n   119\t    /// Sets the StopSign used for reconfiguration.\n   120\t    SetStopsign(Option<StopSign>),\n   121\t    /// Sets the snapshot.\n   122\t    SetSnapshot(Option<T::Snapshot>),\n   123\t}\n   124\t\n   125\t/// Trait for implementing the storage backend of Sequence Paxos.\n   126\tpub trait Storage<T>\n   127\twhere\n   128\t    T: Entry,\n   129\t{\n   130\t    /// **Atomically** perform all storage operations in order.\n   131\t    /// For correctness, the operations must be atomic i.e., either all operations are performed\n   132\t    /// successfully or all get rolled back. If the `StorageResult` returns as `Err`, the\n   133\t    /// operations are assumed to have been rolled back to the previous state before this function\n   134\t    /// call.\n   135\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()>;\n   136\t\n   137\t    /// Appends an entry to the end of the log.\n   138\t    fn append_entry(&mut self, entry: T) -> StorageResult<()>;\n   139\t\n   140\t    /// Appends the entries of `entries` to the end of the log.\n   141\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()>;\n   142\t\n   143\t    /// Appends the entries of `entries` to the prefix from index `from_index` (inclusive) in the log.\n   144\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()>;\n   145\t\n   146\t    /// Sets the round that has been promised.\n   147\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()>;\n   148\t\n   149\t    /// Sets the decided index in the log.\n   150\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()>;\n   151\t\n   152\t    /// Returns the decided index in the log.\n   153\t    fn get_decided_idx(&self) -> StorageResult<usize>;\n   154\t\n   155\t    /// Sets the latest accepted round.\n   156\t    fn se