{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos/src/storage/state_cache.rs omnipaxos/src/messages.rs'","aggregated_output":"     1\tuse super::{internal_storage::InternalStorageConfig, Entry, StopSign};\n     2\tuse crate::ballot_leader_election::Ballot;\n     3\t#[cfg(feature = \"unicache\")]\n     4\tuse crate::{unicache::*, util::NodeId};\n     5\t\n     6\t/// A simple in-memory storage for simple state values of OmniPaxos.\n     7\tpub(super) struct StateCache<T>\n     8\twhere\n     9\t    T: Entry,\n    10\t{\n    11\t    #[cfg(feature = \"unicache\")]\n    12\t    /// Id of this node\n    13\t    pub pid: NodeId,\n    14\t    /// The maximum number of entries to batch.\n    15\t    pub batch_size: usize,\n    16\t    /// Vector which contains all the logged entries in-memory.\n    17\t    pub batched_entries: Vec<T>,\n    18\t    /// Last promised round.\n    19\t    pub promise: Ballot,\n    20\t    /// Last accepted round.\n    21\t    pub accepted_round: Ballot,\n    22\t    /// Length of the decided log.\n    23\t    pub decided_idx: usize,\n    24\t    /// Length of the accepted log.\n    25\t    pub accepted_idx: usize,\n    26\t    /// Garbage collected index.\n    27\t    pub compacted_idx: usize,\n    28\t    /// Stopsign entry.\n    29\t    pub stopsign: Option<StopSign>,\n    30\t    #[cfg(feature = \"unicache\")]\n    31\t    /// Batch of entries that are processed (i.e., maybe encoded). Only used by the leader.\n    32\t    pub batched_processed_by_leader: Vec<T::EncodeResult>,\n    33\t    #[cfg(feature = \"unicache\")]\n    34\t    pub unicache: T::UniCache,\n    35\t}\n    36\t\n    37\timpl<T> StateCache<T>\n    38\twhere\n    39\t    T: Entry,\n    40\t{\n    41\t    pub(super) fn new(\n    42\t        config: InternalStorageConfig,\n    43\t        #[cfg(feature = \"unicache\")] pid: NodeId,\n    44\t    ) -> Self {\n    45\t        StateCache {\n    46\t            #[cfg(feature = \"unicache\")]\n    47\t            pid,\n    48\t            batch_size: config.batch_size,\n    49\t            batched_entries: Vec::with_capacity(config.batch_size),\n    50\t            promise: Ballot::default(),\n    51\t            accepted_round: Ballot::default(),\n    52\t            decided_idx: 0,\n    53\t            accepted_idx: 0,\n    54\t            compacted_idx: 0,\n    55\t            stopsign: None,\n    56\t            #[cfg(feature = \"unicache\")]\n    57\t            batched_processed_by_leader: Vec::with_capacity(config.batch_size),\n    58\t            #[cfg(feature = \"unicache\")]\n    59\t            unicache: T::UniCache::new(),\n    60\t        }\n    61\t    }\n    62\t\n    63\t    // Appends an entry to the end of the `batched_entries`. If the batch is full, the\n    64\t    // batch is flushed and return flushed entries. Else, return None.\n    65\t    pub(super) fn append_entry(&mut self, entry: T) -> Option<Vec<T>> {\n    66\t        #[cfg(feature = \"unicache\")]\n    67\t        {\n    68\t            let processed = self.unicache.try_encode(&entry);\n    69\t            self.batched_processed_by_leader.push(processed);\n    70\t        }\n    71\t        self.batched_entries.push(entry);\n    72\t        self.take_entries_if_batch_is_full()\n    73\t    }\n    74\t\n    75\t    // Appends entries to the end of the `batched_entries`. If the batch is full, the\n    76\t    // batch is flushed and return flushed entries. Else, return None.\n    77\t    pub(super) fn append_entries(&mut self, entries: Vec<T>) -> Option<Vec<T>> {\n    78\t        #[cfg(feature = \"unicache\")]\n    79\t        {\n    80\t            if self.promise.pid == self.pid {\n    81\t                // only try encoding if we're the leader\n    82\t                for entry in &entries {\n    83\t                    let processed = self.unicache.try_encode(entry);\n    84\t                    self.batched_processed_by_leader.push(processed);\n    85\t                }\n    86\t            }\n    87\t        }\n    88\t        self.batched_entries.extend(entries);\n    89\t        self.take_entries_if_batch_is_full()\n    90\t    }\n    91\t\n    92\t    // Flushes batched entries and appends a stopsign to the log. Returns the flushed\n    93\t    // entries if there were any\n    94\t    pub(super) fn append_stopsign(&mut self, ss: StopSign) -> Option<Vec<T>> {\n    95\t        self.stopsign = Some(ss);\n    96\t        if self.batched_entries.is_empty() {\n    97\t            None\n    98\t        } else {\n    99\t            Some(self.take_batched_entries())\n   100\t        }\n   101\t    }\n   102\t\n   103\t    // Return batched entries if the batch is full that need to be flushed in to storage.\n   104\t    fn take_entries_if_batch_is_full(&mut self) -> Option<Vec<T>> {\n   105\t        if self.batched_entries.len() >= self.batch_size {\n   106\t            Some(self.take_batched_entries())\n   107\t        } else {\n   108\t            None\n   109\t        }\n   110\t    }\n   111\t\n   112\t    // Clears the batched entries and returns the cleared entries. If the batch is empty,\n   113\t    // return an empty vector.\n   114\t    pub(super) fn take_batched_entries(&mut self) -> Vec<T> {\n   115\t        std::mem::take(&mut self.batched_entries)\n   116\t    }\n   117\t\n   118\t    #[cfg(feature = \"unicache\")]\n   119\t    pub(super) fn take_batched_processed(&mut self) -> Vec<T::EncodeResult> {\n   120\t        std::mem::take(&mut self.batched_processed_by_leader)\n   121\t    }\n   122\t\n   123\t    // Returns whether a stopsign is decided\n   124\t    pub(super) fn stopsign_is_decided(&self) -> bool {\n   125\t        self.stopsign.is_some() && self.decided_idx == self.accepted_idx\n   126\t    }\n   127\t}\n   128\tuse crate::{\n   129\t    messages::{ballot_leader_election::BLEMessage, sequence_paxos::PaxosMessage},\n   130\t    storage::Entry,\n   131\t    util::NodeId,\n   132\t};\n   133\t#[cfg(feature = \"serde\")]\n   134\tuse serde::{Deserialize, Serialize};\n   135\t\n   136\t#[cfg(feature = \"async_runtime\")]\n   137\tpub use async_runtime::{AsyncRuntimeMessage, AsyncRuntimeMsg, EntryId};\n   138\t\n   139\t/// Internal component for log replication\n   140\tpub mod sequence_paxos {\n   141\t    use crate::{\n   142\t        ballot_leader_election::Ballot,\n   143\t        storage::{Entry, StopSign},\n   144\t        util::{LogSync, NodeId, SequenceNumber},\n   145\t    };\n   146\t    #[cfg(feature = \"serde\")]\n   147\t    use serde::{Deserialize, Serialize};\n   148\t    use std::fmt::Debug;\n   149\t\n   150\t    /// Message sent by a follower on crash-recovery or dropped messages to request its leader to re-prepare them.\n   151\t    #[derive(Copy, Clone, Debug)]\n   152\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   153\t    pub struct PrepareReq {\n   154\t        /// The current round.\n   155\t        pub n: Ballot,\n   156\t    }\n   157\t\n   158\t    /// Prepare message sent by a newly-elected leader to initiate the Prepare phase.\n   159\t    #[derive(Copy, Clone, Debug)]\n   160\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   161\t    pub struct Prepare {\n   162\t        /// The current round.\n   163\t        pub n: Ballot,\n   164\t        /// The decided index of this leader.\n   165\t        pub decided_idx: usize,\n   166\t        /// The latest round in which an entry was accepted.\n   167\t        pub n_accepted: Ballot,\n   168\t        /// The log length of this leader.\n   169\t        pub accepted_idx: usize,\n   170\t    }\n   171\t\n   172\t    /// Promise message sent by a follower in response to a [`Prepare`] sent by the leader.\n   173\t    #[derive(Clone, Debug)]\n   174\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   175\t    pub struct Promise<T>\n   176\t    where\n   177\t        T: Entry,\n   178\t    {\n   179\t        /// The current round.\n   180\t        pub n: Ballot,\n   181\t        /// The latest round in which an entry was accepted.\n   182\t        pub n_accepted: Ballot,\n   183\t        /// The decided index of this follower.\n   184\t        pub decided_idx: usize,\n   185\t        /// The log length of this follower.\n   186\t        pub accepted_idx: usize,\n   187\t        /// The log update which the leader applies to its log in order to sync\n   188\t        /// with this follower (if the follower is more up-to-date).\n   189\t        pub log_sync: Option<LogSync<T>>,\n   190\t    }\n   191\t\n   192\t    /// AcceptSync message sent by the leader to synchronize the logs of all replicas in the prepare phase.\n   193\t    #[derive(Clone, Debug)]\n   194\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   195\t    pub struct AcceptSync<T>\n   196\t    where\n   197\t        T: Entry,\n   198\t    {\n   199\t        /// The current round.\n   200\t        pub n: Ballot,\n   201\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   202\t        pub seq_num: SequenceNumber,\n   203\t        /// The decided index\n   204\t        pub decided_idx: usize,\n   205\t        /// The log update which the follower applies to its log in order to sync\n   206\t        /// with the leader.\n   207\t        pub log_sync: LogSync<T>,\n   208\t        #[cfg(feature = \"unicache\")]\n   209\t        /// The UniCache of the leader\n   210\t        pub unicache: T::UniCache,\n   211\t    }\n   212\t\n   213\t    /// Message with entries to be replicated and the latest decided index sent by the leader in the accept phase.\n   214\t    #[derive(Clone, Debug)]\n   215\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   216\t    pub struct AcceptDecide<T>\n   217\t    where\n   218\t        T: Entry,\n   219\t    {\n   220\t        /// The current round.\n   221\t        pub n: Ballot,\n   222\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   223\t        pub seq_num: SequenceNumber,\n   224\t        /// The decided index.\n   225\t        pub decided_idx: usize,\n   226\t        #[cfg(not(feature = \"unicache\"))]\n   227\t        /// Entries to be replicated.\n   228\t        pub entries: Vec<T>,\n   229\t        #[cfg(feature = \"unicache\")]\n   230\t        /// Entries to be replicated.\n   231\t        pub entries: Vec<T::EncodeResult>,\n   232\t    }\n   233\t\n   234\t    /// Message sent by follower to leader when entries has been accepted.\n   235\t    #[derive(Copy, Clone, Debug)]\n   236\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   237\t    pub struct Accepted {\n   238\t        /// The current round.\n   239\t        pub n: Ballot,\n   240\t        /// The accepted index.\n   241\t        pub accepted_idx: usize,\n   242\t    }\n   243\t\n   244\t    /// Message sent by leader to followers to decide up to a certain index in the log.\n   245\t    #[derive(Copy, Clone, Debug)]\n   246\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   247\t    pub struct Decide {\n   248\t        /// The current round.\n   249\t        pub n: Ballot,\n   250\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   251\t        pub seq_num: SequenceNumber,\n   252\t        /// The decided index.\n   253\t        pub decided_idx: usize,\n   254\t    }\n   255\t\n   256\t    /// Message sent by leader to followers to accept a StopSign\n   257\t    #[derive(Clone, Debug)]\n   258\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   259\t    pub struct AcceptStopSign {\n   260\t        /// The current round.\n   261\t        pub n: Ballot,\n   262\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   263\t        pub seq_num: SequenceNumber,\n   264\t        /// The decided index.\n   265\t        pub ss: StopSign,\n   266\t    }\n   267\t\n   268\t    /// Message sent by follower to leader when accepting an entry is rejected.\n   269\t    /// This happens when the follower is promised to a greater leader.\n   270\t    #[derive(Clone, Debug)]\n   271\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   272\t    pub struct NotAccepted {\n   273\t        /// The follower's current ballot\n   274\t        pub n: Ballot,\n   275\t    }\n   276\t\n   277\t    /// Compaction Request\n   278\t    #[allow(missing_docs)]\n   279\t    #[derive(Clone, Debug)]\n   280\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   281\t    pub enum Compaction {\n   282\t        Trim(usize),\n   283\t        Snapshot(Option<usize>),\n   284\t    }\n   285\t\n   286\t    /// An enum for all the different message types.\n   287\t    #[allow(missing_docs)]\n   288\t    #[derive(Clone, Debug)]\n   289\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   290\t    pub enum PaxosMsg<T>\n   291\t    where\n   292\t        T: Entry,\n   293\t    {\n   294\t        /// Request a [`Prepare`] to be sent from the leader. Used for fail-recovery.\n   295\t        PrepareReq(PrepareReq),\n   296\t        #[allow(missing_docs)]\n   297\t        Prepare(Prepare),\n   298\t        Promise(Promise<T>),\n   299\t        AcceptSync(AcceptSync<T>),\n   300\t        AcceptDecide(AcceptDecide<T>),\n   301\t        Accepted(Accepted),\n   302\t        NotAccepted(NotAccepted),\n   303\t        Decide(Decide),\n   304\t        /// Forward client proposals to the leader.\n   305\t        ProposalForward(Vec<T>),\n   306\t        Compaction(Compaction),\n   307\t        AcceptStopSign(AcceptStopSign),\n   308\t        ForwardStopSign(StopSign),\n   309\t    }\n   310\t\n   311\t    /// A struct for a Paxos message that also includes sender and receiver.\n   312\t    #[derive(Clone, Debug)]\n   313\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   314\t    pub struct PaxosMessage<T>\n   315\t    where\n   316\t        T: Entry,\n   317\t    {\n   318\t        /// Sender of `msg`.\n   319\t        pub from: NodeId,\n   320\t        /// Receiver of `msg`.\n   321\t        pub to: NodeId,\n   322\t        /// The message content.\n   323\t        pub msg: PaxosMsg<T>,\n   324\t    }\n   325\t}\n   326\t\n   327\t/// The different messages BLE uses to communicate with other servers.\n   328\tpub mod ballot_leader_election {\n   329\t\n   330\t    use crate::{ballot_leader_election::Ballot, util::NodeId};\n   331\t    #[cfg(feature = \"serde\")]\n   332\t    use serde::{Deserialize, Serialize};\n   333\t\n   334\t    /// An enum for all the different BLE message types.\n   335\t    #[allow(missing_docs)]\n   336\t    #[derive(Clone, Debug)]\n   337\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   338\t    pub enum HeartbeatMsg {\n   339\t        Request(HeartbeatRequest),\n   340\t        Reply(HeartbeatReply),\n   341\t    }\n   342\t\n   343\t    /// Requests a reply from all the other servers.\n   344\t    #[derive(Clone, Debug)]\n   345\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   346\t    pub struct HeartbeatRequest {\n   347\t        /// Number of the current round.\n   348\t        pub round: u32,\n   349\t    }\n   350\t\n   351\t    /// Replies\n   352\t    #[derive(Clone, Debug)]\n   353\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   354\t    pub struct HeartbeatReply {\n   355\t        /// Number of the current heartbeat round.\n   356\t        pub round: u32,\n   357\t        /// Ballot of replying server.\n   358\t        pub ballot: Ballot,\n   359\t        /// Leader this server is following\n   360\t        pub leader: Ballot,\n   361\t        /// Whether the replying server sees a need for a new leader\n   362\t        pub happy: bool,\n   363\t    }\n   364\t\n   365\t    /// A struct for a Paxos message that also includes sender and receiver.\n   366\t    #[derive(Clone, Debug)]\n   367\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   368\t    pub struct BLEMessage {\n   369\t        /// Sender of `msg`.\n   370\t        pub from: NodeId,\n   371\t        /// Receiver of `msg`.\n   372\t        pub to: NodeId,\n   373\t        /// The message content.\n   374\t        pub msg: HeartbeatMsg,\n   375\t    }\n   376\t}\n   377\t\n   378\t#[allow(missing_docs)]\n   379\t/// Message in OmniPaxos. Can be either a `SequencePaxos` message (for log replication),\n   380\t/// a `BLE` message (for leader election), or (when the `async_runtime` feature is enabled)\n   381\t/// an `AsyncRuntime` message used by the actor layer for `append_notify` correlation.\n   382\t#[derive(Clone, Debug)]\n   383\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   384\tpub enum Message<T>\n   385\twhere\n   386\t    T: Entry,\n   387\t{\n   388\t    SequencePaxos(PaxosMessage<T>),\n   389\t    BLE(BLEMessage),\n   390\t    #[cfg(feature = \"async_runtime\")]\n   391\t    AsyncRuntime(AsyncRuntimeMessage<T>),\n   392\t}\n   393\t\n   394\timpl<T> Message<T>\n   395\twhere\n   396\t    T: Entry,\n   397\t{\n   398\t    /// Get the sender id of the message\n   399\t    pub fn get_sender(&self) -> NodeId {\n   400\t        match self {\n   401\t            Message::SequencePaxos(p) => p.from,\n   402\t            Message::BLE(b) => b.from,\n   403\t            #[cfg(feature = \"async_runtime\")]\n   404\t            Message::AsyncRuntime(a) => a.from,\n   405\t        }\n   406\t    }\n   407\t\n   408\t    /// Get the receiver id of the message\n   409\t    pub fn get_receiver(&self) -> NodeId {\n   410\t        match self {\n   411\t            Message::SequencePaxos(p) => p.to,\n   412\t            Message::BLE(b) => b.to,\n   413\t            #[cfg(feature = \"async_runtime\")]\n   414\t            Message::AsyncRuntime(a) => a.to,\n   415\t        }\n   416\t    }\n   417\t}\n   418\t\n   419\t/// Messages exchanged between actor instances for `append_notify` correlation.\n   420\t/// These do not touch the core Paxos protocol — they run alongside it.\n   421\t#[cfg(feature = \"async_runtime\")]\n   422\tpub mod async_runtime {\n   423\t    use crate::{ballot_leader_election::Ballot, storage::Entry, util::NodeId};\n   424\t    #[cfg(feature = \"serde\")]\n   425\t    use serde::{Deserialize, Serialize};\n   426\t\n   427\t    /// A unique identifier for a tagged proposal, used to correlate a\n   428\t    /// forwarded entry with its assigned log index.\n   429\t    #[derive(Copy, Clone, Debug, Eq, PartialEq, Hash)]\n   430\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   431\t    pub struct EntryId(pub uuid::Uuid);\n   432\t\n   433\t    /// Wrapper carrying sender/receiver for an [`AsyncRuntimeMsg`].\n   434\t    #[derive(Clone, Debug)]\n   435\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   436\t    pub struct AsyncRuntimeMessage<T>\n   437\t    where\n   438\t        T: Entry,\n   439\t    {\n   440\t        /// Sender of `msg`.\n   441\t        pub from: NodeId,\n   442\t        /// Receiver of `msg`.\n   443\t        pub to: NodeId,\n   444\t        /// The runtime-message content.\n   445\t        pub msg: AsyncRuntimeMsg<T>,\n   446\t    }\n   447\t\n   448\t    /// Runtime-layer messages used by the actor to correlate `append_notify` calls\n   449\t    /// with the log index the leader eventually assigns.\n   450\t    #[allow(missing_docs)]\n   451\t    #[derive(Clone, Debug)]\n   452\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   453\t    pub enum AsyncRuntimeMsg<T>\n   454\t    where\n   455\t        T: Entry,\n   456\t    {\n   457\t        /// Follower actor → leader actor. Carries entries the originator(s) want\n   458\t        /// tracked, batched into one message. Replaces the untagged\n   459\t        /// `PaxosMsg::ProposalForward` path when the caller used `append_notify`.\n   460\t        TaggedProposal { entries: Vec<(EntryId, T)> },\n   461\t        /// Leader actor → originating follower actor. Carries, for each entry in a\n   462\t        /// previously received `TaggedProposal` batch that was actually accepted,\n   463\t        /// the log index the leader assigned, plus the single full ballot under\n   464\t        /// which the *whole batch* was accepted (one ballot, not per-entry: the\n   465\t        /// leader processes one incoming `TaggedProposal` synchronously with no\n   466\t        /// yield points, so every entry in it is necessarily accepted under the\n   467\t        /// same ballot).\n   468\t        Assigned {\n   469\t            ballot: Ballot,\n   470\t            entries: Vec<(EntryId, usize)>,\n   471\t        },\n   472\t    }\n   473\t}\n","exit_code":0,"status":"completed"}}
