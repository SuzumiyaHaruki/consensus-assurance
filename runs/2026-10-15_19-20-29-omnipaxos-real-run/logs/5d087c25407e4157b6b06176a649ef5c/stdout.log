{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat Cargo.toml && echo === && cat omnipaxos/tests/batching_test.rs && echo === && cat omnipaxos/test_all_features.sh'","aggregated_output":"[workspace]\nresolver = \"2\"\nmembers = [\n    \"omnipaxos\",\n    \"omnipaxos_storage\",\n    \"omnipaxos_macros\",\n    \"omnipaxos_runtime\",\n    \"omnipaxos_ui\",\n    \"examples/kv_store\",\n    \"examples/kv_store_async\",\n    \"examples/dashboard\",\n]\n\n[profile.release]\nlto = true\n===\npub mod utils;\n\nuse kompact::prelude::{promise, Ask, FutureCollection};\nuse omnipaxos::ballot_leader_election::Ballot;\nuse serial_test::serial;\nuse std::{thread, time::Duration};\nuse utils::{TestConfig, TestSystem};\n\n/// Test case for batching.\n#[test]\n#[serial]\nfn batching_test() {\n    let wait_time_between_propose = Duration::from_millis(2);\n\n    let cfg = TestConfig::load(\"batching_test\").expect(\"Test config loaded\");\n    let mut sys = TestSystem::with(cfg);\n    let first_node = sys.nodes.get(&1).unwrap();\n    let (kprom, kfuture) = promise::<Ballot>();\n    first_node.on_definition(|x| x.election_futures.push(Ask::new(kprom, ())));\n    sys.start_all_nodes();\n    // Wait for initial leader to become elected. Note: needed so that initial propsals don't get\n    // bunched and throw off alignment with cfg.num_proposals.\n    let _leader_id = kfuture\n        .wait_timeout(cfg.wait_timeout)\n        .expect(\"No leader has been elected in the allocated time!\")\n        .pid;\n\n    let mut futures = vec![];\n    let mut last_decided_idx = 0;\n    let proposals = utils::create_proposals(1, cfg.num_proposals);\n    for v in proposals {\n        let (kprom, kfuture) = promise::<()>();\n        first_node.on_definition(|x| {\n            x.insert_decided_future(Ask::new(kprom, v.clone()));\n            x.paxos.append(v.clone()).expect(\"Failed to append\");\n        });\n        futures.push(kfuture);\n        thread::sleep(wait_time_between_propose);\n        // check batching\n        first_node.on_definition(|x| {\n            let decided_idx = x.paxos.get_decided_idx();\n            check_batching(decided_idx, last_decided_idx, cfg.batch_size);\n            last_decided_idx = decided_idx;\n        });\n    }\n\n    match FutureCollection::collect_with_timeout::<Vec<_>>(futures, cfg.wait_timeout) {\n        Ok(_) => {}\n        Err(e) => panic!(\"Error on collecting futures of decided proposals: {}\", e),\n    }\n    sys.shutdown();\n}\n\nfn check_batching(decided_idx: usize, last_decided_idx: usize, batch_size: usize) {\n    let idx_diff = decided_idx - last_decided_idx;\n    if idx_diff != 0 {\n        assert!(decided_idx - last_decided_idx >= batch_size);\n    }\n}\n===\n#!/bin/bash\n\n# Tests all possible feature combinations.\n# Usage: ./test_all_features.sh [-c], -c runs cargo check instead of cargo test\n\n# Define an array of feature names\nfeatures=(\"macros\" \"logging\" \"toml_config\" \"unicache\" \"async_runtime\")\n\n# Initialize a variable to track whether to run the tests or not\ncheck_only=false\n\n# Process command line arguments\nwhile [[ $# -gt 0 ]]; do\n    case \"$1\" in\n        -c)\n            check_only=true\n            shift\n            ;;\n        *)\n            echo \"Invalid argument: $1\"\n            exit 1\n            ;;\n    esac\ndone\n\n# Get the total number of features\nnum_features=${#features[@]}\n\n# Calculate the total number of feature combinations (2^num_features)\ntotal_combinations=$((1 << num_features))\n\n# Initialize a variable to store the failing combination\nfailing_combinations=\"\"\n\n# Loop through all possible feature combinations\nfor ((i = 1; i < total_combinations; i++)); do\n    feature_flags=\"--features \"\n\n    # Generate feature flags for the current combination\n    for ((j = 0; j < num_features; j++)); do\n        if (( (i >> j) & 1 )); then\n            feature_flags+=\"${features[j]},\"\n        fi\n    done\n\n    if [ \"$check_only\" = true ]; then\n        # Run cargo check with the current feature combination\n        echo \"Checking with features: ${feature_flags}\"\n        cargo check --no-default-features $feature_flags\n    else\n        # Run cargo test with the current feature combination\n        echo \"Testing with features: ${feature_flags}\"\n        cargo test --no-default-features $feature_flags\n    fi\n\n    # Check if cargo test failed\n    if [ $? -ne 0 ]; then\n        echo \"Cargo failed with combination ${feature_flags}\"\n        failing_combinations+=\"\\n${feature_flags}\"\n    fi\ndone\n\n# Check if any combination failed and print the failing combinations\nif [ -n \"$failing_combinations\" ]; then\n    echo -e \"Failed feature combinations:$failing_combinations\"\n    exit 1\nfi\n\necho \"All feature combinations tested successfully!\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/tests/async_runtime_test.rs | head -200'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/tests/async_runtime_test.rs | head -200'","aggregated_output":"     1\t//! Integration tests for the async runtime layer.\n     2\t//!\n     3\t//! Sets up a small in-process cluster where each node runs an OmniPaxos actor and messages\n     4\t//! are shuttled between them over in-memory channels, then exercises the async API.\n     5\t#![cfg(feature = \"tokio_runtime\")]\n     6\t\n     7\tuse std::{\n     8\t    collections::HashMap,\n     9\t    sync::{\n    10\t        atomic::{AtomicBool, Ordering},\n    11\t        Arc,\n    12\t    },\n    13\t    time::Duration,\n    14\t};\n    15\t\n    16\t#[cfg(feature = \"unicache\")]\n    17\tuse omnipaxos::unicache::UniCache;\n    18\tuse omnipaxos::{\n    19\t    messages::{sequence_paxos::PaxosMsg, Message},\n    20\t    storage::{Entry, Snapshot},\n    21\t    util::{LogEntry, NodeId},\n    22\t    ClusterConfig, OmniPaxosConfig, ProposeErr, ServerConfig,\n    23\t};\n    24\tuse omnipaxos_runtime::{\n    25\t    spawn_actor, AppendError, OmniPaxosEvent, OmniPaxosHandle, RuntimeConfig, RuntimeProposeErr,\n    26\t    TokioRuntime,\n    27\t};\n    28\tuse omnipaxos_storage::memory_storage::MemoryStorage;\n    29\tuse tokio::time::timeout;\n    30\t\n    31\t/// Minimal Entry type — avoids depending on the `macros` feature. Always derives serde\n    32\t/// traits (an unconditional dev-dependency here) rather than gating on this crate's own\n    33\t/// `serde` feature: under workspace-wide builds (`cargo check --workspace`), `omnipaxos`'s\n    34\t/// `serde` feature can be active (enabled by some other workspace member) independently of\n    35\t/// whether *this* crate's `serde` feature was requested, and `Entry::Snapshot` requires\n    36\t/// `Serialize + Deserialize` whenever the dependency's feature is on, regardless.\n    37\t#[derive(Clone, Debug, Default, PartialEq, serde::Serialize, serde::Deserialize)]\n    38\tstruct TestEntry(u64);\n    39\t\n    40\t#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\n    41\tstruct NoSnapshot;\n    42\t\n    43\timpl Snapshot<TestEntry> for NoSnapshot {\n    44\t    fn create(_entries: &[TestEntry]) -> Self {\n    45\t        NoSnapshot\n    46\t    }\n    47\t    fn merge(&mut self, _delta: Self) {}\n    48\t    fn use_snapshots() -> bool {\n    49\t        false\n    50\t    }\n    51\t}\n    52\t\n    53\t/// No-op UniCache so `cargo test --all-features` can compile without the macros crate.\n    54\t#[cfg(feature = \"unicache\")]\n    55\t#[derive(Clone, Debug, Default, serde::Serialize, serde::Deserialize)]\n    56\tstruct NoUniCache;\n    57\t\n    58\t#[cfg(feature = \"unicache\")]\n    59\timpl UniCache for NoUniCache {\n    60\t    type T = TestEntry;\n    61\t\n    62\t    fn new() -> Self {\n    63\t        NoUniCache\n    64\t    }\n    65\t\n    66\t    fn try_encode(&mut self, entry: &Self::T) -> <Self::T as Entry>::EncodeResult {\n    67\t        entry.clone()\n    68\t    }\n    69\t\n    70\t    fn decode(&mut self, processed: <Self::T as Entry>::EncodeResult) -> Self::T {\n    71\t        processed\n    72\t    }\n    73\t}\n    74\t\n    75\timpl Entry for TestEntry {\n    76\t    type Snapshot = NoSnapshot;\n    77\t\n    78\t    #[cfg(feature = \"unicache\")]\n    79\t    type Encoded = ();\n    80\t    #[cfg(feature = \"unicache\")]\n    81\t    type Encodable = TestEntry;\n    82\t    #[cfg(feature = \"unicache\")]\n    83\t    type NotEncodable = ();\n    84\t    #[cfg(feature = \"unicache\")]\n    85\t    type EncodeResult = TestEntry;\n    86\t    #[cfg(feature = \"unicache\")]\n    87\t    type UniCache = NoUniCache;\n    88\t}\n    89\t\n    90\tfn build_op(\n    91\t    pid: NodeId,\n    92\t    nodes: Vec<NodeId>,\n    93\t) -> omnipaxos::OmniPaxos<TestEntry, MemoryStorage<TestEntry>> {\n    94\t    let cluster_config = ClusterConfig {\n    95\t        configuration_id: 1,\n    96\t        nodes,\n    97\t        flexible_quorum: None,\n    98\t    };\n    99\t    // `..Default::default()` is needed only when the `logging` feature adds\n   100\t    // extra fields to `ServerConfig`; clippy flags it as redundant under\n   101\t    // feature combinations where it isn't (e.g. `logging` off).\n   102\t    #[allow(clippy::needless_update)]\n   103\t    let server_config = ServerConfig {\n   104\t        pid,\n   105\t        election_tick_timeout: 3,\n   106\t        resend_message_tick_timeout: 5,\n   107\t        buffer_size: 100,\n   108\t        batch_size: 1,\n   109\t        flush_batch_tick_timeout: 100,\n   110\t        leader_priority: 0,\n   111\t        ..Default::default()\n   112\t    };\n   113\t    let cfg = OmniPaxosConfig {\n   114\t        cluster_config,\n   115\t        server_config,\n   116\t    };\n   117\t    cfg.build(MemoryStorage::default()).unwrap()\n   118\t}\n   119\t\n   120\t/// Spawn `n` nodes and wire their outgoing/incoming message streams together.\n   121\tasync fn spawn_cluster(n: NodeId) -> HashMap<NodeId, OmniPaxosHandle<TestEntry>> {\n   122\t    let nodes: Vec<NodeId> = (1..=n).collect();\n   123\t    let cfg = RuntimeConfig {\n   124\t        tick_period: Duration::from_millis(2),\n   125\t        egress_period: Duration::from_millis(1),\n   126\t        ..Default::default()\n   127\t    };\n   128\t\n   129\t    let mut handles: HashMap<NodeId, OmniPaxosHandle<TestEntry>> = HashMap::new();\n   130\t    for pid in nodes.clone() {\n   131\t        let op = build_op(pid, nodes.clone());\n   132\t        let h = spawn_actor::<TestEntry, MemoryStorage<TestEntry>, TokioRuntime>(op, cfg.clone());\n   133\t        handles.insert(pid, h);\n   134\t    }\n   135\t\n   136\t    // Wire in-process transport: every node's outgoing_messages -> receiver's handle_incoming.\n   137\t    let handles_arc = Arc::new(handles.clone());\n   138\t    for pid in nodes {\n   139\t        let out = handles_arc[&pid].outgoing_messages();\n   140\t        let peers = handles_arc.clone();\n   141\t        tokio::spawn(async move {\n   142\t            while let Ok(msg) = out.recv().await {\n   143\t                let receiver = msg.get_receiver();\n   144\t                if let Some(peer) = peers.get(&receiver) {\n   145\t                    peer.handle_incoming(msg).await;\n   146\t                }\n   147\t            }\n   148\t        });\n   149\t    }\n   150\t\n   151\t    handles\n   152\t}\n   153\t\n   154\t/// Like `spawn_cluster`, but every message is passed through `keep` before\n   155\t/// delivery: `keep(&msg)` returning `false` drops it (the sender's outgoing\n   156\t/// channel is still drained, so a dropped message never causes backpressure)\n   157\t/// instead of forwarding it to the receiver. Lets tests script network\n   158\t/// conditions (e.g. blocking one node's traffic, or one message type\n   159\t/// cluster-wide) precisely enough to reach specific internal states.\n   160\tasync fn spawn_cluster_with_filter<F>(\n   161\t    n: NodeId,\n   162\t    batch_size: usize,\n   163\t    append_notify_timeout: Duration,\n   164\t    keep: F,\n   165\t) -> HashMap<NodeId, OmniPaxosHandle<TestEntry>>\n   166\twhere\n   167\t    F: Fn(&Message<TestEntry>) -> bool + Send + Sync + 'static,\n   168\t{\n   169\t    let nodes: Vec<NodeId> = (1..=n).collect();\n   170\t    let cfg = RuntimeConfig {\n   171\t        tick_period: Duration::from_millis(2),\n   172\t        egress_period: Duration::from_millis(1),\n   173\t        append_notify_timeout,\n   174\t        ..Default::default()\n   175\t    };\n   176\t\n   177\t    let mut handles: HashMap<NodeId, OmniPaxosHandle<TestEntry>> = HashMap::new();\n   178\t    for pid in nodes.clone() {\n   179\t        let cluster_config = ClusterConfig {\n   180\t            configuration_id: 1,\n   181\t            nodes: nodes.clone(),\n   182\t            flexible_quorum: None,\n   183\t        };\n   184\t        #[allow(clippy::needless_update)]\n   185\t        let server_config = ServerConfig {\n   186\t            pid,\n   187\t            election_tick_timeout: 3,\n   188\t            resend_message_tick_timeout: 5,\n   189\t            buffer_size: 100,\n   190\t            batch_size,\n   191\t            flush_batch_tick_timeout: 100,\n   192\t            leader_priority: 0,\n   193\t            ..Default::default()\n   194\t        };\n   195\t        let op_cfg = OmniPaxosConfig {\n   196\t            cluster_config,\n   197\t            server_config,\n   198\t        };\n   199\t        let op = op_cfg.build(MemoryStorage::default()).unwrap();\n   200\t        let h = spawn_actor::<TestEntry, MemoryStorage<TestEntry>, TokioRuntime>(op, cfg.clone());\n","exit_code":0,"status":"completed"}}
