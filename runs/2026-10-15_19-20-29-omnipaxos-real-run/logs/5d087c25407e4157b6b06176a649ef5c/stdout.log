; }\n        }\n    }\n\n    fn pump(&mut self, steps: usize) {\n        for _ in 0..steps { self.step(); }\n    }\n\n    fn pump_until<F: Fn(&Cluster) -> bool>(&mut self, steps: usize, cond: F) -> bool {\n        for _ in 0..steps {\n            self.step();\n            if cond(self) { return true; }\n        }\n        cond(self)\n    }\n\n    fn leader(&self) -> Option<NodeId> {\n        for (pid, op) in &self.ops {\n            if let Some((l, true)) = op.get_current_leader() { if l == *pid { return Some(*pid); } }\n        }\n        None\n    }\n\n    fn any_leader(&self) -> Option<NodeId> {\n        self.ops.values().find_map(|op| op.get_current_leader().map(|(l, _)| l))\n    }\n\n    fn decided_entries(&self, pid: NodeId) -> Vec<TestEntry> {\n        let op = &self.ops[&pid];\n        let d = op.get_decided_idx();\n        if d == 0 { return vec![]; }\n        op.read_decided_suffix(0).unwrap_or_default().into_iter().filter_map(|e| match e {\n            omnipaxos::util::LogEntry::Decided(v) => Some(v),\n            _ => None,\n        }).collect()\n    }\n\n    fn decided_idx(&self, pid: NodeId) -> usize { self.ops[&pid].get_decided_idx() }\n\n    fn append(&mut self, pid: NodeId, e: TestEntry) -> Result<(), ()> {\n        self.ops.get_mut(&pid).unwrap().append(e).map_err(|_| ())\n    }\n\n    fn crash(&mut self, pid: NodeId) { self.ops.remove(&pid); }\n\n    fn recover(&mut self, pid: NodeId, batch_size: usize) {\n        let store = self.stores[&pid].clone();\n        let nodes = nodes_vec(self.n);\n        self.ops.insert(pid, build_op(pid, nodes, batch_size, store));\n    }\n}\n\nfn all_agree(c: &Cluster, expect: &[TestEntry]) -> bool {\n    c.alive().iter().all(|p| {\n        let got = c.decided_entries(*p);\n        got.len() >= expect.len() && got[..expect.len()] == *expect\n    })\n}\n\nfn start_leader(c: &mut Cluster) -> NodeId {\n    let got = c.pump_until(400, |c| c.leader().is_some());\n    assert!(got, \"no leader elected; any_leader={:?} dropped={}\", c.any_leader(), c.dropped);\n    c.leader().unwrap()\n}\n\n#[test]\nfn probe_basic_agreement() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let expect: Vec<TestEntry> = (0..10).map(TestEntry).collect();\n    for e in &expect { c.append(l, e.clone()).unwrap(); }\n    let ok = c.pump_until(2000, |c| all_agree(c, &expect));\n    for pid in c.alive() { println!(\"node {} decided_idx {}\", pid, c.decided_idx(pid)); }\n    assert!(ok, \"nodes did not agree on all 10 entries; decided: {:?}\", c.alive().iter().map(|p| (*p, c.decided_idx(*p))).collect::<Vec<_>>());\n}\n\n#[test]\nfn probe_stopsign_reconfig() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let expect: Vec<TestEntry> = (0..4).map(TestEntry).collect();\n    for e in &expect { c.append(l, e.clone()).unwrap(); }\n    assert!(c.pump_until(2000, |c| all_agree(c, &expect)), \"prefix not decided\");\n\n    let new_cfg = ClusterConfig { configuration_id: 2, nodes: c.alive(), flexible_quorum: None };\n    let res = c.ops.get_mut(&l).unwrap().reconfigure(new_cfg, None);\n    assert!(res.is_ok(), \"reconfigure rejected\");\n    let done = c.pump_until(2000, |c| c.alive().iter().all(|p| c.ops[p].is_reconfigured().is_some()));\n    for pid in c.alive() {\n        println!(\"node {} decided_idx {} reconfigured={}\", pid, c.decided_idx(pid), c.ops[&pid].is_reconfigured().is_some());\n    }\n    assert!(done, \"not all nodes observed the decided stopsign\");\n}\n\n#[test]\nfn probe_crash_recover_catchup() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..5).map(TestEntry).collect();\n    for e in &first { c.append(l, e.clone()).unwrap(); }\n    assert!(c.pump_until(2000, |c| all_agree(c, &first)), \"first batch not decided everywhere\");\n\n    // crash node 3 (follower) and keep it down\n    let down = (1..=3u64).find(|p| *p != l).unwrap();\n    c.crash(down);\n\n    let second: Vec<TestEntry> = (100..105).map(TestEntry).collect();\n    for e in &second { assert!(c.append(l, e.clone()).is_ok()); }\n    let expect: Vec<TestEntry> = first.iter().cloned().chain(second.iter().cloned()).collect();\n    assert!(c.pump_until(2000, |c| c.decided_idx(l) >= expect.len()), \"leader did not decide second batch\");\n\n    // recover node 3 from its persisted state and let it catch up\n    c.recover(down, 1);\n    let ok = c.pump_until(4000, |c| all_agree(c, &expect));\n    for pid in c.alive() { println!(\"node {} decided {}\", pid, c.decided_idx(pid)); }\n    assert!(ok, \"recovered node did not catch up; {} decided {} expected {}\", down, c.decided_idx(down), expect.len());\n}\n\n#[test]\nfn probe_batching_agreement() {\n    let mut c = Cluster::new(3, 3);\n    let l = start_leader(&mut c);\n    let follower = (1..=3u64).find(|p| *p != l).unwrap();\n    let expect: Vec<TestEntry> = (0..9).map(TestEntry).collect();\n    for e in &expect {\n        c.append(l, e.clone()).unwrap();\n        let _ = c.append(follower, e.clone());\n    }\n    let mut uniq: Vec<TestEntry> = Vec::new();\n    for e in &expect { if !uniq.iter().any(|x| x.0 == e.0) { uniq.push(e.clone()); } }\n    let ok = c.pump_until(4000, |c| c.alive().iter().all(|p| c.decided_entries(*p) == uniq));\n    for pid in c.alive() { println!(\"node {} decided {} entries (leader?) {}\", pid, c.decided_idx(pid), pid == l); }\n    assert!(ok, \"batching cluster did not agree; {:?}\", c.alive().iter().map(|p| (*p, c.decided_entries(*p).len())).collect::<Vec<_>>());\n}\n\n#[test]\nfn probe_leader_change_agreement() {\n    let mut c = Cluster::new(3, 1);\n    let l1 = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..5).map(TestEntry).collect();\n    for e in &first { c.append(l1, e.clone()).unwrap(); }\n    assert!(c.pump_until(2000, |c| all_agree(c, &first)), \"first batch not decided\");\n\n    // crash the leader; remaining two form a quorum and must elect a new one\n    c.crash(l1);\n    let got = c.pump_until(1000, |c| c.leader().is_some());\n    assert!(got, \"no new leader after leader crash\");\n    let l2 = c.leader().unwrap();\n    let second: Vec<TestEntry> = (200..205).map(TestEntry).collect();\n    for e in &second { assert!(c.append(l2, e.clone()).is_ok(), \"append on new leader failed\"); }\n    let expect: Vec<TestEntry> = first.iter().cloned().chain(second.iter().cloned()).collect();\n    assert!(c.pump_until(3000, |c| all_agree(c, &expect)), \"survivors did not agree after leader change\");\n    // old leader recovers; it must not decide anything contradictory\n    c.recover(l1, 1);\n    let ok = c.pump_until(4000, |c| all_agree(c, &expect));\n    for pid in c.alive() { println!(\"node {} decided {} entries\", pid, c.decided_idx(pid)); }\n    assert!(ok, \"recovered old leader diverged from cluster\");\n}\nRSEOF\necho written; wc -l omnipaxos/tests/probe1.rs'","aggregated_output":"written\n286 omnipaxos/tests/probe1.rs\n","exit_code":0,"status":"completed"}}
