{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/ws && cat > omnipaxos/tests/probe2.rs <<'RSEOF'\n// Local construction probe #2 (not the formal harness).\nuse std::cell::RefCell;\nuse std::collections::{HashMap, HashSet};\nuse std::rc::Rc;\n\nuse omnipaxos::{\n    ballot_leader_election::Ballot,\n    messages::{sequence_paxos::PaxosMsg, Message},\n    storage::{Entry, Snapshot, StopSign, Storage, StorageOp, StorageResult},\n    util::{LogEntry, NodeId},\n    ClusterConfig, OmniPaxos, OmniPaxosConfig, ServerConfig,\n};\nuse omnipaxos_storage::memory_storage::MemoryStorage;\n\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\npub struct TestEntry(pub u64);\n\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\npub struct NoSnapshot;\n\nimpl Snapshot<TestEntry> for NoSnapshot {\n    fn create(_e: &[TestEntry]) -> Self { NoSnapshot }\n    fn merge(&mut self, _d: Self) {}\n    fn use_snapshots() -> bool { false }\n}\nimpl Entry for TestEntry { type Snapshot = NoSnapshot; }\n\n#[derive(Clone)]\npub struct SharedStorage<T: Entry>(Rc<RefCell<MemoryStorage<T>>>);\nimpl<T: Entry> SharedStorage<T> { fn new() -> Self { SharedStorage(Rc::new(RefCell::new(MemoryStorage::default()))) } }\nimpl<T: Entry> Storage<T> for SharedStorage<T> {\n    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> { self.0.borrow_mut().write_atomically(ops) }\n    fn append_entry(&mut self, e: T) -> StorageResult<()> { self.0.borrow_mut().append_entry(e) }\n    fn append_entries(&mut self, e: Vec<T>) -> StorageResult<()> { self.0.borrow_mut().append_entries(e) }\n    fn append_on_prefix(&mut self, i: usize, e: Vec<T>) -> StorageResult<()> { self.0.borrow_mut().append_on_prefix(i, e) }\n    fn set_promise(&mut self, b: Ballot) -> StorageResult<()> { self.0.borrow_mut().set_promise(b) }\n    fn set_decided_idx(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().set_decided_idx(i) }\n    fn get_decided_idx(&self) -> StorageResult<usize> { self.0.borrow().get_decided_idx() }\n    fn set_accepted_round(&mut self, b: Ballot) -> StorageResult<()> { self.0.borrow_mut().set_accepted_round(b) }\n    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> { self.0.borrow().get_accepted_round() }\n    fn get_entries(&self, f: usize, t: usize) -> StorageResult<Vec<T>> { self.0.borrow().get_entries(f, t) }\n    fn get_log_len(&self) -> StorageResult<usize> { self.0.borrow().get_log_len() }\n    fn get_suffix(&self, f: usize) -> StorageResult<Vec<T>> { self.0.borrow().get_suffix(f) }\n    fn get_promise(&self) -> StorageResult<Option<Ballot>> { self.0.borrow().get_promise() }\n    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> { self.0.borrow_mut().set_stopsign(s) }\n    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> { self.0.borrow().get_stopsign() }\n    fn trim(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().trim(i) }\n    fn set_compacted_idx(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().set_compacted_idx(i) }\n    fn get_compacted_idx(&self) -> StorageResult<usize> { self.0.borrow().get_compacted_idx() }\n    fn set_snapshot(&mut self, s: Option<T::Snapshot>) -> StorageResult<()> { self.0.borrow_mut().set_snapshot(s) }\n    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> { self.0.borrow().get_snapshot() }\n}\n\ntype Op = OmniPaxos<TestEntry, SharedStorage<TestEntry>>;\n\nfn ev(kind: &str, fields: &str) { println\"'!(\"{{'\"\\\\\\\"ca_event\\\\\\\":\\\\\\\"{kind}\\\\\\\",{fields}}}\\\"); }\n\nstruct Cluster {\n    n: usize,\n    batch: usize,\n    ops: HashMap<NodeId, Op>,\n    stores: HashMap<NodeId, SharedStorage<TestEntry>>,\n    blocked: HashSet<NodeId>,\n    drop_kinds: HashSet<String>,\n    pub dropped: usize,\n    pub delivered: usize,\n}\n\nfn nodes_vec(n: usize) -> Vec<NodeId> { (1..=n as u64).collect() }\n\nfn build_op(pid: NodeId, nodes: Vec<NodeId>, batch_size: usize, store: SharedStorage<TestEntry>) -> Op {\n    let cluster_config = ClusterConfig { configuration_id: 1, nodes, flexible_quorum: None };\n    #[allow(clippy::needless_update)]\n    let server_config = ServerConfig {\n        pid,\n        election_tick_timeout: 2,\n        resend_message_tick_timeout: 4,\n        buffer_size: 10000,\n        batch_size,\n        flush_batch_tick_timeout: 1000, // deliberately long: batching must be driven by decisions/fills\n        leader_priority: 0,\n        ..Default::default()\n    };\n    OmniPaxosConfig { cluster_config, server_config }.build(store).unwrap()\n}\n\nfn kind_of(m: &Message<TestEntry>) -> String {\n    match m {\n        Message::SequencePaxos(p) => match &p.msg {\n            PaxosMsg::PrepareReq(_) => \\\"PrepareReq\\\", PaxosMsg::Prepare(_) => \\\"Prepare\\\",\n            PaxosMsg::Promise(_) => \\\"Promise\\\", PaxosMsg::AcceptSync(_) => \\\"AcceptSync\\\",\n            PaxosMsg::AcceptDecide(_) => \\\"AcceptDecide\\\", PaxosMsg::Accepted(_) => \\\"Accepted\\\",\n            PaxosMsg::NotAccepted(_) => \\\"NotAccepted\\\", PaxosMsg::Decide(_) => \\\"Decide\\\",\n            PaxosMsg::ProposalForward(_) => \\\"ProposalForward\\\", PaxosMsg::Compaction(_) => \\\"Compaction\\\",\n            PaxosMsg::AcceptStopSign(_) => \\\"AcceptStopSign\\\", PaxosMsg::ForwardStopSign(_) => \\\"ForwardStopSign\\\",\n        }.to_string(),\n        Message::BLE(_) => \\\"BLE\\\".to_string(),\n        #[allow(unreachable_patterns)]\n        _ => \\\"Other\\\".to_string(),\n    }\n}\n\nimpl Cluster {\n    fn new(n: usize, batch: usize) -> Self {\n        let nodes = nodes_vec(n);\n        let mut ops = HashMap::new();\n        let mut stores = HashMap::new();\n        for pid in nodes.clone() {\n            let store = SharedStorage::new();\n            stores.insert(pid, store.clone());\n            ops.insert(pid, build_op(pid, nodes.clone(), batch, store));\n        }\n        Cluster { n, batch, ops, stores, blocked: HashSet::new(), drop_kinds: HashSet::new(), dropped: 0, delivered: 0 }\n    }\n\n    fn alive(&self) -> Vec<NodeId> { let mut v: Vec<NodeId> = self.ops.keys().copied().collect(); v.sort(); v }\n\n    fn route(&mut self) {\n        let mut msgs: Vec<Message<TestEntry>> = Vec::new();\n        for op in self.ops.values_mut() {\n            let mut buf = Vec::new();\n            op.take_outgoing_messages(&mut buf);\n            msgs.extend(buf);\n        }\n        for m in msgs {\n            let to = m.get_receiver();\n            let from = m.get_sender();\n            if self.blocked.contains(&to) || self.blocked.contains(&from) || self.drop_kinds.contains(&kind_of(&m)) {\n                self.dropped += 1;\n                continue;\n            }\n            if let Some(op) = self.ops.get_mut(&to) { op.handle_incoming(m); self.delivered += 1; }\n            else { self.dropped += 1; }\n        }\n    }\n\n    fn step(&mut self) { self.route(); for op in self.ops.values_mut() { op.tick(); } self.route(); }\n    fn pump(&mut self, steps: usize) { for _ in 0..steps { self.step(); } }\n    fn pump_until<F: Fn(&Cluster) -> bool>(&mut self, steps: usize, cond: F) -> bool {\n        for _ in 0..steps { if cond(self) { return true; } self.step(); }\n        cond(self)\n    }\n\n    fn leader(&self) -> Option<NodeId> {\n        for (pid, op) in &self.ops { if let Some((l, true)) = op.get_current_leader() { if l == *pid { return Some(*pid); } } }\n        None\n    }\n\n    fn decided(&self, pid: NodeId) -> Vec<TestEntry> {\n        let op = &self.ops[&pid];\n        if op.get_decided_idx() == 0 { return vec\"'![]; }\n        op.read_decided_suffix(0).unwrap_or_default().into_iter().filter_map(|e| match e {\n            LogEntry::Decided(v) => Some(v), _ => None }).collect()\n    }\n\n    fn accepted_idx(&self, pid: NodeId) -> usize { self.ops[&pid].get_accepted_idx() }\n    fn decided_idx(&self, pid: NodeId) -> usize { self.ops[&pid].get_decided_idx() }\n    fn batched_len(&self, pid: NodeId) -> usize { self.ops[&pid].get_batched_len() }\n\n    fn append(&mut self, pid: NodeId, e: TestEntry) -> bool {\n        self.ops.get_mut(&pid).unwrap().append(e).is_ok()\n    }\n    fn crash(&mut self, pid: NodeId) { self.ops.remove(&pid); }\n    fn recover(&mut self, pid: NodeId) {\n        let store = self.stores[&pid].clone();\n        let (n, b) = (self.n, self.batch);\n        self.ops.insert(pid, build_op(pid, nodes_vec(n), b, store));\n    }\n}\n\nfn start_leader(c: &mut Cluster) -> NodeId {\n    assert!(c.pump_until(500, |c| c.leader().is_some()), \"no leader elected\");\n    c.leader().unwrap()\n}\n\n#[test]\nfn probe_batching_content_correct() {\n    // same values proposed on leader and a follower; every node must agree entry-by-entry.\n    let mut c = Cluster::new(3, 4);\n    let l = start_leader(&mut c);\n    let follower = *c.alive().iter().find(|p| **p != l).unwrap();\n    for i in 0..12u64 {\n        assert!(c.append(l, TestEntry(i)), \"append {i} on leader failed\");\n        assert!(c.append(follower, TestEntry(100 + i)), \"append {} on follower failed\", 100 + i);\n    }\n    let ok = c.pump_until(4000, |c| {\n        let idxs: Vec<usize> = c.alive().iter().map(|p| c.decided_idx(*p)).collect();\n        idxs.iter().all(|d| *d == 24)\n    });\n    for p in c.alive() { ev(\"node_state\", &format!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{},\\\\\\\"accepted\\\\\\\":{},\\\\\\\"batched\\\\\\\":{}\\\", c.decided_idx(p), c.accepted_idx(p), c.batched_len(p))); }\n    assert\"'!(ok, \"not all entries decided (24 expected)\");\n    let logs: Vec<(NodeId, Vec<TestEntry>)> = c.alive().iter().map(|p| (*p, c.decided(*p))).collect();\n    let (first_pid, first) = &logs[0];\n    for (pid, log) in &logs[1..] {\n        assert_eq!(log, first, \"node {pid} decided log differs from node {first_pid}\");\n    }\n    let mut vals: Vec<u64> = first.iter().map(|e| e.0).collect();\n    vals.sort();\n    let expect: Vec<u64> = (0..12u64).chain((100..112u64)).collect();\n    assert_eq!(vals, expect, \"decided values are not exactly the proposed ones\");\n}\n\n#[test]\nfn probe_dropped_acceptdecide_then_heal() {\n    // Drop all AcceptDecide traffic for a while; the resend machinery must repair the cluster.\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let expect: Vec<TestEntry> = (0..6).map(TestEntry).collect();\n    for e in &expect { assert!(c.append(l, e.clone())); }\n    c.drop_kinds.insert(\"AcceptDecide\".to_string());\n    c.pump(60);\n    ev(\"during_drop\", &format!(\"'\"\\\\\\\"leader_decided\\\\\\\":{},\\\\\\\"dropped\\\\\\\":{}\\\", c.decided_idx(l), c.dropped));\n    c.drop_kinds.clear();\n    let ok = c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    for p in c.alive() { ev(\\\"after_heal\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(p))); }\n    assert\"'!(ok, \"cluster did not heal after AcceptDecide drops; dropped={}\", c.dropped);\n}\n\n#[test]\nfn probe_partition_then_reconnect() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let victim = *c.alive().iter().find(|p| **p != l).unwrap();\n    let first: Vec<TestEntry> = (0..3).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"first batch not decided\");\n\n    // isolate the victim\n    c.blocked.insert(victim);\n    let second: Vec<TestEntry> = (10..18).map(TestEntry).collect();\n    for e in &second { assert!(c.append(l, e.clone())); }\n    let expect: Vec<TestEntry> = first.iter().chain(second.iter()).cloned().collect();\n    assert!(c.pump_until(2000, |c| c.decided_idx(l) >= expect.len()), \"leader stalled while victim isolated\");\n    ev(\"isolated\", &format!(\"'\"\\\\\\\"victim\\\\\\\":{victim},\\\\\\\"victim_decided\\\\\\\":{},\\\\\\\"leader_decided\\\\\\\":{}\\\", c.decided_idx(victim), c.decided_idx(l)));\n\n    // heal the partition and tell the victim (and leader) the connection is back\n    c.blocked.remove(&victim);\n    c.ops.get_mut(&victim).unwrap().reconnected(l);\n    c.ops.get_mut(&l).unwrap().reconnected(victim);\n    let ok = c.pump_until(3000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    for p in c.alive() { ev(\\\"after_reconnect\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(p))); }\n    assert\"'!(ok, \"victim did not catch up after reconnect; victim decided {} of {}\", c.decided_idx(victim), expect.len());\n}\n\n#[test]\nfn probe_trim_and_read() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..4).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"prefix not decided\");\n    let res = c.ops.get_mut(&l).unwrap().trim(Some(3));\n    ev(\"trim\", &format!(\"'\"\\\\\\\"result\\\\\\\":{:?},\\\\\\\"compacted\\\\\\\":{}\\\", res.is_ok(), c.ops[&l].get_compacted_idx()));\n    let r0 = c.ops[&l].read(0);\n    ev(\\\"read_trimmed_idx\\\", &format\"'!(\"'\"\\\\\\\"entry\\\\\\\":{:?}\\\", r0));\n    let second: Vec<TestEntry> = (20..24).map(TestEntry).collect();\n    for e in &second { assert\"'!(c.append(l, e.clone())); }\n    let expect: Vec<TestEntry> = first.iter().chain(second.iter()).cloned().collect();\n    let ok = c.pump_until(3000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    assert!(ok, \"cluster diverged after trim\");\n    assert!(r0.is_some(), \"read of a trimmed index returned None\");\n}\n\n#[test]\nfn probe_stopsign_with_follower_down() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..3).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"prefix not decided\");\n    let down = *c.alive().iter().find(|p| **p != l).unwrap();\n    c.crash(down);\n    let new_cfg = ClusterConfig { configuration_id: 2, nodes: vec![1, 2, 3], flexible_quorum: None };\n    assert!(c.ops.get_mut(&l).unwrap().reconfigure(new_cfg, None).is_ok());\n    let stopped = c.pump_until(3000, |c| c.op_reconf(l));\n    ev(\"leader_stopped\", &format!(\"'\"\\\\\\\"stopped\\\\\\\":{stopped},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(l)));\n    c.recover(down);\n    let ok = c.pump_until(4000, |c| c.op_reconf(l) && c.op_reconf(down) && c.decided_idx(down) >= c.decided_idx(l));\n    for p in c.alive() { ev(\\\"reconf_state\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"reconf\\\\\\\":{},\\\\\\\"decided\\\\\\\":{}\\\", c.op_reconf(p), c.decided_idx(p))); }\n    assert\"'!(ok, \"crashed follower did not learn the decided stopsign\");\n}\n\nimpl Cluster {\n    fn op_reconf(&self, pid: NodeId) -> bool { self.ops[&pid].is_reconfigured().is_some() }\n}\nRSEOF\nCARGO_TARGET_DIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/target timeout 600 cargo test --offline --locked -p omnipaxos --features async_runtime,serde,logging,macros --test probe2 -- --test-threads=1 2>&1 | grep -v \"''^Oct'\"\\\\|INFO\\\\|warning: profiles\\\\|\"'^package:'\"\\\\|\"'^workspace:\" | tail -40'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/ws && cat > omnipaxos/tests/probe2.rs <<'RSEOF'\n// Local construction probe #2 (not the formal harness).\nuse std::cell::RefCell;\nuse std::collections::{HashMap, HashSet};\nuse std::rc::Rc;\n\nuse omnipaxos::{\n    ballot_leader_election::Ballot,\n    messages::{sequence_paxos::PaxosMsg, Message},\n    storage::{Entry, Snapshot, StopSign, Storage, StorageOp, StorageResult},\n    util::{LogEntry, NodeId},\n    ClusterConfig, OmniPaxos, OmniPaxosConfig, ServerConfig,\n};\nuse omnipaxos_storage::memory_storage::MemoryStorage;\n\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\npub struct TestEntry(pub u64);\n\n#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]\npub struct NoSnapshot;\n\nimpl Snapshot<TestEntry> for NoSnapshot {\n    fn create(_e: &[TestEntry]) -> Self { NoSnapshot }\n    fn merge(&mut self, _d: Self) {}\n    fn use_snapshots() -> bool { false }\n}\nimpl Entry for TestEntry { type Snapshot = NoSnapshot; }\n\n#[derive(Clone)]\npub struct SharedStorage<T: Entry>(Rc<RefCell<MemoryStorage<T>>>);\nimpl<T: Entry> SharedStorage<T> { fn new() -> Self { SharedStorage(Rc::new(RefCell::new(MemoryStorage::default()))) } }\nimpl<T: Entry> Storage<T> for SharedStorage<T> {\n    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> { self.0.borrow_mut().write_atomically(ops) }\n    fn append_entry(&mut self, e: T) -> StorageResult<()> { self.0.borrow_mut().append_entry(e) }\n    fn append_entries(&mut self, e: Vec<T>) -> StorageResult<()> { self.0.borrow_mut().append_entries(e) }\n    fn append_on_prefix(&mut self, i: usize, e: Vec<T>) -> StorageResult<()> { self.0.borrow_mut().append_on_prefix(i, e) }\n    fn set_promise(&mut self, b: Ballot) -> StorageResult<()> { self.0.borrow_mut().set_promise(b) }\n    fn set_decided_idx(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().set_decided_idx(i) }\n    fn get_decided_idx(&self) -> StorageResult<usize> { self.0.borrow().get_decided_idx() }\n    fn set_accepted_round(&mut self, b: Ballot) -> StorageResult<()> { self.0.borrow_mut().set_accepted_round(b) }\n    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> { self.0.borrow().get_accepted_round() }\n    fn get_entries(&self, f: usize, t: usize) -> StorageResult<Vec<T>> { self.0.borrow().get_entries(f, t) }\n    fn get_log_len(&self) -> StorageResult<usize> { self.0.borrow().get_log_len() }\n    fn get_suffix(&self, f: usize) -> StorageResult<Vec<T>> { self.0.borrow().get_suffix(f) }\n    fn get_promise(&self) -> StorageResult<Option<Ballot>> { self.0.borrow().get_promise() }\n    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> { self.0.borrow_mut().set_stopsign(s) }\n    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> { self.0.borrow().get_stopsign() }\n    fn trim(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().trim(i) }\n    fn set_compacted_idx(&mut self, i: usize) -> StorageResult<()> { self.0.borrow_mut().set_compacted_idx(i) }\n    fn get_compacted_idx(&self) -> StorageResult<usize> { self.0.borrow().get_compacted_idx() }\n    fn set_snapshot(&mut self, s: Option<T::Snapshot>) -> StorageResult<()> { self.0.borrow_mut().set_snapshot(s) }\n    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> { self.0.borrow().get_snapshot() }\n}\n\ntype Op = OmniPaxos<TestEntry, SharedStorage<TestEntry>>;\n\nfn ev(kind: &str, fields: &str) { println\"'!(\"{{'\"\\\\\\\"ca_event\\\\\\\":\\\\\\\"{kind}\\\\\\\",{fields}}}\\\"); }\n\nstruct Cluster {\n    n: usize,\n    batch: usize,\n    ops: HashMap<NodeId, Op>,\n    stores: HashMap<NodeId, SharedStorage<TestEntry>>,\n    blocked: HashSet<NodeId>,\n    drop_kinds: HashSet<String>,\n    pub dropped: usize,\n    pub delivered: usize,\n}\n\nfn nodes_vec(n: usize) -> Vec<NodeId> { (1..=n as u64).collect() }\n\nfn build_op(pid: NodeId, nodes: Vec<NodeId>, batch_size: usize, store: SharedStorage<TestEntry>) -> Op {\n    let cluster_config = ClusterConfig { configuration_id: 1, nodes, flexible_quorum: None };\n    #[allow(clippy::needless_update)]\n    let server_config = ServerConfig {\n        pid,\n        election_tick_timeout: 2,\n        resend_message_tick_timeout: 4,\n        buffer_size: 10000,\n        batch_size,\n        flush_batch_tick_timeout: 1000, // deliberately long: batching must be driven by decisions/fills\n        leader_priority: 0,\n        ..Default::default()\n    };\n    OmniPaxosConfig { cluster_config, server_config }.build(store).unwrap()\n}\n\nfn kind_of(m: &Message<TestEntry>) -> String {\n    match m {\n        Message::SequencePaxos(p) => match &p.msg {\n            PaxosMsg::PrepareReq(_) => \\\"PrepareReq\\\", PaxosMsg::Prepare(_) => \\\"Prepare\\\",\n            PaxosMsg::Promise(_) => \\\"Promise\\\", PaxosMsg::AcceptSync(_) => \\\"AcceptSync\\\",\n            PaxosMsg::AcceptDecide(_) => \\\"AcceptDecide\\\", PaxosMsg::Accepted(_) => \\\"Accepted\\\",\n            PaxosMsg::NotAccepted(_) => \\\"NotAccepted\\\", PaxosMsg::Decide(_) => \\\"Decide\\\",\n            PaxosMsg::ProposalForward(_) => \\\"ProposalForward\\\", PaxosMsg::Compaction(_) => \\\"Compaction\\\",\n            PaxosMsg::AcceptStopSign(_) => \\\"AcceptStopSign\\\", PaxosMsg::ForwardStopSign(_) => \\\"ForwardStopSign\\\",\n        }.to_string(),\n        Message::BLE(_) => \\\"BLE\\\".to_string(),\n        #[allow(unreachable_patterns)]\n        _ => \\\"Other\\\".to_string(),\n    }\n}\n\nimpl Cluster {\n    fn new(n: usize, batch: usize) -> Self {\n        let nodes = nodes_vec(n);\n        let mut ops = HashMap::new();\n        let mut stores = HashMap::new();\n        for pid in nodes.clone() {\n            let store = SharedStorage::new();\n            stores.insert(pid, store.clone());\n            ops.insert(pid, build_op(pid, nodes.clone(), batch, store));\n        }\n        Cluster { n, batch, ops, stores, blocked: HashSet::new(), drop_kinds: HashSet::new(), dropped: 0, delivered: 0 }\n    }\n\n    fn alive(&self) -> Vec<NodeId> { let mut v: Vec<NodeId> = self.ops.keys().copied().collect(); v.sort(); v }\n\n    fn route(&mut self) {\n        let mut msgs: Vec<Message<TestEntry>> = Vec::new();\n        for op in self.ops.values_mut() {\n            let mut buf = Vec::new();\n            op.take_outgoing_messages(&mut buf);\n            msgs.extend(buf);\n        }\n        for m in msgs {\n            let to = m.get_receiver();\n            let from = m.get_sender();\n            if self.blocked.contains(&to) || self.blocked.contains(&from) || self.drop_kinds.contains(&kind_of(&m)) {\n                self.dropped += 1;\n                continue;\n            }\n            if let Some(op) = self.ops.get_mut(&to) { op.handle_incoming(m); self.delivered += 1; }\n            else { self.dropped += 1; }\n        }\n    }\n\n    fn step(&mut self) { self.route(); for op in self.ops.values_mut() { op.tick(); } self.route(); }\n    fn pump(&mut self, steps: usize) { for _ in 0..steps { self.step(); } }\n    fn pump_until<F: Fn(&Cluster) -> bool>(&mut self, steps: usize, cond: F) -> bool {\n        for _ in 0..steps { if cond(self) { return true; } self.step(); }\n        cond(self)\n    }\n\n    fn leader(&self) -> Option<NodeId> {\n        for (pid, op) in &self.ops { if let Some((l, true)) = op.get_current_leader() { if l == *pid { return Some(*pid); } } }\n        None\n    }\n\n    fn decided(&self, pid: NodeId) -> Vec<TestEntry> {\n        let op = &self.ops[&pid];\n        if op.get_decided_idx() == 0 { return vec\"'![]; }\n        op.read_decided_suffix(0).unwrap_or_default().into_iter().filter_map(|e| match e {\n            LogEntry::Decided(v) => Some(v), _ => None }).collect()\n    }\n\n    fn accepted_idx(&self, pid: NodeId) -> usize { self.ops[&pid].get_accepted_idx() }\n    fn decided_idx(&self, pid: NodeId) -> usize { self.ops[&pid].get_decided_idx() }\n    fn batched_len(&self, pid: NodeId) -> usize { self.ops[&pid].get_batched_len() }\n\n    fn append(&mut self, pid: NodeId, e: TestEntry) -> bool {\n        self.ops.get_mut(&pid).unwrap().append(e).is_ok()\n    }\n    fn crash(&mut self, pid: NodeId) { self.ops.remove(&pid); }\n    fn recover(&mut self, pid: NodeId) {\n        let store = self.stores[&pid].clone();\n        let (n, b) = (self.n, self.batch);\n        self.ops.insert(pid, build_op(pid, nodes_vec(n), b, store));\n    }\n}\n\nfn start_leader(c: &mut Cluster) -> NodeId {\n    assert!(c.pump_until(500, |c| c.leader().is_some()), \"no leader elected\");\n    c.leader().unwrap()\n}\n\n#[test]\nfn probe_batching_content_correct() {\n    // same values proposed on leader and a follower; every node must agree entry-by-entry.\n    let mut c = Cluster::new(3, 4);\n    let l = start_leader(&mut c);\n    let follower = *c.alive().iter().find(|p| **p != l).unwrap();\n    for i in 0..12u64 {\n        assert!(c.append(l, TestEntry(i)), \"append {i} on leader failed\");\n        assert!(c.append(follower, TestEntry(100 + i)), \"append {} on follower failed\", 100 + i);\n    }\n    let ok = c.pump_until(4000, |c| {\n        let idxs: Vec<usize> = c.alive().iter().map(|p| c.decided_idx(*p)).collect();\n        idxs.iter().all(|d| *d == 24)\n    });\n    for p in c.alive() { ev(\"node_state\", &format!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{},\\\\\\\"accepted\\\\\\\":{},\\\\\\\"batched\\\\\\\":{}\\\", c.decided_idx(p), c.accepted_idx(p), c.batched_len(p))); }\n    assert\"'!(ok, \"not all entries decided (24 expected)\");\n    let logs: Vec<(NodeId, Vec<TestEntry>)> = c.alive().iter().map(|p| (*p, c.decided(*p))).collect();\n    let (first_pid, first) = &logs[0];\n    for (pid, log) in &logs[1..] {\n        assert_eq!(log, first, \"node {pid} decided log differs from node {first_pid}\");\n    }\n    let mut vals: Vec<u64> = first.iter().map(|e| e.0).collect();\n    vals.sort();\n    let expect: Vec<u64> = (0..12u64).chain((100..112u64)).collect();\n    assert_eq!(vals, expect, \"decided values are not exactly the proposed ones\");\n}\n\n#[test]\nfn probe_dropped_acceptdecide_then_heal() {\n    // Drop all AcceptDecide traffic for a while; the resend machinery must repair the cluster.\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let expect: Vec<TestEntry> = (0..6).map(TestEntry).collect();\n    for e in &expect { assert!(c.append(l, e.clone())); }\n    c.drop_kinds.insert(\"AcceptDecide\".to_string());\n    c.pump(60);\n    ev(\"during_drop\", &format!(\"'\"\\\\\\\"leader_decided\\\\\\\":{},\\\\\\\"dropped\\\\\\\":{}\\\", c.decided_idx(l), c.dropped));\n    c.drop_kinds.clear();\n    let ok = c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    for p in c.alive() { ev(\\\"after_heal\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(p))); }\n    assert\"'!(ok, \"cluster did not heal after AcceptDecide drops; dropped={}\", c.dropped);\n}\n\n#[test]\nfn probe_partition_then_reconnect() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let victim = *c.alive().iter().find(|p| **p != l).unwrap();\n    let first: Vec<TestEntry> = (0..3).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"first batch not decided\");\n\n    // isolate the victim\n    c.blocked.insert(victim);\n    let second: Vec<TestEntry> = (10..18).map(TestEntry).collect();\n    for e in &second { assert!(c.append(l, e.clone())); }\n    let expect: Vec<TestEntry> = first.iter().chain(second.iter()).cloned().collect();\n    assert!(c.pump_until(2000, |c| c.decided_idx(l) >= expect.len()), \"leader stalled while victim isolated\");\n    ev(\"isolated\", &format!(\"'\"\\\\\\\"victim\\\\\\\":{victim},\\\\\\\"victim_decided\\\\\\\":{},\\\\\\\"leader_decided\\\\\\\":{}\\\", c.decided_idx(victim), c.decided_idx(l)));\n\n    // heal the partition and tell the victim (and leader) the connection is back\n    c.blocked.remove(&victim);\n    c.ops.get_mut(&victim).unwrap().reconnected(l);\n    c.ops.get_mut(&l).unwrap().reconnected(victim);\n    let ok = c.pump_until(3000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    for p in c.alive() { ev(\\\"after_reconnect\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(p))); }\n    assert\"'!(ok, \"victim did not catch up after reconnect; victim decided {} of {}\", c.decided_idx(victim), expect.len());\n}\n\n#[test]\nfn probe_trim_and_read() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..4).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"prefix not decided\");\n    let res = c.ops.get_mut(&l).unwrap().trim(Some(3));\n    ev(\"trim\", &format!(\"'\"\\\\\\\"result\\\\\\\":{:?},\\\\\\\"compacted\\\\\\\":{}\\\", res.is_ok(), c.ops[&l].get_compacted_idx()));\n    let r0 = c.ops[&l].read(0);\n    ev(\\\"read_trimmed_idx\\\", &format\"'!(\"'\"\\\\\\\"entry\\\\\\\":{:?}\\\", r0));\n    let second: Vec<TestEntry> = (20..24).map(TestEntry).collect();\n    for e in &second { assert\"'!(c.append(l, e.clone())); }\n    let expect: Vec<TestEntry> = first.iter().chain(second.iter()).cloned().collect();\n    let ok = c.pump_until(3000, |c| c.alive().iter().all(|p| c.decided(*p) == expect));\n    assert!(ok, \"cluster diverged after trim\");\n    assert!(r0.is_some(), \"read of a trimmed index returned None\");\n}\n\n#[test]\nfn probe_stopsign_with_follower_down() {\n    let mut c = Cluster::new(3, 1);\n    let l = start_leader(&mut c);\n    let first: Vec<TestEntry> = (0..3).map(TestEntry).collect();\n    for e in &first { assert!(c.append(l, e.clone())); }\n    assert!(c.pump_until(2000, |c| c.alive().iter().all(|p| c.decided(*p) == first)), \"prefix not decided\");\n    let down = *c.alive().iter().find(|p| **p != l).unwrap();\n    c.crash(down);\n    let new_cfg = ClusterConfig { configuration_id: 2, nodes: vec![1, 2, 3], flexible_quorum: None };\n    assert!(c.ops.get_mut(&l).unwrap().reconfigure(new_cfg, None).is_ok());\n    let stopped = c.pump_until(3000, |c| c.op_reconf(l));\n    ev(\"leader_stopped\", &format!(\"'\"\\\\\\\"stopped\\\\\\\":{stopped},\\\\\\\"decided\\\\\\\":{}\\\", c.decided_idx(l)));\n    c.recover(down);\n    let ok = c.pump_until(4000, |c| c.op_reconf(l) && c.op_reconf(down) && c.decided_idx(down) >= c.decided_idx(l));\n    for p in c.alive() { ev(\\\"reconf_state\\\", &format\"'!(\"'\"\\\\\\\"node\\\\\\\":{p},\\\\\\\"reconf\\\\\\\":{},\\\\\\\"decided\\\\\\\":{}\\\", c.op_reconf(p), c.decided_idx(p))); }\n    assert\"'!(ok, \"crashed follower did not learn the decided stopsign\");\n}\n\nimpl Cluster {\n    fn op_reconf(&self, pid: NodeId) -> bool { self.ops[&pid].is_reconfigured().is_some() }\n}\nRSEOF\nCARGO_TARGET_DIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft/tmp/target timeout 600 cargo test --offline --locked -p omnipaxos --features async_runtime,serde,logging,macros --test probe2 -- --test-threads=1 2>&1 | grep -v \"''^Oct'\"\\\\|INFO\\\\|warning: profiles\\\\|\"'^package:'\"\\\\|\"'^workspace:\" | tail -40'","aggregated_output":"    Finished `test` profile [unoptimized + debuginfo] target(s) in 3.19s\nwarning: the following packages contain code that will be rejected by a future version of Rust: nom v4.2.3\nnote: to see what the problems were, use the option `--future-incompat-report`, or run `cargo report future-incompatibilities --id 1`\n     Running tests/probe2.rs (/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real