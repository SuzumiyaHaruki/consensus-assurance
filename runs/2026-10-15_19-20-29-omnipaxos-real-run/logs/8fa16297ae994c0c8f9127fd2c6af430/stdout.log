{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_19-20-29-omnipaxos-real-run/draft && sed -n 175,200p assurance_gap.rs && echo \"=== tail\" && sed -n 280,290p assurance_gap.rs'","aggregated_output":"    .expect(\"failed to build OmniPaxos instance\")\n}\n\nfn from_leader<T: Entry>(to: NodeId, msg: PaxosMsg<T>) -> Message<T> {\n    Message::SequencePaxos(PaxosMessage { from: 1, to, msg })\n}\n\nfn scenario<T: Entry, F: Fn(u64) -> T>(case: &str, snapshots: bool, outcome_event: &str, mk: F) {\n    // The responder is node 2; node 1 stands in for the leader that is still running the same\n    // prefix of traffic a real leader produces.\n    let store = SharedStorage::new();\n    let mut op: OmniPaxos<T, SharedStorage<T>> = build(2, store);\n    let leader_ballot = Ballot::with(1, 1, 0, 1);\n    let stale_ballot = Ballot::with(1, 2, 0, 1);\n    let no_round = Ballot::default(); // older than the round the responder will accept under\n\n    emit(\n        \"case_started\",\n        json!({ \"case\": case, \"use_snapshots\": snapshots, \"responder\": 2 }),\n    );\n\n    // (1) leader prepares; responder promises at ballot (1,1,pid 1)\n    op.handle_incoming(from_leader(\n        2,\n        PaxosMsg::Prepare(Prepare {\n            n: leader_ballot,\n=== tail\n        }\n    }\n}\n\n#[test]\nfn below_compaction_request_with_and_without_snapshots() {\n    scenario(\"nosnapshot_entry\", false, \"log_sync_outcome_nosnapshot\", NoSnapEntry);\n    scenario(\"snapshot_entry\", true, \"log_sync_outcome_snapshot\", SnapEntry);\n}\n","exit_code":0,"status":"completed"}}
