\": [], \"bounded_complete\": true, \"record\": {\"path\": \"state.json\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"e365efbbde80420bb1b1730a6c13d88a\", \"claim_id\": \"C_stale_append_completion\"}}}, {\"claim_id\": \"C_read_gate_release\", \"direct_check_id\": \"7070fcb671194b56a2bec567ad3cbbec\", \"experiment_check_id\": \"2284c9d8090d41c2ac17fad09fa44650\", \"confirmed\": false, \"outcome\": \"violated\", \"blockers\": [\"Direct oracle correspondence is unreviewed\", \"S_raw_advance_contract describes Advance as applied-and-saved, whereas S_early_advance_usage and S_node_advance_order permit Advance before application finishes. The scope adopts the explicit optimization permission and keeps this documentation tension visible.\", \"RawNode.Advance describes applied-and-saved completion. The check adopts the explicit Node/package early-Advance optimization; if a stricter configuration-specific ordering is required, this prefix is excluded.\"], \"bounded_complete\": true, \"record\": {\"path\": \"state.json\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"2284c9d8090d41c2ac17fad09fa44650\", \"claim_id\": \"C_read_gate_release\"}}}]\nreview_issues []\nreview_contracts [{\"target_id\": \"017cd81f455948f2a0d0832a53e904e6\", \"object_type\": \"direct_check\", \"version\": 1, \"required_aspects\": [\"checker_correspondence\"], \"optional_aspects\": [\"applicability\", \"decomposition\"]}, {\"target_id\": \"7070fcb671194b56a2bec567ad3cbbec\", \"object_type\": \"direct_check\", \"version\": 1, \"required_aspects\": [\"checker_correspondence\"], \"optional_aspects\": [\"applicability\", \"decomposition\"]}]\ncurrent {\"phase\": \"executed\", \"operation_id\": \"ca94290bb11e4544b6352cffa8a6243c\", \"action\": \"check\", \"direct_check_id\": \"7070fcb671194b56a2bec567ad3cbbec\"}\nlatest handoff {\"operation_id\": \"ca94290bb11e4544b6352cffa8a6243c\", \"action\": \"check\", \"candidate_ids\": [], \"answered_preview\": \"Built the fixed checker for the accepted Unit. The actual request context identifies both its retained state and later Ready result. Admission is configuration activation after a demonstrated pre-commit queue entry; the oracle only asks whe\\u2026\", \"ref_ids\": [\"cfa40e9c46064645aa6322f0a0286660\", \"S_pending_read_purpose\", \"S_early_advance_usage\", \"S_node_advance_order\", \"S_raw_advance_contract\", \"S_read_api_contract\", \"S_membership\", \"S_read_release\"], \"record\": {\"path\": \"state.json\", \"collection\": \"selections\", \"match\": {\"operation_id\": \"ca94290bb11e4544b6352cffa8a6243c\"}}, \"feedback\": {\"ref_ids\": [\"cfa40e9c46064645aa6322f0a0286660\", \"S_pending_read_purpose\", \"S_early_advance_usage\", \"S_node_advance_order\", \"S_raw_advance_contract\", \"S_read_api_contract\", \"S_membership\", \"S_read_release\"], \"answered\": \"Built the fixed checker for the accepted Unit. The actual request context identifies both its retained state and later Ready result. Admission is configuration activation after a demonstrated pre-commit queue entry; the oracle only asks whether that entry still occupies the pre-commit queue after the prerequisite is satisfied and emitted work is processed. Local construction completed, but no formal finding is inferred.\", \"remaining\": [\"Trusted execution and correspondence/applicability review of the fixed checker.\", \"Preserve early-Advance contract interpretation and public loss allowance when deciding the scope of any measured discrepancy.\"], \"understanding\": \"unchanged\", \"rationale\": \"Continue the existing Candidate/Unit from handoff e0ecf66107184976a84634f67fe70be6; no requirement change or new scenario is introduced. The discriminator targets the queue lifecycle, and the same history later observes the original request complete.\", \"question_updates\": {}}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/ca94290bb11e4544b6352cffa8a6243c/assurance_generated_test.go\npython3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/ca94290bb11e4544b6352cffa8a6243c/plan.json'));p['harness'].pop('source');print(json.dumps({k:p[k] for k in ['claim_id','monitors','observable_properties']},indent=2))\ns=json.load(open('../state.json'))\nc=next(x for x in s['checks'] if x['id']=='2284c9d8090d41c2ac17fad09fa44650');print('run',c['status'],c['exit_code'])\nfor l in open(c['stdout']):\n x=json.loads(l)\n if 'CA_EVENT' in x.get('Output',''):print(x['Output'],end='')\nfor x in s['monitor_results']:\n if x['experiment_check_id']==c['id']: print('results',json.dumps(x['properties']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/ca94290bb11e4544b6352cffa8a6243c/assurance_generated_test.go\npython3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/ca94290bb11e4544b6352cffa8a6243c/plan.json'));p['harness'].pop('source');print(json.dumps({k:p[k] for k in ['claim_id','monitors','observable_properties']},indent=2))\ns=json.load(open('../state.json'))\nc=next(x for x in s['checks'] if x['id']=='2284c9d8090d41c2ac17fad09fa44650');print('run',c['status'],c['exit_code'])\nfor l in open(c['stdout']):\n x=json.loads(l)\n if 'CA_EVENT' in x.get('Output',''):print(x['Output'],end='')\nfor x in s['monitor_results']:\n if x['experiment_check_id']==c['id']: print('results',json.dumps(x['properties']))\nPY\"","aggregated_output":"package raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\tpb \"go.etcd.io/raft/v3/raftpb\"\n\t\"testing\"\n)\n\ntype caSyncPeer struct {\n\trn          *RawNode\n\tms          *MemoryStorage\n\tdelayed     []pb.Entry\n\tdelayConfig bool\n\treads       []ReadState\n}\ntype caSyncNet struct {\n\tt    *testing.T\n\tp    map[uint64]*caSyncPeer\n\tnet  []pb.Message\n\thold func(pb.Message) bool\n}\n\nfunc caExploreEvent(stage string, fields map[string]interface{}) {\n\tfields[\"event\"] = \"read_gate_\" + stage\n\tfields[\"operation\"] = \"configuration-first-commit\"\n\tfields[\"request_context\"] = \"waiting-before-config\"\n\tfields[\"stage\"] = stage\n\tb, e := json.Marshal(fields)\n\tif e != nil {\n\t\tpanic(e)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(b))\n}\nfunc (n *caSyncNet) conf(p *caSyncPeer, e pb.Entry) {\n\tswitch e.Type {\n\tcase pb.EntryConfChange:\n\t\tvar cc pb.ConfChange\n\t\tif err := cc.Unmarshal(e.Data); err != nil {\n\t\t\tn.t.Fatal(err)\n\t\t}\n\t\tp.rn.ApplyConfChange(cc)\n\tcase pb.EntryConfChangeV2:\n\t\tvar cc pb.ConfChangeV2\n\t\tif err := cc.Unmarshal(e.Data); err != nil {\n\t\t\tn.t.Fatal(err)\n\t\t}\n\t\tp.rn.ApplyConfChange(cc)\n\t}\n}\nfunc (n *caSyncNet) collect(id uint64) bool {\n\tp := n.p[id]\n\tif !p.rn.HasReady() {\n\t\treturn false\n\t}\n\trd := p.rn.Ready()\n\tif !IsEmptySnap(rd.Snapshot) {\n\t\tn.t.Fatal(\"snapshot outside exploration scope\")\n\t}\n\tif err := p.ms.Append(rd.Entries); err != nil {\n\t\tn.t.Fatal(err)\n\t}\n\tif !IsEmptyHardState(rd.HardState) {\n\t\tif err := p.ms.SetHardState(rd.HardState); err != nil {\n\t\t\tn.t.Fatal(err)\n\t\t}\n\t}\n\tfor _, e := range rd.CommittedEntries {\n\t\tif e.Type == pb.EntryConfChange || e.Type == pb.EntryConfChangeV2 {\n\t\t\tif p.delayConfig {\n\t\t\t\tp.delayed = append(p.delayed, e)\n\t\t\t} else {\n\t\t\t\tn.conf(p, e)\n\t\t\t}\n\t\t} else if len(p.delayed) > 0 {\n\t\t\tn.t.Fatal(\"later entry applied before delayed configuration\")\n\t\t}\n\t}\n\tp.reads = append(p.reads, rd.ReadStates...)\n\tn.net = append(n.net, rd.Messages...)\n\t// This is the explicit applicability question: Node documents an early\n\t// Advance optimization; RawNode's own comment says applied and saved.\n\t// The delayed configuration is completed before any later entry is applied.\n\tp.rn.Advance(rd)\n\treturn true\n}\nfunc (n *caSyncNet) drain() {\n\tfor turn := 0; turn < 2000; turn++ {\n\t\twork := false\n\t\tfor id := uint64(1); id <= 4; id++ {\n\t\t\tif n.collect(id) {\n\t\t\t\twork = true\n\t\t\t}\n\t\t}\n\t\tfor i, m := range n.net {\n\t\t\tif n.hold != nil && n.hold(m) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tn.net = append(n.net[:i], n.net[i+1:]...)\n\t\t\tif err := n.p[m.To].rn.Step(m); err != nil && err != ErrStepPeerNotFound {\n\t\t\t\tn.t.Fatal(err)\n\t\t\t}\n\t\t\twork = true\n\t\t\tbreak\n\t\t}\n\t\tif !work {\n\t\t\treturn\n\t\t}\n\t}\n\tn.t.Fatal(\"exploration scheduler budget exhausted\")\n}\nfunc (p *caSyncPeer) count(ctx string) int {\n\tv := 0\n\tfor _, s := range p.reads {\n\t\tif string(s.RequestCtx) == ctx {\n\t\t\tv++\n\t\t}\n\t}\n\treturn v\n}\nfunc (p *caSyncPeer) waiting(ctx string) bool {\n\tfor _, m := range p.rn.raft.pendingReadIndexMessages {\n\t\tif len(m.Entries) == 1 && string(m.Entries[0].Data) == ctx {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\nfunc (p *caSyncPeer) currentCommit() bool {\n\tterm, err := p.rn.raft.raftLog.term(p.rn.raft.raftLog.committed)\n\treturn err == nil && term == p.rn.raft.Term\n}\nfunc TestAssuranceReadGateRelease(t *testing.T) {\n\tn := &caSyncNet{t: t, p: map[uint64]*caSyncPeer{}}\n\tfor id := uint64(1); id <= 4; id++ {\n\t\tms := NewMemoryStorage()\n\t\trn, err := NewRawNode(&Config{ID: id, ElectionTick: 10, HeartbeatTick: 1, Storage: ms, MaxSizePerMsg: 1 << 20, MaxInflightMsgs: 16})\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tn.p[id] = &caSyncPeer{rn: rn, ms: ms}\n\t\tif err := rn.Bootstrap([]Peer{{ID: 1}, {ID: 2}, {ID: 3}, {ID: 4}}); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tn.drain()\n\tif err := n.p[1].rn.Campaign(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tn.drain()\n\tp := n.p[2]\n\tp.delayConfig = true\n\tcc := pb.ConfChange{Type: pb.ConfChangeRemoveNode, NodeID: 4}\n\tif err := n.p[1].rn.ProposeConfChange(cc); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tn.drain()\n\tif len(p.delayed) != 1 {\n\t\tt.Fatalf(\"missing delayed committed configuration: %d\", len(p.delayed))\n\t}\n\tcaExploreEvent(\"early_advance\", map[string]interface{}{\"node\": 2, \"delayed_config_index\": p.delayed[0].Index, \"applied\": p.rn.raft.raftLog.applied, \"committed\": p.rn.raft.raftLog.committed, \"voters\": p.rn.raft.trk.VoterNodes()})\n\t// Delay the old leader and current-term replication to the removed voter.\n\t// Vote messages to that voter are still allowed by node 2's old membership.\n\tn.hold = func(m pb.Message) bool { return m.From == 1 || m.To == 1 || (m.Type == pb.MsgApp && m.To == 4) }\n\tif err := p.rn.Campaign(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tn.drain()\n\tif p.rn.raft.state != StateLeader {\n\t\tt.Fatal(\"target did not become leader\")\n\t}\n\tbefore := p.rn.raft.raftLog.committed\n\tp.rn.ReadIndex([]byte(\"waiting-before-config\"))\n\tn.drain()\n\tcaExploreEvent(\"before_activation\", map[string]interface{}{\"node\": 2, \"term\": p.rn.raft.Term, \"committed\": before, \"last_index\": p.rn.raft.raftLog.lastIndex(), \"pending_request\": p.waiting(\"waiting-before-config\"), \"current_term_committed\": p.currentCommit(), \"pending_reads\": len(p.rn.raft.pendingReadIndexMessages), \"old_read_results\": p.count(\"waiting-before-config\"), \"match_self\": p.rn.raft.trk.Progress[2].Match, \"match_peer3\": p.rn.raft.trk.Progress[3].Match})\n\tfor _, e := range p.delayed {\n\t\tn.conf(p, e)\n\t}\n\tp.delayed = nil\n\tp.delayConfig = false\n\tcaExploreEvent(\"activation\", map[string]interface{}{\"node\": 2, \"term\": p.rn.raft.Term, \"prior_commit\": before, \"committed\": p.rn.raft.raftLog.committed, \"current_term_committed\": p.currentCommit(), \"voters\": p.rn.raft.trk.VoterNodes()})\n\tn.hold = nil\n\tn.drain()\n\tfor i := 0; i < 3; i++ {\n\t\tp.rn.Tick()\n\t\tn.drain()\n\t}\n\tp.rn.ReadIndex([]byte(\"fresh-after-config\"))\n\tn.drain()\n\tcaExploreEvent(\"gate_observed\", map[string]interface{}{\"node\": 2, \"term\": p.rn.raft.Term, \"current_term_committed\": p.currentCommit(), \"pending_request\": p.waiting(\"waiting-before-config\"), \"committed\": p.rn.raft.raftLog.committed, \"pending_reads\": len(p.rn.raft.pendingReadIndexMessages), \"old_read_results\": p.count(\"waiting-before-config\"), \"fresh_read_results\": p.count(\"fresh-after-config\"), \"network_pending\": len(n.net)})\n\tif err := p.rn.Propose([]byte(\"later-commit-control\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tn.drain()\n\tcaExploreEvent(\"after_later_proposal\", map[string]interface{}{\"node\": 2, \"term\": p.rn.raft.Term, \"current_term_committed\": p.currentCommit(), \"pending_request\": p.waiting(\"waiting-before-config\"), \"committed\": p.rn.raft.raftLog.committed, \"pending_reads\": len(p.rn.raft.pendingReadIndexMessages), \"old_read_results\": p.count(\"waiting-before-config\"), \"fresh_read_results\": p.count(\"fresh-after-config\"), \"network_pending\": len(n.net)})\n}\n{\n  \"claim_id\": \"C_read_gate_release\",\n  \"monitors\": [\n    {\n      \"id\": \"MON_read_gate\",\n      \"checker_id\": \"CHK_read_gate_discharged\",\n      \"event\": \"read_gate_gate_observed\",\n      \"binding_ids\": [\n        \"BIND_read_wait\",\n        \"BIND_config_commit\",\n        \"BIND_read_release\",\n        \"BIND_read_ack_release\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S_proposal\",\n          \"S_membership\",\n          \"S_responses\",\n          \"S_read_release\",\n          \"S_read_queue\",\n          \"S_read\",\n          \"S_ready\"\n        ],\n        \"expectation_ids\": [\n          \"S_pending_read_purpose\",\n          \"S_new_leader_read_test\",\n          \"S_read_api_contract\"\n        ],\n        \"binding_ids\": [\n          \"BIND_read_wait\",\n          \"BIND_config_commit\",\n          \"BIND_read_release\",\n          \"BIND_read_ack_release\"\n        ],\n        \"derivation\": \"C_read_gate_release concerns the pre-commit queue, not guaranteed public completion. The driver searches pendingReadIndexMessages for the exact fresh context (waiting-before-config) and observes membership after the actual configuration call, all emitted Ready/network work, three heartbeat rounds and one independently completed fresh request. The antecedent is independently established by retained (specific request present, current-term commit false) followed by activated (current-term commit true, same leader term). Operation/node/request_context are stable identifiers; pending_request is only the compared value and is never a result applicability filter. The assertion pending_request == false checks whether the old request remains specifically behind the now-satisfied current-term prerequisite. The result commit and term must match activation, excluding a hidden later commitment or leader change. Later-proposal completion of the same request is recorded after the measured result and does not admit or filter it.\",\n        \"applicability\": \"One designated retained request, one membership activation, and one measured gate endpoint per stream. The admission alias activated represents the completed prerequisite-changing transition whose gate effect is owed. The later direct read and proposal controls are actual calls, with Ready.ReadStates observed by context. The checker does not require every ReadIndex to return; it measures retention in the prerequisite-specific queue after this transition. Source has no independent timer/worker that moves requests out of this queue; its only release caller is acknowledgment-driven commit. Finite heartbeat rounds are diagnostic controls, not a liveness timeout.\",\n        \"unresolved\": [\n          \"Whether the public early-Advance optimization extends to deferred ApplyConfChange remains explicit in the accepted scope.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Clearing/dropping the retained message would not produce this violation: the oracle only rejects remaining in the pre-commit gate.\",\n          \"A separate asynchronous normal read protocol can take longer to produce a result; the oracle does not require immediate ReadState.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"current_term_committed\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        },\n        {\n          \"field\": \"term\",\n          \"op\": \"eq\",\n          \"value\": null,\n          \"reference\": \"activated.term\"\n        },\n        {\n          \"field\": \"committed\",\n          \"op\": \"eq\",\n          \"value\": null,\n          \"reference\": \"activated.committed\"\n        }\n      ],\n      \"admission_alias\": \"activated\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"CHK_read_gate_discharged\"