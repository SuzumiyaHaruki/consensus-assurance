{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat > make_read_obligation.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v2.json'))\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n for k in ['established_by','consumed_by']:f.pop(k,None)\nnewsrc=[dict(id='S_early_advance_usage',file='doc.go',start_line=70,end_line=103,kind='document_statement'),dict(id='S_early_advance_readme',file='README.md',start_line=112,end_line=122,kind='document_statement')]\nm['behaviors'] += [dict(id='B_read_wait',primary_activity='A1',execution_owner='RawNode.ReadIndex -> raft.stepLeader',protocol_context='Leader term, nonsingleton voter configuration and no committed entry from current term',trigger='MsgReadIndex while committedEntryInCurrentTerm is false',implementation_guards=['Singleton fast path precedes the current-term check.','For nonsingleton leaders, current committed entry log term must equal leader term before entering the normal read protocol.'],writes=['Append actual read message to pendingReadIndexMessages.'],produces_fact_ids=['F_read_wait'],important_branches=['Already-qualified request directly calls sendMsgReadIndexResponse.','Follower forwards to known leader or drops when none; public ReadIndex permits request loss and retry.'],cross_activity_effects={'A2':'Read authority confirmation is deferred until the newly elected leader has established its current-term committed prefix.','A7':'Queued admission does not produce a ReadState or promise unconditional eventual client completion.'},source_ids=['S_proposal','S_read_raw_entry','S_read_api_contract','S_read','S_pending_read_purpose']),dict(id='B_read_release',primary_activity='A1',execution_owner='stepLeader MsgAppResp branch -> releasePendingReadIndexMessages -> sendMsgReadIndexResponse',protocol_context='Leader with newly advanced commit and current-term committed entry',trigger='Acknowledgment-driven maybeCommit returns true',imp