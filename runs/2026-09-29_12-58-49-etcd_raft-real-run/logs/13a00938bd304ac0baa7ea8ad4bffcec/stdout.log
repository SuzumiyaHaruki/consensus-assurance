      },\n      \"title\": \"Limitations\",\n      \"type\": \"array\"\n    },\n    \"challenged_components\": {\n      \"description\": \"Components requiring repair, distinct from the review aspect; revision_needed must name them\",\n      \"items\": {\n        \"enum\": [\n          \"configuration\",\n          \"initialization\",\n          \"driver\",\n          \"observation\",\n          \"oracle\",\n          \"expectation\",\n          \"scope\"\n        ],\n        \"type\": \"string\"\n      },\n      \"title\": \"Challenged Components\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"aspect\",\n    \"status\",\n    \"source_ids\",\n    \"rationale\"\n  ],\n  \"title\": \"ArtifactReviewItem\",\n  \"type\": \"object\"\n}\n{\n  \"description\": \"Execute the accepted obsolete-term completion obligation with a legal three-node prefix and actual producer messages. Delay one follower storage append across a real higher-term vote request, then measure the old completion before a current-term HardState-only completion. Later drain all delayed work. No critical protocol state is assigned.\",\n  \"claim_id\": \"C_stale_append_completion\",\n  \"binding_ids\": [\n    \"BIND_append_issue\",\n    \"BIND_append_consume\",\n    \"BIND_unstable_retire\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"testing\\\"\\n\\n\\tpb \\\"go.etcd.io/raft/v3/raftpb\\\"\\n)\\n\\ntype assuranceAppendJob struct {\\n\\tseq     uint64\\n\\tmessage pb.Message\\n}\\ntype assurancePeer struct {\\n\\trn           *RawNode\\n\\tstorage      *MemoryStorage\\n\\tappends      []assuranceAppendJob\\n\\tapplies      []pb.Message\\n\\tnextSeq      uint64\\n\\tcompletedSeq uint64\\n}\\ntype assuranceCluster struct {\\n\\tt       *testing.T\\n\\tpeers   map[uint64]*assurancePeer\\n\\tnetwork []pb.Message\\n}\\n\\nfunc assuranceEmit(event string, fields map[string]interface{}) {\\n\\tfields[\\\"event\\\"] = event\\n\\tfields[\\\"operation\\\"] = \\\"delayed-append\\\"\\n\\tfields[\\\"node\\\"] = uint64(2)\\n\\tb, err := json.Marshal(fields)\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc assuranceRequire(t *testing.T, ok bool, format string, args ...interface{}) {\\n\\tt.Helper()\\n\\tif !ok {\\n\\t\\tt.Fatalf(format, args...)\\n\\t}\\n}\\nfunc (c *assuranceCluster) step(m pb.Message) {\\n\\tc.t.Helper()\\n\\tp := c.peers[m.To]\\n\\tassuranceRequire(c.t, p != nil, \\\"unknown recipient %d\\\", m.To)\\n\\tif err := p.rn.Step(m); err != nil {\\n\\t\\tc.t.Fatalf(\\\"Step %s %d->%d: %v\\\", m.Type, m.From, m.To, err)\\n\\t}\\n}\\nfunc (c *assuranceCluster) collect(id uint64) bool {\\n\\tp := c.peers[id]\\n\\tif !p.rn.HasReady() {\\n\\t\\treturn false\\n\\t}\\n\\trd := p.rn.Ready()\\n\\tfor _, m := range rd.Messages {\\n\\t\\tswitch m.To {\\n\\t\\tcase LocalAppendThread:\\n\\t\\t\\tp.nextSeq++\\n\\t\\t\\tp.appends = append(p.appends, assuranceAppendJob{p.nextSeq, m})\\n\\t\\tcase LocalApplyThread:\\n\\t\\t\\tp.applies = append(p.applies, m)\\n\\t\\tdefault:\\n\\t\\t\\tc.network = append(c.network, m)\\n\\t\\t}\\n\\t}\\n\\treturn true\\n}\\nfunc (c *assuranceCluster) writeAppend(id uint64) assuranceAppendJob {\\n\\tc.t.Helper()\\n\\tp := c.peers[id]\\n\\tassuranceRequire(c.t, len(p.appends) > 0, \\\"no append job for %d\\\", id)\\n\\tj := p.appends[0]\\n\\tp.appends = p.appends[1:]\\n\\tassuranceRequire(c.t, j.seq == p.completedSeq+1, \\\"append order mismatch\\\")\\n\\tm := j.message\\n\\tif m.Snapshot != nil && !IsEmptySnap(*m.Snapshot) {\\n\\t\\tif err := p.storage.ApplySnapshot(*m.Snapshot); err != nil {\\n\\t\\t\\tc.t.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\tif err := p.storage.Append(m.Entries); err != nil {\\n\\t\\tc.t.Fatal(err)\\n\\t}\\n\\ths := pb.HardState{Term: m.Term, Vote: m.Vote, Commit: m.Commit}\\n\\tif !IsEmptyHardState(hs) {\\n\\t\\tif err := p.storage.SetHardState(hs); err != nil {\\n\\t\\t\\tc.t.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\tp.completedSeq = j.seq\\n\\treturn j\\n}\\nfunc (c *assuranceCluster) release(id uint64, j assuranceAppendJob, observe func(pb.Message)) {\\n\\tfor _, m := range j.message.Responses {\\n\\t\\tif m.To == id {\\n\\t\\t\\tif observe != nil && m.Type == pb.MsgStorageAppendResp {\\n\\t\\t\\t\\tobserve(m)\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tc.step(m)\\n\\t\\t\\t}\\n\\t\\t} else {\\n\\t\\t\\tc.network = append(c.network, m)\\n\\t\\t}\\n\\t}\\n}\\nfunc (c *assuranceCluster) apply(id uint64) bool {\\n\\tp := c.peers[id]\\n\\tif len(p.applies) == 0 {\\n\\t\\treturn false\\n\\t}\\n\\tm := p.applies[0]\\n\\tp.applies = p.applies[1:]\\n\\tfor _, e := range m.Entries {\\n\\t\\tswitch e.Type {\\n\\t\\tcase pb.EntryConfChange:\\n\\t\\t\\tvar cc pb.ConfChange\\n\\t\\t\\tif err := cc.Unmarshal(e.Data); err != nil {\\n\\t\\t\\t\\tc.t.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tp.rn.ApplyConfChange(cc)\\n\\t\\tcase pb.EntryConfChangeV2:\\n\\t\\t\\tvar cc pb.ConfChangeV2\\n\\t\\t\\tif err := cc.Unmarshal(e.Data); err != nil {\\n\\t\\t\\t\\tc.t.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tp.rn.ApplyConfChange(cc)\\n\\t\\t}\\n\\t}\\n\\tfor _, resp := range m.Responses {\\n\\t\\tc.step(resp)\\n\\t}\\n\\treturn true\\n}\\nfunc (c *assuranceCluster) drain() {\\n\\tc.t.Helper()\\n\\tfor round := 0; round < 1000; round++ {\\n\\t\\twork := false\\n\\t\\tfor id := uint64(1); id <= 3; id++ {\\n\\t\\t\\tif c.collect(id) {\\n\\t\\t\\t\\twork = true\\n\\t\\t\\t}\\n\\t\\t\\tif len(c.peers[id].appends) > 0 {\\n\\t\\t\\t\\tj := c.writeAppend(id)\\n\\t\\t\\t\\tc.release(id, j, nil)\\n\\t\\t\\t\\twork = true\\n\\t\\t\\t}\\n\\t\\t\\tif c.apply(id) {\\n\\t\\t\\t\\twork = true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif len(c.network) > 0 {\\n\\t\\t\\tm := c.network[0]\\n\\t\\t\\tc.network = c.network[1:]\\n\\t\\t\\tc.step(m)\\n\\t\\t\\twork = true\\n\\t\\t}\\n\\t\\tif !work {\\n\\t\\t\\treturn\\n\\t\\t}\\n\\t}\\n\\tc.t.Fatal(\\\"scheduler budget exhausted; no property conclusion\\\")\\n}\\nfunc assuranceToken(t *testing.T, j assuranceAppendJob) pb.Message {\\n\\tt.Helper()\\n\\tvar result pb.Message\\n\\tcount := 0\\n\\tfor _, m := range j.message.Responses {\\n\\t\\tif m.Type == pb.MsgStorageAppendResp {\\n\\t\\t\\tresult = m\\n\\t\\t\\tcount++\\n\\t\\t}\\n\\t}\\n\\tassuranceRequire(t, count == 1, \\\"expected one storage completion, found %d\\\", count)\\n\\treturn result\\n}\\nfunc (c *assuranceCluster) takeNetwork(kind pb.MessageType, from, to uint64) pb.Message {\\n\\tc.t.Helper()\\n\\tfor i, m := range c.network {\\n\\t\\tif m.Type == kind && m.From == from && m.To == to {\\n\\t\\t\\tc.network = append(c.network[:i], c.network[i+1:]...)\\n\\t\\t\\treturn m\\n\\t\\t}\\n\\t}\\n\\tc.t.Fatalf(\\\"missing emitted %s %d->%d\\\", kind, from, to)\\n\\treturn pb.Message{}\\n}\\n\\nfunc TestAssuranceOldAppendCompletion(t *testing.T) {\\n\\tc := &assuranceCluster{t: t, peers: make(map[uint64]*assurancePeer)}\\n\\tfor id := uint64(1); id <= 3; id++ {\\n\\t\\ts := NewMemoryStorage()\\n\\t\\trn, err := NewRawNode(&Config{ID: id, ElectionTick: 10, HeartbeatTick: 1, Storage: s,\\n\\t\\t\\tMaxSizePerMsg: 1 << 20, MaxInflightMsgs: 16, AsyncStorageWrites: true})\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t\\tc.peers[id] = &assurancePeer{rn: rn, storage: s}\\n\\t\\tif err := rn.Bootstrap([]Peer{{ID: 1}, {ID: 2}, {ID: 3}}); err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t}\\n\\tc.drain()\\n\\tfor id := uint64(1); id <= 3; id++ {\\n\\t\\tassuranceRequire(t, c.peers[id].rn.raft.raftLog.applied == 3, \\\"bootstrap not applied on %d\\\", id)\\n\\t}\\n\\tif err := c.peers[1].rn.Campaign(); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tc.drain()\\n\\tleader := c.peers[1].rn.raft\\n\\tassuranceRequire(t, leader.state == StateLeader, \\\"campaign did not elect node 1\\\")\\n\\tassuranceRequire(t, leader.raftLog.committed == leader.raftLog.lastIndex(), \\\"initial leader entry not committed\\\")\\n\\tp := c.peers[2]\\n\\tpriorTerm := p.rn.raft.Term\\n\\tassuranceEmit(\\\"prefix_ready\\\", map[string]interface{}{\\\"leader\\\": leader.id, \\\"term\\\": leader.Term,\\n\\t\\t\\\"follower_term\\\": priorTerm, \\\"committed\\\": p.rn.raft.raftLog.committed, \\\"applied\\\": p.rn.raft.raftLog.applied})\\n\\n\\tif err := c.peers[1].rn.Propose([]byte(\\\"completion-context-entry\\\")); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tc.collect(1)\\n\\t// Process the leader's storage work. Delay network delivery to node 3.\\n\\tfor len(c.peers[1].appends) > 0 {\\n\\t\\tj := c.writeAppend(1)\\n\\t\\tc.release(1, j, nil)\\n\\t}\\n\\tc.step(c.takeNetwork(pb.MsgApp, 1, 2))\\n\\tc.collect(2)\\n\\tassuranceRequire(t, len(p.appends) == 1, \\\"expected one held follower append\\\")\\n\\theld := p.appends[0]\\n\\told := assuranceToken(t, held)\\n\\tassuranceRequire(t, len(held.message.Entries) > 0 && old.Index > 0 && old.Snapshot == nil, \\\"entry-only token not produced\\\")\\n\\tassuranceRequire(t, old.Term == priorTerm, \\\"unexpected issuance term\\\")\\n\\tassuranceEmit(\\\"token_issued\\\", map[string]interface{}{\\\"batch\\\": held.seq, \\\"issue_term\\\": old.Term,\\n\\t\\t\\\"index\\\": old.Index, \\\"log_term\\\": old.LogTerm, \\\"prefix_term\\\": priorTerm, \\\"entry_count\\\": len(held.message.Entries)})\\n\\n\\t// The lagging peer campaigns from its real, shorter log. Its genuine vote\\n\\t// request advances node 2's term even though node 2 will reject the vote.\\n\\tif err := c.peers[3].rn.Campaign(); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tc.collect(3)\\n\\tfor len(c.peers[3].appends) > 0 {\\n\\t\\tj := c.writeAppend(3)\\n\\t\\tc.release(3, j, nil)\\n\\t}\\n\\tvote := c.takeNetwork(pb.MsgVote, 3, 2)\\n\\tc.step(vote)\\n\\tnow := p.rn.raft.Term\\n\\tassuranceRequire(t, now > old.Term, \\\"vote request did not advance term\\\")\\n\\tassuranceEmit(\\\"context_changed\\\", map[string]interface{}{\\\"issue_term\\\": old.Term, \\\"current_term\\\": now,\\n\\t\\t\\\"request_term\\\": vote.Term, \\\"request_index\\\": vote.Index, \\\"request_log_term\\\": vote.LogTerm, \\\"sender\\\": vote.From})\\n\\tc.collect(2)\\n\\tassuranceRequire(t, len(p.appends) == 2, \\\"term transition did not emit a second storage request\\\")\\n\\tfreshJob := p.appends[1]\\n\\tfresh := assuranceToken(t, freshJob)\\n\\tassuranceRequire(t, len(freshJob.message.Entries) == 0, \\\"reconfirmation request unexpectedly appended entries\\\")\\n\\tassuranceRequire(t, fresh.Term == now && fresh.Index == old.Index && fresh.LogTerm == old.LogTerm, \\\"tail not reconfirmed in current term\\\")\\n\\trejected := false\\n\\tfor _, m := range freshJob.message.Responses {\\n\\t\\tif m.Type == pb.MsgVoteResp && m.To == 3 && m.Reject {\\n\\t\\t\\trejected = true\\n\\t\\t}\\n\\t}\\n\\tassuranceRequire(t, rejected, \\\"expected actual stale-log vote rejection\\\")\\n\\n\\twritten := c.writeAppend(2)\\n\\tstableTerm, err := p.storage.Term(old.Index)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tassuranceEmit(\\\"batch_written\\\", map[string]interface{}{\\\"batch\\\": written.seq, \\\"issue_term\\\": old.Term,\\n\\t\\t\\\"stable_term\\\": stableTerm, \\\"index\\\": old.Index, \\\"completed_seq\\\": p.completedSeq})\\n\\tobserved := false\\n\\tc.release(2, written, func(m pb.Message) {\\n\\t\\tobserved = true\\n\\t\\tbefore := p.rn.raft.raftLog.unstable.offset\\n\\t\\tlast := p.rn.raft.raftLog.lastEntryID()\\n\\t\\tassuranceRequire(t, m.Term < now && last.index == m.Index && last.term == m.LogTerm && before <= m.Index,\\n\\t\\t\\t\\\"discriminator preconditions not reached\\\")\\n\\t\\tassuranceEmit(\\\"completion_admitted\\\", map[string]interface{}{\\\"batch\\\": written.seq, \\\"completed_seq\\\": p.completedSeq,\\n\\t\\t\\t\\\"issue_term\\\": m.Term, \\\"current_term\\\": now, \\\"offset\\\": before, \\\"index\\\": m.Index, \\\"log_term\\\": m.LogTerm,\\n\\t\\t\\t\\\"stale\\\": m.Term < now, \\\"identity_matches\\\": last.index == m.Index && last.term == m.LogTerm, \\\"has_snapshot\\\": m.Snapshot != nil})\\n\\t\\tc.step(m)\\n\\t\\tassuranceEmit(\\\"completion_consumed\\\", map[string]interface{}{\\\"batch\\\": written.seq,\\n\\t\\t\\t\\\"offset\\\": p.rn.raft.raftLog.unstable.offset, \\\"current_term\\\": p.rn.raft.Term,\\n\\t\\t\\t\\\"stale\\\": m.Term < p.rn.raft.Term, \\\"identity_matches\\\": last.index == m.Index && last.term == m.LogTerm,\\n\\t\\t\\t\\\"has_snapshot\\\": m.Snapshot != nil, \\\"index\\\": m.Index, \\\"log_term\\\": m.LogTerm})\\n\\t})\\n\\tassuranceRequire(t, observed, \\\"old completion was not delivered\\\")\\n\\n\\tcurrentWritten := c.writeAppend(2)\\n\\tc.release(2, currentWritten, func(m pb.Message) {\\n\\t\\tbefore := p.rn.raft.raftLog.unstable.offset\\n\\t\\tc.step(m)\\n\\t\\tassuranceEmit(\\\"permitted_control\\\", map[string]interface{}{\\\"batch\\\": currentWritten.seq, \\\"issue_term\\\": m.Term,\\n\\t\\t\\t\\\"current_term\\\": p.rn.raft.Term, \\\"index\\\": m.Index, \\\"log_term\\\": m.LogTerm, \\\"entries_in_request\\\": len(currentWritten.message.Entries),\\n\\t\\t\\t\\\"before_offset\\\": before, \\\"after_offset\\\": p.rn.raft.raftLog.unstable.offset})\\n\\t})\\n\\t// Finish every delayed worker and network delivery; no tick or eventual\\n\\t// election is needed to terminate this finite controlled schedule.\\n\\tc.drain()\\n\\tassuranceEmit(\\\"schedule_complete\\\", map[string]interface{}{\\\"network_pending\\\": len(c.network),\\n\\t\\t\\\"append_pending\\\": len(p.appends), \\\"apply_pending\\\": len(p.applies), \\\"offset\\\": p.rn.raft.raftLog.unstable.offset})\\n}\\n\",\n    \"description\": \"TestAssuranceOldAppendCompletion; serialized scheduler for real RawNode instances, actual emitted network/local messages, and actual MemoryStorage writes. Instrumentation reads unstable.offset before/after the delivered old response. All prerequisites and results are runtime JSON.\",\n    \"semantic_changes\": [\n      \"Adds a package-local Go test only; no target implementation, dependencies or protocol logic are replaced.\",\n      \"The caller-owned network and storage workers are deterministic test scheduling adapters. MemoryStorage substitutes for an unspecified durable backend under a no-crash scope.\",\n      \"Reads unexported state for setup checks and endpoint observation; no direct writes to term, vote, progress, log, commit or unstable state.\",\n      \"Normal application entries have no external state machine; configuration entries are applied through ApplyConfChange before storage-apply responses. This does not create an application-level result.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prefix\",\n        \"event\": \"prefix_ready\",\n        \"conditions\": []\n      },\n      {\n        \"alias\": \"issued\",\n        \"event\": \"token_issued\",\n        \"conditions\": [\n          {\n            \"field\": \"prefix_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prefix.follower_term\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"changed\",\n        \"event\": \"context_changed\",\n        \"conditions\": [\n          {\n            \"field\": \"issue_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"issued.issue_term\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"written\",\n        \"event\": \"batch_written\",\n        \"conditions\": [\n          {\n            \"field\": \"batch\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"issued.batch\"\n          },\n          {\n            \"field\": \"index\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"issued.index\"\n          },\n          {\n            \"field\": \"stable_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"issued.log_term\"\n          }\n        ]\n      },\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"completion_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"completed_seq\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"written.completed_seq\"\n          },\n          {\n            \"field\": \"batch\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"written.batch\"\n          },\n          {\n            \"field\": \"current_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"changed.current_term\"\n          },\n          {\n            \"field\": \"stale\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"identity_matches\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"has_snapshot\",\n            \"op\": \"eq\",\n            \"value\": false,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S_api\",\n        \"S_bootstrap\",\n        \"S_config\",\n        \"S_ready\",\n        \"S_election\",\n        \"S_transition\",\n        \"S_roles\",\n        \"S_proposal\",\n        \"S_receive\",\n        \"S_unstable\",\n        \"S_log_apply\",\n        \"S_storage\",\n        \"S_mem_append\",\n        \"S_mem_hardstate\",\n        \"S_async_messages\",\n        \"S_config_validate\"\n      ],\n      \"expectation_ids\": [\n        \"S_config\",\n        \"S_async_messages\"\n      ],\n      \"binding_ids\": [\n        \"BIND_append_issue\",\n        \"BIND_append_consume\",\n        \"BIND_unstable_retire\"\n      ],\n      \"derivation\": \"The harness creates three NewRawNode instances with empty MemoryStorage, bootstraps the same peer list, processes emitted storage append/apply work and applies configuration entries. It then campaigns node 1 through the real API and drains actual emitted election/replication messages before proposing one entry. Node 2 receives the emitted append but its append-worker request is held. Node 3, whose log is shorter, campaigns and emits the actual higher-term vote request delivered to node 2. This advances node 2 term and produces a real vote rejection and current-term storage request. S_ready produces both old and current response tokens; the harness neither fabricates them nor assigns raft term/log/progress state. S_mem_append and S_mem_hardstate implement the selected in-memory storage operations; S_config requires append-worker requests to be processed in order before responses, which sequence counters check.\",\n      \"applicability\": \"All calls are serialized. AsyncStorageWrites is enabled; no Advance calls occur. The append worker processes every request in FIFO order. No process/storage crashes, mutations of emitted messages, compaction or snapshots occur. MemoryStorage is the actual library storage backend; synchronous completion is a valid no-crash storage completion for this bounded execution, not evidence of disk durability. Outbound append to node 3 and vote request to node 1 are finitely delayed during the discriminator. Other generated replies, including node 2 vote rejection and node 1/node 3 self responses, are processed. All queued network and local worker actions are drained after observation. Logical ticks are omitted over a finite controlled interval: no deadline or liveness claim is made, and the explicit Campaign invokes the real acquisition path.\",\n      \"unresolved\": [\n        \"No competing in-flight suffix overwrite, crash reconstruction, or application/client endpoint is tested.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"The term transition is caused by a rejected vote request, not by a new leader or log overwrite. This intentionally isolates issuance-term checking when entry identity is unchanged.\",\n        \"A current-term HardState-only completion is executed as a permitted control; its raw offset transition is recorded but is not a second formal requirement.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"MON_stale_completion\",\n      \"checker_id\": \"CHK_no_old_term_retirement\",\n      \"event\": \"completion_consumed\",\n      \"binding_ids\": [\n        \"BIND_append_issue\",\n        \"BIND_append_consume\",\n        \"BIND_unstable_retire\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S_ready\",\n          \"S_election\",\n          \"S_unstable\",\n          \"S_config\"\n        ],\n        \"expectation_ids\": [\n          \"S_completion_contract\",\n          \"S_stable_contract\"\n        ],\n        \"binding_ids\": [\n          \"BIND_append_issue\",\n          \"BIND_append_consume\",\n          \"BIND_unstable_retire\"\n        ],\n        \"derivation\": \"C_stale_append_completion requires no retirement by this obsolete completion. BIND_append_issue identifies the unmodified emitted response. BIND_append_consume identifies the exact Step call being observed; no other message is processed between admission and its return. BIND_unstable_retire shows that discarding an unstable prefix advances unstable.offset. Compare the post-Step offset with the observed pre-Step admitted.offset, rather than with a precomputed expected result. Prefix, emitted token, actual context transition and completed storage job are independently emitted prerequisites. Explicit references require generation before context/write and both before admission. Operation and node provide stable independent identity; offset and changing term are not identity filters.\",\n        \"applicability\": \"One designated old completion per execution stream. Before admission the harness independently checks actual old response term, unchanged tail index/log term, nonempty covered unstable range and absence of snapshot. It emits admission immediately before Step and result immediately after Step. The monitored endpoint is local entry retirement only. The later permitted control and full scheduler drain run regardless of whether the measured offset changed; they are diagnostic output, not prerequisites or filters for this measurement.\",\n        \"unresolved\": [\n          \"Offset is a library-internal observation, not an application reply or durable-disk observation.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Snapshot completion can legitimately survive a term change, so this check uses an entry-only token.\",\n          \"An entry-term mismatch could explain no retirement without reaching the chosen discriminator; independent precondition checks exclude that case.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"stale\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        },\n        {\n          \"field\": \"identity_matches\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        },\n        {\n          \"field\": \"has_snapshot\",\n          \"op\": \"eq\",\n          \"value\": false,\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"CHK_no_old_term_retirement\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"completion_consumed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"offset\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admitted.offset\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"operation\",\n        \"node\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For the admitted obsolete entry-only completion with matching entry identity, the unstable offset after actual Step equals its observed offset immediately before Step.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The measured requirement is conservative term filtering, not whether this particular completion could cause data loss.\",\n    \"The schedule contains no competing overwrite; it does not reproduce the broader overwrite scenario described in source comments.\",\n    \"The permitted current-term control is emitted as raw diagnostic observation and is not a separately monitored liveness obligation.\",\n    \"A local build was used for construction only; formal evidence must come from trusted execution of these fixed artifacts.\"\n  ]\n}","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/9fc4b62618184d41988fa5ce0bc8dfad/assurance_generated_test.go\npython3 - <<'PY'\nimport json\ns=json.load(open('../state.json'))\nfor coll,ids in [('claims',['C_stale_append_completion']),('bindings',['BIND_append_issue','BIND_append_consume','BIND_unstable_retire'])]:\n for x in s[coll]:\n  if x['id'] in ids and x['version']==1: print(coll,json.dumps(x))\nfor line in open('../logs/e365efbbde80420bb1b1730a6c13d88a/stdout.log'):\n r=json.loads(line)\n if 'Output' in r: print(r['Output'],end='')\nprint('STDERR:',open('../logs/e365efbbde80420bb1b1730a6c13d88a/stderr.log').read())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/9fc4b62618184d41988fa5ce0bc8dfad/assurance_generated_test.go\npython3 - <<'PY'\nimport json\ns=json.load(open('../state.json'))\nfor coll,ids in [('claims',['C_stale_append_completion']),('bindings',['BIND_append_issue','BIND_append_consume','BIND_unstable_retire'])]:\n for x in s[coll]:\n  if x['id'] in ids and x['version']==1: print(coll,json.dumps(x))\nfor line in open('../logs/e365efbbde80420bb1b1730a6c13d88a/stdout.log'):\n r=json.loads(line)\n if 'Output' in r: print(r['Output'],end='')\nprint('STDERR:',open('../logs/e365efbbde80420bb1b1730a6c13d88a/stderr.log').read())\nPY\"","aggregated_output":"package raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"testing\"\n\n\tpb \"go.etcd.io/raft/v3/raftpb\"\n)\n\ntype assuranceAppendJob struct {\n\tseq     uint64\n\tmessage pb.Message\n}\ntype assurancePeer struct {\n\trn           *RawNode\n\tstorage      *MemoryStorage\n\tappends      []assuranceAppendJob\n\tapplies      []pb.Message\n\tnextSeq      uint64\n\tcompletedSeq uint64\n}\ntype assuranceCluster struct {\n\tt       *testing.T\n\tpeers   map[uint64]*assurancePeer\n\tnetwork []pb.Message\n}\n\nfunc assuranceEmit(event string, fields map[string]interface{}) {\n\tfields[\"event\"] = event\n\tfields[\"operation\"] = \"delayed-append\"\n\tfields[\"node\"] = uint64(2)\n\tb, err := json.Marshal(fields)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(b))\n}\nfunc assuranceRequire(t *testing.T, ok bool, format string, args ...interface{}) {\n\tt.Helper()\n\tif !ok {\n\t\tt.Fatalf(format, args...)\n\t}\n}\nfunc (c *assuranceCluster) step(m pb.Message) {\n\tc.t.Helper()\n\tp := c.peers[m.To]\n\tassuranceRequire(c.t, p != nil, \"unknown recipient %d\", m.To)\n\tif err := p.rn.Step(m); err != nil {\n\t\tc.t.Fatalf(\"Step %s %d->%d: %v\", m.Type, m.From, m.To, err)\n\t}\n}\nfunc (c *assuranceCluster) collect(id uint64) bool {\n\tp := c.peers[id]\n\tif !p.rn.HasReady() {\n\t\treturn false\n\t}\n\trd := p.rn.Ready()\n\tfor _, m := range rd.Messages {\n\t\tswitch m.To {\n\t\tcase LocalAppendThread:\n\t\t\tp.nextSeq++\n\t\t\tp.appends = append(p.appends, assuranceAppendJob{p.nextSeq, m})\n\t\tcase LocalApplyThread:\n\t\t\tp.applies = append(p.applies, m)\n\t\tdefault:\n\t\t\tc.network = append(c.network, m)\n\t\t}\n\t}\n\treturn true\n}\nfunc (c *assuranceCluster) writeAppend(id uint64) assuranceAppendJob {\n\tc.t.Helper()\n\tp := c.peers[id]\n\tassuranceRequire(c.t, len(p.appends) > 0, \"no append job for %d\", id)\n\tj := p.appends[0]\n\tp.appends = p.appends[1:]\n\tassuranceRequire(c.t, j.seq == p.completedSeq+1, \"append order mismatch\")\n\tm := j.message\n\tif m.Snapshot != nil && !IsEmptySnap(*m.Snapshot) {\n\t\tif err := p.storage.ApplySnapshot(*m.Snapshot); err != nil {\n\t\t\tc.t.Fatal(err)\n\t\t}\n\t}\n\tif err := p.storage.Append(m.Entries); err != nil {\n\t\tc.t.Fatal(err)\n\t}\n\ths := pb.HardState{Term: m.Term, Vote: m.Vote, Commit: m.Commit}\n\tif !IsEmptyHardState(hs) {\n\t\tif err := p.storage.SetHardState(hs); err != nil {\n\t\t\tc.t.Fatal(err)\n\t\t}\n\t}\n\tp.completedSeq = j.seq\n\treturn j\n}\nfunc (c *assuranceCluster) release(id uint64, j assuranceAppendJob, observe func(pb.Message)) {\n\tfor _, m := range j.message.Responses {\n\t\tif m.To == id {\n\t\t\tif observe != nil && m.Type == pb.MsgStorageAppendResp {\n\t\t\t\tobserve(m)\n\t\t\t} else {\n\t\t\t\tc.step(m)\n\t\t\t}\n\t\t} else {\n\t\t\tc.network = append(c.network, m)\n\t\t}\n\t}\n}\nfunc (c *assuranceCluster) apply(id uint64) bool {\n\tp := c.peers[id]\n\tif len(p.applies) == 0 {\n\t\treturn false\n\t}\n\tm := p.applies[0]\n\tp.applies = p.applies[1:]\n\tfor _, e := range m.Entries {\n\t\tswitch e.Type {\n\t\tcase pb.EntryConfChange:\n\t\t\tvar cc pb.ConfChange\n\t\t\tif err := cc.Unmarshal(e.Data); err != nil {\n\t\t\t\tc.t.Fatal(err)\n\t\t\t}\n\t\t\tp.rn.ApplyConfChange(cc)\n\t\tcase pb.EntryConfChangeV2:\n\t\t\tvar cc pb.ConfChangeV2\n\t\t\tif err := cc.Unmarshal(e.Data); err != nil {\n\t\t\t\tc.t.Fatal(err)\n\t\t\t}\n\t\t\tp.rn.ApplyConfChange(cc)\n\t\t}\n\t}\n\tfor _, resp := range m.Responses {\n\t\tc.step(resp)\n\t}\n\treturn true\n}\nfunc (c *assuranceCluster) drain() {\n\tc.t.Helper()\n\tfor round := 0; round < 1000; round++ {\n\t\twork := false\n\t\tfor id := uint64(1); id <= 3; id++ {\n\t\t\tif c.collect(id) {\n\t\t\t\twork = true\n\t\t\t}\n\t\t\tif len(c.peers[id].appends) > 0 {\n\t\t\t\tj := c.writeAppend(id)\n\t\t\t\tc.release(id, j, nil)\n\t\t\t\twork = true\n\t\t\t}\n\t\t\tif c.apply(id) {\n\t\t\t\twork = true\n\t\t\t}\n\t\t}\n\t\tif len(c.network) > 0 {\n\t\t\tm := c.network[0]\n\t\t\tc.network = c.network[1:]\n\t\t\tc.step(m)\n\t\t\twork = true\n\t\t}\n\t\tif !work {\n\t\t\treturn\n\t\t}\n\t}\n\tc.t.Fatal(\"scheduler budget exhausted; no property conclusion\")\n}\nfunc assuranceToken(t *testing.T, j assuranceAppendJob) pb.Message {\n\tt.Helper()\n\tvar result pb.Message\n\tcount := 0\n\tfor _, m := range j.message.Responses {\n\t\tif m.Type == pb.MsgStorageAppendResp {\n\t\t\tresult = m\n\t\t\tcount++\n\t\t}\n\t}\n\tassuranceRequire(t, count == 1, \"expected one storage completion, found %d\", count)\n\treturn result\n}\nfunc (c *assuranceCluster) takeNetwork(kind pb.MessageType, from, to uint64) pb.Message {\n\tc.t.Helper()\n\tfor i, m := range c.network {\n\t\tif m.Type == kind && m.From == from && m.To == to {\n\t\t\tc.network = append(c.network[:i], c.network[i+1:]...)\n\t\t\treturn m\n\t\t}\n\t}\n\tc.t.Fatalf(\"missing emitted %s %d->%d\", kind, from, to)\n\treturn pb.Message{}\n}\n\nfunc TestAssuranceOldAppendCompletion(t *testing.T) {\n\tc := &assuranceCluster{t: t, peers: make(map[uint64]*assurancePeer)}\n\tfor id := uint64(1); id <= 3; id++ {\n\t\ts := NewMemoryStorage()\n\t\trn, err := NewRawNode(&Config{ID: id, ElectionTick: 10, HeartbeatTick: 1, Storage: s,\n\t\t\tMaxSizePerMsg: 1 << 20, MaxInflightMsgs: 16, AsyncStorageWrites: true})\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tc.peers[id] = &assurancePeer{rn: rn, storage: s}\n\t\tif err := rn.Bootstrap([]Peer{{ID: 1}, {ID: 2}, {ID: 3}}); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tc.drain()\n\tfor id := uint64(1); id <= 3; id++ {\n\t\tassuranceRequire(t, c.peers[id].rn.raft.raftLog.applied == 3, \"bootstrap not applied on %d\", id)\n\t}\n\tif err := c.peers[1].rn.Campaign(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.drain()\n\tleader := c.peers[1].rn.raft\n\tassuranceRequire(t, leader.state == StateLeader, \"campaign did not elect node 1\")\n\tassuranceRequire(t, leader.raftLog.committed == leader.raftLog.lastIndex(), \"initial leader entry not committed\")\n\tp := c.peers[2]\n\tpriorTerm := p.rn.raft.Term\n\tassuranceEmit(\"prefix_ready\", map[string]interface{}{\"leader\": leader.id, \"term\": leader.Term,\n\t\t\"follower_term\": priorTerm, \"committed\": p.rn.raft.raftLog.committed, \"applied\": p.rn.raft.raftLog.applied})\n\n\tif err := c.peers[1].rn.Propose([]byte(\"completion-context-entry\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.collect(1)\n\t// Process the leader's storage work. Delay network delivery to node 3.\n\tfor len(c.peers[1].appends) > 0 {\n\t\tj := c.writeAppend(1)\n\t\tc.release(1, j, nil)\n\t}\n\tc.step(c.takeNetwork(pb.MsgApp, 1, 2))\n\tc.collect(2)\n\tassuranceRequire(t, len(p.appends) == 1, \"expected one held follower append\")\n\theld := p.appends[0]\n\told := assuranceToken(t, held)\n\tassuranceRequire(t, len(held.message.Entries) > 0 && old.Index > 0 && old.Snapshot == nil, \"entry-only token not produced\")\n\tassuranceRequire(t, old.Term == priorTerm, \"unexpected issuance term\")\n\tassuranceEmit(\"token_issued\", map[string]interface{}{\"batch\": held.seq, \"issue_term\": old.Term,\n\t\t\"index\": old.Index, \"log_term\": old.LogTerm, \"prefix_term\": priorTerm, \"entry_count\": len(held.message.Entries)})\n\n\t// The lagging peer campaigns from its real, shorter log. Its genuine vote\n\t// request advances node 2's term even though node 2 will reject the vote.\n\tif err := c.peers[3].rn.Campaign(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tc.collect(3)\n\tfor len(c.peers[3].appends) > 0 {\n\t\tj := c.writeAppend(3)\n\t\tc.release(3, j, nil)\n\t}\n\tvote := c.takeNetwork(pb.MsgVote, 3, 2)\n\tc.step(vote)\n\tnow := p.rn.raft.Term\n\tassuranceRequire(t, now > old.Term, \"vote request did not advance term\")\n\tassuranceEmit(\"context_changed\", map[string]interface{}{\"issue_term\": old.Term, \"current_term\": now,\n\t\t\"request_term\": vote.Term, \"request_index\": vote.Index, \"request_log_term\": vote.LogTerm, \"sender\": vote.From})\n\tc.collect(2)\n\tassuranceRequire(t, len(p.appends) == 2, \"term transition did not emit a second storage request\")\n\tfreshJob := p.appends[1]\n\tfresh := assuranceToken(t, freshJob)\n\tassuranceRequire(t, len(freshJob.message.Entries) == 0, \"reconfirmation request unexpectedly appended entries\")\n\tassuranceRequire(t, fresh.Term == now && fresh.Index == old.Index && fresh.LogTerm == old.LogTerm, \"tail not reconfirmed in current term\")\n\trejected := false\n\tfor _, m := range freshJob.message.Responses {\n\t\tif m.Type == pb.MsgVoteResp && m.To == 3 && m.Reject {\n\t\t\trejected = true\n\t\t}\n\t}\n\tassuranceRequire(t, rejected, \"expected actual stale-log vote rejection\")\n\n\twritten := c.writeAppend(2)\n\tstableTerm, err := p.storage.Term(old.Index)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tassuranceEmit(\"batch_written\", map[string]interface{}{\"batch\": written.seq, \"issue_term\": old.Term,\n\t\t\"stable_term\": stableTerm, \"index\": old.Index, \"completed_seq\": p.completedSeq})\n\tobserved := false\n\tc.release(2, written, func(m pb.Message) {\n\t\tobserved = true\n\t\tbefore := p.rn.raft.raftLog.unstable.offset\n\t\tlast := p.rn.raft.raftLog.lastEntryID()\n\t\tassuranceRequire(t, m.Term < now && last.index == m.Index && last.term == m.LogTerm && before <= m.Index,\n\t\t\t\"discriminator preconditions not reached\")\n\t\tassuranceEmit(\"completion_admitted\", map[string]interface{}{\"batch\": written.seq, \"completed_seq\": p.completedSeq,\n\t\t\t\"issue_term\": m.Term, \"current_term\": now, \"offset\": before, \"index\": m.Index, \"log_term\": m.LogTerm,\n\t\t\t\"stale\": m.Term < now, \"identity_matches\": last.index == m.Index && last.term == m.LogTerm, \"has_snapshot\": m.Snapshot != nil})\n\t\tc.step(m)\n\t\tassuranceEmit(\"completion_consumed\", map[string]interface{}{\"batch\": written.seq,\n\t\t\t\"offset\": p.rn.raft.raftLog.unstable.offset, \"current_term\": p.rn.raft.Term,\n\t\t\t\"stale\": m.Term < p.rn.raft.Term, \"identity_matches\": last.index == m.Index && last.term == m.LogTerm,\n\t\t\t\"has_snapshot\": m.Snapshot != nil, \"index\": m.Index, \"log_term\": m.LogTerm})\n\t})\n\tassuranceRequire(t, observed, \"old completion was not delivered\")\n\n\tcurrentWritten := c.writeAppend(2)\n\tc.release(2, currentWritten, func(m pb.Message) {\n\t\tbefore := p.rn.raft.raftLog.unstable.offset\n\t\tc.step(m)\n\t\tassuranceEmit(\"permitted_control\", map[string]interface{}{\"batch\": currentWritten.seq, \"issue_term\": m.Term,\n\t\t\t\"current_term\": p.rn.raft.Term, \"index\": m.Index, \"log_term\": m.LogTerm, \"entries_in_request\": len(currentWritten.message.Entries),\n\t\t\t\"before_offset\": before, \"after_offset\": p.rn.raft.raftLog.unstable.offset})\n\t})\n\t// Finish every delayed worker and network delivery; no tick or eventual\n\t// election is needed to terminate this finite controlled schedule.\n\tc.drain()\n\tassuranceEmit(\"schedule_complete\", map[string]interface{}{\"network_pending\": len(c.network),\n\t\t\"append_pending\": len(p.appends), \"apply_pending\": len(p.applies), \"offset\": p.rn.raft.raftLog.unstable.offset})\n}\nclaims {\"id\": \"C_stale_append_completion\", \"kind\": \"obligation\", \"concern\": \"implementation_semantics\", \"description\": \"For a legally delivered asynchronous local append-completion response whose issuing Raft term is earlier than the receiving node's current term, processing that response must not retire entries from the node's current unstable log, even if its acknowledged entry index and log term match the current tail.\", \"scope\": {\"description\": \"Entry-retirement semantics of actual MsgStorageAppendResp messages in AsyncStorageWrites mode across a monotonic Raft term transition.\", \"assumptions\": [\"Non-Byzantine caller returns emitted local response messages unchanged.\", \"Append-worker requests are processed reliably and in order; response release follows completion of the request and all earlier storage work.\", \"RawNode calls are serialized.\"], \"excluded\": [\"Snapshot completion carried by a response.\", \"Crash recovery, disk hardware failures and arbitrary message fabrication.\", \"General eventual reclamation, application correctness or consensus safety proof.\"], \"parameters\": {}}, \"source\": \"Candidate derived from attributed implementation responsibilities\", \"source_ids\": [\"S_completion_contract\", \"S_stable_contract\", \"S_config\", \"S_ready\", \"S_election\", \"S_unstable\"], \"pending\": [\"Construct and execute one legal producer/transition/completion history and a same-term permitted control.\"], \"assessment\": \"unassessed\", \"candidate\": true, \"grounding\": {\"source_ids\": [\"S_ready\", \"S_election\", \"S_unstable\", \"S_config\"], \"expectation_ids\": [\"S_completion_contract\", \"S_stable_contract\"], \"binding_ids\": [], \"derivation\": \"S_completion_contract expressly states that an append response is ignored and unstable log is not truncated if the Raft term has changed since issuance. S_stable_contract requires assurance against future in-progress overwrite before retirement. The obligation checks this explicit context-filter behavior, not a claim that every earlier-term completion is actually unsafe. S_ready captures the issuance term separately from entry identity, while S_election implements the lower-term branch.\", \"applicability\": \"Applies to generated entry-bearing completion tokens under the asynchronous caller contract. A history with no competing overwrite still falls under the documented conservative term filter, but would not establish the overwrite hazard itself.\", \"unresolved\": [\"A passing source review would not establish execution reachability or the real worker prefix.\"], \"conflicts\": [], \"alternatives\": [\"Index/log-term matching independently prevents many stale completions but does not replace the documented issuance-term check.\", \"Ordered storage processing and a subsequent current-term request allow safe reconfirmation of the same entry tail.\", \"Snapshot and application completion have different term-independent semantics and are excluded.\"]}, \"version\": 1}\nbindings {\"associations\": [{\"claim_id\": \"C_stale_append_completion\", \"source_ids\": [\"S_completion_contract\", \"S_config\"], \"rationale\": \"Connects the conditional completion token and its caller release contract to the documented context filter.\"}], \"anchor\": {\"source_ids\": [\"S_completion_contract\", \"S_ready\"], \"boundary_complete\": true, \"kind\": \"declaration\", \"material_id\": \"S_ready\", \"start_line\": 268, \"end_line\": 268, \"symbol\": \"newStorageAppendRespMsg\"}, \"material_id\": \"S_ready\", \"id\": \"BIND_append_issue\", \"file\": \"rawnode.go\", \"symbol\": \"newStorageAppendRespMsg\", \"start_line\": 268, \"end_line\": 365, \"snapshot_id\": \"ddc487473bcb4bf28d237458ffdd5975\", \"content_digest\": \"353943bf23d55dc9225beebf06f530e678518ed13323d25cb728bf401580b4c0\", \"basis\": \"agent_inference\", \"description\": \"Actual response producer captures Raft term and current last entry identity; in-progress work permits an entry-free later request to reconfirm it.\", \"pending\": [], \"excerpt\": \"func newStorageAppendRespMsg(r *raft, rd Ready) pb.Message {\\n\\tm := pb.Message{\\n\\t\\tType: pb.MsgStorageAppendResp,\\n\\t\\tTo:   r.id,\\n\\t\\tFrom: LocalAppendThread,\\n\\t\\t// Dropped after term change, see below.\\n\\t\\tTerm: r.Term,\\n\\t}\\n\\tif r.raftLog.hasNextOrInProgressUnstableEnts() {\\n\\t\\t// If the raft log has unstable entries, attach the last index and term of the\\n\\t\\t// append to the response message. This (index, term) tuple will be handed back\\n\\t\\t// and consulted when the stability of those log entries is signaled to the\\n\\t\\t// unstable. If the (index, term) match the unstable log by the time the\\n\\t\\t// response is received (unstable.stableTo), the unstable log can be truncated.\\n\\t\\t//\\n\\t\\t// However, with just this logic, there would be an ABA problem[^1] that could\\n\\t\\t// lead to the unstable log and the stable log getting out of sync temporarily\\n\\t\\t// and leading to an inconsistent view. Consider the following example with 5\\n\\t\\t// nodes, A B C D E:\\n\\t\\t//\\n\\t\\t//  1. A is the leader.\\n\\t\\t//  2. A proposes some log entries but only B receives these entries.\\n\\t\\t//  3. B gets the Ready and the entries are appended asynchronously.\\n\\t\\t//  4. A crashes and C becomes leader after getting a vote from D and E.\\n\\t\\t//  5. C proposes some log entries and B receives these entries, overwriting the\\n\\t\\t//     previous unstable log entries that are in the process of being appended.\\n\\t\\t//     The entries have a larger term than the previous entries but the same\\n\\t\\t//     indexes. It begins appending these new entries asynchronously.\\n\\t\\t//  6. C crashes and A restarts and becomes leader again after getting the vote\\n\\t\\t//     from D and E.\\n\\t\\t//  7. B receives the entries from A which are the same as the ones from step 2,\\n\\t\\t//     overwriting the previous unstable log entries that are in the process of\\n\\t\\t//     being appended from step 5. The entries have the original terms and\\n\\t\\t//     indexes from step 2. Recall that log entries retain their original term\\n\\t\\t//     numbers when a leader replicates entries from previous terms. It begins\\n\\t\\t//     appending these new entries asynchronously.\\n\\t\\t//  8. The asynchronous log appends from the first Ready complete and stableTo\\n\\t\\t//     is called.\\n\\t\\t//  9. However, the log entries from the second Ready are still in the\\n\\t\\t//     asynchronous append pipeline and will overwrite (in stable storage) the\\n\\t\\t//     entries from the first Ready at some future point. We can't truncate the\\n\\t\\t//     unstable log yet or a future read from Storage might see the entries from\\n\\t\\t//     step 5 before they have been replaced by the entries from step 7.\\n\\t\\t//     Instead, we must wait until we are sure that the entries are stable and\\n\\t\\t//     that no in-progress appends might overwrite them before removing entries\\n\\t\\t//     from the unstable log.\\n\\t\\t//\\n\\t\\t// To prevent these kinds of problems, we also attach the current term to the\\n\\t\\t// MsgStorageAppendResp (above). If the term has changed by the time the\\n\\t\\t// MsgStorageAppendResp if returned, the response is ignored and the unstable\\n\\t\\t// log is not truncated. The unstable log is only truncated when the term has\\n\\t\\t// remained unchanged from the time that the MsgStorageAppend was sent to the\\n\\t\\t// time that the MsgStorageAppendResp is received, indicating that no-one else\\n\\t\\t// is in the process of truncating the stable log.\\n\\t\\t//\\n\\t\\t// However, this replaces a correctness problem with a liveness problem. If we\\n\\t\\t// only attempted to truncate the unstable log when appending new entries but\\n\\t\\t// also occasionally dropped these responses, then quiescence of new log entries\\n\\t\\t// could lead to the unstable log never being truncated.\\n\\t\\t//\\n\\t\\t// To combat this, we attempt to truncate the log on all MsgStorageAppendResp\\n\\t\\t// messages where the unstable log is not empty, not just those associated with\\n\\t\\t// entry appends. This includes MsgStorageAppendResp messages associated with an\\n\\t\\t// updated HardState, which occur after a term change.\\n\\t\\t//\\n\\t\\t// In other words, we set Index and LogTerm in a block that looks like:\\n\\t\\t//\\n\\t\\t//  if r.raftLog.hasNextOrInProgressUnstableEnts() { ... }\\n\\t\\t//\\n\\t\\t// not like:\\n\\t\\t//\\n\\t\\t//  if len(rd.Entries) > 0 { ... }\\n\\t\\t//\\n\\t\\t// To do so, we attach r.raftLog.lastIndex() and r.raftLog.lastTerm(), not the\\n\\t\\t// (index, term) of the last entry in rd.Entries. If rd.Entries is not empty,\\n\\t\\t// these will be the same. However, if rd.Entries is empty, we still want to\\n\\t\\t// attest that this (index, term) is correct at the current term, in case the\\n\\t\\t// MsgStorageAppend that contained the last entry in the unstable slice carried\\n\\t\\t// an earlier term and was dropped.\\n\\t\\t//\\n\\t\\t// A MsgStorageAppend with a new term is emitted on each term change. This is\\n\\t\\t// the same condition that causes MsgStorageAppendResp messages with earlier\\n\\t\\t// terms to be ignored. As a result, we are guaranteed that, assuming a bounded\\n\\t\\t// number of term changes, there will eventually be a MsgStorageAppendResp\\n\\t\\t// message that is not ignored. This means that entries in the unstable log\\n\\t\\t// which have been appended to stable storage will eventually be truncated and\\n\\t\\t// dropped from memory.\\n\\t\\t//\\n\\t\\t// [^1]: https://en.wikipedia.org/wiki/ABA_problem\\n\\t\\tlast := r.raftLog.lastEntryID()\\n\\t\\tm.Index = last.index\\n\\t\\tm.LogTerm = last.term\\n\\t}\\n\\tif !IsEmptySnap(rd.Snapshot) {\\n\\t\\tsnap := rd.Snapshot\\n\\t\\tm.Snapshot = &snap\\n\\t}\\n\\treturn m\", \"version\": 1}\nbindings {\"associations\": [{\"claim_id\": \"C_stale_append_completion\", \"source_ids\": [\"S_completion_contract\", \"S_stable_contract\"], \"rationale\": \"Consumer site whose actual state effects will be observed; the independent expectation is the documented no-retirement contract.\"}], \"anchor\": {\"source_ids\": [\"S_election\"], \"boundary_complete\": false, \"kind\": \"declaration\", \"material_id\": \"S_election\", \"start_line\": 1085, \"end_line\": 1085, \"symbol\": \"Step\"}, \"material_id\": \"S_election\", \"id\": \"BIND_append_consume\", \"file\": \"raft.go\", \"symbol\": \"Step\", \"start_line\": 1085, \"end_line\": 1262, \"snapshot_id\": \"ddc487473bcb4bf28d237458ffdd5975\", \"content_digest\": \"4283c10e12c6da14964c6d6784a69851af1312245aa83925ec0e9426a07ed7bb\", \"basis\": \"agent_inference\", \"description\": \"Message-term dispatch and lower-term MsgStorageAppendResp branch prevent old entry completion from reaching stableTo, while handling snapshots separately.\", \"pending\": [], \"excerpt\": \"func (r *raft) Step(m pb.Message) error {\\n\\ttraceReceiveMessage(r, &m)\\n\\n\\t// Handle the message term, which may result in our stepping down to a follower.\\n\\tswitch {\\n\\tcase m.Term == 0:\\n\\t\\t// local message\\n\\tcase m.Term > r.Term:\\n\\t\\tif m.Type == pb.MsgVote || m.Type == pb.MsgPreVote {\\n\\t\\t\\tforce := bytes.Equal(m.Context, []byte(campaignTransfer))\\n\\t\\t\\tinLease := r.checkQuorum && r.lead != None && r.electionElapsed < r.electionTimeout\\n\\t\\t\\tif !force && inLease {\\n\\t\\t\\t\\t// If a server receives a RequestVote request within the minimum election timeout\\n\\t\\t\\t\\t// of hearing from a current leader, it does not update its term or grant its vote\\n\\t\\t\\t\\tlast := r.raftLog.lastEntryID()\\n\\t\\t\\t\\t// TODO(pav-kv): it should be ok to simply print the %+v of the lastEntryID.\\n\\t\\t\\t\\tr.logger.Infof(\\\"%x [logterm: %d, index: %d, vote: %x] ignored %s from %x [logterm: %d, index: %d] at term %d: lease is not expired (remaining ticks: %d)\\\",\\n\\t\\t\\t\\t\\tr.id, last.term, last.index, r.Vote, m.Type, m.From, m.LogTerm, m.Index, r.Term, r.electionTimeout-r.electionElapsed)\\n\\t\\t\\t\\treturn nil\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tswitch {\\n\\t\\tcase m.Type == pb.MsgPreVote:\\n\\t\\t\\t// Never change our term in response to a PreVote\\n\\t\\tcase m.Type == pb.MsgPreVoteResp && !m.Reject:\\n\\t\\t\\t// We send pre-vote requests with a term in our future. If the\\n\\t\\t\\t// pre-vote is granted, we will increment our term when we get a\\n\\t\\t\\t// quorum. If it is not, the term comes from the node that\\n\\t\\t\\t// rejected our vote so we should become a follower at the new\\n\\t\\t\\t// term.\\n\\t\\tdefault:\\n\\t\\t\\tr.logger.Infof(\\\"%x [term: %d] received a %s message with higher term from %x [term: %d]\\\",\\n\\t\\t\\t\\tr.id, r.Term, m.Type, m.From, m.Term)\\n\\t\\t\\tif m.Type == pb.MsgApp || m.Type == pb.MsgHeartbeat || m.Type == pb.MsgSnap {\\n\\t\\t\\t\\tr.becomeFollower(m.Term, m.From)\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tr.becomeFollower(m.Term, None)\\n\\t\\t\\t}\\n\\t\\t}\\n\\n\\tcase m.Term < r.Term:\\n\\t\\tif (r.checkQuorum || r.preVote) && (m.Type == pb.MsgHeartbeat || m.Type == pb.MsgApp) {\\n\\t\\t\\t// We have received messages from a leader at a lower term. It is possible\\n\\t\\t\\t// that these messages were simply delayed in the network, but this could\\n\\t\\t\\t// also mean that this node has advanced its term number during a network\\n\\t\\t\\t// partition, and it is now unable to either win an election or to rejoin\\n\\t\\t\\t// the majority on the old term. If checkQuorum is false, this will be\\n\\t\\t\\t// handled by incrementing term numbers in response to MsgVote with a\\n\\t\\t\\t// higher term, but if checkQuorum is true we may not advance the term on\\n\\t\\t\\t// MsgVote and must generate other messages to advance the term. The net\\n\\t\\t\\t// result of these two features is to minimize the disruption caused by\\n\\t\\t\\t// nodes that have been removed from the cluster's configuration: a\\n\\t\\t\\t// removed node will send MsgVotes (or MsgPreVotes) which will be ignored,\\n\\t\\t\\t// but it will not receive MsgApp or MsgHeartbeat, so it will not create\\n\\t\\t\\t// disruptive term increases, by notifying leader of this node's activeness.\\n\\t\\t\\t// The above comments also true for Pre-Vote\\n\\t\\t\\t//\\n\\t\\t\\t// When follower gets isolated, it soon starts an election ending\\n\\t\\t\\t// up with a higher term than leader, although it won't receive enough\\n\\t\\t\\t// votes to win the election. When it regains connectivity, this response\\n\\t\\t\\t// with \\\"pb.MsgAppResp\\\" of higher term would force leader to step down.\\n\\t\\t\\t// However, this disruption is inevitable to free this stuck node with\\n\\t\\t\\t// fresh election. This can be prevented with Pre-Vote phase.\\n\\t\\t\\tr.send(pb.Message{To: m.From, Type: pb.MsgAppResp})\\n\\t\\t} else if m.Type == pb.MsgPreVote {\\n\\t\\t\\t// Before Pre-Vote enable, there may have candidate with higher term,\\n\\t\\t\\t// but less log. After update to Pre-Vote, the cluster may deadlock if\\n\\t\\t\\t// we drop messages with a lower term.\\n\\t\\t\\tlast := r.raftLog.lastEntryID()\\n\\t\\t\\t// TODO(pav-kv): it should be ok to simply print %+v of the lastEntryID.\\n\\t\\t\\tr.logger.Infof(\\\"%x [logterm: %d, index: %d, vote: %x] rejected %s from %x [logterm: %d, index: %d] at term %d\\\",\\n\\t\\t\\t\\tr.id, last.term, last.index, r.Vote, m.Type, m.From, m.LogTerm, m.Index, r.Term)\\n\\t\\t\\tr.send(pb.Message{To: m.From, Term: r.Term, Type: pb.MsgPreVoteResp, Reject: true})\\n\\t\\t} else if m.Type == pb.MsgStorageAppendResp {\\n\\t\\t\\tif m.Index != 0 {\\n\\t\\t\\t\\t// Don't consider the appended log entries to be stable because\\n\\t\\t\\t\\t// they may have been overwritten in the unstable log during a\\n\\t\\t\\t\\t// later term. See the comment in newStorageAppendResp for more\\n\\t\\t\\t\\t// about this race.\\n\\t\\t\\t\\tr.logger.Infof(\\\"%x [term: %d] ignored entry appends from a %s message with lower term [term: %d]\\\",\\n\\t\\t\\t\\t\\tr.id, r.Term, m.Type, m.Term)\\n\\t\\t\\t}\\n\\t\\t\\tif m.Snapshot != nil {\\n\\t\\t\\t\\t// Even if the snapshot applied under a different term, its\\n\\t\\t\\t\\t// application is still valid. Snapshots carry committed\\n\\t\\t\\t\\t// (term-independent) state.\\n\\t\\t\\t\\tr.appliedSnap(m.Snapshot)\\n\\t\\t\\t}\\n\\t\\t} else {\\n\\t\\t\\t// ignore other cases\\n\\t\\t\\tr.logger.Infof(\\\"%x [term: %d] ignored a %s message with lower term from %x [term: %d]\\\",\\n\\t\\t\\t\\tr.id, r.Term, m.Type, m.From, m.Term)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t}\\n\\n\\tswitch m.Type {\\n\\tcase pb.MsgHup:\\n\\t\\tif r.preVote {\\n\\t\\t\\tr.hup(campaignPreElection)\\n\\t\\t} else {\\n\\t\\t\\tr.hup(campaignElection)\\n\\t\\t}\\n\\n\\tcase pb.MsgStorageAppendResp:\\n\\t\\tif m.Index != 0 {\\n\\t\\t\\tr.raftLog.stableTo(entryID{term: m.LogTerm, index: m.Index})\\n\\t\\t}\\n\\t\\tif m.Snapshot != nil {\\n\\t\\t\\tr.appliedSnap(m.Snapshot)\\n\\t\\t}\\n\\n\\tcase pb.MsgStorageApplyResp:\\n\\t\\tif len(m.Entries) > 0 {\\n\\t\\t\\tindex := m.Entries[len(m.Entries)-1].Index\\n\\t\\t\\tr.appliedTo(index, entsSize(m.Entries))\\n\\t\\t\\tr.reduceUncommittedSize(payloadsSize(m.Entries))\\n\\t\\t}\\n\\n\\tcase pb.MsgVote, pb.MsgPreVote:\\n\\t\\t// We can vote if this is a repeat of a vote we've already cast...\\n\\t\\tcanVote := r.Vote == m.From ||\\n\\t\\t\\t// ...we haven't voted and we don't think there's a leader yet in this term...\\n\\t\\t\\t(r.Vote == None && r.lead == None) ||\\n\\t\\t\\t// ...or this is a PreVote for a future term...\\n\\t\\t\\t(m.Type == pb.MsgPreVote && m.Term > r.Term)\\n\\t\\t// ...and we believe the candidate is up to date.\\n\\t\\tlastID := r.raftLog.lastEntryID()\\n\\t\\tcandLastID := entryID{term: m.LogTerm, index: m.Index}\\n\\t\\tif canVote && r.raftLog.isUpToDate(candLastID) {\\n\\t\\t\\t// Note: it turns out that that learners must be allowed to cast votes.\\n\\t\\t\\t// This seems counter- intuitive but is necessary in the situation in which\\n\\t\\t\\t// a learner has been promoted (i.e. is now a voter) but has not learned\\n\\t\\t\\t// about this yet.\\n\\t\\t\\t// For example, consider a group in which id=1 is a learner and id=2 and\\n\\t\\t\\t// id=3 are voters. A configuration change promoting 1 can be committed on\\n\\t\\t\\t// the quorum `{2,3}` without the config change being appended to the\\n\\t\\t\\t// learner's log. If the leader (say 2) fails, there are de facto two\\n\\t\\t\\t// voters remaining. Only 3 can win an election (due to its log containing\\n\\t\\t\\t// all committed entries), but to do so it will need 1 to vote. But 1\\n\\t\\t\\t// considers itself a learner and will continue to do so until 3 has\\n\\t\\t\\t// stepped up as leader, replicates the conf change to 1, and 1 applies it.\\n\\t\\t\\t// Ultimately, by receiving a request to vote, the learner realizes that\\n\\t\\t\\t// the candidate believes it to be a voter, and that it should act\\n\\t\\t\\t// accordingly. The candidate's config may be stale, too; but in that case\\n\\t\\t\\t// it won't win the election, at least in the absence of the bug discussed\\n\\t\\t\\t// in:\\n\\t\\t\\t// https://github.com/etcd-io/etcd/issues/7625#issuecomment-488798263.\\n\\t\\t\\tr.logger.Infof(\\\"%x [logterm: %d, index: %d, vote: %x] cast %s for %x [logterm: %d, index: %d] at term %d\\\",\\n\\t\\t\\t\\tr.id, lastID.term, lastID.index, r.Vote, m.Type, m.From, candLastID.term, candLastID.index, r.Term)\\n\\t\\t\\t// When responding to Msg{Pre,}Vote messages we include the term\\n\\t\\t\\t// from the message, not the local term. To see why, consider the\\n\\t\\t\\t// case where a single node was previously partitioned away and\\n\\t\\t\\t// it's local term is now out of date. If we include the local term\\n\\t\\t\\t// (recall that for pre-votes we don't update the local term), the\\n\\t\\t\\t// (pre-)campaigning node on the other end will proceed to ignore\\n\\t\\t\\t// the message (it ignores all out of date messages).\\n\\t\\t\\t// The term in the original message and current local term are the\\n\\t\\t\\t// same in the case of regular votes, but different for pre-votes.\\n\\t\\t\\tr.send(pb.Message{To: m.From, Term: m.Term, Type: voteRespMsgType(m.Type)})\\n\\t\\t\\tif m.Type == pb.MsgVote {\\n\\t\\t\\t\\t// Only record real votes.\\n\\t\\t\\t\\tr.electionElapsed = 0\\n\\t\\t\\t\\tr.Vote = m.From\\n\\t\\t\\t}\\n\\t\\t} else {\\n\\t\\t\\tr.logger.Infof(\\\"%x [logterm: %d, index: %d, vote: %x] rejected %s from %x [logterm: %d, index: %d] at term %d\\\",\\n\\t\\t\\t\\tr.id, lastID.term, lastID.index, r.Vote, m.Type, m.From, candLastID.term, candLastID.index, r.Term)\\n\\t\\t\\tr.send(pb.Message{To: m.From, Term: r.Term, Type: voteRespMsgType(m.Type), Reject: true})\\n\\t\\t}\\n\\n\\tdefault:\\n\\t\\terr := r.step(r, m)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t}\\n\\treturn nil\", \"version\": 1}\nbindings {\"associations\": [{\"claim_id\": \"C_stale_append_completion\", \"source_ids\": [\"S_stable_contract\", \"S_completion_contract\"], \"rationale\": \"Makes absence of retirement measurable in the original data structure without changing protocol logic.\"}], \"anchor\": {\"source_ids\": [\"S_unstable\"], \"boundary_complete\": true, \"kind\": \"declaration\", \"material_id\": \"S_unstable\", \"start_line\": 134, \"end_line\": 134, \"symbol\": \"stableTo\"}, \"material_id\": \"S_unstable\", \"id\": \"BIND_unstable_retire\", \"file\": \"log_unstable.go\", \"symbol\": \"stableTo\", \"start_line\": 134, \"end_line\": 160, \"snapshot_id\": \"ddc487473bcb4bf28d237458ffdd5975\", \"content_digest\": \"7763bee6d96a1327b675dd065259aeba3cc063a344ed70213141ac38d1146b57\", \"basis\": \"agent_inference\", \"description\": \"Entry identity check and actual prefix removal/offset update define the observed retirement endpoint.\", \"pending\": [], \"excerpt\": \"func (u *unstable) stableTo(id entryID) {\\n\\tgt, ok := u.maybeTerm(id.index)\\n\\tif !ok {\\n\\t\\t// Unstable entry missing. Ignore.\\n\\t\\tu.logger.Infof(\\\"entry at index %d missing from unstable log; ignoring\\\", id.index)\\n\\t\\treturn\\n\\t}\\n\\tif id.index < u.offset {\\n\\t\\t// Index matched unstable snapshot, not unstable entry. Ignore.\\n\\t\\tu.logger.Infof(\\\"entry at index %d matched unstable snapshot; ignoring\\\", id.index)\\n\\t\\treturn\\n\\t}\\n\\tif gt != id.term {\\n\\t\\t// Term mismatch between unstable entry and specified entry. Ignore.\\n\\t\\t// This is possible if part or all of the unstable log was replaced\\n\\t\\t// between that time that a set of entries started to be written to\\n\\t\\t// stable storage and when they finished.\\n\\t\\tu.logger.Infof(\\\"entry at (index,term)=(%d,%d) mismatched with \\\"+\\n\\t\\t\\t\\\"entry at (%d,%d) in unstable log; ignoring\\\", id.index, id.term, id.index, gt)\\n\\t\\treturn\\n\\t}\\n\\tnum := int(id.index + 1 - u.offset)\\n\\tu.entries = u.entries[num:]\\n\\tu.offset = id.index + 1\\n\\tu.offsetInProgress = max(u.offsetInProgress, u.offset)\\n\\tu.shrinkEntriesArray()\\n}\", \"version\": 1}\n=== RUN   TestAssuranceOldAppendCompletion\nraft2026/09/29 13:13:37 INFO: 1 switched to configuration voters=()\nraft2026/09/29 13:13:37 INFO: 1 became follower at term 0\nraft2026/09/29 13:13:37 INFO: newRaft 1 [peers: [], term: 0, commit: 0, applied: 0, lastindex: 0, lastterm: 0]\nraft2026/09/29 13:13:37 INFO: 1 became follower at term 1\nraft2026/09/29 13:13:37 INFO: 1 switched to configuration voters=(1)\nraft2026/09/29 13:13:37 INFO: 1 switched to configuration voters=(1 2)\nraft2026/09/29 13:13:37 INFO: 1 switched to configuration voters=(1 2 3)\nraft2026/09/29 13:13:37 INFO: 2 switched to configuration voters=()\nraft2026/09/29 13:13:37 INFO: 2 became follower at term 0\nraft2026/09/29 13:13:37 INFO: newRaft 2 [peers: [], term: 0, commit: 0, applied: 0, lastindex: 0, lastterm: 0]\nraft2026/09/29 13:13:37 INFO: 2 became follower at term 1\nraft2026/09/29 13:13:37 INFO: 2 switched to configuration voters=(1)\nraft2026/09/29 13:13:37 INFO: 2 switched to configuration voters=(1 2)\nraft2026/09/29 13:13:37 INFO: 2 switched to configuration voters=(1 2 3)\