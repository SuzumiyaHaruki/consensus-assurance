een configuration-driven maybeCommit and ReadIndex requests waiting for first current-term commit; determine the actual queue consumers and applicable completion contract before forming another Candidate.\"], \"understanding\": \"unchanged\", \"rationale\": \"Return to the accepted overview/frontier after the local result. Repeating the stale guard with more disclaimers adds less than an independent consumer path. A full overwrite history would deepen the same protection but require a longer multi-leader prefix; ReadIndex queue lifetime has client consequence but an unread completion contract; configuration activation already reuses retained matches and invokes maybeCommit without the acknowledgment branch's explicit pending-read release. Prefer reading that concrete connection next, preserving this completed measurement and without assuming the asymmetry is a defect.\", \"question_updates\": {\"45d41e2405de4b028bd8a31a7e3fc9b0\": {\"unknowns\": [\"One schedule does not cover competing overwrites, other term-transition paths, snapshot completion, crashes or application endpoints.\"], \"resume_conditions\": []}}}}]\n../agent-source/node.go:70:\t// Note that the readState will be returned when raft receives msgReadIndex.\n../agent-source/node.go:218:\t// ReadIndex request a read state. The read state will be set in the ready.\n../agent-source/node.go:223:\t// to retry ReadIndex.\n../agent-source/node.go:226:\t// passed into ReadIndex. Starting with release-3.7, this restriction is\n../agent-source/node.go:229:\tReadIndex(ctx context.Context, rctx []byte) error\n../agent-source/node.go:613:func (n *node) ReadIndex(ctx context.Context, rctx []byte) error {\n../agent-source/node.go:614:\treturn n.step(ctx, pb.Message{Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: rctx}}})\n../agent-source/rawnode.go:556:// ReadIndex requests a read state. The read state will be set in ready.\n../agent-source/rawnode.go:560:// See (Node).ReadIndex for more details.\n../agent-source/rawnode.go:561:func (rn *RawNode) ReadIndex(rctx []byte) {\n../agent-source/rawnode.go:562:\t_ = rn.raft.Step(pb.Message{Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: rctx}}})\n../agent-source/raft.go:65:\t// should (clock can move backward/pause without any bound). ReadIndex is not safe\n../agent-source/raft.go:239:\t// should (clock can move backward/pause without any bound). ReadIndex is not safe\n../agent-source/raft.go:428:\t// pendingReadIndexMessages is used to store messages of type MsgReadIndex\n../agent-source/raft.go:432:\tpendingReadIndexMessages []pb.Message\n../agent-source/raft.go:536:\t\t// do not attach term to MsgProp, MsgReadIndex\n../agent-source/raft.go:539:\t\t// MsgReadIndex is also forwarded to leader.\n../agent-source/raft.go:540:\t\tif m.Type != pb.MsgProp && m.Type != pb.MsgReadIndex {\n../agent-source/raft.go:1346:\tcase pb.MsgReadIndex:\n../agent-source/raft.go:1349:\t\t\tif resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.To != None {\n../agent-source/raft.go:1358:\t\t\tr.pendingReadIndexMessages = append(r.pendingReadIndexMessages, m)\n../agent-source/raft.go:1362:\t\tsendMsgReadIndexResponse(r, m)\n../agent-source/raft.go:1545:\t\t\t\t\treleasePendingReadIndexMessages(r)\n../agent-source/raft.go:1602:\t\t\tif resp := r.responseToReadIndexReq(rs.req, rs.index); resp.To != None {\n../agent-source/raft.go:1759:\tcase pb.MsgReadIndex:\n../agent-source/raft.go:1766:\tcase pb.MsgReadIndexResp:\n../agent-source/raft.go:1768:\t\t\tr.logger.Errorf(\"%x invalid format of MsgReadIndexResp from %x, entries count: %d\", r.id, m.From, len(m.Entries))\n../agent-source/raft.go:2068:// responseToReadIndexReq constructs a response for `req`. If `req` comes from the peer\n../agent-source/raft.go:2070:func (r *raft) responseToReadIndexReq(req pb.Message, readIndex uint64) pb.Message {\n../agent-source/raft.go:2079:\t\tType:    pb.MsgReadIndexResp,\n../agent-source/raft.go:2123:func releasePendingReadIndexMessages(r *raft) {\n../agent-source/raft.go:2124:\tif len(r.pendingReadIndexMessages) == 0 {\n../agent-source/raft.go:2130:\t\tr.logger.Error(\"pending MsgReadIndex should be released only after first commit in current term\")\n../agent-source/raft.go:2134:\tmsgs := r.pendingReadIndexMessages\n../agent-source/raft.go:2135:\tr.pendingReadIndexMessages = nil\n../agent-source/raft.go:2138:\t\tsendMsgReadIndexResponse(r, m)\n../agent-source/raft.go:2142:func sendMsgReadIndexResponse(r *raft, m pb.Message) {\n../agent-source/raft.go:2154:\t\tif resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.To != None {\n../agent-source/raft_test.go:1193:// readOnly readIndexQueue and pendingReadIndex map.\n../agent-source/raft_test.go:1205:\tsm.Step(pb.Message{From: 2, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: ctx}}})\n../agent-source/raft_test.go:1211:\trequire.Len(t, sm.readOnly.pendingReadIndex, 1)\n../agent-source/raft_test.go:1212:\t_, ok := sm.readOnly.pendingReadIndex[string(ctx)]\n../agent-source/raft_test.go:1220:\trequire.Empty(t, sm.readOnly.pendingReadIndex)\n../agent-source/raft_test.go:1221:\t_, ok = sm.readOnly.pendingReadIndex[string(ctx)]\n../agent-source/raft_test.go:1941:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n../agent-source/raft_test.go:1985:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n../agent-source/raft_test.go:2036:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n../agent-source/raft_test.go:2046:// TestReadOnlyForNewLeader ensures that a leader only accepts MsgReadIndex message\n../agent-source/raft_test.go:2085:\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: wctx}}})\n../agent-source/raft_test.go:2106:\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: wctx}}})\n","exit_code":0,"status":