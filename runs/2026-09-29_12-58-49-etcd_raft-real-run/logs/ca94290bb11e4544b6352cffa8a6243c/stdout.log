_and_fresh_read\\\",', 'caExploreEvent(\\\"gate_observed\\\",')\ns=s.replace('\\\"node\\\": 2, \\\"committed\\\": p.rn.raft.raftLog.committed, \\\"pending_reads\\\":', '\\\"node\\\": 2,\\\"term\\\":p.rn.raft.Term,\\\"current_term_committed\\\":p.currentCommit(),\\\"pending_request\\\":p.waiting(\\\"waiting-before-config\\\"), \\\"committed\\\": p.rn.raft.raftLog.committed, \\\"pending_reads\\\":')\nPath('read_gate_check_test.go').write_text(s)\nPY\ngofmt -w read_gate_check_test.go\ncp read_gate_check_test.go local-build/assurance_config_explore_test.go\nGOCACHE=\\\"\"'$PWD/local-go-cache\" GOTMPDIR=\"$PWD/local-go-tmp\" GOPROXY=off GOSUMDB=off go test -C local-build -run '\"'\"'^TestAssuranceReadGateRelease$'\"' -count=1 -v > local-read-gate-output.txt 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
