{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat ../agent-source/internal/raft/readindex.go; sed -n '815,853p' ../agent-source/internal/raft/raft.go; sed -n '290,407p' ../agent-source/internal/raft/logentry.go; sed -n '245,290p' ../agent-source/node.go; sed -n '1118,1188p' ../agent-source/node.go\"","aggregated_output":"// Copyright 2017-2020 Lei Ni (nilei81@gmail.com) and other contributors.\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\npackage raft\n\nimport (\n\t\"github.com/lni/dragonboat/v3/raftpb\"\n)\n\ntype readStatus struct {\n\tindex     uint64\n\tfrom      uint64\n\tctx       raftpb.SystemCtx\n\tconfirmed map[uint64]struct{}\n}\n\n// readIndex is the struct that implements the ReadIndex protocol described in\n// section 6.4 (with the idea in section 6.4.1 excluded) of Diego Ongaro's PhD\n// thesis.\ntype readIndex struct {\n\tpending map[raftpb.SystemCtx]*readStatus\n\tqueue   []raftpb.SystemCtx\n}\n\nfunc newReadIndex() *readIndex {\n\treturn &readIndex{\n\t\tpending: make(map[raftpb.SystemCtx]*readStatus),\n\t\tqueue:   make([]raftpb.SystemCtx, 0),\n\t}\n}\n\nfunc (r *readIndex) addRequest(index uint64,\n\tctx raftpb.SystemCtx, from uint64) {\n\tif _, ok := r.pending[ctx]; ok {\n\t\treturn\n\t}\n\t// index is the committed value of the cluster, it should never move\n\t// backward, check it here\n\tif len(r.queue) > 0 {\n\t\tp, ok := r.pending[r.peepCtx()]\n\t\tif !ok {\n\t\t\tpanic(\"inconsistent pending and queue\")\n\t\t}\n\t\tif index < p.index {\n\t\t\tplog.Panicf(\"index moved backward in readIndex, %d:%d\",\n\t\t\t\tindex, p.index)\n\t\t}\n\t}\n\tr.queue = append(r.queue, ctx)\n\tr.pending[ctx] = &readStatus{\n\t\tindex:     index,\n\t\tfrom:      from,\n\t\tctx:       ctx,\n\t\tconfirmed: make(map[uint64]struct{}),\n\t}\n}\n\nfunc (r *readIndex) hasPendingRequest() bool {\n\treturn len(r.queue) > 0\n}\n\nfunc (r *readIndex) peepCtx() raftpb.SystemCtx {\n\treturn r.queue[len(r.queue)-1]\n}\n\nfunc (r *readIndex) confirm(ctx raftpb.SystemCtx,\n\tfrom uint64, quorum int) []*readStatus {\n\tp, ok := r.pending[ctx]\n\tif !ok {\n\t\treturn nil\n\t}\n\tp.confirmed[from] = struct{}{}\n\tif len(p.confirmed)+1 < quorum {\n\t\treturn nil\n\t}\n\tdone := 0\n\tcs := []*readStatus{}\n\tfor _, pctx := range r.queue {\n\t\tdone++\n\t\ts, ok := r.pending[pctx]\n\t\tif !ok {\n\t\t\tpanic(\"inconsistent pending and queue content\")\n\t\t}\n\t\tcs = append(cs, s)\n\t\tif pctx == ctx {\n\t\t\tfor _, v := range cs {\n\t\t\t\tif v.index > s.index {\n\t\t\t\t\tpanic(\"v.index > s.index is unexpected\")\n\t\t\t\t}\n\t\t\t\t// re-write the index for extra safety.\n\t\t\t\t// we don't know what we don't know.\n\t\t\t\tv.index = s.index\n\t\t\t}\n\t\t\tr.queue = r.queue[done:]\n\t\t\tfor _, v := range cs {\n\t\t\t\tdelete(r.pending, v.ctx)\n\t\t\t}\n\t\t\tif len(r.queue) != len(r.pending) {\n\t\t\t\tpanic(\"inconsistent length\")\n\t\t\t}\n\t\t\treturn cs\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *raft) sendHeartbeatMessage(to uint64,\n\thint pb.SystemCtx, match uint64) {\n\tcommit := min(match, r.log.committed)\n\tr.send(pb.Message{\n\t\tTo:       to,\n\t\tType:     pb.Heartbeat,\n\t\tCommit:   commit,\n\t\tHint:     hint.Low,\n\t\tHintHigh: hint.High,\n\t})\n}\n\n// p72 of the raft thesis describe how to use Heartbeat message in the ReadIndex\n// protocol.\nfunc (r *raft) broadcastHeartbeatMessage() {\n\tr.mustBeLeader()\n\tif r.readIndex.hasPendingRequest() {\n\t\tctx := r.readIndex.peepCtx()\n\t\tr.broadcastHeartbeatMessageWithHint(ctx)\n\t} else {\n\t\tr.broadcastHeartbeatMessageWithHint(pb.SystemCtx{})\n\t}\n}\n\nfunc (r *raft) broadcastHeartbeatMessageWithHint(ctx pb.SystemCtx) {\n\tzeroCtx := pb.SystemCtx{}\n\tfor id, rm := range r.votingMembers() {\n\t\tif id != r.nodeID {\n\t\t\tr.sendHeartbeatMessage(id, ctx, rm.match)\n\t\t}\n\t}\n\tif ctx == zeroCtx {\n\t\tfor id, rm := range r.observers {\n\t\t\tr.sendHeartbeatMessage(id, zeroCtx, rm.match)\n\t\t}\n\t}\n}\n\nfunc (r *raft) sendTimeoutNowMessage(nodeID uint64) {\nfunc (l *entryLog) tryAppend(index uint64, ents []pb.Entry) bool {\n\tconflictIndex := l.getConflictIndex(ents)\n\tif conflictIndex != 0 {\n\t\tif conflictIndex <= l.committed {\n\t\t\tplog.Panicf(\"entry %d conflicts with committed entry, committed %d\",\n\t\t\t\tconflictIndex, l.committed)\n\t\t}\n\t\tl.append(ents[conflictIndex-index-1:])\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc (l *entryLog) append(entries []pb.Entry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tif entries[0].Index <= l.committed {\n\t\tplog.Panicf(\"committed entries being changed, committed %d, first idx %d\",\n\t\t\tl.committed, entries[0].Index)\n\t}\n\tl.inmem.merge(entries)\n}\n\nfunc (l *entryLog) getConflictIndex(entries []pb.Entry) uint64 {\n\tfor _, e := range entries {\n\t\tif !l.matchTerm(e.Index, e.Term) {\n\t\t\treturn e.Index\n\t\t}\n\t}\n\treturn 0\n}\n\nfunc (l *entryLog) commitTo(index uint64) {\n\tif index <= l.committed {\n\t\treturn\n\t}\n\tif index > l.lastIndex() {\n\t\tplog.Panicf(\"invalid commitTo index %d, lastIndex() %d\",\n\t\t\tindex, l.lastIndex())\n\t}\n\tl.committed = index\n}\n\nfunc (l *entryLog) commitUpdate(cu pb.UpdateCommit) {\n\tl.inmem.commitUpdate(cu)\n\tif cu.Processed > 0 {\n\t\tif cu.Processed < l.processed || cu.Processed > l.committed {\n\t\t\tplog.Panicf(\"invalid ApplyReturnedTo %d, current applied %d, committed %d\",\n\t\t\t\tcu.Processed, l.processed, l.committed)\n\t\t}\n\t\tl.processed = cu.Processed\n\t}\n\tif cu.LastApplied > 0 {\n\t\tif cu.LastApplied > l.committed {\n\t\t\tplog.Panicf(\"invalid last applied %d, committed %d\",\n\t\t\t\tcu.LastApplied, l.committed)\n\t\t}\n\t\tif cu.LastApplied > l.processed {\n\t\t\tplog.Panicf(\"invalid last applied %d, processed %d\",\n\t\t\t\tcu.LastApplied, l.processed)\n\t\t}\n\t\tl.inmem.appliedLogTo(cu.LastApplied)\n\t}\n}\n\nfunc (l *entryLog) matchTerm(index uint64, term uint64) bool {\n\tlt, err := l.term(index)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn lt == term\n}\n\nfunc (l *entryLog) upToDate(index uint64, term uint64) bool {\n\tlastTerm, err := l.term(l.lastIndex())\n\tif err != nil {\n\t\tplog.Panicf(\"failed to get the last term, %v\", err)\n\t}\n\tif term >= lastTerm {\n\t\tif term > lastTerm {\n\t\t\treturn true\n\t\t}\n\t\treturn index >= l.lastIndex()\n\t}\n\treturn false\n}\n\nfunc (l *entryLog) tryCommit(index uint64, term uint64) bool {\n\tif index <= l.committed {\n\t\treturn false\n\t}\n\tlterm, err := l.term(index)\n\tif err == ErrCompacted {\n\t\tlterm = 0\n\t} else if err != nil {\n\t\tpanic(err)\n\t}\n\tif index > l.committed && lterm == term {\n\t\tl.commitTo(index)\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc (l *entryLog) restore(s pb.Snapshot) {\n\tl.inmem.restore(s)\n\tl.committed = s.Index\n\tl.processed = s.Index\n}\n\t}\n\tif !ignored {\n\t\tif e.Key == 0 {\n\t\t\tplog.Panicf(\"key is 0\")\n\t\t}\n\t\tn.pendingProposals.applied(e.ClientID, e.SeriesID, e.Key, result, rejected)\n\t}\n}\n\nfunc (n *node) ApplyConfigChange(cc pb.ConfigChange,\n\tkey uint64, rejected bool) {\n\tn.raftMu.Lock()\n\tdefer n.raftMu.Unlock()\n\tif !rejected {\n\t\tn.applyConfigChange(cc)\n\t}\n\tn.configChangeProcessed(key, rejected)\n}\n\nfunc (n *node) applyConfigChange(cc pb.ConfigChange) {\n\tn.p.ApplyConfigChange(cc)\n\tswitch cc.Type {\n\tcase pb.AddNode, pb.AddObserver, pb.AddWitness:\n\t\tn.nodeRegistry.Add(n.clusterID, cc.NodeID, cc.Address)\n\tcase pb.RemoveNode:\n\t\tif cc.NodeID == n.nodeID {\n\t\t\tplog.Infof(\"%s applied ConfChange Remove for itself\", n.id())\n\t\t\tn.nodeRegistry.RemoveCluster(n.clusterID)\n\t\t\tn.requestRemoval()\n\t\t} else {\n\t\t\tn.nodeRegistry.Remove(n.clusterID, cc.NodeID)\n\t\t}\n\tdefault:\n\t\tplog.Panicf(\"unknown config change type, %s\", cc.Type)\n\t}\n}\n\nfunc (n *node) configChangeProcessed(key uint64, rejected bool) {\n\tif n.isWitness() {\n\t\treturn\n\t}\n\tif rejected {\n\t\tn.p.RejectConfigChange()\n\t} else {\n\t\tn.notifyConfigChange()\n\t}\nfunc (n *node) stepNode() (pb.Update, bool) {\n\tn.raftMu.Lock()\n\tdefer n.raftMu.Unlock()\n\tif n.initialized() {\n\t\tif n.handleEvents() {\n\t\t\tif n.qs.newQuiesceState() {\n\t\t\t\tn.sendEnterQuiesceMessages()\n\t\t\t}\n\t\t\treturn n.getUpdate()\n\t\t}\n\t}\n\treturn pb.Update{}, false\n}\n\nfunc (n *node) handleEvents() bool {\n\thasEvent := false\n\tlastApplied := n.updateAppliedIndex()\n\tif lastApplied != n.confirmedIndex {\n\t\thasEvent = true\n\t}\n\tif n.hasEntryToApply() {\n\t\thasEvent = true\n\t}\n\tif n.handleReadIndex() {\n\t\thasEvent = true\n\t}\n\tif n.handleReceivedMessages() {\n\t\thasEvent = true\n\t}\n\tif n.handleConfigChange() {\n\t\thasEvent = true\n\t}\n\tif n.handleProposals() {\n\t\thasEvent = true\n\t}\n\tif n.handleLeaderTransfer() {\n\t\thasEvent = true\n\t}\n\tif n.handleSnapshot(lastApplied) {\n\t\thasEvent = true\n\t}\n\tif n.handleCompaction() {\n\t\thasEvent = true\n\t}\n\tn.gc()\n\tif hasEvent {\n\t\tn.pendingReadIndexes.applied(lastApplied)\n\t}\n\treturn hasEvent\n}\n\nfunc (n *node) gc() {\n\tif n.gcTick != n.currentTick {\n\t\tn.pendingProposals.gc()\n\t\tn.pendingConfigChange.gc()\n\t\tn.pendingSnapshot.gc()\n\t\tn.gcTick = n.currentTick\n\t}\n}\n\nfunc (n *node) handleCompaction() bool {\n\treturn n.ss.hasCompactedTo() || n.ss.hasCompactLogTo()\n}\n\nfunc (n *node) handleLeaderTransfer() bool {\n\ttarget, ok := n.pendingLeaderTransfer.get()\n\tif ok {\n\t\tn.p.RequestLeaderTransfer(target)\n\t}\n\treturn ok\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"I found a read-index correlation question worth retaining: one quorum confirmation can release several queued requests, but the remote-response path uses the confirming heartbeat’s context for each response. The local path uses each request’s saved context. I’ll record that difference as unresolved; caller-side correlation and a legal overlapping history still need investigation.\n"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > build_initial.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind='code_observation')); return i\nraft='internal/raft/raft.go'\nfor x in [('S-form',raft,864,929),('S-context',raft,931,1135),('S-terms',raft,1393,1564),('S-responses',raft,1616,1740),('S-dispatch',raft,2029,2163),('S-membership',raft,1137,1225),('S-recovery',raft,447,529),('S-receive',raft,1316,1391),('S-readreply',raft,1771,1790),('S-heartbeat',raft,815,851),('S-readqueue','internal/raft/readindex.go',20,118),('S-peer','internal/raft/peer.go',184,243),('S-update','internal/raft/peer.go',283,358),('S-engine','engine.go',1286,1368),('S-nodeupdate','node.go',987,1100),('S-log','internal/raft/logentry.go',290,399),('S-configapply','node.go',252,289),('S-nodeevents','node.go',1118,1174)]: src(*x)\ndef beh(i,a,owner,trigger,ss,**kw):\n return dict(id=i,primary_activity=a,execution_owner=owner,protocol_context='One cluster replica and its current term, log and membership',trigger=trigger,source_ids=ss,**kw)\nbs=[\nbeh('B-replicate','A1','raft leader and follower handlers','Leader proposal; Replicate or ReplicateResp delivery',['S-form','S-responses','S-receive','S-log','S-peer','S-dispatch'],implementation_guards=['Peer.Handle rejects responses from unknown members; leader response wrapper requires a remote, observer or witness record.','Follower requires matching previous log term; conflicting committed entries panic; commitment is monotonic.','Leader selects quorum match from voters and witnesses, excluding observers; entryLog.tryCommit requires the selected entry term to equal the current term.'],writes=['Proposal entries receive current term and consecutive indices; local match advances.','Successful replication response advances sender progress; commitment advancement broadcasts replication. Rejections may decrease next and retry.'],produces_fact_ids=['F-commit'],consumes_fact_ids=['F-context'],async_boundaries=['Messages are queued in raft.msgs; engine persists updates and sends replies later.']),\nbeh('B-authority','A2','raft state transition and election handlers','Election, vote request/response, or differing message term',['S-context','S-terms','S-dispatch','S-peer','S-log'],implementation_guards=['Campaign is suppressed while committed entries exceed applied position; vote requires eligibility under previous vote and up-to-date log.','Unknown response senders are filtered by Peer.Handle and observer vote responses are rejected by candidate handler.','Higher-term vote requests can be ignored during a recent-leader check-quorum interval; other higher terms change authority; lower-term messages are ignored.'],writes=['Candidate increments term and votes for self; a quorum of votes promotes it.','Reset clears election votes, pending read-index tracker, leader transfer and remote progress; term change clears persistent vote. Log and committed prefix survive reset.','New leader scans unapplied configuration entries and appends a current-term empty entry.'],produces_fact_ids=['F-context'],consumes_fact_ids=['F-commit'],cross_activity_effects={'A1':'Fresh remote progress and current-term commitment prevent simply reusing a previous leader replication tally.'}),\nbeh('B-membership','A4','node.ApplyConfigChange and raft membership handlers','Applied configuration callback under raftMu',['S-configapply','S-membership','S-terms'],writes=['Add/promote/remove modifies membership maps; observer promotion inherits its replication progress.','Removal of local leader steps down. Removing another member can immediately recompute commitment and broadcast.'],consumes_fact_ids=['F-context'],cross_activity_effects={'A1':'Membership controls quorum and eligible replication progress.','A2':'Local removal ends leadership and applied position gates campaigning.'},unknowns=['RSM membership acceptance, ordered-change policy and exact applied-index callback ordering remain unread.']),\nbeh('B-persist','A6','engine.processSteps and Peer update/commit interface','Node step produces an Update',['S-engine','S-peer','S-update','S-nodeupdate'],writes=['GetUpdate collects state, messages, unstable entries, committed entries and snapshot. Commit marks the processed update and clears outgoing buffers.'],durable_effects=['SaveRaftState is called before ordinary message sending; backend durability and reload have not been traced.'],external_effects=['Replicate/Ping messages may be sent before SaveRaftState. FastApply can enqueue committed work before save only when setFastApply permits it; overlapping unstable entries disable FastApply.','Other messages are sent by processRaftUpdate after SaveRaftState.'],consumes_fact_ids=['F-commit','F-context'],cross_activity_effects={'A1':'Reply transmission follows persistence call; replication transmission has a separate earlier path.','A5':'Committed entries are queued for application, with a FastApply branch.'},unknowns=['Storage backend durability contract and restart reconstruction are not yet inspected.']),\nbeh('B-snapshot','A3','raft.restore and restoreRemotes','InstallSnapshot and later SnapshotReceived events',['S-recovery','S-receive','S-log'],implementation_guards=['Reject snapshot index at or below committed. Matching local index/term advances commitment without replacing the log.'],writes=['Unmatched newer snapshot restores log committed/processed positions. restoreRemotes separately rebuilds membership and progress from snapshot membership.'],produces_fact_ids=['F-commit'],cross_activity_effects={'A1':'Snapshot can establish a committed prefix.','A2':'Restored membership can promote an observer or remove leader authority.'},unknowns=['Ordering between snapshot persistence, state-machine recovery and restoreRemotes remains to be traced.']),\nbeh('B-read','A1','raft leader read-index handler and readIndex tracker','ReadIndex request and matching heartbeat confirmation',['S-responses','S-heartbeat','S-readqueue','S-readreply'],implementation_guards=['Multi-voter leader requires a committed entry in its current term. Context-bearing heartbeats go to voters and witnesses.','Tracker deduplicates contexts and confirmations by sender; confirmation counts leader implicitly.'],writes=['Records requesting node, context and committed index. Quorum confirmation releases queued requests through the confirmed context and rewrites released indices to that context index.'],external_effects=['Local completions use each released request context. Remote ReadIndexResp uses each released request destination and index but the confirming message Hint/HintHigh.'],produces_fact_ids=['F-readpending'],consumes_fact_ids=['F-context','F-commit'],unknowns=['Does remote completion correlation preserve each released request identity under overlapping requests with distinct contexts? Trace context producer and recipient.']),\nbeh('B-consume','A5','node processReadyToRead and update/application queue','Engine processes updates or node observes applied index',['S-nodeupdate','S-nodeevents','S-update'],external_effects=['Committed entries are pushed to application queue. ReadyToReads are passed to pendingReadIndexes and checked against LastApplied.','handleEvents updates applied position and rechecks pending reads after events.'],consumes_fact_ids=['F-commit'],unknowns=['RSM application, callback completion and pending read request correlation need further reading.'])]\nfs=[dict(id='F-context',meaning='Replica current term and role provide the context used by term-qualified dispatch; term changes clear the vote and resets replace volatile support trackers.',identity={'cluster':'clusterID','replica':'nodeID'},validity_context='Current in-memory raft term and role; membership is independently mutable.',representation=['raft.term','raft.state','raft.vote','raft.leaderID'],durability='Term and vote are exposed in Update.State; actual durability is delegated to SaveRaftState and not yet traced.',recovery='Startup reload remains unread.',source_ids=['S-context','S-terms','S-update'],invalidators=['B-authority'],reinterpreters=['B-membership']),dict(id='F-commit',meaning='Replica records a log prefix through committed as committed; leader quorum/current-term commitment, accepted leader replication/heartbeat and snapshot restore are distinct establishment paths.',identity={'cluster':'clusterID','replica':'nodeID','prefix':'log.committed'},validity_context='Replica log history and current membership; not a statement of application completion or persisted backend state.',representation=['entryLog.committed'],durability='Exposed in raft State and saved through update processing; backend guarantee unread.',recovery='Snapshot restore sets committed and processed; restart path unread.',source_ids=['S-form','S-log','S-receive','S-recovery']),dict(id='F-readpending',meaning='A pending read-index request retains its request context, origin and sampled committed index until confirmation removes it; this does not establish remote response correlation.',identity={'cluster':'clusterID','context':'SystemCtx.High and Low'},validity_context='One leader readIndex instance between resets; indices may be raised when a later queued context confirms.',representation=['readIndex.pending','readIndex.queue','readStatus'],durability='Volatile, reset with authority transition.',recovery='Not restored; client completion/retry behavior unread.',source_ids=['S-readqueue','S-readreply','S-context'],invalidators=['B-authority'])]\nroles=json.load(open('../research.json'))['activity_roles']\nacts=[]\nfor a in roles:\n ids=[b['id'] for b in bs if b['primary_activity']==a]\n acts.append(dict(class_id=a,applicability='unknown' if a=='A7' else 'applicable',purpose=roles[a]['relation'],realization_summary={'A1':'Replicated prefix commitment and quorum-confirmed read indices.','A2':'Term-qualified dispatch, election and authority reset.','A3':'Snapshot log restore and separate participant restoration.','A4':'Applied membership callbacks modify participation and quorum.','A5':'Committed work and read readiness feed application-side queues.','A6':'Update batching controls save/send/application ordering.','A7':'Client request completion and retries have not yet been traced.'}[a],source_ids=sorted(set(s for b in bs if b['primary_activity']==a for s in b['source_ids'])),unknowns=['Client completion contract remains unread.'] if a=='A7' else []))\ndef path(ex,ids,ss,fs=[]):return dict(explanation=ex,behavior_ids=ids,source_ids=ss,fact_ids=fs)\nm=dict(version=1,target_profile=dict(system_boundary='Captured Dragonboat Go implementation, from internal Raft Peer through node/engine integration; initial partial map, not a complete deployment or storage audit.',protocol_contexts=['Per-cluster term, membership and replicated log'],external_interfaces=['Peer.Handle/GetUpdate/Commit','node.ApplyConfigChange','logdb.SaveRaftState'],source_ids=['S-peer','S-update','S-engine','S-configapply']),activities=acts,behaviors=bs,facts=fs,surfaces=[dict(entry_point='raft.handleReadIndexLeaderConfirmation',disposition='mapped',behavior_ids=['B-read'],reason='Sourced local/remote context handling difference when confirm releases multiple queued requests; obligation and legal history unresolved.',source_ids=['S-readqueue','S-readreply'],high_consequence=True),dict(entry_point='RSM recovery and membership application callbacks',disposition='deferred',reason='Complete recovery/application ordering is needed before declaring the backbone usable.',source_ids=['S-recovery','S-configapply'],high_consequence=True)],core_overview=dict(status='incomplete',formation=path('Leader assigns term/index to proposals, followers validate previous log term and protect committed history, and eligible member responses advance replication progress. Voter/witness quorum match plus current-term log check advances leader commitment, propagated through replication and bounded heartbeat commit. Engine splits early replication from post-save replies and queues committed work for application.',['B-replicate','B-persist','B-consume'],['S-form','S-receive','S-log','S-engine'],['F-commit']),context=path('Election establishes a new term and self vote; up-to-date eligible voting responses establish leadership. Term dispatch rejects stale messages and resets volatile support on authority changes. Peer filters unknown response senders before raft dispatch. Membership application can remove leadership or promote observers.',['B-authority','B-membership'],['S-context','S-terms','S-peer','S-dispatch','S-membership'],['F-context']),connection=path('Committed history survives role reset while vote tallies, replication match and pending read-index trackers do not. New leaders append a current-term entry before quorum-dependent reads can proceed. Campaigning waits for committed work to be applied, guarding stale membership; membership changes alter eligible support and removal can trigger a new commitment calculation. Snapshot state and membership restoration are separate entries whose completion order still needs investigation.',['B-authority','B-read','B-membership','B-snapshot'],['S-context','S-terms','S-responses','S-recovery','S-membership'],['F-context','F-commit','F-readpending']),core_gaps=['Trace restart/state-machine recovery and the snapshot-to-membership handoff.','Trace committed entry application, configuration acceptance and completion callbacks to establish the complete formation/consumption backbone.'],open_details=['Remote read-index response context differs from the released request context; legality and consumer impact remain open.'],rationale='Initial source-backed partial map preserves actual guards and a local discrepancy without asserting readiness or a defect.'))\njson.dump(m,open('initial-map.json','w'),indent=2)\nsub=dict(action='research',rationale='Retain the initial partial backbone and sourced read-inde