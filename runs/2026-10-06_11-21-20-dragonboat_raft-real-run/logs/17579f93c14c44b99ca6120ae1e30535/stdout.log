     \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"class_id\",\n        \"applicability\",\n        \"purpose\",\n        \"realization_summary\"\n      ],\n      \"title\": \"Activity\",\n      \"type\": \"object\"\n    },\n    \"Behavior\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"primary_activity\": {\n          \"enum\": [\n            \"A1\",\n            \"A2\",\n            \"A3\",\n            \"A4\",\n            \"A5\",\n            \"A6\",\n            \"A7\"\n          ],\n          \"title\": \"Primary Activity\",\n          \"type\": \"string\"\n        },\n        \"execution_owner\": {\n          \"title\": \"Execution Owner\",\n          \"type\": \"string\"\n        },\n        \"protocol_context\": {\n          \"title\": \"Protocol Context\",\n          \"type\": \"string\"\n        },\n        \"trigger\": {\n          \"title\": \"Trigger\",\n          \"type\": \"string\"\n        },\n        \"legal_preconditions\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Legal Preconditions\",\n          \"type\": \"array\"\n        },\n        \"implementation_guards\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Implementation Guards\",\n          \"type\": \"array\"\n        },\n        \"reads\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Reads\",\n          \"type\": \"array\"\n        },\n        \"writes\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Writes\",\n          \"type\": \"array\"\n        },\n        \"durable_effects\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Durable Effects\",\n          \"type\": \"array\"\n        },\n        \"external_effects\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"External Effects\",\n          \"type\": \"array\"\n        },\n        \"important_branches\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Important Branches\",\n          \"type\": \"array\"\n        },\n        \"async_boundaries\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Async Boundaries\",\n          \"type\": \"array\"\n        },\n        \"produces_fact_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Produces Fact Ids\",\n          \"type\": \"array\"\n        },\n        \"consumes_fact_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Consumes Fact Ids\",\n          \"type\": \"array\"\n        },\n        \"cross_activity_effects\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee\",\n          \"propertyNames\": {\n            \"enum\": [\n              \"A1\",\n              \"A2\",\n              \"A3\",\n              \"A4\",\n              \"A5\",\n          