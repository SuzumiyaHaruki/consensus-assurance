se,\n\t\tEntries: []pb.Entry{{Type: pb.ConfigChangeEntry, Cmd: data, Key: key}},\n\t})\n}\n\n// ApplyConfigChange applies a raft membership change to the local raft node.\nfunc (p *Peer) ApplyConfigChange(cc pb.ConfigChange) {\n\tif cc.NodeID == NoLeader {\n\t\tp.raft.clearPendingConfigChange()\n\t\treturn\n\t}\n\tp.raft.Handle(pb.Message{\n\t\tType:     pb.ConfigChangeEvent,\n\t\tReject:   false,\n\t\tHint:     cc.NodeID,\n\t\tHintHigh: uint64(cc.Type),\n\t})\n}\n\n// RejectConfigChange rejects the currently pending raft membership change.\nfunc (p *Peer) RejectConfigChange() {\n\tp.raft.Handle(pb.Message{\n\t\tType:   pb.ConfigChangeEvent,\n\t\tReject: true,\n\t})\n}\n\n// RestoreRemotes applies the remotes info obtained from the specified snapshot.\nfunc (p *Peer) RestoreRemotes(ss pb.Snapshot) {\n\tp.raft.Handle(pb.Message{\n\t\tType:     pb.SnapshotReceived,\n\t\tSnapshot: ss,\n\t})\n}\n\n// ReportUnreachableNode marks the specified node as not reachable.\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/__pycache__/direct_checks.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/plugins/implementations/toy/__pycache__/adapter.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/plugins/implementations/hashicorp_raft/__pycache__/adapter.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/cargo.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/python.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/experiment.cpython-310.pyc: binary file matches\ngrep: /home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/__pycache__/go_module.cpython-310.py