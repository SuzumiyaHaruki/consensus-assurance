{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '179,240p' ../agent-source/internal/logdb/db.go; sed -n '145,185p' ../agent-source/internal/logdb/sharded.go; sed -n '1273,1300p' ../agent-source/node.go; grep -n 'func .*NodeState\\\\|func .*SetState\\\\|func .*ApplySnapshot' ../agent-source/internal/logdb/logreader.go; sed -n '547,594p' ../agent-source/internal/rsm/statemachine.go; sed -n '1105,1118p' ../agent-source/node.go\"","aggregated_output":"func (r *db) saveRaftState(updates []pb.Update, ctx IContext) error {\n\twb := r.getWriteBatch(ctx)\n\tfor _, ud := range updates {\n\t\tr.saveState(ud.ClusterID, ud.NodeID, ud.State, wb, ctx)\n\t\tif !pb.IsEmptySnapshot(ud.Snapshot) {\n\t\t\tif len(ud.EntriesToSave) > 0 {\n\t\t\t\t// raft/inMemory makes sure such entries no longer need to be saved\n\t\t\t\tlastIndex := ud.EntriesToSave[len(ud.EntriesToSave)-1].Index\n\t\t\t\tif ud.Snapshot.Index > lastIndex {\n\t\t\t\t\tplog.Panicf(\"max index not handled, %d, %d\",\n\t\t\t\t\t\tud.Snapshot.Index, lastIndex)\n\t\t\t\t}\n\t\t\t}\n\t\t\tr.saveSnapshot(wb, ud)\n\t\t\tr.setMaxIndex(wb, ud, ud.Snapshot.Index, ctx)\n\t\t}\n\t}\n\tr.saveEntries(updates, wb, ctx)\n\tif wb.Count() > 0 {\n\t\treturn r.kvs.CommitWriteBatch(wb)\n\t}\n\treturn nil\n}\n\nfunc (r *db) importSnapshot(ss pb.Snapshot, nodeID uint64) error {\n\tif ss.Type == pb.UnknownStateMachine {\n\t\tpanic(\"Unknown state machine type\")\n\t}\n\tsnapshots, err := r.listSnapshots(ss.ClusterId, nodeID, math.MaxUint64)\n\tif err != nil {\n\t\treturn err\n\t}\n\tselectedss := make([]pb.Snapshot, 0)\n\tfor _, curss := range snapshots {\n\t\tif curss.Index >= ss.Index {\n\t\t\tselectedss = append(selectedss, curss)\n\t\t}\n\t}\n\twb := r.getWriteBatch(nil)\n\tbsrec := pb.Bootstrap{\n\t\tJoin: true,\n\t\tType: ss.Type,\n\t}\n\tstate := pb.State{\n\t\tTerm:   ss.Term,\n\t\tCommit: ss.Index,\n\t}\n\tr.saveRemoveNodeData(wb, selectedss, ss.ClusterId, nodeID)\n\tr.saveBootstrap(wb, ss.ClusterId, nodeID, bsrec)\n\tr.saveStateAllocs(wb, ss.ClusterId, nodeID, state)\n\tr.saveSnapshot(wb, pb.Update{\n\t\tClusterID: ss.ClusterId,\n\t\tNodeID:    nodeID,\n\t\tSnapshot:  ss,\n\t})\n\tr.saveMaxIndex(wb, ss.ClusterId, nodeID, ss.Index, nil)\n\treturn r.kvs.CommitWriteBatch(wb)\n}\n\nfunc (r *db) setMaxIndex(wb kv.IWriteBatch,\n\tud pb.Update, maxIndex uint64, ctx IContext) {\n\tr.cs.setMaxIndex(ud.ClusterID, ud.NodeID, maxIndex)\n\t\t}\n\t}\n\treturn false, nil\n}\n\n// SaveRaftState saves the raft state and logs found in the raft.Update list\n// to the log db.\nfunc (s *ShardedDB) SaveRaftState(updates []pb.Update, shardID uint64) error {\n\tif shardID-1 >= uint64(len(s.ctxs)) {\n\t\tplog.Panicf(\"invalid shardID %d, len(s.ctxs): %d\", shardID, len(s.ctxs))\n\t}\n\tctx := s.ctxs[shardID-1]\n\tctx.Reset()\n\treturn s.SaveRaftStateCtx(updates, ctx)\n}\n\n// GetLogDBThreadContext return an IContext instance. This method is expected\n// to be used in benchmarks and tests only.\nfunc (s *ShardedDB) GetLogDBThreadContext() IContext {\n\treturn newContext(s.config.SaveBufferSize, s.config.MaxSaveBufferSize)\n}\n\n// SaveRaftStateCtx saves the raft state and logs found in the raft.Update list\n// to the log db.\nfunc (s *ShardedDB) SaveRaftStateCtx(updates []pb.Update, ctx IContext) error {\n\tif len(updates) == 0 {\n\t\treturn nil\n\t}\n\tpid := s.getParititionID(updates)\n\treturn s.shards[pid].saveRaftState(updates, ctx)\n}\n\n// ReadRaftState returns the persistent state of the specified raft node.\nfunc (s *ShardedDB) ReadRaftState(clusterID uint64,\n\tnodeID uint64, lastIndex uint64) (raftio.RaftState, error) {\n\tidx := s.partitioner.GetPartitionID(clusterID)\n\treturn s.shards[idx].readRaftState(clusterID, nodeID, lastIndex)\n}\n\n// ListNodeInfo lists all available NodeInfo found in the log db.\nfunc (s *ShardedDB) ListNodeInfo() ([]raftio.NodeInfo, error) {\n\nfunc (n *node) handleReceivedMessages() bool {\n\tcount := uint64(0)\n\tbusy := n.isBusySnapshotting()\n\tmsgs := n.mq.Get()\n\tfor _, m := range msgs {\n\t\tif m.Type == pb.LocalTick {\n\t\t\tcount++\n\t\t} else if m.Type == pb.Replicate && busy {\n\t\t\tcontinue\n\t\t}\n\t\tif done := n.handleMessage(m); !done {\n\t\t\tn.recordMessage(m)\n\t\t\tn.p.Handle(m)\n\t\t}\n\t}\n\tif count > n.config.ElectionRTT/2 {\n\t\tplog.Warningf(\"%s had %d LocalTick msgs in one batch\", n.id(), count)\n\t}\n\tif lazyFreeCycle > 0 {\n\t\tfor i := range msgs {\n\t\t\tmsgs[i].Entries = nil\n\t\t}\n\t}\n\treturn len(msgs) > 0\n}\n\nfunc (n *node) handleMessage(m pb.Message) bool {\n88:func (lr *LogReader) NodeState() (pb.State, pb.Membership) {\n212:func (lr *LogReader) ApplySnapshot(snapshot pb.Snapshot) error {\n280:func (lr *LogReader) SetState(s pb.State) {\nfunc (s *StateMachine) Handle(batch []Task, apply []sm.Entry) (Task, error) {\n\tbatch = batch[:0]\n\tapply = apply[:0]\n\tprocessed := false\n\tdefer func() {\n\t\t// give the node worker a chance to run when\n\t\t//  - the visible index value has been updated\n\t\t//  - taskC has been popped\n\t\tif processed {\n\t\t\ts.node.StepReady()\n\t\t}\n\t}()\n\tif rec, ok := s.taskQ.Get(); ok {\n\t\tprocessed = true\n\t\tif rec.IsSnapshotTask() {\n\t\t\treturn rec, nil\n\t\t}\n\t\tif !rec.isSyncTask() {\n\t\t\tbatch = append(batch, rec)\n\t\t} else {\n\t\t\tif err := s.sync(); err != nil {\n\t\t\t\treturn Task{}, err\n\t\t\t}\n\t\t}\n\t\tdone := false\n\t\tfor !done {\n\t\t\tif rec, ok := s.taskQ.Get(); ok {\n\t\t\t\tif rec.IsSnapshotTask() {\n\t\t\t\t\tif err := s.handle(batch, apply); err != nil {\n\t\t\t\t\t\treturn Task{}, err\n\t\t\t\t\t}\n\t\t\t\t\treturn rec, nil\n\t\t\t\t}\n\t\t\t\tif !rec.isSyncTask() {\n\t\t\t\t\tbatch = append(batch, rec)\n\t\t\t\t} else {\n\t\t\t\t\tif err := s.sync(); err != nil {\n\t\t\t\t\t\treturn Task{}, err\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tdone = true\n\t\t\t}\n\t\t}\n\t}\n\treturn Task{}, s.handle(batch, apply)\n}\n\n\treturn n.toApplyQ.MoreEntryToApply()\n}\n\nfunc (n *node) hasEntryToApply() bool {\n\treturn n.p.HasEntryToApply()\n}\n\nfunc (n *node) updateAppliedIndex() uint64 {\n\tn.appliedIndex = n.sm.GetLastApplied()\n\tn.p.NotifyRaftLastApplied(n.appliedIndex)\n\treturn n.appliedIndex\n}\n\nfunc (n *node) stepNode() (pb.Update, bool) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > build_backbone.py <<'PY'\nimport json\nm=json.load(open('initial-map.json')); sources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k))\nfor x in [('S-rsmrecover','internal/rsm/statemachine.go',242,280),('S-rsmrestore','internal/rsm/statemachine.go',324,385),('S-rsmhandle','internal/rsm/statemachine.go',547,593),('S-rsmapply','internal/rsm/statemachine.go',825,848),('S-rsmentry','internal/rsm/statemachine.go',877,975),('S-rsmvisible','internal/rsm/statemachine.go',637,707),('S-rsmsession','internal/rsm/statemachine.go',991,1043),('S-membervalidation','internal/rsm/membership.go',122,351),('S-nodecallbacks','node.go',238,330),('S-replay','node.go',605,648),('S-noderecover','node.go',788,869),('S-recoverstatus','node.go',1390,1449),('S-appliednotify','node.go',1111,1116),('S-readcaller','node.go',1225,1234),('S-readconsumer','request.go',792,957),('S-readforward','internal/raft/raft.go',1936,1963),('S-raftload','internal/raft/raft.go',237,292),('S-loadstate','internal/raft/raft.go',429,445),('S-dbwrite','internal/logdb/db.go',179,203),('S-dbshard','internal/logdb/sharded.go',150,182),('S-peerlaunch','internal/raft/peer.go',63,86),('S-nodereceive','node.go',1274,1298),('S-send','internal/raft/raft.go',649,667),('S-readtest','internal/raft/readindex_test.go',125,165,'test_expectation'),('S-followerreadtest','internal/raft/raft_test.go',2431,2450,'test_expectation'),('S-readcontract','nodehost.go',855,875,'interface_statement'),('S-dbcontract','raftio/logdb.go',78,90,'interface_statement')]: src(*x)\nby={b['id']:b for b in m['behaviors']}\nb=by['B-membership'];b['source_ids']+=['S-membervalidation','S-rsmentry','S-rsmapply','S-rsmvisible','S-nodecallbacks','S-appliednotify'];b['unknowns']=[]\nb['implementation_guards']=['RSM rejects stale ordered ConfigChangeId, reuse of removed IDs, duplicate membership/address, invalid role conversion and removal of the last full member.','RSM configChange updates membership and internal applied position before node.ApplyConfigChange; visible lastApplied is published after handling the task batch. Node updates Raft membership under raftMu before that publication is consumed by updateAppliedIndex.']\nb['writes']+=['Rejected configuration clears Raft pending-change state through node.configChangeProcessed; accepted configuration changes registry and Raft membership.']\nb=by['B-snapshot'];b['source_ids']+=['S-rsmrecover','S-rsmrestore','S-nodecallbacks','S-noderecover','S-recoverstatus','S-replay','S-rsmhandle'];b['unknowns']=['On-disk imported snapshot variants and interrupted filesystem installation are not yet followed.']\nb['async_boundaries']=['Persisted snapshot update queues an RSM recovery task. RSM task handling drains preceding entries before returning a snapshot task.','StateMachine.Recover loads state/session data and installs snapshot membership/applied position, then calls node.RestoreRemotes under raftMu before returning.','node.recoverDone notifies recovery completion and wakes application worker; recovery status blocks further task handling until completion, and initial completion marks node initialized.']\nb=by['B-persist'];b['source_ids']+=['S-dbcontract','S-dbwrite','S-dbshard'];b['durable_effects']=['ILogDB requires atomic saving of state, log entries and snapshot metadata. ShardedDB routes the update batch to db.saveRaftState, which adds these components to a write batch and calls CommitWriteBatch.'];b['unknowns']=['KV-specific synchronization and crash durability details remain open; ordinary reload mechanism is mapped in B-reload.']\nb=by['B-consume'];b['source_ids']+=['S-rsmhandle','S-rsmapply','S-rsmentry','S-rsmvisible','S-rsmsession','S-nodecallbacks','S-appliednotify','S-readconsumer'];b['unknowns']=['Concurrent and on-disk application variants have only representative coverage.'];b['external_effects']+=['RSM Handle drains tasks in order and signals StepReady when processed. Entry dispatch applies state machine updates or session/configuration operations; session cache can return prior results without reapplying commands.','Normal updates invoke node.ApplyUpdate to correlate clientID/seriesID/key and notify results. Visible lastApplied is published after the handled batch; node reads it under the RSM lock and passes it to Raft.']\nb=by['B-read'];b['source_ids']+=['S-readforward','S-send','S-readcaller','S-readconsumer','S-readtest'];b['unknowns']=['Can a legal overlapping remote request history expose the per-request versus confirming-context difference through emitted responses and recipient ReadyToReads?'];b['important_branches']=['Follower forwards its context unchanged to the known leader; send fills source replica ID. A received ReadIndexResp becomes ReadyToRead with exactly the received context.','A single-voter leader completes local requests directly and sends matching-context responses for observer requests; the question concerns multi-voter queued confirmation.']\ndef beh(i,a,owner,trigger,ss,**kw):return dict(id=i,primary_activity=a,execution_owner=owner,protocol_context='Per-cluster replica and request context',trigger=trigger,source_ids=ss,**kw)\nm['behaviors'] += [beh('B-reload','A6','node.replayLog, Peer.Launch and newRaft','Startup or restart',['S-replay','S-raftload','S-loadstate','S-peerlaunch','S-dbcontract'],writes=['replayLog installs latest snapshot in LogReader, reads persisted Raft state after snapshot index, and sets log range. newRaft obtains state/membership from NodeState, loads term/vote/commit and enters follower/observer/witness state, resetting volatile tallies.'],produces_fact_ids=['F-context','F-commit'],cross_activity_effects={'A1':'Restores committed prefix rather than old volatile match tallies.','A2':'Term and vote survive reload while active leadership does not.'},unknowns=['KV-specific crash behavior and bootstrap variants remain open.']),beh('B-readclient','A7','node.handleReadIndex and pendingReadIndex','Client read batch admission, ReadyToRead, applied notification, timeout or close',['S-readcaller','S-readconsumer','S-readcontract','S-nodecallbacks'],writes=['Each batch receives a nonzero random Low context and logical-clock High; separate batches can coexist.','addReady updates only the batch keyed by the exact received context. applied completes it only when index > 0, index <= applied and deadline has not elapsed; other contexts do not release it.'],external_effects=['Completion marks RequestState ready for local reads; timeout and shutdown terminate pending requests.'],cross_activity_effects={'A1':'Consumes the identity and index from leader-qualified read support via ReadyToRead; context substitution does not automatically satisfy an older batch.'},unknowns=['End-to-end timeout/retry consequence of a miscorrelated response is not yet executed.'])]\nfor f in m['facts']:\n if f['id']=='F-context':f['recovery']='B-reload restores term/vote from LogReader state and enters a nonleader role; volatile trackers are reconstructed empty.';f['source_ids']+=['S-replay','S-raftload','S-loadstate']\n if f['id']=='F-commit':f['recovery']='B-reload restores persisted commit after installing snapshot/range; loadState checks commit lies within available log bounds.';f['source_ids']+=['S-replay','S-raftload','S-loadstate']\nfor a in m['activities']:\n if a['class_id']=='A7':a.update(applicability='applicable',realization_summary='Request batches correlate read readiness by exact SystemCtx; success requires applied position and deadline checks, with timeout/close completion paths.',unknowns=[])\n a['source_ids']=sorted(set(s for b in m['behaviors'] if b['primary_activity']==a['class_id'] for s in b['source_ids']))\nfor sf in m['surfaces']:\n if sf['entry_point']=='RSM recovery and membership application callbacks':sf.update(disposition='mapped',behavior_ids=['B-snapshot','B-membership','B-consume','B-