\"array\"\n    },\n    \"grounding\": {\n      \"$ref\": \"#/$defs/Grounding\",\n      \"default\": {\n        \"source_ids\": [],\n        \"expectation_ids\": [],\n        \"binding_ids\": [],\n        \"derivation\": \"\",\n        \"applicability\": \"\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      }\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"kind\",\n    \"description\",\n    \"source_ids\",\n    \"scope\",\n    \"pending\"\n  ],\n  \"title\": \"ClaimDraft\",\n  \"type\": \"object\"\n}\nBindingDraft {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"associations\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingAssociation\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Associations\",\n      \"type\": \"array\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"associations\",\n    \"id\",\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\",\n    \"description\",\n    \"pending\"\n  ],\n  \"title\": \"BindingDraft\",\n  \"type\": \"object\"\n}\n\tprevState pb.State\n}\n\n// Launch starts or restarts a Raft node.\nfunc Launch(config config.Config,\n\tlogdb ILogDB, events server.IRaftEventListener,\n\taddresses []PeerAddress, initial bool, newNode bool) *Peer {\n\tcheckLaunchRequest(config, addresses, initial, newNode)\n\tplog.Infof(\"%s created, initial: %t, new: %t\",\n\t\tdn(config.ClusterID, config.NodeID), initial, newNode)\n\tr := newRaft(config, logdb)\n\tp := &Peer{raft: r}\n\tp.raft.events = events\n\t_, lastIndex := logdb.GetRange()\n\tif newNode && !config.IsObserver && !config.IsWitness {\n\t\tr.becomeFollower(1, NoLeader)\n\t}\n\tif initial && newNode {\n\t\tbootstrap(r, addresses)\n\t}\n\tif lastIndex == 0 {\n\t\tp.prevState = emptyState\n\t} else {\n\t\tp.prevState = r.raftState()\n\t}\n\treturn p\n}\n\n// Tick moves the logical clock forward by one tick.\nfunc (p *Peer) Tick() {\nfunc TestReadIndexLeaderCanBeConfirmed(t *testing.T) {\n\tr := newReadIndex()\n\tctx := getTestSystemCtx(10001)\n\tctx2 := getTestSystemCtx(10002)\n\tctx3 := getTestSystemCtx(10003)\n\tr.addRequest(3, ctx2, 1)\n\tr.addRequest(4, ctx, 3)\n\tr.addRequest(5, ctx3, 2)\n\tris := r.confirm(ctx, 1, 3)\n\tif ris != nil {\n\t\tt.Errorf(\"ris confirmed too early\")\n\t}\n\tris = r.confirm(ctx, 3, 3)\n\tif len(ris) != 2 {\n\t\tt.Fatalf(\"failed to confirm leader in ReadIndex\")\n\t}\n\tif ris[1].index != 4 {\n\t\tt.Errorf(\"index %d, want 4\", ris[1].index)\n\t}\n\tif ris[1].from != 3 {\n\t\tt.Errorf(\"from %d, want 3\", ris[1].from)\n\t}\n\tif ris[1].ctx != ctx {\n\t\tt.Errorf(\"ctx %v, want %v\", ris[1].ctx, ctx)\n\t}\n\tif ris[0].index != 4 {\n\t\tt.Errorf(\"index %d, want 4\", ris[0].index)\n\t}\n\tif ris[0].from != 1 {\n\t\tt.Errorf(\"from %d, want 1\", ris[0].from)\n\t}\n\tif ris[0].ctx != getTestSystemCtx(10002) {\n\t\tt.Errorf(\"ctx %d, want %v\", ris[0].ctx, getTestSystemCtx(10002))\n\t}\n\tif len(r.pending) != 1 || len(r.queue) != 1 {\n\t\tt.Errorf(\"cofirmed requet not removed\")\n\t}\n}\n\nfunc TestReadIndexIsResetAfterRaftStateChange(t *testing.T) {\n\tr := newTestRaft(1, []uint64{1, 2, 3}, 10, 1, NewTestLogDB())\n\tr.readIndex.addRequest(3, getTestSystemCtx(10001), 1)\n\tif len(r.readIndex.queue) != 1 || len(r.readIndex.pending) != 1 {\n\t\tt.Errorf(\"add request failed\")\n\t}\n\tr.reset(2, true)\n\tif len(r.readIndex.queue) != 0 || len(r.readIndex.pending) != 0 {\n\t\tt.Errorf(\"readIndex not reset after raft reset\")\n\t}\n}\n../agent-source/internal/logdb/db.go:179:func (r *db) saveRaftState(updates []pb.Update, ctx IContext) error {\n../agent-source/internal/logdb/db_test.go:239:func TestSnapshotsSavedInSaveRaftState(t *testing.T) {\n../agent-source/internal/logdb/db_test.go:491:func testSaveRaftState(t *testing.T, db raftio.ILogDB) {\n../agent-source/internal/logdb/db_test.go:536:func TestSaveRaftState(t *testing.T) {\n../agent-source/internal/logdb/sharded.go:152:func (s *ShardedDB) SaveRaftState(updates []pb.Update, shardID uint64) error {\n../agent-source/internal/logdb/sharded.go:169:func (s *ShardedDB) SaveRaftStateCtx(updates []pb.Update, ctx IContext) error {\n","exit_code":0,"status":"completed"}}
