{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\ns=json.load(open('../state.json'))\nfor col in ['checks','monitor_results','claims']:\n for x in s[col]:\n  if x.get('id') in ['ddfecbc913294fb1a5f2b793b003ea11','O-read-response-context'] or x.get('experiment_check_id')=='ddfecbc913294fb1a5f2b793b003ea11':print(col,json.dumps(x,indent=2))\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"'];print(json.dumps(s['ArtifactReviewItem'],indent=2))\nPY\ncat ../direct-checks/288e18585101441d84a4ad44e6903602/internal/raft/assurance_generated_test.go\"","aggregated_output":"{\n  \"direct_check_id\": \"59df150dcc534cbc8aa672f603b61d63\",\n  \"experiment_check_id\": \"ddfecbc913294fb1a5f2b793b003ea11\",\n  \"scope\": {\n    \"description\": \"Local correlation of an actually released remote read request to its emitted ReadIndexResp in a stable leader term and membership.\",\n    \"assumptions\": [\n      \"Crash-fault operation with unmodified messages produced by configured peers.\",\n      \"Distinct nonzero SystemCtx values identify the pending requests; source identity and term are preserved through delivery.\"\n    ],\n    \"excluded\": [\n      \"Numeric completion deadlines or unconditional read availability\",\n      \"End-to-end client timeout measurement\",\n      \"Wrong read values or linearizability violations\",\n      \"Restart and concurrent membership change during the confirmation\"\n    ],\n    \"parameters\": {}\n  },\n  \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_11-21-20-dragonboat_raft-real-run/logs/ddfecbc913294fb1a5f2b793b003ea11/stdout.log\",\n  \"parsing_errors\": [],\n  \"prerequisites\": {\n    \"status\": \"matched\",\n    \"reason\": \"Declared prerequisites established\",\n    \"matched_indices\": [\n      3\n    ],\n    \"alias_indices\": {\n      \"release\": 3\n    }\n  },\n  \"properties\": [\n    {\n      \"monitor_id\": \"M-read-context\",\n      \"checker_id\": \"P-read-context\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        5\n      ],\n      \"valid_witness_indices\": [\n        5\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        5,\n        6\n      ],\n      \"outside_applicability_indices\": [],\n      \"correlations\": {\n        \"5\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            3\n          ],\n          \"alias_indices\": {\n            \"release\": 3\n          }\n        },\n        \"6\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            4\n          ],\n          \"alias_indices\": {\n            \"release\": 4\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"No target code changes. Captured TestLogDB provides in-memory storage for a no-crash history.\",\n    \"Network and application scheduling are implemented by the driver; responses are produced only by Peer.Handle.\",\n    \"Read-only internal sampling verifies pending records, membership, term and completed setup.\"\n  ],\n  \"conditions\": {\n    \"plan_uncertainties\": [\n      \"The measured boundary is the leader outgoing message, with follower ReadyToRead as diagnostics; client completion and read values are not measured.\",\n      \"Source-backed bootstrap acceptance replaces application callbacks only for initialized AddNode entries; no membership changes overlap the read requests.\"\n    ],\n    \"grounding_unresolved\": [\n      \"This driver does not execute NodeHost client batching or timeout callbacks; their exact-context consumer behavior is source-grounded only.\"\n    ],\n    \"review_limitations\": []\n  },\n  \"blockers\": [\n    \"Direct oracle correspondence is unreviewed\"\n  ],\n  \"boundaries\": [\n    \"Numeric completion deadlines or unconditional read availability\",\n    \"End-to-end client timeout measurement\",\n    \"Wrong read values or linearizability violations\",\n    \"Restart and concurrent membership change during the confirmation\",\n    \"The measured boundary is the leader outgoing message, with follower ReadyToRead as diagnostics; client completion and read values are not measured.\",\n    \"Source-backed bootstrap acceptance replaces application callbacks only for initialized AddNode entries; no membership changes overlap the read requests.\",\n    \"This driver does not execute NodeHost client batching or timeout callbacks; their exact-context consumer behavior is source-grounded only.\"\n  ],\n  \"review_ids\": [],\n  \"open_issue_ids\": [],\n  \"correspondence\": null,\n  \"reviewed_complete\": false,\n  \"bounded_complete\": true,\n  \"confirmed\": false,\n  \"outcome\": \"violated\",\n  \"level\": \"implementation_test\",\n  \"claim_id\": \"O-read-response-context\",\n  \"claim_version\": 1,\n  \"framework_revision\": \"audit-products-v53\",\n  \"finding_ids\": {\n    \"P-read-context\": \"6ae45fb3f0e34a0db53f632a4e00cd63\"\n  },\n  \"finding_id\": \"6ae45fb3f0e34a0db53f632a4e00cd63\"\n}\nclaims {\n  \"id\": \"O-read-response-context\",\n  \"kind\": \"obligation\",\n  \"concern\": \"implementation_semantics\",\n  \"description\": \"When a current multi-voter leader releases a pending remote ReadIndex request after quorum confirmation and emits its ReadIndexResp to the requesting replica, the response must carry that released request\\u2019s SystemCtx unchanged, including when one confirmation releases several queued requests. The returned index may be advanced to the later confirmed safe index.\",\n  \"scope\": {\n    \"description\": \"Local correlation of an actually released remote read request to its emitted ReadIndexResp in a stable leader term and membership.\",\n    \"assumptions\": [\n      \"Crash-fault operation with unmodified messages produced by configured peers.\",\n      \"Distinct nonzero SystemCtx values identify the pending requests; source identity and term are preserved through delivery.\"\n    ],\n    \"excluded\": [\n      \"Numeric completion deadlines or unconditional read availability\",\n      \"End-to-end client timeout measurement\",\n      \"Wrong read values or linearizability violations\",\n      \"Restart and concurrent membership change during the confirmation\"\n    ],\n    \"parameters\": {}\n  },\n  \"source\": \"Candidate derived from attributed implementation responsibilities\",\n  \"source_ids\": [\n    \"S-readqueue\",\n    \"S-readreply\",\n    \"S-readforward\",\n    \"S-readconsumer\",\n    \"S-readcaller\",\n    \"S-readtest\",\n    \"S-readcontract\",\n    \"S-followerreadtest\"\n  ],\n  \"pending\": [],\n  \"assessment\": \"unassessed\",\n  \"candidate\": true,\n  \"grounding\": {\n    \"source_ids\": [\n      \"S-readqueue\",\n      \"S-readreply\",\n      \"S-readforward\",\n      \"S-readconsumer\",\n      \"S-readcaller\"\n    ],\n    \"expectation_ids\": [\n      \"S-readtest\",\n      \"S-followerreadtest\",\n      \"S-readcontract\"\n    ],\n    \"binding_ids\": [\n      \"K-read-response-context\"\n    ],\n    \"derivation\": \"The tracker returns each qualified readStatus with its own context and origin (S-readtest explicitly expects distinct contexts for a released prefix). The follower exports exactly the reply context, and the client consumer matches only that context. Therefore a reply reporting qualification to a requesting replica must preserve that request context. Index promotion to a later safe index is allowed; substituting identity is not equivalent to that promotion.\",\n    \"applicability\": \"Multi-voter leader, current-term commitment, stable term/membership, distinct contexts admitted from remote members and actually removed by one quorum confirmation. This is a local response-correlation duty, not a promise that all network requests succeed before a deadline.\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": [\n      \"Local completion already uses each record context; the single-voter branch is outside this queued-prefix check.\",\n      \"Packet loss or client timeout alone would not violate this requirement.\"\n    ]\n  },\n  \"version\": 1\n}\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"target_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Target Id\"\n    },\n    \"aspect\": {\n      \"enum\": [\n        \"applicability\",\n        \"decomposition\",\n        \"checker_correspondence\"\n      ],\n      \"title\": \"Aspect\",\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"enum\": [\n        \"no_issue_found\",\n        \"needs_reading\",\n        \"disputed\",\n        \"revision_needed\"\n      ],\n      \"title\": \"Status\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"rationale\": {\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"report_title\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Optional short Chinese reading title for this target; presentation only, never a verdict\",\n      \"title\": \"Report Title\"\n    },\n    \"report_answer\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Optional Chinese observed-answer summary preserving applicability; numbers and status come from retained assessment\",\n      \"title\": \"Report Answer\"\n    },\n    \"counterevidence\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Counterevidence\",\n      \"type\": \"array\"\n    },\n    \"limitations\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Limitations\",\n      \"type\": \"array\"\n    },\n    \"challenged_components\": {\n      \"description\": \"Components requiring repair, distinct from the review aspect; revision_needed must name them\",\n      \"items\": {\n        \"enum\": [\n          \"configuration\",\n          \"initialization\",\n          \"driver\",\n          \"observation\",\n          \"oracle\",\n          \"expectation\",\n          \"scope\"\n        ],\n        \"type\": \"string\"\n      },\n      \"title\": \"Challenged Components\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"aspect\",\n    \"status\",\n    \"source_ids\",\n    \"rationale\"\n  ],\n  \"title\": \"ArtifactReviewItem\",\n  \"type\": \"object\"\n}\npackage raft\n\nimport (\n    \"encoding/json\"\n    \"fmt\"\n    \"testing\"\n\n    \"github.com/lni/dragonboat/v3/config\"\n    pb \"github.com/lni/dragonboat/v3/raftpb\"\n)\n\nfunc assuranceReadEvent(v map[string]interface{}) {\n    data, err := json.Marshal(v)\n    if err != nil { panic(err) }\n    fmt.Println(\"CA_EVENT \" + string(data))\n}\n\nfunc assuranceCtx(c pb.SystemCtx) string { return fmt.Sprintf(\"%d/%d\", c.Low, c.High) }\n\ntype assuranceReadPeer struct {\n    peer *Peer\n    db ILogDB\n    applied uint64\n}\n\nfunc TestAssuranceReadResponseCorrelation(t *testing.T) {\n    // One outstanding request per origin makes destination an independent identity.\n    contexts := map[uint64]pb.SystemCtx{2: {Low: 101, High: 30}, 3: {Low: 202, High: 30}}\n    nodes := make(map[uint64]*assuranceReadPeer)\n    queue := []pb.Message{}\n    phase := \"prepare\"\n    qualified := false\n    emit := func(event string, origin uint64, fields map[string]interface{}) {\n        fields[\"event\"] = event\n        fields[\"scenario\"] = \"overlapping_remote_reads\"\n        fields[\"origin\"] = origin\n        fields[\"cluster\"] = uint64(7)\n        assuranceReadEvent(fields)\n    }\n    flush := func(id uint64) {\n        n := nodes[id]\n        ud := n.peer.GetUpdate(true, n.applied)\n        if !pb.IsEmptySnapshot(ud.Snapshot) { t.Fatal(\"unexpected snapshot\") }\n        if err := n.db.Append(ud.EntriesToSave); err != nil { t.Fatal(err) }\n        if !pb.IsEmptyState(ud.State) { n.db.SetState(ud.State) }\n        // Complete the accepted bootstrap configurations; no later configuration is proposed.\n        for _, e := range ud.CommittedEntries {\n            if e.Index != n.applied+1 { t.Fatalf(\"application gap at node %d\", id) }\n            if e.Type == pb.ConfigChangeEntry {\n                var cc pb.ConfigChange\n                if err := cc.Unmarshal(e.Cmd); err != nil { t.Fatal(err) }\n                if !cc.Initialize || cc.Type != pb.AddNode { t.Fatal(\"unexpected configuration\") }\n                n.peer.ApplyConfigChange(cc)\n            }\n            n.applied = e.Index\n        }\n        for _, ready := range ud.ReadyToReads {\n            emit(\"recipient_ready\", id, map[string]interface{}{\"context\": assuranceCtx(ready.SystemCtx), \"index\": ready.Index})\n        }\n        for _, msg := range ud.Messages {\n            if phase == \"reads\" && msg.Type == pb.ReadIndexResp {\n                emit(\"response\", msg.To, map[string]interface{}{\n                    \"context\": assuranceCtx(pb.SystemCtx{Low: msg.Hint, High: msg.HintHigh}),\n                    \"index\": msg.LogIndex, \"term\": msg.Term, \"sender\": msg.From,\n                    \"qualified\": qualified,\n                })\n            }\n            // Predetermined loss policy: suppress only first-context heartbeats.\n            // All retained messages use one FIFO delivery path.\n            if phase == \"reads\" && msg.Type == pb.Heartbeat && msg.Hint == contexts[2].Low && msg.HintHigh == contexts[2].High {\n                emit(\"dropped_heartbeat\", msg.To, map[string]interface{}{\"sender\": msg.From, \"context\": assuranceCtx(contexts[2])})\n                continue\n            }\n            queue = append(queue, msg)\n        }\n        n.peer.Commit(ud)\n        n.peer.NotifyRaftLastApplied(n.applied)\n    }\n    drain := func() {\n        for steps := 0; len(queue) > 0; steps++ {\n            if steps > 1000 { t.Fatal(\"message drain bound exceeded\") }\n            msg := queue[0]\n            queue = queue[1:]\n            dst, ok := nodes[msg.To]\n            if !ok { t.Fatalf(\"unknown destination %d\", msg.To) }\n            isConfirmation := phase == \"reads\" && !qualified && msg.To == 1 && msg.Type == pb.HeartbeatResp && msg.Hint == contexts[3].Low && msg.HintHigh == contexts[3].High\n            if isConfirmation {\n                r := dst.peer.raft\n                if r.state != leader || r.quorum() != 2 || msg.Term != r.term || msg.From == 1 { t.Fatal(\"invalid confirmation provenance\") }\n                if _, ok := r.remotes[msg.From]; !ok { t.Fatal(\"nonvoter confirmation\") }\n                for _, origin := range []uint64{2, 3} {\n                    s, ok := r.readIndex.pending[contexts[origin]]\n                    if !ok || s.from != origin || s.ctx != contexts[origin] { t.Fatal(\"missing pending request\") }\n                }\n            }\n            dst.peer.Handle(msg)\n            if isConfirmation {\n                qualified = true\n                for _, origin := range []uint64{2, 3} {\n                    _, remains := dst.peer.raft.readIndex.pending[contexts[origin]]\n                    emit(\"released\", origin, map[string]interface{}{\n                        \"expected_context\": assuranceCtx(contexts[origin]), \"removed\": !remains,\n                        \"term\": dst.peer.raft.term, \"confirming_sender\": msg.From,\n                        \"quorum\": dst.peer.raft.quorum(), \"confirmed_context\": assuranceCtx(contexts[3]),\n                    })\n                }\n            }\n            flush(msg.To)\n        }\n    }\n    for id := uint64(1); id <= 3; id++ {\n        db := NewTestLogDB()\n        cfg := config.Config{ClusterID: 7, NodeID: id, ElectionRTT: 10, HeartbeatRTT: 1, CheckQuorum: true}\n        p := Launch(cfg, db, nil, []PeerAddress{{NodeID: 1, Address: \"n1\"}, {NodeID: 2, Address: \"n2\"}, {NodeID: 3, Address: \"n3\"}}, true, true)\n        nodes[id] = &assuranceReadPeer{peer: p, db: db}\n        flush(id)\n    }\n    drain()\n    for tick := 0; tick < 100 && nodes[1].peer.raft.state != leader; tick++ {\n        nodes[1].peer.Tick()\n        flush(1)\n        drain()\n    }\n    r := nodes[1].peer.raft\n    if r.state != leader || !r.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"current-term leader not established\") }\n    for id := uint64(1); id <= 3; id++ {\n        n := nodes[id]\n        if n.peer.raft.term != r.term || n.peer.raft.leaderID != 1 || n.applied != r.log.committed { t.Fatalf(\"prefix not complete on node %d\", id) }\n    }\n    emit(\"prefix\", 1, map[string]interface{}{\"term\": r.term, \"commit\": r.log.committed, \"queued_messages\": len(queue)})\n    phase = \"reads\"\n    for _, origin := range []uint64{2, 3} {\n        nodes[origin].peer.ReadIndex(contexts[origin])\n        flush(origin)\n        // The first drain loses its own context-bearing heartbeats by the fixed policy.\n        // The second drain confirms the later context, with the first request still pending.\n        drain()\n    }\n    emit(\"finished\", 1, map[string]interface{}{\"qualified\": qualified, \"pending\": len(r.readIndex.pending), \"queued_messages\": len(queue)})\n    if !qualified { t.Fatal(\"quorum-confirmation prerequisite not reached\") }\n}\n","exit_code":0,"status":"completed"}}
