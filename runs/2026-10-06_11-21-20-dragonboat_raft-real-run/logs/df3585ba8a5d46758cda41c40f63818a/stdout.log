{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../logs/ddfecbc913294fb1a5f2b793b003ea11/stderr.log; /home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nfor l in open('../logs/ddfecbc913294fb1a5f2b793b003ea11/stdout.log'):\n v=json.loads(l)\n if 'CA_EVENT' in v.get('Output','') or v.get('Action') in ['pass','fail']:print(v.get('Output',v))\np=json.load(open('../direct-checks/288e18585101441d84a4ad44e6903602/plan.json'));p['harness'].pop('source');print(json.dumps(p,indent=2))\nPY\nsed -n '2730,2880p' ../agent-source/internal/raft/raft_etcd_test.go; grep -n 'func .*filter\\\\|func .*drop' ../agent-source/internal/raft/raft_etcd_test.go\"","aggregated_output":"CA_EVENT {\"cluster\":7,\"commit\":4,\"event\":\"prefix\",\"origin\":1,\"queued_messages\":0,\"scenario\":\"overlapping_remote_reads\",\"term\":2}\n\nCA_EVENT {\"cluster\":7,\"context\":\"101/30\",\"event\":\"dropped_heartbeat\",\"origin\":3,\"scenario\":\"overlapping_remote_reads\",\"sender\":1}\n\nCA_EVENT {\"cluster\":7,\"context\":\"101/30\",\"event\":\"dropped_heartbeat\",\"origin\":2,\"scenario\":\"overlapping_remote_reads\",\"sender\":1}\n\nCA_EVENT {\"cluster\":7,\"confirmed_context\":\"202/30\",\"confirming_sender\":3,\"event\":\"released\",\"expected_context\":\"101/30\",\"origin\":2,\"quorum\":2,\"removed\":true,\"scenario\":\"overlapping_remote_reads\",\"term\":2}\n\nCA_EVENT {\"cluster\":7,\"confirmed_context\":\"202/30\",\"confirming_sender\":3,\"event\":\"released\",\"expected_context\":\"202/30\",\"origin\":3,\"quorum\":2,\"removed\":true,\"scenario\":\"overlapping_remote_reads\",\"term\":2}\n\nCA_EVENT {\"cluster\":7,\"context\":\"202/30\",\"event\":\"response\",\"index\":4,\"origin\":2,\"qualified\":true,\"scenario\":\"overlapping_remote_reads\",\"sender\":1,\"term\":2}\n\nCA_EVENT {\"cluster\":7,\"context\":\"202/30\",\"event\":\"response\",\"index\":4,\"origin\":3,\"qualified\":true,\"scenario\":\"overlapping_remote_reads\",\"sender\":1,\"term\":2}\n\nCA_EVENT {\"cluster\":7,\"context\":\"202/30\",\"event\":\"recipient_ready\",\"index\":4,\"origin\":2,\"scenario\":\"overlapping_remote_reads\"}\n\nCA_EVENT {\"cluster\":7,\"context\":\"202/30\",\"event\":\"recipient_ready\",\"index\":4,\"origin\":3,\"scenario\":\"overlapping_remote_reads\"}\n\nCA_EVENT {\"cluster\":7,\"event\":\"finished\",\"origin\":1,\"pending\":0,\"qualified\":true,\"queued_messages\":0,\"scenario\":\"overlapping_remote_reads\"}\n\n{'Time': '2026-10-06T11:33:07.843367048+08:00', 'Action': 'pass', 'Package': 'github.com/lni/dragonboat/v3/internal/raft', 'Test': 'TestAssuranceReadResponseCorrelation', 'Elapsed': 0}\n{'Time': '2026-10-06T11:33:07.844900999+08:00', 'Action': 'pass', 'Package': 'github.com/lni/dragonboat/v3/internal/raft', 'Elapsed': 0.01}\n{\n  \"description\": \"Exercise overlapping remote requests with distinct contexts. First-context heartbeats are lost; a later actual voter response releases the queued prefix. Observe emitted response context per unique destination and retain recipient ReadyToRead diagnostics.\",\n  \"claim_id\": \"O-read-response-context\",\n  \"binding_ids\": [\n    \"K-read-response-context\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./internal/raft\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"description\": \"Three bootstrapped Peers, synchronous update storage/application/commit driver, real tick/vote election and deterministic FIFO message delivery with a fixed first-heartbeat loss policy.\",\n    \"semantic_changes\": [\n      \"No target code changes. Captured TestLogDB provides in-memory storage for a no-crash history.\",\n      \"Network and application scheduling are implemented by the driver; responses are produced only by Peer.Handle.\",\n      \"Read-only internal sampling verifies pending records, membership, term and completed setup.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"release\",\n        \"event\": \"released\",\n        \"conditions\": [\n          {\n            \"field\": \"removed\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"quorum\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-peerlaunch\",\n        \"S-bootstrap\",\n        \"S-peerapply\",\n        \"S-update\",\n        \"S-updatecommit\",\n        \"S-peerread\",\n        \"S-testlogdb\",\n        \"S-testlogentries\",\n        \"S-ticks\",\n        \"S-peer\",\n        \"S-engine\",\n        \"S-send\",\n        \"S-transportloss\",\n        \"S-readqueue\",\n        \"S-readreply\"\n      ],\n      \"expectation_ids\": [\n        \"S-dbcontract\",\n        \"S-readtest\"\n      ],\n      \"binding_ids\": [\n        \"K-read-response-context\"\n      ],\n      \"derivation\": \"Launch three initial/new peers with identical unique bootstrap addresses and empty TestLogDBs. The synchronous driver saves entries/state before transmitting any update messages, applies only committed bootstrap AddNode configurations, commits updates, and notifies lastApplied. Tick only replica 1 until real vote exchange elects it and current-term no-op is committed/applied at all peers. No private Raft field or handler is substituted; private state is sampled only for prerequisite diagnostics. The driver issues Peer.ReadIndex on followers 2 and 3 with distinct nonzero contexts. A fixed policy discards context-101 heartbeats before delivery; retained messages share one FIFO. The first dropped heartbeat batch leaves its request pending, and the next context heartbeat is delivered and answered by real follower handlers. Loss is permitted by the asynchronous transport send boundary; no fabricated reply, stale authority or reorder is needed. TestLogDB implements the acquired ILogDB boundary; there is no crash in this history. Holding replication until after save is a permissible stronger persistence order, and it occurs in the setup rather than serializing the investigated read overlap.\",\n      \"applicability\": \"One single-threaded test owns all Peer calls, storage, queue and observation fields. No goroutines, background timers, external clients or shutdown-dependent observations. Both requests have distinct origins, one outstanding request per origin, making To an independent unambiguous response identity. Generated contexts are valid values allowed by Peer.ReadIndex and node context generation; test bypasses random selection only.\",\n      \"unresolved\": [\n        \"This driver does not execute NodeHost client batching or timeout callbacks; their exact-context consumer behavior is source-grounded only.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Earlier source-only reading excluded a cumulative client-context consumer mechanism. A NodeHost endpoint test would add scheduler and timeout dependencies unnecessary for the local response identity proposition.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-read-context\",\n      \"checker_id\": \"P-read-context\",\n      \"event\": \"response\",\n      \"binding_ids\": [\n        \"K-read-response-context\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-readqueue\",\n          \"S-readreply\",\n          \"S-readforward\",\n          \"S-readconsumer\",\n          \"S-readcaller\"\n        ],\n        \"expectation_ids\": [\n          \"S-readtest\",\n          \"S-followerreadtest\",\n          \"S-readcontract\"\n        ],\n        \"binding_ids\": [\n          \"K-read-response-context\"\n        ],\n        \"derivation\": \"The tracker returns each qualified readStatus with its own context and origin (S-readtest explicitly expects distinct contexts for a released prefix). The follower exports exactly the reply context, and the client consumer matches only that context. Therefore a reply reporting qualification to a requesting replica must preserve that request context. Index promotion to a later safe index is allowed; substituting identity is not equivalent to that promotion.\",\n        \"applicability\": \"Multi-voter leader, current-term commitment, stable term/membership, distinct contexts admitted from remote members and actually removed by one quorum confirmation. This is a local response-correlation duty, not a promise that all network requests succeed before a deadline.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Local completion already uses each record context; the single-voter branch is outside this queued-prefix check.\",\n          \"Packet loss or client timeout alone would not violate this requirement.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"scenario\",\n          \"op\": \"eq\",\n          \"value\": \"overlapping_remote_reads\",\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"release\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"P-read-context\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"response\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"context\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"release.expected_context\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"scenario\",\n        \"cluster\",\n        \"origin\"\n      ],\n      \"description\": \"Compare complete serialized Low/High context of each emitted response with the admitted released request. Destination is independent identity because only one request is outstanding from each origin.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The measured boundary is the leader outgoing message, with follower ReadyToRead as diagnostics; client completion and read values are not measured.\",\n    \"Source-backed bootstrap acceptance replaces application callbacks only for initialized AddNode entries; no membership changes overlap the read requests.\"\n  ]\n}\n\tsm.remotes[2].next = 1\n\tsm.remotes[2].becomeSnapshot(11)\n\n\tsm.Handle(pb.Message{From: 2, To: 1, Type: pb.SnapshotStatus, Reject: true})\n\tif sm.remotes[2].snapshotIndex != 0 {\n\t\tt.Fatalf(\"PendingSnapshot = %d, want 0\", sm.remotes[2].snapshotIndex)\n\t}\n\tif sm.remotes[2].next != 1 {\n\t\tt.Fatalf(\"Next = %d, want 1\", sm.remotes[2].next)\n\t}\n\tif sm.remotes[2].state != remoteWait {\n\t\tt.Errorf(\"Paused = %s, want remoteWait\", sm.remotes[2].state)\n\t}\n}\n\nfunc TestSnapshotSucceed(t *testing.T) {\n\tstorage := NewTestLogDB()\n\tsm := newTestRaft(1, []uint64{1, 2}, 10, 1, storage)\n\tsm.restore(testingSnap)\n\tsm.restoreRemotes(testingSnap)\n\n\tsm.becomeCandidate()\n\tsm.becomeLeader()\n\n\tsm.remotes[2].next = 1\n\tsm.remotes[2].becomeSnapshot(11)\n\n\tsm.Handle(pb.Message{From: 2, To: 1, Type: pb.SnapshotStatus, Reject: false})\n\tif sm.remotes[2].snapshotIndex != 0 {\n\t\tt.Fatalf(\"PendingSnapshot = %d, want 0\", sm.remotes[2].snapshotIndex)\n\t}\n\tif sm.remotes[2].next != 12 {\n\t\tt.Fatalf(\"Next = %d, want 12\", sm.remotes[2].next)\n\t}\n\tif sm.remotes[2].state != remoteWait {\n\t\tt.Errorf(\"Paused = %s, want remoteWait\", sm.remotes[2].state)\n\t}\n}\n\nfunc TestSnapshotAbort(t *testing.T) {\n\tstorage := NewTestLogDB()\n\tsm := newTestRaft(1, []uint64{1, 2}, 10, 1, storage)\n\tsm.restore(testingSnap)\n\tsm.restoreRemotes(testingSnap)\n\n\tsm.becomeCandidate()\n\tsm.becomeLeader()\n\n\tsm.remotes[2].next = 1\n\tsm.remotes[2].becomeSnapshot(11)\n\n\t// A successful msgAppResp that has a higher/equal index than the\n\t// pending snapshot should abort the pending snapshot.\n\tsm.Handle(pb.Message{From: 2, To: 1, Type: pb.ReplicateResp, LogIndex: 11})\n\tif sm.remotes[2].snapshotIndex != 0 {\n\t\tt.Fatalf(\"PendingSnapshot = %d, want 0\", sm.remotes[2].snapshotIndex)\n\t}\n\tif sm.remotes[2].next != 12 {\n\t\tt.Fatalf(\"Next = %d, want 12\", sm.remotes[2].next)\n\t}\n}\n\nfunc entsWithConfig(configFunc func(config.Config), terms ...uint64) *raft {\n\tstorage := NewTestLogDB()\n\tfor i, term := range terms {\n\t\tif err := storage.Append([]pb.Entry{{Index: uint64(i + 1), Term: term}}); err != nil {\n\t\t\tpanic(err)\n\t\t}\n\t}\n\tcfg := newTestConfig(1, 5, 1)\n\tif configFunc != nil {\n\t\tconfigFunc(cfg)\n\t}\n\tsm := newRaft(cfg, storage)\n\tsm.reset(terms[len(terms)-1], true)\n\treturn sm\n}\n\n// votedWithConfig creates a raft state machine with Vote and Term set\n// to the given value but no log entries (indicating that it voted in\n// the given term but has not received any logs).\nfunc votedWithConfig(configFunc func(config.Config), vote, term uint64) *raft {\n\tstorage := NewTestLogDB()\n\tstorage.SetState(pb.State{Vote: vote, Term: term})\n\tcfg := newTestConfig(1, 5, 1)\n\tif configFunc != nil {\n\t\tconfigFunc(cfg)\n\t}\n\tsm := newRaft(cfg, storage)\n\tsm.reset(term, true)\n\treturn sm\n}\n\ntype network struct {\n\tpeers   map[uint64]stateMachine\n\tstorage map[uint64]ILogDB\n\tdropm   map[connem]float64\n\tignorem map[pb.MessageType]bool\n}\n\n// newNetwork initializes a network from peers.\n// A nil node will be replaced with a new *stateMachine.\n// A *stateMachine will get its k, id.\n// When using stateMachine, the address list is always [1, n].\nfunc newNetwork(peers ...stateMachine) *network {\n\treturn newNetworkWithConfig(nil, peers...)\n}\n\n// newNetworkWithConfig is like newNetwork but calls the given func to\n// modify the configuration of any state machines it creates.\nfunc newNetworkWithConfig(configFunc func(config.Config), peers ...stateMachine) *network {\n\tsize := len(peers)\n\tpeerAddrs := idsBySize(size)\n\n\tnpeers := make(map[uint64]stateMachine, size)\n\tnstorage := make(map[uint64]ILogDB, size)\n\n\tfor j, p := range peers {\n\t\tid := peerAddrs[j]\n\t\tswitch v := p.(type) {\n\t\tcase nil:\n\t\t\tnstorage[id] = NewTestLogDB()\n\t\t\tcfg := newTestConfig(id, 10, 1)\n\t\t\tif configFunc != nil {\n\t\t\t\tconfigFunc(cfg)\n\t\t\t}\n\t\t\tsm := newRaft(cfg, nstorage[id])\n\t\t\tsm.setTestPeers(peerAddrs)\n\t\t\tsm.hasNotAppliedConfigChange = sm.testOnlyHasConfigChangeToApply\n\t\t\tnpeers[id] = sm\n\t\tcase *raft:\n\t\t\tobservers := make(map[uint64]bool)\n\t\t\twitnesses := make(map[uint64]bool)\n\t\t\tfor i := range v.observers {\n\t\t\t\tobservers[i] = true\n\t\t\t}\n\t\t\tfor i := range v.witnesses {\n\t\t\t\twitnesses[i] = true\n\t\t\t}\n\n\t\t\tv.nodeID = id\n\t\t\tv.remotes = make(map[uint64]*remote)\n\t\t\tv.observers = make(map[uint64]*remote)\n\t\t\tv.witnesses = make(map[uint64]*remote)\n\t\t\tfor i := 0; i < size; i++ {\n\t\t\t\tif _, ok := observers[peerAddrs[i]]; ok {\n\t\t\t\t\tv.observers[peerAddrs[i]] = &remote{}\n\t\t\t\t} else if _, ok := witnesses[peerAddrs[i]]; ok {\n\t\t\t\t\tv.witnesses[peerAddrs[i]] = &remote{}\n\t\t\t\t} else {\n\t\t\t\t\tv.remotes[peerAddrs[i]] = &remote{}\n2908:func (nw *network) drop(from, to uint64, perc float64) {\n2936:func (nw *network) filter(msgs []pb.Message) []pb.Message {\n","exit_code":0,"status":"completed"}}
