    "investigations": [
      {
        "id": "283ebcc6257842828130c4ab9b4f08fd-question-0",
        "ref": null,
        "question": "Which recorded source-derived findings still lack an executed witness, and what is the smallest execution that would settle each?",
        "source_ids": [
          "src_quorumsize_arithmetic_handoff",
          "src_verify_self_vote_handoff"
        ],
        "hypothesis": "Five recorded findings share the same missing piece, and each can be settled by a small in-memory cluster: (1) the verification evidence gap - a cluster with a small voter set and one reachable non-voting member, where the leader is isolated from every voter other than itself but stays connected to that member, observing a successful verification with zero voter acknowledgements; the arithmetic shows one non-voter suffices for a three-voter cluster, since the quorum is two and the leader already counts itself, so the cluster should be built with a single non-voter to test the minimal case and with more to test the larger voter counts; (2) the explicit non-voter transfer - three voters plus one non-voting member, calling the explicit transfer entry point with that member and observing the incumbent lose leadership, the target never win, and the future report success; (3) the transfer readiness cursor - electing a leader while one voter is unreachable, then calling the explicit transfer for that voter immediately on its return and observing TimeoutNow sent before any successful replication response from it; (4) the lease validation gap - a three-node cluster configured with a one-second heartbeat timeout and a five-millisecond lease, observing repeated leadership loss with no sustained leader; (5) the snapshot-install cycle - a leader whose log is compacted above a divergence point and a follower whose cached last index exceeds the leader's snapshot index, observing repeated snapshot transfers with the peer's match index pinned.",
        "discriminator": "Each item is settled by the observation named inside it, and item 1 should be built with the minimal non-voter count so that a failure cannot be explained by insufficient support; a run that cannot execute should leave the item here rather than convert it into a claim. Items 1 to 4 are self-contained in-memory clusters; item 5 additionally needs the follower's log and cached index arranged as its recorded conditions describe, which the existing test helpers can do only partially, so it may need a purpose-built prefix.",
        "disposition": "paused",
        "parent_id": null,
        "knowledge": null,
        "counterevidence": null,
        "limitations": [
          "This record adds no source evidence; it consolidates existing discriminators for reuse, and its item 1 wording was corrected to the minimal non-voter count.",
          "The items are ordered by how self-contained their execution is, not by severity.",
          "Nothing here asserts that any item will be confirmed; several could be refuted by execution, which is the point of listing them."
        ],
        "resume_conditions": [
          "A successor run with execution capacity and the same captured snapshot, able to build in-memory clusters in the package under test.",
          "For item 5, either a helper that can seed a follower's log and cached position, or a purpose-built prefix that reaches the state through real messages.",
          "For the previously paused pre-vote fallback question, the counterpart version's transport error text, which no execution in this snapshot can supply."
        ]
      }
