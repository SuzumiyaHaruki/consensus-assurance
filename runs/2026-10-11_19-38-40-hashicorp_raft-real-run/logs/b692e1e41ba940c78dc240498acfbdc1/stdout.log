:1276:func (r *Raft) LeadershipTransferToServer(id ServerID, address ServerAddress) Future {\nreplication.go:69:\t// lastContact is updated to the current time whenever any response is\nreplication.go:72:\tlastContact time.Time\nreplication.go:73:\t// lastContactLock protects 'lastContact'.\nreplication.go:74:\tlastContactLock sync.RWMutex\nreplication.go:120:// LastContact returns the time of last contact.\nreplication.go:121:func (s *followerReplication) LastContact() time.Time {\nreplication.go:122:\ts.lastContactLock.RLock()\nreplication.go:123:\tlast := s.lastContact\nreplication.go:124:\ts.lastContactLock.RUnlock()\nreplication.go:128:// setLastContact sets the last contact to the current time.\nreplication.go:129:func (s *followerReplication) setLastContact() {\nreplication.go:130:\ts.lastContactLock.Lock()\nreplication.go:131:\ts.lastContact = time.Now()\nreplication.go:132:\ts.lastContactLock.Unlock()\nreplication.go:245:\ts.setLastContact()\nreplication.go:365:\ts.setLastContact()\nreplication.go:416:\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\nreplication.go:427:\t\t\ts.setLastContact()\nreplication.go:554:\t\t\ts.setLastContact()\n","exit_code":0,"status":"completed"}}
