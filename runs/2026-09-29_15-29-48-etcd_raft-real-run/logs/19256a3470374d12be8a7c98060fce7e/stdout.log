{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '51,177p' ../agent-source/confchange/confchange.go; sed -n '204,274p' ../agent-source/confchange/confchange.go; sed -n '119,160p' ../agent-source/confchange/restore.go; sed -n '616,739p' ../agent-source/raft.go; sed -n '740,777p' ../agent-source/raft.go; sed -n '995,1024p' ../agent-source/raft.go; sed -n '2033,2045p' ../agent-source/raft.go; sed -n '2062,2093p' ../agent-source/raft.go; sed -n '2123,2188p' ../agent-source/raft.go; cat ../agent-source/read_only.go; grep -n '\"'^func'\"\\\\|Ready struct\\\\|Messages contains' ../agent-source/node.go\"","aggregated_output":"func (r *raft) committedEntryInCurrentTerm() bool {\n\t// NB: r.Term is never 0 on a leader, so if zeroTermOnOutOfBounds returns 0,\n\t// we won't see it as a match with r.Term.\n\treturn r.raftLog.zeroTermOnOutOfBounds(r.raftLog.term(r.raftLog.committed)) == r.Term\n}\n\n// responseToReadIndexReq constructs a response for `req`. If `req` comes from the peer\n// itself, a blank value will be returned.\nfunc (r *raft) responseToReadIndexReq(req pb.Message, readIndex uint64) pb.Message {\n\tif req.From == None || req.From == r.id {\n\t\tr.readStates = append(r.readStates, ReadState{\n\t\t\tIndex:      readIndex,\n\t\t\tRequestCtx: req.Entries[0].Data,\n\t\t})\n\t\treturn pb.Message{}\n\t}\n\treturn pb.Message{\n\t\tType:    pb.MsgReadIndexResp,\n\t\tTo:      req.From,\n\t\tIndex:   readIndex,\n\t\tEntries: req.Entries,\n\t}\n}\n\n// increaseUncommittedSize computes the size of the proposed entries and\n// determines whether they would push leader over its maxUncommittedSize limit.\n// If the new entries would exceed the limit, the method returns false. If not,\n// the increase in uncommitted entry size is recorded and the method returns\n// true.\n//\n// Empty payloads are never refused. This is used both for appending an empty\n// entry at a new leader's term, as well as leaving a joint configuration.\nfunc releasePendingReadIndexMessages(r *raft) {\n\tif len(r.pendingReadIndexMessages) == 0 {\n\t\t// Fast path for the common case to avoid a call to storage.LastIndex()\n\t\t// via committedEntryInCurrentTerm.\n\t\treturn\n\t}\n\tif !r.committedEntryInCurrentTerm() {\n\t\tr.logger.Error(\"pending MsgReadIndex should be released only after first commit in current term\")\n\t\treturn\n\t}\n\n\tmsgs := r.pendingReadIndexMessages\n\tr.pendingReadIndexMessages = nil\n\n\tfor _, m := range msgs {\n\t\tsendMsgReadIndexResponse(r, m)\n\t}\n}\n\nfunc sendMsgReadIndexResponse(r *raft, m pb.Message) {\n\t// thinking: use an internally defined context instead of the user given context.\n\t// We can express this in terms of the term and index instead of a user-supplied value.\n\t// This would allow multiple reads to piggyback on the same message.\n\tswitch r.readOnly.option {\n\t// If more than the local vote is needed, go through a full broadcast.\n\tcase ReadOnlySafe:\n\t\tr.readOnly.addRequest(r.raftLog.committed, m)\n\t\t// The local node automatically acks the request.\n\t\tr.readOnly.recvAck(r.id, m.Entries[0].Data)\n\t\tr.bcastHeartbeatWithCtx(m.Entries[0].Data)\n\tcase ReadOnlyLeaseBased:\n\t\tif resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.To != None {\n\t\t\tr.send(resp)\n\t\t}\n\t}\n}\n// Copyright 2016 The etcd Authors\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\npackage raft\n\nimport pb \"go.etcd.io/raft/v3/raftpb\"\n\n// ReadState provides state for read only query.\n// It's caller's responsibility to call ReadIndex first before getting\n// this state from ready, it's also caller's duty to differentiate if this\n// state is what it requests through RequestCtx, eg. given a unique id as\n// RequestCtx\ntype ReadState struct {\n\tIndex      uint64\n\tRequestCtx []byte\n}\n\ntype readIndexStatus struct {\n\treq   pb.Message\n\tindex uint64\n\t// NB: this never records 'false', but it's more convenient to use this\n\t// instead of a map[uint64]struct{} due to the API of quorum.VoteResult. If\n\t// this becomes performance sensitive enough (doubtful), quorum.VoteResult\n\t// can change to an API that is closer to that of CommittedIndex.\n\tacks map[uint64]bool\n}\n\ntype readOnly struct {\n\toption           ReadOnlyOption\n\tpendingReadIndex map[string]*readIndexStatus\n\treadIndexQueue   []string\n}\n\nfunc newReadOnly(option ReadOnlyOption) *readOnly {\n\treturn &readOnly{\n\t\toption:           option,\n\t\tpendingReadIndex: make(map[string]*readIndexStatus),\n\t}\n}\n\n// addRequest adds a read only request into readonly struct.\n// `index` is the commit index of the raft state machine when it received\n// the read only request.\n// `m` is the original read only request message from the local or remote node.\nfunc (ro *readOnly) addRequest(index uint64, m pb.Message) {\n\ts := string(m.Entries[0].Data)\n\tif _, ok := ro.pendingReadIndex[s]; ok {\n\t\treturn\n\t}\n\tro.pendingReadIndex[s] = &readIndexStatus{index: index, req: m, acks: make(map[uint64]bool)}\n\tro.readIndexQueue = append(ro.readIndexQueue, s)\n}\n\n// recvAck notifies the readonly struct that the raft state machine received\n// an acknowledgment of the heartbeat that attached with the read only request\n// context.\nfunc (ro *readOnly) recvAck(id uint64, context []byte) map[uint64]bool {\n\trs, ok := ro.pendingReadIndex[string(context)]\n\tif !ok {\n\t\treturn nil\n\t}\n\n\trs.acks[id] = true\n\treturn rs.acks\n}\n\n// advance advances the read only request queue kept by the readonly struct.\n// It dequeues the requests until it finds the read only request that has\n// the same context as the given `m`.\nfunc (ro *readOnly) advance(m pb.Message) []*readIndexStatus {\n\tvar (\n\t\ti     int\n\t\tfound bool\n\t)\n\n\tctx := string(m.Context)\n\tvar rss []*readIndexStatus\n\n\tfor _, okctx := range ro.readIndexQueue {\n\t\ti++\n\t\trs, ok := ro.pendingReadIndex[okctx]\n\t\tif !ok {\n\t\t\tpanic(\"cannot find corresponding read state from pending map\")\n\t\t}\n\t\trss = append(rss, rs)\n\t\tif okctx == ctx {\n\t\t\tfound = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\tif found {\n\t\tro.readIndexQueue = ro.readIndexQueue[i:]\n\t\tfor _, rs := range rss {\n\t\t\tdelete(ro.pendingReadIndex, string(rs.req.Entries[0].Data))\n\t\t}\n\t\treturn rss\n\t}\n\n\treturn nil\n}\n\n// lastPendingRequestCtx returns the context of the last pending read only\n// request in readonly struct.\nfunc (ro *readOnly) lastPendingRequestCtx() string {\n\tif len(ro.readIndexQueue) == 0 {\n\t\treturn \"\"\n\t}\n\treturn ro.readIndexQueue[len(ro.readIndexQueue)-1]\n}\n45:func (a *SoftState) equal(b *SoftState) bool {\n52:type Ready struct {\n117:func isHardStateEqual(a, b pb.HardState) bool {\n122:func IsEmptyHardState(st pb.HardState) bool {\n127:func IsEmptySnap(sp pb.Snapshot) bool {\n255:func setupNode(c *Config, peers []Peer) *node {\n276:func StartNode(c *Config, peers []Peer) Node {\n286:func RestartNode(c *Config) Node {\n317:func newNode(rn *RawNode) node {\n336:func (n *node) Stop() {\n348:func (n *node) run() {\n463:func (n *node) Tick() {\n472:func (n *node) Campaign(ctx context.Context) error { return n.step(ctx, pb.Message{Type: pb.MsgHup}) }\n474:func (n *node) Propose(ctx context.Context, data []byte) error {\n478:func (n *node) Step(ctx context.Context, m pb.Message) error {\n487:func confChangeToMsg(c pb.ConfChangeI) (pb.Message, error) {\n495:func (n *node) ProposeConfChange(ctx context.Context, cc pb.ConfChangeI) error {\n503:func (n *node) step(ctx context.Context, m pb.Message) error {\n507:func (n *node) stepWait(ctx context.Context, m pb.Message) error {\n513:func (n *node) stepWithWaitOption(ctx context.Context, m pb.Message, wait bool) error {\n552:func (n *node) Ready() <-chan Ready { return n.readyc }\n554:func (n *node) Advance() {\n561:func (n *node) ApplyConfChange(cc pb.ConfChangeI) *pb.ConfState {\n574:func (n *node) Status() Status {\n584:func (n *node) ReportUnreachable(id uint64) {\n591:func (n *node) ReportSnapshot(id uint64, status SnapshotStatus) {\n600:func (n *node) TransferLeadership(ctx context.Context, lead, transferee uint64) {\n609:func (n *node) ForgetLeader(ctx context.Context) error {\n613:func (n *node) ReadIndex(ctx context.Context, rctx []byte) error {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '52,116p' ../agent-source/node.go; sed -n '348,461p' ../agent-source/node.go; sed -n '474,486p' ../agent-source/node.go; sed -n '507,550p' ../agent-source/node.go; sed -n '44,130p' ../agent-source/storage.go; sed -n '90,200p' ../agent-source/log_unstable.go; sed -n '130,185p' ../agent-source/tracker/progress.go; sed -n '178,204p' ../agent-source/confchange/confchange.go; sed -n '337,359p' ../agent-source/confchange/confchange.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '52,116p' ../agent-source/node.go; sed -n '348,461p' ../agent-source/node.go; sed -n '474,486p' ../agent-source/node.go; sed -n '507,550p' ../agent-source/node.go; sed -n '44,130p' ../agent-source/storage.go; sed -n '90,200p' ../agent-source/log_unstable.go; sed -n '130,185p' ../agent-source/tracker/progress.go; sed -n '178,204p' ../agent-source/confchange/confchange.go; sed -n '337,359p' ../agent-source/confchange/confchange.go\"","aggregated_output":"func (c Changer) makeVoter(cfg *tracker.Config, trk tracker.ProgressMap, id uint64) {\n\tpr := trk[id]\n\tif pr == nil {\n\t\tc.initProgress(cfg, trk, id, false /* isLearner */)\n\t\treturn\n\t}\n\n\tpr.IsLearner = false\n\tnilAwareDelete(&cfg.Learners, id)\n\tnilAwareDelete(&cfg.LearnersNext, id)\n\tincoming(cfg.Voters)[id] = struct{}{}\n}\n\n// makeLearner makes the given ID a learner or stages it to be a learner once\n// an active joint configuration is exited.\n//\n// The former happens when the peer is not a part of the outgoing config, in\n// which case we either add a new learner or demote a voter in the incoming\n// config.\n//\n// The latter case occurs when the configuration is joint and the peer is a\n// voter in the outgoing config. In that case, we do not want to add the peer\n// as a learner because then we'd have to track a peer as a voter and learner\n// simultaneously. Instead, we add the learner to LearnersNext, so that it will\n// be added to Learners the moment the outgoing config is removed by\n// LeaveJoint().\nfunc (c Changer) makeLearner(cfg *tracker.Config, trk tracker.ProgressMap, id uint64) {\nfunc (c Changer) checkAndCopy() (tracker.Config, tracker.ProgressMap, error) {\n\tcfg := c.Tracker.Config.Clone()\n\ttrk := tracker.ProgressMap{}\n\n\tfor id, pr := range c.Tracker.Progress {\n\t\t// A shallow copy is enough because we only mutate the Learner field.\n\t\tppr := *pr\n\t\ttrk[id] = &ppr\n\t}\n\treturn checkAndReturn(cfg, trk)\n}\n\n// checkAndReturn calls checkInvariants on the input and returns either the\n// resulting error or the input.\nfunc checkAndReturn(cfg tracker.Config, trk tracker.ProgressMap) (tracker.Config, tracker.ProgressMap, error) {\n\tif err := checkInvariants(cfg, trk); err != nil {\n\t\treturn tracker.Config{}, tracker.ProgressMap{}, err\n\t}\n\treturn cfg, trk, nil\n}\n\n// err returns zero values and an error.\nfunc (c Changer) err(err error) (tracker.Config, tracker.ProgressMap, error) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '185,260p' ../agent-source/tracker/progress.go; sed -n '196,235p' ../agent-source/log_unstable.go; sed -n '135,290p' ../agent-source/raft.go; sed -n '276,336p' ../agent-source/confchange/confchange.go; sed -n '26,118p' ../agent-source/confchange/restore.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '185,260p' ../agent-source/tracker/progress.go; sed -n '196,235p' ../agent-source/log_unstable.go; sed -n '135,290p' ../agent-source/raft.go; sed -n '276,336p' ../agent-source/confchange/confchange.go; sed -n '26,118p' ../agent-source/confchange/restore.go\"","aggregated_output":"}\n\n// CanBumpCommit returns true if sending the given commit index can potentially\n// advance the follower's commit index.\nfunc (pr *Progress) CanBumpCommit(index uint64) bool {\n\t// Sending the given commit index may bump the follower's commit index up to\n\t// Next-1 in normal operation, or higher in some rare cases. Allow sending a\n\t// commit index eagerly only if we haven't already sent one that bumps the\n\t// follower's commit all the way to Next-1.\n\treturn index > pr.sentCommit && pr.sentCommit < pr.Next-1\n}\n\n// SentCommit updates the sentCommit.\nfunc (pr *Progress) SentCommit(commit uint64) {\n\tpr.sentCommit = commit\n}\n\n// MaybeUpdate is called when an MsgAppResp arrives from the follower, with the\n// index acked by it. The method returns false if the given n index comes from\n// an outdated message. Otherwise it updates the progress and returns true.\nfunc (pr *Progress) MaybeUpdate(n uint64) bool {\n\tif n <= pr.Match {\n\t\treturn false\n\t}\n\tpr.Match = n\n\tpr.Next = max(pr.Next, n+1) // invariant: Match < Next\n\tpr.MsgAppFlowPaused = false\n\treturn true\n}\n\n// MaybeDecrTo adjusts the Progress to the receipt of a MsgApp rejection. The\n// arguments are the index of the append message rejected by the follower, and\n// the hint that we want to decrease to.\n//\n// Rejections can happen spuriously as messages are sent out of order or\n// duplicated. In such cases, the rejection pertains to an index that the\n// Progress already knows were previously acknowledged, and false is returned\n// without changing the Progress.\n//\n// If the rejection is genuine, Next is lowered sensibly, and the Progress is\n// cleared for sending log entries.\nfunc (pr *Progress) MaybeDecrTo(rejected, matchHint uint64) bool {\n\tif pr.State == StateReplicate {\n\t\t// The rejection must be stale if the progress has matched and \"rejected\"\n\t\t// is smaller than \"match\".\n\t\tif rejected <= pr.Match {\n\t\t\treturn false\n\t\t}\n\t\t// Directly decrease next to match + 1.\n\t\t//\n\t\t// TODO(tbg): why not use matchHint if it's larger?\n\t\tpr.Next = pr.Match + 1\n\t\t// Regress the sentCommit since it unlikely has been applied.\n\t\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n\t\treturn true\n\t}\n\n\t// The rejection must be stale if \"rejected\" does not match next - 1. This\n\t// is because non-replicating followers are probed one entry at a time.\n\t// The check is a best effort assuming message reordering is rare.\n\tif pr.Next-1 != rejected {\n\t\treturn false\n\t}\n\n\tpr.Next = max(min(rejected, matchHint+1), pr.Match+1)\n\t// Regress the sentCommit since it unlikely has been applied.\n\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n\tpr.MsgAppFlowPaused = false\n\treturn true\n}\n\n// IsPaused returns whether sending log entries to this node has been throttled.\n// This is done when a node has rejected recent MsgApps, is currently waiting\n// for a snapshot, or has reached the MaxInflightMsgs limit. In normal\n// operation, this is false. A throttled node will be contacted less frequently\n// until it has reached a state in which it's able to accept a steady stream of\nfunc (u *unstable) truncateAndAppend(ents []pb.Entry) {\n\tfromIndex := ents[0].Index\n\tswitch {\n\tcase fromIndex == u.offset+uint64(len(u.entries)):\n\t\t// fromIndex is the next index in the u.entries, so append directly.\n\t\tu.entries = append(u.entries, ents...)\n\tcase fromIndex <= u.offset:\n\t\tu.logger.Infof(\"replace the unstable entries from index %d\", fromIndex)\n\t\t// The log is being truncated to before our current offset\n\t\t// portion, so set the offset and replace the entries.\n\t\tu.entries = ents\n\t\tu.offset = fromIndex\n\t\tu.offsetInProgress = u.offset\n\tdefault:\n\t\t// Truncate to fromIndex (exclusive), and append the new entries.\n\t\tu.logger.Infof(\"truncate the unstable entries before index %d\", fromIndex)\n\t\tkeep := u.slice(u.offset, fromIndex) // NB: appending to this slice is safe,\n\t\tu.entries = append(keep, ents...)    // and will reallocate/copy it\n\t\t// Only in-progress entries before fromIndex are still considered to be\n\t\t// in-progress.\n\t\tu.offsetInProgress = min(u.offsetInProgress, fromIndex)\n\t}\n}\n\n// slice returns the entries from the unstable log with indexes in the range\n// [lo, hi). The entire range must be stored in the unstable log or the method\n// will panic. The returned slice can be appended to, but the entries in it must\n// not be changed because they are still shared with unstable.\n//\n// TODO(pavelkalinnikov): this, and similar []pb.Entry slices, may bubble up all\n// the way to the application code through Ready struct. Protect other slices\n// similarly, and document how the client can use them.\nfunc (u *unstable) slice(lo uint64, hi uint64) []pb.Entry {\n\tu.mustCheckOutOfBounds(lo, hi)\n\t// NB: use the full slice expression to limit what the caller can do with the\n\t// returned slice. For example, an append will reallocate and copy this slice\n\t// instead of corrupting the neighbouring u.entries.\n\treturn u.entries[lo-u.offset : hi-u.offset : hi-u.offset]\n}\n\n\t// HeartbeatTick is the number of Node.Tick invocations that must pass between\n\t// heartbeats. That is, a leader sends heartbeat messages to maintain its\n\t// leadership every HeartbeatTick ticks.\n\tHeartbeatTick int\n\n\t// Storage is the storage for raft. raft generates entries and states to be\n\t// stored in storage. raft reads the persisted entries and states out of\n\t// Storage when it needs. raft reads out the previous state and configuration\n\t// out of storage when restarting.\n\tStorage Storage\n\t// Applied is the last applied index. It should only be set when restarting\n\t// raft. raft will not return entries to the application smaller or equal to\n\t// Applied. If Applied is unset when restarting, raft might return previous\n\t// applied entries. This is a very application dependent configuration.\n\tApplied uint64\n\n\t// AsyncStorageWrites configures the raft node to write to its local storage\n\t// (raft log and state machine) using a request/response message passing\n\t// interface instead of the default Ready/Advance function call interface.\n\t// Local storage messages can be pipelined and processed asynchronously\n\t// (with respect to Ready iteration), facilitating reduced interference\n\t// between Raft proposals and increased batching of log appends and state\n\t// machine application. As a result, use of asynchronous storage writes can\n\t// reduce end-to-end commit latency and increase maximum throughput.\n\t//\n\t// When true, the Ready.Message slice will include MsgStorageAppend and\n\t// MsgStorageApply messages. The messages will target a LocalAppendThread\n\t// and a LocalApplyThread, respectively. Messages to the same target must be\n\t// reliably processed in order. In other words, they can't be dropped (like\n\t// messages over the network) and those targeted at the same thread can't be\n\t// reordered. Messages to different targets can be processed in any order.\n\t//\n\t// MsgStorageAppend carries Raft log entries to append, election votes /\n\t// term changes / updated commit indexes to persist, and snapshots to apply.\n\t// All writes performed in service of a MsgStorageAppend must be durable\n\t// before response messages are delivered. However, if the MsgStorageAppend\n\t// carries no response messages, durability is not required. The message\n\t// assumes the role of the Entries, HardState, and Snapshot fields in Ready.\n\t//\n\t// MsgStorageApply carries committed entries to apply. Writes performed in\n\t// service of a MsgStorageApply need not be durable before response messages\n\t// are delivered. The message assumes the role of the CommittedEntries field\n\t// in Ready.\n\t//\n\t// Local messages each carry one or more response messages which should be\n\t// delivered after the corresponding storage write has been completed. These\n\t// responses may target the same node or may target other nodes. The storage\n\t// threads are not responsible for understanding the response messages, only\n\t// for delivering them to the correct target after performing the storage\n\t// write.\n\tAsyncStorageWrites bool\n\n\t// MaxSizePerMsg limits the max byte size of each append message. Smaller\n\t// value lowers the raft recovery cost(initial probing and message lost\n\t// during normal operation). On the other side, it might affect the\n\t// throughput during normal replication. Note: math.MaxUint64 for unlimited,\n\t// 0 for at most one entry per message.\n\tMaxSizePerMsg uint64\n\t// MaxCommittedSizePerReady limits the size of the committed entries which\n\t// can be applying at the same time.\n\t//\n\t// Despite its name (preserved for compatibility), this quota applies across\n\t// Ready structs to encompass all outstanding entries in unacknowledged\n\t// MsgStorageApply messages when AsyncStorageWrites is enabled.\n\tMaxCommittedSizePerReady uint64\n\t// MaxUncommittedEntriesSize limits the aggregate byte size of the\n\t// uncommitted entries that may be appended to a leader's log. Once this\n\t// limit is exceeded, proposals will begin to return ErrProposalDropped\n\t// errors. Note: 0 for no limit.\n\tMaxUncommittedEntriesSize uint64\n\t// MaxInflightMsgs limits the max number of in-flight append messages during\n\t// optimistic replication phase. The application transportation layer usually\n\t// has its own sending buffer over TCP/UDP. Setting MaxInflightMsgs to avoid\n\t// overflowing that sending buffer. TODO (xiangli): feedback to application to\n\t// limit the proposal rate?\n\tMaxInflightMsgs int\n\t// MaxInflightBytes limits the number of in-flight bytes in append messages.\n\t// Complements MaxInflightMsgs. Ignored if zero.\n\t//\n\t// This effectively bounds the bandwidth-delay product. Note that especially\n\t// in high-latency deployments setting this too low can lead to a dramatic\n\t// reduction in throughput. For example, with a peer that has a round-trip\n\t// latency of 100ms to the leader and this setting is set to 1 MB, there is a\n\t// throughput limit of 10 MB/s for this group. With RTT of 400ms, this drops\n\t// to 2.5 MB/s. See Little's law to understand the maths behind.\n\tMaxInflightBytes uint64\n\n\t// CheckQuorum specifies if the leader should check quorum activity. Leader\n\t// steps down when quorum is not active for an electionTimeout.\n\tCheckQuorum bool\n\n\t// PreVote enables the Pre-Vote algorithm described in raft thesis section\n\t// 9.6. This prevents disruption when a node that has been partitioned away\n\t// rejoins the cluster.\n\tPreVote bool\n\n\t// ReadOnlyOption specifies how the read only request is processed.\n\t//\n\t// ReadOnlySafe guarantees the linearizability of the read only request by\n\t// communicating with the quorum. It is the default and suggested option.\n\t//\n\t// ReadOnlyLeaseBased ensures linearizability of the read only request by\n\t// relying on the leader lease. It can be affected by clock drift.\n\t// If the clock drift is unbounded, leader might keep the lease longer than it\n\t// should (clock can move backward/pause without any bound). ReadIndex is not safe\n\t// in that case.\n\t// CheckQuorum MUST be enabled if ReadOnlyOption is ReadOnlyLeaseBased.\n\tReadOnlyOption ReadOnlyOption\n\n\t// Logger is the logger used for raft log. For multinode which can host\n\t// multiple raft group, each raft group can have its own logger\n\tLogger Logger\n\n\t// DisableProposalForwarding set to true means that followers will drop\n\t// proposals, rather than forwarding them to the leader. One use case for\n\t// this feature would be in a situation where the Raft leader is used to\n\t// compute the data of a proposal, for example, adding a timestamp from a\n\t// hybrid logical clock to data in a monotonically increasing way. Forwarding\n\t// should be disabled to prevent a follower with an inaccurate hybrid\n\t// logical clock from assigning the timestamp and then forwarding the data\n\t// to the leader.\n\tDisableProposalForwarding bool\n\n\t// DisableConfChangeValidation turns off propose-time verification of\n\t// configuration changes against the currently active configuration of the\n\t// raft instance. These checks are generally sensible (cannot leave a joint\n\t// config unless in a joint config, et cetera) but they have false positives\n\t// because the active configuration may not be the most recent\n\t// configuration. This is because configurations are activated during log\n\t// application, and even the leader can trail log application by an\n\t// unbounded number of entries.\n\t// Symmetrically, the mechanism has false negatives - because the check may\n\t// not run against the \"actual\" config that will be the predecessor of the\n\t// newly proposed one, the check may pass but the new config may be invalid\n\t// when it is being applied. In other words, the checks are best-effort.\n\t//\n\t// Users should *not* use this option unless they have a reliable mechanism\n\t// (above raft) that serializes and verifies configuration changes. If an\n\t// invalid configuration change enters the log and gets applied, a panic\n\t// will result.\n\t//\n\t// This option may be removed once false positives are no longer possible.\n\t// See: https://github.com/etcd-io/raft/issues/80\n\tDisableConfChangeValidation bool\n\n\t// StepDownOnRemoval makes the leader step down when it is removed from the\n\t// group or demoted to a learner.\n\t//\n\t// This behavior will become unconditional in the future. See:\n\t// https://github.com/etcd-io/raft/issues/83\n\tStepDownOnRemoval bool\n\n\t// raft state tracer\n\tTraceLogger TraceLogger\n}\n\nfunc checkInvariants(cfg tracker.Config, trk tracker.ProgressMap) error {\n\t// NB: intentionally allow the empty config. In production we'll never see a\n\t// non-empty config (we prevent it from being created) but we will need to\n\t// be able to *create* an initial config, for example during bootstrap (or\n\t// during tests). Instead of having to hand-code this, we allow\n\t// transitioning from an empty config into any other legal and non-empty\n\t// config.\n\tfor _, ids := range []map[uint64]struct{}{\n\t\tcfg.Voters.IDs(),\n\t\tcfg.Learners,\n\t\tcfg.LearnersNext,\n\t} {\n\t\tfor id := range ids {\n\t\t\tif _, ok := trk[id]; !ok {\n\t\t\t\treturn fmt.Errorf(\"no progress for %d\", id)\n\t\t\t}\n\t\t}\n\t}\n\n\t// Any staged learner was staged because it could not be directly added due\n\t// to a conflicting voter in the outgoing config.\n\tfor id := range cfg.LearnersNext {\n\t\tif _, ok := outgoing(cfg.Voters)[id]; !ok {\n\t\t\treturn fmt.Errorf(\"%d is in LearnersNext, but not Voters[1]\", id)\n\t\t}\n\t\tif trk[id].IsLearner {\n\t\t\treturn fmt.Errorf(\"%d is in LearnersNext, but is already marked as learner\", id)\n\t\t}\n\t}\n\t// Conversely Learners and Voters doesn't intersect at all.\n\tfor id := range cfg.Learners {\n\t\tif _, ok := outgoing(cfg.Voters)[id]; ok {\n\t\t\treturn fmt.Errorf(\"%d is in Learners and Voters[1]\", id)\n\t\t}\n\t\tif _, ok := incoming(cfg.Voters)[id]; ok {\n\t\t\treturn fmt.Errorf(\"%d is in Learners and Voters[0]\", id)\n\t\t}\n\t\tif !trk[id].IsLearner {\n\t\t\treturn fmt.Errorf(\"%d is in Learners, but is not marked as learner\", id)\n\t\t}\n\t}\n\n\tif !joint(cfg) {\n\t\t// We enforce that empty maps are nil instead of zero.\n\t\tif outgoing(cfg.Voters) != nil {\n\t\t\treturn fmt.Errorf(\"cfg.Voters[1] must be nil when not joint\")\n\t\t}\n\t\tif cfg.LearnersNext != nil {\n\t\t\treturn fmt.Errorf(\"cfg.LearnersNext must be nil when not joint\")\n\t\t}\n\t\tif cfg.AutoLeave {\n\t\t\treturn fmt.Errorf(\"AutoLeave must be false when not joint\")\n\t\t}\n\t}\n\n\treturn nil\n}\n\n// checkAndCopy copies the tracker's config and progress map (deeply enough for\n// the purposes of the Changer) and returns those copies. It returns an error\n// if checkInvariants does.\nfunc toConfChangeSingle(cs pb.ConfState) (out []pb.ConfChangeSingle, in []pb.ConfChangeSingle) {\n\t// Example to follow along this code:\n\t// voters=(1 2 3) learners=(5) outgoing=(1 2 4 6) learners_next=(4)\n\t//\n\t// This means that before entering the joint config, the configuration\n\t// had voters (1 2 4 6) and perhaps some learners that are already gone.\n\t// The new set of voters is (1 2 3), i.e. (1 2) were kept around, and (4 6)\n\t// are no longer voters; however 4 is poised to become a learner upon leaving\n\t// the joint state.\n\t// We can't tell whether 5 was a learner before entering the joint config,\n\t// but it doesn't matter (we'll pretend that it wasn't).\n\t//\n\t// The code below will construct\n\t// outgoing = add 1; add 2; add 4; add 6\n\t// incoming = remove 1; remove 2; remove 4; remove 6\n\t//            add 1;    add 2;    add 3;\n\t//            add-learner 5;\n\t//            add-learner 4;\n\t//\n\t// So, when starting with an empty config, after applying 'outgoing' we have\n\t//\n\t//   quorum=(1 2 4 6)\n\t//\n\t// From which we enter a joint state via 'incoming'\n\t//\n\t//   quorum=(1 2 3)&&(1 2 4 6) learners=(5) learners_next=(4)\n\t//\n\t// as desired.\n\n\tfor _, id := range cs.VotersOutgoing {\n\t\t// If there are outgoing voters, first add them one by one so that the\n\t\t// (non-joint) config has them all.\n\t\tout = append(out, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddNode,\n\t\t\tNodeID: id,\n\t\t})\n\n\t}\n\n\t// We're done constructing the outgoing slice, now on to the incoming one\n\t// (which will apply on top of the config created by the outgoing slice).\n\n\t// First, we'll remove all of the outgoing voters.\n\tfor _, id := range cs.VotersOutgoing {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeRemoveNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\t// Then we'll add the incoming voters and learners.\n\tfor _, id := range cs.Voters {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\tfor _, id := range cs.Learners {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddLearnerNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\t// Same for LearnersNext; these are nodes we want to be learners but which\n\t// are currently voters in the outgoing config.\n\tfor _, id := range cs.LearnersNext {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddLearnerNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\treturn out, in\n}\n\nfunc chain(chg Changer, ops ...func(Changer) (tracker.Config, tracker.ProgressMap, error)) (tracker.Config, tracker.ProgressMap, error) {\n\tfor _, op := range ops {\n\t\tcfg, trk, err := op(chg)\n\t\tif err != nil {\n\t\t\treturn tracker.Config{}, nil, err\n\t\t}\n\t\tchg.Tracker.Config = cfg\n\t\tchg.Tracker.Progress = trk\n\t}\n\treturn chg.Tracker.Config, chg.Tracker.Progress, nil\n}\n\n// Restore takes a Changer (which must represent an empty configuration), and\n// runs a sequence of changes enacting the configuration described in the\n// ConfState.\n//\n// TODO(tbg) it's silly that this takes a Changer. Unravel this by making sure\n// the Changer only needs a ProgressMap (not a whole Tracker) at which point\n// this can just take LastIndex and MaxInflight directly instead and cook up\n// the results from that alone.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"I’ve traced proposal replication and authority transitions through their shared term, log, and membership state. Stale append completions are term-filtered; snapshot and application completions follow different paths because they represent committed state. I also found conflicting synchronous `Ready` ordering statements in `doc.go` and `node.go`; I’ll preserve that as an unresolved contract question.\n"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nfrom pathlib import Path\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nsrc('S_API','rawnode.go',30,188)\nsrc('S_READY_CONTRACT','node.go',52,115,'interface_statement')\nsrc('S_DOC_USAGE','doc.go',69,179,'document_statement')\nsrc('S_CONFIG','raft.go',140,284,'interface_statement')\nsrc('S_NODE_LOOP','node.go',348,460)\nsrc('S_NODE_CALL','node.go',474,485)\nsrc('S_NODE_WAIT','node.go',507,550)\nsrc('S_INIT','raft.go',437,495)\nsrc('S_SEND','raft.go',502,601)\nsrc('S_REPLICATE','raft.go',616,739)\nsrc('S_APPLIED','raft.go',740,783)\nsrc('S_RESET','raft.go',784,849)\nsrc('S_ROLE','raft.go',850,1023)\nsrc('S_CAMPAIGN','raft.go',1025,1083)\nsrc('S_DISPATCH','raft.go',1085,1261)\nsrc('S_PROPOSE','raft.go',1267,1397)\nsrc('S_ACK','raft.go',1500,1664)\nsrc('S_CANDIDATE_FOLLOWER','raft.go',1668,1774)\nsrc('S_FOLLOWER_LOG','raft.go',1786,1945)\nsrc('S_ACTIVATE','raft.go',1947,2041)\nsrc('S_READ_REPLY','raft.go',2062,2090)\nsrc('S_READ_RELEASE','raft.go',2123,2160)\nsrc('S_READ_QUEUE','read_only.go',19,129)\nsrc('S_STORAGE_MSG','rawnode.go',193,365)\nsrc('S_READY_ACK','rawnode.go',375,494)\nsrc('S_LOG_APPEND','log.go',73,142)\nsrc('S_LOG_APPLY','log.go',218,272)\nsrc('S_LOG_PROGRESS','log.go',320,373)\nsrc('S_LOG_COMMIT','log.go',440,468)\nsrc('S_UNSTABLE','log_unstable.go',93,218)\nsrc('S_STORAGE_API','storage.go',46,92,'interface_statement')\nsrc('S_TRACKER','tracker/tracker.go',160,280)\nsrc('S_MAJORITY','quorum/majority.go',118,196)\nsrc('S_JOINT','quorum/joint.go',17,77)\nsrc('S_PROGRESS','tracker/progress.go',130,253)\nsrc('S_CHANGE','confchange/confchange.go',51,359)\nsrc('S_RESTORE_CONFIG','confchange/restore.go',26,159)\nbeh=[]\ndef b(i,a,owner,ctx,trigger,ss,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trigger,source_ids=ss);d.update(kw);beh.append(d)\nb('B_ENTRY','A7','RawNode caller; node.run for Node','One local raft instance; RawNode requires caller serialization','Propose, Step, Campaign, Ready and Advance',['S_API','S_NODE_LOOP','S_NODE_CALL','S_NODE_WAIT','S_DOC_USAGE'],legal_preconditions=['Caller performs Ready storage/application duties; network responses identify their sender.'],implementation_guards=['RawNode rejects network-local messages and responses from unknown peers. Node applies corresponding filters in Step/run.'],external_effects=['Propose returns Step admission/error; Node waits for the Step result. This is not commit or application completion.'],important_branches=['Follower without a leader drops proposals; Node disables proposal reception while it has no leader. Cancellation can end the caller wait.'],cross_activity_effects={'A1':'Routes proposal and replication messages to the serialized raft owner.','A2':'Routes campaigns and term-bearing messages to authority transition logic.'},unknowns=['Network authentication and downstream client completion are outside this library boundary.'])\nb('B_PROPOSE','A1','raft.stepLeader / appendEntry','Leader term and currently installed progress/configuration','MsgProp or leader-entry creation',['S_PROPOSE','S_RESET','S_REPLICATE'],implementation_guards=['Reject if local progress is absent or transfer is active; enforce uncommitted byte quota.','Configuration proposal validation uses pendingConfIndex, applied index and joint status unless disabled.'],writes=['Assign current term and consecutive indexes; append to unstable log.'],external_effects=['Broadcast MsgApp carrying predecessor index/term, entries and commit.','Queue self MsgAppResp through send.'],important_branches=['Invalid configuration proposals can become empty normal entries; proposal acceptance does not activate membership.','Paused peer replication or unavailable log prefix may require snapshot/retry.'],produces_fact_ids=['F_ACK_QUEUED'],cross_activity_effects={'A6':'New entries and self-support await persistence processing.'},existing_protections=['Self-acknowledgement is queued after append; it does not immediately update Match.'])\nb('B_APPEND_FOLLOWER','A1','raft.handleAppendEntries / raftLog.maybeAppend','Follower receiving term-filtered MsgApp; index/entry-term history','Append request',['S_FOLLOWER_LOG','S_LOG_APPEND','S_SEND'],implementation_guards=['Match predecessor term before accepting; reject with hint on mismatch.','A conflicting entry at or below committed causes panic, not replacement.'],writes=['Append conflicting uncommitted suffix and commit at most min(message commit, last new index).'],external_effects=['Queue MsgAppResp for accepted last index, or committed index when predecessor is behind committed. Rejections also pass through the append barrier.'],produces_fact_ids=['F_ACK_QUEUED'],existing_protections=['The committed-prefix shortcut does not accept an arbitrary uncommitted suffix.'],cross_activity_effects={'A6':'Successful processing establishes an in-memory prefix; response durability is separately delegated to Ready handling.'})\nb('B_PERSIST_DISPATCH','A6','raft.send and RawNode Ready/Advance; external storage worker','Ready batch, current raft term, last entry index/term','Queued vote/append response or unstable/HardState update',['S_SEND','S_STORAGE_MSG','S_READY_ACK','S_CONFIG','S_READY_CONTRACT'],consumes_fact_ids=['F_ACK_QUEUED'],implementation_guards=['MsgAppResp, MsgVoteResp and MsgPreVoteResp are separated into msgsAfterAppend.','Async response records current raft term and last unstable entry identity, including in-progress entries.'],writes=['acceptReady clears queues and marks unstable work in progress; this does not attest durable storage.'],external_effects=['Async MsgStorageAppend carries responses for delivery after durable ordered writes.','Synchronous mode returns remote responses in Ready and defers self responses plus storage acknowledgements to Advance.'],durable_effects=['Actual persistence is a caller duty; the library emits work and completion messages, not disk writes.'],important_branches=['Append messages may exist solely to release responses or persist HardState.','Async Advance is forbidden; local apply work uses a separate ordered destination.'],cross_activity_effects={'A1':'Controls when self/peer support can legally be delivered and counted.','A2':'Controls publication of election votes and persisted term transitions.'},unknowns=['Synchronous same-batch message ordering differs between doc.go and the Ready interface comments; do not treat the weaker prose as settled permission.'])\nb('B_ACK_COMMIT','A1','raft.stepLeader, tracker and quorum','Current leader term and installed incoming/outgoing voter sets','MsgAppResp after Step term filtering',['S_ACK','S_PROPOSE','S_PROGRESS','S_TRACKER','S_MAJORITY','S_JOINT','S_APPLIED','S_LOG_COMMIT'],implementation_guards=['Require sender progress; MaybeUpdate monotonically increases Match.','Commit candidate must exceed current committed and its log term must equal current nonzero raft term.'],reads=['Per-peer Match; active voter sets; local log entry term.'],writes=['Update peer Match/Next and flow control; advance raftLog.committed on qualified index.'],produces_fact_ids=['F_MATCH','F_COMMITTED'],consumes_fact_ids=['F_MATCH'],important_branches=['Rejected/stale responses adjust or leave probing state; they do not establish successful Match.','Learner progress can update, but quorum iteration counts configured voters only.','Joint index is the minimum of both majority indexes.'],external_effects=['Broadcast commit advance; release pending reads after current-term commit.'],existing_protections=['Heartbeat replies mark activity and read acknowledgements, not replicated Match.'])\nb('B_CONTEXT','A2','raft.Step, campaign, stepCandidate and role transitions','Local raft term, role, vote and installed voter sets','Election tick/Campaign; votes; higher-term input; quorum loss; leader transfer',['S_DISPATCH','S_ROLE','S_RESET','S_CAMPAIGN','S_CANDIDATE_FOLLOWER','S_TRACKER','S_JOINT','S_LOG_COMMIT','S_PROPOSE','S_ACK'],implementation_guards=['Campaign requires eligible nonlearner progress, no in-progress snapshot, and no unapplied committed configuration change.','Vote eligibility combines stored vote/known leader with lexicographic last-entry freshness.','PreVote and granted future PreVote responses do not immediately advance term; lease check may suppress vote requests.'],writes=['Role reset clears vote tallies, peer progress, transfer state and readOnly acknowledgements; only term change clears Vote.','Self Match resets to local last index, other Match to zero; log and committed prefix remain.','New leader appends a current-term empty entry.'],important_branches=['Lower-term messages normally return before role handling; old storage append responses may still acknowledge their snapshot.','PreCandidate counts only PreVoteResp; Candidate counts only VoteResp.','Quorum loss with CheckQuorum steps down; transfer pauses proposals and sends TimeoutNow only after transferee catch-up.'],produces_fact_ids=['F_MATCH'],consumes_fact_ids=['F_MATCH'],cross_activity_effects={'A1':'Rebuilds volatile support on role changes; current-term commit guard connects new support to retained history.','A6':'Higher-term storage-completion filtering prevents old entry completion from clearing replacement unstable state.'},unknowns=['PendingReadIndexMessages is not cleared by reset, unlike readOnly; it is later reconfirmed through releasePendingReadIndexMessages after current-term commit. Effects across membership transitions merit focused investigation.'])\nb('B_STABLE_COMPLETION','A6','raft.Step and unstable.stableTo','Storage response raft term plus entry index/log term; snapshot index separately','MsgStorageAppendResp',['S_DISPATCH','S_STORAGE_MSG','S_UNSTABLE','S_APPLIED'],implementation_guards=['Current-term entry completion requires unstable entry index and term match.','Lower-term completion does not stabilize entries; included snapshot is still processed.'],writes=['Matching stableTo trims unstable prefix; snapshot completion clears matching snapshot and advances applied via max(index, oldApplied).'],existing_protections=['New-term HardState-only append can carry last unstable identity and provide a fresh ordered completion.'],cross_activity_effects={'A1':'Async application eligibility uses unstable offset after this completion.','A2':'Entry completion is context-qualified while committed snapshot completion can survive term change.'},unknowns=['Controlled same-history execution of delayed responses across replacements remains untested.'])\nb('B_MEMBERSHIP','A4','RawNode.ApplyConfChange / raft.switchToConfig / confchange.Changer','Applied configuration entry and incoming/outgoing voter sets','Caller applies committed ConfChange, or recovery restores ConfState',['S_API','S_ACTIVATE','S_CHANGE','S_RESTORE_CONFIG','S_APPLIED','S_CONFIG'],implementation_guards=['Simple change alters at most one voter; joint transitions preserve outgoing voters until LeaveJoint.','Nonempty voter requirement and voter/learner/progress invariants are checked.'],writes=['Install new Config and Progress; retained peers preserve copied Match; new peers start Match zero.','Outgoing voters retain progress; staged learners become learners after leaving joint.'],consumes_fact_ids=['F_MATCH'],produces_fact_ids=['F_COMMITTED'],external_effects=['Leader recomputes commit under updated quorum; sends append/probes and may abort removed transferee.'],important_branches=['Removed/demoted leader steps down only with StepDownOnRemoval; absent local progress separately rejects proposals.','Applied-progress callback can propose automatic joint exit.'],cross_activity_effects={'A1':'Changes which existing Match values qualify and can advance commitment without a new acknowledgement.','A2':'Changes campaigning eligibility and may remove current authority.'},unknowns=['Cancellation wording differs between RawNode ApplyConfChange and doc.go; a specific check must establish its selected API contract.'])\nb('B_APPLY','A5','RawNode.readyWithoutAccept / acceptReady and raft applied callbacks','Committed, applying and applied indexes; selected storage mode','Ready production and storage application completion',['S_API','S_READY_ACK','S_LOG_APPLY','S_LOG_PROGRESS','S_APPLIED','S_READY_CONTRACT'],consumes_fact_ids=['F_COMMITTED'],implementation_guards=['Do not expose committed entries alongside outstanding snapshot; limit outstanding application bytes.','Async mode limits application to stable prefix; synchronous mode can include unstable committed entries subject to caller Ready duties.'],writes=['Ready acceptance advances applying; Advance or MsgStorageApplyResp advances applied and releases quota.'],external_effects=['CommittedEntries or MsgStorageApply is application work, not an observed external client response.'],important_branches=['MsgStorageApplyResp uses term zero because committed entries survive terms.'],cross_activity_effects={'A4':'Applied-progress callback can initiate automatic joint exit.'})\nb('B_RECOVERY','A3','newRaft and raft.restore','Persisted HardState/ConfState and log; snapshot index/term/configuration','Restart or MsgSnap',['S_INIT','S_ACTIVATE','S_FOLLOWER_LOG','S_LOG_APPEND','S_LOG_COMMIT','S_RESTORE_CONFIG','S_STORAGE_API','S_UNSTABLE'],writes=['Restart loads term/vote/commit, reconstructs membership and starts follower.','Nonobsolete snapshot either fast-forwards matching log commit or replaces unstable history and reconstructs membership.'],produces_fact_ids=['F_COMMITTED'],implementation_guards=['loadState bounds commit by available log.','Snapshot restoration requires follower state and recipient inclusion; obsolete snapshots are ignored.'],cross_activity_effects={'A1':'Preserves/reconstructs committed prefix while volatile peer support is rebuilt.','A2':'Restart starts without known leader, using saved term/vote and recovered eligibility.'},unknowns=['Caller crash consistency and concrete disk-backed Storage behavior are external; MemoryStorage implementation is not yet fully traced.'])\nb('B_READ','A1','stepLeader heartbeat handling and readOnly','ReadOnlySafe request context, captured commit index and current voter configuration','ReadIndex and heartbeat acknowledgements',['S_PROPOSE','S_ACK','S_READ_QUEUE','S_READ_REPLY','S_READ_RELEASE','S_CANDIDATE_FOLLOWER','S_CONFIG'],implementation_guards=['Non-singleton leader defers reads until current-term commit.','Safe mode collects unique peer acknowledgements by request context and evaluates installed voter quorum.'],writes=['Capture committed index; self-ack; queue request context; drain prefix through acknowledged context.'],external_effects=['Emit ReadState locally or MsgReadIndexResp; follower accepts exactly one entry carrying request context.'],consumes_fact_ids=['F_COMMITTED'],important_branches=['Singleton bypasses heartbeat round; lease mode relies on configured lease assumptions.','Duplicate context is ignored by addRequest; caller must correlate unique requests.'],cross_activity_effects={'A7':'Ready ReadState still requires caller application progress before serving a local read.'},unknowns=['Safety of acknowledgement reuse across membership change requires its own applicability and history investigation.'])\nfacts=[\n dict(id='F_ACK_QUEUED',meaning='A local append path has queued a MsgAppResp for the indicated index; it has not thereby persisted entries or delivered support.',identity={'node':'response From','recipient':'response To','term':'response Term','index':'response Index'},validity_context='The local raft state when send queues the response; successful follower append or leader self append.',representation=['raft.msgsAfterAppend MsgAppResp'],durability='Volatile queued work. Legal delivery depends on the Ready/storage contract.',recovery='Queued messages are not recovered as messages; restart reconstructs protocol state and can regenerate replies.',source_ids=['S_RESET','S_FOLLOWER_LOG','S_SEND','S_STORAGE_MSG'],unknowns=['No execution has established a concrete durable write or message delivery.']),\n dict(id='F_MATCH',meaning='Within the current progress generation, the leader records the highest accepted successful append response index for a peer, or the local last index assigned by role reset for itself. This is an implementation support value, not an independently observed durable disk prefix.',identity={'owner':'raft instance','peer':'Progress map key','generation':'role-reset generation and raft term'},validity_context='Current Progress object; preserved peers can retain it through configuration activation, while reset replaces progress values.',representation=['Progress.Match'],invalidators=['B_CONTEXT'],reinterpreters=['B_MEMBERSHIP'],durability='Volatile.',recovery='Peer values are reset; self value is initialized from local history.',source_ids=['S_RESET','S_PROGRESS','S_ACK','S_CHANGE'],unknowns=['Its interpretation as durable support relies on legal response production/delivery and elected-leader history; no direct execution evidence yet.']),\n dict(id='F_COMMITTED',meaning='Local raftLog.committed marks a prefix selected by current-term quorum advancement, leader commit propagation, snapshot adoption or persisted-state reconstruction. It does not itself assert application or client completion.',identity={'node':'local raft instance','prefix_end':'raftLog.committed'},validity_context='Local log history retained across role/term resets; peer support aggregation is configuration-dependent.',representation=['raftLog.committed','HardState.Commit'],durability='Emitted in HardState; actual persisted completion is separate.',recovery='loadState validates saved commit bounds; snapshots supply committed index.',source_ids=['S_APPLIED','S_LOG_APPEND','S_LOG_COMMIT','S_ACTIVATE','S_FOLLOWER_LOG','S_INIT'],unknowns=['Follower heartbeat producer/consumer is covered in overview but not yet a separate fact-producing Behavior; broader producer decomposition is pending.'])]\nactivities=[]\nroles=json.load(open('../research.json'))['activity_roles']\nfor a in roles:\n bs=[x for x in beh if x['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary='; '.join(x['execution_owner'] for x in bs),entry_points=[x['trigger'] for x in bs],source_ids=list(dict.fromkeys(s for x in bs for s in x['source_ids']))))\noverview=dict(status='usable',rationale='Source-grounded backbone for both core relationships and their connection, with supporting membership, recovery and Ready/application paths. This is an understanding judgment, not a correctness result or exhaustive map.',\n formation=dict(explanation='A serialized RawNode caller or node.run admits Propose into raft.Step. Followers may forward; candidates or leaderless followers drop. A leader assigns term/index, appends unstable entries, queues a self acknowledgement and replicates MsgApp with predecessor identity. Followers validate the predecessor, refuse committed conflicts, truncate only uncommitted suffixes, and queue append responses. send separates these responses from immediately sendable messages. In async mode ordered durable append work releases responses; synchronous Ready/Advance splits remote and self delivery under caller persistence duties. The leader term-filters replies, requires sender progress, updates Match monotonically, computes the majority-supported index (both majorities for joint membership), and advances only if that index has the current term. Commit is propagated in appends; heartbeats cap commit at the recipient Match. Followers cap append commit at their matched request suffix. Ready exposes committed work with snapshot and application-size guards; async mode additionally requires local stabilization. Applied callbacks are distinct from Ready acceptance and client completion. Propose success promises no commitment.',behavior_ids=['B_ENTRY','B_PROPOSE','B_APPEND_FOLLOWER','B_PERSIST_DISPATCH','B_ACK_COMMIT','B_APPLY'],fact_ids=['F_ACK_QUEUED','F_MATCH','F_COMMITTED'],source_ids=['S_API','S_DOC_USAGE','S_NODE_LOOP','S_PROPOSE','S_RESET','S_SEND','S_REPLICATE','S_FOLLOWER_LOG','S_ACK','S_TRACKER','S_MAJORITY','S_JOINT','S_LOG_COMMIT','S_STORAGE_MSG','S_READY_ACK','S_LOG_APPLY']),\n context=dict(explanation='Authority belongs to a raft instance in a term and installed voter configuration. Election ticks or Campaign require promotability and no unapplied committed configuration change. PreVote can probe the next term without changing current term/vote; real campaigning increments term and queues durable self-vote support. Vote recipients check previous vote/known leader and candidate last-entry freshness. Candidates tally only the response type matching their phase, using configured voter majorities. Winning real election resets progress and appends a current-term empty entry. Higher-term messages generally install follower state, with explicit pre-vote and lease exceptions; stale messages are normally ignored. CheckQuorum may remove leadership; transfer pauses proposals and waits for transferee catch-up. Membership activates through caller application of committed configuration entries, using simple/joint transitions and retained progress. Restart reconstructs saved term/vote/commit and membership but starts follower with no leader. Snapshot acceptance checks obsolescence, follower state and recipient membership before restoring history/configuration or fast-forwarding matching commit.',behavior_ids=['B_CONTEXT','B_MEMBERSHIP','B_RECOVERY'],fact_ids=['F_MATCH','F_COMMITTED'],source_ids=['S_ROLE','S_CAMPAIGN','S_DISPATCH','S_CANDIDATE_FOLLOWER','S_LOG_COMMIT','S_TRACKER','S_JOINT','S_CHANGE','S_ACTIVATE','S_INIT','S_FOLLOWER_LOG','S_RESTORE_CONFIG']),\n connection=dict(explanation='Role reset discards vote tallies and remote Match, retains local history/commit, initializes self Match from that history and rebuilds readOnly acknowledgements. A new current-term entry plus quorum/current-term commitment reconnects retained history to new leadership. Configuration activation can reinterpret retained Match and call maybeCommit without a fresh reply. Old queued responses can survive emission, so consumers enforce term filtering; storage append completion additionally matches entry index/log term before trimming unstable memory. Snapshot completion from an older term remains processed, and application responses have term zero, reflecting committed state that outlives authority. Pending read requests awaiting first current-term commit survive reset separately from readOnly acknowledgement state: they are released only after a current-term commit and then enter the selected read confirmation mechanism. Safe reads correlate heartbeat acknowledgements by context and installed voters; returned ReadState is still subject to caller application progress. These mechanisms separate volatile support, established local decisions, durable state and externally served results.',behavior_ids=['B_CONTEXT','B_MEMBERSHIP','B_STABLE_COMPLETION','B_READ','B_APPLY'],fact_ids=['F_MATCH','F_COMMITTED'],source_ids=['S_RESET','S_ROLE','S_ACTIVATE','S_DISPATCH','S_STORAGE_MSG','S_UNSTABLE','S_READY_ACK','S_PROPOSE','S_READ_RELEASE','S_READ_QUEUE','S_ACK','S_READY_CONTRACT']),\n core_gaps=[],open_details=['Reconcile doc.go same-batch persistence/send overlap with stricter Ready interface wording before selecting synchronous driver permissions.','ReadIndex acknowledgement eligibility across configuration activation and retained pending reads needs a local discriminator.','Detailed disk failure, crash recovery and application transaction behavior are outside the captured library contract; MemoryStorage and bootstrap implementation variants remain partly unread.','Fact producer decomposition is partial: heartbeat commit and read support require separate Behaviors before a Candidate depends on them.'])\nsurfaces=[dict(entry_point='Synchronous Ready persistence and message ordering',disposition='deferred',reason='doc.go permits same-batch overlap whereas Ready.Messages and RawNode comments require Entries persisted before Messages. This is conflicting contract evidence, not an implementation violation.',source_ids=['S_DOC_USAGE','S_READY_CONTRACT','S_API'],high_consequence=True),dict(entry_point='ReadIndex across switchToConfig and reset',disposition='deferred',reason='readOnly acknowledgements are context-keyed and consumed with current voters; reset replaces that state but retains the separate first-commit pending queue. Need legal membership/authority history and normative scope before a focused question.',source_ids=['S_READ_QUEUE','S_RESET','S_READ_RELEASE','S_ACTIVATE','S_ACK'],high_consequence=True),dict(entry_point='RawNode.ApplyConfChange rejection convention',disposition='deferred',reason='RawNode comment permits no call when rejecting while doc.go describes calling with NodeID zero; selected API and application duties must be reconciled.',source_ids=['S_API','S_DOC_USAGE'],high_consequence=True),dict(entry_point='Storage implementation and external durable/apply workers',disposition='deferred',reason='Storage interface and core consumers read; concrete MemoryStorage mutations and worker implementations require expansion if selected. Actual disk durability and client response lie outside the library.',source_ids=['S_STORAGE_API','S_CONFIG'],high_consequence=True)]\nmapdata=dict(version=1,target_profile=dict(system_boundary='Captured go.etcd.io/raft library: raft state machine, RawNode/Node adapters, quorum, configuration, log and Storage interface. Network transport, durable disk writes, application state machine and client completion are caller responsibilities.',protocol_contexts=['Per-instance raft term/role','Active simple or joint voter configuration','Log entry index and entry term','Read request context'],external_interfaces=['RawNode and Node','Storage','Ready/Advance','Async MsgStorageAppend/Apply and response messages'],ownership=['RawNode is thread-unsafe and caller-serialized; Node.run serializes its state-machine events.'],selection_injection=['Caller supplies Storage, IDs, recovered state and configuration choices; in-repository quorum and membership implementations are traced rather than treated as external.'],variants=['Sync and async storage','PreVote and CheckQuorum','Simple and joint membership','Safe and lease-based ReadIndex','StepDownOnRemoval'],source_ids=['S_API','S_CONFIG','S_NODE_LOOP','S_STORAGE_API'],unknowns=['Authentication and transport fault enforcement are outside the captured library.']),activities=activities,behaviors=beh,facts=facts,surfaces=surfaces,core_overview=overview)\nPath('audit-map.json').write_text(json.dumps(mapdata,indent=2)+'\\\\n')\nsubmission=dict(action='research',rationale='Register the initial source-grounded formation/authority backbone and preserve precise contract and lifecycle questions before selecting a formal Candidate.',sources=sources,map_path='audit-map.json',feedback=dict(ref_ids=[s['id'] for s in sources],answered='Traced proposal admission through replication, queued support, storage release, quorum/current-term commit, propagation and application. Traced elections, term filtering, role reset, configuration activation and recovery, including the different lifetimes of entry completions, snapshots, committed application and read queues. Observations are source-based; no property execution or violation is claimed.',remaining=overview['open_details'],understanding='updated',rationale='Next compare async storage completion across term changes with safe-read support across configuration changes. The storage path has explicit term and entry-identity protections and a directly controllable ordered-worker boundary, making legal same-history checks feasible. ReadIndex/configuration has potentially wider read-safety consequences but first needs producer/consumer decomposition and an applicable request contract. Synchronous ordering reconciliation is a narrower interface discriminator that changes harness legality; retain both statements rather than silently choosing one. Prefer expanding the async completion producer/consumer map and checking a delayed old completion plus a fresh completion under a legal RawNode history.'))\nPath('submission.json').write_text(json.dumps(submission,indent=2)+'\\\\n')\nPY\npython3 build_submission.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nfrom pathlib import Path\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind)); return i\nsrc('S_API','rawnode.go',30,188)\nsrc('S_READY_CONTRACT','node.go',52,115,'interface_statement')\nsrc('S_DOC_USAGE','doc.go',69,179,'document_statement')\nsrc('S_CONFIG','raft.go',140,284,'interface_statement')\nsrc('S_NODE_LOOP','node.go',348,460)\nsrc('S_NODE_CALL','node.go',474,485)\nsrc('S_NODE_WAIT','node.go',507,550)\nsrc('S_INIT','raft.go',437,495)\nsrc('S_SEND','raft.go',502,601)\nsrc('S_REPLICATE','raft.go',616,739)\nsrc('S_APPLIED','raft.go',740,783)\nsrc('S_RESET','raft.go',784,849)\nsrc('S_ROLE','raft.go',850,1023)\nsrc('S_CAMPAIGN','raft.go',1025,1083)\nsrc('S_DISPATCH','raft.go',1085,1261)\nsrc('S_PROPOSE','raft.go',1267,1397)\nsrc('S_ACK','raft.go',1500,1664)\nsrc('S_CANDIDATE_FOLLOWER','raft.go',1668,1774)\nsrc('S_FOLLOWER_LOG','raft.go',1786,1945)\nsrc('S_ACTIVATE','raft.go',1947,2041)\nsrc('S_READ_REPLY','raft.go',2062,2090)\nsrc('S_READ_RELEASE','raft.go',2123,2160)\nsrc('S_READ_QUEUE','read_only.go',19,129)\nsrc('S_STORAGE_MSG','rawnode.go',193,365)\nsrc('S_READY_ACK','rawnode.go',375,494)\nsrc('S_LOG_APPEND','log.go',73,142)\nsrc('S_LOG_APPLY','log.go',218,272)\nsrc('S_LOG_PROGRESS','log.go',320,373)\nsrc('S_LOG_COMMIT','log.go',440,468)\nsrc('S_UNSTABLE','log_unstable.go',93,218)\nsrc('S_STORAGE_API','storage.go',46,92,'interface_statement')\nsrc('S_TRACKER','tracker/tracker.go',160,280)\nsrc('S_MAJORITY','quorum/majority.go',118,196)\nsrc('S_JOINT','quorum/joint.go',17,77)\nsrc('S_PROGRESS','tracker/progress.go',130,253)\nsrc('S_CHANGE','confchange/confchange.go',51,359)\nsrc('S_RESTORE_CONFIG','confchange/restore.go',26,159)\nbeh=[]\ndef b(i,a,owner,ctx,trigger,ss,**kw):\n d=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trigger,source_ids=ss);d.update(kw);beh.append(d)\nb('B_ENTRY','A7','RawNode caller; node.run for Node','One local raft instance; RawNode requires caller serialization','Propose, Step, Campaign, Ready and Advance',['S_API','S_NODE_LOOP','S_NODE_CALL','S_NODE_WAIT','S_DOC_USAGE'],legal_preconditions=['Caller performs Ready storage/application duties; network responses identify their sender.'],implementation_guards=['RawNode rejects network-local messages and responses from unknown peers. Node applies corresponding filters in Step/run.'],external_effects=['Propose returns Step admission/error; Node waits for the Step result. This is not commit or application completion.'],important_branches=['Follower without a leader drops proposals; Node disables proposal reception while it has no leader. Cancellation can end the caller wait.'],cross_activity_effects={'A1':'Routes proposal and replication messages to the serialized raft owner.','A2':'Routes campaigns and term-bearing messages to authority transition logic.'},unknowns=['Network authentication and downstream client completion are outside this library boundary.'])\nb('B_PROPOSE','A1','raft.stepLeader / appendEntry','Leader term and currently installed progress/configuration','MsgProp or leader-entry creation',['S_PROPOSE','S_RESET','S_REPLICATE'],implementation_guards=['Reject if local progress is absent or transfer is active; enforce uncommitted byte quota.','Configuration proposal validation uses pendingConfIndex, applied index and joint status unless disabled.'],writes=['Assign current term and consecutive indexes; append to unstable log.'],external_effects=['Broadcast MsgApp carrying predecessor index/term, entries and commit.','Queue self MsgAppResp through send.'],important_branches=['Invalid configuration proposals can become empty normal entries; proposal acceptance does not activate membership.','Paused peer replication or unavailable log prefix may require snapshot/retry.'],produces_fact_ids=['F_ACK_QUEUED'],cross_activity_effects={'A6':'New entries and self-support await persistence processing.'},existing_protections=['Self-acknowledgement is queued after append; it does not immediately update Match.'])\nb('B_APPEND_FOLLOWER','A1','raft.handleAppendEntries / raftLog.maybeAppend','Follower receiving term-filtered MsgApp; index/entry-term history','Append request',['S_FOLLOWER_LOG','S_LOG_APPEND','S_SEND'],implementation_guards=['Match predecessor term before accepting; reject with hint on mismatch.','A conflicting entry at or below committed causes panic, not replacement.'],writes=['Append conflicting uncommitted suffix and commit at most min(message commit, last new index).'],external_effects=['Queue MsgAppResp for accepted last index, or committed index when predecessor is behind committed. Rejections also pass through the append barrier.'],produces_fact_ids=['F_ACK_QUEUED'],existing_protections=['The committed-prefix shortcut does not accept an arbitrary uncommitted suffix.'],cross_activity_effects={'A6':'Successful processing establishes an in-memory prefix; response durability is separately delegated to Ready handling.'})\nb('B_PERSIST_DISPATCH','A6','raft.send and RawNode Ready/Advance; external storage worker','Ready batch, current raft term, last entry index/term','Queued vote/append response or unstable/HardState update',['S_SEND','S_STORAGE_MSG','S_READY_ACK','S_CONFIG','S_READY_CONTRACT'],consumes_fact_ids=['F_ACK_QUEUED'],implementation_guards=['MsgAppResp, MsgVoteResp and MsgPreVoteResp are separated into msgsAfterAppend.','Async response records current raft term and last unstable entry identity, including in-progress entries.'],writes=['acceptReady clears queues and marks unstable work in progress; this does not attest durable storage.'],external_effects=['Async MsgStorageAppend carries responses for delivery after durable ordered writes.','Synchronous mode returns remote responses in Ready and defers self responses plus storage acknowledgements to Advance.'],durable_effects=['Actual persistence is a caller duty; the library emits work and completion messages, not disk writes.'],important_branches=['Append messages may exist solely to release responses or persist HardState.','Async Advance is forbidden; local apply work uses a separate ordered destination.'],cross_activity_effects={'A1':'Controls when self/peer support can legally be delivered and counted.','A2':'Controls publication of election votes and persisted term transitions.'},unknowns=['Synchronous same-batch message ordering differs between doc.go and the Ready interface comments; do not treat the weaker prose as settled permission.'])\nb('B_ACK_COMMIT','A1','raft.stepLeader, tracker and quorum','Current leader term and installed incoming/outgoing voter sets','MsgAppResp after Step term filtering',['S_ACK','S_PROPOSE','S_PROGRESS','S_TRACKER','S_MAJORITY','S_JOINT','S_APPLIED','S_LOG_COMMIT'],implementation_guards=['Require sender progress; MaybeUpdate monotonically increases Match.','Commit candidate must exceed current committed and its log term must equal current nonzero raft term.'],reads=['Per-peer Match; active voter sets; local log entry term.'],writes=['Update peer Match/Next and flow control; advance raftLog.committed on qualified index.'],produces_fact_ids=['F_MATCH','F_COMMITTED'],consumes_fact_ids=['F_MATCH'],important_branches=['Rejected/stale responses adjust or leave probing state; they do not establish successful Match.','Learner progress can update, but quorum iteration counts configured voters only.','Joint index is the minimum of both majority indexes.'],external_effects=['Broadcast commit advance; release pending reads after current-term commit.'],existing_protections=['Heartbeat replies mark activity and read acknowledgements, not replicated Match.'])\nb('B_CONTEXT','A2','raft.Step, campaign, stepCandidate and role transitions','Local raft term, role, vote and installed voter sets','Election tick/Campaign; votes; higher-term input; quorum loss; leader transfer',['S_DISPATCH','S_ROLE','S_RESET','S_CAMPAIGN','S_CANDIDATE_FOLLOWER','S_TRACKER','S_JOINT','S_LOG_COMMIT','S_PROPOSE','S_ACK'],implementation_guards=['Campaign requires eligible nonlearner progress, no in-progress snapshot, and no unapplied committed configuration change.','Vote eligibility combines stored vote/known leader with lexicographic last-entry freshness.','PreVote and granted future PreVote responses do not immediately advance term; lease check may suppress vote requests.'],writes=['Role reset clears vote tallies, peer progress, transfer state and readOnly acknowledgements; only term change clears Vote.','Self Match resets to local last index, other Match to zero; log and committed prefix remain.','New leader appends a current-term empty entry.'],important_branches=['Lower-term messages normally return before role handling; old storage append responses may still acknowledge their snapshot.','PreCandidate counts only PreVoteResp; Candidate counts only VoteResp.','Quorum loss with CheckQuorum steps down; transfer pauses proposals and sends TimeoutNow only after transferee catch-up.'],produces_fact_ids=['F_MATCH'],consumes_fact_ids=['F_MATCH'],cross_activity_effects={'A1':'Rebuilds volatile support on role changes; current-term commit guard connects new support to retained history.','A6':'Higher-term storage-completion filtering prevents old entry completion from clearing replacement unstable state.'},unknowns=['PendingReadIndexMessages is not cleared by reset, unlike readOnly; it is later reconfirmed through releasePendingReadIndexMessages after current-term commit. Effects across membership transitions merit focused investigation.'])\nb('B_STABLE_COMPLETION','A6','raft.Step and unstable.stableTo','Storage response raft term plus entry index/log term; snapshot index separately','MsgStorageAppendResp',['S_DISPATCH','S_STORAGE_MSG','S_UNSTABLE','S_APPLIED'],implementation_guards=['Current-term entry completion requires unstable entry index and term match.','Lower-term completion does not stabilize entries; included snapshot is still processed.'],writes=['Matching stableTo trims unstable prefix; snapshot completion clears matching snapshot and advances applied via max(index, oldApplied).'],existing_protections=['New-term HardState-only append can carry last unstable identity and provide a fresh ordered completion.'],cross_activity_effects={'A1':'Async application eligibility uses unstable offset after this completion.','A2':'Entry completion is context-qualified while committed snapshot completion can survive term change.'},unknowns=['Controlled same-history execution of delayed responses across replacements remains untested.'])\nb('B_MEMBERSHIP','A4','RawNode.ApplyConfChange / raft.switchToConfig / confchange.Changer','Applied configuration entry and incoming/outgoing voter sets','Caller applies committed ConfChange, or recovery restores ConfState',['S_API','S_ACTIVATE','S_CHANGE','S_RESTORE_CONFIG','S_APPLIED','S_CONFIG'],implementation_guards=['Simple change alters at most one voter; joint transitions preserve outgoing voters until LeaveJoint.','Nonempty voter requirement and voter/learner/progress invariants are checked.'],writes=['Install new Config and Progress; retained peers preserve copied Match; new peers start Match zero.','Outgoing voters retain progress; staged learners become learners after leaving joint.'],consumes_fact_ids=['F_MATCH'],produces_fact_ids=['F_COMMITTED'],external_effects=['Leader recomputes commit under updated quorum; sends append/probes and may abort removed transferee.'],important_branches=['Removed/demoted leader steps down only with StepDownOnRemoval; absent local progress separately rejects proposals.','Applied-progress callback can propose automatic joint exit.'],cross_activity_effects={'A1':'Changes which existing Match values qualify and can advance commitment without a new acknowledgement.','A2':'Changes campaigning eligibility and may remove current authority.'},unknowns=['Cancellation wording differs between RawNode ApplyConfChange and doc.go; a specific check must establish its selected API contract.'])\nb('B_APPLY','A5','RawNode.readyWithoutAccept / acceptReady and raft applied callbacks','Committed, applying and applied indexes; selected storage mode','Ready production and storage application completion',['S_API','S_READY_ACK','S_LOG_APPLY','S_LOG_PROGRESS','S_APPLIED','S_READY_CONTRACT'],consumes_fact_ids=['F_COMMITTED'],implementation_guards=['Do not expose committed entries alongside outstanding snapshot; limit outstanding application bytes.','Async mode limits application to stable prefix; synchronous mode can include unstable committed entries subject to caller Ready duties.'],writes=['Ready acceptance advances applying; Advance or MsgStorageApplyResp advances applied and releases quota.'],external_effects=['CommittedEntries or MsgStorageApply is application work, not an observed external client response.'],important_branches=['MsgStorageApplyResp uses term zero because committed entries survive terms.'],cross_activity_effects={'A4':'Applied-progress callback can initiate automatic joint exit.'})\nb('B_RECOVERY','A3','newRaft and raft.restore','Persisted HardState/ConfState and log; snapshot index/term/configuration','Restart or MsgSnap',['S_INIT','S_ACTIVATE','S_FOLLOWER_LOG','S_LOG_APPEND','S_LOG_COMMIT','S_RESTORE_CONFIG','S_STORAGE_API','S_UNSTABLE'],writes=['Restart loads term/vote/commit, reconstructs membership and starts follower.','Nonobsolete snapshot either fast-forwards matching log commit or replaces unstable history and reconstructs membership.'],produces_fact_ids=['F_COMMITTED'],implementation_guards=['loadState bounds commit by available log.','Snapshot restoration requires follower state and recipient inclusion; obsolete snapshots are ignored.'],cross_activity_effects={'A1':'Preserves/reconstructs committed prefix while volatile peer support is rebuilt.','A2':'Restart starts