default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\nClaim null\nBindingDraft {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"associations\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingAssociation\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Associations\",\n      \"type\": \"array\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"associations\",\n    \"id\",\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\",\n    \"description\",\n    \"pending\"\n  ],\n  \"title\": \"BindingDraft\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
