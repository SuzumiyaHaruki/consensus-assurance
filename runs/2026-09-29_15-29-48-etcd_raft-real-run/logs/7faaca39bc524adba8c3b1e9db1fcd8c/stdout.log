IBILITY\", \"direct_check_id\": \"b1dd572dd2d0465fbbc06af7dd312ac7\", \"experiment_check_id\": \"7f87025ec21040378846ee18bc957845\", \"confirmed\": false, \"outcome\": \"violated\", \"blockers\": [\"Direct oracle correspondence is unreviewed\"], \"bounded_complete\": true, \"reviewed_complete\": false, \"correspondence\": null, \"review_ids\": [], \"open_issue_ids\": [], \"record\": {\"path\": \"state.json\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"7f87025ec21040378846ee18bc957845\", \"claim_id\": \"C_SINGLETON_READ_ELIGIBILITY\"}}}]\nreview_contracts [{\"target_id\": \"30b99642cd6d4bb89f9e66b2d66afa77\", \"object_type\": \"direct_check\", \"version\": 1, \"required_aspects\": [\"checker_correspondence\"], \"optional_aspects\": [\"applicability\", \"decomposition\"]}, {\"target_id\": \"b1dd572dd2d0465fbbc06af7dd312ac7\", \"object_type\": \"direct_check\", \"version\": 1, \"required_aspects\": [\"checker_correspondence\"], \"optional_aspects\": [\"applicability\", \"decomposition\"]}]\nreview_issues []\nARTIFACT {\"id\": \"b1dd572dd2d0465fbbc06af7dd312ac7\", \"version\": 1, \"plan_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-09-29_15-29-48-etcd_raft-real-run/direct-checks/844c605b59de4a6c8df8ac80c847e05e/plan.json\", \"harness_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-09-29_15-29-48-etcd_raft-real-run/direct-checks/844c605b59de4a6c8df8ac80c847e05e/assurance_generated_test.go\", \"unit_id\": \"unit-C_SINGLETON_READ_ELIGIBILITY\", \"claim_id\": \"C_SINGLETON_READ_ELIGIBILITY\", \"graph_versions\": {\"C_SINGLETON_READ_ELIGIBILITY\": 1, \"BIND_SINGLETON_READ\": 1, \"BIND_SINGLETON_TEST\": 1, \"unit-C_SINGLETON_READ_ELIGIBILITY\": 1}, \"previous_id\": null, \"record\": {\"path\": \"state.json\", \"collection\": \"direct_checks\", \"match\": {\"id\": \"b1dd572dd2d0465fbbc06af7dd312ac7\"}}, \"basis\": [{\"path\": \"state.json\", \"collection\": \"claims\", \"match\": {\"id\": \"C_SINGLETON_READ_ELIGIBILITY\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BIND_SINGLETON_READ\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BIND_SINGLETON_TEST\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-C_SINGLETON_READ_ELIGIBILITY\", \"version\": 1}}]}\npackage raft\n\nimport (\n \"encoding/json\"\n \"fmt\"\n \"testing\"\n pb \"go.etcd.io/raft/v3/raftpb\"\n)\n\nfunc TestAssuranceSingletonReadEligibility(t *testing.T) {\n for _,stepDown:=range []bool{false,true} { t.Run(fmt.Sprint(stepDown),func(t *testing.T){\n  nodes:=map[uint64]*RawNode{}\n  stores:=map[uint64]*MemoryStorage{}\n  values:=map[uint64]string{}\n  applied:=map[uint64]uint64{1:1,2:1}\n  type observedRead struct { node uint64; state ReadState }; var reads []observedRead\n  emit:=func(event string,id uint64,extra map[string]interface{}) {\n   r:=nodes[id].raft\n   row:=map[string]interface{}{\"event\":event,\"node\":id,\"step_down\":stepDown,\"term\":r.Term,\"role\":r.state.String(),\"leader\":r.lead,\"commit\":r.raftLog.committed,\"app_index\":applied[id],\"value\":values[id],\"voters\":r.trk.VoterNodes()}\n   for k,v:=range extra {row[k]=v}; b,err:=json.Marshal(row);if err!=nil{t.Fatal(err)};fmt.Println(\"CA_EVENT \"+string(b))\n  }\n  for id:=uint64(1);id<=2;id++ {\n   st:=NewMemoryStorage()\n   if err:=st.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{Index:1,Term:1,ConfState:pb.ConfState{Voters:[]uint64{1,2}}}});err!=nil{t.Fatal(err)}\n   if err:=st.SetHardState(pb.HardState{Term:1,Commit:1});err!=nil{t.Fatal(err)}\n   rn,err:=NewRawNode(&Config{ID:id,ElectionTick:10,HeartbeatTick:1,Storage:st,Applied:1,AsyncStorageWrites:true,StepDownOnRemoval:stepDown,ReadOnlyOption:ReadOnlySafe,MaxSizePerMsg:4096,MaxInflightMsgs:16});if err!=nil{t.Fatal(err)}\n   nodes[id],stores[id]=rn,st\n  }\n  var queue []pb.Message\n  pump:=func(){\n   for n:=0;;n++ {\n    if n>10000{t.Fatal(\"finite exploration schedule exceeded\")}\n    work:=false\n    for id:=uint64(1);id<=2;id++ {\n     rn:=nodes[id];if !rn.HasReady(){continue};work=true;rd:=rn.Ready()\n     for _,rs:=range rd.ReadStates { reads=append(reads,observedRead{node:id,state:rs});emit(\"read_state\",id,map[string]interface{}{\"read_index\":rs.Index,\"context\":string(rs.RequestCtx)}) }\n     for _,m:=range rd.Messages {\n      switch m.Type {\n      case pb.MsgStorageAppend:\n       st:=stores[id]\n       if m.Snapshot!=nil{if err:=st.ApplySnapshot(*m.Snapshot);err!=nil{t.Fatal(err)}}\n       if err:=st.Append(m.Entries);err!=nil{t.Fatal(err)}\n       hs:=pb.HardState{Term:m.Term,Vote:m.Vote,Commit:m.Commit}\n       if !IsEmptyHardState(hs){if err:=st.SetHardState(hs);err!=nil{t.Fatal(err)}}\n       queue=append(queue,m.Responses...)\n      case pb.MsgStorageApply:\n       for _,e:=range m.Entries {\n        if e.Index!=applied[id]+1 {t.Fatalf(\"nonconsecutive application: %d after %d\",e.Index,applied[id])}\n        switch e.Type {\n        case pb.EntryConfChange:\n         var cc pb.ConfChange;if err:=cc.Unmarshal(e.Data);err!=nil{t.Fatal(err)};rn.ApplyConfChange(cc)\n        case pb.EntryConfChangeV2:\n         var cc pb.ConfChangeV2;if err:=cc.Unmarshal(e.Data);err!=nil{t.Fatal(err)};rn.ApplyConfChange(cc)\n        case pb.EntryNormal:\n         if len(e.Data)>0{values[id]=string(e.Data)}\n        }\n        applied[id]=e.Index\n        emit(\"applied\",id,map[string]interface{}{\"entry_index\":e.Index,\"entry_type\":e.Type.String()})\n       }\n       queue=append(queue,m.Responses...)\n      default:queue=append(queue,m)\n      }\n     }\n    }\n    if len(queue)>0 {m:=queue[0];queue=queue[1:];if err:=nodes[m.To].Step(m);err!=nil{t.Fatal(err)};continue}\n    if !work{return}\n   }\n  }\n  if err:=nodes[1].Campaign();err!=nil{t.Fatal(err)};pump()\n  if nodes[1].raft.state!=StateLeader{t.Fatal(\"node 1 not elected\")}\n  if err:=nodes[1].Propose([]byte(\"old\"));err!=nil{t.Fatal(err)};pump()\n  if err:=nodes[1].ProposeConfChange(pb.ConfChange{Type:pb.ConfChangeRemoveNode,NodeID:1});err!=nil{t.Fatal(err)};pump()\n  emit(\"after_removal\",1,nil);emit(\"after_removal\",2,nil)\n  if nodes[2].raft.trk.Progress[1]!=nil {t.Fatal(\"removal not applied on successor\")}\n  if err:=nodes[2].Campaign();err!=nil{t.Fatal(err)};pump()\n  if nodes[2].raft.state!=StateLeader{t.Fatal(\"node 2 not elected\")}\n  if err:=nodes[2].Propose([]byte(\"new\"));err!=nil{t.Fatal(err)};pump()\n  emit(\"write_complete\",2,nil)\n  checkRead:=func(id uint64,ctx string){\n   reads=nil\n   r:=nodes[id].raft\n   _,member:=r.trk.Voters[0][id]\n   eligible:=member && len(r.trk.Voters[0])==1 && len(r.trk.Voters[1])==0\n   emit(\"read_admitted\",id,map[string]interface{}{\"request_id\":ctx,\"context\":ctx,\"self_sole_voter\":eligible,\"new_write_index\":applied[2]})\n   nodes[id].ReadIndex([]byte(ctx));pump()\n   count:=0\n   var index uint64\n   for _,observed:=range reads {\n    if observed.node==id && string(observed.state.RequestCtx)==ctx {count++;index=observed.state.Index}\n   }\n   emit(\"read_completed\",id,map[string]interface{}{\"request_id\":ctx,\"context\":ctx,\"returned\":count>0,\"result_count\":count,\"read_index\":index,\"self_sole_voter\":eligible,\"new_write_index\":applied[2]})\n  }\n  checkRead(1,\"removed-after-write\")\n  checkRead(2,\"current-singleton-control\")\n\n }) }\n}\n\nPLAN {\"description\": \"Check singleton self-certification eligibility after actual two-node self-removal, successor election and write. Observe both removed and current singleton RawNode requests in each removal step-down mode. Evaluate only the necessary emitted-result implication.\", \"claim_id\": \"C_SINGLETON_READ_ELIGIBILITY\", \"binding_ids\": [\"BIND_SINGLETON_READ\", \"BIND_SINGLETON_TEST\"], \"harness\": {\"files\": {}, \"kind\": \"go_test\", \"source\": \"separately read\", \"description\": \"Two RawNodes with ordered async MemoryStorage/application workers; actual configuration proposal/application; option control and live singleton read control.\", \"semantic_changes\": [\"No target logic edits; internal voter maps and role are read-only observations.\", \"MemoryStorage substitutes for noncrashing disk persistence.\", \"A string register is the explicit application model; it applies normal payloads and committed configuration entries in index order.\", \"Removed RawNode remains callable intentionally, excluding external retirement policy.\"], \"prerequisites\": [{\"alias\": \"request\", \"event\": \"read_admitted\", \"conditions\": []}], \"legality\": {\"source_ids\": [\"S_API\", \"S_READ_API\", \"S_NODE_READ_CONTRACT\", \"S_NODE_CONFIG_APPLY\", \"S_CONFIG\", \"S_REMOVAL_OPTION\", \"S_MEMBERSHIP_DOC\", \"S_INIT\", \"S_MEMORY_SNAPSHOT\", \"S_MEMORY_HARDSTATE\", \"S_MEMORY_APPEND\", \"S_CONFCHANGE_ENCODING\", \"S_ACTIVATE\", \"S_CHANGE\", \"S_CAMPAIGN\", \"S_ROLE\", \"S_STORAGE_MSG\", \"S_READY_ACK\", \"S_SINGLETON_READ\", \"S_TRACKER\", \"S_READ_REPLY\"], \"expectation_ids\": [\"S_READ_SAFE_EXPECTATION\", \"S_SINGLETON_EXPECTATION\", \"S_REMOVAL_OPTION\"], \"binding_ids\": [\"BIND_SINGLETON_READ\", \"BIND_SINGLETON_TEST\"], \"derivation\": \"For unit-C_SINGLETON_READ_ELIGIBILITY, use the legal history established as constructible by exploration 6127b12776d14d5f8a2557f7ecda3ef7, with fresh execution required for this instrumented driver. Two RawNodes start from consistent supplied snapshot and HardState index/term 1 with voters 1/2. Campaign node 1, replicate/apply an old normal value, propose and commit a legacy single removal of node 1, and apply that actual committed configuration on both nodes. Campaign node 2 under its singleton configuration and propose/apply a new value before either read invocation. Call RawNode.ReadIndex with unique contexts on node 1 and then node 2. No implementation state is assigned after initialization. The worker processes actual Ready messages in node-local order, writes MemoryStorage before releasing append responses, applies normal entries to a modeled string register, and calls ApplyConfChange only on actual committed config entries before releasing apply responses. This provides same-instance, same-history identity across removal, election, write and read. No crash, runtime snapshot, network loss, response fabrication or forced role transition occurs. All protocol and worker actions are serialized. ReadOnlySafe and disabled CheckQuorum are explicit supported options; no ticks occur within this finite event schedule. The caller intentionally keeps the removed RawNode alive, as recorded in claim scope; applications that retire it are excluded. S_MEMBERSHIP_DOC recommends larger groups for availability but does not prohibit this nonfailing two-member history. The second subtest changes only StepDownOnRemoval to true and is a permitted suppression control, not an assertion that reads must finish. An additional live-singleton read on node 2 is a permitted successful control in each mode.\", \"applicability\": \"Selected endpoint is emission of a matching local ReadState through the singleton shortcut, not an application read. Removed-node state and membership are observed before calling ReadIndex. The test performs no lease read and has no earlier read request or context acknowledgement to reuse. MemoryStorage models noncrashing persistence; the consistent initial prefix is supplied rather than generated from birth.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": [\"Automatic caller retirement and StepDownOnRemoval=true prevent the selected removed-leader invocation or branch; both are retained as scope/control distinctions.\"]}}, \"monitors\": [{\"id\": \"M_SINGLETON_ELIGIBILITY\", \"checker_id\": \"singleton_read_eligible\", \"event\": \"read_completed\", \"binding_ids\": [\"BIND_SINGLETON_READ\", \"BIND_SINGLETON_TEST\"], \"grounding\": {\"source_ids\": [\"S_SINGLETON_READ\", \"S_TRACKER\", \"S_READ_REPLY\", \"S_READ_API\", \"S_ACTIVATE\", \"S_REMOVAL_OPTION\"], \"expectation_ids\": [\"S_READ_SAFE_EXPECTATION\", \"S_SINGLETON_EXPECTATION\"], \"binding_ids\": [\"BIND_SINGLETON_READ\", \"BIND_SINGLETON_TEST\"], \"derivation\": \"Compare the necessary relation in C_SINGLETON_READ_ELIGIBILITY as returned implies admitted.self_sole_voter. The admitted event records actual current voter maps and local node identity before the call. self_sole_voter is computed independently by membership in Voters[0], its cardinality one, and empty Voters[1]; it does not use returned status or call IsSingleton. The identity fields step_down, node and request_id distinguish independent executions and read operations. Each unique-context invocation is followed by an unconditional finite pump and read_completed event. Returned is derived from the actual Ready.ReadStates collected during that operation, filtered by emitting node and exact request context, with raw result count and index recorded. No response is synthesized. Normal queue drain is the observation completion bound: missing read output is a permitted false antecedent, not a liveness failure or an expected result. A pump timeout fails execution rather than producing a comparison. The read_state events expose actual individual output, while the completed summary supports the implication for both emitting and nonemitting operations. There is no configuration mutation during either individual read interval. The current singleton control emits a valid read without strengthening the necessary condition into equality.\", \"applicability\": \"The removed-node subtest with StepDownOnRemoval=false is the claim case; step-down true and current-node calls are explicitly diagnostic controls for the same necessary eligibility relation. No all-reads-complete requirement is imposed. The driver observes no heartbeat support for these fresh contexts: the source direct singleton path returns before generating such messages, while the follower-without-leader control drops its input.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": [\"Node 1 retaining StateLeader does not independently prove its membership; the oracle reads voter identity rather than trusting the role label.\", \"An emitted ReadState is not a served stale application read; application wait semantics remain excluded.\"]}, \"applicability_conditions\": [], \"admission_alias\": \"request\"}], \"observable_properties\": [{\"checker_id\": \"singleton_read_eligible\", \"kind\": \"event_implication\", \"trigger\": {\"field\": \"event\", \"op\": \"eq\", \"value\": \"read_completed\", \"reference\": null}, \"assertion\": {\"field\": \"self_sole_voter\", \"op\": \"eq\", \"value\": true, \"reference\": null}, \"antecedent\": {\"field\": \"returned\", \"op\": \"eq\", \"value\": true, \"reference\": null}, \"identity_fields\": [\"step_down\", \"node\", \"request_id\"], \"history_field\": null, \"description\": \"A directly self-certified singleton read result requires the responder to be the sole voter.\"}], \"uncertainties\": [\"The initial snapshot prefix is supplied consistently, not executed from process birth.\", \"No physical disk crash, application-served stale read or external client linearizability endpoint is observed.\", \"Deployments that retire removed instances avoid the selected invocation.\"]}\nEXEC 7f87025ec21040378846ee18bc957845 completed tests_passed\nCA_EVENT {\"app_index\":2,\"commit\":2,\"entry_index\":2,\"entry_type\":\"EntryNormal\",\"event\":\"applied\",\"leader\":1,\"node\":1,\"role\":\"StateLeader\",\"step_down\":false,\"term\":2,\"value\":\"\",\"voters\":[1,2]}\nCA_EVENT {\"app_index\":2,\"commit\":2,\"entry_index\":2,\"entry_type\":\"EntryNormal\",\"event\":\"applied\",\"leader\":1,\"node\":2,\"role\":\"StateFollower\",\"step_down\":false,\"term\":2,\"value\":\"\",\"voters\":[1,2]}\nCA_EVENT {\"app_index\":3,\"commit\":3,\"entry_index\":3,\"entry_type\":\"EntryNormal\",\"event\":\"applied\",\"leader\":1,\"node\":1,\"role\":\"StateLeader\",\"step_dow