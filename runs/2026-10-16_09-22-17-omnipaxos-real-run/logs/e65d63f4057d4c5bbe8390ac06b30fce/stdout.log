, 'is_reconfigured': False, 'read_idx5': 'stop_sign', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'none', 'suffix_entries': -1}\n44 {'event': 'REPEAT_ROUND2', 'case': 'resync', 'node': 1, 'accepted_idx': 8, 'decided_idx': 8, 'decided_eq_accepted': True, 'is_reconfigured': True, 'read_idx5': 'none', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'ok', 'suffix_entries': 1}\n45 {'event': 'REPEAT_ROUND2', 'case': 'resync', 'node': 2, 'accepted_idx': 8, 'decided_idx': 8, 'decided_eq_accepted': True, 'is_reconfigured': True, 'read_idx5': 'none', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'ok', 'suffix_entries': 1}\n46 {'event': 'REPEAT_ROUND2', 'case': 'resync', 'node': 3, 'accepted_idx': 6, 'decided_idx': 8, 'decided_eq_accepted': False, 'is_reconfigured': False, 'read_idx5': 'stop_sign', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'none', 'suffix_entries': -1}\n47 {'event': 'REPEAT_ROUND3', 'case': 'resync', 'node': 1, 'accepted_idx': 9, 'decided_idx': 9, 'decided_eq_accepted': True, 'is_reconfigured': True, 'read_idx5': 'none', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'ok', 'suffix_entries': 1}\n48 {'event': 'REPEAT_ROUND3', 'case': 'resync', 'node': 2, 'accepted_idx': 9, 'decided_idx': 9, 'decided_eq_accepted': True, 'is_reconfigured': True, 'read_idx5': 'none', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'ok', 'suffix_entries': 1}\n49 {'event': 'REPEAT_ROUND3', 'case': 'resync', 'node': 3, 'accepted_idx': 6, 'decided_idx': 9, 'decided_eq_accepted': False, 'is_reconfigured': False, 'read_idx5': 'stop_sign', 'read_idx6': 'none', 'stopsign_entry_decided': False, 'suffix_read_state': 'none', 'suffix_entries': -1}\n","exit_code":0,"status":"completed"}}
