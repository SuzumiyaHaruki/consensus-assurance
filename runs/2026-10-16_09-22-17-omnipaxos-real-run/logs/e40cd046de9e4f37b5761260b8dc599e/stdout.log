0,\"decided_eq_accepted\":true,\"is_reconfigured\":false,\"read_idx5\":\"none\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":false,\"suffix_read_state\":\"none\",\"suffix_entries\":-1}\nCA_EVENT {\"event\":\"SINGLE_ENTRIES_DECIDED\",\"case\":\"single\",\"node\":1,\"accepted_idx\":5,\"decided_idx\":5,\"decided_eq_accepted\":true,\"is_reconfigured\":false,\"read_idx5\":\"none\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":false,\"suffix_read_state\":\"ok\",\"suffix_entries\":5}\nCA_EVENT {\"event\":\"SINGLE_ENTRIES_DECIDED\",\"case\":\"single\",\"node\":2,\"accepted_idx\":5,\"decided_idx\":5,\"decided_eq_accepted\":true,\"is_reconfigured\":false,\"read_idx5\":\"none\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":false,\"suffix_read_state\":\"ok\",\"suffix_entries\":5}\nCA_EVENT {\"event\":\"SINGLE_ENTRIES_DECIDED\",\"case\":\"single\",\"node\":3,\"accepted_idx\":5,\"decided_idx\":5,\"decided_eq_accepted\":true,\"is_reconfigured\":false,\"read_idx5\":\"none\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":false,\"suffix_read_state\":\"ok\",\"suffix_entries\":5}\nCA_EVENT {\"event\":\"SINGLE_STOPSIGN_DECIDED\",\"case\":\"single\",\"node\":1,\"accepted_idx\":6,\"decided_idx\":6,\"decided_eq_accepted\":true,\"is_reconfigured\":true,\"read_idx5\":\"stop_sign\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":true,\"suffix_read_state\":\"ok\",\"suffix_entries\":6}\nCA_EVENT {\"event\":\"SINGLE_STOPSIGN_DECIDED\",\"case\":\"single\",\"node\":2,\"accepted_idx\":6,\"decided_idx\":6,\"decided_eq_accepted\":true,\"is_reconfigured\":true,\"read_idx5\":\"stop_sign\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":true,\"suffix_read_state\":\"ok\",\"suffix_entries\":6}\nCA_EVENT {\"event\":\"SINGLE_STOPSIGN_DECIDED\",\"case\":\"single\",\"node\":3,\"accepted_idx\":6,\"decided_idx\":6,\"decided_eq_accepted\":true,\"is_reconfigured\":true,\"read_idx5\":\"stop_sign\",\"read_idx6\":\"none\",\"stopsign_entry_decided\":true,\"suffix_read_state\":\"ok\",\"suffix_entri