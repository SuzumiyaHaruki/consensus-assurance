{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source/omnipaxos/src && cat -n sequence_paxos/follower.rs'","aggregated_output":"     1\tuse super::super::ballot_leader_election::Ballot;\n     2\t\n     3\tuse super::*;\n     4\t\n     5\tuse crate::util::{MessageStatus, WRITE_ERROR_MSG};\n     6\t\n     7\timpl<T, B> SequencePaxos<T, B>\n     8\twhere\n     9\t    T: Entry,\n    10\t    B: Storage<T>,\n    11\t{\n    12\t    /*** Follower ***/\n    13\t    pub(crate) fn handle_prepare(&mut self, prep: Prepare, from: NodeId) {\n    14\t        let old_promise = self.internal_storage.get_promise();\n    15\t        if old_promise < prep.n || (old_promise == prep.n && self.state.1 == Phase::Recover) {\n    16\t            // Flush any pending writes\n    17\t            // Don't have to handle flushed entries here because we will sync with followers\n    18\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    19\t            self.internal_storage\n    20\t                .set_promise(prep.n)\n    21\t                .expect(WRITE_ERROR_MSG);\n    22\t            self.state = (Role::Follower, Phase::Prepare);\n    23\t            self.current_seq_num = SequenceNumber::default();\n    24\t            let na = self.internal_storage.get_accepted_round();\n    25\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    26\t            let log_sync = if na > prep.n_accepted {\n    27\t                // I'm more up to date: send leader what he is missing after his decided index.\n    28\t                Some(self.create_log_sync(prep.decided_idx, prep.decided_idx))\n    29\t            } else if na == prep.n_accepted && accepted_idx > prep.accepted_idx {\n    30\t                // I'm more up to date and in same round: send leader what he is missing after his\n    31\t                // accepted index.\n    32\t                Some(self.create_log_sync(prep.accepted_idx, prep.decided_idx))\n    33\t            } else {\n    34\t                // I'm equally or less up to date\n    35\t                None\n    36\t            };\n    37\t            let promise = Promise {\n    38\t                n: prep.n,\n    39\t                n_accepted: na,\n    40\t                decided_idx: self.internal_storage.get_decided_idx(),\n    41\t                accepted_idx,\n    42\t                log_sync,\n    43\t            };\n    44\t            self.cached_promise_message = Some(promise.clone());\n    45\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    46\t                from: self.pid,\n    47\t                to: from,\n    48\t                msg: PaxosMsg::Promise(promise),\n    49\t            }));\n    50\t        }\n    51\t    }\n    52\t\n    53\t    pub(crate) fn handle_acceptsync(&mut self, accsync: AcceptSync<T>, from: NodeId) {\n    54\t        if self.check_valid_ballot(accsync.n) && self.state == (Role::Follower, Phase::Prepare) {\n    55\t            self.cached_promise_message = None;\n    56\t            let new_accepted_idx = self\n    57\t                .internal_storage\n    58\t                .sync_log(accsync.n, accsync.decided_idx, Some(accsync.log_sync))\n    59\t                .expect(WRITE_ERROR_MSG);\n    60\t            if self.internal_storage.get_stopsign().is_none() {\n    61\t                self.forward_buffered_proposals();\n    62\t            }\n    63\t            let accepted = Accepted {\n    64\t                n: accsync.n,\n    65\t                accepted_idx: new_accepted_idx,\n    66\t            };\n    67\t            self.state = (Role::Follower, Phase::Accept);\n    68\t            self.current_seq_num = accsync.seq_num;\n    69\t            let cached_idx = self.outgoing.len();\n    70\t            self.latest_accepted_meta = Some((accsync.n, cached_idx));\n    71\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    72\t                from: self.pid,\n    73\t                to: from,\n    74\t                msg: PaxosMsg::Accepted(accepted),\n    75\t            }));\n    76\t            #[cfg(feature = \"unicache\")]\n    77\t            self.internal_storage.set_unicache(accsync.unicache);\n    78\t        }\n    79\t    }\n    80\t\n    81\t    fn forward_buffered_proposals(&mut self) {\n    82\t        let proposals = std::mem::take(&mut self.buffered_proposals);\n    83\t        if !proposals.is_empty() {\n    84\t            self.forward_proposals(proposals);\n    85\t        }\n    86\t    }\n    87\t\n    88\t    pub(crate) fn handle_acceptdecide(&mut self, acc_dec: AcceptDecide<T>) {\n    89\t        if self.check_valid_ballot(acc_dec.n)\n    90\t            && self.state == (Role::Follower, Phase::Accept)\n    91\t            && self.handle_sequence_num(acc_dec.seq_num, acc_dec.n.pid) == MessageStatus::Expected\n    92\t        {\n    93\t            #[cfg(not(feature = \"unicache\"))]\n    94\t            let entries = acc_dec.entries;\n    95\t            #[cfg(feature = \"unicache\")]\n    96\t            let entries = self.internal_storage.decode_entries(acc_dec.entries);\n    97\t            let mut new_accepted_idx = self\n    98\t                .internal_storage\n    99\t                .append_entries_and_get_accepted_idx(entries)\n   100\t                .expect(WRITE_ERROR_MSG);\n   101\t            let flushed_after_decide =\n   102\t                self.update_decided_idx_and_get_accepted_idx(acc_dec.decided_idx);\n   103\t            if flushed_after_decide.is_some() {\n   104\t                new_accepted_idx = flushed_after_decide;\n   105\t            }\n   106\t            if let Some(idx) = new_accepted_idx {\n   107\t                self.reply_accepted(acc_dec.n, idx);\n   108\t            }\n   109\t        }\n   110\t    }\n   111\t\n   112\t    pub(crate) fn handle_accept_stopsign(&mut self, acc_ss: AcceptStopSign) {\n   113\t        if self.check_valid_ballot(acc_ss.n)\n   114\t            && self.state == (Role::Follower, Phase::Accept)\n   115\t            && self.handle_sequence_num(acc_ss.seq_num, acc_ss.n.pid) == MessageStatus::Expected\n   116\t        {\n   117\t            // Flush entries before appending stopsign. The accepted index is ignored here as\n   118\t            // it will be updated when appending stopsign.\n   119\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   120\t            let new_accepted_idx = self\n   121\t                .internal_storage\n   122\t                .set_stopsign(Some(acc_ss.ss))\n   123\t                .expect(WRITE_ERROR_MSG);\n   124\t            self.reply_accepted(acc_ss.n, new_accepted_idx);\n   125\t        }\n   126\t    }\n   127\t\n   128\t    pub(crate) fn handle_decide(&mut self, dec: Decide) {\n   129\t        if self.check_valid_ballot(dec.n)\n   130\t            && self.state.1 == Phase::Accept\n   131\t            && self.handle_sequence_num(dec.seq_num, dec.n.pid) == MessageStatus::Expected\n   132\t        {\n   133\t            let new_accepted_idx = self.update_decided_idx_and_get_accepted_idx(dec.decided_idx);\n   134\t            if let Some(idx) = new_accepted_idx {\n   135\t                self.reply_accepted(dec.n, idx);\n   136\t            }\n   137\t        }\n   138\t    }\n   139\t\n   140\t    /// To maintain decided index <= accepted index, batched entries may be flushed.\n   141\t    /// Returns `Some(new_accepted_idx)` if entries are flushed, otherwise `None`.\n   142\t    fn update_decided_idx_and_get_accepted_idx(&mut self, new_decided_idx: usize) -> Option<usize> {\n   143\t        if new_decided_idx <= self.internal_storage.get_decided_idx() {\n   144\t            return None;\n   145\t        }\n   146\t        if new_decided_idx > self.internal_storage.get_accepted_idx() {\n   147\t            let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   148\t            self.internal_storage\n   149\t                .set_decided_idx(new_decided_idx.min(new_accepted_idx))\n   150\t                .expect(WRITE_ERROR_MSG);\n   151\t            Some(new_accepted_idx)\n   152\t        } else {\n   153\t            self.internal_storage\n   154\t                .set_decided_idx(new_decided_idx)\n   155\t                .expect(WRITE_ERROR_MSG);\n   156\t            None\n   157\t        }\n   158\t    }\n   159\t\n   160\t    fn reply_accepted(&mut self, n: Ballot, accepted_idx: usize) {\n   161\t        let latest_accepted = self.get_latest_accepted_message(n);\n   162\t        match latest_accepted {\n   163\t            Some(acc) => acc.accepted_idx = accepted_idx,\n   164\t            None => {\n   165\t                let accepted = Accepted { n, accepted_idx };\n   166\t                let cached_idx = self.outgoing.len();\n   167\t                self.latest_accepted_meta = Some((n, cached_idx));\n   168\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   169\t                    from: self.pid,\n   170\t                    to: n.pid,\n   171\t                    msg: PaxosMsg::Accepted(accepted),\n   172\t                }));\n   173\t            }\n   174\t        }\n   175\t    }\n   176\t\n   177\t    fn get_latest_accepted_message(&mut self, n: Ballot) -> Option<&mut Accepted> {\n   178\t        if let Some((ballot, outgoing_idx)) = &self.latest_accepted_meta {\n   179\t            if *ballot == n {\n   180\t                if let Message::SequencePaxos(PaxosMessage {\n   181\t                    msg: PaxosMsg::Accepted(a),\n   182\t                    ..\n   183\t                }) = self.outgoing.get_mut(*outgoing_idx).unwrap()\n   184\t                {\n   185\t                    return Some(a);\n   186\t                } else {\n   187\t                    #[cfg(feature = \"logging\")]\n   188\t                    debug!(self.logger, \"Cached idx is not an Accepted message!\");\n   189\t                }\n   190\t            }\n   191\t        }\n   192\t        None\n   193\t    }\n   194\t\n   195\t    /// Also returns whether the message's ballot was promised\n   196\t    fn check_valid_ballot(&mut self, message_ballot: Ballot) -> bool {\n   197\t        let my_promise = self.internal_storage.get_promise();\n   198\t        match my_promise.cmp(&message_ballot) {\n   199\t            std::cmp::Ordering::Equal => true,\n   200\t            std::cmp::Ordering::Greater => {\n   201\t                let not_acc = NotAccepted { n: my_promise };\n   202\t                #[cfg(feature = \"logging\")]\n   203\t                trace!(\n   204\t                    self.logger,\n   205\t                    \"NotAccepted. My promise: {:?}, theirs: {:?}\",\n   206\t                    my_promise,\n   207\t                    message_ballot\n   208\t                );\n   209\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   210\t                    from: self.pid,\n   211\t                    to: message_ballot.pid,\n   212\t                    msg: PaxosMsg::NotAccepted(not_acc),\n   213\t                }));\n   214\t                false\n   215\t            }\n   216\t            std::cmp::Ordering::Less => {\n   217\t                // Should never happen, but to be safe send PrepareReq\n   218\t                #[cfg(feature = \"logging\")]\n   219\t                warn!(\n   220\t                    self.logger,\n   221\t                    \"Received non-prepare message from a leader I've never promised. My: {:?}, theirs: {:?}\", my_promise, message_ballot\n   222\t                );\n   223\t                self.reconnected(message_ballot.pid);\n   224\t                false\n   225\t            }\n   226\t        }\n   227\t    }\n   228\t\n   229\t    /// Also returns the MessageStatus of the sequence based on the incoming sequence number.\n   230\t    fn handle_sequence_num(&mut self, seq_num: SequenceNumber, from: NodeId) -> MessageStatus {\n   231\t        let msg_status = self.current_seq_num.check_msg_status(seq_num);\n   232\t        match msg_status {\n   233\t            MessageStatus::Expected => self.current_seq_num = seq_num,\n   234\t            MessageStatus::DroppedPreceding => self.reconnected(from),\n   235\t            MessageStatus::Outdated => (),\n   236\t        };\n   237\t        msg_status\n   238\t    }\n   239\t\n   240\t    pub(crate) fn resend_messages_follower(&mut self) {\n   241\t        match self.state.1 {\n   242\t            Phase::Prepare => {\n   243\t                // Resend Promise\n   244\t                match &self.cached_promise_message {\n   245\t                    Some(promise) => {\n   246\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   247\t                            from: self.pid,\n   248\t                            to: promise.n.pid,\n   249\t                            msg: PaxosMsg::Promise(promise.clone()),\n   250\t                        }));\n   251\t                    }\n   252\t                    None => {\n   253\t                        // Shouldn't be possible to be in prepare phase without having\n   254\t                        // cached the promise sent as a response to the prepare\n   255\t                        #[cfg(feature = \"logging\")]\n   256\t                        warn!(self.logger, \"In Prepare phase without a cached promise!\");\n   257\t                        self.state = (Role::Follower, Phase::Recover);\n   258\t                        self.send_preparereq_to_all_peers();\n   259\t                    }\n   260\t                }\n   261\t            }\n   262\t            Phase::Recover => {\n   263\t                // Resend PrepareReq\n   264\t                self.send_preparereq_to_all_peers();\n   265\t            }\n   266\t            Phase::Accept => (),\n   267\t            Phase::None => (),\n   268\t        }\n   269\t    }\n   270\t\n   271\t    fn send_preparereq_to_all_peers(&mut self) {\n   272\t        let prepreq = PrepareReq {\n   273\t            n: self.get_promise(),\n   274\t        };\n   275\t        for peer in &self.peers {\n   276\t            self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   277\t                from: self.pid,\n   278\t                to: *peer,\n   279\t                msg: PaxosMsg::PrepareReq(prepreq),\n   280\t            }));\n   281\t        }\n   282\t    }\n   283\t\n   284\t    pub(crate) fn flush_batch_follower(&mut self) {\n   285\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   286\t        let new_accepted_idx = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n   287\t        if new_accepted_idx > accepted_idx {\n   288\t            self.reply_accepted(self.get_promise(), new_accepted_idx);\n   289\t        }\n   290\t    }\n   291\t}\n","exit_code":0,"status":"completed"}}
