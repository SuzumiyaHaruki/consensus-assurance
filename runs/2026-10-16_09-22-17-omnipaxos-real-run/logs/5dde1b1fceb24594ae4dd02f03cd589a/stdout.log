{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source && cat omnipaxos/Cargo.toml Cargo.toml && cat -n omnipaxos/src/ballot_leader_election.rs'","aggregated_output":"[package]\nname = \"omnipaxos\"\nversion = \"0.2.3\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"A distributed log library written in Rust\"\nreadme = \"../README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nslog = { version = \"2.7.0\", optional = true }\nslog-term = { version = \"2.9.0\", optional = true }\nslog-async = { version = \"2.7.0\", optional = true }\nserde = { version = \"1.0\", optional = true, features = [\"derive\"] }\ntoml = { version = \"0.7.3\", optional = true }\nomnipaxos_macros = { version = \"0.1.3\", path = \"../omnipaxos_macros\", optional = true }\nlru = { version = \"0.11.0\", optional = true }\nnum-traits = { version = \"0.2.16\", optional = true }\nlinked_hash_set = { version = \"0.1.4\", optional = true }\nuuid = { version = \"1\", optional = true, features = [\"v4\"] }\n\n[dev-dependencies]\nkompact = { git = \"https://github.com/kompics/kompact\", rev = \"4fd1fdc\", features = [\"silent_logging\"] }\nomnipaxos_storage = { path = \"../omnipaxos_storage\", features = [\"persistent_storage\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\ntoml = \"0.7.3\"\ntempfile = \"3.3.0\"\nserial_test = \"0.5.1\"\nrand = \"0.8.4\"\nserde_json = \"1.0\"\n\n[features]\nlogging  = [\"slog\", \"slog-term\", \"slog-async\"]\ntoml_config = [\"serde\", \"toml\"]\nmacros = [\"omnipaxos_macros\"]\nunicache = [\"lru\", \"num-traits\", \"linked_hash_set\"]\nasync_runtime = [\"dep:uuid\"]\n# Explicit serde feature so it can chain uuid's serde support when both are on.\nserde = [\"dep:serde\", \"uuid?/serde\"]\n\ndefault = [\"macros\"]\n\n[profile.release]\nlto = true\n[workspace]\nresolver = \"2\"\nmembers = [\n    \"omnipaxos\",\n    \"omnipaxos_storage\",\n    \"omnipaxos_macros\",\n    \"omnipaxos_runtime\",\n    \"omnipaxos_ui\",\n    \"examples/kv_store\",\n    \"examples/kv_store_async\",\n    \"examples/dashboard\",\n]\n\n[profile.release]\nlto = true\n     1\tuse std::cmp::Ordering;\n     2\t\n     3\t/// Ballot Leader Election algorithm for electing new leaders\n     4\tuse crate::{\n     5\t    sequence_paxos::{Phase, Role},\n     6\t    util::{defaults::*, ConfigurationId, FlexibleQuorum, Quorum},\n     7\t};\n     8\t\n     9\t#[cfg(feature = \"logging\")]\n    10\tuse crate::utils::logger::create_logger;\n    11\tuse crate::{\n    12\t    messages::ballot_leader_election::{\n    13\t        BLEMessage, HeartbeatMsg, HeartbeatReply, HeartbeatRequest,\n    14\t    },\n    15\t    util::NodeId,\n    16\t    OmniPaxosConfig,\n    17\t};\n    18\t#[cfg(feature = \"serde\")]\n    19\tuse serde::{Deserialize, Serialize};\n    20\t#[cfg(feature = \"logging\")]\n    21\tuse slog::{info, trace, Logger};\n    22\t\n    23\t/// Used to define a Sequence Paxos epoch\n    24\t#[derive(Clone, Copy, Eq, Debug, Default, PartialEq)]\n    25\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    26\tpub struct Ballot {\n    27\t    /// The identifier for the configuration that the replica with this ballot is part of.\n    28\t    pub config_id: ConfigurationId,\n    29\t    /// Ballot number\n    30\t    pub n: u32,\n    31\t    /// Custom priority parameter\n    32\t    pub priority: u32,\n    33\t    /// The pid of the process\n    34\t    pub pid: NodeId,\n    35\t}\n    36\t\n    37\timpl Ballot {\n    38\t    /// Creates a new Ballot\n    39\t    /// # Arguments\n    40\t    /// * `config_id` - The identifier for the configuration that the replica with this ballot is part of.\n    41\t    /// * `n` - Ballot number.\n    42\t    /// * `pid` -  Used as tiebreaker for total ordering of ballots.\n    43\t    pub fn with(config_id: ConfigurationId, n: u32, priority: u32, pid: NodeId) -> Ballot {\n    44\t        Ballot {\n    45\t            config_id,\n    46\t            n,\n    47\t            priority,\n    48\t            pid,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\timpl Ord for Ballot {\n    54\t    fn cmp(&self, other: &Self) -> Ordering {\n    55\t        (self.n, self.priority, self.pid).cmp(&(other.n, other.priority, other.pid))\n    56\t    }\n    57\t}\n    58\t\n    59\timpl PartialOrd for Ballot {\n    60\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n    61\t        Some(self.cmp(other))\n    62\t    }\n    63\t}\n    64\t\n    65\tconst INITIAL_ROUND: u32 = 1;\n    66\tconst RECOVERY_ROUND: u32 = 0;\n    67\t\n    68\t/// A Ballot Leader Election component. Used in conjunction with OmniPaxos to handle the election of a leader for a cluster of OmniPaxos servers,\n    69\t/// incoming messages and produces outgoing messages that the user has to fetch periodically and send using a network implementation.\n    70\t/// User also has to periodically fetch the decided entries that are guaranteed to be strongly consistent and linearizable, and therefore also safe to be used in the higher level application.\n    71\tpub(crate) struct BallotLeaderElection {\n    72\t    /// The identifier for the configuration that this instance is part of.\n    73\t    configuration_id: ConfigurationId,\n    74\t    /// Process identifier used to uniquely identify this instance.\n    75\t    pid: NodeId,\n    76\t    /// Vector that holds the pids of all the other servers.\n    77\t    peers: Vec<NodeId>,\n    78\t    /// The current round of the heartbeat cycle.\n    79\t    hb_round: u32,\n    80\t    /// The heartbeat replies this instance received during the current round.\n    81\t    heartbeat_replies: Vec<HeartbeatReply>,\n    82\t    /// Vector that holds all the received heartbeats from the previous heartbeat round, including the current node. Only used to display the connectivity of this node in the UI.\n    83\t    /// Represents nodes that are currently alive from the view of the current node.\n    84\t    prev_replies: Vec<HeartbeatReply>,\n    85\t    /// Holds the current ballot of this instance.\n    86\t    current_ballot: Ballot,\n    87\t    /// The current leader of this instance.\n    88\t    leader: Ballot,\n    89\t    /// A happy node either sees that it is, is connected to, or sees evidence of a potential leader\n    90\t    /// for the cluster. If a node is unhappy then it is seeking a new leader.\n    91\t    happy: bool,\n    92\t    /// The number of replicas inside the cluster whose heartbeats are needed to become and remain the leader.\n    93\t    quorum: Quorum,\n    94\t    /// Vector which holds all the outgoing messages of the BLE instance.\n    95\t    outgoing: Vec<BLEMessage>,\n    96\t    /// Logger used to output the status of the component.\n    97\t    #[cfg(feature = \"logging\")]\n    98\t    logger: Logger,\n    99\t}\n   100\t\n   101\timpl BallotLeaderElection {\n   102\t    /// Construct a new BallotLeaderElection node\n   103\t    pub(crate) fn with(config: BLEConfig, recovered_leader: Option<Ballot>) -> Self {\n   104\t        let config_id = config.configuration_id;\n   105\t        let pid = config.pid;\n   106\t        let peers = config.peers;\n   107\t        let num_nodes = &peers.len() + 1;\n   108\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n   109\t        let mut initial_ballot = Ballot::with(config_id, INITIAL_ROUND, config.priority, pid);\n   110\t        let initial_leader = match recovered_leader {\n   111\t            Some(b) if b != Ballot::default() => {\n   112\t                // Prevents a recovered server from retaining BLE leadership with the same ballot.\n   113\t                initial_ballot.n = RECOVERY_ROUND;\n   114\t                b\n   115\t            }\n   116\t            _ => initial_ballot,\n   117\t        };\n   118\t        let mut ble = BallotLeaderElection {\n   119\t            configuration_id: config_id,\n   120\t            pid,\n   121\t            peers,\n   122\t            hb_round: 0,\n   123\t            heartbeat_replies: Vec::with_capacity(num_nodes),\n   124\t            prev_replies: Vec::with_capacity(num_nodes),\n   125\t            current_ballot: initial_ballot,\n   126\t            leader: initial_leader,\n   127\t            happy: true,\n   128\t            quorum,\n   129\t            outgoing: Vec::with_capacity(config.buffer_size),\n   130\t            #[cfg(feature = \"logging\")]\n   131\t            logger: {\n   132\t                if let Some(logger) = config.custom_logger {\n   133\t                    logger\n   134\t                } else {\n   135\t                    let s = config\n   136\t                        .logger_file_path\n   137\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   138\t                    create_logger(s.as_str())\n   139\t                }\n   140\t            },\n   141\t        };\n   142\t        #[cfg(feature = \"logging\")]\n   143\t        {\n   144\t            info!(\n   145\t                ble.logger,\n   146\t                \"Ballot Leader Election component pid: {} created!\", pid\n   147\t            );\n   148\t        }\n   149\t        ble.new_hb_round();\n   150\t        ble\n   151\t    }\n   152\t\n   153\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   154\t    /// priority triggers a leader re-election.\n   155\t    pub(crate) fn set_priority(&mut self, p: u32) {\n   156\t        self.current_ballot.priority = p;\n   157\t    }\n   158\t\n   159\t    /// Returns reference to outgoing messages\n   160\t    pub(crate) fn outgoing_mut(&mut self) -> &mut Vec<BLEMessage> {\n   161\t        &mut self.outgoing\n   162\t    }\n   163\t\n   164\t    /// Handle an incoming message.\n   165\t    /// # Arguments\n   166\t    /// * `m` - the message to be handled.\n   167\t    pub(crate) fn handle(&mut self, m: BLEMessage) {\n   168\t        match m.msg {\n   169\t            HeartbeatMsg::Request(req) => self.handle_request(m.from, req),\n   170\t            HeartbeatMsg::Reply(rep) => self.handle_reply(rep),\n   171\t        }\n   172\t    }\n   173\t\n   174\t    /// Initiates a new heartbeat round.\n   175\t    pub(crate) fn new_hb_round(&mut self) {\n   176\t        self.prev_replies = std::mem::take(&mut self.heartbeat_replies);\n   177\t        self.hb_round += 1;\n   178\t        #[cfg(feature = \"logging\")]\n   179\t        trace!(\n   180\t            self.logger,\n   181\t            \"Initiate new heartbeat round: {}\",\n   182\t            self.hb_round\n   183\t        );\n   184\t        for peer in &self.peers {\n   185\t            let hb_request = HeartbeatRequest {\n   186\t                round: self.hb_round,\n   187\t            };\n   188\t            self.outgoing.push(BLEMessage {\n   189\t                from: self.pid,\n   190\t                to: *peer,\n   191\t                msg: HeartbeatMsg::Request(hb_request),\n   192\t            });\n   193\t        }\n   194\t    }\n   195\t\n   196\t    /// End of a heartbeat round. Returns current leader and election status.\n   197\t    pub(crate) fn hb_timeout(\n   198\t        &mut self,\n   199\t        seq_paxos_state: &(Role, Phase),\n   200\t        seq_paxos_promise: Ballot,\n   201\t    ) -> Option<Ballot> {\n   202\t        self.update_leader();\n   203\t        self.update_happiness(seq_paxos_state);\n   204\t        self.check_takeover();\n   205\t        self.new_hb_round();\n   206\t        if seq_paxos_promise > self.leader {\n   207\t            // Sync leader with Paxos promise in case ballot didn't make it to BLE followers\n   208\t            // or become_leader() was called.\n   209\t            self.leader = seq_paxos_promise;\n   210\t            if seq_paxos_promise.pid == self.pid {\n   211\t                self.current_ballot = seq_paxos_promise;\n   212\t            }\n   213\t            self.happy = true;\n   214\t        }\n   215\t        if self.leader == self.current_ballot {\n   216\t            Some(self.current_ballot)\n   217\t        } else {\n   218\t            None\n   219\t        }\n   220\t    }\n   221\t\n   222\t    fn update_leader(&mut self) {\n   223\t        let max_reply_ballot = self.heartbeat_replies.iter().map(|r| r.ballot).max();\n   224\t        if let Some(max) = max_reply_ballot {\n   225\t            if max > self.leader {\n   226\t                self.leader = max;\n   227\t            }\n   228\t        }\n   229\t    }\n   230\t\n   231\t    fn update_happiness(&mut self, seq_paxos_state: &(Role, Phase)) {\n   232\t        self.happy = if self.leader == self.current_ballot {\n   233\t            let potential_followers = self\n   234\t                .heartbeat_replies\n   235\t                .iter()\n   236\t                .filter(|hb_reply| hb_reply.leader <= self.current_ballot)\n   237\t                .count();\n   238\t            let can_form_quorum = match seq_paxos_state {\n   239\t                (Role::Leader, Phase::Accept) => {\n   240\t                    self.quorum.is_accept_quorum(potential_followers + 1)\n   241\t                }\n   242\t                _ => self.quorum.is_prepare_quorum(potential_followers + 1),\n   243\t            };\n   244\t            if can_form_quorum {\n   245\t                true\n   246\t            } else {\n   247\t                let see_larger_happy_leader = self\n   248\t                    .heartbeat_replies\n   249\t                    .iter()\n   250\t                    .any(|r| r.leader > self.current_ballot && r.happy);\n   251\t                see_larger_happy_leader\n   252\t            }\n   253\t        } else {\n   254\t            self.heartbeat_replies\n   255\t                .iter()\n   256\t                .any(|r| r.ballot == self.leader && r.happy)\n   257\t        };\n   258\t    }\n   259\t\n   260\t    fn check_takeover(&mut self) {\n   261\t        if !self.happy {\n   262\t            let all_neighbors_unhappy = self.heartbeat_replies.iter().all(|r| !r.happy);\n   263\t            let im_quorum_connected = self\n   264\t                .quorum\n   265\t                .is_prepare_quorum(self.heartbeat_replies.len() + 1);\n   266\t            if all_neighbors_unhappy && im_quorum_connected {\n   267\t                // We increment past our leader instead of max of unhappy ballots because we\n   268\t                // assume we have already checked leader for this round so they should be equal\n   269\t                self.current_ballot.n = self.leader.n + 1;\n   270\t                self.leader = self.current_ballot;\n   271\t                self.happy = true;\n   272\t            }\n   273\t        }\n   274\t    }\n   275\t\n   276\t    fn handle_request(&mut self, from: NodeId, req: HeartbeatRequest) {\n   277\t        let hb_reply = HeartbeatReply {\n   278\t            round: req.round,\n   279\t            ballot: self.current_ballot,\n   280\t            leader: self.leader,\n   281\t            happy: self.happy,\n   282\t        };\n   283\t        self.outgoing.push(BLEMessage {\n   284\t            from: self.pid,\n   285\t            to: from,\n   286\t            msg: HeartbeatMsg::Reply(hb_reply),\n   287\t        });\n   288\t    }\n   289\t\n   290\t    fn handle_reply(&mut self, rep: HeartbeatReply) {\n   291\t        if rep.round == self.hb_round && rep.ballot.config_id == self.configuration_id {\n   292\t            self.heartbeat_replies.push(rep);\n   293\t        }\n   294\t    }\n   295\t\n   296\t    pub(crate) fn get_current_ballot(&self) -> Ballot {\n   297\t        self.current_ballot\n   298\t    }\n   299\t\n   300\t    pub(crate) fn get_ballots(&self) -> Vec<HeartbeatReply> {\n   301\t        self.prev_replies.clone()\n   302\t    }\n   303\t}\n   304\t\n   305\t/// Configuration for `BallotLeaderElection`.\n   306\t/// # Fields\n   307\t/// * `configuration_id`: The identifier for the configuration that this node is part of.\n   308\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   309\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   310\t/// * `priority`: Set custom priority for this node to be elected as the leader.\n   311\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   312\t/// * `buffer_size`: The buffer size for outgoing messages.\n   313\t/// * `logger_file_path`: The path where the default logger logs events.\n   314\t#[derive(Clone, Debug)]\n   315\tpub(crate) struct BLEConfig {\n   316\t    configuration_id: ConfigurationId,\n   317\t    pid: NodeId,\n   318\t    peers: Vec<NodeId>,\n   319\t    priority: u32,\n   320\t    flexible_quorum: Option<FlexibleQuorum>,\n   321\t    buffer_size: usize,\n   322\t    #[cfg(feature = \"logging\")]\n   323\t    logger_file_path: Option<String>,\n   324\t    #[cfg(feature = \"logging\")]\n   325\t    custom_logger: Option<Logger>,\n   326\t}\n   327\t\n   328\timpl From<OmniPaxosConfig> for BLEConfig {\n   329\t    fn from(config: OmniPaxosConfig) -> Self {\n   330\t        let pid = config.server_config.pid;\n   331\t        let peers = config\n   332\t            .cluster_config\n   333\t            .nodes\n   334\t            .into_iter()\n   335\t            .filter(|x| *x != pid)\n   336\t            .collect();\n   337\t\n   338\t        Self {\n   339\t            configuration_id: config.cluster_config.configuration_id,\n   340\t            pid,\n   341\t            peers,\n   342\t            priority: config.server_config.leader_priority,\n   343\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   344\t            buffer_size: BLE_BUFFER_SIZE,\n   345\t            #[cfg(feature = \"logging\")]\n   346\t            logger_file_path: config.server_config.logger_file_path,\n   347\t            #[cfg(feature = \"logging\")]\n   348\t            custom_logger: config.server_config.custom_logger,\n   349\t        }\n   350\t    }\n   351\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source/omnipaxos/src && cat -n util.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source/omnipaxos/src && cat -n util.rs'","aggregated_output":"     1\tuse super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    messages::sequence_paxos::Promise,\n     4\t    storage::{Entry, SnapshotType, StopSign},\n     5\t};\n     6\t#[cfg(feature = \"serde\")]\n     7\tuse serde::{Deserialize, Serialize};\n     8\tuse std::{cmp::Ordering, fmt::Debug, marker::PhantomData};\n     9\t\n    10\t/// Struct used to help another server synchronize their log with the current state of our own log.\n    11\t#[derive(Clone, Debug)]\n    12\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    13\tpub struct LogSync<T>\n    14\twhere\n    15\t    T: Entry,\n    16\t{\n    17\t    /// The decided snapshot.\n    18\t    pub decided_snapshot: Option<SnapshotType<T>>,\n    19\t    /// The log suffix.\n    20\t    pub suffix: Vec<T>,\n    21\t    /// The index of the log where the entries from `suffix` should be applied at (also the compacted idx of `decided_snapshot` if it exists).\n    22\t    pub sync_idx: usize,\n    23\t    /// The accepted StopSign.\n    24\t    pub stopsign: Option<StopSign>,\n    25\t}\n    26\t\n    27\t#[derive(Debug, Clone, Default)]\n    28\t/// Promise without the log update\n    29\tpub(crate) struct PromiseMetaData {\n    30\t    pub n_accepted: Ballot,\n    31\t    pub accepted_idx: usize,\n    32\t    pub decided_idx: usize,\n    33\t    pub pid: NodeId,\n    34\t}\n    35\t\n    36\timpl PartialOrd for PromiseMetaData {\n    37\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n    38\t        let ordering = if self.n_accepted == other.n_accepted\n    39\t            && self.accepted_idx == other.accepted_idx\n    40\t            && self.pid == other.pid\n    41\t        {\n    42\t            Ordering::Equal\n    43\t        } else if self.n_accepted > other.n_accepted\n    44\t            || (self.n_accepted == other.n_accepted && self.accepted_idx > other.accepted_idx)\n    45\t        {\n    46\t            Ordering::Greater\n    47\t        } else {\n    48\t            Ordering::Less\n    49\t        };\n    50\t        Some(ordering)\n    51\t    }\n    52\t}\n    53\t\n    54\timpl PartialEq for PromiseMetaData {\n    55\t    fn eq(&self, other: &Self) -> bool {\n    56\t        self.n_accepted == other.n_accepted\n    57\t            && self.accepted_idx == other.accepted_idx\n    58\t            && self.pid == other.pid\n    59\t    }\n    60\t}\n    61\t\n    62\t#[derive(Debug, Clone)]\n    63\t/// The promise state of a node.\n    64\tenum PromiseState {\n    65\t    /// Not promised to any leader\n    66\t    NotPromised,\n    67\t    /// Promised to my ballot\n    68\t    Promised(PromiseMetaData),\n    69\t    /// Promised to a leader who's ballot is greater than mine\n    70\t    PromisedHigher,\n    71\t}\n    72\t\n    73\t#[derive(Debug, Clone)]\n    74\tpub(crate) struct LeaderState<T>\n    75\twhere\n    76\t    T: Entry,\n    77\t{\n    78\t    pub n_leader: Ballot,\n    79\t    promises_meta: Vec<PromiseState>,\n    80\t    // the sequence number of accepts for each follower where AcceptSync has sequence number = 1\n    81\t    follower_seq_nums: Vec<SequenceNumber>,\n    82\t    pub accepted_indexes: Vec<usize>,\n    83\t    max_promise_meta: PromiseMetaData,\n    84\t    max_promise_sync: Option<LogSync<T>>,\n    85\t    latest_accept_meta: Vec<Option<(Ballot, usize)>>, //  index in outgoing\n    86\t    pub max_pid: usize,\n    87\t    // The number of promises needed in the prepare phase to become synced and\n    88\t    // the number of accepteds needed in the accept phase to decide an entry.\n    89\t    pub quorum: Quorum,\n    90\t}\n    91\t\n    92\timpl<T> LeaderState<T>\n    93\twhere\n    94\t    T: Entry,\n    95\t{\n    96\t    pub fn with(n_leader: Ballot, max_pid: usize, quorum: Quorum) -> Self {\n    97\t        Self {\n    98\t            n_leader,\n    99\t            promises_meta: vec![PromiseState::NotPromised; max_pid],\n   100\t            follower_seq_nums: vec![SequenceNumber::default(); max_pid],\n   101\t            accepted_indexes: vec![0; max_pid],\n   102\t            max_promise_meta: PromiseMetaData::default(),\n   103\t            max_promise_sync: None,\n   104\t            latest_accept_meta: vec![None; max_pid],\n   105\t            max_pid,\n   106\t            quorum,\n   107\t        }\n   108\t    }\n   109\t\n   110\t    fn pid_to_idx(pid: NodeId) -> usize {\n   111\t        (pid - 1) as usize\n   112\t    }\n   113\t\n   114\t    // Resets `pid`'s accept sequence to indicate they are in the next session of accepts\n   115\t    pub fn increment_seq_num_session(&mut self, pid: NodeId) {\n   116\t        let idx = Self::pid_to_idx(pid);\n   117\t        self.follower_seq_nums[idx].session += 1;\n   118\t        self.follower_seq_nums[idx].counter = 0;\n   119\t    }\n   120\t\n   121\t    pub fn next_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   122\t        let idx = Self::pid_to_idx(pid);\n   123\t        self.follower_seq_nums[idx].counter += 1;\n   124\t        self.follower_seq_nums[idx]\n   125\t    }\n   126\t\n   127\t    pub fn get_seq_num(&mut self, pid: NodeId) -> SequenceNumber {\n   128\t        self.follower_seq_nums[Self::pid_to_idx(pid)]\n   129\t    }\n   130\t\n   131\t    pub fn set_promise(&mut self, prom: Promise<T>, from: NodeId, check_max_prom: bool) -> bool {\n   132\t        let promise_meta = PromiseMetaData {\n   133\t            n_accepted: prom.n_accepted,\n   134\t            accepted_idx: prom.accepted_idx,\n   135\t            decided_idx: prom.decided_idx,\n   136\t            pid: from,\n   137\t        };\n   138\t        if check_max_prom && promise_meta > self.max_promise_meta {\n   139\t            self.max_promise_meta = promise_meta.clone();\n   140\t            self.max_promise_sync = prom.log_sync;\n   141\t        }\n   142\t        self.promises_meta[Self::pid_to_idx(from)] = PromiseState::Promised(promise_meta);\n   143\t        let num_promised = self\n   144\t            .promises_meta\n   145\t            .iter()\n   146\t            .filter(|p| matches!(p, PromiseState::Promised(_)))\n   147\t            .count();\n   148\t        self.quorum.is_prepare_quorum(num_promised)\n   149\t    }\n   150\t\n   151\t    pub fn reset_promise(&mut self, pid: NodeId) {\n   152\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::NotPromised;\n   153\t    }\n   154\t\n   155\t    /// Node `pid` seen with ballot greater than my ballot\n   156\t    pub fn lost_promise(&mut self, pid: NodeId) {\n   157\t        self.promises_meta[Self::pid_to_idx(pid)] = PromiseState::PromisedHigher;\n   158\t    }\n   159\t\n   160\t    pub fn take_max_promise_sync(&mut self) -> Option<LogSync<T>> {\n   161\t        std::mem::take(&mut self.max_promise_sync)\n   162\t    }\n   163\t\n   164\t    pub fn get_max_promise_meta(&self) -> &PromiseMetaData {\n   165\t        &self.max_promise_meta\n   166\t    }\n   167\t\n   168\t    pub fn get_max_decided_idx(&self) -> usize {\n   169\t        self.promises_meta\n   170\t            .iter()\n   171\t            .filter_map(|p| match p {\n   172\t                PromiseState::Promised(m) => Some(m.decided_idx),\n   173\t                _ => None,\n   174\t            })\n   175\t            .max()\n   176\t            .unwrap_or_default()\n   177\t    }\n   178\t\n   179\t    pub fn get_promise_meta(&self, pid: NodeId) -> &PromiseMetaData {\n   180\t        match &self.promises_meta[Self::pid_to_idx(pid)] {\n   181\t            PromiseState::Promised(metadata) => metadata,\n   182\t            _ => panic!(\"No Metadata found for promised follower\"),\n   183\t        }\n   184\t    }\n   185\t\n   186\t    pub fn get_min_all_accepted_idx(&self) -> &usize {\n   187\t        self.accepted_indexes\n   188\t            .iter()\n   189\t            .min()\n   190\t            .expect(\"Should be all initialised to 0!\")\n   191\t    }\n   192\t\n   193\t    pub fn reset_latest_accept_meta(&mut self) {\n   194\t        self.latest_accept_meta = vec![None; self.max_pid];\n   195\t    }\n   196\t\n   197\t    pub fn get_promised_followers(&self) -> Vec<NodeId> {\n   198\t        self.promises_meta\n   199\t            .iter()\n   200\t            .enumerate()\n   201\t            .filter_map(|(idx, x)| match x {\n   202\t                PromiseState::Promised(_) if idx != Self::pid_to_idx(self.n_leader.pid) => {\n   203\t                    Some((idx + 1) as NodeId)\n   204\t                }\n   205\t                _ => None,\n   206\t            })\n   207\t            .collect()\n   208\t    }\n   209\t\n   210\t    /// The pids of peers which have not promised a higher ballot than mine.\n   211\t    pub(crate) fn get_preparable_peers(&self, peers: &[NodeId]) -> Vec<NodeId> {\n   212\t        peers\n   213\t            .iter()\n   214\t            .filter_map(|pid| {\n   215\t                let idx = Self::pid_to_idx(*pid);\n   216\t                match self.promises_meta.get(idx).unwrap() {\n   217\t                    PromiseState::NotPromised => Some(*pid),\n   218\t                    _ => None,\n   219\t                }\n   220\t            })\n   221\t            .collect()\n   222\t    }\n   223\t\n   224\t    pub fn set_latest_accept_meta(&mut self, pid: NodeId, idx: Option<usize>) {\n   225\t        let meta = idx.map(|x| (self.n_leader, x));\n   226\t        self.latest_accept_meta[Self::pid_to_idx(pid)] = meta;\n   227\t    }\n   228\t\n   229\t    pub fn set_accepted_idx(&mut self, pid: NodeId, idx: usize) {\n   230\t        self.accepted_indexes[Self::pid_to_idx(pid)] = idx;\n   231\t    }\n   232\t\n   233\t    pub fn get_latest_accept_meta(&self, pid: NodeId) -> Option<(Ballot, usize)> {\n   234\t        self.latest_accept_meta\n   235\t            .get(Self::pid_to_idx(pid))\n   236\t            .unwrap()\n   237\t            .as_ref()\n   238\t            .copied()\n   239\t    }\n   240\t\n   241\t    pub fn get_decided_idx(&self, pid: NodeId) -> Option<usize> {\n   242\t        match self.promises_meta.get(Self::pid_to_idx(pid)).unwrap() {\n   243\t            PromiseState::Promised(metadata) => Some(metadata.decided_idx),\n   244\t            _ => None,\n   245\t        }\n   246\t    }\n   247\t\n   248\t    pub fn get_accepted_idx(&self, pid: NodeId) -> usize {\n   249\t        *self.accepted_indexes.get(Self::pid_to_idx(pid)).unwrap()\n   250\t    }\n   251\t\n   252\t    pub fn is_chosen(&self, idx: usize) -> bool {\n   253\t        let num_accepted = self\n   254\t            .accepted_indexes\n   255\t            .iter()\n   256\t            .filter(|la| **la >= idx)\n   257\t            .count();\n   258\t        self.quorum.is_accept_quorum(num_accepted)\n   259\t    }\n   260\t}\n   261\t\n   262\t/// The entry read in the log.\n   263\t#[derive(Debug, Clone)]\n   264\tpub enum LogEntry<T>\n   265\twhere\n   266\t    T: Entry,\n   267\t{\n   268\t    /// The entry is decided.\n   269\t    Decided(T),\n   270\t    /// The entry is NOT decided. Might be removed from the log at a later time.\n   271\t    Undecided(T),\n   272\t    /// The entry has been trimmed.\n   273\t    Trimmed(TrimmedIndex),\n   274\t    /// The entry has been snapshotted.\n   275\t    Snapshotted(SnapshottedEntry<T>),\n   276\t    /// This Sequence Paxos instance has been stopped for reconfiguration. The accompanying bool\n   277\t    /// indicates whether the reconfiguration has been decided or not. If it is `true`, then the OmniPaxos instance for the new configuration can be started.\n   278\t    StopSign(StopSign, bool),\n   279\t}\n   280\t\n   281\timpl<T: PartialEq + Entry> PartialEq for LogEntry<T>\n   282\twhere\n   283\t    <T as Entry>::Snapshot: PartialEq,\n   284\t{\n   285\t    fn eq(&self, other: &Self) -> bool {\n   286\t        match (self, other) {\n   287\t            (LogEntry::Decided(v1), LogEntry::Decided(v2)) => v1 == v2,\n   288\t            (LogEntry::Undecided(v1), LogEntry::Undecided(v2)) => v1 == v2,\n   289\t            (LogEntry::Trimmed(idx1), LogEntry::Trimmed(idx2)) => idx1 == idx2,\n   290\t            (LogEntry::Snapshotted(s1), LogEntry::Snapshotted(s2)) => s1 == s2,\n   291\t            (LogEntry::StopSign(ss1, b1), LogEntry::StopSign(ss2, b2)) => ss1 == ss2 && b1 == b2,\n   292\t            _ => false,\n   293\t        }\n   294\t    }\n   295\t}\n   296\t\n   297\t/// Convenience struct for checking if a certain index exists, is compacted or is a StopSign.\n   298\t#[derive(Debug, Clone)]\n   299\tpub(crate) enum IndexEntry {\n   300\t    Entry,\n   301\t    Compacted,\n   302\t    StopSign(StopSign),\n   303\t}\n   304\t\n   305\t#[allow(missing_docs)]\n   306\t#[derive(Debug, Clone)]\n   307\tpub struct SnapshottedEntry<T>\n   308\twhere\n   309\t    T: Entry,\n   310\t{\n   311\t    pub trimmed_idx: TrimmedIndex,\n   312\t    pub snapshot: T::Snapshot,\n   313\t    _p: PhantomData<T>,\n   314\t}\n   315\t\n   316\timpl<T> SnapshottedEntry<T>\n   317\twhere\n   318\t    T: Entry,\n   319\t{\n   320\t    pub(crate) fn with(trimmed_idx: usize, snapshot: T::Snapshot) -> Self {\n   321\t        Self {\n   322\t            trimmed_idx,\n   323\t            snapshot,\n   324\t            _p: PhantomData,\n   325\t        }\n   326\t    }\n   327\t}\n   328\t\n   329\timpl<T: Entry> PartialEq for SnapshottedEntry<T>\n   330\twhere\n   331\t    <T as Entry>::Snapshot: PartialEq,\n   332\t{\n   333\t    fn eq(&self, other: &Self) -> bool {\n   334\t        self.trimmed_idx == other.trimmed_idx && self.snapshot == other.snapshot\n   335\t    }\n   336\t}\n   337\t\n   338\tpub(crate) mod defaults {\n   339\t    pub(crate) const BUFFER_SIZE: usize = 100000;\n   340\t    pub(crate) const BLE_BUFFER_SIZE: usize = 100;\n   341\t    pub(crate) const ELECTION_TIMEOUT: u64 = 1;\n   342\t    pub(crate) const RESEND_MESSAGE_TIMEOUT: u64 = 100;\n   343\t    pub(crate) const FLUSH_BATCH_TIMEOUT: u64 = 200;\n   344\t}\n   345\t\n   346\t#[allow(missing_docs)]\n   347\tpub type TrimmedIndex = usize;\n   348\t\n   349\t/// ID for an OmniPaxos node\n   350\tpub type NodeId = u64;\n   351\t/// ID for an OmniPaxos configuration (i.e., the set of servers in an OmniPaxos cluster)\n   352\tpub type ConfigurationId = u32;\n   353\t\n   354\t/// Error message to display when there was an error reading to the storage implementation.\n   355\tpub const READ_ERROR_MSG: &str = \"Error reading from storage.\";\n   356\t/// Error message to display when there was an error writing to the storage implementation.\n   357\tpub const WRITE_ERROR_MSG: &str = \"Error writing to storage.\";\n   358\t\n   359\t/// Used for checking the ordering of message sequences in the accept phase\n   360\t#[derive(PartialEq, Eq)]\n   361\tpub(crate) enum MessageStatus {\n   362\t    /// Expected message sequence progression\n   363\t    Expected,\n   364\t    /// Identified a message sequence break\n   365\t    DroppedPreceding,\n   366\t    /// An already identified message sequence break\n   367\t    Outdated,\n   368\t}\n   369\t\n   370\t/// Keeps track of the ordering of messages in the accept phase\n   371\t#[derive(Copy, Clone, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]\n   372\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   373\tpub struct SequenceNumber {\n   374\t    /// Meant to refer to a TCP session\n   375\t    pub session: u64,\n   376\t    /// The sequence number with respect to a session\n   377\t    pub counter: u64,\n   378\t}\n   379\t\n   380\timpl SequenceNumber {\n   381\t    /// Compares this sequence number with the sequence number of an incoming message.\n   382\t    pub(crate) fn check_msg_status(&self, msg_seq_num: SequenceNumber) -> MessageStatus {\n   383\t        if msg_seq_num.session == self.session && msg_seq_num.counter == self.counter + 1 {\n   384\t            MessageStatus::Expected\n   385\t        } else if msg_seq_num <= *self {\n   386\t            MessageStatus::Outdated\n   387\t        } else {\n   388\t            MessageStatus::DroppedPreceding\n   389\t        }\n   390\t    }\n   391\t}\n   392\t\n   393\tpub(crate) struct LogicalClock {\n   394\t    time: u64,\n   395\t    timeout: u64,\n   396\t}\n   397\t\n   398\timpl LogicalClock {\n   399\t    pub fn with(timeout: u64) -> Self {\n   400\t        Self { time: 0, timeout }\n   401\t    }\n   402\t\n   403\t    pub fn tick_and_check_timeout(&mut self) -> bool {\n   404\t        self.time += 1;\n   405\t        if self.time == self.timeout {\n   406\t            self.time = 0;\n   407\t            true\n   408\t        } else {\n   409\t            false\n   410\t        }\n   411\t    }\n   412\t}\n   413\t\n   414\t/// Flexible quorums can be used to increase/decrease the read and write quorum sizes,\n   415\t/// for different latency vs fault tolerance tradeoffs.\n   416\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n   417\t#[cfg_attr(any(feature = \"serde\", feature = \"toml_config\"), derive(Deserialize))]\n   418\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n   419\tpub struct FlexibleQuorum {\n   420\t    /// The number of nodes a leader needs to consult to get an up-to-date view of the log.\n   421\t    pub read_quorum_size: usize,\n   422\t    /// The number of acknowledgments a leader needs to commit an entry to the log\n   423\t    pub write_quorum_size: usize,\n   424\t}\n   425\t\n   426\t/// The type of quorum used by the OmniPaxos cluster.\n   427\t#[derive(Copy, Clone, Debug)]\n   428\tpub(crate) enum Quorum {\n   429\t    /// Both the read quorum and the write quorums are a majority of nodes\n   430\t    Majority(usize),\n   431\t    /// The read and write quorum sizes are defined by a `FlexibleQuorum`\n   432\t    Flexible(FlexibleQuorum),\n   433\t}\n   434\t\n   435\timpl Quorum {\n   436\t    pub(crate) fn with(flexible_quorum_config: Option<FlexibleQuorum>, num_nodes: usize) -> Self {\n   437\t        match flexible_quorum_config {\n   438\t            Some(FlexibleQuorum {\n   439\t                read_quorum_size,\n   440\t                write_quorum_size,\n   441\t            }) => Quorum::Flexible(FlexibleQuorum {\n   442\t                read_quorum_size,\n   443\t                write_quorum_size,\n   444\t            }),\n   445\t            None => Quorum::Majority(num_nodes / 2 + 1),\n   446\t        }\n   447\t    }\n   448\t\n   449\t    pub(crate) fn is_prepare_quorum(&self, num_nodes: usize) -> bool {\n   450\t        match self {\n   451\t            Quorum::Majority(majority) => num_nodes >= *majority,\n   452\t            Quorum::Flexible(flex_quorum) => num_nodes >= flex_quorum.read_quorum_size,\n   453\t        }\n   454\t    }\n   455\t\n   456\t    pub(crate) fn is_accept_quorum(&self, num_nodes: usize) -> bool {\n   457\t        match self {\n   458\t            Quorum::Majority(majority) => num_nodes >= *majority,\n   459\t            Quorum::Flexible(flex_quorum) => num_nodes >= flex_quorum.write_quorum_size,\n   460\t        }\n   461\t    }\n   462\t}\n   463\t\n   464\t/// The entries flushed due to an append operation\n   465\tpub(crate) struct AcceptedMetaData<T: Entry> {\n   466\t    pub accepted_idx: usize,\n   467\t    #[cfg(not(feature = \"unicache\"))]\n   468\t    pub entries: Vec<T>,\n   469\t    #[cfg(feature = \"unicache\")]\n   470\t    pub entries: Vec<T::EncodeResult>,\n   471\t}\n   472\t\n   473\t#[cfg(not(feature = \"unicache\"))]\n   474\t#[cfg(test)]\n   475\tmod tests {\n   476\t    use super::*; // Import functions and types from this module\n   477\t    use crate::storage::NoSnapshot;\n   478\t    #[test]\n   479\t    fn preparable_peers_test() {\n   480\t        type Value = ();\n   481\t\n   482\t        impl Entry for Value {\n   483\t            type Snapshot = NoSnapshot;\n   484\t        }\n   485\t\n   486\t        let nodes = vec![6, 7, 8];\n   487\t        let quorum = Quorum::Majority(2);\n   488\t        let max_pid = 8;\n   489\t        let leader_state =\n   490\t            LeaderState::<Value>::with(Ballot::with(1, 1, 1, max_pid), max_pid as usize, quorum);\n   491\t        let prep_peers = leader_state.get_preparable_peers(&nodes);\n   492\t        assert_eq!(prep_peers, nodes);\n   493\t\n   494\t        let nodes = vec![7, 1, 100, 4, 6];\n   495\t        let quorum = Quorum::Majority(3);\n   496\t        let max_pid = 100;\n   497\t        let leader_state =\n   498\t            LeaderState::<Value>::with(Ballot::with(1, 1, 1, max_pid), max_pid as usize, quorum);\n   499\t        let prep_peers = leader_state.get_preparable_peers(&nodes);\n   500\t        assert_eq!(prep_peers, nodes);\n   501\t    }\n   502\t}\n","exit_code":0,"status":"completed"}}
