{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source/omnipaxos/src && cat -n sequence_paxos/leader.rs'","aggregated_output":"     1\tuse super::super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    util::{LeaderState, PromiseMetaData},\n     4\t};\n     5\tuse crate::util::{AcceptedMetaData, WRITE_ERROR_MSG};\n     6\t\n     7\tuse super::*;\n     8\t\n     9\timpl<T, B> SequencePaxos<T, B>\n    10\twhere\n    11\t    T: Entry,\n    12\t    B: Storage<T>,\n    13\t{\n    14\t    /// Handle a new leader. Should be called when the leader election has elected a new leader with the ballot `n`\n    15\t    /*** Leader ***/\n    16\t    pub(crate) fn handle_leader(&mut self, n: Ballot) {\n    17\t        if n <= self.leader_state.n_leader || n <= self.internal_storage.get_promise() {\n    18\t            return;\n    19\t        }\n    20\t        #[cfg(feature = \"logging\")]\n    21\t        debug!(self.logger, \"Newly elected leader: {:?}\", n);\n    22\t        if self.pid == n.pid {\n    23\t            self.leader_state =\n    24\t                LeaderState::with(n, self.leader_state.max_pid, self.leader_state.quorum);\n    25\t            // Flush any pending writes\n    26\t            // Don't have to handle flushed entries here because we will sync with followers\n    27\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    28\t            self.internal_storage.set_promise(n).expect(WRITE_ERROR_MSG);\n    29\t            /* insert my promise */\n    30\t            let na = self.internal_storage.get_accepted_round();\n    31\t            let decided_idx = self.get_decided_idx();\n    32\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    33\t            let my_promise = Promise {\n    34\t                n,\n    35\t                n_accepted: na,\n    36\t                decided_idx,\n    37\t                accepted_idx,\n    38\t                log_sync: None,\n    39\t            };\n    40\t            self.leader_state.set_promise(my_promise, self.pid, true);\n    41\t            /* initialise longest chosen sequence and update state */\n    42\t            self.state = (Role::Leader, Phase::Prepare);\n    43\t            let prep = Prepare {\n    44\t                n,\n    45\t                decided_idx,\n    46\t                n_accepted: na,\n    47\t                accepted_idx,\n    48\t            };\n    49\t            /* send prepare */\n    50\t            for pid in &self.peers {\n    51\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    52\t                    from: self.pid,\n    53\t                    to: *pid,\n    54\t                    msg: PaxosMsg::Prepare(prep),\n    55\t                }));\n    56\t            }\n    57\t        } else {\n    58\t            self.become_follower();\n    59\t        }\n    60\t    }\n    61\t\n    62\t    pub(crate) fn become_follower(&mut self) {\n    63\t        self.state.0 = Role::Follower;\n    64\t    }\n    65\t\n    66\t    pub(crate) fn handle_preparereq(&mut self, prepreq: PrepareReq, from: NodeId) {\n    67\t        #[cfg(feature = \"logging\")]\n    68\t        debug!(self.logger, \"Incoming message PrepareReq from {}\", from);\n    69\t        if self.state.0 == Role::Leader && prepreq.n <= self.leader_state.n_leader {\n    70\t            self.leader_state.reset_promise(from);\n    71\t            self.leader_state.set_latest_accept_meta(from, None);\n    72\t            self.send_prepare(from);\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub(crate) fn handle_forwarded_proposal(&mut self, mut entries: Vec<T>) {\n    77\t        if !self.accepted_reconfiguration() {\n    78\t            match self.state {\n    79\t                (Role::Leader, Phase::Prepare) => self.buffered_proposals.append(&mut entries),\n    80\t                (Role::Leader, Phase::Accept) => self.accept_entries_leader(entries),\n    81\t                _ => self.forward_proposals(entries),\n    82\t            }\n    83\t        }\n    84\t    }\n    85\t\n    86\t    pub(crate) fn handle_forwarded_stopsign(&mut self, ss: StopSign) {\n    87\t        if self.accepted_reconfiguration() {\n    88\t            return;\n    89\t        }\n    90\t        match self.state {\n    91\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n    92\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n    93\t            _ => self.forward_stopsign(ss),\n    94\t        }\n    95\t    }\n    96\t\n    97\t    pub(crate) fn send_prepare(&mut self, to: NodeId) {\n    98\t        let prep = Prepare {\n    99\t            n: self.leader_state.n_leader,\n   100\t            decided_idx: self.internal_storage.get_decided_idx(),\n   101\t            n_accepted: self.internal_storage.get_accepted_round(),\n   102\t            accepted_idx: self.internal_storage.get_accepted_idx(),\n   103\t        };\n   104\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   105\t            from: self.pid,\n   106\t            to,\n   107\t            msg: PaxosMsg::Prepare(prep),\n   108\t        }));\n   109\t    }\n   110\t\n   111\t    pub(crate) fn accept_entry_leader(&mut self, entry: T) {\n   112\t        let accepted_metadata = self\n   113\t            .internal_storage\n   114\t            .append_entry_with_batching(entry)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        if let Some(metadata) = accepted_metadata {\n   117\t            self.leader_state\n   118\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   119\t            self.send_acceptdecide(metadata);\n   120\t        }\n   121\t    }\n   122\t\n   123\t    pub(crate) fn accept_entries_leader(&mut self, entries: Vec<T>) {\n   124\t        let accepted_metadata = self\n   125\t            .internal_storage\n   126\t            .append_entries_with_batching(entries)\n   127\t            .expect(WRITE_ERROR_MSG);\n   128\t        if let Some(metadata) = accepted_metadata {\n   129\t            self.leader_state\n   130\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   131\t            self.send_acceptdecide(metadata);\n   132\t        }\n   133\t    }\n   134\t\n   135\t    pub(crate) fn accept_stopsign_leader(&mut self, ss: StopSign) {\n   136\t        let accepted_metadata = self\n   137\t            .internal_storage\n   138\t            .append_stopsign(ss.clone())\n   139\t            .expect(WRITE_ERROR_MSG);\n   140\t        if let Some(metadata) = accepted_metadata {\n   141\t            self.send_acceptdecide(metadata);\n   142\t        }\n   143\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   144\t        self.leader_state.set_accepted_idx(self.pid, accepted_idx);\n   145\t        for pid in self.leader_state.get_promised_followers() {\n   146\t            self.send_accept_stopsign(pid, ss.clone(), false);\n   147\t        }\n   148\t    }\n   149\t\n   150\t    fn send_accsync(&mut self, to: NodeId) {\n   151\t        let current_n = self.leader_state.n_leader;\n   152\t        let PromiseMetaData {\n   153\t            n_accepted: prev_round_max_promise_n,\n   154\t            accepted_idx: prev_round_max_accepted_idx,\n   155\t            ..\n   156\t        } = &self.leader_state.get_max_promise_meta();\n   157\t        let PromiseMetaData {\n   158\t            n_accepted: followers_promise_n,\n   159\t            accepted_idx: followers_accepted_idx,\n   160\t            pid,\n   161\t            ..\n   162\t        } = self.leader_state.get_promise_meta(to);\n   163\t        let followers_decided_idx = self\n   164\t            .leader_state\n   165\t            .get_decided_idx(*pid)\n   166\t            .expect(\"Received PromiseMetaData but not found in ld\");\n   167\t        // Follower can have valid accepted entries depending on which leader they were previously following\n   168\t        let followers_valid_entries_idx = if *followers_promise_n == current_n {\n   169\t            *followers_accepted_idx\n   170\t        } else if *followers_promise_n == *prev_round_max_promise_n {\n   171\t            *prev_round_max_accepted_idx.min(followers_accepted_idx)\n   172\t        } else {\n   173\t            followers_decided_idx\n   174\t        };\n   175\t        let log_sync = self.create_log_sync(followers_valid_entries_idx, followers_decided_idx);\n   176\t        self.leader_state.increment_seq_num_session(to);\n   177\t        let acc_sync = AcceptSync {\n   178\t            n: current_n,\n   179\t            seq_num: self.leader_state.next_seq_num(to),\n   180\t            decided_idx: self.get_decided_idx(),\n   181\t            log_sync,\n   182\t            #[cfg(feature = \"unicache\")]\n   183\t            unicache: self.internal_storage.get_unicache(),\n   184\t        };\n   185\t        let msg = Message::SequencePaxos(PaxosMessage {\n   186\t            from: self.pid,\n   187\t            to,\n   188\t            msg: PaxosMsg::AcceptSync(acc_sync),\n   189\t        });\n   190\t        self.outgoing.push(msg);\n   191\t    }\n   192\t\n   193\t    fn send_acceptdecide(&mut self, accepted: AcceptedMetaData<T>) {\n   194\t        let decided_idx = self.internal_storage.get_decided_idx();\n   195\t        for pid in self.leader_state.get_promised_followers() {\n   196\t            let latest_accdec = self.get_latest_accdec_message(pid);\n   197\t            match latest_accdec {\n   198\t                // Modify existing AcceptDecide message to follower\n   199\t                Some(accdec) => {\n   200\t                    accdec.entries.extend(accepted.entries.iter().cloned());\n   201\t                    accdec.decided_idx = decided_idx;\n   202\t                }\n   203\t                // Add new AcceptDecide message to follower\n   204\t                None => {\n   205\t                    self.leader_state\n   206\t                        .set_latest_accept_meta(pid, Some(self.outgoing.len()));\n   207\t                    let acc = AcceptDecide {\n   208\t                        n: self.leader_state.n_leader,\n   209\t                        seq_num: self.leader_state.next_seq_num(pid),\n   210\t                        decided_idx,\n   211\t                        entries: accepted.entries.clone(),\n   212\t                    };\n   213\t                    self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   214\t                        from: self.pid,\n   215\t                        to: pid,\n   216\t                        msg: PaxosMsg::AcceptDecide(acc),\n   217\t                    }));\n   218\t                }\n   219\t            }\n   220\t        }\n   221\t    }\n   222\t\n   223\t    fn send_accept_stopsign(&mut self, to: NodeId, ss: StopSign, resend: bool) {\n   224\t        let seq_num = match resend {\n   225\t            true => self.leader_state.get_seq_num(to),\n   226\t            false => self.leader_state.next_seq_num(to),\n   227\t        };\n   228\t        let acc_ss = PaxosMsg::AcceptStopSign(AcceptStopSign {\n   229\t            seq_num,\n   230\t            n: self.leader_state.n_leader,\n   231\t            ss,\n   232\t        });\n   233\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   234\t            from: self.pid,\n   235\t            to,\n   236\t            msg: acc_ss,\n   237\t        }));\n   238\t    }\n   239\t\n   240\t    pub(crate) fn send_decide(&mut self, to: NodeId, decided_idx: usize, resend: bool) {\n   241\t        let seq_num = match resend {\n   242\t            true => self.leader_state.get_seq_num(to),\n   243\t            false => self.leader_state.next_seq_num(to),\n   244\t        };\n   245\t        let d = Decide {\n   246\t            n: self.leader_state.n_leader,\n   247\t            seq_num,\n   248\t            decided_idx,\n   249\t        };\n   250\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   251\t            from: self.pid,\n   252\t            to,\n   253\t            msg: PaxosMsg::Decide(d),\n   254\t        }));\n   255\t    }\n   256\t\n   257\t    fn handle_majority_promises(&mut self) {\n   258\t        let max_promise_sync = self.leader_state.take_max_promise_sync();\n   259\t        let decided_idx = self.leader_state.get_max_decided_idx();\n   260\t        let mut new_accepted_idx = self\n   261\t            .internal_storage\n   262\t            .sync_log(self.leader_state.n_leader, decided_idx, max_promise_sync)\n   263\t            .expect(WRITE_ERROR_MSG);\n   264\t        if !self.accepted_reconfiguration() {\n   265\t            if !self.buffered_proposals.is_empty() {\n   266\t                let entries = std::mem::take(&mut self.buffered_proposals);\n   267\t                new_accepted_idx = self\n   268\t                    .internal_storage\n   269\t                    .append_entries_without_batching(entries)\n   270\t                    .expect(WRITE_ERROR_MSG);\n   271\t            }\n   272\t            if let Some(ss) = self.buffered_stopsign.take() {\n   273\t                self.internal_storage\n   274\t                    .append_stopsign(ss)\n   275\t                    .expect(WRITE_ERROR_MSG);\n   276\t                new_accepted_idx = self.internal_storage.get_accepted_idx();\n   277\t            }\n   278\t        }\n   279\t        self.state = (Role::Leader, Phase::Accept);\n   280\t        self.leader_state\n   281\t            .set_accepted_idx(self.pid, new_accepted_idx);\n   282\t        for pid in self.leader_state.get_promised_followers() {\n   283\t            self.send_accsync(pid);\n   284\t        }\n   285\t    }\n   286\t\n   287\t    pub(crate) fn handle_promise_prepare(&mut self, prom: Promise<T>, from: NodeId) {\n   288\t        #[cfg(feature = \"logging\")]\n   289\t        debug!(\n   290\t            self.logger,\n   291\t            \"Handling promise from {} in Prepare phase\", from\n   292\t        );\n   293\t        if prom.n == self.leader_state.n_leader {\n   294\t            let received_majority = self.leader_state.set_promise(prom, from, true);\n   295\t            if received_majority {\n   296\t                self.handle_majority_promises();\n   297\t            }\n   298\t        }\n   299\t    }\n   300\t\n   301\t    pub(crate) fn handle_promise_accept(&mut self, prom: Promise<T>, from: NodeId) {\n   302\t        #[cfg(feature = \"logging\")]\n   303\t        {\n   304\t            let (r, p) = &self.state;\n   305\t            debug!(\n   306\t                self.logger,\n   307\t                \"Self role {:?}, phase {:?}. Incoming message Promise Accept from {}\", r, p, from\n   308\t            );\n   309\t        }\n   310\t        if prom.n == self.leader_state.n_leader {\n   311\t            self.leader_state.set_promise(prom, from, false);\n   312\t            self.send_accsync(from);\n   313\t        }\n   314\t    }\n   315\t\n   316\t    pub(crate) fn handle_accepted(&mut self, accepted: Accepted, from: NodeId) {\n   317\t        #[cfg(feature = \"logging\")]\n   318\t        trace!(\n   319\t            self.logger,\n   320\t            \"Got Accepted from {}, idx: {}, chosen_idx: {}, accepted: {:?}\",\n   321\t            from,\n   322\t            accepted.accepted_idx,\n   323\t            self.internal_storage.get_decided_idx(),\n   324\t            self.leader_state.accepted_indexes\n   325\t        );\n   326\t        if accepted.n == self.leader_state.n_leader && self.state == (Role::Leader, Phase::Accept) {\n   327\t            self.leader_state\n   328\t                .set_accepted_idx(from, accepted.accepted_idx);\n   329\t            if accepted.accepted_idx > self.internal_storage.get_decided_idx()\n   330\t                && self.leader_state.is_chosen(accepted.accepted_idx)\n   331\t            {\n   332\t                let decided_idx = accepted.accepted_idx;\n   333\t                self.internal_storage\n   334\t                    .set_decided_idx(decided_idx)\n   335\t                    .expect(WRITE_ERROR_MSG);\n   336\t                for pid in self.leader_state.get_promised_followers() {\n   337\t                    let latest_accdec = self.get_latest_accdec_message(pid);\n   338\t                    match latest_accdec {\n   339\t                        Some(accdec) => accdec.decided_idx = decided_idx,\n   340\t                        None => self.send_decide(pid, decided_idx, false),\n   341\t                    }\n   342\t                }\n   343\t            }\n   344\t        }\n   345\t    }\n   346\t\n   347\t    fn get_latest_accdec_message(&mut self, to: NodeId) -> Option<&mut AcceptDecide<T>> {\n   348\t        if let Some((bal, outgoing_idx)) = self.leader_state.get_latest_accept_meta(to) {\n   349\t            if bal == self.leader_state.n_leader {\n   350\t                if let Message::SequencePaxos(PaxosMessage {\n   351\t                    msg: PaxosMsg::AcceptDecide(accdec),\n   352\t                    ..\n   353\t                }) = self.outgoing.get_mut(outgoing_idx).unwrap()\n   354\t                {\n   355\t                    return Some(accdec);\n   356\t                } else {\n   357\t                    #[cfg(feature = \"logging\")]\n   358\t                    debug!(self.logger, \"Cached idx is not an AcceptedDecide!\");\n   359\t                }\n   360\t            }\n   361\t        }\n   362\t        None\n   363\t    }\n   364\t\n   365\t    pub(crate) fn handle_notaccepted(&mut self, not_acc: NotAccepted, from: NodeId) {\n   366\t        if self.state.0 == Role::Leader && self.leader_state.n_leader < not_acc.n {\n   367\t            self.leader_state.lost_promise(from);\n   368\t        }\n   369\t    }\n   370\t\n   371\t    pub(crate) fn resend_messages_leader(&mut self) {\n   372\t        match self.state.1 {\n   373\t            Phase::Prepare => {\n   374\t                // Resend Prepare\n   375\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   376\t                for peer in preparable_peers {\n   377\t                    self.send_prepare(peer);\n   378\t                }\n   379\t            }\n   380\t            Phase::Accept => {\n   381\t                // Resend AcceptStopSign or StopSign's decide\n   382\t                if let Some(ss) = self.internal_storage.get_stopsign() {\n   383\t                    let decided_idx = self.internal_storage.get_decided_idx();\n   384\t                    for follower in self.leader_state.get_promised_followers() {\n   385\t                        if self.internal_storage.stopsign_is_decided() {\n   386\t                            self.send_decide(follower, decided_idx, true);\n   387\t                        } else if self.leader_state.get_accepted_idx(follower)\n   388\t                            != self.internal_storage.get_accepted_idx()\n   389\t                        {\n   390\t                            self.send_accept_stopsign(follower, ss.clone(), true);\n   391\t                        }\n   392\t                    }\n   393\t                }\n   394\t                // Resend Prepare\n   395\t                let preparable_peers = self.leader_state.get_preparable_peers(&self.peers);\n   396\t                for peer in preparable_peers {\n   397\t                    self.send_prepare(peer);\n   398\t                }\n   399\t            }\n   400\t            Phase::Recover => (),\n   401\t            Phase::None => (),\n   402\t        }\n   403\t    }\n   404\t\n   405\t    pub(crate) fn flush_batch_leader(&mut self) {\n   406\t        let accepted_metadata = self\n   407\t            .internal_storage\n   408\t            .flush_batch_and_get_entries()\n   409\t            .expect(WRITE_ERROR_MSG);\n   410\t        if let Some(metadata) = accepted_metadata {\n   411\t            self.leader_state\n   412\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   413\t            self.send_acceptdecide(metadata);\n   414\t        }\n   415\t    }\n   416\t}\n","exit_code":0,"status":"completed"}}
