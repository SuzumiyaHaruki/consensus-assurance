{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source && cat -n omnipaxos/tests/batching_test.rs && sed -n '1,80p' omnipaxos/tests/recovery_test.rs\"","aggregated_output":"     1\tpub mod utils;\n     2\t\n     3\tuse kompact::prelude::{promise, Ask, FutureCollection};\n     4\tuse omnipaxos::ballot_leader_election::Ballot;\n     5\tuse serial_test::serial;\n     6\tuse std::{thread, time::Duration};\n     7\tuse utils::{TestConfig, TestSystem};\n     8\t\n     9\t/// Test case for batching.\n    10\t#[test]\n    11\t#[serial]\n    12\tfn batching_test() {\n    13\t    let wait_time_between_propose = Duration::from_millis(2);\n    14\t\n    15\t    let cfg = TestConfig::load(\"batching_test\").expect(\"Test config loaded\");\n    16\t    let mut sys = TestSystem::with(cfg);\n    17\t    let first_node = sys.nodes.get(&1).unwrap();\n    18\t    let (kprom, kfuture) = promise::<Ballot>();\n    19\t    first_node.on_definition(|x| x.election_futures.push(Ask::new(kprom, ())));\n    20\t    sys.start_all_nodes();\n    21\t    // Wait for initial leader to become elected. Note: needed so that initial propsals don't get\n    22\t    // bunched and throw off alignment with cfg.num_proposals.\n    23\t    let _leader_id = kfuture\n    24\t        .wait_timeout(cfg.wait_timeout)\n    25\t        .expect(\"No leader has been elected in the allocated time!\")\n    26\t        .pid;\n    27\t\n    28\t    let mut futures = vec![];\n    29\t    let mut last_decided_idx = 0;\n    30\t    let proposals = utils::create_proposals(1, cfg.num_proposals);\n    31\t    for v in proposals {\n    32\t        let (kprom, kfuture) = promise::<()>();\n    33\t        first_node.on_definition(|x| {\n    34\t            x.insert_decided_future(Ask::new(kprom, v.clone()));\n    35\t            x.paxos.append(v.clone()).expect(\"Failed to append\");\n    36\t        });\n    37\t        futures.push(kfuture);\n    38\t        thread::sleep(wait_time_between_propose);\n    39\t        // check batching\n    40\t        first_node.on_definition(|x| {\n    41\t            let decided_idx = x.paxos.get_decided_idx();\n    42\t            check_batching(decided_idx, last_decided_idx, cfg.batch_size);\n    43\t            last_decided_idx = decided_idx;\n    44\t        });\n    45\t    }\n    46\t\n    47\t    match FutureCollection::collect_with_timeout::<Vec<_>>(futures, cfg.wait_timeout) {\n    48\t        Ok(_) => {}\n    49\t        Err(e) => panic!(\"Error on collecting futures of decided proposals: {}\", e),\n    50\t    }\n    51\t    sys.shutdown();\n    52\t}\n    53\t\n    54\tfn check_batching(decided_idx: usize, last_decided_idx: usize, batch_size: usize) {\n    55\t    let idx_diff = decided_idx - last_decided_idx;\n    56\t    if idx_diff != 0 {\n    57\t        assert!(decided_idx - last_decided_idx >= batch_size);\n    58\t    }\n    59\t}\npub mod utils;\n\nuse kompact::prelude::{promise, Ask, FutureCollection, KFuture};\nuse omnipaxos::util::{LogEntry, NodeId};\nuse serial_test::serial;\nuse std::{thread, time::Duration};\nuse utils::{verification::verify_log, StorageType, TestConfig, TestSystem, Value};\n\nconst SLEEP_TIMEOUT: Duration = Duration::from_secs(1);\n\n#[test]\n#[serial]\n#[ignore]\nfn leader_fail_follower_propose_test() {\n    let cfg = TestConfig::load(\"recovery_test\").expect(\"Test config loaded\");\n    let mut sys = TestSystem::with(cfg);\n    sys.start_all_nodes();\n\n    let proposals: Vec<Value> = (1..=cfg.num_proposals).map(Value::with_id).collect();\n    let initial_proposals = proposals[0..(cfg.num_proposals / 2) as usize].to_vec();\n    sys.make_proposals(1, initial_proposals, cfg.wait_timeout);\n    let leader = sys.get_elected_leader(1, cfg.wait_timeout);\n    let follower = (1..=cfg.num_nodes as NodeId)\n        .find(|x| *x != leader)\n        .expect(\"No followers found!\");\n\n    kill_and_recover_node(&mut sys, &cfg, leader);\n    check_last_proposals(follower, leader, &sys, &cfg);\n\n    thread::sleep(SLEEP_TIMEOUT);\n\n    let recovery_px = sys\n        .nodes\n        .get(&leader)\n        .expect(\"No SequencePaxos component found\");\n    let read_log: Vec<LogEntry<Value>> = recovery_px.on_definition(|x| x.read_decided_log());\n\n    verify_log(read_log, proposals);\n\n    println!(\"Pass leader_fail_follower_propose!\");\n    sys.shutdown();\n}\n\n#[test]\n#[serial]\n#[ignore]\nfn leader_fail_leader_propose_test() {\n    let cfg = TestConfig::load(\"recovery_test\").expect(\"Test config loaded\");\n    let mut sys = TestSystem::with(cfg);\n    sys.start_all_nodes();\n\n    let proposals: Vec<Value> = (1..=cfg.num_proposals).map(Value::with_id).collect();\n    let initial_proposals = proposals[0..(cfg.num_proposals / 2) as usize].to_vec();\n    sys.make_proposals(1, initial_proposals, cfg.wait_timeout);\n    let leader = sys.get_elected_leader(1, cfg.wait_timeout);\n\n    kill_and_recover_node(&mut sys, &cfg, leader);\n    check_last_proposals(leader, leader, &sys, &cfg);\n\n    thread::sleep(SLEEP_TIMEOUT);\n\n    let recovery_px = sys\n        .nodes\n        .get(&leader)\n        .expect(\"No SequencePaxos component found\");\n    let read_log: Vec<LogEntry<Value>> = recovery_px.on_definition(|x| x.read_decided_log());\n\n    verify_log(read_log, proposals);\n\n    println!(\"Pass leader_fail_leader_propose!\");\n    sys.shutdown();\n}\n\n#[test]\n#[serial]\n#[ignore]\nfn follower_fail_leader_propose_test() {\n    let cfg = TestConfig::load(\"recovery_test\").expect(\"Test config loaded\");\n    let mut sys = TestSystem::with(cfg);\n    sys.start_all_nodes();\n","exit_code":0,"status":"completed"}}
