{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/agent-source/omnipaxos/tests && cat -n forward_proposal_test.rs && sed -n '1,60p' flexible_quorum_test.rs && ls /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/target-support\"","aggregated_output":"     1\tpub mod utils;\n     2\t\n     3\tuse kompact::prelude::{promise, Ask};\n     4\tuse omnipaxos::{ballot_leader_election::Ballot, util::NodeId};\n     5\tuse rand::Rng;\n     6\tuse serial_test::serial;\n     7\tuse utils::{TestConfig, TestSystem, Value};\n     8\t\n     9\t/// Verifies if the follower nodes forwards the proposal message to a leader\n    10\t/// so it can get decided.\n    11\t#[test]\n    12\t#[serial]\n    13\tfn forward_proposal_test() {\n    14\t    let cfg = TestConfig::load(\"proposal_test\").expect(\"Test config loaded\");\n    15\t    let mut sys = TestSystem::with(cfg);\n    16\t\n    17\t    let first_node = sys.nodes.get(&1).unwrap();\n    18\t    let (kprom_ble, kfuture_ble) = promise::<Ballot>();\n    19\t    first_node.on_definition(|x| x.election_futures.push(Ask::new(kprom_ble, ())));\n    20\t\n    21\t    sys.start_all_nodes();\n    22\t\n    23\t    let elected_leader = kfuture_ble\n    24\t        .wait_timeout(cfg.wait_timeout)\n    25\t        .expect(\"No leader has been elected in the allocated time!\");\n    26\t    println!(\"elected: {:?}\", elected_leader);\n    27\t\n    28\t    let mut proposal_node: NodeId;\n    29\t    loop {\n    30\t        proposal_node = rand::thread_rng().gen_range(1..=cfg.num_nodes as NodeId);\n    31\t\n    32\t        if proposal_node != elected_leader.pid {\n    33\t            break;\n    34\t        }\n    35\t    }\n    36\t\n    37\t    let px = sys.nodes.get(&proposal_node).unwrap();\n    38\t    let v = Value::with_id(proposal_node);\n    39\t    let (kprom, kfuture) = promise();\n    40\t    px.on_definition(|x| {\n    41\t        x.insert_decided_future(Ask::new(kprom, v.clone()));\n    42\t        x.paxos.append(v.clone()).expect(\"Failed to call Append\");\n    43\t    });\n    44\t\n    45\t    kfuture\n    46\t        .wait_timeout(cfg.wait_timeout)\n    47\t        .expect(\"The message was not proposed in the allocated time!\");\n    48\t\n    49\t    println!(\"Pass forward_proposal\");\n    50\t    sys.shutdown();\n    51\t}\npub mod utils;\n\nuse omnipaxos::util::NodeId;\nuse serial_test::serial;\nuse std::thread;\nuse utils::{verification::verify_log, TestConfig, TestSystem, Value};\n\n/// Verifies that an OmniPaxos cluster with a write quorum size of Q can still make\n/// progress with Q-1 failures, including leader failure.\n#[test]\n#[serial]\nfn flexible_quorum_prepare_phase_test() {\n    // Start Kompact system\n    let cfg = TestConfig::load(\"flexible_quorum_test\").expect(\"Test config couldn't be loaded\");\n    let mut sys = TestSystem::with(cfg);\n    sys.start_all_nodes();\n\n    let initial_proposals = (0..cfg.num_proposals / 2).map(Value::with_id).collect();\n    let last_proposals: Vec<Value> = ((cfg.num_proposals / 2)..cfg.num_proposals)\n        .map(Value::with_id)\n        .collect();\n    let expected_log: Vec<Value> = (0..cfg.num_proposals).map(Value::with_id).collect();\n\n    // Propose some initial values\n    sys.make_proposals(2, initial_proposals, cfg.wait_timeout);\n    let leader_id = sys.get_elected_leader(1, cfg.wait_timeout);\n\n    // Kill maximum number of nodes (including leader) such that cluster can still function\n    let maximum_tolerable_follower_failures = cfg.flexible_quorum.unwrap().1 - 1;\n    let faulty_followers = (1..=cfg.num_nodes as NodeId)\n        .filter(|id| *id != leader_id)\n        .take(maximum_tolerable_follower_failures - 1);\n    for node_id in faulty_followers {\n        sys.kill_node(node_id);\n    }\n    sys.kill_node(leader_id);\n\n    // Wait for next leader to get elected\n    thread::sleep(10 * cfg.election_timeout);\n\n    // Make some propsals\n    let still_alive_node_id = sys.nodes.keys().next().unwrap();\n    let still_alive_node = sys.nodes.get(still_alive_node_id).unwrap();\n    sys.make_proposals(*still_alive_node_id, last_proposals, cfg.wait_timeout);\n\n    // Verify log\n    let nodes_log = still_alive_node.on_definition(|x| x.read_decided_log());\n    verify_log(nodes_log, expected_log);\n}\n\n/// Verifies that an OmniPaxos cluster with N nodes and a write quorum size of Q can still make\n/// progress with N - Q failures so long as nodes remain in the accept phase (leader doesn't fail).\n#[test]\n#[serial]\nfn flexible_quorum_accept_phase_test() {\n    // Start Kompact system\n    let cfg = TestConfig::load(\"flexible_quorum_test\").expect(\"Test config couldn't be loaded\");\n    let mut sys = TestSystem::with(cfg);\n    sys.start_all_nodes();\n\nls: cannot access '/home/nitro/Desktop/consensus-assurance/runs/2026-10-16_09-22-17-omnipaxos-real-run/target-support': No such file or directory\n","exit_code":2,"status":"failed"}}
