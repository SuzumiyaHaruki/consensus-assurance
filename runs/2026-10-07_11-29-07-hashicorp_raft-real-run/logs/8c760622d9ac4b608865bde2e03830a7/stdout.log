\"Symbol\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"material_id\",\n  \"start_line\",\n  \"end_line\",\n  \"symbol\"\n ],\n \"title\": \"CodeAnchor\",\n \"type\": \"object\"\n}\n===== ClaimDraft\n{\n \"additionalProperties\": false,\n \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n \"properties\": {\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"kind\": {\n   \"enum\": [\n    \"obligation\",\n    \"assumption\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"concern\": {\n   \"default\": \"implementation_semantics\",\n   \"enum\": [\n    \"consensus_safety\",\n    \"bounded_liveness\",\n    \"implementation_semantics\"\n   ],\n   \"title\": \"Concern\",\n   \"type\": \"string\"\n  },\n  \"description\": {\n   \"description\": \"Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability\",\n   \"title\": \"Description\",\n   \"type\": \"string\"\n  },\n  \"source_ids\": {\n   \"description\": \"Located materials; file kinds do not establish normative authority\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Source Ids\",\n   \"type\": \"array\"\n  },\n  \"scope\": {\n   \"$ref\": \"#/$defs/Scope\"\n  },\n  \"pending\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Pending\",\n   \"type\": \"array\"\n  },\n  \"grounding\": {\n   \"$ref\": \"#/$defs/Grounding\",\n   \"default\": {\n    \"source_ids\": [],\n    \"expectation_ids\": [],\n    \"binding_ids\": [],\n    \"derivation\": \"\",\n    \"applicability\": \"\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": []\n   }\n  }\n },\n \"required\": [\n  \"id\",\n  \"kind\",\n  \"description\",\n  \"source_ids\",\n  \"scope\",\n  \"pending\"\n ],\n \"title\": \"ClaimDraft\",\n \"type\": \"object\"\n}\n===== AuditQuestion\n{\n \"additionalProperties\": false,\n \"description\": \"Sourced investigation of requirements, protections and history; these may remain unknown.\",\n \"properties\": {\n  \"audit_spec_version\": {\n   \"anyOf\": [\n    {\n     \"minimum\": 1,\n     \"type\": \"integer\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Audit Spec Version\"\n  },\n  \"disposition\": {\n   \"anyOf\": [\n    {\n     \"enum\": [\n      \"explained_by_existing_mechanism\",\n      \"concrete_suspicion\",\n      \"needs_specific_evidence\",\n      \"ready_for_check\"\n     ],\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Disposition\"\n  },\n  \"preferred_check\": {\n   \"anyOf\": [\n    {\n     \"enum\": [\n      \"source_review\",\n      \"direct_test\",\n      \"controlled_schedule\"\n     ],\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Preferred Check\"\n  },\n  \"question\": {\n   \"title\": \"Question\",\n   \"type\": \"string\"\n  },\n  \"importance\": {\n   \"title\": \"Importance\",\n   \"type\": \"string\"\n  },\n  \"source_ids\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Source Ids\",\n   \"type\": \"array\"\n  },\n  \"participants\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Participants\",\n   \"type\": \"array\"\n  },\n  \"objects\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Objects\",\n   \"type\": \"array\"\n  },\n  \"contexts\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Contexts\",\n   \"type\": \"array\"\n  },\n  \"event_paths\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Event Paths\",\n   \"type\": \"array\"\n  },\n  \"activity_classes\": {\n   \"default\": [],\n   \"items\": {\n    \"enum\": [\n     \"A1\",\n     \"A2\",\n     \"A3\",\n     \"A4\",\n     \"A5\",\n     \"A6\",\n     \"A7\"\n    ],\n    \"type\": \"string\"\n   },\n   \"title\": \"Activity Classes\",\n   \"type\": \"array\"\n  },\n  \"behavior_ids\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Behavior Ids\",\n   \"type\": \"array\"\n  },\n  \"fact_ids\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Fact Ids\",\n   \"type\": \"array\"\n  },\n  \"supporting_behavior_ids\": {\n   \"additionalProperties\": {\n    \"type\": \"string\"\n   },\n   \"description\": \"Behavior ID to sourced prehistory, context or consequence support; not a direct principal Fact edge\",\n   \"title\": \"Supporting Behavior Ids\",\n   \"type\": \"object\"\n  },\n  \"obligation_relation_kind\": {\n   \"anyOf\": [\n    {\n    \n===== CandidateSubmission\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"rationale\": {\n   \"minLength\": 1,\n   \"title\": \"Rationale\",\n   \"type\": \"string\"\n  },\n  \"sources\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/SourceRange\"\n   },\n   \"title\": \"Sources\",\n   \"type\": \"array\"\n  },\n  \"feedback\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/ResearchFeedback\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"repair_of\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n   \"title\": \"Repair Of\"\n  },\n  \"map_path\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Map Path\"\n  },\n  \"map_changes\": {\n   \"additionalProperties\": {\n    \"$ref\": \"#/$defs/UnderstandingChange\"\n   },\n   \"default\": {},\n   \"title\": \"Map Changes\",\n   \"type\": \"object\"\n  },\n  \"reconnect_questions\": {\n   \"additionalProperties\": {\n    \"$ref\": \"#/$defs/AuditQuestion\"\n   },\n   \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n   \"title\": \"Reconnect Questions\",\n   \"type\": \"object\"\n  },\n  \"action\": {\n   \"enum\": [\n    \"continue\",\n    \"pause\",\n    \"explained\",\n    \"obligation\"\n   ],\n   \"title\": \"Action\",\n   \"type\": \"string\"\n  },\n  \"candidate_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Candidate Id\"\n  },\n  \"parent_candidate_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Parent Candidate Id\"\n  },\n  \"question\": {\n   \"$ref\": \"#/$defs/AuditQuestion\"\n  },\n  \"resume_conditions\": {\n   \"default\": [],\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Resume Conditions\",\n   \"type\": \"array\"\n  },\n  \"result_implications\": {\n   \"additionalProperties\": {\n    \"type\": \"string\"\n   },\n   \"default\": {},\n   \"propertyNames\": {\n    \"enum\": [\n     \"holds\",\n     \"violated\",\n     \"incomplete\"\n    ]\n   },\n   \"title\": \"Result Implications\",\n   \"type\": \"object\"\n  },\n  \"obligation\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/ClaimDraft\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"bindings\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/BindingDraft\"\n   },\n   \"title\": \"Bindings\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"rationale\",\n  \"ac\n","exit_code":0,"status":"completed"}}
