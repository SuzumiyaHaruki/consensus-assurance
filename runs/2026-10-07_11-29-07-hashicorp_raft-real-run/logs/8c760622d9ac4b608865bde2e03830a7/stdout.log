ore_regions\": [\n      {\n        \"activity\": \"A1\",\n        \"entries\": [],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      }\n    ]\n  },\n  \"capacity\": {\n    \"remaining\": {\n      \"agent_calls\": 119,\n      \"experiments\": 36,\n      \"audit_units\": 12,\n      \"semantic_reviews\": 24,\n      \"revisions\": 12\n    },\n    \"remaining_seconds\": 7198.766001607,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  },\n  \"conclusions\": [],\n  \"costs\": {\n    \"agent_calls\": 1,\n    \"agent_seconds\": 0,\n    \"rejected_calls\": 0,\n    \"rejected_call_seconds\": 0,\n    \"formal_executions\": 0,\n    \"formal_execution_seconds\": 0,\n    \"target_action_cost\": {\n      \"known_seconds\": 0,\n      \"unrecorded_check_ids\": [],\n      \"process_unrecorded_check_ids\": []\n    },\n    \"elapsed_seconds\": 1.2339983929996379,\n    \"interpretation\": \"formal_execution_seconds is controlled target process time (checks and explorations); target_action_cost includes preparation only where recorded. Parent actions and child steps are not added together. Rejected calls may contain useful investigation; wall time is not token cost\"\n  },\n  \"map_handoffs\": [],\n  \"handoffs\": [],\n  \"pending_work\": [],\n  \"current\": {},\n  \"latest_decision\": null,\n  \"stop\": {},\n  \"stop_reason\": \"Not started\",\n  \"explorations\": [],\n  \"review_issues\": [],\n  \"run_id\": \"ac4c8a15dfd040f0b21cb41d37f4208e\",\n  \"snapshot_id\": \"98204d8f4d524950a17a0bf6848f6281\",\n  \"elapsed_seconds\": 1.2339983929996379,\n  \"source_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/agent-source\",\n  \"draft_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/draft\",\n  \"state_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/state.json\",\n  \"product_schemas\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/product-schemas.json\",\n  \"submission_schema\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/submission.schema.json\",\n  \"method_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/audit-method.md\",\n  \"build_inputs\": [],\n  \"directed_question\": null,\n  \"tools\": {\n    \"agent\": \"codex-cli 0.155.0-alpha.16\",\n    \"implementation\": \"go version go1.23.5 linux/amd64\"\n  },\n  \"implementation\": {\n    \"name\": \"go_module\",\n    \"harness_kind\": \"go_test\",\n    \"default_execution_package\": \".\",\n    \"harness_filename\": \"assurance_generated_test.go\",\n    \"instructions\": \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\",\n    \"support_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/target-support\"\n  },\n  \"validation\": {\n    \"command\": [\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python\",\n      \"-I\",\n      \"-B\",\n      \"-c\",\n      \"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\",\n      \"validate\",\n      \"--run\",\n      \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run\",\n      \"--submission\"