"heartbeat timeout reached, starting election\", \"last-leader-addr\", lastLeaderAddr, \"last-leader-id\", lastLeaderID)\n244: \t\t\t\t\tr.setState(Candidate)\n245: \t\t\t\t\treturn\n246: \t\t\t\t} else if !didWarn {\n247: \t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, not part of a stable configuration or a non-voter, not triggering a leader election\")\n248: \t\t\t\t\tdidWarn = true\n--- 325-350\n325: \t\t\tr.processRPC(rpc)\n326: \t\tcase preVote := <-prevoteCh:\n327: \t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n328: \t\t\tr.mainThreadSaturation.working()\n329: \t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n330: \t\t\t// Check if the term is greater than ours, bail\n331: \t\t\tif preVote.Term > term {\n332: \t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n333: \t\t\t\tr.setState(Follower)\n334: \t\t\t\tr.setCurrentTerm(preVote.Term)\n335: \t\t\t\treturn\n336: \t\t\t}\n337: \n338: \t\t\t// Check if the preVote is granted\n339: \t\t\tif preVote.Granted {\n340: \t\t\t\tpreVoteGrantedVotes++\n341: \t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n342: \t\t\t} else {\n343: \t\t\t\tpreVoteRefusedVotes++\n344: \t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n345: \t\t\t}\n346: \n347: \t\t\t// Check if we've won the pre-vote and proceed to election if so\n348: \t\t\tif preVoteGrantedVotes >= votesNeeded {\n349: \t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n350: \t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n--- 1880-1912\n1880: \t// Separately track the progress of streaming a snapshot over the network\n1881: \t// bec