r.setCurrentTerm(req.Term)\n1669: \n1670: \t\tresp.Term = req.Term\n1671: \t}\n1672: \n1673: \t// if we get a request for vote from a nonVoter  and the request term is higher,\n1674: \t// step down and update term, but reject the vote request\n1675: \t// This could happen when a node, previously voter, is converted to non-voter\n1676: \t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n1677: \t// More details about that in https://github.com/hashicorp/raft/pull/526\n1678: \tif len(req.ID) > 0 {\n1679: \t\tcandidateID := ServerID(req.ID)\n1680: \t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n1681: \t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n1682: \t\t\treturn\n1683: \t\t}\n1684: \t}\n1685: \t// Check if we have voted yet\n1686: \tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n1687: \tif err != nil && err.Error() != \"not found\" {\n1688: \t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n1689: \t\treturn\n1690: \t}\n1691: \tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n1692: \tif err != nil && err.Error() != \"not found\" {\n1693: \t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n1694: \t\treturn\n1695: \t}\n1696: \n1697: \t// Check if we've voted in this election before\n1698: \tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n1699: \t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n1700: \t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n--- 363-390\n363: \t\tcase vote := <-voteCh:\n364: \t\t\tr.mainThreadSaturation.working()\n365: \t\t\t// Check if the term is greater than ours, bail\n366: \t\t\tif vote.Term > r.getCurrentTerm() {\n367: \t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n368: \t\t\t\tr.setState(Follower)\n369: \t\t\t\tr.setCurrentTerm(vote.Term)\n370: \t\t\t\treturn\n371: \t\t\t}\n372: \n373: \t\t\t// Check if the vote is granted\n374: \t\t\tif vote.Granted {\n375: \t\t\t\tgrantedVotes++\n376: \t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n377: \t\t\t}\n378: \n379: \t\t\t// Check if we've become the leader\n380: \t\t\tif grantedVotes >= votesNeeded {\n381: \t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n382: \t\t\t\tr.setState(Leader)\n383: \t\t\t\tr.setLeader(r.localAddr, r.localID)\n384: \t\t\t\treturn\n385: \t\t\t}\n386: \t\tcase c := <-r.configurationChangeCh:\n387: \t\t\tr.mainThreadSaturation.working()\n388: \t\t\t// Reject any operations since we are not the leader\n389: \t\t\tc.respond(ErrNotLeader)\n390: \n--- 785-800\n785: \t\tcase <-r.leaderState.commitCh:\n786: \t\t\tr.mainThreadSaturation.working()\n787: \t\t\t// Process the newly committed entries\n788: \t\t\toldCommitIndex := r.getCommitIndex()\n789: \t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n790: \t\t\tr.setCommitIndex(commitIndex)\n791: \n792: \t\t\t// New configuration has been committed, set it as the committed\n793: \t\t\t// value.\n794: \t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n795: \t\t\t\tr.configurations.latestIndex <= commitIndex {\n796: \t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n797: \t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n798: \t\t\t\t\tstepDown = true\n799: \t\t\t\t}\n800: \t\t\t}\n--- 1565-1580\n1565: \t// Update the commit index\n1566: \tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n1567: \t\tstart := time.Now()\n1568: \t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n1569: \t\tr.setCommitIndex(idx)\n1570: \t\tif r.configurations.latestIndex <= idx {\n1571: \t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n1572: \t\t}\n1573: \t\tr.processLogs(idx, nil)\n1574: \t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n1575: \t}\n1576: \n1577: \t// Everything went well, set success\n1578: \tresp.Success = true\n1579: \tr.setLastContact()\n1580: }\n===== replication.go\n--- 653-665\n653: // successful AppendEntries RPC.\n654: // TODO: This isn't used during InstallSnapshot, but the code there is similar.\n655: func updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n656: \t// Mark any inflight logs as committed\n657: \tif logs := req.Entries; len(logs) > 0 {\n658: \t\tlast := logs[len(logs)-1]\n659: \t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n660: \t\ts.commitment.match(s.peer.ID, last.Index)\n661: \t}\n662: \n663: \t// Notify still leader\n664: \ts.notifyAll(true)\n665: }\n","exit_code":0,"status":"completed"}}
