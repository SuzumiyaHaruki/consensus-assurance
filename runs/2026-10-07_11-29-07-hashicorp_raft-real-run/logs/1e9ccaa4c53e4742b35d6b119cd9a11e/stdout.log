cability; numbers and status come from retained assessment\")\n212-    counterevidence: list[str] = []\n213-    limitations: list[str] = []\n214-    challenged_components: list[RepairComponent] = Field(default_factory=list,\n215-        description=\"Components requiring repair, distinct from the review aspect; revision_needed must name them\")\n216-\n217-\n218-class SemanticReview(Record):\n219-    id: str = Field(default_factory=uid)\n220-    task_id: str\n221-    check_id: str\n222-    target_versions: dict[str, int]\n223-    material_ids: list[str]\n224-    items: list[SemanticCheck]\n225-    origin: Literal[\"agent\", \"mock\"]\n226-    unit_id: str | None = None\n227-    unit_version: int | None = None\n228-    resolves_issue_ids: list[str] = []\n229-\n230-\n231:class ReviewIssue(Record):\n232-    conditions: list[dict[str, Any]] = []\n233-    resolution_basis: dict = {}\n234-    prior_review_ids: list[str] = []\n235-    parent_issue_id: str | None = None\n236-    challenged_components: list[RepairComponent] = []\n237-    id: str = Field(default_factory=uid)\n238-    review_id: str\n239-    target_id: str\n240-    target_version: int\n241-    aspect: str\n242-    source_ids: list[str]\n243-    explanation: str\n244-    disposition: Literal[\"reading\", \"revision\", \"investigation\", \"blocked\"]\n245-    reason: str\n246-    resolved_by: str | None = None\n247-    resolution_checks: list[str] = []\n248-\n249-\n250-class ExecutionStatus(str, Enum):\n251-    NOT_SCHEDULED = \"not_scheduled\"\n252-    RUNNING = \"running\"\n253-    COMPLETED = \"completed\"\n254-    ERROR = \"error\"\n255-    TIMEOUT = \"timeout\"\n256-    TOOL_MISSING = \"tool_missing\"\n257-    LOGIN_REQUIRED = \"login_required\"\n258-    QUOTA_EXHAUSTED = \"quota_exhausted\"\n259-    CANCELLED = \"cancelled\"\n260-\n261-\n","exit_code":0,"status":"completed"}}
