{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'RUN=/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run\nS=$RUN/draft/tmp/scratch-c\nmkdir -p \"$S\"\ncp -r \"$RUN/agent-source\" \"$S/target\"\ncat > \"$S/target/assurance_probe_test.go\" <<'\"'EOF'\npackage raft\n\nimport (\n\t\\\"fmt\\\"\n\t\\\"io\\\"\n\t\\\"testing\\\"\n\t\\\"time\\\"\n)\n\ntype probeFSM struct{}\n\nfunc (probeFSM) Apply(*Log) interface{}            { return nil }\nfunc (probeFSM) Snapshot() (FSMSnapshot, error)     { return probeSnap{}, nil }\nfunc (probeFSM) Restore(io.ReadCloser) error        { return nil }\n\ntype probeSnap struct{}\n\nfunc (probeSnap) Persist(s SnapshotSink) error { return s.Close() }\nfunc (probeSnap) Release()                     {}\n\nfunc TestAssuranceProbeShutdownVerify(t *testing.T) {\n\tconf := DefaultConfig()\n\tconf.LocalID = ServerID(\\\"n1\\\")\n\tconf.LogLevel = \\\"ERROR\\\"\n\t_, trans := NewInmemTransport(\\\"n1\\\")\n\tr, err := NewRaft(conf, probeFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), trans)\n\tif err \"'!= nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := r.Shutdown().Error(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar completedShutdown, completedOther int\n\tvar pending []*verifyFuture\n\tfor i := 0; i < 128; i++ {\n\t\tswitch v := r.VerifyLeader().(type) {\n\t\tcase errorFuture:\n\t\t\tif v.err == ErrRaftShutdown {\n\t\t\t\tcompletedShutdown++\n\t\t\t} else {\n\t\t\t\tcompletedOther++\n\t\t\t}\n\t\tcase *verifyFuture:\n\t\t\tpending = append(pending, v)\n\t\t}\n\t}\n\ttime.Sleep(200 * time.Millisecond)\n\tstillPending := 0\n\tcompletedLater := 0\n\tfor _, p := range pending {\n\t\tselect {\n\t\tcase <-p.errCh:\n\t\t\tcompletedLater++\n\t\tdefault:\n\t\t\tstillPending++\n\t\t}\n\t}\n\tfmt.Println(\"PROBE verify completed_shutdown=\", completedShutdown, \"other=\", completedOther,\n\t\t\"pending=\", len(pending), \"completed_later=\", completedLater, \"still_pending=\", stillPending)\n\n\t// Barrier on the default (unbuffered) apply channel.\n\tvar bCompleted int\n\tfor i := 0; i < 8; i++ {\n\t\tif f := r.Barrier(0); f.Error() == ErrRaftShutdown {\n\t\t\tbCompleted++\n\t\t}\n\t}\n\tfmt.Println(\"PROBE barrier completed_shutdown=\", bCompleted, \"of 8\")\n\n\t// Apply with a buffered apply channel, as the BatchApplyCh option permits.\n\tconf2 := DefaultConfig()\n\tconf2.LocalID = ServerID(\"n2\")\n\tconf2.LogLevel = \"ERROR\"\n\tconf2.BatchApplyCh = true\n\t_, trans2 := NewInmemTransport(\"n2\")\n\tr2, err := NewRaft(conf2, probeFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), trans2)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tr2.Shutdown().Error()\n\tvar aCompleted int\n\tvar aPending []*logFuture\n\tfor i := 0; i < 128; i++ {\n\t\tswitch v := r2.Apply([]byte(\"x\"), 0).(type) {\n\t\tcase errorFuture:\n\t\t\tif v.err == ErrRaftShutdown {\n\t\t\t\taCompleted++\n\t\t\t}\n\t\tcase *logFuture:\n\t\t\taPending = append(aPending, v)\n\t\t}\n\t}\n\ttime.Sleep(200 * time.Millisecond)\n\taStill := 0\n\tfor _, p := range aPending {\n\t\tselect {\n\t\tcase <-p.errCh:\n\t\tdefault:\n\t\t\taStill++\n\t\t}\n\t}\n\tfmt.Println(\"PROBE apply(batched) completed_shutdown=\", aCompleted, \"pending=\", len(aPending), \"still_pending=\", aStill)\n}\nEOF\ncd \"$S/target\"\nexport GOCACHE=$S/gocache GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local GOFLAGS=-mod=readonly GOWORK=off GOMODCACHE=/home/nitro/go/pkg/mod HOME=$S\nfor i in 1 2 3; do timeout 200 go test -count=1 -run '\"'\"'^TestAssuranceProbe'\"' . 2>&1 | grep -E \\\"PROBE|FAIL|ok \\\"; done\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
