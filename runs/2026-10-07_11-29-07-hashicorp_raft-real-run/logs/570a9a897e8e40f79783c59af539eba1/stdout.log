tring(),\n\t})\n}\nEOF\ncd \"$RUN/draft/tmp/scratch-j/target\"\nexport GOCACHE=$RUN/draft/tmp/scratch-j/gocache GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local GOFLAGS=-mod=readonly GOWORK=off GOMODCACHE=/home/nitro/go/pkg/mod HOME=$RUN/draft/tmp/scratch-j\nfor i in 1 2 3; do timeout 120 go test -json -count=1 -timeout=90s -run '\"'\"'^TestAssurance'\"' . 2>&1 | python3 -c \\\"\nimport sys,json\nfor line in sys.stdin:\n    line=line.strip()\n    try: o=json.loads(line)\n    except ValueError: continue\n    if not isinstance(o,dict): continue\n    out=o.get('Output','')\n    if 'CA_EVENT' in out: print(' ',out.rstrip()[:300])\n    if '--- ' in out or o.get('Action')=='fail': print(o.get('Action'),'|',out.rstrip()[:120])\n\\\"; done\"","aggregated_output":"  CA_EVENT {\"event\":\"configuration_established\",\"index\":1,\"log_last_index\":1,\"node\":\"n1\",\"op\":\"client-visible-configuration-index\"}\n  CA_EVENT {\"configuration_has_self\":true,\"event\":\"configuration_index_observed\",\"log_last_index\":1,\"node\":\"n1\",\"node_state\":\"Follower\",\"op\":\"client-visible-configuration-index\",\"reported_index\":0,\"servers\":1,\"stats_index\":\"0\"}\noutput | --- PASS: TestAssuranceConfigurationIndexReported (0.00s)\n  CA_EVENT {\"event\":\"configuration_established\",\"index\":1,\"log_last_index\":1,\"node\":\"n1\",\"op\":\"client-visible-configuration-index\"}\n  CA_EVENT {\"configuration_has_self\":true,\"event\":\"configuration_index_observed\",\"log_last_index\":1,\"node\":\"n1\",\"node_state\":\"Follower\",\"op\":\"client-visible-configuration-index\",\"reported_index\":0,\"servers\":1,\"stats_index\":\"0\"}\noutput | --- PASS: TestAssuranceConfigurationIndexReported (0.00s)\n  CA_EVENT {\"event\":\"configuration_established\",\"index\":1,\"log_last_index\":1,\"node\":\"n1\",\"op\":\"client-visible-configuration-index\"}\n  CA_EVENT {\"configuration_has_self\":true,\"event\":\"configuration_index_observed\",\"log_last_index\":1,\"node\":\"n1\",\"node_state\":\"Fol