{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_11-29-07-hashicorp_raft-real-run/draft && python3 - <<'PY'\nimport json, collections\nm=json.load(open('map-v4.json'), object_pairs_hook=collections.OrderedDict)\nm['version']=4\nfact=collections.OrderedDict([\n (\\\"id\\\",\\\"f-latest-configuration\\\"),\n (\\\"meaning\\\",\\\"The node's latest configuration is the set of servers and suffrages in effect for it, together with the log index at which that configuration was established: the leader writes it when it appends a configuration entry, and followers adopt it from the log or from an installed snapshot.\\\"),\n (\\\"identity\\\",{\\\"node\\\":\\\"local Raft instance\\\",\\\"configuration_index\\\":\\\"N\\\"}),\n (\\\"validity_context\\\",\\\"Holds from the moment the configuration is established until a later configuration entry replaces it; its index identifies where it was written and is the same index a snapshot records with the configuration.\\\"),\n (\\\"representation\\\",[\\\"configurations.latest and latestIndex on the main goroutine\\\",\\\"a copy in Raft.latestConfiguration for readers outside the main loop\\\",\\\"SnapshotMeta.ConfigurationIndex inside snapshots\\\"]),\n (\\\"durability\\\",\\\"carried in the log entry or snapshot that established it\\\"),\n (\\\"recovery\\\",\\\"rebuilt by NewRaft from the snapshot and the log scan, and by installSnapshot from the leader's snapshot\\\"),\n (\\\"source_ids\\\",[\\\"s-raft-append-config\\\",\\\"s-config-next\\\",\\\"s-api-newraft-config\\\",\\\"s-snapshot-take\\\"]),\n (\\\"unknowns\\\",[\\\"whether the client-visible configuration future reports the log index at which the configuration it returns was established\\\"]),\n])\n# insert the new fact before the last existing fact so derived indexes stay ordered with the behaviors\nfacts=m['facts']; facts.insert(len(facts)-1, fact)\nfor b in m['behaviors']:\n    if b['id'] in ('b-config-change','b-follower-append-entries'):\n        b['produces_fact_ids']=list(b.get('produces_fact_ids',[]))+['f-latest-configuration']\n    if b['id'] in ('b-client-apply-verify','b-commit-advance'):\n        b['consumes_fact_ids']=list(b.get('consumes_fact_ids',[]))+['f-latest-configuration']\nopen('map-v5.json','w').write(json.dumps(m, indent=2, ensure_ascii=False)+\\\"\\\\n\\\")\nprint('facts now', [f['id'] for f in facts])\nPY\npython3 -c \\\"\nimport json\nm=json.load(open('map-v5.json'))\nprint('version',m['version'])\nfor b in m['behaviors']:\n    if b['id'] in ('b-config-change','b-follower-append-entries','b-client-apply-verify','b-commit-advance'):\n        print(b['id'],'P',b.get('produces_fact_ids'),'C',b.get('consumes_fact_ids'))\nf=[x for x in m['facts'] if x['id']=='f-latest-configuration'][0]\nprint('new fact sources',f['source_ids'],'unknowns',f['unknowns'])\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
