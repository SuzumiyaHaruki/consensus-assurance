e\": \"string\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"semantic_changes\": {\n      \"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Semantic Changes\",\n      \"type\": \"array\"\n    },\n    \"prerequisites\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/EventRequirement\"\n      },\n      \"title\": \"Prerequisites\",\n      \"type\": \"array\"\n    },\n    \"legality\": {\n      \"$ref\": \"#/$defs/Grounding\",\n      \"default\": {\n        \"source_ids\": [],\n        \"expectation_ids\": [],\n        \"binding_ids\": [],\n        \"derivation\": \"\",\n        \"applicability\": \"\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      }\n    }\n  },\n  \"required\": [\n    \"kind\",\n    \"source\",\n    \"description\",\n    \"semantic_changes\"\n  ],\n  \"title\": \"Harness\",\n  \"type\": \"object\"\n}\nObservableProperty {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"checker_id\": {\n      \"title\": \"Checker Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"default\": \"event_assertion\",\n      \"enum\": [\n        \"event_assertion\",\n        \"event_implication\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"trigger\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"assertion\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"antecedent\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"identity_fields\": {\n      \"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a