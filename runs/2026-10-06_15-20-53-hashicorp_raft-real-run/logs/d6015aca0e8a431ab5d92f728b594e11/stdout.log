revLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n   634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n   635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n   636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n   637\t\n   638\t\tif !skipLegacy {\n   639\t\t\t// Duplicated information. Kept for backward compatibility.\n   640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n   641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n   642\t\t}\n   643\t}\n   644\t\n   645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n","exit_code":0,"status":"completed"}}
