   \"A4\",\n              \"A5\",\n              \"A6\",\n              \"A7\"\n            ]\n          },\n          \"title\": \"Cross Activity Effects\",\n          \"type\": \"object\"\n        },\n        \"existing_protections\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Existing Protections\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"unknowns\": {\n          \"description\": \"Unresolved implementation or interface relationships; check exclusions and execution progress belong to Scope/CheckRun\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"primary_activity\",\n        \"execution_owner\",\n        \"protocol_context\",\n        \"trigger\",\n        \"source_ids\"\n      ],\n      \"title\": \"Behavior\",\n      \"type\": \"object\"\n    },\n    \"CoreOverview\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"formation\": {\n          \"$ref\": \"#/$defs/CorePath\"\n        },\n        \"context\": {\n          \"$ref\": \"#/$defs/CorePath\"\n        },\n        \"connection\": {\n          \"$ref\": \"#/$defs/CorePath\"\n        },\n        \"open_details\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Open Details\",\n          \"type\": \"array\"\n        },\n        \"core_gaps\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Core Gaps\",\n          \"type\": \"array\"\n        },\n        \"status\": {\n          \"default\": \"incomplete\",\n          \"enum\": [\n            \"incomplete\",\n            \"usable\",\n            \"blocked\"\n          ],\n          \"title\": \"Status\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"rationale\"\n      ],\n      \"title\": \"CoreOverview\",\n      \"type\": \"object\"\n    },\n    \"CorePath\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"explanation\": {\n          \"default\": \"\",\n          \"title\": \"Explanation\",\n          \"type\": \"string\"\n        },\n        \"behavior_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Behavior Ids\",\n          \"type\": \"array\"\n        },\n        \"fact_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Fact Ids\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        }\n      },\n      \"title\": \"CorePath\",\n      \"type\": \"object\"\n    },\n    \"Fact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"meaning\": {\n          \"title\": \"Meaning\",\n          \"type\": \"string\"\n        },\n        \"identity\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Identity\",\n          \"type\": \"object\"\n        },\n        \"established_by\": {\n          \"description\": \"Derived from Behavior.produces_fact_ids; never infer an unread producer\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Established By\",\n          \"type\": \"array\",\n          \"x-controller-derived\": true\n        },\n        \"consumed_by\": {\n          \"description\": \"Derived from Behavior.consumes_fact_ids\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Consumed By\",\n          \"type\": \"array\",\n          \"x-controller-derived\": true\n        },\n        \"validity_context\": {\n          \"title\": \"Validity Context\",\n          \"type\": \"string\"\n        },\n        \"representation\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Representation\",\n          \"type\": \"array\"\n        },\n        \"invalidators\": {\n          \"description\": \"Existing Behavior IDs only. Unread events or suspected invalidators belong in unknowns.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Invalidators\",\n          \"type\": \"array\"\n        },\n        \"reinterpreters\": {\n          \"description\": \"Existing Behavior IDs only, not event descriptions or Activity IDs.\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Reinterpreters\",\n          \"type\": \"array\"\n        },\n        \"durability\": {\n          \"title\": \"Durability\",\n          \"type\": \"string\"\n        },\n        \"recovery\": {\n          \"title\": \"Recovery\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"unknowns\": {\n          \"description\": \"Unknown establishment, consumption or validity in this implementation; known weak guarantees belong to meaning/context/durability\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"meaning\",\n        \"identity\",\n        \"validity_context\",\n        \"representation\",\n        \"durability\",\n        \"recovery\",\n        \"source_ids\"\n      ],\n      \"title\": \"Fact\",\n      \"type\": \"object\"\n    },\n    \"Surface\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"entry_point\": {\n          \"title\": \"Entry Point\",\n          \"type\": \"string\"\n        },\n        \"disposition\": {\n          \"enum\": [\n            \"mapped\",\n            \"externalized\",\n            \"infrastructure\",\n            \"deferred\",\n            \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"\n          ],\n          \"title\": \"Disposition\",\n          \"type\": \"string\"\n        },\n        \"behavior_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Behavior Ids\",\n          \"type\": \"array\"\n        },\n        \"reason\": {\n          \"title\": \"Reason\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"high_consequence\": {\n          \"default\": false,\n          \"title\": \"High Consequence\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"entry_point\",\n        \"disposition\",\n        \"reason\"\n      ],\n      \"title\": \"Surface\",\n      \"type\": \"object\"\n    },\n    \"TargetProfile\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"system_boundary\": {\n          \"title\": \"System Boundary\",\n          \"type\": \"string\"\n        },\n        \"protocol_contexts\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Protocol Contexts\",\n          \"type\": \"array\"\n        },\n        \"external_interfaces\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"External Interfaces\",\n          \"type\": \"array\"\n        },\n        \"ownership\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Ownership\",\n          \"type\": \"array\"\n        },\n        \"selection_injection\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Selection Injection\",\n          \"type\": \"array\"\n        },\n        \"variants\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Variants\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"unknowns\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"system_boundary\"\n      ],\n      \"title\": \"TargetProfile\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"version\": {\n      \"default\": 1,\n      \"title\": \"Version\",\n      \"type\": \"integer\"\n    },\n    \"target_profile\": {\n      \"$ref\": \"#/$defs/TargetProfile\"\n    },\n    \"activities\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/Activity\"\n      },\n      \"maxItems\": 7,\n      \"title\": \"Activities\",\n      \"type\": \"array\"\n    },\n    \"behaviors\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Behavior\"\n      },\n      \"title\": \"Behaviors\",\n      \"type\": \"array\"\n    },\n    \"facts\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Fact\"\n      },\n      \"title\": \"Facts\",\n      \"type\": \"array\"\n    },\n    \"surfaces\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Surface\"\n      },\n      \"title\": \"Surfaces\",\n      \"type\": \"array\"\n    },\n    \"core_overview\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CoreOverview\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"target_profile\"\n  ],\n  \"title\": \"ConsensusAuditSpec\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
