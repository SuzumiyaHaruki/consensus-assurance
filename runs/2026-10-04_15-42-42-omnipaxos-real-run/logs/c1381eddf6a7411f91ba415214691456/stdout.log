       if p is None or p.kind not in {'event_assertion','event_implication'}:\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/direct_checks.py:55:        if (p.kind=='event_implication') != (p.antecedent is not None):\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/direct_checks.py:162:    if parsing:blockers.append('Event output contains incomplete or invalid CA_EVENT records')\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/observations.py:56:        if prop.kind == 'event_implication':\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/workflow/encoding.py:48:        if new[id].kind not in {'event_assertion','event_implication'}:\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/plugins/targets/hashicorp_raft/assurance_support_test.go:48:\tfmt.Println(\"CA_EVENT \" + string(raw))\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/core/proposals.py:76:    kind: Literal[\"event_assertion\", \"event_implication\"] = \"event_assertion\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/core/proposals.py:172:    observable_properties: list[ObservableProperty] = Field(min_length=1, description=\"Direct route supports event_assertion and event_implication. Correlate prerequisite fields by alias; observe prerequisites and results from the same legal history. Unsupported general temporal properties must remain an explicit limitation.\")\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/go_module.py:36:    harness_instructions = \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py:116:    \"\"\"Extract complete CA_EVENT lines, preserving runner-provided stream ownership.\"\"\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/experiment.py:121:    marker = \"CA_EVENT \"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/cargo.py:19:    harness_instructions = \"Write Rust #[test] integration tests using the captured crate's public API and existing dependencies. The controller fixes the workspace lock and tools, builds a neutral integration target once, and copies its compiler outputs into each private action. Only the generated test target runs, serially with --nocapture and --locked --offline. Emit complete CA_EVENT JSON lines. Helpers are workspace-relative; never replace manifests, locks, build scripts or Cargo configuration. No extra feature flags are added; original dev-dependencies can enable additional features. Consult build_inputs metadata and actual compiler-artifact records; declaration syntax does not establish active cfg branches or private-state reachability.\"\n/home/nitro/Desktop/consensus-assurance/src/consensus_assurance/adapters/runners/python.py:9:    harness_instructions = \"Use Python imports from the current isolated workspace and print CA_EVENT JSON containing actual returned values.\"\nuse core::{future::Future, time::Duration};\n\nuse super::traits::AsyncRuntime;\n\n/// [`AsyncRuntime`] impl backed by [`tokio`]. Enabled by the `tokio_runtime` feature.\npub struct TokioRuntime;\n\nimpl AsyncRuntime for TokioRuntime {\n    type JoinHandle = tokio::task::JoinHandle<()>;\n\n    fn spawn<F>(future: F) -> Self::JoinHandle\n    where\n        F: Future<Output = ()> + Send + 'static,\n    {\n        tokio::spawn(future)\n    }\n\n    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static {\n        tokio::time::sleep(duration)\n    }\n}\n135:    pub async fn append_notify(&self, entry: T) -> Result<usize, AppendError<T>> {\n143:    pub async fn append_notify_with_timeout(\n169:    pub async fn append(&self, entry: T) -> Result<(), RuntimeProposeErr<T>> {\n182:    pub async fn current_leader(&self) -> Option<(NodeId, bool)> {\n196:    pub async fn decided_idx(&self) -> usize {\n210:    pub async fn read_decided_suffix(&self, from: usize) -> Option<Vec<LogEntry<T>>> {\n224:    pub async fn reconfigure(\n245:    pub async fn try_become_leader(&self) {\n250:    pub async fn reconnected(&self, pid: NodeId) {\n271:    pub async fn subscribe_decided(&self, from: usize) -> async_channel::Receiver<LogEntry<T>> {\n289:    pub async fn handle_incoming(&self, m: Message<T>) {\n[package]\nname = \"omnipaxos_storage\"\nversion = \"0.2.2\"\nauthors = [\"Harald Ng <hng@kth.se>\"]\nedition = \"2021\"\ndescription = \"Storage implementations for OmniPaxos.\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/haraldng/omnipaxos\"\nhomepage = \"https://omnipaxos.com/\"\n\n[package.metadata.docs.rs]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n\n[dependencies]\nomnipaxos = { version = \"0.2.3\", path = \"../omnipaxos\", features = [\"serde\"] }\nserde = { version = \"1.0\", features = [\"derive\"], optional= true }\nbincode = { version = \"1.3.3\", optional = true }\nzerocopy = { version = \"0.6.1\", optional = true }\nrocksdb = { version = \"0.21.0\", optional = true }\n[profile.release]\nlto = true\n\n[features]\npersistent_storage = [\"dep:rocksdb\", \"dep:serde\", \"dep:bincode\", \"dep:zerocopy\"]\n","exit_code":0,"status":"completed"}}
