{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '35,145p;285,445p'; nl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '37,90p;179,196p;281,361p;455,523p'; nl -ba ../agent-source/omnipaxos/src/storage/mod.rs | sed -n '110,235p'; nl -ba ../agent-source/omnipaxos/src/util.rs | sed -n '414,480p'\"","aggregated_output":"    35\t    pub cluster_config: ClusterConfig,\n    36\t    pub server_config: ServerConfig,\n    37\t}\n    38\t\n    39\timpl OmniPaxosConfig {\n    40\t    /// Checks that all the fields of the cluster config are valid.\n    41\t    pub fn validate(&self) -> Result<(), ConfigError> {\n    42\t        self.cluster_config.validate()?;\n    43\t        self.server_config.validate()?;\n    44\t        valid_config!(\n    45\t            self.cluster_config.nodes.contains(&self.server_config.pid),\n    46\t            \"Nodes must include own server pid\"\n    47\t        );\n    48\t        Ok(())\n    49\t    }\n    50\t\n    51\t    /// Creates a new `OmniPaxosConfig` from a `toml` file.\n    52\t    #[cfg(feature = \"toml_config\")]\n    53\t    pub fn with_toml(file_path: &str) -> Result<Self, ConfigError> {\n    54\t        let config_file = fs::read_to_string(file_path)?;\n    55\t        let config: OmniPaxosConfig = toml::from_str(&config_file)?;\n    56\t        config.validate()?;\n    57\t        Ok(config)\n    58\t    }\n    59\t\n    60\t    /// Checks all configuration fields and returns the local OmniPaxos node if successful.\n    61\t    pub fn build<T, B>(self, storage: B) -> Result<OmniPaxos<T, B>, ConfigError>\n    62\t    where\n    63\t        T: Entry,\n    64\t        B: Storage<T>,\n    65\t    {\n    66\t        self.validate()?;\n    67\t        // Use stored ballot as initial BLE leader\n    68\t        let recovered_leader = storage\n    69\t            .get_promise()\n    70\t            .expect(\"storage error while trying to read promise\");\n    71\t        Ok(OmniPaxos {\n    72\t            ble: BallotLeaderElection::with(self.clone().into(), recovered_leader),\n    73\t            election_clock: LogicalClock::with(self.server_config.election_tick_timeout),\n    74\t            resend_message_clock: LogicalClock::with(\n    75\t                self.server_config.resend_message_tick_timeout,\n    76\t            ),\n    77\t            flush_batch_clock: LogicalClock::with(self.server_config.flush_batch_tick_timeout),\n    78\t            seq_paxos: SequencePaxos::with(self.into(), storage),\n    79\t        })\n    80\t    }\n    81\t}\n    82\t\n    83\t/// Configuration for an `OmniPaxos` cluster.\n    84\t/// # Fields\n    85\t/// * `configuration_id`: The identifier for the cluster configuration that this OmniPaxos server is part of.\n    86\t/// * `nodes`: The nodes in the cluster i.e. the `pid`s of the other servers in the configuration.\n    87\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n    88\t#[derive(Clone, Debug, PartialEq, Default)]\n    89\t#[cfg_attr(any(feature = \"serde\", feature = \"toml_config\"), derive(Deserialize))]\n    90\t#[cfg_attr(feature = \"toml_config\", serde(default))]\n    91\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n    92\tpub struct ClusterConfig {\n    93\t    /// The identifier for the cluster configuration that this OmniPaxos server is part of. Must\n    94\t    /// not be 0 and be greater than the previous configuration's id.\n    95\t    pub configuration_id: ConfigurationId,\n    96\t    /// The nodes in the cluster i.e. the `pid`s of the servers in the configuration.\n    97\t    pub nodes: Vec<NodeId>,\n    98\t    /// Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n    99\t    pub flexible_quorum: Option<FlexibleQuorum>,\n   100\t}\n   101\t\n   102\timpl ClusterConfig {\n   103\t    /// Checks that all the fields of the cluster config are valid.\n   104\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   105\t        let num_nodes = self.nodes.len();\n   106\t        valid_config!(num_nodes > 1, \"Need more than 1 node\");\n   107\t        valid_config!(self.configuration_id != 0, \"Configuration ID cannot be 0\");\n   108\t        if let Some(FlexibleQuorum {\n   109\t            read_quorum_size,\n   110\t            write_quorum_size,\n   111\t        }) = self.flexible_quorum\n   112\t        {\n   113\t            valid_config!(\n   114\t                read_quorum_size + write_quorum_size > num_nodes,\n   115\t                \"The quorums must overlap i.e., the sum of their sizes must exceed the # of nodes\"\n   116\t            );\n   117\t            valid_config!(\n   118\t                read_quorum_size >= 2 && read_quorum_size <= num_nodes,\n   119\t                \"Read quorum must be in range 2 to # of nodes in the cluster\"\n   120\t            );\n   121\t            valid_config!(\n   122\t                write_quorum_size >= 2 && write_quorum_size <= num_nodes,\n   123\t                \"Write quorum must be in range 2 to # of nodes in the cluster\"\n   124\t            );\n   125\t            valid_config!(\n   126\t                read_quorum_size >= write_quorum_size,\n   127\t                \"Read quorum size must be >= the write quorum size.\"\n   128\t            );\n   129\t        }\n   130\t        Ok(())\n   131\t    }\n   132\t\n   133\t    /// Checks all configuration fields and builds a local OmniPaxos node with settings for this\n   134\t    /// node defined in `server_config` and using storage `with_storage`.\n   135\t    pub fn build_for_server<T, B>(\n   136\t        self,\n   137\t        server_config: ServerConfig,\n   138\t        with_storage: B,\n   139\t    ) -> Result<OmniPaxos<T, B>, ConfigError>\n   140\t    where\n   141\t        T: Entry,\n   142\t        B: Storage<T>,\n   143\t    {\n   144\t        let op_config = OmniPaxosConfig {\n   145\t            cluster_config: self,\n   285\t        self.seq_paxos.get_compacted_idx()\n   286\t    }\n   287\t\n   288\t    /// Returns the ID of the current leader and whether the node's `Phase` is `Phase::Accepted`.\n   289\t    ///\n   290\t    /// If the node's phase is `Phase::Accepted`, this implies that the returned leader is also\n   291\t    /// in the accepted phase. However, a `Phase::Prepare` or a `false` response does not\n   292\t    /// necessarily imply that the leader is not in the accepted phase; it only reflects the current\n   293\t    /// phase of this node.\n   294\t    pub fn get_current_leader(&self) -> Option<(NodeId, bool)> {\n   295\t        let promised_pid = self.seq_paxos.get_promise().pid;\n   296\t        if promised_pid == 0 {\n   297\t            None\n   298\t        } else {\n   299\t            let is_accepted = self.seq_paxos.get_state().1 == Phase::Accept;\n   300\t            Some((promised_pid, is_accepted))\n   301\t        }\n   302\t    }\n   303\t\n   304\t    /// Returns the promised ballot of this node.\n   305\t    pub fn get_promise(&self) -> Ballot {\n   306\t        self.seq_paxos.get_promise()\n   307\t    }\n   308\t\n   309\t    /// Returns this node's own pid.\n   310\t    pub fn get_pid(&self) -> NodeId {\n   311\t        self.seq_paxos.get_pid()\n   312\t    }\n   313\t\n   314\t    /// Moves outgoing messages from this server into the buffer. The messages should then be sent via the network implementation.\n   315\t    pub fn take_outgoing_messages(&mut self, buffer: &mut Vec<Message<T>>) {\n   316\t        self.seq_paxos.take_outgoing_msgs(buffer);\n   317\t        buffer.extend(self.ble.outgoing_mut().drain(..).map(|b| Message::BLE(b)));\n   318\t    }\n   319\t\n   320\t    /// Read entry at index `idx` in the log. Returns `None` if `idx` is out of bounds.\n   321\t    pub fn read(&self, idx: usize) -> Option<LogEntry<T>> {\n   322\t        match self\n   323\t            .seq_paxos\n   324\t            .internal_storage\n   325\t            .read(idx..idx + 1)\n   326\t            .expect(\"storage error while trying to read log entries\")\n   327\t        {\n   328\t            Some(mut v) => v.pop(),\n   329\t            None => None,\n   330\t        }\n   331\t    }\n   332\t\n   333\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n   334\t    pub fn read_entries<R>(&self, r: R) -> Option<Vec<LogEntry<T>>>\n   335\t    where\n   336\t        R: RangeBounds<usize>,\n   337\t    {\n   338\t        self.seq_paxos\n   339\t            .internal_storage\n   340\t            .read(r)\n   341\t            .expect(\"storage error while trying to read log entries\")\n   342\t    }\n   343\t\n   344\t    /// Read all decided entries starting at `from_idx` (inclusive) in the log. Returns `None` if `from_idx` is out of bounds.\n   345\t    pub fn read_decided_suffix(&self, from_idx: usize) -> Option<Vec<LogEntry<T>>> {\n   346\t        self.seq_paxos\n   347\t            .internal_storage\n   348\t            .read_decided_suffix(from_idx)\n   349\t            .expect(\"storage error while trying to read decided log suffix\")\n   350\t    }\n   351\t\n   352\t    /// Handle an incoming message\n   353\t    pub fn handle_incoming(&mut self, m: Message<T>) {\n   354\t        match m {\n   355\t            Message::SequencePaxos(p) => self.seq_paxos.handle(p),\n   356\t            Message::BLE(b) => self.ble.handle(b),\n   357\t            #[cfg(feature = \"async_runtime\")]\n   358\t            Message::AsyncRuntime(_) => {\n   359\t                // Runtime-layer messages are consumed by the actor before reaching here.\n   360\t                // If one leaks through (e.g. user hand-delivered), silently ignore.\n   361\t            }\n   362\t        }\n   363\t    }\n   364\t\n   365\t    /// Returns whether this Sequence Paxos has been reconfigured\n   366\t    pub fn is_reconfigured(&self) -> Option<StopSign> {\n   367\t        self.seq_paxos.is_reconfigured()\n   368\t    }\n   369\t\n   370\t    /// Append an entry to the replicated log.\n   371\t    pub fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   372\t        self.seq_paxos.append(entry)\n   373\t    }\n   374\t\n   375\t    /// Propose a cluster reconfiguration. Returns an error if the current configuration has already been stopped\n   376\t    /// by a previous reconfiguration request or if the `new_configuration` is invalid.\n   377\t    /// `new_configuration` defines the cluster-wide configuration settings for the **next** cluster.\n   378\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   379\t    pub fn reconfigure(\n   380\t        &mut self,\n   381\t        new_configuration: ClusterConfig,\n   382\t        metadata: Option<Vec<u8>>,\n   383\t    ) -> Result<(), ProposeErr<T>> {\n   384\t        if let Err(config_error) = new_configuration.validate() {\n   385\t            return Err(ProposeErr::ConfigError(\n   386\t                config_error,\n   387\t                new_configuration,\n   388\t                metadata,\n   389\t            ));\n   390\t        }\n   391\t        self.seq_paxos.reconfigure(new_configuration, metadata)\n   392\t    }\n   393\t\n   394\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   395\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   396\t    pub fn reconnected(&mut self, pid: NodeId) {\n   397\t        self.seq_paxos.reconnected(pid)\n   398\t    }\n   399\t\n   400\t    /// Increments the internal logical clock. This drives the processes for leader changes, resending dropped messages, and flushing batched log entries.\n   401\t    /// Each of these is triggered every `election_tick_timeout`, `resend_message_tick_timeout`, and `flush_batch_tick_timeout` number of calls to this function\n   402\t    /// (See how to configure these timeouts in `ServerConfig`).\n   403\t    pub fn tick(&mut self) {\n   404\t        if self.election_clock.tick_and_check_timeout() {\n   405\t            self.election_timeout();\n   406\t        }\n   407\t        if self.resend_message_clock.tick_and_check_timeout() {\n   408\t            self.seq_paxos.resend_message_timeout();\n   409\t        }\n   410\t        if self.flush_batch_clock.tick_and_check_timeout() {\n   411\t            self.seq_paxos.flush_batch_timeout();\n   412\t        }\n   413\t    }\n   414\t\n   415\t    /// Manually attempt to become the leader by incrementing this instance's Ballot. Calling this\n   416\t    /// function may not result in gainig leadership if other instances are competing for\n   417\t    /// leadership with higher Ballots.\n   418\t    pub fn try_become_leader(&mut self) {\n   419\t        let mut my_ballot = self.ble.get_current_ballot();\n   420\t        let promise = self.seq_paxos.get_promise();\n   421\t        my_ballot.n = promise.n + 1;\n   422\t        self.seq_paxos.handle_leader(my_ballot);\n   423\t    }\n   424\t\n   425\t    /*** BLE calls ***/\n   426\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   427\t    /// priority triggers a leader re-election.\n   428\t    pub fn set_priority(&mut self, p: u32) {\n   429\t        self.ble.set_priority(p)\n   430\t    }\n   431\t\n   432\t    /// If the heartbeat of a leader is not received when election_timeout() is called, the server might attempt to become the leader.\n   433\t    /// It is also used for the election process, where the server checks if it can become the leader.\n   434\t    /// For instance if `election_timeout()` is called every 100ms, then if the leader fails, the servers will detect it after 100ms and elect a new server after another 100ms if possible.\n   435\t    fn election_timeout(&mut self) {\n   436\t        if let Some(new_leader) = self\n   437\t            .ble\n   438\t            .hb_timeout(self.seq_paxos.get_state(), self.seq_paxos.get_promise())\n   439\t        {\n   440\t            self.seq_paxos.handle_leader(new_leader);\n   441\t        }\n   442\t    }\n   443\t\n   444\t    /// Returns the current states of the OmniPaxos instance for OmniPaxos UI to display.\n   445\t    pub fn get_ui_states(&self) -> ui::OmniPaxosStates {\n    37\t    pub(crate) fn with(\n    38\t        storage: I,\n    39\t        config: InternalStorageConfig,\n    40\t        #[cfg(feature = \"unicache\")] pid: NodeId,\n    41\t    ) -> Self {\n    42\t        let mut internal_store = InternalStorage {\n    43\t            storage,\n    44\t            state_cache: StateCache::new(\n    45\t                config,\n    46\t                #[cfg(feature = \"unicache\")]\n    47\t                pid,\n    48\t            ),\n    49\t            _t: Default::default(),\n    50\t        };\n    51\t        internal_store.load_cache();\n    52\t        internal_store\n    53\t    }\n    54\t\n    55\t    fn load_cache(&mut self) {\n    56\t        self.state_cache.promise = self\n    57\t            .storage\n    58\t            .get_promise()\n    59\t            .expect(\"Failed to load cache from storage.\")\n    60\t            .unwrap_or_default();\n    61\t        self.state_cache.decided_idx = self.storage.get_decided_idx().unwrap();\n    62\t        self.state_cache.accepted_round = self\n    63\t            .storage\n    64\t            .get_accepted_round()\n    65\t            .unwrap()\n    66\t            .unwrap_or_default();\n    67\t        self.state_cache.compacted_idx = self.storage.get_compacted_idx().unwrap();\n    68\t        self.state_cache.stopsign = self.storage.get_stopsign().unwrap();\n    69\t        self.state_cache.accepted_idx =\n    70\t            self.storage.get_log_len().unwrap() + self.state_cache.compacted_idx;\n    71\t        if self.state_cache.stopsign.is_some() {\n    72\t            self.state_cache.accepted_idx += 1;\n    73\t        }\n    74\t    }\n    75\t\n    76\t    /// Read all decided entries from `from_idx` in the log. Returns `None` if `from_idx` is out of bounds.\n    77\t    pub(crate) fn read_decided_suffix(\n    78\t        &self,\n    79\t        from_idx: usize,\n    80\t    ) -> StorageResult<Option<Vec<LogEntry<T>>>> {\n    81\t        let decided_idx = self.get_decided_idx();\n    82\t        if from_idx < decided_idx {\n    83\t            self.read(from_idx..decided_idx)\n    84\t        } else {\n    85\t            Ok(None)\n    86\t        }\n    87\t    }\n    88\t\n    89\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n    90\t    pub(crate) fn read<R>(&self, r: R) -> StorageResult<Option<Vec<LogEntry<T>>>>\n   179\t    fn create_read_log_entries(&self, from: usize, to: usize) -> StorageResult<Vec<LogEntry<T>>> {\n   180\t        let decided_idx = self.get_decided_idx();\n   181\t        let entries = self\n   182\t            .get_entries(from, to)?\n   183\t            .into_iter()\n   184\t            .enumerate()\n   185\t            .map(|(idx, e)| {\n   186\t                let log_idx = idx + from;\n   187\t                if log_idx < decided_idx {\n   188\t                    LogEntry::Decided(e)\n   189\t                } else {\n   190\t                    LogEntry::Undecided(e)\n   191\t                }\n   192\t            })\n   193\t            .collect();\n   194\t        Ok(entries)\n   195\t    }\n   196\t\n   281\t    pub(crate) fn flush_batch(&mut self) -> StorageResult<usize> {\n   282\t        #[cfg(feature = \"unicache\")]\n   283\t        {\n   284\t            // clear the processed batch\n   285\t            self.state_cache.batched_processed_by_leader.clear();\n   286\t        }\n   287\t        let flushed_entries = self.state_cache.take_batched_entries();\n   288\t        self.append_entries_without_batching(flushed_entries)\n   289\t    }\n   290\t\n   291\t    pub(crate) fn flush_batch_and_get_entries(\n   292\t        &mut self,\n   293\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   294\t        let flushed_entries = if !self.state_cache.batched_entries.is_empty() {\n   295\t            Some(self.state_cache.take_batched_entries())\n   296\t        } else {\n   297\t            None\n   298\t        };\n   299\t        self.flush_if_full_batch(flushed_entries)\n   300\t    }\n   301\t\n   302\t    // Append entries without batching, return the accepted index\n   303\t    pub(crate) fn append_entries_without_batching(\n   304\t        &mut self,\n   305\t        entries: Vec<T>,\n   306\t    ) -> StorageResult<usize> {\n   307\t        let num_new_entries = entries.len();\n   308\t        self.storage.append_entries(entries)?;\n   309\t        self.state_cache.accepted_idx += num_new_entries;\n   310\t        Ok(self.state_cache.accepted_idx)\n   311\t    }\n   312\t\n   313\t    pub(crate) fn sync_log(\n   314\t        &mut self,\n   315\t        accepted_round: Ballot,\n   316\t        decided_idx: usize,\n   317\t        log_sync: Option<LogSync<T>>,\n   318\t    ) -> StorageResult<usize> {\n   319\t        self.state_cache.accepted_round = accepted_round;\n   320\t        self.state_cache.decided_idx = decided_idx;\n   321\t        let mut sync_txn: Vec<StorageOp<T>> = vec![\n   322\t            StorageOp::SetAcceptedRound(accepted_round),\n   323\t            StorageOp::SetDecidedIndex(decided_idx),\n   324\t        ];\n   325\t        if let Some(sync) = log_sync {\n   326\t            match sync.decided_snapshot {\n   327\t                Some(SnapshotType::Complete(c)) => {\n   328\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   329\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   330\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   331\t                    sync_txn.push(StorageOp::SetSnapshot(Some(c)));\n   332\t                }\n   333\t                Some(SnapshotType::Delta(d)) => {\n   334\t                    let mut snapshot = self.create_decided_snapshot()?;\n   335\t                    snapshot.merge(d);\n   336\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   337\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   338\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   339\t                    sync_txn.push(StorageOp::SetSnapshot(Some(snapshot)));\n   340\t                }\n   341\t                None => (),\n   342\t            }\n   343\t            self.state_cache.accepted_idx = sync.sync_idx + sync.suffix.len();\n   344\t            sync_txn.push(StorageOp::AppendOnPrefix(sync.sync_idx, sync.suffix));\n   345\t            match sync.stopsign {\n   346\t                Some(ss) => {\n   347\t                    self.state_cache.stopsign = Some(ss.clone());\n   348\t                    self.state_cache.accepted_idx += 1;\n   349\t                    sync_txn.push(StorageOp::SetStopsign(Some(ss)));\n   350\t                }\n   351\t                None if self.state_cache.stopsign.is_some() => {\n   352\t                    self.state_cache.stopsign = None;\n   353\t                    sync_txn.push(StorageOp::SetStopsign(None));\n   354\t                }\n   355\t                None => (),\n   356\t            }\n   357\t        }\n   358\t        self.storage.write_atomically(sync_txn)?;\n   359\t        Ok(self.state_cache.accepted_idx)\n   360\t    }\n   361\t\n   455\t    pub(crate) fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   456\t        self.state_cache.promise = n_prom;\n   457\t        self.storage.set_promise(n_prom)\n   458\t    }\n   459\t\n   460\t    pub(crate) fn set_decided_idx(&mut self, idx: usize) -> StorageResult<()> {\n   461\t        self.state_cache.decided_idx = idx;\n   462\t        self.storage.set_decided_idx(idx)\n   463\t    }\n   464\t\n   465\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   466\t        self.state_cache.decided_idx\n   467\t    }\n   468\t\n   469\t    fn get_decided_idx_without_stopsign(&self) -> usize {\n   470\t        match self.stopsign_is_decided() {\n   471\t            true => self.get_decided_idx() - 1,\n   472\t            false => self.get_decided_idx(),\n   473\t        }\n   474\t    }\n   475\t\n   476\t    pub(crate) fn get_accepted_round(&self) -> Ballot {\n   477\t        self.state_cache.accepted_round\n   478\t    }\n   479\t\n   480\t    pub(crate) fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n   481\t        self.storage.get_entries(from, to)\n   482\t    }\n   483\t\n   484\t    /// The length of the replicated log, as if log was never compacted.\n   485\t    pub(crate) fn get_accepted_idx(&self) -> usize {\n   486\t        self.state_cache.accepted_idx\n   487\t    }\n   488\t\n   489\t    /// The number of entries currently buffered for batching, not yet reflected\n   490\t    /// in `get_accepted_idx()`.\n   491\t    pub(crate) fn get_batched_len(&self) -> usize {\n   492\t        self.state_cache.batched_entries.len()\n   493\t    }\n   494\t\n   495\t    pub(crate) fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   496\t        self.storage.get_suffix(from)\n   497\t    }\n   498\t\n   499\t    pub(crate) fn get_promise(&self) -> Ballot {\n   500\t        self.state_cache.promise\n   501\t    }\n   502\t\n   503\t    pub(crate) fn set_stopsign(&mut self, ss: Option<StopSign>) -> StorageResult<usize> {\n   504\t        if ss.is_some() && self.state_cache.stopsign.is_none() {\n   505\t            self.state_cache.accepted_idx += 1;\n   506\t        } else if ss.is_none() && self.state_cache.stopsign.is_some() {\n   507\t            self.state_cache.accepted_idx -= 1;\n   508\t        }\n   509\t        self.state_cache.stopsign.clone_from(&ss);\n   510\t        self.storage.set_stopsign(ss)?;\n   511\t        Ok(self.state_cache.accepted_idx)\n   512\t    }\n   513\t\n   514\t    pub(crate) fn get_stopsign(&self) -> Option<StopSign> {\n   515\t        self.state_cache.stopsign.clone()\n   516\t    }\n   517\t\n   518\t    // Returns whether a stopsign is decided\n   519\t    pub(crate) fn stopsign_is_decided(&self) -> bool {\n   520\t        self.state_cache.stopsign_is_decided()\n   521\t    }\n   522\t\n   523\t    pub(crate) fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   110\t    SetPromise(Ballot),\n   111\t    /// Sets the decided index in the log.\n   112\t    SetDecidedIndex(usize),\n   113\t    /// Sets the latest accepted round.\n   114\t    SetAcceptedRound(Ballot),\n   115\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   116\t    SetCompactedIdx(usize),\n   117\t    /// Removes elements up to the given idx from storage.\n   118\t    Trim(usize),\n   119\t    /// Sets the StopSign used for reconfiguration.\n   120\t    SetStopsign(Option<StopSign>),\n   121\t    /// Sets the snapshot.\n   122\t    SetSnapshot(Option<T::Snapshot>),\n   123\t}\n   124\t\n   125\t/// Trait for implementing the storage backend of Sequence Paxos.\n   126\tpub trait Storage<T>\n   127\twhere\n   128\t    T: Entry,\n   129\t{\n   130\t    /// **Atomically** perform all storage operations in order.\n   131\t    /// For correctness, the operations must be atomic i.e., either all operations are performed\n   132\t    /// successfully or all get rolled back. If the `StorageResult` returns as `Err`, the\n   133\t    /// operations are assumed to have been rolled back to the previous state before this function\n   134\t    /// call.\n   135\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()>;\n   136\t\n   137\t    /// Appends an entry to the end of the log.\n   138\t    fn append_entry(&mut self, entry: T) -> StorageResult<()>;\n   139\t\n   140\t    /// Appends the entries of `entries` to the end of the log.\n   141\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()>;\n   142\t\n   143\t    /// Appends the entries of `entries` to the prefix from index `from_index` (inclusive) in the log.\n   144\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()>;\n   145\t\n   146\t    /// Sets the round that has been promised.\n   147\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()>;\n   148\t\n   149\t    /// Sets the decided index in the log.\n   150\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()>;\n   151\t\n   152\t    /// Returns the decided index in the log.\n   153\t    fn get_decided_idx(&self) -> StorageResult<usize>;\n   154\t\n   155\t    /// Sets the latest accepted round.\n   156\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()>;\n   157\t\n   158\t    /// Returns the latest round in which entries have been accepted, returns `None` if no\n   159\t    /// entries have been accepted.\n   160\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>>;\n   161\t\n   162\t    /// Returns the entries in the log in the index interval of [from, to).\n   163\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   164\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>>;\n   165\t\n   166\t    /// Returns the current length of the log (without the trimmed/snapshotted entries).\n   167\t    fn get_log_len(&self) -> StorageResult<usize>;\n   168\t\n   169\t    /// Returns the suffix of entries in the log from index `from` (inclusive).\n   170\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   171\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>>;\n   172\t\n   173\t    /// Returns the round that has been promised.\n   174\t    fn get_promise(&self) -> StorageResult<Option<Ballot>>;\n   175\t\n   176\t    /// Sets the StopSign used for reconfiguration.\n   177\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()>;\n   178\t\n   179\t    /// Returns the stored StopSign, returns `None` if no StopSign has been stored.\n   180\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>>;\n   181\t\n   182\t    /// Removes elements up to the given [`idx`] from storage.\n   183\t    fn trim(&mut self, idx: usize) -> StorageResult<()>;\n   184\t\n   185\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   186\t    fn set_compacted_idx(&mut self, idx: usize) -> StorageResult<()>;\n   187\t\n   188\t    /// Returns the garbage collector index from storage.\n   189\t    fn get_compacted_idx(&self) -> StorageResult<usize>;\n   190\t\n   191\t    /// Sets the snapshot.\n   192\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()>;\n   193\t\n   194\t    /// Returns the stored snapshot.\n   195\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>>;\n   196\t}\n   197\t\n   198\t/// A place holder type for when not using snapshots. You should not use this type, it is only internally when deriving the Entry implementation.\n   199\t#[derive(Copy, Clone, Debug, Eq, PartialEq)]\n   200\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   201\tpub struct NoSnapshot;\n   202\t\n   203\timpl<T: Entry> Snapshot<T> for NoSnapshot {\n   204\t    fn create(_entries: &[T]) -> Self {\n   205\t        panic!(\"NoSnapshot should not be created\");\n   206\t    }\n   207\t\n   208\t    fn merge(&mut self, _delta: Self) {\n   209\t        panic!(\"NoSnapshot should not be merged\");\n   210\t    }\n   211\t\n   212\t    fn use_snapshots() -> bool {\n   213\t        false\n   214\t    }\n   215\t}\n   414\t/// Flexible quorums can be used to increase/decrease the read and write quorum sizes,\n   415\t/// for different latency vs fault tolerance tradeoffs.\n   416\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n   417\t#[cfg_attr(any(feature = \"serde\", feature = \"toml_config\"), derive(Deserialize))]\n   418\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n   419\tpub struct FlexibleQuorum {\n   420\t    /// The number of nodes a leader needs to consult to get an up-to-date view of the log.\n   421\t    pub read_quorum_size: usize,\n   422\t    /// The number of acknowledgments a leader needs to commit an entry to the log\n   423\t    pub write_quorum_size: usize,\n   424\t}\n   425\t\n   426\t/// The type of quorum used by the OmniPaxos cluster.\n   427\t#[derive(Copy, Clone, Debug)]\n   428\tpub(crate) enum Quorum {\n   429\t    /// Both the read quorum and the write quorums are a majority of nodes\n   430\t    Majority(usize),\n   431\t    /// The read and write quorum sizes are defined by a `FlexibleQuorum`\n   432\t    Flexible(FlexibleQuorum),\n   433\t}\n   434\t\n   435\timpl Quorum {\n   436\t    pub(crate) fn with(flexible_quorum_config: Option<FlexibleQuorum>, num_nodes: usize) -> Self {\n   437\t        match flexible_quorum_config {\n   438\t            Some(FlexibleQuorum {\n   439\t                read_quorum_size,\n   440\t                write_quorum_size,\n   441\t            }) => Quorum::Flexible(FlexibleQuorum {\n   442\t                read_quorum_size,\n   443\t                write_quorum_size,\n   444\t            }),\n   445\t            None => Quorum::Majority(num_nodes / 2 + 1),\n   446\t        }\n   447\t    }\n   448\t\n   449\t    pub(crate) fn is_prepare_quorum(&self, num_nodes: usize) -> bool {\n   450\t        match self {\n   451\t            Quorum::Majority(majority) => num_nodes >= *majority,\n   452\t            Quorum::Flexible(flex_quorum) => num_nodes >= flex_quorum.read_quorum_size,\n   453\t        }\n   454\t    }\n   455\t\n   456\t    pub(crate) fn is_accept_quorum(&self, num_nodes: usize) -> bool {\n   457\t        match self {\n   458\t            Quorum::Majority(majority) => num_nodes >= *majority,\n   459\t            Quorum::Flexible(flex_quorum) => num_nodes >= flex_quorum.write_quorum_size,\n   460\t        }\n   461\t    }\n   462\t}\n   463\t\n   464\t/// The entries flushed due to an append operation\n   465\tpub(crate) struct AcceptedMetaData<T: Entry> {\n   466\t    pub accepted_idx: usize,\n   467\t    #[cfg(not(feature = \"unicache\"))]\n   468\t    pub entries: Vec<T>,\n   469\t    #[cfg(feature = \"unicache\")]\n   470\t    pub entries: Vec<T::EncodeResult>,\n   471\t}\n   472\t\n   473\t#[cfg(not(feature = \"unicache\"))]\n   474\t#[cfg(test)]\n   475\tmod tests {\n   476\t    use super::*; // Import functions and types from this module\n   477\t    use crate::storage::NoSnapshot;\n   478\t    #[test]\n   479\t    fn preparable_peers_test() {\n   480\t        type Value = ();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The core path is now traceable: per-node promises select history, acceptance acknowledgments advance decisions, and ballot and sequence checks guard follower processing. I also found two questions worth retaining: delayed messages across configuration changes, and a buffered reconfiguration proposal when its node becomes a follower. Neither is yet an established defect.\n"}}
