    \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Protocol Contexts\",\n          \"type\": \"array\"\n        },\n        \"external_interfaces\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"External Interfaces\",\n          \"type\": \"array\"\n        },\n        \"ownership\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Ownership\",\n          \"type\": \"array\"\n        },\n        \"selection_injection\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Selection Injection\",\n          \"type\": \"array\"\n        },\n        \"variants\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Variants\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"unknowns\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"system_boundary\"\n      ],\n      \"title\": \"TargetProfile\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"version\": {\n      \"default\": 1,\n      \"title\": \"Version\",\n      \"type\": \"integer\"\n    },\n    \"target_profile\": {\n      \"$ref\": \"#/$defs/TargetProfile\"\n    },\n    \"activities\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/Activity\"\n      },\n      \"maxItems\": 7,\n      \"title\": \"Activities\",\n      \"type\": \"array\"\n    },\n    \"behaviors\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Behavior\"\n      },\n      \"title\": \"Behaviors\",\n      \"type\": \"array\"\n    },\n    \"facts\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Fact\"\n      },\n      \"title\": \"Facts\",\n      \"type\": \"array\"\n    },\n    \"surfaces\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Surface\"\n      },\n      \"title\": \"Surfaces\",\n      \"type\": \"array\"\n    },\n    \"core_overview\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CoreOverview\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"target_profile\"\n  ],\n  \"title\": \"ConsensusAuditSpec\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
