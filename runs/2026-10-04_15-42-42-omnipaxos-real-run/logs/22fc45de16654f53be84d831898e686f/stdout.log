election','s-ballot'],implementation_guards=['Heartbeat replies require current round and matching configuration id.','SequencePaxos starts leadership only above both its leader ballot and promise.'],writes=['BLE leader, current ballot and happiness; fresh LeaderState on local takeover.'],external_effects=['Heartbeat requests/replies; local election invokes handle_leader.'],important_branches=['Recovery with a nondefault stored promise starts own BLE ballot at round zero.','Happiness and takeover use preparation or acceptance quorum counts; this is not a decision certificate.'],cross_activity_effects={'A1':'A local elected ballot begins preparation; it does not bypass promise collection.'},unknowns=['Heartbeat replies are stored in a vector without sender deduplication; legal transport duplication assumptions need reading.'])\nb('b-prepare','A2','SequencePaxos leader and follower','Replica promise ballot and role/phase','handle_leader or incoming Prepare',['s-leader-start','s-follow','s-support'],implementation_guards=['Local takeover requires strictly larger ballot; follower accepts larger Prepare or equal ballot while Recover.'],writes=['Flush pending batch, persist promise, reset follower sequence on Prepare; local takeover resets LeaderState and inserts own promise.'],external_effects=['Leader sends Prepare; follower sends and caches Promise containing accepted round/index, decided index and conditional log synchronization.'],important_branches=['A follower with a higher accepted round supplies history after the requesting leader decided index; same accepted round with longer log supplies its suffix.','become_follower changes role only.'],produces_fact_ids=['f-promise'],cross_activity_effects={'A1':'Promised ballot is the guard for accepting log changes and supplies preparation history.'})\nb('b-form','A1','SequencePaxos leader / LeaderState','Leader ballot in Prepare then Accept','Matching Promise, append, flush or Accepted',['s-formation','s-leader-start','s-support','s-quorum'],implementation_guards=['Promises must match leader ballot; support is stored per node id.','Accepted requires matching leader ballot and Leader/Accept; candidate index must exceed decided index and meet acceptance quorum.'],writes=['Preparation chooses maximal accepted round then length, maximum reported decided index, and syncs local log; appends buffered proposals and StopSign only if no accepted StopSign.','Local acceptance updates own accepted index; incoming Accepted replaces sender accepted index.','A chosen incoming accepted index is persisted as decided index.'],external_effects=['AcceptSync to promised followers; AcceptDecide for new entries; Decide or coalesced decided index to promised followers.'],important_branches=['Local append and batch flush update self support and send messages; decision evaluation is in handle_accepted.','Late Promise in Accept updates follower metadata and sends synchronization without reselecting leader history.'],produces_fact_ids=['f-support','f-decided'],consumes_fact_ids=['f-promise'],async_boundaries=['Messages stay in outgoing buffers until caller drains and transports them.'],unknowns=['Whether delayed Accepted messages after same-ballot reconnect can misrepresent support requires producer-history analysis.'])\nb('b-follow','A1','SequencePaxos follower','Promised ballot and receive sequence session/counter','AcceptSync, AcceptDecide, AcceptStopSign or Decide',['s-follow','s-follow-retry','s-sequence'],implementation_guards=['AcceptSync requires matching promise and Follower/Prepare.','AcceptDecide and StopSign require matching promise, Follower/Accept and expected sequence.','Decide requires matching promise, Accept phase and expected sequence.'],writes=['AcceptSync installs history, accepted round, decided index and StopSign; enters Accept with supplied sequence.','AcceptDecide appends entries, updates decided index and may flush batches; StopSign flushes and stores seal.'],external_effects=['Accepted replies report local accepted index and can be coalesced in outgoing buffer.','Successful synchronization forwards buffered ordinary proposals if no StopSign.'],important_branches=['Lower ballot emits NotAccepted; higher unmatched ballot requests reconnection recovery.','Sequence gap invokes reconnected; outdated sequence is ignored.','Decide advancement is bounded by accepted index after flushing when needed.'],consumes_fact_ids=['f-promise'],produces_fact_ids=['f-decided'],cross_activity_effects={'A2':'Ballot and sequence guard define eligible leader work; a gap moves the replica to recovery.'},unknowns=['Buffered StopSign forwarding is absent from forward_buffered_proposals; its lifecycle when a preparing leader becomes a follower remains open.'])\nb('b-recover','A3','SequencePaxos initialization, reconnect and resend handlers','Stored promise or interrupted peer connection','Construction from storage, reconnected notification, sequence gap, or resend timeout',['s-start','s-api','s-leader-start','s-follow-retry','s-retry'],writes=['Stored promise starts Follower/Recover and PrepareReq to peers.','Reconnect to current leader sets Follower/Recover; leader handling PrepareReq resets sender promise metadata and latest accept cache.','Higher NotAccepted marks sender PromisedHigher; acceptance indexes are not reset by this metadata change.'],external_effects=['PrepareReq, Prepare and cached Promise retransmissions; leader retries StopSign acceptance/decision.'],important_branches=['Follower Accept phase has no resend action.','Leader sends a fresh sequence session when generating AcceptSync.'],cross_activity_effects={'A1':'Recovery rejoins through Promise and synchronization, retaining accepted history for selection.','A2':'Preparation changes the authority guard and synchronization establishes the subsequent receive sequence.'},unknowns=['Delayed same-ballot synchronization and replies across reconnect sessions require history analysis.'])\nb('b-storage','A6','InternalStorage and injected Storage backend','Persisted promise, accepted round, decided prefix and log','Build/cache load, log synchronization, append and state setters',['s-cache','s-sync','s-store-state','s-storage-contract'],writes=['Cache loads persisted state; accepted length adds compacted prefix and any StopSign.','sync_log builds an atomic transaction for accepted round, decided index, optional suffix replacement, snapshot and StopSign.'],durable_effects=['Storage trait requires ordered all-or-nothing write_atomically; concrete backend determines persistence.'],important_branches=['Cache fields are updated before backend writes; callers panic on errors. Restart reloads backend state.'],cross_activity_effects={'A1':'Recovered accepted round and length guide maximal history selection.','A2':'Persisted promise prevents ordinary reuse of pre-recovery authority.'},unknowns=['In-repository MemoryStorage and PersistentStorage implementations need inspection; injection does not externalize their obligations.','Compaction and snapshot merge paths need detailed reading.'])\nb('b-config','A4','OmniPaxosConfig / ClusterConfig / reconfiguration caller','Cluster member vector and configuration identifier','Build validation or reconfigure request',['s-config','s-entry','s-reconfig-doc','s-api','s-leader-start'],implementation_guards=['More than one node, nonzero configuration id, own pid included; flexible quorums intersect and sizes are bounded, read >= write.','Append and reconfigure reject once local StopSign is accepted.'],external_effects=['Reconfiguration proposes a StopSign; caller starts new instances after observing its decision and supplies old state to new nodes.'],cross_activity_effects={'A1':'Configured quorum sizes determine prepare and accept thresholds.','A2':'Decided StopSign seals old configuration; new instance belongs to next configuration.'},unknowns=['Public dispatch does not visibly filter SequencePaxos messages by configuration; caller routing duties across configurations need investigation.','Member uniqueness and next configuration id monotonicity are not checked in the read validation body; applicability needs contract analysis.'])\nb('b-read','A5','OmniPaxos read APIs / InternalStorage','Local stored log and decided index','read or read_decided_suffix',['s-entry','s-cache','s-read'],consumes_fact_ids=['f-decided'],external_effects=['Returned entries below cached decided index are tagged Decided; read_decided_suffix bounds the range by that index.'],cross_activity_effects={'A7':'Caller polls decided entries for application consumption; append success alone is admission.'})\nb('b-client','A7','Application caller of OmniPaxos','Caller-driven library instance','Append, periodic tick, outgoing drain, incoming delivery and decided read',['s-entry','s-api','s-comm-doc'],external_effects=['Proposals buffer in Prepare, append in Leader/Accept, otherwise forward or buffer if leader unknown.','Caller drives clocks, transports messages and reads decisions.'],important_branches=['Accepted StopSign blocks later appends; forwarding and admission do not themselves imply decision.'],cross_activity_effects={'A1':'Caller scheduling supplies incoming acknowledgments and timed batch flush.','A2':'Caller clocks drive BLE and retransmission.'},unknowns=['The in-repository async runtime has separate client completion ownership and remains unread.'])\nfacts=[dict(id='f-promise',meaning='The replica records the ballot it has promised and uses it to qualify incoming acceptance work.',identity={'replica':'node id','configuration':'instance configuration'},validity_context='Current replica instance and stored promise; matching promise is necessary but role, phase and sequence may add guards.',representation=['InternalStorage.state_cache.promise','Storage promise'],durability='Written through Storage; actual durability is backend-dependent.',recovery='Loaded from backend; nonempty promise starts recovery preparation.',source_ids=['s-prepare' if False else 's-follow','s-leader-start','s-cache','s-start','s-store-state']),dict(id='f-support',meaning='The leader records the latest assigned accepted index for each node in its current LeaderState.',identity={'leader':'leader ballot','participant':'node id'},validity_context='Current LeaderState; an index is local accounting, not independently a new decision or proof of current follower reachability.',representation=['LeaderState.accepted_indexes'],durability='Volatile; a new LeaderState zeros indexes.',recovery='Rebuilt through local synchronization and incoming Accepted messages.',source_ids=['s-support','s-formation','s-leader-start'],invalidators=['b-prepare'],unknowns=['Same-ballot reconnect leaves previous indexes in place; determine why these remain valid under permitted crash and transport histories.']),dict(id='f-decided',meaning='The local decided index marks the prefix exported as decided, including a decided StopSign when present.',identity={'configuration':'instance configuration','replica':'node id','prefix':'indices below decided index'},validity_context='Cached local log state, updated by quorum decision or synchronization/decision messages.',representation=['InternalStorage.state_cache.decided_idx','Storage decided index'],durability='Backend state with cached copy; sync_log writes it atomically with synchronized history.',recovery='Reloaded from backend and included in promises.',source_ids=['s-formation','s-follow','s-cache','s-sync','s-read','s-store-state'])]\nroles=json.load(open('../research.json'))['activity_roles']\nactivities=[dict(class_id=a,applicability='applicable',purpose=v['relation'],realization_summary='; '.join(x['trigger'] for x in B if x['primary_activity']==a),entry_points=[x['execution_owner'] for x in B if x['primary_activity']==a],source_ids=list(dict.fromkeys(y for x in B if x['primary_activity']==a for y in x['source_ids']))) for a,v in roles.items()]\ndef cp(text,bs,fs,ss): return dict(explanation=text,behavior_ids=bs,fact_ids=fs,source_ids=ss)\nm=dict(version=1,target_profile=dict(system_boundary='Captured OmniPaxos library, storage and optional async runtime; callers provide transport and scheduling. This initial backbone follows the core public library and leaves runtime/backend detail as sourced reading gaps.',protocol_contexts=['Cluster configuration','Leader ballot','Per-follower sequence session','Stored accepted history'],external_interfaces=['append/reconfigure','tick/handle_incoming/take_outgoing_messages','read_decided_suffix','Storage'],source_ids=['s-entry','s-config','s-storage-contract']),activities=activities,behaviors=B,facts=facts,surfaces=[dict(entry_point='OmniPaxos::handle_incoming',disposition='mapped',behavior_ids=['b-config','b-follow'],reason='Determine legal delivery of delayed old-configuration SequencePaxos messages to replacement instances; dispatch lacks an explicit configuration check.',source_ids=['s-entry','s-ballot','s-reconfig-doc'],high_consequence=True),dict(entry_point='SequencePaxos::forward_buffered_proposals',disposition='mapped',behavior_ids=['b-follow'],reason='Follow a buffered StopSign when a preparing leader loses leadership and synchronizes as follower; only ordinary proposals are forwarded here.',source_ids=['s-follow','s-api','s-leader-start']),dict(entry_point='Storage::write_atomically',disposition='deferred',reason='Inspect captured backend implementations against the atomicity contract and restart behavior.',source_ids=['s-storage-contract'],high_consequence=True)],core_overview=dict(status='usable',formation=cp('Caller append buffers or forwards until a leader is in Accept. The leader gathers matching per-node promises to a configured preparation quorum, selects maximum accepted round/length and maximum decided index, installs history, and synchronizes promised followers. Local appends update self support and emit AcceptDecide. Followers with matching promise, phase and sequence persist accepted entries and reply. Leader handle_accepted records sender support; a configured acceptance quorum at a larger index advances its decided prefix and propagates Decide or coalesced metadata. Followers advance decided state with batch handling; reads label entries below that index as Decided.', ['b-client','b-form','b-follow','b-read'],['f-support','f-decided'],['s-formation','s-support','s-follow','s-read','s-entry']),context=cp('BLE heartbeat rounds and manual takeover nominate ballots. SequencePaxos acquires local preparation authority only above its prior leader and promise. Prepare flushes pending writes, persists the promise, resets receive sequence and returns accepted history. Matching promises enable transition to Accept. Higher Prepare changes follower authority; old-ballot acceptance is rejected with NotAccepted, unexplained future ballots and sequence gaps request recovery, outdated sequenced messages are ignored. Restart with stored promise enters Recover; reconnect and timer paths repeat preparation. A StopSign accepted as final entry blocks new appends, and its decision allows caller-created next-configuration instances.', ['b-elect','b-prepare','b-recover','b-config'],['f-promise'],['s-election','s-leader-start','s-follow','s-follow-retry','s-start','s-reconfig-doc']),connection=cp('Authority changes constrain which accepted history can become new support: promises report accepted round/length and existing decision index; maximal history is installed before new proposals are accepted. Follower synchronization retains a prefix based on matching accepted rounds or decided history, then starts a new sequence session. A new leader resets volatile support; recovery retains persisted history and cannot simply reuse ordinary acceptance phase. Old-ballot messages are rejected, while same-ballot late promises trigger follower synchronization. Buffered ordinary proposals are appended by a winning leader or forwarded after follower sync unless sealed. Prior StopSign travels with history and blocks further appends. Same-ballot delayed replies, configuration routing and buffered StopSign transfer remain localized unresolved premises.', ['b-prepare','b-form','b-follow','b-storage','b-recover'],['f-promise','f-support','f-decided'],['s-leader-start','s-formation','s-follow','s-support','s-sync','s-start']),open_details=['Configuration isolation at transport/runtime boundaries.','Buffered StopSign handling after leadership loss.','Atomic backend implementation and async runtime completion paths.','Detailed snapshot/compaction recovery and delayed same-ballot histories.'],core_gaps=[],rationale='Both core relationships and their shared history/authority backbone are traced through public calls, handlers, storage interfaces, recovery and read consumption. Local anomalies and unread variants remain explicit; no execution or defect is asserted.'))\njson.dump(m,open('map.json','w'),indent=2)\nsubmission=dict(action='research',rationale='Establish the sourced two-core relationship backbone and retain concrete unresolved premises before choosing a formal question.',sources=sources,map_path='map.json',feedback=dict(ref_ids=['b-prepare','b-form','b-follow','b-config'],answered='The core library gates acceptance by promised ballot and receive sequence, forms decisions using per-node accepted-index support, and reconstructs history through prepare/synchronization. Caller scheduling and decided-log reads connect formation to application use.',remaining=['Investigate configuration isolation against actual caller/runtime delivery responsibilities.','Trace buffered StopSign ownership through leadership loss.','Inspect backend and runtime implementations before assigning their obligations.'],understanding='updated',rationale='Source observations explain ordinary formation and transitions while preserving local ownership and history gaps without claiming defects.'))\njson.dump(submission,open('submission.json','w'),indent=2)\nPY\npython3 build_map.py\npython3 - <<'PY'\nimport json,pathlib\ns=json.load(open('submission.json'))\nfor r in s['sources']:\n n=len((pathlib.Path('../agent-source')/r['file']).read_text().splitlines())\n if r['end_line']>n: print(r['id'],r['end_line'],n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
