package raft

import (
	"encoding/json"
	"fmt"
	"io"
	"sort"
	"strings"
	"testing"
	"time"

	hclog "github.com/hashicorp/go-hclog"
)

// assuranceFSM is a minimal FSM: it records that a snapshot restore happened and
// discards applied entries.
type assuranceFSM struct {
	restores int
}

func (f *assuranceFSM) Apply(l *Log) interface{} { return nil }

func (f *assuranceFSM) Snapshot() (FSMSnapshot, error) { return &assuranceSnapshot{}, nil }

func (f *assuranceFSM) Restore(rc io.ReadCloser) error {
	f.restores++
	_, err := io.Copy(io.Discard, rc)
	_ = rc.Close()
	return err
}

type assuranceSnapshot struct{}

func (s *assuranceSnapshot) Persist(sink SnapshotSink) error { return sink.Close() }
func (s *assuranceSnapshot) Release()                        {}

func assuranceConfigIDs(c Configuration) string {
	ids := make([]string, 0, len(c.Servers))
	for _, s := range c.Servers {
		id := string(s.ID)
		if s.Suffrage != Voter {
			id += "!"
		}
		ids = append(ids, id)
	}
	sort.Strings(ids)
	return strings.Join(ids, ",")
}

func assuranceEmit(fields map[string]interface{}) {
	b, err := json.Marshal(fields)
	if err != nil {
		panic(err)
	}
	fmt.Println("CA_EVENT " + string(b))
}

// assuranceBuildRestartFixture builds the on-disk state of a node that has
// committed (and recorded as committed) a configuration change newer than its
// last snapshot.
//
// Layout: snapshot at index 5 with configuration {A,B,C} (configuration index 1);
// log entries: 1 = LogConfiguration{A,B,C}, 2..5 = LogNoop, 6 =
// LogConfiguration{A,B,C,D,E}, 7 = LogNoop; the log store records commit index 7,
// so index 6 is a *committed* configuration entry that is newer than the snapshot.
func assuranceBuildRestartFixture(mode string, t *testing.T) (*Config, *assuranceFSM, *InmemCommitTrackingStore, *InmemSnapshotStore, *InmemStore, *InmemTransport, *Configuration, *Log) {
	cfgSnap := Configuration{Servers: []Server{
		{Suffrage: Voter, ID: "A", Address: "A"},
		{Suffrage: Voter, ID: "B", Address: "B"},
		{Suffrage: Voter, ID: "C", Address: "C"},
	}}
	cfgNew := Configuration{Servers: append(append([]Server{}, cfgSnap.Servers...),
		Server{Suffrage: Voter, ID: "D", Address: "D"},
		Server{Suffrage: Voter, ID: "E", Address: "E"},
	)}

	_, trans := NewInmemTransport("A")
	stable := NewInmemStore()
	logs := NewInmemCommitTrackingStore()
	snaps := NewInmemSnapshotStore()

	sink, err := snaps.Create(1, 5, 1, cfgSnap, 1, trans)
	if err != nil {
		t.Fatalf("[%s] snapshot create: %v", mode, err)
	}
	if _, err := sink.Write([]byte("snapshot-state")); err != nil {
		t.Fatalf("[%s] snapshot write: %v", mode, err)
	}
	if err := sink.Close(); err != nil {
		t.Fatalf("[%s] snapshot close: %v", mode, err)
	}

	newCfgEntry := &Log{Index: 6, Term: 2, Type: LogConfiguration, Data: EncodeConfiguration(cfgNew)}
	entries := []*Log{
		{Index: 1, Term: 1, Type: LogConfiguration, Data: EncodeConfiguration(cfgSnap)},
		{Index: 2, Term: 1, Type: LogNoop},
		{Index: 3, Term: 1, Type: LogNoop},
		{Index: 4, Term: 1, Type: LogNoop},
		{Index: 5, Term: 1, Type: LogNoop},
		newCfgEntry,
		{Index: 7, Term: 2, Type: LogNoop},
	}
	for _, e := range entries {
		if err := logs.StoreLog(e); err != nil {
			t.Fatalf("[%s] store log: %v", mode, err)
		}
	}
	if err := logs.StageCommitIndex(7); err != nil {
		t.Fatalf("[%s] stage commit index: %v", mode, err)
	}

	conf := DefaultConfig()
	conf.LocalID = "A"
	conf.Logger = hclog.NewNullLogger()

	return conf, &assuranceFSM{}, logs, snaps, stable, trans, &cfgSnap, newCfgEntry
}

// TestAssuranceRestoreCommittedLogsConfigurationScan observes which configuration a
// restarted node ends up using when Config.RestoreCommittedLogs replays committed
// logs on startup, and compares it against the same fixture with the feature off.
func TestAssuranceRestoreCommittedLogsConfigurationScan(t *testing.T) {
	const (
		modeBaseline  = "baseline"
		modeRestore   = "restore_committed"
		modeRestoreUp = "restore_committed_skip_startup_false"
	)

	for _, mode := range []string{modeBaseline, modeRestore, modeRestoreUp} {
		conf, fsm, logs, snaps, stable, trans, cfgSnap, newCfgEntry := assuranceBuildRestartFixture(mode, t)
		conf.RestoreCommittedLogs = mode != modeBaseline
		conf.skipStartup = mode != modeRestoreUp

		// Setup event: what the durable stores contain before NewRaft runs.
		assuranceEmit(map[string]interface{}{
			"alias":                     "fixture",
			"mode":                      mode,
			"local_id":                  string(conf.LocalID),
			"snapshot_index":            uint64(5),
			"snapshot_config_index":     uint64(1),
			"snapshot_config_ids":       assuranceConfigIDs(*cfgSnap),
			"log_last_index":            uint64(7),
			"log_entry6_type":           newCfgEntry.Type.String(),
			"log_entry6_config_ids":     assuranceConfigIDs(DecodeConfiguration(newCfgEntry.Data)),
			"log_entry6_index":          newCfgEntry.Index,
			"persisted_commit_index":    uint64(7),
			"feature_restore_committed": conf.RestoreCommittedLogs,
		})

		r, err := NewRaft(conf, fsm, logs, stable, snaps, trans)
		if err != nil {
			assuranceEmit(map[string]interface{}{"alias": "construct", "mode": mode, "error": err.Error()})
			t.Fatalf("[%s] NewRaft: %v", mode, err)
		}

		if mode != modeRestoreUp {
			// No goroutines run with skipStartup, so this is exactly the state
			// NewRaft computed.
			assuranceEmit(map[string]interface{}{
				"alias":                  "construct",
				"mode":                   mode,
				"local_id":               string(r.localID),
				"last_applied":           r.getLastApplied(),
				"commit_index":           r.getCommitIndex(),
				"latest_config_index":    r.configurations.latestIndex,
				"latest_config_ids":      assuranceConfigIDs(r.configurations.latest),
				"committed_config_index": r.configurations.committedIndex,
				"committed_config_ids":   assuranceConfigIDs(r.configurations.committed),
				"quorum_size":            r.quorumSize(),
				"has_vote_self":          hasVote(r.configurations.latest, "A"),
				"queued_fsm_batches":     len(r.fsmMutateCh),
				"fsm_restores":           fsm.restores,
			})
			continue
		}

		// Live node: wait until the node has started at least one election, so the
		// sample is taken from a node that is actually running on this state.
		deadline := time.Now().Add(3 * time.Second)
		for time.Now().Before(deadline) && r.getCurrentTerm() < 2 {
			time.Sleep(20 * time.Millisecond)
		}
		liveResp := r.GetConfiguration()
		var reported Configuration
		if err := liveResp.Error(); err == nil {
			reported = liveResp.Configuration()
		}
		assuranceEmit(map[string]interface{}{
			"alias":               "live",
			"mode":                mode,
			"local_id":            string(r.localID),
			"state":               r.getState().String(),
			"current_term":        r.getCurrentTerm(),
			"reported_config_ids": assuranceConfigIDs(reported),
			"latest_config_ids":   assuranceConfigIDs(r.getLatestConfiguration()),
			"last_applied":        r.getLastApplied(),
		})
		if f := r.Shutdown(); f != nil {
			_ = f.Error()
		}
	}
}
