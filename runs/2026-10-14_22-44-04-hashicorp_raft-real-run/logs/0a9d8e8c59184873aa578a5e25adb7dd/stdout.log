{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_live_replay_stall_test.go'\ns=open(p).read()\nhelper='''// liveStallFailingSnapshots wraps an in-memory snapshot store and can be told to\n// fail every Create call, which the library logs and tolerates while the log\n// continues to grow past the node's last snapshot.\ntype liveStallFailingSnapshots struct {\n\tinner    *InmemSnapshotStore\n\tfail     bool\n\tattempts int\n}\n\nfunc (s *liveStallFailingSnapshots) Create(version SnapshotVersion, index, term uint64,\n\tconfiguration Configuration, configurationIndex uint64, trans Transport) (SnapshotSink, error) {\n\ts.attempts++\n\tif s.fail {\n\t\treturn nil, fmt.Errorf(\\\"injected snapshot store failure\\\")\n\t}\n\treturn s.inner.Create(version, index, term, configuration, configurationIndex, trans)\n}\n\nfunc (s *liveStallFailingSnapshots) List() ([]*SnapshotMeta, error) { return s.inner.List() }\n\nfunc (s *liveStallFailingSnapshots) Open(id string) (*SnapshotMeta, io.ReadCloser, error) {\n\treturn s.inner.Open(id)\n}\n\n'''\ns=s.replace('func liveStallEmit(', helper+'func liveStallEmit(',1)\ns=s.replace('''import (\n\t\\\"encoding/json\\\"\n\t\\\"fmt\\\"\n\t\\\"testing\\\"\n\t\\\"time\\\"''','''import (\n\t\\\"encoding/json\\\"\n\t\\\"fmt\\\"\n\t\\\"io\\\"\n\t\\\"testing\\\"\n\t\\\"time\\\"''',1)\n# per-node snapshot stores: A gets the failing wrapper\ns=s.replace('''\t\tsnaps[id] = NewInmemSnapshotStore()''','''\t\tif id == \\\"A\\\" {\n\t\t\tsnaps[id] = liveStallSnapshotsA.inner\n\t\t} else {\n\t\t\tsnaps[id] = NewInmemSnapshotStore()\n\t\t}''',1)\ns=s.replace('''\ttrans := map[ServerID]*InmemTransport{}''','''\tliveStallSnapshotsA := &liveStallFailingSnapshots{inner: NewInmemSnapshotStore()}\n\ttrans := map[ServerID]*InmemTransport{}''',1)\n# A snapshot interval/threshold so the library attempts snapshots on A\ns=s.replace('''\t\tc.SnapshotInterval = 10 * time.Minute\n\t\tc.MaxAppendEntries = maxAppend''','''\t\tc.SnapshotInterval = 100 * time.Millisecond\n\t\tc.SnapshotThreshold = 1000\n\t\tc.MaxAppendEntries = maxAppend''',1)\nopen(p,'w').write(s)\nprint('ok', s.count('liveStallSnapshotsA'), s.count('liveStallFailingSnapshots'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
