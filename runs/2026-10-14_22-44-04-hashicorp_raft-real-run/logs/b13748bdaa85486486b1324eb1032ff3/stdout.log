ep(5 * time.Millisecond)\n\t\t}\n\t\ttermEnd := r.getCurrentTerm()\n\t\tnoSnapEmit(map[string]interface{}{\n\t\t\t\"event\":                 name + \"_isolated\",\n\t\t\t\"mode\":                  mode,\n\t\t\t\"local_id\":              \"A\",\n\t\t\t\"configured_servers\":    len(r.getLatestConfiguration().Servers),\n\t\t\t\"campaigning_observed\":  campaigning,\n\t\t\t\"term_advanced\":         termEnd > termStart,\n\t\t\t\"term_start\":            termStart,\n\t\t\t\"term_end\":              termEnd,\n\t\t\t\"state\":                 r.State().String(),\n\t\t\t\"observation_window_ms\": isolatedDeadline.Sub(time.Now().Add(-1 * time.Second)).Milliseconds(),\n\t\t})\n\t}'\"'''\nassert old2 in s\ns=s.replace(old2,new2,1)\nopen(p,'w').write(s)\nprint('ok')\nPY\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run && cp draft/assurance_no_snapshot_restart_test.go draft/work/zz_nosnap_test.go && cd draft/work && gofmt -w zz_nosnap_test.go && timeout 200 go test -run TestAssuranceNoSnapshotRestartConfiguration -count=1 -v . 2>&1 | tail -8\"","aggregated_output":"Traceback (most recent call last):\n  File \"<stdin>\", line 12, in <module>\nAssertionError\n=== RUN   TestAssuranceNoSnapshotRestartConfiguration\nCA_EVENT {\"a_config_before\":\"A,B,C\",\"a_log_last_index\":13,\"a_reported_config\":\"A,B,C\",\"a_snapshots\":0,\"a_staged_commit\":12,\"committed_commands\":10,\"event\":\"fixture\",\"leader\":\"B\",\"local_id\":\"A\",\"mode\":\"no_snapshot_restart\"}\nCA_EVENT {\"event\":\"restart_with_feature\",\"last_applied\":13,\"local_id\":\"A\",\"mode\":\"no_snapshot_restart\",\"newraft_returned\":true,\"reported_config_ids\":\"\",\"reported_config_list_len\":0,\"state\":\"Follower\",\"total_voters_in_log_config\":3}\nCA_EVENT {\"event\":\"restart_without_feature\",\"last_applied\":13,\"local_id\":\"A\",\"mode\":\"no_snapshot_restart\",\"newraft_returned\":true,\"reported_config_ids\":\"A,B,C\",\"reported_config_list_len\":3,\"state\"