{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_no_snapshot_restart_test.go'\ns=open(p).read()\nold='''\t\t\trafts[\\\"A\\\"] = r\n\t\t\ttime.Sleep(300 * time.Millisecond)\n\t\t\tnoSnapEmit(map[string]interface{}{\n\t\t\t\t\\\"event\\\":                          name,'''\nnew='''\t\t\trafts[\\\"A\\\"] = r\n\t\t\ttime.Sleep(300 * time.Millisecond)\n\t\t\tnoSnapEmit(map[string]interface{}{\n\t\t\t\t\\\"event\\\":                          name,\n\t\t\t\t\\\"configured_servers\\\":             len(r.getLatestConfiguration().Servers),'''\nassert old in s\ns=s.replace(old,new,1)\nold2='''\t\tcase <-time.After(window):\n\t\t\tnoSnapEmit(map[string]interface{}{\\\"event\\\": name, \\\"mode\\\": mode, \\\"local_id\\\": \\\"A\\\", \\\"newraft_returned\\\": false, \\\"window_ms\\\": window.Milliseconds()})\n\t\t}\n\t}'''\nnew2='''\t\tcase <-time.After(window):\n\t\t\tnoSnapEmit(map[string]interface{}{\\\"event\\\": name, \\\"mode\\\": mode, \\\"local_id\\\": \\\"A\\\", \\\"newraft_returned\\\": false, \\\"window_ms\\\": window.Milliseconds()})\n\t\t\treturn\n\t\t}\n\n\t\t// Isolation phase: cut the restarted node off from every peer and see what\n\t\t// it does with the configuration the restart gave it. A node that can\n\t\t// campaign should become a candidate and bump its term; a node whose\n\t\t// configuration is empty should not.\n\t\tr := rafts[\\\"A\\\"]\n\t\tfor _, id := range ids {\n\t\t\tif id \"'!= \"A\" {\n\t\t\t\ttrans[\"A\"].Disconnect(ServerAddress(id))\n\t\t\t\ttrans[id].Disconnect(\"A\")\n\t\t\t}\n\t\t}\n\t\ttermStart := r.getCurrentTerm()\n\t\tcampaigning := false\n\t\tisolatedDeadline := time.Now().Add(1 * time.Second)\n\t\tfor time.Now().Before(isolatedDeadline) {\n\t\t\tif st := r.State(); st == Candidate || st == Leader {\n\t\t\t\tcampaigning = true\n\t\t\t}\n\t\t\ttime.Sleep(5 * time.Millisecond)\n\t\t}\n\t\ttermEnd := r.getCurrentTerm()\n\t\tnoSnapEmit(map[string]interface{}{\n\t\t\t\"event\":                 name + \"_isolated\",\n\t\t\t\"mode\":                  mode,\n\t\t\t\"local_id\":              \"A\",\n\t\t\t\"configured_servers\":    len(r.getLatestConfiguration().Servers),\n\t\t\t\"campaigning_observed\":  campaigning,\n\t\t\t\"term_advanced\":         termEnd > termStart,\n\t\t\t\"term_start\":            termStart,\n\t\t\t\"term_end\":              termEnd,\n\t\t\t\"state\":                 r.State().String(),\n\t\t\t\"observation_window_ms\": isolatedDeadline.Sub(time.Now().Add(-1 * time.Second)).Milliseconds(),\n\t\t})\n\t}'\"'''\nassert old2 in s\ns=s.replace(old2,new2,1)\nopen(p,'w').write(s)\nprint('ok')\nPY\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run && cp draft/assurance_no_snapshot_restart_test.go draft/work/zz_nosnap_test.go && cd draft/work && gofmt -w zz_nosnap_test.go && timeout 200 go test -run TestAssuranceNoSnapshotRestartConfiguration -count=1 -v . 2>&1 | tail -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
