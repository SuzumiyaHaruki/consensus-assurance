{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_stale_election_test.go'\ns=open(p).read()\nanchor='''\t// Repair phase: put a node holding the current configuration in charge, take a'''\nassert anchor in s\nblock='''\t// Configuration change after the long run: a new configuration entry is an entry\n\t// the restarted node has never seen, so it should be processed normally.\n\treconfigLeader := ServerID(\\\"\\\")\n\tfor _, id := range []ServerID{\\\"B\\\", \\\"D\\\", \\\"E\\\"} {\n\t\tif r := nodes[id].raft; r \"'!= nil && r.State() == Leader {\n\t\t\treconfigLeader = id\n\t\t\tbreak\n\t\t}\n\t}\n\tif reconfigLeader == \"\" {\n\t\tfor _, id := range ids {\n\t\t\tif r := nodes[id].raft; r != nil && r.State() == Leader {\n\t\t\t\tif f := r.LeadershipTransferToServer(\"B\", \"B\"); f != nil {\n\t\t\t\t\t_ = f.Error()\n\t\t\t\t}\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tdl := time.Now().Add(10 * time.Second)\n\t\tfor time.Now().Before(dl) {\n\t\t\tfor _, id := range []ServerID{\"B\", \"D\", \"E\"} {\n\t\t\t\tif r := nodes[id].raft; r != nil && r.State() == Leader {\n\t\t\t\t\treconfigLeader = id\n\t\t\t\t}\n\t\t\t}\n\t\t\tif reconfigLeader != \"\" {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ttime.Sleep(10 * time.Millisecond)\n\t\t}\n\t}\n\treconfigErr := \"none\"\n\tif reconfigLeader != \"\" {\n\t\tf := nodes[reconfigLeader].raft.AddVoter(\"F\", \"F\", 0, 5*time.Second)\n\t\tif err := f.Error(); err != nil {\n\t\t\treconfigErr = err.Error()\n\t\t}\n\t}\n\ttime.Sleep(300 * time.Millisecond)\n\treconfigConsistent := true\n\tfirstReconfig := \"\"\n\treconfigPayloads := []string{}\n\tfor _, id := range ids {\n\t\tvar l Log\n\t\tif err := nodes[id].logs.GetLog(minorityWriteIndex, &l); err == nil {\n\t\t\tp := string(l.Data)\n\t\t\tif firstReconfig == \"\" {\n\t\t\t\tfirstReconfig = p\n\t\t\t} else if p != firstReconfig {\n\t\t\t\treconfigConsistent = false\n\t\t\t}\n\t\t\treconfigPayloads = append(reconfigPayloads, fmt.Sprintf(\"%s:%s\", id, p))\n\t\t}\n\t}\n\tstaleElectEmit(map[string]interface{}{\n\t\t\"event\":                          \"reconfigured\",\n\t\t\"mode\":                           mode,\n\t\t\"local_id\":                       \"A\",\n\t\t\"reconfig_leader\":                string(reconfigLeader),\n\t\t\"reconfig_error\":                 reconfigErr,\n\t\t\"a_config_ids_after_reconfig\":    staleElectConfigIDs(nodes[\"A\"].raft),\n\t\t\"a_fsm_applied_writes_after_reconfig\": appliedWrites(nodes[\"A\"].raft),\n\t\t\"entry_payloads_after_reconfig\":  strings.Join(reconfigPayloads, \",\"),\n\t\t\"entry_consistent_after_reconfig\": reconfigConsistent,\n\t})\n\n'\"'''\ns=s.replace(anchor, block+anchor,1)\nopen(p,'w').write(s)\nprint('ok')\nPY\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_22-44-04-hashicorp_raft-real-run && cp draft/assurance_stale_election_test.go draft/work/zz_stale_test.go && cd draft/work && gofmt -w zz_stale_test.go && timeout 300 go test -run TestAssuranceStaleConfigElectionWitness -count=1 -v . 2>&1 | grep '\\\"event\\\":\\\"reconfigured\\\"' | python3 -c \\\"\nimport sys,json\nfor line in sys.stdin:\n    if 'CA_EVENT' not in line: continue\n    ev=json.loads(line.split('CA_EVENT ',1)[1])\n    print(ev['mode'],'| leader',ev['reconfig_leader'],'| A config',ev['a_config_ids_after_reconfig'],'| entry consistent',ev['entry_consistent_after_reconfig'],'| A fsm',repr(ev['a_fsm_applied_writes_after_reconfig']),'| err',ev['reconfig_error'])\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
