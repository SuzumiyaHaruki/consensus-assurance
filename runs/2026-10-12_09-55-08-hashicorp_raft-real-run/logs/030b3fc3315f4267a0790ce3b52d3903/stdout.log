{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/w3 && python3 - <<'PY'\ns=open('assurance_generated_test.go').read()\nold='''\tvar snapIdx, snapTerm uint64\n\tif auto {'''\nnew='''\tvar snapIdx, snapTerm uint64\n\tif auto {\n\t\t// Drive the successor's log well past its FSM so that it snapshots on\n\t\t// its own while the applied index lags the log end.\n\t\tfor i := 0; i < 60; i++ {\n\t\t\tsuccessor.Apply([]byte(fmt.Sprintf(\\\"backlog-%d\\\", i)), 0)\n\t\t}'''\nassert old in s\ns=s.replace(old,new)\nopen('assurance_generated_test.go','w').write(s)\nPY\nGOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go vet . 2>&1|head -3; timeout 200 env GOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go test -count=1 -run 'TestAssurance_ReachabilityDivergentSuffix/trailing_logs=2_post=0_auto=true' -v . 2>&1 | grep -E 'CA_EVENT|FAIL|PASS|ok |undefined' | head -14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/w3 && python3 - <<'PY'\ns=open('assurance_generated_test.go').read()\nold='''\tvar snapIdx, snapTerm uint64\n\tif auto {'''\nnew='''\tvar snapIdx, snapTerm uint64\n\tif auto {\n\t\t// Drive the successor's log well past its FSM so that it snapshots on\n\t\t// its own while the applied index lags the log end.\n\t\tfor i := 0; i < 60; i++ {\n\t\t\tsuccessor.Apply([]byte(fmt.Sprintf(\\\"backlog-%d\\\", i)), 0)\n\t\t}'''\nassert old in s\ns=s.replace(old,new)\nopen('assurance_generated_test.go','w').write(s)\nPY\nGOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go vet . 2>&1|head -3; timeout 200 env GOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go test -count=1 -run 'TestAssurance_ReachabilityDivergentSuffix/trailing_logs=2_post=0_auto=true' -v . 2>&1 | grep -E 'CA_EVENT|FAIL|PASS|ok |undefined' | head -14\"","aggregated_output":"CA_EVENT {\"event\":\"partition\",\"leader\":\"server-6781c\",\"partner\":\"server-0204e\"}\nCA_EVENT {\"base_index\":2,\"divergence_index\":3,\"event\":\"divergent_prefix\",\"partitioned_leader_last_index\":62,\"partner_last_index\":60,\"partner_replicated_uncommitted\":true,\"partner_store_first\":1,\"partner_store_last\":60,\"trailing_logs\":2}\nCA_EVENT {\"divergence_index\":3,\"event\":\"successor_snapshot\",\"old_leader_term\":2,\"snapshot_index\":12,\"snapshot_term\":3,\"successor_applied_index\":64,\"successor_last_index\":64,\"successor_store_first\":13,\"successor_store_last\":64,\"successor_term\":3}\nCA_EVENT {\"event\":\"post_snapshot_applies\",\"post_entries\":0,\"snapshot_index\":12,\"successor_last_index\":64,\"successor_store_first\":13,\"successor_store_last\":64,\"trailing_logs\":2}\nCA_EVENT {\"entry_terms\":{\"server-0204e\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-46c4d\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-6781c\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-b3fa5\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-fa24e\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"}},\"event\":\"timeline\",\"leader\":\"server-b3fa52d7-4cec-1657-0eeb-2c958f32debc\",\"nodes\":{\"server-0204e6ff-bdf1-85d2-a59a-8aa86ce00149\":{\"applied\":64,\"last\":64,\"state\":\"Follower\",\"store_first\":61,\"store_last\":62,\"term\":3},\"server-46c4d752-3393-9684-87b8-8007338dc5fb\":{\"applied\":64,\"last\":64,\"state\":\"Follower\",\"store_first\":63,\"store_last\":64,\"term\":3},\"server-6781cf83-a5e3-9aff-a115-a9bbccaf8980\":{\"applied\":64,\"last\":64,\"state\":\"Follower\",\"store_first\":61,\"store_last\":62,\"term\":3},\"server-b3fa52d7-4cec-1657-0eeb-2c958f32debc\":{\"applied\":64,\"last\":64,\"state\":\"Leader\",\"store_first\":63,\"store_last\":64,\"term\":3},\"server-fa24e7df-fe51-204f-4677-0bbb45bd2da8\":{\"applied\":64,\"last\":64,\"state\":\"Follower\",\"store_first\":63,\"store_last\":64,\"term\":3}},\"partner_applied_cmds\":61,\"partner_id\":\"server-0204e\",\"partner_restores\":0,\"t_ms\":0}\nCA_EVENT {\"entry_terms\":{\"server-0204e\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-46c4d\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-6781c\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-b3fa5\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"},\"server-fa24e\":{\"3\":\"absent\",\"4\":\"absent\",\"5\":\"absent\"}},\"event\":\"timeline\",\"leader\":\"server-b3fa52d7-4cec-1657-0eeb-2c958f32debc\",\"nodes\":{\"server-0204e6ff-bdf1-85d2-a59a-8aa86ce00149\":{\"applied\":64,\"last\":64,\"state\":\"Follower\",\"store_first\":61,\"store_last\":62,\"term\":3},\"server-46c4d752-