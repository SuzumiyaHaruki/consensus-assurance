tom(Peers=5, Bootstrap=true, Conf{TrailingLogs:0, SnapshotInterval:1h, SnapshotThreshold:1<<20, HeartbeatTimeout/ElectionTimeout/LeaderLeaseTimeout:1s, CommitTimeout:10ms}, MakeFSMFunc returning a Restore-counting MockFSM). Wait for a leader, partner=followers[0], others=remaining three; for each other disconnect leader<->other AND partner<->other in both directions, then emit partition; base=leader.LastIndex(); fire five leader.Apply calls; wait until partner.LastIndex()>base and emit divergent_prefix with both last indexes, the partner's store bounds and the divergence index; wait up to 12s for a successor among others, apply one command, Snapshot(), and emit successor_snapshot with index, term, term of the successor, its last/applied index and store bounds; then FullyConnect() and emit a per-node timeline (state, term, last, applied, store bounds; entry terms at 3/4/5; partner Restore count and applied-command count) at 0/200/400/700/1000/1300ms, followed by rejoin_observe with the restore counts and the partner's and successor's indexes and store bounds.\\\",\n    \\\"responsibility\\\": \\\"A reachability claim needs an actually isolated follower; an incomplete partition must not be read as evidence about repair.\\\"\n  }\n}\nJSON\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run --submission update-09.json 2>&1 | head -3\"","aggregated_output":"{\"valid\": false, \"run_id\": \"8085826003f64081939807df782a8a05\", \"elapsed_seconds\": 1854.3803980970001, \"diagnostics\": [{\"details\": {}, \"code\": \"submission\", \"category\": \"semantic\", \"task\": \"\", \"candidate_version\": 0, \"object_ids\": [], \"paths\": [], \"material_ids\": [], \"message\": \"Correction names an object without the