{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/w3 && python3 - <<'PY'\ns=open('assurance_generated_test.go').read()\ns=s.replace('''\tfor _, trailing := range []uint64{0, 3} {\n\t\tt.Run(fmt.Sprintf(\\\"trailing_logs=%d\\\", trailing), func(t *testing.T) {''','''\tfor _, tc := range []struct {\n\t\ttrailing uint64\n\t\tpost     int\n\t}{{0, 0}, {10, 20}, {25, 20}} {\n\t\ttrailing := tc.trailing\n\t\tpost := tc.post\n\t\tt.Run(fmt.Sprintf(\\\"trailing_logs=%d_post=%d\\\", trailing, post), func(t *testing.T) {''')\n# after successor_snapshot emission, apply post-snapshot entries before healing\ns=s.replace('''\tpidx := c.IndexOf(partner)\n\tbefore := fsms[pidx].RestoreCount()\n\tc.FullyConnect()''','''\t// Commit entries past the snapshot so the leader's log extends beyond\n\t// its snapshot index by \"'`post`, making compaction reach the boundary.\n\tfor i := 0; i < post; i++ {\n\t\tif err := successor.Apply([]byte(fmt.Sprintf(\"post-%d\", i)), 5*time.Second).Error(); err != nil {\n\t\t\tt.Fatalf(\"post apply: %v\", err)\n\t\t}\n\t}\n\tsfb, slb := storeBounds(c.stores[c.IndexOf(successor)])\n\tcaEvent(map[string]interface{}{\"event\": \"post_snapshot_applies\", \"trailing_logs\": trailing,\n\t\t\"post_entries\": post, \"successor_last_index\": successor.LastIndex(),\n\t\t\"successor_store_first\": sfb, \"successor_store_last\": slb, \"snapshot_index\": snapIdx})\n\n\tpidx := c.IndexOf(partner)\n\tbefore := fsms[pidx].RestoreCount()\n\tc.FullyConnect()'\"''')\nopen('assurance_generated_test.go','w').write(s)\nPY\nGOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go vet . 2>&1 | head -5; echo \\\"vet done\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
