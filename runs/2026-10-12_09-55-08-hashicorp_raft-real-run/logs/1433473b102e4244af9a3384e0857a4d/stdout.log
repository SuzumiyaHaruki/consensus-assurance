{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/w3 && python3 - <<'PY'\ns=open('assurance_generated_test.go').read()\n# 1) slow FSM type\ns=s.replace('''type countFSM struct {''','''type slowFSM struct {\n\t*MockFSM\n\tdelay time.Duration\n}\n\nfunc (s *slowFSM) Apply(l *Log) interface{} {\n\ttime.Sleep(s.delay)\n\treturn s.MockFSM.Apply(l)\n}\n\ntype countFSM struct {''')\n# 2) case struct gains fields\ns=s.replace('''\tfor _, tc := range []struct {\n\t\ttrailing uint64\n\t\tpost     int\n\t}{{0, 0}, {10, 20}, {25, 20}} {\n\t\ttrailing := tc.trailing\n\t\tpost := tc.post\n\t\tt.Run(fmt.Sprintf(\\\"trailing_logs=%d_post=%d\\\", trailing, post), func(t *testing.T) {''','''\tfor _, tc := range []struct {\n\t\ttrailing   uint64\n\t\tpost       int\n\t\tuncommitted int\n\t\tauto       bool\n\t}{{0, 0, 5, false}, {10, 20, 5, false}, {25, 20, 5, false}, {2, 0, 60, true}} {\n\t\ttrailing := tc.trailing\n\t\tpost := tc.post\n\t\tuncommitted := tc.uncommitted\n\t\tauto := tc.auto\n\t\tt.Run(fmt.Sprintf(\\\"trailing_logs=%d_post=%d_auto=%v\\\", trailing, post, auto), func(t *testing.T) {''')\n# 3) FSM factory: slow when auto\ns=s.replace('''\t\tMakeFSMFunc: func() FSM { f := &countFSM{MockFSM: &MockFSM{}}; fsms = append(fsms, f); return f },''','''\t\tMakeFSMFunc: func() FSM {\n\t\t\tbase := &MockFSM{}\n\t\t\tif auto {\n\t\t\t\tf := &countFSM{MockFSM: base}\n\t\t\t\tfsms = append(fsms, f)\n\t\t\t\treturn &slowFSM{MockFSM: base, delay: 15 * time.Millisecond}\n\t\t\t}\n\t\t\tf := &countFSM{MockFSM: base}\n\t\t\tfsms = append(fsms, f)\n\t\t\treturn f\n\t\t},''')\n# 4) snapshot settings for auto case\ns=s.replace('''\tconf.SnapshotThreshold = 1 << 20\n\tconf.SnapshotInterval = time.Hour''','''\tif auto {\n\t\tconf.SnapshotThreshold = 5\n\t\tconf.SnapshotInterval = 10 * time.Millisecond\n\t} else {\n\t\tconf.SnapshotThreshold = 1 << 20\n\t\tconf.SnapshotInterval = time.Hour\n\t}''')\n# 5) uncommitted count\ns=s.replace('''\tfor i := 0; i < 5; i++ {\n\t\tleader.Apply([]byte(fmt.Sprintf(\\\"uncommitted-%d\\\", i)), 0)\n\t}''','''\tfor i := 0; i < uncommitted; i++ {\n\t\tleader.Apply([]byte(fmt.Sprintf(\\\"uncommitted-%d\\\", i)), 0)\n\t}''')\n# 6) skip the user snapshot for the auto case, and wait for the leader's own snapshot\ns=s.replace('''\tsf := successor.Snapshot()\n\tif err := sf.Error(); err \"'!= nil {\n\t\tt.Fatalf(\"snapshot: %v\", err)\n\t}\n\tmeta, rc, err := sf.Open()\n\tif err != nil {\n\t\tt.Fatalf(\"open: %v\", err)\n\t}\n\tsnapIdx := meta.Index\n\trc.Close()'\"''','''\tvar snapIdx uint64\n\tif auto {\n\t\t// Let the leader snapshot on its own while the log runs ahead of the\n\t\t// FSM, and record the highest snapshot it took.\n\t\tfor d := time.Now().Add(8 * time.Second); time.Now().Before(d); {\n\t\t\tif sf, _ := successor.getLastSnapshot(); false {\n\t\t\t\t_ = sf\n\t\t\t}\n\t\t\tli, _ := successor.getLastSnapshot()\n\t\t\tif li > 0 {\n\t\t\t\tsnapIdx = li\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ttime.Sleep(20 * time.Millisecond)\n\t\t}\n\t\tif snapIdx == 0 {\n\t\t\tt.Fatalf(\\\"leader never snapshotted on its own\\\")\n\t\t}\n\t} else {\n\t\tsf := successor.Snapshot()\n\t\tif err := sf.Error(); err \"'!= nil {\n\t\t\tt.Fatalf(\"snapshot: %v\", err)\n\t\t}\n\t\tmeta, rc, err := sf.Open()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"open: %v\", err)\n\t\t}\n\t\tsnapIdx = meta.Index\n\t\trc.Close()\n\t}'\"''')\nopen('assurance_generated_test.go','w').write(s)\nPY\nGOFLAGS=-mod=readonly GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-12_09-55-08-hashicorp_raft-real-run/draft/tmp/gocache go vet . 2>&1 | head -8; echo VETDONE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
