han error, 1)\\n\\t\\t\\tgo func() { applyDone <- apply.Error() }()\\n\\t\\t\\tselect {\\n\\t\\t\\tcase err := <-applyDone:\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\tcase <-time.After(2 * time.Second):\\n\\t\\t\\t\\tt.Fatal(\\\"prefix apply incomplete\\\")\\n\\t\\t\\t}\\n\\t\\t\\tcf := leader.GetConfiguration()\\n\\t\\t\\tif err := cf.Error(); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tvar configEntry Log\\n\\t\\t\\tif err := leader.logs.GetLog(1, &configEntry); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tif configEntry.Type != LogConfiguration || !reflect.DeepEqual(DecodeConfiguration(configEntry.Data), config) || !reflect.DeepEqual(cf.Configuration(), config) {\\n\\t\\t\\t\\tt.Fatal(\\\"configuration differs from bootstrap\\\")\\n\\t\\t\\t}\\n\\t\\t\\tif leader.CommitIndex() < configEntry.Index {\\n\\t\\t\\t\\tt.Fatal(\\\"configuration not committed\\\")\\n\\t\\t\\t}\\n\\t\\t\\tfor i := 1; i < 4; i++ {\\n\\t\\t\\t\\tidx := apply.Index()\\n\\t\\t\\t\\tassuranceWait(t, time.Second, func() bool { return nodes[i].AppliedIndex() >= idx }, \\\"all peers receive committed prefix\\\")\\n\\t\\t\\t}\\n\\t\\t\\tterm := leader.CurrentTerm()\\n\\t\\t\\tgate.mu.Lock()\\n\\t\\t\\tfor _, id := range ids[1:] {\\n\\t\\t\\t\\tgate.gates[id] = make(chan struct{})\\n\\t\\t\\t}\\n\\t\\t\\tgate.active = true\\n\\t\\t\\tgate.mu.Unlock()\\n\\t\\t\\t// Reaching the next transport call on both loops proves that each loop\\n\\t\\t\\t// consumed its preceding reply before we admit the verification operation.\\n\\t\\t\\tassuranceWait(t, 500*time.Millisecond, func() bool {\\n\\t\\t\\t\\tgate.mu.Lock()\\n\\t\\t\\t\\tdefer gate.mu.Unlock()\\n\\t\\t\\t\\tfor _, id := range ids[1:] {\\n\\t\\t\\t\\t\\tif !gate.blocked[string(id)+\\\"/append\\\"] || !gate.blocked[string(id)+\\\"/heartbeat\\\"] {\\n\\t\\t\\t\\t\\t\\treturn false\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}, \\\"all six sender loops quiescent at transport boundary\\\")\\n\\t\\t\\tif leader.State() != Leader || leader.CurrentTerm() != term {\\n\\t\\t\\t\\tt.Fatal(\\\"leader generation changed before admission\\\")\\n\\t\\t\\t}\\n\\t\\t\\tgate.mu.Lock()\\n\\t\\t\\tgate.replies = make(map[ServerID]int)\\n\\t\\t\\tgate.mu.Unlock()\\n\\t\\t\\tassuranceVerifyEvent(map[string]interface{}{\\\"event\\\": \\\"prefix\\\", \\\"op\\\": name, \\\"term\\\": term, \\\"configuration_index\\\": configEntry.Index, \\\"applied_index\\\": apply.Index(), \\\"voters\\\": 3, \\\"quiescent_loops\\\": 6, \\\"selected_id\\\": string(ids[selected]), \\\"selected_voter\\\": config.Servers[selected].Suffrage == Voter})\\n\\t\\t\\tvf := leader.VerifyLeader()\\n\\t\\t\\tassuranceVerifyEvent(map[string]interface{}{\\\"event\\\": \\\"admitted\\\", \\\"op\\\": name, \\\"term\\\": term})\\n\\t\\t\\tgate.release(ids[selected])\\n\\t\\t\\tresult := make(chan error, 1)\\n\\t\\t\\tgo func() { result <- vf.Error() }()\\n\\t\\t\\tselect {\\n\\t\\t\\tcase err := <-result:\\n\\t\\t\\t\\tgate.mu.Lock()\\n\\t\\t\\t\\tvoterReplies := gate.replies[ids[1]] + gate.replies[ids[2]]\\n\\t\\t\\t\\tnonvoterReplies := gate.replies[ids[3]]\\n\\t\\t\\t\\tgate.mu.Unlock()\\n\\t\\t\\t\\terrText := \\\"\\\"\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\terrText = err.Error()\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tassuranceVerifyEvent(map[string]interface{}{\\\"event\\\": \\\"result\\\", \\\"op\\\": name, \\\"success\\\": err == nil, \\\"error\\\": errText, \\\"remote_voter_reply\\\": voterReplies > 0, \\\"voter_replies\\\": voterReplies, \\\"nonvoter_replies\\\": nonvoterReplies, \\\"selected_id\\\": string(ids[selected]), \\\"term\\\": leader.CurrentTerm(), \\\"state\\\": leader.State().String()})\\n\\t\\t\\tcase <-time.After(600 * time.Millisecond):\\n\\t\\t\\t\\tassuranceVerifyEvent(map[string]interface{}{\\\"event\\\": \\\"incomplete\\\", \\\"op\\\": name, \\\"reason\\\": \\\"no result before finite schedule ends\\\"})\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\",\n    \"description\": \"Two independent four-node histories: nonvoter-only released remote replies and voter-only control. Bootstrap, election, committed Apply and all-peer application prefix precede transport quiescence and public verification. Measure Error result and per-suffrage successful replies.\",\n    \"semantic_changes\": [\n      \"Embed InmemTransport and delay AppendEntries calls before real delivery using channels; do not change requests or responses.\",\n      \"Explicitly disable optional pipelining via ErrPipelineReplicationNotSupported; ordinary retry/fallback and heartbeat remain real.\",\n      \"Observe transport return fields and public futures; use MockFSM from captured testing support.\",\n      \"Cut schedule off after 600 ms independently of forbidden success; missing result remains unknown. Release all gates and shut down all nodes.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prefix\",\n        \"event\": \"prefix\",\n        \"conditions\": [\n          {\n            \"field\": \"voters\",\n            \"op\": \"eq\",\n            \"value\": 3,\n            \"reference\": null\n          },\n          {\n            \"field\": \"quiescent_loops\",\n            \"op\": \"eq\",\n            \"value\": 6,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"admission\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prefix.term\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"s-startup\",\n        \"s-bootstrap\",\n        \"s-config-change\",\n        \"s-repl-ownership\",\n        \"s-replication\",\n        \"s-heartbeat\",\n        \"s-rpc\",\n        \"s-transfer\",\n        \"s-inmem-transport-check\",\n        \"s-test-fsm-check\",\n        \"s-config-timing-check\",\n        \"s-getconfiguration-check\"\n      ],\n      \"expectation_ids\": [\n        \"s-transport-contract\",\n        \"s-verify-documentation\",\n        \"s-verify-api\"\n      ],\n      \"binding_ids\": [\n        \"bind-verify-register\",\n        \"bind-verify-tally\",\n        \"bind-verify-result\",\n        \"bind-verify-producer\"\n      ],\n      \"derivation\": \"BootstrapCluster/NewRaft start four real nodes with fixed configuration; node 0 wins an ordinary election and Apply completes. Each peer AppliedIndex reaches that prefix and leader CommitIndex covers the actual persisted bootstrap configuration entry, whose decoded membership matches GetConfiguration and the expected configuration. Only then does a wrapper pause calls before InmemTransport delivery. Pipelines report ErrPipelineReplicationNotSupported, a supported fallback. Both append and heartbeat loops for every peer must enter a paused next call before admission: their previous replies have already been consumed. Reset counters at that boundary. The selected peer is released after public VerifyLeader enqueue; all other replies remain delayed until result or the 600 ms cutoff. No RPC response, role, term, notification tally or stored protocol state is fabricated.\",\n      \"applicability\": \"Local test harness in package raft; actual target source unchanged. Controlled non-Byzantine finite delays with active normal workers and lease; peer election timeout exceeds experiment delay. New cluster per independent case, distinct op identity.\",\n      \"unresolved\": [\n        \"Scheduling that misses quiescence cutoff yields setup failure, not evidence. Missing verification completion emits only an incomplete diagnostic, not a result.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Voter lease can cause failure; it is not disabled or renewed artificially.\",\n        \"Negative responses from the released real peer are consumed normally. Unreleased responses are finitely delayed and all gates release during cleanup.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-verification\",\n      \"checker_id\": \"verify-voter-support\",\n      \"event\": \"result\",\n      \"binding_ids\": [\n        \"bind-verify-register\",\n        \"bind-verify-tally\",\n        \"bind-verify-result\",\n        \"bind-verify-producer\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s-leader-loop\",\n          \"s-repl-ownership\",\n          \"s-verify-vote\",\n          \"s-replication\",\n          \"s-heartbeat\",\n          \"s-transfer\"\n        ],\n        \"expectation_ids\": [\n          \"s-verify-documentation\",\n          \"s-verify-api\",\n          \"s-membership-contract\",\n          \"s-verify-tests\"\n        ],\n        \"binding_ids\": [\n          \"bind-verify-register\",\n          \"bind-verify-tally\",\n          \"bind-verify-result\",\n          \"bind-verify-producer\"\n        ],\n        \"derivation\": \"A successful verification requires eligible remote support in a three-voter configuration. The checker uses success implies at least one observed remote voter positive reply after all earlier sender loops have drained. In the forbidden schedule both remote voter loops remain gated, so no remote voter can submit a new notification; only the nonvoter is released. In the control only a voter is released. Reply counts are measured by the transport after real receiver processing, not preset expected outcomes.\",\n        \"applicability\": \"Real election and committed application prefix, fixed three-voter/one-nonvoter membership, same operation ID across prefix/admission/result; no state assignments. Pipeline-disabled supported transport variant. Finite request delays, real peer receivers, active lease and all Raft workers.\",\n        \"unresolved\": [\n          \"A result proves the local participant-eligibility proposition only. No competing authority or stale application read is observed.\",\n          \"Successful reply count is an upper bound on consumed support; absence proves no voter consumption after quiescence. The permitted control releases only the voter, excluding nonvoter substitution.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Lease may terminate the old leader later, but does not qualify an earlier nonvoter contribution.\",\n          \"Negative support can reject verification; schedule must preserve or finitely delay this path and report its handling.\",\n          \"Current authority might in fact persist despite lost communication; the obligation constrains verification support rather than asserting a competing leader.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admission\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"verify-voter-support\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"result\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"remote_voter_reply\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"op\"\n      ],\n      \"history_field\": null,\n      \"description\": \"Success implies an observed positive remote voter reply since the quiescent boundary. Nonvoter-only completion violates the necessary participant eligibility condition; no success is required of a pending operation.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"No broader stale-read or later-leader endpoint is measured.\",\n    \"Counts are transport delivery observations, not instrumentation inside vote(); absence of any eligible reply after complete two-loop quiescence is the relevant discriminator.\",\n    \"An independently missing case is reported incomplete and cannot supply a holds result.\"\n  ]\n}{\"Time\":\"2026-09-28T18:17:36.899768594+08:00\",\"Action\":\"start\",\"Package\":\"github.com/hashicorp/raft\"}\n{\"Time\":\"2026-09-28T18:17:36.906568855+08:00\",\"Action\":\"run\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility\"}\n{\"Time\":\"2026-09-28T18:17:36.906596314+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility\",\"Output\":\"=== RUN   TestAssuranceVerifyParticipantEligibility\\n\"}\n{\"Time\":\"2026-09-28T18:17:36.906653692+08:00\",\"Action\":\"run\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility/nonvoter\"}\n{\"Time\":\"2026-09-28T18:17:36.906657418+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility/nonvoter\",\"Output\":\"=== RUN   TestAssuranceVerifyParticipantEligibility/nonvoter\\n\"}\n{\"Time\":\"2026-09-28T18:17:36.906939445+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility/nonvoter\",\"Output\":\"2026-09-28T18:17:36.906+0800 [INFO]  raft: initial configuration: index=1 servers=\\\"[{Suffrage:Voter ID:leader Address:leader} {Suffrage:Voter ID:voter-b Address:voter-b} {Suffrage:Voter ID:voter-c Address:voter-c} {Suffrage:Nonvoter ID:nonvoter Address:nonvoter}]\\\"\\n\"}\n{\"Time\":\"2026-09-28T18:17:36.906982237+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyParticipantEligibility/nonvoter\",\"Output\":\"2026-09-28T18:17:36.906+0800 [INFO]  raft: initial configuration: index=1 servers=\\\"[{Suffrage:Voter ID:leader Address:leader} {Suffrage:Voter ID:voter-b Address:voter-b} {Suffrage:Voter ID:voter-c Address:voter-