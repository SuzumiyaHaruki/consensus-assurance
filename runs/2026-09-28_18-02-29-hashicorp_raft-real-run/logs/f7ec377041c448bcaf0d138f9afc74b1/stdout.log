.Mutex\n../agent-source/net_transport.go:298:// SetHeartbeatHandler is used to set up a heartbeat handler\n../agent-source/net_transport.go:302:\tn.heartbeatFnLock.Lock()\n../agent-source/net_transport.go:303:\tdefer n.heartbeatFnLock.Unlock()\n../agent-source/net_transport.go:304:\tn.heartbeatFn = cb\n../agent-source/net_transport.go:346:func (n *NetworkTransport) Consumer() <-chan RPC {\n../agent-source/net_transport.go:450:func (n *NetworkTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {\n../agent-source/net_transport.go:468:func (n *NetworkTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n../agent-source/net_transport.go:648:\t// measuring the time to get the first byte separately because the heartbeat conn will hang out here\n../agent-source/net_transport.go:649:\t// for a good while waiting for a heartbeat whereas the append entries/rpc conn should not.\n../agent-source/net_transport.go:675:\t\t// Check if this is a heartbeat\n../agent-source/net_transport.go:724:\t// Check for heartbeat fast-path\n../agent-source/net_transport.go:726:\t\tn.heartbeatFnLock.Lock()\n../agent-source/net_transport.go:727:\t\tfn := n.heartbeatFn\n../agent-source/net_transport.go:728:\t\tn.heartbeatFnLock.Unlock()\n../agent-source/net_transport.go:744:\t// we will differentiate the heartbeat fast path from normal RPCs with labels\n../agent-source/net_transport.go:835:\tgo n.decodeResponses()\n../agent-source/net_transport.go:839:// decodeResponses is a long running routine that decodes the responses\n../agent-source/net_transport.go:841:func (n *netPipeline) decodeResponses() {\n../agent-source/net_transport.go:864:func (n *netPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n../agent-source/net_transport.go:894:func (n *netPipeline) Consumer() <-chan AppendFuture {\n  1104\tfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n  1105\t\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n  1106\t\n  1107\t\t// Sanity check the version.\n  1108\t\tversion := meta.Version\n  1109\t\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n  1110\t\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n  1111\t\t}\n  1112\t\n  1113\t\t// We don't support snapshots while there's a config change\n  1114\t\t// outstanding since the snapshot doesn't have a means to\n  1115\t\t// represent this state.\n  1116\t\tcommittedIndex := r.configurations.committedIndex\n  1117\t\tlatestIndex := r.configurations.latestIndex\n  1118\t\tif committedIndex != latestIndex {\n  1119\t\t\treturn fmt.Errorf(\"cannot restore snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n  1120\t\t\t\tlatestIndex, committedIndex)\n  1121\t\t}\n  1122\t\n  1123\t\t// Cancel any inflight requests.\n  1124\t\tfor {\n  1125\t\t\te := r.leaderState.inflight.Front()\n  1126\t\t\tif e == nil {\n  1127\t\t\t\tbreak\n  1128\t\t\t}\n  1129\t\t\te.Value.(*logFuture).respond(ErrAbortedByRestore)\n  1130\t\t\tr.leaderState.inflight.Remove(e)\n  1131\t\t}\n  1132\t\n  1133\t\t// We will overwrite the snapshot metadata with the current term,\n  1134\t\t// an index that's greater than the current index, or the last\n  1135\t\t// index in the snapshot. It's important that we leave a hole in\n  1136\t\t// the index so we know there's nothing in the Raft log there and\n  1137\t\t// replication will fault and send the snapshot.\n  1138\t\tterm := r.getCurrentTerm()\n  1139\t\tlastIndex := r.getLastIndex()\n  1140\t\tif meta.Index > lastIndex {\n  1141\t\t\tlastIndex = meta.Index\n  1142\t\t}\n  1143\t\tlastIndex++\n  1144\t\n  1145\t\t// Dump the snapshot. Note that we use the latest configuration,\n  1146\t\t// not the one that came with the snapshot.\n  1147\t\tsink, err := r.snapshots.Create(version, lastIndex, term,\n  1148\t\t\tr.configurations.latest, r.configurations.latestIndex, r.trans)\n  1149\t\tif err != nil {\n  1150\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n  1151\t\t}\n  1152\t\tn, err := io.Copy(sink, reader)\n  1153\t\tif err != nil {\n  1154\t\t\tsink.Cancel()\n  1155\t\t\treturn fmt.Errorf(\"failed to write snapshot: %v\", err)\n  1156\t\t}\n  1157\t\tif n != meta.Size {\n  1158\t\t\tsink.Cancel()\n  1159\t\t\treturn fmt.Errorf(\"failed to write snapshot, size didn't match (%d != %d)\", n, meta.Size)\n  1160\t\t}\n  1161\t\tif err := sink.Close(); err != nil {\n  1162\t\t\treturn fmt.Errorf(\"failed to close snapshot: %v\", err)\n  1163\t\t}\n  1164\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n  1165\t\n  1166\t\t// Restore the snapshot into the FSM. If this fails we are in a\n  1167\t\t// bad state so we panic to take ourselves out.\n  1168\t\tfsm := &restoreFuture{ID: sink.ID()}\n  1169\t\tfsm.ShutdownCh = r.shutdownCh\n  1170\t\tfsm.init()\n  1171\t\tselect {\n  1172\t\tcase r.fsmMutateCh <- fsm:\n  1173\t\tcase <-r.shutdownCh:\n  1174\t\t\treturn ErrRaftShutdown\n  1175\t\t}\n  1176\t\tif err := fsm.Error(); err != nil {\n  1177\t\t\tpanic(fmt.Errorf(\"failed to restore snapshot: %v\", err))\n  1178\t\t}\n  1179\t\n  1180\t\t// We set the last log so it looks like we've stored the empty\n  1181\t\t// index we burned. The last applied is set because we made the\n  1182\t\t// FSM take the snapshot state, and we store the last snapshot\n  1183\t\t// in the stable store since we created a snapshot as part of\n  1184\t\t// this process.\n  1185\t\tr.setLastLog(lastIndex, term)\n  1186\t\tr.setLastApplied(lastIndex)\n  1187\t\tr.setLastSnapshot(lastIndex, term)\n  1188\t\n  1189\t\t// Remove old logs if r.logs is a MonotonicLogStore. Log any errors and continue.\n  1190\t\tif logs, ok := r.logs.(MonotonicLogStore); ok && logs.IsMonotonic() {\n  1191\t\t\tif err := r.removeOldLogs(); err != nil {\n  1192\t\t\t\tr.logger.Error(\"failed to remove old logs\", \"error\", err)\n  1193\t\t\t}\n  1194\t\t}\n  1195\t\n  1196\t\tr.logger.Info(\"restored user snapshot\", \"index\", lastIndex)\n  1197\t\treturn nil\n  1198\t}\n  1199\t\n  1200\t// appendConfigurationEntry changes the configuration and adds a new\n  1201\t// configuration entry to the log. This must only be called from the\n    20\t\tReader   io.Reader // Set only for InstallSnapshot\n    21\t\tRespChan chan<- RPCResponse\n    22\t}\n    23\t\n    24\t// Respond is used to respond with a response, error or both\n    25\tfunc (r *RPC) Respond(resp interface{}, err error) {\n    26\t\tr.RespChan <- RPCResponse{resp, err}\n    27\t}\n    28\t\n    29\t// Transport provides an interface for network transports\n    30\t// to allow Raft to communicate with other nodes.\n    31\ttype Transport interface {\n    32\t\t// Consumer returns a channel that can be used to\n    33\t\t// consume and respond to RPC requests.\n    34\t\tConsumer() <-chan RPC\n    35\t\n    36\t\t// LocalAddr is used to return our local address to distinguish from our peers.\n    37\t\tLocalAddr() ServerAddress\n    38\t\n    39\t\t// AppendEntriesPipeline returns an interface that can be used to pipeline\n    40\t\t// AppendEntries requests.\n    41\t\tAppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error)\n    42\t\n    43\t\t// AppendEntries sends the appropriate RPC to the target node.\n    44\t\tAppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error\n    45\t\n    46\t\t// RequestVote sends the appropriate RPC to the target node.\n    47\t\tRequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error\n    48\t\n    49\t\t// InstallSnapshot is used to push a snapshot down to a follower. The data is read from\n    50\t\t// the ReadCloser and streamed to the client.\n    51\t\tInstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error\n    52\t\n    53\t\t// EncodePeer is used to serialize a peer's address.\n    54\t\tEncodePeer(id ServerID, addr ServerAddress) []byte\n    55\t\n    56\t\t// DecodePeer is used to deserialize a peer's address.\n    57\t\tDecodePeer([]byte) ServerAddress\n    58\t\n    59\t\t// SetHeartbeatHandler is used to setup a heartbeat handler\n    60\t\t// as a fast-pass. This is to avoid head-of-line blocking from\n    61\t\t// disk IO. If a Transport does not support this, it can simply\n    62\t\t// ignore the call, and push the heartbeat onto the Consumer channel.\n    63\t\tSetHeartbeatHandler(cb func(rpc RPC))\n    64\t\n    65\t\t// TimeoutNow is used to start a leadership transfer to the target node.\n    66\t\tTimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error\n    67\t}\n    68\t\n    69\t// WithPreVote is an interface that a transport may provide which\n    70\t// allows a transport to support a PreVote request.\n    71\t//\n    72\t// It is defined separately from Transport as unfortunately it wasn't in the\n    73\t// original interface specification.\n    74\ttype WithPreVote interface {\n    75\t\t// RequestPreVote sends the appropriate RPC to the target node.\n    76\t\tRequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error\n    77\t}\n    78\t\n    79\t// WithClose is an interface that a transport may provide which\n    80\t// allows a transport to be shut down cleanly when a Raft instance\n    81\t// shuts down.\n    82\t//\n    83\t// It is defined separately from Transport as unfortunately it wasn't in the\n    84\t// original interface specification.\n    85\ttype WithClose interface {\n    86\t\t// Close permanently closes a transport, stopping\n    87\t\t// any associated goroutines and freeing other resources.\n    88\t\tClose() error\n    89\t}\n    90\t\n    91\t// LoopbackTransport is an interface that provides a loopback transport suitable for testing\n    92\t// e.g. InmemTransport. It's there so we don't have to rewrite tests.\n    93\ttype LoopbackTransport interface {\n    94\t\tTransport   // Embedded transport reference\n    95\t\tWithPeers   // Embedded peer management\n    96\t\tWithClose   // with a close routine\n    97\t\tWithPreVote // with a prevote\n    98\t}\n    99\t\n   100\t// WithPeers is an interface that a transport may provide which allows for connection and\n   101\t// disconnection. Unless the transport is a loopback transport, the transport specified to\n   102\t// \"Connect\" is likely to be nil.\n   103\ttype WithPeers interface {\n   104\t\tConnect(peer ServerAddress, t Transport) // Connect a peer\n   105\t\tDisconnect(peer ServerAddress)           // Disconnect a given peer\n   106\t\tDisconnectAll()                          // Disconnect all peers, possibly to reconnect them later\n   107\t}\n   108\t\n   109\t// AppendPipeline is used for pipelining AppendEntries requests. It is used\n   110\t// to increase the replication throughput by masking latency and better\n   111\t// utilizing bandwidth.\n   112\ttype AppendPipeline interface {\n   113\t\t// AppendEntries is used to add another request to the pipeline.\n   114\t\t// The send may block which is an effective form of back-pressure.\n   115\t\tAppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error)\n   116\t\n   117\t\t// Consumer returns a channel that can be used to consume\n   118\t\t// response futures when they are ready.\n   119\t\tConsumer() <-chan AppendFuture\n   120\t\n   121\t\t// Close closes the pipeline and cancels all inflight RPCs\n   122\t\tClose() error\n   123\t}\n   124\t\n   125\t// AppendFuture is used to return information about a pipelined AppendEntries request.\n   126\ttype AppendFuture interface {\n   127\t\tFuture\n   128\t\n   129\t\t// Start returns the time that the append request was started.\n   130\t\t// It is always OK to call this method.\n   131\t\tStart() time.Time\n   132\t\n   133\t\t// Request holds the parameters of the AppendEntries call.\n   134\t\t// It is always OK to call this method.\n   135\t\tRequest() *AppendEntriesRequest\n   136\t\n   137\t\t// Response holds the results of the AppendEntries call.\n   138\t\t// This method must only be called after the Error\n   139\t\t// method returns, and will only be valid on success.\n   140\t\tResponse() *AppendEntriesResponse\n   141\t}\n   299\t\n   300\t\t// Make sure we didn't do something bad like remove the last voter\n   301\t\tif err := checkConfiguration(configuration); err != nil {\n   302\t\t\treturn Configuration{}, err\n   303\t\t}\n   304\t\n   305\t\treturn configuration, nil\n   306\t}\n   307\t\n   308\t// encodePeers is used to serialize a Configuration into the old peers format.\n   188\t\trestore := func(req *restoreFuture) {\n   189\t\t\t// Open the snapshot\n   190\t\t\tmeta, source, err := r.snapshots.Open(req.ID)\n   191\t\t\tif err != nil {\n   192\t\t\t\treq.respond(fmt.Errorf(\"failed to open snapshot %v: %v\", req.ID, err))\n   193\t\t\t\treturn\n   194\t\t\t}\n   195\t\t\tdefer source.Close()\n   196\t\n   197\t\t\tsnapLogger := r.logger.With(\n   198\t\t\t\t\"id\", req.ID,\n   199\t\t\t\t\"last-index\", meta.Index,\n   200\t\t\t\t\"last-term\", meta.Term,\n   201\t\t\t\t\"size-in-bytes\", meta.Size,\n   202\t\t\t)\n   203\t\n   204\t\t\t// Attempt to restore\n   205\t\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, meta.Size); err != nil {\n   206\t\t\t\treq.respond(fmt.Errorf(\"failed to restore snapshot %v: %v\", req.ID, err))\n   207\t\t\t\treturn\n   208\t\t\t}\n   209\t\n   210\t\t\t// Update the last index and term\n   211\t\t\tlastIndex = meta.Index\n   212\t\t\tlastTerm = meta.Term\n   213\t\t\treq.respond(nil)\n   214\t\t}\n   215\t\n   216\t\tsnapshot := func(req *reqSnapshotFuture) {\n   217\t\t\t// Is there something to snapshot?\n   218\t\t\tif lastIndex == 0 {\n   219\t\t\t\treq.respond(ErrNothingNewToSnapshot)\n   220\t\t\t\treturn\n   875\t\tcase r.applyCh <- logFuture:\n   876\t\t\treturn logFuture\n   877\t\t}\n   878\t}\n   879\t\n   880\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   881\t// to prevent returning stale data from the FSM after the peer has lost\n   882\t// leadership.\n   883\tfunc (r *Raft) VerifyLeader() Future {\n   884\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   885\t\tverifyFuture := &verifyFuture{}\n   886\t\tverifyFuture.init()\n   887\t\tselect {\n   888\t\tcase <-r.shutdownCh:\n   889\t\t\treturn errorFuture{ErrRaftShutdown}\n   890\t\tcase r.verifyCh <- verifyFuture:\n   891\t\t\treturn verifyFuture\n   892\t\t}\n   893\t}\n   894\t\n   895\t// GetConfiguration returns the latest configuration. This may not yet be\n   896\t// committed. The main loop can access this directly.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The main paths now connect from client admission through persistence, voter-index aggregation, commitment, and FSM completion, and from elections through leader setup and step-down. Two differences need further investigation: heartbeats update contact time without the ordinary replication path’s higher-term check, and leader verification registers with every replication worker while its threshold counts voters. Neither observation alone establishes a violation."}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/replication.go | sed -n '100,136p;137,201p;570,632p'; nl -ba ../agent-source/future.go | sed -n '220,280p'; nl -ba ../agent-source/net_transport.go | sed -n '660,742p;839,863p'; nl -ba ../agent-source/inmem_transport.go | sed -n '70,86p;272,310p'; nl -ba ../agent-source/raft.go | sed -n '667,709p'; nl -ba ../agent-source/api.go | sed -n '1050,1100p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/replication.go | sed -n '100,136p;137,201p;570,632p'; nl -ba ../agent-source/future.go | sed -n '220,280p'; nl -ba ../agent-source/net_transport.go | sed -n '660,742p;839,863p'; nl -ba ../agent-source/inmem_transport.go | sed -n '70,86p;272,310p'; nl -ba ../agent-source/raft.go | sed -n '667,709p'; nl -ba ../agent-source/api.go | sed -n '1050,1100p'\"","aggregated_output":"   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   101\t\t// Clear the waiting notifies minimizing lock time\n   102\t\ts.notifyLock.Lock()\n   103\t\tn := s.notify\n   104\t\ts.notify = make(map[*verifyFuture]struct{})\n   105\t\ts.notifyLock.Unlock()\n   106\t\n   107\t\t// Submit our votes\n   108\t\tfor v := range n {\n   109\t\t\tv.vote(leader)\n   110\t\t}\n   111\t}\n   112\t\n   113\t// cleanNotify is used to delete notify, .\n   114\tfunc (s *followerReplication) cleanNotify(v *verifyFuture) {\n   115\t\ts.notifyLock.Lock()\n   116\t\tdelete(s.notify, v)\n   117\t\ts.notifyLock.Unlock()\n   118\t}\n   119\t\n   120\t// LastContact returns the time of last contact.\n   121\tfunc (s *followerReplication) LastContact() time.Time {\n   122\t\ts.lastContactLock.RLock()\n   123\t\tlast := s.lastContact\n   124\t\ts.lastContactLock.RUnlock()\n   125\t\treturn last\n   126\t}\n   127\t\n   128\t// setLastContact sets the last contact to the current time.\n   129\tfunc (s *followerReplication) setLastContact() {\n   130\t\ts.lastContactLock.Lock()\n   131\t\ts.lastContact = time.Now()\n   132\t\ts.lastContactLock.Unlock()\n   133\t}\n   134\t\n   135\t// replicate is a long running routine that replicates log entries to a single\n   136\t// follower.\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n   165\t\t\t// followers quickly learn the leader's commit index when\n   166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n   167\t\t\t// can't do this to keep them unblocked by disk IO on the\n   168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n   169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   172\t\t\t}\n   173\t\n   174\t\t\t// If things looks healthy, switch to pipeline mode\n   175\t\t\tif !shouldStop && s.allowPipeline {\n   176\t\t\t\tgoto PIPELINE\n   177\t\t\t}\n   178\t\t}\n   179\t\treturn\n   180\t\n   181\tPIPELINE:\n   182\t\t// Disable until re-enabled\n   183\t\ts.allowPipeline = false\n   184\t\n   185\t\t// Replicates using a pipeline for high performance. This method\n   186\t\t// is not able to gracefully recover from errors, and so we fall back\n   187\t\t// to standard mode on failure.\n   188\t\tif err := r.pipelineReplicate(s); err != nil {\n   189\t\t\tif err != ErrPipelineReplicationNotSupported {\n   190\t\t\t\ts.peerLock.RLock()\n   191\t\t\t\tpeer := s.peer\n   192\t\t\t\ts.peerLock.RUnlock()\n   193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n   194\t\t\t}\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   201\t// If the follower log is behind, we take care to bring them up to date.\n   570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   571\t\treq.RPCHeader = r.getRPCHeader()\n   572\t\treq.Term = s.currentTerm\n   573\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   574\t\treq.Leader = r.trans.EncodePeer(r.localID, r.localAddr)\n   575\t\treq.LeaderCommitIndex = r.getCommitIndex()\n   576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n   580\t\t\treturn err\n   581\t\t}\n   582\t\treturn nil\n   583\t}\n   584\t\n   585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   220\ttype reqSnapshotFuture struct {\n   221\t\tdeferError\n   222\t\n   223\t\t// snapshot details provided by the FSM runner before responding\n   224\t\tindex    uint64\n   225\t\tterm     uint64\n   226\t\tsnapshot FSMSnapshot\n   227\t}\n   228\t\n   229\t// restoreFuture is used for requesting an FSM to perform a\n   230\t// snapshot restore. Used internally only.\n   231\ttype restoreFuture struct {\n   232\t\tdeferError\n   233\t\tID string\n   234\t}\n   235\t\n   236\t// verifyFuture is used to verify the current node is still\n   237\t// the leader. This is to prevent a stale read.\n   238\ttype verifyFuture struct {\n   239\t\tdeferError\n   240\t\tnotifyCh   chan *verifyFuture\n   241\t\tquorumSize int\n   242\t\tvotes      int\n   243\t\tvoteLock   sync.Mutex\n   244\t}\n   245\t\n   246\t// leadershipTransferFuture is used to track the progress of a leadership\n   247\t// transfer internally.\n   248\ttype leadershipTransferFuture struct {\n   249\t\tdeferError\n   250\t\n   251\t\tID      *ServerID\n   252\t\tAddress *ServerAddress\n   253\t}\n   254\t\n   255\t// configurationsFuture is used to retrieve the current configurations. This is\n   256\t// used to allow safe access to this information outside of the main thread.\n   257\ttype configurationsFuture struct {\n   258\t\tdeferError\n   259\t\tconfigurations configurations\n   260\t}\n   261\t\n   262\t// Configuration returns the latest configuration in use by Raft.\n   263\tfunc (c *configurationsFuture) Configuration() Configuration {\n   264\t\treturn c.configurations.latest\n   265\t}\n   266\t\n   267\t// Index returns the index of the latest configuration in use by Raft.\n   268\tfunc (c *configurationsFuture) Index() uint64 {\n   269\t\treturn c.configurations.latestIndex\n   270\t}\n   271\t\n   272\t// vote is used to respond to a verifyFuture.\n   273\t// This may block when responding on the notifyCh.\n   274\tfunc (v *verifyFuture) vote(leader bool) {\n   275\t\tv.voteLock.Lock()\n   276\t\tdefer v.voteLock.Unlock()\n   277\t\n   278\t\t// Guard against having notified already\n   279\t\tif v.notifyCh == nil {\n   280\t\t\treturn\n   660\t\tisHeartbeat := false\n   661\t\tvar labels []metrics.Label\n   662\t\tswitch rpcType {\n   663\t\tcase rpcAppendEntries:\n   664\t\t\tvar req AppendEntriesRequest\n   665\t\t\tif err := dec.Decode(&req); err != nil {\n   666\t\t\t\treturn err\n   667\t\t\t}\n   668\t\t\trpc.Command = &req\n   669\t\n   670\t\t\tleaderAddr := req.RPCHeader.Addr\n   671\t\t\tif len(leaderAddr) == 0 {\n   672\t\t\t\tleaderAddr = req.Leader\n   673\t\t\t}\n   674\t\n   675\t\t\t// Check if this is a heartbeat\n   676\t\t\tif req.Term != 0 && leaderAddr != nil &&\n   677\t\t\t\treq.PrevLogEntry == 0 && req.PrevLogTerm == 0 &&\n   678\t\t\t\tlen(req.Entries) == 0 && req.LeaderCommitIndex == 0 {\n   679\t\t\t\tisHeartbeat = true\n   680\t\t\t}\n   681\t\n   682\t\t\tif isHeartbeat {\n   683\t\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"Heartbeat\"}}\n   684\t\t\t} else {\n   685\t\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"AppendEntries\"}}\n   686\t\t\t}\n   687\t\tcase rpcRequestVote:\n   688\t\t\tvar req RequestVoteRequest\n   689\t\t\tif err := dec.Decode(&req); err != nil {\n   690\t\t\t\treturn err\n   691\t\t\t}\n   692\t\t\trpc.Command = &req\n   693\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"RequestVote\"}}\n   694\t\tcase rpcRequestPreVote:\n   695\t\t\tvar req RequestPreVoteRequest\n   696\t\t\tif err := dec.Decode(&req); err != nil {\n   697\t\t\t\treturn err\n   698\t\t\t}\n   699\t\t\trpc.Command = &req\n   700\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"RequestPreVote\"}}\n   701\t\tcase rpcInstallSnapshot:\n   702\t\t\tvar req InstallSnapshotRequest\n   703\t\t\tif err := dec.Decode(&req); err != nil {\n   704\t\t\t\treturn err\n   705\t\t\t}\n   706\t\t\trpc.Command = &req\n   707\t\t\trpc.Reader = io.LimitReader(r, req.Size)\n   708\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"InstallSnapshot\"}}\n   709\t\tcase rpcTimeoutNow:\n   710\t\t\tvar req TimeoutNowRequest\n   711\t\t\tif err := dec.Decode(&req); err != nil {\n   712\t\t\t\treturn err\n   713\t\t\t}\n   714\t\t\trpc.Command = &req\n   715\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"TimeoutNow\"}}\n   716\t\tdefault:\n   717\t\t\treturn fmt.Errorf(\"unknown rpc type %d\", rpcType)\n   718\t\t}\n   719\t\n   720\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"net\", \"rpcDecode\"}, decodeStart, labels)\n   721\t\n   722\t\tprocessStart := time.Now()\n   723\t\n   724\t\t// Check for heartbeat fast-path\n   725\t\tif isHeartbeat {\n   726\t\t\tn.heartbeatFnLock.Lock()\n   727\t\t\tfn := n.heartbeatFn\n   728\t\t\tn.heartbeatFnLock.Unlock()\n   729\t\t\tif fn != nil {\n   730\t\t\t\tfn(rpc)\n   731\t\t\t\tgoto RESP\n   732\t\t\t}\n   733\t\t}\n   734\t\n   735\t\t// Dispatch the RPC\n   736\t\tselect {\n   737\t\tcase n.consumeCh <- rpc:\n   738\t\tcase <-n.shutdownCh:\n   739\t\t\treturn ErrTransportShutdown\n   740\t\t}\n   741\t\n   742\t\t// Wait for response\n   839\t// decodeResponses is a long running routine that decodes the responses\n   840\t// sent on the connection.\n   841\tfunc (n *netPipeline) decodeResponses() {\n   842\t\ttimeout := n.trans.timeout\n   843\t\tfor {\n   844\t\t\tselect {\n   845\t\t\tcase future := <-n.inprogressCh:\n   846\t\t\t\tif timeout > 0 {\n   847\t\t\t\t\tn.conn.conn.SetReadDeadline(time.Now().Add(timeout))\n   848\t\t\t\t}\n   849\t\n   850\t\t\t\t_, err := decodeResponse(n.conn, future.resp)\n   851\t\t\t\tfuture.respond(err)\n   852\t\t\t\tselect {\n   853\t\t\t\tcase n.doneCh <- future:\n   854\t\t\t\tcase <-n.shutdownCh:\n   855\t\t\t\t\treturn\n   856\t\t\t\t}\n   857\t\t\tcase <-n.shutdownCh:\n   858\t\t\t\treturn\n   859\t\t\t}\n   860\t\t}\n   861\t}\n   862\t\n   863\t// AppendEntries is used to pipeline a new append entries request.\n    70\t}\n    71\t\n    72\t// SetHeartbeatHandler is used to set optional fast-path for\n    73\t// heartbeats, not supported for this transport.\n    74\tfunc (i *InmemTransport) SetHeartbeatHandler(cb func(RPC)) {\n    75\t}\n    76\t\n    77\t// Consumer implements the Transport interface.\n    78\tfunc (i *InmemTransport) Consumer() <-chan RPC {\n    79\t\treturn i.consumerCh\n    80\t}\n    81\t\n    82\t// LocalAddr implements the Transport interface.\n    83\tfunc (i *InmemTransport) LocalAddr() ServerAddress {\n    84\t\treturn i.localAddr\n    85\t}\n    86\t\n   272\tfunc (i *inmemPipeline) decodeResponses() {\n   273\t\ttimeout := i.trans.timeout\n   274\t\tfor {\n   275\t\t\tselect {\n   276\t\t\tcase inp := <-i.inprogressCh:\n   277\t\t\t\tvar timeoutCh <-chan time.Time\n   278\t\t\t\tif timeout > 0 {\n   279\t\t\t\t\ttimeoutCh = time.After(timeout)\n   280\t\t\t\t}\n   281\t\n   282\t\t\t\tselect {\n   283\t\t\t\tcase rpcResp := <-inp.respCh:\n   284\t\t\t\t\t// Copy the result back\n   285\t\t\t\t\t*inp.future.resp = *rpcResp.Response.(*AppendEntriesResponse)\n   286\t\t\t\t\tinp.future.respond(rpcResp.Error)\n   287\t\n   288\t\t\t\t\tselect {\n   289\t\t\t\t\tcase i.doneCh <- inp.future:\n   290\t\t\t\t\tcase <-i.shutdownCh:\n   291\t\t\t\t\t\treturn\n   292\t\t\t\t\t}\n   293\t\n   294\t\t\t\tcase <-timeoutCh:\n   295\t\t\t\t\tinp.future.respond(fmt.Errorf(\"command timed out\"))\n   296\t\t\t\t\tselect {\n   297\t\t\t\t\tcase i.doneCh <- inp.future:\n   298\t\t\t\t\tcase <-i.shutdownCh:\n   299\t\t\t\t\t\treturn\n   300\t\t\t\t\t}\n   301\t\n   302\t\t\t\tcase <-i.shutdownCh:\n   303\t\t\t\t\treturn\n   304\t\t\t\t}\n   305\t\t\tcase <-i.shutdownCh:\n   306\t\t\t\treturn\n   307\t\t\t}\n   308\t\t}\n   309\t}\n   310\t\n   667\tfunc (r *Raft) leaderLoop() {\n   668\t\t// stepDown is used to track if there is an inflight log that\n   669\t\t// would cause us to lose leadership (specifically a RemovePeer of\n   670\t\t// ourselves). If this is the case, we must not allow any logs to\n   671\t\t// be processed in parallel, otherwise we are basing commit on\n   672\t\t// only a single peer (ourself) and replicating to an undefined set\n   673\t\t// of peers.\n   674\t\tstepDown := false\n   675\t\t// This is only used for the first lease check, we reload lease below\n   676\t\t// based on the current config value.\n   677\t\tlease := time.After(r.config().LeaderLeaseTimeout)\n   678\t\n   679\t\tfor r.getState() == Leader {\n   680\t\t\tr.mainThreadSaturation.sleeping()\n   681\t\n   682\t\t\tselect {\n   683\t\t\tcase rpc := <-r.rpcCh:\n   684\t\t\t\tr.mainThreadSaturation.working()\n   685\t\t\t\tr.processRPC(rpc)\n   686\t\n   687\t\t\tcase <-r.leaderState.stepDown:\n   688\t\t\t\tr.mainThreadSaturation.working()\n   689\t\t\t\tr.setState(Follower)\n   690\t\n   691\t\t\tcase future := <-r.leadershipTransferCh:\n   692\t\t\t\tr.mainThreadSaturation.working()\n   693\t\t\t\tif r.getLeadershipTransferInProgress() {\n   694\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   695\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   696\t\t\t\t\tcontinue\n   697\t\t\t\t}\n   698\t\n   699\t\t\t\tr.logger.Debug(\"starting leadership transfer\", \"id\", future.ID, \"address\", future.Address)\n   700\t\n   701\t\t\t\t// When we are leaving leaderLoop, we are no longer\n   702\t\t\t\t// leader, so we should stop transferring.\n   703\t\t\t\tleftLeaderLoop := make(chan struct{})\n   704\t\t\t\tdefer func() { close(leftLeaderLoop) }()\n   705\t\n   706\t\t\t\tstopCh := make(chan struct{})\n   707\t\t\t\tdoneCh := make(chan error, 1)\n   708\t\n   709\t\t\t\t// This is intentionally being setup outside of the\n  1050\t//\n  1051\t// WARNING! This operation has the leader take on the state of the snapshot and\n  1052\t// then sets itself up so that it replicates that to its followers though the\n  1053\t// install snapshot process. This involves a potentially dangerous period where\n  1054\t// the leader commits ahead of its followers, so should only be used for disaster\n  1055\t// recovery into a fresh cluster, and should not be used in normal operations.\n  1056\tfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n  1057\t\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n  1058\t\tvar timer <-chan time.Time\n  1059\t\tif timeout > 0 {\n  1060\t\t\ttimer = time.After(timeout)\n  1061\t\t}\n  1062\t\n  1063\t\t// Perform the restore.\n  1064\t\trestore := &userRestoreFuture{\n  1065\t\t\tmeta:   meta,\n  1066\t\t\treader: reader,\n  1067\t\t}\n  1068\t\trestore.init()\n  1069\t\tselect {\n  1070\t\tcase <-timer:\n  1071\t\t\treturn ErrEnqueueTimeout\n  1072\t\tcase <-r.shutdownCh:\n  1073\t\t\treturn ErrRaftShutdown\n  1074\t\tcase r.userRestoreCh <- restore:\n  1075\t\t\t// If the restore is ingested then wait for it to complete.\n  1076\t\t\tif err := restore.Error(); err != nil {\n  1077\t\t\t\treturn err\n  1078\t\t\t}\n  1079\t\t}\n  1080\t\n  1081\t\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n  1082\t\t// followers have gotten the restore and replicated at least this new\n  1083\t\t// entry, which shows that we've also faulted and installed the\n  1084\t\t// snapshot with the contents of the restore.\n  1085\t\tnoop := &logFuture{\n  1086\t\t\tlog: Log{\n  1087\t\t\t\tType: LogNoop,\n  1088\t\t\t},\n  1089\t\t}\n  1090\t\tnoop.init()\n  1091\t\tselect {\n  1092\t\tcase <-timer:\n  1093\t\t\treturn ErrEnqueueTimeout\n  1094\t\tcase <-r.shutdownCh:\n  1095\t\t\treturn ErrRaftShutdown\n  1096\t\tcase r.applyCh <- noop:\n  1097\t\t\treturn noop.Error()\n  1098\t\t}\n  1099\t}\n  1100\t\n","exit_code":0,"status":"completed"}}
