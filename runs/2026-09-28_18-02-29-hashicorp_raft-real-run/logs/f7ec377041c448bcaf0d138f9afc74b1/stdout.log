{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/commitment.go; nl -ba ../agent-source/raft.go | sed -n '135,440p'; nl -ba ../agent-source/raft.go | sed -n '455,580p'; nl -ba ../agent-source/api.go | sed -n '807,855p'\"","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"sort\"\n     8\t\t\"sync\"\n     9\t)\n    10\t\n    11\t// Commitment is used to advance the leader's commit index. The leader and\n    12\t// replication goroutines report in newly written entries with match(), and\n    13\t// this notifies on commitCh when the commit index has advanced.\n    14\ttype commitment struct {\n    15\t\t// protects matchIndexes and commitIndex\n    16\t\tsync.Mutex\n    17\t\t// notified when commitIndex increases\n    18\t\tcommitCh chan struct{}\n    19\t\t// voter ID to log index: the server stores up through this log entry\n    20\t\tmatchIndexes map[ServerID]uint64\n    21\t\t// a quorum stores up through this log entry. monotonically increases.\n    22\t\tcommitIndex uint64\n    23\t\t// the first index of this leader's term: this needs to be replicated to a\n    24\t\t// majority of the cluster before this leader may mark anything committed\n    25\t\t// (per Raft's commitment rule)\n    26\t\tstartIndex uint64\n    27\t}\n    28\t\n    29\t// newCommitment returns a commitment struct that notifies the provided\n    30\t// channel when log entries have been committed. A new commitment struct is\n    31\t// created each time this server becomes leader for a particular term.\n    32\t// 'configuration' is the servers in the cluster.\n    33\t// 'startIndex' is the first index created in this term (see\n    34\t// its description above).\n    35\tfunc newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n    36\t\tmatchIndexes := make(map[ServerID]uint64)\n    37\t\tfor _, server := range configuration.Servers {\n    38\t\t\tif server.Suffrage == Voter {\n    39\t\t\t\tmatchIndexes[server.ID] = 0\n    40\t\t\t}\n    41\t\t}\n    42\t\treturn &commitment{\n    43\t\t\tcommitCh:     commitCh,\n    44\t\t\tmatchIndexes: matchIndexes,\n    45\t\t\tcommitIndex:  0,\n    46\t\t\tstartIndex:   startIndex,\n    47\t\t}\n    48\t}\n    49\t\n    50\t// Called when a new cluster membership configuration is created: it will be\n    51\t// used to determine commitment from now on. 'configuration' is the servers in\n    52\t// the cluster.\n    53\tfunc (c *commitment) setConfiguration(configuration Configuration) {\n    54\t\tc.Lock()\n    55\t\tdefer c.Unlock()\n    56\t\toldMatchIndexes := c.matchIndexes\n    57\t\tc.matchIndexes = make(map[ServerID]uint64)\n    58\t\tfor _, server := range configuration.Servers {\n    59\t\t\tif server.Suffrage == Voter {\n    60\t\t\t\tc.matchIndexes[server.ID] = oldMatchIndexes[server.ID] // defaults to 0\n    61\t\t\t}\n    62\t\t}\n    63\t\tc.recalculate()\n    64\t}\n    65\t\n    66\t// Called by leader after commitCh is notified\n    67\tfunc (c *commitment) getCommitIndex() uint64 {\n    68\t\tc.Lock()\n    69\t\tdefer c.Unlock()\n    70\t\treturn c.commitIndex\n    71\t}\n    72\t\n    73\t// Match is called once a server completes writing entries to disk: either the\n    74\t// leader has written the new entry or a follower has replied to an\n    75\t// AppendEntries RPC. The given server's disk agrees with this server's log up\n    76\t// through the given index.\n    77\tfunc (c *commitment) match(server ServerID, matchIndex uint64) {\n    78\t\tc.Lock()\n    79\t\tdefer c.Unlock()\n    80\t\tif prev, hasVote := c.matchIndexes[server]; hasVote && matchIndex > prev {\n    81\t\t\tc.matchIndexes[server] = matchIndex\n    82\t\t\tc.recalculate()\n    83\t\t}\n    84\t}\n    85\t\n    86\t// Internal helper to calculate new commitIndex from matchIndexes.\n    87\t// Must be called with lock held.\n    88\tfunc (c *commitment) recalculate() {\n    89\t\tif len(c.matchIndexes) == 0 {\n    90\t\t\treturn\n    91\t\t}\n    92\t\n    93\t\tmatched := make([]uint64, 0, len(c.matchIndexes))\n    94\t\tfor _, idx := range c.matchIndexes {\n    95\t\t\tmatched = append(matched, idx)\n    96\t\t}\n    97\t\tsort.Sort(uint64Slice(matched))\n    98\t\tquorumMatchIndex := matched[(len(matched)-1)/2]\n    99\t\n   100\t\tif quorumMatchIndex > c.commitIndex && quorumMatchIndex >= c.startIndex {\n   101\t\t\tc.commitIndex = quorumMatchIndex\n   102\t\t\tasyncNotifyCh(c.commitCh)\n   103\t\t}\n   104\t}\n   135\tfunc (r *Raft) run() {\n   136\t\tfor {\n   137\t\t\t// Check if we are doing a shutdown\n   138\t\t\tselect {\n   139\t\t\tcase <-r.shutdownCh:\n   140\t\t\t\t// Clear the leader to prevent forwarding\n   141\t\t\t\tr.setLeader(\"\", \"\")\n   142\t\t\t\treturn\n   143\t\t\tdefault:\n   144\t\t\t}\n   145\t\n   146\t\t\tswitch r.getState() {\n   147\t\t\tcase Follower:\n   148\t\t\t\tr.runFollower()\n   149\t\t\tcase Candidate:\n   150\t\t\t\tr.runCandidate()\n   151\t\t\tcase Leader:\n   152\t\t\t\tr.runLeader()\n   153\t\t\t}\n   154\t\t}\n   155\t}\n   156\t\n   157\t// runFollower runs the main loop while in the follower state.\n   158\tfunc (r *Raft) runFollower() {\n   159\t\tdidWarn := false\n   160\t\tleaderAddr, leaderID := r.LeaderWithID()\n   161\t\tr.logger.Info(\"entering follower state\", \"follower\", r, \"leader-address\", leaderAddr, \"leader-id\", leaderID)\n   162\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"follower\"}, 1)\n   163\t\theartbeatTimer := randomTimeout(r.config().HeartbeatTimeout)\n   164\t\n   165\t\tfor r.getState() == Follower {\n   166\t\t\tr.mainThreadSaturation.sleeping()\n   167\t\n   168\t\t\tselect {\n   169\t\t\tcase rpc := <-r.rpcCh:\n   170\t\t\t\tr.mainThreadSaturation.working()\n   171\t\t\t\tr.processRPC(rpc)\n   172\t\n   173\t\t\tcase c := <-r.configurationChangeCh:\n   174\t\t\t\tr.mainThreadSaturation.working()\n   175\t\t\t\t// Reject any operations since we are not the leader\n   176\t\t\t\tc.respond(ErrNotLeader)\n   177\t\n   178\t\t\tcase a := <-r.applyCh:\n   179\t\t\t\tr.mainThreadSaturation.working()\n   180\t\t\t\t// Reject any operations since we are not the leader\n   181\t\t\t\ta.respond(ErrNotLeader)\n   182\t\n   183\t\t\tcase v := <-r.verifyCh:\n   184\t\t\t\tr.mainThreadSaturation.working()\n   185\t\t\t\t// Reject any operations since we are not the leader\n   186\t\t\t\tv.respond(ErrNotLeader)\n   187\t\n   188\t\t\tcase ur := <-r.userRestoreCh:\n   189\t\t\t\tr.mainThreadSaturation.working()\n   190\t\t\t\t// Reject any restores since we are not the leader\n   191\t\t\t\tur.respond(ErrNotLeader)\n   192\t\n   193\t\t\tcase l := <-r.leadershipTransferCh:\n   194\t\t\t\tr.mainThreadSaturation.working()\n   195\t\t\t\t// Reject any operations since we are not the leader\n   196\t\t\t\tl.respond(ErrNotLeader)\n   197\t\n   198\t\t\tcase c := <-r.configurationsCh:\n   199\t\t\t\tr.mainThreadSaturation.working()\n   200\t\t\t\tc.configurations = r.configurations.Clone()\n   201\t\t\t\tc.respond(nil)\n   202\t\n   203\t\t\tcase b := <-r.bootstrapCh:\n   204\t\t\t\tr.mainThreadSaturation.working()\n   205\t\t\t\tb.respond(r.liveBootstrap(b.configuration))\n   206\t\n   207\t\t\tcase <-r.leaderNotifyCh:\n   208\t\t\t\t//  Ignore since we are not the leader\n   209\t\n   210\t\t\tcase <-r.followerNotifyCh:\n   211\t\t\t\theartbeatTimer = time.After(0)\n   212\t\n   213\t\t\tcase <-heartbeatTimer:\n   214\t\t\t\tr.mainThreadSaturation.working()\n   215\t\t\t\t// Restart the heartbeat timer\n   216\t\t\t\thbTimeout := r.config().HeartbeatTimeout\n   217\t\t\t\theartbeatTimer = randomTimeout(hbTimeout)\n   218\t\n   219\t\t\t\t// Check if we have had a successful contact\n   220\t\t\t\tlastContact := r.LastContact()\n   221\t\t\t\tif time.Since(lastContact) < hbTimeout {\n   222\t\t\t\t\tcontinue\n   223\t\t\t\t}\n   224\t\n   225\t\t\t\t// Heartbeat failed! Transition to the candidate state\n   226\t\t\t\tlastLeaderAddr, lastLeaderID := r.LeaderWithID()\n   227\t\t\t\tr.setLeader(\"\", \"\")\n   228\t\n   229\t\t\t\tif r.configurations.latestIndex == 0 {\n   230\t\t\t\t\tif !didWarn {\n   231\t\t\t\t\t\tr.logger.Warn(\"no known peers, aborting election\")\n   232\t\t\t\t\t\tdidWarn = true\n   233\t\t\t\t\t}\n   234\t\t\t\t} else if r.configurations.latestIndex == r.configurations.committedIndex &&\n   235\t\t\t\t\t!hasVote(r.configurations.latest, r.localID) {\n   236\t\t\t\t\tif !didWarn {\n   237\t\t\t\t\t\tr.logger.Warn(\"not part of stable configuration, aborting election\")\n   238\t\t\t\t\t\tdidWarn = true\n   239\t\t\t\t\t}\n   240\t\t\t\t} else {\n   241\t\t\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"heartbeat_timeout\"}, 1)\n   242\t\t\t\t\tif hasVote(r.configurations.latest, r.localID) {\n   243\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, starting election\", \"last-leader-addr\", lastLeaderAddr, \"last-leader-id\", lastLeaderID)\n   244\t\t\t\t\t\tr.setState(Candidate)\n   245\t\t\t\t\t\treturn\n   246\t\t\t\t\t} else if !didWarn {\n   247\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, not part of a stable configuration or a non-voter, not triggering a leader election\")\n   248\t\t\t\t\t\tdidWarn = true\n   249\t\t\t\t\t}\n   250\t\t\t\t}\n   251\t\n   252\t\t\tcase <-r.shutdownCh:\n   253\t\t\t\treturn\n   254\t\t\t}\n   255\t\t}\n   256\t}\n   257\t\n   258\t// liveBootstrap attempts to seed an initial configuration for the cluster. See\n   259\t// the Raft object's member BootstrapCluster for more details. This must only be\n   260\t// called on the main thread, and only makes sense in the follower state.\n   261\tfunc (r *Raft) liveBootstrap(configuration Configuration) error {\n   262\t\tif !hasVote(configuration, r.localID) {\n   263\t\t\t// Reject this operation since we are not a voter\n   264\t\t\treturn ErrNotVoter\n   265\t\t}\n   266\t\n   267\t\t// Use the pre-init API to make the static updates.\n   268\t\tcfg := r.config()\n   269\t\terr := BootstrapCluster(&cfg, r.logs, r.stable, r.snapshots, r.trans, configuration)\n   270\t\tif err != nil {\n   271\t\t\treturn err\n   272\t\t}\n   273\t\n   274\t\t// Make the configuration live.\n   275\t\tvar entry Log\n   276\t\tif err := r.logs.GetLog(1, &entry); err != nil {\n   277\t\t\tpanic(err)\n   278\t\t}\n   279\t\tr.setCurrentTerm(1)\n   280\t\tr.setLastLog(entry.Index, entry.Term)\n   281\t\treturn r.processConfigurationLogEntry(&entry)\n   282\t}\n   283\t\n   284\t// runCandidate runs the main loop while in the candidate state.\n   285\tfunc (r *Raft) runCandidate() {\n   286\t\tterm := r.getCurrentTerm() + 1\n   287\t\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n   288\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n   289\t\n   290\t\t// Start vote for us, and set a timeout\n   291\t\tvar voteCh <-chan *voteResult\n   292\t\tvar prevoteCh <-chan *preVoteResult\n   293\t\n   294\t\t// check if pre-vote is active and that this is not a leader transfer.\n   295\t\t// Leader transfer do not perform prevote by design\n   296\t\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n   297\t\t\tprevoteCh = r.preElectSelf()\n   298\t\t} else {\n   299\t\t\tvoteCh = r.electSelf()\n   300\t\t}\n   301\t\n   302\t\t// Make sure the leadership transfer flag is reset after each run. Having this\n   303\t\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n   304\t\t// which will make other servers vote even though they have a leader already.\n   305\t\t// It is important to reset that flag, because this privilege could be abused\n   306\t\t// otherwise.\n   307\t\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n   308\t\n   309\t\telectionTimeout := r.config().ElectionTimeout\n   310\t\telectionTimer := randomTimeout(electionTimeout)\n   311\t\n   312\t\t// Tally the votes, need a simple majority\n   313\t\tpreVoteGrantedVotes := 0\n   314\t\tpreVoteRefusedVotes := 0\n   315\t\tgrantedVotes := 0\n   316\t\tvotesNeeded := r.quorumSize()\n   317\t\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n   318\t\n   319\t\tfor r.getState() == Candidate {\n   320\t\t\tr.mainThreadSaturation.sleeping()\n   321\t\n   322\t\t\tselect {\n   323\t\t\tcase rpc := <-r.rpcCh:\n   324\t\t\t\tr.mainThreadSaturation.working()\n   325\t\t\t\tr.processRPC(rpc)\n   326\t\t\tcase preVote := <-prevoteCh:\n   327\t\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n   328\t\t\t\tr.mainThreadSaturation.working()\n   329\t\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   330\t\t\t\t// Check if the term is greater than ours, bail\n   331\t\t\t\tif preVote.Term > term {\n   332\t\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n   333\t\t\t\t\tr.setState(Follower)\n   334\t\t\t\t\tr.setCurrentTerm(preVote.Term)\n   335\t\t\t\t\treturn\n   336\t\t\t\t}\n   337\t\n   338\t\t\t\t// Check if the preVote is granted\n   339\t\t\t\tif preVote.Granted {\n   340\t\t\t\t\tpreVoteGrantedVotes++\n   341\t\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   342\t\t\t\t} else {\n   343\t\t\t\t\tpreVoteRefusedVotes++\n   344\t\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   345\t\t\t\t}\n   346\t\n   347\t\t\t\t// Check if we've won the pre-vote and proceed to election if so\n   348\t\t\t\tif preVoteGrantedVotes >= votesNeeded {\n   349\t\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n   350\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   351\t\t\t\t\tpreVoteGrantedVotes = 0\n   352\t\t\t\t\tpreVoteRefusedVotes = 0\n   353\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   354\t\t\t\t\tprevoteCh = nil\n   355\t\t\t\t\tvoteCh = r.electSelf()\n   356\t\t\t\t}\n   357\t\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n   358\t\t\t\t// prevote.\n   359\t\t\t\tif preVoteRefusedVotes >= votesNeeded {\n   360\t\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n   361\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   362\t\t\t\t}\n   363\t\t\tcase vote := <-voteCh:\n   364\t\t\t\tr.mainThreadSaturation.working()\n   365\t\t\t\t// Check if the term is greater than ours, bail\n   366\t\t\t\tif vote.Term > r.getCurrentTerm() {\n   367\t\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n   368\t\t\t\t\tr.setState(Follower)\n   369\t\t\t\t\tr.setCurrentTerm(vote.Term)\n   370\t\t\t\t\treturn\n   371\t\t\t\t}\n   372\t\n   373\t\t\t\t// Check if the vote is granted\n   374\t\t\t\tif vote.Granted {\n   375\t\t\t\t\tgrantedVotes++\n   376\t\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n   377\t\t\t\t}\n   378\t\n   379\t\t\t\t// Check if we've become the leader\n   380\t\t\t\tif grantedVotes >= votesNeeded {\n   381\t\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n   382\t\t\t\t\tr.setState(Leader)\n   383\t\t\t\t\tr.setLeader(r.localAddr, r.localID)\n   384\t\t\t\t\treturn\n   385\t\t\t\t}\n   386\t\t\tcase c := <-r.configurationChangeCh:\n   387\t\t\t\tr.mainThreadSaturation.working()\n   388\t\t\t\t// Reject any operations since we are not the leader\n   389\t\t\t\tc.respond(ErrNotLeader)\n   390\t\n   391\t\t\tcase a := <-r.applyCh:\n   392\t\t\t\tr.mainThreadSaturation.working()\n   393\t\t\t\t// Reject any operations since we are not the leader\n   394\t\t\t\ta.respond(ErrNotLeader)\n   395\t\n   396\t\t\tcase v := <-r.verifyCh:\n   397\t\t\t\tr.mainThreadSaturation.working()\n   398\t\t\t\t// Reject any operations since we are not the leader\n   399\t\t\t\tv.respond(ErrNotLeader)\n   400\t\n   401\t\t\tcase ur := <-r.userRestoreCh:\n   402\t\t\t\tr.mainThreadSaturation.working()\n   403\t\t\t\t// Reject any restores since we are not the leader\n   404\t\t\t\tur.respond(ErrNotLeader)\n   405\t\n   406\t\t\tcase l := <-r.leadershipTransferCh:\n   407\t\t\t\tr.mainThreadSaturation.working()\n   408\t\t\t\t// Reject any operations since we are not the leader\n   409\t\t\t\tl.respond(ErrNotLeader)\n   410\t\n   411\t\t\tcase c := <-r.configurationsCh:\n   412\t\t\t\tr.mainThreadSaturation.working()\n   413\t\t\t\tc.configurations = r.configurations.Clone()\n   414\t\t\t\tc.respond(nil)\n   415\t\n   416\t\t\tcase b := <-r.bootstrapCh:\n   417\t\t\t\tr.mainThreadSaturation.working()\n   418\t\t\t\tb.respond(ErrCantBootstrap)\n   419\t\n   420\t\t\tcase <-r.leaderNotifyCh:\n   421\t\t\t\t//  Ignore since we are not the leader\n   422\t\n   423\t\t\tcase <-r.followerNotifyCh:\n   424\t\t\t\tif electionTimeout != r.config().ElectionTimeout {\n   425\t\t\t\t\telectionTimeout = r.config().ElectionTimeout\n   426\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   427\t\t\t\t}\n   428\t\n   429\t\t\tcase <-electionTimer:\n   430\t\t\t\tr.mainThreadSaturation.working()\n   431\t\t\t\t// Election failed! Restart the election. We simply return,\n   432\t\t\t\t// which will kick us back into runCandidate\n   433\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n   434\t\t\t\treturn\n   435\t\n   436\t\t\tcase <-r.shutdownCh:\n   437\t\t\t\treturn\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   455\tfunc (r *Raft) setupLeaderState() {\n   456\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n   457\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n   458\t\t\tr.configurations.latest,\n   459\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n   460\t\tr.leaderState.inflight = list.New()\n   461\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n   462\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n   463\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n   464\t}\n   465\t\n   466\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n   467\t// the leaderLoop for the hot loop.\n   468\tfunc (r *Raft) runLeader() {\n   469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n   471\t\n   472\t\t// Notify that we are the leader\n   473\t\toverrideNotifyBool(r.leaderCh, true)\n   474\t\n   475\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n   476\t\t// defer below runs, but this makes sure we always notify the same chan if\n   477\t\t// ever for both gaining and losing leadership.\n   478\t\tnotify := r.config().NotifyCh\n   479\t\n   480\t\t// Push to the notify channel if given\n   481\t\tif notify != nil {\n   482\t\t\tselect {\n   483\t\t\tcase notify <- true:\n   484\t\t\tcase <-r.shutdownCh:\n   485\t\t\t\t// make sure push to the notify channel ( if given )\n   486\t\t\t\tselect {\n   487\t\t\t\tcase notify <- true:\n   488\t\t\t\tdefault:\n   489\t\t\t\t}\n   490\t\t\t}\n   491\t\t}\n   492\t\n   493\t\t// setup leader state. This is only supposed to be accessed within the\n   494\t\t// leaderloop.\n   495\t\tr.setupLeaderState()\n   496\t\n   497\t\t// Run a background go-routine to emit metrics on log age\n   498\t\tstopCh := make(chan struct{})\n   499\t\tgo emitLogStoreMetrics(r.logs, []string{\"raft\", \"leader\"}, oldestLogGaugeInterval, stopCh)\n   500\t\n   501\t\t// Cleanup state on step down\n   502\t\tdefer func() {\n   503\t\t\tclose(stopCh)\n   504\t\n   505\t\t\t// Since we were the leader previously, we update our\n   506\t\t\t// last contact time when we step down, so that we are not\n   507\t\t\t// reporting a last contact time from before we were the\n   508\t\t\t// leader. Otherwise, to a client it would seem our data\n   509\t\t\t// is extremely stale.\n   510\t\t\tr.setLastContact()\n   511\t\n   512\t\t\t// Stop replication\n   513\t\t\tfor _, p := range r.leaderState.replState {\n   514\t\t\t\tclose(p.stopCh)\n   515\t\t\t}\n   516\t\n   517\t\t\t// Respond to all inflight operations\n   518\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   519\t\t\t\te.Value.(*logFuture).respond(ErrLeadershipLost)\n   520\t\t\t}\n   521\t\n   522\t\t\t// Respond to any pending verify requests\n   523\t\t\tfor future := range r.leaderState.notify {\n   524\t\t\t\tfuture.respond(ErrLeadershipLost)\n   525\t\t\t}\n   526\t\n   527\t\t\t// Clear all the state\n   528\t\t\tr.leaderState.commitCh = nil\n   529\t\t\tr.leaderState.commitment = nil\n   530\t\t\tr.leaderState.inflight = nil\n   531\t\t\tr.leaderState.replState = nil\n   532\t\t\tr.leaderState.notify = nil\n   533\t\t\tr.leaderState.stepDown = nil\n   534\t\n   535\t\t\t// If we are stepping down for some reason, no known leader.\n   536\t\t\t// We may have stepped down due to an RPC call, which would\n   537\t\t\t// provide the leader, so we cannot always blank this out.\n   538\t\t\tr.leaderLock.Lock()\n   539\t\t\tif r.leaderAddr == r.localAddr && r.leaderID == r.localID {\n   540\t\t\t\tr.leaderAddr = \"\"\n   541\t\t\t\tr.leaderID = \"\"\n   542\t\t\t}\n   543\t\t\tr.leaderLock.Unlock()\n   544\t\n   545\t\t\t// Notify that we are not the leader\n   546\t\t\toverrideNotifyBool(r.leaderCh, false)\n   547\t\n   548\t\t\t// Push to the notify channel if given\n   549\t\t\tif notify != nil {\n   550\t\t\t\tselect {\n   551\t\t\t\tcase notify <- false:\n   552\t\t\t\tcase <-r.shutdownCh:\n   553\t\t\t\t\t// On shutdown, make a best effort but do not block\n   554\t\t\t\t\tselect {\n   555\t\t\t\t\tcase notify <- false:\n   556\t\t\t\t\tdefault:\n   557\t\t\t\t\t}\n   558\t\t\t\t}\n   559\t\t\t}\n   560\t\t}()\n   561\t\n   562\t\t// Start a replication routine for each peer\n   563\t\tr.startStopReplication()\n   564\t\n   565\t\t// Dispatch a no-op log entry first. This gets this leader up to the latest\n   566\t\t// possible commit index, even in the absence of client commands. This used\n   567\t\t// to append a configuration entry instead of a noop. However, that permits\n   568\t\t// an unbounded number of uncommitted configurations in the log. We now\n   569\t\t// maintain that there exists at most one uncommitted configuration entry in\n   570\t\t// any log, so we have to do proper no-ops here.\n   571\t\tnoop := &logFuture{log: Log{Type: LogNoop}}\n   572\t\tr.dispatchLogs([]*logFuture{noop})\n   573\t\n   574\t\t// Sit in the leader loop until we step down\n   575\t\tr.leaderLoop()\n   576\t}\n   577\t\n   578\t// startStopReplication will set up state and start asynchronous replication to\n   579\t// new peers, and stop replication to removed peers. Before removing a peer,\n   580\t// it'll instruct the replication routines to try to replicate to the current\n   807\t// for the command to be started. This must be run on the leader or it\n   808\t// will fail.\n   809\t//\n   810\t// If the node discovers it is no longer the leader while applying the command,\n   811\t// it will return ErrLeadershipLost. There is no way to guarantee whether the\n   812\t// write succeeded or failed in this case. For example, if the leader is\n   813\t// partitioned it can't know if a quorum of followers wrote the log to disk. If\n   814\t// at least one did, it may survive into the next leader's term.\n   815\t//\n   816\t// If a user snapshot is restored while the command is in-flight, an\n   817\t// ErrAbortedByRestore is returned. In this case the write effectively failed\n   818\t// since its effects will not be present in the FSM after the restore.\n   819\tfunc (r *Raft) Apply(cmd []byte, timeout time.Duration) ApplyFuture {\n   820\t\treturn r.ApplyLog(Log{Data: cmd}, timeout)\n   821\t}\n   822\t\n   823\t// ApplyLog performs Apply but takes in a Log directly. The only values\n   824\t// currently taken from the submitted Log are Data and Extensions. See\n   825\t// Apply for details on error cases.\n   826\tfunc (r *Raft) ApplyLog(log Log, timeout time.Duration) ApplyFuture {\n   827\t\tmetrics.IncrCounter([]string{\"raft\", \"apply\"}, 1)\n   828\t\n   829\t\tvar timer <-chan time.Time\n   830\t\tif timeout > 0 {\n   831\t\t\ttimer = time.After(timeout)\n   832\t\t}\n   833\t\n   834\t\t// Create a log future, no index or term yet\n   835\t\tlogFuture := &logFuture{\n   836\t\t\tlog: Log{\n   837\t\t\t\tType:       LogCommand,\n   838\t\t\t\tData:       log.Data,\n   839\t\t\t\tExtensions: log.Extensions,\n   840\t\t\t},\n   841\t\t}\n   842\t\tlogFuture.init()\n   843\t\n   844\t\tselect {\n   845\t\tcase <-timer:\n   846\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   847\t\tcase <-r.shutdownCh:\n   848\t\t\treturn errorFuture{ErrRaftShutdown}\n   849\t\tcase r.applyCh <- logFuture:\n   850\t\t\treturn logFuture\n   851\t\t}\n   852\t}\n   853\t\n   854\t// Barrier is used to issue a command that blocks until all preceding\n   855\t// operations have been applied to the FSM. It can be used to ensure the\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The code creates fresh replication support for each leader term and requires a majority to reach that term’s first log index before advancing commitment. I’ll trace the reply producers and application path next to distinguish replication acknowledgment, commitment, and client completion."}}
