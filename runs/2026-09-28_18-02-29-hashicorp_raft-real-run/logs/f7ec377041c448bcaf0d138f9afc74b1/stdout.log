{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/raft.go | sed -n '582,665p;745,810p;850,925p;1036,1100p;1203,1390p;1440,1602p'; nl -ba ../agent-source/replication.go | sed -n '202,298p;388,445p;534,570p;646,675p'\"","aggregated_output":"   582\tfunc (r *Raft) startStopReplication() {\n   583\t\tinConfig := make(map[ServerID]bool, len(r.configurations.latest.Servers))\n   584\t\tlastIdx := r.getLastIndex()\n   585\t\n   586\t\t// Start replication goroutines that need starting\n   587\t\tfor _, server := range r.configurations.latest.Servers {\n   588\t\t\tif server.ID == r.localID {\n   589\t\t\t\tcontinue\n   590\t\t\t}\n   591\t\n   592\t\t\tinConfig[server.ID] = true\n   593\t\n   594\t\t\ts, ok := r.leaderState.replState[server.ID]\n   595\t\t\tif !ok {\n   596\t\t\t\tr.logger.Info(\"added peer, starting replication\", \"peer\", server.ID)\n   597\t\t\t\ts = &followerReplication{\n   598\t\t\t\t\tpeer:                server,\n   599\t\t\t\t\tcommitment:          r.leaderState.commitment,\n   600\t\t\t\t\tstopCh:              make(chan uint64, 1),\n   601\t\t\t\t\ttriggerCh:           make(chan struct{}, 1),\n   602\t\t\t\t\ttriggerDeferErrorCh: make(chan *deferError, 1),\n   603\t\t\t\t\tcurrentTerm:         r.getCurrentTerm(),\n   604\t\t\t\t\tnextIndex:           lastIdx + 1,\n   605\t\t\t\t\tlastContact:         time.Now(),\n   606\t\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n   607\t\t\t\t\tnotifyCh:            make(chan struct{}, 1),\n   608\t\t\t\t\tstepDown:            r.leaderState.stepDown,\n   609\t\t\t\t}\n   610\t\n   611\t\t\t\tr.leaderState.replState[server.ID] = s\n   612\t\t\t\tr.goFunc(func() { r.replicate(s) })\n   613\t\t\t\tasyncNotifyCh(s.triggerCh)\n   614\t\t\t\tr.observe(PeerObservation{Peer: server, Removed: false})\n   615\t\t\t} else if ok {\n   616\t\n   617\t\t\t\ts.peerLock.RLock()\n   618\t\t\t\tpeer := s.peer\n   619\t\t\t\ts.peerLock.RUnlock()\n   620\t\n   621\t\t\t\tif peer.Address != server.Address {\n   622\t\t\t\t\tr.logger.Info(\"updating peer\", \"peer\", server.ID)\n   623\t\t\t\t\ts.peerLock.Lock()\n   624\t\t\t\t\ts.peer = server\n   625\t\t\t\t\ts.peerLock.Unlock()\n   626\t\t\t\t}\n   627\t\t\t}\n   628\t\t}\n   629\t\n   630\t\t// Stop replication goroutines that need stopping\n   631\t\tfor serverID, repl := range r.leaderState.replState {\n   632\t\t\tif inConfig[serverID] {\n   633\t\t\t\tcontinue\n   634\t\t\t}\n   635\t\t\t// Replicate up to lastIdx and stop\n   636\t\t\tr.logger.Info(\"removed peer, stopping replication\", \"peer\", serverID, \"last-index\", lastIdx)\n   637\t\t\trepl.stopCh <- lastIdx\n   638\t\t\tclose(repl.stopCh)\n   639\t\t\tdelete(r.leaderState.replState, serverID)\n   640\t\t\tr.observe(PeerObservation{Peer: repl.peer, Removed: true})\n   641\t\t}\n   642\t\n   643\t\t// Update peers metric\n   644\t\tmetrics.SetGauge([]string{\"raft\", \"peers\"}, float32(len(r.configurations.latest.Servers)))\n   645\t}\n   646\t\n   647\t// configurationChangeChIfStable returns r.configurationChangeCh if it's safe\n   648\t// to process requests from it, or nil otherwise. This must only be called\n   649\t// from the main thread.\n   650\t//\n   651\t// Note that if the conditions here were to change outside of leaderLoop to take\n   652\t// this from nil to non-nil, we would need leaderLoop to be kicked.\n   653\tfunc (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n   654\t\t// Have to wait until:\n   655\t\t// 1. The latest configuration is committed, and\n   656\t\t// 2. This leader has committed some entry (the noop) in this term\n   657\t\t//    https://groups.google.com/forum/#!msg/raft-dev/t4xj6dJTP6E/d2D9LrWRza8J\n   658\t\tif r.configurations.latestIndex == r.configurations.committedIndex &&\n   659\t\t\tr.getCommitIndex() >= r.leaderState.commitment.startIndex {\n   660\t\t\treturn r.configurationChangeCh\n   661\t\t}\n   662\t\treturn nil\n   663\t}\n   664\t\n   665\t// leaderLoop is the hot loop for a leader. It is invoked\n   745\t\t\t\t\t\t\t// Wait for up to ElectionTimeout before flagging the\n   746\t\t\t\t\t\t\t// leadership transfer as done and unblocking applies in\n   747\t\t\t\t\t\t\t// the leaderLoop.\n   748\t\t\t\t\t\t\tselect {\n   749\t\t\t\t\t\t\tcase <-time.After(r.config().ElectionTimeout):\n   750\t\t\t\t\t\t\t\terr := fmt.Errorf(\"leadership transfer timeout\")\n   751\t\t\t\t\t\t\t\tr.logger.Debug(err.Error())\n   752\t\t\t\t\t\t\t\tfuture.respond(err)\n   753\t\t\t\t\t\t\tcase <-leftLeaderLoop:\n   754\t\t\t\t\t\t\t\tr.logger.Debug(\"lost leadership during transfer (expected)\")\n   755\t\t\t\t\t\t\t\tfuture.respond(nil)\n   756\t\t\t\t\t\t\t}\n   757\t\t\t\t\t\t}\n   758\t\t\t\t\t}\n   759\t\t\t\t}()\n   760\t\n   761\t\t\t\t// leaderState.replState is accessed here before\n   762\t\t\t\t// starting leadership transfer asynchronously because\n   763\t\t\t\t// leaderState is only supposed to be accessed in the\n   764\t\t\t\t// leaderloop.\n   765\t\t\t\tid := future.ID\n   766\t\t\t\taddress := future.Address\n   767\t\t\t\tif id == nil {\n   768\t\t\t\t\ts := r.pickServer()\n   769\t\t\t\t\tif s != nil {\n   770\t\t\t\t\t\tid = &s.ID\n   771\t\t\t\t\t\taddress = &s.Address\n   772\t\t\t\t\t} else {\n   773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n   774\t\t\t\t\t\tcontinue\n   775\t\t\t\t\t}\n   776\t\t\t\t}\n   777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n   778\t\t\t\tif !ok {\n   779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n   780\t\t\t\t\tcontinue\n   781\t\t\t\t}\n   782\t\t\t\tr.setLeadershipTransferInProgress(true)\n   783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n   784\t\n   785\t\t\tcase <-r.leaderState.commitCh:\n   786\t\t\t\tr.mainThreadSaturation.working()\n   787\t\t\t\t// Process the newly committed entries\n   788\t\t\t\toldCommitIndex := r.getCommitIndex()\n   789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n   790\t\t\t\tr.setCommitIndex(commitIndex)\n   791\t\n   792\t\t\t\t// New configuration has been committed, set it as the committed\n   793\t\t\t\t// value.\n   794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n   795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n   796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n   797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n   798\t\t\t\t\t\tstepDown = true\n   799\t\t\t\t\t}\n   800\t\t\t\t}\n   801\t\n   802\t\t\t\tstart := time.Now()\n   803\t\t\t\tvar groupReady []*list.Element\n   804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n   805\t\t\t\tvar lastIdxInGroup uint64\n   806\t\n   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   850\t\t\t\tif v.quorumSize == 0 {\n   851\t\t\t\t\t// Just dispatched, start the verification\n   852\t\t\t\t\tr.verifyLeader(v)\n   853\t\t\t\t} else if v.votes < v.quorumSize {\n   854\t\t\t\t\t// Early return, means there must be a new leader\n   855\t\t\t\t\tr.logger.Warn(\"new leader elected, stepping down\")\n   856\t\t\t\t\tr.setState(Follower)\n   857\t\t\t\t\tdelete(r.leaderState.notify, v)\n   858\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   859\t\t\t\t\t\trepl.cleanNotify(v)\n   860\t\t\t\t\t}\n   861\t\t\t\t\tv.respond(ErrNotLeader)\n   862\t\n   863\t\t\t\t} else {\n   864\t\t\t\t\t// Quorum of members agree, we are still leader\n   865\t\t\t\t\tdelete(r.leaderState.notify, v)\n   866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   867\t\t\t\t\t\trepl.cleanNotify(v)\n   868\t\t\t\t\t}\n   869\t\t\t\t\tv.respond(nil)\n   870\t\t\t\t}\n   871\t\n   872\t\t\tcase future := <-r.userRestoreCh:\n   873\t\t\t\tr.mainThreadSaturation.working()\n   874\t\t\t\tif r.getLeadershipTransferInProgress() {\n   875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   877\t\t\t\t\tcontinue\n   878\t\t\t\t}\n   879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n   880\t\t\t\tfuture.respond(err)\n   881\t\n   882\t\t\tcase future := <-r.configurationsCh:\n   883\t\t\t\tr.mainThreadSaturation.working()\n   884\t\t\t\tif r.getLeadershipTransferInProgress() {\n   885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   887\t\t\t\t\tcontinue\n   888\t\t\t\t}\n   889\t\t\t\tfuture.configurations = r.configurations.Clone()\n   890\t\t\t\tfuture.respond(nil)\n   891\t\n   892\t\t\tcase future := <-r.configurationChangeChIfStable():\n   893\t\t\t\tr.mainThreadSaturation.working()\n   894\t\t\t\tif r.getLeadershipTransferInProgress() {\n   895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   897\t\t\t\t\tcontinue\n   898\t\t\t\t}\n   899\t\t\t\tr.appendConfigurationEntry(future)\n   900\t\n   901\t\t\tcase b := <-r.bootstrapCh:\n   902\t\t\t\tr.mainThreadSaturation.working()\n   903\t\t\t\tb.respond(ErrCantBootstrap)\n   904\t\n   905\t\t\tcase newLog := <-r.applyCh:\n   906\t\t\t\tr.mainThreadSaturation.working()\n   907\t\t\t\tif r.getLeadershipTransferInProgress() {\n   908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n   910\t\t\t\t\tcontinue\n   911\t\t\t\t}\n   912\t\t\t\t// Group commit, gather all the ready commits\n   913\t\t\t\tready := []*logFuture{newLog}\n   914\t\t\tGROUP_COMMIT_LOOP:\n   915\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n   916\t\t\t\t\tselect {\n   917\t\t\t\t\tcase newLog := <-r.applyCh:\n   918\t\t\t\t\t\tready = append(ready, newLog)\n   919\t\t\t\t\tdefault:\n   920\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n   921\t\t\t\t\t}\n   922\t\t\t\t}\n   923\t\n   924\t\t\t\t// Dispatch the logs\n   925\t\t\t\tif stepDown {\n  1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n  1037\t\t// Track contacted nodes, we can always contact ourself\n  1038\t\tcontacted := 0\n  1039\t\n  1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n  1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n  1042\t\t// changes between iterations below.\n  1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n  1044\t\n  1045\t\t// Check each follower\n  1046\t\tvar maxDiff time.Duration\n  1047\t\tnow := time.Now()\n  1048\t\tfor _, server := range r.configurations.latest.Servers {\n  1049\t\t\tif server.Suffrage == Voter {\n  1050\t\t\t\tif server.ID == r.localID {\n  1051\t\t\t\t\tcontacted++\n  1052\t\t\t\t\tcontinue\n  1053\t\t\t\t}\n  1054\t\t\t\tf := r.leaderState.replState[server.ID]\n  1055\t\t\t\tdiff := now.Sub(f.LastContact())\n  1056\t\t\t\tif diff <= leaseTimeout {\n  1057\t\t\t\t\tcontacted++\n  1058\t\t\t\t\tif diff > maxDiff {\n  1059\t\t\t\t\t\tmaxDiff = diff\n  1060\t\t\t\t\t}\n  1061\t\t\t\t} else {\n  1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n  1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n  1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1065\t\t\t\t\t} else {\n  1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1067\t\t\t\t\t}\n  1068\t\t\t\t}\n  1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n  1070\t\t\t}\n  1071\t\t}\n  1072\t\n  1073\t\t// Verify we can contact a quorum\n  1074\t\tquorum := r.quorumSize()\n  1075\t\tif contacted < quorum {\n  1076\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n  1077\t\t\tr.setState(Follower)\n  1078\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n  1079\t\t}\n  1080\t\treturn maxDiff\n  1081\t}\n  1082\t\n  1083\t// quorumSize is used to return the quorum size. This must only be called on\n  1084\t// the main thread.\n  1085\t// TODO: revisit usage\n  1086\tfunc (r *Raft) quorumSize() int {\n  1087\t\tvoters := 0\n  1088\t\tfor _, server := range r.configurations.latest.Servers {\n  1089\t\t\tif server.Suffrage == Voter {\n  1090\t\t\t\tvoters++\n  1091\t\t\t}\n  1092\t\t}\n  1093\t\treturn voters/2 + 1\n  1094\t}\n  1095\t\n  1096\t// restoreUserSnapshot is used to manually consume an external snapshot, such\n  1097\t// as if restoring from a backup. We will use the current Raft configuration,\n  1098\t// not the one from the snapshot, so that we can restore into a new cluster. We\n  1099\t// will also use the higher of the index of the snapshot, or the current index,\n  1100\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n  1203\tfunc (r *Raft) appendConfigurationEntry(future *configurationChangeFuture) {\n  1204\t\tconfiguration, err := nextConfiguration(r.configurations.latest, r.configurations.latestIndex, future.req)\n  1205\t\tif err != nil {\n  1206\t\t\tfuture.respond(err)\n  1207\t\t\treturn\n  1208\t\t}\n  1209\t\n  1210\t\tr.logger.Info(\"updating configuration\",\n  1211\t\t\t\"command\", future.req.command,\n  1212\t\t\t\"server-id\", future.req.serverID,\n  1213\t\t\t\"server-addr\", future.req.serverAddress,\n  1214\t\t\t\"servers\", hclog.Fmt(\"%+v\", configuration.Servers))\n  1215\t\n  1216\t\t// In pre-ID compatibility mode we translate all configuration changes\n  1217\t\t// in to an old remove peer message, which can handle all supported\n  1218\t\t// cases for peer changes in the pre-ID world (adding and removing\n  1219\t\t// voters). Both add peer and remove peer log entries are handled\n  1220\t\t// similarly on old Raft servers, but remove peer does extra checks to\n  1221\t\t// see if a leader needs to step down. Since they both assert the full\n  1222\t\t// configuration, then we can safely call remove peer for everything.\n  1223\t\tif r.protocolVersion < 2 {\n  1224\t\t\tfuture.log = Log{\n  1225\t\t\t\tType: LogRemovePeerDeprecated,\n  1226\t\t\t\tData: encodePeers(configuration, r.trans),\n  1227\t\t\t}\n  1228\t\t} else {\n  1229\t\t\tfuture.log = Log{\n  1230\t\t\t\tType: LogConfiguration,\n  1231\t\t\t\tData: EncodeConfiguration(configuration),\n  1232\t\t\t}\n  1233\t\t}\n  1234\t\n  1235\t\tr.dispatchLogs([]*logFuture{&future.logFuture})\n  1236\t\tindex := future.Index()\n  1237\t\tr.setLatestConfiguration(configuration, index)\n  1238\t\tr.leaderState.commitment.setConfiguration(configuration)\n  1239\t\tr.startStopReplication()\n  1240\t}\n  1241\t\n  1242\t// dispatchLog is called on the leader to push a log to disk, mark it\n  1243\t// as inflight and begin replication of it.\n  1244\tfunc (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n  1245\t\tnow := time.Now()\n  1246\t\tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n  1247\t\n  1248\t\tterm := r.getCurrentTerm()\n  1249\t\tlastIndex := r.getLastIndex()\n  1250\t\n  1251\t\tn := len(applyLogs)\n  1252\t\tlogs := make([]*Log, n)\n  1253\t\tmetrics.SetGauge([]string{\"raft\", \"leader\", \"dispatchNumLogs\"}, float32(n))\n  1254\t\n  1255\t\tfor idx, applyLog := range applyLogs {\n  1256\t\t\tapplyLog.dispatch = now\n  1257\t\t\tlastIndex++\n  1258\t\t\tapplyLog.log.Index = lastIndex\n  1259\t\t\tapplyLog.log.Term = term\n  1260\t\t\tapplyLog.log.AppendedAt = now\n  1261\t\t\tlogs[idx] = &applyLog.log\n  1262\t\t\tr.leaderState.inflight.PushBack(applyLog)\n  1263\t\t}\n  1264\t\n  1265\t\t// Write the log entry locally\n  1266\t\tif err := r.logs.StoreLogs(logs); err != nil {\n  1267\t\t\tr.logger.Error(\"failed to commit logs\", \"error\", err)\n  1268\t\t\tfor _, applyLog := range applyLogs {\n  1269\t\t\t\tapplyLog.respond(err)\n  1270\t\t\t}\n  1271\t\t\tr.setState(Follower)\n  1272\t\t\treturn\n  1273\t\t}\n  1274\t\tr.leaderState.commitment.match(r.localID, lastIndex)\n  1275\t\n  1276\t\t// Update the last log since it's on disk now\n  1277\t\tr.setLastLog(lastIndex, term)\n  1278\t\n  1279\t\t// Notify the replicators of the new log\n  1280\t\tfor _, f := range r.leaderState.replState {\n  1281\t\t\tasyncNotifyCh(f.triggerCh)\n  1282\t\t}\n  1283\t}\n  1284\t\n  1285\t// processLogs is used to apply all the committed entries that haven't been\n  1286\t// applied up to the given index limit.\n  1287\t// This can be called from both leaders and followers.\n  1288\t// Followers call this from AppendEntries, for n entries at a time, and always\n  1289\t// pass futures=nil.\n  1290\t// Leaders call this when entries are committed. They pass the futures from any\n  1291\t// inflight logs.\n  1292\tfunc (r *Raft) processLogs(index uint64, futures map[uint64]*logFuture) {\n  1293\t\t// Reject logs we've applied already\n  1294\t\tlastApplied := r.getLastApplied()\n  1295\t\tif index <= lastApplied {\n  1296\t\t\tr.logger.Warn(\"skipping application of old log\", \"index\", index)\n  1297\t\t\treturn\n  1298\t\t}\n  1299\t\n  1300\t\tapplyBatch := func(batch []*commitTuple) {\n  1301\t\t\tselect {\n  1302\t\t\tcase r.fsmMutateCh <- batch:\n  1303\t\t\tcase <-r.shutdownCh:\n  1304\t\t\t\tfor _, cl := range batch {\n  1305\t\t\t\t\tif cl.future != nil {\n  1306\t\t\t\t\t\tcl.future.respond(ErrRaftShutdown)\n  1307\t\t\t\t\t}\n  1308\t\t\t\t}\n  1309\t\t\t}\n  1310\t\t}\n  1311\t\n  1312\t\t// Store maxAppendEntries for this call in case it ever becomes reloadable. We\n  1313\t\t// need to use the same value for all lines here to get the expected result.\n  1314\t\tmaxAppendEntries := r.config().MaxAppendEntries\n  1315\t\n  1316\t\tbatch := make([]*commitTuple, 0, maxAppendEntries)\n  1317\t\n  1318\t\t// Apply all the preceding logs\n  1319\t\tfor idx := lastApplied + 1; idx <= index; idx++ {\n  1320\t\t\tvar preparedLog *commitTuple\n  1321\t\t\t// Get the log, either from the future or from our log store\n  1322\t\t\tfuture, futureOk := futures[idx]\n  1323\t\t\tif futureOk {\n  1324\t\t\t\tpreparedLog = r.prepareLog(&future.log, future)\n  1325\t\t\t} else {\n  1326\t\t\t\tl := new(Log)\n  1327\t\t\t\tif err := r.logs.GetLog(idx, l); err != nil {\n  1328\t\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", idx, \"error\", err)\n  1329\t\t\t\t\tpanic(err)\n  1330\t\t\t\t}\n  1331\t\t\t\tpreparedLog = r.prepareLog(l, nil)\n  1332\t\t\t}\n  1333\t\n  1334\t\t\tswitch {\n  1335\t\t\tcase preparedLog != nil:\n  1336\t\t\t\t// If we have a log ready to send to the FSM add it to the batch.\n  1337\t\t\t\t// The FSM thread will respond to the future.\n  1338\t\t\t\tbatch = append(batch, preparedLog)\n  1339\t\n  1340\t\t\t\t// If we have filled up a batch, send it to the FSM\n  1341\t\t\t\tif len(batch) >= maxAppendEntries {\n  1342\t\t\t\t\tapplyBatch(batch)\n  1343\t\t\t\t\tbatch = make([]*commitTuple, 0, maxAppendEntries)\n  1344\t\t\t\t}\n  1345\t\n  1346\t\t\tcase futureOk:\n  1347\t\t\t\t// Invoke the future if given.\n  1348\t\t\t\tfuture.respond(nil)\n  1349\t\t\t}\n  1350\t\t}\n  1351\t\n  1352\t\t// If there are any remaining logs in the batch apply them\n  1353\t\tif len(batch) != 0 {\n  1354\t\t\tapplyBatch(batch)\n  1355\t\t}\n  1356\t\n  1357\t\t// Update the lastApplied index and term\n  1358\t\tr.setLastApplied(index)\n  1359\t}\n  1360\t\n  1361\t// processLog is invoked to process the application of a single committed log entry.\n  1362\tfunc (r *Raft) prepareLog(l *Log, future *logFuture) *commitTuple {\n  1363\t\tswitch l.Type {\n  1364\t\tcase LogBarrier:\n  1365\t\t\t// Barrier is handled by the FSM\n  1366\t\t\tfallthrough\n  1367\t\n  1368\t\tcase LogCommand:\n  1369\t\t\treturn &commitTuple{l, future}\n  1370\t\n  1371\t\tcase LogConfiguration:\n  1372\t\t\t// Only support this with the v2 configuration format\n  1373\t\t\tif r.protocolVersion > 2 {\n  1374\t\t\t\treturn &commitTuple{l, future}\n  1375\t\t\t}\n  1376\t\tcase LogAddPeerDeprecated:\n  1377\t\tcase LogRemovePeerDeprecated:\n  1378\t\tcase LogNoop:\n  1379\t\t\t// Ignore the no-op\n  1380\t\n  1381\t\tdefault:\n  1382\t\t\tpanic(fmt.Errorf(\"unrecognized log type: %#v\", l))\n  1383\t\t}\n  1384\t\n  1385\t\treturn nil\n  1386\t}\n  1387\t\n  1388\t// processRPC is called to handle an incoming RPC request. This must only be\n  1389\t// called from the main thread.\n  1390\tfunc (r *Raft) processRPC(rpc RPC) {\n  1440\tfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n  1441\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n  1442\t\t// Setup a response\n  1443\t\tresp := &AppendEntriesResponse{\n  1444\t\t\tRPCHeader:      r.getRPCHeader(),\n  1445\t\t\tTerm:           r.getCurrentTerm(),\n  1446\t\t\tLastLog:        r.getLastIndex(),\n  1447\t\t\tSuccess:        false,\n  1448\t\t\tNoRetryBackoff: false,\n  1449\t\t}\n  1450\t\tvar rpcErr error\n  1451\t\tdefer func() {\n  1452\t\t\trpc.Respond(resp, rpcErr)\n  1453\t\t}()\n  1454\t\n  1455\t\t// Ignore an older term\n  1456\t\tif a.Term < r.getCurrentTerm() {\n  1457\t\t\treturn\n  1458\t\t}\n  1459\t\n  1460\t\t// Increase the term if we see a newer one, also transition to follower\n  1461\t\t// if we ever get an appendEntries call\n  1462\t\tif a.Term > r.getCurrentTerm() || (r.getState() != Follower && !r.candidateFromLeadershipTransfer.Load()) {\n  1463\t\t\t// Ensure transition to follower\n  1464\t\t\tr.setState(Follower)\n  1465\t\t\tr.setCurrentTerm(a.Term)\n  1466\t\t\tresp.Term = a.Term\n  1467\t\t}\n  1468\t\n  1469\t\t// Save the current leader\n  1470\t\tif len(a.Addr) > 0 {\n  1471\t\t\tr.setLeader(r.trans.DecodePeer(a.Addr), ServerID(a.ID))\n  1472\t\t} else {\n  1473\t\t\tr.setLeader(r.trans.DecodePeer(a.Leader), ServerID(a.ID))\n  1474\t\t}\n  1475\t\t// Verify the last log entry\n  1476\t\tif a.PrevLogEntry > 0 {\n  1477\t\t\tlastIdx, lastTerm := r.getLastEntry()\n  1478\t\n  1479\t\t\tvar prevLogTerm uint64\n  1480\t\t\tif a.PrevLogEntry == lastIdx {\n  1481\t\t\t\tprevLogTerm = lastTerm\n  1482\t\t\t} else {\n  1483\t\t\t\tvar prevLog Log\n  1484\t\t\t\tif err := r.logs.GetLog(a.PrevLogEntry, &prevLog); err != nil {\n  1485\t\t\t\t\tr.logger.Warn(\"failed to get previous log\",\n  1486\t\t\t\t\t\t\"previous-index\", a.PrevLogEntry,\n  1487\t\t\t\t\t\t\"last-index\", lastIdx,\n  1488\t\t\t\t\t\t\"error\", err)\n  1489\t\t\t\t\tresp.NoRetryBackoff = true\n  1490\t\t\t\t\treturn\n  1491\t\t\t\t}\n  1492\t\t\t\tprevLogTerm = prevLog.Term\n  1493\t\t\t}\n  1494\t\n  1495\t\t\tif a.PrevLogTerm != prevLogTerm {\n  1496\t\t\t\tr.logger.Warn(\"previous log term mis-match\",\n  1497\t\t\t\t\t\"ours\", prevLogTerm,\n  1498\t\t\t\t\t\"remote\", a.PrevLogTerm)\n  1499\t\t\t\tresp.NoRetryBackoff = true\n  1500\t\t\t\treturn\n  1501\t\t\t}\n  1502\t\t}\n  1503\t\n  1504\t\t// Process any new entries\n  1505\t\tif len(a.Entries) > 0 {\n  1506\t\t\tstart := time.Now()\n  1507\t\n  1508\t\t\t// Delete any conflicting entries, skip any duplicates\n  1509\t\t\tlastLogIdx, _ := r.getLastLog()\n  1510\t\t\tvar newEntries []*Log\n  1511\t\t\tfor i, entry := range a.Entries {\n  1512\t\t\t\tif entry.Index > lastLogIdx {\n  1513\t\t\t\t\tnewEntries = a.Entries[i:]\n  1514\t\t\t\t\tbreak\n  1515\t\t\t\t}\n  1516\t\t\t\tvar storeEntry Log\n  1517\t\t\t\tif err := r.logs.GetLog(entry.Index, &storeEntry); err != nil {\n  1518\t\t\t\t\tr.logger.Warn(\"failed to get log entry\",\n  1519\t\t\t\t\t\t\"index\", entry.Index,\n  1520\t\t\t\t\t\t\"error\", err)\n  1521\t\t\t\t\treturn\n  1522\t\t\t\t}\n  1523\t\t\t\tif entry.Term != storeEntry.Term {\n  1524\t\t\t\t\tr.logger.Warn(\"clearing log suffix\", \"from\", entry.Index, \"to\", lastLogIdx)\n  1525\t\t\t\t\tif err := r.logs.DeleteRange(entry.Index, lastLogIdx); err != nil {\n  1526\t\t\t\t\t\tr.logger.Error(\"failed to clear log suffix\", \"error\", err)\n  1527\t\t\t\t\t\treturn\n  1528\t\t\t\t\t}\n  1529\t\t\t\t\tif entry.Index <= r.configurations.latestIndex {\n  1530\t\t\t\t\t\tr.setLatestConfiguration(r.configurations.committed, r.configurations.committedIndex)\n  1531\t\t\t\t\t}\n  1532\t\t\t\t\tnewEntries = a.Entries[i:]\n  1533\t\t\t\t\tbreak\n  1534\t\t\t\t}\n  1535\t\t\t}\n  1536\t\n  1537\t\t\tif n := len(newEntries); n > 0 {\n  1538\t\t\t\t// Append the new entries\n  1539\t\t\t\tif err := r.logs.StoreLogs(newEntries); err != nil {\n  1540\t\t\t\t\tr.logger.Error(\"failed to append to logs\", \"error\", err)\n  1541\t\t\t\t\t// TODO: leaving r.getLastLog() in the wrong\n  1542\t\t\t\t\t// state if there was a truncation above\n  1543\t\t\t\t\treturn\n  1544\t\t\t\t}\n  1545\t\n  1546\t\t\t\t// Handle any new configuration changes\n  1547\t\t\t\tfor _, newEntry := range newEntries {\n  1548\t\t\t\t\tif err := r.processConfigurationLogEntry(newEntry); err != nil {\n  1549\t\t\t\t\t\tr.logger.Warn(\"failed to append entry\",\n  1550\t\t\t\t\t\t\t\"index\", newEntry.Index,\n  1551\t\t\t\t\t\t\t\"error\", err)\n  1552\t\t\t\t\t\trpcErr = err\n  1553\t\t\t\t\t\treturn\n  1554\t\t\t\t\t}\n  1555\t\t\t\t}\n  1556\t\n  1557\t\t\t\t// Update the lastLog\n  1558\t\t\t\tlast := newEntries[n-1]\n  1559\t\t\t\tr.setLastLog(last.Index, last.Term)\n  1560\t\t\t}\n  1561\t\n  1562\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"storeLogs\"}, start)\n  1563\t\t}\n  1564\t\n  1565\t\t// Update the commit index\n  1566\t\tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n  1567\t\t\tstart := time.Now()\n  1568\t\t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n  1569\t\t\tr.setCommitIndex(idx)\n  1570\t\t\tif r.configurations.latestIndex <= idx {\n  1571\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1572\t\t\t}\n  1573\t\t\tr.processLogs(idx, nil)\n  1574\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n  1575\t\t}\n  1576\t\n  1577\t\t// Everything went well, set success\n  1578\t\tresp.Success = true\n  1579\t\tr.setLastContact()\n  1580\t}\n  1581\t\n  1582\t// processConfigurationLogEntry takes a log entry and updates the latest\n  1583\t// configuration if the entry results in a new configuration. This must only be\n  1584\t// called from the main thread, or from NewRaft() before any threads have begun.\n  1585\tfunc (r *Raft) processConfigurationLogEntry(entry *Log) error {\n  1586\t\tswitch entry.Type {\n  1587\t\tcase LogConfiguration:\n  1588\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1589\t\t\tr.setLatestConfiguration(DecodeConfiguration(entry.Data), entry.Index)\n  1590\t\n  1591\t\tcase LogAddPeerDeprecated, LogRemovePeerDeprecated:\n  1592\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1593\t\t\tconf, err := decodePeers(entry.Data, r.trans)\n  1594\t\t\tif err != nil {\n  1595\t\t\t\treturn err\n  1596\t\t\t}\n  1597\t\t\tr.setLatestConfiguration(conf, entry.Index)\n  1598\t\t}\n  1599\t\treturn nil\n  1600\t}\n  1601\t\n  1602\t// requestVote is invoked when we get a request vote RPC call.\n   202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n   203\t\t// Create the base request\n   204\t\tvar req AppendEntriesRequest\n   205\t\tvar resp AppendEntriesResponse\n   206\t\tvar start time.Time\n   207\t\tvar peer Server\n   208\t\n   209\tSTART:\n   210\t\t// Prevent an excessive retry rate on errors\n   211\t\tif s.failures > 0 {\n   212\t\t\tselect {\n   213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n   214\t\t\tcase <-r.shutdownCh:\n   215\t\t\t}\n   216\t\t}\n   217\t\n   218\t\ts.peerLock.RLock()\n   219\t\tpeer = s.peer\n   220\t\ts.peerLock.RUnlock()\n   221\t\n   222\t\t// Setup the request\n   223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n   224\t\t\tgoto SEND_SNAP\n   225\t\t} else if err != nil {\n   226\t\t\treturn\n   227\t\t}\n   228\t\n   229\t\t// Make the RPC call\n   230\t\tstart = time.Now()\n   231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n   233\t\t\ts.failures++\n   234\t\t\treturn\n   235\t\t}\n   236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n   237\t\n   238\t\t// Check for a newer term, stop running\n   239\t\tif resp.Term > req.Term {\n   240\t\t\tr.handleStaleTerm(s)\n   241\t\t\treturn true\n   242\t\t}\n   243\t\n   244\t\t// Update the last contact\n   245\t\ts.setLastContact()\n   246\t\n   247\t\t// Update s based on success\n   248\t\tif resp.Success {\n   249\t\t\t// Update our replication state\n   250\t\t\tupdateLastAppended(s, &req)\n   251\t\n   252\t\t\t// Clear any failures, allow pipelining\n   253\t\t\ts.failures = 0\n   254\t\t\ts.allowPipeline = true\n   255\t\t} else {\n   256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n   257\t\t\tif resp.NoRetryBackoff {\n   258\t\t\t\ts.failures = 0\n   259\t\t\t} else {\n   260\t\t\t\ts.failures++\n   261\t\t\t}\n   262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n   263\t\t}\n   264\t\n   265\tCHECK_MORE:\n   266\t\t// Poll the stop channel here in case we are looping and have been asked\n   267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n   268\t\t// where we are asked to replicate to a given index and then shutdown,\n   269\t\t// it's better to not loop in here to send lots of entries to a straggler\n   270\t\t// that's leaving the cluster anyways.\n   271\t\tselect {\n   272\t\tcase <-s.stopCh:\n   273\t\t\treturn true\n   274\t\tdefault:\n   275\t\t}\n   276\t\n   277\t\t// Check if there are more logs to replicate\n   278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n   279\t\t\tgoto START\n   280\t\t}\n   281\t\treturn\n   282\t\n   283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n   284\t\t// is too far behind, and we must ship a snapshot down instead\n   285\tSEND_SNAP:\n   286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n   287\t\t\treturn true\n   288\t\t} else if err != nil {\n   289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n   290\t\t\treturn\n   291\t\t}\n   292\t\n   293\t\t// Check if there is more to replicate\n   294\t\tgoto CHECK_MORE\n   295\t}\n   296\t\n   297\t// sendLatestSnapshot is used to send the latest snapshot we have\n   298\t// down to our follower.\n   388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n   389\t\tvar failures uint64\n   390\t\treq := AppendEntriesRequest{\n   391\t\t\tRPCHeader: r.getRPCHeader(),\n   392\t\t\tTerm:      s.currentTerm,\n   393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n   395\t\t}\n   396\t\n   397\t\tvar resp AppendEntriesResponse\n   398\t\tfor {\n   399\t\t\t// Wait for the next heartbeat interval or forced notify\n   400\t\t\tselect {\n   401\t\t\tcase <-s.notifyCh:\n   402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n   403\t\t\tcase <-stopCh:\n   404\t\t\t\treturn\n   405\t\t\t}\n   406\t\n   407\t\t\ts.peerLock.RLock()\n   408\t\t\tpeer := s.peer\n   409\t\t\ts.peerLock.RUnlock()\n   410\t\n   411\t\t\tstart := time.Now()\n   412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n   414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n   415\t\t\t\t\tnextBackoffTime, \"error\", err)\n   416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n   417\t\t\t\tfailures++\n   418\t\t\t\tselect {\n   419\t\t\t\tcase <-time.After(nextBackoffTime):\n   420\t\t\t\tcase <-stopCh:\n   421\t\t\t\t\treturn\n   422\t\t\t\t}\n   423\t\t\t} else {\n   424\t\t\t\tif failures > 0 {\n   425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n   426\t\t\t\t}\n   427\t\t\t\ts.setLastContact()\n   428\t\t\t\tfailures = 0\n   429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n   431\t\n   432\t\t\t\tif !r.noLegacyTelemetry {\n   433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n   434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n   435\t\t\t\t}\n   436\t\n   437\t\t\t\ts.notifyAll(resp.Success)\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n   443\t// and want to switch to a higher performance pipeline mode of replication.\n   444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n   445\t// back to the standard replication which can handle more complex situations.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   561\t\t\t\t// Update our replication state\n   562\t\t\t\tupdateLastAppended(s, req)\n   563\t\t\tcase <-stopCh:\n   564\t\t\t\treturn\n   565\t\t\t}\n   566\t\t}\n   567\t}\n   568\t\n   569\t// setupAppendEntries is used to setup an append entries request.\n   570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n","exit_code":0,"status":"completed"}}
