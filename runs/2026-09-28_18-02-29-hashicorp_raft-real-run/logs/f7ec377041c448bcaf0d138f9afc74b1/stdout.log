63\t\n    64\t// Server tracks the information about a single server in a configuration.\n    65\ttype Server struct {\n    66\t\t// Suffrage determines whether the server gets a vote.\n    67\t\tSuffrage ServerSuffrage\n    68\t\t// ID is a unique string identifying this server for all time.\n    69\t\tID ServerID\n    70\t\t// Address is its network address that a transport can contact.\n    71\t\tAddress ServerAddress\n    72\t}\n    73\t\n    74\t// Configuration tracks which servers are in the cluster, and whether they have\n    75\t// votes. This should include the local server, if it's a member of the cluster.\n    76\t// The servers are listed no particular order, but each should only appear once.\n    77\t// These entries are appended to the log during membership changes.\n    78\ttype Configuration struct {\n    79\t\tServers []Server\n    80\t}\n    81\t\n    82\t// Clone makes a deep copy of a Configuration.\n    83\tfunc (c *Configuration) Clone() (copy Configuration) {\n    84\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n    85\t\treturn\n   239\tfunc BootstrapCluster(conf *Config, logs LogStore, stable StableStore,\n   240\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n   241\t) error {\n   242\t\t// Validate the Raft server config.\n   243\t\tif err := ValidateConfig(conf); err != nil {\n   244\t\t\treturn err\n   245\t\t}\n   246\t\n   247\t\t// Sanity check the Raft peer configuration.\n   248\t\tif err := checkConfiguration(configuration); err != nil {\n   249\t\t\treturn err\n   250\t\t}\n   251\t\n   252\t\t// Make sure the cluster is in a clean state.\n   253\t\thasState, err := HasExistingState(logs, stable, snaps)\n   254\t\tif err != nil {\n   255\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n   256\t\t}\n   257\t\tif hasState {\n   258\t\t\treturn ErrCantBootstrap\n   259\t\t}\n   260\t\n   261\t\t// Set current term to 1.\n   262\t\tif err := stable.SetUint64(keyCurrentTerm, 1); err != nil {\n   263\t\t\treturn fmt.Errorf(\"failed to save current term: %v\", err)\n   264\t\t}\n   265\t\n   266\t\t// Append configuration entry to log.\n   267\t\tentry := &Log{\n   268\t\t\tIndex: 1,\n   269\t\t\tTerm:  1,\n   270\t\t}\n   271\t\tif conf.ProtocolVersion < 3 {\n   272\t\t\tentry.Type = LogRemovePeerDeprecated\n   273\t\t\tentry.Data = encodePeers(configuration, trans)\n   274\t\t} else {\n   275\t\t\tentry.Type = LogConfiguration\n   276\t\t\tentry.Data = EncodeConfiguration(configuration)\n   277\t\t}\n   278\t\tif err := logs.StoreLog(entry); err != nil {\n   279\t\t\treturn fmt.Errorf(\"failed to append configuration entry to log: %v\", err)\n   280\t\t}\n   281\t\n   282\t\treturn nil\n   283\t}\n   284\t\n   285\t// RecoverCluster is used to manually force a new configuration in order to\n   286\t// recover from a loss of quorum where the current configuration cannot be\n   287\t// restored, such as when several servers die at the same time. This works by\n   288\t// reading all the current state for this server, creating a snapshot with the\n   289\t// supplied configuration, and then truncating the Raft log. This is the only\n   615\t\t})\n   616\t\n   617\t\tfor {\n   618\t\t\tselect {\n   619\t\t\tcase <-connCtx.Done():\n   620\t\t\t\tn.logger.Debug(\"stream layer is closed\")\n   621\t\t\t\treturn\n   622\t\t\tdefault:\n   623\t\t\t}\n   624\t\n   625\t\t\tif err := n.handleCommand(r, dec, enc); err != nil {\n   626\t\t\t\tif err != io.EOF {\n   627\t\t\t\t\tn.logger.Error(\"failed to decode incoming command\", \"error\", err)\n   628\t\t\t\t}\n   629\t\t\t\treturn\n   630\t\t\t}\n   631\t\t\tif err := w.Flush(); err != nil {\n   632\t\t\t\tn.logger.Error(\"failed to flush response\", \"error\", err)\n   633\t\t\t\treturn\n   634\t\t\t}\n   635\t\t}\n   636\t}\n   637\t\n   638\t// handleCommand is used to decode and dispatch a single command.\n   639\tfunc (n *NetworkTransport) handleCommand(r *bufio.Reader, dec *codec.Decoder, enc *codec.Encoder) error {\n   640\t\tgetTypeStart := time.Now()\n   641\t\n   642\t\t// Get the rpc type\n   643\t\trpcType, err := r.ReadByte()\n   644\t\tif err != nil {\n   645\t\t\treturn err\n   646\t\t}\n   647\t\n   648\t\t// measuring the time to get the first byte separately because the heartbeat conn will hang out here\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(id,file,a,b,kind='code_observation'):\n sources.append(dict(id=id,file=file,start_line=a,end_line=b,kind=kind)); return id\nsrc('s-apply','api.go',807,851)\nsrc('s-future-contract','future.go',13,45,'interface_statement')\nsrc('s-future-completion','future.go',100,164)\nsrc('s-commitment','commitment.go',11,104)\nsrc('s-follower','raft.go',135,255)\nsrc('s-election','raft.go',285,440)\nsrc('s-leader-life','raft.go',455,575)\nsrc('s-repl-ownership','raft.go',582,663)\nsrc('s-leader-loop','raft.go',667,987)\nsrc('s-transfer','raft.go',990,1094)\nsrc('s-user-restore','raft.go',1104,1198)\nsrc('s-dispatch','raft.go',1203,1386)\nsrc('s-rpc','raft.go',1390,1600)\nsrc('s-vote','raft.go',1603,1733)\nsrc('s-prevote','raft.go',1736,1808)\nsrc('s-install','raft.go',1814,1953)\nsrc('s-campaign','raft.go',1976,2127)\nsrc('s-stable-context','raft.go',2130,2159)\nsrc('s-timeout-config','raft.go',2209,2227)\nsrc('s-replication','replication.go',100,295)\nsrc('s-snapshot-send','replication.go',299,383)\nsrc('s-heartbeat','replication.go',385,440)\nsrc('s-pipeline','replication.go',534,629)\nsrc('s-match-notify','replication.go',646,665)\nsrc('s-startup','api.go',500,707)\nsrc('s-bootstrap','api.go',239,282)\nsrc('s-fsm','fsm.go',86,214)\nsrc('s-membership-contract','configuration.go',8,79,'interface_statement')\nsrc('s-config-change','configuration.go',194,306)\nsrc('s-verify-api','api.go',880,892,'interface_statement')\nsrc('s-verify-vote','future.go',272,293)\nsrc('s-transport-contract','transport.go',29,140,'interface_statement')\nsrc('s-network-dispatch','net_transport.go',660,740)\nsrc('s-network-pipeline','net_transport.go',839,860)\nsrc('s-inmem-heartbeat','inmem_transport.go',72,79)\nsrc('s-inmem-pipeline','inmem_transport.go',272,308)\nsrc('s-restore-contract','api.go',1050,1099)\nB=[]\ndef behavior(id,act,owner,context,trigger,ss,**kw):\n B.append(dict(id=id,primary_activity=act,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss,**kw))\nbehavior('b-admit','A7','Apply/ApplyLog caller and main Raft loop','A logFuture before index/term assignment','Client submits command',['s-apply','s-follower','s-election','s-leader-loop'],writes=['Create LogCommand future; enqueue on applyCh'],important_branches=['Enqueue timeout and shutdown return error futures. Follower and candidate reject with ErrNotLeader. Leader rejects during transfer or pending removal.'],async_boundaries=['Caller returns a future on enqueue; this is not application completion.'],cross_activity_effects={'A1':'Leader dispatches admitted command batches into its indexed log.'})\nbehavior('b-dispatch','A6','Leader main loop: dispatchLogs','Current leader term and fresh leaderState.commitment','Leader batches applies or emits initial no-op',['s-dispatch','s-leader-life'],writes=['Assign increasing Index and current Term; put futures in inflight.'],durable_effects=['Call LogStore.StoreLogs before matching localID or updating lastLog. Durability depends on selected store.'],important_branches=['Store error responds to futures and sets Follower; it does not call match.'],produces_fact_ids=['f-match'],cross_activity_effects={'A1':'Successful local storage contributes one eligible voter match index.'})\nbehavior('b-append','A6','RPC receiver: appendEntries; main loop or transport heartbeat callback','Request term, previous log identity, incoming entries and local history','AppendEntries request delivered',['s-rpc','s-network-dispatch','s-inmem-heartbeat'],implementation_guards=['Reject older request term; adopt newer term and normally follower state. Validate previous index/term.'],writes=['Delete conflicting suffix; roll latest configuration back to committed if affected; append missing entries; update configurations and lastLog.'],durable_effects=['Successful StoreLogs precedes Success=true for new entries. Duplicate entries need no write.'],important_branches=['Missing or mismatching previous entry rejects with NoRetryBackoff. Read, delete and write errors reject. Failure after suffix deletion can leave cached lastLog stale (source TODO).','If LeaderCommitIndex advances, set min(leader commit, local last index), commit eligible configuration and processLogs. Empty heartbeat has no previous index or commit advancement.'],produces_fact_ids=['f-append-accepted'],cross_activity_effects={'A1':'Normal success supplies a replication acknowledgment and follower consumes leader commit index.','A2':'Append receipt can update durable term and demote local role.'},unknowns=['Fast-path concurrent term transitions require a separate interleaving analysis; comments saying main-thread-only conflict with callback wiring.'])\nbehavior('b-replicate','A1','Per-peer replication worker and pipeline decoder','Captured followerReplication.currentTerm, peer ID, commitment object, request entries','Trigger, CommitTimeout or pipeline completion',['s-replication','s-pipeline','s-match-notify','s-repl-ownership','s-network-pipeline','s-inmem-pipeline'],consumes_fact_ids=['f-append-accepted'],produces_fact_ids=['f-match'],implementation_guards=['Ordinary RPC transport error does not match. Higher reply term invokes handleStaleTerm and stops. Successful nonempty reply matches last request entry.'],important_branches=['Reject backs off nextIndex; missing log invokes snapshot fallback; successful sync enables pipeline. Pipeline checks Term and Success but does not call ready.Error before reading Response.'],async_boundaries=['Captured commitment and stepDown channels belong to one leaderState generation.','Pipeline producer completes futures including error cases before publishing them.'],existing_protections=['Old workers retain old commitment object rather than attaching support to a later leader generation.'],unknowns=['Whether a transport error can leave an apparently successful pipeline Response requires actual decoding/error analysis.'])\nbehavior('b-commit','A1','commitment under mutex','One leader generation, current voter-ID map and startIndex','match or setConfiguration',['s-commitment'],consumes_fact_ids=['f-match'],produces_fact_ids=['f-commit'],implementation_guards=['Only existing voter IDs with increasing index update matchIndexes. Sort indexes and choose majority position. Advance only above old commitIndex and at or above startIndex.'],writes=['commitIndex then async commitCh notification'],important_branches=['Empty voter map does not advance; configuration replacement retains indices only for retained voter IDs.'],existing_protections=['One map slot per voter; current-term first-entry threshold; monotonic commitIndex.'])\nbehavior('b-consume-commit','A5','Leader main loop or follower appendEntries -> processLogs','Log indices after lastApplied through committed bound','Commit notification or advancing LeaderCommitIndex',['s-leader-loop','s-dispatch','s-rpc'],consumes_fact_ids=['f-commit'],produces_fact_ids=['f-fsm-queued'],writes=['Leader records commitIndex, marks configuration committed and associates inflight futures by log index. processLogs retrieves prior entries and queues command/barrier/config tuples.'],important_branches=['Old indices skipped; log read error panics; shutdown responds with error. Noops bypass FSM. Self removal takes effect after committed work is enqueued.'],async_boundaries=['lastApplied advances after enqueue; it does not prove FSM.Apply returned.'],cross_activity_effects={'A7':'Future accompanies its indexed command into FSM worker; queue admission alone does not complete it.'})\nbehavior('b-fsm','A5','runFSM goroutine','Ordered commit tuples with optional logFuture; injected FSM implementation','fsmMutateCh work',['s-fsm','s-future-completion','s-future-contract'],consumes_fact_ids=['f-fsm-queued'],produces_fact_ids=['f-applied'],external_effects=['Invoke FSM.Apply or ApplyBatch; save response on future and respond nil afterwards.'],important_branches=['Batching requires response count equal sent commands/configurations; mismatch panics. Barrier not sent to ApplyBatch. Optional ConfigurationStore receives configurations on single path. Restore opens snapshot, invokes FSM restore then completes restoreFuture.'],cross_activity_effects={'A7':'Error completion synchronizes access to FSM response; application-returned errors are Response values, separate from Raft Error.'})\nbehavior('b-vote','A2','requestVote RPC receiver','Candidate address/ID, request term, local latest configuration and last entry','RequestVote delivered',['s-vote','s-stable-context'],produces_fact_ids=['f-vote-granted'],implementation_guards=['Reject unknown candidate ID when configuration nonempty; reject competing known leader unless transfer; reject old term; reject nonvoter candidate; compare last log term then index.'],durable_effects=['Adopt higher term through stable store. Persist vote term then candidate bytes before granting new vote.'],important_branches=['Duplicate same-term vote grants only matching candidate bytes; it returns before freshness comparison. Storage read/write errors reject; current-term persistence failure panics.'],existing_protections=['Persistent per-term candidate selection and log freshness checks.'],unknowns=['Two separate vote writes: partial-failure/recovery contract of selected StableStore remains to be investigated.'])\nbehavior('b-campaign','A2','runFollower/runCandidate and per-voter request workers','Campaign-local response channels, latest voter configuration and term','Eligible follower timeout, retry timeout, or transfer nomination',['s-follower','s-election','s-campaign','s-prevote','s-timeout-config','s-transfer'],consumes_fact_ids=['f-vote-granted'],produces_fact_ids=['f-leader-generation'],writes=['Pre-vote when supported and enabled; after enough grants persist next term, self vote and dispatch RequestVote to each other voter; tally majority into Leader role.'],important_branches=['Pre-vote unsupported RPC can count as grant only for preliminary round; real election still required. Higher response term demotes. Each campaign has a new buffered response channel; late old replies do not feed next tally.','TimeoutNow selects Candidate and transfer flag; transfer skips pre-vote and permits vote despite known leader. Sender waits for replication nextIndex beyond lastIndex before TimeoutNow.'],existing_protections=['Campaign sources are selected voters; voter IDs unique in validated configuration; one request worker per voter per campaign.'],unknowns=['Transfer timeout races and malformed/untrusted RPC behavior are not evaluated.'])\nbehavior('b-leader-life','A2','runLeader setup and deferred cleanup; leaderLoop','A new leaderState generation with first new index = getLastIndex()+1','Enter or leave Leader role',['s-leader-life','s-leader-loop','s-repl-ownership','s-transfer','s-match-notify'],consumes_fact_ids=['f-leader-generation'],writes=['Fresh commitment/inflight/replState/notification/stepDown objects. Start workers and dispatch initial noop.'],important_branches=['On exit close peer stop channels, fail inflight and pending verification futures with ErrLeadershipLost, clear generation state. Higher-term replication signal, incoming RPC, lease failure or committed self removal can cause exit.'],existing_protections=['New commitment starts with zero matches and current-term threshold. Stored old entries survive; late worker matches update old object.','Lease counts recent contact only for latest voters; it is not a read lease contract.'],cross_activity_effects={'A1':'Prior stored entries can be committed under new leader after current-term support is re-established.','A7':'Leadership loss fails pending futures without proving writes absent from future history.'})\nbehavior('b-config','A4','Main loop: configurationChangeChIfStable/appendConfigurationEntry; follower configuration parser','Latest and committed configuration/index plus current leader generation','Membership change request or incoming configuration entry',['s-repl-ownership','s-dispatch','s-rpc','s-config-change','s-membership-contract'],writes=['New configuration becomes latest after dispatch; commitment voter set changes immediately; replication workers started/stopped for all peers. Incoming next configuration marks previous latest committed.'],implementation_guards=['Leader admission requires latest configuration committed and current-term entry committed. Optional prevIndex must match. Configuration validation rejects duplicate/empty IDs or addresses and zero voters.'],important_branches=['Retained IDs preserve match indices; new voters start at zero. Address updates reuse existing per-ID worker. Follower suffix conflict can revert latest to committed.'],cross_activity_effects={'A1':'Latest voter membership defines which match slots participate in majority.','A2':'Latest voter membership controls elections and lease; committed local removal leads to step-down.'})\nbehavior('b-recover','A3','NewRaft initialization before starting workers','Stable term, log suffix and chosen snapshot','Construct/restart Raft',['s-startup','s-bootstrap','s-rpc'],writes=['Initialize Follower, load stable term and last log, restore first usable snapshot, initialize snapshot/configuration metadata, scan remaining logs for configurations.'],important_branches=['Snapshot restore failure tries older snapshots; if none usable construction fails. NoSnapshotRestoreOnStart skips FSM restore but accepts metadata. Bootstrap rejects existing state and stores term 1/config log 1.'],cross_activity_effects={'A1':'Recovered log and snapshot boundaries supply future replication and vote freshness.','A2':'Volatile leader authority is not restored; loaded term/configuration constrain fresh election.'},unknowns=['Backend persistence guarantees, automatic snapshot production/compaction and forced RecoverCluster internals are not mapped.'])\nbehavior('b-install','A3','Snapshot sender replication worker, receiver main loop and FSM restore worker','Captured leader term, snapshot index/term and configuration','Missing log on replication -> sendLatestSnapshot -> InstallSnapshot',['s-snapshot-send','s-install','s-fsm'],produces_fact_ids=['f-match'],implementation_guards=['Receiver validates version and rejects old term; adopts higher term. Checks transferred length, closes sink, waits for FSM restore. Sender rejects higher reply term and matches only on Success.'],writes=['Receiver updates lastApplied, lastSnapshot and both configurations; compacts/removes logs. Sender sets nextIndex=meta.Index+1 and matches captured peer ID.'],important_branches=['Copy, sink and FSM errors reject. Post-restore compaction errors are logged but success remains possible.'],cross_activity_effects={'A1':'Successful snapshot reply contributes snapshot index to same leader commitment object.','A2':'Snapshot request carries context term and establishes recovered participation metadata.'})\nbehavior('b-heartbeat','A2','Independent per-peer heartbeat goroutine','Captured replication term, peer, shared LastContact and pending verification notifications','Periodic interval or notifyCh',['s-heartbeat','s-replication','s-rpc','s-network-dispatch','s-inmem-heartbeat'],produces_fact_ids=['f-contact','f-verification-notification'],writes=['On transport success update contact timestamp and call notifyAll(resp.Success).'],important_branches=['Transport errors back off and do not update contact; response Term is not inspected here. Negative Success submits negative verification support.'],async_boundaries=['Runs independently of blocked ordinary replication. Network transport dispatches structurally empty heartbeats directly; in-memory transport queues them.'],existing_protections=['Higher-term rejection from appendEntries gives Success=false; pending verification may then force step-down. Ordinary replication and lease still run.'])\nbehavior('b-lease','A2','Leader main loop: checkLeaderLease','Latest voter set, peer contact timestamps and LeaderLeaseTimeout','Lease timer',['s-transfer','s-leader-loop'],consumes_fact_ids=['f-contact'],implementation_guards=['Counts only voters including local self; if contacted count below voter majority set Follower.'],unknowns=['Contact timestamp establishes transport response receipt, not successful acknowledgment of current authority. Whether this distinction permits a relevant bad endpoint needs a controlled schedule.'])\nbehavior('b-notify-replication','A2','Successful replication or snapshot worker; handleStaleTerm','Per-worker pending verification map','Successful append/snapshot or higher-term reply',['s-match-notify','s-snapshot-send','s-replication'],produces_fact_ids=['f-verification-notification'],writes=['notifyAll swaps out pending map under lock and calls vote once per registered future. Successful append/snapshot notifies true; stale term notifies false and signals stepDown.'],existing_protections=['Per-worker map draining prevents repeated notification of same registration.'])\nbehavior('b-verify','A2','verifyLeader registration; verifyFuture.vote; leaderLoop result consumer','Future object, captured voter-majority threshold, replication-worker registrations','Public VerifyLeader enqueues future',['s-verify-api','s-leader-loop','s-verify-vote','s-repl-ownership'],consumes_fact_ids=['f-verification-notification'],writes=['Initialize self vote and voter quorum threshold; register future with all replState workers; first negative or enough positive votes re-enqueues future. LeaderLoop responds success if tally meets threshold, otherwise demotes and returns ErrNotLeader.'],important_branches=['Single-voter threshold completes immediately; registrations do not filter Suffrage. Vote lock and nil notifyCh prevent multiple final notifications. Leader cleanup fails pending verification on exit.'],unknowns=['Need distinguish intended authority guarantee from nonvoter contributions. No observed public completion or stale application read is claimed.'],cross_activity_effects={'A7':'Successful public verification may be used by caller to avoid serving stale FSM data, per API comment.'})\nbehavior('b-user-restore','A3','Leader restoreUserSnapshot and public Restore wrapper','Disaster-recovery operation with stable latest configuration','User Restore request',['s-user-restore','s-restore-contract'],writes=['Abort inflight operations, use current config and term, burn index beyond both current log and supplied snapshot, create and restore snapshot. Public wrapper subsequently waits for noop through applyCh.'],important_branches=['Reject unstable configuration and unsupported version; snapshot/FSM failures handled separately. API explicitly restricts intended use to disaster recovery into a fresh cluster.'],cross_activity_effects={'A1':'Burned log hole drives followers to snapshot fallback; subsequent no-op waits for replication.','A7':'Inflight errors are ErrAbortedByRestore; public Restore completion includes later noop.'})\nF=[]\ndef fact(id,meaning,identity,ctx,rep,dur,rec,ss,**kw):\n F.append(dict(id=id,meaning=meaning,identity=identity,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=ss,**kw))\nfact('f-append-accepted','Receiver completed the append handler with Success=true for this request; new entries passed storage calls and previous-entry checks when supplied. This alone is neither quorum commitment nor FSM completion.',{'request':'Transport-associated AppendEntries request','history':'Request term and previous/log indices'},'Receiver context at handling; empty heartbeat carries no log support',['AppendEntriesResponse.Success'],'Reply is volatile; entry durability depends on LogStore.','History can later be reconciled or restored from snapshot.',['s-rpc'],unknowns=['Transport delivery and request/response correlation remain implementation-dependent.'])\nfact('f-match','An eligible voter slot in this commitment object has an increasing reported stored-through index accepted by match. The slot does not independently validate its producer.',{'generation':'commitment object','server':'ServerID','prefix':'matched log index'},'One leader generation and its current voter map',['commitment.matchIndexes'],'Volatile derived support','Fresh leader starts all slots at zero; storage survives separately.',['s-commitment','s-dispatch','s-match-notify','s-snapshot-send'],invalidators=['b-leader-life'],reinterpreters=['b-config'],unknowns=['Backend guarantees and pipeline error handling may affect meaning of producer reports.'])\nfact('f-commit','Majority order statistic of accepted voter match slots passed this generation startIndex and advanced its commit index.',{'generation':'commitment object','prefix':'commitIndex'},'Current voter set at recalculation; startIndex identifies first new-term entry',['commitment.commitIndex','commitCh notification'],'Volatile aggregation; committed history retained through log/snapshot mechanisms.','Re-established using new leader support and propagated commit information.',['s-commitment'],unknowns=['Follower LeaderCommitIndex consumption is an additional authority input, not a locally recomputed quorum.'])\nfact('f-fsm-queued','A committed command/barrier/configuration tuple was sent to the FSM mutation channel, optionally associated with its original future.',{'entry':'log Index and Term','future':'logFuture pointer if local'},'processLogs committed bound and lastApplied traversal',['commitTuple','fsmMutateCh'],'Volatile queue','Snapshot restore and subsequent committed log traversal reconstruct application state.',['s-dispatch'],unknowns=['Queue admission is not completed application.'])\nfact('f-applied','The FSM Apply/ApplyBatch call for a command returned and its associated future response was assigned before successful response notification.',{'entry':'log Index and Term','future':'logFuture'},'runFSM processed command tuple',['logFuture.response','deferError.errCh'],'Application durability belongs to FSM; completion itself volatile.','FSM snapshot restoration is separate from client future recovery.',['s-fsm','s-future-completion','s-future-contract'])\nfact('f-vote-granted','Receiver granted this term/candidate request after a successful new persistent vote or recognition of the same saved candidate in that term.',{'term':'RequestVoteRequest.Term','candidate':'Encoded candidate address'},'Known configuration/leader and freshness guards apply on the relevant branch',['RequestVoteResponse.Granted','keyLastVoteTerm','keyLastVoteCand'],'Two StableStore writes on new vote, with error returns.','Vote handler rereads persistent keys.',['s-vote','s-stable-context'],unknowns=['Partial-write persistence semantics are not established. Self-vote producer is observed in campaign but not represented as this receiver fact.'])\nfact('f-leader-generation','Campaign tally reached the latest voter majority and selected local Leader role.',{'node':'localID','campaign':'campaign response channel and term'},'Successful real election, following optional pre-vote',['Raft state Leader'],'Volatile role','Restart begins Follower; new campaign required.',['s-election','s-campaign'],invalidators=['b-leader-life','b-append','b-vote','b-lease','b-install'])\nfact('f-contact','A peer response completed without a transport error on heartbeat, and its local contact timestamp was refreshed. This asserts receipt, not current-term authority.',{'worker':'followerReplication','peer':'worker peer ID'},'Local wall-clock observation in one replication generation',['lastContact'],'Volatile timestamp','New worker initializes contact to current time.',['s-heartbeat','s-repl-ownership'],unknowns=['Other mapped replication/snapshot paths also update timestamps; fact is restricted to the heartbeat establishment path until those edges are expanded.'])\nfact('f-verification-notification','A replication worker drained this future registration and submitted a Boolean leadership notification, without carrying peer suffrage or reply term into vote().',{'worker':'followerReplication','future':'verifyFuture pointer'},'Pending worker notification registration in current leader state',['notify map','verifyFuture.vote(bool)'],'Volatile','Pending futures fail on leader exit; not restored.',['s-replication','s-match-notify','s-heartbeat','s-verify-vote'],invalidators=['b-leader-life'],unknowns=['Registration timing versus already in-flight replies and configuration changes needs focused analysis.'])\nroles=json.load(open('../research.json'))['activity_roles']\nacts=[]\nfor a in roles:\n bs=[b for b in B if b['primary_activity']==a]\n acts.append(dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary='; '.join(b['execution_owner'] for b in bs),entry_points=[b['trigger'] for b in bs],source_ids=sorted(set(s for b in bs for s in b['source_ids'])),unknowns=[]))\ndef path(ex,b,f,s): return dict(explanation=ex,behavior_ids=b,fact_ids=f,source_ids=s)\noverview=dict(status='usable',rationale='Source-grounded navigation of normal formation, election/context change, old-work cleanup and necessary membership/recovery/application support. Usable means sufficient initial mechanism understanding for a local question, not a correctness claim or verified fault coverage.',formation=path('ApplyLog creates a command future and sends applyCh. The leader main loop rejects transfer/removal cases or assigns term/index and stores a batch. Successful local storage and successful per-peer append/snapshot paths report indices into the leader-generation commitment. Only current voter slots count; the majority index must reach the first index of this leader term. The commit notification makes the leader record commitIndex, commit configuration changes and enqueue indexed work to processLogs/runFSM. Replication requests propagate LeaderCommitIndex; followers validate previous entries, reconcile/store suffixes and apply the bounded leader commit. FSM return precedes local command future response. Heartbeats omit entries and commit index, and are not log support.', ['b-admit','b-dispatch','b-append','b-replicate','b-commit','b-consume-commit','b-fsm','b-install'],['f-append-accepted','f-match','f-commit','f-fsm-queued','f-applied'],['s-apply','s-dispatch','s-rpc','s-replication','s-pipeline','s-commitment','s-leader-loop','s-fsm']),context=path('A timed-out eligible follower becomes candidate; optional pre-vote precedes a real campaign that persists a new term/self vote and asks configured voters. RequestVote checks membership, known leader, term, saved vote and last-entry freshness. Campaign-local channels isolate old replies. Majority selects Leader; setup creates a fresh commitment object and no-op. Higher-term RPC/reply handling, insufficient recent voter contact, negative verification or committed self removal can demote. Leader exit closes worker stop channels and fails unresolved local futures; captured worker support remains attached to the old object. Transfer waits for target replication and sends TimeoutNow, whose candidate bypasses pre-vote but still seeks real votes. Restart restores term/history/configuration as Follower. Network empty-heartbeat handling can bypass the main RPC queue; it is an actual asynchronous owner, despite main-thread-only comments.', ['b-vote','b-campaign','b-leader-life','b-heartbeat','b-lease','b-verify','b-recover'],['f-vote-granted','f-leader-generation','f-contact','f-verification-notification'],['s-follower','s-election','s-campaign','s-vote','s-leader-life','s-transfer','s-startup','s-network-dispatch','s-rpc']),connection=path('Log and snapshot history survive role changes, while volatile support and client futures do not transfer to a new leader generation. New authority re-establishes index support through real replication and its current-term no-op; voter log-freshness checks connect persisted history to elections. Membership is latest-versus-committed: new leader changes wait for a committed current-term entry and stable configuration, then update voter aggregation and all-peer replication; retained voter IDs preserve their slots. Followers roll back latest configuration on suffix conflict and recover configuration from snapshot/logs. Snapshot installation supplies a prefix match only after storage/FSM restore and response processing; application queueing is distinct from completed application. VerifyLeader uses a separate Boolean notification path and must not be equated with commitment. User Restore is an explicitly restricted disaster-recovery override with aborted inflight futures and a later no-op completion.', ['b-leader-life','b-config','b-vote','b-recover','b-install','b-user-restore','b-verify'],['f-match','f-vote-granted','f-verification-notification'],['s-leader-life','s-commitment','s-repl-ownership','s-config-change','s-rpc','s-vote','s-startup','s-install','s-restore-contract']),core_gaps=[],open_details=['Network heartbeat concurrent context-write interleavings versus main loop; source comments and wiring differ.','VerifyLeader suffrage filtering, response timing and applicable authority contract need discrimination.','Heartbeat contact versus higher-term reply handling: other workers and negative verification may protect authority.','Pipeline error/partial-response semantics relative to AppendFuture.Response contract.','Automatic snapshot creation/compaction, forced RecoverCluster and store-specific crash behavior remain deferred.','No executed operation history, property evidence, or overall correctness conclusion exists.'])\nsurfaces=[dict(entry_point='VerifyLeader / verifyLeader / verifyFuture.vote',disposition='mapped',behavior_ids=['b-verify','b-heartbeat','b-notify-replication'],reason='Threshold counts voters but registrations cover all replication workers. Compare actual nonvoter contribution with API authority promise; lease and negative responses are contrary protections. No violation established.',source_ids=['s-verify-api','s-leader-loop','s-repl-ownership','s-verify-vote'],high_consequence=True),dict(entry_point='heartbeat -> LastContact -> checkLeaderLease',disposition='mapped',behavior_ids=['b-heartbeat','b-lease'],reason='Heartbeat refreshes contact on error-free negative/higher-term response while normal replication checks term. Need same-history schedule preserving protective workers and a sourced endpoint.',source_ids=['s-heartbeat','s-replication','s-transfer'],high_consequence=True),dict(entry_point='pipelineDecode -> AppendFuture.Response',disposition='mapped',behavior_ids=['b-replicate'],reason='Consumer omits Error check required by response interface. Decode producer publishes failed futures. Actual effect of partial decode or timeout remains unknown.',source_ids=['s-pipeline','s-transport-contract','s-network-pipeline','s-inmem-pipeline'],high_consequence=True),dict(entry_point='NetworkTransport heartbeat callback -> appendEntries',disposition='UNCLASSIFIED_PROTOCOL_RESPONSIBILITY',reason='Callback bypasses main queue although handler comments demand main-thread ownership. Map records actual owner; legal concurrent context transitions and synchronization need further reading.',source_ids=['s-network-dispatch','s-rpc','s-startup'],high_consequence=True),dict(entry_point='runSnapshots / RecoverCluster / selected store backends',disposition='deferred',reason='Recovery entry and snapshot consumption traced; snapshot production, forced reconfiguration and storage failure variants remain unread.',source_ids=['s-startup','s-install'],high_consequence=True)]\nm=dict(version=1,target_profile=dict(system_boundary='Captured Go raft package: Raft coordination plus included transports, with injected FSM/LogStore/StableStore/SnapshotStore. Included backend implementations are not treated as external merely because interfaces permit injection.',protocol_contexts=['Raft term','Leader-state generation','Latest and 