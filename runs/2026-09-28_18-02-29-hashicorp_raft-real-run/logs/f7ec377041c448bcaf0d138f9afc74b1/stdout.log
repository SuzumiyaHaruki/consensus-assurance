{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/raft.go | sed -n '807,844p;925,990p;1603,1735p;1814,1955p;1976,2050p;2130,2162p'; nl -ba ../agent-source/api.go | sed -n '500,630p'; nl -ba ../agent-source/fsm.go | sed -n '86,195p'\"","aggregated_output":"   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   811\t\t\t\t\tif idx > commitIndex {\n   812\t\t\t\t\t\t// Don't go past the committed index\n   813\t\t\t\t\t\tbreak\n   814\t\t\t\t\t}\n   815\t\n   816\t\t\t\t\t// Measure the commit time\n   817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n   818\t\t\t\t\tgroupReady = append(groupReady, e)\n   819\t\t\t\t\tgroupFutures[idx] = commitLog\n   820\t\t\t\t\tlastIdxInGroup = idx\n   821\t\t\t\t}\n   822\t\n   823\t\t\t\t// Process the group\n   824\t\t\t\tif len(groupReady) != 0 {\n   825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n   826\t\n   827\t\t\t\t\tfor _, e := range groupReady {\n   828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n   829\t\t\t\t\t}\n   830\t\t\t\t}\n   831\t\n   832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n   833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n   834\t\n   835\t\t\t\t// Count the number of logs enqueued\n   836\t\t\t\tmetrics.SetGauge([]string{\"raft\", \"commitNumLogs\"}, float32(len(groupReady)))\n   837\t\n   838\t\t\t\tif stepDown {\n   839\t\t\t\t\tif r.config().ShutdownOnRemove {\n   840\t\t\t\t\t\tr.logger.Info(\"removed ourself, shutting down\")\n   841\t\t\t\t\t\tr.Shutdown()\n   842\t\t\t\t\t} else {\n   843\t\t\t\t\t\tr.logger.Info(\"removed ourself, transitioning to follower\")\n   844\t\t\t\t\t\tr.setState(Follower)\n   925\t\t\t\tif stepDown {\n   926\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n   927\t\t\t\t\tfor i := range ready {\n   928\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n   929\t\t\t\t\t}\n   930\t\t\t\t} else {\n   931\t\t\t\t\tr.dispatchLogs(ready)\n   932\t\t\t\t}\n   933\t\n   934\t\t\tcase <-lease:\n   935\t\t\t\tr.mainThreadSaturation.working()\n   936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n   937\t\t\t\tmaxDiff := r.checkLeaderLease()\n   938\t\n   939\t\t\t\t// Next check interval should adjust for the last node we've\n   940\t\t\t\t// contacted, without going negative\n   941\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n   942\t\t\t\tif checkInterval < minCheckInterval {\n   943\t\t\t\t\tcheckInterval = minCheckInterval\n   944\t\t\t\t}\n   945\t\n   946\t\t\t\t// Renew the lease timer\n   947\t\t\t\tlease = time.After(checkInterval)\n   948\t\n   949\t\t\tcase <-r.leaderNotifyCh:\n   950\t\t\t\tfor _, repl := range r.leaderState.replState {\n   951\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n   952\t\t\t\t}\n   953\t\n   954\t\t\tcase <-r.followerNotifyCh:\n   955\t\t\t\t//  Ignore since we are not a follower\n   956\t\n   957\t\t\tcase <-r.shutdownCh:\n   958\t\t\t\treturn\n   959\t\t\t}\n   960\t\t}\n   961\t}\n   962\t\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n   988\t\n   989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n  1603\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n  1604\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n  1605\t\tr.observe(*req)\n  1606\t\n  1607\t\t// Setup a response\n  1608\t\tresp := &RequestVoteResponse{\n  1609\t\t\tRPCHeader: r.getRPCHeader(),\n  1610\t\t\tTerm:      r.getCurrentTerm(),\n  1611\t\t\tGranted:   false,\n  1612\t\t}\n  1613\t\tvar rpcErr error\n  1614\t\tdefer func() {\n  1615\t\t\trpc.Respond(resp, rpcErr)\n  1616\t\t}()\n  1617\t\n  1618\t\t// Version 0 servers will panic unless the peers is present. It's only\n  1619\t\t// used on them to produce a warning message.\n  1620\t\tif r.protocolVersion < 2 {\n  1621\t\t\tresp.Peers = encodePeers(r.configurations.latest, r.trans)\n  1622\t\t}\n  1623\t\n  1624\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1625\t\t// check the LeadershipTransfer flag is set. Usually votes are rejected if\n  1626\t\t// there is a known leader. But if the leader initiated a leadership transfer,\n  1627\t\t// vote!\n  1628\t\tvar candidate ServerAddress\n  1629\t\tvar candidateBytes []byte\n  1630\t\tif len(req.RPCHeader.Addr) > 0 {\n  1631\t\t\tcandidate = r.trans.DecodePeer(req.RPCHeader.Addr)\n  1632\t\t\tcandidateBytes = req.RPCHeader.Addr\n  1633\t\t} else {\n  1634\t\t\tcandidate = r.trans.DecodePeer(req.Candidate)\n  1635\t\t\tcandidateBytes = req.Candidate\n  1636\t\t}\n  1637\t\n  1638\t\t// For older raft version ID is not part of the packed message\n  1639\t\t// We assume that the peer is part of the configuration and skip this check\n  1640\t\tif len(req.ID) > 0 {\n  1641\t\t\tcandidateID := ServerID(req.ID)\n  1642\t\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1643\t\t\t// Grant the vote\n  1644\t\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1645\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not in configuration\",\n  1646\t\t\t\t\t\"from\", candidate)\n  1647\t\t\t\treturn\n  1648\t\t\t}\n  1649\t\t}\n  1650\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate && !req.LeadershipTransfer {\n  1651\t\t\tr.logger.Warn(\"rejecting vote request since we have a leader\",\n  1652\t\t\t\t\"from\", candidate,\n  1653\t\t\t\t\"leader\", leaderAddr,\n  1654\t\t\t\t\"leader-id\", string(leaderID))\n  1655\t\t\treturn\n  1656\t\t}\n  1657\t\n  1658\t\t// Ignore an older term\n  1659\t\tif req.Term < r.getCurrentTerm() {\n  1660\t\t\treturn\n  1661\t\t}\n  1662\t\n  1663\t\t// Increase the term if we see a newer one\n  1664\t\tif req.Term > r.getCurrentTerm() {\n  1665\t\t\t// Ensure transition to follower\n  1666\t\t\tr.logger.Debug(\"lost leadership because received a requestVote with a newer term\")\n  1667\t\t\tr.setState(Follower)\n  1668\t\t\tr.setCurrentTerm(req.Term)\n  1669\t\n  1670\t\t\tresp.Term = req.Term\n  1671\t\t}\n  1672\t\n  1673\t\t// if we get a request for vote from a nonVoter  and the request term is higher,\n  1674\t\t// step down and update term, but reject the vote request\n  1675\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1676\t\t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n  1677\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n  1678\t\tif len(req.ID) > 0 {\n  1679\t\t\tcandidateID := ServerID(req.ID)\n  1680\t\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1681\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n  1682\t\t\t\treturn\n  1683\t\t\t}\n  1684\t\t}\n  1685\t\t// Check if we have voted yet\n  1686\t\tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n  1687\t\tif err != nil && err.Error() != \"not found\" {\n  1688\t\t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n  1689\t\t\treturn\n  1690\t\t}\n  1691\t\tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n  1692\t\tif err != nil && err.Error() != \"not found\" {\n  1693\t\t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n  1694\t\t\treturn\n  1695\t\t}\n  1696\t\n  1697\t\t// Check if we've voted in this election before\n  1698\t\tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n  1699\t\t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n  1700\t\t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n  1701\t\t\t\tr.logger.Warn(\"duplicate requestVote from\", \"candidate\", candidate)\n  1702\t\t\t\tresp.Granted = true\n  1703\t\t\t}\n  1704\t\t\treturn\n  1705\t\t}\n  1706\t\n  1707\t\t// Reject if their term is older\n  1708\t\tlastIdx, lastTerm := r.getLastEntry()\n  1709\t\tif lastTerm > req.LastLogTerm {\n  1710\t\t\tr.logger.Warn(\"rejecting vote request since our last term is greater\",\n  1711\t\t\t\t\"candidate\", candidate,\n  1712\t\t\t\t\"last-term\", lastTerm,\n  1713\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1714\t\t\treturn\n  1715\t\t}\n  1716\t\n  1717\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1718\t\t\tr.logger.Warn(\"rejecting vote request since our last index is greater\",\n  1719\t\t\t\t\"candidate\", candidate,\n  1720\t\t\t\t\"last-index\", lastIdx,\n  1721\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1722\t\t\treturn\n  1723\t\t}\n  1724\t\n  1725\t\t// Persist a vote for safety\n  1726\t\tif err := r.persistVote(req.Term, candidateBytes); err != nil {\n  1727\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  1728\t\t\treturn\n  1729\t\t}\n  1730\t\n  1731\t\tresp.Granted = true\n  1732\t\tr.setLastContact()\n  1733\t}\n  1734\t\n  1735\t// requestPreVote is invoked when we get a request Pre-Vote RPC call.\n  1814\tfunc (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n  1815\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"installSnapshot\"}, time.Now())\n  1816\t\t// Setup a response\n  1817\t\tresp := &InstallSnapshotResponse{\n  1818\t\t\tTerm:    r.getCurrentTerm(),\n  1819\t\t\tSuccess: false,\n  1820\t\t}\n  1821\t\tvar rpcErr error\n  1822\t\tdefer func() {\n  1823\t\t\t_, _ = io.Copy(io.Discard, rpc.Reader) // ensure we always consume all the snapshot data from the stream [see issue #212]\n  1824\t\t\trpc.Respond(resp, rpcErr)\n  1825\t\t}()\n  1826\t\n  1827\t\t// Sanity check the version\n  1828\t\tif req.SnapshotVersion < SnapshotVersionMin ||\n  1829\t\t\treq.SnapshotVersion > SnapshotVersionMax {\n  1830\t\t\trpcErr = fmt.Errorf(\"unsupported snapshot version %d\", req.SnapshotVersion)\n  1831\t\t\treturn\n  1832\t\t}\n  1833\t\n  1834\t\t// Ignore an older term\n  1835\t\tif req.Term < r.getCurrentTerm() {\n  1836\t\t\tr.logger.Info(\"ignoring installSnapshot request with older term than current term\",\n  1837\t\t\t\t\"request-term\", req.Term,\n  1838\t\t\t\t\"current-term\", r.getCurrentTerm())\n  1839\t\t\treturn\n  1840\t\t}\n  1841\t\n  1842\t\t// Increase the term if we see a newer one\n  1843\t\tif req.Term > r.getCurrentTerm() {\n  1844\t\t\t// Ensure transition to follower\n  1845\t\t\tr.setState(Follower)\n  1846\t\t\tr.setCurrentTerm(req.Term)\n  1847\t\t\tresp.Term = req.Term\n  1848\t\t}\n  1849\t\n  1850\t\t// Save the current leader\n  1851\t\tif len(req.ID) > 0 {\n  1852\t\t\tr.setLeader(r.trans.DecodePeer(req.RPCHeader.Addr), ServerID(req.ID))\n  1853\t\t} else {\n  1854\t\t\tr.setLeader(r.trans.DecodePeer(req.Leader), ServerID(req.ID))\n  1855\t\t}\n  1856\t\n  1857\t\t// Create a new snapshot\n  1858\t\tvar reqConfiguration Configuration\n  1859\t\tvar reqConfigurationIndex uint64\n  1860\t\tif req.SnapshotVersion > 0 {\n  1861\t\t\treqConfiguration = DecodeConfiguration(req.Configuration)\n  1862\t\t\treqConfigurationIndex = req.ConfigurationIndex\n  1863\t\t} else {\n  1864\t\t\treqConfiguration, rpcErr = decodePeers(req.Peers, r.trans)\n  1865\t\t\tif rpcErr != nil {\n  1866\t\t\t\tr.logger.Error(\"failed to install snapshot\", \"error\", rpcErr)\n  1867\t\t\t\treturn\n  1868\t\t\t}\n  1869\t\t\treqConfigurationIndex = req.LastLogIndex\n  1870\t\t}\n  1871\t\tversion := getSnapshotVersion(r.protocolVersion)\n  1872\t\tsink, err := r.snapshots.Create(version, req.LastLogIndex, req.LastLogTerm,\n  1873\t\t\treqConfiguration, reqConfigurationIndex, r.trans)\n  1874\t\tif err != nil {\n  1875\t\t\tr.logger.Error(\"failed to create snapshot to install\", \"error\", err)\n  1876\t\t\trpcErr = fmt.Errorf(\"failed to create snapshot: %v\", err)\n  1877\t\t\treturn\n  1878\t\t}\n  1879\t\n  1880\t\t// Separately track the progress of streaming a snapshot over the network\n  1881\t\t// because this too can take a long time.\n  1882\t\tcountingRPCReader := newCountingReader(rpc.Reader)\n  1883\t\n  1884\t\t// Spill the remote snapshot to disk\n  1885\t\ttransferMonitor := startSnapshotRestoreMonitor(r.logger, countingRPCReader, req.Size, true)\n  1886\t\tn, err := io.Copy(sink, countingRPCReader)\n  1887\t\ttransferMonitor.StopAndWait()\n  1888\t\tif err != nil {\n  1889\t\t\tsink.Cancel()\n  1890\t\t\tr.logger.Error(\"failed to copy snapshot\", \"error\", err)\n  1891\t\t\trpcErr = err\n  1892\t\t\treturn\n  1893\t\t}\n  1894\t\n  1895\t\t// Check that we received it all\n  1896\t\tif n != req.Size {\n  1897\t\t\tsink.Cancel()\n  1898\t\t\tr.logger.Error(\"failed to receive whole snapshot\",\n  1899\t\t\t\t\"received\", hclog.Fmt(\"%d / %d\", n, req.Size))\n  1900\t\t\trpcErr = fmt.Errorf(\"short read\")\n  1901\t\t\treturn\n  1902\t\t}\n  1903\t\n  1904\t\t// Finalize the snapshot\n  1905\t\tif err := sink.Close(); err != nil {\n  1906\t\t\tr.logger.Error(\"failed to finalize snapshot\", \"error\", err)\n  1907\t\t\trpcErr = err\n  1908\t\t\treturn\n  1909\t\t}\n  1910\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n  1911\t\n  1912\t\t// Restore snapshot\n  1913\t\tfuture := &restoreFuture{ID: sink.ID()}\n  1914\t\tfuture.ShutdownCh = r.shutdownCh\n  1915\t\tfuture.init()\n  1916\t\tselect {\n  1917\t\tcase r.fsmMutateCh <- future:\n  1918\t\tcase <-r.shutdownCh:\n  1919\t\t\tfuture.respond(ErrRaftShutdown)\n  1920\t\t\treturn\n  1921\t\t}\n  1922\t\n  1923\t\t// Wait for the restore to happen\n  1924\t\tif err := future.Error(); err != nil {\n  1925\t\t\tr.logger.Error(\"failed to restore snapshot\", \"error\", err)\n  1926\t\t\trpcErr = err\n  1927\t\t\treturn\n  1928\t\t}\n  1929\t\n  1930\t\t// Update the lastApplied so we don't replay old logs\n  1931\t\tr.setLastApplied(req.LastLogIndex)\n  1932\t\n  1933\t\t// Update the last stable snapshot info\n  1934\t\tr.setLastSnapshot(req.LastLogIndex, req.LastLogTerm)\n  1935\t\n  1936\t\t// Restore the peer set\n  1937\t\tr.setLatestConfiguration(reqConfiguration, reqConfigurationIndex)\n  1938\t\tr.setCommittedConfiguration(reqConfiguration, reqConfigurationIndex)\n  1939\t\n  1940\t\t// Clear old logs if r.logs is a MonotonicLogStore. Otherwise compact the\n  1941\t\t// logs. In both cases, log any errors and continue.\n  1942\t\tif mlogs, ok := r.logs.(MonotonicLogStore); ok && mlogs.IsMonotonic() {\n  1943\t\t\tif err := r.removeOldLogs(); err != nil {\n  1944\t\t\t\tr.logger.Error(\"failed to reset logs\", \"error\", err)\n  1945\t\t\t}\n  1946\t\t} else if err := r.compactLogs(req.LastLogIndex); err != nil {\n  1947\t\t\tr.logger.Error(\"failed to compact logs\", \"error\", err)\n  1948\t\t}\n  1949\t\n  1950\t\tr.logger.Info(\"Installed remote snapshot\")\n  1951\t\tresp.Success = true\n  1952\t\tr.setLastContact()\n  1953\t}\n  1954\t\n  1955\t// setLastContact is used to set the last contact time to now\n  1976\tfunc (r *Raft) electSelf() <-chan *voteResult {\n  1977\t\t// Create a response channel\n  1978\t\trespCh := make(chan *voteResult, len(r.configurations.latest.Servers))\n  1979\t\n  1980\t\t// Increment the term\n  1981\t\tnewTerm := r.getCurrentTerm() + 1\n  1982\t\n  1983\t\tr.setCurrentTerm(newTerm)\n  1984\t\t// Construct the request\n  1985\t\tlastIdx, lastTerm := r.getLastEntry()\n  1986\t\treq := &RequestVoteRequest{\n  1987\t\t\tRPCHeader: r.getRPCHeader(),\n  1988\t\t\tTerm:      newTerm,\n  1989\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n  1990\t\t\tCandidate:          r.trans.EncodePeer(r.localID, r.localAddr),\n  1991\t\t\tLastLogIndex:       lastIdx,\n  1992\t\t\tLastLogTerm:        lastTerm,\n  1993\t\t\tLeadershipTransfer: r.candidateFromLeadershipTransfer.Load(),\n  1994\t\t}\n  1995\t\n  1996\t\t// Construct a function to ask for a vote\n  1997\t\taskPeer := func(peer Server) {\n  1998\t\t\tr.goFunc(func() {\n  1999\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n  2000\t\t\t\tresp := &voteResult{voterID: peer.ID}\n  2001\t\t\t\terr := r.trans.RequestVote(peer.ID, peer.Address, req, &resp.RequestVoteResponse)\n  2002\t\t\t\tif err != nil {\n  2003\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n  2004\t\t\t\t\t\t\"target\", peer,\n  2005\t\t\t\t\t\t\"error\", err,\n  2006\t\t\t\t\t\t\"term\", req.Term)\n  2007\t\t\t\t\tresp.Term = req.Term\n  2008\t\t\t\t\tresp.Granted = false\n  2009\t\t\t\t}\n  2010\t\t\t\trespCh <- resp\n  2011\t\t\t})\n  2012\t\t}\n  2013\t\n  2014\t\t// For each peer, request a vote\n  2015\t\tfor _, server := range r.configurations.latest.Servers {\n  2016\t\t\tif server.Suffrage == Voter {\n  2017\t\t\t\tif server.ID == r.localID {\n  2018\t\t\t\t\tr.logger.Debug(\"voting for self\", \"term\", req.Term, \"id\", r.localID)\n  2019\t\n  2020\t\t\t\t\t// Persist a vote for ourselves\n  2021\t\t\t\t\tif err := r.persistVote(req.Term, req.RPCHeader.Addr); err != nil {\n  2022\t\t\t\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  2023\t\t\t\t\t\treturn nil\n  2024\t\n  2025\t\t\t\t\t}\n  2026\t\t\t\t\t// Include our own vote\n  2027\t\t\t\t\trespCh <- &voteResult{\n  2028\t\t\t\t\t\tRequestVoteResponse: RequestVoteResponse{\n  2029\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n  2030\t\t\t\t\t\t\tTerm:      req.Term,\n  2031\t\t\t\t\t\t\tGranted:   true,\n  2032\t\t\t\t\t\t},\n  2033\t\t\t\t\t\tvoterID: r.localID,\n  2034\t\t\t\t\t}\n  2035\t\t\t\t} else {\n  2036\t\t\t\t\tr.logger.Debug(\"asking for vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2037\t\t\t\t\taskPeer(server)\n  2038\t\t\t\t}\n  2039\t\t\t}\n  2040\t\t}\n  2041\t\n  2042\t\treturn respCh\n  2043\t}\n  2044\t\n  2045\t// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\n  2046\t// ourself. This will not increment the current term. The\n  2047\t// response channel returned is used to wait for all the responses (including a\n  2048\t// vote for ourself).\n  2049\t// This must only be called from the main thread.\n  2050\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n  2130\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n  2131\t\tif err := r.stable.SetUint64(keyLastVoteTerm, term); err != nil {\n  2132\t\t\treturn err\n  2133\t\t}\n  2134\t\tif err := r.stable.Set(keyLastVoteCand, candidate); err != nil {\n  2135\t\t\treturn err\n  2136\t\t}\n  2137\t\treturn nil\n  2138\t}\n  2139\t\n  2140\t// setCurrentTerm is used to set the current term in a durable manner.\n  2141\tfunc (r *Raft) setCurrentTerm(t uint64) {\n  2142\t\t// Persist to disk first\n  2143\t\tif err := r.stable.SetUint64(keyCurrentTerm, t); err != nil {\n  2144\t\t\tpanic(fmt.Errorf(\"failed to save current term: %v\", err))\n  2145\t\t}\n  2146\t\tr.raftState.setCurrentTerm(t)\n  2147\t}\n  2148\t\n  2149\t// setState is used to update the current state. Any state\n  2150\t// transition causes the known leader to be cleared. This means\n  2151\t// that leader should be set only after updating the state.\n  2152\tfunc (r *Raft) setState(state RaftState) {\n  2153\t\tr.setLeader(\"\", \"\")\n  2154\t\toldState := r.raftState.getState()\n  2155\t\tr.raftState.setState(state)\n  2156\t\tif oldState != state {\n  2157\t\t\tr.observe(state)\n  2158\t\t}\n  2159\t}\n  2160\t\n  2161\t// pickServer returns the follower that is most up to date and participating in quorum.\n  2162\t// Because it accesses leaderstate, it should only be called from the leaderloop.\n   500\tfunc NewRaft(conf *Config, fsm FSM, logs LogStore, stable StableStore, snaps SnapshotStore, trans Transport) (*Raft, error) {\n   501\t\t// Validate the configuration.\n   502\t\tif err := ValidateConfig(conf); err != nil {\n   503\t\t\treturn nil, err\n   504\t\t}\n   505\t\n   506\t\t// Ensure we have a LogOutput.\n   507\t\tlogger := conf.getOrCreateLogger()\n   508\t\n   509\t\t// Try to restore the current term.\n   510\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   511\t\tif err != nil && err.Error() != \"not found\" {\n   512\t\t\treturn nil, fmt.Errorf(\"failed to load current term: %v\", err)\n   513\t\t}\n   514\t\n   515\t\t// Read the index of the last log entry.\n   516\t\tlastIndex, err := logs.LastIndex()\n   517\t\tif err != nil {\n   518\t\t\treturn nil, fmt.Errorf(\"failed to find last log: %v\", err)\n   519\t\t}\n   520\t\n   521\t\t// Get the last log entry.\n   522\t\tvar lastLog Log\n   523\t\tif lastIndex > 0 {\n   524\t\t\tif err = logs.GetLog(lastIndex, &lastLog); err != nil {\n   525\t\t\t\treturn nil, fmt.Errorf(\"failed to get last log at index %d: %v\", lastIndex, err)\n   526\t\t\t}\n   527\t\t}\n   528\t\n   529\t\t// Make sure we have a valid server address and ID.\n   530\t\tprotocolVersion := conf.ProtocolVersion\n   531\t\tlocalAddr := trans.LocalAddr()\n   532\t\tlocalID := conf.LocalID\n   533\t\n   534\t\t// TODO (slackpad) - When we deprecate protocol version 2, remove this\n   535\t\t// along with the AddPeer() and RemovePeer() APIs.\n   536\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   537\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   538\t\t}\n   539\t\n   540\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   541\t\tapplyCh := make(chan *logFuture)\n   542\t\tif conf.BatchApplyCh {\n   543\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   544\t\t}\n   545\t\n   546\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   547\t\t// Create Raft struct.\n   548\t\tr := &Raft{\n   549\t\t\tprotocolVersion:       protocolVersion,\n   550\t\t\tapplyCh:               applyCh,\n   551\t\t\tfsm:                   fsm,\n   552\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   553\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   554\t\t\tleaderCh:              make(chan bool, 1),\n   555\t\t\tlocalID:               localID,\n   556\t\t\tlocalAddr:             localAddr,\n   557\t\t\tlogger:                logger,\n   558\t\t\tlogs:                  logs,\n   559\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   560\t\t\tconfigurations:        configurations{},\n   561\t\t\trpcCh:                 trans.Consumer(),\n   562\t\t\tsnapshots:             snaps,\n   563\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n   564\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n   565\t\t\tshutdownCh:            make(chan struct{}),\n   566\t\t\tstable:                stable,\n   567\t\t\ttrans:                 trans,\n   568\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n   569\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n   570\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   571\t\t\tobservers:             make(map[uint64]*Observer),\n   572\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   573\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   574\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   575\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   576\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   577\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   578\t\t}\n   579\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   580\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   581\t\t}\n   582\t\n   583\t\tr.conf.Store(*conf)\n   584\t\n   585\t\t// Initialize as a follower.\n   586\t\tr.setState(Follower)\n   587\t\n   588\t\t// Restore the current term and the last log.\n   589\t\tr.setCurrentTerm(currentTerm)\n   590\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   591\t\n   592\t\t// Attempt to restore a snapshot if there are any.\n   593\t\tif err := r.restoreSnapshot(); err != nil {\n   594\t\t\treturn nil, err\n   595\t\t}\n   596\t\n   597\t\t// Scan through the log for any configuration change entries.\n   598\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   599\t\tfor index := snapshotIndex + 1; index <= lastLog.Index; index++ {\n   600\t\t\tvar entry Log\n   601\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   603\t\t\t\tpanic(err)\n   604\t\t\t}\n   605\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   606\t\t\t\treturn nil, err\n   607\t\t\t}\n   608\t\t}\n   609\t\tr.logger.Info(\"initial configuration\",\n   610\t\t\t\"index\", r.configurations.latestIndex,\n   611\t\t\t\"servers\", hclog.Fmt(\"%+v\", r.configurations.latest.Servers))\n   612\t\n   613\t\t// Setup a heartbeat fast-path to avoid head-of-line\n   614\t\t// blocking where possible. It MUST be safe for this\n   615\t\t// to be called concurrently with a blocking RPC.\n   616\t\ttrans.SetHeartbeatHandler(r.processHeartbeat)\n   617\t\n   618\t\tif conf.skipStartup {\n   619\t\t\treturn r, nil\n   620\t\t}\n   621\t\t// Start the background work.\n   622\t\tr.goFunc(r.run)\n   623\t\tr.goFunc(r.runFSM)\n   624\t\tr.goFunc(r.runSnapshots)\n   625\t\treturn r, nil\n   626\t}\n   627\t\n   628\t// restoreSnapshot attempts to restore the latest snapshots, and fails if none\n   629\t// of them can be restored. This is called at initialization time, and is\n   630\t// completely unsafe to call at any other time.\n    86\tfunc (r *Raft) runFSM() {\n    87\t\tvar lastIndex, lastTerm uint64\n    88\t\n    89\t\tbatchingFSM, batchingEnabled := r.fsm.(BatchingFSM)\n    90\t\tconfigStore, configStoreEnabled := r.fsm.(ConfigurationStore)\n    91\t\n    92\t\tapplySingle := func(req *commitTuple) {\n    93\t\t\t// Apply the log if a command or config change\n    94\t\t\tvar resp interface{}\n    95\t\t\t// Make sure we send a response\n    96\t\t\tdefer func() {\n    97\t\t\t\t// Invoke the future if given\n    98\t\t\t\tif req.future != nil {\n    99\t\t\t\t\treq.future.response = resp\n   100\t\t\t\t\treq.future.respond(nil)\n   101\t\t\t\t}\n   102\t\t\t}()\n   103\t\n   104\t\t\tswitch req.log.Type {\n   105\t\t\tcase LogCommand:\n   106\t\t\t\tstart := time.Now()\n   107\t\t\t\tresp = r.fsm.Apply(req.log)\n   108\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"apply\"}, start)\n   109\t\n   110\t\t\tcase LogConfiguration:\n   111\t\t\t\tif !configStoreEnabled {\n   112\t\t\t\t\t// Return early to avoid incrementing the index and term for\n   113\t\t\t\t\t// an unimplemented operation.\n   114\t\t\t\t\treturn\n   115\t\t\t\t}\n   116\t\n   117\t\t\t\tstart := time.Now()\n   118\t\t\t\tconfigStore.StoreConfiguration(req.log.Index, DecodeConfiguration(req.log.Data))\n   119\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"store_config\"}, start)\n   120\t\t\t}\n   121\t\n   122\t\t\t// Update the indexes\n   123\t\t\tlastIndex = req.log.Index\n   124\t\t\tlastTerm = req.log.Term\n   125\t\t}\n   126\t\n   127\t\tapplyBatch := func(reqs []*commitTuple) {\n   128\t\t\tif !batchingEnabled {\n   129\t\t\t\tfor _, ct := range reqs {\n   130\t\t\t\t\tapplySingle(ct)\n   131\t\t\t\t}\n   132\t\t\t\treturn\n   133\t\t\t}\n   134\t\n   135\t\t\t// Only send LogCommand and LogConfiguration log types. LogBarrier types\n   136\t\t\t// will not be sent to the FSM.\n   137\t\t\tshouldSend := func(l *Log) bool {\n   138\t\t\t\tswitch l.Type {\n   139\t\t\t\tcase LogCommand, LogConfiguration:\n   140\t\t\t\t\treturn true\n   141\t\t\t\t}\n   142\t\t\t\treturn false\n   143\t\t\t}\n   144\t\n   145\t\t\tvar lastBatchIndex, lastBatchTerm uint64\n   146\t\t\tsendLogs := make([]*Log, 0, len(reqs))\n   147\t\t\tfor _, req := range reqs {\n   148\t\t\t\tif shouldSend(req.log) {\n   149\t\t\t\t\tsendLogs = append(sendLogs, req.log)\n   150\t\t\t\t}\n   151\t\t\t\tlastBatchIndex = req.log.Index\n   152\t\t\t\tlastBatchTerm = req.log.Term\n   153\t\t\t}\n   154\t\n   155\t\t\tvar responses []interface{}\n   156\t\t\tif len(sendLogs) > 0 {\n   157\t\t\t\tstart := time.Now()\n   158\t\t\t\tresponses = batchingFSM.ApplyBatch(sendLogs)\n   159\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"applyBatch\"}, start)\n   160\t\t\t\tmetrics.AddSample([]string{\"raft\", \"fsm\", \"applyBatchNum\"}, float32(len(reqs)))\n   161\t\n   162\t\t\t\t// Ensure we get the expected responses\n   163\t\t\t\tif len(sendLogs) != len(responses) {\n   164\t\t\t\t\tpanic(\"invalid number of responses\")\n   165\t\t\t\t}\n   166\t\t\t}\n   167\t\n   168\t\t\t// Update the indexes\n   169\t\t\tlastIndex = lastBatchIndex\n   170\t\t\tlastTerm = lastBatchTerm\n   171\t\n   172\t\t\tvar i int\n   173\t\t\tfor _, req := range reqs {\n   174\t\t\t\tvar resp interface{}\n   175\t\t\t\t// If the log was sent to the FSM, retrieve the response.\n   176\t\t\t\tif shouldSend(req.log) {\n   177\t\t\t\t\tresp = responses[i]\n   178\t\t\t\t\ti++\n   179\t\t\t\t}\n   180\t\n   181\t\t\t\tif req.future != nil {\n   182\t\t\t\t\treq.future.response = resp\n   183\t\t\t\t\treq.future.respond(nil)\n   184\t\t\t\t}\n   185\t\t\t}\n   186\t\t}\n   187\t\n   188\t\trestore := func(req *restoreFuture) {\n   189\t\t\t// Open the snapshot\n   190\t\t\tmeta, source, err := r.snapshots.Open(req.ID)\n   191\t\t\tif err != nil {\n   192\t\t\t\treq.respond(fmt.Errorf(\"failed to open snapshot %v: %v\", req.ID, err))\n   193\t\t\t\treturn\n   194\t\t\t}\n   195\t\t\tdefer source.Close()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/raft.go | sed -n '990,1034p;1390,1439p;1736,1812p;2050,2128p;2209,2239p'; nl -ba ../agent-source/api.go | sed -n '631,708p'; nl -ba ../agent-source/replication.go | sed -n '299,387p'; nl -ba ../agent-source/configuration.go | sed -n '190,299p'; nl -ba ../agent-source/future.go | sed -n '1,62p;100,170p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/raft.go | sed -n '990,1034p;1390,1439p;1736,1812p;2050,2128p;2209,2239p'; nl -ba ../agent-source/api.go | sed -n '631,708p'; nl -ba ../agent-source/replication.go | sed -n '299,387p'; nl -ba ../agent-source/configuration.go | sed -n '190,299p'; nl -ba ../agent-source/future.go | sed -n '1,62p;100,170p'\"","aggregated_output":"   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   991\t\t// make sure we are not already stopped\n   992\t\tselect {\n   993\t\tcase <-stopCh:\n   994\t\t\tdoneCh <- nil\n   995\t\t\treturn\n   996\t\tdefault:\n   997\t\t}\n   998\t\n   999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n  1000\t\t\terr := &deferError{}\n  1001\t\t\terr.init()\n  1002\t\t\trepl.triggerDeferErrorCh <- err\n  1003\t\t\tselect {\n  1004\t\t\tcase err := <-err.errCh:\n  1005\t\t\t\tif err != nil {\n  1006\t\t\t\t\tdoneCh <- err\n  1007\t\t\t\t\treturn\n  1008\t\t\t\t}\n  1009\t\t\tcase <-stopCh:\n  1010\t\t\t\tdoneCh <- nil\n  1011\t\t\t\treturn\n  1012\t\t\t}\n  1013\t\t}\n  1014\t\n  1015\t\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n  1016\t\t// messaging for read-only queries. If this is implemented, the lease\n  1017\t\t// has to be reset as well, in case leadership is transferred. This\n  1018\t\t// implementation also has a lease, but it serves another purpose and\n  1019\t\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n  1020\t\t// setup in a similar way to the one in the thesis, but in practice\n  1021\t\t// it's a timer that just tells the leader how often to check\n  1022\t\t// heartbeats are still coming in.\n  1023\t\n  1024\t\t// Step 3: send TimeoutNow message to target server.\n  1025\t\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n  1026\t\tif err != nil {\n  1027\t\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n  1028\t\t}\n  1029\t\tdoneCh <- err\n  1030\t}\n  1031\t\n  1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n  1033\t// within the last leader lease interval. If not, we need to step down,\n  1034\t// as we may have lost connectivity. Returns the maximum duration without\n  1390\tfunc (r *Raft) processRPC(rpc RPC) {\n  1391\t\tif err := r.checkRPCHeader(rpc); err != nil {\n  1392\t\t\trpc.Respond(nil, err)\n  1393\t\t\treturn\n  1394\t\t}\n  1395\t\n  1396\t\tswitch cmd := rpc.Command.(type) {\n  1397\t\tcase *AppendEntriesRequest:\n  1398\t\t\tr.appendEntries(rpc, cmd)\n  1399\t\tcase *RequestVoteRequest:\n  1400\t\t\tr.requestVote(rpc, cmd)\n  1401\t\tcase *RequestPreVoteRequest:\n  1402\t\t\tr.requestPreVote(rpc, cmd)\n  1403\t\tcase *InstallSnapshotRequest:\n  1404\t\t\tr.installSnapshot(rpc, cmd)\n  1405\t\tcase *TimeoutNowRequest:\n  1406\t\t\tr.timeoutNow(rpc, cmd)\n  1407\t\tdefault:\n  1408\t\t\tr.logger.Error(\"got unexpected command\",\n  1409\t\t\t\t\"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1410\t\n  1411\t\t\trpc.Respond(nil, fmt.Errorf(rpcUnexpectedCommandError))\n  1412\t\t}\n  1413\t}\n  1414\t\n  1415\t// processHeartbeat is a special handler used just for heartbeat requests\n  1416\t// so that they can be fast-pathed if a transport supports it. This must only\n  1417\t// be called from the main thread.\n  1418\tfunc (r *Raft) processHeartbeat(rpc RPC) {\n  1419\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"processHeartbeat\"}, time.Now())\n  1420\t\n  1421\t\t// Check if we are shutdown, just ignore the RPC\n  1422\t\tselect {\n  1423\t\tcase <-r.shutdownCh:\n  1424\t\t\treturn\n  1425\t\tdefault:\n  1426\t\t}\n  1427\t\n  1428\t\t// Ensure we are only handling a heartbeat\n  1429\t\tswitch cmd := rpc.Command.(type) {\n  1430\t\tcase *AppendEntriesRequest:\n  1431\t\t\tr.appendEntries(rpc, cmd)\n  1432\t\tdefault:\n  1433\t\t\tr.logger.Error(\"expected heartbeat, got\", \"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1434\t\t\trpc.Respond(nil, fmt.Errorf(\"unexpected command\"))\n  1435\t\t}\n  1436\t}\n  1437\t\n  1438\t// appendEntries is invoked when we get an append entries RPC call. This must\n  1439\t// only be called from the main thread.\n  1736\tfunc (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n  1737\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n  1738\t\tr.observe(*req)\n  1739\t\n  1740\t\t// Setup a response\n  1741\t\tresp := &RequestPreVoteResponse{\n  1742\t\t\tRPCHeader: r.getRPCHeader(),\n  1743\t\t\tTerm:      r.getCurrentTerm(),\n  1744\t\t\tGranted:   false,\n  1745\t\t}\n  1746\t\tvar rpcErr error\n  1747\t\tdefer func() {\n  1748\t\t\trpc.Respond(resp, rpcErr)\n  1749\t\t}()\n  1750\t\n  1751\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1752\t\tcandidate := r.trans.DecodePeer(req.GetRPCHeader().Addr)\n  1753\t\tcandidateID := ServerID(req.ID)\n  1754\t\n  1755\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1756\t\t// Grant the vote\n  1757\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1758\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not in configuration\",\n  1759\t\t\t\t\"from\", candidate)\n  1760\t\t\treturn\n  1761\t\t}\n  1762\t\n  1763\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate {\n  1764\t\t\tr.logger.Warn(\"rejecting pre-vote request since we have a leader\",\n  1765\t\t\t\t\"from\", candidate,\n  1766\t\t\t\t\"leader\", leaderAddr,\n  1767\t\t\t\t\"leader-id\", string(leaderID))\n  1768\t\t\treturn\n  1769\t\t}\n  1770\t\n  1771\t\t// Ignore an older term\n  1772\t\tif req.Term < r.getCurrentTerm() {\n  1773\t\t\treturn\n  1774\t\t}\n  1775\t\n  1776\t\tif req.Term > r.getCurrentTerm() {\n  1777\t\t\t// continue processing here to possibly grant the pre-vote as in a \"real\" vote this will transition us to follower\n  1778\t\t\tr.logger.Debug(\"received a requestPreVote with a newer term, grant the pre-vote\")\n  1779\t\t\tresp.Term = req.Term\n  1780\t\t}\n  1781\t\n  1782\t\t// if we get a request for a pre-vote from a nonVoter  and the request term is higher, do not grant the Pre-Vote\n  1783\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1784\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1785\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not a voter\", \"from\", candidate)\n  1786\t\t\treturn\n  1787\t\t}\n  1788\t\n  1789\t\t// Reject if their term is older\n  1790\t\tlastIdx, lastTerm := r.getLastEntry()\n  1791\t\tif lastTerm > req.LastLogTerm {\n  1792\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last term is greater\",\n  1793\t\t\t\t\"candidate\", candidate,\n  1794\t\t\t\t\"last-term\", lastTerm,\n  1795\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1796\t\t\treturn\n  1797\t\t}\n  1798\t\n  1799\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1800\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last index is greater\",\n  1801\t\t\t\t\"candidate\", candidate,\n  1802\t\t\t\t\"last-index\", lastIdx,\n  1803\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1804\t\t\treturn\n  1805\t\t}\n  1806\t\n  1807\t\tresp.Granted = true\n  1808\t}\n  1809\t\n  1810\t// installSnapshot is invoked when we get a InstallSnapshot RPC call.\n  1811\t// We must be in the follower state for this, since it means we are\n  1812\t// too far behind a leader for log replay. This must only be called\n  2050\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n  2051\t\n  2052\t\t// At this point transport should support pre-vote\n  2053\t\t// but check just in case\n  2054\t\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\n  2055\t\tif !prevoteTransSupported {\n  2056\t\t\tpanic(\"preElection is not possible if the transport don't support pre-vote\")\n  2057\t\t}\n  2058\t\n  2059\t\t// Create a response channel\n  2060\t\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\n  2061\t\n  2062\t\t// Propose the next term without actually changing our state\n  2063\t\tnewTerm := r.getCurrentTerm() + 1\n  2064\t\n  2065\t\t// Construct the request\n  2066\t\tlastIdx, lastTerm := r.getLastEntry()\n  2067\t\treq := &RequestPreVoteRequest{\n  2068\t\t\tRPCHeader:    r.getRPCHeader(),\n  2069\t\t\tTerm:         newTerm,\n  2070\t\t\tLastLogIndex: lastIdx,\n  2071\t\t\tLastLogTerm:  lastTerm,\n  2072\t\t}\n  2073\t\n  2074\t\t// Construct a function to ask for a vote\n  2075\t\taskPeer := func(peer Server) {\n  2076\t\t\tr.goFunc(func() {\n  2077\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"preElectSelf\"}, time.Now())\n  2078\t\t\t\tresp := &preVoteResult{voterID: peer.ID}\n  2079\t\n  2080\t\t\t\terr := prevoteTrans.RequestPreVote(peer.ID, peer.Address, req, &resp.RequestPreVoteResponse)\n  2081\t\n  2082\t\t\t\t// If the target server do not support Pre-vote RPC we count this as a granted vote to allow\n  2083\t\t\t\t// the cluster to progress.\n  2084\t\t\t\tif err != nil && strings.Contains(err.Error(), rpcUnexpectedCommandError) {\n  2085\t\t\t\t\tr.logger.Error(\"target does not support pre-vote RPC, treating as granted\",\n  2086\t\t\t\t\t\t\"target\", peer,\n  2087\t\t\t\t\t\t\"error\", err,\n  2088\t\t\t\t\t\t\"term\", req.Term)\n  2089\t\t\t\t\tresp.Term = req.Term\n  2090\t\t\t\t\tresp.Granted = true\n  2091\t\t\t\t} else if err != nil {\n  2092\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n  2093\t\t\t\t\t\t\"target\", peer,\n  2094\t\t\t\t\t\t\"error\", err,\n  2095\t\t\t\t\t\t\"term\", req.Term)\n  2096\t\t\t\t\tresp.Term = req.Term\n  2097\t\t\t\t\tresp.Granted = false\n  2098\t\t\t\t}\n  2099\t\t\t\trespCh <- resp\n  2100\t\n  2101\t\t\t})\n  2102\t\t}\n  2103\t\n  2104\t\t// For each peer, request a vote\n  2105\t\tfor _, server := range r.configurations.latest.Servers {\n  2106\t\t\tif server.Suffrage == Voter {\n  2107\t\t\t\tif server.ID == r.localID {\n  2108\t\t\t\t\tr.logger.Debug(\"pre-voting for self\", \"term\", req.Term, \"id\", r.localID)\n  2109\t\n  2110\t\t\t\t\t// cast a pre-vote for our self\n  2111\t\t\t\t\trespCh <- &preVoteResult{\n  2112\t\t\t\t\t\tRequestPreVoteResponse: RequestPreVoteResponse{\n  2113\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n  2114\t\t\t\t\t\t\tTerm:      req.Term,\n  2115\t\t\t\t\t\t\tGranted:   true,\n  2116\t\t\t\t\t\t},\n  2117\t\t\t\t\t\tvoterID: r.localID,\n  2118\t\t\t\t\t}\n  2119\t\t\t\t} else {\n  2120\t\t\t\t\tr.logger.Debug(\"asking for pre-vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2121\t\t\t\t\taskPeer(server)\n  2122\t\t\t\t}\n  2123\t\t\t}\n  2124\t\t}\n  2125\t\n  2126\t\treturn respCh\n  2127\t}\n  2128\t\n  2209\tfunc (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n  2210\t\tr.setLeader(\"\", \"\")\n  2211\t\tr.setState(Candidate)\n  2212\t\tr.candidateFromLeadershipTransfer.Store(true)\n  2213\t\trpc.Respond(&TimeoutNowResponse{}, nil)\n  2214\t}\n  2215\t\n  2216\t// setLatestConfiguration stores the latest configuration and updates a copy of it.\n  2217\tfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n  2218\t\tr.configurations.latest = c\n  2219\t\tr.configurations.latestIndex = i\n  2220\t\tr.latestConfiguration.Store(c.Clone())\n  2221\t}\n  2222\t\n  2223\t// setCommittedConfiguration stores the committed configuration.\n  2224\tfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n  2225\t\tr.configurations.committed = c\n  2226\t\tr.configurations.committedIndex = i\n  2227\t}\n  2228\t\n  2229\t// getLatestConfiguration reads the configuration from a copy of the main\n  2230\t// configuration, which means it can be accessed independently from the main\n  2231\t// loop.\n  2232\tfunc (r *Raft) getLatestConfiguration() Configuration {\n  2233\t\t// this switch catches the case where this is called without having set\n  2234\t\t// a configuration previously.\n  2235\t\tswitch c := r.latestConfiguration.Load().(type) {\n  2236\t\tcase Configuration:\n  2237\t\t\treturn c\n  2238\t\tdefault:\n  2239\t\t\treturn Configuration{}\n   631\tfunc (r *Raft) restoreSnapshot() error {\n   632\t\tsnapshots, err := r.snapshots.List()\n   633\t\tif err != nil {\n   634\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   635\t\t\treturn err\n   636\t\t}\n   637\t\n   638\t\t// Try to load in order of newest to oldest\n   639\t\tfor _, snapshot := range snapshots {\n   640\t\t\tif success := r.tryRestoreSingleSnapshot(snapshot); !success {\n   641\t\t\t\tcontinue\n   642\t\t\t}\n   643\t\n   644\t\t\t// Update the lastApplied so we don't replay old logs\n   645\t\t\tr.setLastApplied(snapshot.Index)\n   646\t\n   647\t\t\t// Update the last stable snapshot info\n   648\t\t\tr.setLastSnapshot(snapshot.Index, snapshot.Term)\n   649\t\n   650\t\t\t// Update the configuration\n   651\t\t\tvar conf Configuration\n   652\t\t\tvar index uint64\n   653\t\t\tif snapshot.Version > 0 {\n   654\t\t\t\tconf = snapshot.Configuration\n   655\t\t\t\tindex = snapshot.ConfigurationIndex\n   656\t\t\t} else {\n   657\t\t\t\tvar err error\n   658\t\t\t\tif conf, err = decodePeers(snapshot.Peers, r.trans); err != nil {\n   659\t\t\t\t\treturn err\n   660\t\t\t\t}\n   661\t\t\t\tindex = snapshot.Index\n   662\t\t\t}\n   663\t\t\tr.setCommittedConfiguration(conf, index)\n   664\t\t\tr.setLatestConfiguration(conf, index)\n   665\t\n   666\t\t\t// Success!\n   667\t\t\treturn nil\n   668\t\t}\n   669\t\n   670\t\t// If we had snapshots and failed to load them, its an error\n   671\t\tif len(snapshots) > 0 {\n   672\t\t\treturn fmt.Errorf(\"failed to load any existing snapshots\")\n   673\t\t}\n   674\t\treturn nil\n   675\t}\n   676\t\n   677\tfunc (r *Raft) tryRestoreSingleSnapshot(snapshot *SnapshotMeta) bool {\n   678\t\tif r.config().NoSnapshotRestoreOnStart {\n   679\t\t\treturn true\n   680\t\t}\n   681\t\n   682\t\tsnapLogger := r.logger.With(\n   683\t\t\t\"id\", snapshot.ID,\n   684\t\t\t\"last-index\", snapshot.Index,\n   685\t\t\t\"last-term\", snapshot.Term,\n   686\t\t\t\"size-in-bytes\", snapshot.Size,\n   687\t\t)\n   688\t\n   689\t\tsnapLogger.Info(\"starting restore from snapshot\")\n   690\t\n   691\t\t_, source, err := r.snapshots.Open(snapshot.ID)\n   692\t\tif err != nil {\n   693\t\t\tsnapLogger.Error(\"failed to open snapshot\", \"error\", err)\n   694\t\t\treturn false\n   695\t\t}\n   696\t\n   697\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, snapshot.Size); err != nil {\n   698\t\t\tsource.Close()\n   699\t\t\tsnapLogger.Error(\"failed to restore snapshot\", \"error\", err)\n   700\t\t\treturn false\n   701\t\t}\n   702\t\tsource.Close()\n   703\t\n   704\t\tsnapLogger.Info(\"restored from snapshot\")\n   705\t\n   706\t\treturn true\n   707\t}\n   708\t\n   299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n   300\t\t// Get the snapshots\n   301\t\tsnapshots, err := r.snapshots.List()\n   302\t\tif err != nil {\n   303\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   304\t\t\treturn false, err\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer snapshot.Close()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   381\t\t}\n   382\t\treturn false, nil\n   383\t}\n   384\t\n   385\t// heartbeat is used to periodically invoke AppendEntries on a peer\n   386\t// to ensure they don't time out. This is done async of replicate(),\n   387\t// since that routine could potentially be blocked on disk IO.\n   190\t\t}\n   191\t\treturn false\n   192\t}\n   193\t\n   194\t// checkConfiguration tests a cluster membership configuration for common\n   195\t// errors.\n   196\tfunc checkConfiguration(configuration Configuration) error {\n   197\t\tidSet := make(map[ServerID]bool)\n   198\t\taddressSet := make(map[ServerAddress]bool)\n   199\t\tvar voters int\n   200\t\tfor _, server := range configuration.Servers {\n   201\t\t\tif server.ID == \"\" {\n   202\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   203\t\t\t}\n   204\t\t\tif server.Address == \"\" {\n   205\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   206\t\t\t}\n   207\t\t\tif idSet[server.ID] {\n   208\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   209\t\t\t}\n   210\t\t\tidSet[server.ID] = true\n   211\t\t\tif addressSet[server.Address] {\n   212\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   213\t\t\t}\n   214\t\t\taddressSet[server.Address] = true\n   215\t\t\tif server.Suffrage == Voter {\n   216\t\t\t\tvoters++\n   217\t\t\t}\n   218\t\t}\n   219\t\tif voters == 0 {\n   220\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   221\t\t}\n   222\t\treturn nil\n   223\t}\n   224\t\n   225\t// nextConfiguration generates a new Configuration from the current one and a\n   226\t// configuration change request. It's split from appendConfigurationEntry so\n   227\t// that it can be unit tested easily.\n   228\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   229\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   230\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   231\t\t}\n   232\t\n   233\t\tconfiguration := current.Clone()\n   234\t\tswitch change.command {\n   235\t\tcase AddVoter:\n   236\t\t\tnewServer := Server{\n   237\t\t\t\tSuffrage: Voter,\n   238\t\t\t\tID:       change.serverID,\n   239\t\t\t\tAddress:  change.serverAddress,\n   240\t\t\t}\n   241\t\t\tfound := false\n   242\t\t\tfor i, server := range configuration.Servers {\n   243\t\t\t\tif server.ID == change.serverID {\n   244\t\t\t\t\tif server.Suffrage == Voter {\n   245\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   246\t\t\t\t\t} else {\n   247\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   248\t\t\t\t\t}\n   249\t\t\t\t\tfound = true\n   250\t\t\t\t\tbreak\n   251\t\t\t\t}\n   252\t\t\t}\n   253\t\t\tif !found {\n   254\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   255\t\t\t}\n   256\t\tcase AddNonvoter:\n   257\t\t\tnewServer := Server{\n   258\t\t\t\tSuffrage: Nonvoter,\n   259\t\t\t\tID:       change.serverID,\n   260\t\t\t\tAddress:  change.serverAddress,\n   261\t\t\t}\n   262\t\t\tfound := false\n   263\t\t\tfor i, server := range configuration.Servers {\n   264\t\t\t\tif server.ID == change.serverID {\n   265\t\t\t\t\tif server.Suffrage != Nonvoter {\n   266\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   267\t\t\t\t\t} else {\n   268\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   269\t\t\t\t\t}\n   270\t\t\t\t\tfound = true\n   271\t\t\t\t\tbreak\n   272\t\t\t\t}\n   273\t\t\t}\n   274\t\t\tif !found {\n   275\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   276\t\t\t}\n   277\t\tcase DemoteVoter:\n   278\t\t\tfor i, server := range configuration.Servers {\n   279\t\t\t\tif server.ID == change.serverID {\n   280\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   281\t\t\t\t\tbreak\n   282\t\t\t\t}\n   283\t\t\t}\n   284\t\tcase RemoveServer:\n   285\t\t\tfor i, server := range configuration.Servers {\n   286\t\t\t\tif server.ID == change.serverID {\n   287\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   288\t\t\t\t\tbreak\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\tcase Promote:\n   292\t\t\tfor i, server := range configuration.Servers {\n   293\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   294\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   295\t\t\t\t\tbreak\n   296\t\t\t\t}\n   297\t\t\t}\n   298\t\t}\n   299\t\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"sync\"\n    10\t\t\"time\"\n    11\t)\n    12\t\n    13\t// Future is used to represent an action that may occur in the future.\n    14\ttype Future interface {\n    15\t\t// Error blocks until the future arrives and then returns the error status\n    16\t\t// of the future. This may be called any number of times - all calls will\n    17\t\t// return the same value, however is not OK to call this method twice\n    18\t\t// concurrently on the same Future instance.\n    19\t\t// Error will only return generic errors related to raft, such\n    20\t\t// as ErrLeadershipLost, or ErrRaftShutdown. Some operations, such as\n    21\t\t// ApplyLog, may also return errors from other methods.\n    22\t\tError() error\n    23\t}\n    24\t\n    25\t// IndexFuture is used for future actions that can result in a raft log entry\n    26\t// being created.\n    27\ttype IndexFuture interface {\n    28\t\tFuture\n    29\t\n    30\t\t// Index holds the index of the newly applied log entry.\n    31\t\t// This must not be called until after the Error method has returned.\n    32\t\tIndex() uint64\n    33\t}\n    34\t\n    35\t// ApplyFuture is used for Apply and can return the FSM response.\n    36\ttype ApplyFuture interface {\n    37\t\tIndexFuture\n    38\t\n    39\t\t// Response returns the FSM response as returned by the FSM.Apply method. This\n    40\t\t// must not be called until after the Error method has returned.\n    41\t\t// Note that if FSM.Apply returns an error, it will be returned by Response,\n    42\t\t// and not by the Error method, so it is always important to check Response\n    43\t\t// for errors from the FSM.\n    44\t\tResponse() interface{}\n    45\t}\n    46\t\n    47\t// ConfigurationFuture is used for GetConfiguration and can return the\n    48\t// latest configuration in use by Raft.\n    49\ttype ConfigurationFuture interface {\n    50\t\tIndexFuture\n    51\t\n    52\t\t// Configuration contains the latest configuration. This must\n    53\t\t// not be called until after the Error method has returned.\n    54\t\tConfiguration() Configuration\n    55\t}\n    56\t\n    57\t// SnapshotFuture is used for waiting on a user-triggered snapshot to complete.\n    58\ttype SnapshotFuture interface {\n    59\t\tFuture\n    60\t\n    61\t\t// Open is a function you can call to access the underlying snapshot and\n    62\t\t// its metadata. This must not be called until after the Error method\n   100\t\td.errCh = make(chan error, 1)\n   101\t}\n   102\t\n   103\tfunc (d *deferError) Error() error {\n   104\t\tif d.err != nil {\n   105\t\t\t// Note that when we've received a nil error, this\n   106\t\t\t// won't trigger, but the channel is closed after\n   107\t\t\t// send so we'll still return nil below.\n   108\t\t\treturn d.err\n   109\t\t}\n   110\t\tif d.errCh == nil {\n   111\t\t\tpanic(\"waiting for response on nil channel\")\n   112\t\t}\n   113\t\tselect {\n   114\t\tcase d.err = <-d.errCh:\n   115\t\tcase <-d.ShutdownCh:\n   116\t\t\td.err = ErrRaftShutdown\n   117\t\t}\n   118\t\treturn d.err\n   119\t}\n   120\t\n   121\tfunc (d *deferError) respond(err error) {\n   122\t\tif d.errCh == nil {\n   123\t\t\treturn\n   124\t\t}\n   125\t\tif d.responded {\n   126\t\t\treturn\n   127\t\t}\n   128\t\td.errCh <- err\n   129\t\tclose(d.errCh)\n   130\t\td.responded = true\n   131\t}\n   132\t\n   133\t// There are several types of requests that cause a configuration entry to\n   134\t// be appended to the log. These are encoded here for leaderLoop() to process.\n   135\t// This is internal to a single server.\n   136\ttype configurationChangeFuture struct {\n   137\t\tlogFuture\n   138\t\treq configurationChangeRequest\n   139\t}\n   140\t\n   141\t// bootstrapFuture is used to attempt a live bootstrap of the cluster. See the\n   142\t// Raft object's BootstrapCluster member function for more details.\n   143\ttype bootstrapFuture struct {\n   144\t\tdeferError\n   145\t\n   146\t\t// configuration is the proposed bootstrap configuration to apply.\n   147\t\tconfiguration Configuration\n   148\t}\n   149\t\n   150\t// logFuture is used to apply a log entry and waits until\n   151\t// the log is considered committed.\n   152\ttype logFuture struct {\n   153\t\tdeferError\n   154\t\tlog      Log\n   155\t\tresponse interface{}\n   156\t\tdispatch time.Time\n   157\t}\n   158\t\n   159\tfunc (l *logFuture) Response() interface{} {\n   160\t\treturn l.response\n   161\t}\n   162\t\n   163\tfunc (l *logFuture) Index() uint64 {\n   164\t\treturn l.log.Index\n   165\t}\n   166\t\n   167\ttype shutdownFuture struct {\n   168\t\traft *Raft\n   169\t}\n   170\t\n","exit_code":0,"status":"completed"}}
