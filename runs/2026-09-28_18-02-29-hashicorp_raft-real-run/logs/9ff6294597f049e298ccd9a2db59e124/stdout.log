erm() + 1)\n  1916\t\n  1917\t\t// Wait for the leader to step down\n  1918\t\tselect {\n  1919\t\tcase v := <-leader.LeaderCh():\n  1920\t\t\tif v {\n  1921\t\t\t\tt.Fatalf(\"expected the leader to step down\")\n  1922\t\t\t}\n  1923\t\tcase <-time.After(conf.HeartbeatTimeout * 3):\n  1924\t\t\tc.FailNowf(\"timeout waiting for leader to step down\")\n  1925\t\t}\n  1926\t\n  1927\t\t// Verify we are leader\n  1928\t\tverify := leader.VerifyLeader()\n  1929\t\n  1930\t\tif err := verify.Error(); err != ErrNotLeader && err != ErrLeadershipLost {\n  1931\t\t\tt.Fatalf(\"err: %v\", err)\n  1932\t\t}\n  1933\t\n  1934\t\t// Ensure the known leader is cleared\n  1935\t\tif l, _ := leader.LeaderWithID(); l != \"\" {\n  1936\t\t\tt.Fatalf(\"bad: %v\", l)\n  1937\t\t}\n  1938\t}\n  1939\t\n  1940\tfunc TestRaft_VerifyLeader_PartialConnect(t *testing.T) {\n  1941\t\t// Make a cluster\n  1942\t\tconf := inmemConfig(t)\n  1943\t\tc := MakeCluster(3, t, conf)\n  1944\t\tdefer c.Close()\n  1945\t\n  1946\t\t// Get the leader\n  1947\t\tleader := c.Leader()\n  1948\t\n  1949\t\t// Wait until we have a followers\n  1950\t\tlimit := time.Now().Add(c.longstopTimeout)\n  1951\t\tvar followers []*Raft\n  1952\t\tfor time.Now().Before(limit) && len(followers) != 2 {\n  1953\t\t\tc.WaitEvent(nil, c.conf.CommitTimeout)\n  1954\t\t\tfollowers = c.GetInState(Follower)\n  1955\t\t}\n  1956\t\tif len(followers) != 2 {\n  1957\t\t\tt.Fatalf(\"expected two followers but got: %v\", followers)\n  1958\t\t}\n  1959\t\n  1960\t\t// Force partial disconnect\n  1961\t\tfollower := followers[0]\n  1962\t\tt.Logf(\"[INFO] Disconnecting %v\", follower)\n  1963\t\tc.Disconnect(follower.localAddr)\n  1964\t\n  1965\t\t// Verify we are leader\n  1966\t\tverify := leader.VerifyLeader()\n  1967\t\n  1968\t\t// Wait for the leader to step down\n  1969\t\tif err := verify.Error(); err != nil {\n  1970\t\t\tt.Fatalf(\"err: %v\", err)\n  1971\t\t}\n  1972\t}\n  1973\t\n  1974\tfunc TestRaft_NotifyCh(t *testing.T) {\n  1975\t\tch := make(chan bool, 1)\n  1976\t\tconf := inmemConfig(t)\n  1977\t\tconf.NotifyCh = ch\n  1978\t\tc := MakeCluster(1, t, conf)\n  1979\t\tdefer c.Close()\n  1980\t\n  1981\t\t// Watch leaderCh for change\n  1982\t\tselect {\n  1983\t\tcase v := <-ch:\n  1984\t\t\tif !v {\n  1985\t\t\t\tt.Fatalf(\"should become leader\")\n../agent-source/membership.md:5: - Catching up new servers prior to granting them a vote, as well as allowing permanent non-voting members; and\n../agent-source/docs/apply.md:5:quorum of raft nodes. Then, the committed command is applied to fsm.\n../agent-source/docs/apply.md:39:   opt quorum commit index has increased\n../agent-source/docs/apply.md:70:                                                 // a quorum of responses\n../agent-source/docs/apply.md:102:highest log entry index that has been replicated to a quorum of the servers (\n../agent-source/docs/apply.md:103:`if quorumMatchIndex > c.commitIndex`), update `commitIndex` to that index, and\n../agent-source/docs/README.md:49:* VerifyLeader - send a heartbeat to all voters to confirm the peer is still the leader\nClaimDraft {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"obligation\",\n        \"assumption\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"concern\": {\n      \"default\": \"implementation_semantics\",\n      \"enum\": [\n        \"consensus_safety\",\n        \"bounded_liveness\",\n        \"implementation_semantics\"\n      ],\n      \"title\": \"Concern\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"description\": \"Located materials; file kinds do not establish normative authority\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \