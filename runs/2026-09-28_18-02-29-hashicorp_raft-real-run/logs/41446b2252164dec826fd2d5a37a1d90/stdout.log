bility check of one verification future in one leader generation under fixed three-voter plus one-nonvoter membership. Compare nonvoter-only remote positive support against a permitted remote-voter control. This is a necessary-condition check, not an eventual-success or all-voters requirement.\",\n        \"assumptions\": [\n          \"Operation identity and worker suffrage are independently recorded and fixed during each comparison.\",\n          \"No remote voter contribution is inferred from connectivity alone: pending registrations, reply delivery and alternate successful append paths must be accounted for.\",\n          \"The executed artifact must declare whether authority/configuration prefix is real or supplied. Supplied state yields only a conditional local result.\",\n          \"Network loss/delay is non-Byzantine; replies used as positive support must come from actual implementation or be identified as a conditional substitute.\"\n        ],\n        \"excluded\": [\n          \"A later leader election or stale FSM read unless separately observed.\",\n          \"Configuration transitions, self removal, shutdown and disaster recovery during the comparison.\",\n          \"General liveness failure from an unfinished verification or tool timeout.\"\n        ],\n        \"parameters\": {}\n      },\n      \"check_ids\": [\n        \"a5644db0464f44ccb5dfc352dcff28b0\"\n      ],\n      \"blockers\": [],\n      \"conditions\": [\n        {\n          \"check_id\": \"a5644db0464f44ccb5dfc352dcff28b0\",\n          \"scope\": {\n            \"description\": \"Participant-eligibility check of one verification future in one leader generation under fixed three-voter plus one-nonvoter membership. Compare nonvoter-only remote positive support against a permitted remote-voter control. This is a necessary-condition check, not an eventual-success or all-voters requirement.\",\n            \"assumptions\": [\n              \"Operation identity and worker suffrage are independently recorded and fixed during each comparison.\",\n              \"No remote voter contribution is inferred from connectivity alone: pending registrations, reply delivery and alternate successful append paths must be accounted for.\",\n              \"The executed artifact must declare whether authority/configuration prefix is real or supplied. Supplied state yields only a conditional local result.\",\n              \"Network loss/delay is non-Byzantine; replies used as positive support must come from actual implementation or be identified as a conditional substitute.\"\n            ],\n            \"excluded\": [\n              \"A later leader election or stale FSM read unless separately observed.\",\n              \"Configuration transitions, self removal, shutdown and disaster recovery during the comparison.\",\n              \"General liveness failure from an unfinished verification or tool timeout.\"\n            ],\n            \"parameters\": {}\n          },\n          \"adaptations\": [\n            \"Embed InmemTransport and delay AppendEntries calls before real delivery using channels; do not change requests or responses.\",\n            \"Explicitly disable optional pipelining via ErrPipelineReplicationNotSupported; ordinary retry/fallback and heartbeat remain real.\",\n            \"Observe transport return fields and public futures; use MockFSM from captured testing support.\",\n            \"Cut schedule off after 600 ms independently of forbidden success; missing result remains unknown. Release all gates and shut down all nodes.\"\n          ],\n          \"notes\": {\n            \"plan_uncertainties\": [\n              \"No broader stale-read or later-leader endpoint is measured.\",\n              \"Counts are transport delivery observations, not instrumentation inside vote(); absence of any eligible reply after complete two-loop quiescence is the relevant discriminator.\",\n              \"An independently missing case is reported incomplete and cannot supply a holds result.\"\n            ],\n            \"grounding_unresolved\": [\n              \"Documentation does not define a linearization point or complete read protocol; these remain outside the local eligibility claim.\",\n              \"Measurement of producer identity, registration and terminal public result remains required.\",\n              \"Scheduling that misses quiescence cutoff yields setup failure, not evidence. Missing verification completion emits only an incomplete diagnostic, not a result.\",\n              \"A result proves the local participant-eligibility proposition only. No competing authority or stale application read is observed.\",\n              \"Successful reply count is an upper bound on consumed support; absence proves no voter consumption after quiescence. The permitted control releases only the voter, excluding nonvoter substitution.\"\n            ],\n            \"review_limitations\": [\n              \"Only the no-pipeline in-memory transport variant with finite selective delays and unchanged membership is executed.\",\n              \"Public successful verification is observed; a subsequent FSM read, competing leader election and committed-data inconsistency are not.\",\n              \"The source basis explains nonvoter notification consumption, but this test is not an isolated comparison of every potential cause of stale verification.\"\n            ]\n          }\n        }\n      ]\n    }\n  ],\n  \"pending_work\": []\n}\n483:func (n *NetworkTransport) genericRPC(id ServerID, target ServerAddress, rpcType uint8, args interface{}, resp interface{}) error {\n771:func decodeResponse(conn *netConn, resp interface{}) (bool, error) {\n835:\tgo n.decodeResponses()\n839:// decodeResponses is a long running routine that decodes the responses\n841:func (n *netPipeline) decodeResponses() {\n   830\t\t\t// a response from the previous one. i.e. two are inflight at the same time.\n   831\t\t\tinprogressCh: make(chan *appendFuture, maxInFlight-2),\n   832\t\t\tdoneCh:       make(chan AppendFuture, maxInFlight-2),\n   833\t\t\tshutdownCh:   make(chan struct{}),\n   834\t\t}\n   835\t\tgo n.decodeResponses()\n   836\t\treturn n\n   837\t}\n   838\t\n   839\t// decodeResponses is a long running routine that decodes the responses\n   840\t// sent on the connection.\n   841\tfunc (n *netPipeline) decodeResponses() {\n   842\t\ttimeout := n.trans.timeout\n   843\t\tfor {\n   844\t\t\tselect {\n   845\t\t\tcase future := <-n.inprogressCh:\n   846\t\t\t\tif timeout > 0 {\n   847\t\t\t\t\tn.conn.conn.SetReadDeadline(time.Now().Add(timeout))\n   848\t\t\t\t}\n   849\t\n   850\t\t\t\t_, err := decodeResponse(n.conn, future.resp)\n   851\t\t\t\tfuture.respond(err)\n   852\t\t\t\tselect {\n   853\t\t\t\tcase n.doneCh <- future:\n   854\t\t\t\tcase <-n.shutdownCh:\n   855\t\t\t\t\treturn\n   856\t\t\t\t}\n   857\t\t\tcase <-n.shutdownCh:\n   858\t\t\t\treturn\n   859\t\t\t}\n   860\t\t}\n   861\t}\n   862\t\n   863\t// AppendEntries is used to pipeline a new append entries request.\n   864\tfunc (n *netPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n   865\t\t// Create a new future\n   866\t\tfuture := &appendFuture{\n   867\t\t\tstart: time.Now(),\n   868\t\t\targs:  args,\n   869\t\t\tresp:  resp,\n   870\t\t}\n   871\t\tfuture.init()\n   872\t\n   873\t\t// Add a send timeout\n   874\t\tif timeout := n.trans.timeout; timeout > 0 {\n   875\t\t\tn.conn.conn.SetWriteDeadline(time.Now().Add(timeout))\n   876\t\t}\n   877\t\n   878\t\t// Send the RPC\n   879\t\tif err := sendRPC(n.conn, rpcAppendEntries, future.args); err != nil {\n   880\t\t\treturn nil, err\n   881\t\t}\n   882\t\n   883\t\t// Hand-off for decoding, this can also cause back-pressure\n   884\t\t// to prevent too many inflight requests\n   885\t\tselect {\n   886\t\tcase n.inprogressCh <- future:\n   887\t\t\treturn future, nil\n   888\t\tcase <-n.shutdownCh:\n   889\t\t\treturn nil, ErrPipelineShutdown\n   890\t\t}\n   891\t}\n   892\t\n   893\t// Consumer returns a channel that can be used to consume complete futures.\n   894\tfunc (n *netPipeline) Consumer() <-chan AppendFuture {\n   895\t\treturn n.doneCh\n   896\t}\n   897\t\n   898\t// Close is used to shut down the pipeline connection.\n   899\tfunc (n *netPipeline) Close() error {\n   900\t\tn.shutdownLock.Lock()\n   901\t\tdefer n.shutdownLock.Unlock()\n   902\t\tif n.shutdown {\n   903\t\t\treturn nil\n   904\t\t}\n   905\t\n   906\t\t// Release the connection\n   907\t\tn.conn.Release()\n   908\t\n   909\t\tn.shutdown = true\n   910\t\tclose(n.shutdownCh)\n   911\t\treturn nil\n   912\t}\n   272\tfunc (i *inmemPipeline) decodeResponses() {\n   273\t\ttimeout := i.trans.timeout\n   274\t\tfor {\n   275\t\t\tselect {\n   276\t\t\tcase inp := <-i.inprogressCh:\n   277\t\t\t\tvar timeoutCh <-chan time.Time\n   278\t\t\t\tif timeout > 0 {\n   279\t\t\t\t\ttimeoutCh = time.After(timeout)\n   280\t\t\t\t}\n   281\t\n   282\t\t\t\tselect {\n   283\t\t\t\tcase rpcResp := <-inp.respCh:\n   284\t\t\t\t\t// Copy the result back\n   285\t\t\t\t\t*inp.future.resp = *rpcResp.Response.(*AppendEntriesResponse)\n   286\t\t\t\t\tinp.future.respond(rpcResp.Error)\n   287\t\n   288\t\t\t\t\tselect {\n   289\t\t\t\t\tcase i.doneCh <- inp.future:\n   290\t\t\t\t\tcase <-i.shutdownCh:\n   291\t\t\t\t\t\treturn\n   292\t\t\t\t\t}\n   293\t\n   294\t\t\t\tcase <-timeoutCh:\n   295\t\t\t\t\tinp.future.respond(fmt.Errorf(\"command timed out\"))\n   296\t\t\t\t\tselect {\n   297\t\t\t\t\tcase i.doneCh <- inp.future:\n   298\t\t\t\t\tcase <-i.shutdownCh:\n   299\t\t\t\t\t\treturn\n   300\t\t\t\t\t}\n   301\t\n   302\t\t\t\tcase <-i.shutdownCh:\n   303\t\t\t\t\treturn\n   304\t\t\t\t}\n   305\t\t\tcase <-i.shutdownCh:\n   306\t\t\t\treturn\n   307\t\t\t}\n   308\t\t}\n   309\t}\n   310\t\n   311\tfunc (i *inmemPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n   312\t\t// Create a new future\n   313\t\tfuture := &appendFuture{\n   314\t\t\tstart: time.Now(),\n   315\t\t\targs:  args,\n   316\t\t\tresp:  resp,\n   317\t\t}\n   318\t\tfuture.init()\n   319\t\n   320\t\t// Handle a timeout\n   321\t\tvar timeout <-chan time.Time\n   322\t\tif i.trans.timeout > 0 {\n   323\t\t\ttimeout = time.After(i.trans.timeout)\n   324\t\t}\n   325\t\n   326\t\t// Send the RPC over\n   327\t\trespCh := make(chan RPCResponse, 1)\n   328\t\trpc := RPC{\n   329\t\t\tCommand:  args,\n   330\t\t\tRespChan: respCh,\n   331\t\t}\n   332\t\n   333\t\t// Check if we have been already shutdown, otherwise the random choose\n   334\t\t// made by select statement below might pick consumerCh even if\n   335\t\t// shutdownCh was closed.\n   336\t\ti.shutdownLock.RLock()\n   337\t\tshutdown := i.shutdown\n   338\t\ti.shutdownLock.RUnlock()\n   339\t\tif shutdown {\n   340\t\t\treturn nil, ErrPipelineShutdown\n   341\t\t}\n   342\t\n   343\t\tselect {\n   344\t\tcase i.peer.consumerCh <- rpc:\n   345\t\tcase <-timeout:\n   346\t\t\treturn nil, fmt.Errorf(\"command enqueue timeout\")\n   347\t\tcase <-i.shutdownCh:\n   348\t\t\treturn nil, ErrPipelineShutdown\n   349\t\t}\n   350\t\n78:func (e errorFuture) Error() error {\n82:func (e errorFuture) Response() interface{} {\n99:func (d *deferError) init() {\n103:func (d *deferError) Error() error {\n121:func (d *deferError) respond(err error) {\n159:func (l *logFuture) Response() interface{} {\n171:func (s *shutdownFuture) Error() error {\n312:func (a *appendFuture) Response() *AppendEntriesResponse {\n","exit_code":0,"status":"completed"}}
