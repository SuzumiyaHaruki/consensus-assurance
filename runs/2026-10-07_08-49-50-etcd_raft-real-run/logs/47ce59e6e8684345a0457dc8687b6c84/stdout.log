pplied, size)\\n\\n\\tif r.trk.Config.AutoLeave && newApplied >= r.pendingConfIndex && r.state == StateLeader {\\n\\t\\t// If the current (and most recent, at least for this leader's term)\\n\\t\\t// configuration should be auto-left, initiate that now. We use a\\n\\t\\t// nil Data which unmarshals into an empty ConfChangeV2 and has the\\n\\t\\t// benefit that appendEntry can never refuse it based on its size\\n\\t\\t// (which registers as zero).\\n\\t\\tm, err := confChangeToMsg(nil)\\n\\t\\tif err != nil {\\n\\t\\t\\tpanic(err)\\n\\t\\t}\\n\\t\\t// NB: this proposal can't be dropped due to size, but can be\\n\\t\\t// dropped if a leadership transfer is in progress. We'll keep\\n\\t\\t// checking this condition on each applied entry, so either the\\n\\t\\t// leadership transfer will succeed and the new leader will lea\nbindings {\"associations\": [{\"claim_id\": \"O-auto-joint-continuation\", \"source_ids\": [\"S-joint-contract\", \"S-joint-flag\"], \"rationale\": \"Links implementation continuation mechanism to the implicit-transition ownership contract.\"}], \"anchor\": {\"source_ids\": [\"S-abort\"], \"boundary_complete\": true, \"kind\": \"declaration\", \"material_id\": \"S-abort\", \"start_line\": 2057, \"end_line\": 2057, \"symbol\": \"abortLeaderTransfer\"}, \"material_id\": \"S-abort\", \"id\": \"bind-auto-abort\", \"file\": \"raft.go\", \"symbol\": \"abortLeaderTransfer\", \"start_line\": 2057, \"end_line\": 2059, \"snapshot_id\": \"7fa4a1501e8a40aa82ca2221a27796f2\", \"content_digest\": \"4283c10e12c6da14964c6d6784a69851af1312245aa83925ec0e9426a07ed7bb\", \"basis\": \"agent_inference\", \"description\": \"Clears transfer state without scheduling the application-triggered continuation.\", \"pending\": [], \"excerpt\": \"func (r *raft) abortLeaderTransfer() {\\n\\tr.leadTransferee = None\\n}\", \"version\": 1}\nunits {\"id\": \"unit-O-auto-joint-continuation\", \"candidate_id\": \"741e5e2156e4421abc1c95cb51fe0704\", \"obligation_ids\": [\"O-auto-joint-cont