onfiguration, reconstructible from caller-persisted ConfState and committed configuration entries.',recovery='confchange.Restore reconstructs AutoLeave and voter sets from ConfState.',source_ids=['S-joint-contract','S-joint-flag','S-changer','S-restoreconfig','S-config'],unknowns=['Continuation after a transfer rejects the first automatic leave proposal while no later application completion remains.']))\nm['core_overview']['open_details']=[x if not x.startswith('Automatic joint-exit') else 'Automatic leave is attempted by appliedTo; transfer abort only clears the transferee. Investigate idle continuation after the final completion was rejected.' for x in m['core_overview']['open_details']]\nfor surf in m['surfaces']:\n if surf['entry_point']=='raft.appliedTo automatic joint exit':surf.update(disposition='mapped',behavior_ids=['B-application','B-context','B-config'],reason='Explicit implicit-transition contract assigns leave proposal to Raft. appliedTo attempts it, proposal rejects during transfer, and timeout abort has no visible retry; investigate whether future protocol work necessarily supplies another application completion.',source_ids=['S-applied','S-heartbeat-tick','S-abort','S-joint-contract'])\nchanges={}\nfor i,ids,why in [('B-config',['S-joint-selection','S-joint-flag'],'Map establishment of the automatic-joint fact separately from completing its departure.'),('B-recovery',['S-restoreconfig'],'Map reconstruction of automatic-joint configuration from ConfState.'),('B-application',['S-applied','S-joint-contract'],'Map consumption of automatic-joint state and conditional failed proposal, without asserting unconditional completion.'),('B-context',['S-abort','S-heartbeat-tick'],'Clarify transfer abort has no automatic-leave follow-up.'),('core_overview',['S-applied','S-abort'],'Replace an unread reminder with the sourced trigger relationship.')]:changes[i]=dict(impact='dependency' if i in ['B-config','B-recovery','B-application'] else 'clarification',source_id