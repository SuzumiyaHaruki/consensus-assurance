\n3246:\trequire.Equal(t, uint64(3), lead.leadTransferee)\n3248:\t// Transfer leadership to another node.\n3249:\tnt.send(pb.Message{From: 2, To: 1, Type: pb.MsgTransferLeader})\n3251:\tcheckLeaderTransferState(t, lead, StateFollower, 2)\n3254:// TestLeaderTransferSecondTransferToSameNode verifies second transfer leader request\n3256:func TestLeaderTransferSecondTransferToSameNode(t *testing.T) {\n3264:\tnt.send(pb.Message{From: 3, To: 1, Type: pb.MsgTransferLeader})\n3265:\trequire.Equal(t, uint64(3), lead.leadTransferee)\n3270:\t// Second transfer leadership request to the same node.\n3271:\tnt.send(pb.Message{From: 3, To: 1, Type: pb.MsgTransferLeader})\n3277:\tcheckLeaderTransferState(t, lead, StateLeader, 1)\n3280:func checkLeaderTransferState(t *testing.T, r *raft, state StateType, lead uint64) {\n3283:\trequire.Equal(t, None, r.leadTransferee)\n3286:// TestTransferNonMember verifies that when a MsgTimeoutNow arrives at\n3290:func TestTransferNonMember(t *testing.T) {\n3482:\t// NB: TransferLeader already checks that the recipient is not a learner, but\n3633:\t// Transfer leadership to peer 2.\n3634:\tnt.send(pb.Message{From: 2, To: 1, Type: pb.MsgTransferLeader})\n3639:\t// Abort transfer leader\n3647:\t// Transfer leadership to peer 2 again.\n3648:\tnt.send(pb.Message{From: 2, To: 1, Type: pb.MsgTransferLeader})\n","exit_code":0,"status":"completed"}}
