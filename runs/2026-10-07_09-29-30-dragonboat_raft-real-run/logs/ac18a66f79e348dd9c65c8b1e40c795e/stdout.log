obligation_checks\": {}, \"remaining_obligation_ids\": [\"O-read-response-identity\"], \"recheck_reasons\": [], \"coverage_limitations\": [], \"progress\": [{\"claim_id\": \"O-read-response-identity\", \"record_status\": \"no_fixed_check\"}], \"source_explanation\": null, \"record\": {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-O-read-response-identity\", \"version\": 1}}}]\nclaims [{\"id\": \"O-read-response-identity\", \"kind\": \"obligation\", \"concern\": \"implementation_semantics\", \"description\": \"When the leader consumes and removes a pending remote ReadIndex request as part of a quorum-confirmed prefix, it must emit the corresponding ReadIndexResp to that request origin carrying that request SystemCtx unchanged. Releasing several requests together may raise their index but must not substitute another released request context.\", \"scope\": {\"description\": \"Local read-barrier response correlation for distinct, concurrently pending remote requests in a stable leader term and fixed voting membership, after current-term commitment and valid quorum confirmation.\", \"assumptions\": [\"Non-Byzantine peers and genuine response messages from contextual heartbeats\", \"Distinct nonzero request contexts remain associated with their originating requests\", \"Caller honors Peer update persistence/Commit and local applied-index duties\"], \"excluded\": [\"A numeric client completion deadline or proof of infinite stall\", \"State-machine lookup value linearizability\", \"Restart, membership transition, context collision and Byzantine inputs\"], \"parameters\": {}}, \"source\": \"Candidate derived from attributed implementation responsibilities\", \"source_ids\": [\"M-read-api\", \"M-read-result-expectation\", \"M-prefix-expectation\", \"M-read-queue\", \"M-read-release\", \"M-read-batches\"], \"pending\": [], \"assessment\": \"unassessed\", \"candidate\": true, \"grounding\": {\"source_ids\": [\"M-read-queue\", \"M-read-release\", \"M-read-batches\", \"M-forward-read\", \"M-read-producer\"], \"expectation_ids\": [\"M-read-result-expectation\", \"M-prefix-expectation\", \"M-read-api\"], \"binding_ids\": [\"BI-read-release\", \"BI-read-consumer\"], \"derivation\": \"M-read-result-expectation compares the resulting ReadyToRead.SystemCtx with each original request, including follower requests. M-prefix-expectation requires each released status to preserve its origin/context even when its index is raised to a later confirmed index. Together these establish correlation across batching, not an obligation for each request to receive its own heartbeat confirmation. M-read-batches shows why the context is semantic: only an exact lookup updates the originating batch; M-forward-read copies received context. M-read-api promises per-RequestState outcome notification but does not supply a success deadline. The local obligation therefore ends at response emission and does not infer global liveness.\", \"applicability\": \"A leader actually releases a pending remote request on a valid quorum confirmation; fixed history must establish admission, distinct contexts, current-term commitment and genuine heartbeat provenance.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": [\"Local release correctly uses s.ctx; batching and raising indexes are intentional and remain permitted.\", \"Client timeout/close remains a valid terminal outcome but does not justify substituting response identity on an emitted successful barrier.\"]}, \"version\": 1, \"record\": {\"path\": \"state.json\", \"collection\": \"claims\", \"match\": {\"id\": \"O-read-response-identity\", \"version\": 1}}}]\npending_work [{\"id\": \"unit-O-read-response-identity\", \"candidate_id\": \"e9495b6859ad4644a1bfe4966a7d0104\", \"kind\": \"unit\", \"remaining\": [\"O-read-response-identity\"], \"record\": {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-O-read-response-identity\"}}}]\nreview_issues []\n{\n  \"$d