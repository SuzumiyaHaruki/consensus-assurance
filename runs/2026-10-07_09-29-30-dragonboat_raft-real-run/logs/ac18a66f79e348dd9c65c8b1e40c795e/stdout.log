: [],\n            \"conflicts\": [],\n            \"alternatives\": []\n          }\n        }\n      },\n      \"required\": [\n        \"kind\",\n        \"source\",\n        \"description\",\n        \"semantic_changes\"\n      ],\n      \"title\": \"Harness\",\n      \"type\": \"object\"\n    },\n    \"ObservableProperty\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checker_id\": {\n          \"title\": \"Checker Id\",\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"default\": \"event_assertion\",\n          \"enum\": [\n            \"event_assertion\",\n            \"event_implication\"\n          ],\n          \"title\": \"Kind\",\n          \"type\": \"string\"\n        },\n        \"trigger\": {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        \"assertion\": {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        \"antecedent\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/Comparison\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"identity_fields\": {\n          \"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Identity Fields\",\n          \"type\": \"array\"\n        },\n        \"description\": {\n          \"title\": \"Description\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"checker_id\",\n        \"trigger\",\n        \"assertion\",\n        \"description\"\n      ],\n      \"title\": \"ObservableProperty\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"description\": \"Concrete investigation of an accepted requirement; execution determines the observed result