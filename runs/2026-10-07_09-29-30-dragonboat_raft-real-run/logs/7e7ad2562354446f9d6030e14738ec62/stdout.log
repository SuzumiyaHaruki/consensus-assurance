0\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadIdentity\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"wire_response\\\",\\\"from\\\":1,\\\"high\\\":30,\\\"index\\\":4,\\\"low\\\":2202,\\\"term\\\":2,\\\"to\\\":3}\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.446256585+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadIdentity\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"result\\\",\\\"origin\\\":2,\\\"ready_contexts\\\":\\\"2202:30\\\",\\\"released\\\":true,\\\"remaining_pending\\\":0,\\\"remaining_queue\\\":0,\\\"response_count\\\":1,\\\"response_signature\\\":\\\"2:2202:30\\\",\\\"scenario\\\":\\\"remote_prefix\\\",\\\"term\\\":2}\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.446261497+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadIdentity\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"result\\\",\\\"origin\\\":3,\\\"ready_contexts\\\":\\\"2202:30\\\",\\\"released\\\":true,\\\"remaining_pending\\\":0,\\\"remaining_queue\\\":0,\\\"response_count\\\":1,\\\"response_signature\\\":\\\"3:2202:30\\\",\\\"scenario\\\":\\\"remote_prefix\\\",\\\"term\\\":2}\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.446270702+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadIdentity\",\"Output\":\"--- PASS: TestAssuranceRemoteReadIdentity (0.00s)\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.446316818+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Test\":\"TestAssuranceRemoteReadIdentity\",\"Elapsed\":0}\n{\"Time\":\"2026-10-07T09:41:28.447362017+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.447492275+08:00\",\"Action\":\"output\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Output\":\"ok  \\tgithub.com/lni/dragonboat/v3/internal/raft\\t0.008s\\n\"}\n{\"Time\":\"2026-10-07T09:41:28.447510197+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/lni/dragonboat/v3/internal/raft\",\"Elapsed\":0.008}\n     1\tpackage raft\n     2\t\n     3\timport (\n     4\t \"encoding/json\"\n     5\t \"fmt\"\n     6\t \"strings\"\n     7\t \"testing\"\n     8\t\n     9\t \"github.com/lni/dragonboat/v3/config\"\n    10\t pb \"github.com/lni/dragonboat/v3/raftpb\"\n    11\t)\n    12\t\n    13\ttype assurancePeer struct {\n    14\t p *Peer\n    15\t db ILogDB\n    16\t applied uint64\n    17\t ready []pb.ReadyToRead\n    18\t}\n    19\t\n    20\ttype assuranceReadNetwork struct {\n    21\t t *testing.T\n    22\t nodes map[uint64]*assurancePeer\n    23\t queue []pb.Message\n    24\t responses []pb.Message\n    25\t dropLow uint64\n    26\t dropped int\n    27\t delivered int\n    28\t}\n    29\t\n    30\tfunc assuranceEvent(v map[string]interface{}) {\n    31\t b, err := json.Marshal(v)\n    32\t if err != nil { panic(err) }\n    33\t fmt.Println(\"CA_EVENT \" + string(b))\n    34\t}\n    35\t\n    36\t// Complete the caller's update handoff before any outgoing message is delivered.\n    37\t// The abstract application consumes only bootstrap config entries and the election noop.\n    38\tfunc (n *assuranceReadNetwork) harvest(id uint64) {\n    39\t a := n.nodes[id]\n    40\t u := a.p.GetUpdate(true, a.applied)\n    41\t if err := a.db.Append(u.EntriesToSave); err != nil { n.t.Fatal(err) }\n    42\t if !pb.IsEmptyState(u.State) { a.db.SetState(u.State) }\n    43\t msgs := append([]pb.Message(nil), u.Messages...)\n    44\t a.ready = append(a.ready, u.ReadyToReads...)\n    45\t entries := append([]pb.Entry(nil), u.CommittedEntries...)\n    46\t a.p.Commit(u)\n    47\t for _, e := range entries {\n    48\t  if e.Type == pb.ConfigChangeEntry {\n    49\t   var cc pb.ConfigChange\n    50\t   if err := cc.Unmarshal(e.Cmd); err != nil { n.t.Fatal(err) }\n    51\t   a.p.ApplyConfigChange(cc)\n    52\t  } else if len(e.Cmd) != 0 { n.t.Fatal(\"unexpected application payload\") }\n    53\t  a.applied = e.Index\n    54\t }\n    55\t a.p.NotifyRaftLastApplied(a.applied)\n    56\t for _, m := range msgs {\n    57\t  if m.Type == pb.ReadIndexResp {\n    58\t   n.responses = append(n.responses, m)\n    59\t   assuranceEvent(map[string]interface{}{\"event\":\"wire_response\", \"from\":m.From, \"to\":m.To, \"term\":m.Term, \"low\":m.Hint, \"high\":m.HintHigh, \"index\":m.LogIndex})\n    60\t  }\n    61\t  // This fixed policy models failed sends, not reordered successful delivery.\n    62\t  if m.Type == pb.Heartbeat && m.Hint == n.dropLow && n.dropLow != 0 {\n    63\t   n.dropped++\n    64\t   assuranceEvent(map[string]interface{}{\"event\":\"lost_heartbeat\", \"from\":m.From, \"to\":m.To, \"term\":m.Term, \"low\":m.Hint, \"high\":m.HintHigh})\n    65\t   continue\n    66\t  }\n    67\t  n.queue = append(n.queue, m)\n    68\t }\n    69\t}\n    70\t\n    71\tfunc (n *assuranceReadNetwork) one() pb.Message {\n    72\t if len(n.queue)==0 { n.t.Fatal(\"no queued message\") }\n    73\t m:=n.queue[0]\n    74\t n.queue=n.queue[1:]\n    75\t a,ok:=n.nodes[m.To]\n    76\t if !ok { n.t.Fatalf(\"unknown destination %d\",m.To) }\n    77\t n.delivered++\n    78\t if n.delivered>1000 { n.t.Fatal(\"unexpected message loop\") }\n    79\t a.p.Handle(m)\n    80\t n.harvest(m.To)\n    81\t return m\n    82\t}\n    83\tfunc (n *assuranceReadNetwork) drain() { for len(n.queue)>0 { n.one() } }\n    84\t\n    85\tfunc TestAssuranceRemoteReadIdentity(t *testing.T) {\n    86\t n:= &assuranceReadNetwork{t:t,nodes:make(map[uint64]*assurancePeer)}\n    87\t peers:=[]PeerAddress{{NodeID:1,Address:\"localhost:10001\"},{NodeID:2,Address:\"localhost:10002\"},{NodeID:3,Address:\"localhost:10003\"}}\n    88\t for id:=uint64(1);id<=3;id++ {\n    89\t  db:=NewTestLogDB()\n    90\t  cfg:=config.Config{ClusterID:1,NodeID:id,ElectionRTT:10,HeartbeatRTT:1,CheckQuorum:true}\n    91\t  p:=Launch(cfg,db,nil,append([]PeerAddress(nil),peers...),true,true)\n    92\t  n.nodes[id]=&assurancePeer{p:p,db:db}\n    93\t }\n    94\t for id:=uint64(1);id<=3;id++ { n.harvest(id) }\n    95\t n.drain()\n    96\t // Only node 1's clock advances until it campaigns; no private election bypass.\n    97\t for i:=0;i<30 && !n.nodes[1].p.raft.isLeader();i++ {\n    98\t  n.nodes[1].p.Tick();n.harvest(1);n.drain()\n    99\t }\n   100\t leader:=n.nodes[1].p.raft\n   101\t if !leader.isLeader() || !leader.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"leader/current-term commitment prerequisite not attained\") }\n   102\t for id:=uint64(1);id<=3;id++ {\n   103\t  r:=n.nodes[id].p.raft\n   104\t  if r.term!=leader.term || r.leaderID!=1 || n.nodes[id].applied<leader.log.committed { t.Fatalf(\"node %d not caught up\",id) }\n   105\t }\n   106\t term:=leader.term\n   107\t ctxA:=pb.SystemCtx{Low:1101,High:30}\n   108\t ctxB:=pb.SystemCtx{Low:2202,High:30}\n   109\t n.dropLow=ctxA.Low\n   110\t n.nodes[2].p.ReadIndex(ctxA);n.harvest(2);n.drain()\n   111\t if n.dropped!=2 { t.Fatalf(\"earlier loss policy dropped %d heartbeats\",n.dropped) }\n   112\t if len(leader.readIndex.pending)!=1 { t.Fatal(\"first remote read not pending\") }\n   113\t n.nodes[3].p.ReadIndex(ctxB);n.harvest(3)\n   114\t // Deliver the real forwarded ReadIndex before delivering its generated heartbeats.\n   115\t m:=n.one()\n   116\t if m.Type!=pb.ReadIndex || m.From!=3 || m.To!=1 { t.Fatal(\"unexpected forwarded request\") }\n   117\t if len(leader.readIndex.pending)!=2 || len(leader.readIndex.queue)!=2 { t.Fatal(\"overlapping prefix not established\") }\n   118\t contexts:=map[uint64]pb.SystemCtx{2:ctxA,3:ctxB}\n   119\t for _,origin:=range []uint64{2,3} {\n   120\t  ctx:=contexts[origin]\n   121\t  s,ok:=leader.readIndex.pending[ctx]\n   122\t  if !ok || s.from!=origin || s.ctx!=ctx { t.Fatal(\"pending request identity not attained\") }\n   123\t  assuranceEvent(map[string]interface{}{\"event\":\"admitted\", \"scenario\":\"remote_prefix\", \"origin\":origin, \"request_context\":fmt.Sprintf(\"%d:%d\",s.ctx.Low,s.ctx.High), \"expected_response\":fmt.Sprintf(\"%d:%d:%d\",s.from,s.ctx.Low,s.ctx.High), \"pending\":true, \"term\":term, \"current_term_committed\":leader.hasCommittedEntryAtCurrentTerm(), \"overlap_count\":len(leader.readIndex.pending), \"lost_earlier_heartbeats\":n.dropped})\n   124\t }\n   125\t // All subsequent messages are real target output, delivered in queue order.\n   126\t n.drain()\n   127\t if leader.term!=term || !leader.isLeader() { t.Fatal(\"authority changed\") }\n   128\t for _,origin:=range []uint64{2,3} {\n   129\t  ctx:=contexts[origin]\n   130\t  _,pending:=leader.readIndex.pending[ctx]\n   131\t  sigs:=[]string{}\n   132\t  for _,resp:=range n.responses {\n   133\t   if resp.To==origin { sigs=append(sigs,fmt.Sprintf(\"%d:%d:%d\",resp.To,resp.Hint,resp.HintHigh)) }\n   134\t  }\n   135\t  ready:=[]string{}\n   136\t  for _,v:=range n.nodes[origin].ready { ready=append(ready,fmt.Sprintf(\"%d:%d\",v.SystemCtx.Low,v.SystemCtx.High)) }\n   137\t  assuranceEvent(map[string]interface{}{\"event\":\"result\", \"scenario\":\"remote_prefix\", \"origin\":origin, \"released\":!pending, \"response_signature\":strings.Join(sigs,\",\"), \"response_count\":len(sigs), \"ready_contexts\":strings.Join(ready,\",\"), \"remaining_pending\":len(leader.readIndex.pending), \"remaining_queue\":len(n.queue), \"term\":leader.term})\n   138\t }\n   139\t // No goroutines, files, network connections, or caller updates remain outstanding.\n   140\t}\n{\n  \"description\": \"Exercise O-read-response-identity with two distinct remote origins: lose all contextual heartbeats for A, admit B, then deliver genuine B quorum confirmation and observe response identity for both removed requests. B is an in-history comparison, not a different obligation.\",\n  \"claim_id\": \"O-read-response-identity\",\n  \"binding_ids\": [\n    \"BI-read-release\",\n    \"BI-read-consumer\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./internal/raft\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"strings\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/lni/dragonboat/v3/config\\\"\\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\\n)\\n\\ntype assurancePeer struct {\\n p *Peer\\n db ILogDB\\n applied uint64\\n ready []pb.ReadyToRead\\n}\\n\\ntype assuranceReadNetwork struct {\\n t *testing.T\\n nodes map[uint64]*assurancePeer\\n queue []pb.Message\\n responses []pb.Message\\n dropLow uint64\\n dropped int\\n delivered int\\n}\\n\\nfunc assuranceEvent(v map[string]interface{}) {\\n b, err := json.Marshal(v)\\n if err != nil { panic(err) }\\n fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\n\\n// Complete the caller's update handoff before any outgoing message is delivered.\\n// The abstract application consumes only bootstrap config entries and the election noop.\\nfunc (n *assuranceReadNetwork) harvest(id uint64) {\\n a := n.nodes[id]\\n u := a.p.GetUpdate(true, a.applied)\\n if err := a.db.Append(u.EntriesToSave); err != nil { n.t.Fatal(err) }\\n if !pb.IsEmptyState(u.State) { a.db.SetState(u.State) }\\n msgs := append([]pb.Message(nil), u.Messages...)\\n a.ready = append(a.ready, u.ReadyToReads...)\\n entries := append([]pb.Entry(nil), u.CommittedEntries...)\\n a.p.Commit(u)\\n for _, e := range entries {\\n  if e.Type == pb.ConfigChangeEntry {\\n   var cc pb.ConfigChange\\n   if err := cc.Unmarshal(e.Cmd); err != nil { n.t.Fatal(err) }\\n   a.p.ApplyConfigChange(cc)\\n  } else if len(e.Cmd) != 0 { n.t.Fatal(\\\"unexpected application payload\\\") }\\n  a.applied = e.Index\\n }\\n a.p.NotifyRaftLastApplied(a.applied)\\n for _, m := range msgs {\\n  if m.Type == pb.ReadIndexResp {\\n   n.responses = append(n.responses, m)\\n   assuranceEvent(map[string]interface{}{\\\"event\\\":\\\"wire_response\\\", \\\"from\\\":m.From, \\\"to\\\":m.To, \\\"term\\\":m.Term, \\\"low\\\":m.Hint, \\\"high\\\":m.HintHigh, \\\"index\\\":m.LogIndex})\\n  }\\n  // This fixed policy models failed sends, not reordered successful delivery.\\n  if m.Type == pb.Heartbeat && m.Hint == n.dropLow && n.dropLow != 0 {\\n   n.dropped++\\n   assuranceEvent(map[string]interface{}{\\\"event\\\":\\\"lost_heartbeat\\\", \\\"from\\\":m.From, \\\"to\\\":m.To, \\\"term\\\":m.Term, \\\"low\\\":m.Hint, \\\"high\\\":m.HintHigh})\\n   continue\\n  }\\n  n.queue = append(n.queue, m)\\n }\\n}\\n\\nfunc (n *assuranceReadNetwork) one() pb.Message {\\n if len(n.queue)==0 { n.t.Fatal(\\\"no queued message\\\") }\\n m:=n.queue[0]\\n n.queue=n.queue[1:]\\n a,ok:=n.nodes[m.To]\\n if !ok { n.t.Fatalf(\\\"unknown destination %d\\\",m.To) }\\n n.delivered++\\n if n.delivered>1000 { n.t.Fatal(\\\"unexpected message loop\\\") }\\n a.p.Handle(m)\\n n.harvest(m.To)\\n return m\\n}\\nfunc (n *assuranceReadNetwork) drain() { for len(n.queue)>0 { n.one() } }\\n\\nfunc TestAssuranceRemoteReadIdentity(t *testing.T) {\\n n:= &assuranceReadNetwork{t:t,nodes:make(map[uint64]*assurancePeer)}\\n peers:=[]PeerAddress{{NodeID:1,Address:\\\"localhost:10001\\\"},{NodeID:2,Address:\\\"localhost:10002\\\"},{NodeID:3,Address:\\\"localhost:10003\\\"}}\\n for id:=uint64(1);id<=3;id++ {\\n  db:=NewTestLogDB()\\n  cfg:=config.Config{ClusterID:1,NodeID:id,ElectionRTT:10,HeartbeatRTT:1,CheckQuorum:true}\\n  p:=Launch(cfg,db,nil,append([]PeerAddress(nil),peers...),true,true)\\n  n.nodes[id]=&assurancePeer{p:p,db:db}\\n }\\n for id:=uint64(1);id<=3;id++ { n.harvest(id) }\\n n.drain()\\n // Only node 1's clock advances until it campaigns; no private election bypass.\\n for i:=0;i<30 && !n.nodes[1].p.raft.isLeader();i++ {\\n  n.nodes[1].p.Tick();n.harvest(1);n.drain()\\n }\\n leader:=n.nodes[1].p.raft\\n if !leader.isLeader() || !leader.hasCommittedEntryAtCurrentTerm() { t.Fatal(\\\"leader/current-term commitment prerequisite not attained\\\") }\\n for id:=uint64(1);id<=3;id++ {\\n  r:=n.nodes[id].p.raft\\n  if r.term!=leader.term || r.leaderID!=1 || n.nodes[id].applied<leader.log.committed { t.Fatalf(\\\"node %d not caught up\\\",id) }\\n }\\n term:=leader.term\\n ctxA:=pb.SystemCtx{Low:1101,High:30}\\n ctxB:=pb.SystemCtx{Low:2202,High:30}\\n n.dropLow=ctxA.Low\\n n.nodes[2].p.ReadIndex(ctxA);n.harvest(2);n.drain()\\n if n.dropped!=2 { t.Fatalf(\\\"earlier loss policy dropped %d heartbeats\\\",n.dropped) }\\n if len(leader.readIndex.pending)!=1 { t.Fatal(\\\"first remote read not pending\\\") }\\n n.nodes[3].p.ReadIndex(ctxB);n.harvest(3)\\n // Deliver the real forwarded ReadIndex before delivering its generated heartbeats.\\n m:=n.one()\\n if m.Type!=pb.ReadIndex || m.From!=3 || m.To!=1 { t.Fatal(\\\"unexpected forwarded request\\\") }\\n if len(leader.readIndex.pending)!=2 || len(leader.readIndex.queue)!=2 { t.Fatal(\\\"overlapping prefix not established\\\") }\\n contexts:=map[uint64]pb.SystemCtx{2:ctxA,3:ctxB}\\n for _,origin:=range []uint64{2,3} {\\n  ctx:=contexts[origin]\\n  s,ok:=leader.readIndex.pending[ctx]\\n  if !ok || s.from!=origin || s.ctx!=ctx { t.Fatal(\\\"pending request identity not attained\\\") }\\n  assuranceEvent(map[string]interface{}{\\\"event\\\":\\\"admitted\\\", \\\"scenario\\\":\\\"remote_prefix\\\", \\\"origin\\\":origin, \\\"request_context\\\":fmt.Sprintf(\\\"%d:%d\\\",s.ctx.Low,s.ctx.High), \\\"expected_response\\\":fmt.Sprintf(\\\"%d:%d:%d\\\",s.from,s.ctx.Low,s.ctx.High), \\\"pending\\\":true, \\\"term\\\":term, \\\"current_term_committed\\\":leader.hasCommittedEntryAtCurrentTerm(), \\\"overlap_count\\\":len(leader.readIndex.pending), \\\"lost_earlier_heartbeats\\\":n.dropped})\\n }\\n // All subsequent messages are real target output, delivered in queue order.\\n n.drain()\\n if leader.term!=term || !leader.isLeader() { t.Fatal(\\\"authority changed\\\") }\\n for _,origin:=range []uint64{2,3} {\\n  ctx:=contexts[origin]\\n  _,pending:=leader.readIndex.pending[ctx]\\n  sigs:=[]string{}\\n  for _,resp:=range n.responses {\\n   if resp.To==origin { sigs=append(sigs,fmt.Sprintf(\\\"%d:%d:%d\\\",resp.To,resp.Hint,resp.HintHigh)) }\\n  }\\n  ready:=[]string{}\\n  for _,v:=range n.nodes[origin].ready { ready=append(ready,fmt.Sprintf(\\\"%d:%d\\\",v.SystemCtx.Low,v.SystemCtx.High)) }\\n  assuranceEvent(map[string]interface{}{\\\"event\\\":\\\"result\\\", \\\"scenario\\\":\\\"remote_prefix\\\", \\\"origin\\\":origin, \\\"released\\\":!pending, \\\"response_signature\\\":strings.Join(sigs,\\\",\\\"), \\\"response_count\\\":len(sigs), \\\"ready_contexts\\\":strings.Join(ready,\\\",\\\"), \\\"remaining_pending\\\":len(leader.readIndex.pending), \\\"remaining_queue\\\":len(n.queue), \\\"term\\\":leader.term})\\n }\\n // No goroutines, files, network connections, or caller updates remain outstanding.\\n}\\n\",\n    \"description\": \"Three real Peers, test LogDB, bootstrap/election/persistence/application handoffs, then fixed selective heartbeat loss and FIFO delivery; inspect admitted statuses and resulting messages/readiness.\",\n    \"semantic_changes\": [\n      \"No target code changed. Memory storage is used without crashes; deterministic transport send-loss policy and abstract bootstrap/noop application replace outer layers.\",\n      \"All observations occur synchronously between calls; no concurrency, sleeps, termination or private protocol state injection.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admission\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"pending\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"current_term_committed\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"overlap_count\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"lost_earlier_heartbeats\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"M-read-queue\",\n        \"M-read-release\",\n        \"M-read-batches\",\n        \"M-peer-lifecycle\",\n        \"M-engine-order\",\n        \"M-bootstrap\",\n        \"M-transport-loss\",\n        \"M-send-caller\",\n        \"M-prefix-expectation\",\n        \"M-read-result-expectation\",\n        \"M-peer-update-contract\",\n        \"M-peer-bootstrap-entry\",\n        \"M-update-commit\",\n        \"M-memory-logdb\",\n        \"M-memory-append\",\n        \"M-logdb-interface\",\n        \"M-ticks\",\n        \"M-node-step\",\n        \"M-read-producer\",\n        \"M-forward-read\",\n        \"M-application-feedback\"\n      ],\n      \"expectation_ids\": [\n        \"M-read-result-expectation\"\n      ],\n      \"binding_ids\": [\n        \"BI-read-release\"\n      ],\n      \"derivation\": \"Three real Peer instances use Launch(initial=true,newNode=true) with identical three-voter bootstrap addresses and NewTestLogDB. Bootstrap entries and every later update are appended and state saved before messages are scheduled, then Peer.Commit completes the handoff. The abstract application consumes actual committed bootstrap configuration entries through ApplyConfigChange and the empty election noop, then NotifyRaftLastApplied reports actual consumed indexes; there are no user writes. Tick only node 1 until natural election and drain all resulting messages. Require every peer knows leader 1, shares its term and has applied the committed current-term noop. ReadIndex on peer 2 generates and forwards A; its two actual contextual heartbeat sends fail by declared policy. All other messages, including B from peer 3 and genuine heartbeat responses, use one global FIFO queue, a stricter schedule than per-link FIFO. Source Transport.send permits individual failed sends (including full queue) and NodeHost.sendMessage does not resend failures; no Unreachable event is required for that path. Fixed contexts are legal nonzero outputs of the production context domain, not injected confirmations. After forwarded B is handled, observe both pending statuses before processing its heartbeats. Drain remaining messages through Peer.Handle and all update completions. Memory storage substitutes durability without crashes; no network/worker resources exist. No private raft mutation or test-only election override is used.\",\n      \"applicability\": \"Single-threaded no-crash Peer integration harness, unchanged membership; substitutes a permitted lossy transport and synchronous abstract application for bootstrap/noop only.\",\n      \"unresolved\": [\n        \"No real transport queue saturation or client RequestState timeout is executed; these are scope limits, not observed outcomes.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"No arbitrary message reordering is required. Persisting before all outgoing messages is a permitted slower schedule than early replication.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-read-identity\",\n      \"checker_id\": \"check-read-identity\",\n      \"event\": \"result\",\n      \"binding_ids\": [\n        \"BI-read-release\",\n        \"BI-read-consumer\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"M-read-queue\",\n          \"M-read-release\",\n          \"M-read-batches\",\n          \"M-peer-lifecycle\",\n          \"M-engine-order\",\n          \"M-bootstrap\",\n          \"M-transport-loss\",\n          \"M-send-caller\",\n          \"M-prefix-expectation\",\n          \"M-read-result-expectation\",\n          \"M-peer-update-contract\",\n          \"M-peer-bootstrap-entry\",\n          \"M-update-commit\",\n          \"M-memory-logdb\",\n          \"M-memory-append\",\n          \"M-logdb-interface\"\n        ],\n        \"expectation_ids\": [\n          \"M-prefix-expectation\",\n          \"M-read-result-expectation\"\n        ],\n        \"binding_ids\": [\n          \"BI-read-release\",\n          \"BI-read-consumer\"\n        ],\n        \"derivation\": \"Use accepted O-read-response-identity. Response signatures concatenate actual destination and both context words, one per emitted response to the independently identified origin. The prerequisite expected signature is formed from actual admitted readStatus.from/ctx before confirmation; result is formed from actual Peer.GetUpdate messages. Two distinct origins make association independent of the compared context. A released request implies exact one-response identity, while an unreleased request does not test the duty.\",\n        \"applicability\": \"Stable-term leader consumes the admitted pending remote read after genuine follower heartbeat acknowledgments.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Higher released index is permitted and not compared.\",\n          \"No client completion deadline or full application value is checked.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"scenario\",\n          \"op\": \"eq\",\n          \"value\": \"remote_prefix\",\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"admission\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"check-read-identity\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"scenario\",\n        \"op\": \"eq\",\n        \"value\": \"remote_prefix\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"response_signature\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admission.expected_response\"\n      },\n      \"antecedent\": {\n        \"field\": \"released\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"scenario\",\n        \"origin\"\n      ],\n      \"description\": \"For each independently identified admitted origin whose pending request was removed, the actual response destination/context signature must equal its admitted destination/context signature. Both context words and multiplicity are compared.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"This is local response-correlation, not a client deadline or global linearizability measurement.\",\n    \"A non-release would make this implication hold without testing emission; actual release is recorded separately.\"\n  ]\n}","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The trusted run observed a context mismatch: node 2’s admitted read used `1101:30`, but its sole response carried `2202:30`, the later read’s context. Both requests had been removed from the leader’s pending queue, and node 2 exposed readiness under `2202:30`.\n\nThe later read’s response matched its admission. The process exited normally with the message queue drained. I’m retaining the finding as a local correlation failure; client timeout and state-machine value effects were not measured.\n"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json')); art=r['artifacts'][0]['id'];run=r['assessments'][0]['experiment_check_id']\nss=['M-prefix-expectation','M-read-result-expectation','M-read-api','M-read-queue','M-read-release','M-read-batches','M-forward-read','M-dispatch','M-core-context','M-read-heartbeats','M-read-admission','M-peer-bootstrap-entry','M-bootstrap','M-peer-update-contract','M-peer-lifecycle','M-update-commit','M-logdb-interface','M-memory-logdb','M-memory-append','M-engine-order','M-transport-loss','M-send-caller','M-ticks','M-application-feedback','M-read-producer']\nrat='Reviewed artifact '+art+' version 1 and CheckRun '+run+' against fixed plan/harness and raw stdout/stderr. The accepted duty is local preservation of origin and both SystemCtx words on release of a pending remote read; it is grounded by prefix test preservation plus the existing remote-read result-context expectation, and exact-context batch lookup explains its semantic necessity. Fixed harness lines 85-105 use Launch for three peers with identical initial membership, process actual bootstrap entries, tick node 1 until actual election, and require current-term commitment and applied catch-up at all peers. Lines 38-55 append update entries/save Raft state before making copied outgoing messages deliverable, Commit the update, apply the bootstrap configuration/noop and report actual consumed applied indexes. This is a no-crash memory-storage abstraction; no target fields or election callbacks are overwritten. Lines 61-68 implement a preselected failed-send policy only for A contextual heartbeats; other output messages use one FIFO queue, and lines 71-83 dispatch through Peer.Handle then complete the recipient update. Transport.send permits failed sends and the production caller does not retry them, so no arbitrary delivery reorder or omitted mandatory Unreachable notification is necessary for the selected full-queue failure path. The finite initial no-tick interval on other nodes permits election; no progress deadline relies on it. Lines 107-124 submit distinct nonzero contexts through real remote Peer.ReadIndex paths and observe both original readStatus records before B heartbeats are delivered. The context High value is a client GC tag, not a raft expiration or authority premise; Peer accepts the given distinct contexts and no client deadline is tested. Stable term and leadership are checked after draining. Because there is no other input, reset or membership change during drain, the observed removals are attributable to genuine B heartbeat confirmation through readIndex.confirm, not an authority reset.\\\\n\\\\nRaw CA_EVENT indices 0-1 record both lost A heartbeats; 2 and 3 record admissions for origins 2 and 3 with expected signatures 2:1101:30 and 3:2202:30, two pending requests and current-term commitment at term 2. Events 4-5 are copied actual ReadIndexResp messages from leader 1, both at index 4 and context 2202:30, to origins 2 and 3 respectively. Result 6 for origin 2 records released=true, response_count=1, signature 2:2202:30, and follower readiness 2202:30; result 7 for origin 3 records released=true and matching signature 3:2202:30. Both report pending=0 and transport queue=0. The monitor correlates each result to its own prior admission by scenario/origin (6->2 and 7->3), independently of the compared context. It checks an implication with actual release true for both; origin 2 violates context preservation while origin 3 holds for this history. The signature also distinguishes destination and multiplicity; in this fixed no-duplication, one-request-per-origin history exactly one response was observed, so the decisive mismatch is context rather than an extra-response restriction.\\\\n\\\\nObservations are synchronous: expected identity is copied from the live pending status before confirmation, outgoing values are copied from Peer.GetUpdate before Commit clears messages, and readiness is copied before Commit clears it. No worker concurrently mutates these values. The driver never fills in an expected response as an observation and does not identify operations by the field being compared. GetUpdate/Commit completes for every dispatched message; the loop drains normally and no external threads/files/connections require cleanup. Go exit code 0 and empty stderr establish normal execution, not the property verdict; the parsed identity comparison supplies the discrepancy. The source cause matches measurement: local branch uses s.ctx, but remote branch uses m.Hint/m.HintHigh while looping over all released statuses. No issue was found in correspondence for this bounded local witness.'\nitem=dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ss,rationale=rat,counterevidence=['The later request returns its own context correctly; local release uses stored context.','Index promotion across a confirmed prefix is intended and not a violation.','Client timeout and close mechanisms remain available and prevent inferring permanent blocking.'],limitations=['No NodeHost RequestState outcome, timeout duration, state-machine read value or global linearizability consequence was executed.','Memory storage and a legal lossy-transport abstraction were used; actual queue saturation and crash durability were not tested.','Unchanged membership, one leader term, distinct contexts and one read per remote origin; results do not settle other read or authority paths.'],report_title='远程读批量确认返回了后续请求的上下文',report_answer='同一任期内，节点 2 的请求上下文为 1101:30；后续请求确认后，节点 2 却收到 2202:30，且原请求已从领导者待处理队列移除。测试正常结束，验证的是本地响应关联错误，未测量客户端超时或线性一致性后果。')\nd=dict(action='review',artifact_id=art,review_items=[item],rationale='Review the actual complete local counterexample without converting the Go PASS into a property result or inferring unmeasured client consequences.',feedback=dict(ref_ids=[run,art,'e9495b6859ad4644a1bfe4966a7d0104','B-read-release','F-read-pending','M-read-release','M-read-batches'],answered='Trusted execution observed a fully admitted and released read from node 2 (1101:30) receiving the later request context (2202:30), while the later node 3 request matched. Raw message and follower-ready observations agree; both pending reads and the transport queue were empty at normal completion. Source emission substitutes confirming-message context for each released remote status.',remaining=['No client deadline, eventual timeout or state-machine value consequence was measured. These are independent scope limits, not prerequisites for the local correlation counterexample.','After review, use another sourced relationship for further investigation rather than rerun the answered context mismatch.'],understanding='unchanged',rationale='The measured local emission failure answers the selected discriminator; broader endpoints remain explicitly unmeasured.',question_updates={'e9495b6859ad4644a1bfe4966a7d0104':dict(unknowns=[],resume_conditions=[])}))\njson.dump(d,open('submission-review.json','w'),indent=2)\np=subprocess.run(r['validation']['command']+['submission-review.json'],capture_output=True,text=True);print(p.stdout);print(p.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
