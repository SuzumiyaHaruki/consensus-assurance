e'],external_effects=['Registry changes; local removal requests stop; pending configuration completion'],cross_activity_effects={'A1':'Changes quorum and may trigger commit on removal','A2':'Leader removed locally steps down; observer promotion changes role'},unknowns=['Concurrent application/raft scheduling around configuration completion not deeply analyzed'])\nb('B-storage','A6','engine step worker, node log reader and LogDB','Per-node update with entries, term/vote/commit and snapshot','Engine processes Peer update; startup replays most recent snapshot and saved Raft state',['M-engine-order','M-send-order','M-consumers','M-fastapply','M-replay','M-startup'],durable_effects=['SaveRaftState persists update before ordinary response messages are sent'],external_effects=['Replicate/Ping may send before persistence; other messages send through processRaftUpdate after persistence','FastApply allowed without snapshot and without committed entries intersecting entries-to-save; otherwise application enqueued after save'],writes=['Startup loads saved state, log range and snapshot into reader; newRaft loads member maps and term/vote/commit'],cross_activity_effects={'A1':'Persistence boundary qualifies replication/vote responses for later consumers','A2':'Restart reconstructs saved context and enters nonleader role'},unknowns=['LogDB backend durability implementation and crash atomicity remain unread'])\nb('B-recovery','A3','raft snapshot intake and state machine recovery worker','Snapshot index/term/membership and local committed history','InstallSnapshot qualifies history; successful state-machine Recover calls RestoreRemotes',['M-recovery','M-follower-append','M-recover-complete','M-application-feedback'],implementation_guards=['Snapshot at/below commit ignored; matching index/term advances commit without restore','Unsupported role conversion rejected'],writes=['Full restore resets log committed/processed to snapshot index; recovery restores membership remote maps'],async_boundaries=['Raft snapshot acceptance -> queued application/recovery -> RestoreRemotes under raftMu'],cross_activity_effects={'A1':'Recovered log and member progress determine subsequent support','A2':'Snapshot membership can remove leader or promote observer'},unknowns=['Snapshot transfer retries and abort scheduling details remain open'])\nb('B-apply','A5','engine application workers and StateMachine callbacks','Committed log entries, local applied index and request identities','Committed update queues entries; application callback updates clients and node step samples applied index',['M-engine-order','M-consumers','M-application-feedback','M-node-step','M-rsm-config'],external_effects=['Optional commit notification then toApply queue; proposal application notifies by ClientID/SeriesID/Key; read notification follows applied index'],writes=['Node step samples state-machine last applied and calls NotifyRaftLastApplied'],cross_activity_effects={'A2':'Applied progress releases election restriction on outstanding committed entries','A7':'Client completion follows application or a distinct timeout/drop outcome'},unknowns=['State machine session deduplication internals and all application variants remain unread'])\nF=[dict(id='F-commit',meaning='This raft instance records a committed log prefix through committed index. Leader counted-support advancement requires a current-term entry; follower leader propagation and snapshot history are other establishment paths.',identity={'cluster':'clusterID','prefix':'log index through committed'},validity_context='Local log history and accepted term/context; survives role reset, while snapshots may replace available prefix representation.',representation=['entryLog.committed'],durability='Volatile advancement is exported in Raft state; engine SaveRaftState supplies persistence boundary.',recovery='Startup loads saved state and snapshot; restore can establish snapshot prefix.',source_ids=['M-core-formation','M-log-protection','M-log-qualification','M-recovery','M-startup'],unknowns=['Backend crash consistency not inspected']),dict(id='F-read-pending',meaning='The leader has retained one read barrier request with its origin, SystemCtx and sampled committed index, pending quorum confirmation; this does not assert completion.',identity={'leader':'cluster/node and current term','request':'SystemCtx pair','origin':'readStatus.from'},validity_context='Current leader readIndex instance; unique retained context; prefix release may raise its sampled index to a later confirmed index.',representation=['readIndex.pending[SystemCtx]','readIndex.queue','readStatus.index/from/ctx/confirmed'],invalidators=['B-authority','B-read-release'],durability='Volatile, not persisted.',recovery='No recovery of pending leader requests; requester may timeout or be terminated independently.',source_ids=['M-read-queue','M-read-release','M-core-formation'],unknowns=['Remote response correlation across prefix release is the selected discriminator'])]\n# Explicit additional establishment of commit through snapshot restoration.\nfor z in B:\n if z['id']=='B-recovery': z['produces_fact_ids']=['F-commit']\n if z['id']=='B-storage': z['produces_fact_ids']=['F-commit']\n if z['id']=='B-apply': z['consumes_fact_ids']=['F-commit']\nacts=[]\nroles=json.load(open('../research.json'))['activity_roles']\nfor a,r in roles.items():\n bs=[x for x in B if x['primary_activity']==a]\n acts.append(dict(class_id=a,applicability='applicable',purpose=r['relation'],realization_summary='; '.join(x['trigger'] for x in bs),entry_points=[x['id'] for x in bs],source_ids=list(dict.fromkeys(y for x in bs for y in x['source_ids']))))\ndef path(ex,ids,fs,ss): return dict(explanation=ex,behavior_ids=ids,fact_ids=fs,source_ids=ss)\nm=dict(version=1,target_profile=dict(system_boundary='Captured Dragonboat Go implementation, node/engine, internal raft and state-machine coordination. Transport and LogDB are in-repository mechanisms; their deeper fault/ordering de