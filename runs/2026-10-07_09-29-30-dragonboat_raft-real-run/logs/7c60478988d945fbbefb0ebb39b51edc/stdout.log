without actual log.\n../agent-source/nodehost.go:183:\tIsWitness bool\n../agent-source/nodehost.go:404:// RequestAddWitness methods.\n../agent-source/nodehost.go:625:\t// Witnesses is a map of NodeID values to NodeHost Raft addrsses for all\n../agent-source/nodehost.go:626:\t// witnesses in the Raft cluster.\n../agent-source/nodehost.go:627:\tWitnesses map[uint64]string\n../agent-source/nodehost.go:654:\t\t\t\tWitnesses:      m.Witnesses,\n../agent-source/nodehost.go:934:\tif n.isWitness() {\n../agent-source/nodehost.go:977:// permanently loses its majority quorum. See the ImportSnapshot method in the\n../agent-source/nodehost.go:1112:// SyncRequestAddWitness is the synchronous variant of the RequestAddWitness\n../agent-source/nodehost.go:1113:// method. See RequestAddWitness for more details.\n../agent-source/nodehost.go:1116:func (nh *NodeHost) SyncRequestAddWitness(ctx context.Context,\n../agent-source/nodehost.go:1123:\trs, err := nh.RequestAddWitness(clusterID,\n../agent-source/nodehost.go:1217:// quorum when replicating state. An observer can be promoted to a regular node\n../agent-source/nodehost.go:1252:// RequestAddWitness is a Raft cluster membership change method for requesting\n../agent-source/nodehost.go:1253:// the specified node to be added as a witness to the given Raft cluster. It\n../agent-source/nodehost.go:1254:// starts an asynchronous request to add the specified node as an witness.\n../agent-source/nodehost.go:1256:// A witness can vote in elections but it doesn't have any Raft log or\n../agent-source/nodehost.go:1257:// application state machine associated. The witness node can not be used\n../agent-source/nodehost.go:1259:// Section 11.7.2 of Diego Ongaro's thesis contains more info on such witness\n../agent-source/nodehost.go:1262:// Application should later call StartCluster with config.Config.IsWitness\n../agent-source/nodehost.go:1263:// set to true on the right NodeHost to actually start the witness node.\n../agent-source/nodehost.go:1274:// SyncGetClusterMembership method. The requested add witness operation will be\n../agent-source/nodehost.go:1277:func (nh *NodeHost) RequestAddWitness(clusterID uint64,\n../agent-source/nodehost.go:1288:\treturn n.requestAddWitnessWithOrderID(nodeID,\n../agent-source/nodehost.go:1908:\t\twitness := msg.Snapshot.Witness\n../agent-source/nodehost.go:1909:\t\tplog.Debugf(\"%s is sending snapshot to %s, witness %t, index %d, size %d\",\n../agent-source/nodehost.go:1911:\t\t\twitness, msg.Snapshot.Index, msg.Snapshot.FileSize)\n../agent-source/nodehost.go:1913:\t\t\tif witness || !n.OnDiskStateMachine() {\n../agent-source/README.md:17:Consensus algorithms such as Raft provides fault-tolerance by alllowing a system continue to operate as long as the majority member servers are available. For example, a Raft cluster of 5 servers can make progress even if 2 servers fail. It also appears to clients as a single entity with strong data consistency always provided. All Raft replicas can be used to handle read requests for aggregated read throughput.\n../agent-source/README.md:28:* Built-in tool to repair Raft clusters that permanently lost the quorum\n../agent-source/README.md:37:* witness member\n\tShouldStop() <-chan struct{}\n}\n\n// ISnapshotter is the interface for the snapshotter object.\ntype ISnapshotter interface {\n\tGetSnapshot(uint64) (pb.Snapshot, error)\n\tGetMostRecentSnapshot() (pb.Snapshot, error)\n\tStream(IStreamable, SSMeta, pb.IChunkSink) error\n\tShrunk(ss pb.Snapshot) (bool, error)\n\tSave(ISavable, SSMeta) (pb.Snapshot, SSEnv, error)\n\tLoad(pb.Snapshot, ILoadable, IRecoverable) error\n\tIsNoSnapshotError(error) bool\n}\n\n// StateMachine is the state machine component in the replicated state machine\n// scheme.\ntype StateMachine struct {\n\tmu sync.RWMutex\n\t// lastApplied is the last applied index visibile to other modules in the\n\t// system. it is updated by only setting the last index and term values of\n\t// the update batch. it is protected by its own mutex to minimize contention\n\t// with the update thread\n\tlastApplied struct {\n\t\tsync.Mutex\n\t\tindex uint64\n\t\tterm  uint64\n\t}\n\t// applied index and term values updated for each update entry. they are\n\t// primarily used to ensure index values applied into the SM are continuous\n\t// and the term values never move backward. they are only accessed when\n\t// StateMachine.mu is locked\n\t\t\tif e.Index == 0 || e.Term == 0 {\n\t\t\t\tplog.Panicf(\"invalid entry, %v\", e)\n\t\t\t}\n\t\t\tif idx == 0 {\n\t\t\t\tindex = e.Index\n\t\t\t\tterm = e.Term\n\t\t\t} else {\n\t\t\t\tif e.Index != index+1 {\n\t\t\t\t\tplog.Panicf(\"%s, index gap found, %d,%d\", s.id(), index, e.Index)\n\t\t\t\t}\n\t\t\t\tif e.Term < term {\n\t\t\t\t\tplog.Panicf(\"%s, term moving backward, %d, %d\", s.id(), term, e.Term)\n\t\t\t\t}\n\t\t\t\tindex = e.Index\n\t\t\t\tterm = e.Term\n\t\t\t}\n\t\t}\n\t\ts.lastApplied.Lock()\n\t\tdefer s.lastApplied.Unlock()\n\t\tif s.lastApplied.index+1 != entries[0].Index {\n\t\t\tplog.Panicf(\"%s, gap between batches, %d, %d\", s.id())\n\t\t}\n\t\tif s.lastApplied.term > entries[0].Term {\n\t\t\tplog.Panicf(\"%s, invalid term\", s.id())\n\t\t}\n\t\ts.lastApplied.index = entries[len(entries)-1].Index\n\t\ts.lastApplied.term = entries[len(entries)-1].Term\n\t}\n}\n\nfunc (s *StateMachine) savingDummySnapshot(r SSRequest) bool {\n\t})\n}\n\nfunc (r *raft) makeInstallSnapshotMessage(to uint64, m *pb.Message) uint64 {\n\tm.To = to\n\tm.Type = pb.InstallSnapshot\n\tsnapshot := r.log.snapshot()\n\tif pb.IsEmptySnapshot(snapshot) {\n\t\tplog.Panicf(\"%s got an empty snapshot\", r.describe())\n\t}\n\t// For witness, snapshot message will be marked as dummy snapshot.\n\tif _, ok := r.witnesses[to]; ok {\n\t\tsnapshot = makeWitnessSnapshot(snapshot)\n\t}\n\tm.Snapshot = snapshot\n\treturn snapshot.Index\n}\n\nfunc makeWitnessSnapshot(snapshot pb.Snapshot) pb.Snapshot {\n\tresult := snapshot\n\tresult.Filepath = \"\"\n\tresult.FileSize = 0\n\tresult.Files = nil\n\tresult.Witness = true\n\tresult.Dummy = false\n\treturn result\n}\n\nfunc (r *raft) makeReplicateMessage(to uint64,\n\tnext uint64, maxSize uint64) (pb.Message, error) {\n\tterm, err := r.log.term(next - 1)\n\tif err != nil {\n\t\treturn pb.Message{}, err\n\t}\n\tentries, err := r.log.entries(next, maxSize)\n\tif err != nil {\n\t\treturn pb.Message{}, err\n\t}\n\tif len(entries) > 0 {\n\t\tlastIndex := entries[len(entries)-1].Index\n\t\texpected := next - 1 + uint64(len(entries))\n\t\tif lastIndex != expected {\n\t\t\tplog.Panicf(\"%s expected last index in Replicate %d, got %d\",\n\t\t\t\tr.describe(), expected, lastIndex)\n\t\t}\n\t}\n\t// Don't send actual log entry to witness as they won't replicate real message,\n\t// unless there is a config change.\n\tif _, ok := r.witnesses[to]; ok {\n\t\tentries = makeMetadataEntries(entries)\n\t}\n\treturn pb.Message{\n\t\tTo:       to,\n\t\tType:     pb.Replicate,\n\t\tLogIndex: next - 1,\n\t\tLogTerm:  term,\n\t\tEntries:  entries,\n\t\tCommit:   r.log.committed,\n\t}, nil\n}\n\nfunc makeMetadataEntries(entries []pb.Entry) []pb.Entry {\n\tme := make([]pb.Entry, 0, len(entries))\n\tfor _, ent := range entries {\n\t\tif ent.Type != pb.ConfigChangeEntry {\n\t\t\tme = append(me, pb.Entry{\n\t\t\t\tType:  pb.MetadataEntry,\n\t\t\t\tIndex: ent.Index,\n\t\t\t\tTerm:  ent.Term,\n\t\t\t})\n\t\t} else {\n\t\t\tme = append(me, ent)\n\t\t}\n\t}\n\treturn me\n}\n\nfunc (r *raft) handleObserverReadIndexResp(m pb.Message) {\n\tr.handleFollowerReadIndexResp(m)\n}\n\n//\n// message handlers used by witness, re-route them to follower handlers\n//\n\nfunc (r *raft) handleWitnessReplicate(m pb.Message) {\n\tr.handleFollowerReplicate(m)\n}\n\nfunc (r *raft) handleWitnessHeartbeat(m pb.Message) {\n\tr.handleFollowerHeartbeat(m)\n}\n\nfunc (r *raft) handleWitnessSnapshot(m pb.Message) {\n\tr.handleFollowerInstallSnapshot(m)\n}\n\n//\n// message handlers used by follower\n//\n\nfunc (r *raft) handleFollowerPropose(m pb.Message) {\n\treturn r.state == witness\n}\n\nfunc (r *raft) mustBeLeader() {\n\tif !r.isLeader() {\n\t\tplog.Panicf(\"%s is not leader\", r.describe())\n\t}\n}\n\nfunc (r *raft) setLeaderID(leaderID uint64) {\n\tr.leaderID = leaderID\n\tif r.events != nil {\n\t\tif (r.term == 0 && leaderID == NoLeader) ||\n\t\t\tleaderID != r.prevLeader.LeaderID || r.term != r.prevLeader.Term {\n\t\t\tinfo := server.LeaderInfo{\n\t\t\t\tClusterID: r.clusterID,\n\t\t\t\tNodeID:    r.nodeID,\n\t\t\t\tLeaderID:  leaderID,\n\t\t\t\tTerm:      r.term,\n\t\t\t}\n\t\t\tr.prevLeader = info\n\t\t\tr.events.LeaderUpdated(info)\n\t\t}\n\t}\n}\n\nfunc (r *raft) leaderTransfering() bool {\n\treturn r.leaderTransferTarget != NoNode && r.isLeader()\n}\n\nfunc (r *raft) abortLeaderTransfer() {\n\tr.leaderTransferTarget = NoNode\n}\n\nfunc (r *raft) numVotingMembers() int {\n","exit_code":0,"status":"completed"}}
