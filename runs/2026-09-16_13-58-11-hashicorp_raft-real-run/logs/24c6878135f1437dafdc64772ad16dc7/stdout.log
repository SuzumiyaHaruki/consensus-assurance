          "ServerID",
          "matchIndexes",
          "commitIndex",
          "startIndex"
        ],
        "contexts": [
          "Leadership instance",
          "Current tracked voter set",
          "Reported matching prefixes"
        ],
        "event_paths": [
          "newCommitment -> match or setConfiguration -> recalculate -> commitIndex advancement"
        ],
        "points": [],
        "trigger_rationale": "The complete accumulator implementation and its stated input contract are available. No suspected defect is required to audit this consequential consumer."
      },
