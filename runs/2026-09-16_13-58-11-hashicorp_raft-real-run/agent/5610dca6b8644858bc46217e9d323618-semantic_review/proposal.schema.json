{
  "$defs": {
    "AuditQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CoveragePoint"
          },
          "title": "Points",
          "type": "array"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "question",
        "importance",
        "source_ids",
        "participants",
        "objects",
        "contexts",
        "event_paths",
        "points",
        "trigger_rationale"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "minItems": 1,
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "associations",
        "anchor",
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "BindingSplit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "JSON pointer to one diagnosed, unaccepted binding",
          "title": "Path",
          "type": "string"
        },
        "bindings": {
          "description": "Complete replacement BindingDraft objects, each anchored in supplied code; preserve the entire original behavior range and associations",
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Bindings",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bindings",
        "rationale"
      ],
      "title": "BindingSplit",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending",
        "grounding"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "CodeUse": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "direct",
            "input",
            "support",
            "environment",
            "handoff"
          ],
          "title": "Role",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Relation Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "unverified": {
          "items": {
            "type": "string"
          },
          "title": "Unverified",
          "type": "array"
        }
      },
      "required": [
        "binding_id",
        "role",
        "claim_ids",
        "relation_ids",
        "source_ids",
        "rationale",
        "unverified"
      ],
      "title": "CodeUse",
      "type": "object"
    },
    "CoveragePoint": {
      "additionalProperties": false,
      "properties": {
        "sequence_required": {
          "title": "Sequence Required",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "establish",
            "maintain",
            "use",
            "handoff",
            "recover",
            "other"
          ],
          "title": "Phase",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "sequence_required",
        "id",
        "phase",
        "source_ids",
        "binding_ids",
        "claim_ids",
        "question",
        "unknowns"
      ],
      "title": "CoveragePoint",
      "type": "object"
    },
    "GraphPatch": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 15,
          "title": "Claims",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 20,
          "title": "Bindings",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDraft"
          },
          "maxItems": 30,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitDraft"
          },
          "maxItems": 5,
          "title": "Units",
          "type": "array"
        },
        "expected_versions": {
          "type": "array",
          "description": "Dictionary encoded as unique key/value_json entries; value_json contains a valid JSON value",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value_json": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value_json"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "claims",
        "bindings",
        "relations",
        "units",
        "expected_versions",
        "rationale",
        "gaps"
      ],
      "title": "GraphPatch",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "behavior_ids": {
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "expectation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object",
      "required": [
        "behavior_ids",
        "expectation_ids",
        "binding_ids",
        "derivation",
        "applicability",
        "unresolved",
        "conflicts",
        "alternatives"
      ]
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    },
    "RelationDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "depends_all",
            "alternative",
            "supports",
            "maps",
            "conditional_on",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "group",
        "rationale",
        "pending",
        "grounding"
      ],
      "title": "RelationDraft",
      "type": "object"
    },
    "Replacement": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "One exact JSON pointer from repair_targets",
          "title": "Path",
          "type": "string"
        },
        "value_json": {
          "description": "JSON encoding of the replacement value, not a whole new response",
          "title": "Value Json",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value_json"
      ],
      "title": "Replacement",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "parameters": {
          "type": "array",
          "description": "Dictionary encoded as unique key/value_json entries; value_json contains a valid JSON value",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value_json": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value_json"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description",
        "assumptions",
        "excluded",
        "parameters"
      ],
      "title": "Scope",
      "type": "object"
    },
    "UnitDraft": {
      "additionalProperties": false,
      "properties": {
        "audit_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_uses": {
          "items": {
            "$ref": "#/$defs/CodeUse"
          },
          "title": "Code Uses",
          "type": "array"
        },
        "coverage_intent": {
          "items": {
            "$ref": "#/$defs/CoveragePoint"
          },
          "title": "Coverage Intent",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "goal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Goal Ids",
          "type": "array"
        },
        "obligation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Obligation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Binding Ids",
          "type": "array"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Relation Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "goal_observable": {
          "title": "Goal Observable",
          "type": "boolean"
        }
      },
      "required": [
        "audit_question",
        "code_uses",
        "coverage_intent",
        "id",
        "goal_ids",
        "obligation_ids",
        "binding_ids",
        "relation_ids",
        "scope",
        "rationale",
        "goal_observable"
      ],
      "title": "UnitDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft_patch": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphPatch"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit alternative scope/location proposal for a graph_patch draft; preserve existing claims, relations, checked obligations and fault scope. This is not a mechanical field replacement and is fully revalidated."
    },
    "binding_splits": {
      "items": {
        "$ref": "#/$defs/BindingSplit"
      },
      "maxItems": 4,
      "title": "Binding Splits",
      "type": "array"
    },
    "replacements": {
      "items": {
        "$ref": "#/$defs/Replacement"
      },
      "maxItems": 24,
      "title": "Replacements",
      "type": "array"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/ReadRequest"
      },
      "maxItems": 12,
      "title": "Requests",
      "type": "array"
    },
    "change_request": {
      "title": "Change Request",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "draft_patch",
    "binding_splits",
    "replacements",
    "requests",
    "change_request",
    "rationale"
  ],
  "title": "OutputRepair",
  "type": "object"
}