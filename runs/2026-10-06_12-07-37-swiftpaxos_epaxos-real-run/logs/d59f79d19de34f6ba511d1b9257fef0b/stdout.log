{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"grep -n 'func NewLatencyTable\\\\|func (.*WaitDuration' ../agent-source/replica/defs/latency.go; nl -ba ../agent-source/replica/defs/latency.go | sed -n '177,291p'; /home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nr=json.load(open('../research.json'));s=json.load(open('../state.json'));a=r['artifacts'][-1]\nprint(open(a['harness_path']).read())\np=json.load(open(a['plan_path']));p['harness'].pop('source'); print('PLAN',json.dumps(p))\nfor x in s['monitor_results']:\n if x['direct_check_id']==a['id']:print('ASSESSMENT',json.dumps(x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"grep -n 'func NewLatencyTable\\\\|func (.*WaitDuration' ../agent-source/replica/defs/latency.go; nl -ba ../agent-source/replica/defs/latency.go | sed -n '177,291p'; /home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nr=json.load(open('../research.json'));s=json.load(open('../state.json'));a=r['artifacts'][-1]\nprint(open(a['harness_path']).read())\np=json.load(open(a['plan_path']));p['harness'].pop('source'); print('PLAN',json.dumps(p))\nfor x in s['monitor_results']:\n if x['direct_check_id']==a['id']:print('ASSESSMENT',json.dumps(x))\nPY\"","aggregated_output":"package epaxos\n\nimport (\n \"bufio\"\n \"bytes\"\n \"encoding/json\"\n \"fmt\"\n \"testing\"\n \"time\"\n\n \"github.com/imdea-software/swiftpaxos/dlog\"\n \"github.com/imdea-software/swiftpaxos/replica\"\n \"github.com/imdea-software/swiftpaxos/replica/defs\"\n fastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n \"github.com/imdea-software/swiftpaxos/state\"\n)\n\n// Bounded allocation mirrors the relevant constructor state without starting\n// sockets, clocks, or executor goroutines. All protocol mutations use handlers.\nfunc assuranceWireReplica(id int32) (*Replica, []*bytes.Buffer) {\n const n = 5\n base := &replica.Replica{Logger:dlog.New(\"\",false), N:n, F:2, Id:id,\n  RPC:fastrpc.NewTableId(defs.RPC_TABLE), State:state.InitState(),\n  Stats:&defs.Stats{M:make(map[string]int)}, Thrifty:true, Dreply:true,\n  Alive:make([]bool,n), PreferredPeerOrder:make([]int32,n),\n  PeerWriters:make([]*bufio.Writer,n)}\n r := &Replica{Replica:base, InstanceSpace:make([][]*Instance,n),\n  crtInstance:make([]int32,n), CommittedUpTo:make([]int32,n), ExecedUpTo:make([]int32,n),\n  conflicts:make([]map[state.Key]*InstPair,n), maxSeqPerKey:make(map[state.Key]int32),\n  latestCPInstance:-1, maxRecvBallot:-1}\n wires:=make([]*bytes.Buffer,n)\n for i:=0;i<n;i++ {\n  r.InstanceSpace[i]=make([]*Instance,8)\n  r.crtInstance[i]=-1; r.CommittedUpTo[i]=-1; r.ExecedUpTo[i]=-1\n  r.conflicts[i]=make(map[state.Key]*InstPair)\n  r.Alive[i]=true\n  r.PreferredPeerOrder[i]=(id+1+int32(i))%n\n  wires[i]=new(bytes.Buffer);r.PeerWriters[i]=bufio.NewWriter(wires[i])\n }\n // Preserve production RPC registration order.\n r.prepareRPC=r.RPC.Register(new(Prepare),nil)\n r.prepareReplyRPC=r.RPC.Register(new(PrepareReply),nil)\n r.preAcceptRPC=r.RPC.Register(new(PreAccept),nil)\n r.preAcceptReplyRPC=r.RPC.Register(new(PreAcceptReply),nil)\n r.acceptRPC=r.RPC.Register(new(Accept),nil)\n r.acceptReplyRPC=r.RPC.Register(new(AcceptReply),nil)\n r.commitRPC=r.RPC.Register(new(Commit),nil)\n r.tryPreAcceptRPC=r.RPC.Register(new(TryPreAccept),nil)\n r.tryPreAcceptReplyRPC=r.RPC.Register(new(TryPreAcceptReply),nil)\n return r,wires\n}\n\nfunc assuranceDecode(t *testing.T, r *Replica, wire *bytes.Buffer, code byte) fastrpc.Serializable {\n t.Helper()\n got,err:=wire.ReadByte();if err!=nil {t.Fatal(err)}\n if got!=code {t.Fatalf(\"RPC code %d, expected %d\",got,code)}\n p,ok:=r.RPC.Get(got);if !ok {t.Fatal(\"unregistered RPC\")}\n msg:=p.Obj.New()\n if err:=msg.Unmarshal(wire);err!=nil {t.Fatal(err)}\n if wire.Len()!=0 {t.Fatalf(\"unconsumed bytes: %d\",wire.Len())}\n return msg\n}\n\nfunc assuranceWireEvent(t *testing.T, fields map[string]interface{}) {\n t.Helper(); b,err:=json.Marshal(fields);if err!=nil {t.Fatal(err)}\n fmt.Println(\"CA_EVENT \"+string(b))\n}\n\n\ntype assurancePacket struct { from,to int; code byte; msg fastrpc.Serializable }\ntype assuranceNet struct { r []*Replica; w [][]*bytes.Buffer; pending []assurancePacket }\nfunc (n *assuranceNet) collect(t *testing.T) {\n t.Helper()\n for from:=range n.r {for to:=range n.r {\n  wire:=n.w[from][to]\n  for wire.Len()>0 {\n   code,err:=wire.ReadByte();if err!=nil {t.Fatal(err)}\n   p,ok:=n.r[to].RPC.Get(code);if !ok {t.Fatal(\"unknown code\")}\n   msg:=p.Obj.New();if err:=msg.Unmarshal(wire);err!=nil {t.Fatal(err)}\n   n.pending=append(n.pending,assurancePacket{from,to,code,msg})\n  }\n }}\n}\nfunc (n *assuranceNet) deliver(t *testing.T,from,to int,code byte) {\n t.Helper();n.collect(t)\n for i,p:=range n.pending {\n  if p.from!=from || p.to!=to || p.code!=code {continue}\n  // A selected type is dispatched in its queued order at this receiver.\n  for j:=0;j<i;j++ {q:=n.pending[j];if q.to==to && q.code==code {t.Fatal(\"type queue order violated\")}}\n  n.pending=append(n.pending[:i],n.pending[i+1:]...)\n  t.Logf(\"dispatch %d -> %d %T %+v\",from,to,p.msg,p.msg)\n  switch m:=p.msg.(type) {\n   case *PreAccept:n.r[to].handlePreAccept(m)\n   case *PreAcceptReply:n.r[to].handlePreAcceptReply(m)\n   case *Accept:n.r[to].handleAccept(m)\n   case *AcceptReply:n.r[to].handleAcceptReply(m)\n   case *Commit:n.r[to].handleCommit(m)\n   case *Prepare:n.r[to].handlePrepare(m)\n   case *PrepareReply:n.r[to].handlePrepareReply(m)\n   default:t.Fatalf(\"unsupported packet %T\",m)\n  }\n  n.collect(t);return\n }\n t.Fatalf(\"packet missing %d -> %d code %d\",from,to,code)\n}\nfunc TestAssuranceRecoveryDecisionAgreement(t *testing.T) {\n n:=&assuranceNet{r:make([]*Replica,5),w:make([][]*bytes.Buffer,5)}\n for i:=0;i<5;i++ {n.r[i],n.w[i]=assuranceWireReplica(int32(i))}\n r:=n.r\n x:=[]state.Command{{Op:state.PUT,K:17,V:state.Value(\"chosen\")}}\n r[0].crtInstance[0]=0;r[0].startPhase1(x,0,0,0,nil)\n n.deliver(t,0,1,r[1].preAcceptRPC);n.deliver(t,0,2,r[2].preAcceptRPC)\n n.deliver(t,1,0,r[0].preAcceptReplyRPC);n.deliver(t,2,0,r[0].preAcceptReplyRPC)\n if r[0].InstanceSpace[0][0].Status!=COMMITTED {t.Fatal(\"first decision missing\")}\n first:=r[0].InstanceSpace[0][0]\n firstCommands,err:=json.Marshal(first.Cmds);if err!=nil {t.Fatal(err)}\n assuranceWireEvent(t,map[string]interface{}{\"event\":\"initial_decision\",\"replica\":0,\"instance\":0,\n  \"node\":0,\"commands\":string(firstCommands),\"status\":first.Status,\"configured_failures\":1})\n n.deliver(t,0,2,r[2].commitRPC)\n // Crash peer1 after the decision. Remaining nodes stop selecting that peer.\n for i:=0;i<5;i++ {r[i].Alive[1]=false}\n // The next instance reaches peer3 through thrifty failover. Commit0 is already\n // received/queued there but may remain undispatched while PreAccept1 is chosen.\n r[0].crtInstance[0]=1\n r[0].startPhase1([]state.Command{{Op:state.PUT,K:18,V:state.Value(\"later\")}},0,1,0,nil)\n n.deliver(t,0,2,r[2].preAcceptRPC);n.deliver(t,0,3,r[3].preAcceptRPC)\n if r[3].crtInstance[0]!=1 || r[3].InstanceSpace[0][0]!=nil {t.Fatal(\"known hole missing\")}\n assuranceWireEvent(t,map[string]interface{}{\"event\":\"known_hole\",\"replica\":0,\"instance\":0,\"coordinator\":3,\"known_max\":r[3].crtInstance[0]})\n // Run the real recovery-trigger loop. An unbuffered request queue lets the\n // harness suspend it at the next request while the protocol owner dispatches\n // the first one. The production buffered queue permits the same suspension.\n r[3].instancesToRecover=make(chan *instanceId)\n r[3].exec=&Exec{r[3]}\n executorDone:=make(chan struct{})\n go func(){r[3].executeCommands();close(executorDone)}()\n var request *instanceId\n select {\n case request=<-r[3].instancesToRecover:\n case <-time.After(30*time.Second):t.Fatal(\"executor did not produce the recovery request within harness bound\")\n }\n if request.replica!=0 || request.instance!=0 {t.Fatal(\"unexpected executor request\")}\n // After sending instance0, the source loop next sends instance1 before any\n // further instance reads. Defer cleanup independently of the comparison.\n defer func(){\n  r[3].Shutdown=true\n  select {\n  case next:=<-r[3].instancesToRecover:\n   if next.replica!=0 || next.instance!=1 {t.Error(\"unexpected queued cleanup request\")}\n  case <-time.After(5*time.Second):t.Error(\"executor cleanup request missing\");return\n  }\n  select {case <-executorDone:case <-time.After(5*time.Second):t.Error(\"executor did not stop\")}\n }()\n assuranceWireEvent(t,map[string]interface{}{\"event\":\"recovery_requested\",\"replica\":request.replica,\n  \"instance\":request.instance,\"coordinator\":3,\"known_max\":r[3].crtInstance[0],\"initial_status\":r[0].InstanceSpace[0][0].Status})\n r[3].startRecoveryForInstance(request.replica,request.instance)\n n.deliver(t,3,2,r[2].prepareRPC);n.deliver(t,3,4,r[4].prepareRPC)\n n.deliver(t,2,3,r[3].prepareReplyRPC);n.deliver(t,4,3,r[3].prepareReplyRPC)\n assuranceWireEvent(t,map[string]interface{}{\"event\":\"selected_recovery\",\"status\":r[3].InstanceSpace[0][0].Status,\"cmds\":r[3].InstanceSpace[0][0].Cmds})\n n.deliver(t,3,4,r[4].preAcceptRPC);n.deliver(t,3,0,r[0].preAcceptRPC)\n n.deliver(t,4,3,r[3].preAcceptReplyRPC);n.deliver(t,0,3,r[3].preAcceptReplyRPC)\n n.deliver(t,3,4,r[4].acceptRPC);n.deliver(t,3,0,r[0].acceptRPC)\n n.deliver(t,4,3,r[3].acceptReplyRPC);n.deliver(t,0,3,r[3].acceptReplyRPC)\n inst:=r[3].InstanceSpace[0][0]\n commands,err:=json.Marshal(inst.Cmds);if err!=nil {t.Fatal(err)}\n assuranceWireEvent(t,map[string]interface{}{\"event\":\"recovery_result\",\"node\":3,\"replica\":0,\n  \"instance\":0,\"status\":inst.Status,\"committed\":inst.Status>=COMMITTED,\n  \"commands\":string(commands),\"original_status\":r[0].InstanceSpace[0][0].Status})\n}\n\nPLAN {\"description\": \"Fresh formal check of the explored same-instance decision discrepancy, with real executor-produced recovery admission and full ordered command-content comparison. The original decision at node0 is the reference; the later completed handler suffix at node3 is compared only if it commits.\", \"claim_id\": \"C-recovery-decision-agreement\", \"binding_ids\": [\"BD-agreement-form\", \"BD-agreement-recover\", \"BD-agreement-authority\", \"BD-agreement-accept\", \"BD-agreement-learn\"], \"harness\": {\"execution_package\": \"./epaxos\", \"files\": {}, \"kind\": \"go_test\", \"description\": \"Controlled actual-handler schedule with codec receipt, per-type FIFO dispatch and a real recovery-trigger worker.\", \"semantic_changes\": [\"Bound allocation to eight instances per row; omit autonomous peer listeners and protocol event loops, preserving their selected dispatch semantics.\", \"Buffer sockets and explicitly separate receipt from per-type dispatch; model one peer crash using the Alive eligibility change.\", \"Run the actual executor only at node3 for its known hole; use unbuffered recovery queue to suspend it at the next request and synchronize cleanup.\", \"Emit command JSON and status snapshots; target code and message fields are not replaced.\"], \"prerequisites\": [{\"alias\": \"first\", \"event\": \"initial_decision\", \"conditions\": [{\"field\": \"status\", \"op\": \"eq\", \"value\": 4, \"reference\": null}]}, {\"alias\": \"requested\", \"event\": \"recovery_requested\", \"conditions\": [{\"field\": \"initial_status\", \"op\": \"eq\", \"value\": null, \"reference\": \"first.status\"}, {\"field\": \"known_max\", \"op\": \"eq\", \"value\": 1, \"reference\": null}]}], \"legality\": {\"source_ids\": [\"S-init\", \"S-members\", \"S-dispatch\", \"S-ballot\", \"S-recovery\", \"S-defaults\", \"S-phase1\", \"S-formation\", \"S-bcast\", \"S-commit\", \"S-attrs\", \"S-wire\", \"S-send\", \"S-receive\", \"S-rpc\", \"S-messages\", \"S-accept-wire\", \"S-preaccept-reply-wire\", \"S-run\", \"S-readme\", \"S-buffer\"], \"expectation_ids\": [\"S-formation\", \"S-commit\", \"S-recovery\", \"S-readme\"], \"binding_ids\": [], \"derivation\": \"The fixed helper mirrors N=5,F=2 constructor defaults and buffers actual SendMsg bytes, with all messages decoded via the registered New/Unmarshal factory. collect performs peer receipt/decoding and creates receiver message-type queues; deliver asserts FIFO within each receiver/type before dispatching the actual handler. This preserves the layer implemented by S-receive and S-dispatch: different RPC types enter different channels, so pending Commit0 need not dispatch before later PreAccept1. Original row0.instance0 is fast-committed by actual replies from peers1/2, then delivered to peer2. One peer1 crash is represented by making Alive[1]=false at all live nodes and never scheduling it again; peer loss updates that eligibility in S-receive. No new peer order or messages are fabricated. Thrifty failover sends next row0.instance1 to peers2/3. Node3 receives it while old Commit0 remains queued, so crtInstance[0]=1 with missing slot0, checked before the actual executeCommands loop starts. All protocol states are quiescent during the timer loop. It emits the real instancesToRecover request after its own counter; the harness checks row/instance identity and dispatches startRecoveryForInstance as run does. The queue is unbuffered solely to suspend the executor on its next instance1 request. This is a scheduling refinement of the original buffered producer, which may be suspended at the same send point; it does not change which first request was produced or the protocol state. Between sends for instance0 and instance1 the executor only increments k and reads unchanged crtInstance; it cannot read/write instance state while the recovery handlers run. The fixed handler suffix obtains a quorum from peers2/4, then dispatches the emitted phase1 and Accept exchanges with peers4/0. All decisions derive from target handlers, not installed snapshots. At the fixed observation point node3 live state has no concurrent executor access. Cleanup sets Shutdown only after observation, receives the next instance1 request, then joins the executor; the unbuffered send/receive orders the Shutdown write before the next loop read. Cleanup is independent of the compared result. Pending Commit and other messages remain visible and no global quiescence or eventual progress is assumed.\", \"applicability\": \"Static volatile N=5,F=2; one crash at peer1; node0 and node3 never fail during the comparison.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}}, \"monitors\": [{\"id\": \"M-recovery-agreement\", \"checker_id\": \"P-recovery-agreement\", \"event\": \"recovery_result\", \"binding_ids\": [\"BD-agreement-form\", \"BD-agreement-recover\", \"BD-agreement-authority\", \"BD-agreement-accept\", \"BD-agreement-learn\"], \"grounding\": {\"source_ids\": [\"S-init\", \"S-members\", \"S-dispatch\", \"S-ballot\", \"S-recovery\", \"S-defaults\", \"S-phase1\", \"S-formation\", \"S-bcast\", \"S-commit\", \"S-attrs\", \"S-wire\", \"S-send\", \"S-receive\", \"S-rpc\", \"S-messages\", \"S-accept-wire\", \"S-preaccept-reply-wire\", \"S-run\", \"S-readme\", \"S-buffer\"], \"expectation_ids\": [\"S-formation\", \"S-commit\", \"S-recovery\", \"S-readme\"], \"binding_ids\": [], \"derivation\": \"initial_decision is emitted after actual COMMITTED status at node0; commands is json.Marshal of the full ordered []state.Command, containing operation, key and value bytes. recovery_requested follows the actual executor request with an explicit first.status predecessor condition; the fixed later result is correlated by row/instance, not by command or ballot. At result, committed is actual Status>=COMMITTED and commands is the same complete encoding. The implication compares content only when the later participant commits. A false antecedent would mean no later commit in this schedule, not universal agreement. Sampling is under synchronous ownership with the executor suspended between requests.\", \"applicability\": \"One original instance, one actual recovery request, one fixed suffix result.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}, \"applicability_conditions\": [], \"admission_alias\": \"requested\"}], \"observable_properties\": [{\"checker_id\": \"P-recovery-agreement\", \"kind\": \"event_implication\", \"trigger\": {\"field\": \"event\", \"op\": \"eq\", \"value\": \"recovery_result\", \"reference\": null}, \"assertion\": {\"field\": \"commands\", \"op\": \"eq\", \"value\": null, \"reference\": \"first.commands\"}, \"antecedent\": {\"field\": \"committed\", \"op\": \"eq\", \"value\": true, \"reference\": null}, \"identity_fields\": [\"replica\", \"instance\"], \"description\": \"A later commitment for the same instance preserves the original ordered command batch.\"}], \"uncertainties\": [\"No isolation of one necessary root cause among interacting recovery/formation mechanisms.\", \"The schedule delays pending message types and suspends the executor at a reachable request boundary; production autonomous scheduling is not replayed wall-clock for wall-clock.\", \"No client-visible/application endpoint or universal recovery result is inferred.\"]}\nASSESSMENT {\"direct_check_id\": \"30819be732464c95baa110c8ecc50187\", \"experiment_check_id\": \"4c474e84178449438f85e415d0f2019b\", \"scope\": {\"description\": \"Per-instance command decision agreement across recovery in a five-node volatile configuration tolerating up to two crash failures.\", \"assumptions\": [\"Static N=5,F=2 and distinct participant identities\", \"At most one crash in the selected history; no Byzantine inputs or restart\", \"Messages are actual emitted bytes and dispatched in a schedule allowed by per-type protocol channels\"], \"excluded\": [\"Linearizability or client-visible outcomes\", \"Persistent crash restart\", \"Automatic termination or a numeric recovery deadline\"], \"parameters\": {}}, \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_12-07-37-swiftpaxos_epaxos-real-run/logs/4c474e84178449438f85e415d0f2019b/stdout.log\", \"parsing_errors\": [], \"prerequisites\": {\"status\": \"matched\", \"reason\": \"Declared prerequisites established\", \"matched_indices\": [0, 2], \"alias_indices\": {\"first\": 0, \"requested\": 2}}, \"properties\": [{\"monitor_id\": \"M-recovery-agreement\", \"checker_id\": \"P-recovery-agreement\", \"outcome\": \"violated\", \"witness_indices\": [4], \"valid_witness_indices\": [4], \"witness_complete\": true, \"comparison_complete\": true, \"missing_indices\": [], \"evaluated_indices\": [4], \"outside_applicability_indices\": [], \"correlations\": {\"4\": {\"status\": \"matched\", \"reason\": \"Declared prerequisites established\", \"matched_indices\": [0, 2], \"alias_indices\": {\"first\": 0, \"requested\": 2}}}, \"diagnostics\": [], \"limitations\": [], \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\", \"confirmed\": false}], \"adaptations\": [\"Bound allocation to eight instances per row; omit autonomous peer listeners and protocol event loops, preserving their selected dispatch semantics.\", \"Buffer sockets and explicitly separate receipt from per-type dispatch; model one peer crash using the Alive eligibility change.\", \"Run the actual executor only at node3 for its known hole; use unbuffered recovery queue to suspend it at the next request and synchronize cleanup.\", \"Emit command JSON and status snapshots; target code and message fields are not replaced.\"], \"conditions\": {\"plan_uncertainties\": [\"No isolation of one necessary root cause among interacting recovery/formation mechanisms.\", \"The schedule delays pending message types and suspends the executor at a reachable request boundary; production autonomous scheduling is not replayed wall-clock for wall-clock.\", \"No client-visible/application endpoint or universal recovery result is inferred.\"], \"grounding_unresolved\": [], \"review_limitations\": []}, \"blockers\": [\"Direct oracle correspondence is unreviewed\"], \"boundaries\": [\"Linearizability or client-visible outcomes\", \"Persistent crash restart\", \"Automatic termination or a numeric recovery deadline\", \"No isolation of one necessary root cause among interacting recovery/formation mechanisms.\", \"The schedule delays pending message types and suspends the executor at a reachable request boundary; production autonomous scheduling is not replayed wall-clock for wall-clock.\", \"No client-visible/application endpoint or universal recovery result is inferred.\"], \"review_ids\": [], \"open_issue_ids\": [], \"correspondence\": null, \"reviewed_complete\": false, \"bounded_complete\": true, \"confirmed\": false, \"outcome\": \"violated\", \"level\": \"implementation_test\", \"claim_id\": \"C-recovery-decision-agreement\", \"claim_version\": 1, \"framework_revision\": \"audit-products-v53\", \"finding_ids\": {\"P-recovery-agreement\": \"a8fe1dfd25954136aa4d4a507edad9ba\"}, \"finding_id\": \"a8fe1dfd25954136aa4d4a507edad9ba\"}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The fixed run reached the real executor request and completed cleanup. For row 0, instance 0, node 0 committed the PUT and node 3 later committed the NOOP. The trace shows a committed report arriving during recovery, but the new coordinator’s NONE self-report being selected ahead of it. I’ll review the full schedule and retain the limits on root-cause isolation and client-visible effects.\n"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/replica/defs/latency.go | sed -n '151,177p'; cat > build_agreement_review.py <<'PY'\nimport json\nr=json.load(open('../research.json'));a=r['artifacts'][-1];p=json.load(open(a['plan_path']));run=r['assessments'][-1]['experiment_check_id'];cid=next(u['candidate_id'] for u in r['units'] if u['id']==a['unit_id'])\nss=p['harness']['legality']['source_ids']+['S-peer-order']\ntext='Reviewed fixed artifact '+a['id']+' v1, its accepted requirement and dependency basis, full harness/plan, raw CheckRun '+run+' and monitor correlations. The written responsibility is same-instance command agreement, grounded in the implementation commitment, immutable learned-decision guards and recovery preservation branch, not a timing or endpoint promise. The complete original batch is encoded from live node0 state after actual COMMITTED status: PUT key17 value bytes for chosen. The later result is live node3 status4/committed=true with batch NONE key0 empty value, for the same replica=0,instance=0. These are semantically distinct operations, not merely different byte encodings of equivalent nil values. The JSON encoding retains full ordered operations/keys/value bytes. The event implication committed=>commands==first.commands matches the obligation; committed is true in this run, so equality is actually tested. first and requested are separately observed prerequisites, requested explicitly references first.status, and admission_alias=requested selects the owed suffix observation. Row/instance correlation is independent of content, ballot and node context. There are no parser errors, missing results or ambiguous identities. The earlier exploration is not this Evidence. The fixed run actually waits for executeCommands to send its first recovery request for the checked known hole; raw timestamps span about 13.1 seconds and no deadline property is inferred.\\\\n\\\\nHistory reconstruction: unmodified owner0 startPhase1 emits its initial proposal to peers1/2, whose serialized replies cause actual fast commitment and full Commit. Peer2 learns it. Peer1 then stops being scheduled and Alive[1] becomes false, matching peer-loss eligibility updates; this is one crash within F=2. Original row0.instance1 reaches peers2/3 by actual thrifty selection. At node3 the earlier Commit0 remains received and queued while PreAccept1 dispatches, establishing crtInstance[0]=1 and nil slot0. This ordering is allowed by separate registered RPC-type channels and run select; collect preserves byte receipt and the helper rejects FIFO violations within each receiver/type. It does not assume arbitrary reversal of a single dispatch queue. A finite delay of pending Commit and runnable protocol handlers while the executor advances is permitted under the selected asynchronous safety scope; no fairness deadline is assumed. Preferred peer arrays are constructor-compatible and supply the needed distinct preferred recipients; S-peer-order permits latency-based ranking. The check does not need one hard-coded deployment latency.\\\\n\\\\nThe actual executor starts on quiescent node3 state and produces (row0,instance0). The unbuffered request channel holds its next instance1 send. Source lines408-417 show that after sending instance0, before the next request completes, it only advances k and reads unchanged crtInstance; it cannot inspect or execute the instance while the main owner performs the recovery suffix. This scheduling refinement is attainable by suspending the production buffered-queue producer at the same point; it neither creates the first request nor installs protocol state. After the fixed comparison, cleanup sets Shutdown, receives the next request and joins the worker. The unbuffered receive precedes completion of that send, ordering Shutdown before the next outer-loop read. The worker does not read Shutdown between the two sends. All prerequisite checks and cleanup checks passed; shutdown occurs after the measured state, and cleanup is independent of the predicate.\\\\n\\\\nAt Prepare ballot8, peer2 actually reports COMMITTED with the original PUT, while peer4 reports NONE. Source startRecoveryForInstance has tagged the empty self report with vbal8, and handlePrepareReply selects the highest VBallot, leaving NONE ahead of the remote value ballot0. The trace then shows actual re-formation with NOOP, preaccept responses from peers4/0, and Accept acknowledgments from those peers. Peer0 retains its committed original command through the existing guards, raises its promise on PreAccept, and responds at ballot8; its reply is counted by coordinator3, which commits the NOOP. Thus protections were exercised rather than removed, but their composition did not preserve the per-instance decision. All messages were emitted and decoded by target methods; the driver never substitutes a command, status, result or reply. Important contrary qualifications: the earlier decision is preserved locally at its owner; the discrepancy is across participants, not an overwrite of that owner. A future Commit, a different selected quorum or self state containing commands could yield another outcome but cannot erase two completed distinct commitments in this history. The known VBallot codec and accepted-phase reporting findings remain separate: this run does not establish either as a necessary cause, and the decisive committed remote report already has original VBallot0. The observed source chain identifies interactions, not a minimal patch or independent causal experiment.'\nitem=dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ss,rationale=text,counterevidence=[],limitations=['A controlled asynchronous schedule with one crash; no prevalence, universal failure or wall-clock recovery guarantee.','No client-visible result, execution divergence or linearizability comparison was measured.','No unique necessary root cause or suffic