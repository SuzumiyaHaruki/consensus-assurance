lse\n   128\t\t\t\t}\n   129\t\t\t} else {\n   130\t\t\t\tmaster.alive[i] = true\n   131\t\t\t}\n   132\t\t}\n   133\t\tmaster.lock.Lock()\n   134\t\tfor i, node := range master.nodes {\n   135\t\t\tpingNode(i, node)\n   136\t\t}\n   137\t\t// initialization is finished\n   138\t\t// (i.e., `alive` has been computed)\n   139\t\tmaster.finishInit = true\n   140\t\tmaster.initCond.Broadcast()\n   141\t\tmaster.lock.Unlock()\n   142\t\n   143\t\tbeTheLeader := func(i int) error {\n   144\t\t\tif master.alive[i] {\n   145\t\t\t\tbtlReply := defs.NewBeTheLeaderReply()\n   146\t\t\t\terr := master.nodes[i].Call(\"Replica.BeTheLeader\", &defs.BeTheLeaderArgs{}, btlReply)\n   147\t\t\t\tif err == nil {\n   148\t\t\t\t\tdefs.UpdateBeTheLeaderReply(btlReply)\n   149\t\t\t\t\tleaderI := i\n   150\t\t\t\t\tif btlReply.Leader != -1 {\n   151\t\t\t\t\t\t// TODO: need to set leader[old_leader] to false?\n   152\t\t\t\t\t\tleaderI = int(btlReply.Leader)\n   153\t\t\t\t\t}\n   154\t\t\t\t\tmaster.leader[leaderI] = true\n   155\t\t\t\t\tmaster.nextLeader = int(btlReply.NextLeader)\n   156\t\t\t\t\tmaster.Printf(\"replica %d is the new leader\", leaderI)\n   157\t\t\t\t\treturn nil\n   158\t\t\t\t}\n   159\t\t\t\treturn err\n   160\t\t\t}\n   161\t\t\treturn errors.New(\"dead\")\n   162\t\t}\n   163\t\n   164\t\tfor {\n   165\t\t\ttime.Sleep(3 * time.Second)\n   166\t\t\tnew_leader = false\n   167\t\t\tfor i, node := range master.nodes {\n   168\t\t\t\tpingNode(i, node)\n   169\t\t\t}\n   170\t\n   171\t\t\tif !new_leader {\n   172\t\t\t\tcontinue\n   173\t\t\t}\n   174\t\t\tif master.nextLeader != -1 {\n   175\t\t\t\tif beTheLeader(master.nextLeader) == nil {\n   176\t\t\t\t\tcontinue\n   177\t\t\t\t}\n   178\t\t\t}\n   179\t\t\tfor i := range master.nodes {\n   180\t\t\t\tif beTheLeader(i) == nil {\n   181\t\t\t\t\tbreak\n   182\t\t\t\t}\n   183\t\t\t}\n   184\t\t}\n   185\t}\n   474\tfunc (r *Replica) clientListener(conn net.Conn) {\n   475\t\treader := bufio.NewReader(conn)\n   47