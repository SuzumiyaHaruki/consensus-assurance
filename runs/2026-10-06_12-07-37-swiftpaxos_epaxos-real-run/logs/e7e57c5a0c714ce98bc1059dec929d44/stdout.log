t\tvar (\n   418\t\t\tmsgType      uint8\n   419\t\t\terr          error = nil\n   420\t\t\tgbeacon      defs.Beacon\n   421\t\t\tgbeaconReply defs.BeaconReply\n   422\t\t)\n   423\t\n   424\t\tfor err == nil && !r.Shutdown {\n   425\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   426\t\t\t\tbreak\n   427\t\t\t}\n   428\t\n   429\t\t\tswitch uint8(msgType) {\n   430\t\n   431\t\t\tcase defs.GENERIC_SMR_BEACON:\n   432\t\t\t\tif err = gbeacon.Unmarshal(reader); err != nil {\n   433\t\t\t\t\tbreak\n   434\t\t\t\t}\n   435\t\t\t\tr.ReplyBeacon(&defs.GBeacon{\n   436\t\t\t\t\tRid:       int32(rid),\n   437\t\t\t\t\tTimestamp: gbeacon.Timestamp,\n   438\t\t\t\t})\n   439\t\t\t\tbreak\n   440\t\n   441\t\t\tcase defs.GENERIC_SMR_BEACON_REPLY:\n   442\t\t\t\tif err = gbeaconReply.Unmarshal(reader); err != nil {\n   443\t\t\t\t\tbreak\n   444\t\t\t\t}\n   445\t\t\t\tr.M.Lock()\n   446\t\t\t\tr.Latencies[rid] += time.Now().UnixNano() - gbeaconReply.Timestamp\n   447\t\t\t\tr.M.Unlock()\n   448\t\t\t\tnow := time.Now().UnixNano()\n   449\t\t\t\tr.Ewma[rid] = 0.99*r.Ewma[rid] + 0.01*float64(now-gbeaconReply.Timestamp)\n   450\t\t\t\tbreak\n   451\t\n   452\t\t\tdefault:\n   453\t\t\t\tp, exists := r.RPC.Get(msgType)\n   454\t\t\t\tif exists {\n   455\t\t\t\t\tobj := p.Obj.New()\n   456\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   457\t\t\t\t\t\tbreak\n   458\t\t\t\t\t}\n   459\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   460\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDurationID(rid))\n   461\t\t\t\t\t\tp.Chan <- obj\n   462\t\t\t\t\t}(obj)\n   463\t\t\t\t} else {\n   464\t\t\t\t\tr.Fatal(\"Error: received unknown message type \", msgType, \" from \", rid)\n   465\t\t\t\t}\n   466\t\t\t}\n   467\t\t}\n   468\t\n   469\t\tr.M.Lock()\n   470\t\tr.Alive[rid] = false\n   471\t\tr.M.Unlock()\n   472\t}\n   473\t\n   474\tfunc (r *Replica) clientListener(conn net.Conn) {\n../agent-source/run.go:15:\t\"github.com/imdea-software/swiftpaxos/epaxos\"\n../agent-source/run.