{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/epaxos/epaxos.go | sed -n '469,723p;1121,1535p'; nl -ba ../agent-source/epaxos/exec.go | head -310; grep -n '\"'^func'\"\\\\|Quorum\\\\|StableStore\\\\|Thrifty\\\\|Dreply' ../agent-source/replica/replica.go\"","aggregated_output":"   469\tfunc (r *Replica) bcastPrepare(replica int32, instance int32) {\n   470\t\tdefer func() {\n   471\t\t\tif err := recover(); err != nil {\n   472\t\t\t\tr.Println(\"Prepare bcast failed:\", err)\n   473\t\t\t}\n   474\t\t}()\n   475\t\tlb := r.InstanceSpace[replica][instance].lb\n   476\t\targs := &Prepare{r.Id, replica, instance, lb.lastTriedBallot}\n   477\t\n   478\t\tn := r.N - 1\n   479\t\tq := r.Id\n   480\t\tfor sent := 0; sent < n; {\n   481\t\t\tq = (q + 1) % int32(r.N)\n   482\t\t\tif q == r.Id {\n   483\t\t\t\tbreak\n   484\t\t\t}\n   485\t\t\tif !r.Alive[q] {\n   486\t\t\t\tcontinue\n   487\t\t\t}\n   488\t\t\tr.SendMsg(q, r.prepareRPC, args)\n   489\t\t\tsent++\n   490\t\t}\n   491\t\n   492\t}\n   493\t\n   494\tfunc (r *Replica) bcastPreAccept(replica int32, instance int32) {\n   495\t\tdefer func() {\n   496\t\t\tif err := recover(); err != nil {\n   497\t\t\t\tr.Println(\"PreAccept bcast failed:\", err)\n   498\t\t\t}\n   499\t\t}()\n   500\t\tlb := r.InstanceSpace[replica][instance].lb\n   501\t\tpa := new(PreAccept)\n   502\t\tpa.LeaderId = r.Id\n   503\t\tpa.Replica = replica\n   504\t\tpa.Instance = instance\n   505\t\tpa.Ballot = lb.lastTriedBallot\n   506\t\tpa.Command = lb.cmds\n   507\t\tpa.Seq = lb.seq\n   508\t\tpa.Deps = lb.deps\n   509\t\n   510\t\tn := r.N - 1\n   511\t\tif r.Thrifty {\n   512\t\t\tn = r.Replica.FastQuorumSize() - 1\n   513\t\t}\n   514\t\n   515\t\tsent := 0\n   516\t\tfor q := 0; q < r.N-1; q++ {\n   517\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   518\t\t\t\tcontinue\n   519\t\t\t}\n   520\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.preAcceptRPC, pa)\n   521\t\t\tsent++\n   522\t\t\tif sent >= n {\n   523\t\t\t\tbreak\n   524\t\t\t}\n   525\t\t}\n   526\t}\n   527\t\n   528\tfunc (r *Replica) bcastTryPreAccept(replica int32, instance int32) {\n   529\t\tdefer func() {\n   530\t\t\tif err := recover(); err != nil {\n   531\t\t\t\tr.Println(\"PreAccept bcast failed:\", err)\n   532\t\t\t}\n   533\t\t}()\n   534\t\tlb := r.InstanceSpace[replica][instance].lb\n   535\t\ttpa := new(TryPreAccept)\n   536\t\ttpa.LeaderId = r.Id\n   537\t\ttpa.Replica = replica\n   538\t\ttpa.Instance = instance\n   539\t\ttpa.Ballot = lb.lastTriedBallot\n   540\t\ttpa.Command = lb.cmds\n   541\t\ttpa.Seq = lb.seq\n   542\t\ttpa.Deps = lb.deps\n   543\t\n   544\t\tfor q := int32(0); q < int32(r.N); q++ {\n   545\t\t\tif q == r.Id {\n   546\t\t\t\tcontinue\n   547\t\t\t}\n   548\t\t\tif !r.Alive[q] {\n   549\t\t\t\tcontinue\n   550\t\t\t}\n   551\t\t\tr.SendMsg(q, r.tryPreAcceptRPC, tpa)\n   552\t\t}\n   553\t}\n   554\t\n   555\tfunc (r *Replica) bcastAccept(replica int32, instance int32) {\n   556\t\tdefer func() {\n   557\t\t\tif err := recover(); err != nil {\n   558\t\t\t\tr.Println(\"Accept bcast failed:\", err)\n   559\t\t\t}\n   560\t\t}()\n   561\t\n   562\t\tlb := r.InstanceSpace[replica][instance].lb\n   563\t\tea := new(Accept)\n   564\t\tea.LeaderId = r.Id\n   565\t\tea.Replica = replica\n   566\t\tea.Instance = instance\n   567\t\tea.Ballot = lb.lastTriedBallot\n   568\t\tea.Seq = lb.seq\n   569\t\tea.Deps = lb.deps\n   570\t\n   571\t\tn := r.N - 1\n   572\t\tif r.Thrifty {\n   573\t\t\tn = r.N / 2\n   574\t\t}\n   575\t\n   576\t\tsent := 0\n   577\t\tfor q := 0; q < r.N-1; q++ {\n   578\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   579\t\t\t\tcontinue\n   580\t\t\t}\n   581\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.acceptRPC, ea)\n   582\t\t\tsent++\n   583\t\t\tif sent >= n {\n   584\t\t\t\tbreak\n   585\t\t\t}\n   586\t\t}\n   587\t}\n   588\t\n   589\tfunc (r *Replica) bcastCommit(replica int32, instance int32) {\n   590\t\tdefer func() {\n   591\t\t\tif err := recover(); err != nil {\n   592\t\t\t\tr.Println(\"Commit bcast failed:\", err)\n   593\t\t\t}\n   594\t\t}()\n   595\t\tlb := r.InstanceSpace[replica][instance].lb\n   596\t\tec := new(Commit)\n   597\t\tec.LeaderId = r.Id\n   598\t\tec.Replica = replica\n   599\t\tec.Instance = instance\n   600\t\tec.Command = lb.cmds\n   601\t\tec.Seq = lb.seq\n   602\t\tec.Deps = lb.deps\n   603\t\tec.Ballot = lb.ballot\n   604\t\n   605\t\tfor q := 0; q < r.N-1; q++ {\n   606\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   607\t\t\t\tcontinue\n   608\t\t\t}\n   609\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.commitRPC, ec)\n   610\t\t}\n   611\t}\n   612\t\n   613\tfunc (r *Replica) clearHashtables() {\n   614\t\tfor q := 0; q < r.N; q++ {\n   615\t\t\tr.conflicts[q] = make(map[state.Key]*InstPair, HT_INIT_SIZE)\n   616\t\t}\n   617\t}\n   618\t\n   619\tfunc (r *Replica) updateCommitted(replica int32) {\n   620\t\tr.M.Lock()\n   621\t\tfor r.InstanceSpace[replica][r.CommittedUpTo[replica]+1] != nil &&\n   622\t\t\t(r.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == COMMITTED ||\n   623\t\t\t\tr.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == EXECUTED) {\n   624\t\t\tr.CommittedUpTo[replica] = r.CommittedUpTo[replica] + 1\n   625\t\t}\n   626\t\tr.M.Unlock()\n   627\t}\n   628\t\n   629\tfunc (r *Replica) updateConflicts(cmds []state.Command, replica int32, instance int32, seq int32) {\n   630\t\tfor i := 0; i < len(cmds); i++ {\n   631\t\t\tif dpair, present := r.conflicts[replica][cmds[i].K]; present {\n   632\t\t\t\tif dpair.last < instance {\n   633\t\t\t\t\tr.conflicts[replica][cmds[i].K].last = instance\n   634\t\t\t\t}\n   635\t\t\t\tif dpair.lastWrite < instance && cmds[i].Op != state.GET {\n   636\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   637\t\t\t\t}\n   638\t\t\t} else {\n   639\t\t\t\tr.conflicts[replica][cmds[i].K] = &InstPair{\n   640\t\t\t\t\tlast:      instance,\n   641\t\t\t\t\tlastWrite: -1,\n   642\t\t\t\t}\n   643\t\t\t\tif cmds[i].Op != state.GET {\n   644\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   645\t\t\t\t}\n   646\t\t\t}\n   647\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   648\t\t\t\tif s < seq {\n   649\t\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   650\t\t\t\t}\n   651\t\t\t} else {\n   652\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   653\t\t\t}\n   654\t\t}\n   655\t}\n   656\t\n   657\tfunc (r *Replica) updateAttributes(cmds []state.Command, seq int32, deps []int32, replica int32, instance int32) (int32, []int32, bool) {\n   658\t\tchanged := false\n   659\t\tfor q := 0; q < r.N; q++ {\n   660\t\t\tif r.Id != replica && int32(q) == replica {\n   661\t\t\t\tcontinue\n   662\t\t\t}\n   663\t\t\tfor i := 0; i < len(cmds); i++ {\n   664\t\t\t\tif dpair, present := (r.conflicts[q])[cmds[i].K]; present {\n   665\t\t\t\t\td := dpair.lastWrite\n   666\t\t\t\t\tif cmds[i].Op != state.GET {\n   667\t\t\t\t\t\td = dpair.last\n   668\t\t\t\t\t}\n   669\t\n   670\t\t\t\t\tif d > deps[q] {\n   671\t\t\t\t\t\tdeps[q] = d\n   672\t\t\t\t\t\tif seq <= r.InstanceSpace[q][d].Seq {\n   673\t\t\t\t\t\t\tseq = r.InstanceSpace[q][d].Seq + 1\n   674\t\t\t\t\t\t}\n   675\t\t\t\t\t\tchanged = true\n   676\t\t\t\t\t\tbreak\n   677\t\t\t\t\t}\n   678\t\t\t\t}\n   679\t\t\t}\n   680\t\t}\n   681\t\tfor i := 0; i < len(cmds); i++ {\n   682\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   683\t\t\t\tif seq <= s {\n   684\t\t\t\t\tchanged = true\n   685\t\t\t\t\tseq = s + 1\n   686\t\t\t\t}\n   687\t\t\t}\n   688\t\t}\n   689\t\n   690\t\treturn seq, deps, changed\n   691\t}\n   692\t\n   693\tfunc (r *Replica) mergeAttributes(seq1 int32, deps1 []int32, seq2 int32, deps2 []int32) (int32, []int32, bool) {\n   694\t\tequal := true\n   695\t\tif seq1 != seq2 {\n   696\t\t\tequal = false\n   697\t\t\tif seq2 > seq1 {\n   698\t\t\t\tseq1 = seq2\n   699\t\t\t}\n   700\t\t}\n   701\t\tfor q := 0; q < r.N; q++ {\n   702\t\t\tif int32(q) == r.Id {\n   703\t\t\t\tcontinue\n   704\t\t\t}\n   705\t\t\tif deps1[q] != deps2[q] {\n   706\t\t\t\tequal = false\n   707\t\t\t\tif deps2[q] > deps1[q] {\n   708\t\t\t\t\tdeps1[q] = deps2[q]\n   709\t\t\t\t}\n   710\t\t\t}\n   711\t\t}\n   712\t\treturn seq1, deps1, equal\n   713\t}\n   714\t\n   715\tfunc equal(deps1 []int32, deps2 []int32) bool {\n   716\t\tfor i := 0; i < len(deps1); i++ {\n   717\t\t\tif deps1[i] != deps2[i] {\n   718\t\t\t\treturn false\n   719\t\t\t}\n   720\t\t}\n   721\t\treturn true\n   722\t}\n   723\t\n  1121\tfunc (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n  1122\t\tr.IsLeader = true\n  1123\t\tr.Println(\"I am the leader\")\n  1124\t\treturn nil\n  1125\t}\n  1126\t\n  1127\tfunc (r *Replica) startRecoveryForInstance(replica int32, instance int32) {\n  1128\t\tinst := r.InstanceSpace[replica][instance]\n  1129\t\tif inst == nil {\n  1130\t\t\tinst = r.newInstanceDefault(replica, instance)\n  1131\t\t\tr.InstanceSpace[replica][instance] = inst\n  1132\t\t} else if inst.Status >= COMMITTED && inst.Cmds != nil {\n  1133\t\t\tr.Printf(\"No need to recover %d.%d\", replica, instance)\n  1134\t\t\treturn\n  1135\t\t}\n  1136\t\n  1137\t\t// no TLA guidance here (some difference with the original implementation)\n  1138\t\tvar proposals []*defs.GPropose = nil\n  1139\t\tif inst.lb != nil {\n  1140\t\t\tproposals = inst.lb.clientProposals\n  1141\t\t}\n  1142\t\tinst.lb = r.newLeaderBookkeepingDefault()\n  1143\t\tlb := inst.lb\n  1144\t\tlb.clientProposals = proposals\n  1145\t\tlb.ballot = inst.vbal\n  1146\t\tlb.seq = inst.Seq\n  1147\t\tlb.cmds = inst.Cmds\n  1148\t\tlb.deps = inst.Deps\n  1149\t\tlb.status = inst.Status\n  1150\t\tr.makeBallot(replica, instance)\n  1151\t\n  1152\t\tinst.bal = lb.lastTriedBallot\n  1153\t\tinst.vbal = lb.lastTriedBallot\n  1154\t\tpreply := &PrepareReply{\n  1155\t\t\tr.Id,\n  1156\t\t\treplica,\n  1157\t\t\tinstance,\n  1158\t\t\tinst.bal,\n  1159\t\t\tinst.vbal,\n  1160\t\t\tinst.Status,\n  1161\t\t\tinst.Cmds,\n  1162\t\t\tinst.Seq,\n  1163\t\t\tinst.Deps}\n  1164\t\n  1165\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1166\t\tlb.leaderResponded = r.Id == replica\n  1167\t\n  1168\t\tr.bcastPrepare(replica, instance)\n  1169\t}\n  1170\t\n  1171\tfunc (r *Replica) handlePrepare(prepare *Prepare) {\n  1172\t\tinst := r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1173\t\tvar preply *PrepareReply\n  1174\t\n  1175\t\tif prepare.Ballot > r.maxRecvBallot {\n  1176\t\t\tr.maxRecvBallot = prepare.Ballot\n  1177\t\t}\n  1178\t\n  1179\t\tif inst == nil {\n  1180\t\t\tr.InstanceSpace[prepare.Replica][prepare.Instance] = r.newInstanceDefault(prepare.Replica, prepare.Instance)\n  1181\t\t\tinst = r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1182\t\t}\n  1183\t\n  1184\t\tif prepare.Ballot < inst.bal {\n  1185\t\t\tr.Printf(\"Joined higher ballot %d < %d\", prepare.Ballot, inst.bal)\n  1186\t\t} else if inst.bal < prepare.Ballot {\n  1187\t\t\tr.Printf(\"Joining ballot %d \", prepare.Ballot)\n  1188\t\t\tinst.bal = prepare.Ballot\n  1189\t\t}\n  1190\t\n  1191\t\tpreply = &PrepareReply{\n  1192\t\t\tr.Id,\n  1193\t\t\tprepare.Replica,\n  1194\t\t\tprepare.Instance,\n  1195\t\t\tinst.bal,\n  1196\t\t\tinst.vbal,\n  1197\t\t\tinst.Status,\n  1198\t\t\tinst.Cmds,\n  1199\t\t\tinst.Seq,\n  1200\t\t\tinst.Deps}\n  1201\t\tr.replyPrepare(prepare.LeaderId, preply)\n  1202\t}\n  1203\t\n  1204\tfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n  1205\t\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n  1206\t\tlb := inst.lb\n  1207\t\n  1208\t\tif preply.Ballot > r.maxRecvBallot {\n  1209\t\t\tr.maxRecvBallot = preply.Ballot\n  1210\t\t}\n  1211\t\n  1212\t\tif inst == nil || lb == nil || !lb.preparing {\n  1213\t\t\treturn\n  1214\t\t}\n  1215\t\n  1216\t\tif preply.Ballot != lb.lastTriedBallot {\n  1217\t\t\tlb.nacks++\n  1218\t\t\treturn\n  1219\t\t}\n  1220\t\n  1221\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1222\t\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n  1223\t\t\treturn\n  1224\t\t}\n  1225\t\n  1226\t\tlb.preparing = false\n  1227\t\n  1228\t\t// Deal with each sub-cases in order of the (corrected) TLA specification\n  1229\t\t// only replies from the highest ballot are taken into account\n  1230\t\t// 1 -> committed/executed\n  1231\t\t// 2 -> accepted\n  1232\t\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n  1233\t\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n  1234\t\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n  1235\t\t// 6 -> none of the above\n  1236\t\tpreAcceptCount := 0\n  1237\t\tsubCase := 0\n  1238\t\tallEqual := true\n  1239\t\tfor _, element := range lb.prepareReplies {\n  1240\t\t\tif element.VBallot >= lb.ballot {\n  1241\t\t\t\tlb.ballot = element.VBallot\n  1242\t\t\t\tlb.cmds = element.Command\n  1243\t\t\t\tlb.seq = element.Seq\n  1244\t\t\t\tlb.deps = element.Deps\n  1245\t\t\t\tlb.status = element.Status\n  1246\t\t\t}\n  1247\t\t\tif element.AcceptorId == element.Replica {\n  1248\t\t\t\tlb.leaderResponded = true\n  1249\t\t\t}\n  1250\t\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n  1251\t\t\t\tpreAcceptCount++\n  1252\t\t\t}\n  1253\t\t}\n  1254\t\n  1255\t\tif lb.status >= COMMITTED { // 1\n  1256\t\t\tsubCase = 1\n  1257\t\t} else if lb.status == ACCEPTED { // 2\n  1258\t\t\tsubCase = 2\n  1259\t\t} else if lb.status == PREACCEPTED || lb.status == PREACCEPTED_EQ {\n  1260\t\t\tfor _, element := range lb.prepareReplies {\n  1261\t\t\t\tif element.VBallot == lb.ballot && element.Status >= PREACCEPTED {\n  1262\t\t\t\t\t_, _, equal := r.mergeAttributes(lb.seq, lb.deps, element.Seq, element.Deps)\n  1263\t\t\t\t\tif !equal {\n  1264\t\t\t\t\t\tallEqual = false\n  1265\t\t\t\t\t\tbreak\n  1266\t\t\t\t\t}\n  1267\t\t\t\t}\n  1268\t\t\t}\n  1269\t\t\tif preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1270\t\t\t\tsubCase = 3\n  1271\t\t\t} else if preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1272\t\t\t\tsubCase = 4\n  1273\t\t\t} else if preAcceptCount > 0 && (lb.leaderResponded || !allEqual || preAcceptCount < r.Replica.SlowQuorumSize()-1) {\n  1274\t\t\t\tsubCase = 5\n  1275\t\t\t} else {\n  1276\t\t\t\tpanic(\"Cannot occur\")\n  1277\t\t\t}\n  1278\t\t} else if lb.status == NONE {\n  1279\t\t\tsubCase = 6\n  1280\t\t} else {\n  1281\t\t\tpanic(\"Status unknown\")\n  1282\t\t}\n  1283\t\n  1284\t\t// if subCase != 5 {\n  1285\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d\\n\", preply.Replica, preply.Instance, subCase)\n  1286\t\t// } else {\n  1287\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d with (leaderResponded=%t, allEqual=%t, enough=%t)\\n\",\n  1288\t\t// \t\tpreply.Replica, preply.Instance, subCase, lb.leaderResponded, allEqual, preAcceptCount < r.Replica.SlowQuorumSize()-1)\n  1289\t\t// }\n  1290\t\n  1291\t\tinst.Cmds = lb.cmds\n  1292\t\tinst.bal = lb.lastTriedBallot\n  1293\t\tinst.vbal = lb.lastTriedBallot\n  1294\t\tinst.Seq = lb.seq\n  1295\t\tinst.Deps = lb.deps\n  1296\t\tinst.Status = lb.status\n  1297\t\n  1298\t\tif subCase == 1 {\n  1299\t\t\t// nothing to do\n  1300\t\t} else if subCase == 2 || subCase == 3 {\n  1301\t\t\tinst.Status = ACCEPTED\n  1302\t\t\tlb.status = ACCEPTED\n  1303\t\t\tr.bcastAccept(preply.Replica, preply.Instance)\n  1304\t\t} else if subCase == 4 {\n  1305\t\t\tlb.tryingToPreAccept = true\n  1306\t\t\tr.bcastTryPreAccept(preply.Replica, preply.Instance)\n  1307\t\t} else { // subCase 5 and 6\n  1308\t\t\tcmd := state.NOOP()\n  1309\t\t\tif inst.lb.cmds != nil {\n  1310\t\t\t\tcmd = inst.lb.cmds\n  1311\t\t\t}\n  1312\t\t\tr.startPhase1(cmd, preply.Replica, preply.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1313\t\t}\n  1314\t}\n  1315\t\n  1316\tfunc (r *Replica) handleTryPreAccept(tpa *TryPreAccept) {\n  1317\t\tinst := r.InstanceSpace[tpa.Replica][tpa.Instance]\n  1318\t\n  1319\t\tif inst == nil {\n  1320\t\t\tr.InstanceSpace[tpa.Replica][tpa.Instance] = r.newInstanceDefault(tpa.Replica, tpa.Instance)\n  1321\t\t\tinst = r.InstanceSpace[tpa.Replica][tpa.Instance]\n  1322\t\t}\n  1323\t\n  1324\t\tif inst.bal > tpa.Ballot {\n  1325\t\t\tr.Printf(\"Smaller ballot %d < %d\\n\", tpa.Ballot, inst.bal)\n  1326\t\t\treturn\n  1327\t\t}\n  1328\t\tinst.bal = tpa.Ballot\n  1329\t\n  1330\t\tconfRep := int32(0)\n  1331\t\tconfInst := int32(0)\n  1332\t\tconfStatus := NONE\n  1333\t\tif inst.Status == NONE { // missing in TLA spec.\n  1334\t\t\tif conflict, cr, ci := r.findPreAcceptConflicts(tpa.Command, tpa.Replica, tpa.Instance, tpa.Seq, tpa.Deps); conflict {\n  1335\t\t\t\tconfRep = cr\n  1336\t\t\t\tconfInst = ci\n  1337\t\t\t} else {\n  1338\t\t\t\tif tpa.Instance > r.crtInstance[tpa.Replica] {\n  1339\t\t\t\t\tr.crtInstance[tpa.Replica] = tpa.Instance\n  1340\t\t\t\t}\n  1341\t\t\t\tinst.Cmds = tpa.Command\n  1342\t\t\t\tinst.Seq = tpa.Seq\n  1343\t\t\t\tinst.Deps = tpa.Deps\n  1344\t\t\t\tinst.Status = PREACCEPTED\n  1345\t\t\t}\n  1346\t\t}\n  1347\t\n  1348\t\trtpa := &TryPreAcceptReply{r.Id, tpa.Replica, tpa.Instance, inst.bal, inst.vbal, confRep, confInst, confStatus}\n  1349\t\n  1350\t\tr.replyTryPreAccept(tpa.LeaderId, rtpa)\n  1351\t\n  1352\t}\n  1353\t\n  1354\tfunc (r *Replica) findPreAcceptConflicts(cmds []state.Command, replica int32, instance int32, seq int32, deps []int32) (bool, int32, int32) {\n  1355\t\tinst := r.InstanceSpace[replica][instance]\n  1356\t\tif inst != nil && len(inst.Cmds) > 0 {\n  1357\t\t\tif inst.Status >= ACCEPTED {\n  1358\t\t\t\t// already ACCEPTED or COMMITTED\n  1359\t\t\t\t// we consider this a conflict because we shouldn't regress to PRE-ACCEPTED\n  1360\t\t\t\treturn true, replica, instance\n  1361\t\t\t}\n  1362\t\t\tif inst.Seq == seq && equal(inst.Deps, deps) {\n  1363\t\t\t\t// already PRE-ACCEPTED, no point looking for conflicts again\n  1364\t\t\t\treturn false, replica, instance\n  1365\t\t\t}\n  1366\t\t}\n  1367\t\tfor q := int32(0); q < int32(r.N); q++ {\n  1368\t\t\tfor i := r.ExecedUpTo[q]; i <= r.crtInstance[q]; i++ { // FIXME this is not enough imho.\n  1369\t\t\t\tif i == -1 {\n  1370\t\t\t\t\t//do not check placeholder\n  1371\t\t\t\t\tcontinue\n  1372\t\t\t\t}\n  1373\t\t\t\tif replica == q && instance == i {\n  1374\t\t\t\t\t// no point checking past instance in replica's row, since replica would have\n  1375\t\t\t\t\t// set the dependencies correctly for anything started after instance\n  1376\t\t\t\t\tbreak\n  1377\t\t\t\t}\n  1378\t\t\t\tif i == deps[q] {\n  1379\t\t\t\t\t//the instance cannot be a dependency for itself\n  1380\t\t\t\t\tcontinue\n  1381\t\t\t\t}\n  1382\t\t\t\tinst := r.InstanceSpace[q][i]\n  1383\t\t\t\tif inst == nil || inst.Cmds == nil || len(inst.Cmds) == 0 {\n  1384\t\t\t\t\tcontinue\n  1385\t\t\t\t}\n  1386\t\t\t\tif inst.Deps[replica] >= instance {\n  1387\t\t\t\t\t// instance q.i depends on instance replica.instance, it is not a conflict\n  1388\t\t\t\t\tcontinue\n  1389\t\t\t\t}\n  1390\t\t\t\tif r.LRead || state.ConflictBatch(inst.Cmds, cmds) {\n  1391\t\t\t\t\tif i > deps[q] ||\n  1392\t\t\t\t\t\t(i < deps[q] && inst.Seq >= seq && (q != replica || inst.Status > PREACCEPTED_EQ)) {\n  1393\t\t\t\t\t\t// this is a conflict\n  1394\t\t\t\t\t\treturn true, q, i\n  1395\t\t\t\t\t}\n  1396\t\t\t\t}\n  1397\t\t\t}\n  1398\t\t}\n  1399\t\treturn false, -1, -1\n  1400\t}\n  1401\t\n  1402\tfunc (r *Replica) handleTryPreAcceptReply(tpar *TryPreAcceptReply) {\n  1403\t\tinst := r.InstanceSpace[tpar.Replica][tpar.Instance]\n  1404\t\n  1405\t\tif tpar.Ballot > r.maxRecvBallot {\n  1406\t\t\tr.maxRecvBallot = tpar.Ballot\n  1407\t\t}\n  1408\t\n  1409\t\tif inst == nil {\n  1410\t\t\tr.InstanceSpace[tpar.Replica][tpar.Instance] = r.newInstanceDefault(tpar.Replica, tpar.Instance)\n  1411\t\t\tinst = r.InstanceSpace[tpar.Replica][tpar.Instance]\n  1412\t\t}\n  1413\t\n  1414\t\tlb := inst.lb\n  1415\t\tif lb == nil || !lb.tryingToPreAccept {\n  1416\t\t\treturn\n  1417\t\t}\n  1418\t\n  1419\t\tif tpar.Ballot != lb.lastTriedBallot {\n  1420\t\t\treturn\n  1421\t\t}\n  1422\t\n  1423\t\tlb.tpaReps++\n  1424\t\n  1425\t\tif tpar.VBallot == lb.lastTriedBallot {\n  1426\t\t\tlb.preAcceptOKs++\n  1427\t\t\tif lb.preAcceptOKs >= r.N/2 {\n  1428\t\t\t\t//it's safe to start Accept phase\n  1429\t\t\t\tlb.status = ACCEPTED\n  1430\t\t\t\tlb.tryingToPreAccept = false\n  1431\t\t\t\tlb.acceptOKs = 0\n  1432\t\n  1433\t\t\t\tinst.Cmds = lb.cmds\n  1434\t\t\t\tinst.Seq = lb.seq\n  1435\t\t\t\tinst.Deps = lb.deps\n  1436\t\t\t\tinst.Status = lb.status\n  1437\t\t\t\tinst.vbal = lb.lastTriedBallot\n  1438\t\t\t\tinst.bal = lb.lastTriedBallot\n  1439\t\n  1440\t\t\t\tr.bcastAccept(tpar.Replica, tpar.Instance)\n  1441\t\t\t\treturn\n  1442\t\t\t}\n  1443\t\t} else {\n  1444\t\t\tlb.nacks++\n  1445\t\t\tlb.possibleQuorum[tpar.AcceptorId] = false\n  1446\t\t\tlb.possibleQuorum[tpar.ConflictReplica] = false\n  1447\t\t}\n  1448\t\n  1449\t\tlb.tpaAccepted = lb.tpaAccepted || (tpar.ConflictStatus >= ACCEPTED) // TLA spec. (page 39)\n  1450\t\n  1451\t\tif lb.tpaReps >= r.Replica.SlowQuorumSize()-1 && lb.tpaAccepted {\n  1452\t\t\t//abandon recovery, restart from phase 1\n  1453\t\t\tlb.tryingToPreAccept = false\n  1454\t\t\tr.startPhase1(lb.cmds, tpar.Replica, tpar.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1455\t\t\treturn\n  1456\t\t}\n  1457\t\n  1458\t\t// the code below is not checked in TLA (liveness)\n  1459\t\tnotInQuorum := 0\n  1460\t\tfor q := 0; q < r.N; q++ {\n  1461\t\t\tif !lb.possibleQuorum[tpar.AcceptorId] {\n  1462\t\t\t\tnotInQuorum++\n  1463\t\t\t}\n  1464\t\t}\n  1465\t\n  1466\t\tif notInQuorum == r.N/2 {\n  1467\t\t\t//this is to prevent defer cycles\n  1468\t\t\tif present, dq, _ := deferredByInstance(tpar.Replica, tpar.Instance); present {\n  1469\t\t\t\tif lb.possibleQuorum[dq] {\n  1470\t\t\t\t\t//an instance whose leader must have been in this instance's quorum has been deferred for this instance => contradiction\n  1471\t\t\t\t\t//abandon recovery, restart from phase 1\n  1472\t\t\t\t\tlb.tryingToPreAccept = false\n  1473\t\t\t\t\tr.makeBallot(tpar.Replica, tpar.Instance)\n  1474\t\t\t\t\tr.startPhase1(lb.cmds, tpar.Replica, tpar.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1475\t\t\t\t\treturn\n  1476\t\t\t\t}\n  1477\t\t\t}\n  1478\t\t}\n  1479\t\n  1480\t\tif lb.tpaReps >= r.N/2 {\n  1481\t\t\t//defer recovery and update deferred information\n  1482\t\t\tupdateDeferred(tpar.Replica, tpar.Instance, tpar.ConflictReplica, tpar.ConflictInstance)\n  1483\t\t\tlb.tryingToPreAccept = false\n  1484\t\t}\n  1485\t}\n  1486\t\n  1487\t// helper functions and structures to prevent defer cycles while recovering\n  1488\t\n  1489\tvar deferMap = make(map[uint64]uint64)\n  1490\t\n  1491\tfunc updateDeferred(dr int32, di int32, r int32, i int32) {\n  1492\t\tdaux := (uint64(dr) << 32) | uint64(di)\n  1493\t\taux := (uint64(r) << 32) | uint64(i)\n  1494\t\tdeferMap[aux] = daux\n  1495\t}\n  1496\t\n  1497\tfunc deferredByInstance(q int32, i int32) (bool, int32, int32) {\n  1498\t\taux := (uint64(q) << 32) | uint64(i)\n  1499\t\tdaux, present := deferMap[aux]\n  1500\t\tif !present {\n  1501\t\t\treturn false, 0, 0\n  1502\t\t}\n  1503\t\tdq := int32(daux >> 32)\n  1504\t\tdi := int32(daux)\n  1505\t\treturn true, dq, di\n  1506\t}\n  1507\t\n  1508\tfunc (r *Replica) newInstanceDefault(replica int32, instance int32) *Instance {\n  1509\t\treturn r.newInstance(replica, instance, nil, -1, -1, NONE, -1, nil)\n  1510\t}\n  1511\t\n  1512\tfunc (r *Replica) newInstance(replica int32, instance int32, cmds []state.Command, cballot int32, lballot int32, status int8, seq int32, deps []int32) *Instance {\n  1513\t\treturn &Instance{cmds, cballot, lballot, status, seq, deps, nil, 0, 0, nil, time.Now().UnixNano(), &instanceId{replica, instance}}\n  1514\t}\n  1515\t\n  1516\tfunc (r *Replica) newLeaderBookkeepingDefault() *LeaderBookkeeping {\n  1517\t\treturn r.newLeaderBookkeeping(nil, r.newNilDeps(), r.newNilDeps(), r.newNilDeps(), 0, nil, NONE, -1)\n  1518\t}\n  1519\t\n  1520\tfunc (r *Replica) newLeaderBookkeeping(p []*defs.GPropose, originalDeps []int32, committedDeps []int32, deps []int32, lastTriedBallot int32, cmds []state.Command, status int8, seq int32) *LeaderBookkeeping {\n  1521\t\treturn &LeaderBookkeeping{p, -1, true, 0, 0, 0, originalDeps, committedDeps, nil, true, false, make([]bool, r.N), 0, false, lastTriedBallot, cmds, status, seq, deps, false}\n  1522\t}\n  1523\t\n  1524\tfunc (r *Replica) newNilDeps() []int32 {\n  1525\t\tnildeps := make([]int32, r.N)\n  1526\t\tfor i := 0; i < r.N; i++ {\n  1527\t\t\tnildeps[i] = -1\n  1528\t\t}\n  1529\t\treturn nildeps\n  1530\t}\n     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t\t\"sort\"\n     5\t\n     6\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n     7\t\t\"github.com/imdea-software/swiftpaxos/state\"\n     8\t)\n     9\t\n    10\tconst (\n    11\t\tWHITE int8 = iota\n    12\t\tGRAY\n    13\t\tBLACK\n    14\t)\n    15\t\n    16\ttype Exec struct {\n    17\t\tr *Replica\n    18\t}\n    19\t\n    20\ttype SCComponent struct {\n    21\t\tnodes []*Instance\n    22\t\tcolor int8\n    23\t}\n    24\t\n    25\tfunc (e *Exec) executeCommand(replica int32, instance int32) bool {\n    26\t\tif e.r.InstanceSpace[replica][instance] == nil {\n    27\t\t\treturn false\n    28\t\t}\n    29\t\tinst := e.r.InstanceSpace[replica][instance]\n    30\t\tif inst.Status == EXECUTED {\n    31\t\t\treturn true\n    32\t\t}\n    33\t\tif inst.Status != COMMITTED {\n    34\t\t\treturn false\n    35\t\t}\n    36\t\n    37\t\tif !e.findSCC(inst) {\n    38\t\t\treturn false\n    39\t\t}\n    40\t\n    41\t\treturn true\n    42\t}\n    43\t\n    44\tvar stack []*Instance = make([]*Instance, 0, 100)\n    45\t\n    46\tfunc (e *Exec) findSCC(root *Instance) bool {\n    47\t\tindex := 1\n    48\t\t// find SCCs using Tarjan's algorithm\n    49\t\tstack = stack[0:0]\n    50\t\tret := e.strongconnect(root, &index)\n    51\t\t// reset all indexes in the stack\n    52\t\tfor j := 0; j < len(stack); j++ {\n    53\t\t\tstack[j].Index = 0\n    54\t\t}\n    55\t\treturn ret\n    56\t}\n    57\t\n    58\tfunc (e *Exec) strongconnect(v *Instance, index *int) bool {\n    59\t\tv.Index = *index\n    60\t\tv.Lowlink = *index\n    61\t\t*index = *index + 1\n    62\t\n    63\t\tl := len(stack)\n    64\t\tif l == cap(stack) {\n    65\t\t\tnewSlice := make([]*Instance, l, 2*l)\n    66\t\t\tcopy(newSlice, stack)\n    67\t\t\tstack = newSlice\n    68\t\t}\n    69\t\tstack = stack[0 : l+1]\n    70\t\tstack[l] = v\n    71\t\n    72\t\tif v.Cmds == nil {\n    73\t\t\treturn false\n    74\t\t}\n    75\t\n    76\t\tfor q := int32(0); q < int32(e.r.N); q++ {\n    77\t\t\tinst := v.Deps[q]\n    78\t\t\tfor i := e.r.ExecedUpTo[q] + 1; i <= inst; i++ {\n    79\t\t\t\tif e.r.InstanceSpace[q][i] == nil || e.r.InstanceSpace[q][i].Cmds == nil {\n    80\t\t\t\t\treturn false\n    81\t\t\t\t}\n    82\t\n    83\t\t\t\tif e.r.transconf {\n    84\t\t\t\t\tfor _, alpha := range v.Cmds {\n    85\t\t\t\t\t\tfor _, beta := range e.r.InstanceSpace[q][i].Cmds {\n    86\t\t\t\t\t\t\tif !state.Conflict(&alpha, &beta) {\n    87\t\t\t\t\t\t\t\tcontinue\n    88\t\t\t\t\t\t\t}\n    89\t\t\t\t\t\t}\n    90\t\t\t\t\t}\n    91\t\t\t\t}\n    92\t\n    93\t\t\t\tif e.r.InstanceSpace[q][i].Status == EXECUTED {\n    94\t\t\t\t\tcontinue\n    95\t\t\t\t}\n    96\t\n    97\t\t\t\tfor e.r.InstanceSpace[q][i].Status != COMMITTED {\n    98\t\t\t\t\treturn false\n    99\t\t\t\t}\n   100\t\n   101\t\t\t\tw := e.r.InstanceSpace[q][i]\n   102\t\n   103\t\t\t\tif w.Index == 0 {\n   104\t\t\t\t\tif !e.strongconnect(w, index) {\n   105\t\t\t\t\t\treturn false\n   106\t\t\t\t\t}\n   107\t\t\t\t\tif w.Lowlink < v.Lowlink {\n   108\t\t\t\t\t\tv.Lowlink = w.Lowlink\n   109\t\t\t\t\t}\n   110\t\t\t\t} else if e.inStack(w) {\n   111\t\t\t\t\tif w.Index < v.Lowlink {\n   112\t\t\t\t\t\tv.Lowlink = w.Index\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t}\n   116\t\t}\n   117\t\n   118\t\tif v.Lowlink == v.Index {\n   119\t\t\t//found SCC\n   120\t\t\tlist := stack[l:]\n   121\t\n   122\t\t\t//execute commands in the increasing order of the Seq field\n   123\t\t\tsort.Sort(nodeArray(list))\n   124\t\t\tfor _, w := range list {\n   125\t\t\t\tfor idx := 0; idx < len(w.Cmds); idx++ {\n   126\t\t\t\t\tshouldRespond := e.r.Dreply && w.lb != nil && w.lb.clientProposals != nil\n   127\t\t\t\t\tif w.Cmds[idx].Op == state.NONE {\n   128\t\t\t\t\t\t// nothing to do\n   129\t\t\t\t\t} else if shouldRespond {\n   130\t\t\t\t\t\tval := w.Cmds[idx].Execute(e.r.State)\n   131\t\t\t\t\t\te.r.ReplyProposeTS(\n   132\t\t\t\t\t\t\t&defs.ProposeReplyTS{\n   133\t\t\t\t\t\t\t\tTRUE,\n   134\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].CommandId,\n   135\t\t\t\t\t\t\t\tval,\n   136\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].Timestamp},\n   137\t\t\t\t\t\t\tw.lb.clientProposals[idx].Reply,\n   138\t\t\t\t\t\t\tw.lb.clientProposals[idx].Mutex)\n   139\t\t\t\t\t} else if w.Cmds[idx].Op == state.PUT {\n   140\t\t\t\t\t\tw.Cmds[idx].Execute(e.r.State)\n   141\t\t\t\t\t}\n   142\t\t\t\t}\n   143\t\t\t\tw.Status = EXECUTED\n   144\t\t\t}\n   145\t\t\tstack = stack[0:l]\n   146\t\t}\n   147\t\n   148\t\treturn true\n   149\t}\n   150\t\n   151\tfunc (e *Exec) inStack(w *Instance) bool {\n   152\t\tfor _, u := range stack {\n   153\t\t\tif w == u {\n   154\t\t\t\treturn true\n   155\t\t\t}\n   156\t\t}\n   157\t\treturn false\n   158\t}\n   159\t\n   160\ttype nodeArray []*Instance\n   161\t\n   162\tfunc (na nodeArray) Len() int {\n   163\t\treturn len(na)\n   164\t}\n   165\t\n   166\tfunc (na nodeArray) Less(i, j int) bool {\n   167\t\treturn na[i].Seq < na[j].Seq || (na[i].Seq == na[j].Seq && na[i].id.replica < na[j].id.replica) || (na[i].Seq == na[j].Seq && na[i].id.replica == na[j].id.replica && na[i].proposeTime < na[j].proposeTime)\n   168\t}\n   169\t\n   170\tfunc (na nodeArray) Swap(i, j int) {\n   171\t\tna[i], na[j] = na[j], na[i]\n   172\t}\n43:\tStableStore *os.File\n50:\tThrifty bool\n53:\tDreply  bool\n63:func New(alias string, id, f int, addrs []string, thrifty, exec, lread bool, config *config.Config, l *dlog.Logger) *Replica {\n84:\t\tStableStore: nil,\n91:\t\tThrifty: thrifty,\n94:\t\tDreply:  true,\n113:func (r *Replica) Ping(args *defs.PingArgs, reply *defs.PingReply) error {\n117:func (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n121:func (r *Replica) FastQuorumSize() int {\n125:func (r *Replica) SlowQuorumSize() int {\n129:func (r *Replica) WriteQuorumSize() int {\n133:func (r *Replica) ReadQuorumSize() int {\n137:func (r *Replica) ConnectToPeers() {\n174:func (r *Replica) ConnectToPeersNoListeners() {\n202:func (r *Replica) WaitForClientConnections() {\n215:func (r *Replica) SendMsg(peerId int32, code uint8, msg fastrpc.Serializable) {\n229:func (r *Replica) SendClientMsg(id int32, code uint8, msg fastrpc.Serializable) {\n243:func (r *Replica) SendMsgNoFlush(peerId int32, code uint8, msg fastrpc.Serializable) {\n256:func (r *Replica) ReplyProposeTS(reply *defs.ProposeReplyTS, w *bufio.Writer, lock *sync.Mutex) {\n264:func (r *Replica) SendBeacon(peerId int32) {\n281:func (r *Replica) ReplyBeacon(beacon *defs.GBeacon) {\n298:func (r *Replica) UpdatePreferredPeerOrder(quorum []int32) {\n328:func (r *Replica) ComputeClosestPeers() []float64 {\n385:func (r *Replica) waitForPeerConnections(done chan bool) {\n416:func (r *Replica) replicaListener(rid int, reader *bufio.Reader) {\n474:func (r *Replica) clientListener(conn net.Conn) {\n571:func Leader(ballot int32, repNum int) int32 {\n575:func NextBallotOf(rid, oldBallot int32, repNum int) int32 {\n","exit_code":0,"status":"completed"}}
