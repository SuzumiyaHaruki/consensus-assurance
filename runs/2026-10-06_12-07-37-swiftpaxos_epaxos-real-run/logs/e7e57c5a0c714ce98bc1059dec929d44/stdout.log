eAccept','Target row/instance, current promise and received Accept','Accept delivery',['S-formation'],implementation_guards=['Reject attribute mutation for lower ballot or already committed/executed'],writes=['Eligible request writes Deps, Seq, bal and vbal; does not assign Status'],external_effects=['Send AcceptReply with current bal; metadata/sync on eligible update'],produces_fact_ids=['F-value'],consumes_fact_ids=['F-value'],unknowns=['Does retained preaccepted/NONE status cause recovery to discard already accepted support?'])\nbeh('B-learn','A1','Replica.run / handleCommit','Target row/instance and commit ballot','Commit delivery',['S-commit','S-attrs'],implementation_guards=['Return if already committed/executed or commit ballot below inst.bal'],writes=['Install full Cmds/Seq/Deps, ballots and COMMITTED; update conflicts and contiguous committed prefix'],external_effects=['May requeue original client proposals for recovered NOOP; record metadata and commands, without sync here'],produces_fact_ids=['F-value','F-decision'],consumes_fact_ids=['F-value'],unknowns=['Commit for local row assumes leader bookkeeping when inspecting NOOP proposals'])\nbeh('B-authority','A2','Replica.run / startRecoveryForInstance, makeBallot; RPC BeTheLeader','Per-instance promise plus local recovery-coordinator preference','Executor recovery request; master leader notification',['S-ballot','S-recovery','S-defaults','S-master'],implementation_guards=['Recovery returns for committed instance with commands'],writes=['Reset leader bookkeeping while retaining client proposals and prior value; generate ballot from ID/N and maxRecvBallot if IsLeader; assign both inst.bal and inst.vbal to attempted ballot; append self PrepareReply'],external_effects=['Broadcast Prepare to alive peers; BeTheLeader only sets IsLeader=true'],async_boundaries=['Executor sends instancesToRecover; run owns recovery handler; master RPC separately sets IsLeader'],consumes_fact_ids=['F-value'],produces_fact_ids=['F-prepare'],cross_activity_effects={'A1':'Recovery resets reply accounting and chooses which prior attributes subsequent formation carries.'},unknowns=['Repeated attempts may reuse ballot; local recovery rewrites vbal before reporting self support; preservation consequences remain open'])\nbeh('B-prepare','A2','Replica.run / handlePrepare','Acceptor promise and stored value for requested row/instance','Prepare delivery',['S-recovery'],implementation_guards=['Only raise inst.bal when request ballot is greater; retain stored value/status/vbal'],writes=['Create default missing instance; update maxRecvBallot and promise'],external_effects=['Construct PrepareReply directly from inst.bal, inst.vbal, status, commands, Seq, Deps; send to requester'],consumes_fact_ids=['F-value'],produces_fact_ids=['F-prepare'],cross_activity_effects={'A1':'Replies report prior support used to select the next formation path.'})\nbeh('B-wire','A6','SendMsg, PrepareReply.Marshal/Unmarshal, replicaListener','PrepareReply in transit from acceptor to recovering owner','Send reply; receive registered RPC and allocate New() message',['S-wire','S-send','S-receive','S-rpc'],reads=['Source reply fields and serialized bytes'],writes=['Codec encodes/decodes identity, Ballot, Status, commands, Seq and Deps; no VBallot assignment in this codec'],external_effects=['SendMsg marshals and flushes under r.M; listener decodes into fresh object and delivers to registered channel'],async_boundaries=['Each decoded message gets a goroutine with configured delay before channel enqueue; TCP receive order is not a general dispatch-order guarantee'],consumes_fact_ids=['F-prepare'],cross_activity_effects={'A2':'Recovered support provenance crosses this serialization boundary before ballot selection.','A1':'Selected value/status depends on the delivered VBallot comparison.'},unknowns=['Need an execution witness for a handler-produced nonzero VBallot through this codec; broader decision consequence is separate'])\nbeh('B-select','A2','Replica.run / handlePrepareReply','Preparing instance with lastTriedBallot and accumulated reports','PrepareReply delivery',['S-recovery','S-attrs','S-defaults'],implementation_guards=['Requires preparing bookkeeping and reply Ballot equal to lastTriedBallot','Collect SlowQuorumSize reports including local self report'],writes=['Select value/status using VBallot >= lb.ballot; count preaccepted reports and leader participation; compare attributes; install selected value under attempted ballot'],external_effects=['Committed branch does nothing further; accepted or enough equal support broadcasts Accept; uncertain support restarts phase 1, using NOOP only if commands nil'],important_branches=['Subcase 4 duplicates subcase 3 predicate; TryPreAccept branch appears unreachable through this selection'],consumes_fact_ids=['F-prepare','F-value'],produces_fact_ids=['F-value','F-decision'],cross_activity_effects={'A1':'Selection determines reuse of accepted support versus renewed attribute formation.'},unknowns=['Self report ballot rewrite versus remote report provenance; same-VBallot status ties; counts include reports below selected VBallot'])\nbeh('B-recover-trigger','A3','executeCommands goroutine','Unexecuted known row prefix','Repeated polling of missing/uncommitted/no-command instance',['S-dispatch'],writes=['Track problem instance and accumulated sleep-time counter'],external_effects=['At counter threshold enqueue recovery for problem through crtInstance'],async_boundaries=['Separate executor and protocol run goroutines; shared InstanceSpace not uniformly synchronized'],cross_activity_effects={'A2':'Requests startRecoveryForInstance without requiring global leadership.'},unknowns=['Counter measures iterations, not a strict elapsed-time deadline; dependency-blocked committed roots may need separate continuation analysis'])\nbeh('B-config','A4','runReplica, replica.New, master.run','Fixed peer list and configured process identities','Registration, initialization, connection loss and master polling',['S-run','S-members','S-master','S-receive'],writes=['N from addresses, F from configuration count; Alive from connection establishment/loss; preferred peer order; master chooses leader'],external_effects=['EPaxos constructor forces Thrifty; run passes Durable=false and transconf=false'],cross_activity_effects={'A1':'FastQuorumSize=F+(F+1)/2; SlowQuorumSize=(N+1)/2; Accept threshold uses N/2.','A2':'Master promotion enables higher-ballot retry preference but does not revoke old instance contexts.'},unknowns=['Allowed non-odd membership configurations and relation between registered list/config count require separate contract reading'])\nbeh('B-exec','A5','executeCommands and Exec.strongconnect','Committed dependency graph and row execution prefix','Polling committed instance with commands',['S-dispatch','S-exec','S-state'],implementation_guards=['Requires root COMMITTED and traversed unexecuted dependencies COMMITTED with commands'],writes=['Tarjan SCC ordering; sort by Seq, replica then local proposeTime; execute commands and mark EXECUTED'],external_effects=['Dreply=true returns values to retained client proposals after command execution; otherwise only PUT changes application state'],consumes_fact_ids=['F-decision'],cross_activity_effects={'A1':'Consumes chosen attributes as dependency and intra-SCC execution order.','A7':'Completion reply is tied to local retained proposal metadata.'},unknowns=['Local time tie-breaker consistency for same-row equal-Seq cycles; asynchronous observation ownership; SCAN conflict integration'])\nbeh('B-client','A7','replica.clientListener and protocol run','Client proposal and reply writer identity','PROPOSE received',['S-client','S-phase1','S-members'],writes=['Wrap proposal with writer/mutex and enqueue delayed proposal'],external_effects=['Default Dreply=true; client retry handling explicitly TODO in handlePropose'],cross_activity_effects={'A1':'Queued proposal supplies command batch to an owner instance.'},unknowns=['Client retry policy and deduplication contract not yet traced'])\nF=[dict(id='F-value',meaning='Stored command attributes and status associated with the local instance, with bal used for promise checks and vbal reported as value provenance; status does not necessarily advance on an Accept handler update.',identity={'replica':'InstanceSpace row','instance':'InstanceSpace index'},validity_context='One local replica and current instance state; revised by protocol and recovery handlers.',representation=['Instance.Cmds','Instance.Seq','Instance.Deps','Instance.Status','Instance.bal','Instance.vbal'],durability='In memory in the configured Durable=false server path; optional persistence is not assumed to reconstruct it.',recovery='Prepare reports stored fields; recovery selection may reuse or replace them.',source_ids=['S-phase1','S-formation','S-commit','S-recovery'],invalidators=[],reinterpreters=['B-select','B-authority'],unknowns=[]),dict(id='F-prepare',meaning='The producer-side PrepareReply reports the local promise, value ballot, status and attributes for a requested instance. This assertion is about the constructed reply, not guaranteed end-to-end transport preservation.',identity={'acceptor':'AcceptorId','replica':'Replica','instance':'Instance','request_context':'Ballot reported after handling Prepare'},validity_context='Reply construction in handlePrepare, or self report construction in startRecoveryForInstance; fields describe that producer point.',representation=['PrepareReply.Ballot','PrepareReply.VBallot','PrepareReply.Status','PrepareReply.Command','PrepareReply.Seq','PrepareReply.Deps'],durability='Transient message and recovery bookkeeping.',recovery='handlePrepareReply consumes VBallot to select retained support after matching request Ballot.',source_ids=['S-recovery','S-messages','S-wire'],invalidators=[],reinterpreters=['B-select'],unknowns=['Whether serialization preserves the value provenance needed by the consumer.']),dict(id='F-decision',meaning='A local instance is marked COMMITTED or later EXECUTED with command attributes, permitting dependency-ordered consumption; this records the implementation state rather than proving cluster agreement.',identity={'replica':'Instance row','instance':'Instance index'},validity_context='Current local instance after formation, commit delivery or recovery selection.',representation=['Instance.Status','Instance.Cmds','Instance.Seq','Instance.Deps'],durability='Volatile in default deployment.',recovery='Committed reports may be selected during recovery; full Commit distributes commands.',source_ids=['S-formation','S-commit','S-recovery','S-exec'],invalidators=[],reinterpreters=[],unknowns=[])]\nactivity_text=[('A1','Qualified support for formation and advancement','Local owner batches commands, forms dependency attributes, counts qualified phase replies, and propagates full decisions; Accept update/status discrepancy remains open.',['S-phase1','S-formation','S-commit']),('A2','Context validity and authority transitions','Per-instance bal promises reject older requests; lastTriedBallot qualifies replies. Recovery gathers prior support and chooses a path via VBallot/status. Master IsLeader is retry preference, not exclusive proposal authority.',['S-ballot','S-recovery']),('A3','Recover eligible participation','Executor detects incomplete known prefixes and queues per-instance recovery; recovery selection and transport are implementation-owned.',['S-dispatch','S-recovery']),('A4','Participant eligibility','Fixed peer addresses and Alive/preferred order control recipients; quorum sizes derive from N/F. No dynamic membership path established.',['S-members','S-run','S-master']),('A5','Decision application','Committed dependency graph is traversed as SCCs; commands are applied and marked EXECUTED.',['S-exec']),('A6','History and support reconstruction','Stored bal/vbal/status/attributes are exposed through PrepareReply transport. Optional disk methods exist but default deployment disables Durable and no reconstruction was established.',['S-recovery','S-wire','S-store','S-run']),('A7','Client invocation and completion','PROPOSE enters a delayed channel; owner retains client metadata; default replies follow execution. Retry duties remain unread.',['S-client','S-phase1','S-exec'])]\nA=[dict(class_id=a,applicability='applicable',purpose=p,realization_summary=t,source_ids=ss) for a,p,t,ss in activity_text]\ndef surface(entry,reason,ss,high=True):return dict(entry_point=entry,disposition='deferred',reason=reason,source_ids=ss,high_consequence=high)\nS=[surface('epaxos.(*Replica).recordInstanceMetadata','bal and vbal overwrite the same bytes; Durable=false in normal server entry and no restart reader yet established. Investigate applicability before a persistence obligation.',['S-store','S-run']),surface('epaxos.(*Replica).handleAccept','Eligible Accept updates attributes and ballots without assigning ACCEPTED. Trace legal support histories and recovery consequences.',['S-formation','S-recovery']),surface('epaxos.(*Replica).handleAcceptReply','Unequal-ballot return precedes greater-ballot retry branch; periodic recovery is an alternative continuation whose efficacy remains open.',['S-formation','S-dispatch']),surface('epaxos.(*Replica).startRecoveryForInstance','Recovery replaces vbal with newly attempted ballot before self report and may reuse ballots. Need legal overlapping history and support preservation analysis.',['S-recovery','S-ballot']),surface('epaxos.(*Replica).handleTryPreAcceptReply','Recovery selector duplicates predicates, apparently excluding entry to TryPreAccept; detailed deferred/quorum accounting remains unclassified locally.',['S-recovery','S-try']),surface('epaxos.nodeArray.Less','Equal Seq/same-row ties use local proposeTime rather than instance index; legal cycle/equal-Seq reachability unknown.',['S-exec']),surface('epaxos.(*Replica).updateAttributes / state.Conflict','Ordinary conflict index uses exact key; state.Conflict recognizes SCAN ranges. Need source of SCAN proposals and ordering responsibility.',['S-attrs','S-state']),surface('client retry policy','In-repository client implementation remains to be read; TODO in protocol is not itself an invocation guarantee.',['S-phase1'],False)]\nM=dict(version=1,target_profile=dict(system_boundary='Captured Go EPaxos package plus its in-repository replica, RPC, master, state and server-entry support; other protocol implementations are outside this initial map.',protocol_contexts=['Per-instance row/index and ballot','Static participant set; default volatile server deployment'],external_interfaces=['PROPOSE client messages','Registered peer RPC messages','Master BeTheLeader RPC'],ownership=['Protocol run goroutine owns handlers; executor is separate','Master owns registration and leader preference; per-instance owners form commands'],selection_injection=['Thrifty=true in EPaxos constructor; Durable=false, transconf=false in server entry'],source_ids=['S-init','S-run','S-members'],unknowns=['Restart reconstruction and client retry duties not established']),activities=A,behaviors=B,facts=F,surfaces=S)\nM['core_overview']=dict(status='usable',rationale='Representative formation, transfer of per-instance authority, prior support, transport and application paths have been traced. Usability describes navigation, not correctness or exhaustive coverage.',formation=dict(explanation='A proposal is batched into its receiving replica row and starts phase 1 with owner-ID ballot. Conflict indices establish Seq/Deps. Thrifty PreAccept reaches selected alive peers, whose reports are qualified by lastTriedBallot and phase status. The owner merges attributes and either fast commits under threshold/equality/initial-ballot conditions (with a small-cluster exception) or broadcasts Accept and commits after a majority count. Full Commit carries commands and attributes; receivers reject stale ballots and already established decisions. Default Dreply=true delays client response until dependency/SCC execution. Sender and receiver codecs, not just handler structs, are part of this relationship.',behavior_ids=['B-propose','B-preaccept','B-form','B-accept','B-learn','B-exec','B-config'],fact_ids=['F-value','F-decision'],source_ids=['S-phase1','S-formation','S-bcast','S-commit','S-exec','S-members']),context=dict(explanation='Authority is per row/instance. inst.bal guards incoming work; leader bookkeeping lastTriedBallot guards phase replies. Executor-driven recovery replaces local attempt bookkeeping while retaining proposals and stored value; generated ballots depend on ID/N and optionally maxRecvBallot under master-granted IsLeader. Prepare raises the promise and reports prior vbal/status/attributes. A slow quorum including the self report selects support using VBallot, then preserves a reported committed state, accepts retained support, or restarts phase 1. Prior committed instances with commands bypass recovery. No global revocation mechanism was found; stale work is handled by these local promise/status/phase checks, whose actual strength remains investigable.',behavior_ids=['B-authority','B-prepare','B-select','B-recover-trigger','B-wire'],fact_ids=['F-value','F-prepare'],source_ids=['S-ballot','S-recovery','S-dispatch','S-wire','S-master']),connection=dict(explanation='Recovery authority does not independently determine a new value: its consumer uses reported support provenance/status and attributes to decide which formation path is eligible. bal may rise while vbal and prior attributes remain in handlePrepare, separating promise from support. The local recovery entry instead updates both ballots before self reporting; remote replies cross a codec that omits VBallot. These discrepancies are unresolved premises of support preservation, not assumed agreement failures. Old phase replies face attempt/phase guards; established commit messages have status/ballot guards. Pending client proposals are retained across recovery and sometimes requeued after NOOP; consumption still requires complete committed dependencies.',behavior_ids=['B-prepare','B-wire','B-select','B-form','B-authority','B-learn','B-exec'],fact_ids=['F-value','F-prepare','F-decision'],source_ids=['S-recovery','S-wire','S-formation','S-commit','S-exec']),core_gaps=[],open_details=['PrepareReply transport provenance preservation is the first discriminator.','Accept status, recovery self provenance, ballot reuse and tie selection require separate legal-history investigation.','Optional durability/restart scope, client retries, SCAN ranges and execution-order ties remain open.'])\nq=dict(question='Does the PrepareReply transport preserve the handler-produced VBallot required by recovery support selection, or does decoding a fresh message erase nonzero value provenance?',importance='Incorrect provenance can cause recovery to rank prior support incorrectly during authority transfer; the local transport responsibility can be checked without asserting a whole-cluster agreement failure.',source_ids=['S-recovery','S-wire','S-send','S-receive','S-messages','S-rpc'],participants=['Acceptor','Recovering instance owner'],objects=['PrepareReply','Instance'],contexts=['Volatile static-membership EPaxos','Prepare handling after a nonzero owner ballot'],event_paths=['handlePreAccept -> handlePrepare -> replyPrepare -> SendMsg/Marshal -> New/Unmarshal -> handlePrepareReply'],activity_classes=['A6','A2','A1'],behavior_ids=['B-prepare','B-authority','B-wire','B-select'],fact_ids=['F-prepare'],supporting_behavior_ids={'B-preaccept':'Establishes the prior instance vbal under a nonzero original owner ballot.'},obligation_relation_kind='preservation',counterevidence=['Ballot, identity, status and payload fields are serialized; Ballot equality still qualifies recovery reports.','The self PrepareReply is appended without transport; omission affects remote reports, not every report.','VBallot zero is preserved incidentally when