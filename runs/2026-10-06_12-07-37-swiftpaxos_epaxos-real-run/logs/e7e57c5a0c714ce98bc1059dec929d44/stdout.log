 69\t\tBallot   int32\n    70\t}\n    71\t\n    72\ttype Commit struct {\n    73\t\tLeaderId int32\n    74\t\tReplica  int32\n    75\t\tInstance int32\n    76\t\tBallot   int32\n    77\t\tCommand  []state.Command\n    78\t\tSeq      int32\n    79\t\tDeps     []int32\n    80\t}\n    81\t\n    82\ttype TryPreAccept struct {\n    83\t\tLeaderId int32\n    84\t\tReplica  int32\n    85\t\tInstance int32\n    86\t\tBallot   int32\n    87\t\tCommand  []state.Command\n    88\t\tSeq      int32\n    89\t\tDeps     []int32\n    90\t}\n    91\t\n    92\ttype TryPreAcceptReply struct {\n    93\t\tAcceptorId       int32\n    94\t\tReplica          int32\n    95\t\tInstance         int32\n    96\t\tBallot           int32\n    97\t\tVBallot          int32\n    98\t\tConflictReplica  int32\n    99\t\tConflictInstance int32\n   100\t\tConflictStatus   int8\n   101\t}\n   102\t\n   103\tconst (\n   104\t\tNONE int8 = iota\n   105\t\tPREACCEPTED\n   106\t\tPREACCEPTED_EQ\n   107\t\tACCEPTED\n   108\t\tCOMMITTED\n   109\t\tEXECUTED\n   110\t)\n   111\t\n   112\ttype byteReader interface {\n   113\t\tio.Reader\n   114\t\tReadByte() (c byte, err error)\n   115\t}\n   116\t\n   117\tfunc (t *PrepareReply) New() fastrpc.Serializable {\n   118\t\treturn new(PrepareReply)\n   119\t}\n   120\tfunc (t *PrepareReply) BinarySize() (nbytes int, sizeKnown bool) {\n   121\t\treturn 0, false\n   122\t}\n   123\t\n   124\ttype PrepareReplyCache struct {\n   125\t\tmu    sync.Mutex\n   126\t\tcache []*PrepareReply\n   127\t}\n   128\t\n   129\tfunc NewPrepareReplyCache() *PrepareReplyCache {\n   130\t\tc := &PrepareReplyCache{}\n   131\t\tc.cache = make([]*PrepareReply, 0)\n   132\t\treturn c\n   133\t}\n   134\t\n   135\tfunc (p *PrepareReplyCache) Get() *PrepareReply {\n   136\t\tvar t *PrepareReply\n   137\t\tp.mu.Lock()\n   138\t\tif len(p.cache) > 0 {\n   139\t\t\tt = p.cache[len(p.cache)-1]\n   140\t\t\tp.cache = p.cache[0:(len(p.cache) - 1)]\n   141\t\t}\n   142\t\tp.mu.Unlock()\n   143\t\tif t == nil {\n   144\t\t\tt = &PrepareReply{}\n   145\t\t}\n   146\t\treturn t\n   147\t}\n   148\tfunc (p *PrepareReplyCache) Put(t *PrepareReply) {\n   149\t\tp.mu.Lock()\n   150\t\tp.cache = append(p.cache, t)\n   151\t\tp.mu.Unlock()\n   152\t}\n   153\tfunc (t *PrepareReply) Marshal(wire io.Writer) {\n   154\t\tvar b [18]byte\n   155\t\tvar bs []byte\n   156\t\tbs = b[:17]\n   157\t\ttmp32 := t.AcceptorId\n   158\t\tbs[0] = byte(tmp32)\n   159\t\tbs[1] = byte(tmp32 >> 8)\n   160\t\tbs[2] = byte(tmp32 >> 16)\n   161\t\tbs[3] = byte(tmp32 >> 24)\n   162\t\ttmp32 = t.Replica\n   163\t\tbs[4] = byte(tmp32)\n   164\t\tbs[5] = byte(tmp32 >> 8)\n   165\t\tbs[6] = byte(tmp32 >> 16)\n   166\t\tbs[7] = byte(tmp32 >> 24)\n   167\t\ttmp32 = t.Instance\n   168\t\tbs[8] = byte(tmp32)\n   169\t\tbs[9] = byte(tmp32 >> 8)\n   170\t\tbs[10] = byte(tmp32 >> 16)\n   171\t\tbs[11] = byte(tmp32 >> 24)\n   172\t\ttmp32 = t.Ballot\n   173\t\tbs[12] = byte(tmp32)\n   174\t\tbs[13] = byte(tmp32 >> 8)\n   175\t\tbs[14] = byte(tmp32 >> 16)\n   176\t\tbs[15] = byte(tmp32 >> 24)\n   177\t\tbs[16] = byte(t.Status)\n   178\t\twire.Write(bs)\n   179\t\tbs = b[:]\n   180\t\talen1 := int64(len(t.Command))\n","exit_code":0,"status":"completed"}}
