    \"monitor_id\": \"M-prepare-vballot\",\n      \"checker_id\": \"P-prepare-vballot\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        3\n      ],\n      \"valid_witness_indices\": [\n        3\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        1,\n        3\n      ],\n      \"outside_applicability_indices\": [],\n      \"correlations\": {\n        \"1\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            0\n          ],\n          \"alias_indices\": {\n            \"produced\": 0\n          }\n        },\n        \"3\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            2\n          ],\n          \"alias_indices\": {\n            \"produced\": 2\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"Bound instance allocation and omit automatic networking/timers/executor startup for local handler isolation.\",\n    \"Buffered writers replace peer sockets; the driver selects and synchronously dispatches valid emitted messages once.\",\n    \"Emit prerequisite and result JSON after synchronous handler/codec completion; no protocol implementation edits.\"\n  ],\n  \"conditions\": {\n    \"plan_uncertainties\": [\n      \"Does not execute handlePrepareReply or assert a selected decision or application result.\",\n      \"Does not simulate the executor timer/history which requested recovery; the local valid-message transport obligation is independent of that trigger.\"\n    ],\n    \"grounding_unresolved\": [],\n    \"review_limitations\": []\n  },\n  \"blockers\": [\n    \"Direct oracle correspondence is unreviewed\"\n  ],\n  \"boundaries\": [\n    \"Whole-cluster agreement or liveness consequence\",\n    \"Crash-restart persistence\",\n    \"Malformed or Byzantine message handling\",\n    \"Does not execute handlePrepareReply or assert a selected decision or application result.\",\n    \"Does not simulate the executor timer/history which requested recovery; the local valid-message transport obligation is independent of that trigger.\"\n  ],\n  \"review_ids\": [],\n  \"open_issue_ids\": [],\n  \"correspondence\": null,\n  \"reviewed_complete\": false,\n  \"bounded_complete\": true,\n  \"confirmed\": false,\n  \"outcome\": \"violated\",\n  \"level\": \"implementation_test\",\n  \"claim_id\": \"C-prepare-vballot-preservation\",\n  \"claim_version\": 1,\n  \"framework_revision\": \"audit-products-v53\",\n  \"finding_ids\": {\n    \"P-prepare-vballot\": \"afcaf92fd31c43b3b83a7a800612c1ae\"\n  },\n  \"finding_id\": \"afcaf92fd31c43b3b83a7a800612c1ae\"\n}\nclaims {\n  \"id\": \"C-prepare-vballot-preservation\",\n  \"kind\": \"obligation\",\n  \"concern\": \"implementation_semantics\",\n  \"description\": \"For a valid PrepareReply produced by an EPaxos acceptor and successfully transported through the registered peer RPC codec into a fresh message for the same acceptor/instance, the decoded VBallot must equal the producer-reported value ballot. The transport must preserve the support provenance that the recovery selector compares.\",\n  \"scope\": {\n    \"description\": \"PrepareReply value-ballot preservation at the acceptor-to-recovery RPC boundary in static-membership crash-fault EPaxos.\",\n    \"assumptions\": [\n      \"Unmodified producer and consumer codecs from the same captured implementation\",\n      \"Valid in-memory acceptor state established by protocol handlers; complete noncorrupt delivery to a fresh registered reply object\"\n    ],\n    \"excluded\": [\n      \"Whole-cluster agreement or liveness consequence\",\n      \"Crash-restart persistence\",\n      \"Malformed or Byzantine message handling\"\n    ],\n    \"parameters\": {}\n  },\n  \"source\": \"Candidate derived from attributed implementation responsibilities\",\n  \"source_ids\": [\n    \"S-recovery\",\n    \"S-wire\",\n    \"S-send\",\n    \"S-receive\",\n    \"S-rpc\",\n    \"S-messages\"\n  ],\n  \"pending\": [],\n  \"assessment\": \"unassessed\",\n  \"candidate\": true,\n  \"grounding\": {\n    \"source_ids\": [\n      \"S-recovery\",\n      \"S-wire\",\n      \"S-send\",\n      \"S-receive\",\n      \"S-rpc\",\n      \"S-messages\"\n    ],\n    \"expectation_ids\": [\n      \"S-recovery\",\n      \"S-messages\",\n      \"S-rpc\"\n    ],\n    \"binding_ids\": [],\n    \"derivation\": \"S-recovery handlePrepare copies inst.vbal into PrepareReply.VBallot, and handlePrepareReply compares this field to rank prior support. S-messages declares the distinct Ballot and VBallot fields. S-rpc/S-send/S-receive implement object transfer by Marshal then New/Unmarshal, with no alternative provenance field or reconstruction before the consumer. Preserving that value is a necessary local caller/codec responsibility, derived from the composed producer-consumer interface, not from codec behavior or a protocol name. The local equality claim does not require an observed wrong consensus decision.\",\n    \"applicability\": \"Valid same-version message transfer; newly allocated receiver object.\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": []\n  },\n  \"version\": 1\n}\nFIXED PLAN {\n  \"description\": \"For C-prepare-vballot-preservation, establish an acceptor value through an actual owner PreAccept broadcast, generate a higher Prepare with actual recovery entry, let handlePrepare emit bytes, then decode through fresh registered PrepareReply and compare VBallot to sampled producer state. Owner zero and owner one are preselected independent cases; message payload/ballot diagnostics must complete before result emission.\",\n  \"claim_id\": \"C-prepare-vballot-preservation\",\n  \"binding_ids\": [\n    \"BD-prepare-producer\",\n    \"BD-prepare-codec\",\n    \"BD-prepare-decode\",\n    \"BD-prepare-consumer\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./epaxos\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package epaxos\\n\\nimport (\\n \\\"bufio\\\"\\n \\\"bytes\\\"\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"reflect\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/imdea-software/swiftpaxos/dlog\\\"\\n \\\"github.com/imdea-software/swiftpaxos/replica\\\"\\n \\\"github.com/imdea-software/swiftpaxos/replica/defs\\\"\\n fastrpc \\\"github.com/imdea-software/swiftpaxos/rpc\\\"\\n \\\"github.com/imdea-software/swiftpaxos/state\\\"\\n)\\n\\n// Bounded allocation mirrors the relevant constructor state without starting\\n// sockets, clocks, or executor goroutines. All protocol mutations use handlers.\\nfunc assuranceWireReplica(id int32) (*Replica, []*bytes.Buffer) {\\n const n = 3\\n base := &replica.Replica{Logger:dlog.New(\\\"\\\",false), N:n, F:1, Id:id,\\n  RPC:fastrpc.NewTableId(defs.RPC_TABLE), State:state.InitState(),\\n  Stats:&defs.Stats{M:make(map[string]int)}, Thrifty:true, Dreply:true,\\n  Alive:make([]bool,n), PreferredPeerOrder:make([]int32,n),\\n  PeerWriters:make([]*bufio.Writer,n)}\\n r := &Replica{Replica:base, InstanceSpace:make([][]*Instance,n),\\n  crtInstance:make([]int32,n), CommittedUpTo:make([]int32,n), ExecedUpTo:make([]int32,n),\\n  conflicts:make([]map[state.Key]*InstPair,n), maxSeqPerKey:make(map[state.Key]int32),\\n  latestCPInstance:-1, maxRecvBallot:-1}\\n wires:=make([]*bytes.Buffer,n)\\n for i:=0;i<n;i++ {\\n  r.InstanceSpace[i]=make([]*Instance,8)\\n  r.crtInstance[i]=-1; r.CommittedUpTo[i]=-1; r.ExecedUpTo[i]=-1\\n  r.conflicts[i]=make(map[state.Key]*InstPair)\\n  r.Alive[i]=true\\n  r.PreferredPeerOrder[i]=(id+1+int32(i))%n\\n  wires[i]=new(bytes.Buffer);r.PeerWriters[i]=bufio.NewWriter(wires[i])\\n }\\n // Preserve production RPC registration order.\\n r.prepareRPC=r.RPC.Register(new(Prepare),nil)\\n r.prepareReplyRPC=r.RPC.Register(new(PrepareReply),nil)\\n r.preAcceptRPC=r.RPC.Register(new(PreAccept),nil)\\n r.preAcceptReplyRPC=r.RPC.Register(new(PreAcceptReply),nil)\\n r.acceptRPC=r.RPC.Register(new(Accept),nil)\\n r.acceptReplyRPC=r.RPC.Register(new(AcceptReply),nil)\\n r.commitRPC=r.RPC.Register(new(Commit),nil)\\n r.tryPreAcceptRPC=r.RPC.Register(new(TryPreAccept),nil)\\n r.tryPreAcceptReplyRPC=r.RPC.Register(new(TryPreAcceptReply),nil)\\n return r,wires\\n}\\n\\nfunc assuranceDecode(t *testing.T, r *Replica, wire *bytes.Buffer, code byte) fastrpc.Serializable {\\n t.Helper()\\n got,err:=wire.ReadByte();if err!=nil {t.Fatal(err)}\\n if got!=code {t.Fatalf(\\\"RPC code %d, expected %d\\\",got,code)}\\n p,ok:=r.RPC.Get(got);if !ok {t.Fatal(\\\"unregistered RPC\\\")}\\n msg:=p.Obj.New()\\n if err:=msg.Unmarshal(wire);err!=nil {t.Fatal(err)}\\n if wire.Len()!=0 {t.Fatalf(\\\"unconsumed bytes: %d\\\",wire.Len())}\\n return msg\\n}\\n\\nfunc assuranceWireEvent(t *testing.T, fields map[string]interface{}) {\\n t.Helper(); b,err:=json.Marshal(fields);if err!=nil {t.Fatal(err)}\\n fmt.Println(\\\"CA_EVENT \\\"+string(b))\\n}\\n\\nfunc TestAssurancePrepareValueBallotTransport(t *testing.T) {\\n // Both cases are selected before observing results. Zero is a diagnostic\\n // boundary case of the same responsibility; nonzero tests lost provenance.\\n for _,ownerID:=range []int32{0,1} {\\n  t.Run(fmt.Sprintf(\\\"owner_%d\\\",ownerID),func(t *testing.T){\\n   acceptorID:=(ownerID+1)%3; coordinatorID:=(ownerID+2)%3\\n   owner,ow:=assuranceWireReplica(ownerID)\\n   acceptor,aw:=assuranceWireReplica(acceptorID)\\n   coordinator,cw:=assuranceWireReplica(coordinatorID)\\n   cmds:=[]state.Command{{Op:state.PUT,K:17,V:state.Value(\\\"payload\\\")}}\\n   // This is the internal entry used by handlePropose for the first instance.\\n   owner.crtInstance[ownerID]=0\\n   owner.startPhase1(cmds,ownerID,0,ownerID,nil)\\n   pa:=assuranceDecode(t,acceptor,ow[acceptorID],acceptor.preAcceptRPC).(*PreAccept)\\n   acceptor.handlePreAccept(pa)\\n   inst:=acceptor.InstanceSpace[ownerID][0]\\n   if inst==nil || inst.vbal!=ownerID || inst.Status!=PREACCEPTED_EQ || !reflect.DeepEqual(inst.Cmds,cmds) {\\n    t.Fatal(\\\"preaccept prefix not established\\\")\\n   }\\n   // An executor may request recovery of a missing instance. The coordinator's\\n   // production entry creates its own attempt and emits the Prepare request.\\n   coordinator.startRecoveryForInstance(ownerID,0)\\n   prepare:=assuranceDecode(t,acceptor,cw[acceptorID],acceptor.prepareRPC).(*Prepare)\\n   if prepare.Replica!=ownerID || prepare.Instance!=0 || prepare.Ballot<=inst.bal {\\n    t.Fatal(\\\"recovery request premise not established\\\")\\n   }\\n   acceptor.handlePrepare(prepare)\\n   if inst.bal!=prepare.Ballot || inst.vbal!=ownerID {t.Fatal(\\\"prepare producer state not established\\\")}\\n   // handlePrepare constructs the reply directly from these live fields. No\\n   // concurrent owner runs here, and SendMsg has synchronously flushed bytes.\\n   scenario:=fmt.Sprintf(\\\"owner_%d\\\",ownerID)\\n   assuranceWireEvent(t,map[string]interface{}{\\\"event\\\":\\\"prepare_produced\\\",\\\"scenario\\\":scenario,\\n    \\\"acceptor\\\":acceptorID,\\\"replica\\\":ownerID,\\\"instance\\\":int32(0),\\n    \\\"expected_vballot\\\":inst.vbal,\\\"ballot\\\":inst.bal,\\\"status\\\":inst.Status})\\n   reply:=assuranceDecode(t,coordinator,aw[coordinatorID],coordinator.prepareReplyRPC).(*PrepareReply)\\n   if reply.Ballot!=prepare.Ballot || reply.Status!=inst.Status || reply.Seq!=inst.Seq ||\\n    !reflect.DeepEqual(reply.Command,inst.Cmds) || !reflect.DeepEqual(reply.Deps,inst.Deps) {\\n    t.Fatal(\\\"transport payload diagnostic failed\\\")\\n   }\\n   assuranceWireEvent(t,map[string]interface{}{\\\"event\\\":\\\"prepare_decoded\\\",\\\"scenario\\\":scenario,\\n    \\\"acceptor\\\":reply.AcceptorId,\\\"replica\\\":reply.Replica,\\\"instance\\\":reply.Instance,\\n    \\\"vballot\\\":reply.VBallot,\\\"ballot\\\":reply.Ballot,\\\"status\\\":reply.Status})\\n  })\\n }\\n}\\n\",\n    \"description\": \"Synchronous bounded replicas with actual handlers and peer codecs; buffer-backed SendMsg captures emitted bytes.\",\n    \"semantic_changes\": [\n      \"Bound instance allocation and omit automatic networking/timers/executor startup for local handler isolation.\",\n      \"Buffered writers replace peer sockets; the driver selects and synchronously dispatches valid emitted messages once.\",\n      \"Emit prerequisite and result JSON after synchronous handler/codec completion; no protocol implementation edits.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"produced\",\n        \"event\": \"prepare_produced\",\n        \"conditions\": []\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-init\",\n        \"S-members\",\n        \"S-phase1\",\n        \"S-bcast\",\n        \"S-ballot\",\n        \"S-recovery\",\n        \"S-defaults\",\n        \"S-send\",\n        \"S-receive\",\n        \"S-wire\",\n        \"S-rpc\"\n      ],\n      \"expectation_ids\": [\n        \"S-recovery\",\n        \"S-messages\",\n        \"S-rpc\"\n      ],\n      \"binding_ids\": [],\n      \"derivation\": \"The harness allocates only eight instance slots per row instead of MAX_INSTANCE and reproduces constructor defaults used by these handlers, including -1 prefixes, Thrifty=true, F=1, Dreply=true and Durable=false. No executor/network goroutines run. Each owner calls startPhase1 for its first row instance, as handlePropose does; bytes actually emitted by bcastPreAccept/SendMsg are decoded and delivered to its preferred acceptor. A distinct coordinator calls startRecoveryForInstance on the target and its emitted Prepare is decoded/delivered. The investigated entry is valid Prepare handling, independent of how an executor learned the target; the harness does not claim to reproduce a timed recovery trigger. Serial handler calls choose one admissible schedule with each selected message delivered once. Buffers replace transport only; handlers and codecs remain unchanged. All sampled fields have one synchronous owner. Fresh objects use RPC.Get(code).Obj.New() exactly as the listener. Unselected outgoing messages remain pending in buffers; no requirement is inferred for them.\",\n      \"applicability\": \"N=3,F=1; original owner 0 or 1; target instance 0; distinct acceptor and coordinator; valid noncorrupt messages; no crashes, background execution or clocks.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-prepare-vballot\",\n      \"checker_id\": \"P-prepare-vballot\",\n      \"event\": \"prepare_decoded\",\n      \"binding_ids\": [\n        \"BD-prepare-producer\",\n        \"BD-prepare-codec\",\n        \"BD-prepare-decode\",\n        \"BD-prepare-consumer\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-recovery\",\n          \"S-wire\",\n          \"S-send\",\n          \"S-receive\",\n          \"S-rpc\",\n          \"S-messages\"\n        ],\n        \"expectation_ids\": [\n          \"S-recovery\",\n          \"S-messages\",\n          \"S-rpc\"\n        ],\n        \"binding_ids\": [],\n        \"derivation\": \"The prerequisite samples inst.vbal after handlePrepare, whose producer copies exactly that field into the outgoing reply. The result samples reply.VBallot after successful decode into New(). Fields are synchronous with no concurrent writers. Identity is scenario plus actual decoded acceptor/row/instance; compared value is not a correlation filter.\",\n        \"applicability\": \"Each independently selected case reaching prepare_produced owes one decode result.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"produced\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"P-prepare-vballot\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"prepare_decoded\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"vballot\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"produced.expected_vballot\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"scenario\",\n        \"acceptor\",\n        \"replica\",\n        \"instance\"\n      ],\n      \"description\": \"Decoded value ballot equals the producer-side instance value ballot for the same PrepareReply.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Does not execute handlePrepareReply or assert a selected decision or application result.\",\n    \"Does not simulate the executor timer/history which requested recovery; the local valid-message transport obligation is independent of that trigger.\"\n  ]\n}\nFIXED HARNESS package epaxos\n\nimport (\n \"bufio\"\n \"bytes\"\n \"encoding/json\"\n \"fmt\"\n \"reflect\"\n \"testing\"\n\n \"github.com/imdea-software/swiftpaxos/dlog\"\n \"github.com/imdea-software/swiftpaxos/replica\"\n \"github.com/imdea-software/swiftpaxos/replica/defs\"\n fastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n \"github.com/imdea-software/swiftpaxos/state\"\n)\n\n// Bounded allocation mirrors the relevant constructor state without starting\n// sockets, clocks, or executor goroutines. All protocol mutations use handlers.\nfunc assuranceWireReplica(id int32) (*Replica, []*bytes.Buffer) {\n const n = 3\n base := &replica.Replica{Logger:dlog.New(\"\",false), N:n, F:1, Id:id,\n  RPC:fastrpc.NewTableId(defs.RPC_TABLE), State:state.InitState(),\n  Stats:&defs.Stats{M:make(map[string]int)}, Thrifty:true, Dreply:true,\n  Alive:make([]bool,n), PreferredPeerOrder:make([]int32,n),\n  PeerWriters:make([]*bufio.Writer,n)}\n r := &Replica{Replica:base, InstanceSpace:make([][]*Instance,n),\n  crtInstance:make([]int32,n), CommittedUpTo:make([]int32,n), ExecedUpTo:make([]int32,n),\n  conflicts:make([]map[state.Key]*InstPair,n), maxSeqPerKey:make(map[state.Key]int32),\n  latestCPInstance:-1, maxRecvBallot:-1}\n wires:=make([]*bytes.Buffer,n)\n for i:=0;i<n;i++ {\n  r.InstanceSpace[i]=make([]*Instance,8)\n  r.crtInstance[i]=-1; r.CommittedUpTo[i]=-1; r.ExecedUpTo[i]=-1\n  r.conflicts[i]=make(map[state.Key]*InstPair)\n  r.Alive[i]=true\n  r.PreferredPeerOrder[i]=(id+1+int32(i))%n\n  wires[i]=new(bytes.Buffer);r.PeerWriters[i]=bufio.NewWriter(wires[i])\n }\n // Preserve production RPC registration order.\n r.prepareRPC=r.RPC.Register(new(Prepare),nil)\n r.prepareReplyRPC=r.RPC.Register(new(PrepareReply),nil)\n r.preAcceptRPC=r.RPC.Register(new(PreAccept),nil)\n r.preAcceptReplyRPC=r.RPC.Register(new(PreAcceptReply),nil)\n r.acceptRPC=r.RPC.Register(new(Accept),nil)\n r.acceptReplyRPC=r.RPC.Register(new(AcceptReply),nil)\n r.commitRPC=r.RPC.Register(new(Commit),nil)\n r.tryPreAcceptRPC=r.RPC.Register(new(TryPreAccept),nil)\n r.tryPreAcceptReplyRPC=r.RPC.Register(new(TryPreAcceptReply),nil)\n return r,wires\n}\n\nfunc assuranceDecode(t *testing.T, r *Replica, wire *bytes.Buffer, code byte) fastrpc.Serializable {\n t.Helper()\n got,err:=wire.ReadByte();if err!=nil {t.Fatal(err)}\n if got!=code {t.Fatalf(\"RPC code %d, expected %d\",got,code)}\n p,ok:=r.RPC.Get(got);if !ok {t.Fatal(\"unregistered RPC\")}\n msg:=p.Obj.New()\n if err:=msg.Unmarshal(wire);err!=nil {t.Fatal(err)}\n if wire.Len()!=0 {t.Fatalf(\"unconsumed bytes: %d\",wire.Len())}\n return msg\n}\n\nfunc assuranceWireEvent(t *testing.T, fields map[string]interface{}) {\n t.Helper(); b,err:=json.Marshal(fields);if err!=nil {t.Fatal(err)}\n fmt.Println(\"CA_EVENT \"+string(b))\n}\n\nfunc TestAssurancePrepareValueBallotTransport(t *testing.T) {\n // Both cases are selected before observing results. Zero is a diagnostic\n // boundary case of the same responsibility; nonzero tests lost provenance.\n for _,ownerID:=range []int32{0,1} {\n  t.Run(fmt.Sprintf(\"owner_%d\",ownerID),func(t *testing.T){\n   acceptorID:=(ownerID+1)%3; coordinatorID:=(ownerID+2)%3\n   owner,ow:=assuranceWireReplica(ownerID)\n   acceptor,aw:=assuranceWireReplica(acceptorID)\n   coordinator,cw:=assuranceWireReplica(coordinatorID)\n   cmds:=[]state.Command{{Op:state.PUT,K:17,V:state.Value(\"payload\")}}\n   // This is the internal entry used by handlePropose for the first instance.\n   owner.crtInstance[ownerID]=0\n   owner.startPhase1(cmds,ownerID,0,ownerID,nil)\n   pa:=assuranceDecode(t,acceptor,ow[acceptorID],acceptor.preAcceptRPC).(*PreAccept)\n   acceptor.handlePreAccept(pa)\n   inst:=acceptor.InstanceSpace[ownerID][0]\n   if inst==nil || inst.vbal!=ownerID || inst.Status!=PREACCEPTED_EQ || !reflect.DeepEqual(inst.Cmds,cmds) {\n    t.Fatal(\"preaccept prefix not established\")\n   }\n   // An executor may request recovery of a missing instance. The coordinator's\n   // production entry creates its own attempt and emits the Prepare request.\n   coordinator.startRecoveryForInstance(ownerID,0)\n   prepare:=assuranceDecode(t,acceptor,cw[acceptorID],acceptor.prepareRPC).(*Prepare)\n   if prepare.Replica!=ownerID || prepare.Instance!=0 || prepare.Ballot<=inst.bal {\n    t.Fatal(\"recovery request premise not established\")\n   }\n   acceptor.handlePrepare(prepare)\n   if inst.bal!=prepare.Ballot || inst.vbal!=ownerID {t.Fatal(\"prepare producer state not established\")}\n   // handlePrepare constructs the reply directly from these live fields. No\n   // concurrent owner runs here, and SendMsg has synchronously flushed bytes.\n   scenario:=fmt.Sprintf(\"owner_%d\",ownerID)\n   assuranceWireEvent(t,map[string]interface{}{\"event\":\"prepare_produced\",\"scenario\":scenario,\n    \"acceptor\":acceptorID,\"replica\":ownerID,\"instance\":int32(0),\n    \"expected_vballot\":inst.vbal,\"ballot\":inst.bal,\"status\":inst.Status})\n   reply:=assuranceDecode(t,coordinator,aw[coordinatorID],coordinator.prepareReplyRPC).(*PrepareReply)\n   if reply.Ballot!=prepare.Ballot || reply.Status!=inst.Status || reply.Seq!=inst.Seq ||\n    !reflect.DeepEqual(reply.Command,inst.Cmds) || !reflect.DeepEqual(reply.Deps,inst.Deps) {\n    t.Fatal(\"transport payload diagnostic failed\")\n   }\n   assuranceWireEvent(t,map[string]interface{}{\"event\":\"prepare_decoded\",\"scenario\":scenario,\n    \"acceptor\":reply.AcceptorId,\"replica\":reply.Replica,\"instance\":reply.Instance,\n    \"vballot\":reply.VBallot,\"ballot\":reply.Ballot,\"status\":reply.Status})\n  })\n }\n}\n\n","exit_code":0,"status":"completed"}}
