80\t\n   981\t\tif accept.Instance > r.crtInstance[accept.Replica] {\n   982\t\t\tr.crtInstance[accept.Replica] = accept.Instance\n   983\t\t}\n   984\t\n   985\t\tif inst == nil {\n   986\t\t\tinst = r.newInstanceDefault(accept.Replica, accept.Instance)\n   987\t\t\tr.InstanceSpace[accept.Replica][accept.Instance] = inst\n   988\t\t}\n   989\t\n   990\t\tif accept.Ballot < inst.bal {\n   991\t\t\tr.Printf(\"Smaller ballot %d < %d\\n\", accept.Ballot, inst.bal)\n   992\t\t} else if inst.Status >= COMMITTED {\n   993\t\t\tr.Printf(\"Already committed / executed \\n\")\n   994\t\t} else {\n   995\t\t\tinst.Deps = accept.Deps\n   996\t\t\tinst.Seq = accept.Seq\n   997\t\t\tinst.bal = accept.Ballot\n   998\t\t\tinst.vbal = accept.Ballot\n   999\t\t\tr.recordInstanceMetadata(r.InstanceSpace[accept.Replica][accept.Instance])\n  1000\t\t\tr.sync()\n  1001\t\t}\n  1002\t\n  1003\t\treply := &AcceptReply{accept.Replica, accept.Instance, inst.bal}\n  1004\t\tr.replyAccept(accept.LeaderId, reply)\n  1005\t\n  1006\t}\n  1007\t\n  1008\tfunc (r *Replica) handleAcceptReply(areply *AcceptReply) {\n  1009\t\tinst := r.InstanceSpace[areply.Replica][areply.Instance]\n  1010\t\tlb := inst.lb\n  1011\t\n  1012\t\tif areply.Ballot > r.maxRecvBallot {\n  1013\t\t\tr.maxRecvBallot = areply.Ballot\n  1014\t\t}\n  1015\t\n  1016\t\tif lb.status != ACCEPTED {\n  1017\t\t\treturn\n  1018\t\t}\n  1019\t\n  1020\t\tif lb.lastTriedBallot != areply.Ballot {\n  1021\t\t\treturn\n  1022\t\t}\n  1023\t\n  1024\t\tif areply.Ballot > lb.lastTriedBallot {\n  1025\t\t\tlb.nacks++\n  1026\t\t\tif lb.nacks+1 > r.N>>1 {\n  1027\t\t\t\tif r.IsLeader {\n  1028\t\t\t\t\tr.makeBallot(areply.Replica, areply.Instance)\n  1029\t\t\t\t\tr.bcastPrepare(areply.Replica, areply.Instance)\n  1030\t\t\t\t}\n  1031\t\t\t}\n  1032\t\t\treturn\n  1033\t\t}\n  1034\t\n  1035\t\tinst.lb.acceptOKs++\n  1036\t\n  1037\t\tif inst.lb.acceptOKs+1 > r.N/2 {\n  1038\t\t\tlb.status = COMMITTED\n  1039\t\t\tinst.Status = COMMITTED\n  1040\t\t\tr.updateCommitted(areply.Replica)\n  1041\t\t\tr.recordInstanceMetadata(inst)\n  1042\t\t\tr.sync()\n  1204\tfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n  1205\t\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n  1206\t\tlb := inst.lb\n  1207\t\n  1208\t\tif preply.Ballot > r.maxRecvBallot {\n  1209\t\t\tr.maxRecvBallot = preply.Ballot\n  1210\t\t}\n  1211\t\n  1212\t\tif inst == nil || lb == nil || !lb.preparing {\n  1213\t\t\treturn\n  1214\t\t}\n  1215\t\n  1216\t\tif preply.Ballot != lb.lastTriedBallot {\n  1217\t\t\tlb.nacks++\n  1218\t\t\treturn\n  1219\t\t}\n  1220\t\n  1221\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1222\t\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n  1223\t\t\treturn\n  1224\t\t}\n  1225\t\n  1226\t\tlb.preparing = false\n  1227\t\n  1228\t\t// Deal with each sub-cases in order of the (corrected) TLA specification\n  1229\t\t// only replies from the highest ballot are taken into account\n  1230\t\t// 1 -> committed/executed\n  1231\t\t// 2 -> accepted\n  1232\t\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n  1233\t\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n  1234\t\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n  1235\t\t// 6 -> none of the above\n  1236\t\tpreAcceptCount := 0\n  1237\t\tsubCase := 0\n  1238\t\tallEqual := true\n  1239\t\tfor _, element := range lb.prepareReplies {\n  1240\t\t\tif element.VBallot >= lb.ballot {\n  1241\t\t\t\tlb.ballot = element.VBallot\n  1242\t\t\t\tlb.cmds = element.Command\n  1243\t\t\t\tlb.seq = element.Seq\n  1244\t\t\t\tlb.deps = element.Deps\n  1245\t\t\t\tlb.status = element.Status\n  1246\t\t\t}\n  1247\t\t\tif element.AcceptorId == element.Replica {\n  1248\t\t\t\tlb.leaderResponded = true\n  1249\t\t\t}\n  1250\t\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n  1251\t\t\t\tpreAcceptCount++\n  1252\t\t\t}\n  1253\t\t}\n  1254\t\n  1255\t\tif lb.status >= COMMITTED { // 1\n  1256\t\t\tsubCase = 1\n  1257\t\t} else if lb.status == ACCEPTED { // 2\n  1258\t\t\tsubCase = 2\n  1259\t\t} else if lb.status == PREACCEPTED || lb.status == PREACCEPTED_EQ {\n  1260\t\t\tfor _, element := range lb.prepareReplies {\n  1261\t\t\t\tif element.VBallot == lb.ballot && element.Status >= PREACCEPTED {\n  1262\t\t\t\t\t_, _, equal := r.mergeAttributes(lb.seq, lb.deps, element.Seq, element.Deps)\n  1263\t\t\t\t\tif !equal {\n  1264\t\t\t\t\t\tallEqual = false\n  1265\t\t\t\t\t\tbreak\n  1266\t\t\t\t\t}\n  1267\t\t\t\t}\n  1268\t\t\t}\n  1269\t\t\tif preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1270\t\t\t\tsubCase = 3\n  1271\t\t\t} else if preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1272\t\t\t\tsubCase = 4\n  1273\t\t\t} else if preAcceptCount > 0 && (lb.leaderResponded || !allEqual || preAcceptCount < r.Replica.SlowQuorumSize()-1) {\n  1274\t\t\t\tsubCase = 5\n  1275\t\t\t} else {\n  1276\t\t\t\tpanic(\"Cannot occur\")\n  1277\t\t\t}\n  1278\t\t} else if lb.status == NONE {\n  1279\t\t\tsubCase = 6\n  1280\t\t} else {\n  1281\t\t\tpanic(\"Status unknown\")\n  1282\t\t}\n  1283\t\n  1284\t\t// if subCase != 5 {\n  1285\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d\\n\", preply.Replica, preply.Instance, subCase)\n  1286\t\t// } else {\n  1287\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d with (leaderResponded=%t, allEqual=%t, enough=%t)\\n\",\n  1288\t\t// \t\tpreply.Replica, preply.Instance, subCase, lb.leaderResponded, allEqual, preAcceptCount < r.Replica.SlowQuorumSize()-1)\n  1289\t\t// }\n  1290\t\n  1291\t\tinst.Cmds = lb.cmds\n  1292\t\tinst.bal = lb.lastTriedBallot\n  1293\t\tinst.vbal = lb.lastTriedBallot\n  1294\t\tinst.Seq = lb.seq\n  1295\t\tinst.Deps = lb.deps\n  1296\t\tinst.Status = lb.status\n  1297\t\n  1298\t\tif subCase == 1 {\n  1299\t\t\t// nothing to do\n  1300\t\t} else if subCase == 2 || subCase == 3 {\n  1301\t\t\tinst.Status = ACCEPTED\n  1302\t\t\tlb.status = ACCEPTED\n  1303\t\t\tr.bcastAccept(preply.Replica, preply.Instance)\n  1304\t\t} else if subCase == 4 {\n  1305\t\t\tlb.tryingToPreAccept = true\n  1306\t\t\tr.bcastTryPreAccept(preply.Replica, preply.Instance)\n  1307\t\t} else { // subCase 5 and 6\n  1308\t\t\tcmd := state.NOOP()\n  1309\t\t\tif inst.lb.cmds != nil {\n  1310\t\t\t\tcmd = inst.lb.cmds\n  1311\t\t\t}\n  1312\t\t\tr.startPhase1(cmd, preply.Replica, preply.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1313\t\t}\n  1314\t}\n   419\t}\n   420\tfunc (p *AcceptCache) Put(t *Accept) {\n   421\t\tp.mu.Lock()\n   422\t\tp.cache = append(p.cache, t)\n   423\t\tp.mu.Unlock()\n   424\t}\n   425\tfunc (t *Accept) Marshal(wire io.Writer) {\n   426\t\tvar b [20]byte\n   427\t\tvar bs []byte\n   428\t\tbs = b[:20]\n   429\t\ttmp32 := t.LeaderId\n   430\t\tbs[0] = byte(tmp32)\n   431\t\tbs[1] = byte(tmp32 >> 8)\n   432\t\tbs[2] = byte(tmp32 >> 16)\n   433\t\tbs[3] = byte(tmp32 >> 24)\n   434\t\ttmp32 = t.Replica\n   435\t\tbs[4] = byte(tmp32)\n   436\t\tbs[5] = byte(tmp32 >> 8)\n   437\t\tbs[6] = byte(tmp32 >> 16)\n   438\t\tbs[7] = byte(tmp32 >> 24)\n   439\t\ttmp32 = t.Instance\n   440\t\tbs[8] = byte(tmp32)\n   441\t\tbs[9] = byte(tmp32 >> 8)\n   442\t\tbs[10] = byte(tmp32 >> 16)\n   443\t\tbs[11] = byte(tmp32 >> 24)\n   444\t\ttmp32 = t.Ballot\n   445\t\tbs[12] = byte(tmp32)\n   446\t\tbs[13] = byte(tmp32 >> 8)\n   447\t\tbs[14] = byte(tmp32 >> 16)\n   448\t\tbs[15] = byte(tmp32 >> 24)\n   449\t\ttmp32 = t.Seq\n   450\t\tbs[16] = byte(tmp32)\n   451\t\tbs[17] = byte(tmp32 >> 8)\n   452\t\tbs[18] = byte(tmp32 >> 16)\n   453\t\tbs[19] = byte(tmp32 >> 24)\n   454\t\twire.Write(bs)\n   455\t\tbs = b[:]\n   456\t\talen1 := int64(len(t.Deps))\n   457\t\tif wlen := binary.PutVarint(bs, alen1); wlen >= 0 {\n   458\t\t\twire.Write(b[0:wlen])\n   459\t\t}\n   460\t\tfor i := int64(0); i < alen1; i++ {\n   461\t\t\tbs = b[:4]\n   462\t\t\ttmp32 = t.Deps[i]\n   463\t\t\tbs[0] = byte(tmp32)\n   464\t\t\tbs[1] = byte(tmp32 >> 8)\n   465\t\t\tbs[2] = byte(tmp32 >> 16)\n   466\t\t\tbs[3] = byte(tmp32 >> 24)\n   467\t\t\twire.Write(bs)\n   468\t\t}\n   469\t}\n   470\t\n   471\tfunc (t *Accept) Unmarshal(rr io.Reader) error {\n   472\t\tvar wire byteReader\n   473\t\tvar ok bool\n   474\t\tif wire, ok = rr.(byteReader); !ok {\n   475\t\t\twire = bufio.NewReader(rr)\n   476\t\t}\n   477\t\tvar b [20]byte\n   478\t\tvar bs []byte\n   479\t\tbs = b[:20]\n   480\t\tif _, err := io.ReadAtLeast(wire, bs, 20); err != nil {\n   481\t\t\treturn err\n   482\t\t}\n   483\t\tt.LeaderId = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n   484\t\tt.Replica = int32((uint32(bs[4]) | (uint32(bs[5]) << 8) | (uint32(bs[6]) << 16) | (uint32(bs[7]) << 24)))\n   485\t\tt.Instance = int32((uint32(bs[8]) | (uint32(bs[9]) << 8) | (uint32(bs[10]) << 16) | (uint32(bs[11]) << 24)))\n   486\t\tt.Ballot = int32((uint32(bs[12]) | (uint32(bs[13]) << 8) | (uint32(bs[14]) << 16) | (uint32(bs[15]) << 24)))\n   487\t\tt.Seq = int32((uint32(bs[16]) | (uint32(bs[17]) << 8) | (uint32(bs[18]) << 16) | (uint32(bs[19]) << 24)))\n   488\t\talen1, err := binary.ReadVarint(wire)\n   489\t\tif err != nil {\n   490\t\t\treturn err\n   491\t\t}\n   492\t\tt.Deps = make([]int32, alen1)\n   493\t\tfor i := int64(0); i < alen1; i++ {\n   494\t\t\tbs = b[:4]\n   495\t\t\tif _, err := io.ReadAtLeast(wire, bs, 4); err != nil {\n   496\t\t\t\treturn err\n   497\t\t\t}\n   498\t\t\tt.Deps[i] = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n   499\t\t}\n   500\t\treturn nil\n   501\t}\n   502\t\n   503\tfunc (t *AcceptReply) New() fastrpc.Serializable {\n   504\t\treturn new(AcceptReply)\n   505\t}\n   506\tfunc (t *AcceptReply) BinarySize() (nbytes int, sizeKnown bool) {\n   507\t\treturn 13, true\n   508\t}\n   509\t\n   510\ttype AcceptReplyCache struct {\n   511\t\tmu    sync.Mutex\n   512\t\tcache []*AcceptReply\n   513\t}\n   514\t\n   515\tfunc NewAcceptReplyCache() *AcceptReplyCache {\n   516\t\tc := &AcceptReplyCache{}\n   517\t\tc.cache = make([]*AcceptReply, 0)\n   518\t\treturn c\n   519\t}\n   520\t\n   521\tfunc (p *AcceptReplyCache) Get() *AcceptReply {\n   522\t\tvar t *AcceptReply\n   523\t\tp.mu.Lock()\n   524\t\tif len(p.cache) > 0 {\n   525\t\t\tt = p.cache[len(p.cache)-1]\n   526\t\t\tp.cache = p.cache[0:(len(p.cache) - 1)]\n   527\t\t}\n   528\t\tp.mu.Unlock()\n   529\t\tif t == nil {\n   530\t\t\tt = &AcceptReply{}\n   531\t\t}\n   532\t\treturn t\n   533\t}\n   534\tfunc (p *AcceptReplyCache) Put(t *AcceptReply) {\n   535\t\tp.mu.Lock()\n   536\t\tp.cache = append(p.cache, t)\n   537\t\tp.mu.Unlock()\n   538\t}\n   539\tfunc (t *AcceptReply) Marshal(wire io.Writer) {\n   540\t\tvar b [12]byte\n   541\t\tvar bs []byte\n   542\t\tbs = b[:12]\n   543\t\ttmp32 := t.Replica\n   544\t\tbs[0] = byte(tmp32)\n   545\t\tbs[1] = byte(tmp32 >> 8)\n   546\t\tbs[2] = byte(tmp32 >> 16)\n   547\t\tbs[3] = byte(tmp32 >> 24)\n   548\t\ttmp32 = t.Instance\n   549\t\tbs[4] = byte(tmp32)\n   550\t\tbs[5] = byte(tmp32 >> 8)\n   551\t\tbs[6] = byte(tmp32 >> 16)\n   552\t\tbs[7] = byte(tmp32 >> 24)\n   553\t\ttmp32 = t.Ballot\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nfrom pathlib import Path\nx=Path('prepare_wire_test.go').read_text();x=x[:x.index('func TestAssurance')]\nx=x.replace(' const n = 3',' const n = 5').replace('F:1','F:2')\nPath('accept_status_test.go').write_text(x+'''func TestAssuranceAcceptedSupportReporting(t *testing.T) {\n r:=make([]*Replica,5)\n w:=make([][]*bytes.Buffer,5)\n for i:=0;i<5;i++ {r[i],w[i]=assuranceWireReplica(int32(i))}\n // Replica 4 sends a conflicting command to its preferred peers 0 and 1.\n // Delivery to 0 stays pending while 1 receives it, a legal per-link prefix.\n r[4].crtInstance[4]=0\n r[4].startPhase1([]state.Command{{Op:state.PUT,K:17,V:state.Value(\\\"seed\\\")}},4,0,4,nil)\n seed:=assuranceDecode(t,r[1],w[4][1],r[1].preAcceptRPC).(*PreAccept)\n r[1].handlePreAccept(seed)\n // Owner 0 forms a slow-path instance from differing real PreAccept replies.\n target:=[]state.Command{{Op:state.PUT,K:17,V:state.Value(\\\"target\\\")}}\n r[0].crtInstance[0]=0\n r[0].startPhase1(target,0,0,0,nil)\n for _,a:=range []int32{1,2} {\n  pa:=assuranceDecode(t,r[a],w[0][a],r[a].preAcceptRPC).(*PreAccept)\n  r[a].handlePreAccept(pa)\n  reply:=assuranceDecode(t,r[0],w[a][0],r[0].preAcceptReplyRPC).(*PreAcceptReply)\n  r[0].handlePreAcceptReply(reply)\n }\n ownerInst:=r[0].InstanceSpace[0][0]\n if ownerInst.lb.status\"'!=ACCEPTED || ownerInst.lb.deps[4]!=0 {t.Fatal(\"actual slow path not reached\")}\n // Generate one higher Prepare request through the implementation recovery entry.\n // Its automatic trigger is outside this local reporting test.\n r[3].startRecoveryForInstance(0,0)\n for _,a:=range []int32{1,2} {\n  accept:=assuranceDecode(t,r[a],w[0][a],r[a].acceptRPC).(*Accept)\n  before:=r[a].InstanceSpace[0][0]\n  if accept.Ballot<before.bal || before.Status>=COMMITTED {t.Fatal(\"Accept eligibility not reached\")}\n  r[a].handleAccept(accept)\n  ack:=assuranceDecode(t,r[0],w[a][0],r[0].acceptReplyRPC).(*AcceptReply)\n  if ack.Ballot!=accept.Ballot || ack.Replica!=accept.Replica || ack.Instance!=accept.Instance {\n   t.Fatal(\"matching acknowledgment not reached\")\n  }\n  inst:=r[a].InstanceSpace[0][0]\n  if inst.Seq!=accept.Seq || !reflect.DeepEqual(inst.Deps,accept.Deps) || !reflect.DeepEqual(inst.Cmds,target) {\n   t.Fatal(\"accepted attributes not installed\")\n  }\n  assuranceWireEvent(t,map[string]interface{}{\"event\":\"accept_acknowledged\",\"acceptor\":a,\n   \"replica\":ack.Replica,\"instance\":ack.Instance,\"ballot\":ack.Ballot,\"status_after_accept\":inst.Status})\n  prepare:=assuranceDecode(t,r[a],w[3][a],r[a].prepareRPC).(*Prepare)\n  if prepare.Ballot<=inst.bal {t.Fatal(\"higher Prepare not reached\")}\n  r[a].handlePrepare(prepare)\n  report:=assuranceDecode(t,r[3],w[a][3],r[3].prepareReplyRPC).(*PrepareReply)\n  if report.Ballot!=prepare.Ballot || report.Seq!=inst.Seq || !reflect.DeepEqual(report.Deps,inst.Deps) || !reflect.DeepEqual(report.Command,target) {\n   t.Fatal(\"Prepare report diagnostic failed\")\n  }\n  assuranceWireEvent(t,map[string]interface{}{\"event\":\"accepted_support_reported\",\"acceptor\":report.AcceptorId,\n   \"replica\":report.Replica,\"instance\":report.Instance,\"status\":report.Status,\n   \"recognized_accepted_support\":report.Status>=ACCEPTED,\"prepare_ballot\":report.Ballot})\n }\n}\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
