d_check\": \"controlled_schedule\",\n      \"question\": \"Can a legally applied implicit joint configuration remain without an automatic exit proposal after application completion attempts exit during leadership transfer, transfer later aborts, and no further application work is pending?\",\n      \"importance\": \"A missed automatic exit can retain outgoing voters and obstruct subsequent membership changes or intended availability. No consensus safety violation is presumed.\",\n      \"source_ids\": [\n        \"src-auto\",\n        \"s-auto-contract\",\n        \"s-ready-advance\",\n        \"s-transfer-end\",\n        \"s-timer\",\n        \"s-leader\",\n        \"s-joint-interface\"\n      ],\n      \"participants\": [\n        \"Leader\",\n        \"Voter transferee\",\n        \"Quorum peers\",\n        \"Caller processing Ready\"\n      ],\n      \"objects\": [\n        \"Installed joint ConfState\",\n        \"Pending configuration index\",\n        \"Application completion\",\n        \"leadTransferee\"\n      ],\n      \"contexts\": [\n        \"Implicit joint configuration with AutoLeave\",\n        \"Transfer blocks proposal at application completion; same leader survives timeout\"\n      ],\n      \"event_paths\": [\n        \"Committed joint entry -> ApplyConfChange -> transfer starts -> application acknowledgment -> rejected automatic exit -> transfer cancellation -> continued ticks and message processing\"\n      ],\n      \"activity_classes\": [\n        \"A1\",\n        \"A2\",\n        \"A4\",\n        \"A5\"\n      ],\n      \"behavior_ids\": [\n        \"B-config\",\n        \"B-apply\"\n      ],\n      \"fact_ids\": [\n        \"F-config\"\n      ],\n      \"supporting_behavior_ids\": {\n        \"B-transfer\": \"Controls proposal eligibility during completion and cancellation.\",\n        \"B-replicate\": \"Forms and commits the joint entry and any eventual exit entry.\",\n        \"B-storage\": \"Defines legal Ready/storage completion order.\",\n        \"B-authority\": \"New leadership supplies an alternative future application trigger.\"\n      },\n      \"obligation_relation_kind\": \"consumption\",\n      \"counterevidence\": [\n        \"appliedTo retries on subsequent application; a successful new leader appends an entry whose application can trigger exit.\",\n        \"Transfer timeout clears proposal blocking. Joint configuration itself remains a valid quorum arrangement.\",\n        \"Repaired exploration a440abc8f2ab4f5b8eb31a5979fe9cf3 exits in the no-transfer control and after a later ordinary proposal; the joint quorum remains operational.\"\n      ],\n      \"unknowns\": [\n        \"The fixed check must account for all behavior-determining state, queues, timers and external schedule to distinguish a repeatable non-exiting suffix from finite delay.\"\n      ],\n      \"priority\": 0,\n      \"trigger_rationale\": \"Actual exploration resolves legal overlap and bounded pending state. The remaining discriminator is whether fully serviced periodic execution repeats with live AutoLeave still true, with no required caller work omitted; a formal state-cycle observation can resolve it without inventing a timeout obligation.\"\n    },\n    \"status\": \"escalated\",\n    \"parent_candidate_id\": null,\n    \"fork_reason\": \"\",\n    \"stop_reason\": \"The implicit-mode contract grounds implementation-owned continuation; repaired exploration establishes construction value without proving a deadline violation. Fix the obligation and retain state-cycle evidence debt.\",\n    \"resume_conditions\": [],\n    \"obligation_id\": \"O-auto-exit\",\n    \"result_claim_ids\": [\n      \"O-auto-exit\"\n    ],\n    \"open_issue_ids\": [],\n    \"executions\": [\n      {\n        \"check_id\": \"c14ff92624034255a3f506d0795b2631\",\n        \"artifact_id\": \"3a14b92a84ad47ddaaf66107babcb3b9\",\n        \"action\": \"direct_check\",\n        \"status\": \"completed\",\n        \"outcome\": \"tests_passed\",\n        \"record\": {\n          \"path\": \"state.json\",\n          \"collection\": \"checks\",\n          \"match\": {\n            \"id\": \"c14ff92624034255a3f506d0795b2631\"\n          }\n        }\n      }\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"question_candidates\",\n      \"match\": {\n        \"id\": \"7e761f13c65b42ff9e000d76ca4d64ec\"\n      }\n    }\n  }\n]\n// Copyright 2019 The etcd Authors\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\npackage tracker\n\nimport (\n\t\"fmt\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"go.etcd.io/raft/v3/quorum\"\n\tpb \"go.etcd.io/raft/v3/raftpb\"\n)\n\n// Config reflects the configuration tracked in a ProgressTracker.\ntype Config struct {\n\tVoters quorum.JointConfig\n\t// AutoLeave is true if the configuration is joint and a transition to the\n\t// incoming configuration should be carried out automatically by Raft when\n\t// this is possible. If false, the configuration will be joint until the\n\t// application initiates the transition manually.\n\tAutoLeave bool\n\t// Learners is a set of IDs corresponding to the learners active in the\n\t// current configuration.\n\t//\n\t// Invariant: Learners and Voters does not intersect, i.e. if a peer is in\n\t// either half of the joint config, it can't be a learner; if it is a\n\t// learner it can't be in either half of the joint config. This invariant\n\t// simplifies the implementation since it allows peers to have clarity about\n\t// its current role without taking into account joint consensus.\n\tLearners map[uint64]struct{}\n\t// When we turn a voter into a learner during a joint consensus transition,\n\t// we cannot add the learner directly when entering the joint state. This is\n\t// because this would violate the invariant that the intersection of\n\t// voters and learners is empty. For example, assume a Voter is removed and\n\t// immediately re-added as a learner (or in other words, it is demoted):\n\t//\n\t// Initially, the configuration will be\n\t//\n\t//   voters:   {1 2 3}\n\t//   learners: {}\n\t//\n\t// and we want to demote 3. Entering the joint configuration, we naively get\n\t//\n\t//   voters:   {1 2} & {1 2 3}\n\t//   learners: {3}\n\t//\n\t// but this violates the invariant (3 is both voter and learner). Instead,\n\t// we get\n\t//\n\t//   voters:   {1 2} & {1 2 3}\n\t//   learners: {}\n\t//   next_learners: {3}\n\t//\n\t// Where 3 is now still purely a voter, but we are remembering the intention\n\t// to make it a learner upon transitioning into the final configuration:\n\t//\n\t//   voters:   {1 2}\n\t//   learners: {3}\n\t//   next_learners: {}\n\t//\n\t// Note that next_learners is not used while adding a learner that is not\n\t// also a voter in the joint config. In this case, the learner is added\n\t// right away when entering the joint configuration, so that it is caught up\n\t// as soon as possible.\n\tLearnersNext map[uint64]struct{}\n}\n\nfunc (c Config) String() string {\n\tvar buf strings.Builder\n\tfmt.Fprintf(&buf, \"voters=%s\", c.Voters)\n\tif c.Learners != nil {\n\t\tfmt.Fprintf(&buf, \" learners=%s\", quorum.MajorityConfig(c.Learners).String())\n\t}\n\tif c.LearnersNext != nil {\n\t\tfmt.Fprintf(&buf, \" learners_next=%s\", quorum.MajorityConfig(c.LearnersNext).String())\n\t}\n\tif c.AutoLeave {\n\t\tfmt.Fprint(&buf, \" autoleave\")\n\t}\n\treturn buf.String()\n}\n\n// Clone returns a copy of the Config that shares no memory with the original.\nfunc (c *Config) Clone() Config {\n\tclone := func(m map[uint64]struct{}) map[uint64]struct{} {\n\t\tif m == nil {\n\t\t\treturn nil\n\t\t}\n\t\tmm := make(map[uint64]struct{}, len(m))\n\t\tfor k := range m {\n\t\t\tmm[k] = struct{}{}\n\t\t}\n\t\treturn mm\n\t}\n\treturn Config{\n\t\tVoters:       quorum.JointConfig{clone(c.Voters[0]), clone(c.Voters[1])},\n\t\tLearners:     clone(c.Learners),\n\t\tLearnersNext: clone(c.LearnersNext),\n\t}\n}\n\n// ProgressTracker tracks the currently active configuration and the information\n// known about the nodes and learners in it. In particular, it tracks the match\n// index for each peer which in turn allows reasoning about the committed index.\ntype ProgressTracker struct {\n\tConfig\n\n// Status returns the current status of the given group. This allocates, see\n// BasicStatus and WithProgress for allocation-friendlier choices.\nfunc (rn *RawNode) Status() Status {\n\tstatus := getStatus(rn.raft)\n\treturn status\n}\n\n// BasicStatus returns a BasicStatus. Notably this does not contain the\n// Progress map; see WithProgress for an allocation-free way to inspect it.\nfunc (rn *RawNode) BasicStatus() BasicStatus {\n\treturn getBasicStatus(rn.raft)\n}\n\n// ProgressType indicates the type of replica a Progress corresponds to.\ntype ProgressType byte\n\nconst (\n\t// ProgressTypePeer accompanies a Progress for a regular peer replica.\n\tProgressTypePeer ProgressType = iota\n\t// ProgressTypeLearner accompanies a Progress for a learner replica.\n\tProgressTypeLearner\n)\n\n// WithProgress is a helper to introspect the Progress for this node and its\n// peers.\nfunc (rn *RawNode) WithProgress(visitor func(id uint64, typ ProgressType, pr tracker.Progress)) {\n\trn.raft.trk.Visit(func(id uint64, pr *tracker.Progress) {\n\t\ttyp := ProgressTypePeer\n\t\tif pr.IsLearner {\n\t\t\ttyp = ProgressTypeLearner\n\t\t}\n\t\tp := *pr\n\t\tp.Inflights = nil\n\t\tvisitor(id, typ, p)\n\t})\n}\n\n// ReportUnreachable reports the given node is not reachable for the last send.\nfunc (rn *RawNode) ReportUnreachable(id uint64) {\n\t_ = rn.raft.Step(pb.Message{Type: pb.MsgUnreachable, From: id})\n// The Progress is only populated on the leader.\ntype Status struct {\n\tBasicStatus\n\tConfig   tracker.Config\n\tProgress map[uint64]tracker.Progress\n}\n\n// BasicStatus contains basic information about the Raft peer. It does not allocate.\ntype BasicStatus struct {\n\tID uint64\n\n\tpb.HardState\n\tSoftState\n\n\tApplied uint64\n\n\tLeadTransferee uint64\n}\n\nfunc getProgressCopy(r *raft) map[uint64]tracker.Progress {\n\tm := make(map[uint64]tracker.Progress)\n\tr.trk.Visit(func(id uint64, pr *tracker.Progress) {\n\t\tp := *pr\n\t\tp.Inflights = pr.Inflights.Clone()\n\t\tpr = nil\n\n\t\tm[id] = p\n\t})\n\treturn m\n}\n\nfunc getBasicStatus(r *raft) BasicStatus {\n\ts := BasicStatus{\n\t\tID:             r.id,\n\t\tLeadTransferee: r.leadTransferee,\n\t}\n\ts.HardState = r.hardState()\n\ts.SoftState = r.softState()\n\ts.Applied = r.raftLog.applied\n\treturn s\n}\n\n// getStatus gets a copy of the current raft status.\nfunc getStatus(r *raft) Status {\n\tvar s Status\n\ts.BasicStatus = getBasicStatus(r)\n\tif s.RaftState == StateLeader {\n\t\ts.Progress = getProgressCopy(r)\n\t}\n\ts.Config = r.trk.Config.Clone()\n\treturn s\n}\n\n// MarshalJSON translates the raft status into JSON.\nfunc (c Changer) checkAndCopy() (tracker.Config, tracker.ProgressMap, error) {\n\tcfg := c.Tracker.Config.Clone()\n\ttrk := tracker.ProgressMap{}\n\n\tfor id, pr := range c.Tracker.Progress {\n\t\t// A shallow copy is enough because we only mutate the Learner field.\n\t\tppr := *pr\n\t\ttrk[id] = &ppr\n\t}\n\treturn checkAndReturn(cfg, trk)\n}\n\n// checkAndReturn calls checkInvariants on the input and returns either the\n// resulting error or the input.\nfunc checkAndReturn(cfg tracker.Config, trk tracker.ProgressMap) (tracker.Config, tracker.ProgressMap, error) {\n\tif err := checkInvariants(cfg, trk); err != nil {\n\t\treturn tracker.Config{}, tracker.ProgressMap{}, err\n\t}\n\treturn cfg, trk, nil\n}\n\n// err returns zero values and an error.\nfunc (c Changer) err(err error) (tracker.Config, tracker.ProgressMap, error) {\n\treturn tracker.Config{}, nil, err\n}\n\n../agent-source/status.go:48:\t\tp.Inflights = pr.Inflights.Clone()\n../agent-source/status.go:74:\ts.Config = r.trk.Config.Clone()\n../agent-source/confchange/confchange.go:338:\tcfg := c.Tracker.Config.Clone()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > obligation_copy.py <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json'));m=json.load(open(r['audit_spec_path']))\nfor b in m['behaviors']:\n if b['id']=='B-apply':\n  b['unknowns']=[]\n  b['important_branches']=[x for x in b.get('important_branches',[]) if not x.startswith('Automatic proposal')]+['Automatic proposal can be rejected during transfer. Future appliedTo retries; ordinary heartbeat Ready/Advance has no apply response and therefore no retry. A new leader can trigger application through its new-term entry.']\n if b['id']=='B-transfer':\n  b['unknowns']=[]\n  b['important_branches']=[x for x in b['important_branches'] if not x.startswith('Election timeout')]+['Election timeout aborts transfer if still leader. abortLeaderTransfer only clears the target; it does not append an entry or call appliedTo. Subsequent heartbeats and their replies do not initiate automatic joint exit when replicas are caught up.']\nm['behaviors'].append({'id':'B-config-export','primary_activity':'A4','execution_owner':'tracker.Config.Clone, getStatus and RawNode.Status','protocol_context':'Installed local configuration during simple or joint membership','trigger':'Caller requests Status or Config.Clone; configuration changer also uses Clone for a working copy.','reads':['Live tracker.Config voter sets, learner sets and AutoLeave mode.'],'writes':['Clone allocates voter and learner maps into a new Config; its struct literal omits AutoLeave, which therefore defaults false.'],'external_effects':['getStatus returns the cloned Config; live tracker configuration is not modified by Status.'],'important_branches':['EnterJoint sets AutoLeave after cloning, and LeaveJoint intentionally clears it; these changer paths do not by themselves show corruption of installed live state.'],'consumes_fact_ids':['F-config'],'cross_activity_effects':{'A1':'Reports the installed membership that determines voter quorum.','A2':'Reports automatic versus caller-driven transition mode for joint authority; a lost copy field need not change live authority.'},'source_ids':['s-config-clone','s-status-copy','s-status-contract','s-changer','s-changer-copy'],'unknowns':['Whether the public status observation preserves the installed automatic-exit mode under a generated implicit joint history.']})\nfor s in m['surfaces']:\n if s['entry_point']=='tracker.Config.Clone / RawNode.Status':\n  s['disposition']='mapped';s['behavior_ids']=['B-config-export'];s['reason']='Does the copy contract preserve installed AutoLeave when the public status path invokes Clone? Distinguish exported mode from live state; changer paths explicitly overwrite the mode.'\nm['core_overview']['open_details']=[x for x in m['core_overview']['open_details'] if 'periodic service after failed transfer' not in x]\nm['core_overview']['open_details'].append('Configuration-copy/status mode preservation is now a separate sourced question; live continuation result does not answer it.')\nm['core_overview']['connection']['explanation']+=' Transfer cancellation alone supplies no application-triggered retry; caught-up heartbeat processing does not call appliedTo. Later application and new leadership remain separate continuation triggers. Status copies configuration through Clone and does not mutate live authority.'\nm['core_overview']['connection']['source_ids']=list(dict.fromkeys(m['core_overview']['connection']['source_ids']+['s-config-clone','s-status-copy','s-status-contract']))\njson.dump(m,open('map-copy.json','w'),indent=2)\nq={'question':'Does Config.Clone, as consumed by RawNode.Status, preserve the AutoLeave mode of an actually installed implicit joint configuration?','importance':'Incorrect configuration status can mislead callers about whether Raft or the application owns exit from joint authority. No active quorum or log corruption is presumed.','source_ids':['s-config-clone','s-status-copy','s-status-contract','s-auto-contract','s-joint-interface'],'participants':['RawNode caller','Local configuration tracker'],'objects':['Installed Config.AutoLeave','Copied Status.Config.AutoLeave'],'contexts':['Serialized observation immediately after applying a committed implicit joint configuration and before its Ready is advanced','Explicit joint configuration as false-mode control'],'event_paths':['Bootstrap and election -> committed configuration -> ApplyConfChange -> RawNode.Status -> copied Config.AutoLeave'],'activity_classes':['A4','A1','A2'],'behavior_ids':['B-config','B-config-export'],'fact_ids':['F-config'],'supporting_behavior_ids':{'B-replicate':'Produces and commits the configuration entry.','B-storage':'Caller persists and applies Ready in order.','B-apply':'Observation occurs before acknowledging this Ready; no automatic exit can race the status call.'},'obligation_relation_kind':'consumption','counterevidence':['The live configuration retains AutoLeave; the prior continuation witness is not caused by Status.','Changer.EnterJoint assigns the requested mode after Clone and LeaveJoint deliberately clears it; a call to Clone does not alone prove protocol mutation.'],'unknowns':[],'trigger_rationale':'Clone promises a copy but its returned literal lists all map fields and omits AutoLeave; getStatus consumes that clone unchanged. Earlier execution exposed a live/exported difference, but a separate fixed check must establish this copy obligation under its own legal producer history. A small status observation at application suffices; no further transfer variants or lengthy schedule is needed.','disposition':'ready_for_check','preferred_check':'direct_test'}\nclaim={'id':'O-config-copy','kind':'obligation','concern':'implementation_semantics','description':'A Config copy returned through RawNode.Status must preserve the currently installed configuration AutoLeave value, including true for implicit joint mode, while being separate from the live configuration.','source_ids':['s-config-clone','s-status-copy','s-status-contract','s-auto-contract'],'scope':{'description':'Value preservation of installed automatic-exit mode when RawNode.Status copies tracker.Config at a serialized observation point.','assumptions':['Caller uses legal bootstrap/election/committed configuration application and observes without concurrent protocol mutation.'],'excluded':['No claim about active-state mutation, consensus safety, external application use of Status or unobserved downstream consequences.','Map isolation and preservation of other fields are not separate checked requirements.']},'pending':[],'grounding':{'source_ids':['s-config-clone','s-status-copy','s-status-contract','s-joint-interface','s-changer'],'expectation_ids':['s-config-clone','s-status-contract'],'binding_ids':['bind-config-clone','bind-status-export'],'derivation':'Clone explicitly returns a copy of Config, which includes the semantic AutoLeave field. RawNode.Status promises current group status and getStatus assigns Clone to Status.Config. No documented redaction or special reinterpretation of AutoLeave is present. Implicit mode is established by EnterJoint after a committed entry is applied. The requirement is equality of the copied field at this serialized call, not a global protocol outcome.','applicability':'Actual installed implicit or explicit joint state; source and result refer to the same node/configuration application with no intervening transition.','alternatives':['Map fields are copied and active mode remains correct; these facts limit consequence but do not satisfy scalar value preservation.'],'unresolved':[],'conflicts':[]}}\nb=[]\nfor i,mat,sym,a,z,desc in [('bind-config-clone','s-config-clone','Clone',96,113,'Config.Clone constructs a copy but omits the scalar AutoLeave field.'),('bind-status-export','s-status-copy','getStatus',67,76,'getStatus obtains the reported configuration from the live tracker Clone.')]:\n b.append(dict(id=i,material_id=mat,symbol=