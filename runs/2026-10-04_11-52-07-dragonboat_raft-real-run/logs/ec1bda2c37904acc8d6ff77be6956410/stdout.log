{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k))\nsrc('S-log-guards','internal/raft/logentry.go',290,399)\nsrc('S-start','internal/raft/raft.go',237,292)\nsrc('S-launch','internal/raft/peer.go',64,87)\nsrc('S-replay','node.go',623,650)\nsrc('S-node-apply','node.go',239,279)\nsrc('S-node-restore','node.go',294,318)\nsrc('S-node-events','node.go',1108,1167)\nsrc('S-read-batch','node.go',1225,1234)\nsrc('S-read-timeout','request.go',939,968)\nsrc('S-read-contract','nodehost.go',855,878,'interface_statement')\nsrc('S-ticks','internal/raft/raft.go',559,630)\nsrc('S-transfer','internal/raft/raft.go',1742,1769)\nsrc('S-timeout-now','internal/raft/raft.go',1971,1981)\nsrc('S-rsm-recover','internal/rsm/statemachine.go',242,259)\nsrc('S-rsm-entry','internal/rsm/statemachine.go',877,918)\nsrc('S-rsm-config','internal/rsm/statemachine.go',959,975)\nsrc('S-config-guards','internal/rsm/membership.go',276,315)\nsrc('S-read-response-test','internal/raft/raft_test.go',2431,2449,'test_expectation')\nbs=[]\ndef beh(i,a,owner,ctx,trig,ss,**kw):\n b=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss,unknowns=[]);b.update(kw);bs.append(b)\nbeh('B-replicate','A1','raft leader and followers','Per-cluster term, log and voting membership','Propose and Replicate/ReplicateResp', ['S-core-commit','S-replication','S-read-entry','S-log-guards'],implementation_guards=['Leader rejects proposals during transfer; serializes configuration proposals with pendingConfigChange.','Follower matches predecessor term and refuses changes at committed indexes.','Leader counts remotes and witnesses, excluding observers; tryCommit requires current-term entry at the quorum index.'],writes=['Leader assigns term/index; responses advance remote match; log commitment only advances.'],external_effects=['Replicate messages propagate entries and commitment; rejection feedback adjusts next and retries.'],produces_fact_ids=['F-committed'],consumes_fact_ids=['F-authority'],async_boundaries=['Peer update messages and entries pass through the engine persistence boundary.'])\nbeh('B-authority','A2','raft state machine through Peer.Handle and tick','Per-cluster term, vote and role','Election timeout, RequestVote/response, leader messages or CheckQuorum',['S-core-commit','S-term-election','S-peer-admission','S-vote-response','S-ticks'],implementation_guards=['Peer rejects unknown response senders; candidate ignores observer votes and deduplicates votes.','Vote grant requires prior-vote eligibility and last-log freshness; campaign waits for committed work to be applied.','Higher-term vote requests may be suppressed within the known-leader lease when CheckQuorum is enabled.'],writes=['New term clears vote; reset clears votes, pending readIndex, transfer and replication progress; durable log and commitment remain.'],important_branches=['Higher-term accepted messages demote; lower-term messages are ignored (leader messages can receive NoOP to unstick a candidate).','Current-term candidate receiving leader traffic becomes follower; quorum inactivity can demote the leader.'],produces_fact_ids=['F-authority'],consumes_fact_ids=['F-committed'],cross_activity_effects={'A1':'Only current leader forms commitments and confirms read contexts; reset discards pending confirmation support.'})\nbeh('B-transfer','A2','leader and target follower','Existing term and target voting member','LeaderTransfer, catch-up response, TimeoutNow or transfer timeout',['S-transfer','S-timeout-now','S-read-entry','S-ticks'],implementation_guards=['Target must be a remote, not self; one transfer at a time.'],writes=['Transfer target set; proposals dropped until transfer abort or authority reset.'],external_effects=['Caught-up target receives TimeoutNow and enters normal election path through tick.'],consumes_fact_ids=['F-authority'])\nbeh('B-read-confirm','A1','leader raft/readIndex','Current leader term with committed entry of that term for multi-voter reads','ReadIndex stores request; contextual HeartbeatResp confirms queue prefix',['S-read-entry','S-read-aggregation','S-heartbeat-producer','S-read-response'],implementation_guards=['ReadIndex requests from witnesses are dropped; multi-voter leader requires a committed current-term entry.','Nonzero heartbeat contexts are sent to voters only; confirmation deduplicates sender IDs and counts the leader implicitly.'],writes=['Pending records retain ctx, from and committed index; confirm removes the released prefix and raises its indexes to the confirmed record index.'],important_branches=['Single-node quorum immediately returns ready state; multi-node path waits for confirmation.','Local released items use s.ctx, while remote messages use m.Hint/m.HintHigh for every released item.'],external_effects=['Returns local ReadyToRead or sends ReadIndexResp to each stored requester.'],async_boundaries=['Heartbeat retries use newest pending context; message delivery can overlap multiple pending requests.'],produces_fact_ids=['F-read-release'],consumes_fact_ids=['F-authority','F-committed'],unknowns=['Can remote prefix release lose per-request context in a complete legal overlapping history?'])\nbeh('B-read-receive','A1','follower/observer raft','Term-qualified reply from leader','ReadIndexResp',['S-forward-read','S-read-response-test'],writes=['Marks leader available and appends ReadyToRead using received context and index.'],consumes_fact_ids=['F-read-release'],external_effects=['ReadyToRead exported through Peer update.'],cross_activity_effects={'A7':'Client pending batch selection uses the exported context, not merely destination or index.'})\nbeh('B-read-client','A7','NodeHost, node and pendingReadIndex','Local request batches keyed by SystemCtx','ReadIndex API queue, node step, ready response or applied/timeout update',['S-read-contract','S-read-batch','S-read-consumer','S-read-timeout','S-node-events','S-node-consume'],writes=['Each nonempty drained batch gets a new nonzero Low context; earlier batches remain until completion/drop/timeout.','addReady updates only the exact context batch; applied notifies success only after its positive index has applied and before deadline.'],important_branches=['ReadLocalNode requires successful ReadIndex readiness.','gc times out pending requests; it does not send a new ReadIndex.'],async_boundaries=['API return precedes outcome notification; separate step iterations permit overlapping contexts.'],cross_activity_effects={'A1':'Produces independent contextual read requests; completion depends on the A1 authority confirmation being routed to the same batch.'},unknowns=['Full transport batching and forwarding adaptation paths require inspection before a harness bypasses them.'])\nbeh('B-membership','A4','RSM membership then node/raft under raftMu','Committed configuration entry and prior membership','RSM configChange application',['S-rsm-config','S-config-guards','S-node-apply','S-membership'],implementation_guards=['Membership rejects prohibited role changes, readding removed members, stale ordered changes, invalid promotions and deletion of the only node.'],writes=['Accepted changes update membership, Peer voter maps and registry; pending configuration flag cleared.'],important_branches=['Self-removal demotes leader and requests node removal; observer promotion can inherit progress; removal may recalculate commitment.'],cross_activity_effects={'A1':'Changes eligible quorum population and may advance commitment after removal.','A2':'Campaign waits for committed configuration application; self-removal ends leadership.'},unknowns=['Detailed admission and ordering options for all reconfiguration histories remain open.'])\nbeh('B-persistence','A6','engine step worker, Peer and log reader','Per-node update persistence batc