d history; these may remain unknown.\",\n  \"properties\": {\n    \"audit_spec_version\": {\n      \"anyOf\": [\n        {\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Audit Spec Version\"\n    },\n    \"disposition\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"explained_by_existing_mechanism\",\n            \"concrete_suspicion\",\n            \"needs_specific_evidence\",\n            \"ready_for_check\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Disposition\"\n    },\n    \"preferred_check\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"source_review\",\n            \"direct_test\",\n            \"controlled_schedule\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Preferred Check\"\n    },\n    \"question\": {\n      \"title\": \"Question\",\n      \"type\": \"string\"\n    },\n    \"importance\": {\n      \"title\": \"Importance\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"participants\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Participants\",\n      \"type\": \"array\"\n    },\n    \"objects\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Objects\",\n      \"type\": \"array\"\n    },\n    \"contexts\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Contexts\",\n      \"type\": \"array\"\n    },\n    \"event_paths\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Event Paths\",\n      \"type\": \"array\"\n    },\n    \"activity_classes\": {\n      \"default\": [],\n      \"items\": {\n        \"enum\": [\n          \"A1\",\n          \"A2\",\n          \"A3\",\n          \"A4\",\n          \"A5\",\n          \"A6\",\n          \"A7\"\n        ],\n        \"type\": \"string\"\n      },\n      \"title\": \"Activity Classes\",\n      \"type\": \"array\"\n    },\n    \"behavior_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Behavior Ids\",\n      \"type\": \"array\"\n    },\n    \"fact_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Fact Ids\",\n      \"type\": \"array\"\n    },\n    \"supporting_behavior_ids\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Behavior ID to sourced prehistory, context or consequence support; not a direct principal Fact edge\",\n      \"title\": \"Supporting Behavior Ids\",\n      \"type\": \"object\"\n    },\n    \"obligation_relation_kind\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"establishment\",\n            \"preservation\",\n            \"consumption\",\n            \"recovery\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Obligation Relation Kind\"\n    },\n    \"counterevidence\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Counterevidence\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"description\": \"Specific unresolved premises or discriminators of this question; not generic caution or a checklist of untested cases\",\n      \"items\"