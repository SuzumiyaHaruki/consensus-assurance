    \"discriminator\": \"Drive a real three-node Node-API cluster (config {1,2,3}, leader 1) through committed remove-3 and add-3 conf changes, then invoke Propose on node 3 and on a never-removed member (node 2) with the same leader, and record whether each invocation returns, with which error, and whether its payload reaches any node's committed entries; finally force a leader change and repeat the invocation on node 3.\",\n      \"disposition\": \"active\",\n      \"parent_id\": null,\n      \"source_ids\": [\n        \"runloop\",\n        \"removal_gate\",\n        \"propose_api\",\n        \"stepwait\",\n        \"leader_prop_gate\"\n      ],\n      \"resume_conditions\": [],\n      \"knowledge\": [],\n      \"open_gaps\": [\n        {\n          \"id\": \"3592ccaf01864f56aaf06d54a3f97423-gap-0\",\n          \"question\": \"Besides an observed leader change, which source path re-arms the node.run() proposal gate for a member that is added back to the configuration, and which component is responsible for doing so?\",\n          \"experiment_id\": null,\n          \"operation_id\": \"3592ccaf01864f56aaf06d54a3f97423\",\n          \"response\": null\n        }\n      ],\n      \"latest_execution\": {\n        \"id\": \"43a04622beef40588679c6cf1c40d6ad\",\n        \"experiment_id\": \"3592ccaf01864f56aaf06d54a3f97423-experiment\",\n        \"status\": \"completed\",\n        \"exit_code\": 0,\n        \"record\": \"logs/43a04622beef40588679c6cf1c40d6ad/check.json\",\n        \"observations\": \"logs/43a04622beef40588679c6cf1c40d6ad/observations.json\"\n      },\n      \"latest_interpretation\": {\n        \"id\": \"3592ccaf01864f56aaf06d54a3f97423-interpretation-0\",\n        \"investigation_id\": \"3592ccaf01864f56aaf06d54a3f97423-question-0\",\n        \"experiment_id\": null,\n        \"source_ids\": [\n          \"runloop\",\n          \"removal_gate\",\n          \"propose_api\",\n          \"stepwait\",\n          \"leader_prop_gate\"\n        ],\n        \"executions\": {},\n        \"conclusion\": \"unresolved\",\n        \"defect_claim\": \"asserted\",\n        \"rationale\": \"Source account: node.run() arms propc only through the observed-leader-change branch (node.go:373-377) and disarms it after applying a removal conf change (node.go:412-427); the re-admission case never matches that guard because okBefore is false once the local Progress entry was dropped, so subsequent proposals are enqueued onto a nil channel inside stepWithWaitOption (node.go:514-552) and can only end by context expiry or node stop. The state machine would have accepted the proposal (stepFollower forwards to the leader) and the removed-leader case returns ErrProposalDropped instead of blocking (raft.go:1298-1302), so no rejection or loss is reported to the caller while the member is in fact a voter with a known leader. The submitted experiment is the discriminator for this account and its retained receipt is expected to witness the invocation interval; this entry is currently a source-only account and will be revised with that receipt (including the control on a never-removed member and the post-leader-change invocation).\",\n        \"answers\": {},\n        \"knowledge\": [\n          {\n            \"entry_id\": \"3592ccaf01864f56aaf06d54a3f97423-knowledge-0\",\n            \"revision\": 1,\n            \"assertion\": \"propc is armed only on observed leader change and is left nil after a re-admission\"\n          },\n          {\n            \"entry_id\": \"3592ccaf01864f56aaf06d54a3f97423-knowledge-1\",\n            \"revision\": 1,\n            \"assertion\": \"MsgProp on a nil propc blocks until context expiry or node stop\"\n          },\n          {\n            \"entry_id\": \"3592ccaf01864f56aaf06d54a3f97423-knowledge-2\",\n            \"revision\": 1,\nCA_EVENT {\\\"event\\\":\\\"cluster_ready\\\",\\\"leader\\\":1,\\\"term\\\":1,\\\"voters\\\":[1,2,3]}\\n\"}\nCA_EVENT {\\\"change\\\":\\\"remove\\\",\\\"event\\\":\\\"conf_change_proposed\\\",\\\"node\\\":1,\\\"operation_id\\\":\\\"remove-3\\\",\\\"target\\\":3}\\n\"}\nCA_EVENT {\\\"applied_index\\\":2,\\\"change\\\":\\\"remove\\\",\\\"event\\\":\\\"conf_change_applied\\\",\\\"leader\\\":1,\\\"node\\\":3,\\\"ok\\\":true,\\\"operation_id\\\":\\\"remove-3\\\",\\\"target\\\":3,\\\"term\\\":1,\\\"voter\\\":false}\\n\"}\nCA_EVENT {\\\"change\\\":\\\"add\\\",\\\"event\\\":\\\"conf_change_proposed\\\",\\\"node\\\":1,\\\"operation_id\\\":\\\"readd-3\\\",\\\"target\\\":3}\\n\"}\nCA_EVENT {\\\"applied_index\\\":3,\\\"change\\\":\\\"add\\\",\\\"event\\\":\\\"conf_change_applied\\\",\\\"leader\\\":1,\\\"node\\\":3,\\\"ok\\\":true,\\\"operation_id\\\":\\\"readd-propose-witness\\\",\\\"target\\\":3,\\\"term\\\":1,\\\"voter\\\":true}\\n\"}\nCA_EVENT {\\\"event\\\":\\\"node_context\\\",\\\"leader\\\":1,\\\"node\\\":3,\\\"operation_id\\\":\\\"readd-propose-witness\\\",\\\"term\\\":1,\\\"voter\\\":true}\\n\"}\nCA_EVENT {\\\"deadline_ms\\\":2500,\\\"event\\\":\\\"propose_invocation\\\",\\\"leader\\\":1,\\\"node\\\":3,\\\"operation_id\\\":\\\"readd-propose-witness\\\",\\\"payload\\\":\\\"witness-payload-readded-voter\\\",\\\"phase\\\":\\\"after_readmission\\\",\\\"voter\\\":true}\\n\"}\nCA_EVENT {\\\"deadline_ms\\\":2500,\\\"elapsed_ms\\\":1200,\\\"err\\\":\\\"\\\",\\\"event\\\":\\\"propose_result\\\",\\\"leader\\\":1,\\\"node\\\":3,\\\"operation_id\\\":\\\"readd-propose-witness\\\",\\\"payload\\\":\\\"witness-payload-readded-voter\\\",\\\"phase\\\":\\\"after_readmission\\\",\\\"returned\\\":false,\\\"voter\\\":true,\\\"window_ms\\\":1200}\\n\"}\nCA_EVENT {\\\"elapsed_ms\\\":2500,\\\"err\\\":\\\"context deadline exceeded\\\",\\\"event\\\":\\\"propose_release\\\",\\\"node\\\":3,\\\"operation_id\\\":\\\"readd-propose-witness\\\"}\\n\"}\nCA_EVENT {\\\"checked_after_ms\\\":1200,\\\"event\\\":\\\"commit_observation\\\",\\\"observed_nodes\\\":null,\\\"operation_id\\\":\\\"readd-propose-witness\\\",\\\"payload\\\":\\\"witness-payload-readded-voter\\\",\\\"present\\\":f