            "entry_id": "3592ccaf01864f56aaf06d54a3f97423-knowledge-2",
            "revision": 1,
            "assertion": "the raft state machine returns ErrProposalDropped for a removed leader instead of blocking"
          },
          {
            "entry_id": "e3c629874a414978b22ef047cbd43bc1-knowledge-0",
            "revision": 1,
            "assertion": "intended blocking is scoped to the unknown-leader case and acceptance is expected once a leader is known; re-addition is untested"
          },
          {
            "entry_id": "6a3188b0f52c430db5ab56fc06c53ece-knowledge-0",
