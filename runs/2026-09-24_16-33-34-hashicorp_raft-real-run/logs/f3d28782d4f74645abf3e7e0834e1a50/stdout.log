{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat > network_prefix_explore_test.go <<'EOF'\npackage raft\n\nimport (\n    \\\"bufio\\\"\n    \\\"bytes\\\"\n    \\\"encoding/json\\\"\n    \\\"fmt\\\"\n    \\\"net\\\"\n    \\\"testing\\\"\n    \\\"time\\\"\n\n    \\\"github.com/hashicorp/go-msgpack/v2/codec\\\"\n)\n\nfunc TestAssuranceNetworkResponsePrefixes(t *testing.T) {\n    // Use the same encoder settings and envelope order as handleConn/handleCommand.\n    var wire bytes.Buffer\n    enc := codec.NewEncoder(&wire, &codec.MsgpackHandle{BasicHandle: codec.BasicHandle{TimeNotBuiltin: true}})\n    if err := enc.Encode(\\\"\\\"); err \"'!= nil { t.Fatal(err) }\n    reply := &AppendEntriesResponse{RPCHeader: RPCHeader{ProtocolVersion: 3}, Term: 4, LastLog: 2, Success: true}\n    if err := enc.Encode(reply); err != nil { t.Fatal(err) }\n    encoded := append([]byte(nil), wire.Bytes()...)\n\n    for cut := 0; cut <= len(encoded); cut++ {\n        left, right := net.Pipe()\n        conn := &netConn{\n            conn: left,\n            w: bufio.NewWriter(left),\n            dec: codec.NewDecoder(bufio.NewReader(left), &codec.MsgpackHandle{}),\n        }\n        conn.enc = codec.NewEncoder(conn.w, &codec.MsgpackHandle{BasicHandle: codec.BasicHandle{TimeNotBuiltin: true}})\n        pipeline := newNetPipeline(&NetworkTransport{timeout: time.Second}, conn, 2)\n        peerDone := make(chan error, 1)\n        prefix := encoded[:cut]\n        go func() {\n            defer right.Close()\n            _ = right.SetDeadline(time.Now().Add(2*time.Second))\n            reader := bufio.NewReader(right)\n            typ, err := reader.ReadByte()\n            if err != nil { peerDone <- err; return }\n            if typ != rpcAppendEntries { peerDone <- fmt.Errorf(\"unexpected RPC type: %d\", typ); return }\n            var req AppendEntriesRequest\n            if err := codec.NewDecoder(reader, &codec.MsgpackHandle{}).Decode(&req); err != nil {\n                peerDone <- err; return\n            }\n            if req.Term != 4 || len(req.Entries) != 1 || req.Entries[0].Index != 2 {\n                peerDone <- fmt.Errorf(\"unexpected request identity\"); return\n            }\n            if len(prefix) > 0 {\n                if _, err := right.Write(prefix); err != nil { peerDone <- err; return }\n            }\n            peerDone <- nil\n        }()\n        req := &AppendEntriesRequest{Term: 4, Entries: []*Log{{Index: 2, Term: 4, Type: LogNoop}}}\n        // Retain the caller-owned response allocation to inspect partial decoder writes.\n        raw := new(AppendEntriesResponse)\n        f, err := pipeline.AppendEntries(req, raw)\n        if err != nil { pipeline.Close(); t.Fatal(err) }\n        select {\n        case ready := <-pipeline.Consumer():\n            if ready != f { pipeline.Close(); t.Fatal(\"future identity changed\") }\n        case <-time.After(3*time.Second):\n            pipeline.Close(); t.Fatal(\"network pipeline did not complete\")\n        }\n        futureErr := f.Error()\n        if err := <-peerDone; err != nil { pipeline.Close(); t.Fatal(err) }\n        errorText := \"\"\n        if futureErr != nil { errorText = futureErr.Error() }\n        event := map[string]interface{}{\n            \"event\": \"network_prefix_decoded\", \"operation_id\": fmt.Sprintf(\"prefix-%d\", cut),\n            \"prefix_bytes\": cut, \"full_bytes\": len(encoded), \"future_failed\": futureErr != nil,\n            \"error_text\": errorText, \"raw_success\": raw.Success, \"raw_term\": raw.Term,\n            \"raw_last_log\": raw.LastLog, \"completed\": true,\n        }\n        b, err := json.Marshal(event)\n        if err != nil { pipeline.Close(); t.Fatal(err) }\n        fmt.Println(\"CA_EVENT \" + string(b))\n        pipeline.Close()\n    }\n}\nEOF\ngofmt -w network_prefix_explore_test.go\npython3 - <<'\"'PY'\nimport json\nfrom pathlib import Path\nsources=[\n dict(id='network-connection-fields',file='net_transport.go',start_line=186,end_line=207,kind='code_observation'),\n dict(id='network-server-encoding',file='net_transport.go',start_line=603,end_line=615,kind='code_observation'),\n dict(id='network-response-envelope',file='net_transport.go',start_line=747,end_line=790,kind='code_observation'),\n dict(id='network-pipeline-complete-path',file='net_transport.go',start_line=814,end_line=911,kind='code_observation'),\n dict(id='append-response-fields',file='commands.go',start_line=52,end_line=74,kind='interface_statement')\n]\ns={'action':'explore','sources':sources,'question':'Can the actual netPipeline producer publish a failed AppendFuture whose caller-owned response allocation has Success=true after decoding a strict byte prefix of an otherwise normal encoded AppendEntriesResponse? Enumerate every truncation boundary plus an intact control and observe actual error and raw fields; no response validity or consensus property is assumed.','rationale':'The reviewed local failed-future Response-access finding is retained unchanged. This distinct producer relation tests whether the zero-valued timeout response protection observed in InmemTransport extends to network truncation. The harness uses actual netPipeline.AppendEntries, decodeResponses, decodeResponse and the pinned codec through net.Pipe. A scripted endpoint decodes the actual request, then sends a prefix of one normally encoded successful response and closes the connection. This substitutes follower behavior and socket delivery, not the producer decoder. The producer fixes the completion result; inspection reads the caller-owned raw allocation after Error rather than invoking Response on a failed future. The full prefix is a control. A successful original response is scripted, so partial Success=true would not demonstrate false durable support, unsafe commit or a reachable election history. This is exploratory execution, not formal property Evidence.','harness_path':'network_prefix_explore_test.go','files':{}}\nPath('submission.json').write_text(json.dumps(s,indent=2)+'\\\\n')\nimport jsonschema\njsonschema.validate(s,json.load(open('../native-submission.schema.json')))\nprint('Complete exploration submission validated.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
