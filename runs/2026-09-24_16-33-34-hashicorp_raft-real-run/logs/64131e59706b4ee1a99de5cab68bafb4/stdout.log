06\t\t// Flush\n   807\t\tif err := conn.w.Flush(); err != nil {\n   808\t\t\tconn.Release()\n   809\t\t\treturn err\n   810\t\t}\n   811\t\treturn nil\n   812\t}\n   813\t\n   814\t// newNetPipeline is used to construct a netPipeline from a given transport and\n   815\t// connection. It is a bug to ever call this with maxInFlight less than 2\n   816\t// (minInFlightForPipelining) and will cause a panic.\n   817\tfunc newNetPipeline(trans *NetworkTransport, conn *netConn, maxInFlight int) *netPipeline {\n   272\tfunc (i *inmemPipeline) decodeResponses() {\n   273\t\ttimeout := i.trans.timeout\n   274\t\tfor {\n   275\t\t\tselect {\n   276\t\t\tcase inp := <-i.inprogressCh:\n   277\t\t\t\tvar timeoutCh <-chan time.Time\n   278\t\t\t\tif timeout > 0 {\n   279\t\t\t\t\ttimeoutCh = time.After(timeout)\n   280\t\t\t\t}\n   281\t\n   282\t\t\t\tselect {\n   283\t\t\t\tcase rpcResp := <-inp.respCh:\n   284\t\t\t\t\t// Copy the result back\n   285\t\t\t\t\t*inp.future.resp = *rpcResp.Response.(*AppendEntriesResponse)\n   286\t\t\t\t\tinp.future.respond(rpcResp.Error)\n   287\t\n   288\t\t\t\t\tselect {\n   289\t\t\t\t\tcase i.doneCh <- inp.future:\n   290\t\t\t\t\tcase <-i.shutdownCh:\n   291\t\t\t\t\t\treturn\n   292\t\t\t\t\t}\n   293\t\n   294\t\t\t\tcase <-timeoutCh:\n   295\t\t\t\t\tinp.future.respond(fmt.Errorf(\"command timed out\"))\n   296\t\t\t\t\tselect {\n   297\t\t\t\t\tcase i.doneCh <- inp.future:\n   298\t\t\t\t\tcase <-i.shutdownCh:\n   299\t\t\t\t\t\treturn\n   300\t\t\t\t\t}\n   301\t\n   302\t\t\t\tcase <-i.shutdownCh:\n   303\t\t\t\t\treturn\n   304\t\t\t\t}\n   305\t\t\tcase <-i.shutdownCh:\n   306\t\t\t\treturn\n   307\t\t\t}\n   308\t\t}\n   309\t}\n   310\t\n   311\tfunc (i *inmemPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n../native-source/net_transport.go:19:\t\"github.com/hashicorp/go-msgpack/v2/codec\"\n../native-source/net_transport.go:166:\t// codec to use the new format of time.Time 