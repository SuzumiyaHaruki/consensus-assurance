{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/raft.go | sed -n '430,665p;760,825p;1210,1285p'\nnl -ba ../native-source/replication.go | sed -n '135,200p;299,386p;446,534p'\nnl -ba ../native-source/api.go | sed -n '490,560p;570,615p'\nrg -n 'func .*|commitment|startIndex' ../native-source/commitment_test.go\nrg -n '\"'^type .*interface|func New|func .*run'\"' ../native-source/{transport,stable,log,fsm,inmem_store,inmem_snapshot,file_snapshot,inmem_transport,net_transport,snapshot}.go\"","aggregated_output":"   430\t\t\t\tr.mainThreadSaturation.working()\n   431\t\t\t\t// Election failed! Restart the election. We simply return,\n   432\t\t\t\t// which will kick us back into runCandidate\n   433\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n   434\t\t\t\treturn\n   435\t\n   436\t\t\tcase <-r.shutdownCh:\n   437\t\t\t\treturn\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\tfunc (r *Raft) setLeadershipTransferInProgress(v bool) {\n   443\t\tif v {\n   444\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 1)\n   445\t\t} else {\n   446\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 0)\n   447\t\t}\n   448\t}\n   449\t\n   450\tfunc (r *Raft) getLeadershipTransferInProgress() bool {\n   451\t\tv := atomic.LoadInt32(&r.leaderState.leadershipTransferInProgress)\n   452\t\treturn v == 1\n   453\t}\n   454\t\n   455\tfunc (r *Raft) setupLeaderState() {\n   456\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n   457\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n   458\t\t\tr.configurations.latest,\n   459\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n   460\t\tr.leaderState.inflight = list.New()\n   461\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n   462\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n   463\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n   464\t}\n   465\t\n   466\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n   467\t// the leaderLoop for the hot loop.\n   468\tfunc (r *Raft) runLeader() {\n   469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n   471\t\n   472\t\t// Notify that we are the leader\n   473\t\toverrideNotifyBool(r.leaderCh, true)\n   474\t\n   475\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n   476\t\t// defer below runs, but this makes sure we always notify the same chan if\n   477\t\t// ever for both gaining and losing leadership.\n   478\t\tnotify := r.config().NotifyCh\n   479\t\n   480\t\t// Push to the notify channel if given\n   481\t\tif notify != nil {\n   482\t\t\tselect {\n   483\t\t\tcase notify <- true:\n   484\t\t\tcase <-r.shutdownCh:\n   485\t\t\t\t// make sure push to the notify channel ( if given )\n   486\t\t\t\tselect {\n   487\t\t\t\tcase notify <- true:\n   488\t\t\t\tdefault:\n   489\t\t\t\t}\n   490\t\t\t}\n   491\t\t}\n   492\t\n   493\t\t// setup leader state. This is only supposed to be accessed within the\n   494\t\t// leaderloop.\n   495\t\tr.setupLeaderState()\n   496\t\n   497\t\t// Run a background go-routine to emit metrics on log age\n   498\t\tstopCh := make(chan struct{})\n   499\t\tgo emitLogStoreMetrics(r.logs, []string{\"raft\", \"leader\"}, oldestLogGaugeInterval, stopCh)\n   500\t\n   501\t\t// Cleanup state on step down\n   502\t\tdefer func() {\n   503\t\t\tclose(stopCh)\n   504\t\n   505\t\t\t// Since we were the leader previously, we update our\n   506\t\t\t// last contact time when we step down, so that we are not\n   507\t\t\t// reporting a last contact time from before we were the\n   508\t\t\t// leader. Otherwise, to a client it would seem our data\n   509\t\t\t// is extremely stale.\n   510\t\t\tr.setLastContact()\n   511\t\n   512\t\t\t// Stop replication\n   513\t\t\tfor _, p := range r.leaderState.replState {\n   514\t\t\t\tclose(p.stopCh)\n   515\t\t\t}\n   516\t\n   517\t\t\t// Respond to all inflight operations\n   518\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   519\t\t\t\te.Value.(*logFuture).respond(ErrLeadershipLost)\n   520\t\t\t}\n   521\t\n   522\t\t\t// Respond to any pending verify requests\n   523\t\t\tfor future := range r.leaderState.notify {\n   524\t\t\t\tfuture.respond(ErrLeadershipLost)\n   525\t\t\t}\n   526\t\n   527\t\t\t// Clear all the state\n   528\t\t\tr.leaderState.commitCh = nil\n   529\t\t\tr.leaderState.commitment = nil\n   530\t\t\tr.leaderState.inflight = nil\n   531\t\t\tr.leaderState.replState = nil\n   532\t\t\tr.leaderState.notify = nil\n   533\t\t\tr.leaderState.stepDown = nil\n   534\t\n   535\t\t\t// If we are stepping down for some reason, no known leader.\n   536\t\t\t// We may have stepped down due to an RPC call, which would\n   537\t\t\t// provide the leader, so we cannot always blank this out.\n   538\t\t\tr.leaderLock.Lock()\n   539\t\t\tif r.leaderAddr == r.localAddr && r.leaderID == r.localID {\n   540\t\t\t\tr.leaderAddr = \"\"\n   541\t\t\t\tr.leaderID = \"\"\n   542\t\t\t}\n   543\t\t\tr.leaderLock.Unlock()\n   544\t\n   545\t\t\t// Notify that we are not the leader\n   546\t\t\toverrideNotifyBool(r.leaderCh, false)\n   547\t\n   548\t\t\t// Push to the notify channel if given\n   549\t\t\tif notify != nil {\n   550\t\t\t\tselect {\n   551\t\t\t\tcase notify <- false:\n   552\t\t\t\tcase <-r.shutdownCh:\n   553\t\t\t\t\t// On shutdown, make a best effort but do not block\n   554\t\t\t\t\tselect {\n   555\t\t\t\t\tcase notify <- false:\n   556\t\t\t\t\tdefault:\n   557\t\t\t\t\t}\n   558\t\t\t\t}\n   559\t\t\t}\n   560\t\t}()\n   561\t\n   562\t\t// Start a replication routine for each peer\n   563\t\tr.startStopReplication()\n   564\t\n   565\t\t// Dispatch a no-op log entry first. This gets this leader up to the latest\n   566\t\t// possible commit index, even in the absence of client commands. This used\n   567\t\t// to append a configuration entry instead of a noop. However, that permits\n   568\t\t// an unbounded number of uncommitted configurations in the log. We now\n   569\t\t// maintain that there exists at most one uncommitted configuration entry in\n   570\t\t// any log, so we have to do proper no-ops here.\n   571\t\tnoop := &logFuture{log: Log{Type: LogNoop}}\n   572\t\tr.dispatchLogs([]*logFuture{noop})\n   573\t\n   574\t\t// Sit in the leader loop until we step down\n   575\t\tr.leaderLoop()\n   576\t}\n   577\t\n   578\t// startStopReplication will set up state and start asynchronous replication to\n   579\t// new peers, and stop replication to removed peers. Before removing a peer,\n   580\t// it'll instruct the replication routines to try to replicate to the current\n   581\t// index. This must only be called from the main thread.\n   582\tfunc (r *Raft) startStopReplication() {\n   583\t\tinConfig := make(map[ServerID]bool, len(r.configurations.latest.Servers))\n   584\t\tlastIdx := r.getLastIndex()\n   585\t\n   586\t\t// Start replication goroutines that need starting\n   587\t\tfor _, server := range r.configurations.latest.Servers {\n   588\t\t\tif server.ID == r.localID {\n   589\t\t\t\tcontinue\n   590\t\t\t}\n   591\t\n   592\t\t\tinConfig[server.ID] = true\n   593\t\n   594\t\t\ts, ok := r.leaderState.replState[server.ID]\n   595\t\t\tif !ok {\n   596\t\t\t\tr.logger.Info(\"added peer, starting replication\", \"peer\", server.ID)\n   597\t\t\t\ts = &followerReplication{\n   598\t\t\t\t\tpeer:                server,\n   599\t\t\t\t\tcommitment:          r.leaderState.commitment,\n   600\t\t\t\t\tstopCh:              make(chan uint64, 1),\n   601\t\t\t\t\ttriggerCh:           make(chan struct{}, 1),\n   602\t\t\t\t\ttriggerDeferErrorCh: make(chan *deferError, 1),\n   603\t\t\t\t\tcurrentTerm:         r.getCurrentTerm(),\n   604\t\t\t\t\tnextIndex:           lastIdx + 1,\n   605\t\t\t\t\tlastContact:         time.Now(),\n   606\t\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n   607\t\t\t\t\tnotifyCh:            make(chan struct{}, 1),\n   608\t\t\t\t\tstepDown:            r.leaderState.stepDown,\n   609\t\t\t\t}\n   610\t\n   611\t\t\t\tr.leaderState.replState[server.ID] = s\n   612\t\t\t\tr.goFunc(func() { r.replicate(s) })\n   613\t\t\t\tasyncNotifyCh(s.triggerCh)\n   614\t\t\t\tr.observe(PeerObservation{Peer: server, Removed: false})\n   615\t\t\t} else if ok {\n   616\t\n   617\t\t\t\ts.peerLock.RLock()\n   618\t\t\t\tpeer := s.peer\n   619\t\t\t\ts.peerLock.RUnlock()\n   620\t\n   621\t\t\t\tif peer.Address != server.Address {\n   622\t\t\t\t\tr.logger.Info(\"updating peer\", \"peer\", server.ID)\n   623\t\t\t\t\ts.peerLock.Lock()\n   624\t\t\t\t\ts.peer = server\n   625\t\t\t\t\ts.peerLock.Unlock()\n   626\t\t\t\t}\n   627\t\t\t}\n   628\t\t}\n   629\t\n   630\t\t// Stop replication goroutines that need stopping\n   631\t\tfor serverID, repl := range r.leaderState.replState {\n   632\t\t\tif inConfig[serverID] {\n   633\t\t\t\tcontinue\n   634\t\t\t}\n   635\t\t\t// Replicate up to lastIdx and stop\n   636\t\t\tr.logger.Info(\"removed peer, stopping replication\", \"peer\", serverID, \"last-index\", lastIdx)\n   637\t\t\trepl.stopCh <- lastIdx\n   638\t\t\tclose(repl.stopCh)\n   639\t\t\tdelete(r.leaderState.replState, serverID)\n   640\t\t\tr.observe(PeerObservation{Peer: repl.peer, Removed: true})\n   641\t\t}\n   642\t\n   643\t\t// Update peers metric\n   644\t\tmetrics.SetGauge([]string{\"raft\", \"peers\"}, float32(len(r.configurations.latest.Servers)))\n   645\t}\n   646\t\n   647\t// configurationChangeChIfStable returns r.configurationChangeCh if it's safe\n   648\t// to process requests from it, or nil otherwise. This must only be called\n   649\t// from the main thread.\n   650\t//\n   651\t// Note that if the conditions here were to change outside of leaderLoop to take\n   652\t// this from nil to non-nil, we would need leaderLoop to be kicked.\n   653\tfunc (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n   654\t\t// Have to wait until:\n   655\t\t// 1. The latest configuration is committed, and\n   656\t\t// 2. This leader has committed some entry (the noop) in this term\n   657\t\t//    https://groups.google.com/forum/#!msg/raft-dev/t4xj6dJTP6E/d2D9LrWRza8J\n   658\t\tif r.configurations.latestIndex == r.configurations.committedIndex &&\n   659\t\t\tr.getCommitIndex() >= r.leaderState.commitment.startIndex {\n   660\t\t\treturn r.configurationChangeCh\n   661\t\t}\n   662\t\treturn nil\n   663\t}\n   664\t\n   665\t// leaderLoop is the hot loop for a leader. It is invoked\n   760\t\n   761\t\t\t\t// leaderState.replState is accessed here before\n   762\t\t\t\t// starting leadership transfer asynchronously because\n   763\t\t\t\t// leaderState is only supposed to be accessed in the\n   764\t\t\t\t// leaderloop.\n   765\t\t\t\tid := future.ID\n   766\t\t\t\taddress := future.Address\n   767\t\t\t\tif id == nil {\n   768\t\t\t\t\ts := r.pickServer()\n   769\t\t\t\t\tif s != nil {\n   770\t\t\t\t\t\tid = &s.ID\n   771\t\t\t\t\t\taddress = &s.Address\n   772\t\t\t\t\t} else {\n   773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n   774\t\t\t\t\t\tcontinue\n   775\t\t\t\t\t}\n   776\t\t\t\t}\n   777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n   778\t\t\t\tif !ok {\n   779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n   780\t\t\t\t\tcontinue\n   781\t\t\t\t}\n   782\t\t\t\tr.setLeadershipTransferInProgress(true)\n   783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n   784\t\n   785\t\t\tcase <-r.leaderState.commitCh:\n   786\t\t\t\tr.mainThreadSaturation.working()\n   787\t\t\t\t// Process the newly committed entries\n   788\t\t\t\toldCommitIndex := r.getCommitIndex()\n   789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n   790\t\t\t\tr.setCommitIndex(commitIndex)\n   791\t\n   792\t\t\t\t// New configuration has been committed, set it as the committed\n   793\t\t\t\t// value.\n   794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n   795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n   796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n   797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n   798\t\t\t\t\t\tstepDown = true\n   799\t\t\t\t\t}\n   800\t\t\t\t}\n   801\t\n   802\t\t\t\tstart := time.Now()\n   803\t\t\t\tvar groupReady []*list.Element\n   804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n   805\t\t\t\tvar lastIdxInGroup uint64\n   806\t\n   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   811\t\t\t\t\tif idx > commitIndex {\n   812\t\t\t\t\t\t// Don't go past the committed index\n   813\t\t\t\t\t\tbreak\n   814\t\t\t\t\t}\n   815\t\n   816\t\t\t\t\t// Measure the commit time\n   817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n   818\t\t\t\t\tgroupReady = append(groupReady, e)\n   819\t\t\t\t\tgroupFutures[idx] = commitLog\n   820\t\t\t\t\tlastIdxInGroup = idx\n   821\t\t\t\t}\n   822\t\n   823\t\t\t\t// Process the group\n   824\t\t\t\tif len(groupReady) != 0 {\n   825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n  1210\t\tr.logger.Info(\"updating configuration\",\n  1211\t\t\t\"command\", future.req.command,\n  1212\t\t\t\"server-id\", future.req.serverID,\n  1213\t\t\t\"server-addr\", future.req.serverAddress,\n  1214\t\t\t\"servers\", hclog.Fmt(\"%+v\", configuration.Servers))\n  1215\t\n  1216\t\t// In pre-ID compatibility mode we translate all configuration changes\n  1217\t\t// in to an old remove peer message, which can handle all supported\n  1218\t\t// cases for peer changes in the pre-ID world (adding and removing\n  1219\t\t// voters). Both add peer and remove peer log entries are handled\n  1220\t\t// similarly on old Raft servers, but remove peer does extra checks to\n  1221\t\t// see if a leader needs to step down. Since they both assert the full\n  1222\t\t// configuration, then we can safely call remove peer for everything.\n  1223\t\tif r.protocolVersion < 2 {\n  1224\t\t\tfuture.log = Log{\n  1225\t\t\t\tType: LogRemovePeerDeprecated,\n  1226\t\t\t\tData: encodePeers(configuration, r.trans),\n  1227\t\t\t}\n  1228\t\t} else {\n  1229\t\t\tfuture.log = Log{\n  1230\t\t\t\tType: LogConfiguration,\n  1231\t\t\t\tData: EncodeConfiguration(configuration),\n  1232\t\t\t}\n  1233\t\t}\n  1234\t\n  1235\t\tr.dispatchLogs([]*logFuture{&future.logFuture})\n  1236\t\tindex := future.Index()\n  1237\t\tr.setLatestConfiguration(configuration, index)\n  1238\t\tr.leaderState.commitment.setConfiguration(configuration)\n  1239\t\tr.startStopReplication()\n  1240\t}\n  1241\t\n  1242\t// dispatchLog is called on the leader to push a log to disk, mark it\n  1243\t// as inflight and begin replication of it.\n  1244\tfunc (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n  1245\t\tnow := time.Now()\n  1246\t\tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n  1247\t\n  1248\t\tterm := r.getCurrentTerm()\n  1249\t\tlastIndex := r.getLastIndex()\n  1250\t\n  1251\t\tn := len(applyLogs)\n  1252\t\tlogs := make([]*Log, n)\n  1253\t\tmetrics.SetGauge([]string{\"raft\", \"leader\", \"dispatchNumLogs\"}, float32(n))\n  1254\t\n  1255\t\tfor idx, applyLog := range applyLogs {\n  1256\t\t\tapplyLog.dispatch = now\n  1257\t\t\tlastIndex++\n  1258\t\t\tapplyLog.log.Index = lastIndex\n  1259\t\t\tapplyLog.log.Term = term\n  1260\t\t\tapplyLog.log.AppendedAt = now\n  1261\t\t\tlogs[idx] = &applyLog.log\n  1262\t\t\tr.leaderState.inflight.PushBack(applyLog)\n  1263\t\t}\n  1264\t\n  1265\t\t// Write the log entry locally\n  1266\t\tif err := r.logs.StoreLogs(logs); err != nil {\n  1267\t\t\tr.logger.Error(\"failed to commit logs\", \"error\", err)\n  1268\t\t\tfor _, applyLog := range applyLogs {\n  1269\t\t\t\tapplyLog.respond(err)\n  1270\t\t\t}\n  1271\t\t\tr.setState(Follower)\n  1272\t\t\treturn\n  1273\t\t}\n  1274\t\tr.leaderState.commitment.match(r.localID, lastIndex)\n  1275\t\n  1276\t\t// Update the last log since it's on disk now\n  1277\t\tr.setLastLog(lastIndex, term)\n  1278\t\n  1279\t\t// Notify the replicators of the new log\n  1280\t\tfor _, f := range r.leaderState.replState {\n  1281\t\t\tasyncNotifyCh(f.triggerCh)\n  1282\t\t}\n  1283\t}\n  1284\t\n  1285\t// processLogs is used to apply all the committed entries that haven't been\n   135\t// replicate is a long running routine that replicates log entries to a single\n   136\t// follower.\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n   165\t\t\t// followers quickly learn the leader's commit index when\n   166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n   167\t\t\t// can't do this to keep them unblocked by disk IO on the\n   168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n   169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   172\t\t\t}\n   173\t\n   174\t\t\t// If things looks healthy, switch to pipeline mode\n   175\t\t\tif !shouldStop && s.allowPipeline {\n   176\t\t\t\tgoto PIPELINE\n   177\t\t\t}\n   178\t\t}\n   179\t\treturn\n   180\t\n   181\tPIPELINE:\n   182\t\t// Disable until re-enabled\n   183\t\ts.allowPipeline = false\n   184\t\n   185\t\t// Replicates using a pipeline for high performance. This method\n   186\t\t// is not able to gracefully recover from errors, and so we fall back\n   187\t\t// to standard mode on failure.\n   188\t\tif err := r.pipelineReplicate(s); err != nil {\n   189\t\t\tif err != ErrPipelineReplicationNotSupported {\n   190\t\t\t\ts.peerLock.RLock()\n   191\t\t\t\tpeer := s.peer\n   192\t\t\t\ts.peerLock.RUnlock()\n   193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n   194\t\t\t}\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n   300\t\t// Get the snapshots\n   301\t\tsnapshots, err := r.snapshots.List()\n   302\t\tif err != nil {\n   303\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   304\t\t\treturn false, err\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer snapshot.Close()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   381\t\t}\n   382\t\treturn false, nil\n   383\t}\n   384\t\n   385\t// heartbeat is used to periodically invoke AppendEntries on a peer\n   386\t// to ensure they don't time out. This is done async of replicate(),\n   446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n   447\t\ts.peerLock.RLock()\n   448\t\tpeer := s.peer\n   449\t\ts.peerLock.RUnlock()\n   450\t\n   451\t\t// Create a new pipeline\n   452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n   453\t\tif err != nil {\n   454\t\t\treturn err\n   455\t\t}\n   456\t\tdefer pipeline.Close()\n   457\t\n   458\t\t// Log start and stop of pipeline\n   459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n   460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n   461\t\n   462\t\t// Create a shutdown and finish channel\n   463\t\tstopCh := make(chan struct{})\n   464\t\tfinishCh := make(chan struct{})\n   465\t\n   466\t\t// Start a dedicated decoder\n   467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n   468\t\n   469\t\t// Start pipeline sends at the last good nextIndex\n   470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n   471\t\n   472\t\tshouldStop := false\n   473\tSEND:\n   474\t\tfor !shouldStop {\n   475\t\t\tselect {\n   476\t\t\tcase <-finishCh:\n   477\t\t\t\tbreak SEND\n   478\t\t\tcase maxIndex := <-s.stopCh:\n   479\t\t\t\t// Make a best effort to replicate up to this index\n   480\t\t\t\tif maxIndex > 0 {\n   481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n   482\t\t\t\t}\n   483\t\t\t\tbreak SEND\n   484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   487\t\t\t\tif !shouldStop {\n   488\t\t\t\t\tdeferErr.respond(nil)\n   489\t\t\t\t} else {\n   490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   491\t\t\t\t}\n   492\t\t\tcase <-s.triggerCh:\n   493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   498\t\t\t}\n   499\t\t}\n   500\t\n   501\t\t// Stop our decoder, and wait for it to finish\n   502\t\tclose(stopCh)\n   503\t\tselect {\n   504\t\tcase <-finishCh:\n   505\t\tcase <-r.shutdownCh:\n   506\t\t}\n   507\t\treturn nil\n   508\t}\n   509\t\n   510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n   511\t// pipelineReplicate.\n   512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n   513\t\t// Create a new append request\n   514\t\treq := new(AppendEntriesRequest)\n   515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n   516\t\t\treturn true\n   517\t\t}\n   518\t\n   519\t\t// Pipeline the append entries\n   520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n   521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n   522\t\t\treturn true\n   523\t\t}\n   524\t\n   525\t\t// Increase the next send log to avoid re-sending old logs\n   526\t\tif n := len(req.Entries); n > 0 {\n   527\t\t\tlast := req.Entries[n-1]\n   528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n   529\t\t}\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   490\t\t\treturn true, nil\n   491\t\t}\n   492\t\n   493\t\treturn false, nil\n   494\t}\n   495\t\n   496\t// NewRaft is used to construct a new Raft node. It takes a configuration, as well\n   497\t// as implementations of various interfaces that are required. If we have any\n   498\t// old state, such as snapshots, logs, peers, etc, all those will be restored\n   499\t// when creating the Raft node.\n   500\tfunc NewRaft(conf *Config, fsm FSM, logs LogStore, stable StableStore, snaps SnapshotStore, trans Transport) (*Raft, error) {\n   501\t\t// Validate the configuration.\n   502\t\tif err := ValidateConfig(conf); err != nil {\n   503\t\t\treturn nil, err\n   504\t\t}\n   505\t\n   506\t\t// Ensure we have a LogOutput.\n   507\t\tlogger := conf.getOrCreateLogger()\n   508\t\n   509\t\t// Try to restore the current term.\n   510\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   511\t\tif err != nil && err.Error() != \"not found\" {\n   512\t\t\treturn nil, fmt.Errorf(\"failed to load current term: %v\", err)\n   513\t\t}\n   514\t\n   515\t\t// Read the index of the last log entry.\n   516\t\tlastIndex, err := logs.LastIndex()\n   517\t\tif err != nil {\n   518\t\t\treturn nil, fmt.Errorf(\"failed to find last log: %v\", err)\n   519\t\t}\n   520\t\n   521\t\t// Get the last log entry.\n   522\t\tvar lastLog Log\n   523\t\tif lastIndex > 0 {\n   524\t\t\tif err = logs.GetLog(lastIndex, &lastLog); err != nil {\n   525\t\t\t\treturn nil, fmt.Errorf(\"failed to get last log at index %d: %v\", lastIndex, err)\n   526\t\t\t}\n   527\t\t}\n   528\t\n   529\t\t// Make sure we have a valid server address and ID.\n   530\t\tprotocolVersion := conf.ProtocolVersion\n   531\t\tlocalAddr := trans.LocalAddr()\n   532\t\tlocalID := conf.LocalID\n   533\t\n   534\t\t// TODO (slackpad) - When we deprecate protocol version 2, remove this\n   535\t\t// along with the AddPeer() and RemovePeer() APIs.\n   536\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   537\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   538\t\t}\n   539\t\n   540\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   541\t\tapplyCh := make(chan *logFuture)\n   542\t\tif conf.BatchApplyCh {\n   543\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   544\t\t}\n   545\t\n   546\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   547\t\t// Create Raft struct.\n   548\t\tr := &Raft{\n   549\t\t\tprotocolVersion:       protocolVersion,\n   550\t\t\tapplyCh:               applyCh,\n   551\t\t\tfsm:                   fsm,\n   552\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   553\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   554\t\t\tleaderCh:              make(chan bool, 1),\n   555\t\t\tlocalID:               localID,\n   556\t\t\tlocalAddr:             localAddr,\n   557\t\t\tlogger:                logger,\n   558\t\t\tlogs:                  logs,\n   559\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   560\t\t\tconfigurations:        configurations{},\n   570\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   571\t\t\tobservers:             make(map[uint64]*Observer),\n   572\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   573\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   574\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   575\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   576\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   577\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   578\t\t}\n   579\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   580\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   581\t\t}\n   582\t\n   583\t\tr.conf.Store(*conf)\n   584\t\n   585\t\t// Initialize as a follower.\n   586\t\tr.setState(Follower)\n   587\t\n   588\t\t// Restore the current term and the last log.\n   589\t\tr.setCurrentTerm(currentTerm)\n   590\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   591\t\n   592\t\t// Attempt to restore a snapshot if there are any.\n   593\t\tif err := r.restoreSnapshot(); err != nil {\n   594\t\t\treturn nil, err\n   595\t\t}\n   596\t\n   597\t\t// Scan through the log for any configuration change entries.\n   598\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   599\t\tfor index := snapshotIndex + 1; index <= lastLog.Index; index++ {\n   600\t\t\tvar entry Log\n   601\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   603\t\t\t\tpanic(err)\n   604\t\t\t}\n   605\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   606\t\t\t\treturn nil, err\n   607\t\t\t}\n   608\t\t}\n   609\t\tr.logger.Info(\"initial configuration\",\n   610\t\t\t\"index\", r.configurations.latestIndex,\n   611\t\t\t\"servers\", hclog.Fmt(\"%+v\", r.configurations.latest.Servers))\n   612\t\n   613\t\t// Setup a heartbeat fast-path to avoid head-of-line\n   614\t\t// blocking where possible. It MUST be safe for this\n   615\t\t// to be called concurrently with a blocking RPC.\n10:func makeConfiguration(voters []string) Configuration {\n23:func voters(n int) Configuration {\n31:func TestCommitment_setVoters(t *testing.T) {\n54:func TestCommitment_match_max(t *testing.T) {\n69:func TestCommitment_match_nonVoting(t *testing.T) {\n94:func TestCommitment_recalculate(t *testing.T) {\n155:// Tests recalculate() respecting startIndex.\n156:func TestCommitment_recalculate_startIndex(t *testing.T) {\n165:\t\tt.Fatalf(\"can't commit until startIndex is replicated to a quorum\")\n176:\t\tt.Fatalf(\"should be able to commit startIndex once replicated to a quorum\")\n185:func TestCommitment_noVoterSanity(t *testing.T) {\n221:func TestCommitment_singleVoter(t *testing.T) {\n../native-source/stable.go:8:type StableStore interface {\n../native-source/inmem_snapshot.go:28:func NewInmemSnapshotStore() *InmemSnapshotStore {\n../native-source/snapshot.go:45:type SnapshotStore interface {\n../native-source/snapshot.go:63:type SnapshotSink interface {\n../native-source/snapshot.go:72:func (r *Raft) runSnapshots() {\n../native-source/net_transport.go:173:type ServerAddressProvider interface {\n../native-source/net_transport.go:179:type StreamLayer interface {\n../native-source/net_transport.go:211:func NewNetworkTransportWithConfig(\n../native-source/net_transport.go:251:func NewNetworkTransport(\n../native-source/net_transport.go:273:func NewNetworkTransportWithLogger(\n../native-source/inmem_store.go:25:func NewInmemStore() *InmemStore {\n../native-source/inmem_transport.go:15:func NewInmemAddr() ServerAddress {\n../native-source/inmem_transport.go:53:func NewInmemTransportWithTimeout(addr ServerAddress, timeout time.Duration) (ServerAddress, *InmemTransport) {\n../native-source/inmem_transport.go:68:func NewInmemTransport(addr ServerAddress) (ServerAddress, *InmemTransport) {\n../native-source/file_snapshot.go:88:func NewFileSnapshotStoreWithLogger(base string, ret