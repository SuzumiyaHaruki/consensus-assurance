etTypeStart := time.Now()\n   641\t\n   642\t\t// Get the rpc type\n   643\t\trpcType, err := r.ReadByte()\n   644\t\tif err != nil {\n   645\t\t\treturn err\n   646\t\t}\n   647\t\n   648\t\t// measuring the time to get the first byte separately because the heartbeat conn will hang out here\n   649\t\t// for a good while waiting for a heartbeat whereas the append entries/rpc conn should not.\n   650\t\tmetrics.MeasureSince([]string{\"raft\", \"net\", \"getRPCType\"}, getTypeStart)\n   651\t\tdecodeStart := time.Now()\n   652\t\n   653\t\t// Create the RPC object\n   654\t\trespCh := make(chan RPCResponse, 1)\n   655\t\trpc := RPC{\n   656\t\t\tRespChan: respCh,\n   657\t\t}\n   658\t\n   659\t\t// Decode the command\n   660\t\tisHeartbeat := false\n   661\t\tvar labels []metrics.Label\n   662\t\tswitch rpcType {\n   663\t\tcase rpcAppendEntries:\n   664\t\t\tvar req AppendEntriesRequest\n   665\t\t\tif err := dec.Decode(&req); err != nil {\n   715\t\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"TimeoutNow\"}}\n   716\t\tdefault:\n   717\t\t\treturn fmt.Errorf(\"unknown rpc type %d\", rpcType)\n   718\t\t}\n   719\t\n   720\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"net\", \"rpcDecode\"}, decodeStart, labels)\n   721\t\n   722\t\tprocessStart := time.Now()\n   723\t\n   724\t\t// Check for heartbeat fast-path\n   725\t\tif isHeartbeat {\n   726\t\t\tn.heartbeatFnLock.Lock()\n   727\t\t\tfn := n.heartbeatFn\n   728\t\t\tn.heartbeatFnLock.Unlock()\n   729\t\t\tif fn != nil {\n   730\t\t\t\tfn(rpc)\n   731\t\t\t\tgoto RESP\n   732\t\t\t}\n   733\t\t}\n   734\t\n   735\t\t// Dispatch the RPC\n   736\t\tselect {\n   737\t\tcase n.consumeCh <- rpc:\n   738\t\tcase <-n.shutdownCh:\n   739\t\t\treturn ErrTransportShutdown\n   740\t\t}\n   741\t\n   742\t\t// Wait for response\n   743\tRESP:\n   744\t\t// we will differentiate the heartbeat fast path from normal RPCs with labels\n   745\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"net\", \"rpcEnqueue\"}, processStart, labels)\n   746\t\trespWaitStart := time.Now()\n   747\t\tselect {\n   748\t\tcase resp := <-respCh:\n   749\t\t\tdefer metrics.MeasureSinceWithLabels([]string{\"raft\", \"net\", \"rpcRespond\"}, respWaitStart, labels)\n   750\t\t\t// Send the error first\n   751\t\t\trespErr := \"\"\n   752\t\t\tif resp.Error != nil {\n   753\t\t\t\trespErr = resp.Error.Error()\n   754\t\t\t}\n   755\t\t\tif err := enc.Encode(respErr); err != nil {\n   756\t\t\t\treturn err\n   757\t\t\t}\n   758\t\n   759\t\t\t// Send the response\n   760\t\t\tif err := enc.Encode(resp.Response); err != nil {\n   761\t\t\t\treturn err\n   762\t\t\t}\n   763\t\tcase <-n.shutdownCh:\n   764\t\t\treturn ErrTransportShutdown\n   765\t\t}\n   766\t\treturn nil\n   767\t}\n    55\t\t}\n    56\t\t*log = *l\n    57\t\treturn nil\n    58\t}\n    59\t\n    60\t// StoreLog implements the LogStore interface.\n    61\tfunc (i *InmemStore) StoreLog(log *Log) error {\n    62\t\treturn i.StoreLogs([]*Log{log})\n    63\t}\n    64\t\n    65\t// StoreLogs implements the LogStore interface.\n    66\tfunc (i *InmemStore) StoreLogs(logs []*Log) error {\n    67\t\ti.l.Lock()\n    68\t\tdefer i.l.Unlock()\n    69\t\tfor _, l := range logs {\n    70\t\t\ti.logs[l.Index] = l\n    71\t\t\tif i.lowIndex == 0 {\n    72\t\t\t\ti.lowIndex = l.Index\n    73\t\t\t}\n    74\t\t\tif l.Index > i.highIndex {\n    75\t\t\t\ti.highIndex = l.Index\n    76\t\t\t}\n    77\t\t}\n    78\t\treturn nil\n    79\t}\n    80\t\n    81\t// DeleteRange implements the LogStore interface.\n    82\tfunc (i *InmemStore) DeleteRange(min, max uint64) error {\n    83\t\ti.l.Lock()\n    84\t\tdefer i.l.Unlock()\n    85\t\tfor j := min; j <= max; j++ {\n    86\t\t\tdelete(i.logs, j)\n    87\t\t}\n    88\t\tif min <= i.lowIndex {\n    89\t\t\ti.lowIndex = max + 1\n    90\t\t}\n    91\t\tif max >= i.highIndex {\n    92\t\t\ti.highIndex = min - 1\n    93\t\t}\n    94\t\tif i.lowIndex > i.highIndex {\n    95\t\t\ti.lowIndex = 0\n    96\t\t\ti.highIndex = 0\n    97\t\t}\n    98\t\treturn nil\n    99\t}\n   100\t\n   101\t// Set implements the StableStore interface.\n   102\tfunc (i *InmemStore) Set(key []byte, val []byte) error {\n   103\t\ti.l.Lock()\n   104\t\tdefer i.l.Unlock()\n   105\t\ti.kv[string(key)] = val\n   106\t\treturn nil\n   107\t}\n   108\t\n   109\t// Get implements the StableStore interface.\n   110\tfunc (i *InmemStore) Get(key []byte) ([]byte, error) {\n","exit_code":0,"status":"completed"}}
