{
  "$defs": {
    "AuditQuestion": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "explained_by_existing_mechanism",
                "concrete_suspicion",
                "needs_specific_evidence",
                "ready_for_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition"
        },
        "preferred_check": {
          "anyOf": [
            {
              "enum": [
                "source_review",
                "direct_test",
                "controlled_schedule",
                "local_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Check"
        },
        "requests": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReadRequest"
          },
          "title": "Requests",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "activity_classes": {
          "default": [],
          "items": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7"
            ],
            "type": "string"
          },
          "title": "Activity Classes",
          "type": "array"
        },
        "behavior_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "obligation_relation_kind": {
          "anyOf": [
            {
              "enum": [
                "establishment",
                "preservation",
                "consumption",
                "recovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obligation Relation Kind"
        },
        "counterevidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "description": "System consequence and audit significance, justified in importance; not proof",
          "maximum": 3,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "trigger_rationale": {
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "question",
        "importance",
        "trigger_rationale"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "minItems": 1,
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "associations",
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "CandidateSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "action": {
          "enum": [
            "continue",
            "pause",
            "explained",
            "obligation"
          ],
          "title": "Action",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "parent_candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Candidate Id"
        },
        "question": {
          "$ref": "#/$defs/AuditQuestion"
        },
        "resume_conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resume Conditions",
          "type": "array"
        },
        "counterevidence_resolution": {
          "default": "",
          "title": "Counterevidence Resolution",
          "type": "string"
        },
        "obligation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "title": "Bindings",
          "type": "array"
        }
      },
      "required": [
        "rationale",
        "action",
        "question"
      ],
      "title": "CandidateSubmission",
      "type": "object"
    },
    "CheckSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "action": {
          "enum": [
            "check",
            "revise_check"
          ],
          "title": "Action",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSubmission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_path": {
          "title": "Plan Path",
          "type": "string"
        },
        "harness_path": {
          "title": "Harness Path",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Destination path to draft source path for helpers",
          "title": "Files",
          "type": "object"
        },
        "previous_check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Check Id"
        },
        "encoding_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncodingRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rationale",
        "action",
        "plan_path",
        "harness_path"
      ],
      "title": "CheckSubmission",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding",
          "default": {
            "source_ids": [],
            "expectation_ids": [],
            "binding_ids": [],
            "derivation": "",
            "applicability": "",
            "unresolved": [],
            "conflicts": [],
            "alternatives": []
          }
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "boundary_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Complete"
        },
        "kind": {
          "default": "declaration",
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "ConditionDisposition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable ID from the supplied condition records; preferred for new output",
          "title": "Condition Id"
        },
        "condition": {
          "default": "",
          "description": "Legacy exact-text reference; do not paraphrase it to bypass unresolved conditions",
          "title": "Condition",
          "type": "string"
        },
        "applies_to": {
          "enum": [
            "old_judgment",
            "current_judgment",
            "independent_scope"
          ],
          "title": "Applies To",
          "type": "string"
        },
        "rationale": {
          "description": "Explain the responsibility and range to which this condition applies, preserving counterevidence",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "applies_to",
        "rationale",
        "source_ids"
      ],
      "title": "ConditionDisposition",
      "type": "object"
    },
    "EncodingRevision": {
      "additionalProperties": false,
      "properties": {
        "old_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Model Id"
        },
        "old_direct_check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Direct Check Id"
        },
        "issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "input_changes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Changes",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "rationale"
      ],
      "title": "EncodingRevision",
      "type": "object"
    },
    "ExploreSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "action": {
          "const": "explore",
          "title": "Action",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "harness_path": {
          "title": "Harness Path",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "rationale",
        "action",
        "question",
        "harness_path"
      ],
      "title": "ExploreSubmission",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "expectation_ids": {
          "description": "Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.",
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "default": "",
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "default": "",
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object"
    },
    "IssueResolution": {
      "additionalProperties": false,
      "properties": {
        "condition_dispositions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionDisposition"
          },
          "title": "Condition Dispositions",
          "type": "array"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "target_version": {
          "title": "Target Version",
          "type": "integer"
        },
        "original_question": {
          "description": "The exact stored issue explanation; preserve stable problem identity",
          "title": "Original Question",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "description": "Why actual evidence answers this specific issue; describing current behavior alone is insufficient",
          "title": "Rationale",
          "type": "string"
        },
        "residual_issue_ids": {
          "description": "Other independent open issues that remain; never the resolved issue or its unresolved children",
          "items": {
            "type": "string"
          },
          "title": "Residual Issue Ids",
          "type": "array"
        },
        "scope_limitations": {
          "description": "Independent boundaries retained by the related review item",
          "items": {
            "type": "string"
          },
          "title": "Scope Limitations",
          "type": "array"
        }
      },
      "required": [
        "issue_id",
        "target_version",
        "original_question",
        "source_ids",
        "rationale",
        "residual_issue_ids",
        "scope_limitations"
      ],
      "title": "IssueResolution",
      "type": "object"
    },
    "ModelSubmission": {
