        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Files",
          "type": "object"
        },
        "previous_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
