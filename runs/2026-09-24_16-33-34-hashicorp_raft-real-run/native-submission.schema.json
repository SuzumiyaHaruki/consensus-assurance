            "F1",
            "F4"
          ],
          "title": "Change",
          "type": "string"
        },
        "replay_finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Finding Id"
        }
      },
      "required": [
        "rationale",
        "action",
        "unit_id",
        "model_path",
        "behavior_path",
        "properties_path"
      ],
      "title": "ModelSubmission",
      "type": "object"
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "literal": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    },
    "ResearchSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
