{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"grep 'CA_EVENT' ../logs/4fcecc7255ae497e877cff1da4db063b/stdout.log; cat ../direct-checks/651e2a8158024264b07b857caa9c202c/omnipaxos/tests/assurance_generated.rs; cat ../direct-checks/651e2a8158024264b07b857caa9c202c/plan.json\"","aggregated_output":"test delta_snapshot_preserves_decided_prefix ... CA_EVENT {\"event\":\"transport_drop\",\"from\":1,\"message\":\"SequencePaxos(PaxosMessage { from: 1, to: 3, msg: AcceptDecide(AcceptDecide { n: Ballot { config_id: 1, n: 1, priority: 0, pid: 1 }, seq_num: SequenceNumber { session: 1, counter: 4 }, decided_idx: 1, entries: [Item(22)] }) })\",\"to\":3}\nCA_EVENT {\"event\":\"transport_drop\",\"from\":1,\"message\":\"SequencePaxos(PaxosMessage { from: 1, to: 3, msg: Decide(Decide { n: Ballot { config_id: 1, n: 1, priority: 0, pid: 1 }, seq_num: SequenceNumber { session: 1, counter: 5 }, decided_idx: 2 }) })\",\"to\":3}\nCA_EVENT {\"case\":\"delta_missing_entry\",\"event\":\"prefix_ready\",\"expected_content\":\"[11,22]\",\"leader_decided\":2,\"receiver\":3,\"receiver_accepted\":1,\"receiver_content\":\"[11]\",\"receiver_decided\":1,\"sync_id\":1}\nCA_EVENT {\"accepted\":1,\"ballot\":\"Ballot { config_id: 1, n: 1, priority: 0, pid: 1 }\",\"case\":\"delta_missing_entry\",\"decided\":1,\"event\":\"recovery_promise\",\"receiver\":3,\"sync_id\":1}\nCA_EVENT {\"ballot\":\"Ballot { config_id: 1, n: 1, priority: 0, pid: 1 }\",\"case\":\"delta_missing_entry\",\"decided\":2,\"delta\":[22],\"event\":\"sync_admitted\",\"expected_content\":\"[11,22]\",\"receiver\":3,\"sequence\":\"SequenceNumber { session: 2, counter: 1 }\",\"sync_id\":1,\"sync_idx\":2}\nCA_EVENT {\"accepted\":2,\"actual_content\":\"[22]\",\"case\":\"delta_missing_entry\",\"compacted\":2,\"completed\":true,\"decided\":2,\"event\":\"sync_result\",\"read\":\"Some([Snapshotted(SnapshottedEntry { trimmed_idx: 2, snapshot: Prefix([22]), _p: PhantomData<assurance_generated::Item> })])\",\"receiver\":3,\"sync_id\":1}\nuse omnipaxos::{OmniPaxos, OmniPaxosConfig, ClusterConfig, ServerConfig};\nuse omnipaxos::storage::{Entry, Snapshot, SnapshotType};\nuse omnipaxos::messages::{Message, sequence_paxos::PaxosMsg};\nuse omnipaxos::util::LogEntry;\nuse omnipaxos_storage::memory_storage::MemoryStorage;\nuse serde::{Serialize, Deserialize};\nuse serde_json::json;\nuse std::collections::VecDeque;\n\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct Item(u64);\n#[derive(Clone, Debug, Serialize, Deserialize)]\nstruct Prefix(Vec<u64>);\nimpl Entry for Item { type Snapshot = Prefix; }\nimpl Snapshot<Item> for Prefix {\n    fn create(entries: &[Item]) -> Self { Self(entries.iter().map(|x| x.0).collect()) }\n    fn merge(&mut self, delta: Self) { self.0.extend(delta.0); }\n    fn use_snapshots() -> bool { true }\n}\ntype Node = OmniPaxos<Item, MemoryStorage<Item>>;\nfn event(v: serde_json::Value) { println!(\"CA_EVENT {}\", v); }\nfn contents(node: &Node) -> String {\n    let mut result = Vec::new();\n    if let Some(entries) = node.read_decided_suffix(0) {\n        for entry in entries {\n            match entry {\n                LogEntry::Decided(x) => result.push(x.0),\n                LogEntry::Snapshotted(s) => result.extend(s.snapshot.0),\n                other => panic!(\"Unexpected decided representation: {:?}\", other),\n            }\n        }\n    }\n    serde_json::to_string(&result).unwrap()\n}\nfn collect(nodes: &mut [Node], queue: &mut VecDeque<Message<Item>>) {\n    for node in nodes {\n        let mut out = Vec::new();\n        node.take_outgoing_messages(&mut out);\n        queue.extend(out);\n    }\n}\n// FIFO delivery for every connected pair; disconnection discards all traffic\n// involving node 3, independent of message type or observed protocol result.\nfn drain(nodes: &mut [Node], disconnected: bool) {\n    let mut queue = VecDeque::new();\n    collect(nodes, &mut queue);\n    for step in 0..1000 {\n        let Some(msg) = queue.pop_front() else { return; };\n        let from = msg.get_sender();\n        let to = msg.get_receiver();\n        if disconnected && (from == 3 || to == 3) {\n            event(json!({\"event\":\"transport_drop\", \"from\":from,\"to\":to,\"message\":format!(\"{:?}\", msg)}));\n        } else {\n            nodes[(to - 1) as usize].handle_incoming(msg);\n        }\n        collect(nodes, &mut queue);\n        assert!(step < 999, \"Transport did not quiesce\");\n    }\n}\n#[test]\nfn delta_snapshot_preserves_decided_prefix() {\n    let mut nodes: Vec<Node> = (1..=3).map(|pid| {\n        let config = OmniPaxosConfig {\n            cluster_config: ClusterConfig { configuration_id: 1, nodes: vec![1,2,3], flexible_quorum: None },\n            server_config: ServerConfig { pid, batch_size: 1, ..Default::default() },\n        };\n        config.build(MemoryStorage::default()).unwrap()\n    }).collect();\n    // Public manual leadership attempt still performs actual prepare/accept quorums.\n    nodes[0].try_become_leader();\n    drain(&mut nodes, false);\n    assert!(nodes.iter().all(|n| n.get_current_leader() == Some((1, true))));\n    nodes[0].append(Item(11)).unwrap();\n    drain(&mut nodes, false);\n    assert!(nodes.iter().all(|n| n.get_decided_idx() == 1 && contents(n) == \"[11]\"));\n    // Transport disconnects node 3; majority {1,2} remains connected.\n    nodes[0].append(Item(22)).unwrap();\n    drain(&mut nodes, true);\n    assert_eq!(nodes[0].get_decided_idx(), 2);\n    assert_eq!(nodes[1].get_decided_idx(), 2);\n    assert_eq!(contents(&nodes[0]), \"[11,22]\");\n    assert_eq!(contents(&nodes[1]), \"[11,22]\");\n    assert_eq!(nodes[2].get_decided_idx(), 1);\n    assert_eq!(nodes[2].get_accepted_idx(), 1);\n    assert_eq!(contents(&nodes[2]), \"[11]\");\n    let expected = contents(&nodes[0]);\n    event(json!({\"event\":\"prefix_ready\",\"case\":\"delta_missing_entry\",\"receiver\":3,\"sync_id\":1,\n        \"leader_decided\":nodes[0].get_decided_idx(),\"receiver_decided\":nodes[2].get_decided_idx(),\n        \"receiver_accepted\":nodes[2].get_accepted_idx(),\"receiver_content\":contents(&nodes[2]),\"expected_content\":expected}));\n    // The simulated link is restored before issuing the documented notification.\n    nodes[2].reconnected(1);\n    let mut queue = VecDeque::new();\n    collect(&mut nodes, &mut queue);\n    let mut observed = false;\n    let mut promise_seen = false;\n    for _ in 0..1000 {\n        let Some(msg) = queue.pop_front() else { break; };\n        let to = msg.get_receiver();\n        if let Message::SequencePaxos(p) = &msg {\n            if p.from == 3 {\n                if let PaxosMsg::Promise(prom) = &p.msg {\n                    assert_eq!(prom.decided_idx, 1);\n                    assert_eq!(prom.accepted_idx, 1);\n                    promise_seen = true;\n                    event(json!({\"event\":\"recovery_promise\",\"case\":\"delta_missing_entry\",\"receiver\":3,\"sync_id\":1,\"ballot\":format!(\"{:?}\",prom.n),\"decided\":prom.decided_idx,\"accepted\":prom.accepted_idx}));\n                }\n            }\n            if to == 3 {\n                if let PaxosMsg::AcceptSync(sync) = &p.msg {\n                    assert!(promise_seen);\n                    assert!(!observed);\n                    assert_eq!(sync.n, nodes[2].get_promise());\n                    assert_eq!(sync.decided_idx, 2);\n                    assert_eq!(sync.log_sync.sync_idx, 2);\n                    let delta = match &sync.log_sync.decided_snapshot {\n                        Some(SnapshotType::Delta(s)) => s.0.clone(),\n                        other => panic!(\"Expected actual Delta from target, got {:?}\", other),\n                    };\n                    event(json!({\"event\":\"sync_admitted\",\"case\":\"delta_missing_entry\",\"receiver\":3,\"sync_id\":1,\n                        \"expected_content\":expected,\"delta\":delta,\"decided\":sync.decided_idx,\n                        \"sync_idx\":sync.log_sync.sync_idx,\"ballot\":format!(\"{:?}\",sync.n),\"sequence\":format!(\"{:?}\",sync.seq_num)}));\n                    let ballot = sync.n;\n                    nodes[2].handle_incoming(msg);\n                    let mut replies = Vec::new();\n                    nodes[2].take_outgoing_messages(&mut replies);\n                    let acknowledged = replies.iter().any(|r| matches!(r,\n                        Message::SequencePaxos(p) if p.from==3 && p.to==1 && matches!(&p.msg,\n                            PaxosMsg::Accepted(a) if a.n==ballot && a.accepted_idx==2)));\n                    event(json!({\"event\":\"sync_result\",\"case\":\"delta_missing_entry\",\"receiver\":3,\"sync_id\":1,\n                        \"completed\":acknowledged && nodes[2].get_current_leader()==Some((1,true)),\n                        \"actual_content\":contents(&nodes[2]),\"decided\":nodes[2].get_decided_idx(),\n                        \"accepted\":nodes[2].get_accepted_idx(),\"compacted\":nodes[2].get_compacted_idx(),\n                        \"read\":format!(\"{:?}\",nodes[2].read_decided_suffix(0))}));\n                    queue.extend(replies);\n                    observed = true;\n                    continue;\n                }\n            }\n        }\n        nodes[(to-1) as usize].handle_incoming(msg);\n        collect(&mut nodes, &mut queue);\n    }\n    assert!(observed, \"No recovery AcceptSync was delivered\");\n    assert!(queue.is_empty(), \"Recovery message exchange did not finish\");\n}\n{\n  \"description\": \"Exercise C-delta-prefix by reconnecting a follower with decided=accepted=1 after the leader and another follower decide a second entry. Delta is generated by target code with boundary 2. Compare full recovered content to independently read leader decided prefix.\",\n  \"claim_id\": \"C-delta-prefix\",\n  \"binding_ids\": [\n    \"K-sync-log\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./omnipaxos\",\n    \"files\": {},\n    \"kind\": \"rust_test\",\n    \"source\": \"use omnipaxos::{OmniPaxos, OmniPaxosConfig, ClusterConfig, ServerConfig};\\nuse omnipaxos::storage::{Entry, Snapshot, SnapshotType};\\nuse omnipaxos::messages::{Message, sequence_paxos::PaxosMsg};\\nuse omnipaxos::util::LogEntry;\\nuse omnipaxos_storage::memory_storage::MemoryStorage;\\nuse serde::{Serialize, Deserialize};\\nuse serde_json::json;\\nuse std::collections::VecDeque;\\n\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\nstruct Item(u64);\\n#[derive(Clone, Debug, Serialize, Deserialize)]\\nstruct Prefix(Vec<u64>);\\nimpl Entry for Item { type Snapshot = Prefix; }\\nimpl Snapshot<Item> for Prefix {\\n    fn create(entries: &[Item]) -> Self { Self(entries.iter().map(|x| x.0).collect()) }\\n    fn merge(&mut self, delta: Self) { self.0.extend(delta.0); }\\n    fn use_snapshots() -> bool { true }\\n}\\ntype Node = OmniPaxos<Item, MemoryStorage<Item>>;\\nfn event(v: serde_json::Value) { println!(\\\"CA_EVENT {}\\\", v); }\\nfn contents(node: &Node) -> String {\\n    let mut result = Vec::new();\\n    if let Some(entries) = node.read_decided_suffix(0) {\\n        for entry in entries {\\n            match entry {\\n                LogEntry::Decided(x) => result.push(x.0),\\n                LogEntry::Snapshotted(s) => result.extend(s.snapshot.0),\\n                other => panic!(\\\"Unexpected decided representation: {:?}\\\", other),\\n            }\\n        }\\n    }\\n    serde_json::to_string(&result).unwrap()\\n}\\nfn collect(nodes: &mut [Node], queue: &mut VecDeque<Message<Item>>) {\\n    for node in nodes {\\n        let mut out = Vec::new();\\n        node.take_outgoing_messages(&mut out);\\n        queue.extend(out);\\n    }\\n}\\n// FIFO delivery for every connected pair; disconnection discards all traffic\\n// involving node 3, independent of message type or observed protocol result.\\nfn drain(nodes: &mut [Node], disconnected: bool) {\\n    let mut queue = VecDeque::new();\\n    collect(nodes, &mut queue);\\n    for step in 0..1000 {\\n        let Some(msg) = queue.pop_front() else { return; };\\n        let from = msg.get_sender();\\n        let to = msg.get_receiver();\\n        if disconnected && (from == 3 || to == 3) {\\n            event(json!({\\\"event\\\":\\\"transport_drop\\\", \\\"from\\\":from,\\\"to\\\":to,\\\"message\\\":format!(\\\"{:?}\\\", msg)}));\\n        } else {\\n            nodes[(to - 1) as usize].handle_incoming(msg);\\n        }\\n        collect(nodes, &mut queue);\\n        assert!(step < 999, \\\"Transport did not quiesce\\\");\\n    }\\n}\\n#[test]\\nfn delta_snapshot_preserves_decided_prefix() {\\n    let mut nodes: Vec<Node> = (1..=3).map(|pid| {\\n        let config = OmniPaxosConfig {\\n            cluster_config: ClusterConfig { configuration_id: 1, nodes: vec![1,2,3], flexible_quorum: None },\\n            server_config: ServerConfig { pid, batch_size: 1, ..Default::default() },\\n        };\\n        config.build(MemoryStorage::default()).unwrap()\\n    }).collect();\\n    // Public manual leadership attempt still performs actual prepare/accept quorums.\\n    nodes[0].try_become_leader();\\n    drain(&mut nodes, false);\\n    assert!(nodes.iter().all(|n| n.get_current_leader() == Some((1, true))));\\n    nodes[0].append(Item(11)).unwrap();\\n    drain(&mut nodes, false);\\n    assert!(nodes.iter().all(|n| n.get_decided_idx() == 1 && contents(n) == \\\"[11]\\\"));\\n    // Transport disconnects node 3; majority {1,2} remains connected.\\n    nodes[0].append(Item(22)).unwrap();\\n    drain(&mut nodes, true);\\n    assert_eq!(nodes[0].get_decided_idx(), 2);\\n    assert_eq!(nodes[1].get_decided_idx(), 2);\\n    assert_eq!(contents(&nodes[0]), \\\"[11,22]\\\");\\n    assert_eq!(contents(&nodes[1]), \\\"[11,22]\\\");\\n    assert_eq!(nodes[2].get_decided_idx(), 1);\\n    assert_eq!(nodes[2].get_accepted_idx(), 1);\\n    assert_eq!(contents(&nodes[2]), \\\"[11]\\\");\\n    let expected = contents(&nodes[0]);\\n    event(json!({\\\"event\\\":\\\"prefix_ready\\\",\\\"case\\\":\\\"delta_missing_entry\\\",\\\"receiver\\\":3,\\\"sync_id\\\":1,\\n        \\\"leader_decided\\\":nodes[0].get_decided_idx(),\\\"receiver_decided\\\":nodes[2].get_decided_idx(),\\n        \\\"receiver_accepted\\\":nodes[2].get_accepted_idx(),\\\"receiver_content\\\":contents(&nodes[2]),\\\"expected_content\\\":expected}));\\n    // The simulated link is restored before issuing the documented notification.\\n    nodes[2].reconnected(1);\\n    let mut queue = VecDeque::new();\\n    collect(&mut nodes, &mut queue);\\n    let mut observed = false;\\n    let mut promise_seen = false;\\n    for _ in 0..1000 {\\n        let Some(msg) = queue.pop_front() else { break; };\\n        let to = msg.get_receiver();\\n        if let Message::SequencePaxos(p) = &msg {\\n            if p.from == 3 {\\n                if let PaxosMsg::Promise(prom) = &p.msg {\\n                    assert_eq!(prom.decided_idx, 1);\\n                    assert_eq!(prom.accepted_idx, 1);\\n                    promise_seen = true;\\n                    event(json!({\\\"event\\\":\\\"recovery_promise\\\",\\\"case\\\":\\\"delta_missing_entry\\\",\\\"receiver\\\":3,\\\"sync_id\\\":1,\\\"ballot\\\":format!(\\\"{:?}\\\",prom.n),\\\"decided\\\":prom.decided_idx,\\\"accepted\\\":prom.accepted_idx}));\\n                }\\n            }\\n            if to == 3 {\\n                if let PaxosMsg::AcceptSync(sync) = &p.msg {\\n                    assert!(promise_seen);\\n                    assert!(!observed);\\n                    assert_eq!(sync.n, nodes[2].get_promise());\\n                    assert_eq!(sync.decided_idx, 2);\\n                    assert_eq!(sync.log_sync.sync_idx, 2);\\n                    let delta = match &sync.log_sync.decided_snapshot {\\n                        Some(SnapshotType::Delta(s)) => s.0.clone(),\\n                        other => panic!(\\\"Expected actual Delta from target, got {:?}\\\", other),\\n                    };\\n                    event(json!({\\\"event\\\":\\\"sync_admitted\\\",\\\"case\\\":\\\"delta_missing_entry\\\",\\\"receiver\\\":3,\\\"sync_id\\\":1,\\n                        \\\"expected_content\\\":expected,\\\"delta\\\":delta,\\\"decided\\\":sync.decided_idx,\\n                        \\\"sync_idx\\\":sync.log_sync.sync_idx,\\\"ballot\\\":format!(\\\"{:?}\\\",sync.n),\\\"sequence\\\":format!(\\\"{:?}\\\",sync.seq_num)}));\\n                    let ballot = sync.n;\\n                    nodes[2].handle_incoming(msg);\\n                    let mut replies = Vec::new();\\n                    nodes[2].take_outgoing_messages(&mut replies);\\n                    let acknowledged = replies.iter().any(|r| matches!(r,\\n                        Message::SequencePaxos(p) if p.from==3 && p.to==1 && matches!(&p.msg,\\n                            PaxosMsg::Accepted(a) if a.n==ballot && a.accepted_idx==2)));\\n                    event(json!({\\\"event\\\":\\\"sync_result\\\",\\\"case\\\":\\\"delta_missing_entry\\\",\\\"receiver\\\":3,\\\"sync_id\\\":1,\\n                        \\\"completed\\\":acknowledged && nodes[2].get_current_leader()==Some((1,true)),\\n                        \\\"actual_content\\\":contents(&nodes[2]),\\\"decided\\\":nodes[2].get_decided_idx(),\\n                        \\\"accepted\\\":nodes[2].get_accepted_idx(),\\\"compacted\\\":nodes[2].get_compacted_idx(),\\n                        \\\"read\\\":format!(\\\"{:?}\\\",nodes[2].read_decided_suffix(0))}));\\n                    queue.extend(replies);\\n                    observed = true;\\n                    continue;\\n                }\\n            }\\n        }\\n        nodes[(to-1) as usize].handle_incoming(msg);\\n        collect(&mut nodes, &mut queue);\\n    }\\n    assert!(observed, \\\"No recovery AcceptSync was delivered\\\");\\n    assert!(queue.is_empty(), \\\"Recovery message exchange did not finish\\\");\\n}\\n\",\n    \"description\": \"Three public OmniPaxos instances, genuine FIFO transport messages, one temporary node partition and reconnect notification. Record prerequisites, Delta dispatch, Accepted completion and synchronous decided reads.\",\n    \"semantic_changes\": [\n      \"No target code changes. A deterministic caller-owned transport models the documented external network boundary. Snapshot is a content-preserving vector with concatenate merge.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prefix\",\n        \"event\": \"prefix_ready\",\n        \"conditions\": [\n          {\n            \"field\": \"leader_decided\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"receiver_decided\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          },\n          {\n            \"field\": \"receiver_accepted\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"sync\",\n        \"event\": \"sync_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"expected_content\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prefix.expected_content\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"M-api\",\n        \"M-transport\",\n        \"M-sequence\",\n        \"M-follower\",\n        \"M-leader\",\n        \"M-memory\",\n        \"M-value-snapshot\",\n        \"M-sync-test\",\n        \"M-message-accessors\"\n      ],\n      \"expectation_ids\": [\n        \"M-storage-contract\",\n        \"M-log-contract\"\n      ],\n      \"binding_ids\": [\n        \"K-sync-log\"\n      ],\n      \"derivation\": \"Three fresh public OmniPaxos nodes use the actual MemoryStorage. try_become_leader performs real preparation. A FIFO queue drains genuine target messages. Append 11 reaches decision everywhere; an all-message transport partition isolates node 3 while nodes 1 and 2 decide 22. Restoring the link precedes node3.reconnected(1), matching M-api and the disconnect/reconnect pattern in M-sync-test. No protocol message is constructed or rewritten. The actual Promise witnesses receiver boundaries; actual AcceptSync must carry Delta and matching promised ballot. The handler return and emitted Accepted acknowledge completion; synchronous public reads then observe the live receiver under exclusive ownership.\",\n      \"applicability\": \"Single-threaded explicit network scheduler; no wall-clock waits or concurrent mutations. No tick is required between these finite synchronous calls; the check does not assert eventual progress or a time deadline. Snapshot payload is an ordered content vector matching the repository ValueSnapshot concatenation semantics.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Full prefix comparison intentionally differs from the repository latest-value-only equality; this strengthens observation without changing the underlying content-preservation requirement.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-prefix-monitor\",\n      \"checker_id\": \"P-prefix-content\",\n      \"event\": \"sync_result\",\n      \"binding_ids\": [\n        \"K-sync-log\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"M-cache\",\n          \"M-api\",\n          \"M-follower\",\n          \"M-sync\"\n        ],\n        \"expectation_ids\": [\n          \"M-log-contract\",\n          \"M-snapshot-contract\",\n          \"M-storage-contract\",\n          \"M-value-snapshot\"\n        ],\n        \"binding_ids\": [\n          \"K-sync-log\"\n        ],\n        \"derivation\": \"prefix_ready records actual leader decided content after a majority and receiver old state are checked. sync_admitted is emitted before delivering the authentic matching-ballot Delta. sync_result reads the same receiver after the handler and its actual Accepted response. Compare all expanded snapshot/log values against the measured leader prefix, not snapshot length or last value.\",\n        \"applicability\": \"Identity case/receiver/sync_id is independent of content and stable through recovery. Completed means the target emitted matching-ballot Accepted at the requested boundary and remains in Accept; absence of that result cannot establish holds.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"sync\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"P-prefix-content\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"actual_content\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"sync.expected_content\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"case\",\n        \"receiver\",\n        \"sync_id\"\n      ],\n      \"description\": \"After acknowledged Delta recovery, full ordered decided contents equal the independently established decided leader prefix.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"One concrete receiver-lag case; no universal coverage of leader-side synchronization, already accepted suffix overlap, or compacted receiver variants.\",\n    \"Compilation and fixed execution are pending.\"\n  ]\n}","exit_code":0,"status":"completed"}}
