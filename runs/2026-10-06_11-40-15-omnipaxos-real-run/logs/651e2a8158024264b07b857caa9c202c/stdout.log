g\", \"type\": \"object\"}\nHarness {\"additionalProperties\": false, \"properties\": {\"execution_package\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Optional single local Go package or Rust crate directory; the controller fixes the effective package at acceptance\", \"title\": \"Execution Package\"}, \"files\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Additional generated files with relative destinations and fixed source text\", \"title\": \"Files\", \"type\": \"object\"}, \"kind\": {\"description\": \"Harness kind advertised by the configured execution backend\", \"title\": \"Kind\", \"type\": \"string\"}, \"source\": {\"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\", \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}, \"semantic_changes\": {\"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\", \"items\": {\"type\": \"string\"}, \"title\": \"Semantic Changes\", \"type\": \"array\"}, \"prerequisites\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/EventRequirement\"}, \"title\": \"Prerequisites\", \"type\": \"array\"}, \"legality\": {\"$ref\": \"#/$defs/Grounding\", \"default\": {\"source_ids\": [], \"expectation_ids\": [], \"binding_ids\": [], \"derivation\": \"\", \"applicability\": \"\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}}}, \"required\": [\"kind\", \"source\", \"description\", \"semantic_changes\"], \"title\": \"Harness\", \"type\": \"object\"}\nObservableProperty {\"additionalProperties\": false, \"properties\": {\"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"kind\": {\"default\": \"event_assertion\", \"enum\": [\"event_assertion\", \"event_implication\"], \"title\": \"Kind\", \"type\": \"string\"}, \"trigger\": {\"$ref\": \"#/$defs/Comparison\"}, \"assertion\": {\"$ref\": \"#/$defs/Comparison\"}, \"antecedent\": {\"anyOf\": [{\"$ref\": \"#/$defs/Comparison\"}, {\"type\": \"null\"}], \"default\": null}, \"identity_fields\": {\"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}, \"required\": [\"checker_id\", \"trigger\", \"assertion\", \"description\"], \"title\": \"ObservableProperty\", \"type\": \"object\"}\nScope {\"additionalProperties\": false, \"properties\": {\"description\": {\"title\": \"Description\", \"type\": \"string\"}, \"assumptions\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Assumptions\", \"type\": \"array\"}, \"excluded\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Excluded\", \"type\": \"array\"}, \"parameters\": {\"additionalProperties\": true, \"default\": {}, \"title\": \"Parameters\", \"type\": \"object\"}}, \"required\": [\"description\"], \"title\": \"Scope\", \"type\": \"object\"}\nGrounding {\"additionalProperties\": false, \"properties\": {\"source_ids\": {\"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\", \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"expectation_ids\": {\"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\", \"items\": {\"type\": \"string\"}, \"title\": \"Expectation Ids\", \"type\": \"array\"}, \"binding_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"derivation\": {\"default\": \"\", \"description\": \"This component\\u2019s sourced reasoning; cite accepted IDs instead of repeating their full argument\", \"title\": \"Derivation\", \"type\": \"string\"}, \"applicability\": {\"default\": \"\", \"description\": \"Conditions for this component, including any added assumptions or omitted protections\", \"title\": \"Applicability\", \"type\": \"string\"}, \"unresolved\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unresolved\", \"type\": \"array\"}, \"conflicts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Conflicts\", \"type\": \"array\"}, \"alternatives\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Alternatives\", \"type\": \"array\"}}, \"title\": \"Grounding\", \"type\": \"object\"}\nCodeAnchor {\"additionalProperties\": false, \"properties\": {\"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"boundary_complete\": {\"anyOf\": [{\"type\": \"boolean\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Boundary Complete\"}, \"kind\": {\"default\": \"declaration\", \"enum\": [\"declaration\", \"interface_member\", \"callsite\"], \"title\": \"Kind\", \"type\": \"string\"}, \"material_id\": {\"title\": \"Material Id\", \"type\": \"string\"}, \"start_line\": {\"minimum\": 1, \"title\": \"Start Line\", \"type\": \"integer\"}, \"end_line\": {\"minimum\": 1, \"title\": \"End Line\", \"type\": \"integer\"}, \"symbol\": {\"title\": \"Symbol\", \"type\": \"string\"}}, \"required\": [\"material_id\", \"start_line\", \"end_line\", \"symbol\"], \"title\": \"CodeAnchor\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
