package raft

import (
	"io"

	hclog "github.com/hashicorp/go-hclog"
	"sync"
	"testing"
	"time"
)

// termHookStore delays one chosen currentTerm write to model a slow store write
// that completes after a newer term has already been persisted by another goroutine.
type termHookStore struct {
	*InmemStore
	mu     sync.Mutex
	block  uint64
	before func(uint64)
	writes []uint64
}

func newTermHookStore() *termHookStore { return &termHookStore{InmemStore: NewInmemStore()} }

func (h *termHookStore) SetUint64(key []byte, val uint64) error {
	if string(key) == string(keyCurrentTerm) {
		h.mu.Lock()
		hook := h.before
		block := h.block
		h.mu.Unlock()
		if hook != nil && val == block {
			hook(val)
		}
		h.mu.Lock()
		h.writes = append(h.writes, val)
		h.mu.Unlock()
	}
	return h.InmemStore.SetUint64(key, val)
}

func (h *termHookStore) termWrites() []uint64 {
	h.mu.Lock()
	defer h.mu.Unlock()
	return append([]uint64(nil), h.writes...)
}

type recordFSM struct {
	mu      sync.Mutex
	applied map[uint64]string
}

func newRecordFSM() *recordFSM { return &recordFSM{applied: map[uint64]string{}} }

func (f *recordFSM) Apply(l *Log) interface{} {
	f.mu.Lock()
	f.applied[l.Index] = string(l.Data)
	f.mu.Unlock()
	return nil
}

func (f *recordFSM) Snapshot() (FSMSnapshot, error) { return &assuranceSnapshot{}, nil }
func (f *recordFSM) Restore(io.ReadCloser) error    { return nil }

func (f *recordFSM) at(i uint64) (string, bool) {
	f.mu.Lock()
	defer f.mu.Unlock()
	v, ok := f.applied[i]
	return v, ok
}

func TestProbeHeartbeatTermRegression(t *testing.T) {
	store := newTermHookStore()
	fsm := newRecordFSM()
	snaps := NewInmemSnapshotStore()
	addr, trans := NewInmemTransport("F")
	trans.Connect(addr, trans) // self-directed RPCs still travel the real consumer queue

	conf := DefaultConfig()
	conf.LocalID = "F"
	conf.Logger = hclog.NewNullLogger()
	conf.ElectionTimeout = 30 * time.Second
	conf.HeartbeatTimeout = 30 * time.Second
	conf.LeaderLeaseTimeout = 30 * time.Second
	conf.CommitTimeout = time.Second

	cfg := Configuration{Servers: []Server{
		{Suffrage: Voter, ID: "F", Address: addr},
		{Suffrage: Voter, ID: "A", Address: "A"},
		{Suffrage: Voter, ID: "B", Address: "B"},
	}}
	if err := BootstrapCluster(conf, store, store, snaps, trans, cfg); err != nil {
		t.Fatalf("bootstrap: %v", err)
	}
	r, err := NewRaft(conf, fsm, store, store, snaps, trans)
	if err != nil {
		t.Fatalf("new raft: %v", err)
	}
	defer func() { _ = r.Shutdown().Error() }()

	send := func(req *AppendEntriesRequest) *AppendEntriesResponse {
		resp := &AppendEntriesResponse{}
		if err := trans.AppendEntries("A", addr, req, resp); err != nil {
			t.Fatalf("appendEntries rpc: %v", err)
		}
		return resp
	}
	leader := trans.EncodePeer("A", "A")

	// Baseline history: index 1 is the bootstrap configuration; commit 2 and 3 at term 2.
	if resp := send(&AppendEntriesRequest{RPCHeader: r.getRPCHeader(), Term: 2, Leader: leader,
		PrevLogEntry: 1, PrevLogTerm: 1, LeaderCommitIndex: 3,
		Entries: []*Log{{Index: 2, Term: 2, Type: LogCommand, Data: []byte("new2")}, {Index: 3, Term: 2, Type: LogCommand, Data: []byte("new3")}}}); !resp.Success {
		t.Fatalf("baseline append rejected")
	}
	time.Sleep(100 * time.Millisecond)

	// The stale leader's heartbeat carries term 3; hold its term write.
	blocked := make(chan struct{})
	release := make(chan struct{})
	var once sync.Once
	store.mu.Lock()
	store.block = 3
	store.before = func(uint64) {
		once.Do(func() { close(blocked) })
		<-release
	}
	store.mu.Unlock()

	hbDone := make(chan struct{})
	go func() {
		defer close(hbDone)
		rpc := RPC{Command: &AppendEntriesRequest{RPCHeader: r.getRPCHeader(), Term: 3, Leader: leader},
			RespChan: make(chan RPCResponse, 1)}
		r.processHeartbeat(rpc)
	}()
	select {
	case <-blocked:
	case <-time.After(5 * time.Second):
		t.Fatalf("heartbeat never reached its term write")
	}

	// Main thread adopts term 4 and applies index 4 from that leader.
	if resp := send(&AppendEntriesRequest{RPCHeader: r.getRPCHeader(), Term: 4, Leader: leader,
		PrevLogEntry: 3, PrevLogTerm: 2, LeaderCommitIndex: 4,
		Entries: []*Log{{Index: 4, Term: 4, Type: LogCommand, Data: []byte("new4")}}}); !resp.Success {
		t.Fatalf("term 4 append rejected: %+v", resp)
	}
	time.Sleep(100 * time.Millisecond)
	termAfterNewer := r.CurrentTerm()

	close(release)
	select {
	case <-hbDone:
	case <-time.After(5 * time.Second):
		t.Fatalf("heartbeat did not finish")
	}
	time.Sleep(100 * time.Millisecond)
	termAfterStale := r.CurrentTerm()
	persisted, _ := store.GetUint64(keyCurrentTerm)
	t.Logf("terms: after_newer=%d after_stale=%d persisted=%d writes=%v", termAfterNewer, termAfterStale, persisted, store.termWrites())

	// The stale term-3 leader now asserts its own history at index 4 and 5.
	ok := send(&AppendEntriesRequest{RPCHeader: r.getRPCHeader(), Term: 3, Leader: leader,
		PrevLogEntry: 3, PrevLogTerm: 2, LeaderCommitIndex: 5,
		Entries: []*Log{{Index: 4, Term: 3, Type: LogCommand, Data: []byte("stale4")}, {Index: 5, Term: 3, Type: LogCommand, Data: []byte("stale5")}}}).Success
	time.Sleep(200 * time.Millisecond)

	var l4, l5 Log
	e4 := r.logs.GetLog(4, &l4)
	e5 := r.logs.GetLog(5, &l5)
	v4, _ := fsm.at(4)
	v5, _ := fsm.at(5)
	t.Logf("stale_accepted=%v log4=%q(%v) log5=%q(%v) fsm4=%q fsm5=%q commit=%d applied=%d",
		ok, l4.Data, e4, l5.Data, e5, v4, v5, r.CommitIndex(), r.AppliedIndex())
}
