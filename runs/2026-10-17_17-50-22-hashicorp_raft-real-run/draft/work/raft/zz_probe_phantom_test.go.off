package raft

import (
	"io"
	"sync"
	"testing"
	"time"
)

type failStore struct {
	*InmemStore
	mu       sync.Mutex
	failNext bool
}

func newFailStore() *failStore { return &failStore{InmemStore: NewInmemStore()} }

func (f *failStore) StoreLogs(logs []*Log) error {
	f.mu.Lock()
	fail := f.failNext
	f.failNext = false
	f.mu.Unlock()
	if fail {
		return errInjected
	}
	return f.InmemStore.StoreLogs(logs)
}

type errType string

func (e errType) Error() string { return string(e) }

const errInjected = errType("injected store failure")

type phFSM struct{}

func (f *phFSM) Apply(*Log) interface{}         { return nil }
func (f *phFSM) Snapshot() (FSMSnapshot, error) { return &phSnap{}, nil }
func (f *phFSM) Restore(io.ReadCloser) error    { return nil }

type phSnap struct{}

func (s *phSnap) Persist(SnapshotSink) error { return nil }
func (s *phSnap) Release()                   {}

func TestProbePhantomConfig(t *testing.T) {
	conf := inmemConfig(t)
	conf.HeartbeatTimeout = 300 * time.Millisecond
	conf.ElectionTimeout = 300 * time.Millisecond
	conf.LeaderLeaseTimeout = 300 * time.Millisecond

	addrA, transA := NewInmemTransport("A")
	addrB, transB := NewInmemTransport("B")
	transA.Connect(addrB, transB)
	transB.Connect(addrA, transA)

	storeA, storeB := newFailStore(), newFailStore()
	snapsA, snapsB := NewInmemSnapshotStore(), NewInmemSnapshotStore()
	cfg := Configuration{Servers: []Server{
		{Suffrage: Voter, ID: "A", Address: addrA},
		{Suffrage: Voter, ID: "B", Address: addrB},
	}}
	confA := *conf
	confA.LocalID = "A"
	confB := *conf
	confB.LocalID = "B"
	if err := BootstrapCluster(&confA, storeA, storeA, snapsA, transA, cfg); err != nil {
		t.Fatalf("bootstrap A: %v", err)
	}
	if err := BootstrapCluster(&confB, storeB, storeB, snapsB, transB, cfg); err != nil {
		t.Fatalf("bootstrap B: %v", err)
	}
	rA, err := NewRaft(&confA, &phFSM{}, storeA, storeA, snapsA, transA)
	if err != nil {
		t.Fatalf("raft A: %v", err)
	}
	defer func() { _ = rA.Shutdown().Error() }()
	rB, err := NewRaft(&confB, &phFSM{}, storeB, storeB, snapsB, transB)
	if err != nil {
		t.Fatalf("raft B: %v", err)
	}
	defer func() { _ = rB.Shutdown().Error() }()

	deadline := time.Now().Add(10 * time.Second)
	for rA.Leader() == "" && time.Now().Before(deadline) {
		time.Sleep(10 * time.Millisecond)
	}
	rL, rP := rA, rB
	stL, stP := storeA, storeB
	peerID := ServerID("B")
	if rA.Leader() == "B" {
		rL, rP = rB, rA
		stL, stP = storeB, storeA
		peerID = "A"
	}
	_ = rP
	t.Logf("leader=%v follower-to-remove=%v", rL.Leader(), peerID)

	stL.mu.Lock()
	stL.failNext = true
	stL.mu.Unlock()
	errRemove := rL.RemoveServer(peerID, 0, 5*time.Second).Error()
	lastLogL, _ := stL.LastIndex()
	latestCfg := rL.getLatestConfiguration()
	t.Logf("remove err=%v stateL=%v latestIndex=%d latestServers=%v lastLogL=%d",
		errRemove, rL.State(), rL.configurations.latestIndex, latestCfg.Servers, lastLogL)

	deadline = time.Now().Add(10 * time.Second)
	for rL.State() != Leader && time.Now().Before(deadline) {
		time.Sleep(10 * time.Millisecond)
	}
	stateL := rL.State()
	applyErr := rL.Apply([]byte("phantom"), 3*time.Second).Error()
	commitL := rL.CommitIndex()
	lastL, _ := stL.LastIndex()
	lastP, _ := stP.LastIndex()
	t.Logf("stateL=%v applyErr=%v commitL=%d lastL=%d lastPeer=%d", stateL, applyErr, commitL, lastL, lastP)
}
