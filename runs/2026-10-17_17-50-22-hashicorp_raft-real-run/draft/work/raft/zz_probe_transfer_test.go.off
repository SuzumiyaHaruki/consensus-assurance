package raft

import (
	"testing"
	"time"
)

func TestProbeTransferToNonvoter(t *testing.T) {
	conf := inmemConfig(t)
	c := MakeClusterCustom(t, &MakeClusterOpts{
		Peers:     4,
		Bootstrap: true,
		Conf:      conf,
	})
	defer c.Close()

	leader := c.Leader()
	if leader == nil {
		t.Fatal("no leader")
	}
	// Pick a non-leader peer and demote it to non-voter.
	var target *Raft
	var targetID ServerID
	for _, r := range c.rafts {
		if r != leader {
			target = r
			targetID = r.localID
			break
		}
	}
	if err := leader.DemoteVoter(targetID, 0, 5*time.Second).Error(); err != nil {
		t.Fatalf("demote: %v", err)
	}
	time.Sleep(200 * time.Millisecond)

	start := time.Now()
	fut := leader.LeadershipTransferToServer(targetID, target.localAddr)
	err := fut.Error()
	t.Logf("transfer future err=%v after %v", err, time.Since(start))

	// Watch leadership for a bounded window.
	var sawNoLeader time.Duration
	deadline := time.Now().Add(4 * time.Second)
	for time.Now().Before(deadline) {
		l := c.Leader()
		if l == nil {
			sawNoLeader += 20 * time.Millisecond
		}
		time.Sleep(20 * time.Millisecond)
	}
	final := c.Leader()
	finalID := ServerID("")
	if final != nil {
		finalID = final.localID
	}
	t.Logf("target=%v demoted; leader_after=%v no_leader_total=%v target_state=%v target_term=%d",
		targetID, finalID, sawNoLeader, target.State(), target.CurrentTerm())
}
