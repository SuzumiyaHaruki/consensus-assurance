{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run && python3 -m json.tool fixed-experiments/b5bd70f5750b4b45af3e925bd1748aaf-experiment/basis.json | head -120'","aggregated_output":"{\n    \"id\": \"b5bd70f5750b4b45af3e925bd1748aaf-experiment\",\n    \"investigation_id\": \"6491640ed49a4c7b8f5150438d350e36-question-0\",\n    \"version\": 4,\n    \"basis\": {\n        \"harness\": {\n            \"kind\": \"go_test\",\n            \"source\": \"package raft\\n\\n// Construction notes:\\n//   * Two real members are bootstrapped as voters {A, B} over in-memory\\n//     transports; the leading member's log store fails exactly the write that\\n//     would carry the configuration entry removing the other member.\\n//   * The harness then records whether the failed change left an in-memory\\n//     configuration ahead of the stored log, and whether the leader can later\\n//     commit a client command without the other member having it.\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\t\\\"sync\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\nfunc phEmit(t *testing.T, payload map[string]interface{}) {\\n\\tt.Helper()\\n\\tdata, err := json.Marshal(payload)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"marshal event: %v\\\", err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(data))\\n}\\n\\ntype failStore struct {\\n\\t*InmemStore\\n\\tmu       sync.Mutex\\n\\tfailNext bool\\n}\\n\\nfunc newFailStore() *failStore { return &failStore{InmemStore: NewInmemStore()} }\\n\\nfunc (f *failStore) StoreLogs(logs []*Log) error {\\n\\tf.mu.Lock()\\n\\tfail := f.failNext\\n\\tf.failNext = false\\n\\tf.mu.Unlock()\\n\\tif fail {\\n\\t\\treturn errInjected\\n\\t}\\n\\treturn f.InmemStore.StoreLogs(logs)\\n}\\n\\ntype errType string\\n\\nfunc (e errType) Error() string { return string(e) }\\n\\nconst errInjected = errType(\\\"injected store failure\\\")\\n\\ntype phFSM struct{}\\n\\nfunc (f *phFSM) Apply(*Log) interface{}         { return nil }\\nfunc (f *phFSM) Snapshot() (FSMSnapshot, error) { return &phSnap{}, nil }\\nfunc (f *phFSM) Restore(io.ReadCloser) error    { return nil }\\n\\ntype phSnap struct{}\\n\\nfunc (s *phSnap) Persist(SnapshotSink) error { return nil }\\nfunc (s *phSnap) Release()                   {}\\n\\nfunc phantomRun(t *testing.T, caseName string, grow bool) {\\n\\tconf := inmemConfig(t)\\n\\tconf.HeartbeatTimeout = 300 * time.Millisecond\\n\\tconf.ElectionTimeout = 300 * time.Millisecond\\n\\tconf.LeaderLeaseTimeout = 300 * time.Millisecond\\n\\n\\taddrA, transA := NewInmemTransport(\\\"A\\\")\\n\\taddrB, transB := NewInmemTransport(\\\"B\\\")\\n\\ttransA.Connect(addrB, transB)\\n\\ttransB.Connect(addrA, transA)\\n\\n\\tstoreA, storeB := newFailStore(), newFailStore()\\n\\tsnapsA, snapsB := NewInmemSnapshotStore(), NewInmemSnapshotStore()\\n\\tcfg := Configuration{Servers: []Server{\\n\\t\\t{Suffrage: Voter, ID: \\\"A\\\", Address: addrA},\\n\\t\\t{Suffrage: Voter, ID: \\\"B\\\", Address: addrB},\\n\\t}}\\n\\tconfA := *conf\\n\\tconfA.LocalID = \\\"A\\\"\\n\\tconfB := *conf\\n\\tconfB.LocalID = \\\"B\\\"\\n\\tif err := BootstrapCluster(&confA, storeA, storeA, snapsA, transA, cfg); err != nil {\\n\\t\\tt.Fatalf(\\\"bootstrap A: %v\\\", err)\\n\\t}\\n\\tif err := BootstrapCluster(&confB, storeB, storeB, snapsB, transB, cfg); err != nil {\\n\\t\\tt.Fatalf(\\\"bootstrap B: %v\\\", err)\\n\\t}\\n\\trA, err := NewRaft(&confA, &phFSM{}, storeA, storeA, snapsA, transA)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"raft A: %v\\\", err)\\n\\t}\\n\\tdefer func() { _ = rA.Shutdown().Error() }()\\n\\trB, err := NewRaft(&confB, &phFSM{}, storeB, storeB, snapsB, transB)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"raft B: %v\\\", err)\\n\\t}\\n\\tdefer func() { _ = rB.Shutdown().Error() }()\\n\\n\\tdeadline := time.Now().Add(10 * time.Second)\\n\\tfor rA.Leader() == \\\"\\\" && time.Now().Before(deadline) {\\n\\t\\ttime.Sleep(10 * time.Millisecond)\\n\\t}\\n\\trL, rP := rA, rB\\n\\tstL, stP := storeA, storeB\\n\\tpeerID := ServerID(\\\"B\\\")\\n\\tif rA.Leader() == \\\"B\\\" {\\n\\t\\trL, rP = rB, rA\\n\\t\\tstL, stP = storeB, storeA\\n\\t\\tpeerID = \\\"A\\\"\\n\\t}\\n\\t_ = rP\\n\\tt.Logf(\\\"leader=%v follower-to-remove=%v\\\", rL.Leader(), peerID)\\n\\n\\tstL.mu.Lock()\\n\\tstL.failNext = true\\n\\tstL.mu.Unlock()\\n\\tvar errRemove error\\n\\tif grow {\\n\\t\\terrRemove = rL.AddVoter(\\\"C\\\", \\\"C\\\", 0, 5*time.Second).Error()\\n\\t} else {\\n\\t\\terrRemove = rL.RemoveServer(peerID, 0, 5*time.Second).Error()\\n\\t}\\n\\tlastLogL, _ := stL.LastIndex()\\n\\tlatestCfg := rL.getLatestConfiguration()\\n\\tt.Logf(\\\"remove err=%v stateL=%v latestIndex=%d latestServers=%v lastLogL=%d\\\",\\n\\t\\terrRemove, rL.State(), rL.configurations.latestIndex, latestCfg.Servers, lastLogL)\\n\\n\\tdeadline = time.Now().Add(10 * time.Second)\\n\\tfor rL.State() != Leader && time.Now().Before(deadline) {\\n\\t\\ttime.Sleep(10 * time.Millisecond)\\n\\t}\\n\\tstateL := rL.State()\\n\\treElected := stateL == Leader\\n\\tapplyErr := rL.Apply([]byte(\\\"phantom\\\"), 3*time.Second).Error()\\n\\tcommitL := rL.CommitIndex()\\n\\tlastL, _ := stL.LastIndex()\\n\\tlastP, _ := stP.LastIndex()\\n\\tphantomServers := fmt.Sprintf(\\\"%v\\\", latestCfg.Servers)\\n\\tlatestIndex := rL.configurations.latestIndex\\n\\tphEmit(t, map[string]interface{}{\\n\\t\\t\\\"event\\\":                    \\\"phantom_case_\\\" + caseName,\\n\\t\\t\\\"case\\\":                     caseName,\\n\\t\\t\\\"members\\\":                  2,\\n\\t\\t\\\"failure_injected\\\":         true,\\n\\t\\t\\\"removed_peer\\\":             string(peerID),\\n\\t\\t\\\"latest_index_after_fail\\\":  latestIndex,\\n\\t\\t\\\"last_log_index_after_fail\\\": lastLogL,\\n\\t\\t\\\"phantom_servers\\\":          phantomServers,\\n\\t})\\n\\tphEmit(t, map[string]interface{}{\\n\\t\\t\\\"event\\\":                     \\\"phantom_result_\\\" + caseName,\\n\\t\\t\\\"case\\\":                      caseName,\\n\\t\\t\\\"remove_error\\\":              fmt.Sprintf(\\\"%v\\\", errRemove),\\n\\t\\t\\\"remove_failed\\\":             errRemove != nil,\\n\\t\\t\\\"latest_index_exceeds_log\\\":  latestIndex > lastLogL,\\n\\t\\t\\\"re_elected\\\":                reElected,\\n\\t\\t\\\"apply_ok\\\":                  applyErr == nil,\\n\\t\\t\\\"commit_index\\\":              commitL,\\n\\t\\t\\\"leader_last_index\\\":         lastL,\\n\\t\\t\\\"peer_last_index\\\":           lastP,\\n\\t\\t\\\"commit_without_peer\\\":       applyErr == nil && lastP < commitL,\\n\\t})\\n\\tt.Logf(\\\"stateL=%v applyErr=%v commitL=%d lastL=%d lastPeer=%d\\\", stateL, applyErr, commitL, lastL, lastP)\\n\\n\\t// Restart the phantom leader from its own stores and see whether the lone\\n\\t// commit is retained and whether the peer catches up under the log-derived\\n\\t// configuration.\\n\\tconfRestart := rL.config()\\n\\tconfRestart.Logger = nil\\n\\trestartAddr := rL.localAddr\\n\\tlogsRestart, stableRestart, snapsRestart := stL, stL, rL.snapshots\\n\\t_ = rL.Shutdown()\\n\\t_, transRestart := NewInmemTransport(restartAddr)\\n\\t// Wire the restarted node back to the surviving peer: the peer's routing\\n\\t// table still points at the previous transport object.\\n\\ttransRestart.Connect(rP.localAddr, rP.trans.(*InmemTransport))\\n\\trP.trans.(*InmemTransport).Disconnect(restartAddr)\\n\\trP.trans.(*InmemTransport).Connect(restartAddr, transRestart)\\n\\trestarted, rerr := NewRaft(&confRestart, &phFSM{}, logsRestart, stableRestart, snapsRestart, transRestart)\\n\\trestartOK := rerr == nil\\n\\tbecameLeader := false\\n\\tif restartOK {\\n\\t\\tdefer func() { _ = restarted.Shutdown().Error() }()\\n\\t\\tdl := time.Now().Add(10 * time.Second)\\n\\t\\tfor time.Now().Before(dl) {\\n\\t\\t\\tif restarted.State() == Leader {\\n\\t\\t\\t\\tbecameLeader = true\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t\\ttime.Sleep(20 * time.Millisecond)\\n\\t\\t}\\n\\t}\\n\\tlastPeerAfter, _ := stP.LastIndex()\\n\\tlastLAfter, _ := stL.LastIndex()\\n\\tphEmit(t, map[string]interface{}{\\n\\t\\t\\\"event\\\":                 \\\"phantom_restart_\\\" + caseName,\\n\\t\\t\\\"case\\\":                  caseName,\\n\\t\\t\\\"restart_ok\\\":            restartOK,\\n\\t\\t\\\"restarted_as_leader\\\":   becameLeader,\\n\\t\\t\\\"leader_last_index\\\":     lastLAfter,\\n\\t\\t\\\"peer_last_index\\\":       lastPeerAfter,\\n\\t\\t\\\"peer_caught_up\\\":        lastPeerAfter >= commitL,\\n\\t\\t\\\"lone_commit_retained\\\":  lastLAfter >= commitL,\\n\\t})\\n}\\n\\nfunc TestAssurancePhantomConfiguration(t *testing.T) {\\n\\tt.Run(\\\"shrink_failed_write\\\", func(t *testing.T) { phantomRun(t, \\\"shrink_failed_write\\\", false) })\\n\\tt.Run(\\\"grow_failed_write\\\", func(t *testing.T) { phantomRun(t, \\\"grow_failed_write\\\", true) })\\n}\\n\",\n            \"files\": {},\n            \"execution_package\": \".\",\n            \"test_names\": [\n                \"TestAssurancePhantomConfiguration\"\n            ],\n            \"description\": \"\",\n            \"semantic_changes\": [\n                \"The harness runs two cases: a failed RemoveServer that shrinks the voter set, and a failed AddVoter that grows it.\",\n                \"Event names and the case field are suffixed per case, and two additional comparisons cover the grow-direction control.\"\n            ],\n            \"prerequisites\": [\n                {\n                    \"alias\": \"admit_shrink\",\n                    \"event\": \"phantom_case_shrink_failed_write\",\n                    \"conditions\": [\n                        {\n                            \"field\": \"case\",\n                            \"op\": \"eq\",\n                            \"value\": \"shrink_failed_write\",\n                            \"reference\": null\n                        },\n                        {\n                            \"field\": \"failure_injected\",\n                            \"op\": \"eq\",\n                            \"value\": true,\n                            \"reference\": null\n                        }\n                    ]\n                },\n                {\n                    \"alias\": \"admit_grow\",\n                    \"event\": \"phantom_case_grow_failed_write\",\n                    \"conditions\": [\n                        {\n                            \"field\": \"case\",\n                            \"op\": \"eq\",\n                            \"value\": \"grow_failed_write\",\n                            \"reference\": null\n                        },\n                        {\n                            \"field\": \"failure_injected\",\n                            \"op\": \"eq\",\n                            \"value\": true,\n                            \"reference\": null\n                        }\n                    ]\n                }\n            ]\n        },\n        \"source_ids\": [\n            \"raft_append_config\",\n            \"raft_dispatch_logs\",\n            \"raft_setup_leader_state\",\n            \"raft_quorum_size2\",\n            \"raft_elect_self\",\n            \"api_remove_server\",\n            \"cfg_next_configuration\"\n        ],\n        \"anchors\": [],\n        \"scope\": {\n            \"description\": \"One two-voter cluster of real nodes over in-memory transports. The leading member's log store fails exactly the write carrying the configuration entry that would remove the other voter. The harness records the configuration index the leader holds afterwards against its last stored log index, then waits for the node to lead again and applies one client command, comparing the resulting commit index with the other voter's last log index. The successor additionally restarts the phantom leader from its own stores after the lone commit and records restart success, whether it regains leadership, whether the commit remains in its log, and whether the peer's log has reached that index. In this revision the restarted node's transport is wired to the surviving peer in both directions before the election window, so the restart outcome reflects the target. The successor runs the scenario twice: a failed RemoveServer that leaves a shrunken phantom configuration containing only the leader, and a failed AddVoter that leaves a grown phantom configuration naming an unreachable member.\",\n            \"assumptions\": [\n                \"Both members run the captured code with 300 ms heartbeat, election and lease timeouts and share no state.\",\n                \"The injected failure is a single StoreLogs call returning an error; the store is otherwise the standard in-memory store and accepts later writes.\",\n                \"The harness does not assert which of the two members becomes leader first; it targets whichever one leads when the failure is injected.\",\n                \"A command is treated as committed when its Apply future returns nil, which is the client-visible completion point.\"\n            ],\n            \"excluded\": [\n                \"No restart of the failed node, so the log-derived configuration that would replace the phantom one is not exercised.\",\n                \"No snapshot, no third member and no concurrent client traffic.\"\n            ],\n            \"parameters\": {\n                \"members\": 2,\n                \"voters\": 2,\n                \"injected_failures\": 1,\n                \"timeouts_ms\": 300\n            }\n        },\n        \"prefix\": \"The harness creates two in-memory transports connected to each other, bootstraps the same two-voter configuration on both stores, and starts both rafts with 300 ms timeouts. It waits for a leader, arms that leader's log store to fail the next StoreLogs call, and calls RemoveServer for the other member. It records the returned error, the node's state, the in-memory latest configuration index and servers, and the last stored log index, then waits up to ten seconds for the node to be Leader again, applies one command with a three-second timeout, and emits the commit index, the leader's last log index and the other voter's last log index. The successor then shuts the phantom leader down, creates a fresh in-memory transport on the same address, calls NewRaft with the retained stores and its own config, waits up to ten seconds for Leader state, and emits phantom_restart with restart_ok, restarted_as_leader, leader_last_index, peer_last_index, lone_commit_retained and peer_caught_up. Before starting the restarted node, the harness connects the new transport to the peer's transport and repoints the peer's routing entry for the restarted address, so an election and replication can actually take place. Each case emits its own phantom_case_<case>, phantom_result_<case> and phantom_restart_<case> events; the grow case calls AddVoter('C') instead of RemoveServer.\",\n        \"requirement\": null,\n        \"responsibility\": \"The library owns both the durability of a configuration change and the supporter set used for elections and commitment. A configuration entry that was never stored cannot be the configuration under which the node counts votes or commits entries; reporting the change as failed while adopting it for quorums leaves the caller and the cluster with incompatible views of who must agree.\",\n        \"comparisons\": [\n            {\n                \"event\": \"phantom_result_shrink_failed_write\",\n                \"identity_fields\": [\n                    \"case\"\n                ],\n                \"admission_alias\": \"admit_shrink\",\n                \"assertion\": {\n                    \"field\": \"remove_failed\",\n                    \"op\": \"eq\",\n                    \"value\": true,\n                    \"reference\": null\n                },\n                \"antecedent\": null,\n                \"applicability_conditions\": [],\n                \"description\": \"The failed configuration write must be reported as a failure in the shrink case.\"\n            },\n            {\n                \"event\": \"phantom_result_shrink_failed_write\",\n                \"identity_fields\": [\n                    \"case\"\n                ],\n                \"admission_alias\": \"admit_shrink\",\n                \"assertion\": {\n                    \"field\": \"latest_index_exceeds_log\",\n                    \"op\": \"eq\",\n                    \"value\": false,\n                    \"reference\": null\n                },\n                \"antecedent\": null,\n                \"applicability_conditions\": [],\n","exit_code":0,"status":"completed"}}
