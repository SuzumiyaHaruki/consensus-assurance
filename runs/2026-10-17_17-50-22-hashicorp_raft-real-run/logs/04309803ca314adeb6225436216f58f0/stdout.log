{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/draft && sed -n '1,90p' exp_transfer_nonvoter_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/draft && sed -n '1,90p' exp_transfer_nonvoter_test.go\"","aggregated_output":"package raft\n\n// Construction notes:\n//   * A real in-memory cluster is bootstrapped with four voters, then one\n//     non-leader member is demoted with DemoteVoter so the configuration itself\n//     (not a hand-built state) makes the target a non-voter.\n//   * The transfer case calls LeadershipTransferToServer for that demoted\n//     member; the control case calls it for a voter in an otherwise identical\n//     cluster. Both record the future result, whether the named target ever\n//     reported Leader, the sampled interval without a leader, and terms.\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc xfEmit(t *testing.T, payload map[string]interface{}) {\n\tt.Helper()\n\tdata, err := json.Marshal(payload)\n\tif err != nil {\n\t\tt.Fatalf(\"marshal event: %v\", err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(data))\n}\n\ntype xfObservation struct {\n\tfutureOK           bool\n\tfutureErr          string\n\tfutureMillis       int\n\ttargetEverLeader   bool\n\tfinalLeaderIsTargt bool\n\tnoLeaderMillis     int\n\tsamples            int\n\ttargetTerm         uint64\n\tvoterTermMax       uint64\n\tcandidateSamples   int\n\tleaderlessSamples  int\n}\n\nfunc xfRunTransfer(t *testing.T, name string, demote bool) {\n\tt.Helper()\n\tconst sampleEvery = 10 * time.Millisecond\n\tconst watchWindow = 5 * time.Second\n\tconf := inmemConfig(t)\n\tc := MakeClusterCustom(t, &MakeClusterOpts{Peers: 4, Bootstrap: true, Conf: conf})\n\tdefer c.Close()\n\n\tleader := c.Leader()\n\tif leader == nil {\n\t\tt.Fatalf(\"no leader\")\n\t}\n\tvar target *Raft\n\tfor _, r := range c.rafts {\n\t\tif r != leader {\n\t\t\ttarget = r\n\t\t\tbreak\n\t\t}\n\t}\n\tif target == nil {\n\t\tt.Fatalf(\"no non-leader peer\")\n\t}\n\ttargetID := target.localID\n\ttermBefore := target.CurrentTerm()\n\troleOf := func() string {\n\t\tcfgFut := target.GetConfiguration()\n\t\tif err := cfgFut.Error(); err != nil {\n\t\t\treturn \"unknown\"\n\t\t}\n\t\tfor _, srv := range cfgFut.Configuration().Servers {\n\t\t\tif srv.ID == targetID {\n\t\t\t\tif srv.Suffrage == Voter {\n\t\t\t\t\treturn \"voter\"\n\t\t\t\t}\n\t\t\t\treturn \"nonvoter\"\n\t\t\t}\n\t\t}\n\t\treturn \"absent\"\n\t}\n\troleBefore := roleOf()\n\n\tconverged := false\n\tconvergeMS := 0\n\tif demote {\n\t\tif err := leader.DemoteVoter(targetID, 0, 5*time.Second).Error(); err != nil {\n\t\t\tt.Fatalf(\"demote: %v\", err)\n\t\t}\n\t\t// Wait until the demoted member's own configuration view shows the new\n\t\t// role, so the transfer is requested after the target could know it.\n","exit_code":0,"status":"completed"}}
