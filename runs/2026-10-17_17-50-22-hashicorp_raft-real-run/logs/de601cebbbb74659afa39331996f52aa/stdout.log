{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -c \\\"\nimport json\ns=json.load(open('state.json'))\nfor k in s['knowledge']:\n    if k['id'].startswith('281ef79e'):\n        print(json.dumps(k,indent=1))\n\\\"\"","aggregated_output":"{\n \"id\": \"281ef79e22bc49feaa12b33ce315e3b0-knowledge-0\",\n \"revision\": 1,\n \"kind\": \"behavior\",\n \"statement\": \"RecoverCluster refuses to run without existing state, restores the newest usable snapshot, then replays every log entry after the snapshot index, applying only LogCommand entries to the FSM and tracking the last index and term; it then writes a new snapshot carrying the caller-supplied configuration with configuration index 1 and deletes the entire log range. The recovered configuration is therefore the operator's parameter rather than anything derived from the log, and entries the node held without cluster-wide commitment become part of the recovered baseline.\",\n \"conditions\": \"Operator-invoked catastrophic recovery with existing log, stable or snapshot state.\",\n \"source_ids\": [\n  \"api_recover_cluster\",\n  \"api_recover_replay\",\n  \"api_recover_snapshot\"\n ],\n \"executions\": {},\n \"knowledge\": [],\n \"history\": [],\n \"operation_id\": \"281ef79e22bc49feaa12b33ce315e3b0\"\n}\n","exit_code":0,"status":"completed"}}
