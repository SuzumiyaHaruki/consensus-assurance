{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c 'cat exp_restore_midband_test.go'","aggregated_output":"package raft\n\n// Construction notes:\n//   * A real single-node cluster commits a first batch, takes a snapshot, then\n//     commits a second batch, and is shut down, so the restart replays only the\n//     tail after the snapshot.\n//   * The second batch is sized to leave a replay of about fifty FSM batches at\n//     the default MaxAppendEntries of 64, which sits between the four-batch real\n//     prefix that returned and the 130-batch real prefix that blocked.\n//   * The account currently has no real prefix in that middle range; the nine\n//     batch case is seeded, not produced by a cluster.\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"runtime\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\thclog \"github.com/hashicorp/go-hclog\"\n)\n\ntype mbFSM struct {\n\tmu      sync.Mutex\n\tapplied int\n}\n\nfunc (f *mbFSM) Apply(*Log) interface{} {\n\tf.mu.Lock()\n\tf.applied++\n\tf.mu.Unlock()\n\treturn nil\n}\n\nfunc (f *mbFSM) Snapshot() (FSMSnapshot, error) { return &mbSnapshot{}, nil }\n\nfunc (f *mbFSM) Restore(io.ReadCloser) error {\n\tf.mu.Lock()\n\tf.applied = 0\n\tf.mu.Unlock()\n\treturn nil\n}\n\ntype mbSnapshot struct{}\n\nfunc (s *mbSnapshot) Persist(SnapshotSink) error { return nil }\nfunc (s *mbSnapshot) Release()                  {}\n\nfunc mbEmit(t *testing.T, payload map[string]interface{}) {\n\tt.Helper()\n\tdata, err := json.Marshal(payload)\n\tif err != nil {\n\t\tt.Fatalf(\"marshal event: %v\", err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(data))\n}\n\nfunc mbConfig(id string) *Config {\n\tconf := DefaultConfig()\n\tconf.LocalID = ServerID(id)\n\tconf.Logger = hclog.NewNullLogger()\n\tconf.LogLevel = \"ERROR\"\n\tconf.HeartbeatTimeout = 50 * time.Millisecond\n\tconf.ElectionTimeout = 50 * time.Millisecond\n\tconf.LeaderLeaseTimeout = 50 * time.Millisecond\n\tconf.CommitTimeout = 5 * time.Millisecond\n\tconf.RestoreCommittedLogs = true\n\treturn conf\n}\n\nfunc mbBlocked() int {\n\tbuf := make([]byte, 1<<22)\n\tn := runtime.Stack(buf, true)\n\treturn strings.Count(string(buf[:n]), \"(*Raft).processLogs(\")\n}\n\nfunc TestAssuranceRestoreMidbandReplay(t *testing.T) {\n\tconst firstBatch = 200\n\tconst secondBatch = 3200\n\tconst window = 15 * time.Second\n\n\tstore := NewInmemCommitTrackingStore()\n\tsnaps := NewInmemSnapshotStore()\n\tconf := mbConfig(\"node1\")\n\t_, trans := NewInmemTransport(\"node1\")\n\tconfiguration := Configuration{Servers: []Server{{Suffrage: Voter, ID: \"node1\", Address: trans.LocalAddr()}}}\n\tif err := BootstrapCluster(conf, store, store, snaps, trans, configuration); err != nil {\n\t\tt.Fatalf(\"bootstrap: %v\", err)\n\t}\n\tr, err := NewRaft(conf, &mbFSM{}, store, store, snaps, trans)\n\tif err != nil {\n\t\tt.Fatalf(\"producing raft: %v\", err)\n\t}\n\tdeadline := time.Now().Add(10 * time.Second)\n\tfor r.Leader() == \"\" && time.Now().Before(deadline) {\n\t\ttime.Sleep(2 * time.Millisecond)\n\t}\n\tif r.Leader() == \"\" {\n\t\tt.Fatalf(\"no leader\")\n\t}\n\tapply := func(n int) {\n\t\tvar last ApplyFuture\n\t\tfor i := 0; i < n; i++ {\n\t\t\tlast = r.Apply([]byte(\"x\"), 5*time.Second)\n\t\t}\n\t\tif err := last.Error(); err != nil {\n\t\t\tt.Fatalf(\"apply: %v\", err)\n\t\t}\n\t}\n\tapply(firstBatch)\n\tif err := r.Snapshot().Error(); err != nil {\n\t\tt.Fatalf(\"snapshot: %v\", err)\n\t}\n\tapply(secondBatch)\n\tsnapshotIndex := uint64(0)\n\tlisted, err := snaps.List()\n\tif err != nil {\n\t\tt.Fatalf(\"list snapshots: %v\", err)\n\t}\n\tif len(listed) > 0 {\n\t\tsnapshotIndex = listed[0].Index\n\t}\n\tif err := r.Shutdown().Error(); err != nil {\n\t\tt.Fatalf(\"shutdown: %v\", err)\n\t}\n\tstaged, err := store.GetCommitIndex()\n\tif err != nil {\n\t\tt.Fatalf(\"staged commit: %v\", err)\n\t}\n\tlastLog, err := store.LastIndex()\n\tif err != nil {\n\t\tt.Fatalf(\"last log: %v\", err)\n\t}\n\treplay := uint64(0)\n\tif staged > snapshotIndex {\n\t\treplay = staged - snapshotIndex\n\t}\n\tbatches := (replay + 63) / 64\n\n\tmbEmit(t, map[string]interface{}{\n\t\t\"event\":              \"mb_case_midband_replay\",\n\t\t\"case\":               \"midband_replay\",\n\t\t\"mode\":               \"real_cluster_restart_with_mid_snapshot\",\n\t\t\"snapshot_index\":     snapshotIndex,\n\t\t\"staged_commit_index\": staged,\n\t\t\"last_log_index\":     lastLog,\n\t\t\"replay_entries\":     replay,\n\t\t\"replay_batches\":     batches,\n\t\t\"max_append_entries\": 64,\n\t\t\"window_ms\":          int(window / time.Millisecond),\n\t})\n\n\tbase := mbBlocked()\n\tstart := time.Now()\n\tdone := make(chan error, 1)\n\tvar restarted *Raft\n\tgo func() {\n\t\tvar err error\n\t\trestarted, err = NewRaft(mbConfig(\"node1\"), &mbFSM{}, store, store, snaps, trans)\n\t\tdone <- err\n\t}()\n\treturned := false\n\terrText := \"\"\n\tselect {\n\tcase err := <-done:\n\t\treturned = true\n\t\tif err != nil {\n\t\t\terrText = err.Error()\n\t\t} else {\n\t\t\tdefer func() { _ = restarted.Shutdown().Error() }()\n\t\t}\n\tcase <-time.After(window):\n\t\terrText = \"no return within observation window\"\n\t}\n\tmbEmit(t, map[string]interface{}{\n\t\t\"event\":               \"mb_result_midband_replay\",\n\t\t\"case\":                \"midband_replay\",\n\t\t\"returned\":            returned,\n\t\t\"elapsed_ms\":          int(time.Since(start) / time.Millisecond),\n\t\t\"error\":               errText,\n\t\t\"new_blocked_process\": mbBlocked() - base,\n\t})\n\tt.Logf(\"replay=%d batches=%d returned=%v err=%q\", replay, batches, returned, errText)\n}\n","exit_code":0,"status":"completed"}}
