{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/draft && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B - <<'PY'\nfor p in ['exp_verify_leader_test.go','work/raft/assurance_verify_test.go']:\n    s=open(p).read()\n    old='''\t\tvfEmit(t, map[string]interface{}{\n\t\t\t\\\"event\\\":            \\\"verify_result_\\\" + name,\n\t\t\t\\\"case\\\":             name,\n\t\t\t\\\"completed\\\":        completed,\n\t\t\t\\\"verify_ok\\\":        ok,\n\t\t\t\\\"verify_error\\\":     errText,\n\t\t\t\\\"state_after\\\":      leader.State().String(),\n\t\t})'''\n    new='''\t\tvfEmit(t, map[string]interface{}{\n\t\t\t\\\"event\\\":            \\\"verify_result_\\\" + name,\n\t\t\t\\\"case\\\":             name,\n\t\t\t\\\"completed\\\":        completed,\n\t\t\t\\\"verify_ok\\\":        ok,\n\t\t\t\\\"verify_error\\\":     errText,\n\t\t\t\\\"state_after\\\":      leader.State().String(),\n\t\t})\n\n\t\t// Repeat the verification until it fails, to bound how long a false\n\t\t// success can be obtained from the same partitioned leader.\n\t\tloopSuccesses := 0\n\t\tmsUntilFailure := -1\n\t\tloopStart := time.Now()\n\t\tfor time.Since(loopStart) < 3*time.Second {\n\t\t\tf := leader.VerifyLeader()\n\t\t\tdone2 := make(chan error, 1)\n\t\t\tgo func() { done2 <- f.Error() }()\n\t\t\tvar err error\n\t\t\tselect {\n\t\t\tcase err = <-done2:\n\t\t\t\tif err == nil {\n\t\t\t\t\tloopSuccesses++\n\t\t\t\t\ttime.Sleep(50 * time.Millisecond)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\tcase <-time.After(300 * time.Millisecond):\n\t\t\t\terr = fmt.Errorf(\\\"no completion\\\")\n\t\t\t}\n\t\t\tmsUntilFailure = int(time.Since(loopStart) / time.Millisecond)\n\t\t\t_ = err\n\t\t\tbreak\n\t\t}\n\t\tvfEmit(t, map[string]interface{}{\n\t\t\t\\\"event\\\":             \\\"verify_loop_\\\" + name,\n\t\t\t\\\"case\\\":              name,\n\t\t\t\\\"loop_successes\\\":    loopSuccesses,\n\t\t\t\\\"ms_until_failure\\\":  msUntilFailure,\n\t\t\t\\\"state_after_loop\\\":  leader.State().String(),\n\t\t})'''\n    assert old in s, p\n    s=s.replace(old,new)\n    open(p,'w').write(s)\nprint('patched')\nPY\ncd work/raft && GOPROXY=off GOFLAGS=-mod=mod gofmt -w assurance_verify_test.go && GOPROXY=off GOFLAGS=-mod=mod timeout 150 go test -json -count=1 -timeout=140s -run '\"'^TestAssuranceVerifyLeaderSupporters$'\"' . 2>&1 | grep -o 'CA_EVENT .*' | sed 's/\\\\\\\\n.*//' | grep -E 'loop|result'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
