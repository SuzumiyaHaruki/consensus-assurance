Sprintf(\\\"%v\\\", latestCfg.Servers)\n\tlatestIndex := rL.configurations.latestIndex\n\tphEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":                    \\\"phantom_case\\\",\n\t\t\\\"case\\\":                     \\\"failed_configuration_write\\\",\n\t\t\\\"members\\\":                  2,\n\t\t\\\"failure_injected\\\":         true,\n\t\t\\\"removed_peer\\\":             string(peerID),\n\t\t\\\"latest_index_after_fail\\\":  latestIndex,\n\t\t\\\"last_log_index_after_fail\\\": lastLogL,\n\t\t\\\"phantom_servers\\\":          phantomServers,\n\t})\n\tphEmit(t, map[string]interface{}{\n\t\t\\\"event\\\":                     \\\"phantom_result\\\",\n\t\t\\\"case\\\":                      \\\"failed_configuration_write\\\",\n\t\t\\\"remove_error\\\":              fmt.Sprintf(\\\"%v\\\", errRemove),\n\t\t\\\"remove_failed\\\":             errRemove \"'!= nil,\n\t\t\"latest_index_exceeds_log\":  latestIndex > lastLogL,\n\t\t\"re_elected\":                reElected,\n\t\t\"apply_ok\":                  applyErr == nil,\n\t\t\"commit_index\":              commitL,\n\t\t\"leader_last_index\":         lastL,\n\t\t\"peer_last_index\":           lastP,\n\t\t\"commit_without_peer\":       applyErr == nil && lastP < commitL,\n\t})\n\tt.Logf(\"stateL=%v applyErr=%v commitL=%d lastL=%d lastPeer=%d\", stateL, applyErr, commitL, lastL, lastP)'\"'''\nassert old in s\ns=s.replace(old,new)\nopen('exp_phantom_config_test.go','w').write(s)\nprint('written')\nPY\ncp exp_phantom_config_test.go work/raft/assurance_phantom_test.go && mv work/raft/zz_probe_phantom_test.go work/raft/zz_probe_phantom_test.go.off && cd work/raft && GOPROXY=off GOFLAGS=-mod=mod gofmt -w assurance_phantom_test.go && GOPROXY=off GOFLAGS=-mod=mod timeout 150 go test -json -count=1 -timeout=120s -run '\"'^TestAssurancePhantomConfiguration$'\"' . 2>&1 | grep -o 'CA_EVENT .*' | sed 's/\\\\\\\\n.*//'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
