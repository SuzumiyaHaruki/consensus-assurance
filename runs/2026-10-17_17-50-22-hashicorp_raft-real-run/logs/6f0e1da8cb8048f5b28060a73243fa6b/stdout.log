this switch catches the case where this is called without having set\n\t// a configuration previously.\n\tswitch c := r.latestConfiguration.Load().(type) {\n\tcase Configuration:\n\t\treturn c\n\tdefault:\n\t\treturn Configuration{}\n\t}\n}\n","exit_code":0,"status":"completed"}}
