,\n\t})'''\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nprint('ok')\nPY\ncp exp_phantom_config_test.go work/raft/assurance_phantom_test.go && cd work/raft && GOPROXY=off GOFLAGS=-mod=mod gofmt -w assurance_phantom_test.go && GOPROXY=off GOFLAGS=-mod=mod timeout 200 go test -json -count=1 -timeout=180s -run '\"'^TestAssurancePhantomConfiguration$'\"' . 2>&1 | grep -o 'CA_EVENT .*' | sed 's/\\\\\\\\n.*//' | tail -3\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
