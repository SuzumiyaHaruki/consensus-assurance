{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/draft && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B - <<'PY'\np='exp_verify_leader_test.go'\ns=open(p).read()\n# add an FSM that records the last applied value, plus a helper for the stale-read case\ns=s.replace('''func TestAssuranceVerifyLeaderSupporters(t *testing.T) {''','''type vfFSM struct {\n\tmu   sync.Mutex\n\tlast string\n}\n\nfunc (f *vfFSM) Apply(l *Log) interface{} {\n\tf.mu.Lock()\n\tf.last = string(l.Data)\n\tf.mu.Unlock()\n\treturn nil\n}\n\nfunc (f *vfFSM) Snapshot() (FSMSnapshot, error) { return &vfSnapshot{}, nil }\nfunc (f *vfFSM) Restore(io.ReadCloser) error    { return nil }\n\nfunc (f *vfFSM) value() string {\n\tf.mu.Lock()\n\tdefer f.mu.Unlock()\n\treturn f.last\n}\n\ntype vfSnapshot struct{}\n\nfunc (s *vfSnapshot) Persist(SnapshotSink) error { return nil }\nfunc (s *vfSnapshot) Release()                  {}\n\n// staleReadCase: the partitioned leader keeps passing verification while a\n// majority of voters commits a newer value that this node never sees.\nfunc staleReadCase(t *testing.T) {\n\tconf := inmemConfig(t)\n\tconf.HeartbeatTimeout = time.Second\n\tconf.ElectionTimeout = time.Second\n\tconf.LeaderLeaseTimeout = time.Second\n\tfsms := map[ServerAddress]*vfFSM{}\n\tc := MakeClusterCustom(t, &MakeClusterOpts{Peers: 5, Bootstrap: true, Conf: conf,\n\t\tMakeFSMFunc: func() FSM { return &vfFSM{} }})\n\tdefer c.Close()\n\tleader := c.Leader()\n\tif leader == nil {\n\t\tt.Fatalf(\\\"no leader\\\")\n\t}\n\tvar others []*Raft\n\tfor _, r := range c.rafts {\n\t\tif r \"'!= leader {\n\t\t\tothers = append(others, r)\n\t\t}\n\t}\n\tfor _, r := range others[:2] {\n\t\tif err := leader.DemoteVoter(r.localID, 0, 5*time.Second).Error(); err != nil {\n\t\t\tt.Fatalf(\"demote: %v\", err)\n\t\t}\n\t}\n\ttime.Sleep(300 * time.Millisecond)\n\tif err := leader.Apply([]byte(\"v1\"), 5*time.Second).Error(); err != nil {\n\t\tt.Fatalf(\"apply v1: %v\", err)\n\t}\n\t_ = fsms\n\tleaderTrans := leader.trans.(*InmemTransport)\n\tfor _, r := range others[2:] {\n\t\tleaderTrans.Disconnect(r.localAddr)\n\t\tr.trans.(*InmemTransport).Disconnect(leader.localAddr)\n\t}\n\t// Wait for the majority side to elect a new leader among the two voters.\n\tvar newLeader *Raft\n\tdeadline := time.Now().Add(15 * time.Second)\n\tfor time.Now().Before(deadline) {\n\t\tfor _, r := range others[2:] {\n\t\t\tif r.State() == Leader {\n\t\t\t\tnewLeader = r\n\t\t\t}\n\t\t}\n\t\tif newLeader != nil {\n\t\t\tbreak\n\t\t}\n\t\ttime.Sleep(20 * time.Millisecond)\n\t}\n\tif newLeader == nil {\n\t\tt.Fatalf(\"majority side did not elect a leader\")\n\t}\n\tif err := newLeader.Apply([]byte(\"v2\"), 5*time.Second).Error(); err != nil {\n\t\tt.Fatalf(\"apply v2: %v\", err)\n\t}\n\ttime.Sleep(200 * time.Millisecond)\n\n\tfut := leader.VerifyLeader()\n\tdone := make(chan error, 1)\n\tgo func() { done <- fut.Error() }()\n\tverifyOK := false\n\tcompleted := false\n\tselect {\n\tcase err := <-done:\n\t\tcompleted = true\n\t\tverifyOK = err == nil\n\tcase <-time.After(2 * time.Second):\n\t}\n\toldFSM := leader.fsm.(*vfFSM)\n\tnewFSM := newLeader.fsm.(*vfFSM)\n\tvfEmit(t, map[string]interface{}{\n\t\t\"event\":                   \"stale_read_case\",\n\t\t\"case\":                    \"stale_read_after_verify\",\n\t\t\"partitioned_verify_ok\":   verifyOK,\n\t\t\"verify_completed\":        completed,\n\t\t\"partitioned_value\":       oldFSM.value(),\n\t\t\"majority_value\":          newFSM.value(),\n\t\t\"partitioned_state\":       leader.State().String(),\n\t\t\"majority_leader_state\":   newLeader.State().String(),\n\t})\n}\n\nfunc TestAssuranceVerifyLeaderSupporters(t *testing.T) {\n\tt.Run(\"trigger_stale_read_after_verify\", func(t *testing.T) { staleReadCase(t) })'\"''')\nopen(p,'w').write(s)\nprint('written')\nPY\ncp exp_verify_leader_test.go work/raft/assurance_verify_test.go && cd work/raft && GOPROXY=off GOFLAGS=-mod=mod gofmt -w assurance_verify_test.go && GOPROXY=off GOFLAGS=-mod=mod timeout 200 go test -json -count=1 -timeout=180s -run '\"'^TestAssuranceVerifyLeaderSupporters$/trigger_stale_read_after_verify'\"' . 2>&1 | grep -o 'CA_EVENT .*' | sed 's/\\\\\\\\n.*//'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
