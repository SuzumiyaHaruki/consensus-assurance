t'],\\\"conditions\\\":k0['conditions'],\\\"source_ids\\\":k0['source_ids'],\\\"executions\\\":e0},\n  {\\\"id\\\":k1['id'],\\\"kind\\\":k1['kind'],\\\"statement\\\":k1['statement'],\\\"conditions\\\":k1['conditions'],\\\"source_ids\\\":k1['source_ids'],\\\"executions\\\":e1},\n ],\n \\\"interpretations\\\":[{\n  \\\"investigation_id\\\":\\\"f7da39e9771e40d29f8d7ec3d1c7d886-question-0\\\",\n  \\\"experiment_id\\\":\\\"6f0e1da8cb8048f5b28060a73243fa6b-experiment\\\",\n  \\\"source_ids\\\":cur['source_ids'],\n  \\\"executions\\\":{ex:[0,1,2,3]},\n  \\\"conclusion\\\":\\\"violated\\\",\n  \\\"defect_claim\\\":\\\"asserted\\\",\n  \\\"rationale\\\":cur['rationale']+\\\"\\\\n\\\\n\\\"+para,\n  \\\"counterevidence\\\":ces,\n  \\\"limitations\\\":lims,\n  \\\"joint_history\\\":joint,\n  \\\"knowledge\\\":[\n   {\\\"entry_id\\\":k0['id'],\\\"revision\\\":k0['revision']+1,\\\"assertion\\\":\\\"An explicit transfer target is resolved only through leaderState.replState, which includes non-voters, while pickServer skips non-voters.\\\"},\n   {\\\"entry_id\\\":k1['id'],\\\"revision\\\":k1['revision']+1,\\\"assertion\\\":\\\"A voter adopts a higher term and steps down before rejecting a configured non-voter candidate, and timeoutNow forces candidacy without checking suffrage or term.\\\"},\n  ],\n }],\n}\njson.dump(upd, open('draft/update.json','w'), indent=2, ensure_ascii=False)\nopen('draft/update.json','a').write('\\\\n')\nprint('written', bool(old))\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -c \\\"\nimport json,jsonschema\ns=json.load(open('/home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/submission.schema.json'))\nd=json.load(open('/home/nitro/Desktop/consensus-assurance/runs/2026-10-17_17-50-22-hashicorp_raft-real-run/draft/update.json'))\njsonschema.validate(d,s);i=d['interpretations'][0]\nprint('schema OK ce=',len(i['counterevidence']),'lim=',len(i['limitations']),'revs',[u['revision'] for u in i['knowledge']])\\