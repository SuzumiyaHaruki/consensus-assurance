\", \"collection\": \"monitor_results\", \"match\": {\"experiment_check_id\": \"5889f79a2ba84d4dbf016630607560c4\", \"claim_id\": \"C_accepted_phase_report\"}}}]\nartifacts [{\"id\": \"508c74784d3344ada2c0e266a36b63ed\", \"version\": 1, \"plan_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_20-14-33-swiftpaxos_epaxos-real-run/direct-checks/5ec99f304c634b909da9f6c724dd3107/plan.json\", \"harness_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_20-14-33-swiftpaxos_epaxos-real-run/direct-checks/5ec99f304c634b909da9f6c724dd3107/epaxos/assurance_generated_test.go\", \"unit_id\": \"unit-C_prepare_vballot_preserved\", \"claim_id\": \"C_prepare_vballot_preserved\", \"graph_versions\": {\"C_prepare_vballot_preserved\": 1, \"BD_prepare_producer\": 1, \"BD_prepare_encoder\": 1, \"BD_prepare_decoder\": 1, \"BD_prepare_consumer\": 1, \"unit-C_prepare_vballot_preserved\": 1}, \"previous_id\": null, \"record\": {\"path\": \"state.json\", \"collection\": \"direct_checks\", \"match\": {\"id\": \"508c74784d3344ada2c0e266a36b63ed\"}}, \"basis\": [{\"path\": \"state.json\", \"collection\": \"claims\", \"match\": {\"id\": \"C_prepare_vballot_preserved\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_prepare_producer\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_prepare_encoder\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_prepare_decoder\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_prepare_consumer\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-C_prepare_vballot_preserved\", \"version\": 1}}]}, {\"id\": \"bb4b2c5713754168a8dfc3d95058259d\", \"version\": 1, \"plan_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_20-14-33-swiftpaxos_epaxos-real-run/direct-checks/14283691c3414f058f1ff46ed820b0f0/plan.json\", \"harness_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_20-14-33-swiftpaxos_epaxos-real-run/direct-checks/14283691c3414f058f1ff46ed820b0f0/epaxos/assurance_generated_test.go\", \"unit_id\": \"unit-C_accepted_phase_report\", \"claim_id\": \"C_accepted_phase_report\", \"graph_versions\": {\"C_accepted_phase_report\": 1, \"BD_accept_store\": 1, \"BD_accept_count\": 1, \"BD_accept_prepare_report\": 1, \"BD_accept_recover_classify\": 1, \"unit-C_accepted_phase_report\": 1}, \"previous_id\": null, \"record\": {\"path\": \"state.json\", \"collection\": \"direct_checks\", \"match\": {\"id\": \"bb4b2c5713754168a8dfc3d95058259d\"}}, \"basis\": [{\"path\": \"state.json\", \"collection\": \"claims\", \"match\": {\"id\": \"C_accepted_phase_report\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_accept_store\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_accept_count\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_accept_prepare_report\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"bindings\", \"match\": {\"id\": \"BD_accept_recover_classify\", \"version\": 1}}, {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-C_accepted_phase_report\", \"version\": 1}}]}]\npending_work [{\"id\": \"unit-C_accepted_phase_report\", \"candidate_id\": \"ec1ee8fa559b42e5beed5b951a4676bc\", \"kind\": \"unit\", \"remaining\": [\"C_accepted_phase_report\"], \"record\": {\"path\": \"state.json\", \"collection\": \"units\", \"match\": {\"id\": \"unit-C_accepted_phase_report\"}}}]\nreview_issues []\ncheck {\"id\": \"35b34756363847b183b2d3913113dbea\", \"status\": \"completed\", \"outcome\": \"tests_passed\", \"stdout\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-06_20-14-33-swiftpaxos_epaxos-real-run/logs/35b347563638