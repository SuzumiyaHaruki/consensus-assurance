\"Test\":\"TestAssuranceRecoverDecisionExploration\",\"Output\":\"--- PASS: TestAssuranceRecoverDecisionExploration (0.00s)\\n\"}\n{\"Time\":\"2026-10-06T20:42:04.841461939+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssuranceRecoverDecisionExploration\",\"Elapsed\":0}\n{\"Time\":\"2026-10-06T20:42:04.841486111+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-06T20:42:04.843194364+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Output\":\"ok  \\tgithub.com/imdea-software/swiftpaxos/epaxos\\t0.017s\\n\"}\n{\"Time\":\"2026-10-06T20:42:04.843293052+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Elapsed\":0.017}\n pendingCommit,ok:=assuranceReportDecode(t,recoverer,originOut[recoverer.Id]).(*Commit)\n if !ok || pendingCommit.Instance!=0 {t.Fatal(\"expected pending old Commit\")}\n later,ok:=assuranceReportDecode(t,recoverer,originOut[recoverer.Id]).(*PreAccept)\n if !ok || later.Instance!=1 {t.Fatal(\"expected later-slot PreAccept\")}\n recoverer.handlePreAccept(later)\n if recoverer.crtInstance[1]!=1 || recoverer.InstanceSpace[1][0]!=nil {t.Fatal(\"missing-slot recovery premise not reached\")}\n recoverer.PreferredPeerOrder=[]int32{2,4,1,0,3}\n recoverer.startRecoveryForInstance(1,0)\n for _,receiver:=range []*Replica{coordinator,fourth} {\n  req,ok:=assuranceReportDecode(t,receiver,recovererOut[receiver.Id]).(*Prepare)\n  if !ok {t.Fatal(\"expected Prepare\")}; receiver.handlePrepare(req)\n }\n for _,stream:=range []*bytes.Buffer{coordinatorOut[recoverer.Id],fourthOut[recoverer.Id]} {\n  msg,ok:=assuranceReportDecode(t,recoverer,stream).(*PrepareReply)\n  if !ok {t.Fatal(\"expected PrepareReply\")}; recoverer.handlePrepareReply(msg)\n }\n // Follow whichever phase the actual recovery selected; no command or status\n // is supplied to the target by the driver at this transition.\n for _,receiver:=range []*Replica{coordinator,fourth} {\n  req,ok:=assuranceReportDecode(t,receiver,recovererOut[receiver.Id]).(*PreAccept)\n  if !ok {t.Fatal(\"explored recovery did not restart phase 1\")}; receiver.handlePreAccept(req)\n }\n for _,stream:=range []*bytes.Buffer{coordinatorOut[recoverer.Id],fourthOut[recoverer.Id]} {\n  msg,ok:=assuranceReportDecode(t,recoverer,stream).(*PreAcceptReply)\n  if !ok {t.Fatal(\"expected recovery PreAcceptReply\")}; recoverer.handlePreAcceptReply(msg)\n }\n for _,receiver:=range []*Replica{coordinator,fourth} {\n  req,ok:=assuranceReportDecode(t,receiver,recovererOut[receiver.Id]).(*Accept)\n  if !ok {t.Fatal(\"expected recovery Accept\")}; receiver.handleAccept(req)\n }\n for _,stream:=range []*bytes.Buffer{coordinatorOut[recoverer.Id],fourthOut[recoverer.Id]} {\n  msg,ok:=assuranceReportDecode(t,recoverer,stream).(*AcceptReply)\n  if !ok {t.Fatal(\"expected recovery AcceptReply\")}; recoverer.handleAcceptReply(msg)\n }\n second:=recoverer.InstanceSpace[1][0]\n if second.Status!=COMMITTED {t.Fatal(\"recovery did not attain a second commitment\")}\n secondBytes,err:=json.Marshal(second.Cmds); if err!=nil {t.Fatal(err)}\n assuranceReportEvent(t,map[string]any{\"event\":\"second_decision\",\"origin\":1,\"instance\":0,\"owner\":recoverer.Id,\"commands\":string(secondBytes),\"status\":second.Status,\"first_still_committed\":target.Status==COMMITTED,\"same_commands\":bytes.Equal(firstBytes,secondBytes),\"pending_original_commit_instance\":pendingCommit.Instance})\n}\n\t\tcase acceptS := <-r.acceptChan:\n\t\t\taccept := acceptS.(*Accept)\n\t\t\tr.handleAccept(accept)\n\t\t\tbreak\n\n\t\tcase commitS := <-r.commitChan:\n\t\t\tcommit := commitS.(*Commit)\n\t\t\tr.handleCommit(commit)\n\t\t\tbreak\n\n\t\tcase prepareReplyS := <-r.prepareReplyChan:\n\t\t\tprepareReply := prepareReplyS.(*PrepareReply)\n\t\t\tr.handlePrepareReply(prepareReply)\n\t\t\tbreak\n\n\t\tcase preAcceptReplyS := <-r.preAcceptReplyChan:\n\t\t\tpreAcceptReply := preAcceptReplyS.(*PreAcceptReply)\n\t\t\tr.handlePreAcceptReply(preAcceptReply)\n\t\t\tbreak\n\n\t\tcase acceptReplyS := <-r.acceptReplyChan:\n\t\t\tacceptReply := acceptReplyS.(*AcceptReply)\n\t\t\tr.handleAcceptReply(acceptReply)\n\t\t\tbreak\n\n\t\tcase tryPreAcceptS := <-r.tryPreAcceptChan:\n\t\t\ttryPreAccept := tryPreAcceptS.(*TryPreAccept)\n\t\t\tr.handleTryPreAccept(tryPreAccept)\n\t\t\tbreak\n\n\t\tcase tryPreAcceptReplyS := <-r.tryPreAcceptReplyChan:\n\t\t\ttryPreAcceptReply := tryPreAcceptReplyS.(*TryPreAcceptReply)\n\t\t\tr.handleTryPreAcceptReply(tryPreAcceptReply)\n\t\t\tbreak\n\n\t\tcase beacon := <-r.BeaconChan:\n\t\t\tr.ReplyBeacon(beacon)\n\t\t\tbreak\n\n\t\tcase <-slowClockChan:\n\t\t\tif r.Beacon {\n\t\t\t\tr.Printf(\"weird %d; conflicted %d; slow %d; fast %d\\n\", r.Stats.M[\"weird\"], r.Stats.M[\"conflicted\"], r.Stats.M[\"slow\"], r.Stats.M[\"fast\"])\n\t\t\t\tfor q := int32(0); q < int32(r.N); q++ {\n\t\t\t\t\tif q == r.Id {\n\t\t\t\t\t\tcontinue\n\t\t\t\t\t}\n\t\t\t\t\tr.SendBeacon(q)\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak\n\n\t\tcase iid := <-r.instancesToRecover:\n\t\t\tr.startRecoveryForInstance(iid.replica, iid.instance)\n\t\t\tnow := time.Now().UnixNano()\n\t\t\tr.Ewma[rid] = 0.99*r.Ewma[rid] + 0.01*float64(now-gbeaconReply.Timestamp)\n\t\t\tbreak\n\n\t\tdefault:\n\t\t\tp, exists := r.RPC.Get(msgType)\n\t\t\tif exists {\n\t\t\t\tobj := p.Obj.New()\n\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tgo func(obj fastrpc.Serializable) {\n\t\t\t\t\ttime.Sleep(r.Dt.WaitDurationID(rid))\n\t\t\t\t\tp.Chan <- obj\n\t\t\t\t}(obj)\n\t\t\t} else {\n","exit_code":0,"status":"completed"}}
