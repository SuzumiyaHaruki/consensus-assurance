ire, bs, 4); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tt.CommittedDeps[i] = int32((uint32(bs[0]) | (uint32(bs[1]) << 8) | (uint32(bs[2]) << 16) | (uint32(bs[3]) << 24)))\n\t}\n\treturn nil\n}\npackage master\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"math\"\n\t\"net\"\n\t\"net/http\"\n\t\"net/rpc\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/imdea-software/swiftpaxos/config\"\n\t\"github.com/imdea-software/swiftpaxos/dlog\"\n\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n)\n\ntype Master struct {\n\t*dlog.Logger\n\n\tN          int\n\tport       int\n\tnodeList   []string\n\taddrList   []string\n\tportList   []int\n\tlock       *sync.Mutex\n\tnodes      []*rpc.Client\n\tleader     []bool\n\talive      []bool\n\tlatencies  []float64\n\tfinishInit bool\n\tinitCond   *sync.Cond\n\tnextLeader int\n\tconfig     *config.Config\n}\n\nfunc New(N, port int, config *config.Config, logger *dlog.Logger) *Master {\n\tmaster := &Master{\n\t\tLogger: logger,\n\n\t\tN:          N,\n\t\tport:       port,\n\t\tnodeList:   make([]string, 0, N),\n\t\taddrList:   make([]string, 0, N),\n\t\tportList:   make([]int, 0, N),\n\t\tlock:       new(sync.Mutex),\n\t\tnodes:      make([]*rpc.Client, N),\n\t\tleader:     make([]bool, N),\n\t\talive:      make([]bool, N),\n\t\tlatencies:  make([]float64, N),\n\t\tfinishInit: false,\n\t\tnextLeader: -1,\n\t\tconfig:     config,\n\t}\n\tmaster.initCond = sync.NewCond(master.lock)\n\treturn master\n}\n\nfunc (master *Master) Run() {\n\tmaster.Printf(\"master starting on port %d\", master.port)\n\tmaster.Printf(\"waiting for %d replicas\", master.N)\n\n\trpc.Register(master)\n\trpc.HandleHTTP()\n\tl, err := net.Listen(\"tcp\", fmt.Sprintf(\":%d\", master.port))\n\tif err != nil {\n\t\tmaster.Fatal(\"master listen error:\", err)\n\t}\n\tgo master.run()\n\thttp.Serve(l, nil)\n}\n\nfunc (master *Master) run() {\n\tfor {\n\t\tmaster.lock.Lock()\n\t\tif len(master.nodeList) == master.N {\n\t\t\tmaster.lock.Unlock()\n\t\t\tbreak\n\t\t}\n\t\tmaster.lock.Unlock()\n\t\ttime.Sleep(time.Second)\n\t}\n\ttime.Sleep(2 * time.Second)\n\n\tfor i := 0; i < master.N; {\n\t\tvar err error\n\t\taddr := fmt.Sprintf(\"%s:%d\", master.addrList[i], master.portList[i]+1000)\n\t\tmaster.nodes[i], err = rpc.DialHTTP(\"tcp\", addr)\n\t\tif err != nil {\n\t\t\tmaster.Printf(\"error connecting to replica %d (%v), retrying...\", i, addr)\n\t\t\ttime.Sleep(time.Second)\n\t\t} else {\n\t\t\tbtlReply := defs.NewBeTheLeaderReply()\n\t\t\tif master.leader[i] {\n\t\t\t\terr = master.nodes[i].Call(\"Replica.BeTheLeader\", &defs.BeTheLeaderArgs{}, btlReply)\n\t\t\t\tif err != nil {\n\t\t\t\t\tmaster.Fatal(\"Not today Zurg!\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > build_submission.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind));return i\nsrc('S_profile','epaxos/epaxos.go',31,38)\nsrc('S_init','epaxos/epaxos.go',134,197)\nsrc('S_durable','epaxos/epaxos.go',199,236)\nsrc('S_dispatch','epaxos/epaxos.go',278,383)\nsrc('S_watch','epaxos/epaxos.go',385,451)\nsrc('S_broadcast','epaxos/epaxos.go',453,611)\nsrc('S_attrs','epaxos/epaxos.go',619,722)\nsrc('S_phase1','epaxos/epaxos.go',724,845)\nsrc('S_pa_reply','epaxos/epaxos.go',847,972)\nsrc('S_accept','epaxos/epaxos.go',974,1064)\nsrc('S_commit','epaxos/epaxos.go',1066,1113)\nsrc('S_recover_start','epaxos/epaxos.go',1121,1169)\nsrc('S_prepare','epaxos/epaxos.go',1171,1202)\nsrc('S_recover_select','epaxos/epaxos.go',1204,1314)\nsrc('S_try','epaxos/epaxos.go',1316,1506)\nsrc('S_defaults','epaxos/epaxos.go',1508,1530)\nsrc('S_reply_type','epaxos/defs.go',13,30,'interface_statement')\nsrc('S_prepare_codec','epaxos/defs.go',117,252)\nsrc('S_pa_codec','epaxos/defs.go',822,925)\nsrc('S_transport_send','replica/replica.go',215,227)\nsrc('S_transport_recv','replica/replica.go',416,472)\nsrc('S_rpc','rpc/rpc.go',5,50,'interface_statement')\nsrc('S_members','replica/replica.go',63,172)\nsrc('S_run','run.go',23,62)\nsrc('S_master','master/master.go',80,260)\nsrc('S_client_entry','replica/replica.go',474,544)\nsrc('S_exec','epaxos/exec.go',25,172)\nsrc('S_state','state/state.go',75,146)\nB=[]\ndef b(i,a,owner,context,trigger,ss,**kw):\n x=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss);x.update(kw);B.append(x)\nctx='Replica.InstanceSpace[origin replica][instance], with local promise bal, value tag vbal and per-attempt LeaderBookkeeping.'\nb('B_phase1','A1','Protocol run goroutine',ctx,'Client proposal or recovery restart invokes startPhase1; received PreAccept invokes handlePreAccept.',['S_phase1','S_attrs','S_broadcast','S_defaults'],\n implementation_guards=['PreAccept below inst.bal is dropped. Existing ACCEPTED or later instances retain metadata; missing commands are handled separately.'],\n reads=['Per-row key conflict indexes, maxSeqPerKey, local instance status and ballot.'],writes=['Initiator installs PREACCEPTED with bal=vbal=ballot; creates bookkeeping whose seq is -1 and ballot is -1, with lastTriedBallot set to the attempt ballot.','Receiver below ACCEPTED computes attributes, sets PREACCEPTED/PREACCEPTED_EQ, bal/vbal and commands; records key conflicts.'],\n external_effects=['Initiator broadcasts to preferred live peers, FastQuorumSize()-1 when thrifty.','Receiver returns current bal, vbal, status, seq, deps and committed prefix.'],\n async_boundaries=['run serializes handler calls; network receipt and execution happen in separate goroutines.'],produces_fact_ids=['F_local_value'],unknowns=['Command fill uses LeaderId rather than Replica in the ACCEPTED-or-later branch; recovery may make them different.'])\nb('B_form','A1','Protocol run goroutine',ctx,'PreAcceptReply or AcceptReply arrives for an instance.',['S_pa_reply','S_accept','S_broadcast','S_members'],\n implementation_guards=['PreAcceptReply checks lastTriedBallot and bookkeeping phase. AcceptReply checks ACCEPTED and exact lastTriedBallot.'],\n writes=['PreAccept replies increment support and merge attributes; a larger VBallot replaces bookkeeping value metadata.','Fast threshold plus allEqual, allCommitted and initial ballot commits; otherwise threshold enters ACCEPTED and broadcasts Accept.','Accept replies at the attempted ballot commit when acceptOKs+1>N/2.'],\n important_branches=['N<=3 and Thrifty bypass equality accumulation. Committed-dependency checks run only for N>7.','On higher PreAcceptReply ballot, nacks may cause IsLeader to makeBallot and bcastPrepare. In AcceptReply the inequality return precedes the higher-ballot branch.'],\n external_effects=['Commit sends full commands and dependencies to live peers; early client replies only if Dreply is false.'],produces_fact_ids=['F_decision','F_local_value'],consumes_fact_ids=['F_local_value'],unknowns=['Threshold applicability and implicit self support need separate scrutiny; values are mapped as code observations, not qualified quorum proof.'])\nb('B_accept','A1','Acceptor protocol run goroutine',ctx,'Accept message dispatched.',['S_accept'],\n implementation_guards=['Below-promise ballots and COMMITTED/EXECUTED instances do not replace seq/deps.'],\n writes=['Eligible branch assigns Deps, Seq, bal and vbal; does not assign Status or commands.'],external_effects=['AcceptReply contains current bal, including on rejection.'],produces_fact_ids=['F_local_value'],unknowns=['Does retaining prior status after positive acceptance allow recovery to misclassify support?'])\nb('B_commit','A1','Protocol run goroutine',ctx,'Commit message dispatched.',['S_commit','S_attrs'],\n implementation_guards=['Ignore if already COMMITTED/EXECUTED or incoming ballot below inst.bal.'],writes=['Install command, seq/deps, bal/vbal and COMMITTED; update conflict indexes and contiguous committed prefix.'],\n important_branches=['Own-row NOOP commitment requeues retained proposals and clears their original association.'],external_effects=['No reply is sent by this entry; application is through executeCommands.'],produces_fact_ids=['F_decision','F_local_value'])\nb('B_authority','A2','Protocol run goroutine; BeTheLeader RPC sets leader hint',ctx,'startRecoveryForInstance or handlePrepare.',['S_recover_start','S_prepare','S_watch','S_defaults','S_broadcast'],\n implementation_guards=['Recovery returns if already committed with commands. Prepare only raises bal; replies even for stale requests.'],\n writes=['Recovery replaces bookkeeping while retaining client proposals and copying old value fields; makeBallot chooses Id or Id+N and raises toward maxRecvBallot only when IsLeader.','Recovery sets its local bal and vbal to lastTriedBallot and inserts a self PrepareReply. Prepare reception raises bal without changing vbal.'],\n external_effects=['Recovery broadcasts Prepare to all other live peers. handlePrepare constructs a reply using current identity, promise, vbal, status, command and attributes and sends it to the requesting leader.'],\n produces_fact_ids=['F_prepare_report','F_local_value'],consumes_fact_ids=['F_local_value','F_decision'],cross_activity_effects={'A1':'A new attempt later consumes returned value tags and status to select the next formation path.'},unknowns=['Repeated attempts can reuse ballots; strict increase and old-reply handling beyond equal-ballot filtering remain unresolved.'])\nb('B_prepare_wire','A2','SendMsg caller and peer listener goroutine','PrepareReply message between acceptor and recovery coordinator','replyPrepare -> SendMsg -> Marshal; registered New -> Unmarshal -> handler channel.',['S_prepare_codec','S_transport_send','S_transport_recv','S_init','S_rpc'],\n reads=['Constructed PrepareReply including VBallot.'],writes=['Marshal/Unmarshal include AcceptorId, Replica, Instance, Ballot, Status, Command, Seq and Deps; neither accesses VBallot. New returns a fresh zero-valued PrepareReply.'],\n async_boundaries=['Each decoded RPC is sent to its registered channel in a goroutine after configured delay; byte receipt order alone does not establish handler dispatch order.'],\n consumes_fact_ids=['F_prepare_report'],cross_activity_effects={'A1':'Recovery selection reads the decoded VBallot to choose previously supported metadata.'},unknowns=['Execute a producer-derived nonzero value-ballot reply through the real codec and compare with the producer report; no execution yet.'])\nb('B_recover_select','A2','Recovery coordinator protocol run goroutine',ctx,'PrepareReply reaches handlePrepareReply while preparing.',['S_recover_select','S_defaults','S_broadcast'],\n implementation_guards=['Preparing flag and exact reply Ballot equality; collects SlowQuorumSize replies including self.'],\n reads=['PrepareReply.VBallot, Status, Command, Seq, Deps, AcceptorId; preAcceptCount and leaderResponded.'],\n writes=['Choose metadata whenever element.VBallot>=lb.ballot; classify committed, accepted, preaccepted or NONE. Install selected metadata with new attempt bal/vbal.'],\n important_branches=['Committed case installs and does nothing further here. Accepted or sufficient equal non-owner preaccepts broadcast Accept. Fallback restarts phase1 with selected commands or NOOP.','Case 4 TryPreAccept condition duplicates case 3 exactly, so the current branch ordering does not reach case 4.'],\n produces_fact_ids=['F_local_value'],consumes_fact_ids=['F_prepare_report','F_local_value'],cross_activity_effects={'A1':'Recovered status and value determine whether to resume acceptance or recompute dependencies.'},unknowns=['Selected-value safety under equal tags, wire omission, self-report retagging and accepted-status retention needs discrimination; these are separate premises.'])\nb('B_recovery_watch','A3','Execution goroutine and protocol run goroutine',ctx,'Execution scan repeatedly encounters absent, uncommitted or commandless instance.',['S_watch','S_dispatch','S_recover_start','S_try'],\n writes=['Tracks one problem instance and accumulated sleep-time count per row; queues recovery for the remaining known row suffix after COMMIT_GRACE_PERIOD.'],\n async_boundaries=['instancesToRecover transfers recovery work to run; timer count is not elapsed wall-clock proof.'],\n cross_activity_effects={'A2':'Queued recovery invokes startRecoveryForInstance to acquire an instance attempt.','A1':'Repeated scans can initiate further recovery attempts when pending work remains.'},unknowns=['Progress through recursive missing dependencies and unreachable TryPreAccept entry remains open.'])\nb('B_membership','A4','Master registration and replica initialization','Captured static peer list and configured crash tolerance','runReplica registers, computes f and constructs EPaxos; peer connection setup marks peers alive.',['S_run','S_master','S_members','S_init'],\n writes=['N from peer list, F from configured replica count, Id assigned by registration; Thrifty=true and Dreply=true.','FastQuorumSize=F+(F+1)/2; SlowQuorumSize=(N+1)/2. Peer listener failure marks Alive=false.'],\n external_effects=['Master failure polling selects BeTheLeader hint; EPaxos does not use a single global leader for every proposal.'],cross_activity_effects={'A1':'Configured sizes and preferred live peer order govern solicitation and support counts.','A2':'BeTheLeader affects recovery ballot selection, not replacement of the per-instance ballot guards.'},unknowns=['Runtime membership replacement or restart reconstruction not established.'])\nb('B_apply','A5','Execution goroutine','Committed dependency graph and local key/value State','executeCommands calls Exec.executeCommand on committed instances with commands.',['S_exec','S_watch','S_state'],\n implementation_guards=['Dependency instances and commands must be present; nonexecuted dependencies must be COMMITTED.'],writes=['Tarjan SCC traversal; sorts SCC by seq, origin and proposeTime; executes commands then marks EXECUTED.'],\n external_effects=['Dreply with saved client proposals returns execution result; otherwise PUT is applied without response.'],consumes_fact_ids=['F_decision'],cross_activity_effects={'A7':'Saved command index links result to client CommandId and timestamp.'},unknowns=['Application ordering under equal seq and same origin uses local proposeTime; legal reachability of consequential ties is unestablished.','Execution and protocol mutate shared instances concurrently; coherent observation needs controlled ownership.'])\nb('B_history','A6','Protocol handler caller','Optional Durable mode and local StableStore','recordInstanceMetadata, recordCommands and sync at selected handler sites.',['S_durable','S_phase1','S_prepare','S_commit','S_run','S_members'],\n writes=['Metadata buffer stores bal then vbal at the same offset; commands append separately.'],\n durable_effects=['No writes if Durable=false. startPhase1, preaccept and accept paths may sync; handlePrepare has no persistence call; handleCommit records without sync.'],cross_activity_effects={'A2':'Restart authority would depend on retained promises and value tags if restart were in scope.'},unknowns=['Default executable passes durable=false and StableStore initializes nil; no restart reader has been established. Durable metadata discrepancy is not yet an applicable recovery defect.'])\nb('B_client','A7','Client listener and protocol run goroutine','GPropose with client identity, command, reply writer and mutex','Decoded PROPOSE enters delayed proposal channel, then handlePropose.',['S_client_entry','S_phase1','S_exec','S_members'],\n writes=['Batches pending proposals; allocates next own-row instance; retains proposal association in bookkeeping.'],\n important_branches=['EPaxos constructor has LRead=false; Dreply defaults true. handlePropose explicitly leaves client retries as TODO.'],cross_activity_effects={'A1':'Client commands become instance commands passed to startPhase1.'},unknowns=['Client timeout/retry and duplicate completion semantics have not been read fully.'])\nF=[dict(id='F_local_value',meaning='The local instance holds command/attribute metadata, status and value tag vbal separately from promise bal; this describes stored state, not a certified quorum or invariant that every tag/status pair is valid.',identity={'replica':'origin row','instance':'slot','owner':'local replica'},validity_context=ctx,representation=['Instance.Cmds, Seq, Deps, Status, bal, vbal'],invalidators=['B_phase1','B_accept','B_commit','B_authority','B_recover_select'],reinterpreters=[],durability='Volatile in the default run; optional record routines do not establish reconstruction.',recovery='Copied into bookkeeping and PrepareReply; recovery can replace metadata.',source_ids=['S_phase1','S_accept','S_commit','S_recover_start','S_prepare','S_recover_select'],unknowns=['Validity of retagging and status transitions remains open.']),\n dict(id='F_prepare_report',meaning='At reply construction in handlePrepare, the report identifies the local acceptor and requested instance and copies the current promise ballot, stored value ballot, status, commands and attributes. This is a producer report, not a guarantee of preservation at the receiver.',identity={'acceptor':'PrepareReply.AcceptorId','replica':'PrepareReply.Replica','instance':'PrepareReply.Instance','request_context':'Prepare request and returned Ballot'},validity_context='Constructed by handlePrepare after applying any higher promise, before replyPrepare serialization. Commands/dependencies reference local slices until marshalled.',representation=['PrepareReply.Ballot','PrepareReply.VBallot','PrepareReply.Status','PrepareReply.Command','PrepareReply.Seq','PrepareReply.Deps'],invalidators=[],reinterpreters=['B_prepare_wire','B_recover_select'],durability='Transient RPC object; not durable history.',recovery='Coordinator filters Ballot and selects metadata using VBallot and Status.',source_ids=['S_prepare','S_reply_type','S_prepare_codec','S_recover_select'],unknowns=['Preservation of nonzero VBallot across the production codec has not been executed.']),\n dict(id='F_decision',meaning='The local instance is marked COMMITTED by reply aggregation or installation of a received Commit, with commands and ordering metadata. The marker alone does not prove a valid quorum or completed execution.',identity={'replica':'origin row','instance':'slot','owner':'local replica'},validity_context='Local Instance.Status >= COMMITTED; application further requires commands and committed dependencies.',representation=['Instance.Status','Instance.Cmds','Instance.Seq','Instance.Deps'],invalidators=[],reinterpreters=['B_apply'],durability='Volatile by default; per-path optional records described in B_history.',recovery='startRecovery skips committed instances with commands; prepare selection has a committed case.',source_ids=['S_pa_reply','S_accept','S_commit','S_exec','S_recover_start','S_recover_select'],unknowns=['Global agreement and dependency ordering remain to be checked.'])]\nroles=json.load(open('../research.json'))['activity_roles']\nsummaries={\n'A1':'Origin-row owners preaccept commands and attributes; replies drive fast commitment or accept/majority commitment. Full Commit propagates decisions. Recovery can resume these paths.',\n'A2':'Per-instance bal guards incoming work; lastTriedBallot qualifies replies and vbal orders recovered metadata. Prepare acquires higher promises, while recovery resets coordinator bookkeeping. The master leader flag is a ballot-selection hint.',\n'A3':'Execution discovers missing/uncommitted work and queues per-instance recovery after repeated blocked scans. Recovery solicits prior state and resumes formation.',\n'A4':'Master registration fixes peer IDs/list; configuration supplies F. EPaxos forces thrifty sending and chooses live preferred peers. No dynamic reconfiguration path is established.',\n'A5':'Committed dependency graph is traversed by Tarjan SCC; eligible commands execute in sorted SCC order, then status becomes EXECUTED.',\n'A6':'Optional append/sync helpers record selected state; default entry disables durability. A restart reader and durable-mode initialization remain unknown.',\n'A7':'PROPOSE supplies command and reply identity; batch bookkeeping retains correspondence until execution response. Retry semantics are explicitly unfinished in handlePropose.'}\nactivities=[]\nfor a in roles:\n bs=[x for x in B if x['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary=summaries[a],entry_points=[x['id']+': '+x['trigger'] for x in bs],source_ids=sorted({s for x in bs for s in x['source_ids']}),unknowns=([\\\