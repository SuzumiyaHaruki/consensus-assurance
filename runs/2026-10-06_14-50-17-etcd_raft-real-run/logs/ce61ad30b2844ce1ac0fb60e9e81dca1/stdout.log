{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"grep -n -E 'callStats|globalRand|rand\\\\.' ../agent-source/storage.go ../agent-source/raft.go; cat ../agent-source/state_trace_nop.go; sed -n '195,221p' ../agent-source/tracker/tracker.go; sed -n '712,740p' ../agent-source/raft.go; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']['CheckSubmission']; print(json.dumps(s,indent=1))\nPY\"","aggregated_output":"\t}\n\tfor id := range p.Progress {\n\t\tn--\n\t\tids[n] = id\n\t}\n\tslices.Sort(ids)\n\tfor _, id := range ids {\n\t\tf(id, p.Progress[id])\n\t}\n}\n\n// QuorumActive returns true if the quorum is active from the view of the local\n// raft state machine. Otherwise, it returns false.\nfunc (p *ProgressTracker) QuorumActive() bool {\n\tvotes := map[uint64]bool{}\n\tp.Visit(func(id uint64, pr *Progress) {\n\t\tif pr.IsLearner {\n\t\t\treturn\n\t\t}\n\t\tvotes[id] = pr.RecentActive\n\t})\n\n\treturn p.Voters.VoteResult(votes) == quorum.VoteWon\n}\n\n// VoterNodes returns a sorted slice of voters.\nfunc (p *ProgressTracker) VoterNodes() []uint64 {\nfunc (r *raft) bcastAppend() {\n\tr.trk.Visit(func(id uint64, _ *tracker.Progress) {\n\t\tif id == r.id {\n\t\t\treturn\n\t\t}\n\t\tr.sendAppend(id)\n\t})\n}\n\n// bcastHeartbeat sends RPC, without entries to all the peers.\nfunc (r *raft) bcastHeartbeat() {\n\tlastCtx := r.readOnly.lastPendingRequestCtx()\n\tif len(lastCtx) == 0 {\n\t\tr.bcastHeartbeatWithCtx(nil)\n\t} else {\n\t\tr.bcastHeartbeatWithCtx([]byte(lastCtx))\n\t}\n}\n\nfunc (r *raft) bcastHeartbeatWithCtx(ctx []byte) {\n\tr.trk.Visit(func(id uint64, _ *tracker.Progress) {\n\t\tif id == r.id {\n\t\t\treturn\n\t\t}\n\t\tr.sendHeartbeat(id, ctx)\n\t})\n}\n\nfunc (r *raft) appliedTo(index uint64, size entryEncodingSize) {\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"rationale\": {\n   \"minLength\": 1,\n   \"title\": \"Rationale\",\n   \"type\": \"string\"\n  },\n  \"sources\": {\n   \"default\": [],\n   \"items\": {\n    \"$ref\": \"#/$defs/SourceRange\"\n   },\n   \"title\": \"Sources\",\n   \"type\": \"array\"\n  },\n  \"feedback\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/ResearchFeedback\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"repair_of\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n   \"title\": \"Repair Of\"\n  },\n  \"action\": {\n   \"enum\": [\n    \"check\",\n    \"revise_check\"\n   ],\n   \"title\": \"Action\",\n   \"type\": \"string\"\n  },\n  \"unit_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Unit Id\"\n  },\n  \"candidate\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/CandidateSubmission\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"plan_path\": {\n   \"title\": \"Plan Path\",\n   \"type\": \"string\"\n  },\n  \"harness_path\": {\n   \"title\": \"Harness Path\",\n   \"type\": \"string\"\n  },\n  \"files\": {\n   \"additionalProperties\": {\n    \"type\": \"string\"\n   },\n   \"description\": \"Destination path to draft source path for helpers\",\n   \"title\": \"Files\",\n   \"type\": \"object\"\n  },\n  \"previous_check_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Previous Check Id\"\n  },\n  \"repair_issue_ids\": {\n   \"description\": \"Exact issues whose driver premises the new harness legality answers; admission does not resolve them\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Repair Issue Ids\",\n   \"type\": \"array\"\n  },\n  \"encoding_revision\": {\n   \"anyOf\":