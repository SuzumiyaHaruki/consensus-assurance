\", \"L-transfer-timeout\", \"L-advance\"], \"derivation\": \"Use C-autoleave-continuation. Compare a complete post-timeout protocol cycle, not elapsed ticks against an invented deadline. A forbidden cycle requires equal read-only structural snapshots of all three RawNodes including raft/log/storage/Progress/Ready-response state and the FIFO transport queue; joint state throughout; only heartbeat request/reply messages during the cycle; no queued work or pending transfer; leader with all log entries applied. The same tick order and drain policy can repeat. All random election timeouts are included; no state reset or election occurs in the heartbeat-only suffix, so global randomness is not consulted. MemoryStorage callStats are increment-only diagnostic counts, and logger sinks do not decide transitions. Function code identities and receiver state are retained. A completed exit produces a negative forbidden_cycle; otherwise an unequal/non-closed state produces only a diagnostic and no formal result.\", \"applicability\": \"Formal scenario selected by overlap=true independently of results. Control and rescue events are diagnostic only. Default build, single-threaded real RawNode instances, no callbacks or external threads outside the driver.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": [\"A new proposal can supply application completion and rescue progress; it is deliberately issued only after the formal observation.\"]}, \"applicability_conditions\": [{\"field\": \"overlap\", \"op\": \"eq\", \"value\": true, \"reference\": null}], \"admission_alias\": \"admit\"}]\nobservable_properties [{\"checker_id\": \"P-autoleave-cycle\", \"kind\": \"event_assertion\", \"trigger\": {\"field\": \"overlap\", \"op\": \"eq\", \"value\": true, \"reference\": null}, \"assertion\": {\"field\": \"forbidden_cycle\", \"op\": \"eq\", \"value\": false, \"reference\": null}, \"antecedent\": null, \"identity_fields\": [\"operation\"], \"description\": \"An admitted implicit transition must not remain joint in a closed, reliable, fully serviced periodic execution after transfer timeout. forbidden_cycle is the conjunction of actual structural state recurrence and the retained cycle diagnostics; no result is emitted merely for finite non-completion. Completion yields false and supports only this execution.\"}]\nprerequisites [{\"alias\": \"admit\", \"event\": \"joint_applied_before_advance\", \"conditions\": [{\"field\": \"overlap\", \"op\": \"eq\", \"value\": true, \"reference\": null}, {\"field\": \"auto_leave\", \"op\": \"eq\", \"value\": true, \"reference\": null}, {\"field\": \"transferee\", \"op\": \"eq\", \"value\": 2, \"reference\": null}, {\"field\": \"original_committed\", \"op\": \"eq\", \"value\": true, \"reference\": null}]}, {\"alias\": \"settled\", \"event\": \"after_transfer_timeout\", \"conditions\": [{\"field\": \"overlap\", \"op\": \"eq\", \"value\": true, \"reference\": null}, {\"field\": \"change_index\", \"op\": \"eq\", \"value\": null, \"reference\": \"admit.change_index\"}, {\"field\": \"term\", \"op\": \"eq\", \"value\": null, \"reference\": \"admit.term\"}, {\"field\": \"transferee\", \"op\": \"eq\", \"value\": 0, \"reference\": null}, {\"field\": \"role\", \"op\": \"eq\", \"value\": \"StateLeader\", \"reference\": null}, {\"field\": \"original_applied\", \"op\": \"eq\", \"value\": true, \"reference\": null}, {\"field\": \"dropped_timeout_now\", \"op\": \"eq\", \"value\": 1, \"reference\": null}, {\"field\": \"queue_length\", \"op\": \"eq\", \"value\": 0, \"reference\": null}, {\"field\": \"ready\", \"op\": \"eq\", \"value\": false, \"reference\": null}]}]\n","exit_code":0,"status":"completed"}}
