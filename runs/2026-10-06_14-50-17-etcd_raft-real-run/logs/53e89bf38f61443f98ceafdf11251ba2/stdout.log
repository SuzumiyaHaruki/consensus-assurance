ds',disposition='mapped',behavior_ids=['B-config','B-read'],reason='Commit follow-up differs from MsgAppResp path. Campaign exclusion of unapplied committed changes may rule out the suspicious history; investigate before constructing.',source_ids=['S-config','S-response','S-election'],high_consequence=False),dict(entry_point='raft.pendingReadIndexMessages across reset',disposition='deferred',reason='reset replaces readOnly but does not visibly clear the pre-commit queue; inspect request identity and subsequent release before alleging a defect.',source_ids=['S-reset','S-proposal','S-release'],high_consequence=True),dict(entry_point='MemoryStorage mutation and compaction',disposition='deferred',reason='Storage interface read; concrete mutation and compaction methods remain to be inspected.',source_ids=['S-storage'],high_consequence=True)]\nm=dict(version=1,target_profile=dict(system_boundary='Captured go.etcd.io/raft module implementing one Raft group per Node/RawNode; caller provides transport, durable persistence, ticks and state-machine application. In-repository storage and configuration helpers remain inside investigation scope.',protocol_contexts=['term and role','log prefix','applied membership including joint quorums'],external_interfaces=['Node','RawNode','Storage','Ready/Advance','ordered local storage messages'],ownership=['Node serializes raft state; RawNode requires caller serialization. Disk/network/application effects belong to embedding caller under documented duties.'],variants=['PreVote','CheckQuorum','ReadOnlySafe/ReadOnlyLeaseBased','AsyncStorageWrites','simple/joint membership'],source_ids=['S-api','S-async','S-node','S-storage']),activities=activities,behaviors=bs,facts=facts,surfaces=surfaces,core_overview=overview)\njson.dump(m,open('map.json','w'),indent=2)\nsub=dict(action='research',rationale='Record sourced two-core-path understanding and preserve concrete continuation and old-work leads before selecting a formal question.',map_path='map.json',sources=sources)\njson.dump(sub,open('submission.json','w'),indent=2)\nPY\npython3 build_map.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
