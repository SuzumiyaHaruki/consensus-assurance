"properties\": {\n    \"associations\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingAssociation\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Associations\",\n      \"type\": \"array\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"associations\",\n    \"id\",\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\",\n    \"description\",\n    \"pending\"\n  ],\n  \"title\": \"BindingDraft\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
