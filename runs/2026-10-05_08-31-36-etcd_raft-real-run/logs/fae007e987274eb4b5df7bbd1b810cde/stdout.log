-node-loop\",\n          \"S-proposal\",\n          \"S-ready\",\n          \"S-ready-build\",\n          \"S-replication\",\n          \"S-restore\",\n          \"S-send\",\n          \"S-storage\",\n          \"S-storage-resp\",\n          \"S-timeout\",\n          \"S-tracker\",\n          \"S-transfer\",\n          \"S-votes\"\n        ],\n        \"participants\": [\n          \"Leader\",\n          \"Transferee voter\",\n          \"Other voters\",\n          \"Embedding application\"\n        ],\n        \"objects\": [\n          \"Active joint configuration with AutoLeave\",\n          \"Empty leave-joint log proposal\",\n          \"Ready application completion\"\n        ],\n        \"contexts\": [\n          \"Serialized ordinary RawNode Ready/Advance\",\n          \"Leader remains in same term after unsuccessful transfer\",\n          \"Quiet client workload with required ticks and Ready processing continuing\"\n        ],\n        \"event_paths\": [\n          \"Commit and apply automatic joint-entry configuration\",\n          \"Start transfer before corresponding application completion acknowledgment\",\n          \"Advance while transfer active rejects automatic exit proposal\",\n          \"Transfer timeout clears leadTransferee; continue ticks, actual network messages and Ready handling\"\n        ],\n        \"activity_classes\": [\n          \"A4\",\n          \"A1\",\n          \"A2\"\n        ],\n        \"behavior_ids\": [\n          \"B-config\",\n          \"B-auto\",\n          \"B-recover\"\n        ],\n        \"fact_ids\": [\n          \"F-config\"\n        ],\n        \"supporting_behavior_ids\": {\n          \"B-transfer\": \"Supplies proposal suppression and timeout clearing.\",\n          \"B-apply\": \"Determines whether subsequent Ready completion invokes appliedTo.\",\n          \"B-io\": \"Defines legal persistence/completion order.\",\n          \"B-election\": \"Alternative successful-transfer/new-leader empty-entry application