e([]net.Conn, n),\n    75\t\t\tPeerReaders:        make([]*bufio.Reader, n),\n    76\t\t\tPeerWriters:        make([]*bufio.Writer, n),\n    77\t\t\tClientWriters:      make(map[int32]*bufio.Writer),\n    78\t\t\tConfig:             config,\n    79\t\t\tAlive:              make([]bool, n),\n    80\t\t\tPreferredPeerOrder: make([]int32, n),\n    81\t\n    82\t\t\tState:       state.InitState(),\n    83\t\t\tRPC:         fastrpc.NewTableId(defs.RPC_TABLE),\n    84\t\t\tStableStore: nil,\n    85\t\t\tStats:       &defs.Stats{make(map[string]int)},\n    86\t\t\tShutdown:    false,\n    87\t\t\tListener:    nil,\n    88\t\t\tProposeChan: make(chan *defs.GPropose, defs.CHAN_BUFFER_SIZE),\n    89\t\t\tBeaconChan:  make(chan *defs.GBeacon, defs.CHAN_BUFFER_SIZE),\n    90\t\n    91\t\t\tThrifty: thrifty,\n    92\t\t\tExec:    exec,\n    93\t\t\tLRead:   lread,\n    94\t\t\tDreply:  true,\n    95\t\t\tBeacon:  false,\n    96\t\t\tDurable: false,\n    97\t\n    98\t\t\tEwma:      make([]float64, n),\n    99\t\t\tLatencies: make([]int64, n),\n   100\t\n   101\t\t\tDt: defs.NewLatencyTable(defs.LatencyConf, defs.IP(), addrs),\n   102\t\t}\n   103\t\n   104\t\tfor i := 0; i < r.N; i++ {\n   105\t\t\tr.PreferredPeerOrder[i] = int32((int(r.Id) + 1 + i) % r.N)\n   106\t\t\tr.Ewma[i] = 0.0\n   107\t\t\tr.Latencies[i] = 0\n   108\t\t}\n   109\t\n   110\t\treturn r\n   111\t}\n   112\t\n   113\tfunc (r *Replica) Ping(args *defs.PingArgs, reply *defs.PingReply) error {\n   114\t\treturn nil\n   115\t}\n   116\t\n   117\tfunc (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n   118\t\treturn nil\n   119\t}\n   120\t\n   121\tfunc (r *Replica) FastQuorumSize() int {\n   122\t\treturn r.F + (r.F+1)/2\n   123\t}\n   124\t\n   125\tfunc (r *Replica) SlowQuorumSize() int {\n   126\t\treturn (r.N + 1) / 2\n   127\t}\n   128\t\n   129\tfunc (r *Replica) WriteQuorumSize() int {\n   130\t\treturn r.F + 1\n   131\t}\n   132\t\n   133\tfunc (r *Replica) ReadQuorumSize() int {\n   134\t\treturn r.N - r.F\n   135\t}\n   136\t\n   137\tfunc (r *Replica) ConnectToPeers() {\n   138\t\tvar b [4]byte\n   139\t\tbs := b[:4]\n   140\t\tdone := make(chan bool)\n   141\t\n   142\t\tgo r.waitForPeerConnections(done)\n   143\t\n   144\t\tfor i := 0; i < int(r.Id); i++ {\n   145\t\t\tfor {\n   146\t\t\t\tif conn, err := net.Dial(\"tcp\", r.PeerAddrList[i]); err == nil {\n   147\t\t\t\t\tr.Peers[i] = conn\n   148\t\t\t\t\tbreak\n   149\t\t\t\t}\n   150\t\t\t\ttime.Sleep(1e9)\n   151\t\t\t}\n   152\t\t\tbinary.LittleEndian.PutUint32(bs, uint32(r.Id))\n   153\t\t\tif _, err := r.Peers[i].Write(bs); err != nil {\n   154\t\t\t\tr.Println(\"Write id error:\", err)\n   155\t\t\t\tcontinue\n   156\t\t\t}\n   157\t\t\tr.Alive[i] = true\n   158\t\t\tr.PeerReaders[i] = bufio.NewReader(r.Peers[i])\n   159\t\t\tr.PeerWriters[i] = bufio.NewWriter(r.Peers[i])\n   160\t\t\tr.Printf(\"OUT Connected to %d\", i)\n   161\t\t}\n   162\t\t<-done\n   163\t\tr.Printf(\"Replica %d: done connecting to peers\", r.Id)\n   164\t\tr.Printf(\"Node list %v\", r.PeerAddrList)\n   165\t\n   166\t\tfor rid, reader := range r.PeerReaders {\n   167\t\t\tif int32(rid) == r.Id {\n   168\t\t\t\tcontinue\n   169\t\t\t}\n   170\t\t\tgo r.replicaListener(rid, reader)\n   202\tfunc (r *Replica) WaitForClientConnections() {\n   203\t\tr.Println(\"Waiting for client connections\")\n   204\t\n   205\t\tfor !r.Shutdown {\n   206\t\t\tconn, err := r.Listener.Accept()\n   207\t\t\tif err != nil {\n   208\t\t\t\tr.Println(\"Accept error:\", err)\n   209\t\t\t\tcontinue\n   210\t\t\t}\n   211\t\t\tgo r.clientListener(conn)\n   212\t\t}\n   213\t}\n   214\t\n   215\tfunc (r *Replica) SendMsg(peerId int32, code uint8, msg fastrpc.Serializable) {\n   216\t\tr.M.Lock()\n   217\t\tdefer r.M.Unlock()\n   218\t\n   219\t\tw := r.PeerWriters[peerId]\n   220\t\tif w == nil {\n   221\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   222\t\t\treturn\n   223\t\t}\n   224\t\tw.WriteByte(code)\n   225\t\tmsg.Marshal(w)\n   226\t\tw.Flush()\n   227\t}\n   228\t\n   229\tfunc (r *Replica) SendClientMsg(id int32, code uint8, msg fastrpc.Serializable) {\n   385\tfunc (r *Replica) waitForPeerConnections(done chan bool) {\n   386\t\tvar b [4]byte\n   387\t\tbs := b[:4]\n   388\t\n   389\t\tport := strings.Split(r.PeerAddrList[r.Id], \":\")[1]\n   390\t\tl, err := net.Listen(\"tcp\", \"0.0.0.0:\"+port)\n   391\t\tif err != nil {\n   392\t\t\tr.Fatal(r.PeerAddrList[r.Id], err)\n   393\t\t}\n   394\t\tr.Listener = l\n   395\t\tfor i := r.Id + 1; i < int32(r.N); i++ {\n   396\t\t\tconn, err := r.Listener.Accept()\n   397\t\t\tif err != nil {\n   398\t\t\t\tr.Println(\"Accept error:\", err)\n   399\t\t\t\tcontinue\n   400\t\t\t}\n   401\t\t\tif _, err := io.ReadFull(conn, bs); err != nil {\n   402\t\t\t\tr.Println(\"Connection establish error:\", err)\n   403\t\t\t\tcontinue\n   404\t\t\t}\n   405\t\t\tid := int32(binary.LittleEndian.Uint32(bs))\n   406\t\t\tr.Peers[id] = conn\n   407\t\t\tr.PeerReaders[id] = bufio.NewReader(conn)\n   408\t\t\tr.PeerWriters[id] = bufio.NewWriter(conn)\n   409\t\t\tr.Alive[id] = true\n   410\t\t\tr.Printf(\"IN Connected to %d\", id)\n   411\t\t}\n   412\t\n   413\t\tdone <- true\n   414\t}\n   415\t\n   416\tfunc (r *Replica) replicaListener(rid int, reader *bufio.Reader) {\n   417\t\tvar (\n   418\t\t\tmsgType      uint8\n   419\t\t\terr          error = nil\n   420\t\t\tgbeacon      defs.Beacon\n   421\t\t\tgbeaconReply defs.BeaconReply\n   422\t\t)\n   423\t\n   424\t\tfor err == nil && !r.Shutdown {\n   425\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   426\t\t\t\tbreak\n   427\t\t\t}\n   428\t\n   429\t\t\tswitch uint8(msgType) {\n   430\t\n   431\t\t\tcase defs.GENERIC_SMR_BEACON:\n   432\t\t\t\tif err = gbeacon.Unmarshal(reader); err != nil {\n   433\t\t\t\t\tbreak\n   434\t\t\t\t}\n   435\t\t\t\tr.ReplyBeacon(&defs.GBeacon{\n   436\t\t\t\t\tRid:       int32(rid),\n   437\t\t\t\t\tTimestamp: gbeacon.Timestamp,\n 