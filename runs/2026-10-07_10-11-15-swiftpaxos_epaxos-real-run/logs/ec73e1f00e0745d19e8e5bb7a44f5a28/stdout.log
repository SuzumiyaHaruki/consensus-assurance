{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/epaxos/epaxos.go | sed -n '580,825p'; nl -ba ../agent-source/epaxos/exec.go | sed -n '1,290p'\"","aggregated_output":"   580\t\t\t}\n   581\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.acceptRPC, ea)\n   582\t\t\tsent++\n   583\t\t\tif sent >= n {\n   584\t\t\t\tbreak\n   585\t\t\t}\n   586\t\t}\n   587\t}\n   588\t\n   589\tfunc (r *Replica) bcastCommit(replica int32, instance int32) {\n   590\t\tdefer func() {\n   591\t\t\tif err := recover(); err != nil {\n   592\t\t\t\tr.Println(\"Commit bcast failed:\", err)\n   593\t\t\t}\n   594\t\t}()\n   595\t\tlb := r.InstanceSpace[replica][instance].lb\n   596\t\tec := new(Commit)\n   597\t\tec.LeaderId = r.Id\n   598\t\tec.Replica = replica\n   599\t\tec.Instance = instance\n   600\t\tec.Command = lb.cmds\n   601\t\tec.Seq = lb.seq\n   602\t\tec.Deps = lb.deps\n   603\t\tec.Ballot = lb.ballot\n   604\t\n   605\t\tfor q := 0; q < r.N-1; q++ {\n   606\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   607\t\t\t\tcontinue\n   608\t\t\t}\n   609\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.commitRPC, ec)\n   610\t\t}\n   611\t}\n   612\t\n   613\tfunc (r *Replica) clearHashtables() {\n   614\t\tfor q := 0; q < r.N; q++ {\n   615\t\t\tr.conflicts[q] = make(map[state.Key]*InstPair, HT_INIT_SIZE)\n   616\t\t}\n   617\t}\n   618\t\n   619\tfunc (r *Replica) updateCommitted(replica int32) {\n   620\t\tr.M.Lock()\n   621\t\tfor r.InstanceSpace[replica][r.CommittedUpTo[replica]+1] != nil &&\n   622\t\t\t(r.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == COMMITTED ||\n   623\t\t\t\tr.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == EXECUTED) {\n   624\t\t\tr.CommittedUpTo[replica] = r.CommittedUpTo[replica] + 1\n   625\t\t}\n   626\t\tr.M.Unlock()\n   627\t}\n   628\t\n   629\tfunc (r *Replica) updateConflicts(cmds []state.Command, replica int32, instance int32, seq int32) {\n   630\t\tfor i := 0; i < len(cmds); i++ {\n   631\t\t\tif dpair, present := r.conflicts[replica][cmds[i].K]; present {\n   632\t\t\t\tif dpair.last < instance {\n   633\t\t\t\t\tr.conflicts[replica][cmds[i].K].last = instance\n   634\t\t\t\t}\n   635\t\t\t\tif dpair.lastWrite < instance && cmds[i].Op != state.GET {\n   636\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   637\t\t\t\t}\n   638\t\t\t} else {\n   639\t\t\t\tr.conflicts[replica][cmds[i].K] = &InstPair{\n   640\t\t\t\t\tlast:      instance,\n   641\t\t\t\t\tlastWrite: -1,\n   642\t\t\t\t}\n   643\t\t\t\tif cmds[i].Op != state.GET {\n   644\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   645\t\t\t\t}\n   646\t\t\t}\n   647\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   648\t\t\t\tif s < seq {\n   649\t\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   650\t\t\t\t}\n   651\t\t\t} else {\n   652\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   653\t\t\t}\n   654\t\t}\n   655\t}\n   656\t\n   657\tfunc (r *Replica) updateAttributes(cmds []state.Command, seq int32, deps []int32, replica int32, instance int32) (int32, []int32, bool) {\n   658\t\tchanged := false\n   659\t\tfor q := 0; q < r.N; q++ {\n   660\t\t\tif r.Id != replica && int32(q) == replica {\n   661\t\t\t\tcontinue\n   662\t\t\t}\n   663\t\t\tfor i := 0; i < len(cmds); i++ {\n   664\t\t\t\tif dpair, present := (r.conflicts[q])[cmds[i].K]; present {\n   665\t\t\t\t\td := dpair.lastWrite\n   666\t\t\t\t\tif cmds[i].Op != state.GET {\n   667\t\t\t\t\t\td = dpair.last\n   668\t\t\t\t\t}\n   669\t\n   670\t\t\t\t\tif d > deps[q] {\n   671\t\t\t\t\t\tdeps[q] = d\n   672\t\t\t\t\t\tif seq <= r.InstanceSpace[q][d].Seq {\n   673\t\t\t\t\t\t\tseq = r.InstanceSpace[q][d].Seq + 1\n   674\t\t\t\t\t\t}\n   675\t\t\t\t\t\tchanged = true\n   676\t\t\t\t\t\tbreak\n   677\t\t\t\t\t}\n   678\t\t\t\t}\n   679\t\t\t}\n   680\t\t}\n   681\t\tfor i := 0; i < len(cmds); i++ {\n   682\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   683\t\t\t\tif seq <= s {\n   684\t\t\t\t\tchanged = true\n   685\t\t\t\t\tseq = s + 1\n   686\t\t\t\t}\n   687\t\t\t}\n   688\t\t}\n   689\t\n   690\t\treturn seq, deps, changed\n   691\t}\n   692\t\n   693\tfunc (r *Replica) mergeAttributes(seq1 int32, deps1 []int32, seq2 int32, deps2 []int32) (int32, []int32, bool) {\n   694\t\tequal := true\n   695\t\tif seq1 != seq2 {\n   696\t\t\tequal = false\n   697\t\t\tif seq2 > seq1 {\n   698\t\t\t\tseq1 = seq2\n   699\t\t\t}\n   700\t\t}\n   701\t\tfor q := 0; q < r.N; q++ {\n   702\t\t\tif int32(q) == r.Id {\n   703\t\t\t\tcontinue\n   704\t\t\t}\n   705\t\t\tif deps1[q] != deps2[q] {\n   706\t\t\t\tequal = false\n   707\t\t\t\tif deps2[q] > deps1[q] {\n   708\t\t\t\t\tdeps1[q] = deps2[q]\n   709\t\t\t\t}\n   710\t\t\t}\n   711\t\t}\n   712\t\treturn seq1, deps1, equal\n   713\t}\n   714\t\n   715\tfunc equal(deps1 []int32, deps2 []int32) bool {\n   716\t\tfor i := 0; i < len(deps1); i++ {\n   717\t\t\tif deps1[i] != deps2[i] {\n   718\t\t\t\treturn false\n   719\t\t\t}\n   720\t\t}\n   721\t\treturn true\n   722\t}\n   723\t\n   724\tfunc (r *Replica) handlePropose(propose *defs.GPropose) {\n   725\t\t//TODO!! Handle client retries\n   726\t\n   727\t\tbatchSize := len(r.ProposeChan) + 1\n   728\t\tr.M.Lock()\n   729\t\tr.Stats.M[\"totalBatching\"]++\n   730\t\tr.Stats.M[\"totalBatchingSize\"] += batchSize\n   731\t\tr.M.Unlock()\n   732\t\n   733\t\tr.crtInstance[r.Id]++\n   734\t\n   735\t\tcmds := make([]state.Command, batchSize)\n   736\t\tproposals := make([]*defs.GPropose, batchSize)\n   737\t\tcmds[0] = propose.Command\n   738\t\tproposals[0] = propose\n   739\t\tfor i := 1; i < batchSize; i++ {\n   740\t\t\tprop := <-r.ProposeChan\n   741\t\t\tcmds[i] = prop.Command\n   742\t\t\tproposals[i] = prop\n   743\t\t}\n   744\t\n   745\t\tr.startPhase1(cmds, r.Id, r.crtInstance[r.Id], r.Id, proposals)\n   746\t\n   747\t\tcpcounter += len(cmds)\n   748\t\n   749\t}\n   750\t\n   751\tfunc (r *Replica) startPhase1(cmds []state.Command, replica int32, instance int32, ballot int32, proposals []*defs.GPropose) {\n   752\t\t// init command attributes\n   753\t\tseq := int32(0)\n   754\t\tdeps := make([]int32, r.N)\n   755\t\tfor q := 0; q < r.N; q++ {\n   756\t\t\tdeps[q] = -1\n   757\t\t}\n   758\t\tseq, deps, _ = r.updateAttributes(cmds, seq, deps, replica, instance)\n   759\t\tcomDeps := make([]int32, r.N)\n   760\t\tfor i := 0; i < r.N; i++ {\n   761\t\t\tcomDeps[i] = -1\n   762\t\t}\n   763\t\n   764\t\tinst := r.newInstance(replica, instance, cmds, ballot, ballot, PREACCEPTED, seq, deps)\n   765\t\tinst.lb = r.newLeaderBookkeeping(proposals, deps, comDeps, deps, ballot, cmds, PREACCEPTED, -1)\n   766\t\tr.InstanceSpace[replica][instance] = inst\n   767\t\n   768\t\tr.updateConflicts(cmds, replica, instance, seq)\n   769\t\n   770\t\tif seq >= r.maxSeq {\n   771\t\t\tr.maxSeq = seq\n   772\t\t}\n   773\t\n   774\t\tr.recordInstanceMetadata(r.InstanceSpace[r.Id][instance])\n   775\t\tr.recordCommands(cmds)\n   776\t\tr.sync()\n   777\t\n   778\t\tr.bcastPreAccept(replica, instance)\n   779\t}\n   780\t\n   781\tfunc (r *Replica) handlePreAccept(preAccept *PreAccept) {\n   782\t\tinst := r.InstanceSpace[preAccept.Replica][preAccept.Instance]\n   783\t\n   784\t\tif preAccept.Seq >= r.maxSeq {\n   785\t\t\tr.maxSeq = preAccept.Seq + 1\n   786\t\t}\n   787\t\n   788\t\tif preAccept.Ballot > r.maxRecvBallot {\n   789\t\t\tr.maxRecvBallot = preAccept.Ballot\n   790\t\t}\n   791\t\n   792\t\tif preAccept.Instance > r.crtInstance[preAccept.Replica] {\n   793\t\t\tr.crtInstance[preAccept.Replica] = preAccept.Instance\n   794\t\t}\n   795\t\n   796\t\tif inst == nil {\n   797\t\t\tinst = r.newInstanceDefault(preAccept.Replica, preAccept.Instance)\n   798\t\t\tr.InstanceSpace[preAccept.Replica][preAccept.Instance] = inst\n   799\t\t}\n   800\t\n   801\t\tif inst != nil && preAccept.Ballot < inst.bal {\n   802\t\t\treturn\n   803\t\t}\n   804\t\n   805\t\tinst.bal = preAccept.Ballot\n   806\t\n   807\t\tif inst.Status >= ACCEPTED {\n   808\t\t\tif inst.Cmds == nil {\n   809\t\t\t\tr.InstanceSpace[preAccept.LeaderId][preAccept.Instance].Cmds = preAccept.Command\n   810\t\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n   811\t\t\t\tr.recordCommands(preAccept.Command)\n   812\t\t\t\tr.sync()\n   813\t\t\t}\n   814\t\n   815\t\t} else {\n   816\t\t\tseq, deps, changed := r.updateAttributes(preAccept.Command, preAccept.Seq, preAccept.Deps, preAccept.Replica, preAccept.Instance)\n   817\t\t\tstatus := PREACCEPTED_EQ\n   818\t\t\tif changed {\n   819\t\t\t\tstatus = PREACCEPTED\n   820\t\t\t}\n   821\t\t\tinst.Cmds = preAccept.Command\n   822\t\t\tinst.Seq = seq\n   823\t\t\tinst.Deps = deps\n   824\t\t\tinst.bal = preAccept.Ballot\n   825\t\t\tinst.vbal = preAccept.Ballot\n     1\tpackage epaxos\n     2\t\n     3\timport (\n     4\t\t\"sort\"\n     5\t\n     6\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n     7\t\t\"github.com/imdea-software/swiftpaxos/state\"\n     8\t)\n     9\t\n    10\tconst (\n    11\t\tWHITE int8 = iota\n    12\t\tGRAY\n    13\t\tBLACK\n    14\t)\n    15\t\n    16\ttype Exec struct {\n    17\t\tr *Replica\n    18\t}\n    19\t\n    20\ttype SCComponent struct {\n    21\t\tnodes []*Instance\n    22\t\tcolor int8\n    23\t}\n    24\t\n    25\tfunc (e *Exec) executeCommand(replica int32, instance int32) bool {\n    26\t\tif e.r.InstanceSpace[replica][instance] == nil {\n    27\t\t\treturn false\n    28\t\t}\n    29\t\tinst := e.r.InstanceSpace[replica][instance]\n    30\t\tif inst.Status == EXECUTED {\n    31\t\t\treturn true\n    32\t\t}\n    33\t\tif inst.Status != COMMITTED {\n    34\t\t\treturn false\n    35\t\t}\n    36\t\n    37\t\tif !e.findSCC(inst) {\n    38\t\t\treturn false\n    39\t\t}\n    40\t\n    41\t\treturn true\n    42\t}\n    43\t\n    44\tvar stack []*Instance = make([]*Instance, 0, 100)\n    45\t\n    46\tfunc (e *Exec) findSCC(root *Instance) bool {\n    47\t\tindex := 1\n    48\t\t// find SCCs using Tarjan's algorithm\n    49\t\tstack = stack[0:0]\n    50\t\tret := e.strongconnect(root, &index)\n    51\t\t// reset all indexes in the stack\n    52\t\tfor j := 0; j < len(stack); j++ {\n    53\t\t\tstack[j].Index = 0\n    54\t\t}\n    55\t\treturn ret\n    56\t}\n    57\t\n    58\tfunc (e *Exec) strongconnect(v *Instance, index *int) bool {\n    59\t\tv.Index = *index\n    60\t\tv.Lowlink = *index\n    61\t\t*index = *index + 1\n    62\t\n    63\t\tl := len(stack)\n    64\t\tif l == cap(stack) {\n    65\t\t\tnewSlice := make([]*Instance, l, 2*l)\n    66\t\t\tcopy(newSlice, stack)\n    67\t\t\tstack = newSlice\n    68\t\t}\n    69\t\tstack = stack[0 : l+1]\n    70\t\tstack[l] = v\n    71\t\n    72\t\tif v.Cmds == nil {\n    73\t\t\treturn false\n    74\t\t}\n    75\t\n    76\t\tfor q := int32(0); q < int32(e.r.N); q++ {\n    77\t\t\tinst := v.Deps[q]\n    78\t\t\tfor i := e.r.ExecedUpTo[q] + 1; i <= inst; i++ {\n    79\t\t\t\tif e.r.InstanceSpace[q][i] == nil || e.r.InstanceSpace[q][i].Cmds == nil {\n    80\t\t\t\t\treturn false\n    81\t\t\t\t}\n    82\t\n    83\t\t\t\tif e.r.transconf {\n    84\t\t\t\t\tfor _, alpha := range v.Cmds {\n    85\t\t\t\t\t\tfor _, beta := range e.r.InstanceSpace[q][i].Cmds {\n    86\t\t\t\t\t\t\tif !state.Conflict(&alpha, &beta) {\n    87\t\t\t\t\t\t\t\tcontinue\n    88\t\t\t\t\t\t\t}\n    89\t\t\t\t\t\t}\n    90\t\t\t\t\t}\n    91\t\t\t\t}\n    92\t\n    93\t\t\t\tif e.r.InstanceSpace[q][i].Status == EXECUTED {\n    94\t\t\t\t\tcontinue\n    95\t\t\t\t}\n    96\t\n    97\t\t\t\tfor e.r.InstanceSpace[q][i].Status != COMMITTED {\n    98\t\t\t\t\treturn false\n    99\t\t\t\t}\n   100\t\n   101\t\t\t\tw := e.r.InstanceSpace[q][i]\n   102\t\n   103\t\t\t\tif w.Index == 0 {\n   104\t\t\t\t\tif !e.strongconnect(w, index) {\n   105\t\t\t\t\t\treturn false\n   106\t\t\t\t\t}\n   107\t\t\t\t\tif w.Lowlink < v.Lowlink {\n   108\t\t\t\t\t\tv.Lowlink = w.Lowlink\n   109\t\t\t\t\t}\n   110\t\t\t\t} else if e.inStack(w) {\n   111\t\t\t\t\tif w.Index < v.Lowlink {\n   112\t\t\t\t\t\tv.Lowlink = w.Index\n   113\t\t\t\t\t}\n   114\t\t\t\t}\n   115\t\t\t}\n   116\t\t}\n   117\t\n   118\t\tif v.Lowlink == v.Index {\n   119\t\t\t//found SCC\n   120\t\t\tlist := stack[l:]\n   121\t\n   122\t\t\t//execute commands in the increasing order of the Seq field\n   123\t\t\tsort.Sort(nodeArray(list))\n   124\t\t\tfor _, w := range list {\n   125\t\t\t\tfor idx := 0; idx < len(w.Cmds); idx++ {\n   126\t\t\t\t\tshouldRespond := e.r.Dreply && w.lb != nil && w.lb.clientProposals != nil\n   127\t\t\t\t\tif w.Cmds[idx].Op == state.NONE {\n   128\t\t\t\t\t\t// nothing to do\n   129\t\t\t\t\t} else if shouldRespond {\n   130\t\t\t\t\t\tval := w.Cmds[idx].Execute(e.r.State)\n   131\t\t\t\t\t\te.r.ReplyProposeTS(\n   132\t\t\t\t\t\t\t&defs.ProposeReplyTS{\n   133\t\t\t\t\t\t\t\tTRUE,\n   134\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].CommandId,\n   135\t\t\t\t\t\t\t\tval,\n   136\t\t\t\t\t\t\t\tw.lb.clientProposals[idx].Timestamp},\n   137\t\t\t\t\t\t\tw.lb.clientProposals[idx].Reply,\n   138\t\t\t\t\t\t\tw.lb.clientProposals[idx].Mutex)\n   139\t\t\t\t\t} else if w.Cmds[idx].Op == state.PUT {\n   140\t\t\t\t\t\tw.Cmds[idx].Execute(e.r.State)\n   141\t\t\t\t\t}\n   142\t\t\t\t}\n   143\t\t\t\tw.Status = EXECUTED\n   144\t\t\t}\n   145\t\t\tstack = stack[0:l]\n   146\t\t}\n   147\t\n   148\t\treturn true\n   149\t}\n   150\t\n   151\tfunc (e *Exec) inStack(w *Instance) bool {\n   152\t\tfor _, u := range stack {\n   153\t\t\tif w == u {\n   154\t\t\t\treturn true\n   155\t\t\t}\n   156\t\t}\n   157\t\treturn false\n   158\t}\n   159\t\n   160\ttype nodeArray []*Instance\n   161\t\n   162\tfunc (na nodeArray) Len() int {\n   163\t\treturn len(na)\n   164\t}\n   165\t\n   166\tfunc (na nodeArray) Less(i, j int) bool {\n   167\t\treturn na[i].Seq < na[j].Seq || (na[i].Seq == na[j].Seq && na[i].id.replica < na[j].id.replica) || (na[i].Seq == na[j].Seq && na[i].id.replica == na[j].id.replica && na[i].proposeTime < na[j].proposeTime)\n   168\t}\n   169\t\n   170\tfunc (na nodeArray) Swap(i, j int) {\n   171\t\tna[i], na[j] = na[j], na[i]\n   172\t}\n","exit_code":0,"status":"completed"}}
