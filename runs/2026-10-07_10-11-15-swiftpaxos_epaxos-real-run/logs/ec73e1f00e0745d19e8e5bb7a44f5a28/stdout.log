{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\ns=json.load(open('../product-schemas.json')); print(list(s))\nt=json.load(open('../submission.schema.json'))\nfor k in ['ResearchSubmission','ResearchFeedback','SourceRange']:\n print(k,json.dumps(t['\"'$defs'\"'][k],indent=2))\nPY\"","aggregated_output":"['DirectCheckPlan', 'ConsensusAuditSpec', 'GraphPatch', 'ScopeUpdate', 'Feedback']\nResearchSubmission {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"const\": \"research\",\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"graph_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Graph Path\"\n    },\n    \"scope_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Scope Path\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\"\n  ],\n  \"title\": \"ResearchSubmission\",\n  \"type\": \"object\"\n}\nResearchFeedback {\n  \"additionalProperties\": false,\n  \"description\": \"New sourced answers and next discriminators; historical remaining is not current pending work.\",\n  \"properties\": {\n    \"ref_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Ref Ids\",\n      \"type\": \"array\"\n    },\n    \"answered\": {\n      \"minLength\": 1,\n      \"title\": \"Answered\",\n      \"type\": \"string\"\n    },\n    \"remaining\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Remaining\",\n      \"type\": \"array\"\n    },\n    \"understanding\": {\n      \"anyOf\": [\n        {\n          \"enum\": [\n            \"updated\",\n            \"unchanged\",\n            \"deferred\"\n          ],\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Research understanding across turns, not a declaration that this submission changes the map\",\n      \"title\": \"Understanding\"\n    },\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"question_updates\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/QuestionUpdate\"\n      },\n      \"default\": {},\n      \"title\": \"Question Updates\",\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"ref_ids\",\n    \"answered\",\n    \"remaining\",\n    \"rationale\"\n  ],\n  \"title\": \"ResearchFeedback\",\n  \"type\": \"object\"\n}\nSourceRange {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"file\": {\n      \"title\": \"File\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"document_statement\",\n        \"interface_statement\",\n        \"test_expectation\",\n        \"code_observation\",\n        \"protocol_candidate\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"file\",\n    \"start_line\",\n    \"end_line\",\n    \"kind\"\n  ],\n  \"title\": \"SourceRange\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
