tivity', 'execution_owner', 'protocol_context', 'trigger', 'source_ids'] fields= ['id', 'primary_activity', 'execution_owner', 'protocol_context', 'trigger', 'legal_preconditions', 'implementation_guards', 'reads', 'writes', 'durable_effects', 'external_effects', 'important_branches', 'async_boundaries', 'produces_fact_ids', 'consumes_fact_ids', 'cross_activity_effects', 'existing_protections', 'source_ids', 'unknowns']\nCoreOverview required= ['rationale'] fields= ['formation', 'context', 'connection', 'open_details', 'core_gaps', 'status', 'rationale']\nCorePath required= None fields= ['explanation', 'behavior_ids', 'fact_ids', 'source_ids']\nFact required= ['id', 'meaning', 'identity', 'validity_context', 'representation', 'durability', 'recovery', 'source_ids'] fields= ['id', 'meaning', 'identity', 'established_by', 'consumed_by', 'validity_context', 'representation', 'invalidators', 'reinterpreters', 'durability', 'recovery', 'source_ids', 'unknowns']\nSurface required= ['entry_point', 'disposition', 'reason'] fields= ['entry_point', 'disposition', 'behavior_ids', 'reason', 'source_ids', 'high_consequence']\nTargetProfile required= ['system_boundary'] fields= ['system_boundary', 'protocol_contexts', 'external_interfaces', 'ownership', 'selection_injection', 'variants', 'source_ids', 'unknowns']\n","exit_code":0,"status":"completed"}}
