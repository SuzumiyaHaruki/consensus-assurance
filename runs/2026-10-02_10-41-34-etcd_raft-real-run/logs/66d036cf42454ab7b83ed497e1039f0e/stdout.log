{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '248,257p' ../agent-source/tracker/progress.go; sed -n '180,185p' ../agent-source/raft.go; sed -n '285,299p' ../agent-source/log.go; sed -n '188,202p' ../agent-source/log_unstable.go; sed -n '291,333p' ../agent-source/raft.go; sed -n '1,110p' ../agent-source/confchange/restore.go\"","aggregated_output":"\n\tpr.Next = max(min(rejected, matchHint+1), pr.Match+1)\n\t// Regress the sentCommit since it unlikely has been applied.\n\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n\tpr.MsgAppFlowPaused = false\n\treturn true\n}\n\n// IsPaused returns whether sending log entries to this node has been throttled.\n// This is done when a node has rejected recent MsgApps, is currently waiting\n\t// delivered after the corresponding storage write has been completed. These\n\t// responses may target the same node or may target other nodes. The storage\n\t// threads are not responsible for understanding the response messages, only\n\t// for delivering them to the correct target after performing the storage\n\t// write.\n\tAsyncStorageWrites bool\n// hasNextOrInProgressSnapshot returns if there is pending snapshot waiting for\n// applying or in the process of being applied.\nfunc (l *raftLog) hasNextOrInProgressSnapshot() bool {\n\treturn l.unstable.snapshot != nil\n}\n\nfunc (l *raftLog) snapshot() (pb.Snapshot, error) {\n\tif l.unstable.snapshot != nil {\n\t\treturn *l.unstable.snapshot, nil\n\t}\n\treturn l.storage.Snapshot()\n}\n\nfunc (l *raftLog) firstIndex() uint64 {\n\tif i, ok := l.unstable.maybeFirstIndex(); ok {\nfunc (u *unstable) restore(s pb.Snapshot) {\n\tu.offset = s.Metadata.Index + 1\n\tu.offsetInProgress = u.offset\n\tu.entries = nil\n\tu.snapshot = &s\n\tu.snapshotInProgress = false\n}\n\nfunc (u *unstable) truncateAndAppend(ents []pb.Entry) {\n\tfromIndex := ents[0].Index\n\tswitch {\n\tcase fromIndex == u.offset+uint64(len(u.entries)):\n\t\t// fromIndex is the next index in the u.entries, so append directly.\n\t\tu.entries = append(u.entries, ents...)\n\tcase fromIndex <= u.offset:\nfunc (c *Config) validate() error {\n\tif c.ID == None {\n\t\treturn errors.New(\"cannot use none as id\")\n\t}\n\tif IsLocalMsgTarget(c.ID) {\n\t\treturn errors.New(\"cannot use local target as id\")\n\t}\n\n\tif c.HeartbeatTick <= 0 {\n\t\treturn errors.New(\"heartbeat tick must be greater than 0\")\n\t}\n\n\tif c.ElectionTick <= c.HeartbeatTick {\n\t\treturn errors.New(\"election tick must be greater than heartbeat tick\")\n\t}\n\n\tif c.Storage == nil {\n\t\treturn errors.New(\"storage cannot be nil\")\n\t}\n\n\tif c.MaxUncommittedEntriesSize == 0 {\n\t\tc.MaxUncommittedEntriesSize = noLimit\n\t}\n\n\t// default MaxCommittedSizePerReady to MaxSizePerMsg because they were\n\t// previously the same parameter.\n\tif c.MaxCommittedSizePerReady == 0 {\n\t\tc.MaxCommittedSizePerReady = c.MaxSizePerMsg\n\t}\n\n\tif c.MaxInflightMsgs <= 0 {\n\t\treturn errors.New(\"max inflight messages must be greater than 0\")\n\t}\n\tif c.MaxInflightBytes == 0 {\n\t\tc.MaxInflightBytes = noLimit\n\t} else if c.MaxInflightBytes < c.MaxSizePerMsg {\n\t\treturn errors.New(\"max inflight bytes must be >= max message size\")\n\t}\n\n\tif c.Logger == nil {\n\t\tc.Logger = getLogger()\n\t}\n\n// Copyright 2019 The etcd Authors\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n\npackage confchange\n\nimport (\n\tpb \"go.etcd.io/raft/v3/raftpb\"\n\t\"go.etcd.io/raft/v3/tracker\"\n)\n\n// toConfChangeSingle translates a conf state into 1) a slice of operations creating\n// first the config that will become the outgoing one, and then the incoming one, and\n// b) another slice that, when applied to the config resulted from 1), represents the\n// ConfState.\nfunc toConfChangeSingle(cs pb.ConfState) (out []pb.ConfChangeSingle, in []pb.ConfChangeSingle) {\n\t// Example to follow along this code:\n\t// voters=(1 2 3) learners=(5) outgoing=(1 2 4 6) learners_next=(4)\n\t//\n\t// This means that before entering the joint config, the configuration\n\t// had voters (1 2 4 6) and perhaps some learners that are already gone.\n\t// The new set of voters is (1 2 3), i.e. (1 2) were kept around, and (4 6)\n\t// are no longer voters; however 4 is poised to become a learner upon leaving\n\t// the joint state.\n\t// We can't tell whether 5 was a learner before entering the joint config,\n\t// but it doesn't matter (we'll pretend that it wasn't).\n\t//\n\t// The code below will construct\n\t// outgoing = add 1; add 2; add 4; add 6\n\t// incoming = remove 1; remove 2; remove 4; remove 6\n\t//            add 1;    add 2;    add 3;\n\t//            add-learner 5;\n\t//            add-learner 4;\n\t//\n\t// So, when starting with an empty config, after applying 'outgoing' we have\n\t//\n\t//   quorum=(1 2 4 6)\n\t//\n\t// From which we enter a joint state via 'incoming'\n\t//\n\t//   quorum=(1 2 3)&&(1 2 4 6) learners=(5) learners_next=(4)\n\t//\n\t// as desired.\n\n\tfor _, id := range cs.VotersOutgoing {\n\t\t// If there are outgoing voters, first add them one by one so that the\n\t\t// (non-joint) config has them all.\n\t\tout = append(out, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddNode,\n\t\t\tNodeID: id,\n\t\t})\n\n\t}\n\n\t// We're done constructing the outgoing slice, now on to the incoming one\n\t// (which will apply on top of the config created by the outgoing slice).\n\n\t// First, we'll remove all of the outgoing voters.\n\tfor _, id := range cs.VotersOutgoing {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeRemoveNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\t// Then we'll add the incoming voters and learners.\n\tfor _, id := range cs.Voters {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\tfor _, id := range cs.Learners {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddLearnerNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\t// Same for LearnersNext; these are nodes we want to be learners but which\n\t// are currently voters in the outgoing config.\n\tfor _, id := range cs.LearnersNext {\n\t\tin = append(in, pb.ConfChangeSingle{\n\t\t\tType:   pb.ConfChangeAddLearnerNode,\n\t\t\tNodeID: id,\n\t\t})\n\t}\n\treturn out, in\n}\n\nfunc chain(chg Changer, ops ...func(Changer) (tracker.Config, tracker.ProgressMap, error)) (tracker.Config, tracker.ProgressMap, error) {\n\tfor _, op := range ops {\n\t\tcfg, trk, err := op(chg)\n\t\tif err != nil {\n\t\t\treturn tracker.Config{}, nil, err\n\t\t}\n\t\tchg.Tracker.Config = cfg\n\t\tchg.Tracker.Progress = trk\n\t}\n\treturn chg.Tracker.Config, chg.Tracker.Progress, nil\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k)); return i\nfor args in [('campaign','raft.go',973,1083),('step-vote','raft.go',1178,1263),('leader-admit','raft.go',1267,1374),('leader-match','raft.go',1500,1570),('leader-other','raft.go',1571,1663),('candidate-follower','raft.go',1668,1773),('append-receive','raft.go',1776,1832),('send-replication','raft.go',616,738),('ticks','raft.go',850,889),('snapshot-restore','raft.go',1835,1945),('config-activate','raft.go',1947,2040),('startup','raft.go',437,496),('apply-progress','raft.go',740,773),('read-release','raft.go',2062,2084),('read-pending','raft.go',2123,2158),('log-start-append','log.go',71,139),('log-apply','log.go',213,298),('log-commit-apply','log.go',320,363),('log-eligibility','log.go',440,468),('majority','quorum/majority.go',116,196),('joint','quorum/joint.go',17,76),('tracker-commit','tracker/tracker.go',156,182),('tracker-votes','tracker/tracker.go',206,280),('progress-update','tracker/progress.go',202,254),('config-change','confchange/confchange.go',36,355),('config-restore','confchange/restore.go',23,155),('node-loop','node.go',348,459),('read-tracking','read_only.go',19,130),('unstable-stable','log_unstable.go',128,160),('unstable-snapshot','log_unstable.go',181,194),('storage-memory','storage.go',96,155),('storage-snap-append','storage.go',197,310),('bootstrap','bootstrap.go',25,80),('storage-tail','rawnode.go',328,399)]: src(*args)\nsrc('async-contract','raft.go',151,185,'interface_statement')\nsrc('mode-contract','raft.go',222,285,'interface_statement')\nsrc('storage-contract','storage.go',40,90,'interface_statement')\nsrc('conf-contract','node.go',179,187,'interface_statement')\nB=[]\ndef b(i,a,owner,ctx,trig,s,prod=[],cons=[],**kw):\n B.append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=s,produces_fact_ids=prod,consumes_fact_ids=cons,**kw))\nb('B-entry','A7','RawNode caller or node.run goroutine','One raft instance; caller serializes RawNode access','Propose, Step, Tick, Ready and Advance',['entry','node-loop','ready-contract'],external_effects=['Propose invokes MsgProp and reports admission/dispatch, not application completion. Node.run serializes incoming channels; it can defer proposals when no leader is known.'],legal_preconditions=['Storage, transport and application implement the Ready contract.'],important_branches=['RawNode.Step rejects unknown peer responses and unexpected network-local messages. Node.run separately filters unknown responses.'])\nb('B-propose','A1','raft.stepLeader / stepFollower','Current leader term and active progress map','MsgProp',['leader-admit','candidate-follower','reset-append','send-replication'],prod=['F-app-queued'],cons=['F-leader'],implementation_guards=['Reject empty proposal; drop if leader removed, transfer pending, or uncommitted quota exceeded. Followers forward only with known leader and forwarding enabled; candidates drop.'],writes=['Assign entry term/index and append unstable suffix; queue self MsgAppResp and replicate to peers.'],important_branches=['Configuration proposals may become empty normal entries under pending/joint checks; DisableConfChangeValidation bypasses those checks.'],async_boundaries=['Self append reply is queued after append; outbound replication does not itself establish peer acceptance.'])\nb('B-follower-append','A1','raft.handleAppendEntries and raftLog.maybeAppend','Follower after Step term dispatch','MsgApp',['append-receive','log-start-append','candidate-follower'],prod=['F-app-queued','F-committed'],implementation_guards=['Previous index/term must match unless below already committed index; conflicting committed entries panic.'],writes=['Append conflicting uncommitted suffix and advance commit to min(advertised commit,last new index); queue affirmative append reply.'],important_branches=['Previous index below committed replies with committed index. Mismatch yields rejection with conflict hint, not affirmative acceptance.'])\nb('B-storage-release','A6','raft.send and RawNode Ready/Advance; external storage worker','Ready generation and local append response term','Queued append/vote responses or pending unstable state',['reply-queue','storage-envelope','storage-tail','apply-accept','advance','async-contract','ready-release','term-filter','step-vote','unstable-stable'],cons=['F-app-queued','F-vote-queued'],implementation_guards=['Async envelope response includes current raft term and last unstable entry identity; stale append response cannot stabilize entries. stableTo also checks entry index/term.'],writes=['Ready drains response queues; synchronous Advance steps self responses; accepted storage response trims unstable entries.'],external_effects=['Remote responses are exposed under caller persistence-before-delivery contract; library does not perform disk writes.'],important_branches=['Synchronous remote responses are Ready.Messages; async responses ride MsgStorageAppend. Old-term snapshot completion is still handled.'],cross_activity_effects={'A1':'Append support is withheld from publication/self-consumption until the embedding storage contract is satisfied.','A2':'Vote responses are subject to the same durability handoff, while entry stability uses current term to reject obsolete completion.'})\nb('B-aggregate','A1','raft.stepLeader, tracker, quorum and raftLog','Current leader term and active incoming/outgoing voter sets','Successful MsgAppResp or configuration-triggered maybeCommit',['leader-match','tracker-commit','majority','joint','progress-update','reset-append','log-eligibility','config-activate'],prod=['F-match','F-committed'],cons=['F-app-queued','F-leader'],implementation_guards=['Step term dispatch and tracked sender precede response consumption; MaybeUpdate only increases Match. Aggregate only voter IDs; joint committed index is minimum of both majority indexes. maybeCommit requires a nonzero current-term entry at aggregate index.'],writes=['Update Match, flow control and committed index; broadcast advancement.'],important_branches=['Rejected append adjusts Next under stale-rejection checks, then retries; does not establish Match.'],existing_protections=['A same-index successful probe response may restore replication even without increasing Match.'])\nb('B-campaign','A2','raft.hup/campaign and Step vote branch','Current term, vote and local configuration','Tick timeout, Campaign or transfer TimeoutNow; incoming vote request',['campaign','step-vote','ticks','roles','log-eligibility','snapshot-restore'],prod=['F-vote-queued'],implementation_guards=['Local campaigning requires nonlearner progress and no pending snapshot or unapplied committed configuration changes. Vote grant requires canVote and lexicographic last term/index freshness.'],writes=['Real campaign increments term and self-votes; pre-campaign leaves term/vote unchanged. Queue self response; send requests to union of voter IDs.'],important_branches=['Learners may answer vote requests; only the candidate voter configuration determines whether their votes count. Pre-votes do not record durable Vote.'])\nb('B-election-result','A2','raft.stepCandidate and ProgressTracker','Candidate state and expected vote response type','Vote or pre-vote response',['candidate-follower','campaign','tracker-votes','majority','joint','roles'],prod=['F-leader'],cons=['F-vote-queued'],implementation_guards=['Expected response type distinguishes pre-candidacy; RecordVote accepts first response per identity; VoteResult evaluates only configured voters and both joint halves.'],writes=['Pre-vote win starts real election; real vote win installs leader and appends empty entry; loss becomes follower.'],external_effects=['Leader immediately broadcasts append after transition.'])\nb('B-context','A2','raft.Step, reset and leader timer/transfer handling','Current term, state and known leader','Term-bearing message; quorum timer; leadership transfer',['term-filter','roles','reset-append','ticks','leader-other','leader-admit','candidate-follower','tracker-votes'],cons=['F-leader','F-match'],implementation_guards=['Higher term normally steps down except pre-vote and unexpired lease vote suppression; lower-term messages normally exit before role handlers. Transfer excludes learner/self and requires transferee caught up before TimeoutNow.'],writes=['reset clears votes, remote Match, readOnly ack tracking and transfer; preserves log and commit.'],important_branches=['Same-term candidate receives append/heartbeat/snapshot and becomes follower. CheckQuorum optionally steps down on lost activity. Transfer times out and proposals resume. pendingReadIndexMessages is not cleared by reset; it is distinct from reset readOnly tracking.'],existing_protections=['Old append replies are term-filtered before Match update; reset does not erase committed history.'])\nb('B-membership','A4','raft.applyConfChange / confchange.Changer / switchToConfig','Application-activated configuration','ApplyConfChange on committed configuration entry or restored ConfState',['conf-contract','config-change','config-activate','config-restore','mode-contract'],prod=['F-config'],cons=['F-committed','F-match'],implementation_guards=['Simple changes reject more than one changed voter and joint state; joint enter copies outgoing voters; leaving drops outgoing membership and activates staged learners. Nonempty incoming and voter/learner invariants checked.'],writes=['Install new config and copied/initialized progress; retained peers preserve Match, new peers begin at zero; recompute leader commit.'],important_branches=['Removal/demotion steps down only when configured; absent self drops new proposals. Invalid application panics.'],cross_activity_effects={'A1':'Active voter sets select which Match values establish quorum and may cause commit advancement.','A2':'Same active sets determine vote wins, activity quorum, eligibility and transfer target validity.'})\nb('B-recovery','A3','newRaft, raft.restore and confchange.Restore','Startup or follower snapshot installation','Storage InitialState or MsgSnap',['startup','snapshot-restore','config-restore','log-start-append','log-eligibility','unstable-snapshot','config-activate','storage-contract','bootstrap'],prod=['F-config','F-committed'],implementation_guards=['Startup validates saved Commit within available log range. Snapshot must exceed commit and include local member; matching snapshot term/index fast-forwards commit instead of replacing log.'],writes=['Restore term/vote/commit and configuration; start follower. Full snapshot replaces unstable log and membership; campaign blocked until snapshot completion.'],important_branches=['Bootstrap requires empty storage and supplied peers, appends term-one configuration entries, marks them committed, applies membership while leaving application progress pending.'],cross_activity_effects={'A1':'Recovered commit and snapshot prefix constrain further append and application.','A2':'Restores vote and eligibility while discarding transient leadership.'})\nb('B-apply','A5','RawNode Ready and raft application response handlers','Committed prefix and application progress','Ready/MsgStorageApply and completion response',['log-apply','log-commit-apply','apply-accept','storage-tail','step-vote','apply-progress','ready-contract'],prod=['F-apply-reported'],cons=['F-committed'],implementation_guards=['Pending snapshot blocks entry delivery; asynchronous entry application is bounded by unstable.offset-1. Applied index is monotonic and cannot exceed committed.'],writes=['Track applying entries and outstanding size; completion advances applied and may propose auto-leave. Snapshot completion stabilizes matching snapshot and advances application progress.'],important_branches=['Synchronous Ready may include unstable committed entries under caller ordering duties; asynchronous apply uses term-zero responses because committed work survives terms.'],external_effects=['Application state-machine writes and client success are embedding responsibilities, not performed by raft.'])\nb('B-read','A1','raft read-only handlers and readOnly tracker','Current leadership, read context and active voters','MsgReadIndex, heartbeat acknowledgement, first current-term commit',['leader-admit','leader-other','read-pending','read-release','read-tracking','ready-contract','mode-contract'],prod=['F-read-index'],cons=['F-committed','F-leader','F-config'],implementation_guards=['Non-singleton requests wait for current-term commit. Safe mode tracks context-keyed acknowledgements and requires configured voter VoteWon.'],writes=['Safe mode snapshots committed index at request tracking; quorum heartbeat releases queued reads through matching context.'],important_branches=['Singleton responds immediately; lease mode bypasses heartbeat collection under its time assumptions. reset clears readOnly acknowledgements, but pre-current-term pending requests remain and can be reprocessed after subsequent current-term commit.'],external_effects=['Return ReadState locally or MsgReadIndexResp to requester; application must correlate context and wait for application before serving read.'],unknowns=['Whether retained pre-current-term read requests have a complete eventual release path when configuration activation, rather than append response, first advances current-term commitment.'])\nF=[]\ndef f(i,meaning,identity,ctx,rep,dur,rec,s,**kw): F.append(dict(id=i,meaning=meaning,identity=identity,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=s,**kw))\nf('F-app-queued','A successful append acknowledgement has been queued for the indicated log prefix; queue presence alone does not establish persistence or delivery.',{'replica':'reply From','prefix':'Index','context':'message Term'},'Produced by local append or follower acceptance under Step term handling.','msgsAfterAppend MsgAppResp'.split('|'),'Volatile; dependent state must be durable before delivery under Ready/async contract.','Not recovered as a message; log reconstruction and replication can regenerate support.',['reset-append','append-receive','reply-queue'],invalidators=['B-context'])\nf('F-match','Leader tracker records successful replication acknowledgement through Match for a peer, or local lastIndex initialization during role reset. It is not a standalone disk observation.',{'owner':'leader instance','peer':'Progress map key','prefix':'Match'},'Interpret within current leader term and configuration; remote progress reset on role reset.', ['trk.Progress[id].Match'],'Volatile; relies on response producer and storage contract.','Rebuilt by initialization and subsequent responses.',['reset-append','leader-match','progress-update'],invalidators=['B-context'],reinterpreters=['B-membership'])\nf('F-committed','Local raft log records a committed prefix through committed. Leader quorum advancement, follower leader notification, bootstrap or snapshot/recovery may establish it; this is not application completion.',{'instance':'raft instance','prefix':'committed index'},'Monotonic during active processing; reconstructed from valid stored prefix and HardState on startup.', ['raftLog.committed','HardState.Commit'],'Exposed for persistence; actual durability belongs to embedding.','Loaded from HardState and compacted/snapshot prefix.',['log-commit-apply','log-eligibility','append-receive','startup','bootstrap'],reinterpreters=['B-recovery'])\nf('F-vote-queued','A positive vote/pre-vote response is queued after local eligibility checks, or as self response during campaign; pre-vote is not a recorded real vote.',{'voter':'From','candidate':'To','round':'Term and response type'},'Candidate must interpret response in its expected phase, term and voter configuration.', ['msgsAfterAppend vote response','Vote for real vote'],'Real vote/term changes require storage before delivery; pre-vote queue is volatile.','Term and real Vote restored; response regenerated if applicable.',['campaign','step-vote','reply-queue'],invalidators=['B-context'])\nf('F-leader','The local state machine entered StateLeader after its configured vote result won, reset leader progress, and appended an empty current-term entry.',{'instance':'raft.id','term':'raft.Term'},'Leader state is local authority, not proof that a quorum is presently reachable or a lease valid.', ['state','lead','step','Term'],'Volatile.','Restart is follower; new election required.',['candidate-follower','roles'],invalidators=['B-context'],reinterpreters=['B-membership'])\nf('F-config','The local tracker has installed incoming/outgoing voters, learners and progress produced by configuration change or restore.',{'instance':'raft instance','membership':'ConfState voter/learner sets'},'Activation happens during application or recovery, not merely proposal or commit.', ['trk.Config','trk.Progress'],'Returned ConfState must be included in snapshots.','confchange.Restore reconstructs joint/simple configuration from saved ConfState.',['config-activate','config-change','config-restore','conf-contract'],reinterpreters=['B-membership','B-recovery'])\nf('F-apply-reported','The raft instance has accounted for caller-reported completion through its applied index; this does not independently observe application durability.',{'instance':'raft instance','prefix':'applied index'},'Committed work is term-independent; repeated older snapshot completion cannot regress applied.', ['raftLog.applied'],'Library bookkeeping is volatile; async apply response does not require durable application writes.','Config.Applied communicates restart progress; unset can replay entries.',['apply-progress','step-vote','log-commit-apply','async-contract'])\nf('F-read-index','A read result associates request context with a committed index selected by the leader read path; serving a completed read additionally requires caller correlation and application progress.',{'request':'RequestCtx','instance':'responding/requesting node'},'Safe mode heartbeat quorum or singleton, or lease mode under explicit lease assumptions. No independent client completion is asserted.', ['ReadState','MsgReadIndexResp'],'Volatile.','Caller retries/correlates requests; no persisted read result.',['read-tracking','read-release','leader-other','leader-admit','ready-contract'],invalidators=['B-context'])\nroles=json.load(open('../research.json'))['activity_roles']\nA=[]\nfor a in roles:\n bs=[x for x in B if x['primary_activity']==a]\n A.append(dict(class_id=a,applicability='applicable',purpose=roles[a]['relation'],realization_summary={'A1':'Replicated prefix and safe-read support are aggregated under active voters.','A2':'Term dispatch, campaigns, vote aggregation, optional activity check and transfer govern local authority.','A3':'Storage and snapshots reconstruct prefix and eligible membership.','A4':'Applied configuration changes activate simple/joint voter sets and learners.','A5':'Ready/async apply delivers committed work; caller reports progress.','A6':'Library tracks unstable history and sequences dependent responses; durable I/O is external, MemoryStorage is in-repository memory support.','A7':'RawNode caller or Node loop owns dispatch; proposal return is not client completion.'}[a],source_ids=sorted(set(s for x in bs for s in x['source_ids']))))\ncore=dict(status='usable',rationale='Both core lines have been followed through actual dispatch, producers, quorum consumers, context changes, configuration activation and caller handoffs. Usable is a bounded source explanation, not safety proof or execution evidence.',core_gaps=[],open_details=['Exact storage failure recovery for a production backend lies beyond the library snapshot; MemoryStorage is not a durable backend.','Detailed read-release liveness under configuration-triggered commitment remains a local question.','Progress flow-control variants and malformed input behavior require separate bounded questions.'])\ncore['formation']=dict(explanation='A caller proposes through RawNode or Node.run. Followers may forward; leaders reject proposals during transfer/removal or quota exhaustion. Accepted entries get leader term and consecutive index, enter unstable log and generate deferred self append support. Replication carries preceding index/term, entries and commit. Followers match the preceding entry, refuse committed conflicts, append only the conflicting suffix and acknowledge through the resulting prefix; stale prefixes can acknowledge the existing committed boundary. Ready or asynchronous local append envelopes impose the storage-before-response contract. Successful current-term tracked replies update per-peer Match. The active voter majority order statistic, minimum across both joint halves, supplies a candidate commit index; raftLog advances only when its entry term matches current leader term. Append broadcasts and bounded heartbeat commit propagate the decision. Ready then supplies committed entries, with asynchronous application restricted to locally stable entries and snapshots blocking entry application. Advance or apply response reports completion; the caller owns actual state-machine effects and client acknowledgement. Propose success alone is not commitment.',behavior_ids=['B-entry','B-propose','B-follower-append','B-storage-release','B-aggregate','B-apply'],fact_ids=['F-app-queued','F-match','F-committed','F-apply-reported'],source_ids=['entry','leader-admit','candidate-follower','send-replication','append-receive','log-start-append','reply-queue','async-contract','leader-match','tracker-commit','majority','joint','log-eligibility','log-apply','ready-contract','node-loop'])\ncore['context']=dict(explanation='Election ticks or Campaign pass eligibility and unapplied-configuration guards. PreVote collects support without changing term/vote; real campaign increments term and records self vote, counted only after deferred response release. Incoming votes require voting eligibility and last term/index freshness. The candidate accepts its phase-specific response type, records first vote per identity and uses active joint voter quorums; winning installs leadership and an empty entry. Higher term normally resets role, votes, remote progress and readOnly acknowledgements, with pre-vote and check-quorum lease exceptions. Lower-term replies do not reach ordinary consumers. Same-term leader traffic demotes candidates. Optional CheckQuorum revokes local leadership on inactive quorum; transfer catches up a voter then sends TimeoutNow, rejects new proposals while pending and aborts on timeout. Application activates membership; learner promotion/removal and joint exit change future quorum interpretation. Restart loads term/vote/commit and membership from Storage then becomes follower. Snapshot restore preserves committed prefix constraints, replaces history/config if needed and prevents campaigning while installation is pending.',behavior_ids=['B-campaign','B-election-result','B-context','B-membership','B-recovery'],fact_ids=['F-vote-queued','F-leader','F-config','F-committed'],source_ids=['campaign','step-vote','roles','term-filter','ticks','candidate-follower','leader-other','tracker-votes','majority','joint','config-change','config-activate','startup','snapshot-restore'])\ncore['connection']=dict(explanation='Formation support is scoped by current role/term and interpreted by application-activated membership. Reset discards remote Match and prior vote/read acknowledgements but does not erase log or committed prefix; election freshness and current-term commit gating reconnect inherited history to new decisions. Configuration changes preserve existing peer Match, initialize new peers at zero, and recompute commitment under new voters; staged learners remain outgoing voters until joint exit. Queued storage completions keep their originating raft term: stale entry append completion cannot trim unstable entries, while committed snapshot/application completion remains meaningful across terms. Pending pre-current-term ReadIndex requests survive reset separately from the cleared heartbeat acknowledgement tracker; a subsequent current-term commit reprocesses them through current read mode/quorum. Ready read results still require caller correlation and application progress. Storage, configuration and application boundaries therefore directly govern A1 support and A2 eligibility, without treating mere message emission or applied bookkeeping as durable or client completion.',behavior_ids=['B-context','B-storage-release','B-membership','B-aggregate','B-read','B-apply','B-recovery'],fact_ids=['F-match','F-committed','F-config','F-read-index','F-apply-reported'],source_ids=['reset-append','log-eligibility','config-change','config-activate','term-filter','storage-envelope','storage-tail','unstable-stable','apply-progress','read-pending','read-tracking','ready-contract'])\nmapdata=dict(version=1,target_profile=dict(system_boundary='Captured Go raft library: deterministic raft state machine, RawNode and Node wrapper, log/tracker/quorum/confchange internals and MemoryStorage. Network delivery, durable disk I/O, application state machine and client completion belong to the embedding.',protocol_contexts=['Per-instance term, role, log prefix and application-activated membership.'],external_interfaces=['RawNode/Node Propose, Step, Tick, Ready, Advance, ApplyConfChange; Storage; asynchronous local append/apply messages.'],ownership=['RawNode caller serializes access; Node.run serializes its channels; application performs Ready work.'],selection_injection=['Config selects storage, election/heartbeat ticks, PreVote, CheckQuorum, read mode, AsyncStorageWrites and configuration/removal options.'],variants=['Simple and joint configurations with learners','Synchronous Ready/Advance and asynchronous storage workers','Quorum-safe and lease-based reads'],source_ids=['entry','node-loop','async-contract','mode-contract','storage-contract','storage-memory']),activities=A,behaviors=B,facts=F,core_overview=core,surfaces=[dict(entry_point='raft.switchToConfig -> maybeCommit',disposition='deferred',reason='Unlike the successful append-response branch, this commit-advancing path does not call releasePendingReadIndexMessages. Determine whether another event necessarily releases pending reads; no bounded liveness obligation is established yet.',source_ids=['config-activate','leader-match','read-pending'],high_consequence=False),dict(entry_point='Storage and Ready embedding',disposition='externalized',reason='Durable I/O and final client completion are caller duties; MemoryStorage stores in memory and does not establish crash durability.',source_ids=['storage-contract','storage-memory','ready-contract','async-contract'])])\nwith open('core-map.json','w') as out:json.dump(mapdata,out,indent=2)\nsub=dict(action='research',rationale='Register the initial two-core source map with explicit caller and variant boundaries, while retaining a concrete pending-read consumer asymmetry as an unmapped lead.',map_path='core-map.json',sources=sources,feedback=dict(ref_ids=['leader-match','campaign','config-activate','log-eligibility','async-contract','read-pending'],answered='Recovered proposal-to-commit aggregation, election and authority loss, simple/joint configuration activation, snapshot/restart reconstruction, and application handoffs. The map separates queued support, recorded Match, committed prefix, reported application and read-index results. Storage completion filtering is context-specific; committed work persists across term changes. Configuration activation is another actual consumer of retained Match and may advance commitment. These are source observations, not executed findings.',remaining=['Select a principal Fact lifecycle for a bounded safety discriminator after map acceptance.','Investigate whether asynchronous storage completion can be consumed in the wrong context through the public RawNode entry, preserving per-thread FIFO and durability duties.','Retain the configuration-triggered pending-read release asymmetry as a separate liveness lead until completion expectations and a finite schedule are established.'],understanding='updated',rationale='Next inspect producer-to-consumer storage acknowledgement histories and existing contract/test expectations. The term filter and entry identity check are concrete protections; a legal same-execution schedule can test whether they also preserve snapshot/application progress without conflating durability with notification.'))\nwith open('submission.json','w') as out:json.dump(sub,out,indent=2)\nPY\npython3 build_map.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k)); return i\nfor args in [('campaign','raft.go',973,1083),('step-vote','raft.go',1178,1263),('leader-admit','raft.go',1267,1374),('leader-match','raft.go',1500,1570),('leader-other','raft.go',1571,1663),('candidate-follower','raft.go',1668,1773),('append-receive','raft.go',1776,1832),('send-replication','raft.go',616,738),('ticks','raft.go',850,889),('snapshot-restore','raft.go',1835,1945),('config-activate','raft.go',1947,2040),('startup','raft.go',437,496),('apply-progress','raft.go',740,773),('read-release','raft.go',2062,2084),('read-pending','raft.go',2123,2158),('log-start-append','log.go',71,139),('log-apply','log.go',213,298),('log-commit-apply','log.go',320,363),('log-eligibility','log.go',440,468),('majority','quorum/majority.go',116,196),('joint','quorum/joint.go',17,76),('tracker-commit','tracker/tracker.go',156,182),('tracker-votes','tracker/tracker.go',206,280),('progress-update','tracker/progress.go',202,254),('config-change','confchange/confchange.go',36,355),('config-restore','confchange/restore.go',23,155),('node-loop','node.go',348,459),('read-tracking','read_only.go',19,130),('unstable-stable','log_unstable.go',128,160),('unstable-snapshot','log_unstable.go',181,194),('storage-memory','storage.go',96,155),('storage-snap-append','storage.go',197,310),('bootstrap','bootstrap.go',25,80),('storage-tail','rawnode.go',328,399)]: src(*args)\nsrc('async-contract','raft.go',151,185,'interface_statement')\nsrc('mode-contract','raft.go',222,285,'interface_statement')\nsrc('storage-contract','storage.go',40,90,'interface_statement')\nsrc('conf-contract','node.go',179,187,'interface_statement')\nB=[]\ndef b(i,a,owner,ctx,trig,s,prod=[],cons=[],**kw):\n B.append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=s,produces_fact_ids=prod,consumes_fact_ids=cons,**kw))\nb('B-entry','A7','RawNode caller or node.run goroutine','One raft instance; caller serializes RawNode access','Propose, Step, Tick, Ready and Advance',['entry','node-loop','ready-contract'],external_effects=['Propose invokes MsgProp and reports admission/dispatch, not application completion. Node.run serializes incoming channels; it can defer proposals when no leader is known.'],legal_preconditions=['Storage, transport and application implement the Ready contract.'],important_branches=['RawNode.Step rejects unknown peer responses and unexpected network-local messages. Node.run separately filters unknown responses.'])\nb('B-propose','A1','raft.stepLeader / stepFollower','Current leader term and active progress map','MsgProp',['leader-admit','candidate-follower','reset-append','send-replication'],prod=['F-app-queued'],cons=['F-leader'],implementation_guards=['Reject empty proposal; drop if leader removed, transfer pending, or uncommitted quota exceeded. Followers forward only with known leader and forwarding enabled; candidates drop.'],writes=['Assign entry term/index and append unstable suffix; queue self MsgAppResp and replicate to peers.'],important_branches=['Configuration proposals may become empty normal entries under pending/joint checks; DisableConfChangeValidation bypasses those checks.'],async_boundaries=['Self append reply is queued after append; outbound replication does not itself establish peer acceptance.'])\nb('B-follower-append','A1','raft.handleAppendEntries and raftLog.maybeAppend','Follower after Step term dispatch','MsgApp',['append-receive','log-start-append','candidate-follower'],prod=['F-app-queued','F-committed'],implementation_guards=['Previous index/term must match unless below already committed index; conflicting committed entries panic.'],writes=['Append conflicting uncommitted suffix and advance commit to min(advertised commit,last new index); queue affirmative append reply.'],important_branches=['Previous index below committed replies with committed index. Mismatch yields rejection with conflict hint, not affirmative acceptance.'])\nb('B-storage-release','A6','raft.send and RawNode Ready/Advance; external storage worker','Ready generation and local append response term','Queued append/vote responses or pending unstable state',['reply-queue','storage-envelope','storage-tail','apply-accept','advance','async-contract','ready-release','term-filter','step-vote','unstable-stable'],cons=['F-app-queued','F-vote-queued'],implementation_guards=['Async envelope response includes current raft term and last unstable entry identity; stale append response cannot stabilize entries. stableTo also checks entry index/term.'],writes=['Ready drains response queues; synchronous Advance steps self responses; accepted storage response trims unstable entries.'],external_effects=['Remote responses are exposed under caller persistence-before-delivery contract; library does not perform disk writes.'],important_branches=['Synchronous remote responses are Ready.Messages; async responses ride MsgStorageAppend. Old-term snapshot completion is still handled.'],cross_activity_effects={'A1':'Append support is withheld from publication/self-consumption until the embedding storage contract is satisfied.','A2':'Vote responses are subject to the same durability handoff, while entry stability uses current term to reject obsolete completion.'})\nb('B-aggregate','A1','raft.stepLeader, tracker, quorum and raftLog','Current leader term and active incoming/outgoing voter sets','Successful MsgAppResp or configuration-triggered maybeCommit',['leader-match','tracker-commit','majority','joint','progress-update','reset-append','log-eligibility','config-activate'],prod=['F-match','F-committed'],cons=['F-app-queued','F-leader'],implementation_guards=['Step term dispatch and tracked sender precede response consumption; MaybeUpdate only increases Match. Aggregate only voter IDs; joint committed index is minimum of both majority indexes. maybeCommit requires a nonzero current-term entry at aggregate index.'],writes=['Update Match, flow control and committed index; broadcast advancement.'],important_branches=['Rejected append adjusts Next under stale-rejection checks, then retries; does not establish Match.'],existing_protections=['A same-index successful probe response may restore replication even without increasing Match.'])\nb('B-campaign','A2','raft.hup/campaign and Step vote branch','Current term, vote and local configuration','Tick timeout, Campaign or transfer TimeoutNow; incoming vote request',['campaign','step-vote','ticks','roles','log-eligibility','snapshot-restore'],prod=['F-vote-queued'],implementation_guards=['Local campaigning requires nonlearner progress and no pending snapshot or unapplied committed configuration changes. Vote grant requires canVote and lexicographic last term/index freshness.'],writes=['Real campaign increments term and self-votes; pre-campaign leaves term/vote unchanged. Queue self response; send requests to union of voter IDs.'],important_branches=['Learners may answer vote requests; only the candidate voter configuration determines whether their votes count. Pre-votes do not record durable Vote.'])\nb('B-election-result','A2','raft.stepCandidate and ProgressTracker','Candidate state and expected vote response type','Vote or pre-vote response',['candidate-follower','campaign','tracker-votes','majority','joint','roles'],prod=['F-leader'],cons=['F-vote-queued'],implementation_guards=['Expected response type distinguishes pre-candidacy; RecordVote accepts first response per identity; VoteResult evaluates only configured voters and both joint halves.'],writes=['Pre-vote win starts real election; real vote win installs leader and appends empty entry; loss becomes follower.'],external_effects=['Leader immediately broadcasts append after transition.'])\nb('B-context','A2','raft.Step, reset and leader timer/transfer handling','Current term, state and known leader','Term-bearing message; quorum timer; leadership transfer',['term-filter','roles','reset-append','ticks','leader-other','leader-admit','candidate-follower','tracker-votes'],cons=['F-leader','F-match'],implementation_guards=['Higher term normally steps down except pre-vote and unexpired lease vote suppression; lower-term messages normally exit before role handlers. Transfer excludes learner/self and requires transferee caught up before TimeoutNow.'],writes=['reset clears votes, remote Match, readOnly ack tracking and transfer; preserves log and commit.'],important_branches=['Same-term candidate receives append/heartbeat/snapshot and becomes follower. CheckQuorum optionally steps down on lost activity. Transfer times out and proposals resume. pendingReadIndexMessages is not cleared by reset; it is distinct from reset readOnly tracking.'],existing_protections=['Old append replies are term-filtered before Match update; reset does not erase committed history.'])\nb('B-membership','A4','raft.applyConfChange / confchange.Changer / switchToConfig','Application-activated configuration','ApplyConfChange on committed configuration entry or restored ConfState',['conf-contract','config-change','config-activate','config-restore','mode-contract'],prod=['F-config'],cons=['F-committed','F-match'],implementation_guards=['Simple changes reject more than one changed voter and joint state; joint enter copies outgoing voters; leaving drops outgoing membership and activates staged learners. Nonempty incoming and voter/learner invariants checked.'],writes=['Install new config and copied/initialized progress; retained peers preserve Match, new peers begin at zero; recompute leader commit.'],important_branches=['Removal/demotion steps down only when configured; absent self drops new proposals. Invalid application panics.'],cross_activity_effects={'A1':'Active voter sets select which Match values establish quorum and may cause commit advancement.','A2':'Same active sets determine vote wins, activity quorum, eligibility and transfer target validity.'})\nb('B-recovery','A3','newRaft, raft.restore and confchange.Restore','Startup or follower snapshot installation','Storage InitialState or MsgSnap',['startup','snapshot-restore','config-restore','log-start-append','log-eligibility','unstable-snapshot','config-activate','storage-contract','bootstrap'],prod=['F-config','F-committed'],implementation_guards=['Startup validates saved Commit within available log range. Snapshot must exceed commit and include local member; matching snapshot term/index fast-forwards commit instead of replacing log.'],writes=['Restore term/vote/commit and configuration; start follower. Full snapshot replaces unstable log and membership; campaign blocked until snapshot completion.'],important_branches=['Bootstrap requires empty storage and supplied peers, appends term-one configuration entries, marks them committed, applies membership while leaving application progress pending.'],cross_activity_effects={'A1':'Recovered commit and snapshot prefix constrain further append and application.','A2':'Restores vote and eligibility while discarding transient leadership.'})\nb('B-apply','A5','RawNode Ready and raft application response handlers','Committed prefix and application progress','Ready/MsgStorageApply and completion response',['log-apply','log-commit-apply','apply-accept','storage-tail','step-vote','apply-progress','ready-contract'],prod=['F-apply-reported'],cons=['F-committed'],implementation_guards=['Pending snapshot blocks entry delivery; asynchronous entry application is bounded by unstable.offset-1. Applied index is monotonic and cannot exceed committed.'],writes=['Track applying entries and outstanding size; completion advances applied and may propose auto-leave. Snapshot completion stabilizes matching snapshot and advances application progress.'],important_branches=['Synchronous Ready may include unstable committed entries under caller ordering duties; asynchronous apply uses term-zero responses because committed work survives terms.'],external_effects=['Application state-machine writes and client success are embedding responsibilities, not performed by raft.'])\nb('B-read','A1','raft read-only handlers and readOnly tracker','Current leadership, read context and active voters','MsgReadIndex, heartbeat acknowledgement, first current-term commit',['leader-admit','leader-other','read-pending','read-release','read-tracking','ready-contract','mode-contract'],prod=['F-read-index'],cons=['F-committed','F-leader','F-config'],implementation_guards=['Non-singleton requests wait for current-term commit. Safe mode tracks context-keyed acknowledgements and requires configured voter VoteWon.'],writes=['Safe mode snapshots committed index at request tracking; quorum heartbeat releases queued reads through matching context.'],important_branches=['Singleton responds immediately; lease mode bypasses heartbeat collection under its time assumptions. reset clears readOnly acknowledgements, but pre-current-term pending requests remain and can be reprocessed after subsequent current-term commit.'],external_effects=['Return ReadState locally or MsgReadIndexResp to requester; application must correlate context and wait for application before serving read.'],unknowns=['Whether retained pre-current-term read requests have a complete eventual release path when configuration activation, rather than append response, first advances current-term commitment.'])\nF=[]\ndef f(i,meaning,identity,ctx,rep,dur,rec,s,**kw): F.append(dict(id=i,meaning=meaning,identity=identity,validity_context=ctx,representation=rep,durability=dur,recovery=rec,source_ids=s,**kw))\nf('F-app-queued','A successful append acknowledgement has been queued for the indicated log prefix; queue presence alone does not establish persistence or delivery.',{'replica':'reply From','prefix':'Index','context':'message Term'},'P