d\":\"append_reply_first\",\"pending_contexts\":[],\"reported_applied\":7,\"request\":\"assurance/first-commit/append_reply_first\",\"transition_returned\":true,\"voter_count_after\":3,\"waiting_for_first_commit\":false}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/567df00ac58d417db330fbb889fcb9ae/assurance_generated_test.go; python3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/567df00ac58d417db330fbb889fcb9ae/plan.json'));p['harness'].pop('source');print(json.dumps(p,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/567df00ac58d417db330fbb889fcb9ae/assurance_generated_test.go; python3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/567df00ac58d417db330fbb889fcb9ae/plan.json'));p['harness'].pop('source');print(json.dumps(p,indent=2))\nPY\"","aggregated_output":"package raft\n\nimport (\n \"context\"\n \"encoding/json\"\n \"fmt\"\n \"testing\"\n \"time\"\n pb \"go.etcd.io/raft/v3/raftpb\"\n)\n\ntype assuranceNodePeer struct {\n n Node\n s *MemoryStorage\n deferred [][]pb.Entry\n freezeApply bool\n reads []ReadState\n}\ntype assuranceNodeNetwork struct {\n t *testing.T\n ctx context.Context\n peers []*assuranceNodePeer\n messages []pb.Message\n held []pb.Message\n restrict bool\n}\nfunc assuranceNodeEvent(v map[string]interface{}) {\n b,err:=json.Marshal(v); if err!=nil {panic(err)}\n fmt.Println(\"CA_EVENT \"+string(b))\n}\nfunc (c *assuranceNodeNetwork) apply(p *assuranceNodePeer, entries []pb.Entry) {\n for _,e:=range entries {\n  switch e.Type {\n  case pb.EntryConfChange:\n   var cc pb.ConfChange; if err:=cc.Unmarshal(e.Data);err!=nil {c.t.Fatal(err)}\n   cs:=p.n.ApplyConfChange(cc)\n   assuranceNodeEvent(map[string]interface{}{\"event\":\"config_applied\",\"node\":p.n.Status().ID,\"index\":e.Index,\"conf\":cs})\n  case pb.EntryConfChangeV2:\n   var cc pb.ConfChangeV2; if err:=cc.Unmarshal(e.Data);err!=nil {c.t.Fatal(err)}\n   p.n.ApplyConfChange(cc)\n  }\n }\n}\nfunc (c *assuranceNodeNetwork) ready(p *assuranceNodePeer, rd Ready) {\n if !IsEmptySnap(rd.Snapshot) {c.t.Fatal(\"unexpected snapshot in this exploration\")}\n if err:=p.s.Append(rd.Entries);err!=nil {c.t.Fatal(err)}\n if !IsEmptyHardState(rd.HardState) {if err:=p.s.SetHardState(rd.HardState);err!=nil {c.t.Fatal(err)}}\n c.messages=append(c.messages,rd.Messages...)\n if len(rd.CommittedEntries)>0 {\n  if p.freezeApply || len(p.deferred)>0 {\n   p.deferred=append(p.deferred,rd.CommittedEntries)\n  } else {c.apply(p,rd.CommittedEntries)}\n }\n for _,rs:=range rd.ReadStates {\n  p.reads=append(p.reads,rs)\n  assuranceNodeEvent(map[string]interface{}{\"event\":\"read_state\",\"node\":p.n.Status().ID,\"request\":string(rs.RequestCtx),\"index\":rs.Index})\n }\n // Node/doc.go permit this after persistence, before deferred application.\n p.n.Advance()\n p.n.Status()\n}\nfunc (c *assuranceNodeNetwork) drain() {\n for round:=0;round<300;round++ {\n  work:=false\n  for _,p:=range c.peers {\n   p.n.Status()\n   select {\n   case rd:=<-p.n.Ready(): c.ready(p,rd);work=true\n   case <-time.After(5*time.Millisecond):\n   }\n  }\n  msgs:=c.messages;c.messages=nil\n  for _,m:=range msgs {\n   work=true\n   if c.restrict && m.Type==pb.MsgApp && m.From==2 && (m.To==1 || m.To==4) {\n    c.held=append(c.held,m);continue\n   }\n   if m.To<1 || m.To>uint64(len(c.peers)) {c.t.Fatalf(\"bad destination %d\",m.To)}\n   p:=c.peers[m.To-1]\n   if err:=p.n.Step(c.ctx,m);err!=nil {c.t.Fatal(err)}\n   p.n.Status()\n  }\n  if !work {return}\n }\n c.t.Fatal(\"driver drain budget exhausted\")\n}\nfunc (c *assuranceNodeNetwork) status(label string) {\n s:=c.peers[1].n.Status()\n assuranceNodeEvent(map[string]interface{}{\"event\":\"checkpoint\",\"phase\":label,\"node\":s.ID,\"term\":s.Term,\"state\":s.RaftState.String(),\"commit\":s.Commit,\"reported_applied\":s.Applied,\"config\":s.Config,\"progress\":s.Progress,\"deferred_batches\":len(c.peers[1].deferred),\"read_count\":len(c.peers[1].reads),\"held_messages\":len(c.held)})\n}\nfunc TestAssuranceFirstCommitReadRelease(t *testing.T) {\n for _,activationFirst:=range []bool{true,false} {\n  label:=\"append_reply_first\";if activationFirst {label=\"config_activation_first\"}\n  t.Run(label,func(t *testing.T) {\n   ctx,cancel:=context.WithTimeout(context.Background(),30*time.Second);defer cancel()\n   c:=&assuranceNodeNetwork{t:t,ctx:ctx}\n   peers:=[]Peer{{ID:1},{ID:2},{ID:3},{ID:4}}\n   for i:=1;i<=4;i++ {\n    s:=NewMemoryStorage()\n    n:=StartNode(&Config{ID:uint64(i),ElectionTick:10,HeartbeatTick:1,Storage:s,MaxInflightMsgs:16,MaxSizePerMsg:4096},peers)\n    c.peers=append(c.peers,&assuranceNodePeer{n:n,s:s})\n    defer n.Stop()\n   }\n   c.drain()\n   if err:=c.peers[0].n.Campaign(ctx);err!=nil {t.Fatal(err)}\n   c.drain()\n   if c.peers[0].n.Status().RaftState!=StateLeader {t.Fatal(\"initial election not reached\")}\n   p:=c.peers[1];p.freezeApply=true\n   if err:=c.peers[0].n.ProposeConfChange(ctx,pb.ConfChange{Type:pb.ConfChangeRemoveNode,NodeID:4});err!=nil {t.Fatal(err)}\n   c.drain()\n   if len(p.deferred)==0 {t.Fatal(\"no configuration batch was deferred\")}\n   c.restrict=true\n   if err:=p.n.Campaign(ctx);err!=nil {t.Fatal(err)}\n   c.drain()\n   before:=p.n.Status()\n   if before.RaftState!=StateLeader {t.Fatal(\"second election not reached\")}\n   beforeCommitTerm,err:=p.s.Term(before.Commit);if err!=nil {t.Fatal(err)}\n   if beforeCommitTerm==before.Term {t.Fatal(\"current term committed before intended trigger\")}\n   request:=[]byte(\"assurance/first-commit/\"+label)\n   if err:=p.n.ReadIndex(ctx,request);err!=nil {t.Fatal(err)}\n   p.n.Status()\n   assuranceNodeEvent(map[string]interface{}{\"event\":\"read_admitted\",\"operation_id\":label,\"request\":string(request),\"leader\":before.ID,\"leader_term\":before.Term,\"commit_before\":before.Commit,\"commit_term_before\":beforeCommitTerm,\"current_term_committed_before\":beforeCommitTerm==before.Term,\"leader_state\":before.RaftState.String(),\"voter_count_before\":len(before.Config.Voters[0]),\"read_call_returned\":true})\n   c.drain()\n   if !activationFirst {\n    // The control first delivers actual withheld appends; an old-config quorum\n    // can then commit via the ordinary append-response consumer.\n    c.restrict=false;c.messages=append(c.messages,c.held...);c.held=nil\n    c.drain()\n   }\n   for _,batch:=range p.deferred {c.apply(p,batch)}\n   p.deferred=nil;p.freezeApply=false\n   after:=p.n.Status()\n   afterCommitTerm,err:=p.s.Term(after.Commit);if err!=nil {t.Fatal(err)}\n   // Stop is an observation barrier: after it returns no owner goroutine can\n   // mutate the private pending queue. We do not modify any target state.\n   p.n.Stop()\n   r:=p.n.(*node).rn.raft\n   waiting:=false\n   pendingContexts:=[]string{}\n   for _,m:=range r.pendingReadIndexMessages {\n    if len(m.Entries)==1 {\n     pendingContexts=append(pendingContexts,string(m.Entries[0].Data))\n     if string(m.Entries[0].Data)==string(request) {waiting=true}\n    }\n   }\n   assuranceNodeEvent(map[string]interface{}{\"event\":\"release_observed\",\"operation_id\":label,\"request\":string(request),\"transition_returned\":true,\"leader\":after.ID,\"leader_term\":after.Term,\"leader_state\":after.RaftState.String(),\"commit_after\":after.Commit,\"commit_term_after\":afterCommitTerm,\"current_term_committed\":afterCommitTerm==after.Term,\"voter_count_after\":len(after.Config.Voters[0]),\"waiting_for_first_commit\":waiting,\"pending_contexts\":pendingContexts,\"held_messages\":len(c.held),\"reported_applied\":after.Applied,\"deferred_batches\":len(p.deferred)})\n  })\n }\n}\n{\n  \"description\": \"Run configuration-first and append-reply-first histories with public synchronous Nodes. Observe the original request identity, leader and old commit term before the trigger. After the configuration API returns, observe current-term commitment and inspect whether that same request remains in the first-commit queue after a Stop ownership barrier.\",\n  \"claim_id\": \"C-first-commit-read-release\",\n  \"binding_ids\": [\n    \"D-read-release\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"description\": \"Actual four-node election and committed membership reduction, documented early Advance, two trigger orders, then stopped-owner queue inspection.\",\n    \"semantic_changes\": [\n      \"No target changes or private state assignments.\",\n      \"Same-package queue read occurs only after public Stop returns; stopping ends the observation independently of the forbidden queue state.\",\n      \"Normal application is a no-op except required ApplyConfChange; no external client result is modeled.\",\n      \"MemoryStorage represents successful storage completion.\",\n      \"current_term_committed is derived from the stored term at observed committed index compared with observed current term; raw operands are emitted.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"read\",\n        \"event\": \"read_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"read_call_returned\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"leader_state\",\n            \"op\": \"eq\",\n            \"value\": \"StateLeader\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"current_term_committed_before\",\n            \"op\": \"eq\",\n            \"value\": false,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"node-start-and-restart\",\n        \"node-step-and-read\",\n        \"node-control-methods\",\n        \"node-loop\",\n        \"node-stop\",\n        \"doc-early-advance\",\n        \"node-early-advance\",\n        \"bootstrap-contract\",\n        \"storage-memory\",\n        \"storage-snap-append\",\n        \"campaign\",\n        \"candidate-follower\",\n        \"config-activate\",\n        \"read-pending\",\n        \"read-api-contract\"\n      ],\n      \"expectation_ids\": [\n        \"doc-early-advance\",\n        \"node-early-advance\",\n        \"conf-contract\",\n        \"read-api-contract\"\n      ],\n      \"binding_ids\": [\n        \"D-read-release\"\n      ],\n      \"derivation\": \"Four Nodes start with identical Bootstrap peers and consume actual Ready batches. Each Ready writes Entries and HardState before messages or Advance. Node 2 temporarily defers every application batch in order but advances after persistence, as explicitly permitted by synchronous Node/doc.go. A real committed removal entry is later applied in that same FIFO batch order. Campaign and actual vote replies elect Node 2; only its append network messages to peers 1 and 4 are held, preserving an active quorum of the subsequent three-voter configuration through nodes 2 and 3. The original read is submitted locally while commitment is still from the previous term; Status serializes after ReadIndex reception. The experiment case then applies the delayed config; the control first releases actual held append messages so old-config quorum commits through the ordinary response path, then applies all delayed batches. After ApplyConfChange returns and Status observes commit, Stop waits for the Node owner to terminate, and only then the harness reads its private queue without mutation or races. Stop does not clear that queue. There are no tick timeouts in the selected transition. Each observation finishes at the local queue-release endpoint, not a completed client read.\",\n      \"applicability\": \"Two independent real histories differing only in which actual event first commits the new-term entry. Post-stop no progress is expected. Timing waits only let Ready channels run; they are not an oracle. MemoryStorage models successful stable writes in a no-crash schedule.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Using private raft methods to assign leadership or commit would not establish this legal public-Node history; none are used.\",\n        \"The stopped-owner queue observation answers local release, while actual read service remains outside scope.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-first-commit-read-release\",\n      \"checker_id\": \"first-commit-read-release\",\n      \"event\": \"release_observed\",\n      \"binding_ids\": [\n        \"D-read-release\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"leader-admit\",\n          \"leader-match\",\n          \"read-pending\",\n          \"config-activate\"\n        ],\n        \"expectation_ids\": [\n          \"pending-read-intent\"\n        ],\n        \"binding_ids\": [\n          \"D-read-release\"\n        ],\n        \"derivation\": \"pending-read-intent describes this particular internal queue as holding reads that cannot be answered before a new leader commits in its term, and says they will be handled as fast as the first log is committed in that term. Interpret this as a local transition responsibility: after the first-current-term commitment transition completes, a request already held solely on that condition must be released from this waiting queue for ordinary read processing. The expectation is attributed to that specific implementation statement, not inferred solely from differing call sites. Public ReadIndex explicitly allows requests to be lost and requires retry; this is not a claim of unconditional read completion, linearizability violation or an elapsed-time deadline.\",\n        \"applicability\": \"Synchronous public Node, ReadOnlySafe, surviving leader and unique request context, real pending request before first-current-term commit. Membership activation or an append reply can establish that commit condition. Early Advance is permitted by the Node and doc.go interface statements, with Ready application order retained.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Public read completion can require retries; a missing ReadState alone would not violate this local queue-release proposition.\",\n          \"The append-reply path explicitly releases this queue; membership activation must be examined separately.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"read\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"first-commit-read-release\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"transition_returned\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"waiting_for_first_commit\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"current_term_committed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"operation_id\",\n        \"request\",\n        \"leader\",\n        \"leader_term\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For the admitted request in the same leader term, a completed local transition with a current-term committed entry implies the request no longer waits in the pre-first-commit pending queue. This does not require ReadState output or public read completion.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The local release expectation is attributed to the internal queue comment. Public ReadIndex explicitly allows loss and retries, so this must not be described as an unconditional public completion guarantee.\",\n    \"The same-history construction exercises one documented synchronous scheduling permission and two trigger orders, not all configurations or application strategies.\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
