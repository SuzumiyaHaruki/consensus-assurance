rol_test.go\n-rw-rw-r--  1 nitro nitro  25810 Oct  2 10:41 raft_paper_test.go\n-rw-rw-r--  1 nitro nitro   3772 Oct  2 10:41 raft_snap_test.go\n-rw-rw-r--  1 nitro nitro 129511 Oct  2 10:41 raft_test.go\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 raftpb\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 rafttest\n-rw-rw-r--  1 nitro nitro  21563 Oct  2 10:41 rawnode.go\n-rw-rw-r--  1 nitro nitro  32489 Oct  2 10:41 rawnode_test.go\n-rw-rw-r--  1 nitro nitro   3590 Oct  2 10:41 read_only.go\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 scripts\n-rw-rw-r--  1 nitro nitro   7949 Oct  2 10:41 state_trace.go\n-rw-rw-r--  1 nitro nitro   1246 Oct  2 10:41 state_trace_nop.go\n-rw-rw-r--  1 nitro nitro   2673 Oct  2 10:41 status.go\n-rw-rw-r--  1 nitro nitro  10422 Oct  2 10:41 storage.go\n-rw-rw-r--  1 nitro nitro   5886 Oct  2 10:41 storage_test.go\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 testdata\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 tla\ndrwxrwxr-x  3 nitro nitro   4096 Oct  2 10:41 tools\ndrwxrwxr-x  2 nitro nitro   4096 Oct  2 10:41 tracker\n-rw-rw-r--  1 nitro nitro   3956 Oct  2 10:41 types.go\n-rw-rw-r--  1 nitro nitro   3536 Oct  2 10:41 types_test.go\n-rw-rw-r--  1 nitro nitro   9372 Oct  2 10:41 util.go\n-rw-rw-r--  1 nitro nitro   4318 Oct  2 10:41 util_test.go\ntotal 8\ndrwxrwxr-x 6 nitro nitro 4096 Oct  2 10:42 .\ndrwx------ 8 nitro nitro  260 Oct  2 10:42 ..\ndr-xr-xr-x 2 nitro nitro   40 Oct  2 10:42 .agents\ndr-xr-xr-x 2 nitro nitro   40 Oct  2 10:42 .codex\ndr-xr-xr-x 2 nitro nitro   40 Oct  2 10:42 .git\ndrwxrwxr-x 3 nitro nitro 4096 Oct  2 10:41 tmp\n","exit_code":0,"status":"completed"}}
