required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\nClaimDraft {\n  \"additionalProperties\": false,\n  \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"enum\": [\n        \"obligation\",\n        \"assumption\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"concern\": {\n      \"default\": \"implementation_semantics\",\n      \"enum\": [\n        \"consensus_safety\",\n        \"bounded_liveness\",\n        \"implementation_semantics\"\n      ],\n      \"title\": \"Concern\",\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"description\": \"Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability\",\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"description\": \"Located materials; file kinds do not establish normative authority\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"scope\": {\n      \"$ref\": \"#/$defs/Scope\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    },\n    \"grounding\": {\n      \"$ref\": \"#/$defs/Grounding\",\n      \"default\": {\n        \"source_ids\": [],\n        \"expectation_ids\": [],\n        \"binding_ids\": [],\n        \"derivation\": \"\",\n        \"applicability\": \"\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      }\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"kind\",\n    \"description\",\n    \"source_ids\",\n    \"scope\",\n    \"pending\"\n  ],\n  \"title\": \"ClaimDraft\",\n  \"type\": \"object\"\n}\nBindingDraft {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"associations\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingAssociation\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Associations\",\n      \"type\": \"array\"\n    },\n    \"anchor\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CodeAnchor\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"symbol\": {\n      \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"pending\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Pending\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"associations\",\n    \"id\",\n    \"material_id\",\n    \"symbol\",\n    \"start_line\",\n    \"end_line\",\n    \"description\",\n    \"pending\"\n  ],\n  \"title\": \"BindingDraft\",\n  \"type\": \"object\"\n}\nCheckSubmission {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"check\",\n        \"revise_check\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"unit_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Unit Id\"\n    },\n    \"candidate\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/CandidateSubmission\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"plan_path\": {\n      \"title\": \"Plan Path\",\n      \"type\": \"string\"\n    },\n    \"harness_path\": {\n      \"title\": \"Harness Path\",\n      \"type\": \"string\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Destination path to draft source path for helpers\",\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    },\n    \"previous_check_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Previous Check Id\"\n    },\n    \"repair_issue_ids\": {\n      \"description\": \"Exact issues whose driver premises the new harness legality answers; admission does not resolve them\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Repair Issue Ids\",\n      \"type\": \"array\"\n    },\n    \"encoding_revision\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/EncodingRevision\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"plan_path\",\n    \"harness_path\"\n  ],\n  \"title\": \"CheckSubmission\",\n  \"type\": \"object\"\n}\nPLAN {\"additionalProperties\": false, \"description\": \"Concrete investigation of an accepted requirement; execution determines the observed result.\", \"properties\": {\"description\": {\"description\": \"This check\\u2019s discriminator, prefix, controls and observations; reference the accepted claim rather than restating it\", \"title\": \"Description\", \"type\": \"string\"}, \"claim_id\": {\"title\": \"Claim Id\", \"type\": \"string\"}, \"binding_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Binding Ids\", \"type\": \"array\"}, \"harness\": {\"$ref\": \"#/$defs/Harness\"}, \"monitors\": {\"items\": {\"$ref\": \"#/$defs/EventMonitor\"}, \"minItems\": 1, \"title\": \"Monitors\", \"type\": \"array\"}, \"observable_properties\": {\"description\": \"Direct route supports event_assertion and event_implication. Correlate prerequisite fields by alias; history properties require a local_model fallback.\", \"items\": {\"$ref\": \"#/$defs/ObservableProperty\"}, \"minItems\": 1, \"title\": \"Observable Properties\", \"type\": \"array\"}, \"uncertainties\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Uncertainties\", \"type\": \"array\"}}, \"required\": [\"description\", \"claim_id\", \"binding_ids\", \"harness\", \"monitors\", \"observable_properties\"], \"title\": \"DirectCheckPlan\", \"type\": \"object\"}\nComparison required ['field'] fields ['field', 'op', 'value', 'reference']\nEventMonitor required ['id', 'checker_id', 'event', 'binding_ids', 'grounding'] fields ['id', 'checker_id', 'event', 'binding_ids', 'grounding', 'applicability_conditions', 'admission_alias']\nEventRequirement required ['alias', 'event'] fields ['alias', 'event', 'conditions']\nGrounding required None fields ['source_ids', 'expectation_ids', 'binding_ids', 'derivation', 'applicability', 'unresolved', 'conflicts', 'alternatives']\nHarness required ['kind', 'source', 'description', 'semantic_changes'] fields ['files', 'kind', 'source', 'description', 'semantic_changes', 'prerequisites', 'legality']\nObservableProperty required ['checker_id', 'trigger', 'assertion', 'description'] fields ['checker_id', 'kind', 'trigger', 'assertion', 'antecedent', 'identity_fields', 'history_field', 'description']\n","exit_code":0,"status":"completed"}}
