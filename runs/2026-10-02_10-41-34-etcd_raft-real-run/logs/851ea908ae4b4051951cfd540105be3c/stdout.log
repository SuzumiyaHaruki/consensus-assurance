ecause\n\t\t\t\t// they may have been overwritten in the unstable log during a\n\t\t\t\t// later term. See the comment in newStorageAppendResp for more\n\t\t\t\t// about this race.\n\t\t\t\tr.logger.Infof(\"%x [term: %d] ignored entry appends from a %s message with lower term [term: %d]\",\n\t\t\t\t\tr.id, r.Term, m.Type, m.Term)\n\t\t\t}\n\t\t\tif m.Snapshot != nil {\n\t\t\t\t// Even if the snapshot applied under a different term, its\n\t\t\t\t// application is still valid. Snapshots carry committed\n\t\t\t\t// (term-independent) state.\n\t\t\t\tr.appliedSnap(m.Snapshot)\n\t\t\t}\n\t\t} else {\n\t\t\t// ignore other cases\n\t\t\tr.logger.Infof(\"%x [term: %d] ignored a %s message with lower term from %x [term: %d]\",\n\t\t\t\tr.id, r.Term, m.Type, m.From, m.Term)\n\t\t}\n\t\treturn nil\n\t}\n\n\tswitch m.Type {\n\tcase pb.MsgHup:\n\t\tif r.preVote {\n\t\t\tr.hup(campaignPreElection)\n\t\t} else {\n\t\t\tr.hup(campaignElection)\n\t\t}\n\n\tcase pb.MsgStorageAppendResp:\n\t\tif m.Index != 0 {\n\t\t\tr.raftLog.stableTo(entryID{term: m.LogTerm, index: m.Index})\n\t\t}\n\t\tif m.Snapshot != nil {\n\t\t\tr.appliedSnap(m.Snapshot)\n\t\t}\n\n\tcase pb.MsgStorageApplyResp:\n\t\tif len(m.Entries) > 0 {\n\t\t\tindex := m.Entries[len(m.Entries)-1].Index\n\t\t\tr.appliedTo(index, entsSize(m.Entries))\n\t\t\tr.reduceUncommittedSize(payloadsSize(m.Entries))\n\t\t}\n\n// after the unstable log entries, hard state, and snapshot in the current Ready\n// (along with those in all prior Ready structs) have been saved to stable\n// storage.\nfunc newStorageAppendRespMsg(r *raft, rd Ready) pb.Message {\n\tm := pb.Message{\n\t\tType: pb.MsgStorageAppendResp,\n\t\tTo:   r.id,\n\t\tFrom: LocalAppendThread,\n\t\t// Dropped after term change, see below.\n\t\tTerm: r.Term,\n\t}\n\tif r.raftLog.hasNextOrInProgressUnstableEnts() {\n\t\t// If the raft log has unstable entries, attach the last index and term of the\n\t\t// append to the response message. This (index, term) tuple will be handed back\n\t\t// and consulted when the stability of those log entries is signaled to the\n\t\t// unstable. If the (index, term) match the unstable log by the time the\n\t\t// response is received (unstable.stableTo), the unstable log can be truncated.\n{\n  \"id\": \"B-recovery\",\n  \"primary_activity\": \"A3\",\n  \"execution_owner\": \"newRaft, raft.restore and confchange.Restore\",\n  \"protocol_context\": \"Startup or follower snapshot installation\",\n  \"trigger\": \"Storage InitialState or MsgSnap\",\n  \"legal_preconditions\": [],\n  \"implementation_guards\": [\n    \"Startup validates saved Commit within available log range. Snapshot must exceed commit and include local member; matching snapshot term/index fast-forwards commit instead of replacing log.\"\n  ],\n  \"reads\": [],\n  \"writes\": [\n    \"Restore term/vote/commit and configuration; start follower. Full snapshot replaces unstable log and membership; campaign blocked until snapshot completion.\"\n  ],\n  \"durable_effects\": [],\n  \"external_effects\": [],\n  \"important_branches\": [\n    \"Bootstrap requires empty storage and supplied peers, appends term-one configuration entries, marks them committed, applies membership while leaving application progress pending.\"\n  ],\n  \"async_boundaries\": [],\n  \"produces_fact_ids\": [\n    \"F-config\",\n    \"F-committed\"\n  ],\n  \"consumes_fact_ids\": [],\n  \"cross_activity_effects\": {\n    \"A1\": \"Recovered commit and snapshot prefix constrain further append and application.\",\n    \"A2\": \"Restores vote and eligibility while discarding transient leadership.\"\n  },\n  \"existing_protections\": [],\n  \"source_ids\": [\n    \"startup\",\n    \"snapshot-restore\",\n    \"config-restore\",\n    \"log-start-append\",\n    \"log-eligibility\",\n    \"unstable-snapshot\",\n    \"config-activate\",\n    \"storage-contract\",\n    \"bootstrap\"\n  ],\n  \"unknowns\": []\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nm=json.load(open('../audit-spec/v5.json'))\nfor b in m['behaviors']:\n if b['id']=='B-recovery':\n  b['existing_protections'].append('A full restore sets committed to the snapshot index; every later accepted replacement must exceed that committed index. stableSnapTo clears only a pending snapshot with exactly the completed index, so an older completion cannot clear a strictly newer replacement. appliedSnap advances reported application monotonically without reinstalling membership; promotable and committed-entry delivery continue to test for any pending or in-progress snapshot.')\n  b['source_ids']=sorted(set(b['source_ids']+['term-filter','step-vote','apply-progress','log-apply']))\njson.dump(m,open('core-map-v5-refined.json','w'),indent=2)\ns=dict(action='research',rationale='Retain the source protection against stale snapshot completion clearing a newer pending snapshot; distinguish it from cross-worker application ordering.',map_path='core-map-v5-refined.json',map_changes={'B-recovery':dict(impact='clarification',source_ids=['snapshot-restore','unstable-snapshot','log-eligibility','apply-progress','term-filter','log-apply'],rationale='Follow accepted snapshot indexes through replacement, completion identity and eligibility consumers. This clarifies existing recovery guards without adding a Fact or execution claim.',preserves='Existing Fact identities, producers/consumers, requirements and observation scopes are unchanged. The explanation narrows one unformalized suspicion and neither changes nor broadens the retained synchronous findings.')},sources=[],feedback=dict(ref_ids=['snapshot-restore','unstable-snapshot','log-eligibility','term-filter','step-vote','apply-progress','log-apply','async-contract'],answered='The old-completion/new-snapshot suspicion is explained by complementary source protections. Full restore immediately sets committed to its snapshot index; restore rejects any subsequent snapshot at or below committed. Therefore a later accepted replacement has a strictly larger index. stableSnapTo only clears an exact index match, so an earlier response, including one accepted across a term change, leaves the newer snapshot pending. appliedSnap uses max(oldApplied, completedIndex) and does not restore the old ConfState. promotable and committed-entry delivery inspect the remaining pending/in-progress snapshot, preserving their block until its own completion. A matching-log snapshot instead fast-forwards commit without installing a replacement. These are code-derived relationships, not new execution Evidence or a proof of recovery correctness.',remaining=['Next discriminator: examine the embedding contract for ordering an outstanding MsgStorageApply batch against a newer snapshot handled by LocalAppendThread. The two local destinations may progress independently; determine which layer owns state-machine snapshot/application coordination before proposing a check.'],understanding='updated',rationale='Snapshot identity and monotonic commit settle the selected stale-marker question without a synthetic execution. The independent local-worker boundary is a different responsibility: a preserved pending marker does not itself establish correct external state-machine ordering. Source duties must determine its applicability first.'))\njson.dump(s,open('submission.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-02_10-41-34-etcd_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
