budget\\\")\\n    return 0\\n}\\n\\nfunc assuranceNewCluster(t *testing.T, count int) *assuranceCluster {\\n    c := &assuranceCluster{t:t}\\n    peers := make([]Peer, count)\\n    for i := range peers { peers[i].ID = uint64(i+1) }\\n    for i := 0; i < count; i++ {\\n        s := NewMemoryStorage()\\n        rn, err := NewRawNode(&Config{ID:uint64(i+1), ElectionTick:10, HeartbeatTick:1,\\n            Storage:s, AsyncStorageWrites:true, MaxInflightMsgs:16, MaxSizePerMsg:4096})\\n        if err != nil { t.Fatal(err) }\\n        if err := rn.Bootstrap(peers); err != nil { t.Fatal(err) }\\n        c.replicas = append(c.replicas, &assuranceReplica{rn:rn, store:s})\\n    }\\n    c.drain(0)\\n    if err := c.replicas[0].rn.Campaign(); err != nil { t.Fatal(err) }\\n    c.drain(0)\\n    if c.replicas[0].rn.BasicStatus().RaftState != StateLeader {\\n        t.Fatal(\\\"election prefix did not establish leader\\\")\\n    }\\n    return c\\n}\\n\\nfunc (c *assuranceCluster) observe(caseID, phase string, index, term uint64, data []byte, turns int) {\\n    persisted := 0\\n    indexes := []uint64{}\\n    for _, r := range c.replicas {\\n        last, err := r.store.LastIndex()\\n        if err != nil { c.t.Fatal(err) }\\n        indexes = append(indexes,last)\\n        if last >= index {\\n            es, err := r.store.Entries(index,index+1,^uint64(0))\\n            if err != nil { c.t.Fatal(err) }\\n            if len(es)==1 && es[0].Term==term && string(es[0].Data)==string(data) { persisted++ }\\n        }\\n    }\\n    leader := c.replicas[0]\\n    committed := leader.rn.BasicStatus().Commit\\n    threshold := len(c.replicas)/2+1\\n    assuranceEvent(map[string]interface{}{\\n        \\\"event\\\":\\\"checkpoint\\\", \\\"observation_id\\\":caseID+\\\"/\\\"+phase,\\n        \\\"case_id\\\":caseID, \\\"phase\\\":phase, \\\"schedule_complete\\\":true,\\n        \\\"target_index\\\":index, \\\"target_term\\\":term, \\\"leader_commit\\\":committed,\\n        \\\"leader_match\\\":leader.rn.raft.trk.Progress[1].Match,\\n        \\\"storage_last_indexes\\\":indexes, \\\"persisted_replicas\\\":persisted,\\n        \\\"quorum_threshold\\\":threshold, \\\"committed_target\\\":committed>=index,\\n        \\\"storage_quorum\\\":persisted>=threshold, \\\"drain_turns\\\":turns,\\n        \\\"held_append_count\\\":len(leader.appendQ),\\n        \\\"leader_state\\\":leader.rn.BasicStatus().RaftState.String(),\\n    })\\n}\\n\\nfunc TestAssuranceAsyncCommitSupport(t *testing.T) {\\n    for _, count := range []int{2,3} {\\n        t.Run(fmt.Sprintf(\\\"voters_%d\\\",count),func(t *testing.T) {\\n            c := assuranceNewCluster(t,count)\\n            leader := c.replicas[0].rn\\n            caseID := fmt.Sprintf(\\\"voters-%d\\\",count)\\n            data := []byte(\\\"assurance-proposal/\\\"+caseID)\\n            if err := leader.Propose(data); err != nil { t.Fatal(err) }\\n            index, term := leader.raft.raftLog.lastIndex(), leader.BasicStatus().Term\\n            for _, phase := range []string{\\\"leader_storage_held\\\",\\\"all_storage_released\\\"} {\\n                assuranceEvent(map[string]interface{}{\\n                    \\\"event\\\":\\\"admitted\\\", \\\"observation_id\\\":caseID+\\\"/\\\"+phase,\\n                    \\\"case_id\\\":caseID, \\\"target_index\\\":index, \\\"target_term\\\":term,\\n                    \\\"proposal_admitted\\\":true, \\\"voter_count\\\":count,\\n                })\\n                hold := uint64(1)\\n                if phase==\\\"all_storage_released\\\" { hold=0 }\\n                turns := c.drain(hold)\\n                c.observe(caseID,phase,index,term,data,turns)\\n            }\\n            assuranceEvent(map[string]interface{}{\\\"event\\\":\\\"scenario_complete\\\",\\\"case_id\\\":caseID,\\n                \\\"final_commit\\\":leader.BasicStatus().Commit,\\\"target_index\\\":index,\\n                \\\"final_applied\\\":leader.raft.raftLog.applied})\\n        })\\n    }\\n}\\n\",\n    \"description\": \"Serialized public RawNode driver with deterministic FIFO local storage workers and in-memory network. Four finite checkpoint operations over two complete proposal histories.\",\n    \"semantic_changes\": [\n      \"No implementation modifications; same-package access reads target index, self Match and applied index only.\",\n      \"MemoryStorage substitutes for durable backend completion. No crash recovery or filesystem durability claim.\",\n      \"Derived booleans compare raw leader commit >= target index and matching persisted replica count >= configured majority. Raw operands are emitted.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admission\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"proposal_admitted\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"entry\",\n        \"bootstrap-contract\",\n        \"async-contract\",\n        \"storage-memory\",\n        \"storage-snap-append\",\n        \"candidate-follower\",\n        \"campaign\",\n        \"apply-accept\",\n        \"storage-envelope\",\n        \"storage-tail\"\n      ],\n      \"expectation_ids\": [\n        \"async-contract\",\n        \"conf-contract\"\n      ],\n      \"binding_ids\": [\n        \"D-commit-aggregation\"\n      ],\n      \"derivation\": \"Create each RawNode with MemoryStorage and Bootstrap identical peers; drain bootstrap entries and invoke ApplyConfChange only on emitted committed configuration entries. Campaign through the public method and deliver actual produced messages until a leader emerges. Propose through RawNode; no term, role, log, tracker or commit assignments occur. Each local append queue processes FIFO and publishes carried responses only after writes. Apply queues are independently FIFO and consume real entries; public Step receives actual produced responses. After the proposal only the leader append worker is finitely held, which async-contract permits while other workers run; all held work is subsequently released. No Advance is called in async mode. The loop stops on lack of eligible work or a driver budget independently of the forbidden commitment predicate.\",\n      \"applicability\": \"Two separate clusters with two and three voters, no post-bootstrap configuration changes, no crashes, drops or ticks during the selected interval. The finite drain budget is a driver limit, not a liveness conclusion.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Synchronous Ready has different caller ordering, so this driver is restricted to the async public API.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-storage-qualified-commit\",\n      \"checker_id\": \"storage-qualified-commit\",\n      \"event\": \"checkpoint\",\n      \"binding_ids\": [\n        \"D-commit-aggregation\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"reply-queue\",\n          \"reset-append\",\n          \"leader-match\",\n          \"tracker-commit\",\n          \"majority\",\n          \"log-eligibility\"\n        ],\n        \"expectation_ids\": [\n          \"durability-expectation\",\n          \"async-contract\"\n        ],\n        \"binding_ids\": [\n          \"D-commit-aggregation\"\n        ],\n        \"derivation\": \"The implementation explicitly requires entries to be persisted before being counted toward commitment (durability-expectation). The async contract permits outgoing replication before local writes but requires storage-worker responses after ordered durable completion. Under a fixed simple voting configuration, commitment may use any majority of persisted matching replicas; it does not require the leader itself to have persisted when other replicas form a majority. This requirement is independent of the observed committed value and of a blanket expectation that delayed local writes block every commit.\",\n        \"applicability\": \"Non-Byzantine peers; stable fixed simple voter membership; async storage mode; current-term ordinary proposal; honest ordered storage workers, no crashes or data corruption. MemoryStorage represents successfully completed storage writes at the library boundary; no physical disk durability is measured.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"A three-voter leader may legally commit using both followers while its own append worker is delayed.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admission\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"storage-qualified-commit\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"schedule_complete\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"storage_quorum\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"committed_target\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"observation_id\"\n      ],\n      \"history_field\": null,\n      \"description\": \"At each completed scheduled checkpoint, commitment of the target implies a majority of independently inspected MemoryStorage replicas contain the target term/index/payload. No requirement for commitment is inferred from a merely available quorum.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Observations cover these fixed schedules and two cluster sizes, not all asynchronous interleavings.\",\n    \"MemoryStorage completion represents the embedding durability promise; actual crash durability is outside this check.\"\n  ]\n}","exit_code":0,"status":"completed"}}
