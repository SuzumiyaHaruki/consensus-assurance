  p.n.Status()\\n  }\\n  if !work {return}\\n }\\n c.t.Fatal(\\\"driver drain budget exhausted\\\")\\n}\\nfunc (c *assuranceNodeNetwork) status(label string) {\\n s:=c.peers[1].n.Status()\\n assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"checkpoint\\\",\\\"phase\\\":label,\\\"node\\\":s.ID,\\\"term\\\":s.Term,\\\"state\\\":s.RaftState.String(),\\\"commit\\\":s.Commit,\\\"reported_applied\\\":s.Applied,\\\"config\\\":s.Config,\\\"progress\\\":s.Progress,\\\"deferred_batches\\\":len(c.peers[1].deferred),\\\"read_count\\\":len(c.peers[1].reads),\\\"held_messages\\\":len(c.held)})\\n}\\nfunc TestAssuranceConfigurationAgreement(t *testing.T) {\\n for _,delayed:=range []bool{false,true} { t.Run(fmt.Sprintf(\\\"delayed-%t\\\",delayed),func(t *testing.T) {\\n ctx,cancel:=context.WithTimeout(context.Background(),30*time.Second);defer cancel()\\n c:=&assuranceNodeNetwork{t:t,ctx:ctx}\\n peers:=[]Peer{{ID:1},{ID:2},{ID:3},{ID:4},{ID:5}}\\n for i:=1;i<=5;i++ {\\n  s:=NewMemoryStorage()\\n  n:=StartNode(&Config{ID:uint64(i),ElectionTick:10,HeartbeatTick:1,Storage:s,MaxInflightMsgs:16,MaxSizePerMsg:4096},peers)\\n  c.peers=append(c.peers,&assuranceNodePeer{n:n,s:s});defer n.Stop()\\n }\\n c.drain()\\n if err:=c.peers[0].n.Campaign(ctx);err!=nil {t.Fatal(err)}\\n c.drain()\\n if c.peers[0].n.Status().RaftState!=StateLeader {t.Fatal(\\\"initial election not reached\\\")}\\n c.peers[0].freezeApply=delayed\\n for _,removeID:=range []uint64{2,3} {\\n  if err:=c.peers[0].n.ProposeConfChange(ctx,pb.ConfChange{Type:pb.ConfChangeRemoveNode,NodeID:removeID});err!=nil {t.Fatal(err)}\\n  c.drain()\\n  for _,p:=range c.peers {\\n   st:=p.n.Status()\\n   assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"membership_checkpoint\\\",\\\"removed_proposal\\\":removeID,\\\"node\\\":st.ID,\\\"term\\\":st.Term,\\\"commit\\\":st.Commit,\\\"reported_applied\\\":st.Applied,\\\"config\\\":st.Config,\\\"deferred_batches\\\":len(p.deferred)})\\n  }\\n }\\n // Nodes 2 and 3 remain running after applying removal; they receive only\\n // actual protocol messages. No removed identity is reused or re-added.\\n last,err:=c.peers[0].s.LastIndex();if err!=nil {t.Fatal(err)}\\n target:=last+1\\n assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"comparison_admitted\\\",\\\"scenario_id\\\":t.Name(),\\\"target_index\\\":target,\\\"history_ready\\\":true,\\\"delayed_application\\\":delayed})\\n c.restrict=true\\n if err:=c.peers[0].n.Propose(ctx,[]byte(\\\"assurance/old-config-command\\\"));err!=nil {t.Fatal(err)}\\n c.drain()\\n left:=c.peers[0].n.Status()\\n assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"old_commit\\\",\\\"node\\\":left.ID,\\\"term\\\":left.Term,\\\"commit\\\":left.Commit,\\\"config\\\":left.Config})\\n if err:=c.peers[3].n.Campaign(ctx);err!=nil {t.Fatal(err)}\\n c.drain()\\n // Finish the deferred application FIFO without healing the partition.\\n p:=c.peers[0]\\n for _,batch:=range p.deferred {c.apply(p,batch)}\\n p.deferred=nil;p.freezeApply=false\\n c.drain()\\n assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"application_finished\\\",\\\"node\\\":uint64(1),\\\"reported_applied\\\":p.n.Status().Applied,\\\"config\\\":p.n.Status().Config})\\n left=c.peers[0].n.Status()\\n right:=c.peers[3].n.Status()\\n le,err:=c.peers[0].s.Entries(target,target+1,^uint64(0));if err!=nil {t.Fatal(err)}\\n re,err:=c.peers[3].s.Entries(target,target+1,^uint64(0));if err!=nil {t.Fatal(err)}\\n if len(le)!=1 || len(re)!=1 {t.Fatal(\\\"missing observation entry\\\")}\\n equal:=le[0].Term==re[0].Term && le[0].Type==re[0].Type && string(le[0].Data)==string(re[0].Data)\\n assuranceNodeEvent(map[string]interface{}{\\\"event\\\":\\\"agreement_observed\\\",\\\"scenario_id\\\":t.Name(),\\\"target_index\\\":target,\\\"completed\\\":true,\\\"both_committed\\\":left.Commit>=target && right.Commit>=target,\\\"entries_equal\\\":equal,\\\"left_entry\\\":le[0],\\\"right_entry\\\":re[0],\\\"left_commit\\\":left.Commit,\\\"right_commit\\\":right.Commit,\\\"left_config\\\":left.Config,\\\"right_config\\\":right.Config,\\\"left_term\\\":left.Term,\\\"right_term\\\":right.Term,\\\"held_messages\\\":len(c.held),\\\"deferred_batches\\\":len(p.deferred)})\\n }) }\\n}\\n\",\n    \"description\": \"Public Node network and MemoryStorage, two ordered removals, deterministic partition, actual old-side proposal and new-side campaign, ordered application completion and independent store observations.\",\n    \"semantic_changes\": [\n      \"No target modifications or private critical-state assignments.\",\n      \"Normal-entry application is a no-op; configuration entries call the actual ApplyConfChange.\",\n      \"MemoryStorage represents successful persistence under a no-crash assumption.\",\n      \"both_committed compares each public commit index against the independently preselected target index; entries_equal compares actual stored term/type/data. Raw operands are emitted.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"comparison\",\n        \"event\": \"comparison_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"history_ready\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"node-start-and-restart\",\n        \"node-step-and-read\",\n        \"node-control-methods\",\n        \"node-loop\",\n        \"doc-early-advance\",\n        \"node-early-advance\",\n        \"bootstrap-contract\",\n        \"storage-memory\",\n        \"storage-snap-append\",\n        \"campaign\",\n        \"candidate-follower\",\n        \"config-activate\",\n        \"leader-admit\",\n        \"mode-contract\",\n        \"membership-doc\",\n        \"status-copy\"\n      ],\n      \"expectation_ids\": [\n        \"doc-early-advance\",\n        \"node-early-advance\",\n        \"conf-contract\",\n        \"conf-proposal-contract\",\n        \"membership-doc\"\n      ],\n      \"binding_ids\": [\n        \"D-commit-agreement\"\n      ],\n      \"derivation\": \"Five public Nodes start with identical bootstrap voters. Ready Entries and HardState are persisted before emitted messages or Advance; there are no snapshots, crashes or private state assignments. A real election establishes node 1. Propose removal of node 2 and drain actual traffic; then propose removal of node 3 and drain. In the delayed variant only node 1 defers every application batch in FIFO order while advancing after persistence under the explicit synchronous permission. Other peers apply all configurations normally. Removed peers remain alive and process only actual messages; no identity is reused. Partition {1,2,3} from {4,5} by retaining all actual cross-partition messages. Select the next log index from storage before either competing entry exists. Propose a normal command at node 1, then campaign node 4 with actual vote and replication messages. Finish every deferred node-1 application batch in original order and drain without healing the partition. Read both independent stores and public Status commit indexes. The prompt-application variant runs the same schedule but activates all configurations before advancing. It may leave the old-side command uncommitted, which is permitted. Stop all Nodes independently of equality.\",\n      \"applicability\": \"No ticks or failure-detection deadline is assumed. Five-millisecond Ready waits and the bounded drain loop are scheduling controls, not the property oracle; timeout, missing entries or panic are incomplete execution. The two subtests are independent histories and never combined into one witness. Comparison uses a preselected index and scenario identity, not the differing entry terms or values.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"A stronger caller rule requiring configuration activation before Advance would exclude this history, but the acquired Node and doc.go statements explicitly permit Advance before application completion; correspondence must preserve that premise and any conflicting contract.\",\n        \"A committed conflict panic after healing is not needed or induced; independent committed endpoints are compared while the partition remains.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-configuration-agreement\",\n      \"checker_id\": \"configuration-agreement\",\n      \"event\": \"agreement_observed\",\n      \"binding_ids\": [\n        \"D-commit-agreement\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"membership-doc\",\n          \"replicated-machine-expectation\",\n          \"log-start-append\",\n          \"leader-match\",\n          \"config-activate\",\n          \"node-early-advance\",\n          \"doc-early-advance\"\n        ],\n        \"expectation_ids\": [\n          \"replicated-machine-expectation\",\n          \"membership-doc\"\n        ],\n        \"binding_ids\": [\n          \"D-commit-agreement\"\n        ],\n        \"derivation\": \"The package promises a replicated log keeping replicated state machines in sync, and states that its application-activated one-node membership changes preserve safety through configuration overlap. The necessary log-agreement responsibility is that entries declared committed at the same log index on two participating nodes agree in term, type and command data. This is a necessity, not a requirement that every accepted proposal commit. The committed-conflict panic in maybeAppend is supporting code evidence, not the normative source. A default propose-time best-effort validator is not itself a safety guarantee.\",\n        \"applicability\": \"Synchronous public Node with default configuration validation; successful storage and no crashes; sequential single-voter removals and a network partition. Both compared nodes remain members of the final activated configuration. Application may trail Advance under explicit documentation but must eventually apply all committed batches in order.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"ProposeConfChange can drop proposals, so actual committed entries and resulting configurations must be observed.\",\n          \"Best-effort validation can accept a configuration that later panics; this history must complete all required ApplyConfChange calls to distinguish that case.\",\n          \"A node with an uncommitted competing entry does not violate agreement; the antecedent requires both observed commit indexes to cover the selected index.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"comparison\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"configuration-agreement\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"entries_equal\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"both_committed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"scenario_id\",\n        \"target_index\"\n      ],\n      \"history_field\": null,\n      \"description\": \"If both same-group nodes declare the independently selected index committed, their stored entries there must agree. A different uncommitted entry is permitted.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Applicability depends on the documented synchronous early-Advance permission covering delayed configuration application and continued processing by removed peers.\",\n    \"This bounded history does not establish all configuration schedules or an external client-visible application result.\"\n  ]\n}","exit_code":0,"status":"completed"}}
