n *NetworkTransport) RequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error {\nnet_transport.go:477:\treturn n.genericRPC(id, target, rpcRequestPreVote, args, resp)\nnet_transport.go:691:\tcase rpcRequestPreVote:\nnet_transport.go:692:\t\tvar req RequestPreVoteRequest\nnet_transport.go:697:\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"RequestPreVote\"}}\nraft.go:293:\tvar prevoteCh <-chan *preVoteResult\nraft.go:297:\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\nraft.go:314:\tpreVoteGrantedVotes := 0\nraft.go:315:\tpreVoteRefusedVotes := 0\nraft.go:327:\t\tcase preVote := <-prevoteCh:\nraft.go:330:\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\nraft.go:332:\t\t\tif preVote.Term > term {\nraft.go:333:\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\nraft.go:335:\t\t\t\tr.setCurrentTerm(preVote.Term)\nraft.go:339:\t\t\t// Check if the preVote is granted\nraft.go:340:\t\t\tif preVote.Granted {\nraft.go:341:\t\t\t\tpreVoteGrantedVotes++\nraft.go:342:\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\nraft.go:344:\t\t\t\tpreVoteRefusedVotes++\nraft.go:345:\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\nraft.go:349:\t\t\tif preVoteGrantedVotes >= votesNeeded {\nraft.go:350:\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\nraft.go:351:\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\nraft.go:352:\t\t\t\tpreVoteGrantedVotes = 0\nraft.go:353:\t\t\t\tpreVoteRefusedVotes = 0\nraft.go:360:\t\t\tif preVoteRefusedVotes >= votesNeeded {\nraft.go:361:\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\nraft.go:362:\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\nraft.go:1419:\tcase *RequestPreVoteRequest:\nraft.go:1420:\t\tr.requestPreVote(rpc, cmd)\nraft.go:1758:// requestPreVote is invoked when we get a request Pre-Vote RPC call.\nraft.go:1759:func (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\nraft.go:1760:\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestPreVote\"}, time.Now())\nraft.go:1764:\tresp := &RequestPreVoteResponse{\nraft.go:1801:\t\tr.logger.Debug(\"received a requestPreVote with a newer term, grant the pre-vote\")\nraft.go:1990:type preVoteResult struct {\nraft.go:1991:\tRequestPreVoteResponse\nraft.go:2068:// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\nraft.go:2073:func (r *Raft) preElectSelf() <-chan *preVoteResult {\nraft.go:2077:\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\nraft.go:2083:\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\nraft.go:2090:\treq := &RequestPreVoteRequest{\nraft.go:2101:\t\t\tresp := &preVoteResult{voterID: peer.ID}\nraft.go:2103:\t\t\terr := prevoteTrans.RequestPreVote(peer.ID, peer.Address, req, &resp.RequestPreVoteResponse)\nraft.go:2134:\t\t\t\trespCh <- &preVoteResult{\nraft.go:2135:\t\t\t\t\tRequestPreVoteResponse: RequestPreVoteResponse{\nraft_test.go:2263:// TestRaft_PreVoteMixedCluster focus on testing a cluster with\nraft_test.go:2267:func TestRaft_PreVoteMixedCluster(t *testing.T) {\nraft_test.go:2293:\t\t\tconf.PreVoteDisabled = tc.prevoteNum <= tc.noprevoteNum\nraft_test.go:2299:\t\t\tconf.PreVoteDisabled = tc.prevoteNum >= tc.noprevoteNum\nraft_test.go:2325:func TestRaft_PreVoteAvoidElectionWithPartition(t *testing.T) {\nraft_test.go:2328:\tconf.PreVoteDisabled = false\nraft_test.go:3421:func TestRaft_PreVote_ShouldNotRejectLeader(t *testing.T) {\nraft_test.go:3444:\treqPreVote := RequestPreVoteRequest{\nraft_test.go:3451:\tvar resp RequestPreVoteResponse\nraft_test.go:3453:\tif err := leaderT.RequestPreVote(follower.localID, follower.localAddr, &reqPreVote, &resp); err != nil {\nraft_test.go:3454:\t\tt.Fatalf(\"RequestPreVote RPC failed %v\", err)\nraft_test.go:3463:func TestRaft_PreVote_ShouldRejectNonLeader(t *testing.T) {\n","exit_code":0,"status":"completed"}}
