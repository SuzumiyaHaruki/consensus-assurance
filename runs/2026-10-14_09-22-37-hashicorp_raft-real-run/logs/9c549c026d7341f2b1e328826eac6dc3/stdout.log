l, error) {\n769:\t// Decode the error if any\n770:\tvar rpcError string\n771:\tif err := conn.dec.Decode(&rpcError); err != nil {\n782:\t// Format an error if any\n783:\tif rpcError != \"\" {\n784:\t\treturn true, errors.New(rpcError)\n790:func sendRPC(conn *netConn, rpcType uint8, args interface{}) error {\n861:func (n *netPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n886:\t\treturn nil, ErrPipelineShutdown\n896:func (n *netPipeline) Close() error {\n","exit_code":0,"status":"completed"}}
