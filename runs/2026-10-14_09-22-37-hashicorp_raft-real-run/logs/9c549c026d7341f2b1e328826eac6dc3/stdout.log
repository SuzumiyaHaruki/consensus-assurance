Term,\n  1516\t\t\t\t\t\"remote\", a.PrevLogTerm)\n  1517\t\t\t\tresp.NoRetryBackoff = true\n  1518\t\t\t\treturn\n  1519\t\t\t}\n  1520\t\t}\n  1521\t\n  1522\t\t// Process any new entries\n  1523\t\tif len(a.Entries) > 0 {\n  1524\t\t\tstart := time.Now()\n  1525\t\n  1526\t\t\t// Delete any conflicting entries, skip any duplicates\n  1527\t\t\tlastLogIdx, _ := r.getLastLog()\n  1528\t\t\tvar newEntries []*Log\n  1529\t\t\tfor i, entry := range a.Entries {\n  1530\t\t\t\tif entry.Index > lastLogIdx {\n  1531\t\t\t\t\tnewEntries = a.Entries[i:]\n  1532\t\t\t\t\tbreak\n  1533\t\t\t\t}\n  1534\t\t\t\tvar storeEntry Log\n  1535\t\t\t\tif err := r.logs.GetLog(entry.Index, &storeEntry); err != nil {\n  1536\t\t\t\t\tr.logger.Warn(\"failed to get log entry\",\n  1537\t\t\t\t\t\t\"index\", entry.Index,\n  1538\t\t\t\t\t\t\"error\", err)\n  1539\t\t\t\t\treturn\n  1540\t\t\t\t}\n  1541\t\t\t\tif entry.Term != storeEntry.Term {\n  1542\t\t\t\t\tr.logger.Warn(\"clearing log suffix\", \"from\", entry.Index, \"to\", lastLogIdx)\n  1543\t\t\t\t\tif err := r.logs.DeleteRange(entry.Index, lastLogIdx); err != nil {\n  1544\t\t\t\t\t\tr.logger.Error(\"failed to clear log suffix\", \"error\", err)\n  1545\t\t\t\t\t\treturn\n  1546\t\t\t\t\t}\n  1547\t\t\t\t\tif entry.Index <= r.configurations.latestIndex {\n  1548\t\t\t\t\t\tr.setLatestConfiguration(r.configurations.committed, r.configurations.committedIndex)\n  1549\t\t\t\t\t}\n  1550\t\t\t\t\tnewEntries = a.Entries[i:]\n  1551\t\t\t\t\tbreak\n  1552\t\t\t\t}\n  1553\t\t\t}\n  1554\t\n  1555\t\t\tif n := len(newEntries); n > 0 {\n  1556\t\t\t\t// Stage the future commit index if possible\n  1557\t\t\t\tlastNewIndex := newEntries[len(newEntries)-1].Index\n  1558\t\t\t\tcommitIndex := min(a.LeaderCommitIndex, lastNewIndex)\n  1559\t\t\t\tr.tryStageCommitIndex(commitIndex)\n  1560\t\n  1561\t\t\t\t// Append the new entries\n  1562\t\t\t\tif err := r.logs.StoreLogs(newEntries); err != nil {\n  1563\t\t\t\t\tr.logger.Error(\"failed to append to logs\", \"error\", err)\n  1564\t\t\t\t\t// TODO: leaving r.getLastLog() in the wrong\n  1565\t\t\t\t\t// state if there was a truncation above\n  1566\t\t\t\t\treturn\n  1567\t\t\t\t}\n  1568\t\n  1569\t\t\t\t// Handle any new configuration changes\n  1570\t\t\t\tfor _, newEntry := range newEntries {\n  1571\t\t\t\t\tif err := r.processConfigurationLogEntry(newEntry); err != nil {\n  1572\t\t\t\t\t\tr.logger.Warn(\"failed to append entry\",\n  1573\t\t\t\t\t\t\t\"index\", newEntry.Index,\n  1574\t\t\t\t\t\t\t\"error\", err)\n  1575\t\t\t\t\t\trpcErr = err\n  1576\t\t\t\t\t\treturn\n  1577\t\t\t\t\t}\n  1578\t\t\t\t}\n  1579\t\n  1580\t\t\t\t// Update the lastLog\n  1581\t\t\t\tlast := newEntries[n-1]\n  1582\t\t\t\tr.setLastLog(last.Index, last.Term)\n  1583\t\t\t}\n  1584\t\n  1585\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"storeLogs\"}, start)\n  1586\t\t}\n  1587\t\n  1588\t\t// Update the commit index\n  1589\t\tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n  1590\t\t\tstart := time.Now()\n  1591\t\t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n  1592\t\t\tr.setCommitIndex(idx)\n  1593\t\t\tif r.configurations.latestIndex <= idx {\n  1594\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1595\t\t\t}\n  1596\t\t\tr.processLogs(idx, nil)\n  1597\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n  1598\t\t}\n  1599\t\n  1600\t\t// Everything went well, set success\n  1601\t\tresp.Success = true\n  1602\t\tr.setLastContact()\n  1603\t}\n  1604\t\n  1605\t// processConfigurationLogEntry takes a log entry and updates the latest\n  1606\t// configuration if the entry results in a new configuration. This must only be\n  1607\t// called from the main thread, or from NewRaft() before any threads have begun.\n  1608\tfunc (r *Raft) processConfigurationLogEntry(entry *Log) error {\n  1609\t\tswitch entry.Type {\n  1610\t\tcase LogConfiguration:\n  1611\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1612\t\t\tr.setLatestConfiguration(DecodeConfiguration(entry.Data), entry.Index)\n  1613\t\n  1614\t\tcase LogAddPeerDeprecated, LogRemovePeerDeprecated:\n  1615\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1616\t\t\tconf, err := decodePeers(entry.Data, r.trans)\n  1617\t\t\tif err != nil {\n  1618\t\t\t\treturn err\n  1619\t\t\t}\n  1620\t\t\tr.setLatestConfiguration(conf, entry.Index)\n  1621\t\t}\n  1622\t\treturn nil\n  1623\t}\n  1624\t\n  1625\t// requestVote is invoked when we get a request vote RPC call.\n  1626\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n  1627\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n  1628\t\tr.observe(*req)\n  1629\t\n  1630\t\t// Setup a response\n  1631\t\tresp := &RequestVoteResponse{\n  1632\t\t\tRPCHeader: r.getRPCHeader(),\n  1633\t\t\tTerm:      r.getCurrentTerm(),\n  1634\t\t\tGranted:   false,\n  1635\t\t}\n  1636\t\tvar rpcErr error\n  1637\t\tdefer func() {\n  1638\t\t\trpc.Respond(resp, rpcErr)\n  1639\t\t}()\n  1640\t\n  1641\t\t// Version 0 servers will panic unless the peers is present. It's only\n  1642\t\t// used on them to produce a warning message.\n  1643\t\tif r.protocolVersion < 2 {\n  1644\t\t\tresp.Peers = encodePeers(r.configurations.latest, r.trans)\n  1645\t\t}\n  1646\t\n  1647\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1648\t\t// check the LeadershipTransfer flag is set. Usually votes are rejected if\n  1649\t\t// there is a known leader. But if the leader initiated a leadership transfer,\n  1650\t\t// vote!\n  1651\t\tvar candidate ServerAddress\n  1652\t\tvar candidateBytes []byte\n  1653\t\tif len(req.Addr) > 0 {\n  1654\t\t\tcandidate = r.trans.DecodePeer(req.Addr)\n  1655\t\t\tcandidateBytes = req.Addr\n  1656\t\t} else {\n  1657\t\t\tcandidate = r.trans.DecodePeer(req.Candidate)\n  1658\t\t\tcandidateBytes = req.Candidate\n  1659\t\t}\n  1660\t\n  1661\t\t// For older raft version ID is not part of the packed message\n  1662\t\t// We assume that the peer is part of the configuration and skip this check\n  1663\t\tif len(req.ID) > 0 {\n  1664\t\t\tcandidateID := ServerID(req.ID)\n  1665\t\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1666\t\t\t// Grant the vote\n  1667\t\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1668\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not in configuration\",\n  1669\t\t\t\t\t\"from\", candidate)\n  1670\t\t\t\treturn\n  1671\t\t\t}\n  1672\t\t}\n  1673\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate && !req.LeadershipTransfer {\n  1674\t\t\tr.logger.Warn(\"rejecting vote request since we have a leader\",\n  1675\t\t\t\t\"from\", candidate,\n  1676\t\t\t\t\"leader\", leaderAddr,\n  1677\t\t\t\t\"leader-id\", string(leaderID))\n  1678\t\t\treturn\n  1679\t\t}\n  1680\t\n  1681\t\t// Ignore an older term\n  1682\t\tif req.Term < r.getCurrentTerm() {\n  1683\t\t\treturn\n  1684\t\t}\n  1685\t\n  1686\t\t// Increase the term if we see a newer one\n  1687\t\tif req.Term > r.getCurrentTerm() {\n  1688\t\t\t// Ensure transition to follower\n  1689\t\t\tr.logger.Debug(\"lost leadership because received a requestVote with a newer term\")\n  1690\t\t\tr.setState(Follower)\n  1691\t\t\tr.setCurrentTerm(req.Term)\n  1692\t\n  1693\t\t\tresp.Term = req.Term\n  1694\t\t}\n  1695\t\n  1696\t\t// if we get a request for vote from a nonVoter  and the request term is higher,\n  1697\t\t// step down and update term, but reject the vote request\n  1698\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1699\t\t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n  1700\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n","exit_code":0,"status":"completed"}}
