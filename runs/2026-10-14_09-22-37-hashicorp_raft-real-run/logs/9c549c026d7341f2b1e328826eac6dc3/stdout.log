{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n util.go; echo ==== ; cat -n api.go | sed -n '1100,1330p'\"","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bytes\"\n     8\t\tcrand \"crypto/rand\"\n     9\t\t\"fmt\"\n    10\t\t\"math\"\n    11\t\t\"math/big\"\n    12\t\t\"math/rand\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/hashicorp/go-msgpack/v2/codec\"\n    16\t)\n    17\t\n    18\t// returns an int64 from a crypto random source\n    19\t// can be used to seed a source for a math/rand.\n    20\tfunc newSeed() int64 {\n    21\t\tr, err := crand.Int(crand.Reader, big.NewInt(math.MaxInt64))\n    22\t\tif err != nil {\n    23\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n    24\t\t}\n    25\t\treturn r.Int64()\n    26\t}\n    27\t\n    28\t// randomTimeout returns a value that is between the minVal and 2x minVal.\n    29\tfunc randomTimeout(minVal time.Duration) <-chan time.Time {\n    30\t\tif minVal == 0 {\n    31\t\t\treturn nil\n    32\t\t}\n    33\t\textra := time.Duration(rand.Int63()) % minVal\n    34\t\treturn time.After(minVal + extra)\n    35\t}\n    36\t\n    37\t// min returns the minimum.\n    38\tfunc min(a, b uint64) uint64 {\n    39\t\tif a <= b {\n    40\t\t\treturn a\n    41\t\t}\n    42\t\treturn b\n    43\t}\n    44\t\n    45\t// max returns the maximum.\n    46\tfunc max(a, b uint64) uint64 {\n    47\t\tif a >= b {\n    48\t\t\treturn a\n    49\t\t}\n    50\t\treturn b\n    51\t}\n    52\t\n    53\t// generateUUID is used to generate a random UUID.\n    54\tfunc generateUUID() string {\n    55\t\tbuf := make([]byte, 16)\n    56\t\tif _, err := crand.Read(buf); err != nil {\n    57\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n    58\t\t}\n    59\t\n    60\t\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%12x\",\n    61\t\t\tbuf[0:4],\n    62\t\t\tbuf[4:6],\n    63\t\t\tbuf[6:8],\n    64\t\t\tbuf[8:10],\n    65\t\t\tbuf[10:16])\n    66\t}\n    67\t\n    68\t// asyncNotifyCh is used to do an async channel send\n    69\t// to a single channel without blocking.\n    70\tfunc asyncNotifyCh(ch chan struct{}) {\n    71\t\tselect {\n    72\t\tcase ch <- struct{}{}:\n    73\t\tdefault:\n    74\t\t}\n    75\t}\n    76\t\n    77\t// drainNotifyCh empties out a single-item notification channel without\n    78\t// blocking, and returns whether it received anything.\n    79\tfunc drainNotifyCh(ch chan struct{}) bool {\n    80\t\tselect {\n    81\t\tcase <-ch:\n    82\t\t\treturn true\n    83\t\tdefault:\n    84\t\t\treturn false\n    85\t\t}\n    86\t}\n    87\t\n    88\t// overrideNotifyBool is used to notify on a bool channel\n    89\t// but override existing value if value is present.\n    90\t// ch must be 1-item buffered channel.\n    91\t//\n    92\t// This method does not support multiple concurrent calls.\n    93\tfunc overrideNotifyBool(ch chan bool, v bool) {\n    94\t\tselect {\n    95\t\tcase ch <- v:\n    96\t\t\t// value sent, all done\n    97\t\tcase <-ch:\n    98\t\t\t// channel had an old value\n    99\t\t\tselect {\n   100\t\t\tcase ch <- v:\n   101\t\t\tdefault:\n   102\t\t\t\tpanic(\"race: channel was sent concurrently\")\n   103\t\t\t}\n   104\t\t}\n   105\t}\n   106\t\n   107\t// Decode reverses the encode operation on a byte slice input.\n   108\tfunc decodeMsgPack(buf []byte, out interface{}) error {\n   109\t\tr := bytes.NewBuffer(buf)\n   110\t\thd := codec.MsgpackHandle{}\n   111\t\tdec := codec.NewDecoder(r, &hd)\n   112\t\treturn dec.Decode(out)\n   113\t}\n   114\t\n   115\t// Encode writes an encoded object to a new bytes buffer.\n   116\tfunc encodeMsgPack(in interface{}) (*bytes.Buffer, error) {\n   117\t\tbuf := bytes.NewBuffer(nil)\n   118\t\thd := codec.MsgpackHandle{}\n   119\t\thd.TimeNotBuiltin = true\n   120\t\n   121\t\tenc := codec.NewEncoder(buf, &hd)\n   122\t\terr := enc.Encode(in)\n   123\t\treturn buf, err\n   124\t}\n   125\t\n   126\t// backoff is used to compute an exponential backoff\n   127\t// duration. Base time is scaled by the current round,\n   128\t// up to some maximum scale factor.\n   129\tfunc backoff(base time.Duration, round, limit uint64) time.Duration {\n   130\t\tpower := min(round, limit)\n   131\t\tfor power > 2 {\n   132\t\t\tbase *= 2\n   133\t\t\tpower--\n   134\t\t}\n   135\t\treturn base\n   136\t}\n   137\t\n   138\t// cappedExponentialBackoff computes the exponential backoff with an adjustable\n   139\t// cap on the max timeout.\n   140\tfunc cappedExponentialBackoff(base time.Duration, round, limit uint64, cap time.Duration) time.Duration {\n   141\t\tpower := min(round, limit)\n   142\t\tfor power > 2 {\n   143\t\t\tif base > cap {\n   144\t\t\t\treturn cap\n   145\t\t\t}\n   146\t\t\tbase *= 2\n   147\t\t\tpower--\n   148\t\t}\n   149\t\tif base > cap {\n   150\t\t\treturn cap\n   151\t\t}\n   152\t\treturn base\n   153\t}\n   154\t\n   155\t// Needed for sorting []uint64, used to determine commitment\n   156\ttype uint64Slice []uint64\n   157\t\n   158\tfunc (p uint64Slice) Len() int           { return len(p) }\n   159\tfunc (p uint64Slice) Less(i, j int) bool { return p[i] < p[j] }\n   160\tfunc (p uint64Slice) Swap(i, j int)      { p[i], p[j] = p[j], p[i] }\n====\n  1100\t// then sets itself up so that it replicates that to its followers though the\n  1101\t// install snapshot process. This involves a potentially dangerous period where\n  1102\t// the leader commits ahead of its followers, so should only be used for disaster\n  1103\t// recovery into a fresh cluster, and should not be used in normal operations.\n  1104\tfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n  1105\t\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n  1106\t\tvar timer <-chan time.Time\n  1107\t\tif timeout > 0 {\n  1108\t\t\ttimer = time.After(timeout)\n  1109\t\t}\n  1110\t\n  1111\t\t// Perform the restore.\n  1112\t\trestore := &userRestoreFuture{\n  1113\t\t\tmeta:   meta,\n  1114\t\t\treader: reader,\n  1115\t\t}\n  1116\t\trestore.init()\n  1117\t\tselect {\n  1118\t\tcase <-timer:\n  1119\t\t\treturn ErrEnqueueTimeout\n  1120\t\tcase <-r.shutdownCh:\n  1121\t\t\treturn ErrRaftShutdown\n  1122\t\tcase r.userRestoreCh <- restore:\n  1123\t\t\t// If the restore is ingested then wait for it to complete.\n  1124\t\t\tif err := restore.Error(); err != nil {\n  1125\t\t\t\treturn err\n  1126\t\t\t}\n  1127\t\t}\n  1128\t\n  1129\t\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n  1130\t\t// followers have gotten the restore and replicated at least this new\n  1131\t\t// entry, which shows that we've also faulted and installed the\n  1132\t\t// snapshot with the contents of the restore.\n  1133\t\tnoop := &logFuture{\n  1134\t\t\tlog: Log{\n  1135\t\t\t\tType: LogNoop,\n  1136\t\t\t},\n  1137\t\t}\n  1138\t\tnoop.init()\n  1139\t\tselect {\n  1140\t\tcase <-timer:\n  1141\t\t\treturn ErrEnqueueTimeout\n  1142\t\tcase <-r.shutdownCh:\n  1143\t\t\treturn ErrRaftShutdown\n  1144\t\tcase r.applyCh <- noop:\n  1145\t\t\treturn noop.Error()\n  1146\t\t}\n  1147\t}\n  1148\t\n  1149\t// State returns the state of this raft peer.\n  1150\tfunc (r *Raft) State() RaftState {\n  1151\t\treturn r.getState()\n  1152\t}\n  1153\t\n  1154\t// LeaderCh is used to get a channel which delivers signals on acquiring or\n  1155\t// losing leadership. It sends true if we become the leader, and false if we\n  1156\t// lose it.\n  1157\t//\n  1158\t// Receivers can expect to receive a notification only if leadership\n  1159\t// transition has occurred.\n  1160\t//\n  1161\t// If receivers aren't ready for the signal, signals may drop and only the\n  1162\t// latest leadership transition. For example, if a receiver receives subsequent\n  1163\t// `true` values, they may deduce that leadership was lost and regained while\n  1164\t// the receiver was processing first leadership transition.\n  1165\tfunc (r *Raft) LeaderCh() <-chan bool {\n  1166\t\treturn r.leaderCh\n  1167\t}\n  1168\t\n  1169\t// String returns a string representation of this Raft node.\n  1170\tfunc (r *Raft) String() string {\n  1171\t\treturn fmt.Sprintf(\"Node at %s [%v]\", r.localAddr, r.getState())\n  1172\t}\n  1173\t\n  1174\t// LastContact returns the time of last contact by a leader.\n  1175\t// This only makes sense if we are currently a follower.\n  1176\tfunc (r *Raft) LastContact() time.Time {\n  1177\t\tr.lastContactLock.RLock()\n  1178\t\tlast := r.lastContact\n  1179\t\tr.lastContactLock.RUnlock()\n  1180\t\treturn last\n  1181\t}\n  1182\t\n  1183\t// Stats is used to return a map of various internal stats. This\n  1184\t// should only be used for informative purposes or debugging.\n  1185\t//\n  1186\t// Keys are: \"state\", \"term\", \"last_log_index\", \"last_log_term\",\n  1187\t// \"commit_index\", \"applied_index\", \"fsm_pending\",\n  1188\t// \"last_snapshot_index\", \"last_snapshot_term\",\n  1189\t// \"latest_configuration\", \"last_contact\", and \"num_peers\".\n  1190\t//\n  1191\t// The value of \"state\" is a numeric constant representing one of\n  1192\t// the possible leadership states the node is in at any given time.\n  1193\t// the possible states are: \"Follower\", \"Candidate\", \"Leader\", \"Shutdown\".\n  1194\t//\n  1195\t// The value of \"latest_configuration\" is a string which contains\n  1196\t// the id of each server, its suffrage status, and its address.\n  1197\t//\n  1198\t// The value of \"last_contact\" is either \"never\" if there\n  1199\t// has been no contact with a leader, \"0\" if the node is in the\n  1200\t// leader state, or the time since last contact with a leader\n  1201\t// formatted as a string.\n  1202\t//\n  1203\t// The value of \"num_peers\" is the number of other voting servers in the\n  1204\t// cluster, not including this node. If this node isn't part of the\n  1205\t// configuration then this will be \"0\".\n  1206\t//\n  1207\t// All other values are uint64s, formatted as strings.\n  1208\tfunc (r *Raft) Stats() map[string]string {\n  1209\t\ttoString := func(v uint64) string {\n  1210\t\t\treturn strconv.FormatUint(v, 10)\n  1211\t\t}\n  1212\t\tlastLogIndex, lastLogTerm := r.getLastLog()\n  1213\t\tlastSnapIndex, lastSnapTerm := r.getLastSnapshot()\n  1214\t\ts := map[string]string{\n  1215\t\t\t\"state\":                r.getState().String(),\n  1216\t\t\t\"term\":                 toString(r.getCurrentTerm()),\n  1217\t\t\t\"last_log_index\":       toString(lastLogIndex),\n  1218\t\t\t\"last_log_term\":        toString(lastLogTerm),\n  1219\t\t\t\"commit_index\":         toString(r.getCommitIndex()),\n  1220\t\t\t\"applied_index\":        toString(r.getLastApplied()),\n  1221\t\t\t\"fsm_pending\":          toString(uint64(len(r.fsmMutateCh))),\n  1222\t\t\t\"last_snapshot_index\":  toString(lastSnapIndex),\n  1223\t\t\t\"last_snapshot_term\":   toString(lastSnapTerm),\n  1224\t\t\t\"protocol_version\":     toString(uint64(r.protocolVersion)),\n  1225\t\t\t\"protocol_version_min\": toString(uint64(ProtocolVersionMin)),\n  1226\t\t\t\"protocol_version_max\": toString(uint64(ProtocolVersionMax)),\n  1227\t\t\t\"snapshot_version_min\": toString(uint64(SnapshotVersionMin)),\n  1228\t\t\t\"snapshot_version_max\": toString(uint64(SnapshotVersionMax)),\n  1229\t\t}\n  1230\t\n  1231\t\tfuture := r.GetConfiguration()\n  1232\t\tif err := future.Error(); err != nil {\n  1233\t\t\tr.logger.Warn(\"could not get configuration for stats\", \"error\", err)\n  1234\t\t} else {\n  1235\t\t\tconfiguration := future.Configuration()\n  1236\t\t\ts[\"latest_configuration_index\"] = toString(future.Index())\n  1237\t\t\ts[\"latest_configuration\"] = fmt.Sprintf(\"%+v\", configuration.Servers)\n  1238\t\n  1239\t\t\t// This is a legacy metric that we've seen people use in the wild.\n  1240\t\t\thasUs := false\n  1241\t\t\tnumPeers := 0\n  1242\t\t\tfor _, server := range configuration.Servers {\n  1243\t\t\t\tif server.Suffrage == Voter {\n  1244\t\t\t\t\tif server.ID == r.localID {\n  1245\t\t\t\t\t\thasUs = true\n  1246\t\t\t\t\t} else {\n  1247\t\t\t\t\t\tnumPeers++\n  1248\t\t\t\t\t}\n  1249\t\t\t\t}\n  1250\t\t\t}\n  1251\t\t\tif !hasUs {\n  1252\t\t\t\tnumPeers = 0\n  1253\t\t\t}\n  1254\t\t\ts[\"num_peers\"] = toString(uint64(numPeers))\n  1255\t\t}\n  1256\t\n  1257\t\tlast := r.LastContact()\n  1258\t\tif r.getState() == Leader {\n  1259\t\t\ts[\"last_contact\"] = \"0\"\n  1260\t\t} else if last.IsZero() {\n  1261\t\t\ts[\"last_contact\"] = \"never\"\n  1262\t\t} else {\n  1263\t\t\ts[\"last_contact\"] = fmt.Sprintf(\"%v\", time.Since(last))\n  1264\t\t}\n  1265\t\treturn s\n  1266\t}\n  1267\t\n  1268\t// CurrentTerm returns the current term.\n  1269\tfunc (r *Raft) CurrentTerm() uint64 {\n  1270\t\treturn r.getCurrentTerm()\n  1271\t}\n  1272\t\n  1273\t// LastIndex returns the last index in stable storage,\n  1274\t// either from the last log or from the last snapshot.\n  1275\tfunc (r *Raft) LastIndex() uint64 {\n  1276\t\treturn r.getLastIndex()\n  1277\t}\n  1278\t\n  1279\t// CommitIndex returns the committed index.\n  1280\t// This API maybe helpful for server to implement the read index optimization\n  1281\t// as described in the Raft paper.\n  1282\tfunc (r *Raft) CommitIndex() uint64 {\n  1283\t\treturn r.getCommitIndex()\n  1284\t}\n  1285\t\n  1286\t// AppliedIndex returns the last index applied to the FSM. This is generally\n  1287\t// lagging behind the last index, especially for indexes that are persisted but\n  1288\t// have not yet been considered committed by the leader. NOTE - this reflects\n  1289\t// the last index that was sent to the application's FSM over the apply channel\n  1290\t// but DOES NOT mean that the application's FSM has yet consumed it and applied\n  1291\t// it to its internal state. Thus, the application's state may lag behind this\n  1292\t// index.\n  1293\tfunc (r *Raft) AppliedIndex() uint64 {\n  1294\t\treturn r.getLastApplied()\n  1295\t}\n  1296\t\n  1297\t// LeadershipTransfer will transfer leadership to a server in the cluster.\n  1298\t// This can only be called from the leader, or it will fail. The leader will\n  1299\t// stop accepting client requests, make sure the target server is up to date\n  1300\t// and starts the transfer with a TimeoutNow message. This message has the same\n  1301\t// effect as if the election timeout on the target server fires. Since\n  1302\t// it is unlikely that another server is starting an election, it is very\n  1303\t// likely that the target server is able to win the election.  Note that raft\n  1304\t// protocol version 3 is not sufficient to use LeadershipTransfer. A recent\n  1305\t// version of that library has to be used that includes this feature.  Using\n  1306\t// transfer leadership is safe however in a cluster where not every node has\n  1307\t// the latest version. If a follower cannot be promoted, it will fail\n  1308\t// gracefully.\n  1309\tfunc (r *Raft) LeadershipTransfer() Future {\n  1310\t\tif r.protocolVersion < 3 {\n  1311\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1312\t\t}\n  1313\t\n  1314\t\treturn r.initiateLeadershipTransfer(nil, nil)\n  1315\t}\n  1316\t\n  1317\t// LeadershipTransferToServer does the same as LeadershipTransfer but takes a\n  1318\t// server in the arguments in case a leadership should be transitioned to a\n  1319\t// specific server in the cluster.  Note that raft protocol version 3 is not\n  1320\t// sufficient to use LeadershipTransfer. A recent version of that library has\n  1321\t// to be used that includes this feature. Using transfer leadership is safe\n  1322\t// however in a cluster where not every node has the latest version. If a\n  1323\t// follower cannot be promoted, it will fail gracefully.\n  1324\tfunc (r *Raft) LeadershipTransferToServer(id ServerID, address ServerAddress) Future {\n  1325\t\tif r.protocolVersion < 3 {\n  1326\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1327\t\t}\n  1328\t\n  1329\t\treturn r.initiateLeadershipTransfer(&id, &address)\n  1330\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n inmem_transport.go | sed -n '1,200p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n inmem_transport.go | sed -n '1,200p'\"","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"sync\"\n    10\t\t\"time\"\n    11\t)\n    12\t\n    13\t// NewInmemAddr returns a new in-memory addr with\n    14\t// a randomly generate UUID as the ID.\n    15\tfunc NewInmemAddr() ServerAddress {\n    16\t\treturn ServerAddress(generateUUID())\n    17\t}\n    18\t\n    19\t// inmemPipeline is used to pipeline requests for the in-mem transport.\n    20\ttype inmemPipeline struct {\n    21\t\ttrans    *InmemTransport\n    22\t\tpeer     *InmemTransport\n    23\t\tpeerAddr ServerAddress\n    24\t\n    25\t\tdoneCh       chan AppendFuture\n    26\t\tinprogressCh chan *inmemPipelineInflight\n    27\t\n    28\t\tshutdown     bool\n    29\t\tshutdownCh   chan struct{}\n    30\t\tshutdownLock sync.RWMutex\n    31\t}\n    32\t\n    33\ttype inmemPipelineInflight struct {\n    34\t\tfuture *appendFuture\n    35\t\trespCh <-chan RPCResponse\n    36\t}\n    37\t\n    38\t// InmemTransport Implements the Transport interface, to allow Raft to be\n    39\t// tested in-memory without going over a network.\n    40\ttype InmemTransport struct {\n    41\t\tsync.RWMutex\n    42\t\tconsumerCh chan RPC\n    43\t\tlocalAddr  ServerAddress\n    44\t\tpeers      map[ServerAddress]*InmemTransport\n    45\t\tpipelines  []*inmemPipeline\n    46\t\ttimeout    time.Duration\n    47\t}\n    48\t\n    49\t// NewInmemTransportWithTimeout is used to initialize a new transport and\n    50\t// generates a random local address if none is specified. The given timeout\n    51\t// will be used to decide how long to wait for a connected peer to process the\n    52\t// RPCs that we're sending it. See also Connect() and Consumer().\n    53\tfunc NewInmemTransportWithTimeout(addr ServerAddress, timeout time.Duration) (ServerAddress, *InmemTransport) {\n    54\t\tif string(addr) == \"\" {\n    55\t\t\taddr = NewInmemAddr()\n    56\t\t}\n    57\t\ttrans := &InmemTransport{\n    58\t\t\tconsumerCh: make(chan RPC, 16),\n    59\t\t\tlocalAddr:  addr,\n    60\t\t\tpeers:      make(map[ServerAddress]*InmemTransport),\n    61\t\t\ttimeout:    timeout,\n    62\t\t}\n    63\t\treturn addr, trans\n    64\t}\n    65\t\n    66\t// NewInmemTransport is used to initialize a new transport\n    67\t// and generates a random local address if none is specified\n    68\tfunc NewInmemTransport(addr ServerAddress) (ServerAddress, *InmemTransport) {\n    69\t\treturn NewInmemTransportWithTimeout(addr, 500*time.Millisecond)\n    70\t}\n    71\t\n    72\t// SetHeartbeatHandler is used to set optional fast-path for\n    73\t// heartbeats, not supported for this transport.\n    74\tfunc (i *InmemTransport) SetHeartbeatHandler(cb func(RPC)) {\n    75\t}\n    76\t\n    77\t// Consumer implements the Transport interface.\n    78\tfunc (i *InmemTransport) Consumer() <-chan RPC {\n    79\t\treturn i.consumerCh\n    80\t}\n    81\t\n    82\t// LocalAddr implements the Transport interface.\n    83\tfunc (i *InmemTransport) LocalAddr() ServerAddress {\n    84\t\treturn i.localAddr\n    85\t}\n    86\t\n    87\t// AppendEntriesPipeline returns an interface that can be used to pipeline\n    88\t// AppendEntries requests.\n    89\tfunc (i *InmemTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {\n    90\t\ti.Lock()\n    91\t\tdefer i.Unlock()\n    92\t\n    93\t\tpeer, ok := i.peers[target]\n    94\t\tif !ok {\n    95\t\t\treturn nil, fmt.Errorf(\"failed to connect to peer: %v\", target)\n    96\t\t}\n    97\t\tpipeline := newInmemPipeline(i, peer, target)\n    98\t\ti.pipelines = append(i.pipelines, pipeline)\n    99\t\treturn pipeline, nil\n   100\t}\n   101\t\n   102\t// AppendEntries implements the Transport interface.\n   103\tfunc (i *InmemTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n   104\t\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n   105\t\tif err != nil {\n   106\t\t\treturn err\n   107\t\t}\n   108\t\n   109\t\t// Copy the result back\n   110\t\tout := rpcResp.Response.(*AppendEntriesResponse)\n   111\t\t*resp = *out\n   112\t\treturn nil\n   113\t}\n   114\t\n   115\t// RequestVote implements the Transport interface.\n   116\tfunc (i *InmemTransport) RequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error {\n   117\t\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n   118\t\tif err != nil {\n   119\t\t\treturn err\n   120\t\t}\n   121\t\n   122\t\t// Copy the result back\n   123\t\tout := rpcResp.Response.(*RequestVoteResponse)\n   124\t\t*resp = *out\n   125\t\treturn nil\n   126\t}\n   127\t\n   128\tfunc (i *InmemTransport) RequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error {\n   129\t\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n   130\t\tif err != nil {\n   131\t\t\treturn err\n   132\t\t}\n   133\t\n   134\t\t// Copy the result back\n   135\t\tout := rpcResp.Response.(*RequestPreVoteResponse)\n   136\t\t*resp = *out\n   137\t\treturn nil\n   138\t}\n   139\t\n   140\t// InstallSnapshot implements the Transport interface.\n   141\tfunc (i *InmemTransport) InstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error {\n   142\t\trpcResp, err := i.makeRPC(target, args, data, 10*i.timeout)\n   143\t\tif err != nil {\n   144\t\t\treturn err\n   145\t\t}\n   146\t\n   147\t\t// Copy the result back\n   148\t\tout := rpcResp.Response.(*InstallSnapshotResponse)\n   149\t\t*resp = *out\n   150\t\treturn nil\n   151\t}\n   152\t\n   153\t// TimeoutNow implements the Transport interface.\n   154\tfunc (i *InmemTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {\n   155\t\trpcResp, err := i.makeRPC(target, args, nil, 10*i.timeout)\n   156\t\tif err != nil {\n   157\t\t\treturn err\n   158\t\t}\n   159\t\n   160\t\t// Copy the result back\n   161\t\tout := rpcResp.Response.(*TimeoutNowResponse)\n   162\t\t*resp = *out\n   163\t\treturn nil\n   164\t}\n   165\t\n   166\tfunc (i *InmemTransport) makeRPC(target ServerAddress, args interface{}, r io.Reader, timeout time.Duration) (rpcResp RPCResponse, err error) {\n   167\t\ti.RLock()\n   168\t\tpeer, ok := i.peers[target]\n   169\t\ti.RUnlock()\n   170\t\n   171\t\tif !ok {\n   172\t\t\terr = fmt.Errorf(\"failed to connect to peer: %v\", target)\n   173\t\t\treturn\n   174\t\t}\n   175\t\n   176\t\t// Send the RPC over\n   177\t\trespCh := make(chan RPCResponse, 1)\n   178\t\treq := RPC{\n   179\t\t\tCommand:  args,\n   180\t\t\tReader:   r,\n   181\t\t\tRespChan: respCh,\n   182\t\t}\n   183\t\tselect {\n   184\t\tcase peer.consumerCh <- req:\n   185\t\tcase <-time.After(timeout):\n   186\t\t\terr = fmt.Errorf(\"send timed out\")\n   187\t\t\treturn\n   188\t\t}\n   189\t\n   190\t\t// Wait for a response\n   191\t\tselect {\n   192\t\tcase rpcResp = <-respCh:\n   193\t\t\tif rpcResp.Error != nil {\n   194\t\t\t\terr = rpcResp.Error\n   195\t\t\t}\n   196\t\tcase <-time.After(timeout):\n   197\t\t\terr = fmt.Errorf(\"command timed out\")\n   198\t\t}\n   199\t\treturn\n   200\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n snapshot.go | sed -n '126,279p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n snapshot.go | sed -n '126,279p'\"","aggregated_output":"   126\tfunc (r *Raft) takeSnapshot() (string, error) {\n   127\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n   128\t\n   129\t\t// Create a request for the FSM to perform a snapshot.\n   130\t\tsnapReq := &reqSnapshotFuture{}\n   131\t\tsnapReq.init()\n   132\t\n   133\t\t// Wait for dispatch or shutdown.\n   134\t\tselect {\n   135\t\tcase r.fsmSnapshotCh <- snapReq:\n   136\t\tcase <-r.shutdownCh:\n   137\t\t\treturn \"\", ErrRaftShutdown\n   138\t\t}\n   139\t\n   140\t\t// Wait until we get a response\n   141\t\tif err := snapReq.Error(); err != nil {\n   142\t\t\tif err != ErrNothingNewToSnapshot {\n   143\t\t\t\terr = fmt.Errorf(\"failed to start snapshot: %v\", err)\n   144\t\t\t}\n   145\t\t\treturn \"\", err\n   146\t\t}\n   147\t\tdefer snapReq.snapshot.Release()\n   148\t\n   149\t\t// Make a request for the configurations and extract the committed info.\n   150\t\t// We have to use the future here to safely get this information since\n   151\t\t// it is owned by the main thread.\n   152\t\tconfigReq := &configurationsFuture{}\n   153\t\tconfigReq.ShutdownCh = r.shutdownCh\n   154\t\tconfigReq.init()\n   155\t\tselect {\n   156\t\tcase r.configurationsCh <- configReq:\n   157\t\tcase <-r.shutdownCh:\n   158\t\t\treturn \"\", ErrRaftShutdown\n   159\t\t}\n   160\t\tif err := configReq.Error(); err != nil {\n   161\t\t\treturn \"\", err\n   162\t\t}\n   163\t\tcommitted := configReq.configurations.committed\n   164\t\tcommittedIndex := configReq.configurations.committedIndex\n   165\t\n   166\t\t// We don't support snapshots while there's a config change outstanding\n   167\t\t// since the snapshot doesn't have a means to represent this state. This\n   168\t\t// is a little weird because we need the FSM to apply an index that's\n   169\t\t// past the configuration change, even though the FSM itself doesn't see\n   170\t\t// the configuration changes. It should be ok in practice with normal\n   171\t\t// application traffic flowing through the FSM. If there's none of that\n   172\t\t// then it's not crucial that we snapshot, since there's not much going\n   173\t\t// on Raft-wise.\n   174\t\tif snapReq.index < committedIndex {\n   175\t\t\treturn \"\", fmt.Errorf(\"cannot take snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n   176\t\t\t\tcommittedIndex, snapReq.index)\n   177\t\t}\n   178\t\n   179\t\t// Create a new snapshot.\n   180\t\tr.logger.Info(\"starting snapshot up to\", \"index\", snapReq.index)\n   181\t\tstart := time.Now()\n   182\t\tversion := getSnapshotVersion(r.protocolVersion)\n   183\t\tsink, err := r.snapshots.Create(version, snapReq.index, snapReq.term, committed, committedIndex, r.trans)\n   184\t\tif err != nil {\n   185\t\t\treturn \"\", fmt.Errorf(\"failed to create snapshot: %v\", err)\n   186\t\t}\n   187\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"create\"}, start)\n   188\t\n   189\t\t// Try to persist the snapshot.\n   190\t\tstart = time.Now()\n   191\t\tif err := snapReq.snapshot.Persist(sink); err != nil {\n   192\t\t\t_ = sink.Cancel()\n   193\t\t\treturn \"\", fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   194\t\t}\n   195\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"persist\"}, start)\n   196\t\n   197\t\t// Close and check for error.\n   198\t\tif err := sink.Close(); err != nil {\n   199\t\t\treturn \"\", fmt.Errorf(\"failed to close snapshot: %v\", err)\n   200\t\t}\n   201\t\n   202\t\t// Update the last stable snapshot info.\n   203\t\tr.setLastSnapshot(snapReq.index, snapReq.term)\n   204\t\n   205\t\t// Compact the logs.\n   206\t\tif err := r.compactLogs(snapReq.index); err != nil {\n   207\t\t\treturn \"\", err\n   208\t\t}\n   209\t\n   210\t\tr.logger.Info(\"snapshot complete up to\", \"index\", snapReq.index)\n   211\t\treturn sink.ID(), nil\n   212\t}\n   213\t\n   214\t// compactLogsWithTrailing takes the last inclusive index of a snapshot,\n   215\t// the lastLogIdx, and the trailingLogs and trims the logs that\n   216\t// are no longer needed.\n   217\tfunc (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n   218\t\t// Determine log ranges to compact\n   219\t\tminLog, err := r.logs.FirstIndex()\n   220\t\tif err != nil {\n   221\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   222\t\t}\n   223\t\n   224\t\t// Check if we have enough logs to truncate\n   225\t\t// Use a consistent value for trailingLogs for the duration of this method\n   226\t\t// call to avoid surprising behaviour.\n   227\t\tif lastLogIdx <= trailingLogs {\n   228\t\t\treturn nil\n   229\t\t}\n   230\t\n   231\t\t// Truncate up to the end of the snapshot, or `TrailingLogs`\n   232\t\t// back from the head, which ever is further back. This ensures\n   233\t\t// at least `TrailingLogs` entries, but does not allow logs\n   234\t\t// after the snapshot to be removed.\n   235\t\tmaxLog := min(snapIdx, lastLogIdx-trailingLogs)\n   236\t\n   237\t\tif minLog > maxLog {\n   238\t\t\tr.logger.Info(\"no logs to truncate\")\n   239\t\t\treturn nil\n   240\t\t}\n   241\t\n   242\t\tr.logger.Info(\"compacting logs\", \"from\", minLog, \"to\", maxLog)\n   243\t\n   244\t\t// Compact the logs\n   245\t\tif err := r.logs.DeleteRange(minLog, maxLog); err != nil {\n   246\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   247\t\t}\n   248\t\treturn nil\n   249\t}\n   250\t\n   251\t// compactLogs takes the last inclusive index of a snapshot\n   252\t// and trims the logs that are no longer needed.\n   253\tfunc (r *Raft) compactLogs(snapIdx uint64) error {\n   254\t\tdefer metrics.MeasureSince([]string{\"raft\", \"compactLogs\"}, time.Now())\n   255\t\n   256\t\tlastLogIdx, _ := r.getLastLog()\n   257\t\ttrailingLogs := r.config().TrailingLogs\n   258\t\n   259\t\treturn r.compactLogsWithTrailing(snapIdx, lastLogIdx, trailingLogs)\n   260\t}\n   261\t\n   262\t// removeOldLogs removes all old logs from the store. This is used for\n   263\t// MonotonicLogStores after restore. Callers should verify that the store\n   264\t// implementation is monotonic prior to calling.\n   265\tfunc (r *Raft) removeOldLogs() error {\n   266\t\tdefer metrics.MeasureSince([]string{\"raft\", \"removeOldLogs\"}, time.Now())\n   267\t\n   268\t\tlastLogIdx, err := r.logs.LastIndex()\n   269\t\tif err != nil {\n   270\t\t\treturn fmt.Errorf(\"failed to get last log index: %w\", err)\n   271\t\t}\n   272\t\n   273\t\tr.logger.Info(\"removing all old logs from log store\")\n   274\t\n   275\t\t// call compactLogsWithTrailing with lastLogIdx for snapIdx since\n   276\t\t// it will take the lesser of lastLogIdx and snapIdx to figure out\n   277\t\t// the end for which to apply trailingLogs.\n   278\t\treturn r.compactLogsWithTrailing(lastLogIdx, lastLogIdx, 0)\n   279\t}\n","exit_code":0,"status":"completed"}}
