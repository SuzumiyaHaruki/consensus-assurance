{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n api.go | sed -n '400,760p'\"","aggregated_output":"   400\t\tlastTerm := snapshotTerm\n   401\t\n   402\t\t// Apply any Raft log entries past the snapshot.\n   403\t\tlastLogIndex, err := logs.LastIndex()\n   404\t\tif err != nil {\n   405\t\t\treturn fmt.Errorf(\"failed to find last log: %v\", err)\n   406\t\t}\n   407\t\tfor index := snapshotIndex + 1; index <= lastLogIndex; index++ {\n   408\t\t\tvar entry Log\n   409\t\t\tif err = logs.GetLog(index, &entry); err != nil {\n   410\t\t\t\treturn fmt.Errorf(\"failed to get log at index %d: %v\", index, err)\n   411\t\t\t}\n   412\t\t\tif entry.Type == LogCommand {\n   413\t\t\t\t_ = fsm.Apply(&entry)\n   414\t\t\t}\n   415\t\t\tlastIndex = entry.Index\n   416\t\t\tlastTerm = entry.Term\n   417\t\t}\n   418\t\n   419\t\t// Create a new snapshot, placing the configuration in as if it was\n   420\t\t// committed at index 1.\n   421\t\tsnapshot, err := fsm.Snapshot()\n   422\t\tif err != nil {\n   423\t\t\treturn fmt.Errorf(\"failed to snapshot FSM: %v\", err)\n   424\t\t}\n   425\t\tversion := getSnapshotVersion(conf.ProtocolVersion)\n   426\t\tsink, err := snaps.Create(version, lastIndex, lastTerm, configuration, 1, trans)\n   427\t\tif err != nil {\n   428\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n   429\t\t}\n   430\t\tif err = snapshot.Persist(sink); err != nil {\n   431\t\t\treturn fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   432\t\t}\n   433\t\tif err = sink.Close(); err != nil {\n   434\t\t\treturn fmt.Errorf(\"failed to finalize snapshot: %v\", err)\n   435\t\t}\n   436\t\n   437\t\t// Compact the log so that we don't get bad interference from any\n   438\t\t// configuration change log entries that might be there.\n   439\t\tfirstLogIndex, err := logs.FirstIndex()\n   440\t\tif err != nil {\n   441\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   442\t\t}\n   443\t\tif err := logs.DeleteRange(firstLogIndex, lastLogIndex); err != nil {\n   444\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   445\t\t}\n   446\t\n   447\t\treturn nil\n   448\t}\n   449\t\n   450\t// GetConfiguration returns the persisted configuration of the Raft cluster\n   451\t// without starting a Raft instance or connecting to the cluster. This function\n   452\t// has identical behavior to Raft.GetConfiguration.\n   453\tfunc GetConfiguration(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n   454\t\tsnaps SnapshotStore, trans Transport,\n   455\t) (Configuration, error) {\n   456\t\tconf.skipStartup = true\n   457\t\tr, err := NewRaft(conf, fsm, logs, stable, snaps, trans)\n   458\t\tif err != nil {\n   459\t\t\treturn Configuration{}, err\n   460\t\t}\n   461\t\tfuture := r.GetConfiguration()\n   462\t\tif err = future.Error(); err != nil {\n   463\t\t\treturn Configuration{}, err\n   464\t\t}\n   465\t\treturn future.Configuration(), nil\n   466\t}\n   467\t\n   468\t// HasExistingState returns true if the server has any existing state (logs,\n   469\t// knowledge of a current term, or any snapshots).\n   470\tfunc HasExistingState(logs LogStore, stable StableStore, snaps SnapshotStore) (bool, error) {\n   471\t\t// Make sure we don't have a current term.\n   472\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   473\t\tif err == nil {\n   474\t\t\tif currentTerm > 0 {\n   475\t\t\t\treturn true, nil\n   476\t\t\t}\n   477\t\t} else {\n   478\t\t\tif err.Error() != \"not found\" {\n   479\t\t\t\treturn false, fmt.Errorf(\"failed to read current term: %v\", err)\n   480\t\t\t}\n   481\t\t}\n   482\t\n   483\t\t// Make sure we have an empty log.\n   484\t\tlastIndex, err := logs.LastIndex()\n   485\t\tif err != nil {\n   486\t\t\treturn false, fmt.Errorf(\"failed to get last log index: %v\", err)\n   487\t\t}\n   488\t\tif lastIndex > 0 {\n   489\t\t\treturn true, nil\n   490\t\t}\n   491\t\n   492\t\t// Make sure we have no snapshots\n   493\t\tsnapshots, err := snaps.List()\n   494\t\tif err != nil {\n   495\t\t\treturn false, fmt.Errorf(\"failed to list snapshots: %v\", err)\n   496\t\t}\n   497\t\tif len(snapshots) > 0 {\n   498\t\t\treturn true, nil\n   499\t\t}\n   500\t\n   501\t\treturn false, nil\n   502\t}\n   503\t\n   504\t// NewRaft is used to construct a new Raft node. It takes a configuration, as well\n   505\t// as implementations of various interfaces that are required. If we have any\n   506\t// old state, such as snapshots, logs, peers, etc, all those will be restored\n   507\t// when creating the Raft node.\n   508\tfunc NewRaft(conf *Config, fsm FSM, logs LogStore, stable StableStore, snaps SnapshotStore, trans Transport) (*Raft, error) {\n   509\t\t// Validate the configuration.\n   510\t\tif err := ValidateConfig(conf); err != nil {\n   511\t\t\treturn nil, err\n   512\t\t}\n   513\t\n   514\t\t// Ensure we have a LogOutput.\n   515\t\tlogger := conf.getOrCreateLogger()\n   516\t\n   517\t\t// Try to restore the current term.\n   518\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   519\t\tif err != nil && err.Error() != \"not found\" {\n   520\t\t\treturn nil, fmt.Errorf(\"failed to load current term: %v\", err)\n   521\t\t}\n   522\t\n   523\t\t// Read the index of the last log entry.\n   524\t\tlastIndex, err := logs.LastIndex()\n   525\t\tif err != nil {\n   526\t\t\treturn nil, fmt.Errorf(\"failed to find last log: %v\", err)\n   527\t\t}\n   528\t\n   529\t\t// Get the last log entry.\n   530\t\tvar lastLog Log\n   531\t\tif lastIndex > 0 {\n   532\t\t\tif err = logs.GetLog(lastIndex, &lastLog); err != nil {\n   533\t\t\t\treturn nil, fmt.Errorf(\"failed to get last log at index %d: %v\", lastIndex, err)\n   534\t\t\t}\n   535\t\t}\n   536\t\n   537\t\t// Make sure we have a valid server address and ID.\n   538\t\tprotocolVersion := conf.ProtocolVersion\n   539\t\tlocalAddr := trans.LocalAddr()\n   540\t\tlocalID := conf.LocalID\n   541\t\n   542\t\t// TODO (slackpad) - When we deprecate protocol version 2, remove this\n   543\t\t// along with the AddPeer() and RemovePeer() APIs.\n   544\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   545\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   546\t\t}\n   547\t\n   548\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   549\t\tapplyCh := make(chan *logFuture)\n   550\t\tif conf.BatchApplyCh {\n   551\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   552\t\t}\n   553\t\n   554\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   555\t\t// Create Raft struct.\n   556\t\tr := &Raft{\n   557\t\t\tprotocolVersion:       protocolVersion,\n   558\t\t\tapplyCh:               applyCh,\n   559\t\t\tfsm:                   fsm,\n   560\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   561\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   562\t\t\tleaderCh:              make(chan bool, 1),\n   563\t\t\tlocalID:               localID,\n   564\t\t\tlocalAddr:             localAddr,\n   565\t\t\tlogger:                logger,\n   566\t\t\tlogs:                  logs,\n   567\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   568\t\t\tconfigurations:        configurations{},\n   569\t\t\trpcCh:                 trans.Consumer(),\n   570\t\t\tsnapshots:             snaps,\n   571\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n   572\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n   573\t\t\tshutdownCh:            make(chan struct{}),\n   574\t\t\tstable:                stable,\n   575\t\t\ttrans:                 trans,\n   576\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n   577\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n   578\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   579\t\t\tobservers:             make(map[uint64]*Observer),\n   580\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   581\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   582\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   583\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   584\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   585\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   586\t\t\tRestoreCommittedLogs:  conf.RestoreCommittedLogs,\n   587\t\t}\n   588\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   589\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   590\t\t}\n   591\t\n   592\t\tr.conf.Store(*conf)\n   593\t\n   594\t\t// Initialize as a follower.\n   595\t\tr.setState(Follower)\n   596\t\n   597\t\t// Restore the current term and the last log.\n   598\t\tr.setCurrentTerm(currentTerm)\n   599\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   600\t\n   601\t\t// Attempt to restore a snapshot if there are any.\n   602\t\tif err := r.restoreSnapshot(); err != nil {\n   603\t\t\treturn nil, err\n   604\t\t}\n   605\t\n   606\t\tif err := r.restoreFromCommittedLogs(); err != nil {\n   607\t\t\treturn nil, err\n   608\t\t}\n   609\t\n   610\t\t// Scan through the log for any configuration change entries.\n   611\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   612\t\tlastappliedIndex := r.getLastApplied()\n   613\t\tfor index := max(snapshotIndex, lastappliedIndex) + 1; index <= lastLog.Index; index++ {\n   614\t\t\tvar entry Log\n   615\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   616\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   617\t\t\t\tpanic(err)\n   618\t\t\t}\n   619\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   620\t\t\t\treturn nil, err\n   621\t\t\t}\n   622\t\t}\n   623\t\tr.logger.Info(\"initial configuration\",\n   624\t\t\t\"index\", r.configurations.latestIndex,\n   625\t\t\t\"servers\", hclog.Fmt(\"%+v\", r.configurations.latest.Servers))\n   626\t\n   627\t\t// Setup a heartbeat fast-path to avoid head-of-line\n   628\t\t// blocking where possible. It MUST be safe for this\n   629\t\t// to be called concurrently with a blocking RPC.\n   630\t\ttrans.SetHeartbeatHandler(r.processHeartbeat)\n   631\t\n   632\t\tif conf.skipStartup {\n   633\t\t\treturn r, nil\n   634\t\t}\n   635\t\t// Start the background work.\n   636\t\tr.goFunc(r.run)\n   637\t\tr.goFunc(r.runFSM)\n   638\t\tr.goFunc(r.runSnapshots)\n   639\t\treturn r, nil\n   640\t}\n   641\t\n   642\t// restoreSnapshot attempts to restore the latest snapshots, and fails if none\n   643\t// of them can be restored. This is called at initialization time, and is\n   644\t// completely unsafe to call at any other time.\n   645\tfunc (r *Raft) restoreSnapshot() error {\n   646\t\tsnapshots, err := r.snapshots.List()\n   647\t\tif err != nil {\n   648\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   649\t\t\treturn err\n   650\t\t}\n   651\t\n   652\t\t// Try to load in order of newest to oldest\n   653\t\tfor _, snapshot := range snapshots {\n   654\t\t\tif success := r.tryRestoreSingleSnapshot(snapshot); !success {\n   655\t\t\t\tcontinue\n   656\t\t\t}\n   657\t\n   658\t\t\t// Update the lastApplied so we don't replay old logs\n   659\t\t\tr.setLastApplied(snapshot.Index)\n   660\t\n   661\t\t\t// Update the last stable snapshot info\n   662\t\t\tr.setLastSnapshot(snapshot.Index, snapshot.Term)\n   663\t\n   664\t\t\t// Update the configuration\n   665\t\t\tvar conf Configuration\n   666\t\t\tvar index uint64\n   667\t\t\tif snapshot.Version > 0 {\n   668\t\t\t\tconf = snapshot.Configuration\n   669\t\t\t\tindex = snapshot.ConfigurationIndex\n   670\t\t\t} else {\n   671\t\t\t\tvar err error\n   672\t\t\t\tif conf, err = decodePeers(snapshot.Peers, r.trans); err != nil {\n   673\t\t\t\t\treturn err\n   674\t\t\t\t}\n   675\t\t\t\tindex = snapshot.Index\n   676\t\t\t}\n   677\t\t\tr.setCommittedConfiguration(conf, index)\n   678\t\t\tr.setLatestConfiguration(conf, index)\n   679\t\n   680\t\t\t// Success!\n   681\t\t\treturn nil\n   682\t\t}\n   683\t\n   684\t\t// If we had snapshots and failed to load them, its an error\n   685\t\tif len(snapshots) > 0 {\n   686\t\t\treturn fmt.Errorf(\"failed to load any existing snapshots\")\n   687\t\t}\n   688\t\treturn nil\n   689\t}\n   690\t\n   691\tfunc (r *Raft) tryRestoreSingleSnapshot(snapshot *SnapshotMeta) bool {\n   692\t\tif r.config().NoSnapshotRestoreOnStart {\n   693\t\t\treturn true\n   694\t\t}\n   695\t\n   696\t\tsnapLogger := r.logger.With(\n   697\t\t\t\"id\", snapshot.ID,\n   698\t\t\t\"last-index\", snapshot.Index,\n   699\t\t\t\"last-term\", snapshot.Term,\n   700\t\t\t\"size-in-bytes\", snapshot.Size,\n   701\t\t)\n   702\t\n   703\t\tsnapLogger.Info(\"starting restore from snapshot\")\n   704\t\n   705\t\t_, source, err := r.snapshots.Open(snapshot.ID)\n   706\t\tif err != nil {\n   707\t\t\tsnapLogger.Error(\"failed to open snapshot\", \"error\", err)\n   708\t\t\treturn false\n   709\t\t}\n   710\t\n   711\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, snapshot.Size); err != nil {\n   712\t\t\t_ = source.Close()\n   713\t\t\tsnapLogger.Error(\"failed to restore snapshot\", \"error\", err)\n   714\t\t\treturn false\n   715\t\t}\n   716\t\t_ = source.Close()\n   717\t\n   718\t\tsnapLogger.Info(\"restored from snapshot\")\n   719\t\n   720\t\treturn true\n   721\t}\n   722\t\n   723\t// restoreFromCommittedLogs recovers the Raft node from committed logs.\n   724\tfunc (r *Raft) restoreFromCommittedLogs() error {\n   725\t\tif !r.RestoreCommittedLogs {\n   726\t\t\treturn nil\n   727\t\t}\n   728\t\n   729\t\t// If the store implements CommitTrackingLogStore, we can read the commit index from the store.\n   730\t\t// This is useful when the store is able to track the commit index and we can avoid replaying logs.\n   731\t\tstore, ok := r.logs.(CommitTrackingLogStore)\n   732\t\tif !ok {\n   733\t\t\tr.logger.Warn(\"restore committed logs enabled but log store does not support it\", \"log_store\", fmt.Sprintf(\"%T\", r.logs))\n   734\t\t\treturn ErrIncompatibleLogStore\n   735\t\t}\n   736\t\n   737\t\tcommitIndex, err := store.GetCommitIndex()\n   738\t\tif err != nil {\n   739\t\t\tr.logger.Error(\"failed to get commit index from store\", \"error\", err)\n   740\t\t\treturn err\n   741\t\t}\n   742\t\n   743\t\tlastIndex, err := r.logs.LastIndex()\n   744\t\tif err != nil {\n   745\t\t\tr.logger.Error(\"failed to get last log index from store\", \"error\", err)\n   746\t\t\treturn err\n   747\t\t}\n   748\t\tif commitIndex > lastIndex {\n   749\t\t\tcommitIndex = lastIndex\n   750\t\t}\n   751\t\n   752\t\tr.setCommitIndex(commitIndex)\n   753\t\tr.processLogs(commitIndex, nil)\n   754\t\treturn nil\n   755\t}\n   756\t\n   757\tfunc (r *Raft) config() Config {\n   758\t\treturn r.conf.Load().(Config)\n   759\t}\n   760\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n api.go | sed -n '240,400p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n api.go | sed -n '240,400p'\"","aggregated_output":"   240\t// A cluster can only be bootstrapped once from a single participating Voter\n   241\t// server. Any further attempts to bootstrap will return an error that can be\n   242\t// safely ignored.\n   243\t//\n   244\t// One approach is to bootstrap a single server with a configuration\n   245\t// listing just itself as a Voter, then invoke AddVoter() on it to add other\n   246\t// servers to the cluster.\n   247\tfunc BootstrapCluster(conf *Config, logs LogStore, stable StableStore,\n   248\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n   249\t) error {\n   250\t\t// Validate the Raft server config.\n   251\t\tif err := ValidateConfig(conf); err != nil {\n   252\t\t\treturn err\n   253\t\t}\n   254\t\n   255\t\t// Sanity check the Raft peer configuration.\n   256\t\tif err := checkConfiguration(configuration); err != nil {\n   257\t\t\treturn err\n   258\t\t}\n   259\t\n   260\t\t// Make sure the cluster is in a clean state.\n   261\t\thasState, err := HasExistingState(logs, stable, snaps)\n   262\t\tif err != nil {\n   263\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n   264\t\t}\n   265\t\tif hasState {\n   266\t\t\treturn ErrCantBootstrap\n   267\t\t}\n   268\t\n   269\t\t// Set current term to 1.\n   270\t\tif err := stable.SetUint64(keyCurrentTerm, 1); err != nil {\n   271\t\t\treturn fmt.Errorf(\"failed to save current term: %v\", err)\n   272\t\t}\n   273\t\n   274\t\t// Append configuration entry to log.\n   275\t\tentry := &Log{\n   276\t\t\tIndex: 1,\n   277\t\t\tTerm:  1,\n   278\t\t}\n   279\t\tif conf.ProtocolVersion < 3 {\n   280\t\t\tentry.Type = LogRemovePeerDeprecated\n   281\t\t\tentry.Data = encodePeers(configuration, trans)\n   282\t\t} else {\n   283\t\t\tentry.Type = LogConfiguration\n   284\t\t\tentry.Data = EncodeConfiguration(configuration)\n   285\t\t}\n   286\t\tif err := logs.StoreLog(entry); err != nil {\n   287\t\t\treturn fmt.Errorf(\"failed to append configuration entry to log: %v\", err)\n   288\t\t}\n   289\t\n   290\t\treturn nil\n   291\t}\n   292\t\n   293\t// RecoverCluster is used to manually force a new configuration in order to\n   294\t// recover from a loss of quorum where the current configuration cannot be\n   295\t// restored, such as when several servers die at the same time. This works by\n   296\t// reading all the current state for this server, creating a snapshot with the\n   297\t// supplied configuration, and then truncating the Raft log. This is the only\n   298\t// safe way to force a given configuration without actually altering the log to\n   299\t// insert any new entries, which could cause conflicts with other servers with\n   300\t// different state.\n   301\t//\n   302\t// WARNING! This operation implicitly commits all entries in the Raft log, so\n   303\t// in general this is an extremely unsafe operation. If you've lost your other\n   304\t// servers and are performing a manual recovery, then you've also lost the\n   305\t// commit information, so this is likely the best you can do, but you should be\n   306\t// aware that calling this can cause Raft log entries that were in the process\n   307\t// of being replicated but not yet be committed to be committed.\n   308\t//\n   309\t// Note the FSM passed here is used for the snapshot operations and will be\n   310\t// left in a state that should not be used by the application. Be sure to\n   311\t// discard this FSM and any associated state and provide a fresh one when\n   312\t// calling NewRaft later.\n   313\t//\n   314\t// A typical way to recover the cluster is to shut down all servers and then\n   315\t// run RecoverCluster on every server using an identical configuration. When\n   316\t// the cluster is then restarted, and election should occur and then Raft will\n   317\t// resume normal operation. If it's desired to make a particular server the\n   318\t// leader, this can be used to inject a new configuration with that server as\n   319\t// the sole voter, and then join up other new clean-state peer servers using\n   320\t// the usual APIs in order to bring the cluster back into a known state.\n   321\tfunc RecoverCluster(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n   322\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n   323\t) error {\n   324\t\t// Validate the Raft server config.\n   325\t\tif err := ValidateConfig(conf); err != nil {\n   326\t\t\treturn err\n   327\t\t}\n   328\t\n   329\t\t// Sanity check the Raft peer configuration.\n   330\t\tif err := checkConfiguration(configuration); err != nil {\n   331\t\t\treturn err\n   332\t\t}\n   333\t\n   334\t\t// Refuse to recover if there's no existing state. This would be safe to\n   335\t\t// do, but it is likely an indication of an operator error where they\n   336\t\t// expect data to be there and it's not. By refusing, we force them\n   337\t\t// to show intent to start a cluster fresh by explicitly doing a\n   338\t\t// bootstrap, rather than quietly fire up a fresh cluster here.\n   339\t\tif hasState, err := HasExistingState(logs, stable, snaps); err != nil {\n   340\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n   341\t\t} else if !hasState {\n   342\t\t\treturn fmt.Errorf(\"refused to recover cluster with no initial state, this is probably an operator error\")\n   343\t\t}\n   344\t\n   345\t\t// Attempt to restore any snapshots we find, newest to oldest.\n   346\t\tvar (\n   347\t\t\tsnapshotIndex  uint64\n   348\t\t\tsnapshotTerm   uint64\n   349\t\t\tsnapshots, err = snaps.List()\n   350\t\t)\n   351\t\tif err != nil {\n   352\t\t\treturn fmt.Errorf(\"failed to list snapshots: %v\", err)\n   353\t\t}\n   354\t\n   355\t\tlogger := conf.getOrCreateLogger()\n   356\t\n   357\t\tfor _, snapshot := range snapshots {\n   358\t\t\tvar source io.ReadCloser\n   359\t\t\t_, source, err = snaps.Open(snapshot.ID)\n   360\t\t\tif err != nil {\n   361\t\t\t\t// Skip this one and try the next. We will detect if we\n   362\t\t\t\t// couldn't open any snapshots.\n   363\t\t\t\tcontinue\n   364\t\t\t}\n   365\t\n   366\t\t\t// Note this is the one place we call fsm.Restore without the\n   367\t\t\t// fsmRestoreAndMeasure wrapper since this function should only be called to\n   368\t\t\t// reset state on disk and the FSM passed will not be used for a running\n   369\t\t\t// server instance. If the same process will eventually become a Raft peer\n   370\t\t\t// then it will call NewRaft and restore again from disk then which will\n   371\t\t\t// report metrics.\n   372\t\t\tsnapLogger := logger.With(\n   373\t\t\t\t\"id\", snapshot.ID,\n   374\t\t\t\t\"last-index\", snapshot.Index,\n   375\t\t\t\t\"last-term\", snapshot.Term,\n   376\t\t\t\t\"size-in-bytes\", snapshot.Size,\n   377\t\t\t)\n   378\t\t\tcrc := newCountingReadCloser(source)\n   379\t\t\tmonitor := startSnapshotRestoreMonitor(snapLogger, crc, snapshot.Size, false)\n   380\t\t\terr = fsm.Restore(crc)\n   381\t\t\t// Close the source after the restore has completed\n   382\t\t\t_ = source.Close()\n   383\t\t\tmonitor.StopAndWait()\n   384\t\t\tif err != nil {\n   385\t\t\t\t// Same here, skip and try the next one.\n   386\t\t\t\tcontinue\n   387\t\t\t}\n   388\t\n   389\t\t\tsnapshotIndex = snapshot.Index\n   390\t\t\tsnapshotTerm = snapshot.Term\n   391\t\t\tbreak\n   392\t\t}\n   393\t\tif len(snapshots) > 0 && (snapshotIndex == 0 || snapshotTerm == 0) {\n   394\t\t\treturn fmt.Errorf(\"failed to restore any of the available snapshots\")\n   395\t\t}\n   396\t\n   397\t\t// The snapshot information is the best known end point for the data\n   398\t\t// until we play back the Raft log entries.\n   399\t\tlastIndex := snapshotIndex\n   400\t\tlastTerm := snapshotTerm\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n api.go | sed -n '760,1100p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n api.go | sed -n '760,1100p'\"","aggregated_output":"   760\t\n   761\t// ReloadConfig updates the configuration of a running raft node. If the new\n   762\t// configuration is invalid an error is returned and no changes made to the\n   763\t// instance. All fields will be copied from rc into the new configuration, even\n   764\t// if they are zero valued.\n   765\tfunc (r *Raft) ReloadConfig(rc ReloadableConfig) error {\n   766\t\tr.confReloadMu.Lock()\n   767\t\tdefer r.confReloadMu.Unlock()\n   768\t\n   769\t\t// Load the current config (note we are under a lock so it can't be changed\n   770\t\t// between this read and a later Store).\n   771\t\toldCfg := r.config()\n   772\t\n   773\t\t// Set the reloadable fields\n   774\t\tnewCfg := rc.apply(oldCfg)\n   775\t\n   776\t\tif err := ValidateConfig(&newCfg); err != nil {\n   777\t\t\treturn err\n   778\t\t}\n   779\t\tr.conf.Store(newCfg)\n   780\t\n   781\t\tif rc.HeartbeatTimeout < oldCfg.HeartbeatTimeout {\n   782\t\t\t// On leader, ensure replication loops running with a longer\n   783\t\t\t// timeout than what we want now discover the change.\n   784\t\t\tasyncNotifyCh(r.leaderNotifyCh)\n   785\t\t\t// On follower, update current timer to use the shorter new value.\n   786\t\t\tasyncNotifyCh(r.followerNotifyCh)\n   787\t\t}\n   788\t\treturn nil\n   789\t}\n   790\t\n   791\t// ReloadableConfig returns the current state of the reloadable fields in Raft's\n   792\t// configuration. This is useful for programs to discover the current state for\n   793\t// reporting to users or tests. It is safe to call from any goroutine. It is\n   794\t// intended for reporting and testing purposes primarily; external\n   795\t// synchronization would be required to safely use this in a read-modify-write\n   796\t// pattern for reloadable configuration options.\n   797\tfunc (r *Raft) ReloadableConfig() ReloadableConfig {\n   798\t\tcfg := r.config()\n   799\t\tvar rc ReloadableConfig\n   800\t\trc.fromConfig(cfg)\n   801\t\treturn rc\n   802\t}\n   803\t\n   804\t// BootstrapCluster is equivalent to non-member BootstrapCluster but can be\n   805\t// called on an un-bootstrapped Raft instance after it has been created. This\n   806\t// should only be called at the beginning of time for the cluster with an\n   807\t// identical configuration listing all Voter servers. There is no need to\n   808\t// bootstrap Nonvoter and Staging servers.\n   809\t//\n   810\t// A cluster can only be bootstrapped once from a single participating Voter\n   811\t// server. Any further attempts to bootstrap will return an error that can be\n   812\t// safely ignored.\n   813\t//\n   814\t// One sane approach is to bootstrap a single server with a configuration\n   815\t// listing just itself as a Voter, then invoke AddVoter() on it to add other\n   816\t// servers to the cluster.\n   817\tfunc (r *Raft) BootstrapCluster(configuration Configuration) Future {\n   818\t\tbootstrapReq := &bootstrapFuture{}\n   819\t\tbootstrapReq.init()\n   820\t\tbootstrapReq.configuration = configuration\n   821\t\tselect {\n   822\t\tcase <-r.shutdownCh:\n   823\t\t\treturn errorFuture{ErrRaftShutdown}\n   824\t\tcase r.bootstrapCh <- bootstrapReq:\n   825\t\t\treturn bootstrapReq\n   826\t\t}\n   827\t}\n   828\t\n   829\t// Leader is used to return the current leader of the cluster.\n   830\t// Deprecated: use LeaderWithID instead\n   831\t// It may return empty string if there is no current leader\n   832\t// or the leader is unknown.\n   833\t// Deprecated: use LeaderWithID instead.\n   834\tfunc (r *Raft) Leader() ServerAddress {\n   835\t\tr.leaderLock.RLock()\n   836\t\tleaderAddr := r.leaderAddr\n   837\t\tr.leaderLock.RUnlock()\n   838\t\treturn leaderAddr\n   839\t}\n   840\t\n   841\t// LeaderWithID is used to return the current leader address and ID of the cluster.\n   842\t// It may return empty strings if there is no current leader\n   843\t// or the leader is unknown.\n   844\tfunc (r *Raft) LeaderWithID() (ServerAddress, ServerID) {\n   845\t\tr.leaderLock.RLock()\n   846\t\tleaderAddr := r.leaderAddr\n   847\t\tleaderID := r.leaderID\n   848\t\tr.leaderLock.RUnlock()\n   849\t\treturn leaderAddr, leaderID\n   850\t}\n   851\t\n   852\t// Apply is used to apply a command to the FSM in a highly consistent\n   853\t// manner. This returns a future that can be used to wait on the application.\n   854\t// An optional timeout can be provided to limit the amount of time we wait\n   855\t// for the command to be started. This must be run on the leader or it\n   856\t// will fail.\n   857\t//\n   858\t// If the node discovers it is no longer the leader while applying the command,\n   859\t// it will return ErrLeadershipLost. There is no way to guarantee whether the\n   860\t// write succeeded or failed in this case. For example, if the leader is\n   861\t// partitioned it can't know if a quorum of followers wrote the log to disk. If\n   862\t// at least one did, it may survive into the next leader's term.\n   863\t//\n   864\t// If a user snapshot is restored while the command is in-flight, an\n   865\t// ErrAbortedByRestore is returned. In this case the write effectively failed\n   866\t// since its effects will not be present in the FSM after the restore.\n   867\tfunc (r *Raft) Apply(cmd []byte, timeout time.Duration) ApplyFuture {\n   868\t\treturn r.ApplyLog(Log{Data: cmd}, timeout)\n   869\t}\n   870\t\n   871\t// ApplyLog performs Apply but takes in a Log directly. The only values\n   872\t// currently taken from the submitted Log are Data and Extensions. See\n   873\t// Apply for details on error cases.\n   874\tfunc (r *Raft) ApplyLog(log Log, timeout time.Duration) ApplyFuture {\n   875\t\tmetrics.IncrCounter([]string{\"raft\", \"apply\"}, 1)\n   876\t\n   877\t\tvar timer <-chan time.Time\n   878\t\tif timeout > 0 {\n   879\t\t\ttimer = time.After(timeout)\n   880\t\t}\n   881\t\n   882\t\t// Create a log future, no index or term yet\n   883\t\tlogFuture := &logFuture{\n   884\t\t\tlog: Log{\n   885\t\t\t\tType:       LogCommand,\n   886\t\t\t\tData:       log.Data,\n   887\t\t\t\tExtensions: log.Extensions,\n   888\t\t\t},\n   889\t\t}\n   890\t\tlogFuture.init()\n   891\t\n   892\t\tselect {\n   893\t\tcase <-timer:\n   894\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   895\t\tcase <-r.shutdownCh:\n   896\t\t\treturn errorFuture{ErrRaftShutdown}\n   897\t\tcase r.applyCh <- logFuture:\n   898\t\t\treturn logFuture\n   899\t\t}\n   900\t}\n   901\t\n   902\t// Barrier is used to issue a command that blocks until all preceding\n   903\t// operations have been applied to the FSM. It can be used to ensure the\n   904\t// FSM reflects all queued writes. An optional timeout can be provided to\n   905\t// limit the amount of time we wait for the command to be started. This\n   906\t// must be run on the leader, or it will fail.\n   907\tfunc (r *Raft) Barrier(timeout time.Duration) Future {\n   908\t\tmetrics.IncrCounter([]string{\"raft\", \"barrier\"}, 1)\n   909\t\tvar timer <-chan time.Time\n   910\t\tif timeout > 0 {\n   911\t\t\ttimer = time.After(timeout)\n   912\t\t}\n   913\t\n   914\t\t// Create a log future, no index or term yet\n   915\t\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\n   916\t\tlogFuture.init()\n   917\t\n   918\t\tselect {\n   919\t\tcase <-timer:\n   920\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   921\t\tcase <-r.shutdownCh:\n   922\t\t\treturn errorFuture{ErrRaftShutdown}\n   923\t\tcase r.applyCh <- logFuture:\n   924\t\t\treturn logFuture\n   925\t\t}\n   926\t}\n   927\t\n   928\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   929\t// to prevent returning stale data from the FSM after the peer has lost\n   930\t// leadership.\n   931\tfunc (r *Raft) VerifyLeader() Future {\n   932\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   933\t\tverifyFuture := &verifyFuture{}\n   934\t\tverifyFuture.init()\n   935\t\tselect {\n   936\t\tcase <-r.shutdownCh:\n   937\t\t\treturn errorFuture{ErrRaftShutdown}\n   938\t\tcase r.verifyCh <- verifyFuture:\n   939\t\t\treturn verifyFuture\n   940\t\t}\n   941\t}\n   942\t\n   943\t// GetConfiguration returns the latest configuration. This may not yet be\n   944\t// committed. The main loop can access this directly.\n   945\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n   946\t\tconfigReq := &configurationsFuture{}\n   947\t\tconfigReq.init()\n   948\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n   949\t\tconfigReq.respond(nil)\n   950\t\treturn configReq\n   951\t}\n   952\t\n   953\t// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n   954\t//\n   955\t// Deprecated: Use AddVoter/AddNonvoter instead.\n   956\tfunc (r *Raft) AddPeer(peer ServerAddress) Future {\n   957\t\tif r.protocolVersion > 2 {\n   958\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   959\t\t}\n   960\t\n   961\t\treturn r.requestConfigChange(configurationChangeRequest{\n   962\t\t\tcommand:       AddVoter,\n   963\t\t\tserverID:      ServerID(peer),\n   964\t\t\tserverAddress: peer,\n   965\t\t\tprevIndex:     0,\n   966\t\t}, 0)\n   967\t}\n   968\t\n   969\t// RemovePeer from the cluster configuration. If the current leader is being\n   970\t// removed, it will cause a new election to occur. Must be run on the leader,\n   971\t// or it will fail.\n   972\t\n   973\t// Deprecated: Use RemoveServer instead.\n   974\tfunc (r *Raft) RemovePeer(peer ServerAddress) Future {\n   975\t\tif r.protocolVersion > 2 {\n   976\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   977\t\t}\n   978\t\n   979\t\treturn r.requestConfigChange(configurationChangeRequest{\n   980\t\t\tcommand:   RemoveServer,\n   981\t\t\tserverID:  ServerID(peer),\n   982\t\t\tprevIndex: 0,\n   983\t\t}, 0)\n   984\t}\n   985\t\n   986\t// AddVoter will add the given server to the cluster as a staging server. If the\n   987\t// server is already in the cluster as a voter, this updates the server's address.\n   988\t// This must be run on the leader or it will fail. The leader will promote the\n   989\t// staging server to a voter once that server is ready. If nonzero, prevIndex is\n   990\t// the index of the only configuration upon which this change may be applied; if\n   991\t// another configuration entry has been added in the meantime, this request will\n   992\t// fail. If nonzero, timeout is how long this server should wait before the\n   993\t// configuration change log entry is appended.\n   994\tfunc (r *Raft) AddVoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n   995\t\tif r.protocolVersion < 2 {\n   996\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   997\t\t}\n   998\t\n   999\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1000\t\t\tcommand:       AddVoter,\n  1001\t\t\tserverID:      id,\n  1002\t\t\tserverAddress: address,\n  1003\t\t\tprevIndex:     prevIndex,\n  1004\t\t}, timeout)\n  1005\t}\n  1006\t\n  1007\t// AddNonvoter will add the given server to the cluster but won't assign it a\n  1008\t// vote. The server will receive log entries, but it won't participate in\n  1009\t// elections or log entry commitment. If the server is already in the cluster,\n  1010\t// this updates the server's address. This must be run on the leader or it will\n  1011\t// fail. For prevIndex and timeout, see AddVoter.\n  1012\tfunc (r *Raft) AddNonvoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1013\t\tif r.protocolVersion < 3 {\n  1014\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1015\t\t}\n  1016\t\n  1017\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1018\t\t\tcommand:       AddNonvoter,\n  1019\t\t\tserverID:      id,\n  1020\t\t\tserverAddress: address,\n  1021\t\t\tprevIndex:     prevIndex,\n  1022\t\t}, timeout)\n  1023\t}\n  1024\t\n  1025\t// RemoveServer will remove the given server from the cluster. If the current\n  1026\t// leader is being removed, it will cause a new election to occur. This must be\n  1027\t// run on the leader or it will fail. For prevIndex and timeout, see AddVoter.\n  1028\tfunc (r *Raft) RemoveServer(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1029\t\tif r.protocolVersion < 2 {\n  1030\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1031\t\t}\n  1032\t\n  1033\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1034\t\t\tcommand:   RemoveServer,\n  1035\t\t\tserverID:  id,\n  1036\t\t\tprevIndex: prevIndex,\n  1037\t\t}, timeout)\n  1038\t}\n  1039\t\n  1040\t// DemoteVoter will take away a server's vote, if it has one. If present, the\n  1041\t// server will continue to receive log entries, but it won't participate in\n  1042\t// elections or log entry commitment. If the server is not in the cluster, this\n  1043\t// does nothing. This must be run on the leader or it will fail. For prevIndex\n  1044\t// and timeout, see AddVoter.\n  1045\tfunc (r *Raft) DemoteVoter(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1046\t\tif r.protocolVersion < 3 {\n  1047\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1048\t\t}\n  1049\t\n  1050\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1051\t\t\tcommand:   DemoteVoter,\n  1052\t\t\tserverID:  id,\n  1053\t\t\tprevIndex: prevIndex,\n  1054\t\t}, timeout)\n  1055\t}\n  1056\t\n  1057\t// Shutdown is used to stop the Raft background routines.\n  1058\t// This is not a graceful operation. Provides a future that\n  1059\t// can be used to block until all background routines have exited.\n  1060\tfunc (r *Raft) Shutdown() Future {\n  1061\t\tr.shutdownLock.Lock()\n  1062\t\tdefer r.shutdownLock.Unlock()\n  1063\t\n  1064\t\tif !r.shutdown {\n  1065\t\t\tclose(r.shutdownCh)\n  1066\t\t\tr.shutdown = true\n  1067\t\t\tr.setState(Shutdown)\n  1068\t\t\treturn &shutdownFuture{r}\n  1069\t\t}\n  1070\t\n  1071\t\t// avoid closing transport twice\n  1072\t\treturn &shutdownFuture{nil}\n  1073\t}\n  1074\t\n  1075\t// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n  1076\t// that can be used to block until complete, and that contains a function that\n  1077\t// can be used to open the snapshot.\n  1078\tfunc (r *Raft) Snapshot() SnapshotFuture {\n  1079\t\tfuture := &userSnapshotFuture{}\n  1080\t\tfuture.init()\n  1081\t\tselect {\n  1082\t\tcase r.userSnapshotCh <- future:\n  1083\t\t\treturn future\n  1084\t\tcase <-r.shutdownCh:\n  1085\t\t\tfuture.respond(ErrRaftShutdown)\n  1086\t\t\treturn future\n  1087\t\t}\n  1088\t}\n  1089\t\n  1090\t// Restore is used to manually force Raft to consume an external snapshot, such\n  1091\t// as if restoring from a backup. We will use the current Raft configuration,\n  1092\t// not the one from the snapshot, so that we can restore into a new cluster. We\n  1093\t// will also use the max of the index of the snapshot, or the current index,\n  1094\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n  1095\t// so that the snapshot will be sent to followers and used for any new joiners.\n  1096\t// This can only be run on the leader, and blocks until the restore is complete\n  1097\t// or an error occurs.\n  1098\t//\n  1099\t// WARNING! This operation has the leader take on the state of the snapshot and\n  1100\t// then sets itself up so that it replicates that to its followers though the\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n inmem_store.go log_cache.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n inmem_store.go log_cache.go'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"sync\"\n     9\t\t\"sync/atomic\"\n    10\t)\n    11\t\n    12\tvar _ CommitTrackingLogStore = &InmemCommitTrackingStore{}\n    13\t\n    14\t// InmemStore implements the LogStore and StableStore interface.\n    15\t// It should NOT EVER be used for production. It is used only for\n    16\t// unit tests. Use the MDBStore implementation instead.\n    17\ttype InmemStore struct {\n    18\t\tl         sync.RWMutex\n    19\t\tlowIndex  uint64\n    20\t\thighIndex uint64\n    21\t\tlogs      map[uint64]*Log\n    22\t\tkv        map[string][]byte\n    23\t\tkvInt     map[string]uint64\n    24\t}\n    25\t\n    26\t// NewInmemStore returns a new in-memory backend. Do not ever\n    27\t// use for production. Only for testing.\n    28\tfunc NewInmemStore() *InmemStore {\n    29\t\ti := &InmemStore{\n    30\t\t\tlogs:  make(map[uint64]*Log),\n    31\t\t\tkv:    make(map[string][]byte),\n    32\t\t\tkvInt: make(map[string]uint64),\n    33\t\t}\n    34\t\treturn i\n    35\t}\n    36\t\n    37\t// FirstIndex implements the LogStore interface.\n    38\tfunc (i *InmemStore) FirstIndex() (uint64, error) {\n    39\t\ti.l.RLock()\n    40\t\tdefer i.l.RUnlock()\n    41\t\treturn i.lowIndex, nil\n    42\t}\n    43\t\n    44\t// LastIndex implements the LogStore interface.\n    45\tfunc (i *InmemStore) LastIndex() (uint64, error) {\n    46\t\ti.l.RLock()\n    47\t\tdefer i.l.RUnlock()\n    48\t\treturn i.highIndex, nil\n    49\t}\n    50\t\n    51\t// GetLog implements the LogStore interface.\n    52\tfunc (i *InmemStore) GetLog(index uint64, log *Log) error {\n    53\t\ti.l.RLock()\n    54\t\tdefer i.l.RUnlock()\n    55\t\tl, ok := i.logs[index]\n    56\t\tif !ok {\n    57\t\t\treturn ErrLogNotFound\n    58\t\t}\n    59\t\t*log = *l\n    60\t\treturn nil\n    61\t}\n    62\t\n    63\t// StoreLog implements the LogStore interface.\n    64\tfunc (i *InmemStore) StoreLog(log *Log) error {\n    65\t\treturn i.StoreLogs([]*Log{log})\n    66\t}\n    67\t\n    68\t// StoreLogs implements the LogStore interface.\n    69\tfunc (i *InmemStore) StoreLogs(logs []*Log) error {\n    70\t\ti.l.Lock()\n    71\t\tdefer i.l.Unlock()\n    72\t\tfor _, l := range logs {\n    73\t\t\ti.logs[l.Index] = l\n    74\t\t\tif i.lowIndex == 0 {\n    75\t\t\t\ti.lowIndex = l.Index\n    76\t\t\t}\n    77\t\t\tif l.Index > i.highIndex {\n    78\t\t\t\ti.highIndex = l.Index\n    79\t\t\t}\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// DeleteRange implements the LogStore interface.\n    85\tfunc (i *InmemStore) DeleteRange(min, max uint64) error {\n    86\t\ti.l.Lock()\n    87\t\tdefer i.l.Unlock()\n    88\t\tfor j := min; j <= max; j++ {\n    89\t\t\tdelete(i.logs, j)\n    90\t\t}\n    91\t\tif min <= i.lowIndex {\n    92\t\t\ti.lowIndex = max + 1\n    93\t\t}\n    94\t\tif max >= i.highIndex {\n    95\t\t\ti.highIndex = min - 1\n    96\t\t}\n    97\t\tif i.lowIndex > i.highIndex {\n    98\t\t\ti.lowIndex = 0\n    99\t\t\ti.highIndex = 0\n   100\t\t}\n   101\t\treturn nil\n   102\t}\n   103\t\n   104\t// Set implements the StableStore interface.\n   105\tfunc (i *InmemStore) Set(key []byte, val []byte) error {\n   106\t\ti.l.Lock()\n   107\t\tdefer i.l.Unlock()\n   108\t\ti.kv[string(key)] = val\n   109\t\treturn nil\n   110\t}\n   111\t\n   112\t// Get implements the StableStore interface.\n   113\tfunc (i *InmemStore) Get(key []byte) ([]byte, error) {\n   114\t\ti.l.RLock()\n   115\t\tdefer i.l.RUnlock()\n   116\t\tval := i.kv[string(key)]\n   117\t\tif val == nil {\n   118\t\t\treturn nil, errors.New(\"not found\")\n   119\t\t}\n   120\t\treturn val, nil\n   121\t}\n   122\t\n   123\t// SetUint64 implements the StableStore interface.\n   124\tfunc (i *InmemStore) SetUint64(key []byte, val uint64) error {\n   125\t\ti.l.Lock()\n   126\t\tdefer i.l.Unlock()\n   127\t\ti.kvInt[string(key)] = val\n   128\t\treturn nil\n   129\t}\n   130\t\n   131\t// GetUint64 implements the StableStore interface.\n   132\tfunc (i *InmemStore) GetUint64(key []byte) (uint64, error) {\n   133\t\ti.l.RLock()\n   134\t\tdefer i.l.RUnlock()\n   135\t\treturn i.kvInt[string(key)], nil\n   136\t}\n   137\t\n   138\ttype InmemCommitTrackingStore struct {\n   139\t\tInmemStore\n   140\t\tcommitIndex atomic.Uint64\n   141\t}\n   142\t\n   143\t// NewInmemCommitTrackingStore returns a new in-memory backend that tracks the commit index. Do not ever\n   144\t// use for production. Only for testing.\n   145\tfunc NewInmemCommitTrackingStore() *InmemCommitTrackingStore {\n   146\t\ti := &InmemCommitTrackingStore{\n   147\t\t\tInmemStore: *NewInmemStore(),\n   148\t\t}\n   149\t\treturn i\n   150\t}\n   151\t\n   152\tfunc (i *InmemCommitTrackingStore) StageCommitIndex(index uint64) error {\n   153\t\ti.commitIndex.Store(index)\n   154\t\treturn nil\n   155\t}\n   156\t\n   157\tfunc (i *InmemCommitTrackingStore) GetCommitIndex() (uint64, error) {\n   158\t\treturn i.commitIndex.Load(), nil\n   159\t}\n   160\t// Copyright IBM Corp. 2013, 2025\n   161\t// SPDX-License-Identifier: MPL-2.0\n   162\t\n   163\tpackage raft\n   164\t\n   165\timport (\n   166\t\t\"fmt\"\n   167\t\t\"sync\"\n   168\t)\n   169\t\n   170\t// LogCache wraps any LogStore implementation to provide an\n   171\t// in-memory ring buffer. This is used to cache access to\n   172\t// the recently written entries. For implementations that do not\n   173\t// cache themselves, this can provide a substantial boost by\n   174\t// avoiding disk I/O on recent entries.\n   175\ttype LogCache struct {\n   176\t\tstore LogStore\n   177\t\n   178\t\tcache []*Log\n   179\t\tl     sync.RWMutex\n   180\t}\n   181\t\n   182\t// NewLogCache is used to create a new LogCache with the\n   183\t// given capacity and backend store.\n   184\tfunc NewLogCache(capacity int, store LogStore) (*LogCache, error) {\n   185\t\tif capacity <= 0 {\n   186\t\t\treturn nil, fmt.Errorf(\"capacity must be positive\")\n   187\t\t}\n   188\t\tc := &LogCache{\n   189\t\t\tstore: store,\n   190\t\t\tcache: make([]*Log, capacity),\n   191\t\t}\n   192\t\treturn c, nil\n   193\t}\n   194\t\n   195\t// IsMonotonic implements the MonotonicLogStore interface. This is a shim to\n   196\t// expose the underlying store as monotonically indexed or not.\n   197\tfunc (c *LogCache) IsMonotonic() bool {\n   198\t\tif store, ok := c.store.(MonotonicLogStore); ok {\n   199\t\t\treturn store.IsMonotonic()\n   200\t\t}\n   201\t\n   202\t\treturn false\n   203\t}\n   204\t\n   205\tfunc (c *LogCache) GetLog(idx uint64, log *Log) error {\n   206\t\t// Check the buffer for an entry\n   207\t\tc.l.RLock()\n   208\t\tcached := c.cache[idx%uint64(len(c.cache))]\n   209\t\tc.l.RUnlock()\n   210\t\n   211\t\t// Check if entry is valid\n   212\t\tif cached != nil && cached.Index == idx {\n   213\t\t\t*log = *cached\n   214\t\t\treturn nil\n   215\t\t}\n   216\t\n   217\t\t// Forward request on cache miss\n   218\t\treturn c.store.GetLog(idx, log)\n   219\t}\n   220\t\n   221\tfunc (c *LogCache) StoreLog(log *Log) error {\n   222\t\treturn c.StoreLogs([]*Log{log})\n   223\t}\n   224\t\n   225\tfunc (c *LogCache) StoreLogs(logs []*Log) error {\n   226\t\terr := c.store.StoreLogs(logs)\n   227\t\t// Insert the logs into the ring buffer, but only on success\n   228\t\tif err != nil {\n   229\t\t\treturn fmt.Errorf(\"unable to store logs within log store, err: %q\", err)\n   230\t\t}\n   231\t\tc.l.Lock()\n   232\t\tfor _, l := range logs {\n   233\t\t\tc.cache[l.Index%uint64(len(c.cache))] = l\n   234\t\t}\n   235\t\tc.l.Unlock()\n   236\t\treturn nil\n   237\t}\n   238\t\n   239\tfunc (c *LogCache) FirstIndex() (uint64, error) {\n   240\t\treturn c.store.FirstIndex()\n   241\t}\n   242\t\n   243\tfunc (c *LogCache) LastIndex() (uint64, error) {\n   244\t\treturn c.store.LastIndex()\n   245\t}\n   246\t\n   247\tfunc (c *LogCache) DeleteRange(min, max uint64) error {\n   248\t\t// Invalidate the cache on deletes\n   249\t\tc.l.Lock()\n   250\t\tc.cache = make([]*Log, len(c.cache))\n   251\t\tc.l.Unlock()\n   252\t\n   253\t\treturn c.store.DeleteRange(min, max)\n   254\t}\n","exit_code":0,"status":"completed"}}
