{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n snapshot.go | sed -n '1,130p'; echo ====; cat -n file_snapshot.go | sed -n '1,140p'\"","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"io\"\n    10\t\t\"time\"\n    11\t\n    12\t\tmetrics \"github.com/hashicorp/go-metrics\"\n    13\t)\n    14\t\n    15\t// SnapshotMeta is for metadata of a snapshot.\n    16\ttype SnapshotMeta struct {\n    17\t\t// Version is the version number of the snapshot metadata. This does not cover\n    18\t\t// the application's data in the snapshot, that should be versioned\n    19\t\t// separately.\n    20\t\tVersion SnapshotVersion\n    21\t\n    22\t\t// ID is opaque to the store, and is used for opening.\n    23\t\tID string\n    24\t\n    25\t\t// Index and Term store when the snapshot was taken.\n    26\t\tIndex uint64\n    27\t\tTerm  uint64\n    28\t\n    29\t\t// Peers is deprecated and used to support version 0 snapshots, but will\n    30\t\t// be populated in version 1 snapshots as well to help with upgrades.\n    31\t\tPeers []byte\n    32\t\n    33\t\t// Configuration and ConfigurationIndex are present in version 1\n    34\t\t// snapshots and later.\n    35\t\tConfiguration      Configuration\n    36\t\tConfigurationIndex uint64\n    37\t\n    38\t\t// Size is the size of the snapshot in bytes.\n    39\t\tSize int64\n    40\t}\n    41\t\n    42\t// SnapshotStore interface is used to allow for flexible implementations\n    43\t// of snapshot storage and retrieval. For example, a client could implement\n    44\t// a shared state store such as S3, allowing new nodes to restore snapshots\n    45\t// without streaming from the leader.\n    46\ttype SnapshotStore interface {\n    47\t\t// Create is used to begin a snapshot at a given index and term, and with\n    48\t\t// the given committed configuration. The version parameter controls\n    49\t\t// which snapshot version to create.\n    50\t\tCreate(version SnapshotVersion, index, term uint64, configuration Configuration,\n    51\t\t\tconfigurationIndex uint64, trans Transport) (SnapshotSink, error)\n    52\t\n    53\t\t// List is used to list the available snapshots in the store.\n    54\t\t// It should return then in descending order, with the highest index first.\n    55\t\tList() ([]*SnapshotMeta, error)\n    56\t\n    57\t\t// Open takes a snapshot ID and provides a ReadCloser. Once close is\n    58\t\t// called it is assumed the snapshot is no longer needed.\n    59\t\tOpen(id string) (*SnapshotMeta, io.ReadCloser, error)\n    60\t}\n    61\t\n    62\t// SnapshotSink is returned by StartSnapshot. The FSM will Write state\n    63\t// to the sink and call Close on completion. On error, Cancel will be invoked.\n    64\ttype SnapshotSink interface {\n    65\t\tio.WriteCloser\n    66\t\tID() string\n    67\t\tCancel() error\n    68\t}\n    69\t\n    70\t// runSnapshots is a long running goroutine used to manage taking\n    71\t// new snapshots of the FSM. It runs in parallel to the FSM and\n    72\t// main goroutines, so that snapshots do not block normal operation.\n    73\tfunc (r *Raft) runSnapshots() {\n    74\t\tfor {\n    75\t\t\tselect {\n    76\t\t\tcase <-randomTimeout(r.config().SnapshotInterval):\n    77\t\t\t\t// Check if we should snapshot\n    78\t\t\t\tif !r.shouldSnapshot() {\n    79\t\t\t\t\tcontinue\n    80\t\t\t\t}\n    81\t\n    82\t\t\t\t// Trigger a snapshot\n    83\t\t\t\tif _, err := r.takeSnapshot(); err != nil && !errors.Is(err, ErrNothingNewToSnapshot) {\n    84\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    85\t\t\t\t}\n    86\t\n    87\t\t\tcase future := <-r.userSnapshotCh:\n    88\t\t\t\t// User-triggered, run immediately\n    89\t\t\t\tid, err := r.takeSnapshot()\n    90\t\t\t\tif err != nil && !errors.Is(err, ErrNothingNewToSnapshot) {\n    91\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    92\t\t\t\t} else if err == nil {\n    93\t\t\t\t\tfuture.opener = func() (*SnapshotMeta, io.ReadCloser, error) {\n    94\t\t\t\t\t\treturn r.snapshots.Open(id)\n    95\t\t\t\t\t}\n    96\t\t\t\t}\n    97\t\t\t\tfuture.respond(err)\n    98\t\n    99\t\t\tcase <-r.shutdownCh:\n   100\t\t\t\treturn\n   101\t\t\t}\n   102\t\t}\n   103\t}\n   104\t\n   105\t// shouldSnapshot checks if we meet the conditions to take\n   106\t// a new snapshot.\n   107\tfunc (r *Raft) shouldSnapshot() bool {\n   108\t\t// Check the last snapshot index\n   109\t\tlastSnap, _ := r.getLastSnapshot()\n   110\t\n   111\t\t// Check the last log index\n   112\t\tlastIdx, err := r.logs.LastIndex()\n   113\t\tif err != nil {\n   114\t\t\tr.logger.Error(\"failed to get last log index\", \"error\", err)\n   115\t\t\treturn false\n   116\t\t}\n   117\t\n   118\t\t// Compare the delta to the threshold\n   119\t\tdelta := lastIdx - lastSnap\n   120\t\treturn delta >= r.config().SnapshotThreshold\n   121\t}\n   122\t\n   123\t// takeSnapshot is used to take a new snapshot. This must only be called from\n   124\t// the snapshot thread, never the main thread. This returns the ID of the new\n   125\t// snapshot, along with an error.\n   126\tfunc (r *Raft) takeSnapshot() (string, error) {\n   127\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n   128\t\n   129\t\t// Create a request for the FSM to perform a snapshot.\n   130\t\tsnapReq := &reqSnapshotFuture{}\n====\n     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bufio\"\n     8\t\t\"bytes\"\n     9\t\t\"encoding/json\"\n    10\t\t\"fmt\"\n    11\t\t\"hash\"\n    12\t\t\"hash/crc64\"\n    13\t\t\"io\"\n    14\t\t\"os\"\n    15\t\t\"path/filepath\"\n    16\t\t\"runtime\"\n    17\t\t\"sort\"\n    18\t\t\"strings\"\n    19\t\t\"time\"\n    20\t\n    21\t\thclog \"github.com/hashicorp/go-hclog\"\n    22\t)\n    23\t\n    24\tconst (\n    25\t\ttestPath      = \"permTest\"\n    26\t\tsnapPath      = \"snapshots\"\n    27\t\tmetaFilePath  = \"meta.json\"\n    28\t\tstateFilePath = \"state.bin\"\n    29\t\ttmpSuffix     = \".tmp\"\n    30\t)\n    31\t\n    32\t// FileSnapshotStore implements the SnapshotStore interface and allows\n    33\t// snapshots to be made on the local disk.\n    34\ttype FileSnapshotStore struct {\n    35\t\tpath   string\n    36\t\tretain int\n    37\t\tlogger hclog.Logger\n    38\t\n    39\t\t// noSync, if true, skips crash-safe file fsync api calls.\n    40\t\t// It's a private field, only used in testing\n    41\t\tnoSync bool\n    42\t}\n    43\t\n    44\ttype snapMetaSlice []*fileSnapshotMeta\n    45\t\n    46\t// FileSnapshotSink implements SnapshotSink with a file.\n    47\ttype FileSnapshotSink struct {\n    48\t\tstore     *FileSnapshotStore\n    49\t\tlogger    hclog.Logger\n    50\t\tdir       string\n    51\t\tparentDir string\n    52\t\tmeta      fileSnapshotMeta\n    53\t\n    54\t\tnoSync bool\n    55\t\n    56\t\tstateFile *os.File\n    57\t\tstateHash hash.Hash64\n    58\t\tbuffered  *bufio.Writer\n    59\t\n    60\t\tclosed bool\n    61\t}\n    62\t\n    63\t// fileSnapshotMeta is stored on disk. We also put a CRC\n    64\t// on disk so that we can verify the snapshot.\n    65\ttype fileSnapshotMeta struct {\n    66\t\tSnapshotMeta\n    67\t\tCRC []byte\n    68\t}\n    69\t\n    70\t// bufferedFile is returned when we open a snapshot. This way\n    71\t// reads are buffered and the file still gets closed.\n    72\ttype bufferedFile struct {\n    73\t\tbh *bufio.Reader\n    74\t\tfh *os.File\n    75\t}\n    76\t\n    77\tfunc (b *bufferedFile) Read(p []byte) (n int, err error) {\n    78\t\treturn b.bh.Read(p)\n    79\t}\n    80\t\n    81\tfunc (b *bufferedFile) Close() error {\n    82\t\treturn b.fh.Close()\n    83\t}\n    84\t\n    85\t// NewFileSnapshotStoreWithLogger creates a new FileSnapshotStore based\n    86\t// on a base directory. The `retain` parameter controls how many\n    87\t// snapshots are retained. Must be at least 1.\n    88\tfunc NewFileSnapshotStoreWithLogger(base string, retain int, logger hclog.Logger) (*FileSnapshotStore, error) {\n    89\t\tif retain < 1 {\n    90\t\t\treturn nil, fmt.Errorf(\"must retain at least one snapshot\")\n    91\t\t}\n    92\t\tif logger == nil {\n    93\t\t\tlogger = hclog.New(&hclog.LoggerOptions{\n    94\t\t\t\tName:   \"snapshot\",\n    95\t\t\t\tOutput: hclog.DefaultOutput,\n    96\t\t\t\tLevel:  hclog.DefaultLevel,\n    97\t\t\t})\n    98\t\t}\n    99\t\n   100\t\t// Ensure our path exists\n   101\t\tpath := filepath.Join(base, snapPath)\n   102\t\tif err := os.MkdirAll(path, 0o755); err != nil && !os.IsExist(err) {\n   103\t\t\treturn nil, fmt.Errorf(\"snapshot path not accessible: %v\", err)\n   104\t\t}\n   105\t\n   106\t\t// Setup the store\n   107\t\tstore := &FileSnapshotStore{\n   108\t\t\tpath:   path,\n   109\t\t\tretain: retain,\n   110\t\t\tlogger: logger,\n   111\t\t}\n   112\t\n   113\t\t// Do a permissions test\n   114\t\tif err := store.testPermissions(); err != nil {\n   115\t\t\treturn nil, fmt.Errorf(\"permissions test failed: %v\", err)\n   116\t\t}\n   117\t\treturn store, nil\n   118\t}\n   119\t\n   120\t// NewFileSnapshotStore creates a new FileSnapshotStore based\n   121\t// on a base directory. The `retain` parameter controls how many\n   122\t// snapshots are retained. Must be at least 1.\n   123\tfunc NewFileSnapshotStore(base string, retain int, logOutput io.Writer) (*FileSnapshotStore, error) {\n   124\t\tif logOutput == nil {\n   125\t\t\tlogOutput = os.Stderr\n   126\t\t}\n   127\t\treturn NewFileSnapshotStoreWithLogger(base, retain, hclog.New(&hclog.LoggerOptions{\n   128\t\t\tName:   \"snapshot\",\n   129\t\t\tOutput: logOutput,\n   130\t\t\tLevel:  hclog.DefaultLevel,\n   131\t\t}))\n   132\t}\n   133\t\n   134\t// testPermissions tries to touch a file in our path to see if it works.\n   135\tfunc (f *FileSnapshotStore) testPermissions() error {\n   136\t\tpath := filepath.Join(f.path, testPath)\n   137\t\tfh, err := os.Create(path)\n   138\t\tif err != nil {\n   139\t\t\treturn err\n   140\t\t}\n","exit_code":0,"status":"completed"}}
