future\n  2224\t\tcase <-r.shutdownCh:\n  2225\t\t\treturn errorFuture{ErrRaftShutdown}\n  2226\t\tdefault:\n  2227\t\t\treturn errorFuture{ErrEnqueueTimeout}\n  2228\t\t}\n  2229\t}\n  2230\t\n  2231\t// timeoutNow is what happens when a server receives a TimeoutNowRequest.\n  2232\tfunc (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n  2233\t\tr.setLeader(\"\", \"\")\n  2234\t\tr.setState(Candidate)\n  2235\t\tr.candidateFromLeadershipTransfer.Store(true)\n  2236\t\trpc.Respond(&TimeoutNowResponse{}, nil)\n  2237\t}\n  2238\t\n  2239\t// setLatestConfiguration stores the latest configuration and updates a copy of it.\n  2240\tfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n  2241\t\tr.configurations.latest = c\n  2242\t\tr.configurations.latestIndex = i\n  2243\t\tr.latestConfiguration.Store(c.Clone())\n  2244\t}\n  2245\t\n  2246\t// setCommittedConfiguration stores the committed configuration.\n  2247\tfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n  2248\t\tr.configurations.committed = c\n  2249\t\tr.configurations.committedIndex = i\n  2250\t}\n  2251\t\n  2252\t// getLatestConfiguration reads the configuration from a copy of the main\n  2253\t// configuration, which means it can be accessed independently from the main\n  2254\t// loop.\n  2255\tfunc (r *Raft) getLatestConfiguration() Configuration {\n  2256\t\t// this switch catches the case where this is called without having set\n  2257\t\t// a configuration previously.\n  2258\t\tswitch c := r.latestConfiguration.Load().(type) {\n  2259\t\tcase Configuration:\n  2260\t\t\treturn c\n  2261\t\tdefault:\n  2262\t\t\treturn Configuration{}\n  2263\t\t}\n  2264\t}\n","exit_code":0,"status":"completed"}}
