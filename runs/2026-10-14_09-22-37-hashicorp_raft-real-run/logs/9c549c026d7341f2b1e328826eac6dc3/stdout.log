{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '1,200p'\"","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bytes\"\n     8\t\t\"container/list\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"io\"\n    12\t\t\"strings\"\n    13\t\t\"sync/atomic\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/hashicorp/go-hclog\"\n    17\t\n    18\t\t\"github.com/hashicorp/go-metrics\"\n    19\t)\n    20\t\n    21\tconst (\n    22\t\tminCheckInterval          = 10 * time.Millisecond\n    23\t\toldestLogGaugeInterval    = 10 * time.Second\n    24\t\trpcUnexpectedCommandError = \"unexpected command\"\n    25\t)\n    26\t\n    27\tvar (\n    28\t\tkeyCurrentTerm  = []byte(\"CurrentTerm\")\n    29\t\tkeyLastVoteTerm = []byte(\"LastVoteTerm\")\n    30\t\tkeyLastVoteCand = []byte(\"LastVoteCand\")\n    31\t)\n    32\t\n    33\t// getRPCHeader returns an initialized RPCHeader struct for the given\n    34\t// Raft instance. This structure is sent along with RPC requests and\n    35\t// responses.\n    36\tfunc (r *Raft) getRPCHeader() RPCHeader {\n    37\t\treturn RPCHeader{\n    38\t\t\tProtocolVersion: r.config().ProtocolVersion,\n    39\t\t\tID:              []byte(r.config().LocalID),\n    40\t\t\tAddr:            r.trans.EncodePeer(r.config().LocalID, r.localAddr),\n    41\t\t}\n    42\t}\n    43\t\n    44\t// checkRPCHeader houses logic about whether this instance of Raft can process\n    45\t// the given RPC message.\n    46\tfunc (r *Raft) checkRPCHeader(rpc RPC) error {\n    47\t\t// Get the header off the RPC message.\n    48\t\twh, ok := rpc.Command.(WithRPCHeader)\n    49\t\tif !ok {\n    50\t\t\treturn fmt.Errorf(\"RPC does not have a header\")\n    51\t\t}\n    52\t\theader := wh.GetRPCHeader()\n    53\t\n    54\t\t// First check is to just make sure the code can understand the\n    55\t\t// protocol at all.\n    56\t\tif header.ProtocolVersion < ProtocolVersionMin ||\n    57\t\t\theader.ProtocolVersion > ProtocolVersionMax {\n    58\t\t\treturn ErrUnsupportedProtocol\n    59\t\t}\n    60\t\n    61\t\t// Second check is whether we should support this message, given the\n    62\t\t// current protocol we are configured to run. This will drop support\n    63\t\t// for protocol version 0 starting at protocol version 2, which is\n    64\t\t// currently what we want, and in general support one version back. We\n    65\t\t// may need to revisit this policy depending on how future protocol\n    66\t\t// changes evolve.\n    67\t\tif header.ProtocolVersion < r.config().ProtocolVersion-1 {\n    68\t\t\treturn ErrUnsupportedProtocol\n    69\t\t}\n    70\t\n    71\t\treturn nil\n    72\t}\n    73\t\n    74\t// getSnapshotVersion returns the snapshot version that should be used when\n    75\t// creating snapshots, given the protocol version in use.\n    76\tfunc getSnapshotVersion(protocolVersion ProtocolVersion) SnapshotVersion {\n    77\t\t// Right now we only have two versions and they are backwards compatible\n    78\t\t// so we don't need to look at the protocol version.\n    79\t\treturn 1\n    80\t}\n    81\t\n    82\t// commitTuple is used to send an index that was committed,\n    83\t// with an optional associated future that should be invoked.\n    84\ttype commitTuple struct {\n    85\t\tlog    *Log\n    86\t\tfuture *logFuture\n    87\t}\n    88\t\n    89\t// leaderState is state that is used while we are a leader.\n    90\ttype leaderState struct {\n    91\t\tleadershipTransferInProgress int32 // indicates that a leadership transfer is in progress.\n    92\t\tcommitCh                     chan struct{}\n    93\t\tcommitment                   *commitment\n    94\t\tinflight                     *list.List // list of logFuture in log index order\n    95\t\treplState                    map[ServerID]*followerReplication\n    96\t\tnotify                       map[*verifyFuture]struct{}\n    97\t\tstepDown                     chan struct{}\n    98\t}\n    99\t\n   100\t// setLeader is used to modify the current leader Address and ID of the cluster\n   101\tfunc (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {\n   102\t\tr.leaderLock.Lock()\n   103\t\toldLeaderAddr := r.leaderAddr\n   104\t\tr.leaderAddr = leaderAddr\n   105\t\toldLeaderID := r.leaderID\n   106\t\tr.leaderID = leaderID\n   107\t\tr.leaderLock.Unlock()\n   108\t\tif oldLeaderAddr != leaderAddr || oldLeaderID != leaderID {\n   109\t\t\tr.observe(LeaderObservation{Leader: leaderAddr, LeaderAddr: leaderAddr, LeaderID: leaderID})\n   110\t\t}\n   111\t}\n   112\t\n   113\t// requestConfigChange is a helper for the above functions that make\n   114\t// configuration change requests. 'req' describes the change. For timeout,\n   115\t// see AddVoter.\n   116\tfunc (r *Raft) requestConfigChange(req configurationChangeRequest, timeout time.Duration) IndexFuture {\n   117\t\tvar timer <-chan time.Time\n   118\t\tif timeout > 0 {\n   119\t\t\ttimer = time.After(timeout)\n   120\t\t}\n   121\t\tfuture := &configurationChangeFuture{\n   122\t\t\treq: req,\n   123\t\t}\n   124\t\tfuture.init()\n   125\t\tselect {\n   126\t\tcase <-timer:\n   127\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   128\t\tcase r.configurationChangeCh <- future:\n   129\t\t\treturn future\n   130\t\tcase <-r.shutdownCh:\n   131\t\t\treturn errorFuture{ErrRaftShutdown}\n   132\t\t}\n   133\t}\n   134\t\n   135\t// run the main thread that handles leadership and RPC requests.\n   136\tfunc (r *Raft) run() {\n   137\t\tfor {\n   138\t\t\t// Check if we are doing a shutdown\n   139\t\t\tselect {\n   140\t\t\tcase <-r.shutdownCh:\n   141\t\t\t\t// Clear the leader to prevent forwarding\n   142\t\t\t\tr.setLeader(\"\", \"\")\n   143\t\t\t\treturn\n   144\t\t\tdefault:\n   145\t\t\t}\n   146\t\n   147\t\t\tswitch r.getState() {\n   148\t\t\tcase Follower:\n   149\t\t\t\tr.runFollower()\n   150\t\t\tcase Candidate:\n   151\t\t\t\tr.runCandidate()\n   152\t\t\tcase Leader:\n   153\t\t\t\tr.runLeader()\n   154\t\t\t}\n   155\t\t}\n   156\t}\n   157\t\n   158\t// runFollower runs the main loop while in the follower state.\n   159\tfunc (r *Raft) runFollower() {\n   160\t\tdidWarn := false\n   161\t\tleaderAddr, leaderID := r.LeaderWithID()\n   162\t\tr.logger.Info(\"entering follower state\", \"follower\", r, \"leader-address\", leaderAddr, \"leader-id\", leaderID)\n   163\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"follower\"}, 1)\n   164\t\theartbeatTimer := randomTimeout(r.config().HeartbeatTimeout)\n   165\t\n   166\t\tfor r.getState() == Follower {\n   167\t\t\tr.mainThreadSaturation.sleeping()\n   168\t\n   169\t\t\tselect {\n   170\t\t\tcase rpc := <-r.rpcCh:\n   171\t\t\t\tr.mainThreadSaturation.working()\n   172\t\t\t\tr.processRPC(rpc)\n   173\t\n   174\t\t\tcase c := <-r.configurationChangeCh:\n   175\t\t\t\tr.mainThreadSaturation.working()\n   176\t\t\t\t// Reject any operations since we are not the leader\n   177\t\t\t\tc.respond(ErrNotLeader)\n   178\t\n   179\t\t\tcase a := <-r.applyCh:\n   180\t\t\t\tr.mainThreadSaturation.working()\n   181\t\t\t\t// Reject any operations since we are not the leader\n   182\t\t\t\ta.respond(ErrNotLeader)\n   183\t\n   184\t\t\tcase v := <-r.verifyCh:\n   185\t\t\t\tr.mainThreadSaturation.working()\n   186\t\t\t\t// Reject any operations since we are not the leader\n   187\t\t\t\tv.respond(ErrNotLeader)\n   188\t\n   189\t\t\tcase ur := <-r.userRestoreCh:\n   190\t\t\t\tr.mainThreadSaturation.working()\n   191\t\t\t\t// Reject any restores since we are not the leader\n   192\t\t\t\tur.respond(ErrNotLeader)\n   193\t\n   194\t\t\tcase l := <-r.leadershipTransferCh:\n   195\t\t\t\tr.mainThreadSaturation.working()\n   196\t\t\t\t// Reject any operations since we are not the leader\n   197\t\t\t\tl.respond(ErrNotLeader)\n   198\t\n   199\t\t\tcase c := <-r.configurationsCh:\n   200\t\t\t\tr.mainThreadSaturation.working()\n","exit_code":0,"status":"completed"}}
