{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '1180,1400p'\"","aggregated_output":"  1180\t\n  1181\t\t// We set the last log so it looks like we've stored the empty\n  1182\t\t// index we burned. The last applied is set because we made the\n  1183\t\t// FSM take the snapshot state, and we store the last snapshot\n  1184\t\t// in the stable store since we created a snapshot as part of\n  1185\t\t// this process.\n  1186\t\tr.setLastLog(lastIndex, term)\n  1187\t\tr.setLastApplied(lastIndex)\n  1188\t\tr.setLastSnapshot(lastIndex, term)\n  1189\t\n  1190\t\t// Remove old logs if r.logs is a MonotonicLogStore. Log any errors and continue.\n  1191\t\tif logs, ok := r.logs.(MonotonicLogStore); ok && logs.IsMonotonic() {\n  1192\t\t\tif err := r.removeOldLogs(); err != nil {\n  1193\t\t\t\tr.logger.Error(\"failed to remove old logs\", \"error\", err)\n  1194\t\t\t}\n  1195\t\t}\n  1196\t\n  1197\t\tr.logger.Info(\"restored user snapshot\", \"index\", lastIndex)\n  1198\t\treturn nil\n  1199\t}\n  1200\t\n  1201\t// appendConfigurationEntry changes the configuration and adds a new\n  1202\t// configuration entry to the log. This must only be called from the\n  1203\t// main thread.\n  1204\tfunc (r *Raft) appendConfigurationEntry(future *configurationChangeFuture) {\n  1205\t\tconfiguration, err := nextConfiguration(r.configurations.latest, r.configurations.latestIndex, future.req)\n  1206\t\tif err != nil {\n  1207\t\t\tfuture.respond(err)\n  1208\t\t\treturn\n  1209\t\t}\n  1210\t\n  1211\t\tr.logger.Info(\"updating configuration\",\n  1212\t\t\t\"command\", future.req.command,\n  1213\t\t\t\"server-id\", future.req.serverID,\n  1214\t\t\t\"server-addr\", future.req.serverAddress,\n  1215\t\t\t\"servers\", hclog.Fmt(\"%+v\", configuration.Servers))\n  1216\t\n  1217\t\t// In pre-ID compatibility mode we translate all configuration changes\n  1218\t\t// in to an old remove peer message, which can handle all supported\n  1219\t\t// cases for peer changes in the pre-ID world (adding and removing\n  1220\t\t// voters). Both add peer and remove peer log entries are handled\n  1221\t\t// similarly on old Raft servers, but remove peer does extra checks to\n  1222\t\t// see if a leader needs to step down. Since they both assert the full\n  1223\t\t// configuration, then we can safely call remove peer for everything.\n  1224\t\tif r.protocolVersion < 2 {\n  1225\t\t\tfuture.log = Log{\n  1226\t\t\t\tType: LogRemovePeerDeprecated,\n  1227\t\t\t\tData: encodePeers(configuration, r.trans),\n  1228\t\t\t}\n  1229\t\t} else {\n  1230\t\t\tfuture.log = Log{\n  1231\t\t\t\tType: LogConfiguration,\n  1232\t\t\t\tData: EncodeConfiguration(configuration),\n  1233\t\t\t}\n  1234\t\t}\n  1235\t\n  1236\t\tr.dispatchLogs([]*logFuture{&future.logFuture})\n  1237\t\tindex := future.Index()\n  1238\t\tr.setLatestConfiguration(configuration, index)\n  1239\t\tr.leaderState.commitment.setConfiguration(configuration)\n  1240\t\tr.startStopReplication()\n  1241\t}\n  1242\t\n  1243\t// dispatchLog is called on the leader to push a log to disk, mark it\n  1244\t// as inflight and begin replication of it.\n  1245\tfunc (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n  1246\t\tnow := time.Now()\n  1247\t\tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n  1248\t\n  1249\t\tterm := r.getCurrentTerm()\n  1250\t\tlastIndex := r.getLastIndex()\n  1251\t\n  1252\t\tn := len(applyLogs)\n  1253\t\tlogs := make([]*Log, n)\n  1254\t\tmetrics.SetGauge([]string{\"raft\", \"leader\", \"dispatchNumLogs\"}, float32(n))\n  1255\t\n  1256\t\tfor idx, applyLog := range applyLogs {\n  1257\t\t\tapplyLog.dispatch = now\n  1258\t\t\tlastIndex++\n  1259\t\t\tapplyLog.log.Index = lastIndex\n  1260\t\t\tapplyLog.log.Term = term\n  1261\t\t\tapplyLog.log.AppendedAt = now\n  1262\t\t\tlogs[idx] = &applyLog.log\n  1263\t\t\tr.leaderState.inflight.PushBack(applyLog)\n  1264\t\t}\n  1265\t\n  1266\t\tcommitIndex := r.getCommitIndex()\n  1267\t\tr.tryStageCommitIndex(commitIndex)\n  1268\t\n  1269\t\t// Write the log entry locally\n  1270\t\tif err := r.logs.StoreLogs(logs); err != nil {\n  1271\t\t\tr.logger.Error(\"failed to commit logs\", \"error\", err)\n  1272\t\t\tfor _, applyLog := range applyLogs {\n  1273\t\t\t\tapplyLog.respond(err)\n  1274\t\t\t}\n  1275\t\t\tr.setState(Follower)\n  1276\t\t\treturn\n  1277\t\t}\n  1278\t\tr.leaderState.commitment.match(r.localID, lastIndex)\n  1279\t\n  1280\t\t// Update the last log since it's on disk now\n  1281\t\tr.setLastLog(lastIndex, term)\n  1282\t\n  1283\t\t// Notify the replicators of the new log\n  1284\t\tfor _, f := range r.leaderState.replState {\n  1285\t\t\tasyncNotifyCh(f.triggerCh)\n  1286\t\t}\n  1287\t}\n  1288\t\n  1289\t// processLogs is used to apply all the committed entries that haven't been\n  1290\t// applied up to the given index limit.\n  1291\t// This can be called from both leaders and followers.\n  1292\t// Followers call this from AppendEntries, for n entries at a time, and always\n  1293\t// pass futures=nil.\n  1294\t// Leaders call this when entries are committed. They pass the futures from any\n  1295\t// inflight logs.\n  1296\tfunc (r *Raft) processLogs(index uint64, futures map[uint64]*logFuture) {\n  1297\t\t// Reject logs we've applied already\n  1298\t\tlastApplied := r.getLastApplied()\n  1299\t\tif index <= lastApplied {\n  1300\t\t\tr.logger.Warn(\"skipping application of old log\", \"index\", index)\n  1301\t\t\treturn\n  1302\t\t}\n  1303\t\n  1304\t\tapplyBatch := func(batch []*commitTuple) {\n  1305\t\t\tselect {\n  1306\t\t\tcase r.fsmMutateCh <- batch:\n  1307\t\t\tcase <-r.shutdownCh:\n  1308\t\t\t\tfor _, cl := range batch {\n  1309\t\t\t\t\tif cl.future != nil {\n  1310\t\t\t\t\t\tcl.future.respond(ErrRaftShutdown)\n  1311\t\t\t\t\t}\n  1312\t\t\t\t}\n  1313\t\t\t}\n  1314\t\t}\n  1315\t\n  1316\t\t// Store maxAppendEntries for this call in case it ever becomes reloadable. We\n  1317\t\t// need to use the same value for all lines here to get the expected result.\n  1318\t\tmaxAppendEntries := r.config().MaxAppendEntries\n  1319\t\n  1320\t\tbatch := make([]*commitTuple, 0, maxAppendEntries)\n  1321\t\n  1322\t\t// Apply all the preceding logs\n  1323\t\tfor idx := lastApplied + 1; idx <= index; idx++ {\n  1324\t\t\tvar preparedLog *commitTuple\n  1325\t\t\t// Get the log, either from the future or from our log store\n  1326\t\t\tfuture, futureOk := futures[idx]\n  1327\t\t\tif futureOk {\n  1328\t\t\t\tpreparedLog = r.prepareLog(&future.log, future)\n  1329\t\t\t} else {\n  1330\t\t\t\tl := new(Log)\n  1331\t\t\t\tif err := r.logs.GetLog(idx, l); err != nil {\n  1332\t\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", idx, \"error\", err)\n  1333\t\t\t\t\tpanic(err)\n  1334\t\t\t\t}\n  1335\t\t\t\tpreparedLog = r.prepareLog(l, nil)\n  1336\t\t\t}\n  1337\t\n  1338\t\t\tswitch {\n  1339\t\t\tcase preparedLog != nil:\n  1340\t\t\t\t// If we have a log ready to send to the FSM add it to the batch.\n  1341\t\t\t\t// The FSM thread will respond to the future.\n  1342\t\t\t\tbatch = append(batch, preparedLog)\n  1343\t\n  1344\t\t\t\t// If we have filled up a batch, send it to the FSM\n  1345\t\t\t\tif len(batch) >= maxAppendEntries {\n  1346\t\t\t\t\tapplyBatch(batch)\n  1347\t\t\t\t\tbatch = make([]*commitTuple, 0, maxAppendEntries)\n  1348\t\t\t\t}\n  1349\t\n  1350\t\t\tcase futureOk:\n  1351\t\t\t\t// Invoke the future if given.\n  1352\t\t\t\tfuture.respond(nil)\n  1353\t\t\t}\n  1354\t\t}\n  1355\t\n  1356\t\t// If there are any remaining logs in the batch apply them\n  1357\t\tif len(batch) != 0 {\n  1358\t\t\tapplyBatch(batch)\n  1359\t\t}\n  1360\t\n  1361\t\t// Update the lastApplied index and term\n  1362\t\tr.setLastApplied(index)\n  1363\t}\n  1364\t\n  1365\t// processLog is invoked to process the application of a single committed log entry.\n  1366\tfunc (r *Raft) prepareLog(l *Log, future *logFuture) *commitTuple {\n  1367\t\tswitch l.Type {\n  1368\t\tcase LogBarrier:\n  1369\t\t\t// Barrier is handled by the FSM\n  1370\t\t\tfallthrough\n  1371\t\n  1372\t\tcase LogCommand:\n  1373\t\t\treturn &commitTuple{l, future}\n  1374\t\n  1375\t\tcase LogConfiguration:\n  1376\t\t\t// Only support this with the v2 configuration format\n  1377\t\t\tif r.protocolVersion > 2 {\n  1378\t\t\t\treturn &commitTuple{l, future}\n  1379\t\t\t}\n  1380\t\tcase LogAddPeerDeprecated:\n  1381\t\tcase LogRemovePeerDeprecated:\n  1382\t\tcase LogNoop:\n  1383\t\t\t// Ignore the no-op\n  1384\t\n  1385\t\tdefault:\n  1386\t\t\tpanic(fmt.Errorf(\"unrecognized log type: %#v\", l))\n  1387\t\t}\n  1388\t\n  1389\t\treturn nil\n  1390\t}\n  1391\t\n  1392\t// tryStageCommitIndex updates the commit index in persist store if restore committed logs is enabled and log store implements CommitTrackingLogStore.\n  1393\tfunc (r *Raft) tryStageCommitIndex(commitIndex uint64) {\n  1394\t\tif !r.RestoreCommittedLogs {\n  1395\t\t\treturn\n  1396\t\t}\n  1397\t\tstore, ok := r.logs.(CommitTrackingLogStore)\n  1398\t\tif !ok {\n  1399\t\t\treturn\n  1400\t\t}\n","exit_code":0,"status":"completed"}}
