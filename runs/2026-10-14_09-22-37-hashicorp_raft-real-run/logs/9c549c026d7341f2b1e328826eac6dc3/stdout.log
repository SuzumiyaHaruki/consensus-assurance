{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '1380,1470p'; echo ====; cat -n raft.go | sed -n '1700,1900p'\"","aggregated_output":"  1380\t\tcase LogAddPeerDeprecated:\n  1381\t\tcase LogRemovePeerDeprecated:\n  1382\t\tcase LogNoop:\n  1383\t\t\t// Ignore the no-op\n  1384\t\n  1385\t\tdefault:\n  1386\t\t\tpanic(fmt.Errorf(\"unrecognized log type: %#v\", l))\n  1387\t\t}\n  1388\t\n  1389\t\treturn nil\n  1390\t}\n  1391\t\n  1392\t// tryStageCommitIndex updates the commit index in persist store if restore committed logs is enabled and log store implements CommitTrackingLogStore.\n  1393\tfunc (r *Raft) tryStageCommitIndex(commitIndex uint64) {\n  1394\t\tif !r.RestoreCommittedLogs {\n  1395\t\t\treturn\n  1396\t\t}\n  1397\t\tstore, ok := r.logs.(CommitTrackingLogStore)\n  1398\t\tif !ok {\n  1399\t\t\treturn\n  1400\t\t}\n  1401\t\tif err := store.StageCommitIndex(commitIndex); err != nil {\n  1402\t\t\tr.logger.Error(\"failed to stage commit index in commit tracking log store\", \"index\", commitIndex, \"error\", err)\n  1403\t\t}\n  1404\t}\n  1405\t\n  1406\t// processRPC is called to handle an incoming RPC request. This must only be\n  1407\t// called from the main thread.\n  1408\tfunc (r *Raft) processRPC(rpc RPC) {\n  1409\t\tif err := r.checkRPCHeader(rpc); err != nil {\n  1410\t\t\trpc.Respond(nil, err)\n  1411\t\t\treturn\n  1412\t\t}\n  1413\t\n  1414\t\tswitch cmd := rpc.Command.(type) {\n  1415\t\tcase *AppendEntriesRequest:\n  1416\t\t\tr.appendEntries(rpc, cmd)\n  1417\t\tcase *RequestVoteRequest:\n  1418\t\t\tr.requestVote(rpc, cmd)\n  1419\t\tcase *RequestPreVoteRequest:\n  1420\t\t\tr.requestPreVote(rpc, cmd)\n  1421\t\tcase *InstallSnapshotRequest:\n  1422\t\t\tr.installSnapshot(rpc, cmd)\n  1423\t\tcase *TimeoutNowRequest:\n  1424\t\t\tr.timeoutNow(rpc, cmd)\n  1425\t\tdefault:\n  1426\t\t\tr.logger.Error(\"got unexpected command\",\n  1427\t\t\t\t\"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1428\t\n  1429\t\t\trpc.Respond(nil, errors.New(rpcUnexpectedCommandError))\n  1430\t\t}\n  1431\t}\n  1432\t\n  1433\t// processHeartbeat is a special handler used just for heartbeat requests\n  1434\t// so that they can be fast-pathed if a transport supports it. This must only\n  1435\t// be called from the main thread.\n  1436\tfunc (r *Raft) processHeartbeat(rpc RPC) {\n  1437\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"processHeartbeat\"}, time.Now())\n  1438\t\n  1439\t\t// Check if we are shutdown, just ignore the RPC\n  1440\t\tselect {\n  1441\t\tcase <-r.shutdownCh:\n  1442\t\t\treturn\n  1443\t\tdefault:\n  1444\t\t}\n  1445\t\n  1446\t\t// Ensure we are only handling a heartbeat\n  1447\t\tswitch cmd := rpc.Command.(type) {\n  1448\t\tcase *AppendEntriesRequest:\n  1449\t\t\tr.appendEntries(rpc, cmd)\n  1450\t\tdefault:\n  1451\t\t\tr.logger.Error(\"expected heartbeat, got\", \"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1452\t\t\trpc.Respond(nil, fmt.Errorf(\"unexpected command\"))\n  1453\t\t}\n  1454\t}\n  1455\t\n  1456\t// appendEntries is invoked when we get an append entries RPC call. This must\n  1457\t// only be called from the main thread.\n  1458\tfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n  1459\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n  1460\t\t// Setup a response\n  1461\t\tresp := &AppendEntriesResponse{\n  1462\t\t\tRPCHeader:      r.getRPCHeader(),\n  1463\t\t\tTerm:           r.getCurrentTerm(),\n  1464\t\t\tLastLog:        r.getLastIndex(),\n  1465\t\t\tSuccess:        false,\n  1466\t\t\tNoRetryBackoff: false,\n  1467\t\t}\n  1468\t\tvar rpcErr error\n  1469\t\tdefer func() {\n  1470\t\t\trpc.Respond(resp, rpcErr)\n====\n  1700\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n  1701\t\tif len(req.ID) > 0 {\n  1702\t\t\tcandidateID := ServerID(req.ID)\n  1703\t\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1704\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n  1705\t\t\t\treturn\n  1706\t\t\t}\n  1707\t\t}\n  1708\t\t// Check if we have voted yet\n  1709\t\tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n  1710\t\tif err != nil && err.Error() != \"not found\" {\n  1711\t\t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n  1712\t\t\treturn\n  1713\t\t}\n  1714\t\tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n  1715\t\tif err != nil && err.Error() != \"not found\" {\n  1716\t\t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n  1717\t\t\treturn\n  1718\t\t}\n  1719\t\n  1720\t\t// Check if we've voted in this election before\n  1721\t\tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n  1722\t\t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n  1723\t\t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n  1724\t\t\t\tr.logger.Warn(\"duplicate requestVote from\", \"candidate\", candidate)\n  1725\t\t\t\tresp.Granted = true\n  1726\t\t\t}\n  1727\t\t\treturn\n  1728\t\t}\n  1729\t\n  1730\t\t// Reject if their term is older\n  1731\t\tlastIdx, lastTerm := r.getLastEntry()\n  1732\t\tif lastTerm > req.LastLogTerm {\n  1733\t\t\tr.logger.Warn(\"rejecting vote request since our last term is greater\",\n  1734\t\t\t\t\"candidate\", candidate,\n  1735\t\t\t\t\"last-term\", lastTerm,\n  1736\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1737\t\t\treturn\n  1738\t\t}\n  1739\t\n  1740\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1741\t\t\tr.logger.Warn(\"rejecting vote request since our last index is greater\",\n  1742\t\t\t\t\"candidate\", candidate,\n  1743\t\t\t\t\"last-index\", lastIdx,\n  1744\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1745\t\t\treturn\n  1746\t\t}\n  1747\t\n  1748\t\t// Persist a vote for safety\n  1749\t\tif err := r.persistVote(req.Term, candidateBytes); err != nil {\n  1750\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  1751\t\t\treturn\n  1752\t\t}\n  1753\t\n  1754\t\tresp.Granted = true\n  1755\t\tr.setLastContact()\n  1756\t}\n  1757\t\n  1758\t// requestPreVote is invoked when we get a request Pre-Vote RPC call.\n  1759\tfunc (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n  1760\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestPreVote\"}, time.Now())\n  1761\t\tr.observe(*req)\n  1762\t\n  1763\t\t// Setup a response\n  1764\t\tresp := &RequestPreVoteResponse{\n  1765\t\t\tRPCHeader: r.getRPCHeader(),\n  1766\t\t\tTerm:      r.getCurrentTerm(),\n  1767\t\t\tGranted:   false,\n  1768\t\t}\n  1769\t\tvar rpcErr error\n  1770\t\tdefer func() {\n  1771\t\t\trpc.Respond(resp, rpcErr)\n  1772\t\t}()\n  1773\t\n  1774\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1775\t\tcandidate := r.trans.DecodePeer(req.GetRPCHeader().Addr)\n  1776\t\tcandidateID := ServerID(req.ID)\n  1777\t\n  1778\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1779\t\t// Grant the vote\n  1780\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1781\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not in configuration\",\n  1782\t\t\t\t\"from\", candidate)\n  1783\t\t\treturn\n  1784\t\t}\n  1785\t\n  1786\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate {\n  1787\t\t\tr.logger.Warn(\"rejecting pre-vote request since we have a leader\",\n  1788\t\t\t\t\"from\", candidate,\n  1789\t\t\t\t\"leader\", leaderAddr,\n  1790\t\t\t\t\"leader-id\", string(leaderID))\n  1791\t\t\treturn\n  1792\t\t}\n  1793\t\n  1794\t\t// Ignore an older term\n  1795\t\tif req.Term < r.getCurrentTerm() {\n  1796\t\t\treturn\n  1797\t\t}\n  1798\t\n  1799\t\tif req.Term > r.getCurrentTerm() {\n  1800\t\t\t// continue processing here to possibly grant the pre-vote as in a \"real\" vote this will transition us to follower\n  1801\t\t\tr.logger.Debug(\"received a requestPreVote with a newer term, grant the pre-vote\")\n  1802\t\t\tresp.Term = req.Term\n  1803\t\t}\n  1804\t\n  1805\t\t// if we get a request for a pre-vote from a nonVoter  and the request term is higher, do not grant the Pre-Vote\n  1806\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1807\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1808\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not a voter\", \"from\", candidate)\n  1809\t\t\treturn\n  1810\t\t}\n  1811\t\n  1812\t\t// Reject if their term is older\n  1813\t\tlastIdx, lastTerm := r.getLastEntry()\n  1814\t\tif lastTerm > req.LastLogTerm {\n  1815\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last term is greater\",\n  1816\t\t\t\t\"candidate\", candidate,\n  1817\t\t\t\t\"last-term\", lastTerm,\n  1818\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1819\t\t\treturn\n  1820\t\t}\n  1821\t\n  1822\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1823\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last index is greater\",\n  1824\t\t\t\t\"candidate\", candidate,\n  1825\t\t\t\t\"last-index\", lastIdx,\n  1826\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1827\t\t\treturn\n  1828\t\t}\n  1829\t\n  1830\t\tresp.Granted = true\n  1831\t}\n  1832\t\n  1833\t// installSnapshot is invoked when we get a InstallSnapshot RPC call.\n  1834\t// We must be in the follower state for this, since it means we are\n  1835\t// too far behind a leader for log replay. This must only be called\n  1836\t// from the main thread.\n  1837\tfunc (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n  1838\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"installSnapshot\"}, time.Now())\n  1839\t\t// Setup a response\n  1840\t\tresp := &InstallSnapshotResponse{\n  1841\t\t\tTerm:    r.getCurrentTerm(),\n  1842\t\t\tSuccess: false,\n  1843\t\t}\n  1844\t\tvar rpcErr error\n  1845\t\tdefer func() {\n  1846\t\t\t_, _ = io.Copy(io.Discard, rpc.Reader) // ensure we always consume all the snapshot data from the stream [see issue #212]\n  1847\t\t\trpc.Respond(resp, rpcErr)\n  1848\t\t}()\n  1849\t\n  1850\t\t// Sanity check the version\n  1851\t\tif req.SnapshotVersion < SnapshotVersionMin ||\n  1852\t\t\treq.SnapshotVersion > SnapshotVersionMax {\n  1853\t\t\trpcErr = fmt.Errorf(\"unsupported snapshot version %d\", req.SnapshotVersion)\n  1854\t\t\treturn\n  1855\t\t}\n  1856\t\n  1857\t\t// Ignore an older term\n  1858\t\tif req.Term < r.getCurrentTerm() {\n  1859\t\t\tr.logger.Info(\"ignoring installSnapshot request with older term than current term\",\n  1860\t\t\t\t\"request-term\", req.Term,\n  1861\t\t\t\t\"current-term\", r.getCurrentTerm())\n  1862\t\t\treturn\n  1863\t\t}\n  1864\t\n  1865\t\t// Increase the term if we see a newer one\n  1866\t\tif req.Term > r.getCurrentTerm() {\n  1867\t\t\t// Ensure transition to follower\n  1868\t\t\tr.setState(Follower)\n  1869\t\t\tr.setCurrentTerm(req.Term)\n  1870\t\t\tresp.Term = req.Term\n  1871\t\t}\n  1872\t\n  1873\t\t// Save the current leader\n  1874\t\tif len(req.ID) > 0 {\n  1875\t\t\tr.setLeader(r.trans.DecodePeer(req.Addr), ServerID(req.ID))\n  1876\t\t} else {\n  1877\t\t\tr.setLeader(r.trans.DecodePeer(req.Leader), ServerID(req.ID))\n  1878\t\t}\n  1879\t\n  1880\t\t// Create a new snapshot\n  1881\t\tvar reqConfiguration Configuration\n  1882\t\tvar reqConfigurationIndex uint64\n  1883\t\tif req.SnapshotVersion > 0 {\n  1884\t\t\treqConfiguration = DecodeConfiguration(req.Configuration)\n  1885\t\t\treqConfigurationIndex = req.ConfigurationIndex\n  1886\t\t} else {\n  1887\t\t\treqConfiguration, rpcErr = decodePeers(req.Peers, r.trans)\n  1888\t\t\tif rpcErr != nil {\n  1889\t\t\t\tr.logger.Error(\"failed to install snapshot\", \"error\", rpcErr)\n  1890\t\t\t\treturn\n  1891\t\t\t}\n  1892\t\t\treqConfigurationIndex = req.LastLogIndex\n  1893\t\t}\n  1894\t\tversion := getSnapshotVersion(r.protocolVersion)\n  1895\t\tsink, err := r.snapshots.Create(version, req.LastLogIndex, req.LastLogTerm,\n  1896\t\t\treqConfiguration, reqConfigurationIndex, r.trans)\n  1897\t\tif err != nil {\n  1898\t\t\tr.logger.Error(\"failed to create snapshot to install\", \"error\", err)\n  1899\t\t\trpcErr = fmt.Errorf(\"failed to create snapshot: %v\", err)\n  1900\t\t\treturn\n","exit_code":0,"status":"completed"}}
