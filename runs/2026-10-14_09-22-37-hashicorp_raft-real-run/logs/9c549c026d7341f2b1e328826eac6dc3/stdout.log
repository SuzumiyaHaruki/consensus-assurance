g is a property of our current pipelining\n    47\t\t// implementation and must not be changed unless we change the invariants of\n    48\t\t// that implementation. Roughly speaking even with a zero-length in-flight\n    49\t\t// buffer we still allow 2 requests to be in-flight before we block because we\n    50\t\t// only block after sending and the receiving go-routine always unblocks the\n    51\t\t// chan right after first send. This is a constant just to provide context\n    52\t\t// rather than a magic number in a few places we have to check invariants to\n    53\t\t// avoid panics etc.\n    54\t\tminInFlightForPipelining = 2\n    55\t)\n    56\t\n    57\tvar (\n    58\t\t// ErrTransportShutdown is returned when operations on a transport are\n    59\t\t// invoked after it's been terminated.\n    60\t\tErrTransportShutdown = errors.New(\"transport shutdown\")\n    61\t\n    62\t\t// ErrPipelineShutdown is returned when the pipeline is closed.\n    63\t\tErrPipelineShutdown = errors.New(\"append pipeline closed\")\n    64\t)\n    65\t\n    66\t// NetworkTransport provides a network based transport that can be\n    67\t// used to communicate with Raft on remote machines. It requires\n    68\t// an underlying stream layer to provide a stream abstraction, which can\n    69\t// be simple TCP, TLS, etc.\n    70\t//\n    71\t// This transport is very simple and lightweight. Each RPC request is\n    72\t// framed by sending a byte that indicates the message type, followed\n    73\t// by the MsgPack encoded request.\n    74\t//\n    75\t// The response is an error string followed by the response object,\n    76\t// both are encoded using MsgPack.\n    77\t//\n    78\t// InstallSnapshot is special, in that after the RPC request we stream\n    79\t// the entire state. That socket is not re-used as the connection state\n    80\t// is not known if there is an error.\n    81\ttype NetworkTransport struct {\n    82\t\tconnPool     map[ServerAddress][]*netConn\n    83\t\tconnPoolLock sync.Mutex\n    84\t\n    85\t\tconsumeCh chan RPC\n    86\t\n    87\t\theartbeatFn     func(RPC)\n    88\t\theartbeatFnLock sync.Mutex\n    89\t\n    90\t\tlogger hclog.Logger\n    91\t\n    92\t\tmaxPool     int\n    93\t\tmaxInFlight int\n    94\t\n    95\t\tserverAddressLock     sync.RWMutex\n    96\t\tserverAddressProvider ServerAddressProvider\n    97\t\n    98\t\tshutdown     bool\n    99\t\tshutdownCh   chan struct{}\n   100\t\tshutdownLock sync.Mutex\n   101\t\n   102\t\tstream StreamLayer\n   103\t\n   104\t\t// streamCtx is used to cancel existing connection handlers.\n   105\t\tstreamCtx     context.Context\n   106\t\tstreamCancel  context.CancelFunc\n   107\t\tstreamCtxLock sync.RWMutex\n   108\t\n   109\t\ttimeout      time.Duration\n   110\t\tTimeoutScale int\n   111\t\n   112\t\tmsgpackUseNewTimeFormat bool\n   113\t}\n   114\t\n   115\t// NetworkTransportConfig encapsulates configuration for the network transport layer.\n   116\ttype NetworkTransportConfig struct {\n   117\t\t// ServerAddressProvider is used to override the target address when establishing a connection to invoke an RPC\n   118\t\tServerAddressProvider ServerAddressProvider\n   119\t\n   120\t\tLogger hclog.Logger\n====\n9:\t\"errors\"\n58:\t// ErrTransportShutdown is returned when operations on a transport are\n60:\tErrTransportShutdown = errors.New(\"transport shutdown\")\n62:\t// ErrPipelineShutdown is returned when the pipeline is closed.\n63:\tErrPipelineShutdown = errors.New(\"append pipeline closed\")\n75:// The response is an error string followed by the response object,\n80:// is not known if there is an error.\n174:\tServerAddr(id ServerID) (ServerAddress, error)\n183:\tDial(address ServerAddress, timeout time.Duration) (net.Conn, error)\n194:func (n *netConn) Release() error {\n333:func (n *NetworkTransport) Close() error {\n383:func (n *NetworkTransport) getConnFromAddressProvider(id ServerID, target ServerAddress) (*netConn, error) {\n394:\t\t\tn.logger.Warn(\"un