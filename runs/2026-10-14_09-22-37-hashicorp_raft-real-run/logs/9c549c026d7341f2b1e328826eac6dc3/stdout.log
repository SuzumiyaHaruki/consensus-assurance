{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n saturation.go'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"math\"\n     8\t\t\"time\"\n     9\t\n    10\t\t\"github.com/hashicorp/go-metrics\"\n    11\t)\n    12\t\n    13\t// saturationMetric measures the saturation (percentage of time spent working vs\n    14\t// waiting for work) of an event processing loop, such as runFSM. It reports the\n    15\t// saturation as a gauge metric (at most) once every reportInterval.\n    16\t//\n    17\t// Callers must instrument their loop with calls to sleeping and working, starting\n    18\t// with a call to sleeping.\n    19\t//\n    20\t// Note: the caller must be single-threaded and saturationMetric is not safe for\n    21\t// concurrent use by multiple goroutines.\n    22\ttype saturationMetric struct {\n    23\t\treportInterval time.Duration\n    24\t\n    25\t\t// slept contains time for which the event processing loop was sleeping rather\n    26\t\t// than working in the period since lastReport.\n    27\t\tslept time.Duration\n    28\t\n    29\t\t// lost contains time that is considered lost due to incorrect use of\n    30\t\t// saturationMetricBucket (e.g. calling sleeping() or working() multiple\n    31\t\t// times in succession) in the period since lastReport.\n    32\t\tlost time.Duration\n    33\t\n    34\t\tlastReport, sleepBegan, workBegan time.Time\n    35\t\n    36\t\t// These are overwritten in tests.\n    37\t\tnowFn    func() time.Time\n    38\t\treportFn func(float32)\n    39\t}\n    40\t\n    41\t// newSaturationMetric creates a saturationMetric that will update the gauge\n    42\t// with the given name at the given reportInterval. keepPrev determines the\n    43\t// number of previous measurements that will be used to smooth out spikes.\n    44\tfunc newSaturationMetric(name []string, reportInterval time.Duration) *saturationMetric {\n    45\t\tm := &saturationMetric{\n    46\t\t\treportInterval: reportInterval,\n    47\t\t\tnowFn:          time.Now,\n    48\t\t\tlastReport:     time.Now(),\n    49\t\t\treportFn:       func(sat float32) { metrics.AddSample(name, sat) },\n    50\t\t}\n    51\t\treturn m\n    52\t}\n    53\t\n    54\t// sleeping records the time at which the loop began waiting for work. After the\n    55\t// initial call it must always be proceeded by a call to working.\n    56\tfunc (s *saturationMetric) sleeping() {\n    57\t\tnow := s.nowFn()\n    58\t\n    59\t\tif !s.sleepBegan.IsZero() {\n    60\t\t\t// sleeping called twice in succession. Count that time as lost rather than\n    61\t\t\t// measuring nonsense.\n    62\t\t\ts.lost += now.Sub(s.sleepBegan)\n    63\t\t}\n    64\t\n    65\t\ts.sleepBegan = now\n    66\t\ts.workBegan = time.Time{}\n    67\t\ts.report()\n    68\t}\n    69\t\n    70\t// working records the time at which the loop began working. It must always be\n    71\t// proceeded by a call to sleeping.\n    72\tfunc (s *saturationMetric) working() {\n    73\t\tnow := s.nowFn()\n    74\t\n    75\t\tif s.workBegan.IsZero() {\n    76\t\t\tif s.sleepBegan.IsZero() {\n    77\t\t\t\t// working called before the initial call to sleeping. Count that time as\n    78\t\t\t\t// lost rather than measuring nonsense.\n    79\t\t\t\ts.lost += now.Sub(s.lastReport)\n    80\t\t\t} else {\n    81\t\t\t\ts.slept += now.Sub(s.sleepBegan)\n    82\t\t\t}\n    83\t\t} else {\n    84\t\t\t// working called twice in succession. Count that time as lost rather than\n    85\t\t\t// measuring nonsense.\n    86\t\t\ts.lost += now.Sub(s.workBegan)\n    87\t\t}\n    88\t\n    89\t\ts.workBegan = now\n    90\t\ts.sleepBegan = time.Time{}\n    91\t\ts.report()\n    92\t}\n    93\t\n    94\t// report updates the gauge if reportInterval has passed since our last report.\n    95\tfunc (s *saturationMetric) report() {\n    96\t\tnow := s.nowFn()\n    97\t\ttimeSinceLastReport := now.Sub(s.lastReport)\n    98\t\n    99\t\tif timeSinceLastReport < s.reportInterval {\n   100\t\t\treturn\n   101\t\t}\n   102\t\n   103\t\tvar saturation float64\n   104\t\ttotal := timeSinceLastReport - s.lost\n   105\t\tif total != 0 {\n   106\t\t\tsaturation = float64(total-s.slept) / float64(total)\n   107\t\t\tsaturation = math.Round(saturation*100) / 100\n   108\t\t}\n   109\t\ts.reportFn(float32(saturation))\n   110\t\n   111\t\ts.slept = 0\n   112\t\ts.lost = 0\n   113\t\ts.lastReport = now\n   114\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '200,560p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '200,560p'\"","aggregated_output":"   200\t\t\t\tr.mainThreadSaturation.working()\n   201\t\t\t\tc.configurations = r.configurations.Clone()\n   202\t\t\t\tc.respond(nil)\n   203\t\n   204\t\t\tcase b := <-r.bootstrapCh:\n   205\t\t\t\tr.mainThreadSaturation.working()\n   206\t\t\t\tb.respond(r.liveBootstrap(b.configuration))\n   207\t\n   208\t\t\tcase <-r.leaderNotifyCh:\n   209\t\t\t\t//  Ignore since we are not the leader\n   210\t\n   211\t\t\tcase <-r.followerNotifyCh:\n   212\t\t\t\theartbeatTimer = time.After(0)\n   213\t\n   214\t\t\tcase <-heartbeatTimer:\n   215\t\t\t\tr.mainThreadSaturation.working()\n   216\t\t\t\t// Restart the heartbeat timer\n   217\t\t\t\thbTimeout := r.config().HeartbeatTimeout\n   218\t\t\t\theartbeatTimer = randomTimeout(hbTimeout)\n   219\t\n   220\t\t\t\t// Check if we have had a successful contact\n   221\t\t\t\tlastContact := r.LastContact()\n   222\t\t\t\tif time.Since(lastContact) < hbTimeout {\n   223\t\t\t\t\tcontinue\n   224\t\t\t\t}\n   225\t\n   226\t\t\t\t// Heartbeat failed! Transition to the candidate state\n   227\t\t\t\tlastLeaderAddr, lastLeaderID := r.LeaderWithID()\n   228\t\t\t\tr.setLeader(\"\", \"\")\n   229\t\n   230\t\t\t\tif r.configurations.latestIndex == 0 {\n   231\t\t\t\t\tif !didWarn {\n   232\t\t\t\t\t\tr.logger.Warn(\"no known peers, aborting election\")\n   233\t\t\t\t\t\tdidWarn = true\n   234\t\t\t\t\t}\n   235\t\t\t\t} else if r.configurations.latestIndex == r.configurations.committedIndex &&\n   236\t\t\t\t\t!hasVote(r.configurations.latest, r.localID) {\n   237\t\t\t\t\tif !didWarn {\n   238\t\t\t\t\t\tr.logger.Warn(\"not part of stable configuration, aborting election\")\n   239\t\t\t\t\t\tdidWarn = true\n   240\t\t\t\t\t}\n   241\t\t\t\t} else {\n   242\t\t\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"heartbeat_timeout\"}, 1)\n   243\t\t\t\t\tif hasVote(r.configurations.latest, r.localID) {\n   244\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, starting election\", \"last-leader-addr\", lastLeaderAddr, \"last-leader-id\", lastLeaderID)\n   245\t\t\t\t\t\tr.setState(Candidate)\n   246\t\t\t\t\t\treturn\n   247\t\t\t\t\t} else if !didWarn {\n   248\t\t\t\t\t\tr.logger.Warn(\"heartbeat timeout reached, not part of a stable configuration or a non-voter, not triggering a leader election\")\n   249\t\t\t\t\t\tdidWarn = true\n   250\t\t\t\t\t}\n   251\t\t\t\t}\n   252\t\n   253\t\t\tcase <-r.shutdownCh:\n   254\t\t\t\treturn\n   255\t\t\t}\n   256\t\t}\n   257\t}\n   258\t\n   259\t// liveBootstrap attempts to seed an initial configuration for the cluster. See\n   260\t// the Raft object's member BootstrapCluster for more details. This must only be\n   261\t// called on the main thread, and only makes sense in the follower state.\n   262\tfunc (r *Raft) liveBootstrap(configuration Configuration) error {\n   263\t\tif !hasVote(configuration, r.localID) {\n   264\t\t\t// Reject this operation since we are not a voter\n   265\t\t\treturn ErrNotVoter\n   266\t\t}\n   267\t\n   268\t\t// Use the pre-init API to make the static updates.\n   269\t\tcfg := r.config()\n   270\t\terr := BootstrapCluster(&cfg, r.logs, r.stable, r.snapshots, r.trans, configuration)\n   271\t\tif err != nil {\n   272\t\t\treturn err\n   273\t\t}\n   274\t\n   275\t\t// Make the configuration live.\n   276\t\tvar entry Log\n   277\t\tif err := r.logs.GetLog(1, &entry); err != nil {\n   278\t\t\tpanic(err)\n   279\t\t}\n   280\t\tr.setCurrentTerm(1)\n   281\t\tr.setLastLog(entry.Index, entry.Term)\n   282\t\treturn r.processConfigurationLogEntry(&entry)\n   283\t}\n   284\t\n   285\t// runCandidate runs the main loop while in the candidate state.\n   286\tfunc (r *Raft) runCandidate() {\n   287\t\tterm := r.getCurrentTerm() + 1\n   288\t\tr.logger.Info(\"entering candidate state\", \"node\", r, \"term\", term)\n   289\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"candidate\"}, 1)\n   290\t\n   291\t\t// Start vote for us, and set a timeout\n   292\t\tvar voteCh <-chan *voteResult\n   293\t\tvar prevoteCh <-chan *preVoteResult\n   294\t\n   295\t\t// check if pre-vote is active and that this is not a leader transfer.\n   296\t\t// Leader transfer do not perform prevote by design\n   297\t\tif !r.preVoteDisabled && !r.candidateFromLeadershipTransfer.Load() {\n   298\t\t\tprevoteCh = r.preElectSelf()\n   299\t\t} else {\n   300\t\t\tvoteCh = r.electSelf()\n   301\t\t}\n   302\t\n   303\t\t// Make sure the leadership transfer flag is reset after each run. Having this\n   304\t\t// flag will set the field LeadershipTransfer in a RequestVoteRequest to true,\n   305\t\t// which will make other servers vote even though they have a leader already.\n   306\t\t// It is important to reset that flag, because this privilege could be abused\n   307\t\t// otherwise.\n   308\t\tdefer func() { r.candidateFromLeadershipTransfer.Store(false) }()\n   309\t\n   310\t\telectionTimeout := r.config().ElectionTimeout\n   311\t\telectionTimer := randomTimeout(electionTimeout)\n   312\t\n   313\t\t// Tally the votes, need a simple majority\n   314\t\tpreVoteGrantedVotes := 0\n   315\t\tpreVoteRefusedVotes := 0\n   316\t\tgrantedVotes := 0\n   317\t\tvotesNeeded := r.quorumSize()\n   318\t\tr.logger.Debug(\"calculated votes needed\", \"needed\", votesNeeded, \"term\", term)\n   319\t\n   320\t\tfor r.getState() == Candidate {\n   321\t\t\tr.mainThreadSaturation.sleeping()\n   322\t\n   323\t\t\tselect {\n   324\t\t\tcase rpc := <-r.rpcCh:\n   325\t\t\t\tr.mainThreadSaturation.working()\n   326\t\t\t\tr.processRPC(rpc)\n   327\t\t\tcase preVote := <-prevoteCh:\n   328\t\t\t\t// This a pre-vote case it should trigger a \"real\" election if the pre-vote is won.\n   329\t\t\t\tr.mainThreadSaturation.working()\n   330\t\t\t\tr.logger.Debug(\"pre-vote received\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   331\t\t\t\t// Check if the term is greater than ours, bail\n   332\t\t\t\tif preVote.Term > term {\n   333\t\t\t\t\tr.logger.Debug(\"pre-vote denied: found newer term, falling back to follower\", \"term\", preVote.Term)\n   334\t\t\t\t\tr.setState(Follower)\n   335\t\t\t\t\tr.setCurrentTerm(preVote.Term)\n   336\t\t\t\t\treturn\n   337\t\t\t\t}\n   338\t\n   339\t\t\t\t// Check if the preVote is granted\n   340\t\t\t\tif preVote.Granted {\n   341\t\t\t\t\tpreVoteGrantedVotes++\n   342\t\t\t\t\tr.logger.Debug(\"pre-vote granted\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   343\t\t\t\t} else {\n   344\t\t\t\t\tpreVoteRefusedVotes++\n   345\t\t\t\t\tr.logger.Debug(\"pre-vote denied\", \"from\", preVote.voterID, \"term\", preVote.Term, \"tally\", preVoteGrantedVotes)\n   346\t\t\t\t}\n   347\t\n   348\t\t\t\t// Check if we've won the pre-vote and proceed to election if so\n   349\t\t\t\tif preVoteGrantedVotes >= votesNeeded {\n   350\t\t\t\t\tr.logger.Info(\"pre-vote successful, starting election\", \"term\", preVote.Term,\n   351\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   352\t\t\t\t\tpreVoteGrantedVotes = 0\n   353\t\t\t\t\tpreVoteRefusedVotes = 0\n   354\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   355\t\t\t\t\tprevoteCh = nil\n   356\t\t\t\t\tvoteCh = r.electSelf()\n   357\t\t\t\t}\n   358\t\t\t\t// Check if we've lost the pre-vote and wait for the election to timeout so we can do another time of\n   359\t\t\t\t// prevote.\n   360\t\t\t\tif preVoteRefusedVotes >= votesNeeded {\n   361\t\t\t\t\tr.logger.Info(\"pre-vote campaign failed, waiting for election timeout\", \"term\", preVote.Term,\n   362\t\t\t\t\t\t\"tally\", preVoteGrantedVotes, \"refused\", preVoteRefusedVotes, \"votesNeeded\", votesNeeded)\n   363\t\t\t\t}\n   364\t\t\tcase vote := <-voteCh:\n   365\t\t\t\tr.mainThreadSaturation.working()\n   366\t\t\t\t// Check if the term is greater than ours, bail\n   367\t\t\t\tif vote.Term > r.getCurrentTerm() {\n   368\t\t\t\t\tr.logger.Debug(\"newer term discovered, fallback to follower\", \"term\", vote.Term)\n   369\t\t\t\t\tr.setState(Follower)\n   370\t\t\t\t\tr.setCurrentTerm(vote.Term)\n   371\t\t\t\t\treturn\n   372\t\t\t\t}\n   373\t\n   374\t\t\t\t// Check if the vote is granted\n   375\t\t\t\tif vote.Granted {\n   376\t\t\t\t\tgrantedVotes++\n   377\t\t\t\t\tr.logger.Debug(\"vote granted\", \"from\", vote.voterID, \"term\", vote.Term, \"tally\", grantedVotes)\n   378\t\t\t\t}\n   379\t\n   380\t\t\t\t// Check if we've become the leader\n   381\t\t\t\tif grantedVotes >= votesNeeded {\n   382\t\t\t\t\tr.logger.Info(\"election won\", \"term\", vote.Term, \"tally\", grantedVotes)\n   383\t\t\t\t\tr.setState(Leader)\n   384\t\t\t\t\tr.setLeader(r.localAddr, r.localID)\n   385\t\t\t\t\treturn\n   386\t\t\t\t}\n   387\t\t\tcase c := <-r.configurationChangeCh:\n   388\t\t\t\tr.mainThreadSaturation.working()\n   389\t\t\t\t// Reject any operations since we are not the leader\n   390\t\t\t\tc.respond(ErrNotLeader)\n   391\t\n   392\t\t\tcase a := <-r.applyCh:\n   393\t\t\t\tr.mainThreadSaturation.working()\n   394\t\t\t\t// Reject any operations since we are not the leader\n   395\t\t\t\ta.respond(ErrNotLeader)\n   396\t\n   397\t\t\tcase v := <-r.verifyCh:\n   398\t\t\t\tr.mainThreadSaturation.working()\n   399\t\t\t\t// Reject any operations since we are not the leader\n   400\t\t\t\tv.respond(ErrNotLeader)\n   401\t\n   402\t\t\tcase ur := <-r.userRestoreCh:\n   403\t\t\t\tr.mainThreadSaturation.working()\n   404\t\t\t\t// Reject any restores since we are not the leader\n   405\t\t\t\tur.respond(ErrNotLeader)\n   406\t\n   407\t\t\tcase l := <-r.leadershipTransferCh:\n   408\t\t\t\tr.mainThreadSaturation.working()\n   409\t\t\t\t// Reject any operations since we are not the leader\n   410\t\t\t\tl.respond(ErrNotLeader)\n   411\t\n   412\t\t\tcase c := <-r.configurationsCh:\n   413\t\t\t\tr.mainThreadSaturation.working()\n   414\t\t\t\tc.configurations = r.configurations.Clone()\n   415\t\t\t\tc.respond(nil)\n   416\t\n   417\t\t\tcase b := <-r.bootstrapCh:\n   418\t\t\t\tr.mainThreadSaturation.working()\n   419\t\t\t\tb.respond(ErrCantBootstrap)\n   420\t\n   421\t\t\tcase <-r.leaderNotifyCh:\n   422\t\t\t\t//  Ignore since we are not the leader\n   423\t\n   424\t\t\tcase <-r.followerNotifyCh:\n   425\t\t\t\tif electionTimeout != r.config().ElectionTimeout {\n   426\t\t\t\t\telectionTimeout = r.config().ElectionTimeout\n   427\t\t\t\t\telectionTimer = randomTimeout(electionTimeout)\n   428\t\t\t\t}\n   429\t\n   430\t\t\tcase <-electionTimer:\n   431\t\t\t\tr.mainThreadSaturation.working()\n   432\t\t\t\t// Election failed! Restart the election. We simply return,\n   433\t\t\t\t// which will kick us back into runCandidate\n   434\t\t\t\tr.logger.Warn(\"Election timeout reached, restarting election\")\n   435\t\t\t\treturn\n   436\t\n   437\t\t\tcase <-r.shutdownCh:\n   438\t\t\t\treturn\n   439\t\t\t}\n   440\t\t}\n   441\t}\n   442\t\n   443\tfunc (r *Raft) setLeadershipTransferInProgress(v bool) {\n   444\t\tif v {\n   445\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 1)\n   446\t\t} else {\n   447\t\t\tatomic.StoreInt32(&r.leaderState.leadershipTransferInProgress, 0)\n   448\t\t}\n   449\t}\n   450\t\n   451\tfunc (r *Raft) getLeadershipTransferInProgress() bool {\n   452\t\tv := atomic.LoadInt32(&r.leaderState.leadershipTransferInProgress)\n   453\t\treturn v == 1\n   454\t}\n   455\t\n   456\tfunc (r *Raft) setupLeaderState() {\n   457\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n   458\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n   459\t\t\tr.configurations.latest,\n   460\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n   461\t\tr.leaderState.inflight = list.New()\n   462\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n   463\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n   464\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n   465\t}\n   466\t\n   467\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n   468\t// the leaderLoop for the hot loop.\n   469\tfunc (r *Raft) runLeader() {\n   470\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   471\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n   472\t\n   473\t\t// Notify that we are the leader\n   474\t\toverrideNotifyBool(r.leaderCh, true)\n   475\t\n   476\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n   477\t\t// defer below runs, but this makes sure we always notify the same chan if\n   478\t\t// ever for both gaining and losing leadership.\n   479\t\tnotify := r.config().NotifyCh\n   480\t\n   481\t\t// Push to the notify channel if given\n   482\t\tif notify != nil {\n   483\t\t\tselect {\n   484\t\t\tcase notify <- true:\n   485\t\t\tcase <-r.shutdownCh:\n   486\t\t\t\t// make sure push to the notify channel ( if given )\n   487\t\t\t\tselect {\n   488\t\t\t\tcase notify <- true:\n   489\t\t\t\tdefault:\n   490\t\t\t\t}\n   491\t\t\t}\n   492\t\t}\n   493\t\n   494\t\t// setup leader state. This is only supposed to be accessed within the\n   495\t\t// leaderloop.\n   496\t\tr.setupLeaderState()\n   497\t\n   498\t\t// Run a background go-routine to emit metrics on log age\n   499\t\tstopCh := make(chan struct{})\n   500\t\tgo emitLogStoreMetrics(r.logs, []string{\"raft\", \"leader\"}, oldestLogGaugeInterval, stopCh)\n   501\t\n   502\t\t// Cleanup state on step down\n   503\t\tdefer func() {\n   504\t\t\tclose(stopCh)\n   505\t\n   506\t\t\t// Since we were the leader previously, we update our\n   507\t\t\t// last contact time when we step down, so that we are not\n   508\t\t\t// reporting a last contact time from before we were the\n   509\t\t\t// leader. Otherwise, to a client it would seem our data\n   510\t\t\t// is extremely stale.\n   511\t\t\tr.setLastContact()\n   512\t\n   513\t\t\t// Stop replication\n   514\t\t\tfor _, p := range r.leaderState.replState {\n   515\t\t\t\tclose(p.stopCh)\n   516\t\t\t}\n   517\t\n   518\t\t\t// Respond to all inflight operations\n   519\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   520\t\t\t\te.Value.(*logFuture).respond(ErrLeadershipLost)\n   521\t\t\t}\n   522\t\n   523\t\t\t// Respond to any pending verify requests\n   524\t\t\tfor future := range r.leaderState.notify {\n   525\t\t\t\tfuture.respond(ErrLeadershipLost)\n   526\t\t\t}\n   527\t\n   528\t\t\t// Clear all the state\n   529\t\t\tr.leaderState.commitCh = nil\n   530\t\t\tr.leaderState.commitment = nil\n   531\t\t\tr.leaderState.inflight = nil\n   532\t\t\tr.leaderState.replState = nil\n   533\t\t\tr.leaderState.notify = nil\n   534\t\t\tr.leaderState.stepDown = nil\n   535\t\n   536\t\t\t// If we are stepping down for some reason, no known leader.\n   537\t\t\t// We may have stepped down due to an RPC call, which would\n   538\t\t\t// provide the leader, so we cannot always blank this out.\n   539\t\t\tr.leaderLock.Lock()\n   540\t\t\tif r.leaderAddr == r.localAddr && r.leaderID == r.localID {\n   541\t\t\t\tr.leaderAddr = \"\"\n   542\t\t\t\tr.leaderID = \"\"\n   543\t\t\t}\n   544\t\t\tr.leaderLock.Unlock()\n   545\t\n   546\t\t\t// Notify that we are not the leader\n   547\t\t\toverrideNotifyBool(r.leaderCh, false)\n   548\t\n   549\t\t\t// Push to the notify channel if given\n   550\t\t\tif notify != nil {\n   551\t\t\t\tselect {\n   552\t\t\t\tcase notify <- false:\n   553\t\t\t\tcase <-r.shutdownCh:\n   554\t\t\t\t\t// On shutdown, make a best effort but do not block\n   555\t\t\t\t\tselect {\n   556\t\t\t\t\tcase notify <- false:\n   557\t\t\t\t\tdefault:\n   558\t\t\t\t\t}\n   559\t\t\t\t}\n   560\t\t\t}\n","exit_code":0,"status":"completed"}}
