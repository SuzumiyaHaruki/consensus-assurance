{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '900,1180p'\"","aggregated_output":"   900\t\t\t\tr.appendConfigurationEntry(future)\n   901\t\n   902\t\t\tcase b := <-r.bootstrapCh:\n   903\t\t\t\tr.mainThreadSaturation.working()\n   904\t\t\t\tb.respond(ErrCantBootstrap)\n   905\t\n   906\t\t\tcase newLog := <-r.applyCh:\n   907\t\t\t\tr.mainThreadSaturation.working()\n   908\t\t\t\tif r.getLeadershipTransferInProgress() {\n   909\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   910\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n   911\t\t\t\t\tcontinue\n   912\t\t\t\t}\n   913\t\t\t\t// Group commit, gather all the ready commits\n   914\t\t\t\tready := []*logFuture{newLog}\n   915\t\t\tGROUP_COMMIT_LOOP:\n   916\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n   917\t\t\t\t\tselect {\n   918\t\t\t\t\tcase newLog := <-r.applyCh:\n   919\t\t\t\t\t\tready = append(ready, newLog)\n   920\t\t\t\t\tdefault:\n   921\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n   922\t\t\t\t\t}\n   923\t\t\t\t}\n   924\t\n   925\t\t\t\t// Dispatch the logs\n   926\t\t\t\tif stepDown {\n   927\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n   928\t\t\t\t\tfor i := range ready {\n   929\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n   930\t\t\t\t\t}\n   931\t\t\t\t} else {\n   932\t\t\t\t\tr.dispatchLogs(ready)\n   933\t\t\t\t}\n   934\t\n   935\t\t\tcase <-lease:\n   936\t\t\t\tr.mainThreadSaturation.working()\n   937\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n   938\t\t\t\tmaxDiff := r.checkLeaderLease()\n   939\t\n   940\t\t\t\t// Next check interval should adjust for the last node we've\n   941\t\t\t\t// contacted, without going negative\n   942\t\t\t\tcheckInterval := r.config().LeaderLeaseTimeout - maxDiff\n   943\t\t\t\tif checkInterval < minCheckInterval {\n   944\t\t\t\t\tcheckInterval = minCheckInterval\n   945\t\t\t\t}\n   946\t\n   947\t\t\t\t// Renew the lease timer\n   948\t\t\t\tlease = time.After(checkInterval)\n   949\t\n   950\t\t\tcase <-r.leaderNotifyCh:\n   951\t\t\t\tfor _, repl := range r.leaderState.replState {\n   952\t\t\t\t\tasyncNotifyCh(repl.notifyCh)\n   953\t\t\t\t}\n   954\t\n   955\t\t\tcase <-r.followerNotifyCh:\n   956\t\t\t\t//  Ignore since we are not a follower\n   957\t\n   958\t\t\tcase <-r.shutdownCh:\n   959\t\t\t\treturn\n   960\t\t\t}\n   961\t\t}\n   962\t}\n   963\t\n   964\t// verifyLeader must be called from the main thread for safety.\n   965\t// Causes the followers to attempt an immediate heartbeat.\n   966\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   967\t\t// Current leader always votes for self\n   968\t\tv.votes = 1\n   969\t\n   970\t\t// Set the quorum size, hot-path for single node\n   971\t\tv.quorumSize = r.quorumSize()\n   972\t\tif v.quorumSize == 1 {\n   973\t\t\tv.respond(nil)\n   974\t\t\treturn\n   975\t\t}\n   976\t\n   977\t\t// Track this request\n   978\t\tv.notifyCh = r.verifyCh\n   979\t\tr.leaderState.notify[v] = struct{}{}\n   980\t\n   981\t\t// Trigger immediate heartbeats\n   982\t\tfor _, repl := range r.leaderState.replState {\n   983\t\t\trepl.notifyLock.Lock()\n   984\t\t\trepl.notify[v] = struct{}{}\n   985\t\t\trepl.notifyLock.Unlock()\n   986\t\t\tasyncNotifyCh(repl.notifyCh)\n   987\t\t}\n   988\t}\n   989\t\n   990\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   991\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   992\t\t// make sure we are not already stopped\n   993\t\tselect {\n   994\t\tcase <-stopCh:\n   995\t\t\tdoneCh <- nil\n   996\t\t\treturn\n   997\t\tdefault:\n   998\t\t}\n   999\t\n  1000\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n  1001\t\t\terr := &deferError{}\n  1002\t\t\terr.init()\n  1003\t\t\trepl.triggerDeferErrorCh <- err\n  1004\t\t\tselect {\n  1005\t\t\tcase err := <-err.errCh:\n  1006\t\t\t\tif err != nil {\n  1007\t\t\t\t\tdoneCh <- err\n  1008\t\t\t\t\treturn\n  1009\t\t\t\t}\n  1010\t\t\tcase <-stopCh:\n  1011\t\t\t\tdoneCh <- nil\n  1012\t\t\t\treturn\n  1013\t\t\t}\n  1014\t\t}\n  1015\t\n  1016\t\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n  1017\t\t// messaging for read-only queries. If this is implemented, the lease\n  1018\t\t// has to be reset as well, in case leadership is transferred. This\n  1019\t\t// implementation also has a lease, but it serves another purpose and\n  1020\t\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n  1021\t\t// setup in a similar way to the one in the thesis, but in practice\n  1022\t\t// it's a timer that just tells the leader how often to check\n  1023\t\t// heartbeats are still coming in.\n  1024\t\n  1025\t\t// Step 3: send TimeoutNow message to target server.\n  1026\t\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n  1027\t\tif err != nil {\n  1028\t\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n  1029\t\t}\n  1030\t\tdoneCh <- err\n  1031\t}\n  1032\t\n  1033\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n  1034\t// within the last leader lease interval. If not, we need to step down,\n  1035\t// as we may have lost connectivity. Returns the maximum duration without\n  1036\t// contact. This must only be called from the main thread.\n  1037\tfunc (r *Raft) checkLeaderLease() time.Duration {\n  1038\t\t// Track contacted nodes, we can always contact ourself\n  1039\t\tcontacted := 0\n  1040\t\n  1041\t\t// Store lease timeout for this one check invocation as we need to refer to it\n  1042\t\t// in the loop and would be confusing if it ever becomes reloadable and\n  1043\t\t// changes between iterations below.\n  1044\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n  1045\t\n  1046\t\t// Check each follower\n  1047\t\tvar maxDiff time.Duration\n  1048\t\tnow := time.Now()\n  1049\t\tfor _, server := range r.configurations.latest.Servers {\n  1050\t\t\tif server.Suffrage == Voter {\n  1051\t\t\t\tif server.ID == r.localID {\n  1052\t\t\t\t\tcontacted++\n  1053\t\t\t\t\tcontinue\n  1054\t\t\t\t}\n  1055\t\t\t\tf := r.leaderState.replState[server.ID]\n  1056\t\t\t\tdiff := now.Sub(f.LastContact())\n  1057\t\t\t\tif diff <= leaseTimeout {\n  1058\t\t\t\t\tcontacted++\n  1059\t\t\t\t\tif diff > maxDiff {\n  1060\t\t\t\t\t\tmaxDiff = diff\n  1061\t\t\t\t\t}\n  1062\t\t\t\t} else {\n  1063\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n  1064\t\t\t\t\tif diff <= 3*leaseTimeout {\n  1065\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1066\t\t\t\t\t} else {\n  1067\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1068\t\t\t\t\t}\n  1069\t\t\t\t}\n  1070\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n  1071\t\t\t}\n  1072\t\t}\n  1073\t\n  1074\t\t// Verify we can contact a quorum\n  1075\t\tquorum := r.quorumSize()\n  1076\t\tif contacted < quorum {\n  1077\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n  1078\t\t\tr.setState(Follower)\n  1079\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n  1080\t\t}\n  1081\t\treturn maxDiff\n  1082\t}\n  1083\t\n  1084\t// quorumSize is used to return the quorum size. This must only be called on\n  1085\t// the main thread.\n  1086\t// TODO: revisit usage\n  1087\tfunc (r *Raft) quorumSize() int {\n  1088\t\tvoters := 0\n  1089\t\tfor _, server := range r.configurations.latest.Servers {\n  1090\t\t\tif server.Suffrage == Voter {\n  1091\t\t\t\tvoters++\n  1092\t\t\t}\n  1093\t\t}\n  1094\t\treturn voters/2 + 1\n  1095\t}\n  1096\t\n  1097\t// restoreUserSnapshot is used to manually consume an external snapshot, such\n  1098\t// as if restoring from a backup. We will use the current Raft configuration,\n  1099\t// not the one from the snapshot, so that we can restore into a new cluster. We\n  1100\t// will also use the higher of the index of the snapshot, or the current index,\n  1101\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n  1102\t// so that the snapshot will be sent to followers and used for any new joiners.\n  1103\t// This can only be run on the leader, and returns a future that can be used to\n  1104\t// block until complete.\n  1105\tfunc (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n  1106\t\tdefer metrics.MeasureSince([]string{\"raft\", \"restoreUserSnapshot\"}, time.Now())\n  1107\t\n  1108\t\t// Sanity check the version.\n  1109\t\tversion := meta.Version\n  1110\t\tif version < SnapshotVersionMin || version > SnapshotVersionMax {\n  1111\t\t\treturn fmt.Errorf(\"unsupported snapshot version %d\", version)\n  1112\t\t}\n  1113\t\n  1114\t\t// We don't support snapshots while there's a config change\n  1115\t\t// outstanding since the snapshot doesn't have a means to\n  1116\t\t// represent this state.\n  1117\t\tcommittedIndex := r.configurations.committedIndex\n  1118\t\tlatestIndex := r.configurations.latestIndex\n  1119\t\tif committedIndex != latestIndex {\n  1120\t\t\treturn fmt.Errorf(\"cannot restore snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n  1121\t\t\t\tlatestIndex, committedIndex)\n  1122\t\t}\n  1123\t\n  1124\t\t// Cancel any inflight requests.\n  1125\t\tfor {\n  1126\t\t\te := r.leaderState.inflight.Front()\n  1127\t\t\tif e == nil {\n  1128\t\t\t\tbreak\n  1129\t\t\t}\n  1130\t\t\te.Value.(*logFuture).respond(ErrAbortedByRestore)\n  1131\t\t\tr.leaderState.inflight.Remove(e)\n  1132\t\t}\n  1133\t\n  1134\t\t// We will overwrite the snapshot metadata with the current term,\n  1135\t\t// an index that's greater than the current index, or the last\n  1136\t\t// index in the snapshot. It's important that we leave a hole in\n  1137\t\t// the index so we know there's nothing in the Raft log there and\n  1138\t\t// replication will fault and send the snapshot.\n  1139\t\tterm := r.getCurrentTerm()\n  1140\t\tlastIndex := r.getLastIndex()\n  1141\t\tif meta.Index > lastIndex {\n  1142\t\t\tlastIndex = meta.Index\n  1143\t\t}\n  1144\t\tlastIndex++\n  1145\t\n  1146\t\t// Dump the snapshot. Note that we use the latest configuration,\n  1147\t\t// not the one that came with the snapshot.\n  1148\t\tsink, err := r.snapshots.Create(version, lastIndex, term,\n  1149\t\t\tr.configurations.latest, r.configurations.latestIndex, r.trans)\n  1150\t\tif err != nil {\n  1151\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n  1152\t\t}\n  1153\t\tn, err := io.Copy(sink, reader)\n  1154\t\tif err != nil {\n  1155\t\t\t_ = sink.Cancel()\n  1156\t\t\treturn fmt.Errorf(\"failed to write snapshot: %v\", err)\n  1157\t\t}\n  1158\t\tif n != meta.Size {\n  1159\t\t\t_ = sink.Cancel()\n  1160\t\t\treturn fmt.Errorf(\"failed to write snapshot, size didn't match (%d != %d)\", n, meta.Size)\n  1161\t\t}\n  1162\t\tif err := sink.Close(); err != nil {\n  1163\t\t\treturn fmt.Errorf(\"failed to close snapshot: %v\", err)\n  1164\t\t}\n  1165\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n  1166\t\n  1167\t\t// Restore the snapshot into the FSM. If this fails we are in a\n  1168\t\t// bad state so we panic to take ourselves out.\n  1169\t\tfsm := &restoreFuture{ID: sink.ID()}\n  1170\t\tfsm.ShutdownCh = r.shutdownCh\n  1171\t\tfsm.init()\n  1172\t\tselect {\n  1173\t\tcase r.fsmMutateCh <- fsm:\n  1174\t\tcase <-r.shutdownCh:\n  1175\t\t\treturn ErrRaftShutdown\n  1176\t\t}\n  1177\t\tif err := fsm.Error(); err != nil {\n  1178\t\t\tpanic(fmt.Errorf(\"failed to restore snapshot: %v\", err))\n  1179\t\t}\n  1180\t\n","exit_code":0,"status":"completed"}}
