he restore to happen\n  1947\t\tif err := future.Error(); err != nil {\n  1948\t\t\tr.logger.Error(\"failed to restore snapshot\", \"error\", err)\n  1949\t\t\trpcErr = err\n  1950\t\t\treturn\n  1951\t\t}\n  1952\t\n  1953\t\t// Update the lastApplied so we don't replay old logs\n  1954\t\tr.setLastApplied(req.LastLogIndex)\n  1955\t\n  1956\t\t// Update the last stable snapshot info\n  1957\t\tr.setLastSnapshot(req.LastLogIndex, req.LastLogTerm)\n  1958\t\n  1959\t\t// Restore the peer set\n  1960\t\tr.setLatestConfiguration(reqConfiguration, reqConfigurationIndex)\n  1961\t\tr.setCommittedConfiguration(reqConfiguration, reqConfigurationIndex)\n  1962\t\n  1963\t\t// Clear old logs if r.logs is a MonotonicLogStore. Otherwise compact the\n  1964\t\t// logs. In both cases, log any errors and continue.\n  1965\t\tif mlogs, ok := r.logs.(MonotonicLogStore); ok && mlogs.IsMonotonic() {\n  1966\t\t\tif err := r.removeOldLogs(); err != nil {\n  1967\t\t\t\tr.logger.Error(\"failed to reset logs\", \"error\", err)\n  1968\t\t\t}\n  1969\t\t} else if err := r.compactLogs(req.LastLogIndex); err != nil {\n  1970\t\t\tr.logger.Error(\"failed to compact logs\", \"error\", err)\n  1971\t\t}\n  1972\t\n  1973\t\tr.logger.Info(\"Installed remote snapshot\")\n  1974\t\tresp.Success = true\n  1975\t\tr.setLastContact()\n  1976\t}\n  1977\t\n  1978\t// setLastContact is used to set the last contact time to now\n  1979\tfunc (r *Raft) setLastContact() {\n  1980\t\tr.lastContactLock.Lock()\n=====\n  2160\t\treturn nil\n  2161\t}\n  2162\t\n  2163\t// setCurrentTerm is used to set the current term in a durable manner.\n  2164\tfunc (r *Raft) setCurrentTerm(t uint64) {\n  2165\t\t// Persist to disk first\n  2166\t\tif err := r.stable.SetUint64(keyCurrentTerm, t); err != nil {\n  2167\t\t\tpanic(fmt.Errorf(\"failed to save current term: %v\", err))\n  2168\t\t}\n  2169\t\tr.raftState.setCurrentTerm(t)\n  2170\t}\n  2171\t\n  2172\t// setState is used to update the current state. Any state