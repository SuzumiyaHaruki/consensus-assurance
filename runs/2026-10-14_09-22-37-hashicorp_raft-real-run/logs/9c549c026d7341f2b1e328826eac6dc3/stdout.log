{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/agent-source; cat -n raft.go | sed -n '1980,2160p'\"","aggregated_output":"  1980\t\tr.lastContactLock.Lock()\n  1981\t\tr.lastContact = time.Now()\n  1982\t\tr.lastContactLock.Unlock()\n  1983\t}\n  1984\t\n  1985\ttype voteResult struct {\n  1986\t\tRequestVoteResponse\n  1987\t\tvoterID ServerID\n  1988\t}\n  1989\t\n  1990\ttype preVoteResult struct {\n  1991\t\tRequestPreVoteResponse\n  1992\t\tvoterID ServerID\n  1993\t}\n  1994\t\n  1995\t// electSelf is used to send a RequestVote RPC to all peers, and vote for\n  1996\t// ourself. This has the side affecting of incrementing the current term. The\n  1997\t// response channel returned is used to wait for all the responses (including a\n  1998\t// vote for ourself). This must only be called from the main thread.\n  1999\tfunc (r *Raft) electSelf() <-chan *voteResult {\n  2000\t\t// Create a response channel\n  2001\t\trespCh := make(chan *voteResult, len(r.configurations.latest.Servers))\n  2002\t\n  2003\t\t// Increment the term\n  2004\t\tnewTerm := r.getCurrentTerm() + 1\n  2005\t\n  2006\t\tr.setCurrentTerm(newTerm)\n  2007\t\t// Construct the request\n  2008\t\tlastIdx, lastTerm := r.getLastEntry()\n  2009\t\treq := &RequestVoteRequest{\n  2010\t\t\tRPCHeader: r.getRPCHeader(),\n  2011\t\t\tTerm:      newTerm,\n  2012\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n  2013\t\t\tCandidate:          r.trans.EncodePeer(r.localID, r.localAddr),\n  2014\t\t\tLastLogIndex:       lastIdx,\n  2015\t\t\tLastLogTerm:        lastTerm,\n  2016\t\t\tLeadershipTransfer: r.candidateFromLeadershipTransfer.Load(),\n  2017\t\t}\n  2018\t\n  2019\t\t// Construct a function to ask for a vote\n  2020\t\taskPeer := func(peer Server) {\n  2021\t\t\tr.goFunc(func() {\n  2022\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n  2023\t\t\t\tresp := &voteResult{voterID: peer.ID}\n  2024\t\t\t\terr := r.trans.RequestVote(peer.ID, peer.Address, req, &resp.RequestVoteResponse)\n  2025\t\t\t\tif err != nil {\n  2026\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n  2027\t\t\t\t\t\t\"target\", peer,\n  2028\t\t\t\t\t\t\"error\", err,\n  2029\t\t\t\t\t\t\"term\", req.Term)\n  2030\t\t\t\t\tresp.Term = req.Term\n  2031\t\t\t\t\tresp.Granted = false\n  2032\t\t\t\t}\n  2033\t\t\t\trespCh <- resp\n  2034\t\t\t})\n  2035\t\t}\n  2036\t\n  2037\t\t// For each peer, request a vote\n  2038\t\tfor _, server := range r.configurations.latest.Servers {\n  2039\t\t\tif server.Suffrage == Voter {\n  2040\t\t\t\tif server.ID == r.localID {\n  2041\t\t\t\t\tr.logger.Debug(\"voting for self\", \"term\", req.Term, \"id\", r.localID)\n  2042\t\n  2043\t\t\t\t\t// Persist a vote for ourselves\n  2044\t\t\t\t\tif err := r.persistVote(req.Term, req.Addr); err != nil {\n  2045\t\t\t\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  2046\t\t\t\t\t\treturn nil\n  2047\t\n  2048\t\t\t\t\t}\n  2049\t\t\t\t\t// Include our own vote\n  2050\t\t\t\t\trespCh <- &voteResult{\n  2051\t\t\t\t\t\tRequestVoteResponse: RequestVoteResponse{\n  2052\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n  2053\t\t\t\t\t\t\tTerm:      req.Term,\n  2054\t\t\t\t\t\t\tGranted:   true,\n  2055\t\t\t\t\t\t},\n  2056\t\t\t\t\t\tvoterID: r.localID,\n  2057\t\t\t\t\t}\n  2058\t\t\t\t} else {\n  2059\t\t\t\t\tr.logger.Debug(\"asking for vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2060\t\t\t\t\taskPeer(server)\n  2061\t\t\t\t}\n  2062\t\t\t}\n  2063\t\t}\n  2064\t\n  2065\t\treturn respCh\n  2066\t}\n  2067\t\n  2068\t// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\n  2069\t// ourself. This will not increment the current term. The\n  2070\t// response channel returned is used to wait for all the responses (including a\n  2071\t// vote for ourself).\n  2072\t// This must only be called from the main thread.\n  2073\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n  2074\t\n  2075\t\t// At this point transport should support pre-vote\n  2076\t\t// but check just in case\n  2077\t\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\n  2078\t\tif !prevoteTransSupported {\n  2079\t\t\tpanic(\"preElection is not possible if the transport don't support pre-vote\")\n  2080\t\t}\n  2081\t\n  2082\t\t// Create a response channel\n  2083\t\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\n  2084\t\n  2085\t\t// Propose the next term without actually changing our state\n  2086\t\tnewTerm := r.getCurrentTerm() + 1\n  2087\t\n  2088\t\t// Construct the request\n  2089\t\tlastIdx, lastTerm := r.getLastEntry()\n  2090\t\treq := &RequestPreVoteRequest{\n  2091\t\t\tRPCHeader:    r.getRPCHeader(),\n  2092\t\t\tTerm:         newTerm,\n  2093\t\t\tLastLogIndex: lastIdx,\n  2094\t\t\tLastLogTerm:  lastTerm,\n  2095\t\t}\n  2096\t\n  2097\t\t// Construct a function to ask for a vote\n  2098\t\taskPeer := func(peer Server) {\n  2099\t\t\tr.goFunc(func() {\n  2100\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"preElectSelf\"}, time.Now())\n  2101\t\t\t\tresp := &preVoteResult{voterID: peer.ID}\n  2102\t\n  2103\t\t\t\terr := prevoteTrans.RequestPreVote(peer.ID, peer.Address, req, &resp.RequestPreVoteResponse)\n  2104\t\n  2105\t\t\t\t// If the target server do not support Pre-vote RPC we count this as a granted vote to allow\n  2106\t\t\t\t// the cluster to progress.\n  2107\t\t\t\tif err != nil && strings.Contains(err.Error(), rpcUnexpectedCommandError) {\n  2108\t\t\t\t\tr.logger.Error(\"target does not support pre-vote RPC, treating as granted\",\n  2109\t\t\t\t\t\t\"target\", peer,\n  2110\t\t\t\t\t\t\"error\", err,\n  2111\t\t\t\t\t\t\"term\", req.Term)\n  2112\t\t\t\t\tresp.Term = req.Term\n  2113\t\t\t\t\tresp.Granted = true\n  2114\t\t\t\t} else if err != nil {\n  2115\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n  2116\t\t\t\t\t\t\"target\", peer,\n  2117\t\t\t\t\t\t\"error\", err,\n  2118\t\t\t\t\t\t\"term\", req.Term)\n  2119\t\t\t\t\tresp.Term = req.Term\n  2120\t\t\t\t\tresp.Granted = false\n  2121\t\t\t\t}\n  2122\t\t\t\trespCh <- resp\n  2123\t\n  2124\t\t\t})\n  2125\t\t}\n  2126\t\n  2127\t\t// For each peer, request a vote\n  2128\t\tfor _, server := range r.configurations.latest.Servers {\n  2129\t\t\tif server.Suffrage == Voter {\n  2130\t\t\t\tif server.ID == r.localID {\n  2131\t\t\t\t\tr.logger.Debug(\"pre-voting for self\", \"term\", req.Term, \"id\", r.localID)\n  2132\t\n  2133\t\t\t\t\t// cast a pre-vote for our self\n  2134\t\t\t\t\trespCh <- &preVoteResult{\n  2135\t\t\t\t\t\tRequestPreVoteResponse: RequestPreVoteResponse{\n  2136\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n  2137\t\t\t\t\t\t\tTerm:      req.Term,\n  2138\t\t\t\t\t\t\tGranted:   true,\n  2139\t\t\t\t\t\t},\n  2140\t\t\t\t\t\tvoterID: r.localID,\n  2141\t\t\t\t\t}\n  2142\t\t\t\t} else {\n  2143\t\t\t\t\tr.logger.Debug(\"asking for pre-vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2144\t\t\t\t\taskPeer(server)\n  2145\t\t\t\t}\n  2146\t\t\t}\n  2147\t\t}\n  2148\t\n  2149\t\treturn respCh\n  2150\t}\n  2151\t\n  2152\t// persistVote is used to persist our vote for safety.\n  2153\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n  2154\t\tif err := r.stable.SetUint64(keyLastVoteTerm, term); err != nil {\n  2155\t\t\treturn err\n  2156\t\t}\n  2157\t\tif err := r.stable.Set(keyLastVoteCand, candidate); err != nil {\n  2158\t\t\treturn err\n  2159\t\t}\n  2160\t\treturn nil\n","exit_code":0,"status":"completed"}}
