an entry it had committed.\\\",\n \\\"conditions\\\":\\\"RestoreCommittedLogs=true with a CommitTrackingLogStore and a log whose newest configuration entry lies inside the replayed committed prefix without a covering snapshot; the affected node must lead (or be elected) for the commitment, lease, confirmation and configuration-change consequences.\\\",\n \\\"source_ids\\\":[\\\"newraft_scan\\\",\\\"restore_committed\\\",\\\"append_config_entry\\\",\\\"next_configuration\\\",\\\"commit_config_on_append\\\",\\\"truncate_conflict\\\",\\\"verify_leader_quorum\\\"],\n \\\"executions\\\":{\\\"226f9762f0b444f69c154b35fe0788f3\\\":[1,3],\\\"b1daa1f4c9444b8d857bc7e0ab761691\\\":[1,3],\\\"6f9feceeefb245c288a7fd1f4497b83c\\\":[2,3,4],\\\"1f95cb0a02bc4577a5a9f1ab627fe903\\\":[6]},\n \\\"changed_premise\\\":\\\"Statement extended, not corrected: the previous revision listed commitment, lease and configuration-change decisions as the consumers of the stale configuration; this revision adds the leadership-confirmation quorum (verifyLeader) and the two client-visible consequences observed since (confirmation succeeding while a different majority elects a higher-term leader). Conditions, sources for the original claims and all earlier evidence are unchanged.\\\")\n}]\njson.dump(d, open(p,'w'), indent=2)\nEOF\ncd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run; /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run . --submission update.json 2>&1 | head -3\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
