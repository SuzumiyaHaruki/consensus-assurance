'\"'''\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nprint('patched')\nPYEOF\ncp assurance_quorum_restart_test.go scratch/; cd scratch; GOFLAGS=-mod=mod GOPROXY=off GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/draft/tmp/gocache2 timeout 240 go test -run '\"'^TestAssurance_ClusterWideRestartWithoutSnapshot$'\"' -count=1 -v . 2>&1 | grep -E \\\"CA_EVENT|PASS|FAIL|panic|\\\\.go:\\\" | head -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
