{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-14_09-22-37-hashicorp_raft-real-run/draft; python3 - <<'EOF'\np='assurance_resurrect_test.go'\ns=open(p).read()\n\n# (a) C is not the subject of the probe: keep its own configuration recovery normal.\nold='''\t\tc := *conf\n\t\tc.LocalID = ServerID(a)\n\t\tconfs[i] = &c'''\nnew='''\t\tc := *conf\n\t\tc.LocalID = ServerID(a)\n\t\tif a == \\\"C\\\" {\n\t\t\t// C is not the subject of this probe; keep its own restart path normal\n\t\t\t// so a configuration-less C cannot confound the phase-2 election.\n\t\t\tc.RestoreCommittedLogs = false\n\t\t}\n\t\tconfs[i] = &c'''\nassert old in s; s=s.replace(old,new)\n\n# (b) keep B from stealing the election while A restarts\nold='''\tif err := raftA.Shutdown().Error(); err \"'!= nil {\n\t\tt.Fatalf(\"[%s] shutdown A: %v\", mode, err)\n\t}\n\t_, transA2 := NewInmemTransport(\"A\")'\"'''\nnew='''\trc := raftB.ReloadableConfig()\n\trc.HeartbeatTimeout = 3 * time.Second\n\trc.ElectionTimeout = 3 * time.Second\n\tif err := raftB.ReloadConfig(rc); err \"'!= nil {\n\t\tt.Fatalf(\"[%s] reload B: %v\", mode, err)\n\t}\n\tif err := raftA.Shutdown().Error(); err != nil {\n\t\tt.Fatalf(\"[%s] shutdown A: %v\", mode, err)\n\t}\n\t_, transA2 := NewInmemTransport(\"A\")'\"'''\nassert old in s; s=s.replace(old,new)\n\n# (c) make sure A is leader again, and measure the write's own index\nold='''\ttransA2.Disconnect(\\\"B\\\")\n\ttrans[1].Disconnect(\\\"A\\\")\n\twriteErr := raftA.Apply([]byte(\\\"a-c-only-write\\\"), 2*time.Second).Error()\n\tentryIdx := raftA.LastIndex()\n\tbHas := raftB.LastIndex() >= entryIdx\n\tresurrectEvent(t, \\\"split_write_\\\"+mode, map[string]interface{}{\n\t\t\\\"mode\\\":              mode,\n\t\t\\\"write_applied\\\":     writeErr == nil,\n\t\t\\\"entry_index\\\":       entryIdx,\n\t\t\\\"a_commit\\\":          raftA.CommitIndex(),\n\t\t\\\"a_applied\\\":         r