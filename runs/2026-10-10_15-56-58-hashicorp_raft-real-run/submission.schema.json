{
  "$defs": {
    "ArtifactReviewItem": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "aspect": {
          "enum": [
            "applicability",
            "decomposition",
            "checker_correspondence"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "status": {
          "enum": [
            "no_issue_found",
            "needs_reading",
            "disputed",
            "revision_needed"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "execution_attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionAttribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only direct checker_correspondence: cite completed violating witnesses and a subsequent independent failure. Source IDs and rationale must justify completion and causal independence; see evidence-review guidance"
        },
        "report_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional short Chinese reading title for this target; presentation only, never a verdict",
          "title": "Report Title"
        },
        "report_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Chinese observed-answer summary preserving applicability; numbers and status come from retained assessment",
          "title": "Report Answer"
        },
        "counterevidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "aspect",
        "status",
        "source_ids",
        "rationale"
      ],
      "title": "ArtifactReviewItem",
      "type": "object"
    },
    "AuditQuestion": {
      "additionalProperties": false,
      "description": "Sourced investigation of requirements, protections and history; these may remain unknown.",
      "properties": {
        "audit_spec_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Spec Version"
        },
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "explained_by_existing_mechanism",
                "concrete_suspicion",
                "needs_specific_evidence",
                "ready_for_check"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition"
        },
        "preferred_check": {
          "anyOf": [
            {
              "enum": [
                "source_review",
                "direct_test",
                "controlled_schedule"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Check"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "importance": {
          "default": "",
          "title": "Importance",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "participants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "objects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "contexts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contexts",
          "type": "array"
        },
        "event_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Paths",
          "type": "array"
        },
        "activity_classes": {
          "default": [],
          "items": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7"
            ],
            "type": "string"
          },
          "title": "Activity Classes",
          "type": "array"
        },
        "behavior_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Behavior Ids",
          "type": "array"
        },
        "fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "supporting_behavior_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional Behavior ID to sourced prehistory, context or consequence support",
          "title": "Supporting Behavior Ids",
          "type": "object"
        },
        "obligation_relation_kind": {
          "anyOf": [
            {
              "enum": [
                "establishment",
                "preservation",
                "consumption",
                "recovery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obligation Relation Kind"
        },
        "counterevidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "unknowns": {
          "description": "Specific unresolved premises or discriminators of this question; not generic caution or a checklist of untested cases",
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "trigger_rationale": {
          "default": "",
          "title": "Trigger Rationale",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "AuditQuestion",
      "type": "object"
    },
    "BindingAssociation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_ids",
        "rationale"
      ],
      "title": "BindingAssociation",
      "type": "object"
    },
    "BindingDraft": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "description": "In a combined obligation, omitted associations are derived from its claim",
          "items": {
            "$ref": "#/$defs/BindingAssociation"
          },
          "title": "Associations",
          "type": "array"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "symbol": {
          "description": "Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.",
          "title": "Symbol",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "id",
        "material_id",
        "symbol",
        "start_line",
        "end_line",
        "description",
        "pending"
      ],
      "title": "BindingDraft",
      "type": "object"
    },
    "CandidateSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchFeedback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "map_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Path"
        },
        "map_changes": {
          "additionalProperties": {
            "$ref": "#/$defs/UnderstandingChange"
          },
          "default": {},
          "title": "Map Changes",
          "type": "object"
        },
        "repair_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retained rejected operation whose draft this submission repairs",
          "title": "Repair Of"
        },
        "action": {
          "enum": [
            "continue",
            "pause",
            "explained",
            "obligation"
          ],
          "title": "Action",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "parent_candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Candidate Id"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditQuestion"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New sourced question, or only changed AuditQuestion fields when candidate_id is supplied",
          "title": "Question"
        },
        "resume_conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resume Conditions",
          "type": "array"
        },
        "obligation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "title": "Bindings",
          "type": "array"
        }
      },
      "required": [
        "rationale",
        "action"
      ],
      "title": "CandidateSubmission",
      "type": "object"
    },
    "CheckSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchFeedback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "map_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Path"
        },
        "map_changes": {
          "additionalProperties": {
            "$ref": "#/$defs/UnderstandingChange"
          },
          "default": {},
          "title": "Map Changes",
          "type": "object"
        },
        "repair_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retained rejected operation whose draft this submission repairs",
          "title": "Repair Of"
        },
        "action": {
          "enum": [
            "check",
            "revise_check"
          ],
          "title": "Action",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateSubmission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_path": {
          "title": "Plan Path",
          "type": "string"
        },
        "harness_path": {
          "title": "Harness Path",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Destination path to draft source path for helpers",
          "title": "Files",
          "type": "object"
        },
        "previous_check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Check Id"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphPatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional changes to the previous check's claim, bindings or Unit; expected versions protect saved inputs. The controller records the diff and executes the successor."
        }
      },
      "required": [
        "rationale",
        "action",
        "plan_path",
        "harness_path"
      ],
      "title": "CheckSubmission",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "description": "A sourced requirement under explicit conditions, not the script for one experiment.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "obligation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "concern": {
          "default": "implementation_semantics",
          "enum": [
            "consensus_safety",
            "bounded_liveness",
            "implementation_semantics"
          ],
          "title": "Concern",
          "type": "string"
        },
        "description": {
          "description": "Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability",
          "title": "Description",
          "type": "string"
        },
        "source_ids": {
          "description": "Located materials; file kinds do not establish normative authority",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "pending": {
          "items": {
            "type": "string"
          },
          "title": "Pending",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding",
          "default": {
            "source_ids": [],
            "expectation_ids": [],
            "binding_ids": [],
            "derivation": "",
            "applicability": "",
            "unresolved": [],
            "conflicts": [],
            "alternatives": []
          }
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "source_ids",
        "scope",
        "pending"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "CodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "boundary_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Complete"
        },
        "kind": {
          "default": "declaration",
          "enum": [
            "declaration",
            "interface_member",
            "callsite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "start_line",
        "end_line",
        "symbol"
      ],
      "title": "CodeAnchor",
      "type": "object"
    },
    "ExecutionAttribution": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "description": "Exact retained target CheckRun, not the review operation or artifact ID",
          "title": "Check Id",
          "type": "string"
        },
        "witness_indices": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "description": "Checker IDs and their valid violating parsed event indices; never raw file line numbers",
          "title": "Witness Indices",
          "type": "object"
        },
        "failure_stream": {
          "enum": [
            "stdout",
            "stderr"
          ],
          "title": "Failure Stream",
          "type": "string"
        },
        "failure_lines": {
          "description": "Inclusive one-based lines in that CheckRun's retained stream",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Failure Lines",
          "type": "array"
        },
        "harness_lines": {
          "description": "Inclusive one-based lines in the artifact's fixed primary harness",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Harness Lines",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "witness_indices",
        "failure_stream",
        "failure_lines",
        "harness_lines"
      ],
      "title": "ExecutionAttribution",
      "type": "object"
    },
    "ExploreSubmission": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRange"
          },
          "title": "Sources",
          "type": "array"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchFeedback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "map_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Path"
        },
        "map_changes": {
          "additionalProperties": {
            "$ref": "#/$defs/UnderstandingChange"
          },
          "default": {},
          "title": "Map Changes",
          "type": "object"
        },
        "repair_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retained rejected operation whose draft this submission repairs",
          "title": "Repair Of"
        },
        "action": {
          "const": "explore",
          "title": "Action",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "harness_path": {
          "title": "Harness Path",
          "type": "string"
        },
        "execution_package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Package"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "rationale",
        "action",
        "question",
        "harness_path"
      ],
      "title": "ExploreSubmission",
      "type": "object"
    },
    "GraphPatch": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 15,
          "title": "Claims",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/BindingDraft"
          },
          "maxItems": 20,
          "title": "Bindings",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDraft"
          },
          "maxItems": 30,
          "title": "Relations",
          "type": "array"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/UnitDraft"
          },
          "maxItems": 5,
          "title": "Units",
          "type": "array"
        },
        "expected_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Expected Versions",
          "type": "object"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "title": "GraphPatch",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
