ring\"\n  },\n  \"file\": {\n   \"title\": \"File\",\n   \"type\": \"string\"\n  },\n  \"start_line\": {\n   \"minimum\": 1,\n   \"title\": \"Start Line\",\n   \"type\": \"integer\"\n  },\n  \"end_line\": {\n   \"minimum\": 1,\n   \"title\": \"End Line\",\n   \"type\": \"integer\"\n  },\n  \"kind\": {\n   \"enum\": [\n    \"document_statement\",\n    \"interface_statement\",\n    \"test_expectation\",\n    \"code_observation\",\n    \"protocol_candidate\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"id\",\n  \"file\",\n  \"start_line\",\n  \"end_line\",\n  \"kind\"\n ],\n \"title\": \"SourceRange\",\n \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
