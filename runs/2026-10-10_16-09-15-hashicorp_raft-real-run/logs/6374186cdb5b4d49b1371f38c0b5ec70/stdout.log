ation,\\n\\t\\t\\tData: EncodeConfiguration(configuration),\\n\\t\\t}\\n\\t}\\n\\n\\tr.dispatchLogs([]*logFuture{&future.logFuture})\\n\\tindex := future.Index()\\n\\tr.setLatestCon\nbindings: []\nclaims: []\ngraph_version: 0\n","exit_code":0,"status":"completed"}}
