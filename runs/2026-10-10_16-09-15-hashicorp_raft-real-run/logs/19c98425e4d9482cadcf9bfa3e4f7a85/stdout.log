n1585:func (r *Raft) processConfigurationLogEntry(entry *Log) error {\n1603:func (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n1736:func (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n1814:func (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n1956:func (r *Raft) setLastContact() {\n1976:func (r *Raft) electSelf() <-chan *voteResult {\n2050:func (r *Raft) preElectSelf() <-chan *preVoteResult {\n2130:func (r *Raft) persistVote(term uint64, candidate []byte) error {\n2141:func (r *Raft) setCurrentTerm(t uint64) {\n2152:func (r *Raft) setState(state RaftState) {\n2163:func (r *Raft) pickServer() *Server {\n2187:func (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n2209:func (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n2217:func (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n2224:func (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n2232:func (r *Raft) getLatestConfiguration() Configuration {\n","exit_code":0,"status":"completed"}}
