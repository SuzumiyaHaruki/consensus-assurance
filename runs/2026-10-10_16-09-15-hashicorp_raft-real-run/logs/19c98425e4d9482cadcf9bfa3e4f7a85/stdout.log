{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c 'cat -n /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-15-hashicorp_raft-real-run/agent-source/replication.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"sync\"\n    10\t\t\"sync/atomic\"\n    11\t\t\"time\"\n    12\t\n    13\t\t\"github.com/hashicorp/go-metrics/compat\"\n    14\t)\n    15\t\n    16\tconst (\n    17\t\tmaxFailureScale = 12\n    18\t\tfailureWait     = 10 * time.Millisecond\n    19\t)\n    20\t\n    21\tvar (\n    22\t\t// ErrLogNotFound indicates a given log entry is not available.\n    23\t\tErrLogNotFound = errors.New(\"log not found\")\n    24\t\n    25\t\t// ErrPipelineReplicationNotSupported can be returned by the transport to\n    26\t\t// signal that pipeline replication is not supported in general, and that\n    27\t\t// no error message should be produced.\n    28\t\tErrPipelineReplicationNotSupported = errors.New(\"pipeline replication not supported\")\n    29\t)\n    30\t\n    31\t// followerReplication is in charge of sending snapshots and log entries from\n    32\t// this leader during this particular term to a remote follower.\n    33\ttype followerReplication struct {\n    34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n    35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n    36\t\t// platforms.\n    37\t\n    38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n    39\t\t// requests.\n    40\t\tcurrentTerm uint64\n    41\t\n    42\t\t// nextIndex is the index of the next log entry to send to the follower,\n    43\t\t// which may fall past the end of the log.\n    44\t\tnextIndex uint64\n    45\t\n    46\t\t// peer contains the network address and ID of the remote follower.\n    47\t\tpeer Server\n    48\t\t// peerLock protects 'peer'\n    49\t\tpeerLock sync.RWMutex\n    50\t\n    51\t\t// commitment tracks the entries acknowledged by followers so that the\n    52\t\t// leader's commit index can advance. It is updated on successful\n    53\t\t// AppendEntries responses.\n    54\t\tcommitment *commitment\n    55\t\n    56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n    57\t\t// removed from the cluster. In the follower removed case, it carries a log\n    58\t\t// index; replication should be attempted with a best effort up through that\n    59\t\t// index, before exiting.\n    60\t\tstopCh chan uint64\n    61\t\n    62\t\t// triggerCh is notified every time new entries are appended to the log.\n    63\t\ttriggerCh chan struct{}\n    64\t\n    65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n    66\t\t// deferErr, the sender can be notified when the replication is done.\n    67\t\ttriggerDeferErrorCh chan *deferError\n    68\t\n    69\t\t// lastContact is updated to the current time whenever any response is\n    70\t\t// received from the follower (successful or not). This is used to check\n    71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n    72\t\tlastContact time.Time\n    73\t\t// lastContactLock protects 'lastContact'.\n    74\t\tlastContactLock sync.RWMutex\n    75\t\n    76\t\t// failures counts the number of failed RPCs since the last success, which is\n    77\t\t// used to apply backoff.\n    78\t\tfailures uint64\n    79\t\n    80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n    81\t\t// this server is still leader.\n    82\t\tnotifyCh chan struct{}\n    83\t\t// notify is a map of futures to be resolved upon receipt of an\n    84\t\t// acknowledgement, then cleared from this map.\n    85\t\tnotify map[*verifyFuture]struct{}\n    86\t\t// notifyLock protects 'notify'.\n    87\t\tnotifyLock sync.Mutex\n    88\t\n    89\t\t// stepDown is used to indicate to the leader that we\n    90\t\t// should step down based on information from a follower.\n    91\t\tstepDown chan struct{}\n    92\t\n    93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n    94\t\t// It is private to this replication goroutine.\n    95\t\tallowPipeline bool\n    96\t}\n    97\t\n    98\t// notifyAll is used to notify all the waiting verify futures\n    99\t// if the follower believes we are still the leader.\n   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   101\t\t// Clear the waiting notifies minimizing lock time\n   102\t\ts.notifyLock.Lock()\n   103\t\tn := s.notify\n   104\t\ts.notify = make(map[*verifyFuture]struct{})\n   105\t\ts.notifyLock.Unlock()\n   106\t\n   107\t\t// Submit our votes\n   108\t\tfor v := range n {\n   109\t\t\tv.vote(leader)\n   110\t\t}\n   111\t}\n   112\t\n   113\t// cleanNotify is used to delete notify, .\n   114\tfunc (s *followerReplication) cleanNotify(v *verifyFuture) {\n   115\t\ts.notifyLock.Lock()\n   116\t\tdelete(s.notify, v)\n   117\t\ts.notifyLock.Unlock()\n   118\t}\n   119\t\n   120\t// LastContact returns the time of last contact.\n   121\tfunc (s *followerReplication) LastContact() time.Time {\n   122\t\ts.lastContactLock.RLock()\n   123\t\tlast := s.lastContact\n   124\t\ts.lastContactLock.RUnlock()\n   125\t\treturn last\n   126\t}\n   127\t\n   128\t// setLastContact sets the last contact to the current time.\n   129\tfunc (s *followerReplication) setLastContact() {\n   130\t\ts.lastContactLock.Lock()\n   131\t\ts.lastContact = time.Now()\n   132\t\ts.lastContactLock.Unlock()\n   133\t}\n   134\t\n   135\t// replicate is a long running routine that replicates log entries to a single\n   136\t// follower.\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n   165\t\t\t// followers quickly learn the leader's commit index when\n   166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n   167\t\t\t// can't do this to keep them unblocked by disk IO on the\n   168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n   169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   172\t\t\t}\n   173\t\n   174\t\t\t// If things looks healthy, switch to pipeline mode\n   175\t\t\tif !shouldStop && s.allowPipeline {\n   176\t\t\t\tgoto PIPELINE\n   177\t\t\t}\n   178\t\t}\n   179\t\treturn\n   180\t\n   181\tPIPELINE:\n   182\t\t// Disable until re-enabled\n   183\t\ts.allowPipeline = false\n   184\t\n   185\t\t// Replicates using a pipeline for high performance. This method\n   186\t\t// is not able to gracefully recover from errors, and so we fall back\n   187\t\t// to standard mode on failure.\n   188\t\tif err := r.pipelineReplicate(s); err != nil {\n   189\t\t\tif err != ErrPipelineReplicationNotSupported {\n   190\t\t\t\ts.peerLock.RLock()\n   191\t\t\t\tpeer := s.peer\n   192\t\t\t\ts.peerLock.RUnlock()\n   193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n   194\t\t\t}\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   201\t// If the follower log is behind, we take care to bring them up to date.\n   202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n   203\t\t// Create the base request\n   204\t\tvar req AppendEntriesRequest\n   205\t\tvar resp AppendEntriesResponse\n   206\t\tvar start time.Time\n   207\t\tvar peer Server\n   208\t\n   209\tSTART:\n   210\t\t// Prevent an excessive retry rate on errors\n   211\t\tif s.failures > 0 {\n   212\t\t\tselect {\n   213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n   214\t\t\tcase <-r.shutdownCh:\n   215\t\t\t}\n   216\t\t}\n   217\t\n   218\t\ts.peerLock.RLock()\n   219\t\tpeer = s.peer\n   220\t\ts.peerLock.RUnlock()\n   221\t\n   222\t\t// Setup the request\n   223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n   224\t\t\tgoto SEND_SNAP\n   225\t\t} else if err != nil {\n   226\t\t\treturn\n   227\t\t}\n   228\t\n   229\t\t// Make the RPC call\n   230\t\tstart = time.Now()\n   231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n   233\t\t\ts.failures++\n   234\t\t\treturn\n   235\t\t}\n   236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n   237\t\n   238\t\t// Check for a newer term, stop running\n   239\t\tif resp.Term > req.Term {\n   240\t\t\tr.handleStaleTerm(s)\n   241\t\t\treturn true\n   242\t\t}\n   243\t\n   244\t\t// Update the last contact\n   245\t\ts.setLastContact()\n   246\t\n   247\t\t// Update s based on success\n   248\t\tif resp.Success {\n   249\t\t\t// Update our replication state\n   250\t\t\tupdateLastAppended(s, &req)\n   251\t\n   252\t\t\t// Clear any failures, allow pipelining\n   253\t\t\ts.failures = 0\n   254\t\t\ts.allowPipeline = true\n   255\t\t} else {\n   256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n   257\t\t\tif resp.NoRetryBackoff {\n   258\t\t\t\ts.failures = 0\n   259\t\t\t} else {\n   260\t\t\t\ts.failures++\n   261\t\t\t}\n   262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n   263\t\t}\n   264\t\n   265\tCHECK_MORE:\n   266\t\t// Poll the stop channel here in case we are looping and have been asked\n   267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n   268\t\t// where we are asked to replicate to a given index and then shutdown,\n   269\t\t// it's better to not loop in here to send lots of entries to a straggler\n   270\t\t// that's leaving the cluster anyways.\n   271\t\tselect {\n   272\t\tcase <-s.stopCh:\n   273\t\t\treturn true\n   274\t\tdefault:\n   275\t\t}\n   276\t\n   277\t\t// Check if there are more logs to replicate\n   278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n   279\t\t\tgoto START\n   280\t\t}\n   281\t\treturn\n   282\t\n   283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n   284\t\t// is too far behind, and we must ship a snapshot down instead\n   285\tSEND_SNAP:\n   286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n   287\t\t\treturn true\n   288\t\t} else if err != nil {\n   289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n   290\t\t\treturn\n   291\t\t}\n   292\t\n   293\t\t// Check if there is more to replicate\n   294\t\tgoto CHECK_MORE\n   295\t}\n   296\t\n   297\t// sendLatestSnapshot is used to send the latest snapshot we have\n   298\t// down to our follower.\n   299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n   300\t\t// Get the snapshots\n   301\t\tsnapshots, err := r.snapshots.List()\n   302\t\tif err != nil {\n   303\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   304\t\t\treturn false, err\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer snapshot.Close()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   381\t\t}\n   382\t\treturn false, nil\n   383\t}\n   384\t\n   385\t// heartbeat is used to periodically invoke AppendEntries on a peer\n   386\t// to ensure they don't time out. This is done async of replicate(),\n   387\t// since that routine could potentially be blocked on disk IO.\n   388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n   389\t\tvar failures uint64\n   390\t\treq := AppendEntriesRequest{\n   391\t\t\tRPCHeader: r.getRPCHeader(),\n   392\t\t\tTerm:      s.currentTerm,\n   393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n   395\t\t}\n   396\t\n   397\t\tvar resp AppendEntriesResponse\n   398\t\tfor {\n   399\t\t\t// Wait for the next heartbeat interval or forced notify\n   400\t\t\tselect {\n   401\t\t\tcase <-s.notifyCh:\n   402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n   403\t\t\tcase <-stopCh:\n   404\t\t\t\treturn\n   405\t\t\t}\n   406\t\n   407\t\t\ts.peerLock.RLock()\n   408\t\t\tpeer := s.peer\n   409\t\t\ts.peerLock.RUnlock()\n   410\t\n   411\t\t\tstart := time.Now()\n   412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n   414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n   415\t\t\t\t\tnextBackoffTime, \"error\", err)\n   416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n   417\t\t\t\tfailures++\n   418\t\t\t\tselect {\n   419\t\t\t\tcase <-time.After(nextBackoffTime):\n   420\t\t\t\tcase <-stopCh:\n   421\t\t\t\t\treturn\n   422\t\t\t\t}\n   423\t\t\t} else {\n   424\t\t\t\tif failures > 0 {\n   425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n   426\t\t\t\t}\n   427\t\t\t\ts.setLastContact()\n   428\t\t\t\tfailures = 0\n   429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n   431\t\n   432\t\t\t\tif !r.noLegacyTelemetry {\n   433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n   434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n   435\t\t\t\t}\n   436\t\n   437\t\t\t\ts.notifyAll(resp.Success)\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n   443\t// and want to switch to a higher performance pipeline mode of replication.\n   444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n   445\t// back to the standard replication which can handle more complex situations.\n   446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n   447\t\ts.peerLock.RLock()\n   448\t\tpeer := s.peer\n   449\t\ts.peerLock.RUnlock()\n   450\t\n   451\t\t// Create a new pipeline\n   452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n   453\t\tif err != nil {\n   454\t\t\treturn err\n   455\t\t}\n   456\t\tdefer pipeline.Close()\n   457\t\n   458\t\t// Log start and stop of pipeline\n   459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n   460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n   461\t\n   462\t\t// Create a shutdown and finish channel\n   463\t\tstopCh := make(chan struct{})\n   464\t\tfinishCh := make(chan struct{})\n   465\t\n   466\t\t// Start a dedicated decoder\n   467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n   468\t\n   469\t\t// Start pipeline sends at the last good nextIndex\n   470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n   471\t\n   472\t\tshouldStop := false\n   473\tSEND:\n   474\t\tfor !shouldStop {\n   475\t\t\tselect {\n   476\t\t\tcase <-finishCh:\n   477\t\t\t\tbreak SEND\n   478\t\t\tcase maxIndex := <-s.stopCh:\n   479\t\t\t\t// Make a best effort to replicate up to this index\n   480\t\t\t\tif maxIndex > 0 {\n   481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n   482\t\t\t\t}\n   483\t\t\t\tbreak SEND\n   484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   487\t\t\t\tif !shouldStop {\n   488\t\t\t\t\tdeferErr.respond(nil)\n   489\t\t\t\t} else {\n   490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   491\t\t\t\t}\n   492\t\t\tcase <-s.triggerCh:\n   493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   498\t\t\t}\n   499\t\t}\n   500\t\n   501\t\t// Stop our decoder, and wait for it to finish\n   502\t\tclose(stopCh)\n   503\t\tselect {\n   504\t\tcase <-finishCh:\n   505\t\tcase <-r.shutdownCh:\n   506\t\t}\n   507\t\treturn nil\n   508\t}\n   509\t\n   510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n   511\t// pipelineReplicate.\n   512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n   513\t\t// Create a new append request\n   514\t\treq := new(AppendEntriesRequest)\n   515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n   516\t\t\treturn true\n   517\t\t}\n   518\t\n   519\t\t// Pipeline the append entries\n   520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n   521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n   522\t\t\treturn true\n   523\t\t}\n   524\t\n   525\t\t// Increase the next send log to avoid re-sending old logs\n   526\t\tif n := len(req.Entries); n > 0 {\n   527\t\t\tlast := req.Entries[n-1]\n   528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n   529\t\t}\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   561\t\t\t\t// Update our replication state\n   562\t\t\t\tupdateLastAppended(s, req)\n   563\t\t\tcase <-stopCh:\n   564\t\t\t\treturn\n   565\t\t\t}\n   566\t\t}\n   567\t}\n   568\t\n   569\t// setupAppendEntries is used to setup an append entries request.\n   570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   571\t\treq.RPCHeader = r.getRPCHeader()\n   572\t\treq.Term = s.currentTerm\n   573\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   574\t\treq.Leader = r.trans.EncodePeer(r.localID, r.localAddr)\n   575\t\treq.LeaderCommitIndex = r.getCommitIndex()\n   576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n   580\t\t\treturn err\n   581\t\t}\n   582\t\treturn nil\n   583\t}\n   584\t\n   585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n   634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n   635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n   636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n   637\t\n   638\t\tif !skipLegacy {\n   639\t\t\t// Duplicated information. Kept for backward compatibility.\n   640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n   641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n   642\t\t}\n   643\t}\n   644\t\n   645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c 'cat -n /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-15-hashicorp_raft-real-run/agent-source/commitment.go /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-15-hashicorp_raft-real-run/agent-source/configuration.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c 'cat -n /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-15-hashicorp_raft-real-run/agent-source/commitment.go /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_16-09-15-hashicorp_raft-real-run/agent-source/configuration.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"sort\"\n     8\t\t\"sync\"\n     9\t)\n    10\t\n    11\t// Commitment is used to advance the leader's commit index. The leader and\n    12\t// replication goroutines report in newly written entries with match(), and\n    13\t// this notifies on commitCh when the commit index has advanced.\n    14\ttype commitment struct {\n    15\t\t// protects matchIndexes and commitIndex\n    16\t\tsync.Mutex\n    17\t\t// notified when commitIndex increases\n    18\t\tcommitCh chan struct{}\n    19\t\t// voter ID to log index: the server stores up through this log entry\n    20\t\tmatchIndexes map[ServerID]uint64\n    21\t\t// a quorum stores up through this log entry. monotonically increases.\n    22\t\tcommitIndex uint64\n    23\t\t// the first index of this leader's term: this needs to be replicated to a\n    24\t\t// majority of the cluster before this leader may mark anything committed\n    25\t\t// (per Raft's commitment rule)\n    26\t\tstartIndex uint64\n    27\t}\n    28\t\n    29\t// newCommitment returns a commitment struct that notifies the provided\n    30\t// channel when log entries have been committed. A new commitment struct is\n    31\t// created each time this server becomes leader for a particular term.\n    32\t// 'configuration' is the servers in the cluster.\n    33\t// 'startIndex' is the first index created in this term (see\n    34\t// its description above).\n    35\tfunc newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n    36\t\tmatchIndexes := make(map[ServerID]uint64)\n    37\t\tfor _, server := range configuration.Servers {\n    38\t\t\tif server.Suffrage == Voter {\n    39\t\t\t\tmatchIndexes[server.ID] = 0\n    40\t\t\t}\n    41\t\t}\n    42\t\treturn &commitment{\n    43\t\t\tcommitCh:     commitCh,\n    44\t\t\tmatchIndexes: matchIndexes,\n    45\t\t\tcommitIndex:  0,\n    46\t\t\tstartIndex:   startIndex,\n    47\t\t}\n    48\t}\n    49\t\n    50\t// Called when a new cluster membership configuration is created: it will be\n    51\t// used to determine commitment from now on. 'configuration' is the servers in\n    52\t// the cluster.\n    53\tfunc (c *commitment) setConfiguration(configuration Configuration) {\n    54\t\tc.Lock()\n    55\t\tdefer c.Unlock()\n    56\t\toldMatchIndexes := c.matchIndexes\n    57\t\tc.matchIndexes = make(map[ServerID]uint64)\n    58\t\tfor _, server := range configuration.Servers {\n    59\t\t\tif server.Suffrage == Voter {\n    60\t\t\t\tc.matchIndexes[server.ID] = oldMatchIndexes[server.ID] // defaults to 0\n    61\t\t\t}\n    62\t\t}\n    63\t\tc.recalculate()\n    64\t}\n    65\t\n    66\t// Called by leader after commitCh is notified\n    67\tfunc (c *commitment) getCommitIndex() uint64 {\n    68\t\tc.Lock()\n    69\t\tdefer c.Unlock()\n    70\t\treturn c.commitIndex\n    71\t}\n    72\t\n    73\t// Match is called once a server completes writing entries to disk: either the\n    74\t// leader has written the new entry or a follower has replied to an\n    75\t// AppendEntries RPC. The given server's disk agrees with this server's log up\n    76\t// through the given index.\n    77\tfunc (c *commitment) match(server ServerID, matchIndex uint64) {\n    78\t\tc.Lock()\n    79\t\tdefer c.Unlock()\n    80\t\tif prev, hasVote := c.matchIndexes[server]; hasVote && matchIndex > prev {\n    81\t\t\tc.matchIndexes[server] = matchIndex\n    82\t\t\tc.recalculate()\n    83\t\t}\n    84\t}\n    85\t\n    86\t// Internal helper to calculate new commitIndex from matchIndexes.\n    87\t// Must be called with lock held.\n    88\tfunc (c *commitment) recalculate() {\n    89\t\tif len(c.matchIndexes) == 0 {\n    90\t\t\treturn\n    91\t\t}\n    92\t\n    93\t\tmatched := make([]uint64, 0, len(c.matchIndexes))\n    94\t\tfor _, idx := range c.matchIndexes {\n    95\t\t\tmatched = append(matched, idx)\n    96\t\t}\n    97\t\tsort.Sort(uint64Slice(matched))\n    98\t\tquorumMatchIndex := matched[(len(matched)-1)/2]\n    99\t\n   100\t\tif quorumMatchIndex > c.commitIndex && quorumMatchIndex >= c.startIndex {\n   101\t\t\tc.commitIndex = quorumMatchIndex\n   102\t\t\tasyncNotifyCh(c.commitCh)\n   103\t\t}\n   104\t}\n   105\t// Copyright (c) HashiCorp, Inc.\n   106\t// SPDX-License-Identifier: MPL-2.0\n   107\t\n   108\tpackage raft\n   109\t\n   110\timport \"fmt\"\n   111\t\n   112\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n   113\ttype ServerSuffrage int\n   114\t\n   115\t// Note: Don't renumber these, since the numbers are written into the log.\n   116\tconst (\n   117\t\t// Voter is a server whose vote is counted in elections and whose match index\n   118\t\t// is used in advancing the leader's commit index.\n   119\t\tVoter ServerSuffrage = iota\n   120\t\t// Nonvoter is a server that receives log entries but is not considered for\n   121\t\t// elections or commitment purposes.\n   122\t\tNonvoter\n   123\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n   124\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n   125\t\t// into a Voter.\n   126\t\t// Deprecated: use Nonvoter instead.\n   127\t\tStaging\n   128\t)\n   129\t\n   130\tfunc (s ServerSuffrage) String() string {\n   131\t\tswitch s {\n   132\t\tcase Voter:\n   133\t\t\treturn \"Voter\"\n   134\t\tcase Nonvoter:\n   135\t\t\treturn \"Nonvoter\"\n   136\t\tcase Staging:\n   137\t\t\treturn \"Staging\"\n   138\t\t}\n   139\t\treturn \"ServerSuffrage\"\n   140\t}\n   141\t\n   142\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n   143\t// to store configuration updates made in the replicated log. In general this is only\n   144\t// necessary for FSMs that mutate durable state directly instead of applying changes\n   145\t// in memory and snapshotting periodically. By storing configuration changes, the\n   146\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n   147\t// without an external snapshot just for persisting the raft configuration.\n   148\ttype ConfigurationStore interface {\n   149\t\t// ConfigurationStore is a superset of the FSM functionality\n   150\t\tFSM\n   151\t\n   152\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n   153\t\t// change is committed. It takes the index at which the configuration was\n   154\t\t// written and the configuration value.\n   155\t\tStoreConfiguration(index uint64, configuration Configuration)\n   156\t}\n   157\t\n   158\ttype nopConfigurationStore struct{}\n   159\t\n   160\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n   161\t\n   162\t// ServerID is a unique string identifying a server for all time.\n   163\ttype ServerID string\n   164\t\n   165\t// ServerAddress is a network address for a server that a transport can contact.\n   166\ttype ServerAddress string\n   167\t\n   168\t// Server tracks the information about a single server in a configuration.\n   169\ttype Server struct {\n   170\t\t// Suffrage determines whether the server gets a vote.\n   171\t\tSuffrage ServerSuffrage\n   172\t\t// ID is a unique string identifying this server for all time.\n   173\t\tID ServerID\n   174\t\t// Address is its network address that a transport can contact.\n   175\t\tAddress ServerAddress\n   176\t}\n   177\t\n   178\t// Configuration tracks which servers are in the cluster, and whether they have\n   179\t// votes. This should include the local server, if it's a member of the cluster.\n   180\t// The servers are listed no particular order, but each should only appear once.\n   181\t// These entries are appended to the log during membership changes.\n   182\ttype Configuration struct {\n   183\t\tServers []Server\n   184\t}\n   185\t\n   186\t// Clone makes a deep copy of a Configuration.\n   187\tfunc (c *Configuration) Clone() (copy Configuration) {\n   188\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n   189\t\treturn\n   190\t}\n   191\t\n   192\t// ConfigurationChangeCommand is the different ways to change the cluster\n   193\t// configuration.\n   194\ttype ConfigurationChangeCommand uint8\n   195\t\n   196\tconst (\n   197\t\t// AddVoter adds a server with Suffrage of Voter.\n   198\t\tAddVoter ConfigurationChangeCommand = iota\n   199\t\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n   200\t\tAddNonvoter\n   201\t\t// DemoteVoter makes a server Nonvoter unless its absent.\n   202\t\tDemoteVoter\n   203\t\t// RemoveServer removes a server entirely from the cluster membership.\n   204\t\tRemoveServer\n   205\t\t// Promote changes a server from Staging to Voter. The command will be a\n   206\t\t// no-op if the server is not Staging.\n   207\t\t// Deprecated: use AddVoter instead.\n   208\t\tPromote\n   209\t\t// AddStaging makes a server a Voter.\n   210\t\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n   211\t\tAddStaging = 0 // explicit 0 to preserve the old value.\n   212\t)\n   213\t\n   214\tfunc (c ConfigurationChangeCommand) String() string {\n   215\t\tswitch c {\n   216\t\tcase AddVoter:\n   217\t\t\treturn \"AddVoter\"\n   218\t\tcase AddNonvoter:\n   219\t\t\treturn \"AddNonvoter\"\n   220\t\tcase DemoteVoter:\n   221\t\t\treturn \"DemoteVoter\"\n   222\t\tcase RemoveServer:\n   223\t\t\treturn \"RemoveServer\"\n   224\t\tcase Promote:\n   225\t\t\treturn \"Promote\"\n   226\t\t}\n   227\t\treturn \"ConfigurationChangeCommand\"\n   228\t}\n   229\t\n   230\t// configurationChangeRequest describes a change that a leader would like to\n   231\t// make to its current configuration. It's used only within a single server\n   232\t// (never serialized into the log), as part of `configurationChangeFuture`.\n   233\ttype configurationChangeRequest struct {\n   234\t\tcommand       ConfigurationChangeCommand\n   235\t\tserverID      ServerID\n   236\t\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n   237\t\t// prevIndex, if nonzero, is the index of the only configuration upon which\n   238\t\t// this change may be applied; if another configuration entry has been\n   239\t\t// added in the meantime, this request will fail.\n   240\t\tprevIndex uint64\n   241\t}\n   242\t\n   243\t// configurations is state tracked on every server about its Configurations.\n   244\t// Note that, per Diego's dissertation, there can be at most one uncommitted\n   245\t// configuration at a time (the next configuration may not be created until the\n   246\t// prior one has been committed).\n   247\t//\n   248\t// One downside to storing just two configurations is that if you try to take a\n   249\t// snapshot when your state machine hasn't yet applied the committedIndex, we\n   250\t// have no record of the configuration that would logically fit into that\n   251\t// snapshot. We disallow snapshots in that case now. An alternative approach,\n   252\t// which LogCabin uses, is to track every configuration change in the\n   253\t// log.\n   254\ttype configurations struct {\n   255\t\t// committed is the latest configuration in the log/snapshot that has been\n   256\t\t// committed (the one with the largest index).\n   257\t\tcommitted Configuration\n   258\t\t// committedIndex is the log index where 'committed' was written.\n   259\t\tcommittedIndex uint64\n   260\t\t// latest is the latest configuration in the log/snapshot (may be committed\n   261\t\t// or uncommitted)\n   262\t\tlatest Configuration\n   263\t\t// latestIndex is the log index where 'latest' was written.\n   264\t\tlatestIndex uint64\n   265\t}\n   266\t\n   267\t// Clone makes a deep copy of a configurations object.\n   268\tfunc (c *configurations) Clone() (copy configurations) {\n   269\t\tcopy.committed = c.committed.Clone()\n   270\t\tcopy.committedIndex = c.committedIndex\n   271\t\tcopy.latest = c.latest.Clone()\n   272\t\tcopy.latestIndex = c.latestIndex\n   273\t\treturn\n   274\t}\n   275\t\n   276\t// hasVote returns true if the server identified by 'id' is a Voter in the\n   277\t// provided Configuration.\n   278\tfunc hasVote(configuration Configuration, id ServerID) bool {\n   279\t\tfor _, server := range configuration.Servers {\n   280\t\t\tif server.ID == id {\n   281\t\t\t\treturn server.Suffrage == Voter\n   282\t\t\t}\n   283\t\t}\n   284\t\treturn false\n   285\t}\n   286\t\n   287\t// inConfiguration returns true if the server identified by 'id' is in the\n   288\t// provided Configuration.\n   289\tfunc inConfiguration(configuration Configuration, id ServerID) bool {\n   290\t\tfor _, server := range configuration.Servers {\n   291\t\t\tif server.ID == id {\n   292\t\t\t\treturn true\n   293\t\t\t}\n   294\t\t}\n   295\t\treturn false\n   296\t}\n   297\t\n   298\t// checkConfiguration tests a cluster membership configuration for common\n   299\t// errors.\n   300\tfunc checkConfiguration(configuration Configuration) error {\n   301\t\tidSet := make(map[ServerID]bool)\n   302\t\taddressSet := make(map[ServerAddress]bool)\n   303\t\tvar voters int\n   304\t\tfor _, server := range configuration.Servers {\n   305\t\t\tif server.ID == \"\" {\n   306\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   307\t\t\t}\n   308\t\t\tif server.Address == \"\" {\n   309\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   310\t\t\t}\n   311\t\t\tif idSet[server.ID] {\n   312\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   313\t\t\t}\n   314\t\t\tidSet[server.ID] = true\n   315\t\t\tif addressSet[server.Address] {\n   316\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   317\t\t\t}\n   318\t\t\taddressSet[server.Address] = true\n   319\t\t\tif server.Suffrage == Voter {\n   320\t\t\t\tvoters++\n   321\t\t\t}\n   322\t\t}\n   323\t\tif voters == 0 {\n   324\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   325\t\t}\n   326\t\treturn nil\n   327\t}\n   328\t\n   329\t// nextConfiguration generates a new Configuration from the current one and a\n   330\t// configuration change request. It's split from appendConfigurationEntry so\n   331\t// that it can be unit tested easily.\n   332\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   333\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   334\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   335\t\t}\n   336\t\n   337\t\tconfiguration := current.Clone()\n   338\t\tswitch change.command {\n   339\t\tcase AddVoter:\n   340\t\t\tnewServer := Server{\n   341\t\t\t\tSuffrage: Voter,\n   342\t\t\t\tID:       change.serverID,\n   343\t\t\t\tAddress:  change.serverAddress,\n   344\t\t\t}\n   345\t\t\tfound := false\n   346\t\t\tfor i, server := range configuration.Servers {\n   347\t\t\t\tif server.ID == change.serverID {\n   348\t\t\t\t\tif server.Suffrage == Voter {\n   349\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   350\t\t\t\t\t} else {\n   351\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   352\t\t\t\t\t}\n   353\t\t\t\t\tfound = true\n   354\t\t\t\t\tbreak\n   355\t\t\t\t}\n   356\t\t\t}\n   357\t\t\tif !found {\n   358\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   359\t\t\t}\n   360\t\tcase AddNonvoter:\n   361\t\t\tnewServer := Server{\n   362\t\t\t\tSuffrage: Nonvoter,\n   363\t\t\t\tID:       change.serverID,\n   364\t\t\t\tAddress:  change.serverAddress,\n   365\t\t\t}\n   366\t\t\tfound := false\n   367\t\t\tfor i, server := range configuration.Servers {\n   368\t\t\t\tif server.ID == change.serverID {\n   369\t\t\t\t\tif server.Suffrage != Nonvoter {\n   370\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   371\t\t\t\t\t} else {\n   372\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   373\t\t\t\t\t}\n   374\t\t\t\t\tfound = true\n   375\t\t\t\t\tbreak\n   376\t\t\t\t}\n   377\t\t\t}\n   378\t\t\tif !found {\n   379\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   380\t\t\t}\n   381\t\tcase DemoteVoter:\n   382\t\t\tfor i, server := range configuration.Servers {\n   383\t\t\t\tif server.ID == change.serverID {\n   384\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   385\t\t\t\t\tbreak\n   386\t\t\t\t}\n   387\t\t\t}\n   388\t\tcase RemoveServer:\n   389\t\t\tfor i, server := range configuration.Servers {\n   390\t\t\t\tif server.ID == change.serverID {\n   391\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   392\t\t\t\t\tbreak\n   393\t\t\t\t}\n   394\t\t\t}\n   395\t\tcase Promote:\n   396\t\t\tfor i, server := range configuration.Servers {\n   397\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   398\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   399\t\t\t\t\tbreak\n   400\t\t\t\t}\n   401\t\t\t}\n   402\t\t}\n   403\t\n   404\t\t// Make sure we didn't do something bad like remove the last voter\n   405\t\tif err := checkConfiguration(configuration); err != nil {\n   406\t\t\treturn Configuration{}, err\n   407\t\t}\n   408\t\n   409\t\treturn configuration, nil\n   410\t}\n   411\t\n   412\t// encodePeers is used to serialize a Configuration into the old peers format.\n   413\t// This is here for backwards compatibility when operating with a mix of old\n   414\t// servers and should be removed once we deprecate support for protocol version 1.\n   415\tfunc encodePeers(configuration Configuration, trans Transport) []byte {\n   416\t\t// Gather up all the voters, other suffrage types are not supported by\n   417\t\t// this data format.\n   418\t\tvar encPeers [][]byte\n   419\t\tfor _, server := range configuration.Servers {\n   420\t\t\tif server.Suffrage == Voter {\n   421\t\t\t\tencPeers = append(encPeers, trans.EncodePeer(server.ID, server.Address))\n   422\t\t\t}\n   423\t\t}\n   424\t\n   425\t\t// Encode the entire array.\n   426\t\tbuf, err := encodeMsgPack(encPeers)\n   427\t\tif err != nil {\n   428\t\t\tpanic(fmt.Errorf(\"failed to encode peers: %v\", err))\n   429\t\t}\n   430\t\n   431\t\treturn buf.Bytes()\n   432\t}\n   433\t\n   434\t// decodePeers is used to deserialize an old list of peers into a Configuration.\n   435\t// This is here for backwards compatibility with old log entries and snapshots;\n   436\t// it should be removed eventually.\n   437\tfunc decodePeers(buf []byte, trans Transport) (Configuration, error) {\n   438\t\t// Decode the buffer first.\n   439\t\tvar encPeers [][]byte\n   440\t\tif err := decodeMsgPack(buf, &encPeers); err != nil {\n   441\t\t\treturn Configuration{}, fmt.Errorf(\"failed to decode peers: %v\", err)\n   442\t\t}\n   443\t\n   444\t\t// Deserialize each peer.\n   445\t\tvar servers []Server\n   446\t\tfor _, enc := range encPeers {\n   447\t\t\tp := trans.DecodePeer(enc)\n   448\t\t\tservers = append(servers, Server{\n   449\t\t\t\tSuffrage: Voter,\n   450\t\t\t\tID:       ServerID(p),\n   451\t\t\t\tAddress:  p,\n   452\t\t\t})\n   453\t\t}\n   454\t\n   455\t\treturn Configuration{Servers: servers}, nil\n   456\t}\n   457\t\n   458\t// EncodeConfiguration serializes a Configuration using MsgPack, or panics on\n   459\t// errors.\n   460\tfunc EncodeConfiguration(configuration Configuration) []byte {\n   461\t\tbuf, err := encodeMsgPack(configuration)\n   462\t\tif err != nil {\n   463\t\t\tpanic(fmt.Errorf(\"failed to encode configuration: %v\", err))\n   464\t\t}\n   465\t\treturn buf.Bytes()\n   466\t}\n   467\t\n   468\t// DecodeConfiguration deserializes a Configuration using MsgPack, or panics on\n   469\t// errors.\n   470\tfunc DecodeConfiguration(buf []byte) Configuration {\n   471\t\tvar configuration Configuration\n   472\t\tif err := decodeMsgPack(buf, &configuration); err != nil {\n   473\t\t\tpanic(fmt.Errorf(\"failed to decode configuration: %v\", err))\n   474\t\t}\n   475\t\treturn configuration\n   476\t}\n","exit_code":0,"status":"completed"}}
