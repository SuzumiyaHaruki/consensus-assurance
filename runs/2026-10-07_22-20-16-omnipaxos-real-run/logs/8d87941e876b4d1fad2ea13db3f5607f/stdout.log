{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'nl -ba ../agent-source/omnipaxos/src/storage/mod.rs | head -240; nl -ba ../agent-source/omnipaxos_storage/src/memory_storage.rs | head -210; nl -ba ../agent-source/omnipaxos/tests/snapshot_test.rs | head -220'","aggregated_output":"     1\tpub(crate) mod internal_storage;\n     2\tmod state_cache;\n     3\t\n     4\tuse super::ballot_leader_election::Ballot;\n     5\t#[cfg(feature = \"unicache\")]\n     6\tuse crate::unicache::*;\n     7\tuse crate::ClusterConfig;\n     8\t#[cfg(feature = \"serde\")]\n     9\tuse serde::{Deserialize, Serialize};\n    10\tuse std::{error::Error, fmt::Debug};\n    11\t\n    12\t/// Type of the entries stored in the log.\n    13\tpub trait Entry: Clone + Debug {\n    14\t    #[cfg(not(feature = \"serde\"))]\n    15\t    /// The snapshot type for this entry type.\n    16\t    type Snapshot: Snapshot<Self>;\n    17\t\n    18\t    #[cfg(feature = \"serde\")]\n    19\t    /// The snapshot type for this entry type.\n    20\t    type Snapshot: Snapshot<Self> + Serialize + for<'a> Deserialize<'a>;\n    21\t\n    22\t    #[cfg(feature = \"unicache\")]\n    23\t    /// The encoded type of some data. If there is a cache hit in UniCache, the data will be replaced and get sent over the network as this type instead. E.g., if `u8` then the cached `Entry` (or field of it) will be sent as `u8` instead.\n    24\t    type Encoded: Encoded;\n    25\t    #[cfg(feature = \"unicache\")]\n    26\t    /// The type representing the encodable parts of an `Entry`. It can be set to `Self` if the whole `Entry` is cachable. See docs of `pre_process()` for an example of deriving `Encodable` from an `Entry`.\n    27\t    type Encodable: Encodable;\n    28\t    #[cfg(feature = \"unicache\")]\n    29\t    /// The type representing the **NOT** encodable parts of an `Entry`. Any `NotEncodable` data will be transmitted in its original form, without encoding. It can be set to `()` if the whole `Entry` is cachable. See docs of `pre_process()` for an example.\n    30\t    type NotEncodable: NotEncodable;\n    31\t\n    32\t    #[cfg(all(feature = \"unicache\", not(feature = \"serde\")))]\n    33\t    /// The type that represents if there was a cache hit or miss in UniCache.\n    34\t    type EncodeResult: Clone + Debug;\n    35\t\n    36\t    #[cfg(all(feature = \"unicache\", feature = \"serde\"))]\n    37\t    /// The type that represents the results of trying to encode i.e., if there was a cache hit or miss in UniCache.\n    38\t    type EncodeResult: Clone + Debug + Serialize + for<'a> Deserialize<'a>;\n    39\t\n    40\t    #[cfg(all(feature = \"unicache\", not(feature = \"serde\")))]\n    41\t    /// The type that represents the results of trying to encode i.e., if there was a cache hit or miss in UniCache.\n    42\t    type UniCache: UniCache<T = Self>;\n    43\t    #[cfg(all(feature = \"unicache\", feature = \"serde\"))]\n    44\t    /// The unicache type for caching popular/re-occurring fields of an entry.\n    45\t    type UniCache: UniCache<T = Self> + Serialize + for<'a> Deserialize<'a>;\n    46\t}\n    47\t\n    48\t/// A StopSign entry that marks the end of a configuration. Used for reconfiguration.\n    49\t#[derive(Clone, Debug, PartialEq)]\n    50\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    51\tpub struct StopSign {\n    52\t    /// The new `Omnipaxos` cluster configuration\n    53\t    pub next_config: ClusterConfig,\n    54\t    /// Metadata for the reconfiguration.\n    55\t    pub metadata: Option<Vec<u8>>,\n    56\t}\n    57\t\n    58\timpl StopSign {\n    59\t    /// Creates a [`StopSign`].\n    60\t    pub fn with(next_config: ClusterConfig, metadata: Option<Vec<u8>>) -> Self {\n    61\t        StopSign {\n    62\t            next_config,\n    63\t            metadata,\n    64\t        }\n    65\t    }\n    66\t}\n    67\t\n    68\t/// Snapshot type. A `Complete` snapshot contains all snapshotted data while `Delta` has snapshotted changes since an earlier snapshot.\n    69\t#[allow(missing_docs)]\n    70\t#[derive(Clone, Debug)]\n    71\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    72\tpub enum SnapshotType<T>\n    73\twhere\n    74\t    T: Entry,\n    75\t{\n    76\t    Complete(T::Snapshot),\n    77\t    Delta(T::Snapshot),\n    78\t}\n    79\t\n    80\t/// Trait for implementing snapshot operations for log entries of type `T` in OmniPaxos.\n    81\tpub trait Snapshot<T>: Clone + Debug\n    82\twhere\n    83\t    T: Entry,\n    84\t{\n    85\t    /// Create a snapshot from the log `entries`.\n    86\t    fn create(entries: &[T]) -> Self;\n    87\t\n    88\t    /// Merge another snapshot `delta` into self.\n    89\t    fn merge(&mut self, delta: Self);\n    90\t\n    91\t    /// Whether `T` is snapshottable. If not, simply return `false` and leave the other functions `unimplemented!()`.\n    92\t    fn use_snapshots() -> bool;\n    93\t\n    94\t    //fn size_hint() -> usize;  // TODO: To let the system know trade-off of using entries vs snapshot?\n    95\t}\n    96\t\n    97\t/// The Result type returned by the storage API.\n    98\tpub type StorageResult<T> = Result<T, Box<dyn Error>>;\n    99\t\n   100\t/// The write operations of the storge implementation.\n   101\t#[derive(Debug)]\n   102\tpub enum StorageOp<T: Entry> {\n   103\t    /// Appends an entry to the end of the log.\n   104\t    AppendEntry(T),\n   105\t    /// Appends entries to the end of the log.\n   106\t    AppendEntries(Vec<T>),\n   107\t    /// Appends entries to the log from the prefix specified by the given index.\n   108\t    AppendOnPrefix(usize, Vec<T>),\n   109\t    /// Sets the round that has been promised.\n   110\t    SetPromise(Ballot),\n   111\t    /// Sets the decided index in the log.\n   112\t    SetDecidedIndex(usize),\n   113\t    /// Sets the latest accepted round.\n   114\t    SetAcceptedRound(Ballot),\n   115\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   116\t    SetCompactedIdx(usize),\n   117\t    /// Removes elements up to the given idx from storage.\n   118\t    Trim(usize),\n   119\t    /// Sets the StopSign used for reconfiguration.\n   120\t    SetStopsign(Option<StopSign>),\n   121\t    /// Sets the snapshot.\n   122\t    SetSnapshot(Option<T::Snapshot>),\n   123\t}\n   124\t\n   125\t/// Trait for implementing the storage backend of Sequence Paxos.\n   126\tpub trait Storage<T>\n   127\twhere\n   128\t    T: Entry,\n   129\t{\n   130\t    /// **Atomically** perform all storage operations in order.\n   131\t    /// For correctness, the operations must be atomic i.e., either all operations are performed\n   132\t    /// successfully or all get rolled back. If the `StorageResult` returns as `Err`, the\n   133\t    /// operations are assumed to have been rolled back to the previous state before this function\n   134\t    /// call.\n   135\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()>;\n   136\t\n   137\t    /// Appends an entry to the end of the log.\n   138\t    fn append_entry(&mut self, entry: T) -> StorageResult<()>;\n   139\t\n   140\t    /// Appends the entries of `entries` to the end of the log.\n   141\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()>;\n   142\t\n   143\t    /// Appends the entries of `entries` to the prefix from index `from_index` (inclusive) in the log.\n   144\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()>;\n   145\t\n   146\t    /// Sets the round that has been promised.\n   147\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()>;\n   148\t\n   149\t    /// Sets the decided index in the log.\n   150\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()>;\n   151\t\n   152\t    /// Returns the decided index in the log.\n   153\t    fn get_decided_idx(&self) -> StorageResult<usize>;\n   154\t\n   155\t    /// Sets the latest accepted round.\n   156\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()>;\n   157\t\n   158\t    /// Returns the latest round in which entries have been accepted, returns `None` if no\n   159\t    /// entries have been accepted.\n   160\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>>;\n   161\t\n   162\t    /// Returns the entries in the log in the index interval of [from, to).\n   163\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   164\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>>;\n   165\t\n   166\t    /// Returns the current length of the log (without the trimmed/snapshotted entries).\n   167\t    fn get_log_len(&self) -> StorageResult<usize>;\n   168\t\n   169\t    /// Returns the suffix of entries in the log from index `from` (inclusive).\n   170\t    /// If entries **do not exist for the complete interval**, an empty Vector should be returned.\n   171\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>>;\n   172\t\n   173\t    /// Returns the round that has been promised.\n   174\t    fn get_promise(&self) -> StorageResult<Option<Ballot>>;\n   175\t\n   176\t    /// Sets the StopSign used for reconfiguration.\n   177\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()>;\n   178\t\n   179\t    /// Returns the stored StopSign, returns `None` if no StopSign has been stored.\n   180\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>>;\n   181\t\n   182\t    /// Removes elements up to the given [`idx`] from storage.\n   183\t    fn trim(&mut self, idx: usize) -> StorageResult<()>;\n   184\t\n   185\t    /// Sets the compacted (i.e. trimmed or snapshotted) index.\n   186\t    fn set_compacted_idx(&mut self, idx: usize) -> StorageResult<()>;\n   187\t\n   188\t    /// Returns the garbage collector index from storage.\n   189\t    fn get_compacted_idx(&self) -> StorageResult<usize>;\n   190\t\n   191\t    /// Sets the snapshot.\n   192\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()>;\n   193\t\n   194\t    /// Returns the stored snapshot.\n   195\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>>;\n   196\t}\n   197\t\n   198\t/// A place holder type for when not using snapshots. You should not use this type, it is only internally when deriving the Entry implementation.\n   199\t#[derive(Copy, Clone, Debug, Eq, PartialEq)]\n   200\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   201\tpub struct NoSnapshot;\n   202\t\n   203\timpl<T: Entry> Snapshot<T> for NoSnapshot {\n   204\t    fn create(_entries: &[T]) -> Self {\n   205\t        panic!(\"NoSnapshot should not be created\");\n   206\t    }\n   207\t\n   208\t    fn merge(&mut self, _delta: Self) {\n   209\t        panic!(\"NoSnapshot should not be merged\");\n   210\t    }\n   211\t\n   212\t    fn use_snapshots() -> bool {\n   213\t        false\n   214\t    }\n   215\t}\n     1\tuse omnipaxos::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    storage::{Entry, StopSign, Storage, StorageOp, StorageResult},\n     4\t};\n     5\t/// An in-memory storage implementation for SequencePaxos.\n     6\t#[derive(Clone)]\n     7\tpub struct MemoryStorage<T>\n     8\twhere\n     9\t    T: Entry,\n    10\t{\n    11\t    /// Vector which contains all the logged entries in-memory.\n    12\t    log: Vec<T>,\n    13\t    /// Last promised round.\n    14\t    n_prom: Option<Ballot>,\n    15\t    /// Last accepted round.\n    16\t    acc_round: Option<Ballot>,\n    17\t    /// Length of the decided log.\n    18\t    ld: usize,\n    19\t    /// Garbage collected index.\n    20\t    trimmed_idx: usize,\n    21\t    /// Stored compact index\n    22\t    compacted_idx: usize,\n    23\t    /// Stored snapshot\n    24\t    snapshot: Option<T::Snapshot>,\n    25\t    /// Stored StopSign\n    26\t    stopsign: Option<StopSign>,\n    27\t}\n    28\t\n    29\timpl<T> Storage<T> for MemoryStorage<T>\n    30\twhere\n    31\t    T: Entry,\n    32\t{\n    33\t    fn write_atomically(&mut self, ops: Vec<StorageOp<T>>) -> StorageResult<()> {\n    34\t        for op in ops {\n    35\t            match op {\n    36\t                StorageOp::AppendEntry(entry) => self.append_entry(entry)?,\n    37\t                StorageOp::AppendEntries(entries) => self.append_entries(entries)?,\n    38\t                StorageOp::AppendOnPrefix(from_idx, entries) => {\n    39\t                    self.append_on_prefix(from_idx, entries)?\n    40\t                }\n    41\t                StorageOp::SetPromise(bal) => self.set_promise(bal)?,\n    42\t                StorageOp::SetDecidedIndex(idx) => self.set_decided_idx(idx)?,\n    43\t                StorageOp::SetAcceptedRound(bal) => self.set_accepted_round(bal)?,\n    44\t                StorageOp::SetCompactedIdx(idx) => self.set_compacted_idx(idx)?,\n    45\t                StorageOp::Trim(idx) => self.trim(idx)?,\n    46\t                StorageOp::SetStopsign(ss) => self.set_stopsign(ss)?,\n    47\t                StorageOp::SetSnapshot(snap) => self.set_snapshot(snap)?,\n    48\t            }\n    49\t        }\n    50\t        Ok(())\n    51\t    }\n    52\t\n    53\t    fn append_entry(&mut self, entry: T) -> StorageResult<()> {\n    54\t        self.log.push(entry);\n    55\t        Ok(())\n    56\t    }\n    57\t\n    58\t    fn append_entries(&mut self, entries: Vec<T>) -> StorageResult<()> {\n    59\t        let mut e = entries;\n    60\t        self.log.append(&mut e);\n    61\t        Ok(())\n    62\t    }\n    63\t\n    64\t    fn append_on_prefix(&mut self, from_idx: usize, entries: Vec<T>) -> StorageResult<()> {\n    65\t        self.log.truncate(from_idx - self.trimmed_idx);\n    66\t        self.append_entries(entries)\n    67\t    }\n    68\t\n    69\t    fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n    70\t        self.n_prom = Some(n_prom);\n    71\t        Ok(())\n    72\t    }\n    73\t\n    74\t    fn set_decided_idx(&mut self, ld: usize) -> StorageResult<()> {\n    75\t        self.ld = ld;\n    76\t        Ok(())\n    77\t    }\n    78\t\n    79\t    fn get_decided_idx(&self) -> StorageResult<usize> {\n    80\t        Ok(self.ld)\n    81\t    }\n    82\t\n    83\t    fn set_accepted_round(&mut self, na: Ballot) -> StorageResult<()> {\n    84\t        self.acc_round = Some(na);\n    85\t        Ok(())\n    86\t    }\n    87\t\n    88\t    fn get_accepted_round(&self) -> StorageResult<Option<Ballot>> {\n    89\t        Ok(self.acc_round)\n    90\t    }\n    91\t\n    92\t    fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n    93\t        let from = from - self.trimmed_idx;\n    94\t        let to = to - self.trimmed_idx;\n    95\t        Ok(self.log.get(from..to).unwrap_or(&[]).to_vec())\n    96\t    }\n    97\t\n    98\t    fn get_log_len(&self) -> StorageResult<usize> {\n    99\t        Ok(self.log.len())\n   100\t    }\n   101\t\n   102\t    fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   103\t        Ok(match self.log.get((from - self.trimmed_idx)..) {\n   104\t            Some(s) => s.to_vec(),\n   105\t            None => vec![],\n   106\t        })\n   107\t    }\n   108\t\n   109\t    fn get_promise(&self) -> StorageResult<Option<Ballot>> {\n   110\t        Ok(self.n_prom)\n   111\t    }\n   112\t\n   113\t    fn set_stopsign(&mut self, s: Option<StopSign>) -> StorageResult<()> {\n   114\t        self.stopsign = s;\n   115\t        Ok(())\n   116\t    }\n   117\t\n   118\t    fn get_stopsign(&self) -> StorageResult<Option<StopSign>> {\n   119\t        Ok(self.stopsign.clone())\n   120\t    }\n   121\t\n   122\t    fn trim(&mut self, trimmed_idx: usize) -> StorageResult<()> {\n   123\t        let to_trim = (trimmed_idx - self.trimmed_idx).min(self.log.len());\n   124\t        self.log.drain(0..to_trim);\n   125\t        self.trimmed_idx = trimmed_idx;\n   126\t        Ok(())\n   127\t    }\n   128\t\n   129\t    fn set_compacted_idx(&mut self, compact_idx: usize) -> StorageResult<()> {\n   130\t        self.compacted_idx = compact_idx;\n   131\t        Ok(())\n   132\t    }\n   133\t\n   134\t    fn get_compacted_idx(&self) -> StorageResult<usize> {\n   135\t        Ok(self.compacted_idx)\n   136\t    }\n   137\t\n   138\t    fn set_snapshot(&mut self, snapshot: Option<T::Snapshot>) -> StorageResult<()> {\n   139\t        self.snapshot = snapshot;\n   140\t        Ok(())\n   141\t    }\n   142\t\n   143\t    fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   144\t        Ok(self.snapshot.clone())\n   145\t    }\n   146\t}\n   147\t\n   148\timpl<T: Entry> Default for MemoryStorage<T> {\n   149\t    fn default() -> Self {\n   150\t        Self {\n   151\t            log: vec![],\n   152\t            n_prom: None,\n   153\t            acc_round: None,\n   154\t            ld: 0,\n   155\t            trimmed_idx: 0,\n   156\t            compacted_idx: 0,\n   157\t            snapshot: None,\n   158\t            stopsign: None,\n   159\t        }\n   160\t    }\n   161\t}\n     1\tpub mod utils;\n     2\t\n     3\tuse crate::utils::{omnireplica::OmniPaxosComponent, ValueSnapshot};\n     4\tuse kompact::prelude::{promise, Ask, Component, FutureCollection};\n     5\tuse omnipaxos::{storage::Snapshot, util::LogEntry};\n     6\tuse serial_test::serial;\n     7\tuse std::{sync::Arc, thread};\n     8\tuse utils::{TestConfig, TestSystem, Value};\n     9\t\n    10\tconst SNAPSHOT_INDEX_INCREMENT: usize = 10;\n    11\t\n    12\t/// Test trimming the log.\n    13\t/// At the end the log is retrieved from each replica and verified\n    14\t/// if the first [`gc_index`] are removed.\n    15\t#[test]\n    16\t#[serial]\n    17\tfn snapshot_test() {\n    18\t    let cfg = TestConfig::load(\"trim_test\").expect(\"Test config loaded\");\n    19\t    let mut sys = TestSystem::with(cfg);\n    20\t    sys.start_all_nodes();\n    21\t    let elected_pid = sys.get_elected_leader(1, cfg.wait_timeout);\n    22\t    let elected_leader = sys.nodes.get(&elected_pid).unwrap();\n    23\t\n    24\t    thread::sleep(cfg.wait_timeout); // wait a little longer so that ALL nodes get prepared with empty logs\n    25\t\n    26\t    let vec_proposals = utils::create_proposals(1, cfg.num_proposals);\n    27\t    let mut futures = vec![];\n    28\t    for v in &vec_proposals {\n    29\t        let (kprom, kfuture) = promise::<()>();\n    30\t        elected_leader.on_definition(|x| {\n    31\t            x.insert_decided_future(Ask::new(kprom, v.clone()));\n    32\t            x.paxos.append(v.clone()).expect(\"Failed to append\");\n    33\t        });\n    34\t        futures.push(kfuture);\n    35\t    }\n    36\t\n    37\t    match FutureCollection::collect_with_timeout::<Vec<_>>(futures, cfg.wait_timeout) {\n    38\t        Ok(_) => {}\n    39\t        Err(e) => panic!(\"Error on collecting futures of decided proposals: {}\", e),\n    40\t    }\n    41\t\n    42\t    elected_leader.on_definition(|x| {\n    43\t        x.paxos\n    44\t            .snapshot(Some(cfg.trim_idx), false)\n    45\t            .expect(\"Failed to trim\");\n    46\t    });\n    47\t\n    48\t    thread::sleep(cfg.wait_timeout);\n    49\t\n    50\t    for (_pid, node) in sys.nodes.iter() {\n    51\t        check_snapshot(&vec_proposals, cfg.trim_idx, node.clone());\n    52\t    }\n    53\t\n    54\t    println!(\"Pass snapshot\");\n    55\t    sys.shutdown();\n    56\t}\n    57\t\n    58\t/// Test trimming the log twice.\n    59\t/// At the end the log is retrieved from each replica and verified\n    60\t/// if the first [`gc_index`] + an increment are removed.\n    61\t#[test]\n    62\t#[serial]\n    63\tfn double_snapshot_test() {\n    64\t    let cfg = TestConfig::load(\"trim_test\").expect(\"Test config loaded\");\n    65\t    let mut sys = TestSystem::with(cfg);\n    66\t    sys.start_all_nodes();\n    67\t    let elected_pid = sys.get_elected_leader(1, cfg.wait_timeout);\n    68\t    let elected_leader = sys.nodes.get(&elected_pid).unwrap();\n    69\t\n    70\t    thread::sleep(cfg.wait_timeout); // wait a little longer so that ALL nodes get prepared with empty logs\n    71\t\n    72\t    let vec_proposals = utils::create_proposals(1, cfg.num_proposals);\n    73\t    let mut futures = vec![];\n    74\t    for v in &vec_proposals {\n    75\t        let (kprom, kfuture) = promise::<()>();\n    76\t        elected_leader.on_definition(|x| {\n    77\t            x.insert_decided_future(Ask::new(kprom, v.clone()));\n    78\t            x.paxos.append(v.clone()).expect(\"Failed to append\");\n    79\t        });\n    80\t        futures.push(kfuture);\n    81\t    }\n    82\t\n    83\t    match FutureCollection::collect_with_timeout::<Vec<_>>(futures, cfg.wait_timeout) {\n    84\t        Ok(_) => {}\n    85\t        Err(e) => panic!(\"Error on collecting futures of decided proposals: {}\", e),\n    86\t    }\n    87\t\n    88\t    elected_leader.on_definition(|x| {\n    89\t        x.paxos\n    90\t            .snapshot(Some(cfg.trim_idx), false)\n    91\t            .expect(\"Failed to trim\");\n    92\t    });\n    93\t\n    94\t    thread::sleep(cfg.wait_timeout);\n    95\t\n    96\t    elected_leader.on_definition(|x| {\n    97\t        x.paxos\n    98\t            .snapshot(Some(cfg.trim_idx + SNAPSHOT_INDEX_INCREMENT), false)\n    99\t            .expect(\"Failed to trim\");\n   100\t    });\n   101\t\n   102\t    thread::sleep(cfg.wait_timeout);\n   103\t\n   104\t    for (_pid, node) in sys.nodes.iter() {\n   105\t        check_snapshot(\n   106\t            &vec_proposals,\n   107\t            cfg.trim_idx + SNAPSHOT_INDEX_INCREMENT,\n   108\t            node.clone(),\n   109\t        );\n   110\t    }\n   111\t\n   112\t    println!(\"Pass double snapshot\");\n   113\t    sys.shutdown();\n   114\t}\n   115\t\n   116\tfn check_snapshot(\n   117\t    vec_proposals: &[Value],\n   118\t    snapshot_idx: usize,\n   119\t    node: Arc<Component<OmniPaxosComponent>>,\n   120\t) {\n   121\t    let exp_snapshot = ValueSnapshot::create(&vec_proposals[0..snapshot_idx]);\n   122\t    let num_proposals = vec_proposals.len();\n   123\t    node.on_definition(|x| {\n   124\t        let op = &x.paxos;\n   125\t        for snapshotted_idx in 0..snapshot_idx {\n   126\t            match op.read(snapshotted_idx).unwrap() {\n   127\t                LogEntry::Snapshotted(s)\n   128\t                    if s.snapshot == exp_snapshot && s.trimmed_idx == snapshot_idx => {}\n   129\t                e => panic!(\n   130\t                    \"Unexpected entry at {}. Should be snapshot with trimmed index {} and latest value: {:?}, but got {:?}\",\n   131\t                    snapshotted_idx, snapshot_idx, exp_snapshot.latest_value, e\n   132\t                ),\n   133\t            }\n   134\t        }\n   135\t        for idx in snapshot_idx..num_proposals {\n   136\t            let expected_value = vec_proposals.get(idx).unwrap();\n   137\t            match op.read(idx).unwrap() {\n   138\t                LogEntry::Decided(v) if &v == expected_value => {}\n   139\t                e => panic!(\n   140\t                    \"Entry {} must be decided with {:?}, but was {:?}\",\n   141\t                    idx, expected_value, e\n   142\t                ),\n   143\t            }\n   144\t        }\n   145\t        let decided_sfx = op.read_decided_suffix(0).unwrap();\n   146\t        assert_eq!(decided_sfx.len(), num_proposals - snapshot_idx + 1); // +1 as all snapshotted entries are represented by LogEntry::Snapshotted\n   147\t    });\n   148\t}\n","exit_code":0,"status":"completed"}}
