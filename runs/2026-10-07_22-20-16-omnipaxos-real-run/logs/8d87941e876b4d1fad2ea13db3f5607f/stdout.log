\"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      }\n    ]\n  },\n  \"capacity\": {\n    \"remaining\": {\n      \"agent_calls\": 39,\n      \"experiments\": 16,\n      \"audit_units\": 6,\n      \"semantic_reviews\": 10,\n      \"revisions\": 6\n    },\n    \"remaining_seconds\": 1796.4960992900014,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  },\n  \"conclusions\": [],\n  \"costs\": {\n    \"agent_calls\": 1,\n    \"agent_seconds\": 0,\n    \"rejected_calls\": 0,\n    \"rejected_call_seconds\": 0,\n    \"formal_executions\": 0,\n    \"formal_execution_seconds\": 0,\n    \"target_action_cost\": {\n      \"known_seconds\": 0,\n      \"unrecorded_check_ids\": [],\n      \"process_unrecorded_check_ids\": []\n    },\n    \"elapsed_seconds\": 3.503900709998561,\n    \"interpretation\": \"formal_execution_seconds is controlled target process time (checks and explorations); target_action_cost includes preparation only where recorded. Parent actions and child steps are not added together. Rejected calls may contain useful investigation; wall time is not token cost\"\n  },\n  \"map_handoffs\": [],\n  \"handoffs\": [],\n  \"pending_work\": [],\n  \"current\": {},\n  \"latest_decision\": null,\n  \"stop\": {},\n  \"stop_reason\": \"Not started\",\n  \"explorations\": [],\n  \"review_issues\": [],\n  \"run_id\": \"7e054152038a47a597bd1d15d29a8083\",\n  \"snapshot_id\": \"6d31e810242643e8917552d67188c1ab\",\n  \"elapsed_seconds\": 3.503900709998561,\n  \"source_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_22-20-16-omnipaxos-real-run/agent-source\",\n  \"draft_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-07_22-20