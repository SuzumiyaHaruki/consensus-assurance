{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '260,540p'\"","aggregated_output":"   260\t    ) -> StorageResult<Option<usize>> {\n   261\t        let append_res = self.state_cache.append_entries(entries);\n   262\t        if let Some(flushed_entries) = append_res {\n   263\t            let accepted_idx = self.append_entries_without_batching(flushed_entries)?;\n   264\t            Ok(Some(accepted_idx))\n   265\t        } else {\n   266\t            Ok(None)\n   267\t        }\n   268\t    }\n   269\t\n   270\t    #[cfg(feature = \"unicache\")]\n   271\t    pub(crate) fn decode_entries(\n   272\t        &mut self,\n   273\t        encoded_entries: Vec<<T as Entry>::EncodeResult>,\n   274\t    ) -> Vec<T> {\n   275\t        encoded_entries\n   276\t            .into_iter()\n   277\t            .map(|x| self.state_cache.unicache.decode(x))\n   278\t            .collect()\n   279\t    }\n   280\t\n   281\t    pub(crate) fn flush_batch(&mut self) -> StorageResult<usize> {\n   282\t        #[cfg(feature = \"unicache\")]\n   283\t        {\n   284\t            // clear the processed batch\n   285\t            self.state_cache.batched_processed_by_leader.clear();\n   286\t        }\n   287\t        let flushed_entries = self.state_cache.take_batched_entries();\n   288\t        self.append_entries_without_batching(flushed_entries)\n   289\t    }\n   290\t\n   291\t    pub(crate) fn flush_batch_and_get_entries(\n   292\t        &mut self,\n   293\t    ) -> StorageResult<Option<AcceptedMetaData<T>>> {\n   294\t        let flushed_entries = if !self.state_cache.batched_entries.is_empty() {\n   295\t            Some(self.state_cache.take_batched_entries())\n   296\t        } else {\n   297\t            None\n   298\t        };\n   299\t        self.flush_if_full_batch(flushed_entries)\n   300\t    }\n   301\t\n   302\t    // Append entries without batching, return the accepted index\n   303\t    pub(crate) fn append_entries_without_batching(\n   304\t        &mut self,\n   305\t        entries: Vec<T>,\n   306\t    ) -> StorageResult<usize> {\n   307\t        let num_new_entries = entries.len();\n   308\t        self.storage.append_entries(entries)?;\n   309\t        self.state_cache.accepted_idx += num_new_entries;\n   310\t        Ok(self.state_cache.accepted_idx)\n   311\t    }\n   312\t\n   313\t    pub(crate) fn sync_log(\n   314\t        &mut self,\n   315\t        accepted_round: Ballot,\n   316\t        decided_idx: usize,\n   317\t        log_sync: Option<LogSync<T>>,\n   318\t    ) -> StorageResult<usize> {\n   319\t        self.state_cache.accepted_round = accepted_round;\n   320\t        self.state_cache.decided_idx = decided_idx;\n   321\t        let mut sync_txn: Vec<StorageOp<T>> = vec![\n   322\t            StorageOp::SetAcceptedRound(accepted_round),\n   323\t            StorageOp::SetDecidedIndex(decided_idx),\n   324\t        ];\n   325\t        if let Some(sync) = log_sync {\n   326\t            match sync.decided_snapshot {\n   327\t                Some(SnapshotType::Complete(c)) => {\n   328\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   329\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   330\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   331\t                    sync_txn.push(StorageOp::SetSnapshot(Some(c)));\n   332\t                }\n   333\t                Some(SnapshotType::Delta(d)) => {\n   334\t                    let mut snapshot = self.create_decided_snapshot()?;\n   335\t                    snapshot.merge(d);\n   336\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   337\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   338\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   339\t                    sync_txn.push(StorageOp::SetSnapshot(Some(snapshot)));\n   340\t                }\n   341\t                None => (),\n   342\t            }\n   343\t            self.state_cache.accepted_idx = sync.sync_idx + sync.suffix.len();\n   344\t            sync_txn.push(StorageOp::AppendOnPrefix(sync.sync_idx, sync.suffix));\n   345\t            match sync.stopsign {\n   346\t                Some(ss) => {\n   347\t                    self.state_cache.stopsign = Some(ss.clone());\n   348\t                    self.state_cache.accepted_idx += 1;\n   349\t                    sync_txn.push(StorageOp::SetStopsign(Some(ss)));\n   350\t                }\n   351\t                None if self.state_cache.stopsign.is_some() => {\n   352\t                    self.state_cache.stopsign = None;\n   353\t                    sync_txn.push(StorageOp::SetStopsign(None));\n   354\t                }\n   355\t                None => (),\n   356\t            }\n   357\t        }\n   358\t        self.storage.write_atomically(sync_txn)?;\n   359\t        Ok(self.state_cache.accepted_idx)\n   360\t    }\n   361\t\n   362\t    fn create_decided_snapshot(&mut self) -> StorageResult<T::Snapshot> {\n   363\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   364\t        self.create_snapshot(log_decided_idx)\n   365\t    }\n   366\t\n   367\t    pub(crate) fn create_snapshot(&self, compact_idx: usize) -> StorageResult<T::Snapshot> {\n   368\t        let current_compacted_idx = self.get_compacted_idx();\n   369\t        if compact_idx < current_compacted_idx {\n   370\t            Err(CompactionErr::TrimmedIndex(current_compacted_idx))?\n   371\t        }\n   372\t        let entries = self\n   373\t            .storage\n   374\t            .get_entries(current_compacted_idx, compact_idx)?;\n   375\t        let delta = T::Snapshot::create(entries.as_slice());\n   376\t        match self.storage.get_snapshot()? {\n   377\t            Some(mut s) => {\n   378\t                s.merge(delta);\n   379\t                Ok(s)\n   380\t            }\n   381\t            None => Ok(delta),\n   382\t        }\n   383\t    }\n   384\t\n   385\t    // Creates a Delta snapshot of entries from `from_idx` to the end of the decided log and also\n   386\t    // returns the compacted idx of the created snapshot. If the range of entries contains entries\n   387\t    // which have already been compacted a valid delta cannot be created, so creates a Complete\n   388\t    // snapshot of the entire decided log instead.\n   389\t    pub(crate) fn create_diff_snapshot(\n   390\t        &self,\n   391\t        from_idx: usize,\n   392\t    ) -> StorageResult<(Option<SnapshotType<T>>, usize)> {\n   393\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   394\t        let compacted_idx = self.get_compacted_idx();\n   395\t        let snapshot = if from_idx <= compacted_idx {\n   396\t            // Some entries in range are compacted, snapshot entire decided log\n   397\t            if compacted_idx < log_decided_idx {\n   398\t                Some(SnapshotType::Complete(\n   399\t                    self.create_snapshot(log_decided_idx)?,\n   400\t                ))\n   401\t            } else {\n   402\t                // Entire decided log already snapshotted\n   403\t                self.get_snapshot()?.map(|s| SnapshotType::Complete(s))\n   404\t            }\n   405\t        } else {\n   406\t            let diff_entries = self.get_entries(from_idx, log_decided_idx)?;\n   407\t            Some(SnapshotType::Delta(T::Snapshot::create(\n   408\t                diff_entries.as_slice(),\n   409\t            )))\n   410\t        };\n   411\t        Ok((snapshot, log_decided_idx))\n   412\t    }\n   413\t\n   414\t    pub(crate) fn try_trim(&mut self, idx: usize) -> StorageResult<()> {\n   415\t        let decided_idx = self.get_decided_idx();\n   416\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   417\t        let new_compacted_idx = match idx.cmp(&decided_idx) {\n   418\t            Ordering::Less => idx,\n   419\t            Ordering::Equal => log_decided_idx,\n   420\t            Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   421\t        };\n   422\t        if new_compacted_idx > self.get_compacted_idx() {\n   423\t            self.storage.write_atomically(vec![\n   424\t                StorageOp::Trim(new_compacted_idx),\n   425\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   426\t            ])?;\n   427\t            self.state_cache.compacted_idx = new_compacted_idx;\n   428\t        }\n   429\t        Ok(())\n   430\t    }\n   431\t\n   432\t    pub(crate) fn try_snapshot(&mut self, snapshot_idx: Option<usize>) -> StorageResult<()> {\n   433\t        let decided_idx = self.get_decided_idx();\n   434\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   435\t        let new_compacted_idx = match snapshot_idx {\n   436\t            Some(i) => match i.cmp(&decided_idx) {\n   437\t                Ordering::Less => i,\n   438\t                Ordering::Equal => log_decided_idx,\n   439\t                Ordering::Greater => Err(CompactionErr::UndecidedIndex(decided_idx))?,\n   440\t            },\n   441\t            None => log_decided_idx,\n   442\t        };\n   443\t        if new_compacted_idx > self.get_compacted_idx() {\n   444\t            let snapshot = self.create_snapshot(new_compacted_idx)?;\n   445\t            self.storage.write_atomically(vec![\n   446\t                StorageOp::Trim(new_compacted_idx),\n   447\t                StorageOp::SetCompactedIdx(new_compacted_idx),\n   448\t                StorageOp::SetSnapshot(Some(snapshot)),\n   449\t            ])?;\n   450\t            self.state_cache.compacted_idx = new_compacted_idx;\n   451\t        }\n   452\t        Ok(())\n   453\t    }\n   454\t\n   455\t    pub(crate) fn set_promise(&mut self, n_prom: Ballot) -> StorageResult<()> {\n   456\t        self.state_cache.promise = n_prom;\n   457\t        self.storage.set_promise(n_prom)\n   458\t    }\n   459\t\n   460\t    pub(crate) fn set_decided_idx(&mut self, idx: usize) -> StorageResult<()> {\n   461\t        self.state_cache.decided_idx = idx;\n   462\t        self.storage.set_decided_idx(idx)\n   463\t    }\n   464\t\n   465\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   466\t        self.state_cache.decided_idx\n   467\t    }\n   468\t\n   469\t    fn get_decided_idx_without_stopsign(&self) -> usize {\n   470\t        match self.stopsign_is_decided() {\n   471\t            true => self.get_decided_idx() - 1,\n   472\t            false => self.get_decided_idx(),\n   473\t        }\n   474\t    }\n   475\t\n   476\t    pub(crate) fn get_accepted_round(&self) -> Ballot {\n   477\t        self.state_cache.accepted_round\n   478\t    }\n   479\t\n   480\t    pub(crate) fn get_entries(&self, from: usize, to: usize) -> StorageResult<Vec<T>> {\n   481\t        self.storage.get_entries(from, to)\n   482\t    }\n   483\t\n   484\t    /// The length of the replicated log, as if log was never compacted.\n   485\t    pub(crate) fn get_accepted_idx(&self) -> usize {\n   486\t        self.state_cache.accepted_idx\n   487\t    }\n   488\t\n   489\t    /// The number of entries currently buffered for batching, not yet reflected\n   490\t    /// in `get_accepted_idx()`.\n   491\t    pub(crate) fn get_batched_len(&self) -> usize {\n   492\t        self.state_cache.batched_entries.len()\n   493\t    }\n   494\t\n   495\t    pub(crate) fn get_suffix(&self, from: usize) -> StorageResult<Vec<T>> {\n   496\t        self.storage.get_suffix(from)\n   497\t    }\n   498\t\n   499\t    pub(crate) fn get_promise(&self) -> Ballot {\n   500\t        self.state_cache.promise\n   501\t    }\n   502\t\n   503\t    pub(crate) fn set_stopsign(&mut self, ss: Option<StopSign>) -> StorageResult<usize> {\n   504\t        if ss.is_some() && self.state_cache.stopsign.is_none() {\n   505\t            self.state_cache.accepted_idx += 1;\n   506\t        } else if ss.is_none() && self.state_cache.stopsign.is_some() {\n   507\t            self.state_cache.accepted_idx -= 1;\n   508\t        }\n   509\t        self.state_cache.stopsign.clone_from(&ss);\n   510\t        self.storage.set_stopsign(ss)?;\n   511\t        Ok(self.state_cache.accepted_idx)\n   512\t    }\n   513\t\n   514\t    pub(crate) fn get_stopsign(&self) -> Option<StopSign> {\n   515\t        self.state_cache.stopsign.clone()\n   516\t    }\n   517\t\n   518\t    // Returns whether a stopsign is decided\n   519\t    pub(crate) fn stopsign_is_decided(&self) -> bool {\n   520\t        self.state_cache.stopsign_is_decided()\n   521\t    }\n   522\t\n   523\t    pub(crate) fn get_snapshot(&self) -> StorageResult<Option<T::Snapshot>> {\n   524\t        self.storage.get_snapshot()\n   525\t    }\n   526\t\n   527\t    pub(crate) fn get_compacted_idx(&self) -> usize {\n   528\t        self.state_cache.compacted_idx\n   529\t    }\n   530\t\n   531\t    #[cfg(feature = \"unicache\")]\n   532\t    pub(crate) fn get_unicache(&self) -> T::UniCache {\n   533\t        self.state_cache.unicache.clone()\n   534\t    }\n   535\t\n   536\t    #[cfg(feature = \"unicache\")]\n   537\t    pub(crate) fn set_unicache(&mut self, unicache: T::UniCache) {\n   538\t        self.state_cache.unicache = unicache;\n   539\t    }\n   540\t}\n","exit_code":0,"status":"completed"}}
