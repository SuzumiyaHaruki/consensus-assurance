n            \"protocol_candidate\"\n          ],\n          \"title\": \"Kind\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"file\",\n        \"start_line\",\n        \"end_line\",\n        \"kind\"\n      ],\n      \"title\": \"SourceRange\",\n      \"type\": \"object\"\n    },\n    \"StopSubmission\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"sources\": {\n          \"default\": [],\n          \"items\": {\n            \"$ref\": \"#/$defs/SourceRange\"\n          },\n          \"title\": \"Sources\",\n          \"type\": \"array\"\n        },\n        \"feedback\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/ResearchFeedback\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"repair_of\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n          \"title\": \"Repair Of\"\n        },\n        \"action\": {\n          \"const\": \"stop\",\n          \"title\": \"Action\",\n          \"type\": \"string\"\n        },\n        \"scope\": {\n          \"enum\": [\n            \"candidate\",\n            \"family\",\n            \"focus\",\n            \"run\"\n          ],\n          \"title\": \"Scope\",\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"enum\": [\n            \"bounded_completed\",\n            \"insufficient_basis\",\n            \"tool_gap\",\n            \"resource_limit\",\n            \"user_stop\",\n            \"no_actionable_direction\"\n          ],\n          \"title\": \"Reason\",\n          \"type\": \"string\"\n        },\n        \"ref_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Ref Ids\",\n          \"type\": \"array\"\n        },\n        \"resume_conditions\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Resume Conditions\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"scope\",\n        \"reason\"\n      ],\n      \"title\": \"StopSubmission\",\n      \"type\": \"object\"\n    },\n    \"UnderstandingChange\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"impact\": {\n          \"enum\": [\n            \"clarification\",\n            \"meaning\",\n            \"dependency\"\n          ],\n          \"title\": \"Impact\",\n          \"type\": \"string\"\n        },\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"preserves\": {\n          \"default\": \"\",\n          \"description\": \"Shared sourced explanation of why the existing propositions, premises and observations still apply\",\n          \"title\": \"Preserves\",\n          \"type\": \"string\"\n        },\n        \"challenges\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Saved Candidate IDs and the concrete premise or interpretation challenged by this knowledge\",\n          \"title\": \"Challenges\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"impact\",\n        \"rationale\",\n        \"source_ids\"\n      ],\n      \"title\": \"UnderstandingChange\",\n      \"type\": \"object\"\n    }\n  },\n  \"discriminator\": {\n    \"mapping\": {\n      \"check\": \"#/$defs/CheckSubmission\",\n      \"continue\": \"#/$defs/CandidateSubmission\",\n      \"explained\": \"#/$defs/CandidateSubmission\",\n      \"explore\": \"#/$defs/ExploreSubmission\",\n      \"obligation\": \"#/$defs/CandidateSubmission\",\n      \"pause\": \"#/$defs/CandidateSubmission\",\n      \"research\": \"#/$defs/ResearchSubmission\",\n      \"review\": \"#/$defs/ReviewSubmission\",\n      \"revise_check\": \"#/$defs/CheckSubmission\",\n      \"semantic_revision\": \"#/$defs/SemanticSubmission\",\n      \"stop\": \"#/$defs/StopSubmission\"\n    },\n    \"propertyName\": \"action\"\n  },\n  \"oneOf\": [\n    {\n      \"$ref\": \"#/$defs/CandidateSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/CheckSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ResearchSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/SemanticSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ReviewSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ExploreSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/StopSubmission\"\n    }\n  ]\n}","exit_code":0,"status":"completed"}}
