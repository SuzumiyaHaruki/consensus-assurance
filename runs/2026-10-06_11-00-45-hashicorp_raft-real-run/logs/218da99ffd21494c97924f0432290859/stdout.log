{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"grep -n '\"'^func '\"' ../agent-source/inmem_transport.go; sed -n '100,220p' ../agent-source/inmem_transport.go; sed -n '1010,1029p' ../agent-source/api.go; grep -n -A25 'func .*shutdownFuture' ../agent-source/future.go; cat ../direct-checks/aa0a66a272eb4347918f655825ece907/plan.json\"","aggregated_output":"// This is not a graceful operation. Provides a future that\n// can be used to block until all background routines have exited.\nfunc (r *Raft) Shutdown() Future {\n\tr.shutdownLock.Lock()\n\tdefer r.shutdownLock.Unlock()\n\n\tif !r.shutdown {\n\t\tclose(r.shutdownCh)\n\t\tr.shutdown = true\n\t\tr.setState(Shutdown)\n\t\treturn &shutdownFuture{r}\n\t}\n\n\t// avoid closing transport twice\n\treturn &shutdownFuture{nil}\n}\n\n// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n// that can be used to block until complete, and that contains a function that\n// can be used to open the snapshot.\n171:func (s *shutdownFuture) Error() error {\n172-\tif s.raft == nil {\n173-\t\treturn nil\n174-\t}\n175-\ts.raft.waitShutdown()\n176-\tif closeable, ok := s.raft.trans.(WithClose); ok {\n177-\t\tcloseable.Close()\n178-\t}\n179-\treturn nil\n180-}\n181-\n182-// userSnapshotFuture is used for waiting on a user-triggered snapshot to\n183-// complete.\n184-type userSnapshotFuture struct {\n185-\tdeferError\n186-\n187-\t// opener is a function used to open the snapshot. This is filled in\n188-\t// once the future returns with no error.\n189-\topener func() (*SnapshotMeta, io.ReadCloser, error)\n190-}\n191-\n192-// Open is a function you can call to access the underlying snapshot and its\n193-// metadata.\n194-func (u *userSnapshotFuture) Open() (*SnapshotMeta, io.ReadCloser, error) {\n195-\tif u.opener == nil {\n196-\t\treturn nil, nil, fmt.Errorf(\"no snapshot available\")\n{\n  \"description\": \"Fresh fixed check of nonvoter support substitution after real election and before any successful voter replication. Observes public future completion, transport successes by peer identity, configured voter threshold and state. No stale read is claimed.\",\n  \"claim_id\": \"C-verify-eligible\",\n  \"binding_ids\": [\n    \"BD-verify-register\"\n  ],\n  \"harness\": {\n    \"execution_package\": \".\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"io\\\"\\n \\\"sync\\\"\\n \\\"testing\\\"\\n \\\"time\\\"\\n)\\n\\ntype assuranceVerifyTransport struct {\\n *InmemTransport\\n mu sync.Mutex\\n blocked map[ServerID]bool\\n positive map[ServerID]int\\n denied map[ServerID]int\\n}\\nfunc (a *assuranceVerifyTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\\n a.mu.Lock()\\n blocked := a.blocked[id]\\n if blocked { a.denied[id]++ }\\n a.mu.Unlock()\\n if blocked { return fmt.Errorf(\\\"controlled unavailable voter %s\\\", id) }\\n err := a.InmemTransport.AppendEntries(id, addr, req, resp)\\n if err == nil && resp.Success { a.mu.Lock(); a.positive[id]++; a.mu.Unlock() }\\n return err\\n}\\nfunc (a *assuranceVerifyTransport) AppendEntriesPipeline(id ServerID, addr ServerAddress) (AppendPipeline,error) {\\n return nil, ErrPipelineReplicationNotSupported\\n}\\nfunc assuranceVerifyEvent(v map[string]interface{}) {\\n b, _ := json.Marshal(v)\\n fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\nfunc TestAssuranceVerifyNonvoterEligibility(t *testing.T) {\\n ids := []ServerID{\\\"a\\\", \\\"b\\\", \\\"c\\\", \\\"n\\\"}\\n membership := Configuration{}\\n for i,id := range ids { suffrage:=Voter; if i==3 { suffrage=Nonvoter }; membership.Servers=append(membership.Servers,Server{ID:id,Address:ServerAddress(id),Suffrage:suffrage}) }\\n nodes:=make([]*Raft,4)\\n transports:=make([]*InmemTransport,4)\\n var outbound *assuranceVerifyTransport\\n for i,id:=range ids {\\n  _,tr:=NewInmemTransport(ServerAddress(id));transports[i]=tr\\n  cfg:=DefaultConfig();cfg.LocalID=id;cfg.skipStartup=true;cfg.PreVoteDisabled=true\\n  cfg.HeartbeatTimeout=5*time.Second;cfg.ElectionTimeout=5*time.Second;cfg.LeaderLeaseTimeout=5*time.Second;cfg.LogOutput=io.Discard\\n  store:=NewInmemStore();snaps:=NewInmemSnapshotStore()\\n  var transport Transport=tr\\n  if i==0 { outbound=&assuranceVerifyTransport{InmemTransport:tr,blocked:map[ServerID]bool{},positive:map[ServerID]int{},denied:map[ServerID]int{}};transport=outbound }\\n  if err:=BootstrapCluster(cfg,store,store,snaps,transport,membership);err!=nil {t.Fatal(err)}\\n  r,err:=NewRaft(cfg,&MockFSM{},store,store,snaps,transport);if err!=nil {t.Fatal(err)};nodes[i]=r\\n }\\n for i,tr:=range transports { for j,peer:=range transports {if i!=j {tr.Connect(ServerAddress(ids[j]),peer)}} }\\n stop:=make(chan struct{});var pumps sync.WaitGroup\\n // Serialize each follower's real handlers; election timers are not run during this bounded schedule.\\n for i:=1;i<4;i++ {r:=nodes[i];pumps.Add(1);go func(){defer pumps.Done();for {select {case rpc:=<-r.rpcCh:r.processRPC(rpc);case <-stop:return}}}()}\\n defer func(){for _,r:=range nodes {if err:=r.Shutdown().Error();err!=nil {t.Error(err)}};close(stop);pumps.Wait();for _,tr:=range transports {tr.Close()}}()\\n leader:=nodes[0]\\n leader.setState(Candidate)\\n leader.runCandidate()\\n if leader.State()!=Leader {t.Fatalf(\\\"election not won: %v\\\",leader.State())}\\n // No replication goroutine has started, hence there are no earlier append replies to drain.\\n outbound.mu.Lock();outbound.blocked[\\\"b\\\"]=true;outbound.blocked[\\\"c\\\"]=true;outbound.mu.Unlock()\\n assuranceVerifyEvent(map[string]interface{}{\\\"event\\\":\\\"prepared\\\",\\\"operation\\\":\\\"verify-1\\\",\\\"term\\\":leader.CurrentTerm(),\\\"state\\\":leader.State().String(),\\\"voters\\\":3,\\\"nonvoters\\\":1,\\\"policy\\\":\\\"only_nonvoter_append_replies\\\",\\\"replication_started\\\":false})\\n leader.goFunc(leader.runLeader)\\n future:=leader.VerifyLeader()\\n assuranceVerifyEvent(map[string]interface{}{\\\"event\\\":\\\"admitted\\\",\\\"operation\\\":\\\"verify-1\\\",\\\"policy\\\":\\\"only_nonvoter_append_replies\\\"})\\n done:=make(chan error,1);go func(){done<-future.Error()}()\\n select {\\n case err:=<-done:\\n  outbound.mu.Lock();positive:=map[ServerID]int{};denied:=map[ServerID]int{};for id,n:=range outbound.positive {positive[id]=n};for id,n:=range outbound.denied {denied[id]=n};outbound.mu.Unlock()\\n  errText:=\\\"\\\";if err!=nil {errText=err.Error()}\\n  eligible:=1;totalVoters:=0\\n  for _,server:=range membership.Servers {if server.Suffrage==Voter {totalVoters++;if server.ID!=leader.localID && positive[server.ID]>0 {eligible++}}}\\n  quorum:=totalVoters/2+1\\n  assuranceVerifyEvent(map[string]interface{}{\\\"event\\\":\\\"result\\\",\\\"operation\\\":\\\"verify-1\\\",\\\"success\\\":err==nil,\\\"completed\\\":true,\\\"eligible_voter_quorum\\\":eligible>=quorum,\\\"eligible_voter_support\\\":eligible,\\\"quorum\\\":quorum,\\\"error\\\":errText,\\\"positive_append_responses\\\":positive,\\\"blocked_calls\\\":denied,\\\"state\\\":leader.State().String(),\\\"term\\\":leader.CurrentTerm()})\\n case <-time.After(2*time.Second):\\n  assuranceVerifyEvent(map[string]interface{}{\\\"event\\\":\\\"bounded_pending\\\",\\\"operation\\\":\\\"verify-1\\\"})\\n  leader.Shutdown()\\n  select {case <-done:case <-time.After(time.Second):t.Fatal(\\\"verification waiter did not exit after shutdown\\\")}\\n }\\n}\\n\",\n    \"description\": \"Four constructor-built nodes, serialized real follower RPC dispatch, real candidate election, voter append failures established before leader replication, and public VerifyLeader observation.\",\n    \"semantic_changes\": [\n      \"skipStartup and manual follower RPC pumps select a bounded schedule with follower election timers delayed\",\n      \"Transport wrapper returns errors to selected voter appends and declares pipelining unsupported; it delegates other operations unchanged\",\n      \"No edits to target implementation; mutex-protected counters instrument only transport responses\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prepared\",\n        \"event\": \"prepared\",\n        \"conditions\": [\n          {\n            \"field\": \"state\",\n            \"op\": \"eq\",\n            \"value\": \"Leader\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"voters\",\n            \"op\": \"eq\",\n            \"value\": 3,\n            \"reference\": null\n          },\n          {\n            \"field\": \"nonvoters\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          },\n          {\n            \"field\": \"replication_started\",\n            \"op\": \"eq\",\n            \"value\": false,\n            \"reference\": null\n          },\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": \"only_nonvoter_append_replies\",\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"operation\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prepared.operation\"\n          },\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prepared.policy\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"M-bootstrap\",\n        \"M-start\",\n        \"M-skip-start\",\n        \"M-elect-producer\",\n        \"M-election\",\n        \"M-leader\",\n        \"M-trans-contract\",\n        \"M-heartbeat\",\n        \"M-append\",\n        \"M-api-verify\",\n        \"M-future\"\n      ],\n      \"expectation_ids\": [\n        \"M-api-verify\"\n      ],\n      \"binding_ids\": [],\n      \"derivation\": \"Bootstrap each node with the same valid 3-voter/1-nonvoter configuration. NewRaft skipStartup is a testing scheduler boundary; follower pumps run actual processRPC serially. Actual runCandidate/electSelf request real persisted votes from voters. No replication starts before the transport policy blocks b/c appends. Only then runLeader starts and public VerifyLeader is enqueued. Thus no pre-policy successful voter append can race registration. The wrapper returns transport errors for voter appends and disables optional pipeline; nonvoter requests traverse real transport and appendEntries. No target protocol logic is changed.\",\n      \"applicability\": \"Bounded prefix before the 5-second leader lease. Follower election timers are unscheduled during the finite experiment. Two-second observation limit is a harness bound, not a claimed protocol deadline. New leader noop is not committed; VerifyLeader has no current-term-commit admission requirement, and the obligation only concerns its tally eligibility.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"A narrower direct vote(bool) call would omit public completion and actual response production; this check retains those paths.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"MON-verify\",\n      \"checker_id\": \"CHK-verify\",\n      \"event\": \"result\",\n      \"binding_ids\": [\n        \"BD-verify-register\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"M-verify-register\",\n          \"M-verify-vote\",\n          \"M-notify\",\n          \"M-consume\",\n          \"M-leader\",\n          \"M-heartbeat\",\n          \"M-api-verify\",\n          \"M-future\"\n        ],\n        \"expectation_ids\": [\n          \"M-api-verify\",\n          \"M-suffrage-contract\",\n          \"M-lease\"\n        ],\n        \"binding_ids\": [\n          \"BD-verify-register\"\n        ],\n        \"derivation\": \"One operation ID correlates prepared policy, API admission and eventual future Error result. success is err==nil. eligible voter support counts local voter plus distinct configured voter IDs with successful append responses since before leader replication began. This is an upper bound on eligible support attributable to the request; observing no voter response even in that wider interval suffices for the selected missing-voter witness. No response sampling infers a quorum from nonvoters.\",\n        \"applicability\": \"Result fields sampled after Error returns and transport maps copied under their mutex. Absence of a result remains unknown. Non-completion event is diagnostic only.\",\n        \"unresolved\": [\n          \"The positive-support count does not prove exact per-request voter callback causality if other scenarios deliver voter responses; this declared scenario blocks all of them.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"CHK-verify\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"eligible_voter_quorum\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"operation\"\n      ],\n      \"description\": \"Successful verification requires an eligible voter quorum; failed verification is not a claim that the quorum exists.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Formal review must assess composed normative eligibility inference.\",\n    \"No second leader, stale read or infinite non-completion is asserted.\"\n  ]\n}","exit_code":0,"status":"completed"}}
