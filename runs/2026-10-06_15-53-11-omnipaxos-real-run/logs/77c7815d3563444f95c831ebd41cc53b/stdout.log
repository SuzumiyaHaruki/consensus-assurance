{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/storage/internal_storage.rs | sed -n '30,90p;303,365p'; nl -ba ../agent-source/omnipaxos/src/sequence_paxos/mod.rs | sed -n '345,465p'; python3 - <<'PY'\nimport json\ns=json.load(open('../product-schemas.json'))['ConsensusAuditSpec']\nfor n in ['ConsensusAuditSpec','Activity','CoreOverview','Behavior','Fact','Surface']:\n d=s if n=='ConsensusAuditSpec' else s['\"'$defs'\"'].get(n,{})\n print(n, json.dumps(d))\nPY\"","aggregated_output":"    30\t}\n    31\t\n    32\timpl<I, T> InternalStorage<I, T>\n    33\twhere\n    34\t    I: Storage<T>,\n    35\t    T: Entry,\n    36\t{\n    37\t    pub(crate) fn with(\n    38\t        storage: I,\n    39\t        config: InternalStorageConfig,\n    40\t        #[cfg(feature = \"unicache\")] pid: NodeId,\n    41\t    ) -> Self {\n    42\t        let mut internal_store = InternalStorage {\n    43\t            storage,\n    44\t            state_cache: StateCache::new(\n    45\t                config,\n    46\t                #[cfg(feature = \"unicache\")]\n    47\t                pid,\n    48\t            ),\n    49\t            _t: Default::default(),\n    50\t        };\n    51\t        internal_store.load_cache();\n    52\t        internal_store\n    53\t    }\n    54\t\n    55\t    fn load_cache(&mut self) {\n    56\t        self.state_cache.promise = self\n    57\t            .storage\n    58\t            .get_promise()\n    59\t            .expect(\"Failed to load cache from storage.\")\n    60\t            .unwrap_or_default();\n    61\t        self.state_cache.decided_idx = self.storage.get_decided_idx().unwrap();\n    62\t        self.state_cache.accepted_round = self\n    63\t            .storage\n    64\t            .get_accepted_round()\n    65\t            .unwrap()\n    66\t            .unwrap_or_default();\n    67\t        self.state_cache.compacted_idx = self.storage.get_compacted_idx().unwrap();\n    68\t        self.state_cache.stopsign = self.storage.get_stopsign().unwrap();\n    69\t        self.state_cache.accepted_idx =\n    70\t            self.storage.get_log_len().unwrap() + self.state_cache.compacted_idx;\n    71\t        if self.state_cache.stopsign.is_some() {\n    72\t            self.state_cache.accepted_idx += 1;\n    73\t        }\n    74\t    }\n    75\t\n    76\t    /// Read all decided entries from `from_idx` in the log. Returns `None` if `from_idx` is out of bounds.\n    77\t    pub(crate) fn read_decided_suffix(\n    78\t        &self,\n    79\t        from_idx: usize,\n    80\t    ) -> StorageResult<Option<Vec<LogEntry<T>>>> {\n    81\t        let decided_idx = self.get_decided_idx();\n    82\t        if from_idx < decided_idx {\n    83\t            self.read(from_idx..decided_idx)\n    84\t        } else {\n    85\t            Ok(None)\n    86\t        }\n    87\t    }\n    88\t\n    89\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n    90\t    pub(crate) fn read<R>(&self, r: R) -> StorageResult<Option<Vec<LogEntry<T>>>>\n   303\t    pub(crate) fn append_entries_without_batching(\n   304\t        &mut self,\n   305\t        entries: Vec<T>,\n   306\t    ) -> StorageResult<usize> {\n   307\t        let num_new_entries = entries.len();\n   308\t        self.storage.append_entries(entries)?;\n   309\t        self.state_cache.accepted_idx += num_new_entries;\n   310\t        Ok(self.state_cache.accepted_idx)\n   311\t    }\n   312\t\n   313\t    pub(crate) fn sync_log(\n   314\t        &mut self,\n   315\t        accepted_round: Ballot,\n   316\t        decided_idx: usize,\n   317\t        log_sync: Option<LogSync<T>>,\n   318\t    ) -> StorageResult<usize> {\n   319\t        self.state_cache.accepted_round = accepted_round;\n   320\t        self.state_cache.decided_idx = decided_idx;\n   321\t        let mut sync_txn: Vec<StorageOp<T>> = vec![\n   322\t            StorageOp::SetAcceptedRound(accepted_round),\n   323\t            StorageOp::SetDecidedIndex(decided_idx),\n   324\t        ];\n   325\t        if let Some(sync) = log_sync {\n   326\t            match sync.decided_snapshot {\n   327\t                Some(SnapshotType::Complete(c)) => {\n   328\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   329\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   330\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   331\t                    sync_txn.push(StorageOp::SetSnapshot(Some(c)));\n   332\t                }\n   333\t                Some(SnapshotType::Delta(d)) => {\n   334\t                    let mut snapshot = self.create_decided_snapshot()?;\n   335\t                    snapshot.merge(d);\n   336\t                    self.state_cache.compacted_idx = sync.sync_idx;\n   337\t                    sync_txn.push(StorageOp::Trim(sync.sync_idx));\n   338\t                    sync_txn.push(StorageOp::SetCompactedIdx(sync.sync_idx));\n   339\t                    sync_txn.push(StorageOp::SetSnapshot(Some(snapshot)));\n   340\t                }\n   341\t                None => (),\n   342\t            }\n   343\t            self.state_cache.accepted_idx = sync.sync_idx + sync.suffix.len();\n   344\t            sync_txn.push(StorageOp::AppendOnPrefix(sync.sync_idx, sync.suffix));\n   345\t            match sync.stopsign {\n   346\t                Some(ss) => {\n   347\t                    self.state_cache.stopsign = Some(ss.clone());\n   348\t                    self.state_cache.accepted_idx += 1;\n   349\t                    sync_txn.push(StorageOp::SetStopsign(Some(ss)));\n   350\t                }\n   351\t                None if self.state_cache.stopsign.is_some() => {\n   352\t                    self.state_cache.stopsign = None;\n   353\t                    sync_txn.push(StorageOp::SetStopsign(None));\n   354\t                }\n   355\t                None => (),\n   356\t            }\n   357\t        }\n   358\t        self.storage.write_atomically(sync_txn)?;\n   359\t        Ok(self.state_cache.accepted_idx)\n   360\t    }\n   361\t\n   362\t    fn create_decided_snapshot(&mut self) -> StorageResult<T::Snapshot> {\n   363\t        let log_decided_idx = self.get_decided_idx_without_stopsign();\n   364\t        self.create_snapshot(log_decided_idx)\n   365\t    }\n   345\t            return;\n   346\t        } else if pid == self.get_current_leader() {\n   347\t            self.state = (Role::Follower, Phase::Recover);\n   348\t        }\n   349\t        let prepreq = PrepareReq {\n   350\t            n: self.get_promise(),\n   351\t        };\n   352\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   353\t            from: self.pid,\n   354\t            to: pid,\n   355\t            msg: PaxosMsg::PrepareReq(prepreq),\n   356\t        }));\n   357\t    }\n   358\t\n   359\t    fn propose_entry(&mut self, entry: T) {\n   360\t        match self.state {\n   361\t            (Role::Leader, Phase::Prepare) => self.buffered_proposals.push(entry),\n   362\t            (Role::Leader, Phase::Accept) => self.accept_entry_leader(entry),\n   363\t            _ => self.forward_proposals(vec![entry]),\n   364\t        }\n   365\t    }\n   366\t\n   367\t    pub(crate) fn get_leader_state(&self) -> &LeaderState<T> {\n   368\t        &self.leader_state\n   369\t    }\n   370\t\n   371\t    pub(crate) fn forward_proposals(&mut self, mut entries: Vec<T>) {\n   372\t        let leader = self.get_current_leader();\n   373\t        if leader > 0 && self.pid != leader {\n   374\t            let pf = PaxosMsg::ProposalForward(entries);\n   375\t            let msg = Message::SequencePaxos(PaxosMessage {\n   376\t                from: self.pid,\n   377\t                to: leader,\n   378\t                msg: pf,\n   379\t            });\n   380\t            self.outgoing.push(msg);\n   381\t        } else {\n   382\t            self.buffered_proposals.append(&mut entries);\n   383\t        }\n   384\t    }\n   385\t\n   386\t    pub(crate) fn forward_stopsign(&mut self, ss: StopSign) {\n   387\t        let leader = self.get_current_leader();\n   388\t        if leader > 0 && self.pid != leader {\n   389\t            #[cfg(feature = \"logging\")]\n   390\t            trace!(self.logger, \"Forwarding StopSign to Leader {:?}\", leader);\n   391\t            let fs = PaxosMsg::ForwardStopSign(ss);\n   392\t            let msg = Message::SequencePaxos(PaxosMessage {\n   393\t                from: self.pid,\n   394\t                to: leader,\n   395\t                msg: fs,\n   396\t            });\n   397\t            self.outgoing.push(msg);\n   398\t        } else if self.buffered_stopsign.as_mut().is_none() {\n   399\t            self.buffered_stopsign = Some(ss);\n   400\t        }\n   401\t    }\n   402\t    /// Returns `LogSync`, a struct to help other servers synchronize their log to correspond to the\n   403\t    /// current state of our own log. The `common_prefix_idx` marks where in the log the other server\n   404\t    /// needs to be sync from.\n   405\t    fn create_log_sync(\n   406\t        &self,\n   407\t        common_prefix_idx: usize,\n   408\t        other_logs_decided_idx: usize,\n   409\t    ) -> LogSync<T> {\n   410\t        let decided_idx = self.internal_storage.get_decided_idx();\n   411\t        let (decided_snapshot, suffix, sync_idx) =\n   412\t            if T::Snapshot::use_snapshots() && decided_idx > common_prefix_idx {\n   413\t                // Note: We snapshot from the other log's decided index and not the common prefix because\n   414\t                // snapshots currently only work on decided entries.\n   415\t                let (delta_snapshot, compacted_idx) = self\n   416\t                    .internal_storage\n   417\t                    .create_diff_snapshot(other_logs_decided_idx)\n   418\t                    .expect(READ_ERROR_MSG);\n   419\t                let suffix = self\n   420\t                    .internal_storage\n   421\t                    .get_suffix(decided_idx)\n   422\t                    .expect(READ_ERROR_MSG);\n   423\t                (delta_snapshot, suffix, compacted_idx)\n   424\t            } else {\n   425\t                let suffix = self\n   426\t                    .internal_storage\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n   446\t}\n   447\t\n   448\t#[derive(PartialEq, Debug)]\n   449\tpub(crate) enum Role {\n   450\t    Follower,\n   451\t    Leader,\n   452\t}\n   453\t\n   454\t/// Configuration for `SequencePaxos`.\n   455\t/// # Fields\n   456\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   457\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   458\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   459\t/// * `buffer_size`: The buffer size for outgoing messages.\n   460\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   461\t/// * `logger_file_path`: The path where the default logger logs events.\n   462\t#[derive(Clone, Debug)]\n   463\tpub(crate) struct SequencePaxosConfig {\n   464\t    pid: NodeId,\n   465\t    peers: Vec<NodeId>,\nConsensusAuditSpec {\"$defs\": {\"Activity\": {\"additionalProperties\": false, \"properties\": {\"class_id\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Class Id\", \"type\": \"string\"}, \"applicability\": {\"enum\": [\"applicable\", \"externalized\", \"not_applicable\", \"unknown\"], \"title\": \"Applicability\", \"type\": \"string\"}, \"purpose\": {\"title\": \"Purpose\", \"type\": \"string\"}, \"realization_summary\": {\"title\": \"Realization Summary\", \"type\": \"string\"}, \"entry_points\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Entry Points\", \"type\": \"array\"}, \"behavior_ids\": {\"description\": \"Derived from Behavior.primary_activity\", \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\", \"x-controller-derived\": true}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}}, \"required\": [\"class_id\", \"applicability\", \"purpose\", \"realization_summary\"], \"title\": \"Activity\", \"type\": \"object\"}, \"Behavior\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"primary_activity\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Primary Activity\", \"type\": \"string\"}, \"execution_owner\": {\"title\": \"Execution Owner\", \"type\": \"string\"}, \"protocol_context\": {\"title\": \"Protocol Context\", \"type\": \"string\"}, \"trigger\": {\"title\": \"Trigger\", \"type\": \"string\"}, \"legal_preconditions\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Legal Preconditions\", \"type\": \"array\"}, \"implementation_guards\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Implementation Guards\", \"type\": \"array\"}, \"reads\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Reads\", \"type\": \"array\"}, \"writes\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Writes\", \"type\": \"array\"}, \"durable_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Durable Effects\", \"type\": \"array\"}, \"external_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Effects\", \"type\": \"array\"}, \"important_branches\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Important Branches\", \"type\": \"array\"}, \"async_boundaries\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Async Boundaries\", \"type\": \"array\"}, \"produces_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Produces Fact Ids\", \"type\": \"array\"}, \"consumes_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Consumes Fact Ids\", \"type\": \"array\"}, \"cross_activity_effects\": {\"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee\", \"propertyNames\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"]}, \"title\": \"Cross Activity Effects\", \"type\": \"object\"}, \"existing_protections\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Existing Protections\", \"type\": \"array\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"description\": \"Unresolved implementation or interface relationships; check exclusions and execution progress belong to Scope/CheckRun\", \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}, \"required\": [\"id\", \"primary_activity\", \"execution_owner\", \"protocol_context\", \"trigger\", \"source_ids\"], \"title\": \"Behavior\", \"type\": \"object\"}, \"CoreOverview\": {\"additionalProperties\": false, \"properties\": {\"formation\": {\"$ref\": \"#/$defs/CorePath\"}, \"context\": {\"$ref\": \"#/$defs/CorePath\"}, \"connection\": {\"$ref\": \"#/$defs/CorePath\"}, \"open_details\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Open Details\", \"type\": \"array\"}, \"core_gaps\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Core Gaps\", \"type\": \"array\"}, \"status\": {\"default\": \"incomplete\", \"enum\": [\"incomplete\", \"usable\", \"blocked\"], \"title\": \"Status\", \"type\": \"string\"}, \"rationale\": {\"title\": \"Rationale\", \"type\": \"string\"}}, \"required\": [\"rationale\"], \"title\": \"CoreOverview\", \"type\": \"object\"}, \"CorePath\": {\"additionalProperties\": false, \"properties\": {\"explanation\": {\"default\": \"\", \"title\": \"Explanation\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Fact Ids\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}}, \"title\": \"CorePath\", \"type\": \"object\"}, \"Fact\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"meaning\": {\"title\": \"Meaning\", \"type\": \"string\"}, \"identity\": {\"additionalProperties\": {\"type\": \"string\"}, \"title\": \"Identity\", \"type\": \"object\"}, \"established_by\": {\"description\": \"Derived from Behavior.produces_fact_ids; never infer an unread producer\", \"items\": {\"type\": \"string\"}, \"title\": \"Established By\", \"type\": \"array\", \"x-controller-derived\": true}, \"consumed_by\": {\"description\": \"Derived from Behavior.consumes_fact_ids\", \"items\": {\"type\": \"string\"}, \"title\": \"Consumed By\", \"type\": \"array\", \"x-controller-derived\": true}, \"validity_context\": {\"title\": \"Validity Context\", \"type\": \"string\"}, \"representation\": {\"items\": {\"type\": \"string\"}, \"title\": \"Representation\", \"type\": \"array\"}, \"invalidators\": {\"description\": \"Existing Behavior IDs only. Unread events or suspected invalidators belong in unknowns.\", \"items\": {\"type\": \"string\"}, \"title\": \"Invalidators\", \"type\": \"array\"}, \"reinterpreters\": {\"description\": \"Existing Behavior IDs only, not event descriptions or Activity IDs.\", \"items\": {\"type\": \"string\"}, \"title\": \"Reinterpreters\", \"type\": \"array\"}, \"durability\": {\"title\": \"Durability\", \"type\": \"string\"}, \"recovery\": {\"title\": \"Recovery\", \"type\": \"string\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"description\": \"Unknown establishment, consumption or validity in this implementation; known weak guarantees belong to meaning/context/durability\", \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}, \"required\": [\"id\", \"meaning\", \"identity\", \"validity_context\", \"representation\", \"durability\", \"recovery\", \"source_ids\"], \"title\": \"Fact\", \"type\": \"object\"}, \"Surface\": {\"additionalProperties\": false, \"properties\": {\"entry_point\": {\"title\": \"Entry Point\", \"type\": \"string\"}, \"disposition\": {\"enum\": [\"mapped\", \"externalized\", \"infrastructure\", \"deferred\", \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"], \"title\": \"Disposition\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"high_consequence\": {\"default\": false, \"title\": \"High Consequence\", \"type\": \"boolean\"}}, \"required\": [\"entry_point\", \"disposition\", \"reason\"], \"title\": \"Surface\", \"type\": \"object\"}, \"TargetProfile\": {\"additionalProperties\": false, \"properties\": {\"system_boundary\": {\"title\": \"System Boundary\", \"type\": \"string\"}, \"protocol_contexts\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Protocol Contexts\", \"type\": \"array\"}, \"external_interfaces\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Interfaces\", \"type\": \"array\"}, \"ownership\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Ownership\", \"type\": \"array\"}, \"selection_injection\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Selection Injection\", \"type\": \"array\"}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}, \"required\": [\"system_boundary\"], \"title\": \"TargetProfile\", \"type\": \"object\"}}, \"additionalProperties\": false, \"properties\": {\"version\": {\"default\": 1, \"title\": \"Version\", \"type\": \"integer\"}, \"target_profile\": {\"$ref\": \"#/$defs/TargetProfile\"}, \"activities\": {\"items\": {\"$ref\": \"#/$defs/Activity\"}, \"maxItems\": 7, \"title\": \"Activities\", \"type\": \"array\"}, \"behaviors\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/Behavior\"}, \"title\": \"Behaviors\", \"type\": \"array\"}, \"facts\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/Fact\"}, \"title\": \"Facts\", \"type\": \"array\"}, \"surfaces\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/Surface\"}, \"title\": \"Surfaces\", \"type\": \"array\"}, \"core_overview\": {\"anyOf\": [{\"$ref\": \"#/$defs/CoreOverview\"}, {\"type\": \"null\"}], \"default\": null}}, \"required\": [\"target_profile\"], \"title\": \"ConsensusAuditSpec\", \"type\": \"object\"}\nActivity {\"additionalProperties\": false, \"properties\": {\"class_id\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Class Id\", \"type\": \"string\"}, \"applicability\": {\"enum\": [\"applicable\", \"externalized\", \"not_applicable\", \"unknown\"], \"title\": \"Applicability\", \"type\": \"string\"}, \"purpose\": {\"title\": \"Purpose\", \"type\": \"string\"}, \"realization_summary\": {\"title\": \"Realization Summary\", \"type\": \"string\"}, \"entry_points\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Entry Points\", \"type\": \"array\"}, \"behavior_ids\": {\"description\": \"Derived from Behavior.primary_activity\", \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\", \"x-controller-derived\": true}, \"variants\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Variants\", \"type\": \"array\"}, \"unknowns\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}}, \"required\": [\"class_id\", \"applicability\", \"purpose\", \"realization_summary\"], \"title\": \"Activity\", \"type\": \"object\"}\nCoreOverview {\"additionalProperties\": false, \"properties\": {\"formation\": {\"$ref\": \"#/$defs/CorePath\"}, \"context\": {\"$ref\": \"#/$defs/CorePath\"}, \"connection\": {\"$ref\": \"#/$defs/CorePath\"}, \"open_details\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Open Details\", \"type\": \"array\"}, \"core_gaps\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Core Gaps\", \"type\": \"array\"}, \"status\": {\"default\": \"incomplete\", \"enum\": [\"incomplete\", \"usable\", \"blocked\"], \"title\": \"Status\", \"type\": \"string\"}, \"rationale\": {\"title\": \"Rationale\", \"type\": \"string\"}}, \"required\": [\"rationale\"], \"title\": \"CoreOverview\", \"type\": \"object\"}\nBehavior {\"additionalProperties\": false, \"properties\": {\"id\": {\"title\": \"Id\", \"type\": \"string\"}, \"primary_activity\": {\"enum\": [\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\"], \"title\": \"Primary Activity\", \"type\": \"string\"}, \"execution_owner\": {\"title\": \"Execution Owner\", \"type\": \"string\"}, \"protocol_context\": {\"title\": \"Protocol Context\", \"type\": \"string\"}, \"trigger\": {\"title\": \"Trigger\", \"type\": \"string\"}, \"legal_preconditions\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Legal Preconditions\", \"type\": \"array\"}, \"implementation_guards\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Implementation Guards\", \"type\": \"array\"}, \"reads\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Reads\", \"type\": \"array\"}, \"writes\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Writes\", \"type\": \"array\"}, \"durable_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Durable Effects\", \"type\": \"array\"}, \"external_effects\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"External Effects\", \"type\": \"array\"}, \"important_branches\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Important Branches\", \"type\": \"array\"}, \"async_boundaries\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Async Boundaries\", \"type\": \"array\"}, \"produces_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Produces Fact Ids\", \"type\": \"array\"}, \"consumes_fact_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Consumes Fact Ids\", \"type\": \"array\"}, \"cross_activity_effects\": {\"additionalProperties\": {\"t