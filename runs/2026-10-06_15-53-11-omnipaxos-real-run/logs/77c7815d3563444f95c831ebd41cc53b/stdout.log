\": {\"type\": \"string\"}, \"title\": \"Invalidators\", \"type\": \"array\"}, \"reinterpreters\": {\"description\": \"Existing Behavior IDs only, not event descriptions or Activity IDs.\", \"items\": {\"type\": \"string\"}, \"title\": \"Reinterpreters\", \"type\": \"array\"}, \"durability\": {\"title\": \"Durability\", \"type\": \"string\"}, \"recovery\": {\"title\": \"Recovery\", \"type\": \"string\"}, \"source_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Source Ids\", \"type\": \"array\"}, \"unknowns\": {\"description\": \"Unknown establishment, consumption or validity in this implementation; known weak guarantees belong to meaning/context/durability\", \"items\": {\"type\": \"string\"}, \"title\": \"Unknowns\", \"type\": \"array\"}}, \"required\": [\"id\", \"meaning\", \"identity\", \"validity_context\", \"representation\", \"durability\", \"recovery\", \"source_ids\"], \"title\": \"Fact\", \"type\": \"object\"}\nSurface {\"additionalProperties\": false, \"properties\": {\"entry_point\": {\"title\": \"Entry Point\", \"type\": \"string\"}, \"disposition\": {\"enum\": [\"mapped\", \"externalized\", \"infrastructure\", \"deferred\", \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"], \"title\": \"Disposition\", \"type\": \"string\"}, \"behavior_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Behavior Ids\", \"type\": \"array\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"source_ids\": {\"default\": [], \"items\": {\"type\": \"string\"}, \"title\": \"Source Ids\", \"type\": \"array\"}, \"high_consequence\": {\"default\": false, \"title\": \"High Consequence\", \"type\": \"boolean\"}}, \"required\": [\"entry_point\", \"disposition\", \"reason\"], \"title\": \"Surface\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
