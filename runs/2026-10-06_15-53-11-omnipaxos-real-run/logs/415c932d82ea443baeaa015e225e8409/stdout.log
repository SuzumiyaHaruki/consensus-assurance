ired_aspects\": [\"checker_correspondence\"], \"questions\": {\"checker_correspondence\": \"Explain which part of the current question the obligation and actual observations answer, under which premises. Distinguish the original cause hypothesis and wider consequences from the checked proposition. Review fixed inputs, source bindings, oracle, correlated observations, legality and contrary evidence together; no separate object approvals are required. Matching IDs alone are not correspondence.\"}, \"optional_questions\": {\"applicability\": \"Why does the implementation owe this responsibility in the selected scope?\", \"decomposition\": \"Explain necessity, sufficiency, alternatives, producer/consumer dependencies and remaining guarantees.\"}, \"required_material_ids\": [\"s_follower\", \"s_leader_sync\", \"s_memory\", \"s_pending\", \"s_read\", \"s_snapshot_doc\", \"s_storage_contract\", \"s_sync\", \"s_sync_test_expectation\"], \"dependency_versions\": {\"a5fd40b0afc54d27bef5dbc6bf7217df\": 2, \"bind_delta_sync\": 1, \"claim_snapshot_content\": 1}}, \"allowed_targets\": [{\"source_ranges\": [{\"file\": \"docs/omnipaxos/compaction.md\", \"content_digest\": \"f65bb10839e286a7397f3850d9294257dc869a731a7881926693032162e489c2\", \"ranges\": [[29, 63]]}, {\"file\": \"omnipaxos/src/sequence_paxos/follower.rs\", \"content_digest\": \"cbe87da8f37d9528e9d188bdee7c228be7336bfabbd24b65840f4c40b74ff30e\", \"ranges\": [[13, 159]]}, {\"file\": \"omnipaxos/src/sequence_paxos/leader.rs\", \"content_digest\": \"88814be77547ffe3e3dd2aff771df9852b09da9718e5980515748d2ab580162b\", \"ranges\": [[160, 208]]}, {\"file\": \"omnipaxos/src/sequence_paxos/mod.rs\", \"content_digest\": \"8b3053463fc9c77f162a7b97133f90d86fc0621283a420d1638d2c4decff454a\", \"ranges\": [[339, 437]]}, {\"file\": \"omnipaxos/src/storage/internal_storage.rs\", \"content_digest\": \"4ad8f4d686efe518f90480ba3a9e2ccb0273714994fe241b033e4fe4e066aefa\", \"ranges\": [[55, 204], [313, 412]]}, {\"file\": \"omnipaxos/src/sto