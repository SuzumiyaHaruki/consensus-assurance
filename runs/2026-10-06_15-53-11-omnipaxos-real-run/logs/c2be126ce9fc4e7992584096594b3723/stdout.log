{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '890,980p' ../agent-source/omnipaxos_runtime/tests/async_runtime_test.rs; cat ../agent-source/omnipaxos_runtime/src/lib.rs; cat ../agent-source/omnipaxos_runtime/src/tokio_rt.rs; nl -ba ../agent-source/omnipaxos_runtime/src/actor.rs | sed -n '190,230p;330,370p;680,725p'\"","aggregated_output":"//! Async runtime actor layer for OmniPaxos.\n//!\n//! The [`AsyncRuntime`] trait abstracts over the async executor so this crate can be used\n//! on top of any runtime. A ready-to-use [`TokioRuntime`] is provided behind the\n//! `tokio_runtime` feature.\n//!\n//! The main entry point is [`spawn_actor`], which takes an\n//! [`OmniPaxos`](omnipaxos::OmniPaxos) instance and returns an [`OmniPaxosHandle`]. The\n//! handle is cloneable and provides `async` methods to append entries and observe state\n//! transitions.\n//!\n//! The runtime does NOT own message transport: use [`OmniPaxosHandle::outgoing_messages`]\n//! to drain outgoing messages and [`OmniPaxosHandle::handle_incoming`] to deliver\n//! incoming ones. This keeps the crate free of I/O dependencies and lets users plug in\n//! any transport (TCP, QUIC, in-process channels, etc.).\n\n#![deny(missing_docs)]\n\nmod actor;\nmod event;\nmod handle;\nmod traits;\n\n#[cfg(feature = \"tokio_runtime\")]\nmod tokio_rt;\n\npub use event::{AppendError, OmniPaxosEvent, RuntimeProposeErr};\npub use handle::{spawn_actor, OmniPaxosHandle, RuntimeConfig};\npub use omnipaxos::messages::EntryId;\npub use traits::{ActorEntry, AsyncRuntime};\n\n#[cfg(feature = \"tokio_runtime\")]\npub use tokio_rt::TokioRuntime;\nuse core::{future::Future, time::Duration};\n\nuse super::traits::AsyncRuntime;\n\n/// [`AsyncRuntime`] impl backed by [`tokio`]. Enabled by the `tokio_runtime` feature.\npub struct TokioRuntime;\n\nimpl AsyncRuntime for TokioRuntime {\n    type JoinHandle = tokio::task::JoinHandle<()>;\n\n    fn spawn<F>(future: F) -> Self::JoinHandle\n    where\n        F: Future<Output = ()> + Send + 'static,\n    {\n        tokio::spawn(future)\n    }\n\n    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static {\n        tokio::time::sleep(duration)\n    }\n}\n   190\t                let _ = self\n   191\t                    .event_tx\n   192\t                    .send(OmniPaxosEvent::Reconfigured {\n   193\t                        stop_sign_idx: self.op.get_decided_idx(),\n   194\t                    })\n   195\t                    .await;\n   196\t                self.last_reconfigured = true;\n   197\t            }\n   198\t        }\n   199\t    }\n   200\t\n   201\t    fn drain_notifiers(&mut self) {\n   202\t        let decided = self.op.get_decided_idx();\n   203\t        let now = Instant::now();\n   204\t        let cur_ballot = self.op.get_promise();\n   205\t        let old = std::mem::take(&mut self.pending);\n   206\t        for p in old {\n   207\t            match p.assigned {\n   208\t                Some((idx, _)) if idx <= decided => {\n   209\t                    let _ = p.reply.send(Ok(idx));\n   210\t                }\n   211\t                Some((idx, ballot)) if ballot < cur_ballot => {\n   212\t                    let _ = p\n   213\t                        .reply\n   214\t                        .send(Err(AppendError::Superseded { log_entry_idx: idx }));\n   215\t                }\n   216\t                _ if now > p.deadline => {\n   217\t                    let _ = p.reply.send(Err(AppendError::Timeout));\n   218\t                }\n   219\t                _ => self.pending.push_back(p),\n   220\t            }\n   221\t        }\n   222\t    }\n   223\t\n   224\t    /// Effective cap for `outgoing_buf`: the channel's own capacity when known,\n   225\t    /// else [`ActorConfig::max_outgoing_buffered`].\n   226\t    fn outgoing_buf_cap(&self) -> usize {\n   227\t        self.outgoing_tx\n   228\t            .capacity()\n   229\t            .unwrap_or(self.config.max_outgoing_buffered)\n   230\t    }\n   330\t            }\n   331\t            true\n   332\t        });\n   333\t    }\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`