uf: &mut Vec<M>, cap: usize) {\n   716\t    if buf.len() > cap {\n   717\t        let excess = buf.len() - cap;\n   718\t        buf.drain(..excess);\n   719\t    }\n   720\t}\n   721\t\n   722\t#[cfg(test)]\n   723\tmod tests {\n   724\t    use super::trim_oldest;\n   725\t\n","exit_code":0,"status":"completed"}}
