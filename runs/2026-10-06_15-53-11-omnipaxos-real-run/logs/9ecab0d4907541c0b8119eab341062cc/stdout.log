pl,scope=dict(description='Successful same-configuration follower AcceptSync using SnapshotType::Delta and conforming key/value snapshots; compare application state at the synchronization decided boundary.',assumptions=['Each sender is a configured non-Byzantine replica.','Snapshot create folds entries in order; merge applies delta updates, as documented.','MemoryStorage runs without injected errors; network disconnect can lose messages and endpoints call reconnected after restoration.'],excluded=['Disk crash atomicity','Cross-configuration message mixing','Numeric convergence deadline','Runtime subscriptions']),pending=[],grounding=grounding('The snapshot documentation explicitly contrasts state-preserving snapshots with data-discarding trim and defines merge as application of later updates. Storage Snapshot defines Complete versus Delta. The sync test expects followers missing decided entries to recover the leader log. These sources require preservation of represented decided state, not merely equality of indices.'))\nquestion=dict(question='Does follower delta synchronization reconstruct the decided prefix correctly when the incoming decided index exceeds both its old decided and accepted indexes?',importance='Loss of an already decided key from the recovered snapshot would expose divergent application state despite matching decided indexes.',source_ids=impl+expect,participants=['leader','reconnecting follower','quorum follower'],objects=['decided prefix','delta snapshot','compacted snapshot'],contexts=['single configuration','same-ballot reconnect','follower with shorter accepted history'],event_paths=['reconnected -> PrepareReq -> Prepare -> Promise -> AcceptSync -> sync_log -> read_decided_suffix'],activity_classes=['A6','A1','A2'],behavior_ids=['b_sync','b_read'],fact_ids=['f_snapshot'],supporting_behavior_ids={'b_recover':'Restores eligible participation via the prepare exchange.','b_prepare':'Qualifies authority and supplies follower history metadata.','b_accept':'Creates the original decided prefix and later quorum decisions.'},obligation_relation_kind='preservation',counterevidence=['Ballot equality, follower Prepare phase, and sequence recovery qualify the transfer.','Storage operations are atomically grouped; this protects transaction completion but does not establish correct snapshot contents.','Complete snapshot replacement avoids constructing a local delta base.'],unknowns=['Whether an actual implementation-generated delta transfer in the constructed legal history preserves or loses the earlier key.'],priority=3,trigger_rationale='Source order installs incoming decided_idx before create_decided_snapshot; when new index exceeds the local accepted log, MemoryStorage returns an empty slice for that base. Sender delta begins at the old follower decided index. A public-API reconnect test resolves reachability and actual content with fewer assumptions than injecting storage state; buffered StopSign and runtime completion remain separate leads.',disposition='ready_for_check',preferred_check='controlled_schedule')\nbinding=dict(id=bid,material_id='s_sync',symbol='sync_log',start_line=313,end_line=359,description='Installs incoming decided index and constructs a local base before merging a delta snapshot.',pending=[],associations=[dict(claim_id=cid,source_ids=impl+expect,rationale='This function implements the history reconstruction whose state-preservation duty is grounded by the snapshot API and documentation.')])\ncandidate=dict(action='obligation',rationale='Source-defined snapshot semantics and a legal reconnect history ground a content-preservation obligation without presuming its outcome.',question=question,obligation=claim,bindings=[binding])\nplan=dict(description='Establish one decided key at three replicas. Disconnect follower 3, decide two distinct additional keys on nodes 1 and 2, then reconnect 3. Observe the actual generated delta AcceptSync and compare the state returned immediately after its synchronous handler with the leader state captured before dispatch. FIFO producer queues and public APIs construct all state; messages across the declared disconnect are dropped.',claim_id=cid,binding_ids=[bid],harness=dict(kind='rust_test',source='',files={},description='Single-thread public-API three-node driver with MemoryStorage and documented key/value snapshot semantics. Explicit try_become_leader selects leader; bounded queue drains drive generated messages. No wall-clock progress assertion is made.',semantic_changes=['No target changes. Transport is a deterministic FIFO delivery driver with an explicitly declared disconnection.','Application Entry/Snapshot uses a BTreeMap for canonical serialization and overwrite merge equivalent to documented HashMap semantics.'],prerequisites=[dict(alias='admitted',event='sync_admitted',conditions=[dict(field='delta',value=True),dict(field='before_decided',value=1),dict(field='before_accepted',value=1),dict(field='transfer_decided',value=3),dict(field='transfer_compacted',value=3)])],legality=grounding('The public manual leadership API enters the real prepare protocol; every protocol message is generated by target nodes. A fully delivered common prefix is observed before disconnection. Node 3 misses only messages while disconnected. Both restored endpoints receive reconnected callbacks. Observed same-ballot Prepare/Promise precedes the targeted AcceptSync. All API calls, snapshot reads and observations occur serially with exclusive Rust ownership; no sleep or cache copy substitutes for completion. Timers are unnecessary within this finite manually driven transition and are not used to claim liveness. Each outgoing batch preserves sender-to-receiver order.')),\nmonitors=[dict(id='monitor_delta_content',checker_id='check_delta_content',event='sync_result',binding_ids=[bid],admission_alias='admitted',grounding=grounding('The result is emitted after the exact admitted AcceptSync handler returns. The expected state is derived from a real decided leader read before dispatch, previously corroborated with node 2. Both maps are canonically serialized; ordinal, case and node independently identify the same transfer. Decided/accepted/compacted indices and phase are diagnostic output, not substituted for content equality.'))],observable_properties=[dict(checker_id='check_delta_content',kind='event_assertion',identity_fields=['case','node','ordinal'],trigger=dict(field='returned',value=True),assertion=dict(field='actual_state',reference='admitted.expected_state'),description='State recovered from decided snapshot/suffix equals the current leader decided application state at the admitted synchronization boundary.')],uncertainties=['One bounded same-ballot delta transfer does not establish all snapshot variants or disk-recovery behavior.','No target execution has yet established that prerequisites are reached; compilation or setup failures require repair rather than a property verdict.'])\njson.dump(plan,open('delta_plan.json','w'),indent=2)\njson.dump(dict(action='check',rationale='Fixed legal-history test distinguishes incorrect delta reconstruction from a harmless cached index update.',sources=new_sources,candidate=candidate,plan_path='delta_plan.json',harness_path='delta_sync.rs',files={}),open('delta_submission.json','w'),indent=2)\nPY\npython3 build_delta.py\npython3 - <<'PY'\nimport json,subprocess\nr=json.load(open('../research.json')); p=subprocess.run(r['validation']['command']+['delta_submission.json'],capture_output=True,text=True); print(p.stdout); print(p.stderr)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
