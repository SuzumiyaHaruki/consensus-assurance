serde support when both are on.\nserde = [\"dep:serde\", \"uuid?/serde\"]\n\ndefault = [\"macros\"]\n\n[profile.release]\nlto = true\n[workspace]\nresolver = \"2\"\nmembers = [\n    \"omnipaxos\",\n    \"omnipaxos_storage\",\n    \"omnipaxos_macros\",\n    \"omnipaxos_runtime\",\n    \"omnipaxos_ui\",\n    \"examples/kv_store\",\n    \"examples/kv_store_async\",\n    \"examples/dashboard\",\n]\n\n[profile.release]\nlto = true\n     1\tuse crate::{\n     2\t    messages::{ballot_leader_election::BLEMessage, sequence_paxos::PaxosMessage},\n     3\t    storage::Entry,\n     4\t    util::NodeId,\n     5\t};\n     6\t#[cfg(feature = \"serde\")]\n     7\tuse serde::{Deserialize, Serialize};\n     8\t\n     9\t#[cfg(feature = \"async_runtime\")]\n    10\tpub use async_runtime::{AsyncRuntimeMessage, AsyncRuntimeMsg, EntryId};\n    11\t\n    12\t/// Internal component for log replication\n    13\tpub mod sequence_paxos {\n    14\t    use crate::{\n    15\t        ballot_leader_election::Ballot,\n    16\t        storage::{Entry, StopSign},\n    17\t        util::{LogSync, NodeId, SequenceNumber},\n    18\t    };\n    19\t    #[cfg(feature = \"serde\")]\n    20\t    use serde::{Deserialize, Serialize};\n    21\t    use std::fmt::Debug;\n    22\t\n    23\t    /// Message sent by a follower on crash-recovery or dropped messages to request its leader to re-prepare them.\n    24\t    #[derive(Copy, Clone, Debug)]\n    25\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    26\t    pub struct PrepareReq {\n    27\t        /// The current round.\n    28\t        pub n: Ballot,\n    29\t    }\n    30\t\n    31\t    /// Prepare message sent by a newly-elected leader to initiate the Prepare phase.\n    32\t    #[derive(Copy, Clone, Debug)]\n    33\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    34\t    pub struct Prepare {\n    35\t        /// The current round.\n    36\t        pub n: Ballot,\n    37\t        /// The decided index of this leader.\n    38\t        pub decided_idx: usize,\n    39\t        /// The latest round in which an entry was accepted.\n    40\t        pub n_accepted: Ballot,\n    41\t        /// The log length of this leader.\n    42\t        pub accepted_idx: usize,\n    43\t    }\n    44\t\n    45\t    /// Promise message sent by a follower in response to a [`Prepare`] sent by the leader.\n    46\t    #[derive(Clone, Debug)]\n    47\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    48\t    pub struct Promise<T>\n    49\t    where\n    50\t        T: Entry,\n    51\t    {\n    52\t        /// The current round.\n    53\t        pub n: Ballot,\n    54\t        /// The latest round in which an entry was accepted.\n    55\t        pub n_accepted: Ballot,\n    56\t        /// The decided index of this follower.\n    57\t        pub decided_idx: usize,\n    58\t        /// The log length of this follower.\n    59\t        pub accepted_idx: usize,\n    60\t        /// The log update which the leader applies to its log in order to sync\n    61\t        /// with this follower (if the follower is more up-to-date).\n    62\t        pub log_sync: Option<LogSync<T>>,\n    63\t    }\n    64\t\n    65\t    /// AcceptSync message sent by the leader to synchronize the logs of all replicas in the prepare phase.\n    66\t    #[derive(Clone, Debug)]\n    67\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    68\t    pub struct AcceptSync<T>\n    69\t    where\n    70\t        T: Entry,\n    71\t    {\n    72\t        /// The current round.\n    73\t        pub n: Ballot,\n    74\t        /// The sequence number of this message in the leader-to-follower accept sequence\n    75\t        pub seq_num: SequenceNumber,\n    76\t        /// The decided index\n    77\t        pub decided_idx: usize,\n    78\t        /// The log update which the follower applies to its log in order to sync\n    79\t        /// with the leader.\n    80\t        pub log_sync: LogSync<T>,\n    81\t        #[cfg(feature = \"unicache\")]\n    82\t        /// The UniCache of the leader\n    83\t        pub unicache: T::UniCache,\n    84\t    }\n    85\t\n    86\t    /// Message with entries to be replicated and the latest decided index sent by the leader in the accept phase.\n    87\t    #[derive(Clone, Debug)]\n    88\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n    89\t    pub struct AcceptDecide<T>\n    90\t    where\n    91\t        T: Entry,\n    92\t    {\n    93\t        /// The current round.\n    94\t        pub n: Ballot,\n    95\t        /// The sequence number of this message in the leader-to-follower accept sequence\n    96\t        pub seq_num: SequenceNumber,\n    97\t        /// The decided index.\n    98\t        pub decided_idx: usize,\n    99\t        #[cfg(not(feature = \"unicache\"))]\n   100\t        /// Entries to be replicated.\n   101\t        pub entries: Vec<T>,\n   102\t        #[cfg(feature = \"unicache\")]\n   103\t        /// Entries to be replicated.\n   104\t        pub entries: Vec<T::EncodeResult>,\n   105\t    }\n   106\t\n   107\t    /// Message sent by follower to leader when entries has been accepted.\n   108\t    #[derive(Copy, Clone, Debug)]\n   109\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   110\t    pub struct Accepted {\n   111\t        /// The current round.\n   112\t        pub n: Ballot,\n   113\t        /// The accepted index.\n   114\t        pub accepted_idx: usize,\n   115\t    }\n   116\t\n   117\t    /// Message sent by leader to followers to decide up to a certain index in the log.\n   118\t    #[derive(Copy, Clone, Debug)]\n   119\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   120\t    pub struct Decide {\n   121\t        /// The current round.\n   122\t        pub n: Ballot,\n   123\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   124\t        pub seq_num: SequenceNumber,\n   125\t        /// The decided index.\n   126\t        pub decided_idx: usize,\n   127\t    }\n   128\t\n   129\t    /// Message sent by leader to followers to accept a StopSign\n   130\t    #[derive(Clone, Debug)]\n   131\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   132\t    pub struct AcceptStopSign {\n   133\t        /// The current round.\n   134\t        pub n: Ballot,\n   135\t        /// The sequence number of this message in the leader-to-follower accept sequence\n   136\t        pub seq_num: SequenceNumber,\n   137\t        /// The decided index.\n   138\t        pub ss: StopSign,\n   139\t    }\n   140\t\n   141\t    /// Message sent by follower to leader when accepting an entry is rejected.\n   142\t    /// This happens when the follower is promised to a greater leader.\n   143\t    #[derive(Clone, Debug)]\n   144\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   145\t    pub struct NotAccepted {\n   146\t        /// The follower's current ballot\n   147\t        pub n: Ballot,\n   148\t    }\n   149\t\n   150\t    /// Compaction Request\n   151\t    #[allow(missing_docs)]\n   152\t    #[derive(Clone, Debug)]\n   153\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   154\t    pub enum Compaction {\n   155\t        Trim(usize),\n   156\t        Snapshot(Option<usize>),\n   157\t    }\n   158\t\n   159\t    /// An enum for all the different message types.\n   160\t    #[allow(missing_docs)]\n   161\t    #[derive(Clone, Debug)]\n   162\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   163\t    pub enum PaxosMsg<T>\n   164\t    where\n   165\t        T: Entry,\n   166\t    {\n   167\t        /// Request a [`Prepare`] to be sent from the leader. Used for fail-recovery.\n   168\t        PrepareReq(PrepareReq),\n   169\t        #[allow(missing_docs)]\n   170\t        Prepare(Prepare),\n   171\t        Promise(Promise<T>),\n   172\t        AcceptSync(AcceptSync<T>),\n   173\t        AcceptDecide(AcceptDecide<T>),\n   174\t        Accepted(Accepted),\n   175\t        NotAccepted(NotAccepted),\n   176\t        Decide(Decide),\n   177\t        /// Forward client proposals to the leader.\n   178\t        ProposalForward(Vec<T>),\n   179\t        Compaction(Compaction),\n   180\t        AcceptStopSign(AcceptStopSign),\n   181\t        ForwardStopSign(StopSign),\n   182\t    }\n   183\t\n   184\t    /// A struct for a Paxos message that also includes sender and receiver.\n   185\t    #[derive(Clone, Debug)]\n   186\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   187\t    pub struct PaxosMessage<T>\n   188\t    where\n   189\t        T: Entry,\n   190\t    {\n   191\t        /// Sender of `msg`.\n   192\t        pub from: NodeId,\n   193\t        /// Receiver of `msg`.\n   194\t        pub to: NodeId,\n   195\t        /// The message content.\n   196\t        pub msg: PaxosMsg<T>,\n   197\t    }\n   198\t}\n   199\t\n   200\t/// The different messages BLE uses to communicate with other servers.\n   201\tpub mod ballot_leader_election {\n   202\t\n   203\t    use crate::{ballot_leader_election::Ballot, util::NodeId};\n   204\t    #[cfg(feature = \"serde\")]\n   205\t    use serde::{Deserialize, Serialize};\n   206\t\n   207\t    /// An enum for all the different BLE message types.\n   208\t    #[allow(missing_docs)]\n   209\t    #[derive(Clone, Debug)]\n   210\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   211\t    pub enum HeartbeatMsg {\n   212\t        Request(HeartbeatRequest),\n   213\t        Reply(HeartbeatReply),\n   214\t    }\n   215\t\n   216\t    /// Requests a reply from all the other servers.\n   217\t    #[derive(Clone, Debug)]\n   218\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   219\t    pub struct HeartbeatRequest {\n   220\t        /// Number of the current round.\n   221\t        pub round: u32,\n   222\t    }\n   223\t\n   224\t    /// Replies\n   225\t    #[derive(Clone, Debug)]\n   226\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   227\t    pub struct HeartbeatReply {\n   228\t        /// Number of the current heartbeat round.\n   229\t        pub round: u32,\n   230\t        /// Ballot of replying server.\n   231\t        pub ballot: Ballot,\n   232\t        /// Leader this server is following\n   233\t        pub leader: Ballot,\n   234\t        /// Whether the replying server sees a need for a new leader\n   235\t        pub happy: bool,\n   236\t    }\n   237\t\n   238\t    /// A struct for a Paxos message that also includes sender and receiver.\n   239\t    #[derive(Clone, Debug)]\n   240\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   241\t    pub struct BLEMessage {\n   242\t        /// Sender of `msg`.\n   243\t        pub from: NodeId,\n   244\t        /// Receiver of `msg`.\n   245\t        pub to: NodeId,\n   246\t        /// The message content.\n   247\t        pub msg: HeartbeatMsg,\n   248\t    }\n   249\t}\n   250\t\n   251\t#[allow(missing_docs)]\n   252\t/// Message in OmniPaxos. Can be either a `SequencePaxos` message (for log replication),\n   253\t/// a `BLE` message (for leader election), or (when the `async_runtime` feature is enabled)\n   254\t/// an `AsyncRuntime` message used by the actor layer for `append_notify` correlation.\n   255\t#[derive(Clone, Debug)]\n   256\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   257\tpub enum Message<T>\n   258\twhere\n   259\t    T: Entry,\n   260\t{\n   261\t    SequencePaxos(PaxosMessage<T>),\n   262\t    BLE(BLEMessage),\n   263\t    #[cfg(feature = \"async_runtime\")]\n   264\t    AsyncRuntime(AsyncRuntimeMessage<T>),\n   265\t}\n   266\t\n   267\timpl<T> Message<T>\n   268\twhere\n   269\t    T: Entry,\n   270\t{\n   271\t    /// Get the sender id of the message\n   272\t    pub fn get_sender(&self) -> NodeId {\n   273\t        match self {\n   274\t            Message::SequencePaxos(p) => p.from,\n   275\t            Message::BLE(b) => b.from,\n   276\t            #[cfg(feature = \"async_runtime\")]\n   277\t            Message::AsyncRuntime(a) => a.from,\n   278\t        }\n   279\t    }\n   280\t\n   281\t    /// Get the receiver id of the message\n   282\t    pub fn get_receiver(&self) -> NodeId {\n   283\t        match self {\n   284\t            Message::SequencePaxos(p) => p.to,\n   285\t            Message::BLE(b) => b.to,\n   286\t            #[cfg(feature = \"async_runtime\")]\n   287\t            Message::AsyncRuntime(a) => a.to,\n   288\t        }\n   289\t    }\n   290\t}\n   291\t\n   292\t/// Messages exchanged between actor instances for `append_notify` correlation.\n   293\t/// These do not touch the core Paxos protocol — they run alongside it.\n   294\t#[cfg(feature = \"async_runtime\")]\n   295\tpub mod async_runtime {\n   296\t    use crate::{ballot_leader_election::Ballot, storage::Entry, util::NodeId};\n   297\t    #[cfg(feature = \"serde\")]\n   298\t    use serde::{Deserialize, Serialize};\n   299\t\n   300\t    /// A unique identifier for a tagged proposal, used to correlate a\n   301\t    /// forwarded entry with its assigned log index.\n   302\t    #[derive(Copy, Clone, Debug, Eq, PartialEq, Hash)]\n   303\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   304\t    pub struct EntryId(pub uuid::Uuid);\n   305\t\n   306\t    /// Wrapper carrying sender/receiver for an [`AsyncRuntimeMsg`].\n   307\t    #[derive(Clone, Debug)]\n   308\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   309\t    pub struct AsyncRuntimeMessage<T>\n   310\t    where\n   311\t        T: Entry,\n   312\t    {\n   313\t        /// Sender of `msg`.\n   314\t        pub from: NodeId,\n   315\t        /// Receiver of `msg`.\n   316\t        pub to: NodeId,\n   317\t        /// The runtime-message content.\n   318\t        pub msg: AsyncRuntimeMsg<T>,\n   319\t    }\n   320\t\n   321\t    /// Runtime-layer messages used by the actor to correlate `append_notify` calls\n   322\t    /// with the log index the leader eventually assigns.\n   323\t    #[allow(missing_docs)]\n   324\t    #[derive(Clone, Debug)]\n   325\t    #[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n   326\t    pub enum AsyncRuntimeMsg<T>\n   327\t    where\n   328\t        T: Entry,\n   329\t    {\n   330\t        /// Follower actor → leader actor. Carries entries the originator(s) want\n   331\t        /// tracked, batched into one message. Replaces the untagged\n   332\t        /// `PaxosMsg::ProposalForward` path when the caller used `append_notify`.\n   333\t        TaggedProposal { entries: Vec<(EntryId, T)> },\n   334\t        /// Leader actor → originating follower actor. Carries, for each entry in a\n   335\t        /// previously received `TaggedProposal` batch that was actually accepted,\n   336\t        /// the log index the leader assigned, plus the single full ballot under\n   337\t        /// which the *whole batch* was accepted (one ballot, not per-entry: the\n   338\t        /// leader processes one incoming `TaggedProposal` synchronously with no\n   339\t        /// yield points, so every entry in it is necessarily accepted under the\n   340\t        /// same ballot).\n   341\t        Assigned {\n   342\t            ballot: Ballot,\n   343\t            entries: Vec<(EntryId, usize)>,\n   344\t        },\n   345\t    }\n   346\t}\n","exit_code":0,"status":"completed"}}
