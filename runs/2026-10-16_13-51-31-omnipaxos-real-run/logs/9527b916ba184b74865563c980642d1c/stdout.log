{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/agent-source/omnipaxos && cat -n src/sequence_paxos/mod.rs'","aggregated_output":"     1\tuse super::{ballot_leader_election::Ballot, messages::sequence_paxos::*, util::LeaderState};\n     2\t#[cfg(feature = \"logging\")]\n     3\tuse crate::utils::logger::create_logger;\n     4\tuse crate::{\n     5\t    messages::Message,\n     6\t    storage::{\n     7\t        internal_storage::{InternalStorage, InternalStorageConfig},\n     8\t        Entry, Snapshot, StopSign, Storage,\n     9\t    },\n    10\t    util::{\n    11\t        FlexibleQuorum, LogSync, NodeId, Quorum, SequenceNumber, READ_ERROR_MSG, WRITE_ERROR_MSG,\n    12\t    },\n    13\t    ClusterConfig, CompactionErr, OmniPaxosConfig, ProposeErr,\n    14\t};\n    15\t#[cfg(feature = \"logging\")]\n    16\tuse slog::{debug, info, trace, warn, Logger};\n    17\tuse std::{fmt::Debug, vec};\n    18\t\n    19\tpub mod follower;\n    20\tpub mod leader;\n    21\t\n    22\t/// a Sequence Paxos replica. Maintains local state of the replicated log, handles incoming messages and produces outgoing messages that the user has to fetch periodically and send using a network implementation.\n    23\t/// User also has to periodically fetch the decided entries that are guaranteed to be strongly consistent and linearizable, and therefore also safe to be used in the higher level application.\n    24\t/// If snapshots are not desired to be used, use `()` for the type parameter `S`.\n    25\tpub(crate) struct SequencePaxos<T, B>\n    26\twhere\n    27\t    T: Entry,\n    28\t    B: Storage<T>,\n    29\t{\n    30\t    pub(crate) internal_storage: InternalStorage<B, T>,\n    31\t    pid: NodeId,\n    32\t    peers: Vec<NodeId>, // excluding self pid\n    33\t    state: (Role, Phase),\n    34\t    buffered_proposals: Vec<T>,\n    35\t    buffered_stopsign: Option<StopSign>,\n    36\t    outgoing: Vec<Message<T>>,\n    37\t    leader_state: LeaderState<T>,\n    38\t    latest_accepted_meta: Option<(Ballot, usize)>,\n    39\t    // Keeps track of sequence of accepts from leader where AcceptSync = 1\n    40\t    current_seq_num: SequenceNumber,\n    41\t    cached_promise_message: Option<Promise<T>>,\n    42\t    #[cfg(feature = \"logging\")]\n    43\t    logger: Logger,\n    44\t}\n    45\t\n    46\timpl<T, B> SequencePaxos<T, B>\n    47\twhere\n    48\t    T: Entry,\n    49\t    B: Storage<T>,\n    50\t{\n    51\t    /*** User functions ***/\n    52\t    /// Creates a Sequence Paxos replica.\n    53\t    pub(crate) fn with(config: SequencePaxosConfig, storage: B) -> Self {\n    54\t        let pid = config.pid;\n    55\t        let peers = config.peers;\n    56\t        let num_nodes = &peers.len() + 1;\n    57\t        let quorum = Quorum::with(config.flexible_quorum, num_nodes);\n    58\t        let max_peer_pid = peers.iter().max().unwrap();\n    59\t        let max_pid = *std::cmp::max(max_peer_pid, &pid) as usize;\n    60\t        let mut outgoing = Vec::with_capacity(config.buffer_size);\n    61\t        let (state, leader) = match storage\n    62\t            .get_promise()\n    63\t            .expect(\"storage error while trying to read promise\")\n    64\t        {\n    65\t            // if we recover a promise from storage then we must do failure recovery\n    66\t            Some(b) => {\n    67\t                let state = (Role::Follower, Phase::Recover);\n    68\t                for peer_pid in &peers {\n    69\t                    let prepreq = PrepareReq { n: b };\n    70\t                    outgoing.push(Message::SequencePaxos(PaxosMessage {\n    71\t                        from: pid,\n    72\t                        to: *peer_pid,\n    73\t                        msg: PaxosMsg::PrepareReq(prepreq),\n    74\t                    }));\n    75\t                }\n    76\t                (state, b)\n    77\t            }\n    78\t            None => ((Role::Follower, Phase::None), Ballot::default()),\n    79\t        };\n    80\t        let internal_storage_config = InternalStorageConfig {\n    81\t            batch_size: config.batch_size,\n    82\t        };\n    83\t        let mut paxos = SequencePaxos {\n    84\t            internal_storage: InternalStorage::with(\n    85\t                storage,\n    86\t                internal_storage_config,\n    87\t                #[cfg(feature = \"unicache\")]\n    88\t                pid,\n    89\t            ),\n    90\t            pid,\n    91\t            peers,\n    92\t            state,\n    93\t            buffered_proposals: vec![],\n    94\t            buffered_stopsign: None,\n    95\t            outgoing,\n    96\t            leader_state: LeaderState::<T>::with(leader, max_pid, quorum),\n    97\t            latest_accepted_meta: None,\n    98\t            current_seq_num: SequenceNumber::default(),\n    99\t            cached_promise_message: None,\n   100\t            #[cfg(feature = \"logging\")]\n   101\t            logger: {\n   102\t                if let Some(logger) = config.custom_logger {\n   103\t                    logger\n   104\t                } else {\n   105\t                    let s = config\n   106\t                        .logger_file_path\n   107\t                        .unwrap_or_else(|| format!(\"logs/paxos_{}.log\", pid));\n   108\t                    create_logger(s.as_str())\n   109\t                }\n   110\t            },\n   111\t        };\n   112\t        paxos\n   113\t            .internal_storage\n   114\t            .set_promise(leader)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        #[cfg(feature = \"logging\")]\n   117\t        {\n   118\t            info!(paxos.logger, \"Paxos component pid: {} created!\", pid);\n   119\t            if let Quorum::Flexible(flex_quorum) = quorum {\n   120\t                if flex_quorum.read_quorum_size > num_nodes - flex_quorum.write_quorum_size + 1 {\n   121\t                    warn!(\n   122\t                        paxos.logger,\n   123\t                        \"Unnecessary overlaps in read and write quorums. Read and Write quorums only need to be overlapping by one node i.e., read_quorum_size + write_quorum_size = num_nodes + 1\");\n   124\t                }\n   125\t            }\n   126\t        }\n   127\t        paxos\n   128\t    }\n   129\t\n   130\t    pub(crate) fn get_state(&self) -> &(Role, Phase) {\n   131\t        &self.state\n   132\t    }\n   133\t\n   134\t    pub(crate) fn get_promise(&self) -> Ballot {\n   135\t        self.internal_storage.get_promise()\n   136\t    }\n   137\t\n   138\t    /// Initiates the trim process.\n   139\t    /// # Arguments\n   140\t    /// * `trim_idx` - Deletes all entries up to [`trim_idx`], if the [`trim_idx`] is `None` then the minimum index accepted by **ALL** servers will be used as the [`trim_idx`].\n   141\t    pub(crate) fn trim(&mut self, trim_idx: Option<usize>) -> Result<(), CompactionErr> {\n   142\t        match self.state {\n   143\t            (Role::Leader, _) => {\n   144\t                let min_all_accepted_idx = self.leader_state.get_min_all_accepted_idx();\n   145\t                let trimmed_idx = match trim_idx {\n   146\t                    Some(idx) if idx <= *min_all_accepted_idx => idx,\n   147\t                    None => {\n   148\t                        #[cfg(feature = \"logging\")]\n   149\t                        trace!(\n   150\t                            self.logger,\n   151\t                            \"No trim index provided, using min_las_idx: {:?}\",\n   152\t                            min_all_accepted_idx\n   153\t                        );\n   154\t                        *min_all_accepted_idx\n   155\t                    }\n   156\t                    _ => {\n   157\t                        return Err(CompactionErr::NotAllDecided(*min_all_accepted_idx));\n   158\t                    }\n   159\t                };\n   160\t                let result = self.internal_storage.try_trim(trimmed_idx);\n   161\t                if result.is_ok() {\n   162\t                    for pid in &self.peers {\n   163\t                        let msg = PaxosMsg::Compaction(Compaction::Trim(trimmed_idx));\n   164\t                        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   165\t                            from: self.pid,\n   166\t                            to: *pid,\n   167\t                            msg,\n   168\t                        }));\n   169\t                    }\n   170\t                }\n   171\t                result.map_err(|e| {\n   172\t                    *e.downcast()\n   173\t                        .expect(\"storage error while trying to trim log\")\n   174\t                })\n   175\t            }\n   176\t            _ => Err(CompactionErr::NotCurrentLeader(self.get_current_leader())),\n   177\t        }\n   178\t    }\n   179\t\n   180\t    /// Trim the log and create a snapshot. ** Note: only up to the `decided_idx` can be snapshotted **\n   181\t    /// # Arguments\n   182\t    /// `idx` - Snapshots all entries with index < [`idx`], if the [`idx`] is None then the decided index will be used.\n   183\t    /// `local_only` - If `true`, only this server snapshots the log. If `false` all servers performs the snapshot.\n   184\t    pub(crate) fn snapshot(\n   185\t        &mut self,\n   186\t        idx: Option<usize>,\n   187\t        local_only: bool,\n   188\t    ) -> Result<(), CompactionErr> {\n   189\t        let result = self.internal_storage.try_snapshot(idx);\n   190\t        if !local_only && result.is_ok() {\n   191\t            // since it is decided, it is ok even for a follower to send this\n   192\t            for pid in &self.peers {\n   193\t                let msg = PaxosMsg::Compaction(Compaction::Snapshot(idx));\n   194\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   195\t                    from: self.pid,\n   196\t                    to: *pid,\n   197\t                    msg,\n   198\t                }));\n   199\t            }\n   200\t        }\n   201\t        result.map_err(|e| {\n   202\t            *e.downcast()\n   203\t                .expect(\"storage error while trying to snapshot log\")\n   204\t        })\n   205\t    }\n   206\t\n   207\t    /// Return the decided index.\n   208\t    pub(crate) fn get_decided_idx(&self) -> usize {\n   209\t        self.internal_storage.get_decided_idx()\n   210\t    }\n   211\t\n   212\t    /// Return trim index from storage.\n   213\t    pub(crate) fn get_compacted_idx(&self) -> usize {\n   214\t        self.internal_storage.get_compacted_idx()\n   215\t    }\n   216\t\n   217\t    fn handle_compaction(&mut self, c: Compaction) {\n   218\t        // try trimming and snapshotting forwarded compaction. Errors are ignored as that the data will still be kept.\n   219\t        match c {\n   220\t            Compaction::Trim(idx) => {\n   221\t                let _ = self.internal_storage.try_trim(idx);\n   222\t            }\n   223\t            Compaction::Snapshot(idx) => {\n   224\t                let _ = self.snapshot(idx, true);\n   225\t            }\n   226\t        }\n   227\t    }\n   228\t\n   229\t    /// Detects if a Prepare, Promise, AcceptStopSign, Decide of a Stopsign, or PrepareReq message\n   230\t    /// has been sent but not been received. If so resends them. Note: We can't detect if a\n   231\t    /// StopSign's Decide message has been received so we always resend to be safe.\n   232\t    pub(crate) fn resend_message_timeout(&mut self) {\n   233\t        match self.state.0 {\n   234\t            Role::Leader => self.resend_messages_leader(),\n   235\t            Role::Follower => self.resend_messages_follower(),\n   236\t        }\n   237\t    }\n   238\t\n   239\t    /// Flushes any batched log entries and sends their corresponding Accept or Accepted messages.\n   240\t    pub(crate) fn flush_batch_timeout(&mut self) {\n   241\t        match self.state {\n   242\t            (Role::Leader, Phase::Accept) => self.flush_batch_leader(),\n   243\t            (Role::Follower, Phase::Accept) => self.flush_batch_follower(),\n   244\t            _ => (),\n   245\t        }\n   246\t    }\n   247\t\n   248\t    /// Moves the outgoing messages from this replica into the buffer. The messages should then be sent via the network implementation.\n   249\t    /// If `buffer` is empty, it gets swapped with the internal message buffer. Otherwise, messages are appended to the buffer. This prevents messages from getting discarded.\n   250\t    /// the buffer.\n   251\t    pub(crate) fn take_outgoing_msgs(&mut self, buffer: &mut Vec<Message<T>>) {\n   252\t        if buffer.is_empty() {\n   253\t            std::mem::swap(buffer, &mut self.outgoing);\n   254\t        } else {\n   255\t            // User has unsent messages in their buffer, must extend their buffer.\n   256\t            buffer.append(&mut self.outgoing);\n   257\t        }\n   258\t        self.leader_state.reset_latest_accept_meta();\n   259\t        self.latest_accepted_meta = None;\n   260\t    }\n   261\t\n   262\t    /// Handle an incoming message.\n   263\t    pub(crate) fn handle(&mut self, m: PaxosMessage<T>) {\n   264\t        match m.msg {\n   265\t            PaxosMsg::PrepareReq(prepreq) => self.handle_preparereq(prepreq, m.from),\n   266\t            PaxosMsg::Prepare(prep) => self.handle_prepare(prep, m.from),\n   267\t            PaxosMsg::Promise(prom) => match &self.state {\n   268\t                (Role::Leader, Phase::Prepare) => self.handle_promise_prepare(prom, m.from),\n   269\t                (Role::Leader, Phase::Accept) => self.handle_promise_accept(prom, m.from),\n   270\t                _ => {}\n   271\t            },\n   272\t            PaxosMsg::AcceptSync(acc_sync) => self.handle_acceptsync(acc_sync, m.from),\n   273\t            PaxosMsg::AcceptDecide(acc) => self.handle_acceptdecide(acc),\n   274\t            PaxosMsg::NotAccepted(not_acc) => self.handle_notaccepted(not_acc, m.from),\n   275\t            PaxosMsg::Accepted(accepted) => self.handle_accepted(accepted, m.from),\n   276\t            PaxosMsg::Decide(d) => self.handle_decide(d),\n   277\t            PaxosMsg::ProposalForward(proposals) => self.handle_forwarded_proposal(proposals),\n   278\t            PaxosMsg::Compaction(c) => self.handle_compaction(c),\n   279\t            PaxosMsg::AcceptStopSign(acc_ss) => self.handle_accept_stopsign(acc_ss),\n   280\t            PaxosMsg::ForwardStopSign(f_ss) => self.handle_forwarded_stopsign(f_ss),\n   281\t        }\n   282\t    }\n   283\t\n   284\t    /// Returns whether this Sequence Paxos has been reconfigured\n   285\t    pub(crate) fn is_reconfigured(&self) -> Option<StopSign> {\n   286\t        match self.internal_storage.get_stopsign() {\n   287\t            Some(ss) if self.internal_storage.stopsign_is_decided() => Some(ss),\n   288\t            _ => None,\n   289\t        }\n   290\t    }\n   291\t\n   292\t    /// Returns whether this Sequence Paxos instance is stopped, i.e. if it has been reconfigured.\n   293\t    fn accepted_reconfiguration(&self) -> bool {\n   294\t        self.internal_storage.get_stopsign().is_some()\n   295\t    }\n   296\t\n   297\t    /// Append an entry to the replicated log.\n   298\t    pub(crate) fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   299\t        if self.accepted_reconfiguration() {\n   300\t            Err(ProposeErr::PendingReconfigEntry(entry))\n   301\t        } else {\n   302\t            self.propose_entry(entry);\n   303\t            Ok(())\n   304\t        }\n   305\t    }\n   306\t\n   307\t    /// Propose a reconfiguration. Returns an error if already stopped or `new_config` is invalid.\n   308\t    /// `new_config` defines the cluster-wide configuration settings for the next cluster.\n   309\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   310\t    pub(crate) fn reconfigure(\n   311\t        &mut self,\n   312\t        new_config: ClusterConfig,\n   313\t        metadata: Option<Vec<u8>>,\n   314\t    ) -> Result<(), ProposeErr<T>> {\n   315\t        if self.accepted_reconfiguration() {\n   316\t            return Err(ProposeErr::PendingReconfigConfig(new_config, metadata));\n   317\t        }\n   318\t        #[cfg(feature = \"logging\")]\n   319\t        info!(\n   320\t            self.logger,\n   321\t            \"Accepting reconfiguration {:?}\", new_config.nodes\n   322\t        );\n   323\t        let ss = StopSign::with(new_config, metadata);\n   324\t        match self.state {\n   325\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n   326\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n   327\t            _ => self.forward_stopsign(ss),\n   328\t        }\n   329\t        Ok(())\n   330\t    }\n   331\t\n   332\t    fn get_current_leader(&self) -> NodeId {\n   333\t        self.get_promise().pid\n   334\t    }\n   335\t\n   336\t    /// Returns this node's own pid.\n   337\t    pub(crate) fn get_pid(&self) -> NodeId {\n   338\t        self.pid\n   339\t    }\n   340\t\n   341\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   342\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   343\t    pub(crate) fn reconnected(&mut self, pid: NodeId) {\n   344\t        if pid == self.pid {\n   345\t            return;\n   346\t        } else if pid == self.get_current_leader() {\n   347\t            self.state = (Role::Follower, Phase::Recover);\n   348\t        }\n   349\t        let prepreq = PrepareReq {\n   350\t            n: self.get_promise(),\n   351\t        };\n   352\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   353\t            from: self.pid,\n   354\t            to: pid,\n   355\t            msg: PaxosMsg::PrepareReq(prepreq),\n   356\t        }));\n   357\t    }\n   358\t\n   359\t    fn propose_entry(&mut self, entry: T) {\n   360\t        match self.state {\n   361\t            (Role::Leader, Phase::Prepare) => self.buffered_proposals.push(entry),\n   362\t            (Role::Leader, Phase::Accept) => self.accept_entry_leader(entry),\n   363\t            _ => self.forward_proposals(vec![entry]),\n   364\t        }\n   365\t    }\n   366\t\n   367\t    pub(crate) fn get_leader_state(&self) -> &LeaderState<T> {\n   368\t        &self.leader_state\n   369\t    }\n   370\t\n   371\t    pub(crate) fn forward_proposals(&mut self, mut entries: Vec<T>) {\n   372\t        let leader = self.get_current_leader();\n   373\t        if leader > 0 && self.pid != leader {\n   374\t            let pf = PaxosMsg::ProposalForward(entries);\n   375\t            let msg = Message::SequencePaxos(PaxosMessage {\n   376\t                from: self.pid,\n   377\t                to: leader,\n   378\t                msg: pf,\n   379\t            });\n   380\t            self.outgoing.push(msg);\n   381\t        } else {\n   382\t            self.buffered_proposals.append(&mut entries);\n   383\t        }\n   384\t    }\n   385\t\n   386\t    pub(crate) fn forward_stopsign(&mut self, ss: StopSign) {\n   387\t        let leader = self.get_current_leader();\n   388\t        if leader > 0 && self.pid != leader {\n   389\t            #[cfg(feature = \"logging\")]\n   390\t            trace!(self.logger, \"Forwarding StopSign to Leader {:?}\", leader);\n   391\t            let fs = PaxosMsg::ForwardStopSign(ss);\n   392\t            let msg = Message::SequencePaxos(PaxosMessage {\n   393\t                from: self.pid,\n   394\t                to: leader,\n   395\t                msg: fs,\n   396\t            });\n   397\t            self.outgoing.push(msg);\n   398\t        } else if self.buffered_stopsign.as_mut().is_none() {\n   399\t            self.buffered_stopsign = Some(ss);\n   400\t        }\n   401\t    }\n   402\t    /// Returns `LogSync`, a struct to help other servers synchronize their log to correspond to the\n   403\t    /// current state of our own log. The `common_prefix_idx` marks where in the log the other server\n   404\t    /// needs to be sync from.\n   405\t    fn create_log_sync(\n   406\t        &self,\n   407\t        common_prefix_idx: usize,\n   408\t        other_logs_decided_idx: usize,\n   409\t    ) -> LogSync<T> {\n   410\t        let decided_idx = self.internal_storage.get_decided_idx();\n   411\t        let (decided_snapshot, suffix, sync_idx) =\n   412\t            if T::Snapshot::use_snapshots() && decided_idx > common_prefix_idx {\n   413\t                // Note: We snapshot from the other log's decided index and not the common prefix because\n   414\t                // snapshots currently only work on decided entries.\n   415\t                let (delta_snapshot, compacted_idx) = self\n   416\t                    .internal_storage\n   417\t                    .create_diff_snapshot(other_logs_decided_idx)\n   418\t                    .expect(READ_ERROR_MSG);\n   419\t                let suffix = self\n   420\t                    .internal_storage\n   421\t                    .get_suffix(decided_idx)\n   422\t                    .expect(READ_ERROR_MSG);\n   423\t                (delta_snapshot, suffix, compacted_idx)\n   424\t            } else {\n   425\t                let suffix = self\n   426\t                    .internal_storage\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n   446\t}\n   447\t\n   448\t#[derive(PartialEq, Debug)]\n   449\tpub(crate) enum Role {\n   450\t    Follower,\n   451\t    Leader,\n   452\t}\n   453\t\n   454\t/// Configuration for `SequencePaxos`.\n   455\t/// # Fields\n   456\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   457\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   458\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   459\t/// * `buffer_size`: The buffer size for outgoing messages.\n   460\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   461\t/// * `logger_file_path`: The path where the default logger logs events.\n   462\t#[derive(Clone, Debug)]\n   463\tpub(crate) struct SequencePaxosConfig {\n   464\t    pid: NodeId,\n   465\t    peers: Vec<NodeId>,\n   466\t    buffer_size: usize,\n   467\t    pub(crate) batch_size: usize,\n   468\t    flexible_quorum: Option<FlexibleQuorum>,\n   469\t    #[cfg(feature = \"logging\")]\n   470\t    logger_file_path: Option<String>,\n   471\t    #[cfg(feature = \"logging\")]\n   472\t    custom_logger: Option<Logger>,\n   473\t}\n   474\t\n   475\timpl From<OmniPaxosConfig> for SequencePaxosConfig {\n   476\t    fn from(config: OmniPaxosConfig) -> Self {\n   477\t        let pid = config.server_config.pid;\n   478\t        let peers = config\n   479\t            .cluster_config\n   480\t            .nodes\n   481\t            .into_iter()\n   482\t            .filter(|x| *x != pid)\n   483\t            .collect();\n   484\t        SequencePaxosConfig {\n   485\t            pid,\n   486\t            peers,\n   487\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   488\t            buffer_size: config.server_config.buffer_size,\n   489\t            batch_size: config.server_config.batch_size,\n   490\t            #[cfg(feature = \"logging\")]\n   491\t            logger_file_path: config.server_config.logger_file_path,\n   492\t            #[cfg(feature = \"logging\")]\n   493\t            custom_logger: config.server_config.custom_logger,\n   494\t        }\n   495\t    }\n   496\t}\n","exit_code":0,"status":"completed"}}
