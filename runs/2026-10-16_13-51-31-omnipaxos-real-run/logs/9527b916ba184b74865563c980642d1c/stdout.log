{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/src/lib.rs omnipaxos_runtime/src/traits.rs omnipaxos_runtime/src/event.rs omnipaxos_runtime/README.md'","aggregated_output":"     1\t//! Async runtime actor layer for OmniPaxos.\n     2\t//!\n     3\t//! The [`AsyncRuntime`] trait abstracts over the async executor so this crate can be used\n     4\t//! on top of any runtime. A ready-to-use [`TokioRuntime`] is provided behind the\n     5\t//! `tokio_runtime` feature.\n     6\t//!\n     7\t//! The main entry point is [`spawn_actor`], which takes an\n     8\t//! [`OmniPaxos`](omnipaxos::OmniPaxos) instance and returns an [`OmniPaxosHandle`]. The\n     9\t//! handle is cloneable and provides `async` methods to append entries and observe state\n    10\t//! transitions.\n    11\t//!\n    12\t//! The runtime does NOT own message transport: use [`OmniPaxosHandle::outgoing_messages`]\n    13\t//! to drain outgoing messages and [`OmniPaxosHandle::handle_incoming`] to deliver\n    14\t//! incoming ones. This keeps the crate free of I/O dependencies and lets users plug in\n    15\t//! any transport (TCP, QUIC, in-process channels, etc.).\n    16\t\n    17\t#![deny(missing_docs)]\n    18\t\n    19\tmod actor;\n    20\tmod event;\n    21\tmod handle;\n    22\tmod traits;\n    23\t\n    24\t#[cfg(feature = \"tokio_runtime\")]\n    25\tmod tokio_rt;\n    26\t\n    27\tpub use event::{AppendError, OmniPaxosEvent, RuntimeProposeErr};\n    28\tpub use handle::{spawn_actor, OmniPaxosHandle, RuntimeConfig};\n    29\tpub use omnipaxos::messages::EntryId;\n    30\tpub use traits::{ActorEntry, AsyncRuntime};\n    31\t\n    32\t#[cfg(feature = \"tokio_runtime\")]\n    33\tpub use tokio_rt::TokioRuntime;\n    34\tuse core::{future::Future, time::Duration};\n    35\t\n    36\tuse omnipaxos::storage::Entry;\n    37\t\n    38\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n    39\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n    40\t/// covers any `Entry` whose associated types are `Send`.\n    41\t#[cfg(not(feature = \"unicache\"))]\n    42\tpub trait ActorEntry: Entry<Snapshot: Send> + Send + 'static {}\n    43\t\n    44\t#[cfg(not(feature = \"unicache\"))]\n    45\timpl<T> ActorEntry for T where T: Entry<Snapshot: Send> + Send + 'static {}\n    46\t\n    47\t/// A blanket trait that fixes all the `Send` bounds an [`Entry`] must satisfy to cross\n    48\t/// the actor boundary. Users normally do not implement this manually — a blanket impl\n    49\t/// covers any `Entry` whose associated types are `Send`.\n    50\t#[cfg(feature = \"unicache\")]\n    51\tpub trait ActorEntry:\n    52\t    Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n    53\t{\n    54\t}\n    55\t\n    56\t#[cfg(feature = \"unicache\")]\n    57\timpl<T> ActorEntry for T where\n    58\t    T: Entry<Snapshot: Send, UniCache: Send, EncodeResult: Send> + Send + 'static\n    59\t{\n    60\t}\n    61\t\n    62\t/// Abstraction over an async executor.\n    63\t///\n    64\t/// Implement this trait to run OmniPaxos on runtimes other than tokio. Two primitives\n    65\t/// are required: task spawning and a timer. The actor loop builds intervals on top of\n    66\t/// [`AsyncRuntime::sleep`], so no separate `interval` primitive is needed.\n    67\tpub trait AsyncRuntime: 'static {\n    68\t    /// The join handle returned by [`AsyncRuntime::spawn`]. The runtime is free to\n    69\t    /// return `()` if it does not need cancellation or joining.\n    70\t    type JoinHandle: Send + 'static;\n    71\t\n    72\t    /// Spawn a future onto the executor.\n    73\t    fn spawn<F>(future: F) -> Self::JoinHandle\n    74\t    where\n    75\t        F: Future<Output = ()> + Send + 'static;\n    76\t\n    77\t    /// Return a future that resolves after `duration` elapses.\n    78\t    fn sleep(duration: Duration) -> impl Future<Output = ()> + Send + 'static;\n    79\t}\n    80\tuse core::time::Duration;\n    81\t\n    82\tuse futures::channel::oneshot;\n    83\t\n    84\tuse omnipaxos::{\n    85\t    storage::Entry,\n    86\t    util::{LogEntry, NodeId},\n    87\t    ClusterConfig, ProposeErr,\n    88\t};\n    89\t\n    90\t/// A state transition observed by the actor and broadcast on the event stream.\n    91\t#[derive(Debug, Clone)]\n    92\tpub enum OmniPaxosEvent {\n    93\t    /// A new leader was observed on this node.\n    94\t    LeaderElected {\n    95\t        /// The pid of the elected leader.\n    96\t        pid: NodeId,\n    97\t        /// Whether this node's phase is `Phase::Accept`.\n    98\t        accepted: bool,\n    99\t    },\n   100\t    /// The decided index advanced. The value is the new decided index.\n   101\t    Decided {\n   102\t        /// The new decided index.\n   103\t        new_decided_idx: usize,\n   104\t    },\n   105\t    /// A reconfiguration StopSign was decided.\n   106\t    Reconfigured {\n   107\t        /// The log index at which the StopSign was decided.\n   108\t        stop_sign_idx: usize,\n   109\t    },\n   110\t}\n   111\t\n   112\t/// Error returned by [`OmniPaxosHandle::append_notify`](super::OmniPaxosHandle::append_notify).\n   113\t#[derive(Debug)]\n   114\tpub enum AppendError<T>\n   115\twhere\n   116\t    T: Entry,\n   117\t{\n   118\t    /// The underlying [`OmniPaxos::append`](omnipaxos::OmniPaxos::append) call failed while\n   119\t    /// this node was accepting the entry as leader (e.g. a reconfiguration is already\n   120\t    /// pending). Unlike the other variants, this is resolved immediately rather than\n   121\t    /// waiting for `append_notify_timeout` -- but only when this node itself owns the\n   122\t    /// pending call (i.e. it originated the `append_notify` or was routed to it as\n   123\t    /// leader). If the failure happens on a different node than the origin, the origin\n   124\t    /// still just sees a `Timeout`, since surfacing the specific error cross-node would\n   125\t    /// require a new wire message.\n   126\t    Propose(ProposeErr<T>),\n   127\t    /// A leader change occurred after the entry was accepted at the given index but\n   128\t    /// before it was decided. This is a *heuristic*, not a certainty: a new leader is\n   129\t    /// required to adopt any value a majority-overlapping quorum may have already\n   130\t    /// accepted, so the entry can still end up decided at `log_entry_idx` under the\n   131\t    /// new ballot -- we just stop waiting rather than confirm it. Check\n   132\t    /// [`OmniPaxosHandle::read_decided_suffix`](super::OmniPaxosHandle::read_decided_suffix)\n   133\t    /// at that index if you need to know for sure before re-appending.\n   134\t    Superseded {\n   135\t        /// The log index the entry was assigned before the leader change.\n   136\t        log_entry_idx: usize,\n   137\t    },\n   138\t    /// The `append_notify_timeout` elapsed before the entry was decided. Retry safe.\n   139\t    Timeout,\n   140\t    /// The actor has shut down before the entry could be decided.\n   141\t    Shutdown,\n   142\t    /// The actor already has [`RuntimeConfig::max_pending_appends`](super::RuntimeConfig::max_pending_appends)\n   143\t    /// outstanding `append_notify` calls; this one was rejected immediately rather\n   144\t    /// than queued. Nothing was proposed, so it's safe to retry (ideally after a\n   145\t    /// backoff, since the backlog needs time to drain).\n   146\t    TooManyOutstanding,\n   147\t}\n   148\t\n   149\t/// Error returned by [`OmniPaxosHandle::append`](super::OmniPaxosHandle::append) and\n   150\t/// [`OmniPaxosHandle::reconfigure`](super::OmniPaxosHandle::reconfigure). Distinct from\n   151\t/// [`AppendError`]: these calls don't track decision, so they only ever fail\n   152\t/// synchronously -- either the propose call itself was rejected, or the actor is gone.\n   153\t#[derive(Debug)]\n   154\tpub enum RuntimeProposeErr<T>\n   155\twhere\n   156\t    T: Entry,\n   157\t{\n   158\t    /// The underlying propose call failed (e.g. a reconfiguration is already pending,\n   159\t    /// or an invalid cluster config was proposed).\n   160\t    Propose(ProposeErr<T>),\n   161\t    /// The actor has shut down.\n   162\t    Shutdown,\n   163\t}\n   164\t\n   165\t/// Commands sent from an [`OmniPaxosHandle`](super::OmniPaxosHandle) to the actor task.\n   166\t///\n   167\t/// This type is `pub(crate)` because it is an implementation detail of the actor <-> handle\n   168\t/// protocol.\n   169\tpub(crate) enum Command<T>\n   170\twhere\n   171\t    T: Entry,\n   172\t{\n   173\t    Append {\n   174\t        entry: T,\n   175\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n   176\t    },\n   177\t    AppendNotify {\n   178\t        entry: T,\n   179\t        /// Overrides [`RuntimeConfig::append_notify_timeout`](super::RuntimeConfig::append_notify_timeout)\n   180\t        /// for this call only, if `Some`.\n   181\t        timeout: Option<Duration>,\n   182\t        reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n   183\t    },\n   184\t    CurrentLeader {\n   185\t        reply: oneshot::Sender<Option<(NodeId, bool)>>,\n   186\t    },\n   187\t    DecidedIdx {\n   188\t        reply: oneshot::Sender<usize>,\n   189\t    },\n   190\t    ReadDecidedSuffix {\n   191\t        from: usize,\n   192\t        reply: oneshot::Sender<Option<Vec<LogEntry<T>>>>,\n   193\t    },\n   194\t    SubscribeDecided {\n   195\t        from: usize,\n   196\t        tx: async_channel::Sender<LogEntry<T>>,\n   197\t    },\n   198\t    Reconfigure {\n   199\t        new_configuration: ClusterConfig,\n   200\t        metadata: Option<Vec<u8>>,\n   201\t        reply: oneshot::Sender<Result<(), ProposeErr<T>>>,\n   202\t    },\n   203\t    TryBecomeLeader,\n   204\t    Reconnected {\n   205\t        pid: NodeId,\n   206\t    },\n   207\t}\n   208\t# OmniPaxos Runtime\n   209\tAsync runtime actor layer for [OmniPaxos](https://omnipaxos.com/). Spawns an `OmniPaxos`\n   210\tinstance as a background actor and returns a cloneable `OmniPaxosHandle` with `async`\n   211\tmethods to append entries, subscribe to decided entries, and observe leader/reconfiguration\n   212\tevents -- no manual driving of `tick()`, `send_msg()`, or `outgoing_messages()` needed.\n   213\t\n   214\tThe runtime is generic over the async executor via the `AsyncRuntime` trait; a ready-to-use\n   215\t`TokioRuntime` is provided behind the `tokio_runtime` feature. See\n   216\t`examples/kv_store_async` for a full usage example.\n   217\t\n   218\t## Usage\n   219\t\n   220\t```toml\n   221\t[dependencies]\n   222\tomnipaxos = { version = \"0.2.3\", features = [\"async_runtime\"] }\n   223\tomnipaxos_runtime = { version = \"0.1.0\", features = [\"tokio_runtime\"] }\n   224\t```\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/src/actor.rs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/agent-source && cat -n omnipaxos_runtime/src/actor.rs'","aggregated_output":"     1\tuse core::time::Duration;\n     2\tuse std::{\n     3\t    collections::{HashMap, VecDeque},\n     4\t    marker::PhantomData,\n     5\t    time::Instant,\n     6\t};\n     7\t\n     8\tuse futures::{channel::oneshot, select_biased, FutureExt, StreamExt};\n     9\t\n    10\tuse omnipaxos::{\n    11\t    ballot_leader_election::Ballot,\n    12\t    messages::{\n    13\t        async_runtime::{AsyncRuntimeMessage, AsyncRuntimeMsg, EntryId},\n    14\t        Message,\n    15\t    },\n    16\t    storage::{Entry, Storage},\n    17\t    util::{LogEntry, NodeId},\n    18\t    OmniPaxos, ProposeErr,\n    19\t};\n    20\t\n    21\tuse super::{\n    22\t    event::{AppendError, Command, OmniPaxosEvent},\n    23\t    handle::RuntimeConfig,\n    24\t    traits::{ActorEntry, AsyncRuntime},\n    25\t};\n    26\t\n    27\t/// Actor-loop-relevant subset of [`RuntimeConfig`]. Excludes the channel-capacity\n    28\t/// fields, which are only needed once, to construct the channels in `spawn_actor`\n    29\t/// before the actor itself is built — mirrors how `SequencePaxosConfig` in the core\n    30\t/// crate trims down the public `OmniPaxosConfig` to just what that component needs.\n    31\tpub(crate) struct ActorConfig {\n    32\t    tick_period: Duration,\n    33\t    egress_period: Duration,\n    34\t    append_notify_timeout: Duration,\n    35\t    max_pending_appends: usize,\n    36\t    max_decided_subscribers: usize,\n    37\t    max_outgoing_buffered: usize,\n    38\t}\n    39\t\n    40\timpl From<&RuntimeConfig> for ActorConfig {\n    41\t    fn from(cfg: &RuntimeConfig) -> Self {\n    42\t        Self {\n    43\t            tick_period: cfg.tick_period,\n    44\t            egress_period: cfg.egress_period,\n    45\t            append_notify_timeout: cfg.append_notify_timeout,\n    46\t            max_pending_appends: cfg.max_pending_appends,\n    47\t            max_decided_subscribers: cfg.max_decided_subscribers,\n    48\t            max_outgoing_buffered: cfg.max_outgoing_buffered,\n    49\t        }\n    50\t    }\n    51\t}\n    52\t\n    53\t/// A pending `append_notify` awaiting decision. Uniform representation regardless\n    54\t/// of whether the entry was accepted locally (we are leader) or forwarded (we are\n    55\t/// follower). The `assigned` field is filled in by either code path; the drain\n    56\t/// loop treats every pending item the same way.\n    57\tstruct Pending<T>\n    58\twhere\n    59\t    T: Entry,\n    60\t{\n    61\t    id: EntryId,\n    62\t    /// The entry, retained until dispatched (accepted locally or sent as a\n    63\t    /// `TaggedProposal`). While `Some`, `try_dispatch_undispatched` retries it\n    64\t    /// each tick — this is what lets `append_notify` be called before a\n    65\t    /// leader is known.\n    66\t    undispatched: Option<T>,\n    67\t    /// `(assigned_idx, ballot_at_assignment)`. `None` until either:\n    68\t    ///   (a) we accepted the entry ourselves as leader, or\n    69\t    ///   (b) we received `AsyncRuntimeMsg::Assigned` from the leader.\n    70\t    assigned: Option<(usize, Ballot)>,\n    71\t    deadline: Instant,\n    72\t    reply: oneshot::Sender<Result<usize, AppendError<T>>>,\n    73\t}\n    74\t\n    75\t/// What to do, once its index is known, for a write buffered in the shared\n    76\t/// batch buffer. Every code path that can add to that buffer pushes one of\n    77\t/// these (see `track_untracked_batch_growth`), keeping `unconfirmed_local`'s\n    78\t/// FIFO position in sync with the buffer regardless of source.\n    79\tenum TrackIntent {\n    80\t    /// Not tracked: a plain `Command::Append`, or an entry that entered the\n    81\t    /// buffer via core-internal protocol handling we have no id for (a\n    82\t    /// forwarded proposal, replicated entries, a reconfiguration stopsign).\n    83\t    Untracked,\n    84\t    /// Resolve a pending `append_notify` we own directly, via `self.pending`,\n    85\t    /// once this index is known.\n    86\t    Local(EntryId),\n    87\t    /// Reply with `AsyncRuntimeMsg::Assigned` to `from` once this index is\n    88\t    /// known -- used for entries that arrived via a remote `TaggedProposal`\n    89\t    /// and got deferred by batching rather than accepted immediately (the\n    90\t    /// immediate case is handled inline by `handle_runtime_msg` instead).\n    91\t    Remote { id: EntryId, from: NodeId },\n    92\t}\n    93\t\n    94\tpub(crate) struct ActorState<T, B>\n    95\twhere\n    96\t    T: Entry,\n    97\t    B: Storage<T>,\n    98\t{\n    99\t    pub(crate) op: OmniPaxos<T, B>,\n   100\t    pub(crate) cmd_rx: async_channel::Receiver<Command<T>>,\n   101\t    pub(crate) incoming_rx: async_channel::Receiver<Message<T>>,\n   102\t    pub(crate) outgoing_tx: async_channel::Sender<Message<T>>,\n   103\t    pub(crate) event_tx: async_channel::Sender<OmniPaxosEvent>,\n   104\t    pub(crate) config: ActorConfig,\n   105\t\n   106\t    pid: NodeId,\n   107\t    outgoing_buf: Vec<Message<T>>,\n   108\t    pending: VecDeque<Pending<T>>,\n   109\t    decided_subscribers: Vec<DecidedSub<T>>,\n   110\t    last_leader: Option<(NodeId, bool)>,\n   111\t    last_decided_idx: usize,\n   112\t    last_reconfigured: bool,\n   113\t    /// One entry per write currently sitting in the shared per-node batch\n   114\t    /// buffer, in the order it was added, awaiting the flush that assigns it\n   115\t    /// an index. Popping one entry per unit of `get_accepted_idx()` advance\n   116\t    /// (`reconcile_unconfirmed`) lines up with what actually flushed. Paired\n   117\t    /// with the ballot in effect when buffered so a leader change before the\n   118\t    /// flush is detected rather than mis-assigned.\n   119\t    unconfirmed_local: VecDeque<(TrackIntent, Ballot)>,\n   120\t    last_seen_accepted_idx: usize,\n   121\t}\n   122\t\n   123\t/// A single subscriber to the decided-log stream. `next_idx` is the next log\n   124\t/// index the actor must deliver; incremented on every successful `try_send`.\n   125\tstruct DecidedSub<T>\n   126\twhere\n   127\t    T: Entry,\n   128\t{\n   129\t    next_idx: usize,\n   130\t    tx: async_channel::Sender<LogEntry<T>>,\n   131\t}\n   132\t\n   133\timpl<T, B> ActorState<T, B>\n   134\twhere\n   135\t    T: Entry,\n   136\t    B: Storage<T>,\n   137\t{\n   138\t    pub(crate) fn new(\n   139\t        op: OmniPaxos<T, B>,\n   140\t        cmd_rx: async_channel::Receiver<Command<T>>,\n   141\t        incoming_rx: async_channel::Receiver<Message<T>>,\n   142\t        outgoing_tx: async_channel::Sender<Message<T>>,\n   143\t        event_tx: async_channel::Sender<OmniPaxosEvent>,\n   144\t        config: ActorConfig,\n   145\t    ) -> Self {\n   146\t        let last_decided_idx = op.get_decided_idx();\n   147\t        let last_leader = op.get_current_leader();\n   148\t        let pid = op.get_pid();\n   149\t        let accepted_idx = op.get_accepted_idx();\n   150\t        Self {\n   151\t            op,\n   152\t            cmd_rx,\n   153\t            incoming_rx,\n   154\t            outgoing_tx,\n   155\t            event_tx,\n   156\t            config,\n   157\t            pid,\n   158\t            outgoing_buf: Vec::new(),\n   159\t            pending: VecDeque::new(),\n   160\t            decided_subscribers: Vec::new(),\n   161\t            last_leader,\n   162\t            last_decided_idx,\n   163\t            last_reconfigured: false,\n   164\t            unconfirmed_local: VecDeque::new(),\n   165\t            last_seen_accepted_idx: accepted_idx,\n   166\t        }\n   167\t    }\n   168\t\n   169\t    async fn detect_and_emit_events(&mut self) {\n   170\t        let cur = self.op.get_current_leader();\n   171\t        if cur != self.last_leader {\n   172\t            if let Some((pid, accepted)) = cur {\n   173\t                let _ = self\n   174\t                    .event_tx\n   175\t                    .send(OmniPaxosEvent::LeaderElected { pid, accepted })\n   176\t                    .await;\n   177\t            }\n   178\t            self.last_leader = cur;\n   179\t        }\n   180\t        let d = self.op.get_decided_idx();\n   181\t        if d > self.last_decided_idx {\n   182\t            let _ = self\n   183\t                .event_tx\n   184\t                .send(OmniPaxosEvent::Decided { new_decided_idx: d })\n   185\t                .await;\n   186\t            self.last_decided_idx = d;\n   187\t        }\n   188\t        if !self.last_reconfigured {\n   189\t            if let Some(_ss) = self.op.is_reconfigured() {\n   190\t                let _ = self\n   191\t                    .event_tx\n   192\t                    .send(OmniPaxosEvent::Reconfigured {\n   193\t                        stop_sign_idx: self.op.get_decided_idx(),\n   194\t                    })\n   195\t                    .await;\n   196\t                self.last_reconfigured = true;\n   197\t            }\n   198\t        }\n   199\t    }\n   200\t\n   201\t    fn drain_notifiers(&mut self) {\n   202\t        let decided = self.op.get_decided_idx();\n   203\t        let now = Instant::now();\n   204\t        let cur_ballot = self.op.get_promise();\n   205\t        let old = std::mem::take(&mut self.pending);\n   206\t        for p in old {\n   207\t            match p.assigned {\n   208\t                Some((idx, _)) if idx <= decided => {\n   209\t                    let _ = p.reply.send(Ok(idx));\n   210\t                }\n   211\t                Some((idx, ballot)) if ballot < cur_ballot => {\n   212\t                    let _ = p\n   213\t                        .reply\n   214\t                        .send(Err(AppendError::Superseded { log_entry_idx: idx }));\n   215\t                }\n   216\t                _ if now > p.deadline => {\n   217\t                    let _ = p.reply.send(Err(AppendError::Timeout));\n   218\t                }\n   219\t                _ => self.pending.push_back(p),\n   220\t            }\n   221\t        }\n   222\t    }\n   223\t\n   224\t    /// Effective cap for `outgoing_buf`: the channel's own capacity when known,\n   225\t    /// else [`ActorConfig::max_outgoing_buffered`].\n   226\t    fn outgoing_buf_cap(&self) -> usize {\n   227\t        self.outgoing_tx\n   228\t            .capacity()\n   229\t            .unwrap_or(self.config.max_outgoing_buffered)\n   230\t    }\n   231\t\n   232\t    /// Non-blocking drain of `outgoing_buf` onto `outgoing_tx`. Uses `try_send`\n   233\t    /// so a merely-full channel (slow consumer) doesn't block the actor loop;\n   234\t    /// unsent messages stay in `outgoing_buf` (in order) for the next attempt.\n   235\t    /// If the buffer exceeds [`Self::outgoing_buf_cap`], oldest messages are\n   236\t    /// dropped — see [`RuntimeConfig::max_outgoing_buffered`].\n   237\t    fn drain_outgoing_buf(&mut self) {\n   238\t        let cap = self.outgoing_buf_cap();\n   239\t        trim_oldest(&mut self.outgoing_buf, cap);\n   240\t\n   241\t        let pending = std::mem::take(&mut self.outgoing_buf);\n   242\t        let mut iter = pending.into_iter();\n   243\t        for msg in iter.by_ref() {\n   244\t            match self.outgoing_tx.try_send(msg) {\n   245\t                Ok(()) => {}\n   246\t                Err(async_channel::TrySendError::Full(msg)) => {\n   247\t                    self.outgoing_buf.push(msg);\n   248\t                    break;\n   249\t                }\n   250\t                Err(async_channel::TrySendError::Closed(_)) => {\n   251\t                    // Receiver dropped — user is not draining outgoing. Discard\n   252\t                    // everything remaining; nothing left to retry against.\n   253\t                    return;\n   254\t                }\n   255\t            }\n   256\t        }\n   257\t        self.outgoing_buf.extend(iter);\n   258\t    }\n   259\t\n   260\t    /// Enqueue one outgoing message without awaiting. Appends behind any\n   261\t    /// already-buffered messages (preserves order), then tries to drain.\n   262\t    /// Used for both core protocol traffic (via [`Self::flush_outgoing`]) and\n   263\t    /// runtime control-plane messages (`TaggedProposal` / `Assigned`).\n   264\t    fn enqueue_outgoing(&mut self, msg: Message<T>) {\n   265\t        self.outgoing_buf.push(msg);\n   266\t        self.drain_outgoing_buf();\n   267\t    }\n   268\t\n   269\t    /// Pull newly-produced OmniPaxos/BLE messages into `outgoing_buf` and drain.\n   270\t    fn flush_outgoing(&mut self) {\n   271\t        self.op.take_outgoing_messages(&mut self.outgoing_buf);\n   272\t        self.drain_outgoing_buf();\n   273\t    }\n   274\t\n   275\t    /// Push newly-decided entries to a single, freshly-added subscriber. Used\n   276\t    /// only on the immediate catch-up path from `Command::SubscribeDecided`,\n   277\t    /// where there is no shared read to amortize against. Returns `false` if\n   278\t    /// the receiver was already closed.\n   279\t    fn push_to_sub(op: &mut OmniPaxos<T, B>, sub: &mut DecidedSub<T>) -> bool {\n   280\t        let decided = op.get_decided_idx();\n   281\t        if sub.next_idx >= decided {\n   282\t            return true;\n   283\t        }\n   284\t        let Some(entries) = op.read_decided_suffix(sub.next_idx) else {\n   285\t            return true;\n   286\t        };\n   287\t        for entry in entries {\n   288\t            match sub.tx.try_send(entry) {\n   289\t                Ok(()) => sub.next_idx += 1,\n   290\t                Err(async_channel::TrySendError::Full(_)) => return true,\n   291\t                Err(async_channel::TrySendError::Closed(_)) => return false,\n   292\t            }\n   293\t        }\n   294\t        true\n   295\t    }\n   296\t\n   297\t    /// Push newly-decided entries to every subscriber, reading the log suffix\n   298\t    /// **once** and fanning out. Each sub keeps its own cursor, so slow subs\n   299\t    /// don't block fast ones; the storage read is amortized across all subs\n   300\t    /// starting from the trailing sub's position.\n   301\t    fn push_to_all_subs(&mut self) {\n   302\t        if self.decided_subscribers.is_empty() {\n   303\t            return;\n   304\t        }\n   305\t        let cur = self.op.get_decided_idx();\n   306\t        let min_next = self\n   307\t            .decided_subscribers\n   308\t            .iter()\n   309\t            .map(|s| s.next_idx)\n   310\t            .min()\n   311\t            .expect(\"non-empty checked above\");\n   312\t        if min_next >= cur {\n   313\t            return;\n   314\t        }\n   315\t        // Read once, from the trailing sub's position. `entries[i]` is the log\n   316\t        // entry at position `min_next + i`.\n   317\t        let Some(entries) = self.op.read_decided_suffix(min_next) else {\n   318\t            return;\n   319\t        };\n   320\t        // Fan out; drop closed subscribers in place via retain_mut.\n   321\t        self.decided_subscribers.retain_mut(|sub| {\n   322\t            // sub.next_idx should always be >= min_next; guard defensively.\n   323\t            let start = sub.next_idx.saturating_sub(min_next);\n   324\t            for entry in entries.iter().skip(start) {\n   325\t                match sub.tx.try_send(entry.clone()) {\n   326\t                    Ok(()) => sub.next_idx += 1,\n   327\t                    Err(async_channel::TrySendError::Full(_)) => break,\n   328\t                    Err(async_channel::TrySendError::Closed(_)) => return false,\n   329\t                }\n   330\t            }\n   331\t            true\n   332\t        });\n   333\t    }\n   334\t\n   335\t    fn record_assignment(&mut self, id: EntryId, idx: usize, ballot: Ballot) {\n   336\t        for p in self.pending.iter_mut() {\n   337\t            if p.id == id {\n   338\t                p.assigned = Some((idx, ballot));\n   339\t                return;\n   340\t            }\n   341\t        }\n   342\t        // No matching pending — late reply after timeout drain, or duplicate. Ignore.\n   343\t    }\n   344\t\n   345\t    /// Resolves a pending `append_notify` immediately with the propose error that\n   346\t    /// just failed it, instead of leaving it to silently time out. Only affects\n   347\t    /// entries this node itself owns in `self.pending` — when `id` came from a\n   348\t    /// remote `TaggedProposal`, the owning `Pending` lives on the origin node, so\n   349\t    /// this is a no-op there and that call still resolves via `Timeout`.\n   350\t    fn resolve_pending_failed(&mut self, id: EntryId, err: ProposeErr<T>) {\n   351\t        if let Some(pos) = self.pending.iter().position(|p| p.id == id) {\n   352\t            let p = self.pending.remove(pos).unwrap();\n   353\t            let _ = p.reply.send(Err(AppendError::Propose(err)));\n   354\t        }\n   355\t    }\n   356\t\n   357\t    /// Appends `entry` to the local log, tracking it in `unconfirmed_local` if\n   358\t    /// the write is genuinely deferred by batching (`get_batched_len()` grew)\n   359\t    /// rather than immediately reflected in `get_accepted_idx()`. `intent`\n   360\t    /// says what to do with the eventual index; plain `Command::Append` passes\n   361\t    /// `TrackIntent::Untracked`.\n   362\t    ///\n   363\t    /// Must check `get_batched_len()` rather than inferring \"batched\" from\n   364\t    /// `before == after`: a follower, or a leader still in `Phase::Prepare`,\n   365\t    /// also has `before == after`, but the entry went to `buffered_proposals`\n   366\t    /// or out as a `ProposalForward`, not the shared batch buffer — pushing a\n   367\t    /// placeholder for that case would desync `unconfirmed_local`'s FIFO\n   368\t    /// count. `accept_as_leader`'s stable-leader gate means only plain\n   369\t    /// `Command::Append` can hit this case.\n   370\t    fn append_tracked(\n   371\t        &mut self,\n   372\t        intent: TrackIntent,\n   373\t        entry: T,\n   374\t    ) -> Result<Option<(usize, Ballot)>, ProposeErr<T>> {\n   375\t        let accepted_before = self.op.get_accepted_idx();\n   376\t        let batched_before = self.op.get_batched_len();\n   377\t        self.op.append(entry)?;\n   378\t        let accepted_after = self.op.get_accepted_idx();\n   379\t        let batched_after = self.op.get_batched_len();\n   380\t        if accepted_after > accepted_before {\n   381\t            let ballot = self.op.get_promise();\n   382\t            if let TrackIntent::Local(id) = intent {\n   383\t                self.record_assignment(id, accepted_after, ballot);\n   384\t            }\n   385\t            Ok(Some((accepted_after, ballot)))\n   386\t        } else if batched_after > batched_before {\n   387\t            // Genuinely deferred by batching.\n   388\t            self.unconfirmed_local\n   389\t                .push_back((intent, self.op.get_promise()));\n   390\t            Ok(None)\n   391\t        } else {\n   392\t            // Went somewhere else entirely (forwarded, or buffered pending a\n   393\t            // Prepare -> Accept transition) -- nothing entered the shared\n   394\t            // batch buffer, so there's nothing to track here.\n   395\t            Ok(None)\n   396\t        }\n   397\t    }\n   398\t\n   399\t    /// Leader-side accept, for an entry we originate locally (`from: None`)\n   400\t    /// or received via `TaggedProposal` from follower `from`. Populates the\n   401\t    /// pending's `assigned` (or, if buffered by batching, queues a\n   402\t    /// `TrackIntent` for `reconcile_unconfirmed` to resolve later) and\n   403\t    /// returns `(id, assigned_idx)` if accepted immediately, so batch callers\n   404\t    /// can collect these and send one `Assigned` reply for the whole batch.\n   405\t    fn accept_as_leader(\n   406\t        &mut self,\n   407\t        id: EntryId,\n   408\t        entry: T,\n   409\t        from: Option<NodeId>,\n   410\t    ) -> Option<(EntryId, usize)> {\n   411\t        // Only accept while leadership is stable (Accept phase).\n   412\t        let stable_leader =\n   413\t            matches!(self.op.get_current_leader(), Some((pid, true)) if pid == self.pid);\n   414\t        if !stable_leader {\n   415\t            return None;\n   416\t        }\n   417\t        let intent = match from {\n   418\t            None => TrackIntent::Local(id),\n   419\t            Some(from) => TrackIntent::Remote { id, from },\n   420\t        };\n   421\t        match self.append_tracked(intent, entry) {\n   422\t            Ok(Some((after, _ballot))) => Some((id, after)),\n   423\t            Ok(None) => None,\n   424\t            Err(err) => {\n   425\t                self.resolve_pending_failed(id, err);\n   426\t                None\n   427\t            }\n   428\t        }\n   429\t    }\n   430\t\n   431\t    /// Matches everything buffered in `unconfirmed_local` to the index it's\n   432\t    /// assigned once its batch flushes and `get_accepted_idx()` advances.\n   433\t    /// FIFO correspondence is exact here regardless of what added to the\n   434\t    /// shared batch buffer (see `unconfirmed_local`'s doc comment), as long as\n   435\t    /// the ballot hasn't changed since the entry was buffered; if it has,\n   436\t    /// leadership moved on and this index may belong to different writes, so\n   437\t    /// we drop tracking for it and let the caller time out.\n   438\t    fn reconcile_unconfirmed(&mut self) {\n   439\t        let cur_ballot = self.op.get_promise();\n   440\t        let accepted = self.op.get_accepted_idx();\n   441\t        let mut idx = self.last_seen_accepted_idx;\n   442\t        // Entries from a single remote TaggedProposal batch can resolve\n   443\t        // across several different `idx` values here (their own batch may\n   444\t        // have been interleaved with others' writes); group by origin so\n   445\t        // each gets one `Assigned` reply instead of one message per entry.\n   446\t        let mut remote_assigned: HashMap<NodeId, Vec<(EntryId, usize)>> = HashMap::new();\n   447\t        while idx < accepted {\n   448\t            idx += 1;\n   449\t            let Some((intent, ballot)) = self.unconfirmed_local.pop_front() else {\n   450\t                break;\n   451\t            };\n   452\t            if ballot != cur_ballot {\n   453\t                // Leadership moved on since this was buffered; the index may\n   454\t                // belong to different writes. Drop tracking -- Local/Remote\n   455\t                // origins simply time out, matching the ballot-mismatch\n   456\t                // handling in `drain_notifiers` for already-assigned entries.\n   457\t                continue;\n   458\t            }\n   459\t            match intent {\n   460\t                TrackIntent::Untracked => {}\n   461\t                TrackIntent::Local(id) => self.record_assignment(id, idx, ballot),\n   462\t                TrackIntent::Remote { id, from } => {\n   463\t                    remote_assigned.entry(from).or_default().push((id, idx));\n   464\t                }\n   465\t            }\n   466\t        }\n   467\t        self.last_seen_accepted_idx = accepted;\n   468\t\n   469\t        for (from, entries) in remote_assigned {\n   470\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   471\t                from: self.pid,\n   472\t                to: from,\n   473\t                msg: AsyncRuntimeMsg::Assigned {\n   474\t                    ballot: cur_ballot,\n   475\t                    entries,\n   476\t                },\n   477\t            }));\n   478\t        }\n   479\t    }\n   480\t\n   481\t    /// Attempt to dispatch every pending entry that hasn't yet been sent or\n   482\t    /// accepted locally. Called from `Command::AppendNotify` and on each tick,\n   483\t    /// which lets a call issued *before* an election eventually succeed once a\n   484\t    /// leader is known.\n   485\t    fn try_dispatch_undispatched(&mut self) {\n   486\t        let Some((leader, accepted)) = self.op.get_current_leader() else {\n   487\t            return;\n   488\t        };\n   489\t        if leader == self.pid && !accepted {\n   490\t            // We're leader but not yet in Accept phase — leave entries undispatched\n   491\t            // and wait for the next tick.\n   492\t            return;\n   493\t        }\n   494\t        let entries: Vec<(EntryId, T)> = self\n   495\t            .pending\n   496\t            .iter_mut()\n   497\t            .filter_map(|p| p.undispatched.take().map(|entry| (p.id, entry)))\n   498\t            .collect();\n   499\t        if leader == self.pid {\n   500\t            for (id, entry) in entries {\n   501\t                self.accept_as_leader(id, entry, None);\n   502\t            }\n   503\t        } else if !entries.is_empty() {\n   504\t            self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   505\t                from: self.pid,\n   506\t                to: leader,\n   507\t                msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   508\t            }));\n   509\t        }\n   510\t    }\n   511\t\n   512\t    fn handle_runtime_msg(&mut self, arm: AsyncRuntimeMessage<T>) {\n   513\t        match arm.msg {\n   514\t            AsyncRuntimeMsg::TaggedProposal { entries } => {\n   515\t                let cur = self.op.get_current_leader().map(|(p, _)| p);\n   516\t                if cur == Some(self.pid) {\n   517\t                    // Collect accepted assignments and reply to the origin with a\n   518\t                    // single batched `Assigned`.\n   519\t                    let from = arm.from;\n   520\t                    let assigned: Vec<(EntryId, usize)> = entries\n   521\t                        .into_iter()\n   522\t                        .filter_map(|(id, entry)| self.accept_as_leader(id, entry, Some(from)))\n   523\t                        .collect();\n   524\t                    if !assigned.is_empty() {\n   525\t                        let ballot = self.op.get_promise();\n   526\t                        self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   527\t                            from: self.pid,\n   528\t                            to: arm.from,\n   529\t                            msg: AsyncRuntimeMsg::Assigned {\n   530\t                                ballot,\n   531\t                                entries: assigned,\n   532\t                            },\n   533\t                        }));\n   534\t                    }\n   535\t                } else if let Some(new_leader) = cur {\n   536\t                    // Leadership drifted since sender chose us. Hop the whole batch\n   537\t                    // forward, preserving the original `from` so the leader replies\n   538\t                    // to the true origin.\n   539\t                    self.enqueue_outgoing(Message::AsyncRuntime(AsyncRuntimeMessage {\n   540\t                        from: arm.from,\n   541\t                        to: new_leader,\n   542\t                        msg: AsyncRuntimeMsg::TaggedProposal { entries },\n   543\t                    }));\n   544\t                }\n   545\t                // Else: no leader; drop. Originators will timeout.\n   546\t            }\n   547\t            AsyncRuntimeMsg::Assigned { ballot, entries } => {\n   548\t                for (id, assigned_idx) in entries {\n   549\t                    self.record_assignment(id, assigned_idx, ballot);\n   550\t                }\n   551\t            }\n   552\t        }\n   553\t    }\n   554\t\n   555\t    /// Given a `(batched_len, accepted_idx)` snapshot taken before some call\n   556\t    /// that may have silently added to the shared batch buffer (a forwarded\n   557\t    /// proposal, an incoming replication batch, a reconfiguration stopsign),\n   558\t    /// pushes a `TrackIntent::Untracked` placeholder in `unconfirmed_local`\n   559\t    /// for each newly-added entry, keeping its FIFO count accurate.\n   560\t    ///\n   561\t    /// Growth is `(accepted_after - accepted_before) + (batched_after -\n   562\t    /// batched_before)`, computed with signed arithmetic and clamped at 0:\n   563\t    /// `accepted_idx` can legitimately *decrease* when a follower's log is\n   564\t    /// truncated by an incoming `AcceptSync` from a new leader, which isn't a\n   565\t    /// case with anything new to track.\n   566\t    fn track_batch_growth(&mut self, batched_before: usize, accepted_before: usize) {\n   567\t        let batched_after = self.op.get_batched_len();\n   568\t        let accepted_after = self.op.get_accepted_idx();\n   569\t        let added = accepted_after as isize - accepted_before as isize + batched_after as isize\n   570\t            - batched_before as isize;\n   571\t        let ballot = self.op.get_promise();\n   572\t        for _ in 0..added.max(0) {\n   573\t            self.unconfirmed_local\n   574\t                .push_back((TrackIntent::Untracked, ballot));\n   575\t        }\n   576\t    }\n   577\t\n   578\t    /// Delivers an incoming `SequencePaxos`/BLE message to the core, tracking\n   579\t    /// any entries it silently adds to the shared batch buffer -- see\n   580\t    /// `track_batch_growth`.\n   581\t    fn handle_incoming_tracked(&mut self, m: Message<T>) {\n   582\t        let batched_before = self.op.get_batched_len();\n   583\t        let accepted_before = self.op.get_accepted_idx();\n   584\t        self.op.handle_incoming(m);\n   585\t        self.track_batch_growth(batched_before, accepted_before);\n   586\t    }\n   587\t\n   588\t    async fn handle_command(&mut self, cmd: Command<T>) {\n   589\t        match cmd {\n   590\t            Command::Append { entry, reply } => {\n   591\t                // Via append_tracked (not self.op.append) so a deferred write\n   592\t                // still gets its unconfirmed_local placeholder, keeping FIFO\n   593\t                // position exact for any append_notify entries batched alongside it.\n   594\t                let res = self\n   595\t                    .append_tracked(TrackIntent::Untracked, entry)\n   596\t                    .map(|_| ());\n   597\t                let _ = reply.send(res);\n   598\t            }\n   599\t            Command::AppendNotify {\n   600\t                entry,\n   601\t                timeout,\n   602\t                reply,\n   603\t            } => {\n   604\t                if self.pending.len() >= self.config.max_pending_appends {\n   605\t                    let _ = reply.send(Err(AppendError::TooManyOutstanding));\n   606\t                    return;\n   607\t                }\n   608\t                let id = EntryId(uuid::Uuid::new_v4());\n   609\t                let timeout = timeout.unwrap_or(self.config.append_notify_timeout);\n   610\t                self.pending.push_back(Pending {\n   611\t                    id,\n   612\t                    undispatched: Some(entry),\n   613\t                    assigned: None,\n   614\t                    deadline: Instant::now() + timeout,\n   615\t                    reply,\n   616\t                });\n   617\t                self.try_dispatch_undispatched();\n   618\t            }\n   619\t            Command::CurrentLeader { reply } => {\n   620\t                let _ = reply.send(self.op.get_current_leader());\n   621\t            }\n   622\t            Command::DecidedIdx { reply } => {\n   623\t                let _ = reply.send(self.op.get_decided_idx());\n   624\t            }\n   625\t            Command::ReadDecidedSuffix { from, reply } => {\n   626\t                let _ = reply.send(self.op.read_decided_suffix(from));\n   627\t            }\n   628\t            Command::SubscribeDecided { from, tx } => {\n   629\t                if self.decided_subscribers.len() >= self.config.max_decided_subscribers {\n   630\t                    // Reject: drop `tx` without storing it, closing the\n   631\t                    // subscriber's channel immediately with no entries delivered.\n   632\t                    return;\n   633\t                }\n   634\t                let mut sub = DecidedSub { next_idx: from, tx };\n   635\t                // Immediate catch-up: push whatever is already decided from `from`.\n   636\t                if Self::push_to_sub(&mut self.op, &mut sub) {\n   637\t                    self.decided_subscribers.push(sub);\n   638\t                }\n   639\t            }\n   640\t            Command::Reconfigure {\n   641\t                new_configuration,\n   642\t                metadata,\n   643\t                reply,\n   644\t            } => {\n   645\t                // Wrapped like handle_incoming_tracked: a stopsign accepted as\n   646\t                // leader is itself an untracked addition to the shared batch buffer.\n   647\t                let batched_before = self.op.get_batched_len();\n   648\t                let accepted_before = self.op.get_accepted_idx();\n   649\t                let res = self.op.reconfigure(new_configuration, metadata);\n   650\t                self.track_batch_growth(batched_before, accepted_before);\n   651\t                let _ = reply.send(res);\n   652\t            }\n   653\t            Command::TryBecomeLeader => {\n   654\t                self.op.try_become_leader();\n   655\t            }\n   656\t            Command::Reconnected { pid } => {\n   657\t                self.op.reconnected(pid);\n   658\t            }\n   659\t        }\n   660\t    }\n   661\t}\n   662\t\n   663\t/// Drives the actor. Runs until all handles are dropped (both `cmd_tx` and\n   664\t/// `incoming_tx` senders closed).\n   665\tpub(crate) async fn run<T, B, R>(mut state: ActorState<T, B>, _rt: PhantomData<fn() -> R>)\n   666\twhere\n   667\t    T: ActorEntry,\n   668\t    B: Storage<T> + Send + 'static,\n   669\t    R: AsyncRuntime,\n   670\t{\n   671\t    let mut tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   672\t    let mut egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   673\t\n   674\t    // async_channel::Receiver is !Unpin; keep it in a Pin<Box<...>> so the Stream\n   675\t    // impl works under select_biased!.\n   676\t    let cmd_rx = std::mem::replace(&mut state.cmd_rx, async_channel::bounded(1).1);\n   677\t    let incoming_rx = std::mem::replace(&mut state.incoming_rx, async_channel::bounded(1).1);\n   678\t    let mut cmd_rx = Box::pin(cmd_rx);\n   679\t    let mut incoming_rx = Box::pin(incoming_rx);\n   680\t\n   681\t    loop {\n   682\t        select_biased! {\n   683\t            _ = tick_fut => {\n   684\t                state.op.tick();\n   685\t                state.detect_and_emit_events().await;\n   686\t                state.try_dispatch_undispatched();\n   687\t                state.reconcile_unconfirmed();\n   688\t                state.drain_notifiers();\n   689\t                state.push_to_all_subs();\n   690\t                tick_fut = Box::pin(R::sleep(state.config.tick_period)).fuse();\n   691\t            }\n   692\t            _ = egress_fut => {\n   693\t                state.flush_outgoing();\n   694\t                egress_fut = Box::pin(R::sleep(state.config.egress_period)).fuse();\n   695\t            }\n   696\t            in_msg = incoming_rx.next() => {\n   697\t                match in_msg {\n   698\t                    Some(Message::AsyncRuntime(arm)) => state.handle_runtime_msg(arm),\n   699\t                    Some(m) => state.handle_incoming_tracked(m),\n   700\t                    None => break,\n   701\t                }\n   702\t            }\n   703\t            cmd = cmd_rx.next() => {\n   704\t                match cmd {\n   705\t                    Some(c) => state.handle_command(c).await,\n   706\t                    None => break,\n   707\t                }\n   708\t            }\n   709\t        }\n   710\t    }\n   711\t}\n   712\t\n   713\t/// Drops the oldest elements of `buf` until its length is at most `cap`, preserving\n   714\t/// the relative order of what remains. A no-op if `buf` is already within `cap`.\n   715\tfn trim_oldest<M>(buf: &mut Vec<M>, cap: usize) {\n   716\t    if buf.len() > cap {\n   717\t        let excess = buf.len() - cap;\n   718\t        buf.drain(..excess);\n   719\t    }\n   720\t}\n   721\t\n   722\t#[cfg(test)]\n   723\tmod tests {\n   724\t    use super::trim_oldest;\n   725\t\n   726\t    #[test]\n   727\t    fn trim_oldest_drops_front_keeps_cap_most_recent() {\n   728\t        let mut buf = vec![1, 2, 3, 4, 5];\n   729\t        trim_oldest(&mut buf, 3);\n   730\t        assert_eq!(buf, vec![3, 4, 5]);\n   731\t    }\n   732\t\n   733\t    #[test]\n   734\t    fn trim_oldest_is_noop_when_within_cap() {\n   735\t        let mut buf = vec![1, 2, 3];\n   736\t        trim_oldest(&mut buf, 5);\n   737\t        assert_eq!(buf, vec![1, 2, 3]);\n   738\t    }\n   739\t\n   740\t    #[test]\n   741\t    fn trim_oldest_is_noop_when_exactly_at_cap() {\n   742\t        let mut buf = vec![1, 2, 3];\n   743\t        trim_oldest(&mut buf, 3);\n   744\t        assert_eq!(buf, vec![1, 2, 3]);\n   745\t    }\n   746\t\n   747\t    #[test]\n   748\t    fn trim_oldest_can_drop_everything() {\n   749\t        let mut buf = vec![1, 2, 3];\n   750\t        trim_oldest(&mut buf, 0);\n   751\t        assert!(buf.is_empty());\n   752\t    }\n   753\t}\n","exit_code":0,"status":"completed"}}
