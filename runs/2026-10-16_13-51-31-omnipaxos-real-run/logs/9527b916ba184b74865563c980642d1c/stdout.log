ping_all_handles_shuts_actor_down() {\n823:#[tokio::test]\n824:async fn append_notify_resolves_propose_error_immediately() {\n861:#[tokio::test]\n862:async fn append_notify_shutdown_error_when_actor_gone() {\n901:#[tokio::test]\n902:async fn append_notify_superseded_when_entry_truly_lost() {\n1002:#[tokio::test]\n1003:async fn append_and_reconfigure_report_shutdown_not_fabricated_propose_error() {\n1048:#[tokio::test]\n1049:async fn full_outgoing_channel_does_not_stall_actor_loop() {\n1084:async fn spawn_cluster_pausable(\n1148:#[tokio::test]\n1149:async fn notify_egress_does_not_stall_when_outgoing_full() {\n1198:async fn recv_decided(\n1215:#[tokio::test]\n1216:async fn subscribe_decided_delivers_history_and_live() {\n1246:#[tokio::test]\n1247:async fn subscribe_decided_multi_subscriber_independent() {\n1276:#[tokio::test]\n1277:async fn subscribe_decided_drop_receiver_removes_sub() {\n1323:#[tokio::test]\n1324:async fn append_notify_index_correct_when_batched_with_plain_append() {\n1443:#[tokio::test]\n1444:async fn subscribe_decided_rejects_when_too_many_subscribers() {\n1468 omnipaxos_runtime/tests/async_runtime_test.rs\n","exit_code":0,"status":"completed"}}
