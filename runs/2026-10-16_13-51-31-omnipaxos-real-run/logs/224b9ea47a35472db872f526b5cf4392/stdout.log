mits CA_EVENT three_node_lost_accepteds_window {steps,resend_periods,produced,dropped,after_drop,accept_decide_total,leader_decided_idx,follower_2_accepted_idx,follower_3_accepted_idx,\\\"\n   \\\"both_followers_hold_undecided_entry} and asserts exactly two Accepted receipts were dropped, both followers really accepted the entry (accepted_idx 1) and hold it as Undecided at index 0, the leader is still at decided index 0 after the window, and only the two AcceptDecide messages of \\\"\n   \\\"the single proposal crossed (no new proposal). It then appends a second entry and emits CA_EVENT three_node_later_proposal_repairs {steps_until_decided,leader_decided_idx}. The 2-node cases from the earlier harness (lost Accepted -> undecided; delivered -> decided; later proposal \\\"\n   \\\"repairs) are included unchanged so the comparison spans both cluster sizes in one execution.\\\"),\n  \\\"scope\\\":{\\\"description\\\":(\\\"Generalization of the accept-phase repair gap from two nodes to three, where hiding the quorum from the leader requires dropping both follower receipts.\\\"),\n   \\\"assumptions\\\":[\\\"3-node cluster, majority quorum, error-free memory storage, in-order delivery of everything except the deliberately dropped receipts\\\",\\\"the leader is identified by leader_priority; the cluster is given time to reach the accept phase before the proposal\\\",\\\"writes are hand-driven; no real network and no concurrency\\\"],\n   \\\"excluded\\\":[\\\"clusters larger than three nodes\\\",\\\"any rate or probability claim about how often both receipts are lost\\\"],\n   \\\"parameters\\\":{\\\"nodes\\\":3,\\\"election_tick_timeout\\\":3,\\\"resend_message_tick_timeout\\\":5,\\\"steps\\\":500,\\\"resend_periods\\\":100,\\\"dropped_receipts\\\":2}},\n },\n}\njson.dump(d,open('update.json','w'),indent=2)\nprint('written')\nPY\ncd .. && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-as