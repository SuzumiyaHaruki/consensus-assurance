{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/draft && python3 - <<'PY'\np='assurance_generated.rs'\ns=open(p).read()\n\n# 1. helper\nanchor = \\\"/// A command round-trip completes: the actor task is running its select loop.\\\\n\\\"\nhelper = '''/// Emitted on stdout as a CA_EVENT JSON line so the receipt carries the observed\n/// operands, not just the test verdict.\nfn emit(line: &str) {\n    println\"'!(\"CA_EVENT {line}\");\n}\n\n'\"'''\nassert anchor in s\ns = s.replace(anchor, helper + anchor, 1)\n\n# 2. case 1 events\nold = \\\"\\\"\\\"    // Witness 1: every node reached the bound, so the actor cannot no longer publish\\\"\\\"\\\"\nold = \\\"\\\"\\\"    // Witness 1: every node reached the bound, so the actor can no longer publish\n    // the next transition it observes.\n    let deadline = tokio::time::Instant::now() + Duration::from_secs(8);\n    loop {\n        let full = [1u64, 2, 3]\n            .iter()\n            .filter(|pid| c.event_rx[pid].is_full() && \"'!c.event_rx[pid].is_closed())\n            .count();\n        if full == 3 {\n            break;\n        }\"\"\"\nnew = \"\"\"    // Witness 1: every node reached the bound, so the actor can no longer publish\n    // the next transition it observes.\n    let deadline = tokio::time::Instant::now() + Duration::from_secs(8);\n    let mut nodes_full = 0;\n    loop {\n        nodes_full = [1u64, 2, 3]\n            .iter()\n            .filter(|pid| c.event_rx[pid].is_full() && !c.event_rx[pid].is_closed())\n            .count();\n        if nodes_full == 3 {\n            break;\n        }\"\"\"\nassert old in s\ns = s.replace(old, new, 1)\n\nold2 = \"\"\"    let parked_pid = parked_pid.expect(\"no node stopped answering commands\");\"\"\"\nnew2 = \"\"\"    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"unconsumed_event_bound_reached\\\\\\\\\\\",\\\\\\\\\\\"nodes_full\\\\\\\\\\\":{nodes_full},\\\\\\\\\\\"nodes\\\\\\\\\\\":3,\\\\\\\\\\\"event_capacity\\\\\\\\\\\":{EVENT_CAPACITY}}}\\\"\n    ));\n    let parked_pid = parked_pid.expect(\\\"no node stopped answering commands\\\");\\\"\\\"\\\"\nassert old2 in s\ns = s.replace(old2, new2, 1)\n\nold3 = \\\"\\\"\\\"    // Witness 3: on that parked node the proposal endpoint is gone too - its\n    // append_notify_timeout is 1500ms, so a running actor would have answered\n    // (Timeout at the latest) well before the outer 4s.\\\"\\\"\\\"\nnew3 = \\\"\\\"\\\"    emit(&format\"'!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"actor_parked\\\\\\\\\\\",\\\\\\\\\\\"node\\\\\\\\\\\":{parked_pid},\\\\\\\\\\\"samples_without_reply\\\\\\\\\\\":10,\\\\\\\\\\\"reply_budget_ms\\\\\\\\\\\":200,\\\\\\\\\\\"permanently_parked\\\\\\\\\\\":{permanently_parked}}}\\\"\n    ));\n\n    // Witness 3: on that parked node the proposal endpoint is gone too - its\n    // append_notify_timeout is 1500ms, so a running actor would have answered\n    // (Timeout at the latest) well before the outer 4s.\\\"\\\"\\\"\nassert old3 in s\ns = s.replace(old3, new3, 1)\n\nold4 = \\\"\\\"\\\"    assert\"'!(\n        resolved.is_err(),\n        \"append_notify on parked node {parked_pid} resolved: {resolved:?}\"\n    );\n}\"\"\"\nnew4 = \"\"\"    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"append_notify_endpoint_withheld\\\\\\\\\\\",\\\\\\\\\\\"node\\\\\\\\\\\":{parked_pid},\\\\\\\\\\\"per_call_deadline_ms\\\\\\\\\\\":300,\\\\\\\\\\\"actor_timeout_ms\\\\\\\\\\\":1500,\\\\\\\\\\\"outer_wait_ms\\\\\\\\\\\":4000,\\\\\\\\\\\"resolved\\\\\\\\\\\":{}}}\\\",\n        resolved.is_ok()\n    ));\n    assert\"'!(\n        resolved.is_err(),\n        \"append_notify on parked node {parked_pid} resolved: {resolved:?}\"\n    );\n}\"\"\"\nassert old4 in s\ns = s.replace(old4, new4, 1)\n\n# 3. case 2 events\nold5 = \"\"\"    assert_eq!(\n        alive,\n        c.handles.len(),\n        \"control: some actor loop stopped with a drained event stream{}\",\n        channel_state(&c)\n    );\"\"\"\nnew5 = \"\"\"    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"control_actors_responsive\\\\\\\\\\\",\\\\\\\\\\\"nodes_answering\\\\\\\\\\\":{alive},\\\\\\\\\\\"nodes\\\\\\\\\\\":3,\\\\\\\\\\\"event_capacity\\\\\\\\\\\":{EVENT_CAPACITY}}}\\\"\n    ));\n    assert_eq\"'!(\n        alive,\n        c.handles.len(),\n        \"control: some actor loop stopped with a drained event stream{}\",\n        channel_state(&c)\n    );\"\"\"\nassert old5 in s\ns = s.replace(old5, new5, 1)\n\nold6 = \"\"\"    assert!(idx >= 1, \"control append_notify returned idx {idx}\");\"\"\"\nnew6 = \"\"\"    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"control_append_notify\\\\\\\\\\\",\\\\\\\\\\\"origin\\\\\\\\\\\":{follower},\\\\\\\\\\\"succeeded\\\\\\\\\\\":{},\\\\\\\\\\\"idx\\\\\\\\\\\":{idx}}}\\\",\n        idx >= 1\n    ));\n    assert\"'!(idx >= 1, \"control append_notify returned idx {idx}\");\"\"\"\nassert old6 in s\ns = s.replace(old6, new6, 1)\nopen(p,'\"'w').write(s)\nprint(\\\"ok\\\")\nPY\ncp assurance_generated.rs localws/omnipaxos_runtime/tests/assurance_generated.rs && cd localws && timeout 300 cargo test --offline --locked -p omnipaxos_runtime --test assurance_generated 2>&1 | tail -10\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
