{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/draft && python3 - <<'PY'\np='identity_probe.rs'\ns=open(p).read()\n# add a flow-specific block (sender -> receiver)\ns=s.replace(\\\"    blocked: AtomicU64,\\\\n    blocked_in: AtomicU64,\\\\n}\\\",\\\"    blocked: AtomicU64,\\\\n    blocked_in: AtomicU64,\\\\n    /// Optional (sender, receiver) pair whose messages are dropped.\\\\n    blocked_flow: Mutex<Option<(NodeId, NodeId)>>,\\\\n}\\\")\ns=s.replace(\\\"            blocked: AtomicU64::new(0),\\\\n            blocked_in: AtomicU64::new(0),\\\\n        })\\\",\\\"            blocked: AtomicU64::new(0),\\\\n            blocked_in: AtomicU64::new(0),\\\\n            blocked_flow: Mutex::new(None),\\\\n        })\\\")\ns=s.replace('''        if msg.get_sender() == wire.blocked.load(Ordering::SeqCst)\n            || msg.get_receiver() == wire.blocked_in.load(Ordering::SeqCst)\n        {\n            continue;\n        }''','''        if msg.get_sender() == wire.blocked.load(Ordering::SeqCst)\n            || msg.get_receiver() == wire.blocked_in.load(Ordering::SeqCst)\n        {\n            continue;\n        }\n        if let Some((from, to)) = *wire.blocked_flow.lock().unwrap() {\n            if msg.get_sender() == from && msg.get_receiver() == to {\n                continue;\n            }\n        }''')\ns += '''\n/// Scope control for the identity case: when the caller's entry *is* adopted by the\n/// following leader, the same call must report Ok(idx) truthfully - the entry at that\n/// index is the caller's entry. Node 3 is allowed to accept node 1's entry but its\n/// reply is dropped, so node 1 never learns about that acceptance and stays at\n/// decided 0 with the call still pending; node 2 then takes over, adopts node 3's log\n/// (which holds node 1's entry), and node 1 re-synchronizes.\n#[tokio::test]\nasync fn ok_is_truthful_when_the_entry_is_adopted() {\n    let nodes: Vec<NodeId> = vec\"'![1, 2, 3];\n    let cfg = RuntimeConfig {\n        tick_period: Duration::from_millis(2000),\n        egress_period: Duration::from_millis(1),\n        append_notify_timeout: Duration::from_secs(30),\n        ..Default::default()\n    };\n    let wire = Wire::new();\n    let mut handles = std::collections::HashMap::new();\n    for pid in nodes.clone() {\n        let op = build_op(pid, nodes.clone());\n        let h = spawn_actor::<TestEntry, MemoryStorage<TestEntry>, TestRuntime>(op, cfg.clone());\n        let out = h.outgoing_messages();\n        let w = wire.clone();\n        tokio::spawn(async move {\n            while let Ok(m) = out.recv().await {\n                w.push(m);\n            }\n        });\n        handles.insert(pid, h);\n    }\n    {\n        let w = wire.clone();\n        let hs = handles.clone();\n        tokio::spawn(async move {\n            loop {\n                let _ = deliver_all(&w, &hs).await;\n                tokio::time::sleep(Duration::from_millis(1)).await;\n            }\n        });\n    }\n    tokio::time::sleep(Duration::from_millis(50)).await;\n    handles[&1].try_become_leader().await;\n    settle(40).await;\n    assert_eq!(handles[&1].current_leader().await, Some((1, true)), \"setup: not leader\");\n\n    // Node 1 accepts its own entry; node 3 accepts it too, but node 3'\"'s receipt is\n    // dropped so node 1 cannot decide and its call stays pending.\n    *wire.blocked_flow.lock().unwrap() = Some((3, 1));\n    let pending = {\n        let h = handles[&1].clone();\n        tokio::spawn(async move { h.append_notify(TestEntry(42)).await })\n    };\n    settle(60).await;\n    let a_decided_before = handles[&1].decided_idx().await;\n    let c_holds = matches\"'!(\n        handles[&3].read_decided_suffix(0).await.and_then(|v| v.first().cloned()),\n        Some(LogEntry::Undecided(TestEntry(42)))\n    );\n    assert_eq!(a_decided_before, 0, \"setup: node 1 decided before the takeover\");\n    assert!(c_holds, \"setup: node 3 does not hold node 1'\"'s entry\\\");\n\n    // Node 2 takes over and adopts node 3's log, which contains node 1's entry.\n    handles[&2].try_become_leader().await;\n    settle(120).await;\n    *wire.blocked_flow.lock().unwrap() = None;\n    handles[&1].reconnected(2).await;\n    settle(140).await;\n\n    let a_decided = handles[&1].decided_idx().await;\n    let a_log = handles[&1].read_decided_suffix(0).await.unwrap_or_default();\n    let resolution = tokio::time::timeout(Duration::from_secs(8), pending)\n        .await\n        .expect(\\\"append_notify never resolved after the re-sync\\\");\n    emit(&format\"'!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"adopted_entry_resolution\\\\\\\\\\\",\\\\\\\\\\\"a_decided_before\\\\\\\\\\\":{a_decided_before},\\\\\\\\\\\"a_decided_idx\\\\\\\\\\\":{a_decided},\\\\\\\\\\\"a_entry_at_index_1_is_own\\\\\\\\\\\":{},\\\\\\\\\\\"b_decided_idx\\\\\\\\\\\":{},\\\\\\\\\\\"resolution\\\\\\\\\\\":\\\\\\\\\\\"{}\\\\\\\\\\\"}}\\\",\n        matches\"'!(a_log.first(), Some(LogEntry::Decided(TestEntry(42)))),\n        handles[&2].decided_idx().await,\n        match &resolution {\n            Ok(Ok(idx)) => format!(\"Ok({idx})\"),\n            Ok(Err(AppendError::Superseded { log_entry_idx })) => format!(\"Superseded({log_entry_idx})\"),\n            Ok(Err(AppendError::Timeout)) => \"Timeout\".to_string(),\n            Ok(Err(AppendError::Shutdown)) => \"Shutdown\".to_string(),\n            Ok(Err(AppendError::TooManyOutstanding)) => \"TooManyOutstanding\".to_string(),\n            Ok(Err(AppendError::Propose(_))) => \"Propose\".to_string(),\n            Err(_) => \"join-error\".to_string(),\n        }\n    ));\n    // The scope control: the entry was adopted, so Ok must be truthful.\n    match resolution {\n        Ok(Ok(idx)) => assert!(\n            matches!(a_log.get(idx.saturating_sub(1)), Some(LogEntry::Decided(TestEntry(42)))),\n            \"Ok({idx}) was reported but the entry at that index is not the caller'\"'s\\\"\n        ),\n        other => panic\"'!(\"expected Ok for the adopted entry, got {other:?}\"),\n    }\n}\n'\"'''\nopen(p,'w').write(s)\nprint('appended scope control')\nPY\ncp identity_probe.rs localws/omnipaxos_runtime/tests/identity_probe.rs && cd localws && timeout 120 cargo test --offline --locked -p omnipaxos_runtime --test identity_probe -- --nocapture 2>&1 | grep -E \\\"CA_EVENT|panicked|error\\\\[|test result\\\" | head -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
