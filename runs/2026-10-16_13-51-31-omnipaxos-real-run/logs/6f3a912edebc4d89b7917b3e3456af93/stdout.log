{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/draft && python3 - <<'PY'\np='assurance_generated.rs'\ns=open(p).read()\ns += '''\n/// Case 4: the same park at the shipped default capacity. Only node 1 consumes its\n/// event stream; \"'`RuntimeConfig::default()` is used unchanged (event_capacity 1024),\n/// so the two unread nodes park only after 1024 observed transitions - reached here\n/// by pacing ordinary writes until they do.\n#[tokio::test]\nasync fn default_capacity_event_bound_stops_actor_loop() {\n    let c = spawn_cluster_partial(&[1], RuntimeConfig::default().event_capacity).await;\n    let leader = wait_for_stable_leader(&c).await;\n    assert!(leader.is_some(), \"setup: no stable leader{}\", channel_state(&c));\n    let leader = leader.unwrap();\n\n    // Paced writes: one per millisecond keeps producing transitions for a while.\n    keep_proposing(&c, leader, 0, 4000);\n\n    let mut parked = 0;\n    let deadline = tokio::time::Instant::now() + Duration::from_secs(90);\n    while tokio::time::Instant::now() < deadline {\n        let answers_2 =\n            tokio::time::timeout(Duration::from_millis(250), c.handles[&2].decided_idx())\n                .await\n                .is_ok();\n        let answers_3 =\n            tokio::time::timeout(Duration::from_millis(250), c.handles[&3].decided_idx())\n                .await\n                .is_ok();\n        parked = usize::from(!answers_2) + usize::from(!answers_3);\n        if parked == 2 {\n            break;\n        }\n        tokio::time::sleep(Duration::from_millis(200)).await;\n    }\n    let decided_before =\n        tokio::time::timeout(Duration::from_millis(500), c.handles[&1].decided_idx())\n            .await\n            .expect(\"node 1 should stay responsive\");\n    let res = tokio::time::timeout(\n        Duration::from_secs(5),\n        c.handles[&1].append_notify_with_timeout(TestEntry(9), Duration::from_millis(500)),\n    )\n    .await;\n    let timeout_reached = matches!(res, Ok(Err(omnipaxos_runtime::AppendError::Timeout)));\n    tokio::time::sleep(Duration::from_secs(1)).await;\n    let decided_after =\n        tokio::time::timeout(Duration::from_millis(500), c.handles[&1].decided_idx())\n            .await\n            .expect(\"node 1 should still be responsive\");\n    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"default_capacity_parked_cluster\\\\\\\\\\\",\\\\\\\\\\\"event_capacity\\\\\\\\\\\":{},\\\\\\\\\\\"nodes_parked\\\\\\\\\\\":{parked},\\\\\\\\\\\"decided_before\\\\\\\\\\\":{decided_before},\\\\\\\\\\\"decided_after\\\\\\\\\\\":{decided_after},\\\\\\\\\\\"append_notify_timeout_reached\\\\\\\\\\\":{timeout_reached}}}\\\",\n        RuntimeConfig::default().event_capacity\n    ));\n    assert_eq\"'!(\n        parked, 2,\n        \"the default-capacity bound was not reached within the window{}\",\n        channel_state(&c)\n    );\n    assert_eq!(\n        decided_after, decided_before,\n        \"the cluster kept deciding although two of three nodes were parked\"\n    );\n    assert!(\n        decided_before >= 1024,\n        \"the two unread nodes parked before 1024 transitions were observed, so the bound was not the default\"\n    );\n}\n'\"'''\nopen(p,'w').write(s)\nprint('appended case 4')\nPY\ncp assurance_generated.rs localws/omnipaxos_runtime/tests/assurance_generated.rs && cd localws && timeout 100 cargo test --offline --locked -p omnipaxos_runtime --test assurance_generated default_capacity -- --nocapture 2>&1 | grep -E \\\"CA_EVENT|panicked|error\\\\[|test result\\\" | head -6\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
