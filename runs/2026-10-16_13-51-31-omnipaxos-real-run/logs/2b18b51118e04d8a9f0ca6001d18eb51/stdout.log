{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"The fixed-cadence run is decisive: exit 0, both tests pass, and `lost_accepted_window` shows no churn (Prepare:1, Promise:1, AcceptSync:1), only BLE after the drop, leader_decided_idx 0 over 100 resend periods. Let me extend the runtime harness with the cluster-level consequence, verifying locally."}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-16_13-51-31-omnipaxos-real-run/draft && python3 - <<'PY'\np='assurance_generated.rs'\ns=open(p).read()\ns=s.replace('''/// Case 1: nothing consumes the event stream; the cluster is kept busy until the\n/// bound is reached.''','''/// 3-node cluster in which only the pids in \"'`draining` read their event stream;\n/// the others leave the receiver the handle owns unread. Used to measure what\n/// happens to the *rest* of the cluster when a node'\"'s actor is parked.\nasync fn spawn_cluster_partial(draining: &[NodeId], event_capacity: usize) -> Cluster {\n    let nodes: Vec<NodeId> = vec\"'![1, 2, 3];\n    let cfg = RuntimeConfig {\n        tick_period: Duration::from_millis(2),\n        egress_period: Duration::from_millis(1),\n        event_capacity,\n        append_notify_timeout: Duration::from_millis(1500),\n        ..Default::default()\n    };\n    let mut handles: HashMap<NodeId, OmniPaxosHandle<TestEntry>> = HashMap::new();\n    let mut event_rx = HashMap::new();\n    for pid in nodes.clone() {\n        let op = build_op(pid, nodes.clone());\n        let h = spawn_actor::<TestEntry, MemoryStorage<TestEntry>, TestRuntime>(op, cfg.clone());\n        if draining.contains(&pid) {\n            let rx = h.subscribe_events();\n            tokio::spawn(async move { while rx.recv().await.is_ok() {} });\n        }\n        event_rx.insert(pid, h.subscribe_events());\n        handles.insert(pid, h);\n    }\n    let arc = Arc::new(handles.clone());\n    for pid in nodes {\n        let out = arc[&pid].outgoing_messages();\n        let peers = arc.clone();\n        tokio::spawn(async move {\n            while let Ok(msg) = out.recv().await {\n                if let Some(peer) = peers.get(&msg.get_receiver()) {\n                    peer.handle_incoming(msg).await;\n                }\n            }\n        });\n    }\n    Cluster { handles, event_rx }\n}\n\n/// Case 1: nothing consumes the event stream; the cluster is kept busy until the\n/// bound is reached.'\"''')\n\ns += '''\n/// Case 3: the consequence for the rest of the cluster. Only node 1 reads its event\n/// stream, so nodes 2 and 3 reach the bound and park; node 1 stays a healthy actor.\n/// Anything that needs those two as a quorum can then no longer be decided.\n#[tokio::test]\nasync fn parked_majority_stops_the_cluster_deciding() {\n    let c = spawn_cluster_partial(&[1], 8).await;\n    let leader = wait_for_stable_leader(&c).await;\n    assert\"'!(leader.is_some(), \"setup: no stable leader{}\", channel_state(&c));\n\n    // Keep ordinary writes coming so every node observes enough transitions to reach\n    // its bound; only the two unread nodes stop after that.\n    keep_proposing(&c, leader.unwrap(), 0, 24);\n    let mut parked = 0;\n    let deadline = tokio::time::Instant::now() + Duration::from_secs(8);\n    while tokio::time::Instant::now() < deadline {\n        parked = [2u64, 3]\n            .iter()\n            .filter(|pid| !c.handles.contains_key(pid) || {\n                // a parked actor stops answering commands\n                true\n            })\n            .count();\n        let answered = tokio::time::timeout(Duration::from_millis(250), c.handles[&2].decided_idx())\n            .await\n            .is_ok()\n            + tokio::time::timeout(Duration::from_millis(250), c.handles[&3].decided_idx())\n                .await\n                .is_ok();\n        parked = 2 - answered;\n        if parked == 2 {\n            break;\n        }\n        tokio::time::sleep(Duration::from_millis(100)).await;\n    }\n    let decided_before = tokio::time::timeout(Duration::from_millis(500), c.handles[&1].decided_idx())\n        .await\n        .expect(\"node 1 should stay responsive while nodes 2 and 3 are parked\");\n\n    // Node 1 is healthy, but it cannot complete a write: the parked nodes never\n    // answer, so the entry is never decided. Its own actor does run, so the\n    // documented Timeout endpoint is still reachable - what is withheld is progress.\n    let res = tokio::time::timeout(\n        Duration::from_secs(4),\n        c.handles[&1].append_notify_with_timeout(TestEntry(7), Duration::from_millis(300)),\n    )\n    .await;\n    let timeout_reached = matches!(res, Ok(Err(omnipaxos_runtime::AppendError::Timeout)));\n    tokio::time::sleep(Duration::from_secs(1)).await;\n    let decided_after = tokio::time::timeout(Duration::from_millis(500), c.handles[&1].decided_idx())\n        .await\n        .expect(\"node 1 should still be responsive\");\n    emit(&format!(\n        \"{{'\"\\\\\\\\\\\"event\\\\\\\\\\\":\\\\\\\\\\\"parked_majority_cluster\\\\\\\\\\\",\\\\\\\\\\\"nodes_parked\\\\\\\\\\\":{parked},\\\\\\\\\\\"healthy_node_responsive\\\\\\\\\\\":true,\\\\\\\\\\\"append_notify_timeout_reached\\\\\\\\\\\":{timeout_reached},\\\\\\\\\\\"decided_before\\\\\\\\\\\":{decided_before},\\\\\\\\\\\"decided_after\\\\\\\\\\\":{decided_after}}}\\\"\n    ));\n    assert_eq\"'!(\n        parked, 2,\n        \"setup: nodes 2 and 3 did not both stop answering{}\",\n        channel_state(&c)\n    );\n    assert_eq!(\n        decided_after, decided_before,\n        \"the cluster still decided entries although two of three nodes were parked\"\n    );\n}\n'\"'''\nopen(p,'w').write(s)\nprint('patched')\nPY\ncp assurance_generated.rs localws/omnipaxos_runtime/tests/assurance_generated.rs && cd localws && timeout 200 cargo test --offline --locked -p omnipaxos_runtime --test assurance_generated 2>&1 | tail -14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
