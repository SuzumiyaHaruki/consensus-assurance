estAssurancePartialVotePair/failed_candidate_write\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"vote_prefix\\\",\\\"intervening_granted\\\":false,\\\"old_candidate\\\":\\\"a\\\",\\\"old_vote_term\\\":2,\\\"operation\\\":\\\"failed_candidate_write\\\",\\\"pair_candidate\\\":\\\"a\\\",\\\"pair_term\\\":4,\\\"receiver_index\\\":2,\\\"receiver_log_term\\\":3,\\\"stale_index\\\":1,\\\"stale_log_term\\\":1,\\\"write_failures\\\":1}\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.920092403+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair/failed_candidate_write\",\"Output\":\"CA_EVENT {\\\"candidate\\\":\\\"a\\\",\\\"candidate_index\\\":1,\\\"candidate_log_term\\\":1,\\\"candidate_stale\\\":true,\\\"event\\\":\\\"vote_admitted\\\",\\\"operation\\\":\\\"failed_candidate_write\\\",\\\"prior_same_term_grant\\\":false,\\\"receiver_index\\\":2,\\\"receiver_log_term\\\":3,\\\"request_term\\\":4}\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.920200156+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair/failed_candidate_write\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"vote_result\\\",\\\"granted\\\":true,\\\"operation\\\":\\\"failed_candidate_write\\\",\\\"response_term\\\":4,\\\"rpc_completed\\\":true,\\\"stored_candidate\\\":\\\"a\\\",\\\"stored_vote_term\\\":4}\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.920263643+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair/failed_candidate_write\",\"Output\":\"--- PASS: TestAssurancePartialVotePair/failed_candidate_write (2.49s)\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.920288856+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair/failed_candidate_write\",\"Elapsed\":2.49}\n{\"Time\":\"2026-10-03T14:31:18.920328873+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair\",\"Output\":\"--- PASS: TestAssurancePartialVotePair (4.15s)\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.920406949+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePartialVotePair\",\"Elapsed\":4.15}\n{\"Time\":\"2026-10-03T14:31:18.922478893+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.927016243+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"ok  \\tgithub.com/hashicorp/raft\\t4.167s\\n\"}\n{\"Time\":\"2026-10-03T14:31:18.927081541+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Elapsed\":4.168}\npackage raft\n\nimport (\n \"bytes\"\n \"encoding/json\"\n \"fmt\"\n \"io\"\n \"sync\"\n \"testing\"\n \"time\"\n)\n\ntype assuranceFailCandidate struct { *InmemStore; armed bool; failures int }\nfunc (s *assuranceFailCandidate) Set(k, v []byte) error {\n if s.armed && bytes.Equal(k, keyLastVoteCand) { s.armed=false; s.failures++; return fmt.Errorf(\"injected candidate write failure\") }\n return s.InmemStore.Set(k,v)\n}\ntype assuranceVoteRecord struct { candidate ServerID; term uint64; granted bool }\ntype assuranceVoteNetwork struct {\n sync.Mutex\n nodes map[ServerID]*Raft\n blocked map[string]bool\n history []assuranceVoteRecord\n final bool\n operation string\n}\ntype assuranceVoteTransport struct { *InmemTransport; id ServerID; net *assuranceVoteNetwork }\nfunc assuranceVoteEmit(e map[string]interface{}) { b,err:=json.Marshal(e);if err!=nil {panic(err)};fmt.Println(\"CA_EVENT \"+string(b)) }\nfunc (x *assuranceVoteTransport) RequestVote(id ServerID, addr ServerAddress, req *RequestVoteRequest, resp *RequestVoteResponse) error {\n x.net.Lock()\n blocked:=x.net.blocked[string(x.id)+\":\"+string(id)]\n node:=x.net.nodes[id]\n final:=x.net.final && x.id==\"a\" && id==\"v\"\n prior:=false\n for _,h:=range x.net.history { if h.term==req.Term && h.candidate==x.id && h.granted {prior=true} }\n x.net.Unlock()\n if blocked { return fmt.Errorf(\"scheduled message omission\") }\n if final {\n  idx,term:=node.getLastEntry()\n  stale:=req.LastLogTerm<term || (req.LastLogTerm==term && req.LastLogIndex<idx)\n  assuranceVoteEmit(map[string]interface{}{\"event\":\"vote_admitted\",\"operation\":x.net.operation,\"request_term\":req.Term,\"candidate\":string(x.id),\"candidate_index\":req.LastLogIndex,\"candidate_log_term\":req.LastLogTerm,\"receiver_index\":idx,\"receiver_log_term\":term,\"candidate_stale\":stale,\"prior_same_term_grant\":prior})\n }\n ch:=make(chan RPCResponse,1)\n node.processRPC(RPC{Command:req,RespChan:ch})\n result:=<-ch\n if result.Error!=nil {return result.Error}\n *resp=*(result.Response.(*RequestVoteResponse))\n if id==\"v\" { x.net.Lock(); x.net.history=append(x.net.history,assuranceVoteRecord{x.id,req.Term,resp.Granted}); x.net.Unlock() }\n if final {\n  vt,_:=node.stable.GetUint64(keyLastVoteTerm);vc,_:=node.stable.Get(keyLastVoteCand)\n  assuranceVoteEmit(map[string]interface{}{\"event\":\"vote_result\",\"operation\":x.net.operation,\"granted\":resp.Granted,\"response_term\":resp.Term,\"stored_vote_term\":vt,\"stored_candidate\":string(vc),\"rpc_completed\":true})\n }\n return nil\n}\nfunc (x *assuranceVoteTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n ch:=make(chan RPCResponse,1);x.net.nodes[id].processRPC(RPC{Command:req,RespChan:ch});v:=<-ch\n if v.Error!=nil{return v.Error};*resp=*(v.Response.(*AppendEntriesResponse));return nil\n}\nfunc assuranceCampaign(t *testing.T,r *Raft) int {\n t.Helper();r.setState(Candidate);ch:=r.electSelf();grants:=0\n for i:=0;i<3;i++ { select {case v:=<-ch:if v.Granted {grants++};case <-time.After(time.Second):t.Fatal(\"campaign response missing\")} }\n return grants\n}\nfunc TestAssurancePartialVotePair(t *testing.T) {\n for _,fault:=range []bool{false,true} {\n  name:=\"successful_write_control\";if fault{name=\"failed_candidate_write\"}\n  t.Run(name,func(t *testing.T){\n   cfgs:=Configuration{Servers:[]Server{{ID:\"a\",Address:\"a\",Suffrage:Voter},{ID:\"b\",Address:\"b\",Suffrage:Voter},{ID:\"v\",Address:\"v\",Suffrage:Voter}}}\n   net:=&assuranceVoteNetwork{nodes:map[ServerID]*Raft{},blocked:map[string]bool{},operation:name}\n   var receiverStore *assuranceFailCandidate\n   for _,server:=range cfgs.Servers {\n    cfg:=DefaultConfig();cfg.LocalID=server.ID;cfg.ProtocolVersion=3;cfg.PreVoteDisabled=true;cfg.skipStartup=true;cfg.LogOutput=io.Discard\n    _,base:=NewInmemTransport(server.Address);tr:=&assuranceVoteTransport{base,server.ID,net}\n    store:=NewInmemStore();stable:=&assuranceFailCandidate{InmemStore:store};if server.ID==\"v\"{receiverStore=stable}\n    snaps:=NewInmemSnapshotStore();if err:=BootstrapCluster(cfg,store,stable,snaps,tr,cfgs);err!=nil{t.Fatal(err)}\n    r,err:=NewRaft(cfg,&MockFSM{},store,stable,snaps,tr);if err!=nil{t.Fatal(err)};net.nodes[server.ID]=r\n   }\n   defer func(){for _,r:=range net.nodes{r.Shutdown().Error()}}()\n   a,b,v:=net.nodes[\"a\"],net.nodes[\"b\"],net.nodes[\"v\"]\n   // A's term-2 campaign executes real grants. Delay its main-loop tally;\n   // B's later term-3 campaign can arrive while A is still a candidate.\n   if assuranceCampaign(t,a)!=3 {t.Fatal(\"initial campaign grants missing\")}\n   net.blocked[\"b:v\"]=true\n   if assuranceCampaign(t,b)!=2 {t.Fatal(\"B did not get A+self majority\")}\n   b.setState(Leader);b.setLeader(b.localAddr,b.localID);b.setupLeaderState()\n   // Prepare the same initial replication state as a new leader, before noop.\n   repl:=&followerReplication{lastContact:time.Now(),peer:cfgs.Servers[2],commitment:b.leaderState.commitment,currentTerm:b.getCurrentTerm(),nextIndex:b.getLastIndex()+1,stopCh:make(chan uint64,1),triggerCh:make(chan struct{},1),notify:map[*verifyFuture]struct{}{},stepDown:b.leaderState.stepDown}\n   b.leaderState.replState[\"v\"]=repl\n   b.leaderState.replState[\"a\"]=&followerReplication{peer:cfgs.Servers[0],lastContact:time.Now(),triggerCh:make(chan struct{},1)}\n   noop:=&logFuture{log:Log{Type:LogNoop}};noop.init();b.dispatchLogs([]*logFuture{noop})\n   if b.replicateTo(repl,b.getLastIndex()){t.Fatal(\"replication stopped\")}\n   // V learns term-3 history through AppendEntries, without voting for B.\n   vi,vt:=v.getLastEntry();ai,at:=a.getLastEntry()\n   oldTerm,_:=receiverStore.GetUint64(keyLastVoteTerm);oldCand,_:=receiverStore.Get(keyLastVoteCand)\n   if oldTerm!=2 || string(oldCand)!=\"a\" || !(vt>at || (vt==at && vi>ai)) {t.Fatal(\"prefix did not establish old vote and newer receiver log\")}\n   // Let contacts expire, execute the real lease check, then the real follower\n   // timeout path. No peers respond during this scheduled interval.\n   time.Sleep(b.config().LeaderLeaseTimeout+10*time.Millisecond)\n   b.checkLeaderLease()\n   if b.getState()!=Follower {t.Fatal(\"lease did not remove leader authority\")}\n   b.setLastContact() // runLeader exit performs this update before follower loop.\n   b.runFollower()\n   if b.getState()!=Candidate {t.Fatal(\"follower timeout did not start campaign\")}\n   net.blocked[\"b:v\"]=false;net.blocked[\"b:a\"]=true\n   receiverStore.armed=fault\n   grants:=assuranceCampaign(t,b)\n   bGranted:=grants==2\n   pairTerm,_:=receiverStore.GetUint64(keyLastVoteTerm);pairCand,_:=receiverStore.Get(keyLastVoteCand)\n   assuranceVoteEmit(map[string]interface{}{\"event\":\"vote_prefix\",\"operation\":name,\"old_vote_term\":oldTerm,\"old_candidate\":string(oldCand),\"receiver_index\":vi,\"receiver_log_term\":vt,\"stale_index\":ai,\"stale_log_term\":at,\"intervening_granted\":bGranted,\"write_failures\":receiverStore.failures,\"pair_term\":pairTerm,\"pair_candidate\":string(pairCand)})\n   // A learned term 3 when it granted B's prior election, but missed B's\n   // new log. Its own electSelf therefore produces a real stale term-4 RPC.\n   net.blocked[\"a:b\"]=true;net.final=true\n   assuranceCampaign(t,a)\n  })\n }\n}\n{\n  \"description\": \"Execute a same-history sequence: A obtains term-2 vote at V; B obtains a term-3 majority from A+self without V, appends its no-op and replicates to V; B later attempts term-4 vote at V with candidate-key success or injected unchanged-key failure; A electSelf produces a term-4 stale request. Observe whether V grants A, and all intermediate stored vote keys.\",\n  \"claim_id\": \"claim-vote-freshness-after-write-error\",\n  \"binding_ids\": [\n    \"bind-vote-pair-write\",\n    \"bind-vote-pair-consume\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"[read from fixed harness above]\",\n    \"description\": \"Three bootstrapped real Raft states; actual electSelf, requestVote, dispatchLogs, replicateTo and appendEntries. Synchronous transport substitutes RPC scheduling while preserving actual requests/responses.\",\n    \"semantic_changes\": [\n      \"No target source edits. skipStartup suppresses background loops; driver schedules campaigns and state transitions serially.\",\n      \"A term-2 election result is collected by the driver but its main-loop majority transition is delayed; B term-3 request reaches A while A is still Candidate, causing the real higher-term handler transition.\",\n      \"B majority transition is performed by the driver after observed A+self grants. Driver initializes one replication state matching startStopReplication and uses actual dispatchLogs/replicateTo for the term-3 no-op.\",\n      \"After the no-op replication, the driver lets the configured lease interval expire, invokes actual checkLeaderLease, performs the sourced runLeader-exit last-contact update and runs actual runFollower to its candidate transition. The enclosing runLeader cleanup is not executed; no prior replication worker remains running.\",\n      \"Transport replaces delivery with synchronous processRPC calls and explicit omissions; each candidate request comes from electSelf. No reply is forged.\",\n      \"StableStore wrapper returns one candidate-key Set error without changing the key; all other writes delegate to InmemStore. Successful-write control uses the same history without that error.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"prefix\",\n        \"event\": \"vote_prefix\",\n        \"conditions\": [\n          {\n            \"field\": \"old_vote_term\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"old_candidate\",\n            \"op\": \"eq\",\n            \"value\": \"a\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"pair_term\",\n            \"op\": \"eq\",\n            \"value\": 4,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"vote_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"request_term\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"prefix.pair_term\"\n          },\n          {\n            \"field\": \"candidate_stale\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"prior_same_term_grant\",\n            \"op\": \"eq\",\n            \"value\": false,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"src-stable-interface\",\n        \"src-durable-term-vote\",\n        \"src-vote-handler\",\n        \"src-vote-producer\",\n        \"src-startup\",\n        \"src-bootstrap\",\n        \"src-campaign\",\n        \"src-dispatch-config\",\n        \"src-replicate\",\n        \"src-follower-append\",\n        \"src-repl-lifecycle\",\n        \"src-inmem-store-driver\",\n        \"src-transfer-lease\",\n        \"src-leader-context\"\n      ],\n      \"expectation_ids\": [],\n      \"binding_ids\": [\n        \"bind-vote-pair-write\",\n        \"bind-vote-pair-consume\"\n      ],\n      \"derivation\": \"Bootstrap creates a fixed three-voter configuration. Actual A term-2 campaign saves A at V. B term-3 wins A+self while V delivery is omitted; therefore V need not have voted for B to legally receive B history. Actual dispatchLogs creates the higher-term no-op and replicateTo/appendEntries stores it at V while A remains behind. A learned term 3 by granting B and later electSelf advances it to 4 using its actual old last-log tuple. B term-4 request has the fresh tuple; the failed candidate-key write leaves old A with successfully stored term 4. The driver invokes checkLeaderLease after configured contact expiry, then actual runFollower reaches Candidate on its heartbeat timeout. It substitutes enclosing leader-loop cleanup, performing its last-contact update; this does not alter V vote memory or supply the tested grant. Individual successful stable writes remain intact, and the failed Set returns an ordinary error without corruption. The driver does not fake a prior same-term grant: history of actual V responses is inspected at final admission.\",\n      \"applicability\": \"Local RequestVote freshness after a partial vote persistence error, plus same-sequence successful-write control. Fixed IDs/addresses, no concurrent node mutation during each phase.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Actual lease checking and follower timeout execute, but the driver replaces enclosing runLeader setup/cleanup and final majority handling; no stale leader election endpoint is claimed.\",\n        \"Storage backends that stop the process instead of returning the injected error do not exercise this conditional continuation.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-vote-freshness\",\n      \"checker_id\": \"vote-freshness\",\n      \"event\": \"vote_result\",\n      \"binding_ids\": [\n        \"bind-vote-pair-write\",\n        \"bind-vote-pair-consume\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"src-stable-interface\",\n          \"src-durable-term-vote\",\n          \"src-vote-handler\",\n          \"src-vote-producer\",\n          \"src-startup\",\n          \"src-bootstrap\",\n          \"src-campaign\",\n          \"src-dispatch-config\",\n          \"src-replicate\",\n          \"src-follower-append\",\n          \"src-repl-lifecycle\",\n          \"src-inmem-store-driver\",\n          \"src-transfer-lease\",\n          \"src-leader-context\"\n        ],\n        \"expectation_ids\": [],\n        \"binding_ids\": [\n          \"bind-vote-pair-write\",\n          \"bind-vote-pair-consume\"\n        ],\n        \"derivation\": \"Admission independently computes log staleness from actual request and receiver log tuples and checks actual prior V response history for same candidate/term grant. Compare the subsequent actual Granted response with false. Distinct operation names correlate each control/discriminator prefix, admission and completed reply. The result is emitted even when granted, not filtered by expected outcome.\",\n        \"applicability\": \"A log-stale request without previous same-term grant; fault branch has the documented partial pair and successful control has the other candidate saved.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"vote-freshness\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"vote_result\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"granted\",\n        \"op\": \"eq\",\n        \"value\": false,\n        \"reference\": null\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"operation\"\n      ],\n      \"description\": \"The stale candidate without a previous same-term grant must be denied; a new term paired with an old candidate after Set failure cannot serve as an eligibility exception.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"No particular production storage backend is exercised; the error-return model is explicit.\",\n    \"Actual election RPC producers, log replication, lease checking and follower timeout execute; enclosing loop setup/cleanup and majority transitions remain driver-controlled.\",\n    \"No final stale-leader election or loss of a committed command is observed.\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The runner observed a new-term grant to the stale candidate after the injected candidate-key write failure. The receiver retained candidate A from term 2 while the saved vote term advanced to 4; A then requested term 4 with log `(1,1)`, behind the receiver’s `(2,3)`, and was granted. With the candidate write succeeding, the receiver saved B and denied A. This establishes a local grant difference under the declared fault model, not a stale-leader election or lost command.\n"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nfixed=json.load(open('../direct-checks/6a8f533248094889885d1b15ee6fcc45/plan.json'))\nss=fixed['harness']['legality']['source_ids']\np={'action':'review','artifact_id':'729f8585190e4f29b0746cd4e4d6a657','rationale':'Review the actual partial-vote persistence history, stale-request producer, comparison and explicit fault model. The completed local grant witness is distinct from a lost-command or elected-leader consequence.','review_items':[{'aspect':'checker_correspondence','status':'no_issue_found','source_ids':ss,'rationale':'Reviewed the fixed plan and harness for artifact 729f8585190e4f29b0746cd4e4d6a657 and raw output of execution 6d624169e9c44667a5e943dae1ba4d65. The claim concerns a new-term stale grant synthesized from incomplete persistent vote state. Its applicability is a StableStore Set returning an error without modifying that key after earlier successful writes; the wrapper implements exactly that one failure on keyLastVoteCand and delegates all other operations. This is not arbitrary corruption or a claim that a specific production backend continues on such an error. persistVote updates term first; requestVote denies the immediate failed attempt but continues to serve requests. Actual history is produced in one fixture: A electSelf term 2 causes V to save A; B electSelf term 3 receives A+self while V delivery is omitted; actual dispatchLogs and replicateTo/appendEntries put B term-3 no-op at V while A retains only the term-1 configuration. V is not required to vote in B election to accept B replication. Actual lease expiry checking removes B authority and runFollower reaches Candidate before its term-4 campaign. B term-4 request therefore carries its real fresh last-log tuple. Final A electSelf uses its actual term learned from B vote and actual older log, yielding the observed stale term-4 request. Driver substitutions are explicit: it delays A campaign tally, supplies B majority transition after actual grants, initializes replication state, replaces synchronous transport delivery and enclosing runLeader setup/cleanup, and schedules other campaigns. Delaying A tally while servicing a later higher-term vote is permitted by runCandidate select; the higher-term receiver handler performs the state/term update. The omitted leader cleanup would fail inflight work and clear leader fields but cannot repair V stable vote pair; no old replication worker remains running. Each receiver has one request at a time in these phases. The actual data, not scenario names, establishes the oracle: admission compares incoming last-log tuple to V getLastEntry and scans actual V grant history for a same-term grant to A. Only log-stale requests with no such grant are compared against Granted=false. This is a necessary rejection, not an eventual-success equality. Stable operation labels correlate each prefix, admission and result; request_term references the prefix pair_term as a predecessor, while the compared grant is not a correlation key. Results are emitted even on unexpected grants. In the fault branch the raw prefix has one write failure, intervening_granted=false, pair_term=4 and pair_candidate=a, with earlier vote a/2. Admission reports A log index/term 1/1 versus V 2/3 and no prior A/4 grant. The completed response is Granted=true and leaves the pair a/4. The successful-write control instead records b/4, zero failures and Granted=false for the same stale A request. That control confirms a normal denial, while the fault witness establishes the partial-pair consequence. The Go tests passing reflects driver completion only; the separate observed predicate is violated. Considered alternative protections: immediate error denial does occur, but does not prevent later false duplicate classification. Current term persistence and ordinary freshness rejection remain present; the duplicate branch bypasses the latter. A backend that terminates the process rather than returning this error is outside this scoped continuation. The check does not show double voting, a completed stale-leader election or loss of a committed command; these limits do not negate the measured local grant.', 'counterevidence':[], 'limitations':['Conditional library behavior under a single unchanged-key returned Set error; no production backend fault frequency or fail-stop behavior is measured.','Synchronous transport and selected main-loop setup/cleanup are driver substitutions; actual election request producers, vote handlers, append replication, lease check and follower timeout execute.','The no-op history is sufficient for log freshness; no committed client command, stale-leader state transition, or resulting state-machine divergence is observed.','Successful-write control denies A after saving B in the same term; it does not independently isolate the ordinary nonduplicate freshness rejection branch.'], 'report_title':'部分投票持久化失败导致陈旧候选者获票','report_answer':'候选者键写入失败后，接收方留下“新任期 4、旧候选者 A”的组合，并向日志落后的 A 返回同任期投票成功；无故障对照拒绝该请求。结果限定于明确的单键写入错误返回模型，未观察到陈旧节点当选或已提交数据丢失。'}], 'feedback':{'ref_ids':['bc11db21270a4b959845b42fde5778f0','b-election','f-persisted-vote-pair','729f8585190e4f29b0746cd4e4d6a657','6d624169e9c44667a5e943dae1ba4d65','src-durable-term-vote','src-vote-handler'],'answered':'Under the declared returned-write-error model, actual same-history execution produced a mixed term/candidate record and a later stale candidate grant through duplicate handling. One failed candidate write leaves old A with term 4; actual A request at term 4 has last-log tuple 1/1 versus receiver 2/3 and no prior A/4 grant, yet Granted=true. Successful candidate-write control saves B/4 and denies A. The reviewed proposition is local vote eligibility after partial persistence, not global election outcome.','remaining':['Production backend fault realization, final stale-leader election and client history loss remain independent scope limits.','Other retained follower storage-error and snapshot-history surfaces remain available for source investigation.'],'understanding':'updated','rationale':'The observed grant, producer history and fault model support the local responsibility comparison without extending it to unobserved cluster consequences.'}}\nopen('submission.json','w').write(json.dumps(p,indent=2)+'\\\\n')\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-03_13-58-41-hashicorp_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
