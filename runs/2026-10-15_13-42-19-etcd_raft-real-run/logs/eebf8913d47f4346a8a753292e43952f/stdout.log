{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft && python3 - <<'PY'\nimport json\ndef ch(b): return {\\\"field\\\":\\\"scenario\\\",\\\"reference\\\":b+\\\".scenario\\\"}\nprev=json.load(open('update8.json'))['experiment']   # 16-comparison Q2 basis (scenarios A, B, C)\nexp=dict(prev)\nexp['investigation_id']=\\\"9ad1a10e85bb41578fbb8a42a6890ab3-question-0\\\"\nexp['previous_id']=\\\"bbdf8837c719466ba9f5044f34c9c29f-experiment\\\"\nexp['revision_reason']=\\\"The harness now also contains a fourth scenario for the same cause: the single-voter removal with Config.PreVote enabled and CheckQuorum disabled, so the receipt can measure whether the same code branch that bounds the window under CheckQuorum (the answer to a lower-term message carrying the receiver's term) also bounds it under PreVote alone. The earlier scenarios and comparisons are kept, and the harness was rebuilt from the retained basis after a bad copy damaged the draft.\\\"\nexp['scope']=dict(prev['scope'])\nexp['scope']['description']=\\\"Observe the removed-leader ReadIndex path in four configurations of the same removal: a single-voter remainder, a two-voter remainder, a single-voter remainder with CheckQuorum enabled, and a single-voter remainder with PreVote enabled and CheckQuorum disabled.\\\"\nexp['scope']['assumptions']=prev['scope']['assumptions']+[\\\"In the PreVote scenario the observations are taken before and after the first heartbeat tick of the removed leader, as in the CheckQuorum scenario, so the receipt covers the window in which the stale answer is issued and the state after the step-down.\\\"]\nexp['scope']['excluded']=[\\\"Lease-based reads (ReadOnlyLeaseBased).\\\",\\\"PreVote combined with CheckQuorum.\\\",\\\"Snapshot transfer and asynchronous storage writes.\\\"]\nexp['prefix']=prev['prefix']+\\\" Scenario D (single-voter remainder with PreVote and without CheckQuorum): as scenario C, but the read is delivered before the removed leader has contacted the new leader, then one heartbeat tick is delivered and the step-down is observed, then a further MsgReadIndex is delivered.\\\"\nexp['prerequisites']=prev['prerequisites']+[\n {\\\"alias\\\":\\\"esetup\\\",\\\"event\\\":\\\"e_setup\\\"},\n {\\\"alias\\\":\\\"eremoved\\\",\\\"event\\\":\\\"e_leader_removed\\\",\\\"conditions\\\":[ch(\\\"esetup\\\")]},\n {\\\"alias\\\":\\\"enewlead\\\",\\\"event\\\":\\\"e_new_leader_committed\\\",\\\"conditions\\\":[ch(\\\"eremoved\\\")]},\n {\\\"alias\\\":\\\"eread\\\",\\\"event\\\":\\\"e_read_before_stepdown\\\",\\\"conditions\\\":[ch(\\\"enewlead\\\")]},\n {\\\"alias\\\":\\\"estep\\\",\\\"event\\\":\\\"e_stepdown\\\",\\\"conditions\\\":[ch(\\\"eread\\\")]}]\nexp['comparisons']=prev['comparisons']+[\n {\\\"event\\\":\\\"e_leader_removed\\\",\\\"identity_fields\\\":[\\\"scenario\\\"],\\\"admission_alias\\\":\\\"esetup\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"singleton\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n  \\\"description\\\":\\\"PreVote premise: the removal still leaves node 1 leading a configuration whose single voter is node 2, so the shortcut applies.\\\"},\n {\\\"event\\\":\\\"e_new_leader_committed\\\",\\\"identity_fields\\\":[\\\"scenario\\\"],\\\"admission_alias\\\":\\\"eremoved\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"actual_leader_ahead\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n  \\\"description\\\":\\\"PreVote premise: the new leader of {2} has committed an entry the removed leader's commit index does not cover.\\\"},\n {\\\"event\\\":\\\"e_read_before_stepdown\\\",\\\"identity_fields\\\":[\\\"scenario\\\"],\\\"admission_alias\\\":\\\"enewlead\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"read_index_at_least_other_committed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n  \\\"antecedent\\\":{\\\"field\\\":\\\"read_states\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1},\n  \\\"description\\\