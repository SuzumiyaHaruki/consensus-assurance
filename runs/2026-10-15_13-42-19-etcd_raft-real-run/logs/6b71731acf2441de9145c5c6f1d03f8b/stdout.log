\"id\": \"c72c66880fd9498ca1efb95774b0b06e\",\n  \"experiment_id\": \"381d89a2dcdc44cd95d8cc9cb5bed4cb-experiment\",\n  \"status\": \"completed\",\n  \"exit_code\": 0,\n  \"record\": \"logs/c72c66880fd9498ca1efb95774b0b06e/check.json\",\n  \"observations\": \"logs/c72c66880fd9498ca1efb95774b0b06e/observations.json\"\n },\n \"latest_interpretation\": {\n  \"id\": \"41aa04d6f89f47f9ad833d25d2c6e73c-interpretation-0\",\n  \"investigation_id\": \"9ad1a10e85bb41578fbb8a42a6890ab3-question-0\",\n  \"experiment_id\": \"eebf8913d47f4346a8a753292e43952f-experiment\",\n  \"source_ids\": [\n   \"tracker-singleton\",\n   \"readindex-singleton-branch\",\n   \"prop-removed-leader\",\n   \"switchtoconfig-removal\",\n   \"config-stepdown-doc\",\n   \"readonlysafe-doc\",\n   \"node-readindex-contract\",\n   \"readme-linearizable\"\n  ],\n  \"executions\": {\n   \"eaec4096389145f5a26353274b77a639\": [\n    12,\n    14,\n    15,\n    16\n   ],\n   \"8090da09e0d44e13af56696a62f13d45\": [\n    12,\n    13,\n    14,\n    15,\n    16\n   ]\n  },\n  \"conclusion\": \"violated\",\n  \"defect_claim\": \"asserted\",\n  \"rationale\": \"The measured account stands on receipt 8090da09e0d44e13af56696a62f13d45 as before: the removed leader answers the read immediately with an index below the entry the actual leader had already committed (parsed index 14), the actual leader's own answer covers its commit index, and the exposure ends when the removed leader steps down one heartbeat interval after the new leader is elected (indices 15  [preview: 1314 characters omitted; see full record]\",\n  \"answers\": {},\n  \"knowledge\": [\n   {\n    \"entry_id\": \"9ad1a10e85bb41578fbb8a42a6890ab3-knowledge-0\",\n    \"revision\": 1,\n    \"assertion\": \"IsSingleton is a size-only test over the configuration and never compares the single voter with the local node.\"\n   },\n   {\n    \"entry_id\": \"9ad1a10e85bb41578fbb8a42a6890ab3-knowledge-1\",\n    \"revision\": 1,\n    \"assertion\": \"StepLeader answers