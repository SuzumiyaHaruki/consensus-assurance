\t\t\t}\n  1981\t\n  1982\t\t\tnt.send(&pb.Message{From: new(tt.sm.id), To: new(tt.sm.id), Type: pb.MsgReadIndex.Enum(), Entries: []*pb.Entry{{Data: tt.wctx}}})\n  1983\t\n  1984\t\t\tr := tt.sm\n  1985\t\t\tassert.NotEmpty(t, r.readStates, \"#%d\", i)\n  1986\t\t\trs := r.readStates[0]\n  1987\t\t\tassert.Equal(t, tt.wri, rs.Index, \"#%d\", i)\n  1988\t\t\tassert.Equal(t, tt.wctx, rs.RequestCtx, \"#%d\", i)\n  1989\t\t\tr.readStates = nil\n  1990\t\t}\n  1991\t}\n  1992\t\n  1993\tfunc TestReadOnlyWithLearner(t *testing.T) {\n  1994\t\ts := newTestMemoryStorage(withPeers(1), withLearners(2))\n  1995\t\ta := newTestLearnerRaft(1, 10, 1, s)\n  1996\t\tb := newTestLearnerRaft(2, 10, 1, newTestMemoryStorage(withPeers(1), withLearners(2)))\n  1997\t\n  1998\t\tnt := newNetwork(a, b)\n  1999\t\tsetRandomizedElectionTimeout(b, b.electionTimeout+1)\n  2000\t\n  2001\t\tfor i := 0; i < b.electionTimeout; i++ {\n  2002\t\t\tb.tick()\n  2003\t\t}\n  2004\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgHup.Enum()})\n  2005\t\n  2006\t\trequire.Equal(t, StateLeader, a.state)\n  2007\t\n  2008\t\ttests := []struct {\n  2009\t\t\tsm        *raft\n  2010\t\t\tproposals int\n  2011\t\t\twri       uint64\n  2012\t\t\twctx      []byte\n  2013\t\t}{\n  2014\t\t\t{a, 10, 11, []byte(\"ctx1\")},\n  2015\t\t\t{b, 10, 21, []byte(\"ctx2\")},\n  2016\t\t\t{a, 10, 31, []byte(\"ctx3\")},\n  2017\t\t\t{b, 10, 41, []byte(\"ctx4\")},\n  2018\t\t}\n  2019\t\n  2020\t\tfor i, tt := range tests {\n  2021\t\t\tfor j := 0; j < tt.proposals; j++ {\n  2022\t\t\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{}}})\n  2023\t\t\t\tnextEnts(a, s) // append the entries on the leader\n  2024\t\t\t}\n  2025\t\n  2026\t\t\tnt.send(&pb.Message{From: new(tt.sm.id), To: new(tt.sm.id), Type: pb.MsgReadIndex.Enum(), Entries: []*pb.Entry{{Data: tt.wctx}}})\n  2027\t\n  2028\t\t\tr := tt.sm\n  2029\t\t\trequire.NotEmpty(t, r.re