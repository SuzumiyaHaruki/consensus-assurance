{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '1671,1782p' raft.go | nl -ba -v1671; echo ---- ; cat -n tracker/inflights.go; echo ----; cat -n util.go\"","aggregated_output":"  1671\t// stepCandidate is shared by StateCandidate and StatePreCandidate; the difference is\n  1672\t// whether they respond to MsgVoteResp or MsgPreVoteResp.\n  1673\tfunc stepCandidate(r *raft, m *pb.Message) error {\n  1674\t\t// Only handle vote responses corresponding to our candidacy (while in\n  1675\t\t// StateCandidate, we may get stale MsgPreVoteResp messages in this term from\n  1676\t\t// our pre-candidate state).\n  1677\t\tvar myVoteRespType pb.MessageType\n  1678\t\tif r.state == StatePreCandidate {\n  1679\t\t\tmyVoteRespType = pb.MsgPreVoteResp\n  1680\t\t} else {\n  1681\t\t\tmyVoteRespType = pb.MsgVoteResp\n  1682\t\t}\n  1683\t\tswitch m.GetType() {\n  1684\t\tcase pb.MsgProp:\n  1685\t\t\tr.logger.Infof(\"%x no leader at term %d; dropping proposal\", r.id, r.Term)\n  1686\t\t\treturn ErrProposalDropped\n  1687\t\tcase pb.MsgApp:\n  1688\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1689\t\t\tr.handleAppendEntries(m)\n  1690\t\tcase pb.MsgHeartbeat:\n  1691\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1692\t\t\tr.handleHeartbeat(m)\n  1693\t\tcase pb.MsgSnap:\n  1694\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1695\t\t\tr.handleSnapshot(m)\n  1696\t\tcase myVoteRespType:\n  1697\t\t\tgr, rj, res := r.poll(m.GetFrom(), m.GetType(), !m.GetReject())\n  1698\t\t\tr.logger.Infof(\"%x has received %d %s votes and %d vote rejections\", r.id, gr, m.GetType(), rj)\n  1699\t\t\tswitch res {\n  1700\t\t\tcase quorum.VoteWon:\n  1701\t\t\t\tif r.state == StatePreCandidate {\n  1702\t\t\t\t\tr.campaign(campaignElection)\n  1703\t\t\t\t} else {\n  1704\t\t\t\t\tr.becomeLeader()\n  1705\t\t\t\t\tr.bcastAppend()\n  1706\t\t\t\t}\n  1707\t\t\tcase quorum.VoteLost:\n  1708\t\t\t\t// pb.MsgPreVoteResp contains future term of pre-candidate\n  1709\t\t\t\t// m.Term > r.Term; reuse r.Term\n  1710\t\t\t\tr.becomeFollower(r.Term, None)\n  1711\t\t\t}\n  1712\t\tcase pb.MsgTimeoutNow:\n  1713\t\t\tr.logger.Debugf(\"%x [term %d state %v] ignored MsgTimeoutNow from %x\", r.id, r.Term, r.state, m.GetFrom())\n  1714\t\t}\n  1715\t\treturn nil\n  1716\t}\n  1717\t\n  1718\tfunc stepFollower(r *raft, m *pb.Message) error {\n  1719\t\tswitch m.GetType() {\n  1720\t\tcase pb.MsgProp:\n  1721\t\t\tif r.lead == None {\n  1722\t\t\t\tr.logger.Infof(\"%x no leader at term %d; dropping proposal\", r.id, r.Term)\n  1723\t\t\t\treturn ErrProposalDropped\n  1724\t\t\t} else if r.disableProposalForwarding {\n  1725\t\t\t\tr.logger.Infof(\"%x not forwarding to leader %x at term %d; dropping proposal\", r.id, r.lead, r.Term)\n  1726\t\t\t\treturn ErrProposalDropped\n  1727\t\t\t}\n  1728\t\t\tm.To = new(r.lead)\n  1729\t\t\tr.send(m)\n  1730\t\tcase pb.MsgApp:\n  1731\t\t\tr.electionElapsed = 0\n  1732\t\t\tr.lead = m.GetFrom()\n  1733\t\t\tr.handleAppendEntries(m)\n  1734\t\tcase pb.MsgHeartbeat:\n  1735\t\t\tr.electionElapsed = 0\n  1736\t\t\tr.lead = m.GetFrom()\n  1737\t\t\tr.handleHeartbeat(m)\n  1738\t\tcase pb.MsgSnap:\n  1739\t\t\tr.electionElapsed = 0\n  1740\t\t\tr.lead = m.GetFrom()\n  1741\t\t\tr.handleSnapshot(m)\n  1742\t\tcase pb.MsgTransferLeader:\n  1743\t\t\tif r.lead == None {\n  1744\t\t\t\tr.logger.Infof(\"%x no leader at term %d; dropping leader transfer msg\", r.id, r.Term)\n  1745\t\t\t\treturn nil\n  1746\t\t\t}\n  1747\t\t\tm.To = new(r.lead)\n  1748\t\t\tr.send(m)\n  1749\t\tcase pb.MsgForgetLeader:\n  1750\t\t\tif r.readOnly.option == ReadOnlyLeaseBased {\n  1751\t\t\t\tr.logger.Error(\"ignoring MsgForgetLeader due to ReadOnlyLeaseBased\")\n  1752\t\t\t\treturn nil\n  1753\t\t\t}\n  1754\t\t\tif r.lead != None {\n  1755\t\t\t\tr.logger.Infof(\"%x forgetting leader %x at term %d\", r.id, r.lead, r.Term)\n  1756\t\t\t\tr.lead = None\n  1757\t\t\t}\n  1758\t\tcase pb.MsgTimeoutNow:\n  1759\t\t\tr.logger.Infof(\"%x [term %d] received MsgTimeoutNow from %x and starts an election to get leadership.\", r.id, r.Term, m.GetFrom())\n  1760\t\t\t// Leadership transfers never use pre-vote even if r.preVote is true; we\n  1761\t\t\t// know we are not recovering from a partition so there is no need for the\n  1762\t\t\t// extra round trip.\n  1763\t\t\tr.hup(campaignTransfer)\n  1764\t\tcase pb.MsgReadIndex:\n  1765\t\t\tif r.lead == None {\n  1766\t\t\t\tr.logger.Infof(\"%x no leader at term %d; dropping index reading msg\", r.id, r.Term)\n  1767\t\t\t\treturn nil\n  1768\t\t\t}\n  1769\t\t\tm.To = new(r.lead)\n  1770\t\t\tr.send(m)\n  1771\t\tcase pb.MsgReadIndexResp:\n  1772\t\t\tif len(m.GetEntries()) != 1 {\n  1773\t\t\t\tr.logger.Errorf(\"%x invalid format of MsgReadIndexResp from %x, entries count: %d\", r.id, m.GetFrom(), len(m.GetEntries()))\n  1774\t\t\t\treturn nil\n  1775\t\t\t}\n  1776\t\t\tr.readStates = append(r.readStates, ReadState{Index: m.GetIndex(), RequestCtx: m.GetEntries()[0].GetData()})\n  1777\t\t}\n  1778\t\treturn nil\n  1779\t}\n  1780\t\n  1781\t// logSliceFromMsgApp extracts the appended logSlice from a MsgApp message.\n  1782\tfunc logSliceFromMsgApp(m *pb.Message) logSlice {\n----\n     1\t// Copyright 2019 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage tracker\n    16\t\n    17\t// inflight describes an in-flight MsgApp message.\n    18\ttype inflight struct {\n    19\t\tindex uint64 // the index of the last entry inside the message\n    20\t\tbytes uint64 // the total byte size of the entries in the message\n    21\t}\n    22\t\n    23\t// Inflights limits the number of MsgApp (represented by the largest index\n    24\t// contained within) sent to followers but not yet acknowledged by them. Callers\n    25\t// use Full() to check whether more messages can be sent, call Add() whenever\n    26\t// they are sending a new append, and release \"quota\" via FreeLE() whenever an\n    27\t// ack is received.\n    28\ttype Inflights struct {\n    29\t\t// the starting index in the buffer\n    30\t\tstart int\n    31\t\n    32\t\tcount int    // number of inflight messages in the buffer\n    33\t\tbytes uint64 // number of inflight bytes\n    34\t\n    35\t\tsize     int    // the max number of inflight messages\n    36\t\tmaxBytes uint64 // the max total byte size of inflight messages\n    37\t\n    38\t\t// buffer is a ring buffer containing info about all in-flight messages.\n    39\t\tbuffer []inflight\n    40\t}\n    41\t\n    42\t// NewInflights sets up an Inflights that allows up to size inflight messages,\n    43\t// with the total byte size up to maxBytes. If maxBytes is 0 then there is no\n    44\t// byte size limit. The maxBytes limit is soft, i.e. we accept a single message\n    45\t// that brings it from size < maxBytes to size >= maxBytes.\n    46\tfunc NewInflights(size int, maxBytes uint64) *Inflights {\n    47\t\treturn &Inflights{\n    48\t\t\tsize:     size,\n    49\t\t\tmaxBytes: maxBytes,\n    50\t\t}\n    51\t}\n    52\t\n    53\t// Clone returns an *Inflights that is identical to but shares no memory with\n    54\t// the receiver.\n    55\tfunc (in *Inflights) Clone() *Inflights {\n    56\t\tins := *in\n    57\t\tins.buffer = append([]inflight(nil), in.buffer...)\n    58\t\treturn &ins\n    59\t}\n    60\t\n    61\t// Add notifies the Inflights that a new message with the given index and byte\n    62\t// size is being dispatched. Full() must be called prior to Add() to verify that\n    63\t// there is room for one more message, and consecutive calls to Add() must\n    64\t// provide a monotonic sequence of indexes.\n    65\tfunc (in *Inflights) Add(index, bytes uint64) {\n    66\t\tif in.Full() {\n    67\t\t\tpanic(\"cannot add into a Full inflights\")\n    68\t\t}\n    69\t\tnext := in.start + in.count\n    70\t\tsize := in.size\n    71\t\tif next >= size {\n    72\t\t\tnext -= size\n    73\t\t}\n    74\t\tif next >= len(in.buffer) {\n    75\t\t\tin.grow()\n    76\t\t}\n    77\t\tin.buffer[next] = inflight{index: index, bytes: bytes}\n    78\t\tin.count++\n    79\t\tin.bytes += bytes\n    80\t}\n    81\t\n    82\t// grow the inflight buffer by doubling up to inflights.size. We grow on demand\n    83\t// instead of preallocating to inflights.size to handle systems which have\n    84\t// thousands of Raft groups per process.\n    85\tfunc (in *Inflights) grow() {\n    86\t\tnewSize := len(in.buffer) * 2\n    87\t\tif newSize == 0 {\n    88\t\t\tnewSize = 1\n    89\t\t} else if newSize > in.size {\n    90\t\t\tnewSize = in.size\n    91\t\t}\n    92\t\tnewBuffer := make([]inflight, newSize)\n    93\t\tcopy(newBuffer, in.buffer)\n    94\t\tin.buffer = newBuffer\n    95\t}\n    96\t\n    97\t// FreeLE frees the inflights smaller or equal to the given `to` flight.\n    98\tfunc (in *Inflights) FreeLE(to uint64) {\n    99\t\tif in.count == 0 || to < in.buffer[in.start].index {\n   100\t\t\t// out of the left side of the window\n   101\t\t\treturn\n   102\t\t}\n   103\t\n   104\t\tidx := in.start\n   105\t\tvar i int\n   106\t\tvar bytes uint64\n   107\t\tfor i = 0; i < in.count; i++ {\n   108\t\t\tif to < in.buffer[idx].index { // found the first large inflight\n   109\t\t\t\tbreak\n   110\t\t\t}\n   111\t\t\tbytes += in.buffer[idx].bytes\n   112\t\n   113\t\t\t// increase index and maybe rotate\n   114\t\t\tsize := in.size\n   115\t\t\tif idx++; idx >= size {\n   116\t\t\t\tidx -= size\n   117\t\t\t}\n   118\t\t}\n   119\t\t// free i inflights and set new start index\n   120\t\tin.count -= i\n   121\t\tin.bytes -= bytes\n   122\t\tin.start = idx\n   123\t\tif in.count == 0 {\n   124\t\t\t// inflights is empty, reset the start index so that we don't grow the\n   125\t\t\t// buffer unnecessarily.\n   126\t\t\tin.start = 0\n   127\t\t}\n   128\t}\n   129\t\n   130\t// Full returns true if no more messages can be sent at the moment.\n   131\tfunc (in *Inflights) Full() bool {\n   132\t\treturn in.count == in.size || (in.maxBytes != 0 && in.bytes >= in.maxBytes)\n   133\t}\n   134\t\n   135\t// Count returns the number of inflight messages.\n   136\tfunc (in *Inflights) Count() int { return in.count }\n   137\t\n   138\t// reset frees all inflights.\n   139\tfunc (in *Inflights) reset() {\n   140\t\tin.start = 0\n   141\t\tin.count = 0\n   142\t\tin.bytes = 0\n   143\t}\n----\n     1\t// Copyright 2015 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage raft\n    16\t\n    17\timport (\n    18\t\t\"bytes\"\n    19\t\t\"fmt\"\n    20\t\t\"strings\"\n    21\t\n    22\t\t\"google.golang.org/protobuf/proto\"\n    23\t\n    24\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    25\t)\n    26\t\n    27\tfunc (st StateType) MarshalJSON() ([]byte, error) {\n    28\t\treturn []byte(fmt.Sprintf(\"%q\", st.String())), nil\n    29\t}\n    30\t\n    31\tvar isLocalMsg = [...]bool{\n    32\t\tpb.MsgHup:               true,\n    33\t\tpb.MsgBeat:              true,\n    34\t\tpb.MsgUnreachable:       true,\n    35\t\tpb.MsgSnapStatus:        true,\n    36\t\tpb.MsgCheckQuorum:       true,\n    37\t\tpb.MsgStorageAppend:     true,\n    38\t\tpb.MsgStorageAppendResp: true,\n    39\t\tpb.MsgStorageApply:      true,\n    40\t\tpb.MsgStorageApplyResp:  true,\n    41\t}\n    42\t\n    43\tvar isResponseMsg = [...]bool{\n    44\t\tpb.MsgAppResp:           true,\n    45\t\tpb.MsgVoteResp:          true,\n    46\t\tpb.MsgHeartbeatResp:     true,\n    47\t\tpb.MsgUnreachable:       true,\n    48\t\tpb.MsgReadIndexResp:     true,\n    49\t\tpb.MsgPreVoteResp:       true,\n    50\t\tpb.MsgStorageAppendResp: true,\n    51\t\tpb.MsgStorageApplyResp:  true,\n    52\t}\n    53\t\n    54\tfunc isMsgInArray(msgt pb.MessageType, arr []bool) bool {\n    55\t\ti := int(msgt)\n    56\t\treturn i < len(arr) && arr[i]\n    57\t}\n    58\t\n    59\tfunc IsLocalMsg(msgt pb.MessageType) bool {\n    60\t\treturn isMsgInArray(msgt, isLocalMsg[:])\n    61\t}\n    62\t\n    63\tfunc IsResponseMsg(msgt pb.MessageType) bool {\n    64\t\treturn isMsgInArray(msgt, isResponseMsg[:])\n    65\t}\n    66\t\n    67\tfunc IsLocalMsgTarget(id uint64) bool {\n    68\t\treturn id == LocalAppendThread || id == LocalApplyThread\n    69\t}\n    70\t\n    71\t// voteResponseType maps vote and prevote message types to their corresponding responses.\n    72\tfunc voteRespMsgType(msgt pb.MessageType) pb.MessageType {\n    73\t\tswitch msgt {\n    74\t\tcase pb.MsgVote:\n    75\t\t\treturn pb.MsgVoteResp\n    76\t\tcase pb.MsgPreVote:\n    77\t\t\treturn pb.MsgPreVoteResp\n    78\t\tdefault:\n    79\t\t\tpanic(fmt.Sprintf(\"not a vote message: %s\", msgt))\n    80\t\t}\n    81\t}\n    82\t\n    83\tfunc DescribeHardState(hs *pb.HardState) string {\n    84\t\tvar buf strings.Builder\n    85\t\tfmt.Fprintf(&buf, \"Term:%d\", hs.GetTerm())\n    86\t\tif hs.GetVote() != 0 {\n    87\t\t\tfmt.Fprintf(&buf, \" Vote:%d\", hs.GetVote())\n    88\t\t}\n    89\t\tfmt.Fprintf(&buf, \" Commit:%d\", hs.GetCommit())\n    90\t\treturn buf.String()\n    91\t}\n    92\t\n    93\tfunc DescribeSoftState(ss SoftState) string {\n    94\t\treturn fmt.Sprintf(\"Lead:%d State:%s\", ss.Lead, ss.RaftState)\n    95\t}\n    96\t\n    97\tfunc DescribeConfState(state *pb.ConfState) string {\n    98\t\treturn fmt.Sprintf(\n    99\t\t\t\"Voters:%v VotersOutgoing:%v Learners:%v LearnersNext:%v AutoLeave:%v\",\n   100\t\t\tstate.Voters, state.VotersOutgoing, state.Learners, state.LearnersNext, state.GetAutoLeave(),\n   101\t\t)\n   102\t}\n   103\t\n   104\tfunc DescribeSnapshot(snap *pb.Snapshot) string {\n   105\t\tm := snap.GetMetadata()\n   106\t\treturn fmt.Sprintf(\"Index:%d Term:%d ConfState:%s\", m.GetIndex(), m.GetTerm(), DescribeConfState(m.GetConfState()))\n   107\t}\n   108\t\n   109\tfunc DescribeReady(rd Ready, f EntryFormatter) string {\n   110\t\tvar buf strings.Builder\n   111\t\tif rd.SoftState != nil {\n   112\t\t\tfmt.Fprint(&buf, DescribeSoftState(*rd.SoftState))\n   113\t\t\tbuf.WriteByte('\\n')\n   114\t\t}\n   115\t\tif !IsEmptyHardState(rd.HardState) {\n   116\t\t\tfmt.Fprintf(&buf, \"HardState %s\", DescribeHardState(rd.HardState))\n   117\t\t\tbuf.WriteByte('\\n')\n   118\t\t}\n   119\t\tif len(rd.ReadStates) > 0 {\n   120\t\t\tfmt.Fprintf(&buf, \"ReadStates %v\\n\", rd.ReadStates)\n   121\t\t}\n   122\t\tif len(rd.Entries) > 0 {\n   123\t\t\tbuf.WriteString(\"Entries:\\n\")\n   124\t\t\tfmt.Fprint(&buf, DescribeEntries(rd.Entries, f))\n   125\t\t}\n   126\t\tif !IsEmptySnap(rd.Snapshot) {\n   127\t\t\tfmt.Fprintf(&buf, \"Snapshot %s\\n\", DescribeSnapshot(rd.Snapshot))\n   128\t\t}\n   129\t\tif len(rd.CommittedEntries) > 0 {\n   130\t\t\tbuf.WriteString(\"CommittedEntries:\\n\")\n   131\t\t\tfmt.Fprint(&buf, DescribeEntries(rd.CommittedEntries, f))\n   132\t\t}\n   133\t\tif len(rd.Messages) > 0 {\n   134\t\t\tbuf.WriteString(\"Messages:\\n\")\n   135\t\t\tfor _, msg := range rd.Messages {\n   136\t\t\t\tfmt.Fprint(&buf, DescribeMessage(msg, f))\n   137\t\t\t\tbuf.WriteByte('\\n')\n   138\t\t\t}\n   139\t\t}\n   140\t\tif buf.Len() > 0 {\n   141\t\t\treturn fmt.Sprintf(\"Ready MustSync=%t:\\n%s\", rd.MustSync, buf.String())\n   142\t\t}\n   143\t\treturn \"<empty Ready>\"\n   144\t}\n   145\t\n   146\t// EntryFormatter can be implemented by the application to provide human-readable formatting\n   147\t// of entry data. Nil is a valid EntryFormatter and will use a default format.\n   148\ttype EntryFormatter func([]byte) string\n   149\t\n   150\t// DescribeMessage returns a concise human-readable description of a\n   151\t// Message for debugging.\n   152\tfunc DescribeMessage(m *pb.Message, f EntryFormatter) string {\n   153\t\treturn describeMessageWithIndent(\"\", m, f)\n   154\t}\n   155\t\n   156\tfunc describeMessageWithIndent(indent string, m *pb.Message, f EntryFormatter) string {\n   157\t\tvar buf bytes.Buffer\n   158\t\tfmt.Fprintf(&buf, \"%s%s->%s %v Term:%d Log:%d/%d\", indent,\n   159\t\t\tdescribeTarget(m.GetFrom()), describeTarget(m.GetTo()), m.GetType(), m.GetTerm(), m.GetLogTerm(), m.GetIndex())\n   160\t\tif m.GetReject() {\n   161\t\t\tfmt.Fprintf(&buf, \" Rejected (Hint: %d)\", m.GetRejectHint())\n   162\t\t}\n   163\t\tif m.GetCommit() != 0 {\n   164\t\t\tfmt.Fprintf(&buf, \" Commit:%d\", m.GetCommit())\n   165\t\t}\n   166\t\tif m.GetVote() != 0 {\n   167\t\t\tfmt.Fprintf(&buf, \" Vote:%d\", m.GetVote())\n   168\t\t}\n   169\t\tif ents := m.GetEntries(); len(ents) == 1 {\n   170\t\t\tfmt.Fprintf(&buf, \" Entries:[%s]\", DescribeEntry(ents[0], f))\n   171\t\t} else if len(ents) > 1 {\n   172\t\t\tfmt.Fprint(&buf, \" Entries:[\")\n   173\t\t\tfor _, e := range ents {\n   174\t\t\t\tfmt.Fprintf(&buf, \"\\n%s  \", indent)\n   175\t\t\t\tbuf.WriteString(DescribeEntry(e, f))\n   176\t\t\t}\n   177\t\t\tfmt.Fprintf(&buf, \"\\n%s]\", indent)\n   178\t\t}\n   179\t\tif s := m.GetSnapshot(); s != nil && !IsEmptySnap(s) {\n   180\t\t\tfmt.Fprintf(&buf, \"\\n%s  Snapshot: %s\", indent, DescribeSnapshot(s))\n   181\t\t}\n   182\t\tif len(m.GetResponses()) > 0 {\n   183\t\t\tfmt.Fprintf(&buf, \" Responses:[\")\n   184\t\t\tfor _, r := range m.GetResponses() {\n   185\t\t\t\tbuf.WriteString(\"\\n\")\n   186\t\t\t\tbuf.WriteString(describeMessageWithIndent(indent+\"  \", r, f))\n   187\t\t\t}\n   188\t\t\tfmt.Fprintf(&buf, \"\\n%s]\", indent)\n   189\t\t}\n   190\t\treturn buf.String()\n   191\t}\n   192\t\n   193\tfunc describeTarget(id uint64) string {\n   194\t\tswitch id {\n   195\t\tcase None:\n   196\t\t\treturn \"None\"\n   197\t\tcase LocalAppendThread:\n   198\t\t\treturn \"AppendThread\"\n   199\t\tcase LocalApplyThread:\n   200\t\t\treturn \"ApplyThread\"\n   201\t\tdefault:\n   202\t\t\treturn fmt.Sprintf(\"%x\", id)\n   203\t\t}\n   204\t}\n   205\t\n   206\t// DescribeEntry returns a concise human-readable description of an\n   207\t// Entry for debugging.\n   208\tfunc DescribeEntry(e *pb.Entry, f EntryFormatter) string {\n   209\t\tif f == nil {\n   210\t\t\tf = func(data []byte) string { return fmt.Sprintf(\"%q\", data) }\n   211\t\t}\n   212\t\n   213\t\tformatConfChange := func(cc pb.ConfChangeI) string {\n   214\t\t\t// TODO(tbg): give the EntryFormatter a type argument so that it gets\n   215\t\t\t// a chance to expose the Context.\n   216\t\t\treturn pb.ConfChangesToString(cc.AsV2().Changes)\n   217\t\t}\n   218\t\n   219\t\tvar formatted string\n   220\t\tswitch e.GetType() {\n   221\t\tcase pb.EntryNormal:\n   222\t\t\tformatted = f(e.GetData())\n   223\t\tcase pb.EntryConfChange:\n   224\t\t\tcc := &pb.ConfChange{}\n   225\t\t\tif err := proto.Unmarshal(e.GetData(), cc); err != nil {\n   226\t\t\t\tformatted = err.Error()\n   227\t\t\t} else {\n   228\t\t\t\tformatted = formatConfChange(cc)\n   229\t\t\t}\n   230\t\tcase pb.EntryConfChangeV2:\n   231\t\t\tcc := &pb.ConfChangeV2{}\n   232\t\t\tif err := proto.Unmarshal(e.GetData(), cc); err != nil {\n   233\t\t\t\tformatted = err.Error()\n   234\t\t\t} else {\n   235\t\t\t\tformatted = formatConfChange(cc)\n   236\t\t\t}\n   237\t\t}\n   238\t\tif formatted != \"\" {\n   239\t\t\tformatted = \" \" + formatted\n   240\t\t}\n   241\t\treturn fmt.Sprintf(\"%d/%d %s%s\", e.GetTerm(), e.GetIndex(), e.GetType(), formatted)\n   242\t}\n   243\t\n   244\t// DescribeConfChange returns a deterministic, human-readable representation of\n   245\t// a ConfChangeI. It avoids using the proto text format (which adds random extra\n   246\t// spaces via detrand, producing unstable output across architectures/builds).\n   247\tfunc DescribeConfChange(cc pb.ConfChangeI) string {\n   248\t\tcv2 := cc.AsV2()\n   249\t\tvar b strings.Builder\n   250\t\tfmt.Fprintf(&b, \"transition:%v\", cv2.GetTransition())\n   251\t\tfor _, c := range cv2.GetChanges() {\n   252\t\t\tfmt.Fprintf(&b, \" changes:{type:%v node_id:%d}\", c.GetType(), c.GetNodeId())\n   253\t\t}\n   254\t\tif len(cv2.Context) > 0 {\n   255\t\t\tfmt.Fprintf(&b, \" context:%q\", cv2.Context)\n   256\t\t}\n   257\t\treturn b.String()\n   258\t}\n   259\t\n   260\t// DescribeEntries calls DescribeEntry for each Entry, adding a newline to\n   261\t// each.\n   262\tfunc DescribeEntries(ents []*pb.Entry, f EntryFormatter) string {\n   263\t\tvar buf bytes.Buffer\n   264\t\tfor _, e := range ents {\n   265\t\t\t_, _ = buf.WriteString(DescribeEntry(e, f) + \"\\n\")\n   266\t\t}\n   267\t\treturn buf.String()\n   268\t}\n   269\t\n   270\t// entryEncodingSize represents the protocol buffer encoding size of one or more\n   271\t// entries.\n   272\ttype entryEncodingSize uint64\n   273\t\n   274\tfunc entsSize(ents []*pb.Entry) entryEncodingSize {\n   275\t\tvar size entryEncodingSize\n   276\t\tfor _, ent := range ents {\n   277\t\t\tsize += entryEncodingSize(proto.Size(ent))\n   278\t\t}\n   279\t\treturn size\n   280\t}\n   281\t\n   282\t// limitSize returns the longest prefix of the given entries slice, such that\n   283\t// its total byte size does not exceed maxSize. Always returns a non-empty slice\n   284\t// if the input is non-empty, so, as an exception, if the size of the first\n   285\t// entry exceeds maxSize, a non-empty slice with just this entry is returned.\n   286\tfunc limitSize(ents []*pb.Entry, maxSize entryEncodingSize) []*pb.Entry {\n   287\t\tif len(ents) == 0 {\n   288\t\t\treturn ents\n   289\t\t}\n   290\t\tsize := entryEncodingSize(proto.Size(ents[0]))\n   291\t\tfor limit := 1; limit < len(ents); limit++ {\n   292\t\t\tsize += entryEncodingSize(proto.Size(ents[limit]))\n   293\t\t\tif size > maxSize {\n   294\t\t\t\treturn ents[:limit]\n   295\t\t\t}\n   296\t\t}\n   297\t\treturn ents\n   298\t}\n   299\t\n   300\t// entryPayloadSize represents the size of one or more entries' payloads.\n   301\t// Notably, it does not depend on its Index or Term. Entries with empty\n   302\t// payloads, like those proposed after a leadership change, are considered\n   303\t// to be zero size.\n   304\ttype entryPayloadSize uint64\n   305\t\n   306\t// payloadSize is the size of the payload of the provided entry.\n   307\tfunc payloadSize(e *pb.Entry) entryPayloadSize {\n   308\t\treturn entryPayloadSize(len(e.GetData()))\n   309\t}\n   310\t\n   311\t// payloadsSize is the size of the payloads of the provided entries.\n   312\tfunc payloadsSize(ents []*pb.Entry) entryPayloadSize {\n   313\t\tvar s entryPayloadSize\n   314\t\tfor _, e := range ents {\n   315\t\t\ts += payloadSize(e)\n   316\t\t}\n   317\t\treturn s\n   318\t}\n   319\t\n   320\tfunc assertConfStatesEquivalent(l Logger, cs1, cs2 *pb.ConfState) {\n   321\t\terr := cs1.Equivalent(cs2)\n   322\t\tif err == nil {\n   323\t\t\treturn\n   324\t\t}\n   325\t\tl.Panic(err)\n   326\t}\n   327\t\n   328\t// extend appends vals to the given dst slice. It differs from the standard\n   329\t// slice append only in the way it allocates memory. If cap(dst) is not enough\n   330\t// for appending the values, precisely size len(dst)+len(vals) is allocated.\n   331\t//\n   332\t// Use this instead of standard append in situations when this is the last\n   333\t// append to dst, so there is no sense in allocating more than needed.\n   334\tfunc extend(dst, vals []*pb.Entry) []*pb.Entry {\n   335\t\tneed := len(dst) + len(vals)\n   336\t\tif need <= cap(dst) {\n   337\t\t\treturn append(dst, vals...) // does not allocate\n   338\t\t}\n   339\t\tbuf := make([]*pb.Entry, need, need) // allocates precisely what's needed\n   340\t\tcopy(buf, dst)\n   341\t\tcopy(buf[len(dst):], vals)\n   342\t\treturn buf\n   343\t}\n","exit_code":0,"status":"completed"}}
