ved from the beginning of `unconfirmedReads`.\n    46\t\tconfirmedReads uint64\n    47\t}\n    48\t\n    49\tfunc newReadOnly(option ReadOnlyOption) *readOnly {\n    50\t\treturn &readOnly{\n    51\t\t\toption: option,\n    52\t\t\tacks:   make(map[uint64]uint64),\n    53\t\t}\n    54\t}\n    55\t\n    56\t// addRequest adds a read only request into the `readOnly`.\n    57\t// `commitIndex` is the commit index of the raft state machine when it received\n    58\t// the read only request.\n    59\t// `req` is the original read only request message from the local or remote node.\n    60\tfunc (ro *readOnly) addRequest(commitIndex uint64, req *pb.Message) {\n    61\t\tro.unconfirmedReads = append(ro.unconfirmedReads, &readIndexRequest{req: req, index: commitIndex})\n    62\t}\n    63\t\n    64\t// recvAck notifies the `readOnly` of an acknowledgment of a heartbeat response.\n    65\tfunc (ro *readOnly) recvAck(from uint64, ctx []byte) {\n    66\t\tif len(ctx) != 0 {\n    67\t\t\tro.acks[from] = max(ro.acks[from], binary.LittleEndian.Uint64(ctx))\n    68\t\t}\n    69\t}\n    70\t\n    71\t// AckedIndex allows for using `CommittedIndex` in `maybeAdvance`.\n    72\tfunc (ro *readOnly) AckedIndex(voterID uint64) (quorum.Index, bool) {\n    73\t\tidx, found := ro.acks[voterID]\n    74\t\treturn quorum.Index(idx), found\n    75\t}\n    76\t\n    77\t// maybeAdvance uses the existing acknowledgements and current raft\n    78\t// configuration to confirm and return as many unconfirmed reads as possible.\n    79\tfunc (ro *readOnly) maybeAdvance(c quorum.JointConfig) []*readIndexRequest {\n    80\t\t// Use `CommittedIndex` to figure out how many reads are now confirmed.\n    81\t\tnewConfirmedReads := uint64(c.CommittedIndex(ro))\n    82\t\tif newConfirmedReads <= ro.confirmedReads {\n    83\t\t\treturn nil\n    84\t\t}\n    85\t\treadStates := ro.unconfirmedReads[:newConfirmedReads-ro.confirmedReads]\n    86\t\tro.unconfirmedReads = ro.unconfirmedReads[newConfirmedReads-ro.confirmedReads:]\n    87\t\tro.confirmedReads = newConfirmedReads\n    88\t\treturn readStates\n    89\t}\n    90\t\n    91\t// heartbeatCtx returns the `Context` that should be sent in order to confirm\n    92\t// all currently unconfirmed reads.\n    93\tfunc (ro *readOnly) heartbeatCtx() []byte {\n    94\t\tif len(ro.unconfirmedReads) == 0 {\n    95\t\t\treturn nil\n    96\t\t}\n    97\t\tunconfirmedReadPosition := ro.confirmedReads + uint64(len(ro.unconfirmedReads))\n    98\t\tencLastIndex := make([]byte, 8)\n    99\t\tbinary.LittleEndian.PutUint64(encLastIndex, unconfirmedReadPosition)\n   100\t\treturn encLastIndex\n   101\t}\n","exit_code":0,"status":"completed"}}
