{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '600,900p' raft.go | nl -ba -v600\"","aggregated_output":"   600\t\t}\n   601\t}\n   602\t\n   603\t// sendAppend sends an append RPC with new entries (if any) and the\n   604\t// current commit index to the given peer.\n   605\tfunc (r *raft) sendAppend(to uint64) {\n   606\t\tr.maybeSendAppend(to, true)\n   607\t}\n   608\t\n   609\t// maybeSendAppend sends an append RPC with new entries to the given peer,\n   610\t// if necessary. Returns true if a message was sent. The sendIfEmpty\n   611\t// argument controls whether messages with no entries will be sent\n   612\t// (\"empty\" messages are useful to convey updated Commit indexes, but\n   613\t// are undesirable when we're sending multiple messages in a batch).\n   614\t//\n   615\t// TODO(pav-kv): make invocation of maybeSendAppend stateless. The Progress\n   616\t// struct contains all the state necessary for deciding whether to send a\n   617\t// message.\n   618\tfunc (r *raft) maybeSendAppend(to uint64, sendIfEmpty bool) bool {\n   619\t\tpr := r.trk.Progress[to]\n   620\t\tif pr.IsPaused() {\n   621\t\t\treturn false\n   622\t\t}\n   623\t\n   624\t\tprevIndex := pr.Next - 1\n   625\t\tprevTerm, err := r.raftLog.term(prevIndex)\n   626\t\tif err != nil {\n   627\t\t\t// The log probably got truncated at >= pr.Next, so we can't catch up the\n   628\t\t\t// follower log anymore. Send a snapshot instead.\n   629\t\t\treturn r.maybeSendSnapshot(to, pr)\n   630\t\t}\n   631\t\n   632\t\tvar ents []*pb.Entry\n   633\t\t// In a throttled StateReplicate only send empty MsgApp, to ensure progress.\n   634\t\t// Otherwise, if we had a full Inflights and all inflight messages were in\n   635\t\t// fact dropped, replication to that follower would stall. Instead, an empty\n   636\t\t// MsgApp will eventually reach the follower (heartbeats responses prompt the\n   637\t\t// leader to send an append), allowing it to be acked or rejected, both of\n   638\t\t// which will clear out Inflights.\n   639\t\tif pr.State != tracker.StateReplicate || !pr.Inflights.Full() {\n   640\t\t\tents, err = r.raftLog.entries(pr.Next, r.maxMsgSize)\n   641\t\t}\n   642\t\tif len(ents) == 0 && !sendIfEmpty {\n   643\t\t\treturn false\n   644\t\t}\n   645\t\t// TODO(pav-kv): move this check up to where err is returned.\n   646\t\tif err != nil { // send a snapshot if we failed to get the entries\n   647\t\t\treturn r.maybeSendSnapshot(to, pr)\n   648\t\t}\n   649\t\n   650\t\t// Send the actual MsgApp otherwise, and update the progress accordingly.\n   651\t\tr.send(&pb.Message{\n   652\t\t\tTo:      new(to),\n   653\t\t\tType:    pb.MsgApp.Enum(),\n   654\t\t\tIndex:   new(prevIndex),\n   655\t\t\tLogTerm: new(prevTerm),\n   656\t\t\tEntries: ents,\n   657\t\t\tCommit:  new(r.raftLog.committed),\n   658\t\t})\n   659\t\tpr.SentEntries(len(ents), uint64(payloadsSize(ents)))\n   660\t\tpr.SentCommit(r.raftLog.committed)\n   661\t\treturn true\n   662\t}\n   663\t\n   664\t// maybeSendSnapshot fetches a snapshot from Storage, and sends it to the given\n   665\t// node. Returns true iff the snapshot message has been emitted successfully.\n   666\tfunc (r *raft) maybeSendSnapshot(to uint64, pr *tracker.Progress) bool {\n   667\t\tif !pr.RecentActive {\n   668\t\t\tr.logger.Debugf(\"ignore sending snapshot to %x since it is not recently active\", to)\n   669\t\t\treturn false\n   670\t\t}\n   671\t\n   672\t\tsnapshot, err := r.raftLog.snapshot()\n   673\t\tif err != nil {\n   674\t\t\tif err == ErrSnapshotTemporarilyUnavailable {\n   675\t\t\t\tr.logger.Debugf(\"%x failed to send snapshot to %x because snapshot is temporarily unavailable\", r.id, to)\n   676\t\t\t\treturn false\n   677\t\t\t}\n   678\t\t\tpanic(err) // TODO(bdarnell)\n   679\t\t}\n   680\t\tif IsEmptySnap(snapshot) {\n   681\t\t\tpanic(\"need non-empty snapshot\")\n   682\t\t}\n   683\t\tsindex, sterm := snapshot.GetMetadata().GetIndex(), snapshot.GetMetadata().GetTerm()\n   684\t\tr.logger.Debugf(\"%x [firstindex: %d, commit: %d] sent snapshot[index: %d, term: %d] to %x [%s]\",\n   685\t\t\tr.id, r.raftLog.firstIndex(), r.raftLog.committed, sindex, sterm, to, pr)\n   686\t\tpr.BecomeSnapshot(sindex)\n   687\t\tr.logger.Debugf(\"%x paused sending replication messages to %x [%s]\", r.id, to, pr)\n   688\t\n   689\t\tr.send(&pb.Message{To: new(to), Type: pb.MsgSnap.Enum(), Snapshot: snapshot})\n   690\t\treturn true\n   691\t}\n   692\t\n   693\t// sendHeartbeat sends a heartbeat RPC to the given peer.\n   694\tfunc (r *raft) sendHeartbeat(to uint64, ctx []byte) {\n   695\t\tpr := r.trk.Progress[to]\n   696\t\t// Attach the commit as min(to.matched, r.committed).\n   697\t\t// When the leader sends out heartbeat message,\n   698\t\t// the receiver(follower) might not be matched with the leader\n   699\t\t// or it might not have all the committed entries.\n   700\t\t// The leader MUST NOT forward the follower's commit to\n   701\t\t// an unmatched index.\n   702\t\tcommit := min(pr.Match, r.raftLog.committed)\n   703\t\tr.send(&pb.Message{\n   704\t\t\tTo:      new(to),\n   705\t\t\tType:    pb.MsgHeartbeat.Enum(),\n   706\t\t\tCommit:  new(commit),\n   707\t\t\tContext: ctx,\n   708\t\t})\n   709\t\tpr.SentCommit(commit)\n   710\t}\n   711\t\n   712\t// bcastAppend sends RPC, with entries to all peers that are not up-to-date\n   713\t// according to the progress recorded in r.trk.\n   714\tfunc (r *raft) bcastAppend() {\n   715\t\tr.trk.Visit(func(id uint64, _ *tracker.Progress) {\n   716\t\t\tif id == r.id {\n   717\t\t\t\treturn\n   718\t\t\t}\n   719\t\t\tr.sendAppend(id)\n   720\t\t})\n   721\t}\n   722\t\n   723\t// bcastHeartbeat sends RPC, without entries to all the peers.\n   724\tfunc (r *raft) bcastHeartbeat() {\n   725\t\tr.bcastHeartbeatWithCtx(r.readOnly.heartbeatCtx())\n   726\t}\n   727\t\n   728\tfunc (r *raft) bcastHeartbeatWithCtx(ctx []byte) {\n   729\t\tr.trk.Visit(func(id uint64, _ *tracker.Progress) {\n   730\t\t\tif id == r.id {\n   731\t\t\t\treturn\n   732\t\t\t}\n   733\t\t\tr.sendHeartbeat(id, ctx)\n   734\t\t})\n   735\t}\n   736\t\n   737\tfunc (r *raft) appliedTo(index uint64, size entryEncodingSize) {\n   738\t\toldApplied := r.raftLog.applied\n   739\t\tnewApplied := max(index, oldApplied)\n   740\t\tr.raftLog.appliedTo(newApplied, size)\n   741\t\n   742\t\tif r.trk.Config.AutoLeave && newApplied >= r.pendingConfIndex && r.state == StateLeader {\n   743\t\t\t// If the current (and most recent, at least for this leader's term)\n   744\t\t\t// configuration should be auto-left, initiate that now. We use a\n   745\t\t\t// nil Data which unmarshals into an empty ConfChangeV2 and has the\n   746\t\t\t// benefit that appendEntry can never refuse it based on its size\n   747\t\t\t// (which registers as zero).\n   748\t\t\tm, err := confChangeToMsg(nil)\n   749\t\t\tif err != nil {\n   750\t\t\t\tpanic(err)\n   751\t\t\t}\n   752\t\t\t// NB: this proposal can't be dropped due to size, but can be\n   753\t\t\t// dropped if a leadership transfer is in progress. We'll keep\n   754\t\t\t// checking this condition on each applied entry, so either the\n   755\t\t\t// leadership transfer will succeed and the new leader will leave\n   756\t\t\t// the joint configuration, or the leadership transfer will fail,\n   757\t\t\t// and we will propose the config change on the next advance.\n   758\t\t\tif err := r.Step(m); err != nil {\n   759\t\t\t\tr.logger.Debugf(\"not initiating automatic transition out of joint configuration %s: %v\", r.trk.Config, err)\n   760\t\t\t} else {\n   761\t\t\t\tr.logger.Infof(\"initiating automatic transition out of joint configuration %s\", r.trk.Config)\n   762\t\t\t}\n   763\t\t}\n   764\t}\n   765\t\n   766\tfunc (r *raft) appliedSnap(snap *pb.Snapshot) {\n   767\t\tindex := snap.GetMetadata().GetIndex()\n   768\t\tr.raftLog.stableSnapTo(index)\n   769\t\tr.appliedTo(index, 0 /* size */)\n   770\t}\n   771\t\n   772\t// maybeCommit attempts to advance the commit index. Returns true if the commit\n   773\t// index changed (in which case the caller should call r.bcastAppend). This can\n   774\t// only be called in StateLeader.\n   775\tfunc (r *raft) maybeCommit() bool {\n   776\t\tdefer traceCommit(r)\n   777\t\n   778\t\treturn r.raftLog.maybeCommit(entryID{term: r.Term, index: r.trk.Committed()})\n   779\t}\n   780\t\n   781\tfunc (r *raft) reset(term uint64) {\n   782\t\tif r.Term != term {\n   783\t\t\tr.Term = term\n   784\t\t\tr.Vote = None\n   785\t\t}\n   786\t\tr.lead = None\n   787\t\n   788\t\tr.electionElapsed = 0\n   789\t\tr.heartbeatElapsed = 0\n   790\t\tr.resetRandomizedElectionTimeout()\n   791\t\n   792\t\tr.abortLeaderTransfer()\n   793\t\n   794\t\tr.trk.ResetVotes()\n   795\t\tr.trk.Visit(func(id uint64, pr *tracker.Progress) {\n   796\t\t\t*pr = tracker.Progress{\n   797\t\t\t\tMatch:     0,\n   798\t\t\t\tNext:      r.raftLog.lastIndex() + 1,\n   799\t\t\t\tInflights: tracker.NewInflights(r.trk.MaxInflight, r.trk.MaxInflightBytes),\n   800\t\t\t\tIsLearner: pr.IsLearner,\n   801\t\t\t}\n   802\t\t\tif id == r.id {\n   803\t\t\t\tpr.Match = r.raftLog.lastIndex()\n   804\t\t\t}\n   805\t\t})\n   806\t\n   807\t\tr.pendingConfIndex = 0\n   808\t\tr.uncommittedSize = 0\n   809\t\tr.readOnly = newReadOnly(r.readOnly.option)\n   810\t}\n   811\t\n   812\tfunc (r *raft) appendEntry(es ...*pb.Entry) (accepted bool) {\n   813\t\tli := r.raftLog.lastIndex()\n   814\t\tcloned := make([]*pb.Entry, len(es))\n   815\t\tfor i := range es {\n   816\t\t\t// TODO: Consider whether cloning/copying is necessary at all, and aim to eliminate it if possible.\n   817\t\t\tcloned[i] = proto.Clone(es[i]).(*pb.Entry)\n   818\t\t\tcloned[i].Term = new(r.Term)\n   819\t\t\tcloned[i].Index = new(li + 1 + uint64(i))\n   820\t\t}\n   821\t\t// Track the size of this uncommitted proposal.\n   822\t\tif !r.increaseUncommittedSize(cloned) {\n   823\t\t\tr.logger.Warningf(\n   824\t\t\t\t\"%x appending new entries to log would exceed uncommitted entry size limit; dropping proposal\",\n   825\t\t\t\tr.id,\n   826\t\t\t)\n   827\t\t\t// Drop the proposal.\n   828\t\t\treturn false\n   829\t\t}\n   830\t\n   831\t\ttraceReplicate(r, cloned...)\n   832\t\n   833\t\t// use latest \"last\" index after truncate/append\n   834\t\tli = r.raftLog.append(cloned...)\n   835\t\t// The leader needs to self-ack the entries just appended once they have\n   836\t\t// been durably persisted (since it doesn't send an MsgApp to itself). This\n   837\t\t// response message will be added to msgsAfterAppend and delivered back to\n   838\t\t// this node after these entries have been written to stable storage. When\n   839\t\t// handled, this is roughly equivalent to:\n   840\t\t//\n   841\t\t//  r.trk.Progress[r.id].MaybeUpdate(e.Index)\n   842\t\t//  if r.maybeCommit() {\n   843\t\t//  \tr.bcastAppend()\n   844\t\t//  }\n   845\t\tr.send(&pb.Message{To: new(r.id), Type: pb.MsgAppResp.Enum(), Index: new(li)})\n   846\t\treturn true\n   847\t}\n   848\t\n   849\t// tickElection is run by followers and candidates after r.electionTimeout.\n   850\tfunc (r *raft) tickElection() {\n   851\t\tr.electionElapsed++\n   852\t\n   853\t\tif r.promotable() && r.pastElectionTimeout() {\n   854\t\t\tr.electionElapsed = 0\n   855\t\t\tif err := r.Step(&pb.Message{From: new(r.id), Type: pb.MsgHup.Enum()}); err != nil {\n   856\t\t\t\tr.logger.Debugf(\"error occurred during election: %v\", err)\n   857\t\t\t}\n   858\t\t}\n   859\t}\n   860\t\n   861\t// tickHeartbeat is run by leaders to send a MsgBeat after r.heartbeatTimeout.\n   862\tfunc (r *raft) tickHeartbeat() {\n   863\t\tr.heartbeatElapsed++\n   864\t\tr.electionElapsed++\n   865\t\n   866\t\tif r.electionElapsed >= r.electionTimeout {\n   867\t\t\tr.electionElapsed = 0\n   868\t\t\tif r.checkQuorum {\n   869\t\t\t\tif err := r.Step(&pb.Message{From: new(r.id), Type: pb.MsgCheckQuorum.Enum()}); err != nil {\n   870\t\t\t\t\tr.logger.Debugf(\"error occurred during checking sending heartbeat: %v\", err)\n   871\t\t\t\t}\n   872\t\t\t}\n   873\t\t\t// If current leader cannot transfer leadership in electionTimeout, it becomes leader again.\n   874\t\t\tif r.state == StateLeader && r.leadTransferee != None {\n   875\t\t\t\tr.abortLeaderTransfer()\n   876\t\t\t}\n   877\t\t}\n   878\t\n   879\t\tif r.state != StateLeader {\n   880\t\t\treturn\n   881\t\t}\n   882\t\n   883\t\tif r.heartbeatElapsed >= r.heartbeatTimeout {\n   884\t\t\tr.heartbeatElapsed = 0\n   885\t\t\tif err := r.Step(&pb.Message{From: new(r.id), Type: pb.MsgBeat.Enum()}); err != nil {\n   886\t\t\t\tr.logger.Debugf(\"error occurred during checking sending heartbeat: %v\", err)\n   887\t\t\t}\n   888\t\t}\n   889\t}\n   890\t\n   891\tfunc (r *raft) becomeFollower(term uint64, lead uint64) {\n   892\t\tr.step = stepFollower\n   893\t\tr.reset(term)\n   894\t\tr.tick = r.tickElection\n   895\t\tr.lead = lead\n   896\t\tr.state = StateFollower\n   897\t\tr.logger.Infof(\"%x became follower at term %d\", r.id, r.Term)\n   898\t\n   899\t\ttraceBecomeFollower(r)\n   900\t}\n","exit_code":0,"status":"completed"}}
