{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '1089,1400p' raft.go | nl -ba -v1089\"","aggregated_output":"  1089\tfunc (r *raft) Step(m *pb.Message) error {\n  1090\t\t// m should never be nil\n  1091\t\tif m == nil {\n  1092\t\t\treturn errors.New(\"nil message\")\n  1093\t\t}\n  1094\t\ttraceReceiveMessage(r, m)\n  1095\t\n  1096\t\t// Handle the message term, which may result in our stepping down to a follower.\n  1097\t\tswitch {\n  1098\t\tcase m.GetTerm() == 0:\n  1099\t\t\t// local message\n  1100\t\tcase m.GetTerm() > r.Term:\n  1101\t\t\tif m.GetType() == pb.MsgVote || m.GetType() == pb.MsgPreVote {\n  1102\t\t\t\tforce := bytes.Equal(m.GetContext(), []byte(campaignTransfer))\n  1103\t\t\t\tinLease := r.checkQuorum && r.lead != None && r.electionElapsed < r.electionTimeout\n  1104\t\t\t\tif !force && inLease {\n  1105\t\t\t\t\t// If a server receives a RequestVote request within the minimum election timeout\n  1106\t\t\t\t\t// of hearing from a current leader, it does not update its term or grant its vote\n  1107\t\t\t\t\tlast := r.raftLog.lastEntryID()\n  1108\t\t\t\t\t// TODO(pav-kv): it should be ok to simply print the %+v of the lastEntryID.\n  1109\t\t\t\t\tr.logger.Infof(\"%x [logterm: %d, index: %d, vote: %x] ignored %s from %x [logterm: %d, index: %d] at term %d: lease is not expired (remaining ticks: %d)\",\n  1110\t\t\t\t\t\tr.id, last.term, last.index, r.Vote, m.GetType(), m.GetFrom(), m.GetLogTerm(), m.GetIndex(), r.Term, r.electionTimeout-r.electionElapsed)\n  1111\t\t\t\t\treturn nil\n  1112\t\t\t\t}\n  1113\t\t\t}\n  1114\t\t\tswitch {\n  1115\t\t\tcase m.GetType() == pb.MsgPreVote:\n  1116\t\t\t\t// Never change our term in response to a PreVote\n  1117\t\t\tcase m.GetType() == pb.MsgPreVoteResp && !m.GetReject():\n  1118\t\t\t\t// We send pre-vote requests with a term in our future. If the\n  1119\t\t\t\t// pre-vote is granted, we will increment our term when we get a\n  1120\t\t\t\t// quorum. If it is not, the term comes from the node that\n  1121\t\t\t\t// rejected our vote so we should become a follower at the new\n  1122\t\t\t\t// term.\n  1123\t\t\tdefault:\n  1124\t\t\t\tr.logger.Infof(\"%x [term: %d] received a %s message with higher term from %x [term: %d]\",\n  1125\t\t\t\t\tr.id, r.Term, m.GetType(), m.GetFrom(), m.GetTerm())\n  1126\t\t\t\tif m.GetType() == pb.MsgApp || m.GetType() == pb.MsgHeartbeat || m.GetType() == pb.MsgSnap {\n  1127\t\t\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom())\n  1128\t\t\t\t} else {\n  1129\t\t\t\t\tr.becomeFollower(m.GetTerm(), None)\n  1130\t\t\t\t}\n  1131\t\t\t}\n  1132\t\n  1133\t\tcase m.GetTerm() < r.Term:\n  1134\t\t\tif (r.checkQuorum || r.preVote) && (m.GetType() == pb.MsgHeartbeat || m.GetType() == pb.MsgApp) {\n  1135\t\t\t\t// We have received messages from a leader at a lower term. It is possible\n  1136\t\t\t\t// that these messages were simply delayed in the network, but this could\n  1137\t\t\t\t// also mean that this node has advanced its term number during a network\n  1138\t\t\t\t// partition, and it is now unable to either win an election or to rejoin\n  1139\t\t\t\t// the majority on the old term. If checkQuorum is false, this will be\n  1140\t\t\t\t// handled by incrementing term numbers in response to MsgVote with a\n  1141\t\t\t\t// higher term, but if checkQuorum is true we may not advance the term on\n  1142\t\t\t\t// MsgVote and must generate other messages to advance the term. The net\n  1143\t\t\t\t// result of these two features is to minimize the disruption caused by\n  1144\t\t\t\t// nodes that have been removed from the cluster's configuration: a\n  1145\t\t\t\t// removed node will send MsgVotes (or MsgPreVotes) which will be ignored,\n  1146\t\t\t\t// but it will not receive MsgApp or MsgHeartbeat, so it will not create\n  1147\t\t\t\t// disruptive term increases, by notifying leader of this node's activeness.\n  1148\t\t\t\t// The above comments also true for Pre-Vote\n  1149\t\t\t\t//\n  1150\t\t\t\t// When follower gets isolated, it soon starts an election ending\n  1151\t\t\t\t// up with a higher term than leader, although it won't receive enough\n  1152\t\t\t\t// votes to win the election. When it regains connectivity, this response\n  1153\t\t\t\t// with \"pb.MsgAppResp\" of higher term would force leader to step down.\n  1154\t\t\t\t// However, this disruption is inevitable to free this stuck node with\n  1155\t\t\t\t// fresh election. This can be prevented with Pre-Vote phase.\n  1156\t\t\t\tr.send(&pb.Message{To: m.From, Type: pb.MsgAppResp.Enum()})\n  1157\t\t\t} else if m.GetType() == pb.MsgPreVote {\n  1158\t\t\t\t// Before Pre-Vote enable, there may have candidate with higher term,\n  1159\t\t\t\t// but less log. After update to Pre-Vote, the cluster may deadlock if\n  1160\t\t\t\t// we drop messages with a lower term.\n  1161\t\t\t\tlast := r.raftLog.lastEntryID()\n  1162\t\t\t\t// TODO(pav-kv): it should be ok to simply print %+v of the lastEntryID.\n  1163\t\t\t\tr.logger.Infof(\"%x [logterm: %d, index: %d, vote: %x] rejected %s from %x [logterm: %d, index: %d] at term %d\",\n  1164\t\t\t\t\tr.id, last.term, last.index, r.Vote, m.GetType(), m.GetFrom(), m.GetLogTerm(), m.GetIndex(), r.Term)\n  1165\t\t\t\tr.send(&pb.Message{To: m.From, Term: new(r.Term), Type: pb.MsgPreVoteResp.Enum(), Reject: new(true)})\n  1166\t\t\t} else if m.GetType() == pb.MsgStorageAppendResp {\n  1167\t\t\t\tif m.GetIndex() != 0 {\n  1168\t\t\t\t\t// Don't consider the appended log entries to be stable because\n  1169\t\t\t\t\t// they may have been overwritten in the unstable log during a\n  1170\t\t\t\t\t// later term. See the comment in newStorageAppendResp for more\n  1171\t\t\t\t\t// about this race.\n  1172\t\t\t\t\tr.logger.Infof(\"%x [term: %d] ignored entry appends from a %s message with lower term [term: %d]\",\n  1173\t\t\t\t\t\tr.id, r.Term, m.GetType(), m.GetTerm())\n  1174\t\t\t\t}\n  1175\t\t\t\tif m.GetSnapshot() != nil {\n  1176\t\t\t\t\t// Even if the snapshot applied under a different term, its\n  1177\t\t\t\t\t// application is still valid. Snapshots carry committed\n  1178\t\t\t\t\t// (term-independent) state.\n  1179\t\t\t\t\tr.appliedSnap(m.GetSnapshot())\n  1180\t\t\t\t}\n  1181\t\t\t} else {\n  1182\t\t\t\t// ignore other cases\n  1183\t\t\t\tr.logger.Infof(\"%x [term: %d] ignored a %s message with lower term from %x [term: %d]\",\n  1184\t\t\t\t\tr.id, r.Term, m.GetType(), m.GetFrom(), m.GetTerm())\n  1185\t\t\t}\n  1186\t\t\treturn nil\n  1187\t\t}\n  1188\t\n  1189\t\tswitch m.GetType() {\n  1190\t\tcase pb.MsgHup:\n  1191\t\t\tif r.preVote {\n  1192\t\t\t\tr.hup(campaignPreElection)\n  1193\t\t\t} else {\n  1194\t\t\t\tr.hup(campaignElection)\n  1195\t\t\t}\n  1196\t\n  1197\t\tcase pb.MsgStorageAppendResp:\n  1198\t\t\tif m.GetIndex() != 0 {\n  1199\t\t\t\tr.raftLog.stableTo(entryID{term: m.GetLogTerm(), index: m.GetIndex()})\n  1200\t\t\t}\n  1201\t\t\tif m.GetSnapshot() != nil {\n  1202\t\t\t\tr.appliedSnap(m.GetSnapshot())\n  1203\t\t\t}\n  1204\t\n  1205\t\tcase pb.MsgStorageApplyResp:\n  1206\t\t\tif len(m.GetEntries()) > 0 {\n  1207\t\t\t\tindex := m.GetEntries()[len(m.GetEntries())-1].GetIndex()\n  1208\t\t\t\tr.appliedTo(index, entsSize(m.GetEntries()))\n  1209\t\t\t\tr.reduceUncommittedSize(payloadsSize(m.GetEntries()))\n  1210\t\t\t}\n  1211\t\n  1212\t\tcase pb.MsgVote, pb.MsgPreVote:\n  1213\t\t\t// We can vote if this is a repeat of a vote we've already cast...\n  1214\t\t\tcanVote := r.Vote == m.GetFrom() ||\n  1215\t\t\t\t// ...we haven't voted and we don't think there's a leader yet in this term...\n  1216\t\t\t\t(r.Vote == None && r.lead == None) ||\n  1217\t\t\t\t// ...or this is a PreVote for a future term...\n  1218\t\t\t\t(m.GetType() == pb.MsgPreVote && m.GetTerm() > r.Term)\n  1219\t\t\t// ...and we believe the candidate is up to date.\n  1220\t\t\tlastID := r.raftLog.lastEntryID()\n  1221\t\t\tcandLastID := entryID{term: m.GetLogTerm(), index: m.GetIndex()}\n  1222\t\t\tif canVote && r.raftLog.isUpToDate(candLastID) {\n  1223\t\t\t\t// Note: it turns out that that learners must be allowed to cast votes.\n  1224\t\t\t\t// This seems counter- intuitive but is necessary in the situation in which\n  1225\t\t\t\t// a learner has been promoted (i.e. is now a voter) but has not learned\n  1226\t\t\t\t// about this yet.\n  1227\t\t\t\t// For example, consider a group in which id=1 is a learner and id=2 and\n  1228\t\t\t\t// id=3 are voters. A configuration change promoting 1 can be committed on\n  1229\t\t\t\t// the quorum `{2,3}` without the config change being appended to the\n  1230\t\t\t\t// learner's log. If the leader (say 2) fails, there are de facto two\n  1231\t\t\t\t// voters remaining. Only 3 can win an election (due to its log containing\n  1232\t\t\t\t// all committed entries), but to do so it will need 1 to vote. But 1\n  1233\t\t\t\t// considers itself a learner and will continue to do so until 3 has\n  1234\t\t\t\t// stepped up as leader, replicates the conf change to 1, and 1 applies it.\n  1235\t\t\t\t// Ultimately, by receiving a request to vote, the learner realizes that\n  1236\t\t\t\t// the candidate believes it to be a voter, and that it should act\n  1237\t\t\t\t// accordingly. The candidate's config may be stale, too; but in that case\n  1238\t\t\t\t// it won't win the election, at least in the absence of the bug discussed\n  1239\t\t\t\t// in:\n  1240\t\t\t\t// https://github.com/etcd-io/etcd/issues/7625#issuecomment-488798263.\n  1241\t\t\t\tr.logger.Infof(\"%x [logterm: %d, index: %d, vote: %x] cast %s for %x [logterm: %d, index: %d] at term %d\",\n  1242\t\t\t\t\tr.id, lastID.term, lastID.index, r.Vote, m.GetType(), m.GetFrom(), candLastID.term, candLastID.index, r.Term)\n  1243\t\t\t\t// When responding to Msg{Pre,}Vote messages we include the term\n  1244\t\t\t\t// from the message, not the local term. To see why, consider the\n  1245\t\t\t\t// case where a single node was previously partitioned away and\n  1246\t\t\t\t// it's local term is now out of date. If we include the local term\n  1247\t\t\t\t// (recall that for pre-votes we don't update the local term), the\n  1248\t\t\t\t// (pre-)campaigning node on the other end will proceed to ignore\n  1249\t\t\t\t// the message (it ignores all out of date messages).\n  1250\t\t\t\t// The term in the original message and current local term are the\n  1251\t\t\t\t// same in the case of regular votes, but different for pre-votes.\n  1252\t\t\t\tr.send(&pb.Message{To: m.From, Term: m.Term, Type: voteRespMsgType(m.GetType()).Enum()})\n  1253\t\t\t\tif m.GetType() == pb.MsgVote {\n  1254\t\t\t\t\t// Only record real votes.\n  1255\t\t\t\t\tr.electionElapsed = 0\n  1256\t\t\t\t\tr.Vote = m.GetFrom()\n  1257\t\t\t\t}\n  1258\t\t\t} else {\n  1259\t\t\t\tr.logger.Infof(\"%x [logterm: %d, index: %d, vote: %x] rejected %s from %x [logterm: %d, index: %d] at term %d\",\n  1260\t\t\t\t\tr.id, lastID.term, lastID.index, r.Vote, m.GetType(), m.GetFrom(), candLastID.term, candLastID.index, r.Term)\n  1261\t\t\t\tr.send(&pb.Message{To: m.From, Term: new(r.Term), Type: voteRespMsgType(m.GetType()).Enum(), Reject: new(true)})\n  1262\t\t\t}\n  1263\t\n  1264\t\tdefault:\n  1265\t\t\terr := r.step(r, m)\n  1266\t\t\tif err != nil {\n  1267\t\t\t\treturn err\n  1268\t\t\t}\n  1269\t\t}\n  1270\t\treturn nil\n  1271\t}\n  1272\t\n  1273\ttype stepFunc func(r *raft, m *pb.Message) error\n  1274\t\n  1275\tfunc stepLeader(r *raft, m *pb.Message) error {\n  1276\t\t// These message types do not require any progress for m.From.\n  1277\t\tswitch m.GetType() {\n  1278\t\tcase pb.MsgBeat:\n  1279\t\t\tr.bcastHeartbeat()\n  1280\t\t\treturn nil\n  1281\t\tcase pb.MsgCheckQuorum:\n  1282\t\t\tif !r.trk.QuorumActive() {\n  1283\t\t\t\tr.logger.Warningf(\"%x stepped down to follower since quorum is not active\", r.id)\n  1284\t\t\t\tr.becomeFollower(r.Term, None)\n  1285\t\t\t}\n  1286\t\t\t// Mark everyone (but ourselves) as inactive in preparation for the next\n  1287\t\t\t// CheckQuorum.\n  1288\t\t\tr.trk.Visit(func(id uint64, pr *tracker.Progress) {\n  1289\t\t\t\tif id != r.id {\n  1290\t\t\t\t\tpr.RecentActive = false\n  1291\t\t\t\t}\n  1292\t\t\t})\n  1293\t\t\treturn nil\n  1294\t\tcase pb.MsgProp:\n  1295\t\t\tif len(m.GetEntries()) == 0 {\n  1296\t\t\t\tr.logger.Panicf(\"%x stepped empty MsgProp\", r.id)\n  1297\t\t\t}\n  1298\t\t\tif r.trk.Progress[r.id] == nil {\n  1299\t\t\t\t// If we are not currently a member of the range (i.e. this node\n  1300\t\t\t\t// was removed from the configuration while serving as leader),\n  1301\t\t\t\t// drop any new proposals.\n  1302\t\t\t\treturn ErrProposalDropped\n  1303\t\t\t}\n  1304\t\t\tif r.leadTransferee != None {\n  1305\t\t\t\tr.logger.Debugf(\"%x [term %d] transfer leadership to %x is in progress; dropping proposal\", r.id, r.Term, r.leadTransferee)\n  1306\t\t\t\treturn ErrProposalDropped\n  1307\t\t\t}\n  1308\t\n  1309\t\t\tfor i := range m.GetEntries() {\n  1310\t\t\t\te := m.GetEntries()[i]\n  1311\t\t\t\tvar cc pb.ConfChangeI\n  1312\t\t\t\tif e.GetType() == pb.EntryConfChange {\n  1313\t\t\t\t\tccc := &pb.ConfChange{}\n  1314\t\t\t\t\tif err := proto.Unmarshal(e.GetData(), ccc); err != nil {\n  1315\t\t\t\t\t\tpanic(err)\n  1316\t\t\t\t\t}\n  1317\t\t\t\t\tcc = ccc\n  1318\t\t\t\t} else if e.GetType() == pb.EntryConfChangeV2 {\n  1319\t\t\t\t\tccc := &pb.ConfChangeV2{}\n  1320\t\t\t\t\tif err := proto.Unmarshal(e.GetData(), ccc); err != nil {\n  1321\t\t\t\t\t\tpanic(err)\n  1322\t\t\t\t\t}\n  1323\t\t\t\t\tcc = ccc\n  1324\t\t\t\t}\n  1325\t\t\t\tif cc != nil {\n  1326\t\t\t\t\talreadyPending := r.pendingConfIndex > r.raftLog.applied\n  1327\t\t\t\t\talreadyJoint := len(r.trk.Config.Voters[1]) > 0\n  1328\t\t\t\t\twantsLeaveJoint := len(cc.AsV2().Changes) == 0\n  1329\t\n  1330\t\t\t\t\tvar failedCheck string\n  1331\t\t\t\t\tif alreadyPending {\n  1332\t\t\t\t\t\tfailedCheck = fmt.Sprintf(\"possible unapplied conf change at index %d (applied to %d)\", r.pendingConfIndex, r.raftLog.applied)\n  1333\t\t\t\t\t} else if alreadyJoint && !wantsLeaveJoint {\n  1334\t\t\t\t\t\tfailedCheck = \"must transition out of joint config first\"\n  1335\t\t\t\t\t} else if !alreadyJoint && wantsLeaveJoint {\n  1336\t\t\t\t\t\tfailedCheck = \"not in joint state; refusing empty conf change\"\n  1337\t\t\t\t\t}\n  1338\t\n  1339\t\t\t\t\tif failedCheck != \"\" && !r.disableConfChangeValidation {\n  1340\t\t\t\t\t\tr.logger.Infof(\"%x ignoring conf change %s at config %s: %s\", r.id, DescribeConfChange(cc), r.trk.Config, failedCheck)\n  1341\t\t\t\t\t\tm.GetEntries()[i] = &pb.Entry{Type: pb.EntryNormal.Enum()}\n  1342\t\t\t\t\t} else {\n  1343\t\t\t\t\t\tr.pendingConfIndex = r.raftLog.lastIndex() + uint64(i) + 1\n  1344\t\t\t\t\t\ttraceChangeConfEvent(cc, r)\n  1345\t\t\t\t\t}\n  1346\t\t\t\t}\n  1347\t\t\t}\n  1348\t\n  1349\t\t\tif !r.appendEntry(m.GetEntries()...) {\n  1350\t\t\t\treturn ErrProposalDropped\n  1351\t\t\t}\n  1352\t\t\tr.bcastAppend()\n  1353\t\t\treturn nil\n  1354\t\tcase pb.MsgReadIndex:\n  1355\t\t\t// only one voting member (the leader) in the cluster\n  1356\t\t\tif r.trk.IsSingleton() {\n  1357\t\t\t\tif resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.GetTo() != None {\n  1358\t\t\t\t\tr.send(resp)\n  1359\t\t\t\t}\n  1360\t\t\t\treturn nil\n  1361\t\t\t}\n  1362\t\n  1363\t\t\t// Postpone read only request when this leader has not committed\n  1364\t\t\t// any log entry at its term.\n  1365\t\t\tif !r.committedEntryInCurrentTerm() {\n  1366\t\t\t\tr.pendingReadIndexMessages = append(r.pendingReadIndexMessages, m)\n  1367\t\t\t\treturn nil\n  1368\t\t\t}\n  1369\t\n  1370\t\t\tsendMsgReadIndexResponse(r, m)\n  1371\t\n  1372\t\t\treturn nil\n  1373\t\tcase pb.MsgForgetLeader:\n  1374\t\t\treturn nil // noop on leader\n  1375\t\t}\n  1376\t\n  1377\t\t// All other message types require a progress for m.From (pr).\n  1378\t\tpr := r.trk.Progress[m.GetFrom()]\n  1379\t\tif pr == nil {\n  1380\t\t\tr.logger.Debugf(\"%x no progress available for %x\", r.id, m.GetFrom())\n  1381\t\t\treturn nil\n  1382\t\t}\n  1383\t\tswitch m.GetType() {\n  1384\t\tcase pb.MsgAppResp:\n  1385\t\t\t// NB: this code path is also hit from (*raft).advance, where the leader steps\n  1386\t\t\t// an MsgAppResp to acknowledge the appended entries in the last Ready.\n  1387\t\n  1388\t\t\tpr.RecentActive = true\n  1389\t\n  1390\t\t\tif m.GetReject() {\n  1391\t\t\t\t// RejectHint is the suggested next base entry for appending (i.e.\n  1392\t\t\t\t// we try to append entry RejectHint+1 next), and LogTerm is the\n  1393\t\t\t\t// term that the follower has at index RejectHint. Older versions\n  1394\t\t\t\t// of this library did not populate LogTerm for rejections and it\n  1395\t\t\t\t// is zero for followers with an empty log.\n  1396\t\t\t\t//\n  1397\t\t\t\t// Under normal circumstances, the leader's log is longer than the\n  1398\t\t\t\t// follower's and the follower's log is a prefix of the leader's\n  1399\t\t\t\t// (i.e. there is no divergent uncommitted suffix of the log on the\n  1400\t\t\t\t// follower). In that case, the first probe reveals where the\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '1400,1700p' raft.go | nl -ba -v1400\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '1400,1700p' raft.go | nl -ba -v1400\"","aggregated_output":"  1400\t\t\t\t// follower). In that case, the first probe reveals where the\n  1401\t\t\t\t// follower's log ends (RejectHint=follower's last index) and the\n  1402\t\t\t\t// subsequent probe succeeds.\n  1403\t\t\t\t//\n  1404\t\t\t\t// However, when networks are partitioned or systems overloaded,\n  1405\t\t\t\t// large divergent log tails can occur. The naive attempt, probing\n  1406\t\t\t\t// entry by entry in decreasing order, will be the product of the\n  1407\t\t\t\t// length of the diverging tails and the network round-trip latency,\n  1408\t\t\t\t// which can easily result in hours of time spent probing and can\n  1409\t\t\t\t// even cause outright outages. The probes are thus optimized as\n  1410\t\t\t\t// described below.\n  1411\t\t\t\tr.logger.Debugf(\"%x received MsgAppResp(rejected, hint: (index %d, term %d)) from %x for index %d\",\n  1412\t\t\t\t\tr.id, m.GetRejectHint(), m.GetLogTerm(), m.GetFrom(), m.GetIndex())\n  1413\t\t\t\tnextProbeIdx := m.GetRejectHint()\n  1414\t\t\t\tif m.GetLogTerm() > 0 {\n  1415\t\t\t\t\t// If the follower has an uncommitted log tail, we would end up\n  1416\t\t\t\t\t// probing one by one until we hit the common prefix.\n  1417\t\t\t\t\t//\n  1418\t\t\t\t\t// For example, if the leader has:\n  1419\t\t\t\t\t//\n  1420\t\t\t\t\t//   idx        1 2 3 4 5 6 7 8 9\n  1421\t\t\t\t\t//              -----------------\n  1422\t\t\t\t\t//   term (L)   1 3 3 3 5 5 5 5 5\n  1423\t\t\t\t\t//   term (F)   1 1 1 1 2 2\n  1424\t\t\t\t\t//\n  1425\t\t\t\t\t// Then, after sending an append anchored at (idx=9,term=5) we\n  1426\t\t\t\t\t// would receive a RejectHint of 6 and LogTerm of 2. Without the\n  1427\t\t\t\t\t// code below, we would try an append at index 6, which would\n  1428\t\t\t\t\t// fail again.\n  1429\t\t\t\t\t//\n  1430\t\t\t\t\t// However, looking only at what the leader knows about its own\n  1431\t\t\t\t\t// log and the rejection hint, it is clear that a probe at index\n  1432\t\t\t\t\t// 6, 5, 4, 3, and 2 must fail as well:\n  1433\t\t\t\t\t//\n  1434\t\t\t\t\t// For all of these indexes, the leader's log term is larger than\n  1435\t\t\t\t\t// the rejection's log term. If a probe at one of these indexes\n  1436\t\t\t\t\t// succeeded, its log term at that index would match the leader's,\n  1437\t\t\t\t\t// i.e. 3 or 5 in this example. But the follower already told the\n  1438\t\t\t\t\t// leader that it is still at term 2 at index 6, and since the\n  1439\t\t\t\t\t// log term only ever goes up (within a log), this is a contradiction.\n  1440\t\t\t\t\t//\n  1441\t\t\t\t\t// At index 1, however, the leader can draw no such conclusion,\n  1442\t\t\t\t\t// as its term 1 is not larger than the term 2 from the\n  1443\t\t\t\t\t// follower's rejection. We thus probe at 1, which will succeed\n  1444\t\t\t\t\t// in this example. In general, with this approach we probe at\n  1445\t\t\t\t\t// most once per term found in the leader's log.\n  1446\t\t\t\t\t//\n  1447\t\t\t\t\t// There is a similar mechanism on the follower (implemented in\n  1448\t\t\t\t\t// handleAppendEntries via a call to findConflictByTerm) that is\n  1449\t\t\t\t\t// useful if the follower has a large divergent uncommitted log\n  1450\t\t\t\t\t// tail[1], as in this example:\n  1451\t\t\t\t\t//\n  1452\t\t\t\t\t//   idx        1 2 3 4 5 6 7 8 9\n  1453\t\t\t\t\t//              -----------------\n  1454\t\t\t\t\t//   term (L)   1 3 3 3 3 3 3 3 7\n  1455\t\t\t\t\t//   term (F)   1 3 3 4 4 5 5 5 6\n  1456\t\t\t\t\t//\n  1457\t\t\t\t\t// Naively, the leader would probe at idx=9, receive a rejection\n  1458\t\t\t\t\t// revealing the log term of 6 at the follower. Since the leader's\n  1459\t\t\t\t\t// term at the previous index is already smaller than 6, the leader-\n  1460\t\t\t\t\t// side optimization discussed above is ineffective. The leader thus\n  1461\t\t\t\t\t// probes at index 8 and, naively, receives a rejection for the same\n  1462\t\t\t\t\t// index and log term 5. Again, the leader optimization does not improve\n  1463\t\t\t\t\t// over linear probing as term 5 is above the leader's term 3 for that\n  1464\t\t\t\t\t// and many preceding indexes; the leader would have to probe linearly\n  1465\t\t\t\t\t// until it would finally hit index 3, where the probe would succeed.\n  1466\t\t\t\t\t//\n  1467\t\t\t\t\t// Instead, we apply a similar optimization on the follower. When the\n  1468\t\t\t\t\t// follower receives the probe at index 8 (log term 3), it concludes\n  1469\t\t\t\t\t// that all of the leader's log preceding that index has log terms of\n  1470\t\t\t\t\t// 3 or below. The largest index in the follower's log with a log term\n  1471\t\t\t\t\t// of 3 or below is index 3. The follower will thus return a rejection\n  1472\t\t\t\t\t// for index=3, log term=3 instead. The leader's next probe will then\n  1473\t\t\t\t\t// succeed at that index.\n  1474\t\t\t\t\t//\n  1475\t\t\t\t\t// [1]: more precisely, if the log terms in the large uncommitted\n  1476\t\t\t\t\t// tail on the follower are larger than the leader's. At first,\n  1477\t\t\t\t\t// it may seem unintuitive that a follower could even have such\n  1478\t\t\t\t\t// a large tail, but it can happen:\n  1479\t\t\t\t\t//\n  1480\t\t\t\t\t// 1. Leader appends (but does not commit) entries 2 and 3, crashes.\n  1481\t\t\t\t\t//   idx        1 2 3 4 5 6 7 8 9\n  1482\t\t\t\t\t//              -----------------\n  1483\t\t\t\t\t//   term (L)   1 2 2     [crashes]\n  1484\t\t\t\t\t//   term (F)   1\n  1485\t\t\t\t\t//   term (F)   1\n  1486\t\t\t\t\t//\n  1487\t\t\t\t\t// 2. a follower becomes leader and appends entries at term 3.\n  1488\t\t\t\t\t//              -----------------\n  1489\t\t\t\t\t//   term (x)   1 2 2     [down]\n  1490\t\t\t\t\t//   term (F)   1 3 3 3 3\n  1491\t\t\t\t\t//   term (F)   1\n  1492\t\t\t\t\t//\n  1493\t\t\t\t\t// 3. term 3 leader goes down, term 2 leader returns as term 4\n  1494\t\t\t\t\t//    leader. It commits the log & entries at term 4.\n  1495\t\t\t\t\t//\n  1496\t\t\t\t\t//              -----------------\n  1497\t\t\t\t\t//   term (L)   1 2 2 2\n  1498\t\t\t\t\t//   term (x)   1 3 3 3 3 [down]\n  1499\t\t\t\t\t//   term (F)   1\n  1500\t\t\t\t\t//              -----------------\n  1501\t\t\t\t\t//   term (L)   1 2 2 2 4 4 4\n  1502\t\t\t\t\t//   term (F)   1 3 3 3 3 [gets probed]\n  1503\t\t\t\t\t//   term (F)   1 2 2 2 4 4 4\n  1504\t\t\t\t\t//\n  1505\t\t\t\t\t// 4. the leader will now probe the returning follower at index\n  1506\t\t\t\t\t//    7, the rejection points it at the end of the follower's log\n  1507\t\t\t\t\t//    which is at a higher log term than the actually committed\n  1508\t\t\t\t\t//    log.\n  1509\t\t\t\t\tnextProbeIdx, _ = r.raftLog.findConflictByTerm(m.GetRejectHint(), m.GetLogTerm())\n  1510\t\t\t\t}\n  1511\t\t\t\tif pr.MaybeDecrTo(m.GetIndex(), nextProbeIdx) {\n  1512\t\t\t\t\tr.logger.Debugf(\"%x decreased progress of %x to [%s]\", r.id, m.GetFrom(), pr)\n  1513\t\t\t\t\tif pr.State == tracker.StateReplicate {\n  1514\t\t\t\t\t\tpr.BecomeProbe()\n  1515\t\t\t\t\t}\n  1516\t\t\t\t\tr.sendAppend(m.GetFrom())\n  1517\t\t\t\t}\n  1518\t\t\t} else {\n  1519\t\t\t\t// We want to update our tracking if the response updates our\n  1520\t\t\t\t// matched index or if the response can move a probing peer back\n  1521\t\t\t\t// into StateReplicate (see heartbeat_rep_recovers_from_probing.txt\n  1522\t\t\t\t// for an example of the latter case).\n  1523\t\t\t\t// NB: the same does not make sense for StateSnapshot - if `m.Index`\n  1524\t\t\t\t// equals pr.Match we know we don't m.Index+1 in our log, so moving\n  1525\t\t\t\t// back to replicating state is not useful; besides pr.PendingSnapshot\n  1526\t\t\t\t// would prevent it.\n  1527\t\t\t\tif pr.MaybeUpdate(m.GetIndex()) || (pr.Match == m.GetIndex() && pr.State == tracker.StateProbe) {\n  1528\t\t\t\t\tswitch {\n  1529\t\t\t\t\tcase pr.State == tracker.StateProbe:\n  1530\t\t\t\t\t\tpr.BecomeReplicate()\n  1531\t\t\t\t\tcase pr.State == tracker.StateSnapshot && pr.Match+1 >= r.raftLog.firstIndex():\n  1532\t\t\t\t\t\t// Note that we don't take into account PendingSnapshot to\n  1533\t\t\t\t\t\t// enter this branch. No matter at which index a snapshot\n  1534\t\t\t\t\t\t// was actually applied, as long as this allows catching up\n  1535\t\t\t\t\t\t// the follower from the log, we will accept it. This gives\n  1536\t\t\t\t\t\t// systems more flexibility in how they implement snapshots;\n  1537\t\t\t\t\t\t// see the comments on PendingSnapshot.\n  1538\t\t\t\t\t\tr.logger.Debugf(\"%x recovered from needing snapshot, resumed sending replication messages to %x [%s]\", r.id, m.GetFrom(), pr)\n  1539\t\t\t\t\t\t// Transition back to replicating state via probing state\n  1540\t\t\t\t\t\t// (which takes the snapshot into account). If we didn't\n  1541\t\t\t\t\t\t// move to replicating state, that would only happen with\n  1542\t\t\t\t\t\t// the next round of appends (but there may not be a next\n  1543\t\t\t\t\t\t// round for a while, exposing an inconsistent RaftStatus).\n  1544\t\t\t\t\t\tpr.BecomeProbe()\n  1545\t\t\t\t\t\tpr.BecomeReplicate()\n  1546\t\t\t\t\tcase pr.State == tracker.StateReplicate:\n  1547\t\t\t\t\t\tpr.Inflights.FreeLE(m.GetIndex())\n  1548\t\t\t\t\t}\n  1549\t\n  1550\t\t\t\t\tif r.maybeCommit() {\n  1551\t\t\t\t\t\t// committed index has progressed for the term, so it is safe\n  1552\t\t\t\t\t\t// to respond to pending read index requests\n  1553\t\t\t\t\t\treleasePendingReadIndexMessages(r)\n  1554\t\t\t\t\t\tr.bcastAppend()\n  1555\t\t\t\t\t} else if r.id != m.GetFrom() && pr.CanBumpCommit(r.raftLog.committed) {\n  1556\t\t\t\t\t\t// This node may be missing the latest commit index, so send it.\n  1557\t\t\t\t\t\t// NB: this is not strictly necessary because the periodic heartbeat\n  1558\t\t\t\t\t\t// messages deliver commit indices too. However, a message sent now\n  1559\t\t\t\t\t\t// may arrive earlier than the next heartbeat fires.\n  1560\t\t\t\t\t\tr.sendAppend(m.GetFrom())\n  1561\t\t\t\t\t}\n  1562\t\t\t\t\t// We've updated flow control information above, which may\n  1563\t\t\t\t\t// allow us to send multiple (size-limited) in-flight messages\n  1564\t\t\t\t\t// at once (such as when transitioning from probe to\n  1565\t\t\t\t\t// replicate, or when freeTo() covers multiple messages). If\n  1566\t\t\t\t\t// we have more entries to send, send as many messages as we\n  1567\t\t\t\t\t// can (without sending empty messages for the commit index)\n  1568\t\t\t\t\tif r.id != m.GetFrom() {\n  1569\t\t\t\t\t\tfor r.maybeSendAppend(m.GetFrom(), false /* sendIfEmpty */) {\n  1570\t\t\t\t\t\t}\n  1571\t\t\t\t\t}\n  1572\t\t\t\t\t// Transfer leadership is in progress.\n  1573\t\t\t\t\tif m.GetFrom() == r.leadTransferee && pr.Match == r.raftLog.lastIndex() {\n  1574\t\t\t\t\t\tr.logger.Infof(\"%x sent MsgTimeoutNow to %x after received MsgAppResp\", r.id, m.GetFrom())\n  1575\t\t\t\t\t\tr.sendTimeoutNow(m.GetFrom())\n  1576\t\t\t\t\t}\n  1577\t\t\t\t}\n  1578\t\t\t}\n  1579\t\tcase pb.MsgHeartbeatResp:\n  1580\t\t\tpr.RecentActive = true\n  1581\t\t\tpr.MsgAppFlowPaused = false\n  1582\t\n  1583\t\t\t// NB: if the follower is paused (full Inflights), this will still send an\n  1584\t\t\t// empty append, allowing it to recover from situations in which all the\n  1585\t\t\t// messages that filled up Inflights in the first place were dropped. Note\n  1586\t\t\t// also that the outgoing heartbeat already communicated the commit index.\n  1587\t\t\t//\n  1588\t\t\t// If the follower is fully caught up but also in StateProbe (as can happen\n  1589\t\t\t// if ReportUnreachable was called), we also want to send an append (it will\n  1590\t\t\t// be empty) to allow the follower to transition back to StateReplicate once\n  1591\t\t\t// it responds.\n  1592\t\t\t//\n  1593\t\t\t// Note that StateSnapshot typically satisfies pr.Match < lastIndex, but\n  1594\t\t\t// `pr.Paused()` is always true for StateSnapshot, so sendAppend is a\n  1595\t\t\t// no-op.\n  1596\t\t\tif pr.Match < r.raftLog.lastIndex() || pr.State == tracker.StateProbe {\n  1597\t\t\t\tr.sendAppend(m.GetFrom())\n  1598\t\t\t}\n  1599\t\n  1600\t\t\tif r.readOnly.option != ReadOnlySafe || len(m.GetContext()) == 0 {\n  1601\t\t\t\treturn nil\n  1602\t\t\t}\n  1603\t\n  1604\t\t\tr.readOnly.recvAck(m.GetFrom(), m.GetContext())\n  1605\t\t\trss := r.readOnly.maybeAdvance(r.trk.Voters)\n  1606\t\t\tfor _, rs := range rss {\n  1607\t\t\t\tif resp := r.responseToReadIndexReq(rs.req, rs.index); resp.GetTo() != None {\n  1608\t\t\t\t\tr.send(resp)\n  1609\t\t\t\t}\n  1610\t\t\t}\n  1611\t\tcase pb.MsgSnapStatus:\n  1612\t\t\tif pr.State != tracker.StateSnapshot {\n  1613\t\t\t\treturn nil\n  1614\t\t\t}\n  1615\t\t\tif !m.GetReject() {\n  1616\t\t\t\tpr.BecomeProbe()\n  1617\t\t\t\tr.logger.Debugf(\"%x snapshot succeeded, resumed sending replication messages to %x [%s]\", r.id, m.GetFrom(), pr)\n  1618\t\t\t} else {\n  1619\t\t\t\t// NB: the order here matters or we'll be probing erroneously from\n  1620\t\t\t\t// the snapshot index, but the snapshot never applied.\n  1621\t\t\t\tpr.PendingSnapshot = 0\n  1622\t\t\t\tpr.BecomeProbe()\n  1623\t\t\t\tr.logger.Debugf(\"%x snapshot failed, resumed sending replication messages to %x [%s]\", r.id, m.GetFrom(), pr)\n  1624\t\t\t}\n  1625\t\t\t// If snapshot finish, wait for the MsgAppResp from the remote node before sending\n  1626\t\t\t// out the next MsgApp.\n  1627\t\t\t// If snapshot failure, wait for a heartbeat interval before next try\n  1628\t\t\tpr.MsgAppFlowPaused = true\n  1629\t\tcase pb.MsgUnreachable:\n  1630\t\t\t// During optimistic replication, if the remote becomes unreachable,\n  1631\t\t\t// there is huge probability that a MsgApp is lost.\n  1632\t\t\tif pr.State == tracker.StateReplicate {\n  1633\t\t\t\tpr.BecomeProbe()\n  1634\t\t\t}\n  1635\t\t\tr.logger.Debugf(\"%x failed to send message to %x because it is unreachable [%s]\", r.id, m.GetFrom(), pr)\n  1636\t\tcase pb.MsgTransferLeader:\n  1637\t\t\tif pr.IsLearner {\n  1638\t\t\t\tr.logger.Debugf(\"%x is learner. Ignored transferring leadership\", r.id)\n  1639\t\t\t\treturn nil\n  1640\t\t\t}\n  1641\t\t\tleadTransferee := m.GetFrom()\n  1642\t\t\tlastLeadTransferee := r.leadTransferee\n  1643\t\t\tif lastLeadTransferee != None {\n  1644\t\t\t\tif lastLeadTransferee == leadTransferee {\n  1645\t\t\t\t\tr.logger.Infof(\"%x [term %d] transfer leadership to %x is in progress, ignores request to same node %x\",\n  1646\t\t\t\t\t\tr.id, r.Term, leadTransferee, leadTransferee)\n  1647\t\t\t\t\treturn nil\n  1648\t\t\t\t}\n  1649\t\t\t\tr.abortLeaderTransfer()\n  1650\t\t\t\tr.logger.Infof(\"%x [term %d] abort previous transferring leadership to %x\", r.id, r.Term, lastLeadTransferee)\n  1651\t\t\t}\n  1652\t\t\tif leadTransferee == r.id {\n  1653\t\t\t\tr.logger.Debugf(\"%x is already leader. Ignored transferring leadership to self\", r.id)\n  1654\t\t\t\treturn nil\n  1655\t\t\t}\n  1656\t\t\t// Transfer leadership to third party.\n  1657\t\t\tr.logger.Infof(\"%x [term %d] starts to transfer leadership to %x\", r.id, r.Term, leadTransferee)\n  1658\t\t\t// Transfer leadership should be finished in one electionTimeout, so reset r.electionElapsed.\n  1659\t\t\tr.electionElapsed = 0\n  1660\t\t\tr.leadTransferee = leadTransferee\n  1661\t\t\tif pr.Match == r.raftLog.lastIndex() {\n  1662\t\t\t\tr.sendTimeoutNow(leadTransferee)\n  1663\t\t\t\tr.logger.Infof(\"%x sends MsgTimeoutNow to %x immediately as %x already has up-to-date log\", r.id, leadTransferee, leadTransferee)\n  1664\t\t\t} else {\n  1665\t\t\t\tr.sendAppend(leadTransferee)\n  1666\t\t\t}\n  1667\t\t}\n  1668\t\treturn nil\n  1669\t}\n  1670\t\n  1671\t// stepCandidate is shared by StateCandidate and StatePreCandidate; the difference is\n  1672\t// whether they respond to MsgVoteResp or MsgPreVoteResp.\n  1673\tfunc stepCandidate(r *raft, m *pb.Message) error {\n  1674\t\t// Only handle vote responses corresponding to our candidacy (while in\n  1675\t\t// StateCandidate, we may get stale MsgPreVoteResp messages in this term from\n  1676\t\t// our pre-candidate state).\n  1677\t\tvar myVoteRespType pb.MessageType\n  1678\t\tif r.state == StatePreCandidate {\n  1679\t\t\tmyVoteRespType = pb.MsgPreVoteResp\n  1680\t\t} else {\n  1681\t\t\tmyVoteRespType = pb.MsgVoteResp\n  1682\t\t}\n  1683\t\tswitch m.GetType() {\n  1684\t\tcase pb.MsgProp:\n  1685\t\t\tr.logger.Infof(\"%x no leader at term %d; dropping proposal\", r.id, r.Term)\n  1686\t\t\treturn ErrProposalDropped\n  1687\t\tcase pb.MsgApp:\n  1688\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1689\t\t\tr.handleAppendEntries(m)\n  1690\t\tcase pb.MsgHeartbeat:\n  1691\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1692\t\t\tr.handleHeartbeat(m)\n  1693\t\tcase pb.MsgSnap:\n  1694\t\t\tr.becomeFollower(m.GetTerm(), m.GetFrom()) // always m.Term == r.Term\n  1695\t\t\tr.handleSnapshot(m)\n  1696\t\tcase myVoteRespType:\n  1697\t\t\tgr, rj, res := r.poll(m.GetFrom(), m.GetType(), !m.GetReject())\n  1698\t\t\tr.logger.Infof(\"%x has received %d %s votes and %d vote rejections\", r.id, gr, m.GetType(), rj)\n  1699\t\t\tswitch res {\n  1700\t\t\tcase quorum.VoteWon:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n tracker/progress.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n tracker/progress.go'","aggregated_output":"     1\t// Copyright 2019 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage tracker\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"slices\"\n    20\t\t\"strings\"\n    21\t)\n    22\t\n    23\t// Progress represents a follower’s progress in the view of the leader. Leader\n    24\t// maintains progresses of all followers, and sends entries to the follower\n    25\t// based on its progress.\n    26\t//\n    27\t// NB(tbg): Progress is basically a state machine whose transitions are mostly\n    28\t// strewn around `*raft.raft`. Additionally, some fields are only used when in a\n    29\t// certain State. All of this isn't ideal.\n    30\ttype Progress struct {\n    31\t\t// Match is the index up to which the follower's log is known to match the\n    32\t\t// leader's.\n    33\t\tMatch uint64\n    34\t\t// Next is the log index of the next entry to send to this follower. All\n    35\t\t// entries with indices in (Match, Next) interval are already in flight.\n    36\t\t//\n    37\t\t// Invariant: 0 <= Match < Next.\n    38\t\t// NB: it follows that Next >= 1.\n    39\t\t//\n    40\t\t// In StateSnapshot, Next == PendingSnapshot + 1.\n    41\t\tNext uint64\n    42\t\n    43\t\t// sentCommit is the highest commit index in flight to the follower.\n    44\t\t//\n    45\t\t// Generally, it is monotonic, but con regress in some cases, e.g. when\n    46\t\t// converting to `StateProbe` or when receiving a rejection from a follower.\n    47\t\t//\n    48\t\t// In StateSnapshot, sentCommit == PendingSnapshot == Next-1.\n    49\t\tsentCommit uint64\n    50\t\n    51\t\t// State defines how the leader should interact with the follower.\n    52\t\t//\n    53\t\t// When in StateProbe, leader sends at most one replication message\n    54\t\t// per heartbeat interval. It also probes actual progress of the follower.\n    55\t\t//\n    56\t\t// When in StateReplicate, leader optimistically increases next\n    57\t\t// to the latest entry sent after sending replication message. This is\n    58\t\t// an optimized state for fast replicating log entries to the follower.\n    59\t\t//\n    60\t\t// When in StateSnapshot, leader should have sent out snapshot\n    61\t\t// before and stops sending any replication message.\n    62\t\tState StateType\n    63\t\n    64\t\t// PendingSnapshot is used in StateSnapshot and tracks the last index of the\n    65\t\t// leader at the time at which it realized a snapshot was necessary. This\n    66\t\t// matches the index in the MsgSnap message emitted from raft.\n    67\t\t//\n    68\t\t// While there is a pending snapshot, replication to the follower is paused.\n    69\t\t// The follower will transition back to StateReplicate if the leader\n    70\t\t// receives an MsgAppResp from it that reconnects the follower to the\n    71\t\t// leader's log (such an MsgAppResp is emitted when the follower applies a\n    72\t\t// snapshot). It may be surprising that PendingSnapshot is not taken into\n    73\t\t// account here, but consider that complex systems may delegate the sending\n    74\t\t// of snapshots to alternative datasources (i.e. not the leader). In such\n    75\t\t// setups, it is difficult to manufacture a snapshot at a particular index\n    76\t\t// requested by raft and the actual index may be ahead or behind. This\n    77\t\t// should be okay, as long as the snapshot allows replication to resume.\n    78\t\t//\n    79\t\t// The follower will transition to StateProbe if ReportSnapshot is called on\n    80\t\t// the leader; if SnapshotFinish is passed then PendingSnapshot becomes the\n    81\t\t// basis for the next attempt to append. In practice, the first mechanism is\n    82\t\t// the one that is relevant in most cases. However, if this MsgAppResp is\n    83\t\t// lost (fallible network) then the second mechanism ensures that in this\n    84\t\t// case the follower does not erroneously remain in StateSnapshot.\n    85\t\tPendingSnapshot uint64\n    86\t\n    87\t\t// RecentActive is true if the progress is recently active. Receiving any messages\n    88\t\t// from the corresponding follower indicates the progress is active.\n    89\t\t// RecentActive can be reset to false after an election timeout.\n    90\t\t// This is always true on the leader.\n    91\t\tRecentActive bool\n    92\t\n    93\t\t// MsgAppFlowPaused is used when the MsgApp flow to a node is throttled. This\n    94\t\t// happens in StateProbe, or StateReplicate with saturated Inflights. In both\n    95\t\t// cases, we need to continue sending MsgApp once in a while to guarantee\n    96\t\t// progress, but we only do so when MsgAppFlowPaused is false (it is reset on\n    97\t\t// receiving a heartbeat response), to not overflow the receiver. See\n    98\t\t// IsPaused().\n    99\t\tMsgAppFlowPaused bool\n   100\t\n   101\t\t// Inflights is a sliding window for the inflight messages.\n   102\t\t// Each inflight message contains one or more log entries.\n   103\t\t// The max number of entries per message is defined in raft config as MaxSizePerMsg.\n   104\t\t// Thus inflight effectively limits both the number of inflight messages\n   105\t\t// and the bandwidth each Progress can use.\n   106\t\t// When inflights is Full, no more message should be sent.\n   107\t\t// When a leader sends out a message, the index of the last\n   108\t\t// entry should be added to inflights. The index MUST be added\n   109\t\t// into inflights in order.\n   110\t\t// When a leader receives a reply, the previous inflights should\n   111\t\t// be freed by calling inflights.FreeLE with the index of the last\n   112\t\t// received entry.\n   113\t\tInflights *Inflights\n   114\t\n   115\t\t// IsLearner is true if this progress is tracked for a learner.\n   116\t\tIsLearner bool\n   117\t}\n   118\t\n   119\t// ResetState moves the Progress into the specified State, resetting MsgAppFlowPaused,\n   120\t// PendingSnapshot, and Inflights.\n   121\tfunc (pr *Progress) ResetState(state StateType) {\n   122\t\tpr.MsgAppFlowPaused = false\n   123\t\tpr.PendingSnapshot = 0\n   124\t\tpr.State = state\n   125\t\tpr.Inflights.reset()\n   126\t}\n   127\t\n   128\t// BecomeProbe transitions into StateProbe. Next is reset to Match+1 or,\n   129\t// optionally and if larger, the index of the pending snapshot.\n   130\tfunc (pr *Progress) BecomeProbe() {\n   131\t\t// If the original state is StateSnapshot, progress knows that\n   132\t\t// the pending snapshot has been sent to this peer successfully, then\n   133\t\t// probes from pendingSnapshot + 1.\n   134\t\tif pr.State == StateSnapshot {\n   135\t\t\tpendingSnapshot := pr.PendingSnapshot\n   136\t\t\tpr.ResetState(StateProbe)\n   137\t\t\tpr.Next = max(pr.Match+1, pendingSnapshot+1)\n   138\t\t} else {\n   139\t\t\tpr.ResetState(StateProbe)\n   140\t\t\tpr.Next = pr.Match + 1\n   141\t\t}\n   142\t\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n   143\t}\n   144\t\n   145\t// BecomeReplicate transitions into StateReplicate, resetting Next to Match+1.\n   146\tfunc (pr *Progress) BecomeReplicate() {\n   147\t\tpr.ResetState(StateReplicate)\n   148\t\tpr.Next = pr.Match + 1\n   149\t}\n   150\t\n   151\t// BecomeSnapshot moves the Progress to StateSnapshot with the specified pending\n   152\t// snapshot index.\n   153\tfunc (pr *Progress) BecomeSnapshot(snapshoti uint64) {\n   154\t\tpr.ResetState(StateSnapshot)\n   155\t\tpr.PendingSnapshot = snapshoti\n   156\t\tpr.Next = snapshoti + 1\n   157\t\tpr.sentCommit = snapshoti\n   158\t}\n   159\t\n   160\t// SentEntries updates the progress on the given number of consecutive entries\n   161\t// being sent in a MsgApp, with the given total bytes size, appended at log\n   162\t// indices >= pr.Next.\n   163\t//\n   164\t// Must be used with StateProbe or StateReplicate.\n   165\tfunc (pr *Progress) SentEntries(entries int, bytes uint64) {\n   166\t\tswitch pr.State {\n   167\t\tcase StateReplicate:\n   168\t\t\tif entries > 0 {\n   169\t\t\t\tpr.Next += uint64(entries)\n   170\t\t\t\tpr.Inflights.Add(pr.Next-1, bytes)\n   171\t\t\t}\n   172\t\t\t// If this message overflows the in-flights tracker, or it was already full,\n   173\t\t\t// consider this message being a probe, so that the flow is paused.\n   174\t\t\tpr.MsgAppFlowPaused = pr.Inflights.Full()\n   175\t\tcase StateProbe:\n   176\t\t\t// TODO(pavelkalinnikov): this condition captures the previous behaviour,\n   177\t\t\t// but we should set MsgAppFlowPaused unconditionally for simplicity, because any\n   178\t\t\t// MsgApp in StateProbe is a probe, not only non-empty ones.\n   179\t\t\tif entries > 0 {\n   180\t\t\t\tpr.MsgAppFlowPaused = true\n   181\t\t\t}\n   182\t\tdefault:\n   183\t\t\tpanic(fmt.Sprintf(\"sending append in unhandled state %s\", pr.State))\n   184\t\t}\n   185\t}\n   186\t\n   187\t// CanBumpCommit returns true if sending the given commit index can potentially\n   188\t// advance the follower's commit index.\n   189\tfunc (pr *Progress) CanBumpCommit(index uint64) bool {\n   190\t\t// Sending the given commit index may bump the follower's commit index up to\n   191\t\t// Next-1 in normal operation, or higher in some rare cases. Allow sending a\n   192\t\t// commit index eagerly only if we haven't already sent one that bumps the\n   193\t\t// follower's commit all the way to Next-1.\n   194\t\treturn index > pr.sentCommit && pr.sentCommit < pr.Next-1\n   195\t}\n   196\t\n   197\t// SentCommit updates the sentCommit.\n   198\tfunc (pr *Progress) SentCommit(commit uint64) {\n   199\t\tpr.sentCommit = commit\n   200\t}\n   201\t\n   202\t// MaybeUpdate is called when an MsgAppResp arrives from the follower, with the\n   203\t// index acked by it. The method returns false if the given n index comes from\n   204\t// an outdated message. Otherwise it updates the progress and returns true.\n   205\tfunc (pr *Progress) MaybeUpdate(n uint64) bool {\n   206\t\tif n <= pr.Match {\n   207\t\t\treturn false\n   208\t\t}\n   209\t\tpr.Match = n\n   210\t\tpr.Next = max(pr.Next, n+1) // invariant: Match < Next\n   211\t\tpr.MsgAppFlowPaused = false\n   212\t\treturn true\n   213\t}\n   214\t\n   215\t// MaybeDecrTo adjusts the Progress to the receipt of a MsgApp rejection. The\n   216\t// arguments are the index of the append message rejected by the follower, and\n   217\t// the hint that we want to decrease to.\n   218\t//\n   219\t// Rejections can happen spuriously as messages are sent out of order or\n   220\t// duplicated. In such cases, the rejection pertains to an index that the\n   221\t// Progress already knows were previously acknowledged, and false is returned\n   222\t// without changing the Progress.\n   223\t//\n   224\t// If the rejection is genuine, Next is lowered sensibly, and the Progress is\n   225\t// cleared for sending log entries.\n   226\tfunc (pr *Progress) MaybeDecrTo(rejected, matchHint uint64) bool {\n   227\t\tif pr.State == StateReplicate {\n   228\t\t\t// The rejection must be stale if the progress has matched and \"rejected\"\n   229\t\t\t// is smaller than \"match\".\n   230\t\t\tif rejected <= pr.Match {\n   231\t\t\t\treturn false\n   232\t\t\t}\n   233\t\t\t// Directly decrease next to match + 1.\n   234\t\t\t//\n   235\t\t\t// TODO(tbg): why not use matchHint if it's larger?\n   236\t\t\tpr.Next = pr.Match + 1\n   237\t\t\t// Regress the sentCommit since it unlikely has been applied.\n   238\t\t\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n   239\t\t\treturn true\n   240\t\t}\n   241\t\n   242\t\t// The rejection must be stale if \"rejected\" does not match next - 1. This\n   243\t\t// is because non-replicating followers are probed one entry at a time.\n   244\t\t// The check is a best effort assuming message reordering is rare.\n   245\t\tif pr.Next-1 != rejected {\n   246\t\t\treturn false\n   247\t\t}\n   248\t\n   249\t\tpr.Next = max(min(rejected, matchHint+1), pr.Match+1)\n   250\t\t// Regress the sentCommit since it unlikely has been applied.\n   251\t\tpr.sentCommit = min(pr.sentCommit, pr.Next-1)\n   252\t\tpr.MsgAppFlowPaused = false\n   253\t\treturn true\n   254\t}\n   255\t\n   256\t// IsPaused returns whether sending log entries to this node has been throttled.\n   257\t// This is done when a node has rejected recent MsgApps, is currently waiting\n   258\t// for a snapshot, or has reached the MaxInflightMsgs limit. In normal\n   259\t// operation, this is false. A throttled node will be contacted less frequently\n   260\t// until it has reached a state in which it's able to accept a steady stream of\n   261\t// log entries again.\n   262\tfunc (pr *Progress) IsPaused() bool {\n   263\t\tswitch pr.State {\n   264\t\tcase StateProbe:\n   265\t\t\treturn pr.MsgAppFlowPaused\n   266\t\tcase StateReplicate:\n   267\t\t\treturn pr.MsgAppFlowPaused\n   268\t\tcase StateSnapshot:\n   269\t\t\treturn true\n   270\t\tdefault:\n   271\t\t\tpanic(\"unexpected state\")\n   272\t\t}\n   273\t}\n   274\t\n   275\tfunc (pr *Progress) String() string {\n   276\t\tvar buf strings.Builder\n   277\t\tfmt.Fprintf(&buf, \"%s match=%d next=%d\", pr.State, pr.Match, pr.Next)\n   278\t\tif pr.IsLearner {\n   279\t\t\tfmt.Fprint(&buf, \" learner\")\n   280\t\t}\n   281\t\tif pr.IsPaused() {\n   282\t\t\tfmt.Fprint(&buf, \" paused\")\n   283\t\t}\n   284\t\tif pr.PendingSnapshot > 0 {\n   285\t\t\tfmt.Fprintf(&buf, \" pendingSnap=%d\", pr.PendingSnapshot)\n   286\t\t}\n   287\t\tif !pr.RecentActive {\n   288\t\t\tfmt.Fprint(&buf, \" inactive\")\n   289\t\t}\n   290\t\tif n := pr.Inflights.Count(); n > 0 {\n   291\t\t\tfmt.Fprintf(&buf, \" inflight=%d\", n)\n   292\t\t\tif pr.Inflights.Full() {\n   293\t\t\t\tfmt.Fprint(&buf, \"[full]\")\n   294\t\t\t}\n   295\t\t}\n   296\t\treturn buf.String()\n   297\t}\n   298\t\n   299\t// ProgressMap is a map of *Progress.\n   300\ttype ProgressMap map[uint64]*Progress\n   301\t\n   302\t// String prints the ProgressMap in sorted key order, one Progress per line.\n   303\tfunc (m ProgressMap) String() string {\n   304\t\tids := make([]uint64, 0, len(m))\n   305\t\tfor k := range m {\n   306\t\t\tids = append(ids, k)\n   307\t\t}\n   308\t\tslices.Sort(ids)\n   309\t\tvar buf strings.Builder\n   310\t\tfor _, id := range ids {\n   311\t\t\tfmt.Fprintf(&buf, \"%d: %s\\n\", id, m[id])\n   312\t\t}\n   313\t\treturn buf.String()\n   314\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n log.go | sed -n '1,200p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n log.go | sed -n '1,200p'\"","aggregated_output":"     1\t// Copyright 2015 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage raft\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\n    20\t\t\"google.golang.org/protobuf/proto\"\n    21\t\n    22\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    23\t)\n    24\t\n    25\ttype raftLog struct {\n    26\t\t// storage contains all stable entries since the last snapshot.\n    27\t\tstorage Storage\n    28\t\n    29\t\t// unstable contains all unstable entries and snapshot.\n    30\t\t// they will be saved into storage.\n    31\t\tunstable unstable\n    32\t\n    33\t\t// committed is the highest log position that is known to be in\n    34\t\t// stable storage on a quorum of nodes.\n    35\t\tcommitted uint64\n    36\t\t// applying is the highest log position that the application has\n    37\t\t// been instructed to apply to its state machine. Some of these\n    38\t\t// entries may be in the process of applying and have not yet\n    39\t\t// reached applied.\n    40\t\t// Use: The field is incremented when accepting a Ready struct.\n    41\t\t// Invariant: applied <= applying && applying <= committed\n    42\t\tapplying uint64\n    43\t\t// applied is the highest log position that the application has\n    44\t\t// successfully applied to its state machine.\n    45\t\t// Use: The field is incremented when advancing after the committed\n    46\t\t// entries in a Ready struct have been applied (either synchronously\n    47\t\t// or asynchronously).\n    48\t\t// Invariant: applied <= committed\n    49\t\tapplied uint64\n    50\t\n    51\t\tlogger Logger\n    52\t\n    53\t\t// maxApplyingEntsSize limits the outstanding byte size of the messages\n    54\t\t// returned from calls to nextCommittedEnts that have not been acknowledged\n    55\t\t// by a call to appliedTo.\n    56\t\tmaxApplyingEntsSize entryEncodingSize\n    57\t\t// applyingEntsSize is the current outstanding byte size of the messages\n    58\t\t// returned from calls to nextCommittedEnts that have not been acknowledged\n    59\t\t// by a call to appliedTo.\n    60\t\tapplyingEntsSize entryEncodingSize\n    61\t\t// applyingEntsPaused is true when entry application has been paused until\n    62\t\t// enough progress is acknowledged.\n    63\t\tapplyingEntsPaused bool\n    64\t}\n    65\t\n    66\t// newLog returns log using the given storage and default options. It\n    67\t// recovers the log to the state that it just commits and applies the\n    68\t// latest snapshot.\n    69\tfunc newLog(storage Storage, logger Logger) *raftLog {\n    70\t\treturn newLogWithSize(storage, logger, noLimit)\n    71\t}\n    72\t\n    73\t// newLogWithSize returns a log using the given storage and max\n    74\t// message size.\n    75\tfunc newLogWithSize(storage Storage, logger Logger, maxApplyingEntsSize entryEncodingSize) *raftLog {\n    76\t\tfirstIndex, err := storage.FirstIndex()\n    77\t\tif err != nil {\n    78\t\t\tpanic(err) // TODO(bdarnell)\n    79\t\t}\n    80\t\tlastIndex, err := storage.LastIndex()\n    81\t\tif err != nil {\n    82\t\t\tpanic(err) // TODO(bdarnell)\n    83\t\t}\n    84\t\treturn &raftLog{\n    85\t\t\tstorage: storage,\n    86\t\t\tunstable: unstable{\n    87\t\t\t\toffset:           lastIndex + 1,\n    88\t\t\t\toffsetInProgress: lastIndex + 1,\n    89\t\t\t\tlogger:           logger,\n    90\t\t\t},\n    91\t\t\tmaxApplyingEntsSize: maxApplyingEntsSize,\n    92\t\n    93\t\t\t// Initialize our committed and applied pointers to the time of the last compaction.\n    94\t\t\tcommitted: firstIndex - 1,\n    95\t\t\tapplying:  firstIndex - 1,\n    96\t\t\tapplied:   firstIndex - 1,\n    97\t\n    98\t\t\tlogger: logger,\n    99\t\t}\n   100\t}\n   101\t\n   102\tfunc (l *raftLog) String() string {\n   103\t\treturn fmt.Sprintf(\"committed=%d, applied=%d, applying=%d, unstable.offset=%d, unstable.offsetInProgress=%d, len(unstable.Entries)=%d\",\n   104\t\t\tl.committed, l.applied, l.applying, l.unstable.offset, l.unstable.offsetInProgress, len(l.unstable.entries))\n   105\t}\n   106\t\n   107\t// maybeAppend returns (0, false) if the entries cannot be appended. Otherwise,\n   108\t// it returns (last index of new entries, true).\n   109\tfunc (l *raftLog) maybeAppend(a logSlice, committed uint64) (lastnewi uint64, ok bool) {\n   110\t\tif !l.matchTerm(a.prev) {\n   111\t\t\treturn 0, false\n   112\t\t}\n   113\t\t// TODO(pav-kv): propagate logSlice down the stack. It will be used all the\n   114\t\t// way down in unstable, for safety checks, and for useful bookkeeping.\n   115\t\n   116\t\tlastnewi = a.prev.index + uint64(len(a.entries))\n   117\t\tci := l.findConflict(a.entries)\n   118\t\tswitch {\n   119\t\tcase ci == 0:\n   120\t\tcase ci <= l.committed:\n   121\t\t\tl.logger.Panicf(\"entry %d conflict with committed entry [committed(%d)]\", ci, l.committed)\n   122\t\tdefault:\n   123\t\t\toffset := a.prev.index + 1\n   124\t\t\tif ci-offset > uint64(len(a.entries)) {\n   125\t\t\t\tl.logger.Panicf(\"index, %d, is out of range [%d]\", ci-offset, len(a.entries))\n   126\t\t\t}\n   127\t\t\tl.append(a.entries[ci-offset:]...)\n   128\t\t}\n   129\t\tl.commitTo(min(committed, lastnewi))\n   130\t\treturn lastnewi, true\n   131\t}\n   132\t\n   133\tfunc (l *raftLog) append(ents ...*pb.Entry) uint64 {\n   134\t\tif len(ents) == 0 {\n   135\t\t\treturn l.lastIndex()\n   136\t\t}\n   137\t\tif after := ents[0].GetIndex() - 1; after < l.committed {\n   138\t\t\tl.logger.Panicf(\"after(%d) is out of range [committed(%d)]\", after, l.committed)\n   139\t\t}\n   140\t\tl.unstable.truncateAndAppend(ents)\n   141\t\treturn l.lastIndex()\n   142\t}\n   143\t\n   144\t// findConflict finds the index of the conflict.\n   145\t// It returns the first pair of conflicting entries between the existing\n   146\t// entries and the given entries, if there are any.\n   147\t// If there is no conflicting entries, and the existing entries contains\n   148\t// all the given entries, zero will be returned.\n   149\t// If there is no conflicting entries, but the given entries contains new\n   150\t// entries, the index of the first new entry will be returned.\n   151\t// An entry is considered to be conflicting if it has the same index but\n   152\t// a different term.\n   153\t// The index of the given entries MUST be continuously increasing.\n   154\tfunc (l *raftLog) findConflict(ents []*pb.Entry) uint64 {\n   155\t\tfor i := range ents {\n   156\t\t\tif id := pbEntryID(ents[i]); !l.matchTerm(id) {\n   157\t\t\t\tif id.index <= l.lastIndex() {\n   158\t\t\t\t\t// TODO(pav-kv): can simply print %+v of the id. This will change the\n   159\t\t\t\t\t// log format though.\n   160\t\t\t\t\tl.logger.Infof(\"found conflict at index %d [existing term: %d, conflicting term: %d]\",\n   161\t\t\t\t\t\tid.index, l.zeroTermOnOutOfBounds(l.term(id.index)), id.term)\n   162\t\t\t\t}\n   163\t\t\t\treturn id.index\n   164\t\t\t}\n   165\t\t}\n   166\t\treturn 0\n   167\t}\n   168\t\n   169\t// findConflictByTerm returns a best guess on where this log ends matching\n   170\t// another log, given that the only information known about the other log is the\n   171\t// (index, term) of its single entry.\n   172\t//\n   173\t// Specifically, the first returned value is the max guessIndex <= index, such\n   174\t// that term(guessIndex) <= term or term(guessIndex) is not known (because this\n   175\t// index is compacted or not yet stored).\n   176\t//\n   177\t// The second returned value is the term(guessIndex), or 0 if it is unknown.\n   178\t//\n   179\t// This function is used by a follower and leader to resolve log conflicts after\n   180\t// an unsuccessful append to a follower, and ultimately restore the steady flow\n   181\t// of appends.\n   182\tfunc (l *raftLog) findConflictByTerm(index uint64, term uint64) (uint64, uint64) {\n   183\t\tfor ; index > 0; index-- {\n   184\t\t\t// If there is an error (likely ErrCompacted or ErrUnavailable), we don't\n   185\t\t\t// know whether it's a match or not, so assume a possible match and return\n   186\t\t\t// the index, with 0 term indicating an unknown term.\n   187\t\t\tif ourTerm, err := l.term(index); err != nil {\n   188\t\t\t\treturn index, 0\n   189\t\t\t} else if ourTerm <= term {\n   190\t\t\t\treturn index, ourTerm\n   191\t\t\t}\n   192\t\t}\n   193\t\treturn 0, 0\n   194\t}\n   195\t\n   196\t// nextUnstableEnts returns all entries that are available to be written to the\n   197\t// local stable log and are not already in-progress.\n   198\tfunc (l *raftLog) nextUnstableEnts() []*pb.Entry {\n   199\t\treturn l.unstable.nextEntries()\n   200\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '200,576p' log.go | nl -ba -v200\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && sed -n '200,576p' log.go | nl -ba -v200\"","aggregated_output":"   200\t}\n   201\t\n   202\t// hasNextUnstableEnts returns if there are any entries that are available to be\n   203\t// written to the local stable log and are not already in-progress.\n   204\tfunc (l *raftLog) hasNextUnstableEnts() bool {\n   205\t\treturn len(l.nextUnstableEnts()) > 0\n   206\t}\n   207\t\n   208\t// hasNextOrInProgressUnstableEnts returns if there are any entries that are\n   209\t// available to be written to the local stable log or in the process of being\n   210\t// written to the local stable log.\n   211\tfunc (l *raftLog) hasNextOrInProgressUnstableEnts() bool {\n   212\t\treturn len(l.unstable.entries) > 0\n   213\t}\n   214\t\n   215\t// nextCommittedEnts returns all the available entries for execution.\n   216\t// Entries can be committed even when the local raft instance has not durably\n   217\t// appended them to the local raft log yet. If allowUnstable is true, committed\n   218\t// entries from the unstable log may be returned; otherwise, only entries known\n   219\t// to reside locally on stable storage will be returned.\n   220\tfunc (l *raftLog) nextCommittedEnts(allowUnstable bool) (ents []*pb.Entry) {\n   221\t\tif l.applyingEntsPaused {\n   222\t\t\t// Entry application outstanding size limit reached.\n   223\t\t\treturn nil\n   224\t\t}\n   225\t\tif l.hasNextOrInProgressSnapshot() {\n   226\t\t\t// See comment in hasNextCommittedEnts.\n   227\t\t\treturn nil\n   228\t\t}\n   229\t\tlo, hi := l.applying+1, l.maxAppliableIndex(allowUnstable)+1 // [lo, hi)\n   230\t\tif lo >= hi {\n   231\t\t\t// Nothing to apply.\n   232\t\t\treturn nil\n   233\t\t}\n   234\t\tmaxSize := l.maxApplyingEntsSize - l.applyingEntsSize\n   235\t\tif maxSize <= 0 {\n   236\t\t\tl.logger.Panicf(\"applying entry size (%d-%d)=%d not positive\",\n   237\t\t\t\tl.maxApplyingEntsSize, l.applyingEntsSize, maxSize)\n   238\t\t}\n   239\t\tents, err := l.slice(lo, hi, maxSize)\n   240\t\tif err != nil {\n   241\t\t\tl.logger.Panicf(\"unexpected error when getting unapplied entries (%v)\", err)\n   242\t\t}\n   243\t\treturn ents\n   244\t}\n   245\t\n   246\t// hasNextCommittedEnts returns if there is any available entries for execution.\n   247\t// This is a fast check without heavy raftLog.slice() in nextCommittedEnts().\n   248\tfunc (l *raftLog) hasNextCommittedEnts(allowUnstable bool) bool {\n   249\t\tif l.applyingEntsPaused {\n   250\t\t\t// Entry application outstanding size limit reached.\n   251\t\t\treturn false\n   252\t\t}\n   253\t\tif l.hasNextOrInProgressSnapshot() {\n   254\t\t\t// If we have a snapshot to apply, don't also return any committed\n   255\t\t\t// entries. Doing so raises questions about what should be applied\n   256\t\t\t// first.\n   257\t\t\treturn false\n   258\t\t}\n   259\t\tlo, hi := l.applying+1, l.maxAppliableIndex(allowUnstable)+1 // [lo, hi)\n   260\t\treturn lo < hi\n   261\t}\n   262\t\n   263\t// maxAppliableIndex returns the maximum committed index that can be applied.\n   264\t// If allowUnstable is true, committed entries from the unstable log can be\n   265\t// applied; otherwise, only entries known to reside locally on stable storage\n   266\t// can be applied.\n   267\tfunc (l *raftLog) maxAppliableIndex(allowUnstable bool) uint64 {\n   268\t\thi := l.committed\n   269\t\tif !allowUnstable {\n   270\t\t\thi = min(hi, l.unstable.offset-1)\n   271\t\t}\n   272\t\treturn hi\n   273\t}\n   274\t\n   275\t// nextUnstableSnapshot returns the snapshot, if present, that is available to\n   276\t// be applied to the local storage and is not already in-progress.\n   277\tfunc (l *raftLog) nextUnstableSnapshot() *pb.Snapshot {\n   278\t\treturn l.unstable.nextSnapshot()\n   279\t}\n   280\t\n   281\t// hasNextUnstableSnapshot returns if there is a snapshot that is available to\n   282\t// be applied to the local storage and is not already in-progress.\n   283\tfunc (l *raftLog) hasNextUnstableSnapshot() bool {\n   284\t\treturn l.unstable.nextSnapshot() != nil\n   285\t}\n   286\t\n   287\t// hasNextOrInProgressSnapshot returns if there is pending snapshot waiting for\n   288\t// applying or in the process of being applied.\n   289\tfunc (l *raftLog) hasNextOrInProgressSnapshot() bool {\n   290\t\treturn l.unstable.snapshot != nil\n   291\t}\n   292\t\n   293\tfunc (l *raftLog) snapshot() (*pb.Snapshot, error) {\n   294\t\tif l.unstable.snapshot != nil {\n   295\t\t\treturn proto.Clone(l.unstable.snapshot).(*pb.Snapshot), nil\n   296\t\t}\n   297\t\treturn l.storage.Snapshot()\n   298\t}\n   299\t\n   300\tfunc (l *raftLog) firstIndex() uint64 {\n   301\t\tif i, ok := l.unstable.maybeFirstIndex(); ok {\n   302\t\t\treturn i\n   303\t\t}\n   304\t\tindex, err := l.storage.FirstIndex()\n   305\t\tif err != nil {\n   306\t\t\tpanic(err) // TODO(bdarnell)\n   307\t\t}\n   308\t\treturn index\n   309\t}\n   310\t\n   311\tfunc (l *raftLog) lastIndex() uint64 {\n   312\t\tif i, ok := l.unstable.maybeLastIndex(); ok {\n   313\t\t\treturn i\n   314\t\t}\n   315\t\ti, err := l.storage.LastIndex()\n   316\t\tif err != nil {\n   317\t\t\tpanic(err) // TODO(bdarnell)\n   318\t\t}\n   319\t\treturn i\n   320\t}\n   321\t\n   322\tfunc (l *raftLog) commitTo(tocommit uint64) {\n   323\t\t// never decrease commit\n   324\t\tif l.committed < tocommit {\n   325\t\t\tif l.lastIndex() < tocommit {\n   326\t\t\t\tl.logger.Panicf(\"tocommit(%d) is out of range [lastIndex(%d)]. Was the raft log corrupted, truncated, or lost?\", tocommit, l.lastIndex())\n   327\t\t\t}\n   328\t\t\tl.committed = tocommit\n   329\t\t}\n   330\t}\n   331\t\n   332\tfunc (l *raftLog) appliedTo(i uint64, size entryEncodingSize) {\n   333\t\tif l.committed < i || i < l.applied {\n   334\t\t\tl.logger.Panicf(\"applied(%d) is out of range [prevApplied(%d), committed(%d)]\", i, l.applied, l.committed)\n   335\t\t}\n   336\t\tl.applied = i\n   337\t\tl.applying = max(l.applying, i)\n   338\t\tif l.applyingEntsSize > size {\n   339\t\t\tl.applyingEntsSize -= size\n   340\t\t} else {\n   341\t\t\t// Defense against underflow.\n   342\t\t\tl.applyingEntsSize = 0\n   343\t\t}\n   344\t\tl.applyingEntsPaused = l.applyingEntsSize >= l.maxApplyingEntsSize\n   345\t}\n   346\t\n   347\tfunc (l *raftLog) acceptApplying(i uint64, size entryEncodingSize, allowUnstable bool) {\n   348\t\tif l.committed < i {\n   349\t\t\tl.logger.Panicf(\"applying(%d) is out of range [prevApplying(%d), committed(%d)]\", i, l.applying, l.committed)\n   350\t\t}\n   351\t\tl.applying = i\n   352\t\tl.applyingEntsSize += size\n   353\t\t// Determine whether to pause entry application until some progress is\n   354\t\t// acknowledged. We pause in two cases:\n   355\t\t// 1. the outstanding entry size equals or exceeds the maximum size.\n   356\t\t// 2. the outstanding entry size does not equal or exceed the maximum size,\n   357\t\t//    but we determine that the next entry in the log will push us over the\n   358\t\t//    limit. We determine this by comparing the last entry returned from\n   359\t\t//    raftLog.nextCommittedEnts to the maximum entry that the method was\n   360\t\t//    allowed to return had there been no size limit. If these indexes are\n   361\t\t//    not equal, then the returned entries slice must have been truncated to\n   362\t\t//    adhere to the memory limit.\n   363\t\tl.applyingEntsPaused = l.applyingEntsSize >= l.maxApplyingEntsSize ||\n   364\t\t\ti < l.maxAppliableIndex(allowUnstable)\n   365\t}\n   366\t\n   367\tfunc (l *raftLog) stableTo(id entryID) { l.unstable.stableTo(id) }\n   368\t\n   369\tfunc (l *raftLog) stableSnapTo(i uint64) { l.unstable.stableSnapTo(i) }\n   370\t\n   371\t// acceptUnstable indicates that the application has started persisting the\n   372\t// unstable entries in storage, and that the current unstable entries are thus\n   373\t// to be marked as being in-progress, to avoid returning them with future calls\n   374\t// to Ready().\n   375\tfunc (l *raftLog) acceptUnstable() { l.unstable.acceptInProgress() }\n   376\t\n   377\t// lastEntryID returns the ID of the last entry in the log.\n   378\tfunc (l *raftLog) lastEntryID() entryID {\n   379\t\tindex := l.lastIndex()\n   380\t\tt, err := l.term(index)\n   381\t\tif err != nil {\n   382\t\t\tl.logger.Panicf(\"unexpected error when getting the last term at %d: %v\", index, err)\n   383\t\t}\n   384\t\treturn entryID{term: t, index: index}\n   385\t}\n   386\t\n   387\tfunc (l *raftLog) term(i uint64) (uint64, error) {\n   388\t\t// Check the unstable log first, even before computing the valid term range,\n   389\t\t// which may need to access stable Storage. If we find the entry's term in\n   390\t\t// the unstable log, we know it was in the valid range.\n   391\t\tif t, ok := l.unstable.maybeTerm(i); ok {\n   392\t\t\treturn t, nil\n   393\t\t}\n   394\t\n   395\t\t// The valid term range is [firstIndex-1, lastIndex]. Even though the entry at\n   396\t\t// firstIndex-1 is compacted away, its term is available for matching purposes\n   397\t\t// when doing log appends.\n   398\t\tif i+1 < l.firstIndex() {\n   399\t\t\treturn 0, ErrCompacted\n   400\t\t}\n   401\t\tif i > l.lastIndex() {\n   402\t\t\treturn 0, ErrUnavailable\n   403\t\t}\n   404\t\n   405\t\tt, err := l.storage.Term(i)\n   406\t\tif err == nil {\n   407\t\t\treturn t, nil\n   408\t\t}\n   409\t\tif err == ErrCompacted || err == ErrUnavailable {\n   410\t\t\treturn 0, err\n   411\t\t}\n   412\t\tpanic(err) // TODO(bdarnell)\n   413\t}\n   414\t\n   415\tfunc (l *raftLog) entries(i uint64, maxSize entryEncodingSize) ([]*pb.Entry, error) {\n   416\t\tif i > l.lastIndex() {\n   417\t\t\treturn nil, nil\n   418\t\t}\n   419\t\treturn l.slice(i, l.lastIndex()+1, maxSize)\n   420\t}\n   421\t\n   422\t// allEntries returns all entries in the log.\n   423\tfunc (l *raftLog) allEntries() []*pb.Entry {\n   424\t\tents, err := l.entries(l.firstIndex(), noLimit)\n   425\t\tif err == nil {\n   426\t\t\treturn ents\n   427\t\t}\n   428\t\tif err == ErrCompacted { // try again if there was a racing compaction\n   429\t\t\treturn l.allEntries()\n   430\t\t}\n   431\t\t// TODO (xiangli): handle error?\n   432\t\tpanic(err)\n   433\t}\n   434\t\n   435\t// isUpToDate determines if a log with the given last entry is more up-to-date\n   436\t// by comparing the index and term of the last entries in the existing logs.\n   437\t//\n   438\t// If the logs have last entries with different terms, then the log with the\n   439\t// later term is more up-to-date. If the logs end with the same term, then\n   440\t// whichever log has the larger lastIndex is more up-to-date. If the logs are\n   441\t// the same, the given log is up-to-date.\n   442\tfunc (l *raftLog) isUpToDate(their entryID) bool {\n   443\t\tour := l.lastEntryID()\n   444\t\treturn their.term > our.term || their.term == our.term && their.index >= our.index\n   445\t}\n   446\t\n   447\tfunc (l *raftLog) matchTerm(id entryID) bool {\n   448\t\tt, err := l.term(id.index)\n   449\t\tif err != nil {\n   450\t\t\treturn false\n   451\t\t}\n   452\t\treturn t == id.term\n   453\t}\n   454\t\n   455\tfunc (l *raftLog) maybeCommit(at entryID) bool {\n   456\t\t// NB: term should never be 0 on a commit because the leader campaigned at\n   457\t\t// least at term 1. But if it is 0 for some reason, we don't consider this a\n   458\t\t// term match.\n   459\t\tif at.term != 0 && at.index > l.committed && l.matchTerm(at) {\n   460\t\t\tl.commitTo(at.index)\n   461\t\t\treturn true\n   462\t\t}\n   463\t\treturn false\n   464\t}\n   465\t\n   466\tfunc (l *raftLog) restore(s *pb.Snapshot) {\n   467\t\tl.logger.Infof(\"log [%s] starts to restore snapshot [index: %d, term: %d]\", l, s.GetMetadata().GetIndex(), s.GetMetadata().GetTerm())\n   468\t\tl.committed = s.GetMetadata().GetIndex()\n   469\t\tl.unstable.restore(s)\n   470\t}\n   471\t\n   472\t// scan visits all log entries in the [lo, hi) range, returning them via the\n   473\t// given callback. The callback can be invoked multiple times, with consecutive\n   474\t// sub-ranges of the requested range. Returns up to pageSize bytes worth of\n   475\t// entries at a time. May return more if a single entry size exceeds the limit.\n   476\t//\n   477\t// The entries in [lo, hi) must exist, otherwise scan() eventually returns an\n   478\t// error (possibly after passing some entries through the callback).\n   479\t//\n   480\t// If the callback returns an error, scan terminates and returns this error\n   481\t// immediately. This can be used to stop the scan early (\"break\" the loop).\n   482\tfunc (l *raftLog) scan(lo, hi uint64, pageSize entryEncodingSize, v func([]*pb.Entry) error) error {\n   483\t\tfor lo < hi {\n   484\t\t\tents, err := l.slice(lo, hi, pageSize)\n   485\t\t\tif err != nil {\n   486\t\t\t\treturn err\n   487\t\t\t} else if len(ents) == 0 {\n   488\t\t\t\treturn fmt.Errorf(\"got 0 entries in [%d, %d)\", lo, hi)\n   489\t\t\t}\n   490\t\t\tif err := v(ents); err != nil {\n   491\t\t\t\treturn err\n   492\t\t\t}\n   493\t\t\tlo += uint64(len(ents))\n   494\t\t}\n   495\t\treturn nil\n   496\t}\n   497\t\n   498\t// slice returns a slice of log entries from lo through hi-1, inclusive.\n   499\tfunc (l *raftLog) slice(lo, hi uint64, maxSize entryEncodingSize) ([]*pb.Entry, error) {\n   500\t\tif err := l.mustCheckOutOfBounds(lo, hi); err != nil {\n   501\t\t\treturn nil, err\n   502\t\t}\n   503\t\tif lo == hi {\n   504\t\t\treturn nil, nil\n   505\t\t}\n   506\t\tif lo >= l.unstable.offset {\n   507\t\t\tents := limitSize(l.unstable.slice(lo, hi), maxSize)\n   508\t\t\t// NB: use the full slice expression to protect the unstable slice from\n   509\t\t\t// appends to the returned ents slice.\n   510\t\t\treturn ents[:len(ents):len(ents)], nil\n   511\t\t}\n   512\t\n   513\t\tcut := min(hi, l.unstable.offset)\n   514\t\tents, err := l.storage.Entries(lo, cut, uint64(maxSize))\n   515\t\tif err == ErrCompacted {\n   516\t\t\treturn nil, err\n   517\t\t} else if err == ErrUnavailable {\n   518\t\t\tl.logger.Panicf(\"entries[%d:%d) is unavailable from storage\", lo, cut)\n   519\t\t} else if err != nil {\n   520\t\t\tpanic(err) // TODO(pavelkalinnikov): handle errors uniformly\n   521\t\t}\n   522\t\tif hi <= l.unstable.offset {\n   523\t\t\treturn ents, nil\n   524\t\t}\n   525\t\n   526\t\t// Fast path to check if ents has reached the size limitation. Either the\n   527\t\t// returned slice is shorter than requested (which means the next entry would\n   528\t\t// bring it over the limit), or a single entry reaches the limit.\n   529\t\tif uint64(len(ents)) < cut-lo {\n   530\t\t\treturn ents, nil\n   531\t\t}\n   532\t\t// Slow path computes the actual total size, so that unstable entries are cut\n   533\t\t// optimally before being copied to ents slice.\n   534\t\tsize := entsSize(ents)\n   535\t\tif size >= maxSize {\n   536\t\t\treturn ents, nil\n   537\t\t}\n   538\t\n   539\t\tunstable := limitSize(l.unstable.slice(l.unstable.offset, hi), maxSize-size)\n   540\t\t// Total size of unstable may exceed maxSize-size only if len(unstable) == 1.\n   541\t\t// If this happens, ignore this extra entry.\n   542\t\tif len(unstable) == 1 && size+entsSize(unstable) > maxSize {\n   543\t\t\treturn ents, nil\n   544\t\t}\n   545\t\t// Otherwise, total size of unstable does not exceed maxSize-size, so total\n   546\t\t// size of ents+unstable does not exceed maxSize. Simply concatenate them.\n   547\t\treturn extend(ents, unstable), nil\n   548\t}\n   549\t\n   550\t// l.firstIndex <= lo <= hi <= l.firstIndex + len(l.entries)\n   551\tfunc (l *raftLog) mustCheckOutOfBounds(lo, hi uint64) error {\n   552\t\tif lo > hi {\n   553\t\t\tl.logger.Panicf(\"invalid slice %d > %d\", lo, hi)\n   554\t\t}\n   555\t\tfi := l.firstIndex()\n   556\t\tif lo < fi {\n   557\t\t\treturn ErrCompacted\n   558\t\t}\n   559\t\n   560\t\tlength := l.lastIndex() + 1 - fi\n   561\t\tif hi > fi+length {\n   562\t\t\tl.logger.Panicf(\"slice[%d,%d) out of bound [%d,%d]\", lo, hi, fi, l.lastIndex())\n   563\t\t}\n   564\t\treturn nil\n   565\t}\n   566\t\n   567\tfunc (l *raftLog) zeroTermOnOutOfBounds(t uint64, err error) uint64 {\n   568\t\tif err == nil {\n   569\t\t\treturn t\n   570\t\t}\n   571\t\tif err == ErrCompacted || err == ErrUnavailable {\n   572\t\t\treturn 0\n   573\t\t}\n   574\t\tl.logger.Panicf(\"unexpected error (%v)\", err)\n   575\t\treturn 0\n   576\t}\n","exit_code":0,"status":"completed"}}
