{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n raftpb/confchange.go raftpb/confstate.go raftpb/util.go raftpb/alias.go'","aggregated_output":"     1\t// Copyright 2019 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage raftpb\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"strconv\"\n    20\t\t\"strings\"\n    21\t\n    22\t\t\"google.golang.org/protobuf/proto\"\n    23\t)\n    24\t\n    25\t// ConfChangeI abstracts over ConfChangeV2 and (legacy) ConfChange to allow\n    26\t// treating them in a unified manner.\n    27\ttype ConfChangeI interface {\n    28\t\t// AsV2 should always return a non-nil object\n    29\t\tAsV2() *ConfChangeV2\n    30\t\t// AsV1 should always return a non-nil object\n    31\t\tAsV1() (*ConfChange, bool)\n    32\t}\n    33\t\n    34\t// MarshalConfChange calls Marshal on the underlying ConfChange or ConfChangeV2\n    35\t// and returns the result along with the corresponding EntryType.\n    36\tfunc MarshalConfChange(c ConfChangeI) (EntryType, []byte, error) {\n    37\t\tvar typ EntryType\n    38\t\tvar ccdata []byte\n    39\t\tvar err error\n    40\t\tif c == nil {\n    41\t\t\t// A nil data unmarshals into an empty ConfChangeV2 and has the benefit\n    42\t\t\t// that appendEntry can never refuse it based on its size (which\n    43\t\t\t// registers as zero).\n    44\t\t\ttyp = EntryConfChangeV2\n    45\t\t\tccdata = nil\n    46\t\t} else if ccv1, ok := c.AsV1(); ok {\n    47\t\t\ttyp = EntryConfChange\n    48\t\t\tccdata, err = proto.Marshal(ccv1)\n    49\t\t} else {\n    50\t\t\tccv2 := c.AsV2()\n    51\t\t\ttyp = EntryConfChangeV2\n    52\t\t\tccdata, err = proto.Marshal(ccv2)\n    53\t\t}\n    54\t\treturn typ, ccdata, err\n    55\t}\n    56\t\n    57\t// AsV2 returns a V2 configuration change carrying out the same operation.\n    58\tfunc (c *ConfChange) AsV2() *ConfChangeV2 {\n    59\t\treturn &ConfChangeV2{\n    60\t\t\tChanges: []*ConfChangeSingle{{\n    61\t\t\t\tType:   c.GetType().Enum(),\n    62\t\t\t\tNodeId: new(c.GetNodeId()),\n    63\t\t\t}},\n    64\t\t\tContext: c.Context,\n    65\t\t}\n    66\t}\n    67\t\n    68\t// AsV1 returns the ConfChange and true.\n    69\tfunc (c *ConfChange) AsV1() (*ConfChange, bool) {\n    70\t\treturn c, true\n    71\t}\n    72\t\n    73\t// AsV2 is the identity.\n    74\tfunc (c *ConfChangeV2) AsV2() *ConfChangeV2 { return c }\n    75\t\n    76\t// AsV1 returns nil and false.\n    77\tfunc (c *ConfChangeV2) AsV1() (*ConfChange, bool) { return nil, false }\n    78\t\n    79\t// EnterJoint returns two bools. The second bool is true if and only if this\n    80\t// config change will use Joint Consensus, which is the case if it contains more\n    81\t// than one change or if the use of Joint Consensus was requested explicitly.\n    82\t// The first bool can only be true if second one is, and indicates whether the\n    83\t// Joint State will be left automatically.\n    84\tfunc (c *ConfChangeV2) EnterJoint() (autoLeave bool, ok bool) {\n    85\t\t// NB: in theory, more config changes could qualify for the \"simple\"\n    86\t\t// protocol but it depends on the config on top of which the changes apply.\n    87\t\t// For example, adding two learners is not OK if both nodes are part of the\n    88\t\t// base config (i.e. two voters are turned into learners in the process of\n    89\t\t// applying the conf change). In practice, these distinctions should not\n    90\t\t// matter, so we keep it simple and use Joint Consensus liberally.\n    91\t\tif c.GetTransition() != ConfChangeTransitionAuto || len(c.Changes) > 1 {\n    92\t\t\t// Use Joint Consensus.\n    93\t\t\tvar autoLeave bool\n    94\t\t\tswitch c.GetTransition() {\n    95\t\t\tcase ConfChangeTransitionAuto:\n    96\t\t\t\tautoLeave = true\n    97\t\t\tcase ConfChangeTransitionJointImplicit:\n    98\t\t\t\tautoLeave = true\n    99\t\t\tcase ConfChangeTransitionJointExplicit:\n   100\t\t\tdefault:\n   101\t\t\t\tpanic(fmt.Sprintf(\"unknown transition: %+v\", c))\n   102\t\t\t}\n   103\t\t\treturn autoLeave, true\n   104\t\t}\n   105\t\treturn false, false\n   106\t}\n   107\t\n   108\t// LeaveJoint is true if the configuration change leaves a joint configuration.\n   109\t// This is the case if the ConfChangeV2 is zero, with the possible exception of\n   110\t// the Context field.\n   111\tfunc (c *ConfChangeV2) LeaveJoint() bool {\n   112\t\treturn c.GetTransition() == ConfChangeTransition_ConfChangeTransitionAuto &&\n   113\t\t\tlen(c.GetChanges()) == 0\n   114\t}\n   115\t\n   116\t// ConfChangesFromString parses a Space-delimited sequence of operations into a\n   117\t// slice of ConfChangeSingle. The supported operations are:\n   118\t// - vn: make n a voter,\n   119\t// - ln: make n a learner,\n   120\t// - rn: remove n, and\n   121\t// - un: update n.\n   122\tfunc ConfChangesFromString(s string) ([]*ConfChangeSingle, error) {\n   123\t\tvar ccs []*ConfChangeSingle\n   124\t\ttoks := strings.Split(strings.TrimSpace(s), \" \")\n   125\t\tif toks[0] == \"\" {\n   126\t\t\ttoks = nil\n   127\t\t}\n   128\t\tfor _, tok := range toks {\n   129\t\t\tif len(tok) < 2 {\n   130\t\t\t\treturn nil, fmt.Errorf(\"unknown token %s\", tok)\n   131\t\t\t}\n   132\t\t\tcc := &ConfChangeSingle{}\n   133\t\t\tswitch tok[0] {\n   134\t\t\tcase 'v':\n   135\t\t\t\tcc.Type = ConfChangeAddNode.Enum()\n   136\t\t\tcase 'l':\n   137\t\t\t\tcc.Type = ConfChangeAddLearnerNode.Enum()\n   138\t\t\tcase 'r':\n   139\t\t\t\tcc.Type = ConfChangeRemoveNode.Enum()\n   140\t\t\tcase 'u':\n   141\t\t\t\tcc.Type = ConfChangeUpdateNode.Enum()\n   142\t\t\tdefault:\n   143\t\t\t\treturn nil, fmt.Errorf(\"unknown input: %s\", tok)\n   144\t\t\t}\n   145\t\t\tid, err := strconv.ParseUint(tok[1:], 10, 64)\n   146\t\t\tif err != nil {\n   147\t\t\t\treturn nil, err\n   148\t\t\t}\n   149\t\t\tcc.NodeId = new(id)\n   150\t\t\tccs = append(ccs, cc)\n   151\t\t}\n   152\t\treturn ccs, nil\n   153\t}\n   154\t\n   155\t// ConfChangesToString is the inverse to ConfChangesFromString.\n   156\tfunc ConfChangesToString(ccs []*ConfChangeSingle) string {\n   157\t\tvar buf strings.Builder\n   158\t\tfor i, cc := range ccs {\n   159\t\t\tif i > 0 {\n   160\t\t\t\tbuf.WriteByte(' ')\n   161\t\t\t}\n   162\t\t\tswitch cc.GetType() {\n   163\t\t\tcase ConfChangeAddNode:\n   164\t\t\t\tbuf.WriteByte('v')\n   165\t\t\tcase ConfChangeAddLearnerNode:\n   166\t\t\t\tbuf.WriteByte('l')\n   167\t\t\tcase ConfChangeRemoveNode:\n   168\t\t\t\tbuf.WriteByte('r')\n   169\t\t\tcase ConfChangeUpdateNode:\n   170\t\t\t\tbuf.WriteByte('u')\n   171\t\t\tdefault:\n   172\t\t\t\tbuf.WriteString(\"unknown\")\n   173\t\t\t}\n   174\t\t\tfmt.Fprintf(&buf, \"%d\", cc.GetNodeId())\n   175\t\t}\n   176\t\treturn buf.String()\n   177\t}\n   178\t// Copyright 2019 The etcd Authors\n   179\t//\n   180\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n   181\t// you may not use this file except in compliance with the License.\n   182\t// You may obtain a copy of the License at\n   183\t//\n   184\t//     http://www.apache.org/licenses/LICENSE-2.0\n   185\t//\n   186\t// Unless required by applicable law or agreed to in writing, software\n   187\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n   188\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n   189\t// See the License for the specific language governing permissions and\n   190\t// limitations under the License.\n   191\t\n   192\tpackage raftpb\n   193\t\n   194\timport (\n   195\t\t\"fmt\"\n   196\t\t\"slices\"\n   197\t\n   198\t\t\"google.golang.org/protobuf/proto\"\n   199\t)\n   200\t\n   201\t// Equivalent returns a nil error if the inputs describe the same configuration.\n   202\t// On mismatch, returns a descriptive error showing the differences.\n   203\tfunc (cs *ConfState) Equivalent(cs2 *ConfState) error {\n   204\t\tif cs == nil || cs2 == nil {\n   205\t\t\treturn fmt.Errorf(\"cannot compare ConfState: nil input (left=%v, right=%v)\", cs == nil, cs2 == nil)\n   206\t\t}\n   207\t\n   208\t\tcs1v := proto.Clone(cs).(*ConfState)\n   209\t\tcs2v := proto.Clone(cs2).(*ConfState)\n   210\t\n   211\t\ts := func(sl *[]uint64) {\n   212\t\t\tslices.Sort(*sl)\n   213\t\t}\n   214\t\tfor _, c := range []*ConfState{cs1v, cs2v} {\n   215\t\t\ts(&c.Voters)\n   216\t\t\ts(&c.Learners)\n   217\t\t\ts(&c.VotersOutgoing)\n   218\t\t\ts(&c.LearnersNext)\n   219\t\n   220\t\t\t// Treat nil AutoLeave as false.\n   221\t\t\tautoLeave := c.GetAutoLeave()\n   222\t\t\tc.AutoLeave = &autoLeave\n   223\t\t}\n   224\t\n   225\t\tif !proto.Equal(cs1v, cs2v) {\n   226\t\t\treturn fmt.Errorf(\"ConfStates not equivalent after sorting:\\n%+#v\\n%+#v\\nInputs were:\\n%+#v\\n%+#v\", cs1v, cs2v, cs, cs2)\n   227\t\t}\n   228\t\treturn nil\n   229\t}\n   230\t// Copyright 2026 The etcd Authors\n   231\t//\n   232\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n   233\t// you may not use this file except in compliance with the License.\n   234\t// You may obtain a copy of the License at\n   235\t//\n   236\t//     http://www.apache.org/licenses/LICENSE-2.0\n   237\t//\n   238\t// Unless required by applicable law or agreed to in writing, software\n   239\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n   240\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n   241\t// See the License for the specific language governing permissions and\n   242\t// limitations under the License.\n   243\t\n   244\tpackage raftpb\n   245\t\n   246\t// EnsureConfState ensures that cs and all of its pointer fields are non-nil.\n   247\t// If cs is nil, a new ConfState is allocated. Any nil pointer field is set to\n   248\t// point to its zero value. Returns the resulting cs.\n   249\tfunc EnsureConfState(cs *ConfState) *ConfState {\n   250\t\tif cs == nil {\n   251\t\t\tcs = new(ConfState)\n   252\t\t}\n   253\t\tif cs.AutoLeave == nil {\n   254\t\t\tcs.AutoLeave = new(false)\n   255\t\t}\n   256\t\treturn cs\n   257\t}\n   258\t\n   259\t// EnsureSnapshotMetadata ensures that m and all of its pointer fields are\n   260\t// non-nil. If m is nil, a new SnapshotMetadata is allocated. Any nil pointer\n   261\t// field is set to point to its zero value. Returns the resulting m.\n   262\tfunc EnsureSnapshotMetadata(m *SnapshotMetadata) *SnapshotMetadata {\n   263\t\tif m == nil {\n   264\t\t\tm = new(SnapshotMetadata)\n   265\t\t}\n   266\t\tnewConfState := EnsureConfState(m.ConfState)\n   267\t\tif m.ConfState == nil {\n   268\t\t\t// ConfState in a SnapshotMetadata is guaranteed to be non-nil, so in most cases\n   269\t\t\t// we don't need to update m.ConfState, which also avoids potential races.\n   270\t\t\tm.ConfState = newConfState\n   271\t\t}\n   272\t\n   273\t\tif m.Index == nil {\n   274\t\t\tm.Index = new(uint64)\n   275\t\t}\n   276\t\tif m.Term == nil {\n   277\t\t\tm.Term = new(uint64)\n   278\t\t}\n   279\t\treturn m\n   280\t}\n   281\t\n   282\t// EnsureSnapshot ensures that s and all of its pointer fields are non-nil.\n   283\t// If s is nil, a new Snapshot is allocated. Any nil pointer field is set to\n   284\t// point to its zero value. Returns the resulting s.\n   285\tfunc EnsureSnapshot(s *Snapshot) *Snapshot {\n   286\t\tif s == nil {\n   287\t\t\ts = new(Snapshot)\n   288\t\t}\n   289\t\tnewMedata := EnsureSnapshotMetadata(s.Metadata)\n   290\t\tif s.Metadata == nil {\n   291\t\t\t// Metadata in a snapshot is guaranteed to be non-nil, so in most cases\n   292\t\t\t// we don't need to update s.Metadata, which also avoids potential races.\n   293\t\t\ts.Metadata = newMedata\n   294\t\t}\n   295\t\treturn s\n   296\t}\n   297\t// Copyright 2026 The etcd Authors\n   298\t//\n   299\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n   300\t// you may not use this file except in compliance with the License.\n   301\t// You may obtain a copy of the License at\n   302\t//\n   303\t//     http://www.apache.org/licenses/LICENSE-2.0\n   304\t//\n   305\t// Unless required by applicable law or agreed to in writing, software\n   306\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n   307\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n   308\t// See the License for the specific language governing permissions and\n   309\t// limitations under the License.\n   310\t\n   311\tpackage raftpb\n   312\t\n   313\tconst (\n   314\t\tEntryNormal                 = EntryType_EntryNormal\n   315\t\tEntryConfChange             = EntryType_EntryConfChange\n   316\t\tEntryConfChangeV2 EntryType = EntryType_EntryConfChangeV2\n   317\t\n   318\t\tMsgHup               = MessageType_MsgHup\n   319\t\tMsgBeat              = MessageType_MsgBeat\n   320\t\tMsgProp              = MessageType_MsgProp\n   321\t\tMsgApp               = MessageType_MsgApp\n   322\t\tMsgAppResp           = MessageType_MsgAppResp\n   323\t\tMsgVote              = MessageType_MsgVote\n   324\t\tMsgVoteResp          = MessageType_MsgVoteResp\n   325\t\tMsgSnap              = MessageType_MsgSnap\n   326\t\tMsgHeartbeat         = MessageType_MsgHeartbeat\n   327\t\tMsgHeartbeatResp     = MessageType_MsgHeartbeatResp\n   328\t\tMsgUnreachable       = MessageType_MsgUnreachable\n   329\t\tMsgSnapStatus        = MessageType_MsgSnapStatus\n   330\t\tMsgCheckQuorum       = MessageType_MsgCheckQuorum\n   331\t\tMsgTransferLeader    = MessageType_MsgTransferLeader\n   332\t\tMsgTimeoutNow        = MessageType_MsgTimeoutNow\n   333\t\tMsgReadIndex         = MessageType_MsgReadIndex\n   334\t\tMsgReadIndexResp     = MessageType_MsgReadIndexResp\n   335\t\tMsgPreVote           = MessageType_MsgPreVote\n   336\t\tMsgPreVoteResp       = MessageType_MsgPreVoteResp\n   337\t\tMsgStorageAppend     = MessageType_MsgStorageAppend\n   338\t\tMsgStorageAppendResp = MessageType_MsgStorageAppendResp\n   339\t\tMsgStorageApply      = MessageType_MsgStorageApply\n   340\t\tMsgStorageApplyResp  = MessageType_MsgStorageApplyResp\n   341\t\tMsgForgetLeader      = MessageType_MsgForgetLeader\n   342\t\n   343\t\tConfChangeTransitionAuto          = ConfChangeTransition_ConfChangeTransitionAuto\n   344\t\tConfChangeTransitionJointImplicit = ConfChangeTransition_ConfChangeTransitionJointImplicit\n   345\t\tConfChangeTransitionJointExplicit = ConfChangeTransition_ConfChangeTransitionJointExplicit\n   346\t\n   347\t\tConfChangeAddNode        = ConfChangeType_ConfChangeAddNode\n   348\t\tConfChangeRemoveNode     = ConfChangeType_ConfChangeRemoveNode\n   349\t\tConfChangeUpdateNode     = ConfChangeType_ConfChangeUpdateNode\n   350\t\tConfChangeAddLearnerNode = ConfChangeType_ConfChangeAddLearnerNode\n   351\t)\n","exit_code":0,"status":"completed"}}
