{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n quorum/majority.go | sed -n '1,200p'\"","aggregated_output":"     1\t// Copyright 2019 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage quorum\n    16\t\n    17\timport (\n    18\t\t\"cmp\"\n    19\t\t\"fmt\"\n    20\t\t\"math\"\n    21\t\t\"slices\"\n    22\t\t\"strings\"\n    23\t)\n    24\t\n    25\t// MajorityConfig is a set of IDs that uses majority quorums to make decisions.\n    26\ttype MajorityConfig map[uint64]struct{}\n    27\t\n    28\tfunc (c MajorityConfig) String() string {\n    29\t\tsl := make([]uint64, 0, len(c))\n    30\t\tfor id := range c {\n    31\t\t\tsl = append(sl, id)\n    32\t\t}\n    33\t\tslices.Sort(sl)\n    34\t\tvar buf strings.Builder\n    35\t\tbuf.WriteByte('(')\n    36\t\tfor i := range sl {\n    37\t\t\tif i > 0 {\n    38\t\t\t\tbuf.WriteByte(' ')\n    39\t\t\t}\n    40\t\t\tfmt.Fprintf(&buf, \"%x\", sl[i])\n    41\t\t}\n    42\t\tbuf.WriteByte(')')\n    43\t\treturn buf.String()\n    44\t}\n    45\t\n    46\t// Describe returns a (multi-line) representation of the commit indexes for the\n    47\t// given lookuper.\n    48\tfunc (c MajorityConfig) Describe(l AckedIndexer) string {\n    49\t\tif len(c) == 0 {\n    50\t\t\treturn \"<empty majority quorum>\"\n    51\t\t}\n    52\t\ttype tup struct {\n    53\t\t\tid  uint64\n    54\t\t\tidx Index\n    55\t\t\tok  bool // idx found?\n    56\t\t\tbar int  // length of bar displayed for this tup\n    57\t\t}\n    58\t\n    59\t\t// Below, populate .bar so that the i-th largest commit index has bar i (we\n    60\t\t// plot this as sort of a progress bar). The actual code is a bit more\n    61\t\t// complicated and also makes sure that equal index => equal bar.\n    62\t\n    63\t\tn := len(c)\n    64\t\tinfo := make([]tup, 0, n)\n    65\t\tfor id := range c {\n    66\t\t\tidx, ok := l.AckedIndex(id)\n    67\t\t\tinfo = append(info, tup{id: id, idx: idx, ok: ok})\n    68\t\t}\n    69\t\n    70\t\t// Sort by index\n    71\t\tslices.SortFunc(info, func(a, b tup) int {\n    72\t\t\tif n := cmp.Compare(a.idx, b.idx); n != 0 {\n    73\t\t\t\treturn n\n    74\t\t\t}\n    75\t\t\treturn cmp.Compare(a.id, b.id)\n    76\t\t})\n    77\t\n    78\t\t// Populate .bar.\n    79\t\tfor i := 1; i < len(info); i++ {\n    80\t\t\tif info[i-1].idx < info[i].idx {\n    81\t\t\t\tinfo[i].bar = i\n    82\t\t\t} else {\n    83\t\t\t\tinfo[i].bar = info[i-1].bar\n    84\t\t\t}\n    85\t\t}\n    86\t\n    87\t\t// Sort by ID.\n    88\t\tslices.SortFunc(info, func(a, b tup) int {\n    89\t\t\treturn cmp.Compare(a.id, b.id)\n    90\t\t})\n    91\t\n    92\t\tvar buf strings.Builder\n    93\t\n    94\t\t// Print.\n    95\t\tfmt.Fprint(&buf, strings.Repeat(\" \", n)+\"    idx\\n\")\n    96\t\tfor i := range info {\n    97\t\t\tbar := info[i].bar\n    98\t\t\tif !info[i].ok {\n    99\t\t\t\tfmt.Fprint(&buf, \"?\"+strings.Repeat(\" \", n))\n   100\t\t\t} else {\n   101\t\t\t\tfmt.Fprint(&buf, strings.Repeat(\"x\", bar)+\">\"+strings.Repeat(\" \", n-bar))\n   102\t\t\t}\n   103\t\t\tfmt.Fprintf(&buf, \" %5d    (id=%x)\\n\", info[i].idx, info[i].id)\n   104\t\t}\n   105\t\treturn buf.String()\n   106\t}\n   107\t\n   108\t// Slice returns the MajorityConfig as a sorted slice.\n   109\tfunc (c MajorityConfig) Slice() []uint64 {\n   110\t\tvar sl []uint64\n   111\t\tfor id := range c {\n   112\t\t\tsl = append(sl, id)\n   113\t\t}\n   114\t\tslices.Sort(sl)\n   115\t\treturn sl\n   116\t}\n   117\t\n   118\t// CommittedIndex computes the committed index from those supplied via the\n   119\t// provided AckedIndexer (for the active config).\n   120\tfunc (c MajorityConfig) CommittedIndex(l AckedIndexer) Index {\n   121\t\tn := len(c)\n   122\t\tif n == 0 {\n   123\t\t\t// This plays well with joint quorums which, when one half is the zero\n   124\t\t\t// MajorityConfig, should behave like the other half.\n   125\t\t\treturn math.MaxUint64\n   126\t\t}\n   127\t\n   128\t\t// Use an on-stack slice to collect the committed indexes when n <= 7\n   129\t\t// (otherwise we alloc). The alternative is to stash a slice on\n   130\t\t// MajorityConfig, but this impairs usability (as is, MajorityConfig is just\n   131\t\t// a map, and that's nice). The assumption is that running with a\n   132\t\t// replication factor of >7 is rare, and in cases in which it happens\n   133\t\t// performance is a lesser concern (additionally the performance\n   134\t\t// implications of an allocation here are far from drastic).\n   135\t\tvar stk [7]uint64\n   136\t\tvar srt []uint64\n   137\t\tif len(stk) >= n {\n   138\t\t\tsrt = stk[:n]\n   139\t\t} else {\n   140\t\t\tsrt = make([]uint64, n)\n   141\t\t}\n   142\t\n   143\t\t{\n   144\t\t\t// Fill the slice with the indexes observed. Any unused slots will be\n   145\t\t\t// left as zero; these correspond to voters that may report in, but\n   146\t\t\t// haven't yet. We fill from the right (since the zeroes will end up on\n   147\t\t\t// the left after sorting below anyway).\n   148\t\t\ti := n - 1\n   149\t\t\tfor id := range c {\n   150\t\t\t\tif idx, ok := l.AckedIndex(id); ok {\n   151\t\t\t\t\tsrt[i] = uint64(idx)\n   152\t\t\t\t\ti--\n   153\t\t\t\t}\n   154\t\t\t}\n   155\t\t}\n   156\t\tslices.Sort(srt)\n   157\t\n   158\t\t// The smallest index into the array for which the value is acked by a\n   159\t\t// quorum. In other words, from the end of the slice, move n/2+1 to the\n   160\t\t// left (accounting for zero-indexing).\n   161\t\tpos := n - (n/2 + 1)\n   162\t\treturn Index(srt[pos])\n   163\t}\n   164\t\n   165\t// VoteResult takes a mapping of voters to yes/no (true/false) votes and returns\n   166\t// a result indicating whether the vote is pending (i.e. neither a quorum of\n   167\t// yes/no has been reached), won (a quorum of yes has been reached), or lost (a\n   168\t// quorum of no has been reached).\n   169\tfunc (c MajorityConfig) VoteResult(votes map[uint64]bool) VoteResult {\n   170\t\tif len(c) == 0 {\n   171\t\t\t// By convention, the elections on an empty config win. This comes in\n   172\t\t\t// handy with joint quorums because it'll make a half-populated joint\n   173\t\t\t// quorum behave like a majority quorum.\n   174\t\t\treturn VoteWon\n   175\t\t}\n   176\t\n   177\t\tvar votedCnt int //vote counts for yes.\n   178\t\tvar missing int\n   179\t\tfor id := range c {\n   180\t\t\tv, ok := votes[id]\n   181\t\t\tif !ok {\n   182\t\t\t\tmissing++\n   183\t\t\t\tcontinue\n   184\t\t\t}\n   185\t\t\tif v {\n   186\t\t\t\tvotedCnt++\n   187\t\t\t}\n   188\t\t}\n   189\t\n   190\t\tq := len(c)/2 + 1\n   191\t\tif votedCnt >= q {\n   192\t\t\treturn VoteWon\n   193\t\t}\n   194\t\tif votedCnt+missing >= q {\n   195\t\t\treturn VotePending\n   196\t\t}\n   197\t\treturn VoteLost\n   198\t}\n","exit_code":0,"status":"completed"}}
