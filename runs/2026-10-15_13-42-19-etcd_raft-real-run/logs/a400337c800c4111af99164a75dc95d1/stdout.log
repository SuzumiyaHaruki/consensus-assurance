r.\n  1261\t\t// more info: raft dissertation 6.4, step 3.\n  1262\t\tsm.Step(&pb.Message{From: new(uint64(2)), Type: pb.MsgHeartbeatResp.Enum(), Context: msgs[0].GetContext()})\n  1263\t\trequire.Empty(t, sm.readOnly.unconfirmedReads)\n  1264\t}\n  1265\t\n  1266\t// TestMsgAppRespWaitReset verifies the resume behavior of a leader\n  1267\t// MsgAppResp.\n  1268\tfunc TestMsgAppRespWaitReset(t *testing.T) {\n  1269\t\ts := newTestMemoryStorage(withPeers(1, 2, 3))\n  1270\t\tsm := newTestRaft(1, 5, 1, s)\n  1271\t\tsm.becomeCandidate()\n  1272\t\tsm.becomeLeader()\n  1273\t\n  1274\t\t// Run n1 which includes sending a message like the below\n  1275\t\t// one to n2, but also appending to its own log.\n  1276\t\tnextEnts(sm, s)\n  1277\t\n  1278\t\t// Node 2 acks the first entry, making it committed.\n  1279\t\tsm.Step(&pb.Message{\n  1280\t\t\tFrom:  new(uint64(2)),\n  1281\t\t\tType:  pb.MsgAppResp.Enum(),\n  1282\t\t\tIndex: new(uint64(1)),\n  1283\t\t})\n  1284\t\trequire.Equal(t, uint64(1), sm.raftLog.committed)\n  1285\t\n  1286\t\t// Also consume the MsgApp messages that update Commit on the followers.\n  1287\t\tsm.readMessages()\n  1288\t\n  1289\t\t// A new command is now proposed on node 1.\n  1290\t\tsm.Step(&pb.Message{\n=======\n  2150\t\trequire.Equal(t, windex, rs.Index)\n  2151\t\trequire.Equal(t, wctx, rs.RequestCtx)\n  2152\t}\n  2153\t\n  2154\t// TestReadOnlyDuplicateRequest ensures that sending multiple ReadIndex requests\n  2155\t// with the same RequestCtx does not cause invalid readStates to be returned.\n  2156\tfunc TestReadOnlyDuplicateRequest(t *testing.T) {\n  2157\t\tr1 := newTestRaft(1, 10, 1, newTestMemoryStorage(withPeers(1, 2, 3)))\n  2158\t\tr2 := newTestRaft(2, 10, 1, newTestMemoryStorage(withPeers(1, 2, 3)))\n  2159\t\tr3 := newTestRaft(3, 10, 1, newTestMemoryStorage(withPeers(1, 2, 3)))\n  2160\t\tnet := newNetwork(r1, r2, r3)\n  2161\t\n  2162\t\t// These will be delayed until a new leader gets elected and commits a new entry\n  2163\t\tvar delayedMsgs []*pb.Message\n  2164\t\n  2165\t\t// net hook that delays (but doesn't duplicate) only heartbeat responses\n  2166\t\tdelayHeartbeatResps := func(m *pb.Message) bool {\n  2167\t\t\tif m.GetType() == pb.MsgHeartbeatResp {\n  2168\t\t\t\tdelayedMsgs = append(delayedMsgs, m)\n  2169\t\t\t\treturn false\n  2170\t\t\t}\n  2171\t\t\treturn true\n  2172\t\t}\n  2173\t\n  2174\t\t// elect r1 as leader\n  2175\t\tnet.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgHup.Enum()})\n  2176\t\n  2177\t\t// Create readIndexMsgA; its eventual readIndex must be least readIndexMinimumA\n  2178\t\treadIndexMsgA := &pb.Message{From: new(uint64(2)), To: new(uint64(1)), Type: pb.MsgReadIndex.Enum(),\n  2179\t\t\tEntries: []*pb.Entry{{Data: []byte(\"A\")}}}\n  2180\t\treadIndexMinimumA := r1.raftLog.committed\n  2181\t\n  2182\t\t// Explicitly duplicate readIndexMsgA for later; this would be done either by\n  2183\t\t// the network itself, or by users of the raft library retrying `ReadIndex()`.\n  2184\t\tdelayedMsgs = append(delayedMsgs, readIndexMsgA)\n  2185\t\n  2186\t\t// Process readIndex request, but delay heartbeats until the end of this test\n  2187\t\tnet.msgHook = delayHeartbeatResps\n  2188\t\tnet.send(readIndexMsgA)\n  2189\t\tnet.msgHook = nil // stop delaying\n  2190\t\n  2191\t\t// tick and send whatever raft wants to send; this will finish processing readIndexA\n  2192\t\tr1.tick()\n  2193\t\tr1.advanceMessagesAfterAppend()\n  2194\t\tmsgs := r1.msgs\n  2195\t\tr1.msgs = nil\n  2196\t\tnet.send(msgs...)\n  2197\t\n  2198\t\tnet.isolate(r1.id)\n  2199\t\n  2200\t\t// elect r2 as leader, and commit a new entry\n  2201\t\tnet.send(&pb.Message{From: new(uint64(2)), To: new(uint64(2)), Type: pb.MsgHup.Enum()})\n  2202\t\tnet.send(&pb.Message{From: new(uint64(2)), To: new(uint64(2)),\n  2203\t\t\tType: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"someOp\")}}})\n  2204\t\n  2205\t\t// Try reading from the disconnected and stale leader r1\n  2206\t\t// Create readIndexMsgB; its eventual readIndex must be least readIndexMinimumB\n  2207\t\treadIndexMsgB := &pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgReadIndex.Enum(),\n  2208\t\t\tEntries: []*pb.Entry{{Data: []byte(\"B\")}}}\n  2209\t\treadIndexMinimumB := r2.raftLog.committed\n  2210\t\n  2211\t\tnet.send(readIndexMsgB)\n  2212\t\tnet.recover()\n  2213\t\t// First send the delayed readIndexMsgA, then the delayed heartbeats. This\n  2214\t\t// should not cause B to be confirmed.\n  2215\t\tnet.send(delayedMsgs...)\n  2216\t\n  2217\t\t// make sure the readIndexes aren't too small (which would violate linearizability)\n  2218\t\tfor _, rd := range slices.Concat(r1.readStates, r2.readStates, r3.readStates) {\n  2219\t\t\tif string(rd.RequestCtx) == \"A\" {\n  2220\t\t\t\tassert.True(t, rd.Index >= readIndexMinimumA, \"readIndex for A is %v (should be >= %v)\", rd.Index, readIndexMinimumA)\n  2221\t\t\t} else if string(rd.RequestCtx) == \"B\" {\n  2222\t\t\t\tassert.True(t, rd.Index >= readIndexMinimumB, \"readIndex for B is %v (should be >= %v)\", rd.Index, readIndexMinimumB)\n  2223\t\t\t}\n  2224\t\t}\n  2225\t}\n  2226\t\n  2227\tfunc TestLeaderAppResp(t *testing.T) {\n  2228\t\t// initial progress: match = 0; next = 3\n  2229\t\ttests := []struct {\n  2230\t\t\tindex  uint64\n  2231\t\t\treject bool\n  2232\t\t\t// progress\n  2233\t\t\twmatch uint64\n  2234\t\t\twnext  uint64\n  2235\t\t\t// message\n  2236\t\t\twmsgNum    int\n  2237\t\t\twindex     uint64\n  2238\t\t\twcommitted uint64\n  2239\t\t}{\n  2240\t\t\t{3, true, 0, 3, 0, 0, 0},  // stale resp; no replies\n","exit_code":0,"status":"completed"}}
