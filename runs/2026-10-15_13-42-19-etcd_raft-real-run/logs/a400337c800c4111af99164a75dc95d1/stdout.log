{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n log_unstable.go'","aggregated_output":"     1\t// Copyright 2015 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage raft\n    16\t\n    17\timport (\n    18\t\t\"google.golang.org/protobuf/proto\"\n    19\t\n    20\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    21\t)\n    22\t\n    23\t// unstable contains \"unstable\" log entries and snapshot state that has\n    24\t// not yet been written to Storage. The type serves two roles. First, it\n    25\t// holds on to new log entries and an optional snapshot until they are\n    26\t// handed to a Ready struct for persistence. Second, it continues to\n    27\t// hold on to this state after it has been handed off to provide raftLog\n    28\t// with a view of the in-progress log entries and snapshot until their\n    29\t// writes have been stabilized and are guaranteed to be reflected in\n    30\t// queries of Storage. After this point, the corresponding log entries\n    31\t// and/or snapshot can be cleared from unstable.\n    32\t//\n    33\t// unstable.entries[i] has raft log position i+unstable.offset.\n    34\t// Note that unstable.offset may be less than the highest log\n    35\t// position in storage; this means that the next write to storage\n    36\t// might need to truncate the log before persisting unstable.entries.\n    37\ttype unstable struct {\n    38\t\t// the incoming unstable snapshot, if any.\n    39\t\tsnapshot *pb.Snapshot\n    40\t\t// all entries that have not yet been written to storage.\n    41\t\tentries []*pb.Entry\n    42\t\t// entries[i] has raft log position i+offset.\n    43\t\toffset uint64\n    44\t\n    45\t\t// if true, snapshot is being written to storage.\n    46\t\tsnapshotInProgress bool\n    47\t\t// entries[:offsetInProgress-offset] are being written to storage.\n    48\t\t// Like offset, offsetInProgress is exclusive, meaning that it\n    49\t\t// contains the index following the largest in-progress entry.\n    50\t\t// Invariant: offset <= offsetInProgress\n    51\t\toffsetInProgress uint64\n    52\t\n    53\t\tlogger Logger\n    54\t}\n    55\t\n    56\t// maybeFirstIndex returns the index of the first possible entry in entries\n    57\t// if it has a snapshot.\n    58\tfunc (u *unstable) maybeFirstIndex() (uint64, bool) {\n    59\t\tif u.snapshot != nil {\n    60\t\t\treturn u.snapshot.GetMetadata().GetIndex() + 1, true\n    61\t\t}\n    62\t\treturn 0, false\n    63\t}\n    64\t\n    65\t// maybeLastIndex returns the last index if it has at least one\n    66\t// unstable entry or snapshot.\n    67\tfunc (u *unstable) maybeLastIndex() (uint64, bool) {\n    68\t\tif l := len(u.entries); l != 0 {\n    69\t\t\treturn u.offset + uint64(l) - 1, true\n    70\t\t}\n    71\t\tif u.snapshot != nil {\n    72\t\t\treturn u.snapshot.GetMetadata().GetIndex(), true\n    73\t\t}\n    74\t\treturn 0, false\n    75\t}\n    76\t\n    77\t// maybeTerm returns the term of the entry at index i, if there\n    78\t// is any.\n    79\tfunc (u *unstable) maybeTerm(i uint64) (uint64, bool) {\n    80\t\tif i < u.offset {\n    81\t\t\tif u.snapshot != nil && u.snapshot.GetMetadata().GetIndex() == i {\n    82\t\t\t\treturn u.snapshot.GetMetadata().GetTerm(), true\n    83\t\t\t}\n    84\t\t\treturn 0, false\n    85\t\t}\n    86\t\n    87\t\tlast, ok := u.maybeLastIndex()\n    88\t\tif !ok {\n    89\t\t\treturn 0, false\n    90\t\t}\n    91\t\tif i > last {\n    92\t\t\treturn 0, false\n    93\t\t}\n    94\t\n    95\t\treturn u.entries[i-u.offset].GetTerm(), true\n    96\t}\n    97\t\n    98\t// nextEntries returns the unstable entries that are not already in the process\n    99\t// of being written to storage.\n   100\tfunc (u *unstable) nextEntries() []*pb.Entry {\n   101\t\tinProgress := int(u.offsetInProgress - u.offset)\n   102\t\tif len(u.entries) == inProgress {\n   103\t\t\treturn nil\n   104\t\t}\n   105\t\treturn u.entries[inProgress:]\n   106\t}\n   107\t\n   108\t// nextSnapshot returns the unstable snapshot, if one exists that is not already\n   109\t// in the process of being written to storage.\n   110\tfunc (u *unstable) nextSnapshot() *pb.Snapshot {\n   111\t\tif u.snapshot == nil || u.snapshotInProgress {\n   112\t\t\treturn nil\n   113\t\t}\n   114\t\treturn proto.Clone(u.snapshot).(*pb.Snapshot)\n   115\t}\n   116\t\n   117\t// acceptInProgress marks all entries and the snapshot, if any, in the unstable\n   118\t// as having begun the process of being written to storage. The entries/snapshot\n   119\t// will no longer be returned from nextEntries/nextSnapshot. However, new\n   120\t// entries/snapshots added after a call to acceptInProgress will be returned\n   121\t// from those methods, until the next call to acceptInProgress.\n   122\tfunc (u *unstable) acceptInProgress() {\n   123\t\tif len(u.entries) > 0 {\n   124\t\t\t// NOTE: +1 because offsetInProgress is exclusive, like offset.\n   125\t\t\tu.offsetInProgress = u.entries[len(u.entries)-1].GetIndex() + 1\n   126\t\t}\n   127\t\tif u.snapshot != nil {\n   128\t\t\tu.snapshotInProgress = true\n   129\t\t}\n   130\t}\n   131\t\n   132\t// stableTo marks entries up to the entry with the specified (index, term) as\n   133\t// being successfully written to stable storage.\n   134\t//\n   135\t// The method should only be called when the caller can attest that the entries\n   136\t// can not be overwritten by an in-progress log append. See the related comment\n   137\t// in newStorageAppendRespMsg.\n   138\tfunc (u *unstable) stableTo(id entryID) {\n   139\t\tgt, ok := u.maybeTerm(id.index)\n   140\t\tif !ok {\n   141\t\t\t// Unstable entry missing. Ignore.\n   142\t\t\tu.logger.Infof(\"entry at index %d missing from unstable log; ignoring\", id.index)\n   143\t\t\treturn\n   144\t\t}\n   145\t\tif id.index < u.offset {\n   146\t\t\t// Index matched unstable snapshot, not unstable entry. Ignore.\n   147\t\t\tu.logger.Infof(\"entry at index %d matched unstable snapshot; ignoring\", id.index)\n   148\t\t\treturn\n   149\t\t}\n   150\t\tif gt != id.term {\n   151\t\t\t// Term mismatch between unstable entry and specified entry. Ignore.\n   152\t\t\t// This is possible if part or all of the unstable log was replaced\n   153\t\t\t// between that time that a set of entries started to be written to\n   154\t\t\t// stable storage and when they finished.\n   155\t\t\tu.logger.Infof(\"entry at (index,term)=(%d,%d) mismatched with \"+\n   156\t\t\t\t\"entry at (%d,%d) in unstable log; ignoring\", id.index, id.term, id.index, gt)\n   157\t\t\treturn\n   158\t\t}\n   159\t\tnum := int(id.index + 1 - u.offset)\n   160\t\tu.entries = u.entries[num:]\n   161\t\tu.offset = id.index + 1\n   162\t\tu.offsetInProgress = max(u.offsetInProgress, u.offset)\n   163\t\tu.shrinkEntriesArray()\n   164\t}\n   165\t\n   166\t// shrinkEntriesArray discards the underlying array used by the entries slice\n   167\t// if most of it isn't being used. This avoids holding references to a bunch of\n   168\t// potentially large entries that aren't needed anymore. Simply clearing the\n   169\t// entries wouldn't be safe because clients might still be using them.\n   170\tfunc (u *unstable) shrinkEntriesArray() {\n   171\t\t// We replace the array if we're using less than half of the space in\n   172\t\t// it. This number is fairly arbitrary, chosen as an attempt to balance\n   173\t\t// memory usage vs number of allocations. It could probably be improved\n   174\t\t// with some focused tuning.\n   175\t\tconst lenMultiple = 2\n   176\t\tif len(u.entries) == 0 {\n   177\t\t\tu.entries = nil\n   178\t\t} else if len(u.entries)*lenMultiple < cap(u.entries) {\n   179\t\t\tnewEntries := make([]*pb.Entry, len(u.entries))\n   180\t\t\tcopy(newEntries, u.entries)\n   181\t\t\tu.entries = newEntries\n   182\t\t}\n   183\t}\n   184\t\n   185\tfunc (u *unstable) stableSnapTo(i uint64) {\n   186\t\tif u.snapshot != nil && u.snapshot.GetMetadata().GetIndex() == i {\n   187\t\t\tu.snapshot = nil\n   188\t\t\tu.snapshotInProgress = false\n   189\t\t}\n   190\t}\n   191\t\n   192\tfunc (u *unstable) restore(s *pb.Snapshot) {\n   193\t\tu.offset = s.GetMetadata().GetIndex() + 1\n   194\t\tu.offsetInProgress = u.offset\n   195\t\tu.entries = nil\n   196\t\tu.snapshot = proto.Clone(s).(*pb.Snapshot)\n   197\t\tu.snapshotInProgress = false\n   198\t}\n   199\t\n   200\tfunc (u *unstable) truncateAndAppend(ents []*pb.Entry) {\n   201\t\tfromIndex := ents[0].GetIndex()\n   202\t\tswitch {\n   203\t\tcase fromIndex == u.offset+uint64(len(u.entries)):\n   204\t\t\t// fromIndex is the next index in the u.entries, so append directly.\n   205\t\t\tu.entries = append(u.entries, ents...)\n   206\t\tcase fromIndex <= u.offset:\n   207\t\t\tu.logger.Infof(\"replace the unstable entries from index %d\", fromIndex)\n   208\t\t\t// The log is being truncated to before our current offset\n   209\t\t\t// portion, so set the offset and replace the entries.\n   210\t\t\tu.entries = ents\n   211\t\t\tu.offset = fromIndex\n   212\t\t\tu.offsetInProgress = u.offset\n   213\t\tdefault:\n   214\t\t\t// Truncate to fromIndex (exclusive), and append the new entries.\n   215\t\t\tu.logger.Infof(\"truncate the unstable entries before index %d\", fromIndex)\n   216\t\t\tkeep := u.slice(u.offset, fromIndex) // NB: appending to this slice is safe,\n   217\t\t\tu.entries = append(keep, ents...)    // and will reallocate/copy it\n   218\t\t\t// Only in-progress entries before fromIndex are still considered to be\n   219\t\t\t// in-progress.\n   220\t\t\tu.offsetInProgress = min(u.offsetInProgress, fromIndex)\n   221\t\t}\n   222\t}\n   223\t\n   224\t// slice returns the entries from the unstable log with indexes in the range\n   225\t// [lo, hi). The entire range must be stored in the unstable log or the method\n   226\t// will panic. The returned slice can be appended to, but the entries in it must\n   227\t// not be changed because they are still shared with unstable.\n   228\t//\n   229\t// TODO(pavelkalinnikov): this, and similar []*pb.Entry slices, may bubble up all\n   230\t// the way to the application code through Ready struct. Protect other slices\n   231\t// similarly, and document how the client can use them.\n   232\tfunc (u *unstable) slice(lo uint64, hi uint64) []*pb.Entry {\n   233\t\tu.mustCheckOutOfBounds(lo, hi)\n   234\t\t// NB: use the full slice expression to limit what the caller can do with the\n   235\t\t// returned slice. For example, an append will reallocate and copy this slice\n   236\t\t// instead of corrupting the neighbouring u.entries.\n   237\t\treturn u.entries[lo-u.offset : hi-u.offset : hi-u.offset]\n   238\t}\n   239\t\n   240\t// u.offset <= lo <= hi <= u.offset+len(u.entries)\n   241\tfunc (u *unstable) mustCheckOutOfBounds(lo, hi uint64) {\n   242\t\tif lo > hi {\n   243\t\t\tu.logger.Panicf(\"invalid unstable.slice %d > %d\", lo, hi)\n   244\t\t}\n   245\t\tupper := u.offset + uint64(len(u.entries))\n   246\t\tif lo < u.offset || hi > upper {\n   247\t\t\tu.logger.Panicf(\"unstable.slice[%d,%d) out of bound [%d,%d]\", lo, hi, u.offset, upper)\n   248\t\t}\n   249\t}\n","exit_code":0,"status":"completed"}}
