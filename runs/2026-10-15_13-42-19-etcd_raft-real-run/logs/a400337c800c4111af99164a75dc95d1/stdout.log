78\t\n  2079\t\t\tr := tt.sm\n  2080\t\t\trs := r.readStates[0]\n  2081\t\t\tassert.Equal(t, tt.wri, rs.Index, \"#%d\", i)\n  2082\t\t\tassert.Equal(t, tt.wctx, rs.RequestCtx, \"#%d\", i)\n  2083\t\t\tr.readStates = nil\n  2084\t\t}\n  2085\t}\n  2086\t\n  2087\t// TestReadOnlyForNewLeader ensures that a leader only accepts MsgReadIndex message\n  2088\t// when it commits at least one log entry at it term.\n  2089\tfunc TestReadOnlyForNewLeader(t *testing.T) {\n  2090\t\tnodeConfigs := []struct {\n  2091\t\t\tid           uint64\n  2092\t\t\tcommitted    uint64\n  2093\t\t\tapplied      uint64\n  2094\t\t\tcompactIndex uint64\n  2095\t\t}{\n  2096\t\t\t{1, 1, 1, 0},\n  2097\t\t\t{2, 2, 2, 2},\n  2098\t\t\t{3, 2, 2, 2},\n  2099\t\t}\n  2100\t\tpeers := make([]stateMachine, 0)\n  2101\t\tfor _, c := range nodeConfigs {\n  2102\t\t\tstorage := newTestMemoryStorage(withPeers(1, 2, 3))\n  2103\t\t\trequire.NoError(t, storage.Append(index(1).terms(1, 1)))\n  2104\t\t\tstorage.SetHardState(&pb.HardState{Term: new(uint64(1)), Commit: new(c.committed)})\n  2105\t\t\tif c.compactIndex != 0 {\n  2106\t\t\t\tstorage.Compact(c.compactIndex)\n  2107\t\t\t}\n  2108\t\t\tcfg := newTestConfig(c.id, 10, 1, storage)\n  2109\t\t\tcfg.Applied = c.applied\n  2110\t\t\traft := newRaft(cfg)\n  2111\t\t\tpeers = append(peers, raft)\n  2112\t\t}\n  2113\t\tnt := newNetwork(peers...)\n  2114\t\n  2115\t\t// Drop MsgApp to forbid peer a to commit any log entry at its term after it becomes leader.\n  2116\t\tnt.ignore(pb.MsgApp)\n  2117\t\t// Force peer a to become leader.\n  2118\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgHup.Enum()})\n  2119\t\n  2120\t\tsm := nt.peers[1].(*raft)\n  2121\t\trequire.Equal(t, StateLeader, sm.state)\n  2122\t\n  2123\t\t// Ensure peer a drops read only request.\n  2124\t\tvar windex uint64 = 4\n  2125\t\twctx := []byte(\"ctx\")\n  2126\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgReadIndex.Enum(), Entries: []*pb.Entry{{Data: wctx}}})\n  2127\t\trequire.Empty(t, sm.readStates)\n  2128\t\n  2129\t\tnt.recover()\n  2130\t\n  2131\t\t// Force peer a to commit a log entry at its term\n  2132\t\tfor i := 0; i < sm.heartbeatTimeout; i++ {\n  2133\t\t\tsm.tick()\n  2134\t\t}\n  2135\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{}}})\n  2136\t\trequire.Equal(t, uint64(4), sm.raftLog.committed)\n  2137\t\tlastLogTerm := sm.raftLog.zeroTermOnOutOfBounds(sm.raftLog.term(sm.raftLog.committed))\n  2138\t\trequire.Equal(t, sm.Term, lastLogTerm)\n  2139\t\n  2140\t\t// Ensure peer a processed postponed read only request after it committed an entry at its term.\n  2141\t\trequire.Len(t, sm.readStates, 1)\n  2142\t\trs := sm.readStates[0]\n  2143\t\trequire.Equal(t, windex, rs.Index)\n  2144\t\trequire.Equal(t, wctx, rs.RequestCtx)\n  2145\t\n  2146\t\t// Ensure peer a accepts read only request after it committed an entry at its term.\n  2147\t\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgReadIndex.Enum(), Entries: []*pb.Entry{{Data: wctx}}})\n  2148\t\trequire.Len(t, sm.readStates, 2)\n  2149\t\trs = sm.readStates[1]\n  2150\t\trequire.Equal(t, windex, rs.Index)\n  2151\t\trequire.Equal(t, wctx, rs.RequestCtx)\n  2152\t}\n","exit_code":0,"status":"completed"}}
