the MsgApp's LogTerm.\n1813\t//\n1814\t// See the other caller for findConflictByTerm (in stepLeader) for a much more\n1815\t// detailed explanation of this mechanism.\n1816\t    35\t\n1817\t// NB: m.Index >= raftLog.committed by now (see the early return above), and\n1818\t// raftLog.lastIndex() >= raftLog.committed by invariant, so min of the two is\n1819\t// also >= raftLog.committed. Hence, the findConflictByTerm argument is within\n1820\t// the valid interval, which then will return a valid (index, term) pair with\n1821\t// a non-zero term (unless the log is empty). However, it is safe to send a zero\n1822\t// LogTerm in this response in any case, so we don't verify it here.\n1823\thintIndex := min(m.GetIndex(), r.raftLog.lastIndex())\n1824\thintIndex, hintTerm := r.raftLog.findConflictByTerm(hintIndex, m.GetLogTerm())\n1825\tr.send(&pb.Message{\n1826\tTo:         m.From,\n1827\tType:       pb.MsgAppResp.Enum(),\n1828\tIndex:      new(m.GetIndex()),\n1829\tReject:     new(true),\n1830\tRejectHint: new(hintIndex),\n1831\tLogTerm:    new(hintTerm),\n1832\t})\n1833\t}\n1834\t    53\t\n1835\tfunc (r *raft) handleHeartbeat(m *pb.Message) {\n1836\tr.raftLog.commitTo(m.GetCommit())\n1837\tr.send(&pb.Message{To: m.From, Type: pb.MsgHeartbeatResp.Enum(), Context: m.GetContext()})\n1838\t}\n1839\t    58\t\n1840\tfunc (r *raft) handleSnapshot(m *pb.Message) {\n1841\t// MsgSnap messages should always carry a non-nil Snapshot, but err on the\n1842\t// side of safety and treat a nil Snapshot as a zero-valued Snapshot.\n1843\ts := m.GetSnapshot()\n1844\ts = pb.EnsureSnapshot(s)\n1845\tsindex, sterm := s.GetMetadata().GetIndex(), s.GetMetadata().GetTerm()\n1846\tif r.restore(s) {\n1847\tr.logger.Infof(\"%x [commit: %d] restored snapshot [index: %d, term: %d]\",\n1848\tr.id, r.raftLog.committed, sindex, sterm)\n1849\tr.send(&pb.Message{To: m.From, Type: pb.MsgAppResp.Enum(), Index: new(r.raftLog.lastIndex())})\n1850\t} else {\n1851\tr.logger.Infof(\"%x [commit: %d] ignored snap