{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n rafttest/interaction_env_handler_add_nodes.go'","aggregated_output":"     1\t// Copyright 2019 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage rafttest\n    16\t\n    17\timport (\n    18\t\t\"errors\"\n    19\t\t\"fmt\"\n    20\t\t\"testing\"\n    21\t\n    22\t\t\"github.com/cockroachdb/datadriven\"\n    23\t\t\"google.golang.org/protobuf/proto\"\n    24\t\n    25\t\t\"go.etcd.io/raft/v3\"\n    26\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    27\t)\n    28\t\n    29\tfunc (env *InteractionEnv) handleAddNodes(t *testing.T, d datadriven.TestData) error {\n    30\t\tn := firstAsInt(t, d)\n    31\t\tsnap := pb.EnsureSnapshot(nil)\n    32\t\tcfg := raftConfigStub()\n    33\t\tfor _, arg := range d.CmdArgs[1:] {\n    34\t\t\tfor i := range arg.Vals {\n    35\t\t\t\tswitch arg.Key {\n    36\t\t\t\tcase \"voters\":\n    37\t\t\t\t\tvar id uint64\n    38\t\t\t\t\targ.Scan(t, i, &id)\n    39\t\t\t\t\tsnap.Metadata.ConfState.Voters = append(snap.Metadata.ConfState.Voters, id)\n    40\t\t\t\tcase \"learners\":\n    41\t\t\t\t\tvar id uint64\n    42\t\t\t\t\targ.Scan(t, i, &id)\n    43\t\t\t\t\tsnap.Metadata.ConfState.Learners = append(snap.Metadata.ConfState.Learners, id)\n    44\t\t\t\tcase \"inflight\":\n    45\t\t\t\t\targ.Scan(t, i, &cfg.MaxInflightMsgs)\n    46\t\t\t\tcase \"index\":\n    47\t\t\t\t\tvar idx uint64\n    48\t\t\t\t\targ.Scan(t, i, &idx)\n    49\t\t\t\t\tsnap.Metadata.Index = new(idx)\n    50\t\t\t\t\tcfg.Applied = snap.GetMetadata().GetIndex()\n    51\t\t\t\tcase \"content\":\n    52\t\t\t\t\targ.Scan(t, i, &snap.Data)\n    53\t\t\t\tcase \"async-storage-writes\":\n    54\t\t\t\t\targ.Scan(t, i, &cfg.AsyncStorageWrites)\n    55\t\t\t\tcase \"prevote\":\n    56\t\t\t\t\targ.Scan(t, i, &cfg.PreVote)\n    57\t\t\t\tcase \"checkquorum\":\n    58\t\t\t\t\targ.Scan(t, i, &cfg.CheckQuorum)\n    59\t\t\t\tcase \"max-committed-size-per-ready\":\n    60\t\t\t\t\targ.Scan(t, i, &cfg.MaxCommittedSizePerReady)\n    61\t\t\t\tcase \"disable-conf-change-validation\":\n    62\t\t\t\t\targ.Scan(t, i, &cfg.DisableConfChangeValidation)\n    63\t\t\t\tcase \"read-only\":\n    64\t\t\t\t\tswitch arg.Vals[i] {\n    65\t\t\t\t\tcase \"safe\":\n    66\t\t\t\t\t\tcfg.ReadOnlyOption = raft.ReadOnlySafe\n    67\t\t\t\t\tcase \"lease-based\":\n    68\t\t\t\t\t\tcfg.ReadOnlyOption = raft.ReadOnlyLeaseBased\n    69\t\t\t\t\tdefault:\n    70\t\t\t\t\t\treturn fmt.Errorf(\"invalid read-only option %q\", arg.Vals[i])\n    71\t\t\t\t\t}\n    72\t\t\t\tcase \"step-down-on-removal\":\n    73\t\t\t\t\targ.Scan(t, i, &cfg.StepDownOnRemoval)\n    74\t\t\t\t}\n    75\t\t\t}\n    76\t\t}\n    77\t\treturn env.AddNodes(n, cfg, snap)\n    78\t}\n    79\t\n    80\ttype snapOverrideStorage struct {\n    81\t\tStorage\n    82\t\tsnapshotOverride func() (*pb.Snapshot, error)\n    83\t}\n    84\t\n    85\tfunc (s snapOverrideStorage) Snapshot() (*pb.Snapshot, error) {\n    86\t\tif s.snapshotOverride != nil {\n    87\t\t\treturn s.snapshotOverride()\n    88\t\t}\n    89\t\treturn s.Storage.Snapshot()\n    90\t}\n    91\t\n    92\tvar _ raft.Storage = snapOverrideStorage{}\n    93\t\n    94\t// AddNodes adds n new nodes initialized from the given snapshot (which may be\n    95\t// empty), and using the cfg as template. They will be assigned consecutive IDs.\n    96\tfunc (env *InteractionEnv) AddNodes(n int, cfg raft.Config, snap *pb.Snapshot) error {\n    97\t\temptySnapshot := pb.EnsureSnapshot(nil)\n    98\t\tsnap = pb.EnsureSnapshot(snap)\n    99\t\tbootstrap := !proto.Equal(snap, emptySnapshot)\n   100\t\tfor i := 0; i < n; i++ {\n   101\t\t\tid := uint64(1 + len(env.Nodes))\n   102\t\t\ts := snapOverrideStorage{\n   103\t\t\t\tStorage: raft.NewMemoryStorage(),\n   104\t\t\t\t// When you ask for a snapshot, you get the most recent snapshot.\n   105\t\t\t\t//\n   106\t\t\t\t// TODO(tbg): this is sort of clunky, but MemoryStorage itself will\n   107\t\t\t\t// give you some fixed snapshot and also the snapshot changes\n   108\t\t\t\t// whenever you compact the logs and vice versa, so it's all a bit\n   109\t\t\t\t// awkward to use.\n   110\t\t\t\tsnapshotOverride: func() (*pb.Snapshot, error) {\n   111\t\t\t\t\tsnaps := env.Nodes[int(id-1)].History\n   112\t\t\t\t\treturn snaps[len(snaps)-1], nil\n   113\t\t\t\t},\n   114\t\t\t}\n   115\t\t\tif bootstrap {\n   116\t\t\t\t// NB: we could make this work with 1, but MemoryStorage just\n   117\t\t\t\t// doesn't play well with that and it's not a loss of generality.\n   118\t\t\t\tif snap.GetMetadata().GetIndex() <= 1 {\n   119\t\t\t\t\treturn errors.New(\"index must be specified as > 1 due to bootstrap\")\n   120\t\t\t\t}\n   121\t\t\t\tsnap.Metadata.Term = new(uint64(1))\n   122\t\t\t\tif err := s.ApplySnapshot(snap); err != nil {\n   123\t\t\t\t\treturn err\n   124\t\t\t\t}\n   125\t\t\t\tfi, err := s.FirstIndex()\n   126\t\t\t\tif err != nil {\n   127\t\t\t\t\treturn err\n   128\t\t\t\t}\n   129\t\t\t\t// At the time of writing and for *MemoryStorage, applying a\n   130\t\t\t\t// snapshot also truncates appropriately, but this would change with\n   131\t\t\t\t// other storage engines potentially.\n   132\t\t\t\tif exp := snap.GetMetadata().GetIndex() + 1; fi != exp {\n   133\t\t\t\t\treturn fmt.Errorf(\"failed to establish first index %d; got %d\", exp, fi)\n   134\t\t\t\t}\n   135\t\t\t}\n   136\t\t\tcfg := cfg // fork the config stub\n   137\t\t\tcfg.ID, cfg.Storage = id, s\n   138\t\t\tif env.Options.OnConfig != nil {\n   139\t\t\t\tenv.Options.OnConfig(&cfg)\n   140\t\t\t\tif cfg.ID != id {\n   141\t\t\t\t\t// This could be supported but then we need to do more work\n   142\t\t\t\t\t// translating back and forth -- not worth it.\n   143\t\t\t\t\treturn errors.New(\"OnConfig must not change the ID\")\n   144\t\t\t\t}\n   145\t\t\t}\n   146\t\t\tif cfg.Logger != nil {\n   147\t\t\t\treturn errors.New(\"OnConfig must not set Logger\")\n   148\t\t\t}\n   149\t\t\tcfg.Logger = env.Output\n   150\t\n   151\t\t\trn, err := raft.NewRawNode(&cfg)\n   152\t\t\tif err != nil {\n   153\t\t\t\treturn err\n   154\t\t\t}\n   155\t\n   156\t\t\tnode := Node{\n   157\t\t\t\tRawNode: rn,\n   158\t\t\t\t// TODO(tbg): allow a more general Storage, as long as it also allows\n   159\t\t\t\t// us to apply snapshots, append entries, and update the HardState.\n   160\t\t\t\tStorage: s,\n   161\t\t\t\tConfig:  &cfg,\n   162\t\t\t\tHistory: []*pb.Snapshot{snap},\n   163\t\t\t}\n   164\t\t\tenv.Nodes = append(env.Nodes, node)\n   165\t\t}\n   166\t\treturn nil\n   167\t}\n","exit_code":0,"status":"completed"}}
