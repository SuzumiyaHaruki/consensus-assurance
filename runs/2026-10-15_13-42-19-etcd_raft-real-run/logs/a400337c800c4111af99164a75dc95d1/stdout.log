trequire.Len(t, ms, 1)\n    42\t\t\trequire.Equal(t, pb.MsgApp, ms[0].GetType())\n    43\t\t}\n    44\t\n    45\t\t// ensure 1\n    46\t\trequire.True(t, pr2.IsPaused())\n    47\t\n    48\t\t// ensure 2\n    49\t\tfor i := 0; i < 10; i++ {\n    50\t\t\tr.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"somedata\")}}})\n    51\t\t\tms := r.readMessages()\n    52\t\t\trequire.Empty(t, ms)\n    53\t\t}\n    54\t}\n    55\t\n    56\t// TestMsgAppFlowControlMoveForward ensures msgAppResp can move\n    57\t// forward the sending window correctly:\n    58\t// 1. valid msgAppResp.index moves the windows to pass all smaller or equal index.\n    59\t// 2. out-of-dated msgAppResp has no effect on the sliding window.\n    60\tfunc TestMsgAppFlowControlMoveForward(t *testing.T) {\n    61\t\tr := newTestRaft(1, 5, 1, newTestMemoryStorage(withPeers(1, 2)))\n    62\t\tr.becomeCandidate()\n    63\t\tr.becomeLeader()\n    64\t\n    65\t\tpr2 := r.trk.Progress[2]\n    66\t\t// force the progress to be in replicate state\n    67\t\tpr2.BecomeReplicate()\n    68\t\t// fill in the inflights window\n    69\t\tfor i := 0; i < r.trk.MaxInflight; i++ {\n    70\t\t\tr.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"somedata\")}}})\n    71\t\t\tr.readMessages()\n    72\t\t}\n    73\t\n    74\t\t// 1 is noop, 2 is the first proposal we just sent.\n    75\t\t// so we start with 2.\n    76\t\tfor tt := 2; tt < r.trk.MaxInflight; tt++ {\n    77\t\t\t// move forward the window\n    78\t\t\tr.Step(&pb.Message{From: new(uint64(2)), To: new(uint64(1)), Type: pb.MsgAppResp.Enum(), Index: new(uint64(tt))})\n    79\t\t\tr.readMessages()\n    80\t\n    81\t\t\t// fill in the inflights window again\n    82\t\t\tr.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"somedata\")}}})\n    83\t\t\tms := r.readMessages()\n    84\t\t\trequire.Len(t, ms, 1)\n    85\t\t\trequire.Equal(t, pb.MsgApp, ms[0].GetType())\n    86\t\n    87\t\t\t// ensure 1\n    88\t\t\trequire.True(t, pr2.IsPaused())\n    89\t\n    90\t\t\t// ensure 2\n    91\t\t\tfor i := 0; i < tt; i++ {\n    92\t\t\t\tr.Step(&pb.Message{From: new(uint64(2)), To: new(uint64(1)), Type: pb.MsgAppResp.Enum(), Index: new(uint64(i))})\n    93\t\t\t\trequire.True(t, pr2.IsPaused())\n    94\t\t\t}\n    95\t\t}\n    96\t}\n    97\t\n    98\t// TestMsgAppFlowControlRecvHeartbeat ensures a heartbeat response\n    99\t// frees one slot if the window is full.\n   100\tfunc TestMsgAppFlowControlRecvHeartbeat(t *testing.T) {\n   101\t\tr := newTestRaft(1, 5, 1, newTestMemoryStorage(withPeers(1, 2)))\n   102\t\tr.becomeCandidate()\n   103\t\tr.becomeLeader()\n   104\t\n   105\t\tpr2 := r.trk.Progress[2]\n   106\t\t// force the progress to be in replicate state\n   107\t\tpr2.BecomeReplicate()\n   108\t\t// fill in the inflights window\n   109\t\tfor i := 0; i < r.trk.MaxInflight; i++ {\n   110\t\t\tr.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"somedata\")}}})\n   111\t\t\tr.readMessages()\n   112\t\t}\n   113\t\n   114\t\tfor tt := 1; tt < 5; tt++ {\n   115\t\t\t// recv tt msgHeartbeatResp and expect one free slot\n   116\t\t\tfor i := 0; i < tt; i++ {\n   117\t\t\t\trequire.True(t, pr2.IsPaused())\n   118\t\t\t\t// Unpauses the progress, sends an empty MsgApp, and pauses it again.\n   119\t\t\t\tr.Step(&pb.Message{From: new(uint64(2)), To: new(uint64(1)), Type: pb.MsgHeartbeatResp.Enum()})\n   120\t\t\t\tms := r.readMessages()\n   121\t\t\t\trequire.Len(t, ms, 1)\n   122\t\t\t\trequire.Equal(t, pb.MsgApp, ms[0].GetType())\n   123\t\t\t\trequire.Empty(t, ms[0].GetEntries())\n   124\t\t\t}\n   125\t\n   126\t\t\t// No more appends are sent if there are no heartbeats.\n   127\t\t\tfor i := 0; i < 10; i++ {\n   128\t\t\t\trequire.True(t, pr2.IsPaused())\n   129\t\t\t\tr.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"somedata\")}}})\n   130\t\t\t\tms := r.readMessages()\n   131\t\t\t\trequire.Empty(t, ms)\n   132\t\t\t}\n   133\t\n   134\t\t\t// clear all pending messages.\n   135\t\t\tr.Step(&pb.Message{From: new(uint64(2)), To: new(uint64(1)), Type: pb.MsgHeartbeatResp.Enum()})\n   136\t\t\tr.readMessages()\n   137\t\t}\n   138\t}\n","exit_code":0,"status":"completed"}}
