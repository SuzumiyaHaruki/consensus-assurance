{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft && python3 - <<'EOF'\nimport json\np='update.json'\nd=json.load(open(p))\ne=d['experiment']\ne['prerequisites']=[\n {\\\"alias\\\":\\\"elect\\\",\\\"event\\\":\\\"election\\\"},\n {\\\"alias\\\":\\\"stash\\\",\\\"event\\\":\\\"readindex_received\\\",\\\"conditions\\\":[{\\\"field\\\":\\\"stashed\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True}]},\n {\\\"alias\\\":\\\"cc\\\",\\\"event\\\":\\\"confchange_applied\\\",\\\"conditions\\\":[{\\\"reference\\\":\\\"stash.case\\\"}]},\n {\\\"alias\\\":\\\"hb\\\",\\\"event\\\":\\\"heartbeat_round\\\",\\\"conditions\\\":[{\\\"reference\\\":\\\"cc.case\\\"}]},\n {\\\"alias\\\":\\\"repair\\\",\\\"event\\\":\\\"unrelated_commit\\\",\\\"conditions\\\":[{\\\"reference\\\":\\\"hb.case\\\"}]},\n]\ncaseA=\\\"apply-removal-of-unreachable-voter-4\\\"\ncaseB=\\\"apply-leave-joint-config\\\"\ndef cmp(ev,alias,field,value,ante=None,case=None,desc=\\\"\\\"):\n    c={\\\"event\\\":ev,\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":alias,\n       \\\"assertion\\\":{\\\"field\\\":field,\\\"op\\\":\\\"eq\\\",\\\"value\\\":value},\\\"description\\\":desc}\n    if ante: c[\\\"antecedent\\\"]={\\\"field\\\":ante,\\\"op\\\":\\\"eq\\\",\\\"value\\\":True}\n    if case: c[\\\"applicability_conditions\\\"]=[{\\\"field\\\":\\\"case\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":case}]\n    return c\ne['comparisons']=[\n cmp(\\\"readindex_received\\\",\\\"elect\\\",\\\"stashed\\\",True,case=caseA,\n     desc=\\\"Precondition observation: the leader postponed the received request because no entry of its term was committed (committed_entry_term 1, leader_term 2).\\\"),\n cmp(\\\"confchange_applied\\\",\\\"stash\\\",\\\"pending_reads\\\",0,ante=\\\"term_has_commit\\\",case=caseA,\n     desc=\\\"Witness: applying the committed removal of voter 4 performed the leade