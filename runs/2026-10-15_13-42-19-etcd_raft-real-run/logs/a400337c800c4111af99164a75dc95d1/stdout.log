found {\n1898\tbreak\n1899\t}\n1900\t}\n1901\tif !found {\n1902\tr.logger.Warningf(\n1903\t\"%x attempted to restore snapshot but it is not in the ConfState %v; should never happen\",\n1904\tr.id, cs,\n1905\t)\n1906\treturn false\n1907\t}\n1908\t   127\t\n1909\t// Now go ahead and actually restore.\n1910\t   129\t\n1911\tid := entryID{term: s.GetMetadata().GetTerm(), index: s.GetMetadata().GetIndex()}\n1912\tif r.raftLog.matchTerm(id) {\n1913\t// TODO(pav-kv): can print %+v of the id, but it will change the format.\n1914\tlast := r.raftLog.lastEntryID()\n1915\tr.logger.Infof(\"%x [commit: %d, lastindex: %d, lastterm: %d] fast-forwarded commit to snapshot [index: %d, term: %d]\",\n1916\tr.id, r.raftLog.committed, last.index, last.term, id.index, id.term)\n1917\tr.raftLog.commitTo(s.GetMetadata().GetIndex())\n1918\treturn false\n1919\t}\n1920\t   139\t\n1921\tr.raftLog.restore(s)\n1922\t   141\t\n1923\t// Reset the configuration and add the (potentially updated) peers in anew.\n1924\tr.trk = tracker.MakeProgressTracker(r.trk.MaxInflight, r.trk.MaxInflightBytes)\n1925\tcfg, trk, err := confchange.Restore(confchange.Changer{\n1926\tTracker:   r.trk,\n1927\tLastIndex: r.raftLog.lastIndex(),\n1928\t}, cs)\n1929\t   148\t\n1930\tif err != nil {\n1931\t// This should never happen. Either there's a bug in our config change\n1932\t// handling or the client corrupted the conf change.\n1933\tpanic(fmt.Sprintf(\"unable to restore config %+v: %s\", cs, err))\n1934\t}\n1935\t   154\t\n1936\tassertConfStatesEquivalent(r.logger, cs, r.switchToConfig(cfg, trk))\n1937\t   156\t\n1938\tlast := r.raftLog.lastEntryID()\n1939\tr.logger.Infof(\"%x [commit: %d, lastindex: %d, lastterm: %d] restored snapshot [index: %d, term: %d]\",\n1940\tr.id, r.raftLog.committed, last.index, last.term, id.index, id.term)\n1941\treturn true\n1942\t}\n1943\t   162\t\n1944\t// promotable indicates whether state machine can be promoted to leader,\n1945\t// which is true when its own id is in progress list.\n1