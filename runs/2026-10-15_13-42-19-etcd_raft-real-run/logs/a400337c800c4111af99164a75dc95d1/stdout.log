s, cs, err := c.Storage.InitialState()\n   445\t\tif err != nil {\n   446\t\t\tpanic(err) // TODO(bdarnell)\n   447\t\t}\n   448\t\n   449\t\tr := &raft{\n   450\t\t\tid:                          c.ID,\n   451\t\t\tlead:                        None,\n   452\t\t\tisLearner:                   false,\n   453\t\t\traftLog:                     raftlog,\n   454\t\t\tmaxMsgSize:                  entryEncodingSize(c.MaxSizePerMsg),\n   455\t\t\tmaxUncommittedSize:          entryPayloadSize(c.MaxUncommittedEntriesSize),\n   456\t\t\ttrk:                         tracker.MakeProgressTracker(c.MaxInflightMsgs, c.MaxInflightBytes),\n   457\t\t\telectionTimeout:             c.ElectionTick,\n   458\t\t\theartbeatTimeout:            c.HeartbeatTick,\n   459\t\t\tlogger:                      c.Logger,\n   460\t\t\tcheckQuorum:                 c.CheckQuorum,\n   461\t\t\tpreVote:                     c.PreVote,\n   462\t\t\treadOnly:                    newReadOnly(c.ReadOnlyOption),\n   463\t\t\tdisableProposalForwarding:   c.DisableProposalForwarding,\n   464\t\t\tdisableConfChangeValidation: c.DisableConfChangeValidation,\n   465\t\t\tstepDownOnRemoval:           c.StepDownOnRemoval,\n   466\t\t\ttraceLogger:                 c.TraceLogger,\n   467\t\t}\n   468\t\n   469\t\ttraceInitState(r)\n   470\t\n   471\t\tlastID := r.raftLog.lastEntryID()\n   472\t\tcfg, trk, err := confchange.Restore(confchange.Changer{\n   473\t\t\tTracker:   r.trk,\n   474\t\t\tLastIndex: lastID.index,\n   475\t\t}, cs)\n   476\t\tif err != nil {\n   477\t\t\tpanic(err)\n   478\t\t}\n   479\t\tassertConfStatesEquivalent(r.logger, cs, r.switchToConfig(cfg, trk))\n   480\t\n   481\t\tif !IsEmptyHardState(hs) {\n   482\t\t\tr.loadState(hs)\n   483\t\t}\n   484\t\tif c.Applied > 0 {\n   485\t\t\traftlog.appliedTo(c.Applied, 0 /* size */)\n   486\t\t}\n   487\t\tr.becomeFollower(r.Term, None)\n   488\t\n   489\t\tvar nodesStrs []string\n   490\t\tfor _, n := range r.trk.VoterNodes() {\n   491\t\t\tnodesStrs = append(nodesStrs, fmt.Sprintf(\"%x\", n))\n   492\t\t}\n   493\t\n   494\t\t// TODO(pav-kv): it should be ok to simply print %+v for lastID.\n   495\t\tr.logger.Infof(\"newRaft %x [peers: [%s], term: %d, commit: %d, applied: %d, lastindex: %d, lastterm: %d]\",\n   496\t\t\tr.id, strings.Join(nodesStrs, \",\"), r.Term, r.raftLog.committed, r.raftLog.applied, lastID.index, lastID.term)\n   497\t\treturn r\n   498\t}\n   499\t\n   500\tfunc (r *raft) hasLeader() bool { return r.lead != None }\n   501\t\n   502\tfunc (r *raft) softState() SoftState { return SoftState{Lead: r.lead, RaftState: r.state} }\n   503\t\n   504\tfunc (r *raft) hardState() *pb.HardState {\n   505\t\treturn &pb.HardState{\n   506\t\t\tTerm:   new(r.Term),\n   507\t\t\tVote:   new(r.Vote),\n   508\t\t\tCommit: new(r.raftLog.committed),\n   509\t\t}\n   510\t}\n   511\t\n   512\t// send schedules persisting state to a stable storage and AFTER that\n   513\t// sending the message (as part of next Ready message processing).\n   514\tfunc (r *raft) send(m *pb.Message) {\n   515\t\tif m.GetFrom() == None {\n   516\t\t\tm.From = new(r.id)\n   517\t\t}\n   518\t\tif m.GetType() == pb.MsgVote || m.GetType() == pb.MsgVoteResp || m.GetType() == pb.MsgPreVote || m.GetType() == pb.MsgPreVoteResp {\n   519\t\t\tif m.GetTerm() == 0 {\n   520\t\t\t\t// All {pre-,}campaign messages need to have the term set when\n   521\t\t\t\t// sending.\n   522\t\t\t\t// - MsgVote: m.Term is the term the node is campaigning for,\n   523\t\t\t\t//   non-zero as we increment the term when campaigning.\n   524\t\t\t\t// - MsgVoteResp: m.Term is the new r.Term if the MsgVote was\n   525\t\t\t\t//   granted, non-zero for the same reason MsgVote is\n   526\t\t\t\t// - MsgPreVote: m.Term is the term the node will campaign,\n   527\t\t\t\t//   non-zero as we use m.Term to indicate the next term we'll be\n   528\t\t\t\t//   campaigning for\n   529\t\t\t\t// - MsgPreVoteResp: m.Term is the term received in the original\n   530\t\t\t\t//   MsgPreVote if the pre-vote was granted, non-zero for the\n   531\t\t\t\t//   same reasons MsgPreVote is\n   532\t\t\t\tr.logger.Panicf(\"term should be set when sending %s\", m.GetType())\n   533\t\t\t}\n   534\t\t} else {\n   535\t\t\tif m.GetTerm() != 0 {\n   536\t\t\t\tr.logger.Panicf(\"term should not be set when sending %s (was %d)\", m.GetType(), m.GetTerm())\n   537\t\t\t}\n   538\t\t\t// do not attach term to MsgProp, MsgReadIndex\n   539\t\t\t// proposals are a way to forward to the leader and\n   540\t\t\t// should be treated as local message.\n   541\t\t\t// MsgReadIndex is also forwarded to leader.\n   542\t\t\tif m.GetType() != pb.MsgProp && m.GetType() != pb.MsgReadIndex {\n   543\t\t\t\tm.Term = new(r.Term)\n   544\t\t\t}\n   545\t\t}\n   546\t\tif m.GetType() == pb.MsgAppResp || m.GetType() == pb.MsgVoteResp || m.GetType() == pb.MsgPreVoteResp {\n   547\t\t\t// If async storage writes are enabled, messages added to the msgs slice\n   548\t\t\t// are allowed to be sent out before unstable state (e.g. log entry\n   549\t\t\t// writes and election votes) have been durably synced to the local\n   550\t\t\t// disk.\n   551\t\t\t//\n   552\t\t\t// For most message types, this is not an issue. However, response\n   553\t\t\t// messages that relate to \"voting\" on either leader election or log\n   554\t\t\t// appends require durability before they can be sent. It would be\n   555\t\t\t// incorrect to publish a vote in an election before that vote has been\n   556\t\t\t// synced to stable storage locally. Similarly, it would be incorrect to\n   557\t\t\t// acknowledge a log append to the leader before that entry has been\n   558\t\t\t// synced to stable storage locally.\n   559\t\t\t//\n   560\t\t\t// Per the Raft thesis, section 3.8 Persisted state and server restarts:\n   561\t\t\t//\n   562\t\t\t// > Raft servers must persist enough information to stable storage to\n   563\t\t\t// > survive server restarts safely. In particular, each server persists\n   564\t\t\t// > its current term and vote; this is necessary to prevent the server\n   565\t\t\t// > from voting twice in the same term or replacing log entries from a\n   566\t\t\t// > newer leader with those from a deposed leader. Each server also\n   567\t\t\t// > persists new log entries before they are counted towards the entries’\n   568\t\t\t// > commitment; this prevents committed entries from being lost or\n   569\t\t\t// > “uncommitted” when servers restart\n   570\t\t\t//\n   571\t\t\t// To enforce this durability requirement, these response messages are\n   572\t\t\t// queued to be sent out as soon as the current collection of unstable\n   573\t\t\t// state (the state that the response message was predicated upon) has\n   574\t\t\t// been durably persisted. This unstable state may have already been\n   575\t\t\t// passed to a Ready struct whose persistence is in progress or may be\n   576\t\t\t// waiting for the next Ready struct to begin being written to Storage.\n   577\t\t\t// These messages must wait for all of this state to be durable before\n   578\t\t\t// being published.\n   579\t\t\t//\n   580\t\t\t// Rejected responses (m.Reject == true) present an interesting case\n   581\t\t\t// where the durability requirement is less unambiguous. A rejection may\n   582\t\t\t// be predicated upon unstable state. For instance, a node may reject a\n   583\t\t\t// vote for one peer because it has already begun syncing its vote for\n   584\t\t\t// another peer. Or it may reject a vote from one peer because it has\n   585\t\t\t// unstable log entries that indicate that the peer is behind on its\n   586\t\t\t// log. In these cases, it is likely safe to send out the rejection\n   587\t\t\t// response immediately without compromising safety in the presence of a\n   588\t\t\t// server restart. However, because these rejections are rare and\n   589\t\t\t// because the safety of such behavior has not been formally verified,\n   590\t\t\t// we err on the side of safety and omit a `&& !m.Reject` condition\n   591\t\t\t// above.\n   592\t\t\tr.msgsAfterAppend = append(r.msgsAfterAppend, m)\n   593\t\t\ttraceSendMessage(r, m)\n   594\t\t} else {\n   595\t\t\tif m.GetTo() == r.id {\n   596\t\t\t\tr.logger.Panicf(\"message should not be self-addressed when sending %s\", m.GetType())\n   597\t\t\t}\n   598\t\t\tr.msgs = append(r.msgs, m)\n   599\t\t\ttraceSendMessage(r, m)\n   600\t\t}\n","exit_code":0,"status":"completed"}}
