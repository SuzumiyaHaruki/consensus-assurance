nil\n   126\t\treturn msgs\n   127\t}\n   128\t\n   129\tfunc (r *raft) stepOrSend(msgs []*pb.Message) error {\n   130\t\tfor _, m := range msgs {\n   131\t\t\tif m.GetTo() == r.id {\n   132\t\t\t\tif err := r.Step(m); err != nil {\n   133\t\t\t\t\treturn err\n   134\t\t\t\t}\n   135\t\t\t} else {\n   136\t\t\t\tr.msgs = append(r.msgs, m)\n   137\t\t\t}\n   138\t\t}\n   139\t\treturn nil\n   140\t}\n   141\t\n   142\tfunc TestProgressLeader(t *testing.T) {\n   143\t\ts := newTestMemoryStorage(withPeers(1, 2))\n   144\t\tr := newTestRaft(1, 5, 1, s)\n   145\t\tr.becomeCandidate()\n   146\t\tr.becomeLeader()\n   147\t\tr.trk.Progress[2].BecomeReplicate()\n   148\t\n   149\t\t// Send proposals to r1. The first 5 entries should be queued in the unstable log.\n   150\t\tpropMsg := &pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgProp.Enum(), Entries: []*pb.Entry{{Data: []byte(\"foo\")}}}\n   151\t\tfor i := 0; i < 5; i++ {\n   152\t\t\trequire.NoError(t, r.Step(propMsg), \"#%d\", i)\n   153\t\t}\n   154\t\n   155\t\trequire.Zero(t, r.trk.Progress[1].Match)\n   156\t\n   157\t\tents := r.raftLog.nextUnstableEnts()\n   158\t\trequire.Len(t, ents, 6)\n   159\t\trequire.Len(t, ents[0].GetData(), 0)\n   160\t\trequire.Equal(t, \"foo\", string(ents[5].GetData()))\n   161\t\n   162\t\tr.advanceMessagesAfterAppend()\n   163\t\n   164\t\trequire.Equal(t, uint64(6), r.trk.Progress[1].Match)\n   165\t\trequire.Equal(t, uint64(7), r.trk.Progress[1].Next)\n   166\t}\n   167\t\n   168\t// TestProgressResumeByHeartbeatResp ensures raft.heartbeat reset progress.paused by heartbeat response.\n   169\tfunc TestProgressResumeByHeartbeatResp(t *testing.T) {\n   170\t\tr := newTestRaft(1, 5, 1, newTestMemoryStorage(withPeers(1, 2)))\n====\n  4028\ttype network struct {\n  4029\t\tt *testing.T // optional\n  4030\t\n  4031\t\tpeers   map[uint64]stateMachine\n  4032\t\tstorage map[uint64]*MemoryStorage\n  4033\t\tdropm   map[connem]float64\n  4034\t\tignorem map[pb.MessageType]bool\n  4035\t\n  4036\t\t// msgHook is called for each message sent. It may inspect the\n  4037\t\t// message and return true to send it or false to drop it.\n  4038\t\tmsgHook func(*pb.Message) bool\n  4039\t}\n  4040\t\n  4041\t// newNetwork initializes a network from peers.\n  4042\t// A nil node will be replaced with a new *stateMachine.\n  4043\t// A *stateMachine will get its k, id.\n  4044\t// When using stateMachine, the address list is always [1, n].\n  4045\tfunc newNetwork(peers ...stateMachine) *network {\n  4046\t\treturn newNetworkWithConfig(nil, peers...)\n  4047\t}\n  4048\t\n  4049\t// newNetworkWithConfig is like newNetwork but calls the given func to\n  4050\t// modify the configuration of any state machines it creates.\n  4051\tfunc newNetworkWithConfig(configFunc func(*Config), peers ...stateMachine) *network {\n  4052\t\tsize := len(peers)\n  4053\t\tpeerAddrs := idsBySize(size)\n  4054\t\n  4055\t\tnpeers := make(map[uint64]stateMachine, size)\n  4056\t\tnstorage := make(map[uint64]*MemoryStorage, size)\n  4057\t\n  4058\t\tfor j, p := range peers {\n  4059\t\t\tid := peerAddrs[j]\n  4060\t\t\tswitch v := p.(type) {\n  4061\t\t\tcase nil:\n  4062\t\t\t\tnstorage[id] = newTestMemoryStorage(withPeers(peerAddrs...))\n  4063\t\t\t\tcfg := newTestConfig(id, 10, 1, nstorage[id])\n  4064\t\t\t\tif configFunc != nil {\n  4065\t\t\t\t\tconfigFunc(cfg)\n  4066\t\t\t\t}\n  4067\t\t\t\tsm := newRaft(cfg)\n  4068\t\t\t\tnpeers[id] = sm\n  4069\t\t\tcase *raft:\n  4070\t\t\t\t// TODO(tbg): this is all pretty confused. Clean this up.\n  4071\t\t\t\tlearners := make(map[uint64]bool, len(v.trk.Learners))\n  4072\t\t\t\tfor i := range v.trk.Learners {\n  4073\t\t\t\t\tlearners[i] = true\n  4074\t\t\t\t}\n  4075\t\t\t\tv.id = id\n  4076\t\t\t\tv.trk = tracker.MakeProgressTracker(v.trk.MaxInflight, v.trk.MaxInflightBytes)\n  4077\t\t\t\tif len(learners) > 0 {\n  4078\t\t\t\t\tv.trk.Learners = map[uint64]struct{}{}\n  4079\t\t\t\t}\n  4080\t\t\t\tfor i := 0; i < size; i++ {\n  4081\t\t\t\t\tpr := &tracker.Progress{}\n  4082\t\t\t\t\tif _, ok := learners[peerAddrs[i]]; ok {\n  4083\t\t\t\t\t\tpr.IsLearner = true\n  4084\t\t\t\t\t\tv.trk.Learners[peerAddrs[i]] = struct{}{}\n  4085\t\t\t\t\t} else {\n  4086\t\t\t\t\t\tv.trk.Voters[0][peerAddrs[i]] = struct{}{}\n  4087\t\t\t\t\t}\n  4088\t\t\t\t\tv.trk.Progress[peerAddrs[i]] = pr\n  4089\t\t\t\t}\n  4090\t\t\t\tv.reset(v.Term)\n  4091\t\t\t\tnpeers[id] = v\n  4092\t\t\tcase *blackHole:\n  4093\t\t\t\tnpeers[id] = v\n  4094\t\t\tdefault:\n  4095\t\t\t\tpanic(fmt.Sprintf(\"unexpected state machine type: %T\", p))\n  4096\t\t\t}\n  4097\t\t}\n  4098\t\treturn &network{\n  4099\t\t\tpeers:   npeers,\n  4100\t\t\tstorage: nstorage,\n  4101\t\t\tdropm:   make(map[connem]float64),\n  4102\t\t\tignorem: make(map[pb.MessageType]bool),\n  4103\t\t}\n  4104\t}\n  4105\t\n  4106\tfunc preVoteConfig(c *Config) {\n  4107\t\tc.PreVote = true\n  4108\t}\n  4109\t\n  4110\tfunc (nw *network) send(msgs ...*pb.Message) {\n  4111\t\tfor len(msgs) > 0 {\n  4112\t\t\tm := msgs[0]\n  4113\t\t\tp := nw.peers[m.GetTo()]\n  4114\t\t\tif nw.t != nil {\n  4115\t\t\t\tnw.t.Log(DescribeMessage(m, nil))\n  4116\t\t\t}\n  4117\t\t\t_ = p.Step(m)\n  4118\t\t\tp.advanceMessagesAfterAppend()\n  4119\t\t\tmsgs = append(msgs[1:], nw.filter(p.readMessages())...)\n  4120\t\t}\n  4121\t}\n  4122\t\n  4123\tfunc (nw *network) drop(from, to uint64, perc float64) {\n  4124\t\tnw.dropm[connem{from, to}] = perc\n  4125\t}\n  4126\t\n  4127\tfunc (nw *network) cut(one, other uint64) {\n  4128\t\tnw.drop(one, other, 2.0) // always drop\n  4129\t\tnw.drop(other, one, 2.0) // always drop\n  4130\t}\n  4131\t\n  4132\tfunc (nw *network) isolate(id uint64) {\n  4133\t\tfor i := 0; i < len(nw.peers); i++ {\n  4134\t\t\tnid := uint64(i) + 1\n  4135\t\t\tif nid != id {\n  4136\t\t\t\tnw.drop(id, nid, 1.0) // always drop\n  4137\t\t\t\tnw.drop(nid, id, 1.0) // always drop\n  4138\t\t\t}\n  4139\t\t}\n  4140\t}\n  4141\t\n  4142\tfunc (nw *network) ignore(t pb.MessageType) {\n  4143\t\tnw.ignorem[t] = true\n  4144\t}\n  4145\t\n  4146\tfunc (nw *network) recover() {\n  4147\t\tnw.dropm = make(map[connem]float64)\n  4148\t\tnw.ignorem = make(map[pb.MessageType]bool)\n  4149\t}\n  4150\t\n  4151\tfunc (nw *network) filter(msgs []*pb.Message) []*pb.Message {\n  4152\t\tvar mm []*pb.Message\n  4153\t\tfor _, m := range msgs {\n  4154\t\t\tif nw.ignorem[m.GetType()] {\n  4155\t\t\t\tcontinue\n  4156\t\t\t}\n  4157\t\t\tswitch m.GetType() {\n  4158\t\t\tcase pb.MsgHup:\n  4159\t\t\t\t// hups never go over the network, so don't drop them but panic\n  4160\t\t\t\tpanic(\"unexpected msgHup\")\n  4161\t\t\tdefault:\n  4162\t\t\t\tperc := nw.dropm[connem{m.GetFrom(), m.GetTo()}]\n  4163\t\t\t\tif n := rand.Float64(); n < perc {\n  4164\t\t\t\t\tcontinue\n  4165\t\t\t\t}\n  4166\t\t\t}\n  4167\t\t\tif nw.msgHook != nil {\n  4168\t\t\t\tif !nw.msgHook(m) {\n  4169\t\t\t\t\tcontinue\n  4170\t\t\t\t}\n  4171\t\t\t}\n  4172\t\t\tmm = append(mm, m)\n  4173\t\t}\n  4174\t\treturn mm\n  4175\t}\n  4176\t\n  4177\ttype connem struct {\n  4178\t\tfrom, to uint64\n  4179\t}\n  4180\t\n  4181\ttype blackHole struct{}\n  4182\t\n  4183\tfunc (blackHole) Step(*pb.Message) error      { return nil }\n  4184\tfunc (blackHole) readMessages() []*pb.Message { return nil }\n  4185\tfunc (blackHole) advanceMessagesAfterAppend() {}\n  4186\t\n  4187\tvar nopStepper = &blackHole{}\n  4188\t\n  4189\tfunc idsBySize(size int) []uint64 {\n  4190\t\tids := make([]uint64, size)\n  4191\t\tfor i := 0; i < size; i++ {\n  4192\t\t\tids[i] = 1 + uint64(i)\n  4193\t\t}\n  4194\t\treturn ids\n  4195\t}\n  4196\t\n  4197\t// setRandomizedElectionTimeout set up the value by caller instead of choosing\n  4198\t// by system, in some test scenario we need to fill in some expected value to\n  4199\t// ensure the certainty\n  4200\tfunc setRandomizedElectionTimeout(r *raft, v int) {\n  4201\t\tr.randomizedElectionTimeout = v\n  4202\t}\n  4203\t\n  4204\t// SetRandomizedElectionTimeout is like setRandomizedElectionTimeout, but\n  4205\t// exported for use by tests that are not in the raft package, using RawNode.\n  4206\tfunc SetRandomizedElectionTimeout(r *RawNode, v int) {\n  4207\t\tsetRandomizedElectionTimeout(r.raft, v)\n  4208\t}\n  4209\t\n  4210\tfunc newTestConfig(id uint64, election, heartbeat int, storage Storage) *Config {\n  4211\t\treturn &Config{\n  4212\t\t\tID:              id,\n  4213\t\t\tElectionTick:    election,\n  4214\t\t\tHeartbeatTick:   heartbeat,\n  4215\t\t\tStorage:         storage,\n","exit_code":0,"status":"completed"}}
