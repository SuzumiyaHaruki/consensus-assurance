{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/agent-source && cat -n rawnode.go'","aggregated_output":"     1\t// Copyright 2015 The etcd Authors\n     2\t//\n     3\t// Licensed under the Apache License, Version 2.0 (the \"License\");\n     4\t// you may not use this file except in compliance with the License.\n     5\t// You may obtain a copy of the License at\n     6\t//\n     7\t//     http://www.apache.org/licenses/LICENSE-2.0\n     8\t//\n     9\t// Unless required by applicable law or agreed to in writing, software\n    10\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n    11\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n    12\t// See the License for the specific language governing permissions and\n    13\t// limitations under the License.\n    14\t\n    15\tpackage raft\n    16\t\n    17\timport (\n    18\t\t\"errors\"\n    19\t\n    20\t\tpb \"go.etcd.io/raft/v3/raftpb\"\n    21\t\t\"go.etcd.io/raft/v3/tracker\"\n    22\t)\n    23\t\n    24\t// ErrStepLocalMsg is returned when try to step a local raft message\n    25\tvar ErrStepLocalMsg = errors.New(\"raft: cannot step raft local message\")\n    26\t\n    27\t// ErrStepPeerNotFound is returned when try to step a response message\n    28\t// but there is no peer found in raft.trk for that node.\n    29\tvar ErrStepPeerNotFound = errors.New(\"raft: cannot step as peer not found\")\n    30\t\n    31\t// RawNode is a thread-unsafe Node.\n    32\t// The methods of this struct correspond to the methods of Node and are described\n    33\t// more fully there.\n    34\ttype RawNode struct {\n    35\t\traft               *raft\n    36\t\tasyncStorageWrites bool\n    37\t\n    38\t\t// Mutable fields.\n    39\t\tprevSoftSt     *SoftState\n    40\t\tprevHardSt     *pb.HardState\n    41\t\tstepsOnAdvance []*pb.Message\n    42\t}\n    43\t\n    44\t// NewRawNode instantiates a RawNode from the given configuration.\n    45\t//\n    46\t// See Bootstrap() for bootstrapping an initial state; this replaces the former\n    47\t// 'peers' argument to this method (with identical behavior). However, It is\n    48\t// recommended that instead of calling Bootstrap, applications bootstrap their\n    49\t// state manually by setting up a Storage that has a first index > 1 and which\n    50\t// stores the desired ConfState as its InitialState.\n    51\tfunc NewRawNode(config *Config) (*RawNode, error) {\n    52\t\tr := newRaft(config)\n    53\t\trn := &RawNode{\n    54\t\t\traft: r,\n    55\t\t}\n    56\t\trn.asyncStorageWrites = config.AsyncStorageWrites\n    57\t\tss := r.softState()\n    58\t\trn.prevSoftSt = &ss\n    59\t\trn.prevHardSt = r.hardState()\n    60\t\treturn rn, nil\n    61\t}\n    62\t\n    63\t// Tick advances the internal logical clock by a single tick.\n    64\tfunc (rn *RawNode) Tick() {\n    65\t\trn.raft.tick()\n    66\t}\n    67\t\n    68\t// TickQuiesced advances the internal logical clock by a single tick without\n    69\t// performing any other state machine processing. It allows the caller to avoid\n    70\t// periodic heartbeats and elections when all of the peers in a Raft group are\n    71\t// known to be at the same state. Expected usage is to periodically invoke Tick\n    72\t// or TickQuiesced depending on whether the group is \"active\" or \"quiesced\".\n    73\t//\n    74\t// WARNING: Be very careful about using this method as it subverts the Raft\n    75\t// state machine. You should probably be using Tick instead.\n    76\t//\n    77\t// DEPRECATED: This method will be removed in a future release.\n    78\tfunc (rn *RawNode) TickQuiesced() {\n    79\t\trn.raft.electionElapsed++\n    80\t}\n    81\t\n    82\t// Campaign causes this RawNode to transition to candidate state.\n    83\tfunc (rn *RawNode) Campaign() error {\n    84\t\treturn rn.raft.Step(&pb.Message{\n    85\t\t\tType: pb.MsgHup.Enum(),\n    86\t\t})\n    87\t}\n    88\t\n    89\t// Propose proposes data be appended to the raft log.\n    90\tfunc (rn *RawNode) Propose(data []byte) error {\n    91\t\treturn rn.raft.Step(&pb.Message{\n    92\t\t\tType:    pb.MsgProp.Enum(),\n    93\t\t\tFrom:    new(rn.raft.id),\n    94\t\t\tEntries: []*pb.Entry{{Data: data}},\n    95\t\t})\n    96\t}\n    97\t\n    98\t// ProposeConfChange proposes a config change. See (Node).ProposeConfChange for\n    99\t// details.\n   100\tfunc (rn *RawNode) ProposeConfChange(cc pb.ConfChangeI) error {\n   101\t\tm, err := confChangeToMsg(cc)\n   102\t\tif err != nil {\n   103\t\t\treturn err\n   104\t\t}\n   105\t\treturn rn.raft.Step(m)\n   106\t}\n   107\t\n   108\t// ApplyConfChange applies a config change to the local node. The app must call\n   109\t// this when it applies a configuration change, except when it decides to reject\n   110\t// the configuration change, in which case no call must take place.\n   111\tfunc (rn *RawNode) ApplyConfChange(cc pb.ConfChangeI) *pb.ConfState {\n   112\t\treturn rn.raft.applyConfChange(cc.AsV2())\n   113\t}\n   114\t\n   115\t// Step advances the state machine using the given message.\n   116\tfunc (rn *RawNode) Step(m *pb.Message) error {\n   117\t\t// Ignore unexpected local messages receiving over network.\n   118\t\tif IsLocalMsg(m.GetType()) && !IsLocalMsgTarget(m.GetFrom()) {\n   119\t\t\treturn ErrStepLocalMsg\n   120\t\t}\n   121\t\tif IsResponseMsg(m.GetType()) && !IsLocalMsgTarget(m.GetFrom()) && rn.raft.trk.Progress[m.GetFrom()] == nil {\n   122\t\t\treturn ErrStepPeerNotFound\n   123\t\t}\n   124\t\treturn rn.raft.Step(m)\n   125\t}\n   126\t\n   127\t// Ready returns the outstanding work that the application needs to handle. This\n   128\t// includes appending and applying entries or a snapshot, updating the HardState,\n   129\t// and sending messages. The returned Ready() *must* be handled and subsequently\n   130\t// passed back via Advance().\n   131\tfunc (rn *RawNode) Ready() Ready {\n   132\t\trd := rn.readyWithoutAccept()\n   133\t\trn.acceptReady(rd)\n   134\t\treturn rd\n   135\t}\n   136\t\n   137\t// readyWithoutAccept returns a Ready. This is a read-only operation, i.e. there\n   138\t// is no obligation that the Ready must be handled.\n   139\tfunc (rn *RawNode) readyWithoutAccept() Ready {\n   140\t\tr := rn.raft\n   141\t\n   142\t\trd := Ready{\n   143\t\t\tEntries:          r.raftLog.nextUnstableEnts(),\n   144\t\t\tCommittedEntries: r.raftLog.nextCommittedEnts(rn.applyUnstableEntries()),\n   145\t\t\tMessages:         r.msgs,\n   146\t\t}\n   147\t\tif softSt := r.softState(); !softSt.equal(rn.prevSoftSt) {\n   148\t\t\t// Allocate only when SoftState changes.\n   149\t\t\tescapingSoftSt := softSt\n   150\t\t\trd.SoftState = &escapingSoftSt\n   151\t\t}\n   152\t\tif hardSt := r.hardState(); !isHardStateEqual(hardSt, rn.prevHardSt) {\n   153\t\t\trd.HardState = hardSt\n   154\t\t}\n   155\t\tif r.raftLog.hasNextUnstableSnapshot() {\n   156\t\t\trd.Snapshot = r.raftLog.nextUnstableSnapshot()\n   157\t\t}\n   158\t\tif len(r.readStates) != 0 {\n   159\t\t\trd.ReadStates = r.readStates\n   160\t\t}\n   161\t\trd.MustSync = MustSync(r.hardState(), rn.prevHardSt, len(rd.Entries))\n   162\t\n   163\t\tif rn.asyncStorageWrites {\n   164\t\t\t// If async storage writes are enabled, enqueue messages to\n   165\t\t\t// local storage threads, where applicable.\n   166\t\t\tif needStorageAppendMsg(r, rd) {\n   167\t\t\t\tm := newStorageAppendMsg(r, rd)\n   168\t\t\t\trd.Messages = append(rd.Messages, m)\n   169\t\t\t}\n   170\t\t\tif needStorageApplyMsg(rd) {\n   171\t\t\t\tm := newStorageApplyMsg(r, rd)\n   172\t\t\t\trd.Messages = append(rd.Messages, m)\n   173\t\t\t}\n   174\t\t} else {\n   175\t\t\t// If async storage writes are disabled, immediately enqueue\n   176\t\t\t// msgsAfterAppend to be sent out. The Ready struct contract\n   177\t\t\t// mandates that Messages cannot be sent until after Entries\n   178\t\t\t// are written to stable storage.\n   179\t\t\tfor _, m := range r.msgsAfterAppend {\n   180\t\t\t\tif m.GetTo() != r.id {\n   181\t\t\t\t\trd.Messages = append(rd.Messages, m)\n   182\t\t\t\t}\n   183\t\t\t}\n   184\t\t}\n   185\t\n   186\t\treturn rd\n   187\t}\n   188\t\n   189\t// MustSync returns true if the hard state and count of Raft entries indicate\n   190\t// that a synchronous write to persistent storage is required.\n   191\tfunc MustSync(st, prevst *pb.HardState, entsnum int) bool {\n   192\t\t// Persistent state on all servers:\n   193\t\t// (Updated on stable storage before responding to RPCs)\n   194\t\t// currentTerm\n   195\t\t// votedFor\n   196\t\t// log entries[]\n   197\t\treturn entsnum != 0 || st.GetVote() != prevst.GetVote() || st.GetTerm() != prevst.GetTerm()\n   198\t}\n   199\t\n   200\tfunc needStorageAppendMsg(r *raft, rd Ready) bool {\n   201\t\t// Return true if log entries, hard state, or a snapshot need to be written\n   202\t\t// to stable storage. Also return true if any messages are contingent on all\n   203\t\t// prior MsgStorageAppend being processed.\n   204\t\treturn len(rd.Entries) > 0 ||\n   205\t\t\t!IsEmptyHardState(rd.HardState) ||\n   206\t\t\t!IsEmptySnap(rd.Snapshot) ||\n   207\t\t\tlen(r.msgsAfterAppend) > 0\n   208\t}\n   209\t\n   210\tfunc needStorageAppendRespMsg(r *raft, rd Ready) bool {\n   211\t\t// Return true if raft needs to hear about stabilized entries or an applied\n   212\t\t// snapshot. See the comment in newStorageAppendRespMsg, which explains why\n   213\t\t// we check hasNextOrInProgressUnstableEnts instead of len(rd.Entries) > 0.\n   214\t\treturn r.raftLog.hasNextOrInProgressUnstableEnts() ||\n   215\t\t\t!IsEmptySnap(rd.Snapshot)\n   216\t}\n   217\t\n   218\t// newStorageAppendMsg creates the message that should be sent to the local\n   219\t// append thread to instruct it to append log entries, write an updated hard\n   220\t// state, and apply a snapshot. The message also carries a set of responses\n   221\t// that should be delivered after the rest of the message is processed. Used\n   222\t// with AsyncStorageWrites.\n   223\tfunc newStorageAppendMsg(r *raft, rd Ready) *pb.Message {\n   224\t\tm := &pb.Message{\n   225\t\t\tType:    pb.MsgStorageAppend.Enum(),\n   226\t\t\tTo:      new(LocalAppendThread),\n   227\t\t\tFrom:    new(r.id),\n   228\t\t\tEntries: rd.Entries,\n   229\t\t}\n   230\t\tif !IsEmptyHardState(rd.HardState) {\n   231\t\t\t// If the Ready includes a HardState update, assign each of its fields\n   232\t\t\t// to the corresponding fields in the Message. This allows clients to\n   233\t\t\t// reconstruct the HardState and save it to stable storage.\n   234\t\t\t//\n   235\t\t\t// If the Ready does not include a HardState update, make sure to not\n   236\t\t\t// assign a value to any of the fields so that a HardState reconstructed\n   237\t\t\t// from them will be empty (return true from raft.IsEmptyHardState).\n   238\t\t\tm.Term = new(rd.GetTerm())\n   239\t\t\tm.Vote = new(rd.GetVote())\n   240\t\t\tm.Commit = new(rd.GetCommit())\n   241\t\t}\n   242\t\tif !IsEmptySnap(rd.Snapshot) {\n   243\t\t\tm.Snapshot = rd.Snapshot\n   244\t\t}\n   245\t\t// Attach all messages in msgsAfterAppend as responses to be delivered after\n   246\t\t// the message is processed, along with a self-directed MsgStorageAppendResp\n   247\t\t// to acknowledge the entry stability.\n   248\t\t//\n   249\t\t// NB: it is important for performance that MsgStorageAppendResp message be\n   250\t\t// handled after self-directed MsgAppResp messages on the leader (which will\n   251\t\t// be contained in msgsAfterAppend). This ordering allows the MsgAppResp\n   252\t\t// handling to use a fast-path in r.raftLog.term() before the newly appended\n   253\t\t// entries are removed from the unstable log.\n   254\t\tm.Responses = r.msgsAfterAppend\n   255\t\tif needStorageAppendRespMsg(r, rd) {\n   256\t\t\tresp := newStorageAppendRespMsg(r, rd)\n   257\t\t\tm.Responses = append(m.GetResponses(), resp)\n   258\t\t}\n   259\t\treturn m\n   260\t}\n   261\t\n   262\t// newStorageAppendRespMsg creates the message that should be returned to node\n   263\t// after the unstable log entries, hard state, and snapshot in the current Ready\n   264\t// (along with those in all prior Ready structs) have been saved to stable\n   265\t// storage.\n   266\tfunc newStorageAppendRespMsg(r *raft, rd Ready) *pb.Message {\n   267\t\tm := &pb.Message{\n   268\t\t\tType: pb.MsgStorageAppendResp.Enum(),\n   269\t\t\tTo:   new(r.id),\n   270\t\t\tFrom: new(LocalAppendThread),\n   271\t\t\t// Dropped after term change, see below.\n   272\t\t\tTerm: new(r.Term),\n   273\t\t}\n   274\t\tif r.raftLog.hasNextOrInProgressUnstableEnts() {\n   275\t\t\t// If the raft log has unstable entries, attach the last index and term of the\n   276\t\t\t// append to the response message. This (index, term) tuple will be handed back\n   277\t\t\t// and consulted when the stability of those log entries is signaled to the\n   278\t\t\t// unstable. If the (index, term) match the unstable log by the time the\n   279\t\t\t// response is received (unstable.stableTo), the unstable log can be truncated.\n   280\t\t\t//\n   281\t\t\t// However, with just this logic, there would be an ABA problem[^1] that could\n   282\t\t\t// lead to the unstable log and the stable log getting out of sync temporarily\n   283\t\t\t// and leading to an inconsistent view. Consider the following example with 5\n   284\t\t\t// nodes, A B C D E:\n   285\t\t\t//\n   286\t\t\t//  1. A is the leader.\n   287\t\t\t//  2. A proposes some log entries but only B receives these entries.\n   288\t\t\t//  3. B gets the Ready and the entries are appended asynchronously.\n   289\t\t\t//  4. A crashes and C becomes leader after getting a vote from D and E.\n   290\t\t\t//  5. C proposes some log entries and B receives these entries, overwriting the\n   291\t\t\t//     previous unstable log entries that are in the process of being appended.\n   292\t\t\t//     The entries have a larger term than the previous entries but the same\n   293\t\t\t//     indexes. It begins appending these new entries asynchronously.\n   294\t\t\t//  6. C crashes and A restarts and becomes leader again after getting the vote\n   295\t\t\t//     from D and E.\n   296\t\t\t//  7. B receives the entries from A which are the same as the ones from step 2,\n   297\t\t\t//     overwriting the previous unstable log entries that are in the process of\n   298\t\t\t//     being appended from step 5. The entries have the original terms and\n   299\t\t\t//     indexes from step 2. Recall that log entries retain their original term\n   300\t\t\t//     numbers when a leader replicates entries from previous terms. It begins\n   301\t\t\t//     appending these new entries asynchronously.\n   302\t\t\t//  8. The asynchronous log appends from the first Ready complete and stableTo\n   303\t\t\t//     is called.\n   304\t\t\t//  9. However, the log entries from the second Ready are still in the\n   305\t\t\t//     asynchronous append pipeline and will overwrite (in stable storage) the\n   306\t\t\t//     entries from the first Ready at some future point. We can't truncate the\n   307\t\t\t//     unstable log yet or a future read from Storage might see the entries from\n   308\t\t\t//     step 5 before they have been replaced by the entries from step 7.\n   309\t\t\t//     Instead, we must wait until we are sure that the entries are stable and\n   310\t\t\t//     that no in-progress appends might overwrite them before removing entries\n   311\t\t\t//     from the unstable log.\n   312\t\t\t//\n   313\t\t\t// To prevent these kinds of problems, we also attach the current term to the\n   314\t\t\t// MsgStorageAppendResp (above). If the term has changed by the time the\n   315\t\t\t// MsgStorageAppendResp if returned, the response is ignored and the unstable\n   316\t\t\t// log is not truncated. The unstable log is only truncated when the term has\n   317\t\t\t// remained unchanged from the time that the MsgStorageAppend was sent to the\n   318\t\t\t// time that the MsgStorageAppendResp is received, indicating that no-one else\n   319\t\t\t// is in the process of truncating the stable log.\n   320\t\t\t//\n   321\t\t\t// However, this replaces a correctness problem with a liveness problem. If we\n   322\t\t\t// only attempted to truncate the unstable log when appending new entries but\n   323\t\t\t// also occasionally dropped these responses, then quiescence of new log entries\n   324\t\t\t// could lead to the unstable log never being truncated.\n   325\t\t\t//\n   326\t\t\t// To combat this, we attempt to truncate the log on all MsgStorageAppendResp\n   327\t\t\t// messages where the unstable log is not empty, not just those associated with\n   328\t\t\t// entry appends. This includes MsgStorageAppendResp messages associated with an\n   329\t\t\t// updated HardState, which occur after a term change.\n   330\t\t\t//\n   331\t\t\t// In other words, we set Index and LogTerm in a block that looks like:\n   332\t\t\t//\n   333\t\t\t//  if r.raftLog.hasNextOrInProgressUnstableEnts() { ... }\n   334\t\t\t//\n   335\t\t\t// not like:\n   336\t\t\t//\n   337\t\t\t//  if len(rd.Entries) > 0 { ... }\n   338\t\t\t//\n   339\t\t\t// To do so, we attach r.raftLog.lastIndex() and r.raftLog.lastTerm(), not the\n   340\t\t\t// (index, term) of the last entry in rd.Entries. If rd.Entries is not empty,\n   341\t\t\t// these will be the same. However, if rd.Entries is empty, we still want to\n   342\t\t\t// attest that this (index, term) is correct at the current term, in case the\n   343\t\t\t// MsgStorageAppend that contained the last entry in the unstable slice carried\n   344\t\t\t// an earlier term and was dropped.\n   345\t\t\t//\n   346\t\t\t// A MsgStorageAppend with a new term is emitted on each term change. This is\n   347\t\t\t// the same condition that causes MsgStorageAppendResp messages with earlier\n   348\t\t\t// terms to be ignored. As a result, we are guaranteed that, assuming a bounded\n   349\t\t\t// number of term changes, there will eventually be a MsgStorageAppendResp\n   350\t\t\t// message that is not ignored. This means that entries in the unstable log\n   351\t\t\t// which have been appended to stable storage will eventually be truncated and\n   352\t\t\t// dropped from memory.\n   353\t\t\t//\n   354\t\t\t// [^1]: https://en.wikipedia.org/wiki/ABA_problem\n   355\t\t\tlast := r.raftLog.lastEntryID()\n   356\t\t\tm.Index = new(last.index)\n   357\t\t\tm.LogTerm = new(last.term)\n   358\t\t}\n   359\t\tif !IsEmptySnap(rd.Snapshot) {\n   360\t\t\tm.Snapshot = rd.Snapshot\n   361\t\t}\n   362\t\treturn m\n   363\t}\n   364\t\n   365\tfunc needStorageApplyMsg(rd Ready) bool     { return len(rd.CommittedEntries) > 0 }\n   366\tfunc needStorageApplyRespMsg(rd Ready) bool { return needStorageApplyMsg(rd) }\n   367\t\n   368\t// newStorageApplyMsg creates the message that should be sent to the local\n   369\t// apply thread to instruct it to apply committed log entries. The message\n   370\t// also carries a response that should be delivered after the rest of the\n   371\t// message is processed. Used with AsyncStorageWrites.\n   372\tfunc newStorageApplyMsg(r *raft, rd Ready) *pb.Message {\n   373\t\tents := rd.CommittedEntries\n   374\t\treturn &pb.Message{\n   375\t\t\tType:      pb.MsgStorageApply.Enum(),\n   376\t\t\tTo:        new(LocalApplyThread),\n   377\t\t\tFrom:      new(r.id),\n   378\t\t\tTerm:      new(uint64(0)), // committed entries don't apply under a specific term\n   379\t\t\tEntries:   ents,\n   380\t\t\tResponses: []*pb.Message{newStorageApplyRespMsg(r, ents)},\n   381\t\t}\n   382\t}\n   383\t\n   384\t// newStorageApplyRespMsg creates the message that should be returned to node\n   385\t// after the committed entries in the current Ready (along with those in all\n   386\t// prior Ready structs) have been applied to the local state machine.\n   387\tfunc newStorageApplyRespMsg(r *raft, ents []*pb.Entry) *pb.Message {\n   388\t\treturn &pb.Message{\n   389\t\t\tType:    pb.MsgStorageApplyResp.Enum(),\n   390\t\t\tTo:      new(r.id),\n   391\t\t\tFrom:    new(LocalApplyThread),\n   392\t\t\tTerm:    new(uint64(0)), // committed entries don't apply under a specific term\n   393\t\t\tEntries: ents,\n   394\t\t}\n   395\t}\n   396\t\n   397\t// acceptReady is called when the consumer of the RawNode has decided to go\n   398\t// ahead and handle a Ready. Nothing must alter the state of the RawNode between\n   399\t// this call and the prior call to Ready().\n   400\tfunc (rn *RawNode) acceptReady(rd Ready) {\n   401\t\tif rd.SoftState != nil {\n   402\t\t\trn.prevSoftSt = rd.SoftState\n   403\t\t}\n   404\t\tif !IsEmptyHardState(rd.HardState) {\n   405\t\t\trn.prevHardSt = rd.HardState\n   406\t\t}\n   407\t\tif len(rd.ReadStates) != 0 {\n   408\t\t\trn.raft.readStates = nil\n   409\t\t}\n   410\t\tif !rn.asyncStorageWrites {\n   411\t\t\tif len(rn.stepsOnAdvance) != 0 {\n   412\t\t\t\trn.raft.logger.Panicf(\"two accepted Ready structs without call to Advance\")\n   413\t\t\t}\n   414\t\t\tfor _, m := range rn.raft.msgsAfterAppend {\n   415\t\t\t\tif m.GetTo() == rn.raft.id {\n   416\t\t\t\t\trn.stepsOnAdvance = append(rn.stepsOnAdvance, m)\n   417\t\t\t\t}\n   418\t\t\t}\n   419\t\t\tif needStorageAppendRespMsg(rn.raft, rd) {\n   420\t\t\t\tm := newStorageAppendRespMsg(rn.raft, rd)\n   421\t\t\t\trn.stepsOnAdvance = append(rn.stepsOnAdvance, m)\n   422\t\t\t}\n   423\t\t\tif needStorageApplyRespMsg(rd) {\n   424\t\t\t\tm := newStorageApplyRespMsg(rn.raft, rd.CommittedEntries)\n   425\t\t\t\trn.stepsOnAdvance = append(rn.stepsOnAdvance, m)\n   426\t\t\t}\n   427\t\t}\n   428\t\trn.raft.msgs = nil\n   429\t\trn.raft.msgsAfterAppend = nil\n   430\t\trn.raft.raftLog.acceptUnstable()\n   431\t\tif len(rd.CommittedEntries) > 0 {\n   432\t\t\tents := rd.CommittedEntries\n   433\t\t\tindex := ents[len(ents)-1].GetIndex()\n   434\t\t\trn.raft.raftLog.acceptApplying(index, entsSize(ents), rn.applyUnstableEntries())\n   435\t\t}\n   436\t\n   437\t\ttraceReady(rn.raft)\n   438\t}\n   439\t\n   440\t// applyUnstableEntries returns whether entries are allowed to be applied once\n   441\t// they are known to be committed but before they have been written locally to\n   442\t// stable storage.\n   443\tfunc (rn *RawNode) applyUnstableEntries() bool {\n   444\t\treturn !rn.asyncStorageWrites\n   445\t}\n   446\t\n   447\t// HasReady called when RawNode user need to check if any Ready pending.\n   448\tfunc (rn *RawNode) HasReady() bool {\n   449\t\t// TODO(nvanbenschoten): order these cases in terms of cost and frequency.\n   450\t\tr := rn.raft\n   451\t\tif softSt := r.softState(); !softSt.equal(rn.prevSoftSt) {\n   452\t\t\treturn true\n   453\t\t}\n   454\t\tif hardSt := r.hardState(); !IsEmptyHardState(hardSt) && !isHardStateEqual(hardSt, rn.prevHardSt) {\n   455\t\t\treturn true\n   456\t\t}\n   457\t\tif r.raftLog.hasNextUnstableSnapshot() {\n   458\t\t\treturn true\n   459\t\t}\n   460\t\tif len(r.msgs) > 0 || len(r.msgsAfterAppend) > 0 {\n   461\t\t\treturn true\n   462\t\t}\n   463\t\tif r.raftLog.hasNextUnstableEnts() || r.raftLog.hasNextCommittedEnts(rn.applyUnstableEntries()) {\n   464\t\t\treturn true\n   465\t\t}\n   466\t\tif len(r.readStates) != 0 {\n   467\t\t\treturn true\n   468\t\t}\n   469\t\treturn false\n   470\t}\n   471\t\n   472\t// Advance notifies the RawNode that the application has applied and saved progress in the\n   473\t// last Ready results.\n   474\t//\n   475\t// NOTE: Advance must not be called when using AsyncStorageWrites. Response messages from\n   476\t// the local append and apply threads take its place.\n   477\tfunc (rn *RawNode) Advance(_ Ready) {\n   478\t\t// The actions performed by this function are encoded into stepsOnAdvance in\n   479\t\t// acceptReady. In earlier versions of this library, they were computed from\n   480\t\t// the provided Ready struct. Retain the unused parameter for compatibility.\n   481\t\tif rn.asyncStorageWrites {\n   482\t\t\trn.raft.logger.Panicf(\"Advance must not be called when using AsyncStorageWrites\")\n   483\t\t}\n   484\t\tfor i, m := range rn.stepsOnAdvance {\n   485\t\t\t_ = rn.raft.Step(m)\n   486\t\t\trn.stepsOnAdvance[i] = nil\n   487\t\t}\n   488\t\trn.stepsOnAdvance = rn.stepsOnAdvance[:0]\n   489\t}\n   490\t\n   491\t// Status returns the current status of the given group. This allocates, see\n   492\t// BasicStatus and WithProgress for allocation-friendlier choices.\n   493\tfunc (rn *RawNode) Status() Status {\n   494\t\tstatus := getStatus(rn.raft)\n   495\t\treturn status\n   496\t}\n   497\t\n   498\t// BasicStatus returns a BasicStatus. Notably this does not contain the\n   499\t// Progress map; see WithProgress for an allocation-free way to inspect it.\n   500\tfunc (rn *RawNode) BasicStatus() BasicStatus {\n   501\t\treturn getBasicStatus(rn.raft)\n   502\t}\n   503\t\n   504\t// ProgressType indicates the type of replica a Progress corresponds to.\n   505\ttype ProgressType byte\n   506\t\n   507\tconst (\n   508\t\t// ProgressTypePeer accompanies a Progress for a regular peer replica.\n   509\t\tProgressTypePeer ProgressType = iota\n   510\t\t// ProgressTypeLearner accompanies a Progress for a learner replica.\n   511\t\tProgressTypeLearner\n   512\t)\n   513\t\n   514\t// WithProgress is a helper to introspect the Progress for this node and its\n   515\t// peers.\n   516\tfunc (rn *RawNode) WithProgress(visitor func(id uint64, typ ProgressType, pr tracker.Progress)) {\n   517\t\trn.raft.trk.Visit(func(id uint64, pr *tracker.Progress) {\n   518\t\t\ttyp := ProgressTypePeer\n   519\t\t\tif pr.IsLearner {\n   520\t\t\t\ttyp = ProgressTypeLearner\n   521\t\t\t}\n   522\t\t\tp := *pr\n   523\t\t\tp.Inflights = nil\n   524\t\t\tvisitor(id, typ, p)\n   525\t\t})\n   526\t}\n   527\t\n   528\t// ReportUnreachable reports the given node is not reachable for the last send.\n   529\tfunc (rn *RawNode) ReportUnreachable(id uint64) {\n   530\t\t_ = rn.raft.Step(&pb.Message{Type: pb.MsgUnreachable.Enum(), From: new(id)})\n   531\t}\n   532\t\n   533\t// ReportSnapshot reports the status of the sent snapshot.\n   534\tfunc (rn *RawNode) ReportSnapshot(id uint64, status SnapshotStatus) {\n   535\t\trej := status == SnapshotFailure\n   536\t\n   537\t\t_ = rn.raft.Step(&pb.Message{Type: pb.MsgSnapStatus.Enum(), From: new(id), Reject: new(rej)})\n   538\t}\n   539\t\n   540\t// TransferLeader tries to transfer leadership to the given transferee.\n   541\tfunc (rn *RawNode) TransferLeader(transferee uint64) {\n   542\t\t_ = rn.raft.Step(&pb.Message{Type: pb.MsgTransferLeader.Enum(), From: new(transferee)})\n   543\t}\n   544\t\n   545\t// ForgetLeader forgets a follower's current leader, changing it to None.\n   546\t// See (Node).ForgetLeader for details.\n   547\tfunc (rn *RawNode) ForgetLeader() error {\n   548\t\treturn rn.raft.Step(&pb.Message{Type: pb.MsgForgetLeader.Enum()})\n   549\t}\n   550\t\n   551\t// ReadIndex requests a read state. The read state will be set in ready.\n   552\t// Read State has a read index. Once the application advances further than the read\n   553\t// index, any linearizable read requests issued before the read request can be\n   554\t// processed safely. The read state will have the same rctx attached.\n   555\tfunc (rn *RawNode) ReadIndex(rctx []byte) {\n   556\t\t_ = rn.raft.Step(&pb.Message{Type: pb.MsgReadIndex.Enum(), Entries: []*pb.Entry{{Data: rctx}}})\n   557\t}\n","exit_code":0,"status":"completed"}}
