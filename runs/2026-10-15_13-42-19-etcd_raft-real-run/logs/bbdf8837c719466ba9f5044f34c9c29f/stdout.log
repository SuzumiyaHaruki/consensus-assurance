:                 n1.Term,\n\t\t\"lead\":                 n1.lead,\n\t\t\"read_states_before\":   before,\n\t\t\"read_states\":          len(n1.readStates),\n\t\t\"new_read_states\":      len(n1.readStates) - before,\n\t\t\"read_answered\":        len(n1.readStates) > before,\n\t\t\"committed_index\":      n1.raftLog.committed,\n\t\t\"other_committed_index\": n2.raftLog.committed,\n\t})\n}\nGO\ncp assurance_singleton_test.go work/raft/ && cd work/raft && TMPDIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft/work/tmp timeout 120 go test -count=1 -v -run '\"'TestAssuranceReadIndexFromRemovedLeaderWithCheckQuorum' . 2>&1 | grep -E \\\"CA_EVENT|FAIL|ok |panic|_test.go:[0-9]+\\\" | head -12\"","aggregated_output":"CA_EVENT {\"checkquorum\":true,\"cluster\":\"voters=(1 2)\",\"election_tick\":10,\"event\":\"c_setup\",\"heartbeat_tick\":1,\"scenario\":\"removed-singleton-leader-read-checkquorum\",\"step\":\"setup\"}\nCA_EVENT {\"committed_index\":2,\"config\":\"voters=(2)\",\"event\":\"c_leader_removed\",\"is_voter\":false,\"node\":1,\"scenario\":\"removed-singleton-leader-read-checkquorum\",\"singleton\":true,\"state\":\"StateLeader\",\"step\":\"leader-1-removed\",\"term\":1}\nCA_EVENT {\"actual_leader_ahead\":true,\"committed_index\":4,\"event\":\"c_new_leader_committed\",\"node\":2,\"removed_leader_committed_index\":2,\"removed_leader_state\":\"StateLeader\",\"scenario\":\"removed-singleton-leader-read-checkquorum\",\"state\":\"StateLeader\",\"step\":\"node-2-leads\",\"term\":2}\nCA_EVENT {\"committed_index\":2,\"event\":\"c_read_before_stepdown\",\"node\":1,\"other_committed_index\":4,\"read_index\":2,\"read_index_at_least_other_committed\":false,\"read_states\":1,\"scenario\":\"removed-singleton-leader-read-checkquorum\",\"singleton\":true,\"state\":\"StateLeader\",\"step\":\"read-before-stepdown\",\"term\":1}\nCA_EVENT {\"committed_index\":2,\"event\":\"c_stepdown\",\"lead\":0,\"node\":1,\"scenario\":\"removed-singleton-leade