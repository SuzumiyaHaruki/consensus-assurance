{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft && cat >> assurance_singleton_test.go <<'GO'\n\n// TestAssuranceLeaseReadFromRemovedLeader observes the same removal and read as\n// the two-voter control, but with ReadOnlyLeaseBased (and the CheckQuorum it\n// requires): the read is answered without any round, so the \\\"no answer\\\" outcome\n// of the read-only-safe configuration is not the only possible one.\nfunc TestAssuranceLeaseReadFromRemovedLeader(t *testing.T) {\n\tmk := func(id uint64) *raft {\n\t\ts := newTestMemoryStorage(withPeers(1, 2, 3))\n\t\tcfg := newTestConfig(id, 10, 1, s)\n\t\tcfg.ReadOnlyOption = ReadOnlyLeaseBased\n\t\tcfg.CheckQuorum = true\n\t\treturn newRaft(cfg)\n\t}\n\tn1, n2, n3 := mk(1), mk(2), mk(3)\n\tnt := newNetwork(n1, n2, n3)\n\tsetRandomizedElectionTimeout(n2, n2.electionTimeout*10)\n\tsetRandomizedElectionTimeout(n3, n3.electionTimeout*10)\n\n\tassurance2Emit(t, map[string]any{\n\t\t\\\"scenario\\\": \\\"removed-leader-lease-read\\\",\n\t\t\\\"event\\\":    \\\"d_setup\\\",\n\t\t\\\"step\\\":     \\\"setup\\\",\n\t\t\\\"cluster\\\":  \\\"voters=(1 2 3)\\\",\n\t\t\\\"read_only_option\\\": \\\"ReadOnlyLeaseBased\\\",\n\t\t\\\"checkquorum\\\":      true,\n\t})\n\n\tnt.send(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgHup.Enum()})\n\tnextEnts(n1, n1.raftLog.storage.(*MemoryStorage))\n\tnextEnts(n2, n2.raftLog.storage.(*MemoryStorage))\n\tnextEnts(n3, n3.raftLog.storage.(*MemoryStorage))\n\n\tcc := &pb.ConfChange{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: new(uint64(1))}\n\tm, err := confChangeToMsg(cc)\n\tif err \"'!= nil {\n\t\tt.Fatalf(\"conf change message: %v\", err)\n\t}\n\tm.From, m.To = new(uint64(1)), new(uint64(1))\n\tnt.send(m)\n\tccv2 := cc.AsV2()\n\tn1.applyConfChange(ccv2)\n\tn2.applyConfChange(ccv2)\n\tn3.applyConfChange(ccv2)\n\tnextEnts(n1, n1.raftLog.storage.(*MemoryStorage))\n\tnextEnts(n2, n2.raftLog.storage.(*MemoryStorage))\n\tnextEnts(n3, n3.raftLog.storage.(*MemoryStorage))\n\n\tassurance2Emit(t, map[string]any{\n\t\t\"scenario\": \"removed-leader-lease-read\",\n\t\t\"event\":    \"d_leader_removed\",\n\t\t\"step\":     \"leader-1-removed\",\n\t\t\"node\":     1, \"state\": n1.state.String(), \"term\": n1.Term,\n\t\t\"config\": n1.trk.Config.String(), \"singleton\": n1.trk.IsSingleton(),\n\t\t\"is_voter\": assurance2IsVoter(n1), \"committed_index\": n1.raftLog.committed,\n\t})\n\n\tnt.send(&pb.Message{From: new(uint64(2)), To: new(uint64(2)), Type: pb.MsgHup.Enum()})\n\tnt.send(&pb.Message{From: new(uint64(2)), To: new(uint64(2)), Type: pb.MsgProp.Enum(),\n\t\tEntries: []*pb.Entry{{Data: []byte(\"w\")}}})\n\tassurance2Emit(t, map[string]any{\n\t\t\"scenario\": \"removed-leader-lease-read\",\n\t\t\"event\":    \"d_new_leader_committed\",\n\t\t\"step\":     \"node-2-leads\",\n\t\t\"node\":     2, \"state\": n2.state.String(), \"term\": n2.Term,\n\t\t\"committed_index\": n2.raftLog.committed,\n\t\t\"removed_leader_committed_index\": n1.raftLog.committed,\n\t\t\"actual_leader_ahead\":            n2.raftLog.committed > n1.raftLog.committed,\n\t})\n\n\tif err := n1.Step(&pb.Message{From: new(uint64(1)), To: new(uint64(1)), Type: pb.MsgReadIndex.Enum(),\n\t\tEntries: []*pb.Entry{{Data: []byte(\"R\")}}}); err != nil {\n\t\tt.Fatalf(\"read index: %v\", err)\n\t}\n\temitted := n1.readMessages()\n\tnt.send(emitted...)\n\theartbeats := 0\n\tfor _, msg := range emitted {\n\t\tif msg.GetType() == pb.MsgHeartbeat {\n\t\t\theartbeats++\n\t\t}\n\t}\n\tev := map[string]any{\n\t\t\"scenario\": \"removed-leader-lease-read\",\n\t\t\"event\":    \"d_read_attempt\",\n\t\t\"step\":     \"read-via-removed-leader\",\n\t\t\"node\":     1, \"state\": n1.state.String(), \"term\": n1.Term,\n\t\t\"singleton\": n1.trk.IsSingleton(), \"is_voter\": assurance2IsVoter(n1),\n\t\t\"read_states\": len(n1.readStates), \"read_answered\": len(n1.readStates) > 0,\n\t\t\"heartbeats_emitted\": heartbeats, \"messages_emitted\": assurance2Types(emitted),\n\t\t\"unconfirmed_reads\": len(n1.readOnly.unconfirmedReads),\n\t\t\"pending_reads\":     len(n1.pendingReadIndexMessages),\n\t\t\"committed_index\":   n1.raftLog.committed,\n\t\t\"other_committed_index\": n2.raftLog.committed,\n\t}\n\tif len(n1.readStates) > 0 {\n\t\tlast := n1.readStates[len(n1.readStates)-1].Index\n\t\tev[\"read_index\"] = last\n\t\tev[\"read_index_at_least_other_committed\"] = last >= n2.raftLog.committed\n\t}\n\tassurance2Emit(t, ev)\n\n\tif err := n2.Step(&pb.Message{From: new(uint64(2)), To: new(uint64(2)), Type: pb.MsgReadIndex.Enum(),\n\t\tEntries: []*pb.Entry{{Data: []byte(\"R\")}}}); err != nil {\n\t\tt.Fatalf(\"control read index: %v\", err)\n\t}\n\tnt.send(n2.readMessages()...)\n\tev = map[string]any{\n\t\t\"scenario\": \"removed-leader-lease-read\",\n\t\t\"event\":    \"d_control_read_actual_leader\",\n\t\t\"step\":     \"read-via-actual-leader\",\n\t\t\"node\":     2, \"state\": n2.state.String(), \"term\": n2.Term,\n\t\t\"read_states\": len(n2.readStates), \"own_committed_index\": n2.raftLog.committed,\n\t}\n\tif len(n2.readStates) > 0 {\n\t\tev[\"read_index\"] = n2.readStates[len(n2.readStates)-1].Index\n\t\tev[\"read_index_at_least_own_committed\"] = n2.readStates[len(n2.readStates)-1].Index >= n2.raftLog.committed\n\t}\n\tassurance2Emit(t, ev)\n}\nGO\ncp assurance_singleton_test.go work/raft/ && cd work/raft && TMPDIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft/work/tmp timeout 120 go test -count=1 -v -timeout 90s -run '\"'TestAssuranceLeaseReadFromRemovedLeader' . 2>&1 | grep -E \\\"CA_EVENT|FAIL|ok |panic\\\" | head -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
