ter-leadership-change\")\n\tpump()\n\tev = map[string]any{\"event\": \"propose_after_leadership_change\", \"step\": \"propose-after-leadership-change\",\n\t\t\"proposal_returned_error\": err4 != nil, \"proposal_duration_ms\": dur4.Milliseconds(),\n\t\t\"leader_index_before\":     leaderIndexBefore2,\n\t\t\"leader_last_index\":       n1.raftLog.lastIndex(),\n\t\t\"leader_advanced\":         n1.raftLog.lastIndex() > leaderIndexBefore2}\n\tev2 := h.Status()\n\tev[\"node2_state_after\"] = map[string]any{\"state\": ev2.RaftState.String(), \"term\": ev2.GetTerm(),\n\t\t\"known_leader\": ev2.Lead, \"commit\": ev2.GetCommit()}\n\tif err4 != nil {\n\t\tev[\"proposal_error\"] = err4.Error()\n\t}\n\tassurance3Emit(t, ev)\n'\"'''\ni=s.rindex(\\\"}\\\\n\\\")\ns=s[:i]+add+s[i:]\nopen(p,'w').write(s)\nPY\ncp assurance_node_proposal_test.go work/raft/ && cd work/raft && TMPDIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft/work/tmp timeout 180 go test -count=1 -v -timeout 150s -run 'TestAssuranceProposeAfterReAdd' . 2>&1 | grep -E \\\"campaign_attempt|propose_after_leadership|FAIL|ok |panic\\\" | head -6\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
