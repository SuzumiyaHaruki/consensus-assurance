.go work/raft/ && cd work/raft && TMPDIR=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft/work/tmp timeout 120 go test -count=1 -v -run '\"'TestAssuranceForwardedReadIndexAcrossConfigCommit' . 2>&1 | grep -E \\\"CA_EVENT|FAIL|ok |panic|_test.go:[0-9]+\\\" | head -12\"","aggregated_output":"CA_EVENT {\"applied_index\":10,\"bootstrap_conf_state\":\"Voters:[1 2 3 4] VotersOutgoing:[] Learners:[] LearnersNext:[] AutoLeave:false\",\"case\":\"remove-voter-4-forwarded-read\",\"config\":\"voters=(1 2 3 4)\",\"event\":\"setup\",\"node\":1,\"persisted_commit\":10}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_entry_term\":1,\"committed_index\":10,\"config\":\"voters=(1 2 3 4)\",\"event\":\"election\",\"last_index\":11,\"leader_term\":2,\"node\":1,\"pending_reads\":0,\"read_states\":0,\"state\":\"StateLeader\",\"term_has_commit\":false,\"unconfirmed_reads\":0}\nCA_EVENT {\"case\":\"remove-voter-4-forwarded-read\",\"event\":\"fwd_readindex_forwarded\",\"forwarded_to_leader\":true,\"known_leader\":1,\"messages_emitted\":[\"MsgReadIndex\"],\"node\":2,\"node2_read_states\":0,\"state\":\"StateFollower\"}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_entry_term\":1,\"committed_index\":10,\"config\":\"voters=(1 2 3 4)\",\"event\":\"fwd_readindex_stashed\",\"last_index\":11,\"leader_term\":2,\"node\":1,\"node2_read_states\":0,\"pending_reads\":1,\"read_states\":0,\"term_has_commit\":false,\"unconfirmed_reads\":0}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_before\":10,\"committed_entry_term\":2,\"committed_index\":11,\"config\":\"voters=(1 2 3)\",\"event\":\"fwd_confchange_applied\",\"last_index\":11,\"leader_term\":2,\"messages_emitted\":[\"MsgApp\",\"MsgAppResp\"],\"node\":1,\"node2_read_states\":0,\"pending_reads\":1,\"read_states\":0,\"readindex_responses_emitted\":0,\"term_has_commit\":true,\"unconfirmed_reads\":0}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_entry_term\":2,\"committed_index\":11,\"config\":\"voters=(1 2 3)\",\"event\":\"delayed_ack_delivered\",\"last_index\":11,\"leader_term\":2,\"node\":1,\"node2_read_states\":0,\"pending_reads\":1,\"read_states\":0,\"term_has_commit\":true,\"unconfirmed_reads\":0}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_entry_term\":2,\"committed_index\":11,\"config\":\"voters=(1 2 3)\",\"event\":\"heartbeat_round\",\"last_index\":11,\"leader_term\":2,\"node\":1,\"node2_read_states\":0,\"pending_reads\":1,\"read_states\":0,\"term_has_commit\":true,\"unconfirmed_reads\":0}\nCA_EVENT {\"applied_index\":10,\"case\":\"remove-voter-4-forwarded-read\",\"committed_before\":11,\"committed_entry_term\":2,\"committed_index\":12,\"config\":\"voters=(1 2 3)\",\"event\":\"fwd_unrelated_commit\",\"last_index\":12,\"leader_term\":2,\"node\":1,\"node2_read_index\":12,\"node2_read_states\":1,\"node2_request_ctx\":\"A\",\"pending_reads\":0,\"read_states\":0,\"readindex_responses_emitted\":1,\"term_has_commit\":true,\"unconfirmed_reads\":0}\nok  \tgo.etcd.io/raft/v3\t0.009s\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_13-42-19-etcd_raft-real-run/draft && python3 - <<'PY'\nimport json\norig=json.load(open('update.json'))['experiment']\ndef chain(b): return {\\\"field\\\":\\\"case\\\",\\\"reference\\\":b+\\\".case\\\"}\nexp=dict(orig)\nexp['previous_id']=\\\"8769550822c045a18219e24795b9bdc0-experiment\\\"\nexp['revision_reason']=\\\"The harness now also contains the forwarded-completion variant of the same scenario: the client's read reaches follower 2, which forwards it to leader 1, so the answer owed for the postponed request is a MsgReadIndexResp delivered to node 2 rather than a local ReadState. The earlier cases and comparisons are kept.\\\"\nexp['scope']={\\\"description\\\":\\\"Observe the whole interval of one postponed ReadIndex request for two completion paths on the same 4-node group: a local request answered into leader 1's readStates, and a forwarded request (client to follower 2, follower forwards to leader 1) whose answer must be a MsgReadIndexResp delivered back to node 2. In both paths the application then applies an already-committed configuration change whose resulting configuration performs the leader's first commit of the term.\\\",\n \\\"assumptions\\\":[\n  \\\"Four voters {1,2,3,4} bootstrapped from a ConfState-only snapshot, log entries 1..9 ordinary and entry 10 the configuration change, HardState{Term:1, Commit:10}, applied index 10 (the application reported applied progress but has not yet called ApplyConfChange for entry 10, which node.go:166-187 permits).\\\",\n  \\\"Transport preserves raft's per-message semantics; voter 4 is unreachable and voter 3's append acknowledgements are delayed (message loss/delay).\\\",\n  \\\"The forwarded request is produced by delivering MsgReadIndex without a From to follower 2, so follower 2 forwards it to the leader it knows, exactly as the Node.ReadIndex path does.\\\"],\n \\\"excluded\\\":[\\\"Pre-vote, check-quorum and lease-based reads.\\\",\\\"Snapshot-based recovery and asynchronous storage writes.\\\"]}\nexp['prefix']=\\\"For each case: build four nodes whose storage is bootstrapped with the case ConfState (voters {1,2,3,4}, or the joint configuration voters {1,2,3} + voters_outgoing {1,2,3,4}), append ten term-1 entries with entry 10 the case configuration change, persist HardState{Term:1,Commit:10} and set Applied=10; elect node 1 with a real MsgHup/MsgVote/MsgVoteResp round (voter 4 unreachable, voter 3's MsgAppResp delayed); deliver the read request (locally to node 1, or to follower 2 which forwards it); apply the committed change at index 10 via applyConfChange; deliver the delayed acknowledgement; run one heartbeat round (tick); finally propose one unrelated entry.\\\"\nexp['prerequisites']=orig['prerequisites']+[\n {\\\"alias\\\":\\\"felect\\\",\\\"event\\\":\\\"election\\\"},\n {\\\"alias\\\":\\\"ffwd\\\",\\\"event\\\":\\\"fwd_readindex_forwarded\\\",\\\"conditions\\\":[chain(\\\"felect\\\")]},\n {\\\"alias\\\":\\\"fstash\\\",\\\"event\\\":\\\"fwd_readindex_stashed\\\",\\\"conditions\\\":[chain(\\\"ffwd\\\")]},\n {\\\"alias\\\":\\\"fcc\\\",\\\"event\\\":\\\"fwd_confchange_applied\\\",\\\"conditions\\\":[chain(\\\"fstash\\\")]},\n {\\\"alias\\\":\\\"frepair\\\",\\\"event\\\":\\\"fwd_unrelated_commit\\\",\\\"conditions\\\":[chain(\\\"fcc\\\")]},\n]\nexp['comparisons']=orig['comparisons']+[\n {\\\"event\\\":\\\"fwd_readindex_forwarded\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"felect\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"forwarded_to_leader\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n  \\\"description\\\":\\\"Forwarded-path premise: follower 2 (StateFollower, known leader 1) emits MsgReadIndex addressed to leader 1, so the answer owed is a MsgReadIndexResp to node 2.\\\"},\n {\\\"event\\\":\\\"fwd_readindex_stashed\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"ffwd\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"pending_reads\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1},\n  \\\"description\\\":\\\"Forwarded-path premise: the leader postponed the forwarded request because no entry of its term was committed.\\\"},\n {\\\"event\\\":\\\"fwd_confchange_applied\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"fstash\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"node2_read_states\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1},\n  \\\"antecedent\\\":{\\\"field\\\":\\\"term_has_commit\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n  \\\"description\\\":\\\"Forwarded-path witness: applying the committed change performed the leader's first commit of term 2 (committed 10 -> 11, committed_entry_term 2 == leader_term) yet no MsgReadIndexResp was emitted and follower 2 received no ReadState, so the client's forwarded read stays unanswered.\\\"},\n {\\\"event\\\":\\\"fwd_unrelated_commit\\\",\\\"identity_fields\\\":[\\\"case\\\"],\\\"admission_alias\\\":\\\"fcc\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"readindex_responses_emitted\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1},\n  \\\"description\\\":\\\"Forwarded-path control: the unrelated proposal committed by the new configuration releases the postponed request, and only then does follower 2 receive the MsgReadIndexResp (ctx A, index 12).\\\"},\n]\nu={\\\"rationale\\\":\\\"Expand the postponed-read finding to a materially different completion path: the harness now also measures the forwarded request (client to follower 2, forwarded to leader 1, answered by MsgReadIndexResp), so the account can state which consumers are affected rather than relying on the local ReadState path alone. The comparison set keeps the two configuration-change cases and adds the forwarded-path comparisons. No interpretation is added this turn; the first question's account stays as recorded until this receipt exists.\\\",\n \\\"experiment\\\":exp}\nopen('update10.json','w').write(json.dum