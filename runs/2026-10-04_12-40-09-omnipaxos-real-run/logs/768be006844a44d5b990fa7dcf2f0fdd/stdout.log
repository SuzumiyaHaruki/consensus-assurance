{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > build_core.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v1.json'))\n# Derived indexes are recomputed by the controller.\nfor a in m['activities']: a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None);f.pop('consumed_by',None)\ns=[]\ndef src(i,f,a,b,k='code_observation'):\n s.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\napi=src('src_api','omnipaxos/src/omni_paxos.rs',40,201)\nentry=src('src_entry','omnipaxos/src/omni_paxos.rs',315,442)\nsync=src('src_sync','omnipaxos/src/storage/internal_storage.rs',313,412)\nread=src('src_read','omnipaxos/src/storage/internal_storage.rs',55,196)\nbatch=src('src_batch','omnipaxos/src/storage/internal_storage.rs',199,311)\ncompact=src('src_compact','omnipaxos/src/storage/internal_storage.rs',414,474)\ncontract=src('src_storage_contract','omnipaxos/src/storage/mod.rs',75,218,'interface_statement')\nmem=src('src_memory','omnipaxos_storage/src/memory_storage.rs',31,178)\ndoc=src('src_snapshot_doc','docs/omnipaxos/compaction.md',29,64,'document_statement')\ndef add(i,a,owner,trig,ss,**kw):\n b=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context='One configured replica and its log history',trigger=trig,source_ids=ss);b.update(kw);m['behaviors'].append(b)\nadd('B_admission','A4','OmniPaxosConfig and ClusterConfig','build or reconfigure',[api,entry],implementation_guards=['At least two nodes; nonzero configuration ID and local pid; own pid in nodes; flexible read/write quorum bounds and overlap; positive batching and election/resend timeouts.'],external_effects=['Build reads recovered promise, creates BLE, timers and SequencePaxos. reconfigure validates the proposed configuration before forwarding.'],unknowns=['Node-list uniqueness and cross-configuration message isolation are not checked in the read validation/dispatch paths; caller obligations need investigation