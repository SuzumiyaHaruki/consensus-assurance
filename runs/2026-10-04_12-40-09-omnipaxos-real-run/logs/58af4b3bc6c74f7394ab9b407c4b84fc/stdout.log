{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nsources=[]\ndef src(i,f,a,b,k='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k));return i\nl=src('src_leader','omnipaxos/src/sequence_paxos/leader.rs',14,415)\nf=src('src_follower','omnipaxos/src/sequence_paxos/follower.rs',12,290)\nm=src('src_dispatch','omnipaxos/src/sequence_paxos/mod.rs',248,455)\nu=src('src_support','omnipaxos/src/util.rs',77,268)\nb=src('src_ble','omnipaxos/src/ballot_leader_election.rs',177,311)\nr=src('src_recovery_init','omnipaxos/src/sequence_paxos/mod.rs',52,125)\nc=src('src_communication','docs/omnipaxos/communication.md',1,26,'document_statement')\nrc=src('src_reconfiguration','docs/omnipaxos/reconfiguration.md',1,44,'document_statement')\nbeh=[]\ndef behavior(i,a,owner,trigger,guards,writes,effects,ss,prod=[],cons=[]):\n beh.append(dict(id=i,primary_activity=a,execution_owner=owner,protocol_context='One configured SequencePaxos instance and ballot',trigger=trigger,implementation_guards=guards,writes=writes,external_effects=effects,source_ids=ss,produces_fact_ids=prod,consumes_fact_ids=cons))\nbehavior('B_authority','A2','SequencePaxos::handle_leader and handle_prepare','New election result or incoming Prepare',['New local leadership requires ballot greater than leader_state and stored promise; follower Prepare requires greater promise or equal promise in Recover'],['Flush batch, store promise; leader resets LeaderState and enters Prepare; follower resets receive sequence and caches Promise'],['Leader sends Prepare; follower replies with accepted round/index and conditional log sync'],[l,f],['F_promise'])\nbehavior('B_formation','A1','SequencePaxos leader handlers and LeaderState','Promise, local/forwarded proposal or Accepted',['Promise and Accepted ballot must equal leader ballot; Accepted also requires Leader/Accept; prepare and accept quorum counts use per-pid slots'],['Prepare quorum selects maximum accepted round/index history and maximum decided index; synchronizes log, appends pending proposals unless stopped; updates own accepted slot; Accepted overwrites sender slot and may advance decided index'],['AcceptSync starts a per-follower sequence session; AcceptDecide carries entries and decided index; quorum decision produces Decide or updates buffered AcceptDecide'],[l,u],['F_support'],['F_support'])\nbehavior('B_follow','A1','SequencePaxos follower handlers','AcceptSync, AcceptDecide, AcceptStopSign or Decide',['Ballot equals stored promise; AcceptSync requires Follower/Prepare; AcceptDecide and StopSign require Follower/Accept and expected sequence; Decide requires Accept and expected sequence'],['Synchronize or append before replying; monotonically advance decided index, flushing batches if necessary; install StopSign'],['Accepted acknowledges persisted accepted index; AcceptSync forwards buffered proposals if no StopSign'],[f],[],['F_promise'])\nbehavior('B_recover','A3','SequencePaxos initialization, reconnected and resend handlers','Stored promise on construction, network reconnection, sequence gap or resend timeout',['Reconnect to current leader enters Recover; old ballot receives NotAccepted; larger unexpected ballot requests recovery'],['PrepareReq at leader resets sender promise and cached outgoing acceptance metadata; follower enters Recover on sequence gap'],['PrepareReq, Prepare and cached Promise retransmissions; Accept-phase resend handles StopSign and unpromised peers; ordinary Accept/Accepted retransmission is not present in these branches'],[r,m,l,f])\nbeh[-1]['cross_activity_effects']={'A2':'Recovery enables equal-ballot Prepare to rebuild follower context.','A1':'Resynchronization restarts follower acceptance from selected leader history.'}\nfacts=[dict(id='F_promise',meaning='The stored ballot is the ballot currently promised by this replica.',identity={'replica':'configured node','instance':'configured SequencePaxos instance'},validity_context='Until replaced by a qualifying Prepare or local leadership transition.',representation=['InternalStorage promise'],durability='Written through InternalStorage; backend guarantees not yet inspected.',recovery='Construction reads existing promise and enters Recover.',source_ids=[r,l,f],invalidators=['B_authority']),dict(id='F_support',meaning='The leader records each participant\\\\'s most recently assigned accepted index for its current LeaderState.',identity={'leader':'leader node','ballot':'LeaderState.n_leader','participant':'pid slot'},validity_context='LeaderState is replaced on new local leadership; incoming current-ballot Accepted overwrites the sender slot.',representation=['LeaderState.accepted_indexes'],durability='Volatile leader accounting.',recovery='New leadership starts zeroed accounting and rebuilds through synchronization acknowledgments.',source_ids=[l,u],invalidators=['B_authority'])]\npaths=lambda e,bs,ss:dict(explanation=e,behavior_ids=bs,source_ids=ss)\nmapobj=dict(version=1,target_profile=dict(system_boundary='Captured OmniPaxos Rust library, with caller-owned message transport and periodic polling. In-repository storage and wrapper duties remain to be traced.',source_ids=[c,rc,m]),activities=[dict(class_id=a,applicability='applicable',purpose=p,realization_summary=t,source_ids=ss) for a,p,t,ss in [('A1','Qualified support for decision formation and legal advancement','Leader aggregates per-pid promises and accepted indexes; followers validate ballot and receive ordering.',[l,f,u]),('A2','Context validity and acquisition, transfer or loss of authority','BLE suggests ballots, persistent promises gate acceptance, and preparation carries prior accepted history.',[b,l,f]),('A3','Recovery and resynchronization of eligible participation','Recovered promise and detected gaps initiate PrepareReq and log synchronization.',[r,m,f]),('A4','Configuration and participant eligibility','StopSign seals old instance; caller starts next membership. Configuration validation remains unread.',[rc]),('A5','Decision application and consumption','Caller reads decided entries; export implementation remains unread.',[c,rc]),('A6','History, persistence and reconstruction of support','Storage abstraction retains promise and history; backend and atomic sync require reading.',[r,l,f]),('A7','Client contracts, invocation intervals and observed completion','Caller submits proposals, transports messages and reads decisions; append success is not yet characterized as completion.',[c,m])]],behaviors=beh,facts=facts,surfaces=[dict(entry_point='SequencePaxos::resend_messages_leader',disposition='mapped',behavior_ids=['B_recover'],reason='Ordinary final AcceptDecide or Accepted loss has no resend in these branches. Does the transport contract require reliable delivery or reconnection notification, and which other trigger restores progress?',source_ids=[l,f,c],high_consequence=True),dict(entry_point='LeaderState::set_accepted_idx',disposition='mapped',behavior_ids=['B_formation'],reason='Current-ballot Accepted overwrites rather than maximizes per-pid index. Determine whether legal delayed acknowledgments affect only conservative accounting or also trim/progress consumers.',source_ids=[u,l],high_consequence=True)],core_overview=dict(status='incomplete',formation=paths('Leader preparation collects per-pid promises, selects prior history, enters Accept and synchronizes followers. Local proposals append/batch, followers acknowledge accepted indexes, and leader accepts a decision only after the configured acceptance quorum. Decision propagation uses Decide or piggybacking. Application export remains unread.',['B_formation','B_follow'],[l,f,u]),context=paths('BLE heartbeat rounds propose leadership; SequencePaxos only initiates local leadership above its prior leader and promise. A follower persists a qualifying promise before responding, rejects old ballots and requires preparation before AcceptSync. Recovery permits same-ballot Prepare; new local leadership resets support accounting.',['B_authority','B_recover'],[b,l,f,r]),connection=paths('Preparation flushes pending batches before reporting accepted history. The selected accepted round/index and decided index constrain the new leader history; pending proposals append only if no accepted StopSign. Current-ballot acceptance and per-follower message sequences qualify later advancement. Gaps request resynchronization; old ballots cannot directly append at followers.',['B_authority','B_formation','B_follow','B_recover'],[l,f,m,u]),core_gaps=['Read wrapper configuration validation, message admission and timer dispatch to establish actual entry duties.','Read InternalStorage sync_log, batching, decided exports and storage contract to explain persistence and consumption boundaries.'],open_details=['Transport loss/reordering contract and caller reconnect duties.','Delayed same-ballot Accepted accounting and its independent consumers.'],rationale='Initial partial map preserves sourced core relationships and leads while explicitly retaining unread backbone boundaries.'))\njson.dump(mapobj,open('initial-map.json','w'),indent=2)\njson.dump(dict(action='research',rationale='Preserve the initial two-core-path reconstruction and two sourced open surfaces before finishing wrapper and storage boundaries.',sources=sources,map_path='initial-map.json'),open('submission.json','w'),indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
