parked\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"peer\\\":\\\"v0\\\",\\\"rpc\\\":2,\\\"term\\\":2,\\\"worker\\\":\\\"data\\\"}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.166598367+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyEligibleSupport/nonvoter_only\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"worker_parked\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"peer\\\":\\\"v1\\\",\\\"rpc\\\":3,\\\"term\\\":2,\\\"worker\\\":\\\"data\\\"}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.431439934+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyEligibleSupport/nonvoter_only\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"worker_parked\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"peer\\\":\\\"v1\\\",\\\"rpc\\\":4,\\\"term\\\":2,\\\"worker\\\":\\\"heartbeat\\\"}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.439471997+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyEligibleSupport/nonvoter_only\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"worker_parked\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"peer\\\":\\\"v0\\\",\\\"rpc\\\":5,\\\"term\\\":2,\\\"worker\\\":\\\"heartbeat\\\"}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.506821751+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyEligibleSupport/nonvoter_only\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"worker_parked\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"peer\\\":\\\"n0\\\",\\\"rpc\\\":6,\\\"term\\\":2,\\\"worker\\\":\\\"heartbeat\\\"}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.510433775+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyEligibleSupport/nonvoter_only\",\"Output\":\"CA_EVENT {\\\"event\\\":\\\"quiescent\\\",\\\"leader\\\":\\\"v2\\\",\\\"op\\\":\\\"nonvoter_only\\\",\\\"parked_workers\\\":6,\\\"term\\\":2}\\n\"}\n{\"Time\":\"2026-09-27T20:51:37.510533408+08:00\",\"Action\":\"output\",\"Package\":\"