 \"behavior_ids\": [\n    \"B-repl\",\n    \"B-snapshot\",\n    \"B-heartbeat\",\n    \"B-verify-register\",\n    \"B-verify-notify\",\n    \"B-verify-finish\"\n  ],\n  \"fact_ids\": [\n    \"F-peer-positive\"\n  ],\n  \"supporting_behavior_ids\": {\n    \"B-membership\": \"Defines actual voter/nonvoter roles and replication eligibility.\",\n    \"B-elect\": \"Establishes a real leader before the check.\",\n    \"B-authority-life\": \"Lease expiry, higher-term stepdown and cleanup are protective competing events.\",\n    \"B-commit\": \"Shows separately voter-filtered log commitment; its guarantees cannot be assumed for VerifyLeader.\"\n  },\n  \"obligation_relation_kind\": \"consumption\",\n  \"counterevidence\": [\n    \"VerifyLeader returns errors on follower/candidate and on negative notification; leader exit fails pending verification.\",\n    \"Voter-only lease checks can end authority even if nonvoters respond.\",\n    \"Normal commitment explicitly excludes nonvoter matches; no incorrect log commitment follows from this registration asymmetry alone.\",\n    \"The API does not literally state a voter-quorum formula; its authority/read purpose needs a justified requirement derivation.\"\n  ],\n  \"unknowns\": [\n    \"Applicable requirement: derive the necessary support condition for this authority API without turning implementation asymmetry into its own oracle.\",\n    \"Actual producer: execute actual nonvoter reply production and its consumption, not a synthetic vote(bool).\",\n    \"Initial prefix: observe real election and settled mixed membership with public configuration and committed operation.\",\n    \"Same execution: exclude old voter replies as contributors, retain negative replies/lease/stepdown workers, and correlate the checked future interval.\",\n    \"Observed endpoint: measure the same public future result; stale FSM read and newer-leader application are separate unobserved consequences.\"\n  ],\n  \"priority\": 3,\n  \"trigger_rationale\":