,\n  \"type\": \"object\"\n}\nCodeAnchor {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"boundary_complete\": {\n      \"anyOf\": [\n        {\n          \"type\": \"boolean\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Boundary Complete\"\n    },\n    \"kind\": {\n      \"default\": \"declaration\",\n      \"enum\": [\n        \"declaration\",\n        \"interface_member\",\n        \"callsite\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"material_id\": {\n      \"title\": \"Material Id\",\n      \"type\": \"string\"\n    },\n    \"start_line\": {\n      \"minimum\": 1,\n      \"title\": \"Start Line\",\n      \"type\": \"integer\"\n    },\n    \"end_line\": {\n      \"minimum\": 1,\n      \"title\": \"End Line\",\n      \"type\": \"integer\"\n    },\n    \"symbol\": {\n      \"title\": \"Symbol\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"material_id\",\n    \"start_line\",\n    \"end_line\",\n    \"symbol\"\n  ],\n  \"title\": \"CodeAnchor\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
