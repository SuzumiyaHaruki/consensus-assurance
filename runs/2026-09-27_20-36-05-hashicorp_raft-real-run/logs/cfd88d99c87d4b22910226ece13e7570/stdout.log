{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p' ../native-source/commands.go; sed -n '107,125p' ../native-source/inmem_transport.go; sed -n '1440,1481p' ../native-source/raft.go; sed -n '388,441p' ../native-source/replication.go; sed -n '272,296p' ../native-source/future.go\"","aggregated_output":"// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\n// RPCHeader is a common sub-structure used to pass along protocol version and\n// other information about the cluster. For older Raft implementations before\n// versioning was added this will default to a zero-valued structure when read\n// by newer Raft versions.\ntype RPCHeader struct {\n\t// ProtocolVersion is the version of the protocol the sender is\n\t// speaking.\n\tProtocolVersion ProtocolVersion\n\t// ID is the ServerID of the node sending the RPC Request or Response\n\tID []byte\n\t// Addr is the ServerAddr of the node sending the RPC Request or Response\n\tAddr []byte\n}\n\n// WithRPCHeader is an interface that exposes the RPC header.\ntype WithRPCHeader interface {\n\tGetRPCHeader() RPCHeader\n}\n\n// AppendEntriesRequest is the command used to append entries to the\n// replicated log.\ntype AppendEntriesRequest struct {\n\tRPCHeader\n\n\t// Provide the current term and leader\n\tTerm uint64\n\n\t// Deprecated: use RPCHeader.Addr instead\n\tLeader []byte\n\n\t// Provide the previous entries for integrity checking\n\tPrevLogEntry uint64\n\tPrevLogTerm  uint64\n\n\t// New entries to commit\n\tEntries []*Log\n\n\t// Commit index on the leader\n\tLeaderCommitIndex uint64\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *AppendEntriesRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// AppendEntriesResponse is the response returned from an\n// AppendEntriesRequest.\ntype AppendEntriesResponse struct {\n\tRPCHeader\n\n\t// Newer term if leader is out of date\n\tTerm uint64\n\n\t// Last Log is a hint to help accelerate rebuilding slow nodes\n\tLastLog uint64\n\n\t// We may not succeed if we have a conflicting entry\n\tSuccess bool\n\n\t// There are scenarios where this request didn't succeed\n\t// but there's no need to wait/back-off the next attempt.\n\tNoRetryBackoff bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *AppendEntriesResponse) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\n// RequestVoteRequest is the command used by a candidate to ask a Raft peer\n// for a vote in an election.\ntype RequestVoteRequest struct {\n\tRPCHeader\n\n\t// Provide the term and our id\n\tTerm uint64\n\n\t// Deprecated: use RPCHeader.Addr instead\n\tCandidate []byte\n\n\t// Used to ensure safety\n\tLastLogIndex uint64\n\tLastLogTerm  uint64\n\n\t// Used to indicate to peers if this vote was triggered by a leadership\n\t// transfer. It is required for leadership transfer to work, because servers\n\t// wouldn't vote otherwise if they are aware of an existing leader.\n\tLeadershipTransfer bool\n}\n\n// GetRPCHeader - See WithRPCHeader.\nfunc (r *RequestVoteRequest) GetRPCHeader() RPCHeader {\n\treturn r.RPCHeader\n}\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*AppendEntriesResponse)\n\t*resp = *out\n\treturn nil\n}\n\n// RequestVote implements the Transport interface.\nfunc (i *InmemTransport) RequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*RequestVoteResponse)\n\t*resp = *out\n\treturn nil\nfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n\t// Setup a response\n\tresp := &AppendEntriesResponse{\n\t\tRPCHeader:      r.getRPCHeader(),\n\t\tTerm:           r.getCurrentTerm(),\n\t\tLastLog:        r.getLastIndex(),\n\t\tSuccess:        false,\n\t\tNoRetryBackoff: false,\n\t}\n\tvar rpcErr error\n\tdefer func() {\n\t\trpc.Respond(resp, rpcErr)\n\t}()\n\n\t// Ignore an older term\n\tif a.Term < r.getCurrentTerm() {\n\t\treturn\n\t}\n\n\t// Increase the term if we see a newer one, also transition to follower\n\t// if we ever get an appendEntries call\n\tif a.Term > r.getCurrentTerm() || (r.getState() != Follower && !r.candidateFromLeadershipTransfer.Load()) {\n\t\t// Ensure transition to follower\n\t\tr.setState(Follower)\n\t\tr.setCurrentTerm(a.Term)\n\t\tresp.Term = a.Term\n\t}\n\n\t// Save the current leader\n\tif len(a.Addr) > 0 {\n\t\tr.setLeader(r.trans.DecodePeer(a.Addr), ServerID(a.ID))\n\t} else {\n\t\tr.setLeader(r.trans.DecodePeer(a.Leader), ServerID(a.ID))\n\t}\n\t// Verify the last log entry\n\tif a.PrevLogEntry > 0 {\n\t\tlastIdx, lastTerm := r.getLastEntry()\n\n\t\tvar prevLogTerm uint64\n\t\tif a.PrevLogEntry == lastIdx {\n\t\t\tprevLogTerm = lastTerm\nfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n\tvar failures uint64\n\treq := AppendEntriesRequest{\n\t\tRPCHeader: r.getRPCHeader(),\n\t\tTerm:      s.currentTerm,\n\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n\t}\n\n\tvar resp AppendEntriesResponse\n\tfor {\n\t\t// Wait for the next heartbeat interval or forced notify\n\t\tselect {\n\t\tcase <-s.notifyCh:\n\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n\t\tcase <-stopCh:\n\t\t\treturn\n\t\t}\n\n\t\ts.peerLock.RLock()\n\t\tpeer := s.peer\n\t\ts.peerLock.RUnlock()\n\n\t\tstart := time.Now()\n\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n\t\t\t\tnextBackoffTime, \"error\", err)\n\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n\t\t\tfailures++\n\t\t\tselect {\n\t\t\tcase <-time.After(nextBackoffTime):\n\t\t\tcase <-stopCh:\n\t\t\t\treturn\n\t\t\t}\n\t\t} else {\n\t\t\tif failures > 0 {\n\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n\t\t\t}\n\t\t\ts.setLastContact()\n\t\t\tfailures = 0\n\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n\n\t\t\tif !r.noLegacyTelemetry {\n\t\t\t\t// Duplicated information. Kept for backward compatibility.\n\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n\t\t\t}\n\n\t\t\ts.notifyAll(resp.Success)\n\t\t}\n\t}\n}\n\n// vote is used to respond to a verifyFuture.\n// This may block when responding on the notifyCh.\nfunc (v *verifyFuture) vote(leader bool) {\n\tv.voteLock.Lock()\n\tdefer v.voteLock.Unlock()\n\n\t// Guard against having notified already\n\tif v.notifyCh == nil {\n\t\treturn\n\t}\n\n\tif leader {\n\t\tv.votes++\n\t\tif v.votes >= v.quorumSize {\n\t\t\tv.notifyCh <- v\n\t\t\tv.notifyCh = nil\n\t\t}\n\t} else {\n\t\tv.notifyCh <- v\n\t\tv.notifyCh = nil\n\t}\n}\n\n// appendFuture is used for waiting on a pipelined append\n// entries RPC.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nr=json.load(open('../research.json'));m=json.load(open(r['audit_spec_path']));bs={b['id']:b for b in m['behaviors']};fs={f['id']:f for f in m['facts']}\ndirect=['B-heartbeat','B-verify-notify'];support={'B-append':'Produces the actual stale-term rejection response; its early-return branch leaves Success false and RPC error nil.','B-repl':'Contrasting ordinary response path checks higher terms before reporting support.','B-authority-life':'Lease checks use contact freshness and are a separate consumer from verification.','B-verify-finish':'Consumes the resulting negative verification wake-up and fails the public future below threshold.'}\nsources=set(fs['F-peer-positive']['source_ids'])|{'S-inmem-rpc','S-command-response'}\nfor bid in direct+list(support):sources.update(bs[bid]['source_ids'])\nq=dict(question='For an actual heartbeat rejected by the receiver because its request term is stale, can error-free transport return alone convert that rejection into positive VerifyLeader support?',importance='The heartbeat path refreshes lastContact without the higher-term branch used by ordinary replication. Confusing transport completion with positive protocol support could incorrectly confirm authority. This question isolates that conversion; continued local Leader state and stale application reads are separate questions.',source_ids=sorted(sources),participants=['heartbeat sender','higher-term receiver','pending VerifyLeader caller'],objects=['AppendEntriesResponse.Success','followerReplication.notify','verifyFuture'],contexts=['Actual non-Byzantine receiver rejects an older request term','A pending future is registered before the negative notification','No prior completed positive quorum is retroactively retracted'],event_paths=['appendEntries initializes Success=false -> rejects older term -> RPC response with nil error -> InmemTransport copies response -> heartbeat notifyAll(false) -> vote(false) wakes main loop'],activity_classes=['A2'],behavior_ids=direct,fact_ids=['F-peer-positive'],supporting_behavior_ids=support,obligation_relation_kind='establishment',counterevidence=['Source protection: appendEntries initializes Success=false and returns before the success assignment on stale term.','Source protection: heartbeat forwards resp.Success, not err==nil, to notifyAll.','Source protection: vote(false) does not increment votes and wakes leaderLoop for a below-quorum rejection.'],unknowns=['Refreshing lastContact for a stale-term rejection can affect lease-based role retention; that independent question requires a same-history newer term and analysis of ordinary replication and inbound RPC stepdown paths.','A reply produced successfully before a later term change is not the stale-rejection case closed here.','A future already completed using other positive support ignores later negative notifications; this disposition does not validate that earlier support.'],priority=2,trigger_rationale='After the confirmed mixed-membership support witness, compare the asynchronous heartbeat branch with ordinary replication. Fresh source inspection of the response type and in-memory copying shows protocol Success is preserved independently of transport error. This closes the narrow conversion suspicion while retaining contact/lease and delayed-positive-reply questions.',disposition='explained_by_existing_mechanism',preferred_check='source_review')\ns=dict(action='explained',question=q,sources=[dict(id='S-command-response',file='commands.go',start_line=52,end_line=70,kind='interface_statement')],rationale='Source explanation closes only the proposed conversion of an actual stale-term rejection into positive verification support: nil transport error is distinct from Success, the receiver returns false, and the heartbeat forwards that false unchanged. No execution Evidence is created. Frontier comparison: the previously checked nonvoter eligibility question is confirmed locally but broader stale-read effects require a new authority/application endpoint; heartbeat contact/lease retention has a concrete asynchronous consumer but ordinary replication and incoming higher-term RPCs may force stepdown; delayed snapshot ordering has higher potential application consequence but needs a longer legal prefix and snapshot producer. The next useful discriminator is the exact contract for contact-based role retention, since this source closure leaves its distinct consumer unexplained.',feedback=dict(ref_ids=['f33d00777fe2480c95d12d871ba5890b','13d1ff41f04c4d28a41c8b0eaee0560d','e450db195a5e4546869cbd65c48c80b5','S-heartbeat','S-repl','S-lease','S-verify-vote'],answered='Controller now records the nonvoter support witness as confirmed in scope with no blockers. The follow-on source comparison distinguishes contact refresh from positive verification support: actual stale rejection is forwarded as a negative notification.',remaining=q['unknowns'],understanding='unchanged',rationale='Existing map already contains the response flag protection and the separate lease consumer. Preserve the confirmed local witness, close this narrow source-level branch suspicion, and use the remaining contact/lease question to guide contract reading rather than claiming general authority safety.'))\nPath('submission-heartbeat-explained.json').write_text(json.dumps(s,indent=2)+'\\\\n')\nimport jsonschema\njsonschema.validate(s,json.load(open('../native-submission.schema.json')))\nprint('Source-explanation submission schema validated.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
