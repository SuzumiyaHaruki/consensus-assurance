<- err\n\t\t\t\treturn\n\t\t\t}\n\t\tcase <-stopCh:\n\t\t\tdoneCh <- nil\n\t\t\treturn\n\t\t}\n\t}\n\n\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n\t// messaging for read-only queries. If this is implemented, the lease\n\t// has to be reset as well, in case leadership is transferred. This\n\t// implementation also has a lease, but it serves another purpose and\n\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n\t// setup in a similar way to the one in the thesis, but in practice\n\t// it's a timer that just tells the leader how often to check\n\t// heartbeats are still coming in.\n\n\t// Step 3: send TimeoutNow message to target server.\n\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n\tif err != nil {\n\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n\t}\n\tdoneCh <- err\n}\n\n// checkLeaderLease is used to check if we can contact a quorum of nodes\n// within the last leader lease interval. If not, we need to step down,\n// as we may have lost connectivity. Returns the maximum duration without\n// contact. This must only be called from the main thread.\nfunc (r *Raft) checkLeaderLease() time.Duration {\n\t// Track contacted nodes, we can always contact ourself\n\tcontacted := 0\n\n\t// Store lease timeout for this one check invocation as we need to refer to it\n\t// in the loop and would be confusing if it ever becomes reloadable and\n\t// changes between iterations below.\n\tleaseTimeout := r.config().LeaderLeaseTimeout\n\n\t// Check each follower\n\tvar maxDiff time.Duration\n\tnow := time.Now()\n\tfor _, server := range r.configurations.latest.Servers {\n\t\tif server.Suffrage == Voter {\n\t\t\tif server.ID == r.localID {\n\t\t\t\tcontacted++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tf := r.leaderState.replState[server.ID]\n\t\t\tdiff := now.Sub(f.LastContact())\n\t\t\tif diff <= leaseTimeout {\n\t\t\t\tcontacted++\n\t\t\t\tif diff > maxDiff {\n\t\t\t\t\tmaxDiff = diff\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n\t\t\t\tif diff <= 3*leaseTimeout {\n\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n\t\t\t\t} else {\n\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n\t\t\t\t}\n\t\t\t}\n\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n\t\t}\n\t}\n\n\t// Verify we can contact a quorum\n\tquorum := r.quorumSize()\n\tif contacted < quorum {\n\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n\t\tr.setState(Follower)\n\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n\t}\n\treturn maxDiff\n}\n\n// quorumSize is used to return the quorum size. This must only be called on\n// the main thread.\n// TODO: revisit usage\nfunc (r *Raft) quorumSize() int {\n\tvoters := 0\n\tfor _, server := range r.configurations.latest.Servers {\n\t\tif server.Suffrage == Voter {\n\t\t\tvoters++\n\t\t}\n\t}\n\treturn voters/2 + 1\n}\n\n// restoreUserSnapshot is used to manually consume an external snapshot, such\n// as if restoring from a backup. We will use the current Raft configuration,\n// not the one from the snapshot, so that we can restore into a new cluster. We\n// will also use the higher of the index of the snapshot, or the current index,\n// and then add 1 to that, so we force a new state with a hole in the Raft log,\n\tstopCh chan uint64\n\n\t// triggerCh is notified every time new entries are appended to the log.\n\ttriggerCh chan struct{}\n\n\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n\t// deferErr, the sender can be notified when the replication is done.\n\ttriggerDeferErrorCh chan *deferError\n\n\t// lastContact is updated to the current time whenever any response is\n\t// received from the follower (successful or not). This is used to check\n\t// whether the leader should step down (Raft.checkLeaderLease()).\n\tlastContact time.Time\n\t// lastContactLock protects 'lastContact'.\n\tlastContactLock sync.RWMutex\n\n\t// failures counts the number of failed RPCs since the last success, which is\n../native-source/config.go:201:\t// LeaderLeaseTimeout is used to control how long the \"lease\" lasts\n../native-source/api.go:1126:// LastContact returns the time of last contact by a leader.\n../native-source/api.go:1128:func (r *Raft) LastContact() time.Time {\n../native-source/api.go:1209:\tlast := r.LastContact()\n../native-source/raft_test.go:395:\t\tt.Fatalf(\"expected newer term! %d %d (%v, %v)\", newLead.getCurrentTerm(), leaderTerm, newLead, leader)\n../native-source/raft_test.go:460:\tif behind.LastContact().IsZero() {\n../native-source/raft_test.go:1746:\t// Rejoin. The follower will have a higher term than the leader,\n../native-source/raft_test.go:1811:\tif leader.LastContact().IsZero() {\n../native-source/raft_test.go:1821:\tlast := follower.LastContact()\n../native-source/raft_test.go:1825:\tif last != follower.LastContact() {\n../native-source/raft_test.go:3004:\t// set that follower term to higher term to faster simulate a partitioning\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"agent_message","text":"The source defines `lastContact` as contact even when a reply rejects the request, and describes the leader lease as a connectivity check rather than a read lease. I’ll record that distinction in the map. Whether missing higher-term handling lets an old leader retain authority long enough to cause a public error remains a separate, unexecuted question.\n"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nr=json.load(open('../research.json'));m=json.load(open(r['audit_spec_path']));m['version']=r['audit_spec_version']\nfor a in m['activities']:a.pop('behavior_ids',None)\nfor f in m['facts']:\n f.pop('established_by',None);f.pop('consumed_by',None)\nchanged={}\nfor b in m['behaviors']:\n if b['id'] in ['B-authority-life','B-repl','B-heartbeat','B-snapshot']:\n  b.setdefault('produces_fact_ids',[]).append('F-contact-budget')\n  changed[b['id']]=dict(impact='dependency',source_ids=b['source_ids'],rationale='Expose the distinct contact-budget output already written on this path. This is an independent lease consumer, not a changed identity, producer, eligibility or meaning of F-peer-positive used by the completed nonvoter witness. Leader initialization grants initial credit; response paths refresh it under their existing conditions.')\nm['facts'].append(dict(id='F-contact-budget',meaning='The implementation has granted this replication worker a locally timestamped contact budget for its peer. Initialization grants credit without a received reply; later error-free response paths refresh credit under their path-specific guards. This budget does not assert successful append, current-term authority confirmation or replicated history.',identity={'worker':'followerReplication instance in one leadership period','peer':'worker peer ServerID','timestamp':'lastContact value written under its lock'},validity_context='Local elapsed-time comparison by checkLeaderLease, restricted there to the latest configuration voters. Credit expires by age, can be refreshed, and is discarded with the leadership worker set.',representation=['followerReplication.lastContact'],durability='Volatile local time observation or initial grace credit; no persistence claim.',recovery='A new leadership period creates new replication workers with time.Now initial credit.',source_ids=['S-leader','S-repl','S-heartbeat','S-snapshot-send','S-lease','S-transfer'],invalidators=['B-authority-life'],reinterpreters=['B-membership'],unknowns=['Whether stale-term heartbeat replies can keep this budget fresh during a reachable concurrent newer leadership history, despite ordinary replication and incoming higher-term RPC protections, is unexecuted.']))\nm['behaviors'].append(dict(id='B-lease-check',primary_activity='A2',execution_owner='Leader main loop',protocol_context='Current local leadership period, latest voter membership and configured LeaderLeaseTimeout',trigger='Leader lease timer fires',implementation_guards=['Count only Voter members; count local voter as contacted.','For each remote voter compare now minus worker.LastContact to lease timeout.','If contacted count is below quorumSize, set Follower.'],reads=['latest configuration','per-peer lastContact under read lock'],writes=['Local role becomes Follower when recent contact count is insufficient.'],important_branches=['This consumer does not inspect response term or Success; those are path-specific producer fields.','Freshly initialized peers have initial credit even before a reply.','A sufficient contact count leaves the local role unchanged but does not complete an Apply or VerifyLeader future.'],consumes_fact_ids=['F-contact-budget'],source_ids=['S-lease','S-leader','S-transfer'],existing_protections=['Voter filter; elapsed-time cutoff; independent data replication and incoming RPCs can force stepdown.'],cross_activity_effects={'A7':'This is not a read authority lease: the implementation explicitly distinguishes it from read-query leases, and public VerifyLeader has a separate support path.'},unknowns=['Scheduling of the lease timer while the main loop is blocked requires its own scoped history and deadline contract.']))\nfor a in m['activities']:\n if a['class_id']=='A2':a['realization_summary']+=' Contact-budget expiry is a distinct voter-filtered connectivity check; it does not prove positive authority support.'\nfor key in ['context','connection']:\n m['core_overview'][key]['behavior_ids'].append('B-lease-check')\n m['core_overview'][key]['fact_ids'].append('F-contact-budget')\n m['core_overview'][key]['source_ids']=sorted(set(m['core_overview'][key]['source_ids'])|{'S-lease','S-transfer','S-leader','S-repl','S-heartbeat','S-snapshot-send'})\nm['core_overview']['connection']['explanation']+=' Separately, F-contact-budget is timestamped initial grace or response contact, not an acknowledgement of authority: checkLeaderLease counts fresh voter budgets; leadershipTransfer comments explicitly distinguish this mechanism from a read-query lease.'\nfor surf in m['surfaces']:\n if surf['entry_point']=='heartbeat versus replicateTo higher-term handling':\n  surf['behavior_ids']=list(dict.fromkeys(surf['behavior_ids']+['B-lease-check']))\n  surf['reason']='Separate contact credit from positive verification support. A real stale rejection remains negative for verification, but an error-free heartbeat still refreshes contact credit. Connectivity-only lease semantics explain why Success is not checked here; a broader higher-term authority-retention consequence still needs a legal concurrent history and public endpoint.'\n  surf['source_ids']=sorted(set(surf['source_ids'])|{'S-transfer','S-leader'})\nPath('audit-map-contact.json').write_text(json.dumps(m,indent=2)+'\\\\n')\ns=dict(action='research',map_path='audit-map-contact.json',map_changes=changed,rationale='Add the source-grounded contact-budget lifecycle and its distinct lease consumer after the reviewed support-eligibility witness and source closure of stale-rejection conversion. Source comments and actual consumption define connectivity, not a read lease. No existing Fact meaning, obligation, checker or witness is changed; this exposes another independent output/consumer of already mapped workers. Frontier comparison: stronger nonvoter stale-read consequence needs a newer leader plus application endpoint; heartbeat contact retention needs a legal term-transition history retaining ordinary/inbound stepdown paths; snapshot ordering needs actual snapshot creation and delayed delivery; crash persistence needs a concrete fault contract. Contact semantics are now mapped, while these stronger propositions remain open.',feedback=dict(ref_ids=['7346b963dffd45088c4df0f31ac4d432','e450db195a5e4546869cbd65c48c80b5','S-transfer','S-lease','S-repl','S-heartbeat','f33d00777fe2480c95d12d871ba5890b'],answered='The lease consumer uses a local contact budget, initially seeded and later refreshed by transport responses, including unsuccessful heartbeat replies. Its sourced responsibility is connectivity-based stepdown, not authority certification for reads. This explains why contact refresh alone is not a newly established API violation and preserves the separate confirmed verification-eligibility witness.',remaining=['A legal newer-term history and public endpoint are still needed before attributing an authority-retention consequence to stale heartbeat contact refresh.','Delayed snapshot ordering and storage failure recovery remain separate unexpanded safety directions.'],understanding='updated',rationale='Add reusable contact semantics to the accepted map rather than retaining them as candidate-specific speculation. The next selection should prioritize a concrete externally observed consequence over another timer-only observation.'))\nPath('submission-contact-map.json').write_text(json.dumps(s,indent=2)+'\\\\n')\nimport jsonschema\njsonschema.validate(m,json.load(open('../product-schemas.json'))['ConsensusAuditSpec'])\njsonschema.validate(s,json.load(open('../native-submission.schema.json')))\nprint('Map and submission schemas validated.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
