{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../direct-checks/563626623cf144f5a145827eb45c0351/assurance_generated_test.go; python3 - <<'PY'\nimport json\np='../logs/e30e751a96ef45c8b43640539253ffe4/'\nc=json.load(open(p+'check.json'))\nprint('RUN',c['status'],c['exit_code']);print('checker_results',json.dumps(c.get('checker_results'),indent=2))\nfor num,l in enumerate(open(p+'stdout.log'),1):\n x=json.loads(l);o=x.get('Output','')\n if o.startswith('CA_EVENT '):\n  ev=json.loads(o[9:]);snapshot=ev.pop('snapshot',None); print('line',num,ev)\n  if snapshot:\n   s=json.loads(snapshot);print('policy',s['policy']);print('queue',s['queue'])\n   for n in s['nodes']:\n    n=n['value']; ra=n['raft']['value']; print('node',ra['id'],'timers',ra['electionElapsed'],ra['heartbeatElapsed'],ra['randomizedElectionTimeout'],'pending',ra['pendingReadIndexMessages'],ra['msgs'],ra['msgsAfterAppend'],'raw-prev',n['prevHardSt'],n['stepsOnAdvance']); print('log',ra['raftLog']['value'])\nprint('STDERR',open(p+'stderr.log').read())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../direct-checks/563626623cf144f5a145827eb45c0351/assurance_generated_test.go; python3 - <<'PY'\nimport json\np='../logs/e30e751a96ef45c8b43640539253ffe4/'\nc=json.load(open(p+'check.json'))\nprint('RUN',c['status'],c['exit_code']);print('checker_results',json.dumps(c.get('checker_results'),indent=2))\nfor num,l in enumerate(open(p+'stdout.log'),1):\n x=json.loads(l);o=x.get('Output','')\n if o.startswith('CA_EVENT '):\n  ev=json.loads(o[9:]);snapshot=ev.pop('snapshot',None); print('line',num,ev)\n  if snapshot:\n   s=json.loads(snapshot);print('policy',s['policy']);print('queue',s['queue'])\n   for n in s['nodes']:\n    n=n['value']; ra=n['raft']['value']; print('node',ra['id'],'timers',ra['electionElapsed'],ra['heartbeatElapsed'],ra['randomizedElectionTimeout'],'pending',ra['pendingReadIndexMessages'],ra['msgs'],ra['msgsAfterAppend'],'raw-prev',n['prevHardSt'],n['stepsOnAdvance']); print('log',ra['raftLog']['value'])\nprint('STDERR',open(p+'stderr.log').read())\nPY\"","aggregated_output":"     1\tpackage raft\n     2\t\n     3\timport (\n     4\t    \"encoding/json\"\n     5\t    \"fmt\"\n     6\t    \"reflect\"\n     7\t    \"testing\"\n     8\t\n     9\t    pb \"go.etcd.io/raft/v3/raftpb\"\n    10\t)\n    11\t\n    12\t// This driver uses only actual RawNode output as peer traffic. All calls are\n    13\t// serialized; persistence, configuration application and Advance finish each\n    14\t// Ready before accepting another Ready from that node.\n    15\ttype assuranceTransferEnv struct {\n    16\t    t *testing.T\n    17\t    nodes []*RawNode\n    18\t    stores []*MemoryStorage\n    19\t    queue []pb.Message\n    20\t    armed, triggered, dropTimeout bool\n    21\t    dropped, delivered, readies, applyBatches int\n    22\t    tick int\n    23\t    configIndex uint64\n    24\t    cycleTracking, cycleOnlyHeartbeats, cycleRolesStable bool\n    25\t}\n    26\t\n    27\tfunc (e *assuranceTransferEnv) emit(phase string) {\n    28\t    r := e.nodes[0].raft\n    29\t    out := map[string]interface{}{\n    30\t        \"event\": phase, \"operation_id\":\"remove-node3-implicit-1\", \"scenario\":\"failed_transfer_idle\", \"config_index\":e.configIndex, \"phase\": phase, \"tick\": e.tick, \"triggered\": e.triggered,\n    31\t        \"term\": r.Term, \"role\": r.state.String(), \"leader\": r.lead,\n    32\t        \"transferee\": r.leadTransferee, \"last\": r.raftLog.lastIndex(),\n    33\t        \"commit\": r.raftLog.committed, \"applied\": r.raftLog.applied,\n    34\t        \"pending_conf\": r.pendingConfIndex, \"config\": r.trk.ConfState(),\n    35\t        \"queue\": len(e.queue), \"drained\":e.drained(), \"all_applied_config\":e.allAppliedConfig(), \"dropped_timeout_now\": e.dropped,\n    36\t        \"delivered\": e.delivered, \"readies\": e.readies,\n    37\t        \"apply_batches\": e.applyBatches,\n    38\t    }\n    39\t    b, err := json.Marshal(out)\n    40\t    if err != nil { e.t.Fatal(err) }\n    41\t    fmt.Println(\"CA_EVENT \" + string(b))\n    42\t}\n    43\t\n    44\tfunc (e *assuranceTransferEnv) ready(i int) bool {\n    45\t    n, s := e.nodes[i], e.stores[i]\n    46\t    if !n.HasReady() { return false }\n    47\t    rd := n.Ready()\n    48\t    e.readies++\n    49\t    if !IsEmptySnap(rd.Snapshot) {\n    50\t        if err := s.ApplySnapshot(rd.Snapshot); err != nil { e.t.Fatal(err) }\n    51\t    }\n    52\t    if err := s.Append(rd.Entries); err != nil { e.t.Fatal(err) }\n    53\t    if !IsEmptyHardState(rd.HardState) {\n    54\t        if err := s.SetHardState(rd.HardState); err != nil { e.t.Fatal(err) }\n    55\t    }\n    56\t    if len(rd.CommittedEntries) > 0 { e.applyBatches++ }\n    57\t    for _, ent := range rd.CommittedEntries {\n    58\t        switch ent.Type {\n    59\t        case pb.EntryConfChange:\n    60\t            var cc pb.ConfChange\n    61\t            if err := cc.Unmarshal(ent.Data); err != nil { e.t.Fatal(err) }\n    62\t            n.ApplyConfChange(cc)\n    63\t        case pb.EntryConfChangeV2:\n    64\t            var cc pb.ConfChangeV2\n    65\t            if err := cc.Unmarshal(ent.Data); err != nil { e.t.Fatal(err) }\n    66\t            n.ApplyConfChange(cc)\n    67\t            if i == 0 && e.armed && !e.triggered && string(cc.Context) == \"enter\" {\n    68\t                // Configuration is genuinely committed and applied. Transfer\n    69\t                // interleaves before the caller acknowledges this Ready.\n    70\t                e.triggered = true\n    71\t                e.configIndex = ent.Index\n    72\t                n.TransferLeader(2)\n    73\t                if n.raft.leadTransferee != 2 { e.t.Fatal(\"transfer not admitted\") }\n    74\t                e.emit(\"transfer_before_application_ack\")\n    75\t            }\n    76\t        }\n    77\t    }\n    78\t    // Storage is complete before releasing any peer message from this Ready.\n    79\t    e.queue = append(e.queue, rd.Messages...)\n    80\t    n.Advance(rd)\n    81\t    return true\n    82\t}\n    83\t\n    84\tfunc (e *assuranceTransferEnv) pump() {\n    85\t    for work := 0; work < 20000; work++ {\n    86\t        changed := false\n    87\t        for i := range e.nodes { if e.ready(i) { changed = true } }\n    88\t        if len(e.queue) > 0 {\n    89\t            m := e.queue[0]\n    90\t            if e.cycleTracking && m.Type != pb.MsgHeartbeat && m.Type != pb.MsgHeartbeatResp { e.cycleOnlyHeartbeats = false }\n    91\t            e.queue = e.queue[1:]\n    92\t            if e.dropTimeout && m.Type == pb.MsgTimeoutNow {\n    93\t                e.dropped++\n    94\t            } else {\n    95\t                if m.To < 1 || m.To > uint64(len(e.nodes)) { e.t.Fatalf(\"unknown destination %d\", m.To) }\n    96\t                err := e.nodes[m.To-1].Step(m)\n    97\t                if err != nil && err != ErrStepPeerNotFound { e.t.Fatal(err) }\n    98\t                e.delivered++\n    99\t                e.recordRoles()\n   100\t            }\n   101\t            changed = true\n   102\t        }\n   103\t        if !changed { return }\n   104\t    }\n   105\t    e.t.Fatal(\"driver work bound reached before queues drained\")\n   106\t}\n   107\t\n   108\tfunc TestAssuranceTransferAutoLeaveCycle(t *testing.T) {\n   109\t    e := &assuranceTransferEnv{t:t, dropTimeout:true}\n   110\t    peers := []Peer{{ID:1}, {ID:2}, {ID:3}}\n   111\t    for id := uint64(1); id <= 3; id++ {\n   112\t        s := NewMemoryStorage()\n   113\t        n, err := NewRawNode(&Config{ID:id, ElectionTick:10, HeartbeatTick:1,\n   114\t            Storage:s, MaxSizePerMsg:4096, MaxInflightMsgs:16, CheckQuorum:true})\n   115\t        if err != nil { t.Fatal(err) }\n   116\t        if err := n.Bootstrap(peers); err != nil { t.Fatal(err) }\n   117\t        e.nodes = append(e.nodes,n)\n   118\t        e.stores = append(e.stores,s)\n   119\t    }\n   120\t    e.pump()\n   121\t    if err := e.nodes[0].Campaign(); err != nil { t.Fatal(err) }\n   122\t    e.pump()\n   123\t    if e.nodes[0].raft.state != StateLeader { t.Fatal(\"campaign did not elect node 1\") }\n   124\t    e.emit(\"elected_and_drained\")\n   125\t    e.armed = true\n   126\t    cc := pb.ConfChangeV2{Transition:pb.ConfChangeTransitionJointImplicit,\n   127\t        Changes:[]pb.ConfChangeSingle{{Type:pb.ConfChangeRemoveNode,NodeID:3}}, Context:[]byte(\"enter\")}\n   128\t    if err := e.nodes[0].ProposeConfChange(cc); err != nil { t.Fatal(err) }\n   129\t    e.pump()\n   130\t    if !e.triggered || e.dropped == 0 { t.Fatal(\"overlap or transport fault not reached\") }\n   131\t    e.emit(\"admitted\")\n   132\t    var cycleStart string\n   133\t    var readyStart, deliveredStart, applyStart int\n   134\t    for e.tick < 30 {\n   135\t        e.tick++\n   136\t        for _, n := range e.nodes { n.Tick(); e.recordRoles() }\n   137\t        e.pump()\n   138\t        if e.tick == 10 {\n   139\t            // The bounded loss period ends. All later traffic is delivered.\n   140\t            e.dropTimeout = false\n   141\t            e.emit(\"transfer_timeout\")\n   142\t        }\n   143\t        if e.tick == 20 {\n   144\t            e.cycleTracking = true\n   145\t            e.cycleOnlyHeartbeats = true\n   146\t            e.cycleRolesStable = true\n   147\t            readyStart, deliveredStart, applyStart = e.readies, e.delivered, e.applyBatches\n   148\t            cycleStart = e.snapshot()\n   149\t            e.output(map[string]interface{}{\"event\":\"cycle_start\", \"snapshot\":cycleStart, \"tick\":e.tick})\n   150\t        }\n   151\t        if e.tick == 30 {\n   152\t            finish := e.snapshot()\n   153\t            drained := e.drained()\n   154\t            r := e.nodes[0].raft\n   155\t            equal := cycleStart == finish\n   156\t            pending := r.trk.AutoLeave && len(r.trk.Voters[1]) > 0\n   157\t            unchangedTail := r.raftLog.lastIndex() == e.configIndex && r.raftLog.committed == e.configIndex && r.raftLog.applied == e.configIndex\n   158\t            closed := equal && drained && e.cycleOnlyHeartbeats && e.cycleRolesStable && e.applyBatches == applyStart\n   159\t            e.output(map[string]interface{}{\n   160\t                \"event\":\"cycle_result\", \"tick\":e.tick, \"snapshot\":finish,\n   161\t                \"same_state\":equal, \"drained\":drained,\n   162\t                \"only_heartbeats\":e.cycleOnlyHeartbeats, \"roles_stable\":e.cycleRolesStable,\n   163\t                \"ready_delta\":e.readies-readyStart, \"message_delta\":e.delivered-deliveredStart,\n   164\t                \"apply_delta\":e.applyBatches-applyStart, \"joint_pending\":pending,\n   165\t                \"unchanged_tail\":unchangedTail, \"transferee\":r.leadTransferee,\n   166\t                \"forbidden_idle_cycle\":closed && pending && unchangedTail && r.leadTransferee == 0,\n   167\t            })\n   168\t            e.cycleTracking = false\n   169\t        }\n   170\t    }\n   171\t    // Separate rescue phase: ordinary client work is an additional stimulus,\n   172\t    // not silently included in the automatic-continuation observation.\n   173\t    if err := e.nodes[0].Propose([]byte(\"rescue\")); err != nil { t.Fatal(err) }\n   174\t    e.pump()\n   175\t    e.emit(\"after_unrelated_proposal\")\n   176\t}\n   177\t\n   178\t\n   179\t// A read-only structural projection, not a hash or an expected-state template.\n   180\t// All target fields are retained except diagnostic loggers/call counters and\n   181\t// the MemoryStorage mutex, which is unlocked throughout this serialized model.\n   182\t// Function code identities are retained; their bound raft receivers are also\n   183\t// recursively captured. No protocol field is written by this observer.\n   184\tfunc assuranceProjection(v reflect.Value) interface{} {\n   185\t    if !v.IsValid() { return nil }\n   186\t    switch v.Kind() {\n   187\t    case reflect.Pointer, reflect.Interface:\n   188\t        if v.IsNil() { return nil }\n   189\t        return map[string]interface{}{\"type\":v.Type().String(),\"value\":assuranceProjection(v.Elem())}\n   190\t    case reflect.Struct:\n   191\t        out := map[string]interface{}{}\n   192\t        for i:=0; i<v.NumField(); i++ {\n   193\t            name := v.Type().Field(i).Name\n   194\t            typ := v.Type().String()\n   195\t            if (typ == \"raft.raft\" && (name == \"logger\" || name == \"traceLogger\")) ||\n   196\t               ((typ == \"raft.raftLog\" || typ == \"raft.unstable\") && name == \"logger\") ||\n   197\t               (typ == \"raft.MemoryStorage\" && (name == \"Mutex\" || name == \"callStats\")) { continue }\n   198\t            out[name] = assuranceProjection(v.Field(i))\n   199\t        }\n   200\t        return out\n   201\t    case reflect.Slice, reflect.Array:\n   202\t        if v.Kind() == reflect.Slice && v.IsN