ull\"\n            }\n          ],\n          \"default\": null\n        },\n        \"repair_of\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n          \"title\": \"Repair Of\"\n        },\n        \"action\": {\n          \"const\": \"explore\",\n          \"title\": \"Action\",\n          \"type\": \"string\"\n        },\n        \"question\": {\n          \"minLength\": 1,\n          \"title\": \"Question\",\n          \"type\": \"string\"\n        },\n        \"harness_path\": {\n          \"title\": \"Harness Path\",\n          \"type\": \"string\"\n        },\n        \"execution_package\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"description\": \"Optional single local Go package or Rust crate directory, with the same meaning as Harness.execution_package\",\n          \"title\": \"Execution Package\"\n        },\n        \"files\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"default\": {},\n          \"title\": \"Files\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"question\",\n        \"harness_path\"\n      ],\n      \"title\": \"ExploreSubmission\",\n      \"type\": \"object\"\n    },\n    \"Grounding\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"source_ids\": {\n          \"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n       