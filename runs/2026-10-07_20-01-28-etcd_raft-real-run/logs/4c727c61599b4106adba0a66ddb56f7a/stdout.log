{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nx=json.load(open('../product-schemas.json'))['ConsensusAuditSpec']['\"'$defs'\"']\nfor k in ['Activity','CoreOverview','Fact','Surface','Behavior']:\n print(k, json.dumps(x[k],indent=2))\nPY\"","aggregated_output":"Activity {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"class_id\": {\n      \"enum\": [\n        \"A1\",\n        \"A2\",\n        \"A3\",\n        \"A4\",\n        \"A5\",\n        \"A6\",\n        \"A7\"\n      ],\n      \"title\": \"Class Id\",\n      \"type\": \"string\"\n    },\n    \"applicability\": {\n      \"enum\": [\n        \"applicable\",\n        \"externalized\",\n        \"not_applicable\",\n        \"unknown\"\n      ],\n      \"title\": \"Applicability\",\n      \"type\": \"string\"\n    },\n    \"purpose\": {\n      \"title\": \"Purpose\",\n      \"type\": \"string\"\n    },\n    \"realization_summary\": {\n      \"title\": \"Realization Summary\",\n      \"type\": \"string\"\n    },\n    \"entry_points\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Entry Points\",\n      \"type\": \"array\"\n    },\n    \"behavior_ids\": {\n      \"description\": \"Derived from Behavior.primary_activity\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Behavior Ids\",\n      \"type\": \"array\",\n      \"x-controller-derived\": true\n    },\n    \"variants\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Variants\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unknowns\",\n      \"type\": \"array\"\n    },\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"class_id\",\n    \"applicability\",\n    \"purpose\",\n    \"realization_summary\"\n  ],\n  \"title\": \"Activity\",\n  \"type\": \"object\"\n}\nCoreOverview {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"formation\": {\n      \"$ref\": \"#/$defs/CorePath\"\n    },\n    \"context\": {\n      \"$ref\": \"#/$defs/CorePath\"\n    },\n    \"connection\": {\n      \"$ref\": \"#/$defs/CorePath\"\n    },\n    \"open_details\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Open Details\",\n      \"type\": \"array\"\n    },\n    \"core_gaps\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Core Gaps\",\n      \"type\": \"array\"\n    },\n    \"status\": {\n      \"default\": \"incomplete\",\n      \"enum\": [\n        \"incomplete\",\n        \"usable\",\n        \"blocked\"\n      ],\n      \"title\": \"Status\",\n      \"type\": \"string\"\n    },\n    \"rationale\": {\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"rationale\"\n  ],\n  \"title\": \"CoreOverview\",\n  \"type\": \"object\"\n}\nFact {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"meaning\": {\n      \"title\": \"Meaning\",\n      \"type\": \"string\"\n    },\n    \"identity\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Identity\",\n      \"type\": \"object\"\n    },\n    \"established_by\": {\n      \"description\": \"Derived from Behavior.produces_fact_ids; never infer an unread producer\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Established By\",\n      \"type\": \"array\",\n      \"x-controller-derived\": true\n    },\n    \"consumed_by\": {\n      \"description\": \"Derived from Behavior.consumes_fact_ids\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Consumed By\",\n      \"type\": \"array\",\n      \"x-controller-derived\": true\n    },\n    \"validity_context\": {\n      \"title\": \"Validity Context\",\n      \"type\": \"string\"\n    },\n    \"representation\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Representation\",\n      \"type\": \"array\"\n    },\n    \"invalidators\": {\n      \"description\": \"Existing Behavior IDs only. Unread events or suspected invalidators belong in unknowns.\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Invalidators\",\n      \"type\": \"array\"\n    },\n    \"reinterpreters\": {\n      \"description\": \"Existing Behavior IDs only, not event descriptions or Activity IDs.\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Reinterpreters\",\n      \"type\": \"array\"\n    },\n    \"durability\": {\n      \"title\": \"Durability\",\n      \"type\": \"string\"\n    },\n    \"recovery\": {\n      \"title\": \"Recovery\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"description\": \"Unknown establishment, consumption or validity in this implementation; known weak guarantees belong to meaning/context/durability\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unknowns\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"meaning\",\n    \"identity\",\n    \"validity_context\",\n    \"representation\",\n    \"durability\",\n    \"recovery\",\n    \"source_ids\"\n  ],\n  \"title\": \"Fact\",\n  \"type\": \"object\"\n}\nSurface {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"entry_point\": {\n      \"title\": \"Entry Point\",\n      \"type\": \"string\"\n    },\n    \"disposition\": {\n      \"enum\": [\n        \"mapped\",\n        \"externalized\",\n        \"infrastructure\",\n        \"deferred\",\n        \"UNCLASSIFIED_PROTOCOL_RESPONSIBILITY\"\n      ],\n      \"title\": \"Disposition\",\n      \"type\": \"string\"\n    },\n    \"behavior_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Behavior Ids\",\n      \"type\": \"array\"\n    },\n    \"reason\": {\n      \"title\": \"Reason\",\n      \"type\": \"string\"\n    },\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"high_consequence\": {\n      \"default\": false,\n      \"title\": \"High Consequence\",\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"entry_point\",\n    \"disposition\",\n    \"reason\"\n  ],\n  \"title\": \"Surface\",\n  \"type\": \"object\"\n}\nBehavior {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"primary_activity\": {\n      \"enum\": [\n        \"A1\",\n        \"A2\",\n        \"A3\",\n        \"A4\",\n        \"A5\",\n        \"A6\",\n        \"A7\"\n      ],\n      \"title\": \"Primary Activity\",\n      \"type\": \"string\"\n    },\n    \"execution_owner\": {\n      \"title\": \"Execution Owner\",\n      \"type\": \"string\"\n    },\n    \"protocol_context\": {\n      \"title\": \"Protocol Context\",\n      \"type\": \"string\"\n    },\n    \"trigger\": {\n      \"title\": \"Trigger\",\n      \"type\": \"string\"\n    },\n    \"legal_preconditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Legal Preconditions\",\n      \"type\": \"array\"\n    },\n    \"implementation_guards\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Implementation Guards\",\n      \"type\": \"array\"\n    },\n    \"reads\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Reads\",\n      \"type\": \"array\"\n    },\n    \"writes\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Writes\",\n      \"type\": \"array\"\n    },\n    \"durable_effects\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Durable Effects\",\n      \"type\": \"array\"\n    },\n    \"external_effects\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"External Effects\",\n      \"type\": \"array\"\n    },\n    \"important_branches\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Important Branches\",\n      \"type\": \"array\"\n    },\n    \"async_boundaries\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Async Boundaries\",\n      \"type\": \"array\"\n    },\n    \"produces_fact_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Produces Fact Ids\",\n      \"type\": \"array\"\n    },\n    \"consumes_fact_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Consumes Fact Ids\",\n      \"type\": \"array\"\n    },\n    \"cross_activity_effects\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee\",\n      \"propertyNames\": {\n        \"enum\": [\n          \"A1\",\n          \"A2\",\n          \"A3\",\n          \"A4\",\n          \"A5\",\n          \"A6\",\n          \"A7\"\n        ]\n      },\n      \"title\": \"Cross Activity Effects\",\n      \"type\": \"object\"\n    },\n    \"existing_protections\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Existing Protections\",\n      \"type\": \"array\"\n    },\n    \"source_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"description\": \"Unresolved implementation or interface relationships; check exclusions and execution progress belong to Scope/CheckRun\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unknowns\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"primary_activity\",\n    \"execution_owner\",\n    \"protocol_context\",\n    \"trigger\",\n    \"source_ids\"\n  ],\n  \"title\": \"Behavior\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
