{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../product-schemas.json'))['ConsensusAuditSpec']\nprint(json.dumps({k:v for k,v in s.items() if k\"'!='\"'\"'$defs'\"'},indent=2))\nfor k,v in s['\"'$defs'\"'].items():\n print('\\\\n',k, 'required:',v.get('required'), '\\\\n',[(a,b.get('type',b.get('\"'$ref'\"',b.get('anyOf')))) for a,b in v.get('properties',{}).items()])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
