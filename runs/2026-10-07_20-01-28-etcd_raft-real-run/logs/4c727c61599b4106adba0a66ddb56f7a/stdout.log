ng'), ('entry_points', 'array'), ('behavior_ids', 'array'), ('variants', 'array'), ('unknowns', 'array'), ('source_ids', 'array')]\n\n Behavior required: ['id', 'primary_activity', 'execution_owner', 'protocol_context', 'trigger', 'source_ids'] \n [('id', 'string'), ('primary_activity', 'string'), ('execution_owner', 'string'), ('protocol_context', 'string'), ('trigger', 'string'), ('legal_preconditions', 'array'), ('implementation_guards', 'array'), ('reads', 'array'), ('writes', 'array'), ('durable_effects', 'array'), ('external_effects', 'array'), ('important_branches', 'array'), ('async_boundaries', 'array'), ('produces_fact_ids', 'array'), ('consumes_fact_ids', 'array'), ('cross_activity_effects', 'object'), ('existing_protections', 'array'), ('source_ids', 'array'), ('unknowns', 'array')]\n\n CoreOverview required: ['rationale'] \n [('formation', '#/$defs/CorePath'), ('context', '#/$defs/CorePath'), ('connection', '#/$defs/CorePath'), ('open_details', 'array'), ('core_gaps', 'array'), ('status', 'string'), ('rationale', 'string')]\n\n CorePath required: None \n [('explanation', 'string'), ('behavior_ids', 'array'), ('fact_ids', 'array'), ('source_ids', 'array')]\n\n Fact required: ['id', 'meaning', 'identity', 'validity_context', 'representation', 'durability', 'recovery', 'source_ids'] \n [('id', 'string'), ('meaning', 'string'), ('identity', 'object'), ('established_by', 'array'), ('consumed_by', 'array'), ('validity_context', 'string'), ('representation', 'array'), ('invalidators', 'array'), ('reinterpreters', 'array'), ('durability', 'string'), ('recovery', 'string'), ('source_ids', 'array'), ('unknowns', 'array')]\n\n Surface required: ['entry_point', 'disposition', 'reason'] \n [('entry_point', 'string'), ('disposition', 'string'), ('behavior_ids', 'array'), ('reason', 'string'), ('source_ids', 'array'), ('high_consequence', 'boolean')]\n\n TargetProfile required: ['system_boundary'] \n [('system_boundary', 'string'), ('protocol_contexts', 'array'), ('external_interfaces', 'array'), ('ownership', 'array'), ('selection_injection', 'array'), ('variants', 'array'), ('source_ids', 'array'), ('unknowns', 'array')]\n","exit_code":0,"status":"completed"}}
