Update our replication state\n   250\t\t\tupdateLastAppended(s, &req)\n   251\t\n   252\t\t\t// Clear any failures, allow pipelining\n   253\t\t\ts.failures = 0\n   254\t\t\ts.allowPipeline = true\n   255\t\t} else {\n   256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n   257\t\t\tif resp.NoRetryBackoff {\n   258\t\t\t\ts.failures = 0\n   259\t\t\t} else {\n   260\t\t\t\ts.failures++\n   261\t\t\t}\n   262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n   263\t\t}\n   264\t\n   265\tCHECK_MORE:\n   266\t\t// Poll the stop channel here in case we are looping and have been asked\n   267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n   268\t\t// where we are asked to replicate to a given index and then shutdown,\n   269\t\t// it's better to not loop in here to send lots of entries to a straggler\n   270\t\t// that's leaving the cluster anyways.\n   271\t\tselect {\n   272\t\tcase <-s.stopCh:\n   273\t\t\treturn true\n   274\t\tdefault:\n   275\t\t}\n   276\t\n   277\t\t// Check if there are more logs to replicate\n   278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n   279\t\t\tgoto START\n   280\t\t}\n   281\t\treturn\n   282\t\n   283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n   284\t\t// is too far behind, and we must ship a snapshot down instead\n   285\tSEND_SNAP:\n   286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n   287\t\t\treturn true\n   288\t\t} else if err != nil {\n   289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n   290\t\t\treturn\n   320\t\tdefer snapshot.Close()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   480\t\t\t\tif maxIndex > 0 {\n   481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n   482\t\t\t\t}\n   483\t\t\t\tbreak SEND\n   484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   487\t\t\t\tif !shouldStop {\n   488\t\t\t\t\tdeferErr.respond(nil)\n   489\t\t\t\t} else {\n   490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   491\t\t\t\t}\n   492\t\t\tcase <-s.triggerCh:\n   493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   498\t\t\t}\n   499\t\t}\n   500\t\n   501\t\t// Stop our decoder, and wait for it to finish\n   502\t\tclose(stopCh)\n   503\t\tselect {\n   504\t\tcase <-finishCh:\n   505\t\tcase <-r.shutdownCh:\n   506\t\t}\n   507\t\treturn nil\n   508\t}\n   509\t\n   510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n   511\t// pipelineReplicate.\n   512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n   513\t\t// Create a new append request\n   514\t\treq := new(AppendEntriesRequest)\n   515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n   516\t\t\treturn true\n   517\t\t}\n   518\t\n   519\t\t// Pipeline the append entries\n   520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n   521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n   522\t\t\treturn true\n   523\t\t}\n   524\t\n   525\t\t// Increase the next send log to avoid re-sending old logs\n   526\t\tif n := len(req.Entries); n > 0 {\n   527\t\t\tlast := req.Entries[n-1]\n   528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n   529\t\t}\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n   450\tfunc (r *Raft) getLeadershipTransferInProgress() bool {\n   451\t\tv := atomic.LoadInt32(&r.leaderState.leadershipTransferInProgress)\n   452\t\treturn v == 1\n   453\t}\n   454\t\n   455\tfunc (r *Raft) setupLeaderState() {\n   456\t\tr.leaderState.commitCh = make(chan struct{}, 1)\n   457\t\tr.leaderState.commitment = newCommitment(r.leaderState.commitCh,\n   458\t\t\tr.configurations.latest,\n   459\t\t\tr.getLastIndex()+1 /* first index that may be committed in this term */)\n   460\t\tr.leaderState.inflight = list.New()\n   461\t\tr.leaderState.replState = make(map[ServerID]*followerReplication)\n   462\t\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n   463\t\tr.leaderState.stepDown = make(chan struct{}, 1)\n   464\t}\n   465\t\n   466\t// runLeader runs the main loop while in leader state. Do the setup here and drop into\n   467\t// the leaderLoop for the hot loop.\n   468\tfunc (r *Raft) runLeader() {\n   469\t\tr.logger.Info(\"entering leader state\", \"leader\", r)\n   470\t\tmetrics.IncrCounter([]string{\"raft\", \"state\", \"leader\"}, 1)\n   471\t\n   472\t\t// Notify that we are the leader\n   473\t\toverrideNotifyBool(r.leaderCh, true)\n   474\t\n   475\t\t// Store the notify chan. It's not reloadable so shouldn't change before the\n   476\t\t// defer below runs, but this makes sure we always notify the same chan if\n   477\t\t// ever for both gaining and losing leadership.\n   478\t\tnotify := r.config().NotifyCh\n   479\t\n   480\t\t// Push to the notify channel if given\n   481\t\tif notify != nil {\n   482\t\t\tselect {\n   483\t\t\tcase notify <- true:\n   484\t\t\tcase <-r.shutdownCh:\n   485\t\t\t\t// make sure push to the notify channel ( if given )\n   486\t\t\t\tselect {\n   487\t\t\t\tcase notify <- true:\n   488\t\t\t\tdefault:\n   489\t\t\t\t}\n   490\t\t\t}\n   780\t\t\t\t\tcontinue\n   781\t\t\t\t}\n   782\t\t\t\tr.setLeadershipTransferInProgress(true)\n   783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n   784\t\n   785\t\t\tcase <-r.leaderState.commitCh:\n   786\t\t\t\tr.mainThreadSaturation.working()\n   787\t\t\t\t// Process the newly committed entries\n   788\t\t\t\toldCommitIndex := r.getCommitIndex()\n   789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n   790\t\t\t\tr.setCommitIndex(commitIndex)\n   791\t\n   792\t\t\t\t// New configuration has been committed, set it as the committed\n   793\t\t\t\t// value.\n   794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n   795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n   796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n   797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n   798\t\t\t\t\t\tstepDown = true\n   799\t\t\t\t\t}\n   800\t\t\t\t}\n   801\t\n   802\t\t\t\tstart := time.Now()\n   803\t\t\t\tvar groupReady []*list.Element\n   804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n   805\t\t\t\tvar lastIdxInGroup uint64\n   806\t\n   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   811\t\t\t\t\tif idx > commitIndex {\n   812\t\t\t\t\t\t// Don't go past the committed index\n   813\t\t\t\t\t\tbreak\n   814\t\t\t\t\t}\n   815\t\n   816\t\t\t\t\t// Measure the commit time\n   817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n   818\t\t\t\t\tgroupReady = append(groupReady, e)\n   819\t\t\t\t\tgroupFutures[idx] = commitLog\n   820\t\t\t\t\tlastIdxInGroup = idx\n   821\t\t\t\t}\n   822\t\n   823\t\t\t\t// Process the group\n   824\t\t\t\tif len(groupReady) != 0 {\n   825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n   826\t\n   827\t\t\t\t\tfor _, e := range groupReady {\n   828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n   829\t\t\t\t\t}\n   830\t\t\t\t}\n   831\t\n   832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n   833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n   834\t\n   835\t\t\t\t// Count the number of logs enqueued\n  1210\t\tr.logger.Info(\"updating configuration\",\n  1211\t\t\t\"command\", future.req.command,\n  1212\t\t\t\"server-id\", future.req.serverID,\n  1213\t\t\t\"server-addr\", future.req.serverAddress,\n  1214\t\t\t\"servers\", hclog.Fmt(\"%+v\", configuration.Servers))\n  1215\t\n  1216\t\t// In pre-ID compatibility mode we translate all configuration changes\n  1217\t\t// in to an old remove peer message, which can handle all supported\n  1218\t\t// cases for peer changes in the pre-ID world (adding and removing\n  1219\t\t// voters). Both add peer and remove peer log entries are handled\n  1220\t\t// similarly on old Raft servers, but remove peer does extra checks to\n  1221\t\t// see if a leader needs to step down. Since they both assert the full\n  1222\t\t// configuration, then we can safely call remove peer for everything.\n  1223\t\tif r.protocolVersion < 2 {\n  1224\t\t\tfuture.log = Log{\n  1225\t\t\t\tType: LogRemovePeerDeprecated,\n  1226\t\t\t\tData: encodePeers(configuration, r.trans),\n  1227\t\t\t}\n  1228\t\t} else {\n  1229\t\t\tfuture.log = Log{\n  1230\t\t\t\tType: LogConfiguration,\n  1231\t\t\t\tData: EncodeConfiguration(configuration),\n  1232\t\t\t}\n  1233\t\t}\n  1234\t\n  1235\t\tr.dispatchLogs([]*logFuture{&future.logFuture})\n  1236\t\tindex := future.Index()\n  1237\t\tr.setLatestConfiguration(configuration, index)\n  1238\t\tr.leaderState.commitment.setConfiguration(configuration)\n  1239\t\tr.startStopReplication()\n  1240\t}\n  1241\t\n  1242\t// dispatchLog is called on the leader to push a log to disk, mark it\n  1243\t// as inflight and begin replication of it.\n  1244\tfunc (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n  1245\t\tnow := time.Now()\n  1246\t\tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n  1247\t\n  1248\t\tterm := r.getCurrentTerm()\n  1249\t\tlastIndex := r.getLastIndex()\n  1250\t\n  1251\t\tn := len(applyLogs)\n  1252\t\tlogs := make([]*Log, n)\n  1253\t\tmetrics.SetGauge([]string{\"raft\", \"leader\", \"dispatchNumLogs\"}, float32(n))\n  1254\t\n  1255\t\tfor idx, applyLog := range applyLogs {\n  1256\t\t\tapplyLog.dispatch = now\n  1257\t\t\tlastIndex++\n  1258\t\t\tapplyLog.log.Index = lastIndex\n  1259\t\t\tapplyLog.log.Term = term\n  1260\t\t\tapplyLog.log.AppendedAt = now\n  1261\t\t\tlogs[idx] = &applyLog.log\n  1262\t\t\tr.leaderState.inflight.PushBack(applyLog)\n  1263\t\t}\n  1264\t\n  1265\t\t// Write the log entry locally\n  1266\t\tif err := r.logs.StoreLogs(logs); err != nil {\n  1267\t\t\tr.logger.Error(\"failed to commit logs\", \"error\", err)\n  1268\t\t\tfor _, applyLog := range applyLogs {\n  1269\t\t\t\tapplyLog.respond(err)\n  1270\t\t\t}\n  1271\t\t\tr.setState(Follower)\n  1272\t\t\treturn\n  1273\t\t}\n  1274\t\tr.leaderState.commitment.match(r.localID, lastIndex)\n  1275\t\n  1276\t\t// Update the last log since it's on disk now\n  1277\t\tr.setLastLog(lastIndex, term)\n  1278\t\n  1279\t\t// Notify the replicators of the new log\n  1280\t\tfor _, f := range r.leaderState.replState {\n../native-support/assurance_support_test.go\n../native-draft/tmp/codex-bwrap-synthetic-mount-targets-1000/c7cd748cd5b604d4/113350\n../native-draft/tmp/codex-bwrap-synthetic-mount-targets-1000/lock\n../native-draft/tmp/codex-bwrap-synthetic-mount-targets-1000/6254a9e2918d645a/113350\n../native-draft/tmp/codex-bwrap-synthetic-mount-targets-1000/36373a9871ad9f1d/113350\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"Commit-index advancement uses a voter-only quorum and requires replication through the first index of the leader’s term. I’m tracing how replication acknowledgments establish those match indexes; the quorum calculation alone does not establish that its inputs are valid.\n"}}
