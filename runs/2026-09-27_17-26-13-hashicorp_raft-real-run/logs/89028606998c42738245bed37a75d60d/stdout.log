{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=json.load(open('../product-schemas.json')); print(list(s)); print(json.dumps(s,indent=2)[:26000])\nPY\"","aggregated_output":"['DirectCheckPlan', 'ConsensusAuditSpec', 'GraphPatch', 'ScopeUpdate', 'Feedback']\n{\n  \"DirectCheckPlan\": {\n    \"$defs\": {\n      \"Comparison\": {\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"field\": {\n            \"title\": \"Field\",\n            \"type\": \"string\"\n          },\n          \"op\": {\n            \"default\": \"eq\",\n            \"enum\": [\n              \"eq\",\n              \"ne\"\n            ],\n            \"title\": \"Op\",\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"boolean\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"default\": null,\n            \"title\": \"Value\"\n          },\n          \"reference\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"default\": null,\n            \"title\": \"Reference\"\n          }\n        },\n        \"required\": [\n          \"field\"\n        ],\n        \"title\": \"Comparison\",\n        \"type\": \"object\"\n      },\n      \"EventMonitor\": {\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"id\": {\n            \"title\": \"Id\",\n            \"type\": \"string\"\n          },\n          \"checker_id\": {\n            \"title\": \"Checker Id\",\n            \"type\": \"string\"\n          },\n          \"event\": {\n            \"title\": \"Event\",\n            \"type\": \"string\"\n          },\n          \"binding_ids\": {\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"title\": \"Binding Ids\",\n            \"type\": \"array\"\n          },\n          \"grounding\": {\n            \"$ref\": \"#/$defs/Grounding\"\n          },\n          \"applicability_conditions\": {\n            \"default\": [],\n            \"items\": {\n              \"$ref\": \"#/$defs/Comparison\"\n            },\n            \"title\": \"Applicability Conditions\",\n            \"type\": \"array\"\n          },\n          \"admission_alias\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"default\": null,\n            \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\",\n            \"title\": \"Admission Alias\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"checker_id\",\n          \"event\",\n          \"binding_ids\",\n          \"grounding\"\n        ],\n        \"title\": \"EventMonitor\",\n        \"type\": \"object\"\n      },\n      \"EventRequirement\": {\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"alias\": {\n            \"title\": \"Alias\",\n            \"type\": \"string\"\n          },\n          \"event\": {\n            \"title\": \"Event\",\n            \"type\": \"string\"\n          },\n          \"conditions\": {\n            \"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Comparison\"\n            },\n            \"title\": \"Cond