{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/configuration.go | sed -n '1,60p;194,310p'; nl -ba ../native-source/raft.go | sed -n '865,910p'; rg -n 'func .*verifyLeader|verifyFuture|hasVote.*peer|checkLeaderLease' ../native-source/raft.go ../native-source/replication.go; nl -ba ../native-source/raft.go | sed -n '960,1060p'; nl -ba ../native-source/api.go | sed -n '870,903p;938,960p'\"","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\ttype nopConfigurationStore struct{}\n    55\t\n    56\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n    57\t\n    58\t// ServerID is a unique string identifying a server for all time.\n    59\ttype ServerID string\n    60\t\n   194\t// checkConfiguration tests a cluster membership configuration for common\n   195\t// errors.\n   196\tfunc checkConfiguration(configuration Configuration) error {\n   197\t\tidSet := make(map[ServerID]bool)\n   198\t\taddressSet := make(map[ServerAddress]bool)\n   199\t\tvar voters int\n   200\t\tfor _, server := range configuration.Servers {\n   201\t\t\tif server.ID == \"\" {\n   202\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   203\t\t\t}\n   204\t\t\tif server.Address == \"\" {\n   205\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   206\t\t\t}\n   207\t\t\tif idSet[server.ID] {\n   208\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   209\t\t\t}\n   210\t\t\tidSet[server.ID] = true\n   211\t\t\tif addressSet[server.Address] {\n   212\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   213\t\t\t}\n   214\t\t\taddressSet[server.Address] = true\n   215\t\t\tif server.Suffrage == Voter {\n   216\t\t\t\tvoters++\n   217\t\t\t}\n   218\t\t}\n   219\t\tif voters == 0 {\n   220\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   221\t\t}\n   222\t\treturn nil\n   223\t}\n   224\t\n   225\t// nextConfiguration generates a new Configuration from the current one and a\n   226\t// configuration change request. It's split from appendConfigurationEntry so\n   227\t// that it can be unit tested easily.\n   228\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   229\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   230\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   231\t\t}\n   232\t\n   233\t\tconfiguration := current.Clone()\n   234\t\tswitch change.command {\n   235\t\tcase AddVoter:\n   236\t\t\tnewServer := Server{\n   237\t\t\t\tSuffrage: Voter,\n   238\t\t\t\tID:       change.serverID,\n   239\t\t\t\tAddress:  change.serverAddress,\n   240\t\t\t}\n   241\t\t\tfound := false\n   242\t\t\tfor i, server := range configuration.Servers {\n   243\t\t\t\tif server.ID == change.serverID {\n   244\t\t\t\t\tif server.Suffrage == Voter {\n   245\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   246\t\t\t\t\t} else {\n   247\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   248\t\t\t\t\t}\n   249\t\t\t\t\tfound = true\n   250\t\t\t\t\tbreak\n   251\t\t\t\t}\n   252\t\t\t}\n   253\t\t\tif !found {\n   254\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   255\t\t\t}\n   256\t\tcase AddNonvoter:\n   257\t\t\tnewServer := Server{\n   258\t\t\t\tSuffrage: Nonvoter,\n   259\t\t\t\tID:       change.serverID,\n   260\t\t\t\tAddress:  change.serverAddress,\n   261\t\t\t}\n   262\t\t\tfound := false\n   263\t\t\tfor i, server := range configuration.Servers {\n   264\t\t\t\tif server.ID == change.serverID {\n   265\t\t\t\t\tif server.Suffrage != Nonvoter {\n   266\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   267\t\t\t\t\t} else {\n   268\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   269\t\t\t\t\t}\n   270\t\t\t\t\tfound = true\n   271\t\t\t\t\tbreak\n   272\t\t\t\t}\n   273\t\t\t}\n   274\t\t\tif !found {\n   275\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   276\t\t\t}\n   277\t\tcase DemoteVoter:\n   278\t\t\tfor i, server := range configuration.Servers {\n   279\t\t\t\tif server.ID == change.serverID {\n   280\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   281\t\t\t\t\tbreak\n   282\t\t\t\t}\n   283\t\t\t}\n   284\t\tcase RemoveServer:\n   285\t\t\tfor i, server := range configuration.Servers {\n   286\t\t\t\tif server.ID == change.serverID {\n   287\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   288\t\t\t\t\tbreak\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\tcase Promote:\n   292\t\t\tfor i, server := range configuration.Servers {\n   293\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   294\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   295\t\t\t\t\tbreak\n   296\t\t\t\t}\n   297\t\t\t}\n   298\t\t}\n   299\t\n   300\t\t// Make sure we didn't do something bad like remove the last voter\n   301\t\tif err := checkConfiguration(configuration); err != nil {\n   302\t\t\treturn Configuration{}, err\n   303\t\t}\n   304\t\n   305\t\treturn configuration, nil\n   306\t}\n   307\t\n   308\t// encodePeers is used to serialize a Configuration into the old peers format.\n   309\t// This is here for backwards compatibility when operating with a mix of old\n   310\t// servers and should be removed once we deprecate support for protocol version 1.\n   865\t\t\t\t\tdelete(r.leaderState.notify, v)\n   866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   867\t\t\t\t\t\trepl.cleanNotify(v)\n   868\t\t\t\t\t}\n   869\t\t\t\t\tv.respond(nil)\n   870\t\t\t\t}\n   871\t\n   872\t\t\tcase future := <-r.userRestoreCh:\n   873\t\t\t\tr.mainThreadSaturation.working()\n   874\t\t\t\tif r.getLeadershipTransferInProgress() {\n   875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   877\t\t\t\t\tcontinue\n   878\t\t\t\t}\n   879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n   880\t\t\t\tfuture.respond(err)\n   881\t\n   882\t\t\tcase future := <-r.configurationsCh:\n   883\t\t\t\tr.mainThreadSaturation.working()\n   884\t\t\t\tif r.getLeadershipTransferInProgress() {\n   885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   887\t\t\t\t\tcontinue\n   888\t\t\t\t}\n   889\t\t\t\tfuture.configurations = r.configurations.Clone()\n   890\t\t\t\tfuture.respond(nil)\n   891\t\n   892\t\t\tcase future := <-r.configurationChangeChIfStable():\n   893\t\t\t\tr.mainThreadSaturation.working()\n   894\t\t\t\tif r.getLeadershipTransferInProgress() {\n   895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   897\t\t\t\t\tcontinue\n   898\t\t\t\t}\n   899\t\t\t\tr.appendConfigurationEntry(future)\n   900\t\n   901\t\t\tcase b := <-r.bootstrapCh:\n   902\t\t\t\tr.mainThreadSaturation.working()\n   903\t\t\t\tb.respond(ErrCantBootstrap)\n   904\t\n   905\t\t\tcase newLog := <-r.applyCh:\n   906\t\t\t\tr.mainThreadSaturation.working()\n   907\t\t\t\tif r.getLeadershipTransferInProgress() {\n   908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n   910\t\t\t\t\tcontinue\n../native-source/replication.go:71:\t// whether the leader should step down (Raft.checkLeaderLease()).\n../native-source/replication.go:85:\tnotify map[*verifyFuture]struct{}\n../native-source/replication.go:104:\ts.notify = make(map[*verifyFuture]struct{})\n../native-source/replication.go:114:func (s *followerReplication) cleanNotify(v *verifyFuture) {\n../native-source/raft.go:95:\tnotify                       map[*verifyFuture]struct{}\n../native-source/raft.go:462:\tr.leaderState.notify = make(map[*verifyFuture]struct{})\n../native-source/raft.go:606:\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n../native-source/raft.go:937:\t\t\tmaxDiff := r.checkLeaderLease()\n../native-source/raft.go:965:func (r *Raft) verifyLeader(v *verifyFuture) {\n../native-source/raft.go:1032:// checkLeaderLease is used to check if we can contact a quorum of nodes\n../native-source/raft.go:1036:func (r *Raft) checkLeaderLease() time.Duration {\n   960\t\t}\n   961\t}\n   962\t\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n   988\t\n   989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   991\t\t// make sure we are not already stopped\n   992\t\tselect {\n   993\t\tcase <-stopCh:\n   994\t\t\tdoneCh <- nil\n   995\t\t\treturn\n   996\t\tdefault:\n   997\t\t}\n   998\t\n   999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n  1000\t\t\terr := &deferError{}\n  1001\t\t\terr.init()\n  1002\t\t\trepl.triggerDeferErrorCh <- err\n  1003\t\t\tselect {\n  1004\t\t\tcase err := <-err.errCh:\n  1005\t\t\t\tif err != nil {\n  1006\t\t\t\t\tdoneCh <- err\n  1007\t\t\t\t\treturn\n  1008\t\t\t\t}\n  1009\t\t\tcase <-stopCh:\n  1010\t\t\t\tdoneCh <- nil\n  1011\t\t\t\treturn\n  1012\t\t\t}\n  1013\t\t}\n  1014\t\n  1015\t\t// Step ?: the thesis describes in chap 6.4.1: Using clocks to reduce\n  1016\t\t// messaging for read-only queries. If this is implemented, the lease\n  1017\t\t// has to be reset as well, in case leadership is transferred. This\n  1018\t\t// implementation also has a lease, but it serves another purpose and\n  1019\t\t// doesn't need to be reset. The lease mechanism in our raft lib, is\n  1020\t\t// setup in a similar way to the one in the thesis, but in practice\n  1021\t\t// it's a timer that just tells the leader how often to check\n  1022\t\t// heartbeats are still coming in.\n  1023\t\n  1024\t\t// Step 3: send TimeoutNow message to target server.\n  1025\t\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\n  1026\t\tif err != nil {\n  1027\t\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\n  1028\t\t}\n  1029\t\tdoneCh <- err\n  1030\t}\n  1031\t\n  1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n  1033\t// within the last leader lease interval. If not, we need to step down,\n  1034\t// as we may have lost connectivity. Returns the maximum duration without\n  1035\t// contact. This must only be called from the main thread.\n  1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n  1037\t\t// Track contacted nodes, we can always contact ourself\n  1038\t\tcontacted := 0\n  1039\t\n  1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n  1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n  1042\t\t// changes between iterations below.\n  1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n  1044\t\n  1045\t\t// Check each follower\n  1046\t\tvar maxDiff time.Duration\n  1047\t\tnow := time.Now()\n  1048\t\tfor _, server := range r.configurations.latest.Servers {\n  1049\t\t\tif server.Suffrage == Voter {\n  1050\t\t\t\tif server.ID == r.localID {\n  1051\t\t\t\t\tcontacted++\n  1052\t\t\t\t\tcontinue\n  1053\t\t\t\t}\n  1054\t\t\t\tf := r.leaderState.replState[server.ID]\n  1055\t\t\t\tdiff := now.Sub(f.LastContact())\n  1056\t\t\t\tif diff <= leaseTimeout {\n  1057\t\t\t\t\tcontacted++\n  1058\t\t\t\t\tif diff > maxDiff {\n  1059\t\t\t\t\t\tmaxDiff = diff\n  1060\t\t\t\t\t}\n   870\t\tselect {\n   871\t\tcase <-timer:\n   872\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   873\t\tcase <-r.shutdownCh:\n   874\t\t\treturn errorFuture{ErrRaftShutdown}\n   875\t\tcase r.applyCh <- logFuture:\n   876\t\t\treturn logFuture\n   877\t\t}\n   878\t}\n   879\t\n   880\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   881\t// to prevent returning stale data from the FSM after the peer has lost\n   882\t// leadership.\n   883\tfunc (r *Raft) VerifyLeader() Future {\n   884\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   885\t\tverifyFuture := &verifyFuture{}\n   886\t\tverifyFuture.init()\n   887\t\tselect {\n   888\t\tcase <-r.shutdownCh:\n   889\t\t\treturn errorFuture{ErrRaftShutdown}\n   890\t\tcase r.verifyCh <- verifyFuture:\n   891\t\t\treturn verifyFuture\n   892\t\t}\n   893\t}\n   894\t\n   895\t// GetConfiguration returns the latest configuration. This may not yet be\n   896\t// committed. The main loop can access this directly.\n   897\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n   898\t\tconfigReq := &configurationsFuture{}\n   899\t\tconfigReq.init()\n   900\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n   901\t\tconfigReq.respond(nil)\n   902\t\treturn configReq\n   903\t}\n   938\t// AddVoter will add the given server to the cluster as a staging server. If the\n   939\t// server is already in the cluster as a voter, this updates the server's address.\n   940\t// This must be run on the leader or it will fail. The leader will promote the\n   941\t// staging server to a voter once that server is ready. If nonzero, prevIndex is\n   942\t// the index of the only configuration upon which this change may be applied; if\n   943\t// another configuration entry has been added in the meantime, this request will\n   944\t// fail. If nonzero, timeout is how long this server should wait before the\n   945\t// configuration change log entry is appended.\n   946\tfunc (r *Raft) AddVoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n   947\t\tif r.protocolVersion < 2 {\n   948\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   949\t\t}\n   950\t\n   951\t\treturn r.requestConfigChange(configurationChangeRequest{\n   952\t\t\tcommand:       AddVoter,\n   953\t\t\tserverID:      id,\n   954\t\t\tserverAddress: address,\n   955\t\t\tprevIndex:     prevIndex,\n   956\t\t}, timeout)\n   957\t}\n   958\t\n   959\t// AddNonvoter will add the given server to the cluster but won't assign it a\n   960\t// vote. The server will receive log entries, but it won't participate in\n","exit_code":0,"status":"completed"}}
