{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat ../direct-checks/49dd69ed2a0341d88e62bbd108a13636/plan.json ../direct-checks/49dd69ed2a0341d88e62bbd108a13636/assurance_generated_test.go ../logs/2f0f1d4acd0140a89420299dcb3e1288/stdout.log'","aggregated_output":"{\n  \"description\": \"Measure same-future Error-return-before-Response in the real pipeline decoder, with real built-in completion producers and an independent permitted-order control.\",\n  \"claim_id\": \"O_pipeline_response_order\",\n  \"binding_ids\": [\n    \"bind_pipeline_response\"\n  ],\n  \"harness\": {\n    \"files\": {\n      \"assurance_support_test.go\": \"package raft\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"sync\\\"\\n\\t\\\"sync/atomic\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\n// AssuranceMessage identifies one actual RPC and its delivery boundary.\\n// Payload records actual input/output; callers supply their own discriminator.\\ntype AssuranceMessage struct {\\n\\tID       uint64 `json:\\\"message_id\\\"`\\n\\tSender   string `json:\\\"sender\\\"`\\n\\tReceiver string `json:\\\"receiver\\\"`\\n\\tKind     string `json:\\\"kind\\\"`\\n\\tPhase    string `json:\\\"event\\\"`\\n\\tPayload  string `json:\\\"payload\\\"`\\n\\tError    string `json:\\\"error,omitempty\\\"`\\n}\\n\\ntype AssuranceCluster struct {\\n\\tNodes      []*Raft\\n\\tTransports []*InmemTransport\\n\\tdone       chan struct{}\\n\\tworkers    sync.WaitGroup\\n\\tsequence   uint64\\n\\temit       sync.Mutex\\n\\tgate       func(AssuranceMessage) <-chan struct{}\\n}\\n\\ntype assuranceTransport struct {\\n\\t*InmemTransport\\n\\tinbox chan RPC\\n}\\n\\nfunc (t *assuranceTransport) Consumer() <-chan RPC { return t.inbox }\\n\\nfunc (c *AssuranceCluster) record(m AssuranceMessage) {\\n\\tc.emit.Lock()\\n\\traw, err := json.Marshal(m)\\n\\tif err != nil {\\n\\t\\tc.emit.Unlock()\\n\\t\\tpanic(err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(raw))\\n\\tc.emit.Unlock()\\n}\\n\\nfunc (c *AssuranceCluster) boundary(m AssuranceMessage) bool {\\n\\tc.record(m)\\n\\tvar release <-chan struct{}\\n\\tif c.gate != nil {\\n\\t\\trelease = c.gate(m)\\n\\t}\\n\\tif release != nil {\\n\\t\\tselect {\\n\\t\\tcase <-release:\\n\\t\\tcase <-c.done:\\n\\t\\t\\treturn false\\n\\t\\t}\\n\\t}\\n\\tselect {\\n\\tcase <-c.done:\\n\\t\\treturn false\\n\\tdefault:\\n\\t\\treturn true\\n\\t}\\n}\\n\\nfunc (c *AssuranceCluster) forward(t *assuranceTransport, receiver ServerID, rpc RPC) {\\n\\tdefer c.workers.Done()\\n\\tdata, err := json.Marshal(rpc.Command)\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\tm := AssuranceMessage{ID: atomic.AddUint64(&c.sequence, 1), Receiver: string(receiver),\\n\\t\\tKind: fmt.Sprintf(\\\"%T\\\", rpc.Command), Phase: \\\"request_delivery\\\", Payload: string(data)}\\n\\tif h, ok := rpc.Command.(WithRPCHeader); ok {\\n\\t\\tm.Sender = string(h.GetRPCHeader().ID)\\n\\t}\\n\\tif !c.boundary(m) {\\n\\t\\treturn\\n\\t}\\n\\tresponse := make(chan RPCResponse, 1)\\n\\tactual := rpc\\n\\tactual.RespChan = response\\n\\tselect {\\n\\tcase t.inbox <- actual:\\n\\tcase <-c.done:\\n\\t\\treturn\\n\\t}\\n\\tm.Phase = \\\"request_handoff\\\"\\n\\tc.record(m)\\n\\tvar result RPCResponse\\n\\tselect {\\n\\tcase result = <-response:\\n\\tcase <-c.done:\\n\\t\\treturn\\n\\t}\\n\\tdata, err = json.Marshal(result.Response)\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\tm.Phase, m.Payload = \\\"reply_delivery\\\", string(data)\\n\\tif result.Error != nil {\\n\\t\\tm.Error = result.Error.Error()\\n\\t}\\n\\tif !c.boundary(m) {\\n\\t\\treturn\\n\\t}\\n\\tselect {\\n\\tcase rpc.RespChan <- result:\\n\\t\\tm.Phase = \\\"reply_handoff\\\"\\n\\t\\tc.record(m)\\n\\tcase <-c.done:\\n\\t}\\n}\\n\\n// Configurations, FSMs and timeouts are experiment inputs, never hidden answers.\\n// Bootstrap uses the public API; every election and reply comes from real workers.\\nfunc NewAssuranceCluster(t *testing.T, configs []*Config, fsm func(int) FSM,\\n\\trpcTimeout time.Duration, gate func(AssuranceMessage) <-chan struct{}) *AssuranceCluster {\\n\\treturn NewAssuranceClusterWithSuffrage(t, configs, nil, fsm, rpcTimeout, gate)\\n}\\n\\n// Explicit initial membership is passed unchanged to the public bootstrap API.\\n// A nil list retains the all-voter convenience entry point.\\nfunc NewAssuranceClusterWithSuffrage(t *testing.T, configs []*Config, suffrage []ServerSuffrage,\\n\\tfsm func(int) FSM, rpcTimeout time.Duration, gate func(AssuranceMessage) <-chan struct{}) *AssuranceCluster {\\n\\tt.Helper()\\n\\tif len(suffrage) != 0 && len(suffrage) != len(configs) {\\n\\t\\tt.Fatal(\\\"suffrage must name every configured member\\\")\\n\\t}\\n\\tc := &AssuranceCluster{done: make(chan struct{}), gate: gate}\\n\\tt.Cleanup(func() {\\n\\t\\tclose(c.done)\\n\\t\\tfutures := make([]Future, 0, len(c.Nodes))\\n\\t\\tfor _, node := range c.Nodes {\\n\\t\\t\\tfutures = append(futures, node.Shutdown())\\n\\t\\t}\\n\\t\\tfor _, transport := range c.Transports {\\n\\t\\t\\ttransport.Close()\\n\\t\\t}\\n\\t\\tfinished := make(chan struct{})\\n\\t\\tgo func() {\\n\\t\\t\\tfor _, future := range futures {\\n\\t\\t\\t\\tfuture.Error()\\n\\t\\t\\t}\\n\\t\\t\\tc.workers.Wait()\\n\\t\\t\\tclose(finished)\\n\\t\\t}()\\n\\t\\tselect {\\n\\t\\tcase <-finished:\\n\\t\\tcase <-time.After(5 * time.Second):\\n\\t\\t\\tt.Error(\\\"Raft helper cleanup timed out\\\")\\n\\t\\t}\\n\\t})\\n\\tconfiguration := Configuration{}\\n\\tfor index, conf := range configs {\\n\\t\\t_, transport := NewInmemTransportWithTimeout(ServerAddress(conf.LocalID), rpcTimeout)\\n\\t\\tc.Transports = append(c.Transports, transport)\\n\\t\\trole := Voter\\n\\t\\tif len(suffrage) != 0 {\\n\\t\\t\\trole = suffrage[index]\\n\\t\\t}\\n\\t\\tconfiguration.Servers = append(configuration.Servers, Server{ID: conf.LocalID,\\n\\t\\t\\tAddress: transport.LocalAddr(), Suffrage: role})\\n\\t}\\n\\tfor i, transport := range c.Transports {\\n\\t\\tfor j, peer := range c.Transports {\\n\\t\\t\\tif i != j {\\n\\t\\t\\t\\ttransport.Connect(peer.LocalAddr(), peer)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tfor i, transport := range c.Transports {\\n\\t\\tconf := *configs[i]\\n\\t\\tstore, snapshots := NewInmemStore(), NewInmemSnapshotStore()\\n\\t\\tproxy := &assuranceTransport{InmemTransport: transport, inbox: make(chan RPC)}\\n\\t\\tif err := BootstrapCluster(&conf, store, store, snapshots, proxy, configuration); err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t\\tc.workers.Add(1)\\n\\t\\tgo func(receiver ServerID, tr *assuranceTransport) {\\n\\t\\t\\tdefer c.workers.Done()\\n\\t\\t\\tfor {\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase rpc := <-tr.InmemTransport.Consumer():\\n\\t\\t\\t\\t\\tc.workers.Add(1)\\n\\t\\t\\t\\t\\tgo c.forward(tr, receiver, rpc)\\n\\t\\t\\t\\tcase <-c.done:\\n\\t\\t\\t\\t\\treturn\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}(conf.LocalID, proxy)\\n\\t\\tnode, err := NewRaft(&conf, fsm(i), store, store, snapshots, proxy)\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t\\tc.Nodes = append(c.Nodes, node)\\n\\t}\\n\\treturn c\\n}\\n\"\n    },\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\t\\\"sync\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\nfunc assuranceOrderEvent(v map[string]interface{}) {\\n\\traw, err := json.Marshal(v)\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(raw))\\n}\\n\\ntype assuranceOrderFuture struct {\\n\\tAppendFuture\\n\\tmu                  sync.Mutex\\n\\terrorReturned       bool\\n\\tresponseCalled      bool\\n\\terrorBeforeResponse bool\\n\\tseen                chan struct{}\\n}\\n\\nfunc (f *assuranceOrderFuture) Error() error {\\n\\terr := f.AppendFuture.Error()\\n\\tf.mu.Lock()\\n\\tf.errorReturned = true\\n\\tf.mu.Unlock()\\n\\treturn err\\n}\\nfunc (f *assuranceOrderFuture) Response() *AppendEntriesResponse {\\n\\tf.mu.Lock()\\n\\tif !f.responseCalled {\\n\\t\\tf.responseCalled = true\\n\\t\\tf.errorBeforeResponse = f.errorReturned\\n\\t\\tclose(f.seen)\\n\\t}\\n\\tf.mu.Unlock()\\n\\treturn f.AppendFuture.Response()\\n}\\n\\ntype assuranceOrderPipeline struct {\\n\\tAppendPipeline\\n\\tready chan AppendFuture\\n}\\n\\nfunc (p *assuranceOrderPipeline) Consumer() <-chan AppendFuture { return p.ready }\\n\\nfunc TestAssurancePipelineResponseOrder(t *testing.T) {\\n\\tfor _, scenario := range []string{\\\"decoder_timeout\\\", \\\"decoder_success\\\", \\\"permitted_control\\\"} {\\n\\t\\tt.Run(scenario, func(t *testing.T) {\\n\\t\\t\\t_, sender := NewInmemTransportWithTimeout(\\\"order-sender\\\", 100*time.Millisecond)\\n\\t\\t\\t_, receiver := NewInmemTransportWithTimeout(\\\"order-receiver\\\", 100*time.Millisecond)\\n\\t\\t\\tdefer sender.Close()\\n\\t\\t\\tdefer receiver.Close()\\n\\t\\t\\tsender.Connect(receiver.LocalAddr(), receiver)\\n\\t\\t\\tif scenario != \\\"decoder_timeout\\\" {\\n\\t\\t\\t\\tconf := DefaultConfig()\\n\\t\\t\\t\\tconf.LocalID = \\\"order-receiver\\\"\\n\\t\\t\\t\\tconf.LogOutput = io.Discard\\n\\t\\t\\t\\tstore := NewInmemStore()\\n\\t\\t\\t\\tnode, err := NewRaft(conf, &MockFSM{}, store, store, NewInmemSnapshotStore(), receiver)\\n\\t\\t\\t\\tif err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tdefer func() {\\n\\t\\t\\t\\t\\tif err := node.Shutdown().Error(); err != nil {\\n\\t\\t\\t\\t\\t\\tt.Error(err)\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}()\\n\\t\\t\\t}\\n\\t\\t\\tpipeline, err := sender.AppendEntriesPipeline(\\\"order-receiver\\\", receiver.LocalAddr())\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tdefer pipeline.Close()\\n\\t\\t\\treq := &AppendEntriesRequest{RPCHeader: RPCHeader{ProtocolVersion: ProtocolVersionMax, ID: []byte(\\\"order-sender\\\"), Addr: []byte(\\\"order-sender\\\")}, Term: 1}\\n\\t\\t\\tresponseStorage := new(AppendEntriesResponse)\\n\\t\\t\\toriginal, err := pipeline.AppendEntries(req, responseStorage)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t\\tvar ready AppendFuture\\n\\t\\t\\tselect {\\n\\t\\t\\tcase ready = <-pipeline.Consumer():\\n\\t\\t\\tcase <-time.After(3 * time.Second):\\n\\t\\t\\t\\tt.Fatal(\\\"producer did not publish future\\\")\\n\\t\\t\\t}\\n\\t\\t\\tif ready != original || ready.Request() != req {\\n\\t\\t\\t\\tt.Fatal(\\\"future/request association changed\\\")\\n\\t\\t\\t}\\n\\t\\t\\tobserved := &assuranceOrderFuture{AppendFuture: ready, seen: make(chan struct{})}\\n\\t\\t\\tassuranceOrderEvent(map[string]interface{}{\\\"event\\\": \\\"order_admitted\\\", \\\"operation\\\": scenario, \\\"consumer\\\": scenario, \\\"producer\\\": \\\"inmemPipeline\\\", \\\"same_future\\\": ready == original})\\n\\t\\t\\tif scenario == \\\"permitted_control\\\" {\\n\\t\\t\\t\\tif err := observed.Error(); err != nil {\\n\\t\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tif !observed.Response().Success {\\n\\t\\t\\t\\t\\tt.Fatal(\\\"real follower did not accept control request\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tproxy := &assuranceOrderPipeline{AppendPipeline: pipeline, ready: make(chan AppendFuture, 1)}\\n\\t\\t\\t\\tproxy.ready <- observed\\n\\t\\t\\t\\t// Only the decoder is exercised. Empty requests cannot add log match support.\\n\\t\\t\\t\\tconsumer := &Raft{noLegacyTelemetry: true}\\n\\t\\t\\t\\tstate := &followerReplication{peer: Server{ID: \\\"order-receiver\\\", Address: receiver.LocalAddr()}, notify: make(map[*verifyFuture]struct{})}\\n\\t\\t\\t\\tstop, finish := make(chan struct{}), make(chan struct{})\\n\\t\\t\\t\\tgo consumer.pipelineDecode(state, proxy, stop, finish)\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase <-observed.seen:\\n\\t\\t\\t\\tcase <-finish:\\n\\t\\t\\t\\tcase <-time.After(3 * time.Second):\\n\\t\\t\\t\\t\\tclose(stop)\\n\\t\\t\\t\\t\\tt.Fatal(\\\"decoder did not complete or access response\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tclose(stop)\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase <-finish:\\n\\t\\t\\t\\tcase <-time.After(3 * time.Second):\\n\\t\\t\\t\\t\\tt.Fatal(\\\"decoder did not stop\\\")\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tobserved.mu.Lock()\\n\\t\\t\\tcalled, before := observed.responseCalled, observed.errorBeforeResponse\\n\\t\\t\\tobserved.mu.Unlock()\\n\\t\\t\\t// Read completion status only after the measured consumer has stopped.\\n\\t\\t\\tfinalErr := ready.Error()\\n\\t\\t\\tfinalResponse := responseStorage\\n\\t\\t\\tassuranceOrderEvent(map[string]interface{}{\\\"event\\\": \\\"order_result\\\", \\\"operation\\\": scenario, \\\"consumer\\\": scenario, \\\"response_accessed\\\": called, \\\"error_returned_before_response\\\": before, \\\"rpc_error\\\": fmt.Sprint(finalErr), \\\"response_success\\\": finalResponse.Success, \\\"completed\\\": true})\\n\\t\\t})\\n\\t}\\n}\\n\",\n    \"description\": \"TestAssurancePipelineResponseOrder runs decoder_timeout, decoder_success, and permitted_control. The first two call actual pipelineDecode; the last explicitly follows the interface ordering and is an unmonitored observation control. Every request is paired with its exact returned and consumed future. order_admitted is emitted after production but before decoder delivery. order_result is emitted after decoder completion. Auxiliary raw response fields are read from the original response storage, not treated as valid successful results when Error is nonnil.\",\n    \"semantic_changes\": [\n      \"A forwarding future wrapper records only Error return and first Response invocation; it delegates original values and does not pre-call Error.\",\n      \"A pipeline proxy delivers that same wrapped real future to an isolated real decoder; transport producer output is otherwise unchanged.\",\n      \"The decoder receiver and followerReplication are minimally initialized; no leadership prefix is claimed. Empty requests exclude match-index and application effects.\",\n      \"Timeout is generated by actual InmemTransport; tool timeouts call t.Fatal and do not emit a completed comparison.\",\n      \"The permitted control uses a separate operation and future; it never supplies history for either decoder case.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admission\",\n        \"event\": \"order_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"consumer\",\n            \"op\": \"ne\",\n            \"value\": \"permitted_control\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"same_future\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"src_inmem_constructor\",\n        \"src_inmem_pipeline\",\n        \"src_newraft_initial\",\n        \"src_rpc_dispatch\",\n        \"src_append_producer\",\n        \"src_request_fields\",\n        \"src_mock_fsm\",\n        \"src_pipeline_match\"\n      ],\n      \"expectation_ids\": [\n        \"src_pipeline_interface\"\n      ],\n      \"binding_ids\": [],\n      \"derivation\": \"Use actual in-memory transport request enqueue, completion decoder, and per-request future identity. A connected receiver without a worker yields the transport own timeout. Successful cases create an unbootstrapped empty follower through NewRaft using empty real in-memory stores, then send a protocol-version-matched empty term-1 AppendEntries request with no predecessor or commit index. The real worker produces its reply. This is a local RPC/consumer contract input, not an elected-leader history. pipelineDecode is invoked with minimal peer and notification state; empty entries cannot reach commitment.match. No target logic is replaced.\",\n      \"applicability\": \"Method ordering before response interpretation requires no quorum, elected leadership, log entry, or FSM action. The isolated consumer has no concurrent writers. Receiver workers stay live through successful reply; timeout case omits receiver processing as its declared delay fault. Consumer stop is supplied after response entry or natural decoder termination, and completion is awaited before result observation.\",\n      \"unresolved\": [\n        \"The harness does not establish the synthetic sender as a legally elected leader; this is excluded from the local claim.\",\n        \"The network transport and configuration transitions remain outside this execution.\"\n      ],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"A full cluster history would be needed for a claim about decision safety but does not determine this interface method order.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor_pipeline_order\",\n      \"checker_id\": \"check_pipeline_order\",\n      \"event\": \"order_result\",\n      \"binding_ids\": [\n        \"bind_pipeline_response\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"src_pipeline_match\",\n          \"src_inmem_pipeline\",\n          \"src_future_completion\",\n          \"src_pipeline_send\"\n        ],\n        \"expectation_ids\": [\n          \"src_pipeline_interface\"\n        ],\n        \"binding_ids\": [\n          \"bind_pipeline_response\"\n        ],\n        \"derivation\": \"Observe the actual pipelineDecode call through a forwarding AppendFuture wrapper. Error records return only after delegating to the real completed future. First Response entry records whether Error already returned. The property is response_accessed implies error_returned_before_response, never an equality between response success and RPC success.\",\n        \"applicability\": \"Two isolated decoder operations receive independently produced real in-memory futures: a timeout with an unserviced receiver, and a successful empty append processed by a real NewRaft follower. Consumer completion and stable operation identity are recorded separately from the result.\",\n        \"unresolved\": [\n          \"Network pipeline branch is not executed.\",\n          \"No leader election prefix, log commitment or application consequence is exercised.\"\n        ],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"The real transport publishes after completion, protecting write visibility; this does not perform the required Error invocation.\",\n          \"Timeout response remains zero-valued and does not advance match support.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"consumer\",\n          \"op\": \"ne\",\n          \"value\": \"permitted_control\",\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"admission\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"check_pipeline_order\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"completed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"error_returned_before_response\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"response_accessed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"operation\"\n      ],\n      \"history_field\": null,\n      \"description\": \"For each completed decoder operation, if Response was accessed on its admitted future then Error must already have returned on that same future.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"Only the in-memory producer is executed; network producer support is sourced but not execution coverage.\",\n    \"A contract mismatch does not establish use of invalid successful support: the timeout response remains false and the successful reply comes from the actual follower.\",\n    \"The unbootstrapped follower and supplied term-1 request are an RPC prefix for this local interface check, not a proven election history.\"\n  ]\n}package raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc assuranceOrderEvent(v map[string]interface{}) {\n\traw, err := json.Marshal(v)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(raw))\n}\n\ntype assuranceOrderFuture struct {\n\tAppendFuture\n\tmu                  sync.Mutex\n\terrorReturned       bool\n\tresponseCalled      bool\n\terrorBeforeResponse bool\n\tseen                chan struct{}\n}\n\nfunc (f *assuranceOrderFuture) Error() error {\n\terr := f.AppendFuture.Error()\n\tf.mu.Lock()\n\tf.errorReturned = true\n\tf.mu.Unlock()\n\treturn err\n}\nfunc (f *assuranceOrderFuture) Response() *AppendEntriesResponse {\n\tf.mu.Lock()\n\tif !f.responseCalled {\n\t\tf.responseCalled = true\n\t\tf.errorBeforeResponse = f.errorReturned\n\t\tclose(f.seen)\n\t}\n\tf.mu.Unlock()\n\treturn f.AppendFuture.Response()\n}\n\ntype assuranceOrderPipeline struct {\n\tAppendPipeline\n\tready chan AppendFuture\n}\n\nfunc (p *assuranceOrderPipeline) Consumer() <-chan AppendFuture { return p.ready }\n\nfunc TestAssurancePipelineResponseOrder(t *testing.T) {\n\tfor _, scenario := range []string{\"decoder_timeout\", \"decoder_success\", \"permitted_control\"} {\n\t\tt.Run(scenario, func(t *testing.T) {\n\t\t\t_, sender := NewInmemTransportWithTimeout(\"order-sender\", 100*time.Millisecond)\n\t\t\t_, receiver := NewInmemTransportWithTimeout(\"order-receiver\", 100*time.Millisecond)\n\t\t\tdefer sender.Close()\n\t\t\tdefer receiver.Close()\n\t\t\tsender.Connect(receiver.LocalAddr(), receiver)\n\t\t\tif scenario != \"decoder_timeout\" {\n\t\t\t\tconf := DefaultConfig()\n\t\t\t\tconf.LocalID = \"order-receiver\"\n\t\t\t\tconf.LogOutput = io.Discard\n\t\t\t\tstore := NewInmemStore()\n\t\t\t\tnode, err := NewRaft(conf, &MockFSM{}, store, store, NewInmemSnapshotStore(), receiver)\n\t\t\t\tif err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tdefer func() {\n\t\t\t\t\tif err := node.Shutdown().Error(); err != nil {\n\t\t\t\t\t\tt.Error(err)\n\t\t\t\t\t}\n\t\t\t\t}()\n\t\t\t}\n\t\t\tpipeline, err := sender.AppendEntriesPipeline(\"order-receiver\", receiver.LocalAddr())\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tdefer pipeline.Close()\n\t\t\treq := &AppendEntriesRequest{RPCHeader: RPCHeader{ProtocolVersion: ProtocolVersionMax, ID: []byte(\"order-sender\"), Addr: []byte(\"order-sender\")}, Term: 1}\n\t\t\tresponseStorage := new(AppendEntriesResponse)\n\t\t\toriginal, err := pipeline.AppendEntries(req, responseStorage)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tvar ready AppendFuture\n\t\t\tselect {\n\t\t\tcase ready = <-pipeline.Consumer():\n\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\tt.Fatal(\"producer did not publish future\")\n\t\t\t}\n\t\t\tif ready != original || ready.Request() != req {\n\t\t\t\tt.Fatal(\"future/request association changed\")\n\t\t\t}\n\t\t\tobserved := &assuranceOrderFuture{AppendFuture: ready, seen: make(chan struct{})}\n\t\t\tassuranceOrderEvent(map[string]interface{}{\"event\": \"order_admitted\", \"operation\": scenario, \"consumer\": scenario, \"producer\": \"inmemPipeline\", \"same_future\": ready == original})\n\t\t\tif scenario == \"permitted_control\" {\n\t\t\t\tif err := observed.Error(); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t\tif !observed.Response().Success {\n\t\t\t\t\tt.Fatal(\"real follower did not accept control request\")\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tproxy := &assuranceOrderPipeline{AppendPipeline: pipeline, ready: make(chan AppendFuture, 1)}\n\t\t\t\tproxy.ready <- observed\n\t\t\t\t// Only the decoder is exercised. Empty requests cannot add log match support.\n\t\t\t\tconsumer := &Raft{noLegacyTelemetry: true}\n\t\t\t\tstate := &followerReplication{peer: Server{ID: \"order-receiver\", Address: receiver.LocalAddr()}, notify: make(map[*verifyFuture]struct{})}\n\t\t\t\tstop, finish := make(chan struct{}), make(chan struct{})\n\t\t\t\tgo consumer.pipelineDecode(state, proxy, stop, finish)\n\t\t\t\tselect {\n\t\t\t\tcase <-observed.seen:\n\t\t\t\tcase <-finish:\n\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\tclose(stop)\n\t\t\t\t\tt.Fatal(\"decoder did not complete or access response\")\n\t\t\t\t}\n\t\t\t\tclose(stop)\n\t\t\t\tselect {\n\t\t\t\tcase <-finish:\n\t\t\t\tcase <-time.After(3 * time.Second):\n\t\t\t\t\tt.Fatal(\"decoder did not stop\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tobserved.mu.Lock()\n\t\t\tcalled, before := observed.responseCalled, observed.errorBeforeResponse\n\t\t\tobserved.mu.Unlock()\n\t\t\t// Read completion status only after the measured consumer has stopped.\n\t\t\tfinalErr := ready.Error()\n\t\t\tfinalResponse := responseStorage\n\t\t\tassuranceOrderEvent(map[string]interface{}{\"event\": \"order_result\", \"operation\": scenario, \"consumer\": scenario, \"response_accessed\": called, \"error_returned_before_response\": before, \"rpc_error\": fmt.Sprint(finalErr), \"response_success\": finalResponse.Success, \"completed\": true})\n\t\t})\n\t}\n}\n{\"Time\":\"2026-09-27T17:37:17.645099898+08:00\",\"Action\":\"start\",\"Package\":\"github.com/hashicorp/raft\"}\n{\"Time\":\"2026-09-27T17:37:17.663227361+08:00\",\"Action\":\"run\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder\"}\n{\"Time\":\"2026-09-27T17:37:17.663305254+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder\",\"Output\":\"=== RUN   TestAssurancePipelineResponseOrder\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.663452295+08:00\",\"Action\":\"run\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\"}\n{\"Time\":\"2026-09-27T17:37:17.66346927+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\",\"Output\":\"=== RUN   TestAssurancePipelineResponseOrder/decoder_timeout\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.765546319+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\",\"Output\":\"CA_EVENT {\\\"consumer\\\":\\\"decoder_timeout\\\",\\\"event\\\":\\\"order_admitted\\\",\\\"operation\\\":\\\"decoder_timeout\\\",\\\"producer\\\":\\\"inmemPipeline\\\",\\\"same_future\\\":true}\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.766127891+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\",\"Output\":\"CA_EVENT {\\\"completed\\\":true,\\\"consumer\\\":\\\"decoder_timeout\\\",\\\"error_returned_before_response\\\":false,\\\"event\\\":\\\"order_result\\\",\\\"operation\\\":\\\"decoder_timeout\\\",\\\"response_accessed\\\":true,\\\"response_success\\\":false,\\\"rpc_error\\\":\\\"command timed out\\\"}\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.767127221+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\",\"Output\":\"--- PASS: TestAssurancePipelineResponseOrder/decoder_timeout (0.10s)\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.767166713+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_timeout\",\"Elapsed\":0.1}\n{\"Time\":\"2026-09-27T17:37:17.767520451+08:00\",\"Action\":\"run\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_success\"}\n{\"Time\":\"2026-09-27T17:37:17.767602865+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssurancePipelineResponseOrder/decoder_success\",\"Output\":\"=== RUN   TestAssurancePipelineResponseOrder/decoder_success\\n\"}\n{\"Time\":\"2026-09-27T17:37:17.771073032+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\"