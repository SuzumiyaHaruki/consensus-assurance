ription\",\n    \"source_ids\",\n    \"scope\",\n    \"pending\"\n  ],\n  \"title\": \"ClaimDraft\",\n  \"type\": \"object\"\n}\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"sync\"\n    10\t\t\"sync/atomic\"\n    11\t\t\"time\"\n    12\t\n    13\t\t\"github.com/hashicorp/go-metrics/compat\"\n    14\t)\n    15\t\n    16\tconst (\n    17\t\tmaxFailureScale = 12\n    18\t\tfailureWait     = 10 * time.Millisecond\n    19\t)\n    20\t\n    21\tvar (\n    22\t\t// ErrLogNotFound indicates a given log entry is not available.\n    23\t\tErrLogNotFound = errors.New(\"log not found\")\n    24\t\n    25\t\t// ErrPipelineReplicationNotSupported can be returned by the transport to\n    26\t\t// signal that pipeline replication is not supported in general, and that\n    27\t\t// no error message should be produced.\n    28\t\tErrPipelineReplicationNotSupported = errors.New(\"pipeline replication not supported\")\n    29\t)\n    30\t\n    31\t// followerReplication is in charge of sending snapshots and log entries from\n    32\t// this leader during this particular term to a remote follower.\n    33\ttype followerReplication struct {\n    34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n    35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n    36\t\t// platforms.\n    37\t\n    38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n    39\t\t// requests.\n    40\t\tcurrentTerm uint64\n    41\t\n    42\t\t// nextIndex is the index of the next log entry to send to the follower,\n    43\t\t// which may fall past the end of the log.\n    44\t\tnextIndex uint64\n    45\t\n    46\t\t// peer contains the network address and ID of the remote follower.\n    47\t\tpeer Server\n    48\t\t// peerLock protects 'peer'\n    49\t\tpeerLock sync.RWMutex\n    50\t\n    51\t\t// commitment tracks the entries acknowledged by followers so that the\n    52\t\t// leader's commit index can advance. It is updated on successful\n    53\t\t// AppendEntries responses.\n    54\t\tcommitment *commitment\n    55\t\n    56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n    57\t\t// removed from the cluster. In the follower removed case, it carries a log\n    58\t\t// index; replication should be attempted with a best effort up through that\n    59\t\t// index, before exiting.\n    60\t\tstopCh chan uint64\n    61\t\n    62\t\t// triggerCh is notified every time new entries are appended to the log.\n    63\t\ttriggerCh chan struct{}\n    64\t\n    65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n    66\t\t// deferErr, the sender can be notified when the replication is done.\n    67\t\ttriggerDeferErrorCh chan *deferError\n    68\t\n    69\t\t// lastContact is updated to the current time whenever any response is\n    70\t\t// received from the follower (successful or not). This is used to check\n    71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n    72\t\tlastContact time.Time\n    73\t\t// lastContactLock protects 'lastContact'.\n    74\t\tlastContactLock sync.RWMutex\n    75\t\n    76\t\t// failures counts the number of failed RPCs since the last success, which is\n    77\t\t// used to apply backoff.\n    78\t\tfailures uint64\n    79\t\n    80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n    81\t\t// this server is still leader.\n    82\t\tnotifyCh chan struct{}\n    83\t\t// notify is a map of futures to be resolved upon receipt of an\n    84\t\t// acknowledgement, then cleared from this map.\n    85\t\tnotify map[*verifyFuture]struct{}\n    86\t\t// notifyLock protects 'notify'.\n    87\t\tnotifyLock sync.Mutex\n    88\t\n    89\t\t// stepDown is used to indicate to the leader that we\n    90\t\t// should step down based on information from a follower.\n    91\t\tstepDown chan struct{}\n    92\t\n    93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n    94\t\t// It is private to this replication goroutine.\n    95\t\tallowPipeline bool\n    96\t}\n    97\t\n    98\t// notifyAll is used to notify all the waiting verify futures\n    99\t// if the follower believes we are still the leader.\n   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   101\t\t// Clear the waiting notifies minimizing lock time\n   102\t\ts.notifyLock.Lock()\n   103\t\tn := s.notify\n   104\t\ts.notify = make(map[*verifyFuture]struct{})\n   105\t\ts.notifyLock.Unlock()\n   106\t\n   107\t\t// Submit our votes\n   108\t\tfor v := range n {\n   109\t\t\tv.vote(leader)\n   110\t\t}\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n   443\t// and want to switch to a higher performance pipeline mode of replication.\n   444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n   445\t// back to the standard replication which can handle more complex situations.\n   446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n   447\t\ts.peerLock.RLock()\n   448\t\tpeer := s.peer\n   449\t\ts.peerLock.RUnlock()\n   450\t\n   451\t\t// Create a new pipeline\n   452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n   453\t\tif err != nil {\n   454\t\t\treturn err\n   455\t\t}\n   456\t\tdefer pipeline.Close()\n   457\t\n   458\t\t// Log start and stop of pipeline\n   459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n   460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n   461\t\n   462\t\t// Create a shutdown and finish channel\n   463\t\tstopCh := make(chan struct{})\n   464\t\tfinishCh := make(chan struct{})\n   465\t\n   466\t\t// Start a dedicated decoder\n   467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n   468\t\n   469\t\t// Start pipeline sends at the last good nextIndex\n   470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n   471\t\n   472\t\tshouldStop := false\n   473\tSEND:\n   474\t\tfor !shouldStop {\n   475\t\t\tselect {\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"sync\"\n    10\t\t\"time\"\n    11\t)\n    12\t\n    13\t// Future is used to represent an action that may occur in the future.\n    14\ttype Future interface {\n    15\t\t// Error blocks until the future arrives and then returns the error status\n    16\t\t// of the future. This may be called any number of times - all calls will\n    17\t\t// return the same value, however is not OK to call this method twice\n    18\t\t// concurrently on the same Future instance.\n    19\t\t// Error will only return generic errors related to raft, such\n    20\t\t// as ErrLeadershipLost, or ErrRaftShutdown. Some operations, such as\n    21\t\t// ApplyLog, may also return errors from other methods.\n    22\t\tError() error\n    23\t}\n    24\t\n    25\t// IndexFuture is used for future actions that can result in a raft log entry\n   260\t}\n   261\t\n   262\t// Configuration returns the latest configuration in use by Raft.\n   263\tfunc (c *configurationsFuture) Configuration() Configuration {\n   264\t\treturn c.configurations.latest\n   265\t}\n   266\t\n   267\t// Index returns the index of the latest configuration in use by Raft.\n   268\tfunc (c *configurationsFuture) Index() uint64 {\n   269\t\treturn c.configurations.latestIndex\n   270\t}\n   271\t\n   272\t// vote is used to respond to a verifyFuture.\n   273\t// This may block when responding on the notifyCh.\n   274\tfunc (v *verifyFuture) vote(leader bool) {\n   275\t\tv.voteLock.Lock()\n   276\t\tdefer v.voteLock.Unlock()\n   277\t\n   278\t\t// Guard against having notified already\n   279\t\tif v.notifyCh == nil {\n   280\t\t\treturn\n   281\t\t}\n   282\t\n   283\t\tif leader {\n   284\t\t\tv.votes++\n   285\t\t\tif v.votes >= v.quorumSize {\n   286\t\t\t\tv.notifyCh <- v\n   287\t\t\t\tv.notifyCh = nil\n   288\t\t\t}\n   289\t\t} else {\n   290\t\t\tv.notifyCh <- v\npackage raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\n// AssuranceMessage identifies one actual RPC and its delivery boundary.\n// Payload records actual input/output; callers supply their own discriminator.\ntype AssuranceMessage struct {\n\tID       uint64 `json:\"message_id\"`\n\tSender   string `json:\"sender\"`\n\tReceiver string `json:\"receiver\"`\n\tKind     string `json:\"kind\"`\n\tPhase    string `json:\"event\"`\n\tPayload  string `json:\"payload\"`\n\tError    string `json:\"error,omitempty\"`\n}\n\ntype AssuranceCluster struct {\n\tNodes      []*Raft\n\tTransports []*InmemTransport\n\tdone       chan struct{}\n\tworkers    sync.WaitGroup\n\tsequence   uint64\n\temit       sync.Mutex\n\tgate       func(AssuranceMessage) <-chan struct{}\n}\n\ntype assuranceTransport struct {\n\t*InmemTransport\n\tinbox chan RPC\n}\n\nfunc (t *assuranceTransport) Consumer() <-chan RPC { return t.inbox }\n\nfunc (c *AssuranceCluster) record(m AssuranceMessage) {\n\tc.emit.Lock()\n\traw, err := json.Marshal(m)\n\tif err != nil {\n\t\tc.emit.Unlock()\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(raw))\n\tc.emit.Unlock()\n}\n\nfunc (c *AssuranceCluster) boundary(m AssuranceMessage) bool {\n\tc.record(m)\n\tvar release <-chan struct{}\n\tif c.gate != nil {\n\t\trelease = c.gate(m)\n\t}\n\tif release != nil {\n\t\tselect {\n\t\tcase <-release:\n\t\tcase <-c.done:\n\t\t\treturn false\n\t\t}\n\t}\n\tselect {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The interface requires `Error()` to return before `Response()` is read, but `pipelineDecode` reads the response directly. Both built-in transports also publish futures on error. This supports a focused interface-contract check; it does not yet establish invalid commitment, because the follower handler leaves `Success` false on its error paths.\n"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > prepare_pipeline_obligation.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v1.json'))\n# Derived indexes are omitted; the controller rebuilds them.\nfor a in m.get('activities',[]): a.pop('behavior_ids',None)\nfor f in m.get('facts',[]):\n for k in ('established_by','consumed_by'): f.pop(k,None)\nsources=[]\ndef src(i,f,a,b,kind='code_observation'):\n sources.append(dict(id=i,file=f,start_line=a,end_line=b,kind=kind))\nsrc('src_pipeline_interface','transport.go',109,141,'interface_statement')\nsrc('src_inmem_pipeline','inmem_transport.go',259,362)\nsrc('src_net_pipeline','net_transport.go',814,896)\nsrc('src_net_decode','net_transport.go',769,790)\nsrc('src_future_completion','future.go',90,131)\nsrc('src_pipeline_launch','replication.go',442,467)\nsrc('src_pipeline_send','replication.go',510,531)\nfor i,owner,ss,branches in [\n ('B_inmem_ready','In-memory pipeline decoder',['src_inmem_pipeline','src_future_completion'],['Reply channel: copy response then record RPC error before publishing future','Timeout: record timeout without copying a response, then publish future','Shutdown: return without publishing remaining futures']),\n ('B_net_ready','Network pipeline decoder',['src_net_pipeline','src_net_decode','src_future_completion'],['Decode error string and response into caller-owned response, record returned error, then publish future','Decode failure releases connection but still publishes errored future','Shutdown may prevent publication'])]:\n m['behaviors'].append(dict(id=i,primary_activity='A6',execution_owner=owner,protocol_context='One AppendFuture associated with the request pointer and response pointer supplied to AppendEntries',trigger='Decoder receives queued in-progress request',reads=['Request-associated reply channel or ordered network stream'],writes=['Future response fields and completion error'],async_boundaries=['inprogressCh to decoder','doneCh to Raft pipelineDecode'],produces_fact_ids=['F_pipeline_ready'],important_branches=branches,cross_activity_effects={'A1':'Supplies completion objects whose response fields pipelineDecode uses to decide whether to register voter replication support'},existing_protections=['Completion error is recorded before publication','A fresh response is allocated for each Raft pipeline send'],source_ids=ss+['src_pipeline_send'],unknowns=['No network fault experiment has established partially decoded Success under error','This local completion fact does not establish a legal election or application history']))\np=next(b for b in m['behaviors'] if b['id']=='B_pipeline_match')\np['consumes_fact_ids']=['F_pipeline_ready']\np['source_ids']+=['src_pipeline_interface','src_inmem_pipeline','src_net_pipeline','src_pipeline_launch','src_pipeline_send']\np['unknowns']=['The decoder reads Response without invoking Error although the interface requires Error to return first. A measured call-order check is selected; invalid commitment is not inferred.','Success with a nonnil error from a legal real follower and permitted network fault is not established; in-memory timeout leaves a fresh response zero-valued.','Election prefix, leadership loss, and application consequences remain outside the local interface proposition.']\np['existing_protections']+=['Built-in producers publish after recording completion, so receipt provides completion ordering even though it does not check error status.','Real follower append handler error paths do not assign Success true.']\nm['facts'].append(dict(id='F_pipeline_ready',meaning='The built-in pipeline decoder has recorded completion status for this request-associated future and published it to Consumer. The status may be an error; readiness alone does not establish a valid successful AppendEntries response.',identity={'future':'AppendFuture instance','request':'Request pointer captured by pipeline AppendEntries','pipeline':'Transport pipeline instance'},validity_context='Completion and publication of one in-progress future, prior to consumer inspection.',representation=['AppendFuture from doneCh','deferError completion channel','Request and Response pointers'],durability='In-memory completion notification; no independent persistence guarantee.',recovery='Pipeline lifecycle is transient; reconstruction across restart is not asserted.',source_ids=['src_inmem_pipeline','src_net_pipeline','src_net_decode','src_future_completion','src_pipeline_interface'],unknowns=['Custom transport producers have not been read; this fact describes the two built-in producers only.','A completed future can contain unusable response data on error; legal partial-decode histories remain unexplored.']))\nfor s in m['surfaces']:\n if s['entry_point']=='Raft.pipelineDecode / AppendPipeline.Consumer':\n  s.update(disposition='mapped',behavior_ids=['B_inmem_ready','B_net_ready','B_pipeline_match'],reason='Built-in completion producers and decoder are mapped. The selected local question concerns required Error-before-Response access; broader erroneous-support reachability remains unknown.',source_ids=['src_pipeline_interface','src_inmem_pipeline','src_net_pipeline','src_pipeline_match'])\njson.dump(m,open('map-pipeline.json','w'),indent=2)\nq=dict(question='Does Raft.pipelineDecode obey the AppendFuture requirement to wait for Error() to return before calling Response(), when it consumes a completed built-in pipeline future?',importance='The decoder uses response fields to update peer progress and feed A1 commitment support. The selected proposition is the explicit interface access contract; an access violation alone does not prove unsupported commitment or application divergence.',source_ids=['src_pipeline_interface','src_pipeline_match','src_inmem_pipeline','src_net_pipeline','src_append_producer'],participants=['Raft pipeline decoder','Built-in transport pipeline decoder'],objects=['AppendFuture','AppendEntriesResponse','followerReplication'],contexts=['Completed future delivered on Consumer','Both successful and failed completion status','Isolated decoder invocation with real built-in future producer'],event_paths=['Pipeline AppendEntries -> producer completion -> Consumer delivery -> pipelineDecode Response access'],activity_classes=['A1','A6'],behavior_ids=['B_inmem_ready','B_net_ready','B_pipeline_match'],fact_ids=['F_pipeline_ready'],supporting_behavior_ids={'B_commit':'Receives peer match updates and computes commitment, explaining consequence relevance without claiming it is exercised by this check.','B_append_success':'Real follower errors return without setting Success, limiting any inference of invalid support.'},obligation_relation_kind='consumption',counterevidence=['Built-in producers record completion before sending the future, so channel receipt orders completed response writes.','Fresh zero-valued responses and follower error paths can prevent an error from looking like a successful match; the selected obligation is not equivalent to a commitment-safety property.'],unknowns=['A direct call-order observation remains to be executed.','No legal same-execution prefix or endpoint establishing unsupported commitment is available.'],priority=2,trigger_rationale='The interface explicitly requires Error to return before Response, while the real decoder reads ready.Request(), ready.Response() without Error. Built-in Consumer publishes error completions, so readiness is not a general success guarantee.',disposition='ready_for_check',preferred_check='direct_test')\nclaim=dict(id='O_pipeline_response_order',kind='obligation',concern='implementation_semantics',description='For each consumed AppendFuture on which pipelineDecode calls Response(), a call to Error() on that same future must already have returned.',source_ids=['src_pipeline_interface','src_pipeline_match'],scope=dict(description='Local AppendFuture access contract in Raft.pipelineDecode for completed built-in pipeline futures. Measure call order with an observing forwarding wrapper; do not substitute a successful reply for a real failed RPC.',assumptions=['The wrapper delegates all methods and values to the actual future and records method entry/return only.','An isolated decoder context is sufficient for this method-access contract; no election or application history is inferred.'],excluded=['Whether invalid response bytes cause an unsafe commit','Global consensus safety','Crash recovery or liveness','A requirement to call Response after an error; the requirement is conditional on access']),pending=[],grounding=dict(source_ids=['src_pipeline_match','src_inmem_pipeline','src_net_pipeline'],expectation_ids=['src_pipeline_interface'],derivation='AppendFuture.Response documentation explicitly says it must only be called after Error returns. Consumer documents readiness, not exemption from that ordering requirement. The oracle observes Error return preceding Response access for the same future; it neither requires Response on failure nor equates readiness with RPC success.',applicability='pipelineDecode consumes AppendFuture through the documented AppendPipeline interface. Both built-in implementations retain the per-request object and expose it via Consumer.',alternatives=['Channel publication already orders completion writes for built-in transports; this may protect memory visibility but does not perform the specified Error call or inspect its result.'],unresolved=['Stronger consensus consequences need separate legal producer/fault/history evidence.']))\nbinding=dict(id='bind_pipeline_response',material_id='src_pipeline_match',symbol='(*Raft).pipelineDecode',start_line=533,end_line=567,description='Actual consumer of completed AppendFuture and direct Response invocation.',associations=[dict(claim_id=claim['id'],source_ids=['src_pipeline_interface','src_pipeline_match'],rationale='Interface defines access ordering and implementation supplies the consumer being checked.')],pending=[])\nchanges={'B_pipeline_match':dict(impact='dependency',source_ids=['src_pipeline_interface','src_inmem_pipeline','src_net_pipeline'],rationale='Connect the newly read actual completion producers via F_pipeline_ready. No earlier Candidate or witness exists; F_commit retains its conditional reported-support meaning.'),'Raft.pipelineDecode / AppendPipeline.Consumer':dict(impact='clarification',source_ids=['src_pipeline_interface','src_inmem_pipeline','src_net_pipeline'],rationale='Replace the deferred surface with mapped producer and consumer ownership while retaining stronger consequence gaps.')}\nsub=dict(action='obligation',map_path='map-pipeline.json',map_changes=changes,sources=sources,question=q,obligation=claim,bindings=[binding],rationale='The selected discriminator established an explicit interface expectation and actual producer semantics. Register a bounded implementation-semantics obligation for same-future access ordering. This local check is directly grounded and cheaper than proving an unsafe network history; built-in completion ordering and follower failure guards are retained as contrary evidence against stronger consequences. After this bounded check, return to pipeline error reachability or membership/snapshot support depending on results.',feedback=dict(ref_ids=['B_pipeline_match'],answered='Read both built-in Consumer producers: they publish futures after recording completion, including error completions. Receipt establishes completion ordering but not success. The AppendFuture interface separately requires Error to return before Response access.',remaining=['Execute the local same-future method-order check.','Determine whether any permitted real error history can supply invalid successful support before considering a consensus consequence.'],understanding='updated',rationale='The interface obligation can be checked independently without fabricating a successful error response or assuming a consensus failure.'))\njson.dump(sub,open('submission-pipeline-obligation.json','w'),indent=2)\nPY\npython3 prepare_pipeline_obligation.py\npython3 - <<'PY'\nimport json,jsonschema\njsonschema.validate(json.load(open('submission-pipeline-obligation.json')),json.load(open('../native-submission.schema.json')))\njsonschema.validate(json.load(open('map-pipeline.json')),json.load(open('../product-schemas.json'))['ConsensusAuditSpec'])\nprint('Schemas validated')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
