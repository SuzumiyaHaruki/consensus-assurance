{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/inmem_transport.go | sed -n '259,365p'; nl -ba ../native-source/net_transport.go | sed -n '760,900p'; nl -ba ../native-source/transport.go | sed -n '108,155p'; nl -ba ../native-source/future.go | sed -n '85,145p'; rg -n 'decodeResponse|encode.*resp|rpcErr|resp.Error' ../native-source/net_transport.go\"","aggregated_output":"   259\tfunc newInmemPipeline(trans *InmemTransport, peer *InmemTransport, addr ServerAddress) *inmemPipeline {\n   260\t\ti := &inmemPipeline{\n   261\t\t\ttrans:        trans,\n   262\t\t\tpeer:         peer,\n   263\t\t\tpeerAddr:     addr,\n   264\t\t\tdoneCh:       make(chan AppendFuture, 16),\n   265\t\t\tinprogressCh: make(chan *inmemPipelineInflight, 16),\n   266\t\t\tshutdownCh:   make(chan struct{}),\n   267\t\t}\n   268\t\tgo i.decodeResponses()\n   269\t\treturn i\n   270\t}\n   271\t\n   272\tfunc (i *inmemPipeline) decodeResponses() {\n   273\t\ttimeout := i.trans.timeout\n   274\t\tfor {\n   275\t\t\tselect {\n   276\t\t\tcase inp := <-i.inprogressCh:\n   277\t\t\t\tvar timeoutCh <-chan time.Time\n   278\t\t\t\tif timeout > 0 {\n   279\t\t\t\t\ttimeoutCh = time.After(timeout)\n   280\t\t\t\t}\n   281\t\n   282\t\t\t\tselect {\n   283\t\t\t\tcase rpcResp := <-inp.respCh:\n   284\t\t\t\t\t// Copy the result back\n   285\t\t\t\t\t*inp.future.resp = *rpcResp.Response.(*AppendEntriesResponse)\n   286\t\t\t\t\tinp.future.respond(rpcResp.Error)\n   287\t\n   288\t\t\t\t\tselect {\n   289\t\t\t\t\tcase i.doneCh <- inp.future:\n   290\t\t\t\t\tcase <-i.shutdownCh:\n   291\t\t\t\t\t\treturn\n   292\t\t\t\t\t}\n   293\t\n   294\t\t\t\tcase <-timeoutCh:\n   295\t\t\t\t\tinp.future.respond(fmt.Errorf(\"command timed out\"))\n   296\t\t\t\t\tselect {\n   297\t\t\t\t\tcase i.doneCh <- inp.future:\n   298\t\t\t\t\tcase <-i.shutdownCh:\n   299\t\t\t\t\t\treturn\n   300\t\t\t\t\t}\n   301\t\n   302\t\t\t\tcase <-i.shutdownCh:\n   303\t\t\t\t\treturn\n   304\t\t\t\t}\n   305\t\t\tcase <-i.shutdownCh:\n   306\t\t\t\treturn\n   307\t\t\t}\n   308\t\t}\n   309\t}\n   310\t\n   311\tfunc (i *inmemPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n   312\t\t// Create a new future\n   313\t\tfuture := &appendFuture{\n   314\t\t\tstart: time.Now(),\n   315\t\t\targs:  args,\n   316\t\t\tresp:  resp,\n   317\t\t}\n   318\t\tfuture.init()\n   319\t\n   320\t\t// Handle a timeout\n   321\t\tvar timeout <-chan time.Time\n   322\t\tif i.trans.timeout > 0 {\n   323\t\t\ttimeout = time.After(i.trans.timeout)\n   324\t\t}\n   325\t\n   326\t\t// Send the RPC over\n   327\t\trespCh := make(chan RPCResponse, 1)\n   328\t\trpc := RPC{\n   329\t\t\tCommand:  args,\n   330\t\t\tRespChan: respCh,\n   331\t\t}\n   332\t\n   333\t\t// Check if we have been already shutdown, otherwise the random choose\n   334\t\t// made by select statement below might pick consumerCh even if\n   335\t\t// shutdownCh was closed.\n   336\t\ti.shutdownLock.RLock()\n   337\t\tshutdown := i.shutdown\n   338\t\ti.shutdownLock.RUnlock()\n   339\t\tif shutdown {\n   340\t\t\treturn nil, ErrPipelineShutdown\n   341\t\t}\n   342\t\n   343\t\tselect {\n   344\t\tcase i.peer.consumerCh <- rpc:\n   345\t\tcase <-timeout:\n   346\t\t\treturn nil, fmt.Errorf(\"command enqueue timeout\")\n   347\t\tcase <-i.shutdownCh:\n   348\t\t\treturn nil, ErrPipelineShutdown\n   349\t\t}\n   350\t\n   351\t\t// Send to be decoded\n   352\t\tselect {\n   353\t\tcase i.inprogressCh <- &inmemPipelineInflight{future, respCh}:\n   354\t\t\treturn future, nil\n   355\t\tcase <-i.shutdownCh:\n   356\t\t\treturn nil, ErrPipelineShutdown\n   357\t\t}\n   358\t}\n   359\t\n   360\tfunc (i *inmemPipeline) Consumer() <-chan AppendFuture {\n   361\t\treturn i.doneCh\n   362\t}\n   363\t\n   364\tfunc (i *inmemPipeline) Close() error {\n   365\t\ti.shutdownLock.Lock()\n   760\t\t\tif err := enc.Encode(resp.Response); err != nil {\n   761\t\t\t\treturn err\n   762\t\t\t}\n   763\t\tcase <-n.shutdownCh:\n   764\t\t\treturn ErrTransportShutdown\n   765\t\t}\n   766\t\treturn nil\n   767\t}\n   768\t\n   769\t// decodeResponse is used to decode an RPC response and reports whether\n   770\t// the connection can be reused.\n   771\tfunc decodeResponse(conn *netConn, resp interface{}) (bool, error) {\n   772\t\t// Decode the error if any\n   773\t\tvar rpcError string\n   774\t\tif err := conn.dec.Decode(&rpcError); err != nil {\n   775\t\t\tconn.Release()\n   776\t\t\treturn false, err\n   777\t\t}\n   778\t\n   779\t\t// Decode the response\n   780\t\tif err := conn.dec.Decode(resp); err != nil {\n   781\t\t\tconn.Release()\n   782\t\t\treturn false, err\n   783\t\t}\n   784\t\n   785\t\t// Format an error if any\n   786\t\tif rpcError != \"\" {\n   787\t\t\treturn true, fmt.Errorf(rpcError)\n   788\t\t}\n   789\t\treturn true, nil\n   790\t}\n   791\t\n   792\t// sendRPC is used to encode and send the RPC.\n   793\tfunc sendRPC(conn *netConn, rpcType uint8, args interface{}) error {\n   794\t\t// Write the request type\n   795\t\tif err := conn.w.WriteByte(rpcType); err != nil {\n   796\t\t\tconn.Release()\n   797\t\t\treturn err\n   798\t\t}\n   799\t\n   800\t\t// Send the request\n   801\t\tif err := conn.enc.Encode(args); err != nil {\n   802\t\t\tconn.Release()\n   803\t\t\treturn err\n   804\t\t}\n   805\t\n   806\t\t// Flush\n   807\t\tif err := conn.w.Flush(); err != nil {\n   808\t\t\tconn.Release()\n   809\t\t\treturn err\n   810\t\t}\n   811\t\treturn nil\n   812\t}\n   813\t\n   814\t// newNetPipeline is used to construct a netPipeline from a given transport and\n   815\t// connection. It is a bug to ever call this with maxInFlight less than 2\n   816\t// (minInFlightForPipelining) and will cause a panic.\n   817\tfunc newNetPipeline(trans *NetworkTransport, conn *netConn, maxInFlight int) *netPipeline {\n   818\t\tif maxInFlight < minInFlightForPipelining {\n   819\t\t\t// Shouldn't happen (tm) since we validate this in the one call site and\n   820\t\t\t// skip pipelining if it's lower.\n   821\t\t\tpanic(\"pipelining makes no sense if maxInFlight < 2\")\n   822\t\t}\n   823\t\tn := &netPipeline{\n   824\t\t\tconn:  conn,\n   825\t\t\ttrans: trans,\n   826\t\t\t// The buffer size is 2 less than the configured max because we send before\n   827\t\t\t// waiting on the channel and the decode routine unblocks the channel as\n   828\t\t\t// soon as it's waiting on the first request. So a zero-buffered channel\n   829\t\t\t// still allows 1 request to be sent even while decode is still waiting for\n   830\t\t\t// a response from the previous one. i.e. two are inflight at the same time.\n   831\t\t\tinprogressCh: make(chan *appendFuture, maxInFlight-2),\n   832\t\t\tdoneCh:       make(chan AppendFuture, maxInFlight-2),\n   833\t\t\tshutdownCh:   make(chan struct{}),\n   834\t\t}\n   835\t\tgo n.decodeResponses()\n   836\t\treturn n\n   837\t}\n   838\t\n   839\t// decodeResponses is a long running routine that decodes the responses\n   840\t// sent on the connection.\n   841\tfunc (n *netPipeline) decodeResponses() {\n   842\t\ttimeout := n.trans.timeout\n   843\t\tfor {\n   844\t\t\tselect {\n   845\t\t\tcase future := <-n.inprogressCh:\n   846\t\t\t\tif timeout > 0 {\n   847\t\t\t\t\tn.conn.conn.SetReadDeadline(time.Now().Add(timeout))\n   848\t\t\t\t}\n   849\t\n   850\t\t\t\t_, err := decodeResponse(n.conn, future.resp)\n   851\t\t\t\tfuture.respond(err)\n   852\t\t\t\tselect {\n   853\t\t\t\tcase n.doneCh <- future:\n   854\t\t\t\tcase <-n.shutdownCh:\n   855\t\t\t\t\treturn\n   856\t\t\t\t}\n   857\t\t\tcase <-n.shutdownCh:\n   858\t\t\t\treturn\n   859\t\t\t}\n   860\t\t}\n   861\t}\n   862\t\n   863\t// AppendEntries is used to pipeline a new append entries request.\n   864\tfunc (n *netPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {\n   865\t\t// Create a new future\n   866\t\tfuture := &appendFuture{\n   867\t\t\tstart: time.Now(),\n   868\t\t\targs:  args,\n   869\t\t\tresp:  resp,\n   870\t\t}\n   871\t\tfuture.init()\n   872\t\n   873\t\t// Add a send timeout\n   874\t\tif timeout := n.trans.timeout; timeout > 0 {\n   875\t\t\tn.conn.conn.SetWriteDeadline(time.Now().Add(timeout))\n   876\t\t}\n   877\t\n   878\t\t// Send the RPC\n   879\t\tif err := sendRPC(n.conn, rpcAppendEntries, future.args); err != nil {\n   880\t\t\treturn nil, err\n   881\t\t}\n   882\t\n   883\t\t// Hand-off for decoding, this can also cause back-pressure\n   884\t\t// to prevent too many inflight requests\n   885\t\tselect {\n   886\t\tcase n.inprogressCh <- future:\n   887\t\t\treturn future, nil\n   888\t\tcase <-n.shutdownCh:\n   889\t\t\treturn nil, ErrPipelineShutdown\n   890\t\t}\n   891\t}\n   892\t\n   893\t// Consumer returns a channel that can be used to consume complete futures.\n   894\tfunc (n *netPipeline) Consumer() <-chan AppendFuture {\n   895\t\treturn n.doneCh\n   896\t}\n   897\t\n   898\t// Close is used to shut down the pipeline connection.\n   899\tfunc (n *netPipeline) Close() error {\n   900\t\tn.shutdownLock.Lock()\n   108\t\n   109\t// AppendPipeline is used for pipelining AppendEntries requests. It is used\n   110\t// to increase the replication throughput by masking latency and better\n   111\t// utilizing bandwidth.\n   112\ttype AppendPipeline interface {\n   113\t\t// AppendEntries is used to add another request to the pipeline.\n   114\t\t// The send may block which is an effective form of back-pressure.\n   115\t\tAppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error)\n   116\t\n   117\t\t// Consumer returns a channel that can be used to consume\n   118\t\t// response futures when they are ready.\n   119\t\tConsumer() <-chan AppendFuture\n   120\t\n   121\t\t// Close closes the pipeline and cancels all inflight RPCs\n   122\t\tClose() error\n   123\t}\n   124\t\n   125\t// AppendFuture is used to return information about a pipelined AppendEntries request.\n   126\ttype AppendFuture interface {\n   127\t\tFuture\n   128\t\n   129\t\t// Start returns the time that the append request was started.\n   130\t\t// It is always OK to call this method.\n   131\t\tStart() time.Time\n   132\t\n   133\t\t// Request holds the parameters of the AppendEntries call.\n   134\t\t// It is always OK to call this method.\n   135\t\tRequest() *AppendEntriesRequest\n   136\t\n   137\t\t// Response holds the results of the AppendEntries call.\n   138\t\t// This method must only be called after the Error\n   139\t\t// method returns, and will only be valid on success.\n   140\t\tResponse() *AppendEntriesResponse\n   141\t}\n    85\t\n    86\tfunc (e errorFuture) Index() uint64 {\n    87\t\treturn 0\n    88\t}\n    89\t\n    90\t// deferError can be embedded to allow a future\n    91\t// to provide an error in the future.\n    92\ttype deferError struct {\n    93\t\terr        error\n    94\t\terrCh      chan error\n    95\t\tresponded  bool\n    96\t\tShutdownCh chan struct{}\n    97\t}\n    98\t\n    99\tfunc (d *deferError) init() {\n   100\t\td.errCh = make(chan error, 1)\n   101\t}\n   102\t\n   103\tfunc (d *deferError) Error() error {\n   104\t\tif d.err != nil {\n   105\t\t\t// Note that when we've received a nil error, this\n   106\t\t\t// won't trigger, but the channel is closed after\n   107\t\t\t// send so we'll still return nil below.\n   108\t\t\treturn d.err\n   109\t\t}\n   110\t\tif d.errCh == nil {\n   111\t\t\tpanic(\"waiting for response on nil channel\")\n   112\t\t}\n   113\t\tselect {\n   114\t\tcase d.err = <-d.errCh:\n   115\t\tcase <-d.ShutdownCh:\n   116\t\t\td.err = ErrRaftShutdown\n   117\t\t}\n   118\t\treturn d.err\n   119\t}\n   120\t\n   121\tfunc (d *deferError) respond(err error) {\n   122\t\tif d.errCh == nil {\n   123\t\t\treturn\n   124\t\t}\n   125\t\tif d.responded {\n   126\t\t\treturn\n   127\t\t}\n   128\t\td.errCh <- err\n   129\t\tclose(d.errCh)\n   130\t\td.responded = true\n   131\t}\n   132\t\n   133\t// There are several types of requests that cause a configuration entry to\n   134\t// be appended to the log. These are encoded here for leaderLoop() to process.\n   135\t// This is internal to a single server.\n   136\ttype configurationChangeFuture struct {\n   137\t\tlogFuture\n   138\t\treq configurationChangeRequest\n   139\t}\n   140\t\n   141\t// bootstrapFuture is used to attempt a live bootstrap of the cluster. See the\n   142\t// Raft object's BootstrapCluster member function for more details.\n   143\ttype bootstrapFuture struct {\n   144\t\tdeferError\n   145\t\n501:\tcanReturn, err := decodeResponse(conn, resp)\n542:\t_, err = decodeResponse(conn, resp)\n752:\t\tif resp.Error != nil {\n753:\t\t\trespErr = resp.Error.Error()\n769:// decodeResponse is used to decode an RPC response and reports whether\n771:func decodeResponse(conn *netConn, resp interface{}) (bool, error) {\n773:\tvar rpcError string\n774:\tif err := conn.dec.Decode(&rpcError); err != nil {\n786:\tif rpcError != \"\" {\n787:\t\treturn true, fmt.Errorf(rpcError)\n835:\tgo n.decodeResponses()\n839:// decodeResponses is a long running routine that decodes the responses\n841:func (n *netPipeline) decodeResponses() {\n850:\t\t\t_, err := decodeResponse(n.conn, future.resp)\n","exit_code":0,"status":"completed"}}
