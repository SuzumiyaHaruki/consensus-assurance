{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../native-source/raft.go | sed -n '1390,1428p'; nl -ba ../native-source/commands.go | sed -n '1,65p'; nl -ba ../native-source/api.go | sed -n '535,610p;620,634p'; nl -ba ../native-source/testing.go | sed -n '30,105p'\"","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\t// RPCHeader is a common sub-structure used to pass along protocol version and\n     7\t// other information about the cluster. For older Raft implementations before\n     8\t// versioning was added this will default to a zero-valued structure when read\n     9\t// by newer Raft versions.\n    10\ttype RPCHeader struct {\n    11\t\t// ProtocolVersion is the version of the protocol the sender is\n    12\t\t// speaking.\n    13\t\tProtocolVersion ProtocolVersion\n    14\t\t// ID is the ServerID of the node sending the RPC Request or Response\n    15\t\tID []byte\n    16\t\t// Addr is the ServerAddr of the node sending the RPC Request or Response\n    17\t\tAddr []byte\n    18\t}\n    19\t\n    20\t// WithRPCHeader is an interface that exposes the RPC header.\n    21\ttype WithRPCHeader interface {\n    22\t\tGetRPCHeader() RPCHeader\n    23\t}\n    24\t\n    25\t// AppendEntriesRequest is the command used to append entries to the\n    26\t// replicated log.\n    27\ttype AppendEntriesRequest struct {\n    28\t\tRPCHeader\n    29\t\n    30\t\t// Provide the current term and leader\n    31\t\tTerm uint64\n    32\t\n    33\t\t// Deprecated: use RPCHeader.Addr instead\n    34\t\tLeader []byte\n    35\t\n    36\t\t// Provide the previous entries for integrity checking\n    37\t\tPrevLogEntry uint64\n    38\t\tPrevLogTerm  uint64\n    39\t\n    40\t\t// New entries to commit\n    41\t\tEntries []*Log\n    42\t\n    43\t\t// Commit index on the leader\n    44\t\tLeaderCommitIndex uint64\n    45\t}\n    46\t\n    47\t// GetRPCHeader - See WithRPCHeader.\n    48\tfunc (r *AppendEntriesRequest) GetRPCHeader() RPCHeader {\n    49\t\treturn r.RPCHeader\n    50\t}\n    51\t\n    52\t// AppendEntriesResponse is the response returned from an\n    53\t// AppendEntriesRequest.\n    54\ttype AppendEntriesResponse struct {\n    55\t\tRPCHeader\n    56\t\n    57\t\t// Newer term if leader is out of date\n    58\t\tTerm uint64\n    59\t\n    60\t\t// Last Log is a hint to help accelerate rebuilding slow nodes\n    61\t\tLastLog uint64\n    62\t\n    63\t\t// We may not succeed if we have a conflicting entry\n    64\t\tSuccess bool\n    65\t\n   535\t\t// along with the AddPeer() and RemovePeer() APIs.\n   536\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   537\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   538\t\t}\n   539\t\n   540\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   541\t\tapplyCh := make(chan *logFuture)\n   542\t\tif conf.BatchApplyCh {\n   543\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   544\t\t}\n   545\t\n   546\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   547\t\t// Create Raft struct.\n   548\t\tr := &Raft{\n   549\t\t\tprotocolVersion:       protocolVersion,\n   550\t\t\tapplyCh:               applyCh,\n   551\t\t\tfsm:                   fsm,\n   552\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   553\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   554\t\t\tleaderCh:              make(chan bool, 1),\n   555\t\t\tlocalID:               localID,\n   556\t\t\tlocalAddr:             localAddr,\n   557\t\t\tlogger:                logger,\n   558\t\t\tlogs:                  logs,\n   559\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   560\t\t\tconfigurations:        configurations{},\n   561\t\t\trpcCh:                 trans.Consumer(),\n   562\t\t\tsnapshots:             snaps,\n   563\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n   564\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n   565\t\t\tshutdownCh:            make(chan struct{}),\n   566\t\t\tstable:                stable,\n   567\t\t\ttrans:                 trans,\n   568\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n   569\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n   570\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   571\t\t\tobservers:             make(map[uint64]*Observer),\n   572\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   573\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   574\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   575\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   576\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   577\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   578\t\t}\n   579\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   580\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   581\t\t}\n   582\t\n   583\t\tr.conf.Store(*conf)\n   584\t\n   585\t\t// Initialize as a follower.\n   586\t\tr.setState(Follower)\n   587\t\n   588\t\t// Restore the current term and the last log.\n   589\t\tr.setCurrentTerm(currentTerm)\n   590\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   591\t\n   592\t\t// Attempt to restore a snapshot if there are any.\n   593\t\tif err := r.restoreSnapshot(); err != nil {\n   594\t\t\treturn nil, err\n   595\t\t}\n   596\t\n   597\t\t// Scan through the log for any configuration change entries.\n   598\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   599\t\tfor index := snapshotIndex + 1; index <= lastLog.Index; index++ {\n   600\t\t\tvar entry Log\n   601\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   603\t\t\t\tpanic(err)\n   604\t\t\t}\n   605\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   606\t\t\t\treturn nil, err\n   607\t\t\t}\n   608\t\t}\n   609\t\tr.logger.Info(\"initial configuration\",\n   610\t\t\t\"index\", r.configurations.latestIndex,\n   620\t\t}\n   621\t\t// Start the background work.\n   622\t\tr.goFunc(r.run)\n   623\t\tr.goFunc(r.runFSM)\n   624\t\tr.goFunc(r.runSnapshots)\n   625\t\treturn r, nil\n   626\t}\n   627\t\n   628\t// restoreSnapshot attempts to restore the latest snapshots, and fails if none\n   629\t// of them can be restored. This is called at initialization time, and is\n   630\t// completely unsafe to call at any other time.\n   631\tfunc (r *Raft) restoreSnapshot() error {\n   632\t\tsnapshots, err := r.snapshots.List()\n   633\t\tif err != nil {\n   634\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n    30\t\tconf.Logger = newTestLogger(t)\n    31\t\treturn conf\n    32\t}\n    33\t\n    34\t// MockFSM is an implementation of the FSM interface, and just stores\n    35\t// the logs sequentially.\n    36\t//\n    37\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    38\ttype MockFSM struct {\n    39\t\tsync.Mutex\n    40\t\tlogs           [][]byte\n    41\t\tconfigurations []Configuration\n    42\t}\n    43\t\n    44\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    45\ttype MockFSMConfigStore struct {\n    46\t\tFSM\n    47\t}\n    48\t\n    49\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    50\ttype WrappingFSM interface {\n    51\t\tUnderlying() FSM\n    52\t}\n    53\t\n    54\tfunc getMockFSM(fsm FSM) *MockFSM {\n    55\t\tswitch f := fsm.(type) {\n    56\t\tcase *MockFSM:\n    57\t\t\treturn f\n    58\t\tcase *MockFSMConfigStore:\n    59\t\t\treturn f.FSM.(*MockFSM)\n    60\t\tcase WrappingFSM:\n    61\t\t\treturn getMockFSM(f.Underlying())\n    62\t\t}\n    63\t\n    64\t\treturn nil\n    65\t}\n    66\t\n    67\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    68\ttype MockSnapshot struct {\n    69\t\tlogs     [][]byte\n    70\t\tmaxIndex int\n    71\t}\n    72\t\n    73\tvar _ ConfigurationStore = (*MockFSMConfigStore)(nil)\n    74\t\n    75\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    76\tfunc (m *MockFSM) Apply(log *Log) interface{} {\n    77\t\tm.Lock()\n    78\t\tdefer m.Unlock()\n    79\t\tm.logs = append(m.logs, log.Data)\n    80\t\treturn len(m.logs)\n    81\t}\n    82\t\n    83\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    84\tfunc (m *MockFSM) Snapshot() (FSMSnapshot, error) {\n    85\t\tm.Lock()\n    86\t\tdefer m.Unlock()\n    87\t\treturn &MockSnapshot{m.logs, len(m.logs)}, nil\n    88\t}\n    89\t\n    90\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    91\tfunc (m *MockFSM) Restore(inp io.ReadCloser) error {\n    92\t\tm.Lock()\n    93\t\tdefer m.Unlock()\n    94\t\tdefer inp.Close()\n    95\t\thd := codec.MsgpackHandle{}\n    96\t\tdec := codec.NewDecoder(inp, &hd)\n    97\t\n    98\t\tm.logs = nil\n    99\t\treturn dec.Decode(&m.logs)\n   100\t}\n   101\t\n   102\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n   103\tfunc (m *MockFSM) Logs() [][]byte {\n   104\t\tm.Lock()\n   105\t\tdefer m.Unlock()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat > pipeline_order_test.go <<'GO'\npackage raft\n\nimport (\n \\\"encoding/json\\\"\n \\\"fmt\\\"\n \\\"io\\\"\n \\\"sync\\\"\n \\\"testing\\\"\n \\\"time\\\"\n)\n\nfunc assuranceOrderEvent(v map[string]interface{}) {\n raw, err := json.Marshal(v)\n if err \"'!= nil { panic(err) }\n fmt.Println(\"CA_EVENT \" + string(raw))\n}\n\ntype assuranceOrderFuture struct {\n AppendFuture\n mu sync.Mutex\n errorReturned bool\n responseCalled bool\n errorBeforeResponse bool\n seen chan struct{}\n}\nfunc (f *assuranceOrderFuture) Error() error {\n err := f.AppendFuture.Error()\n f.mu.Lock(); f.errorReturned = true; f.mu.Unlock()\n return err\n}\nfunc (f *assuranceOrderFuture) Response() *AppendEntriesResponse {\n f.mu.Lock()\n if !f.responseCalled {\n  f.responseCalled = true\n  f.errorBeforeResponse = f.errorReturned\n  close(f.seen)\n }\n f.mu.Unlock()\n return f.AppendFuture.Response()\n}\n\ntype assuranceOrderPipeline struct {\n AppendPipeline\n ready chan AppendFuture\n}\nfunc (p *assuranceOrderPipeline) Consumer() <-chan AppendFuture { return p.ready }\n\nfunc TestAssurancePipelineResponseOrder(t *testing.T) {\n for _, scenario := range []string{\"decoder_timeout\", \"decoder_success\", \"permitted_control\"} {\n  t.Run(scenario, func(t *testing.T) {\n   _, sender := NewInmemTransportWithTimeout(\"order-sender\", 100*time.Millisecond)\n   _, receiver := NewInmemTransportWithTimeout(\"order-receiver\", 100*time.Millisecond)\n   defer sender.Close(); defer receiver.Close()\n   sender.Connect(receiver.LocalAddr(), receiver)\n   if scenario != \"decoder_timeout\" {\n    conf := DefaultConfig(); conf.LocalID = \"order-receiver\"; conf.LogOutput = io.Discard\n    store := NewInmemStore()\n    node, err := NewRaft(conf, &MockFSM{}, store, store, NewInmemSnapshotStore(), receiver)\n    if err != nil { t.Fatal(err) }\n    defer func() { if err := node.Shutdown().Error(); err != nil { t.Error(err) } }()\n   }\n   pipeline, err := sender.AppendEntriesPipeline(\"order-receiver\", receiver.LocalAddr())\n   if err != nil { t.Fatal(err) }\n   defer pipeline.Close()\n   req := &AppendEntriesRequest{RPCHeader: RPCHeader{ProtocolVersion: ProtocolVersionMax, ID: []byte(\"order-sender\"), Addr: []byte(\"order-sender\")}, Term: 1}\n   original, err := pipeline.AppendEntries(req, new(AppendEntriesResponse))\n   if err != nil { t.Fatal(err) }\n   var ready AppendFuture\n   select {\n   case ready = <-pipeline.Consumer():\n   case <-time.After(3*time.Second): t.Fatal(\"producer did not publish future\")\n   }\n   if ready != original || ready.Request() != req { t.Fatal(\"future/request association changed\") }\n   observed := &assuranceOrderFuture{AppendFuture: ready, seen: make(chan struct{})}\n   assuranceOrderEvent(map[string]interface{}{\"event\":\"order_admitted\", \"operation\":scenario, \"consumer\":scenario, \"producer\":\"inmemPipeline\", \"same_future\":ready == original})\n   if scenario == \"permitted_control\" {\n    if err := observed.Error(); err != nil { t.Fatal(err) }\n    if !observed.Response().Success { t.Fatal(\"real follower did not accept control request\") }\n   } else {\n    proxy := &assuranceOrderPipeline{AppendPipeline:pipeline, ready:make(chan AppendFuture,1)}\n    proxy.ready <- observed\n    // Only the decoder is exercised. Empty requests cannot add log match support.\n    consumer := &Raft{noLegacyTelemetry:true}\n    state := &followerReplication{peer:Server{ID:\"order-receiver\", Address:receiver.LocalAddr()}, notify:make(map[*verifyFuture]struct{})}\n    stop, finish := make(chan struct{}), make(chan struct{})\n    go consumer.pipelineDecode(state, proxy, stop, finish)\n    select {\n    case <-observed.seen:\n    case <-finish:\n    case <-time.After(3*time.Second): close(stop); t.Fatal(\"decoder did not complete or access response\")\n    }\n    close(stop)\n    select {\n    case <-finish:\n    case <-time.After(3*time.Second): t.Fatal(\"decoder did not stop\")\n    }\n   }\n   observed.mu.Lock()\n   called, before := observed.responseCalled, observed.errorBeforeResponse\n   observed.mu.Unlock()\n   // Read completion status only after the measured consumer has stopped.\n   finalErr := ready.Error()\n   finalResponse := ready.Response()\n   assuranceOrderEvent(map[string]interface{}{\"event\":\"order_result\", \"operation\":scenario, \"consumer\":scenario, \"response_accessed\":called, \"error_returned_before_response\":before, \"rpc_error\":fmt.Sprint(finalErr), \"response_success\":finalResponse.Success, \"completed\":true})\n  })\n }\n}\nGO\nmkdir -p local-source local-cache local-tmp\ncp ../native-source/*.go ../native-source/go.mod ../native-source/go.sum local-source/\ncp pipeline_order_test.go local-source/assurance_generated_test.go\nGOCACHE=\"$PWD/local-cache\" GOTMPDIR=\"$PWD/local-tmp\" GOPROXY=off go -C local-source test -run '\"'\"'^TestAssurancePipelineResponseOrder$'\"' -count=1 -v > local-order.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
