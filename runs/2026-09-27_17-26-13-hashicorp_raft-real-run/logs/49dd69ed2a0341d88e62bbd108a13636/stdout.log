{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nr=json.load(open('../research.json'));print(json.dumps({k:r[k] for k in ['units','claims','candidates','current']},indent=2))\nPY\ncat ../native-support/assurance_support_test.go\nsed -n '40,115p' ../native-source/inmem_transport.go\"","aggregated_output":"{\n  \"units\": [\n    {\n      \"id\": \"unit-O_pipeline_response_order\",\n      \"candidate_id\": \"8873456b384a4c9d929091e2a05adc5d\",\n      \"obligation_ids\": [\n        \"O_pipeline_response_order\"\n      ],\n      \"binding_ids\": [\n        \"bind_pipeline_response\"\n      ],\n      \"relation_ids\": [],\n      \"scope\": {\n        \"description\": \"Local AppendFuture access contract in Raft.pipelineDecode for completed built-in pipeline futures. Measure call order with an observing forwarding wrapper; do not substitute a successful reply for a real failed RPC.\",\n        \"assumptions\": [\n          \"The wrapper delegates all methods and values to the actual future and records method entry/return only.\",\n          \"An isolated decoder context is sufficient for this method-access contract; no election or application history is inferred.\"\n        ],\n        \"excluded\": [\n          \"Whether invalid response bytes cause an unsafe commit\",\n          \"Global consensus safety\",\n          \"Crash recovery or liveness\",\n          \"A requirement to call Response after an error; the requirement is conditional on access\"\n        ],\n        \"parameters\": {}\n      },\n      \"rationale\": \"The selected discriminator established an explicit interface expectation and actual producer semantics. Register a bounded implementation-semantics obligation for same-future access ordering. This local check is directly grounded and cheaper than proving an unsafe network history; built-in completion ordering and follower failure guards are retained as contrary evidence against stronger consequences. After this bounded check, return to pipeline error reachability or membership/snapshot support depending on results.\",\n      \"status\": \"pending\",\n      \"previous_id\": null,\n      \"version\": 1,\n      \"boundary_changes\": [],\n      \"obligation_checks\": {},\n      \"remaining_obligation_ids\": [\n        \"O_pipeline_response_order\"\n      ],\n      \"recheck_reasons\": [],\n      \"semantic_readiness\": {},\n      \"coverage_limitations\": [\n        \"No executable trigger requirement covers reference B_inmem_ready\",\n        \"No executable trigger requirement covers reference B_pipeline_match\",\n        \"No executable trigger requirement covers reference B_net_ready\",\n        \"No executable trigger requirement covers reference F_pipeline_ready\"\n      ]\n    }\n  ],\n  \"claims\": [\n    {\n      \"id\": \"O_pipeline_response_order\",\n      \"concern\": \"implementation_semantics\",\n      \"description\": \"For each consumed AppendFuture on which pipelineDecode calls Response(), a call to Error() on that same future must already have returned.\",\n      \"source_ids\": [\n        \"src_pipeline_interface\",\n        \"src_pipeline_match\"\n      ],\n      \"version\": 1\n    }\n  ],\n  \"candidates\": [\n    {\n      \"id\": \"8873456b384a4c9d929091e2a05adc5d\",\n      \"question\": {\n        \"audit_spec_version\": 2,\n        \"disposition\": \"ready_for_check\",\n        \"preferred_check\": \"direct_test\",\n        \"requests\": [],\n        \"question\": \"Does Raft.pipelineDecode obey the AppendFuture requirement to wait for Error() to return before calling Response(), when it consumes a completed built-in pipeline future?\",\n        \"importance\": \"The decoder uses response fields to update peer progress and feed A1 commitment support. The selected proposition is the explicit interface access contract; an access violation alone does not prove unsupported commitment or application divergence.\",\n        \"source_ids\": [\n          \"src_append_producer\",\n          \"src_commitment\",\n          \"src_future_completion\",\n          \"src_inmem_pipeline\",\n          \"src_match_update\",\n          \"src_net_decode\",\n          \"src_net_pipeline\",\n          \"src_pipeline_interface\",\n          \"src_pipeline_launch\",\n          \"src_pipeline_match\",\n          \"src_pipeline_send\"\n        ],\n        \"participants\": [\n          \"Raft pipeline decoder\",\n          \"Built-in transport pipeline decoder\"\n        ],\n        \"objects\": [\n          \"AppendFuture\",\n          \"AppendEntriesResponse\",\n          \"followerReplication\"\n        ],\n        \"contexts\": [\n          \"Completed future delivered on Consumer\",\n          \"Both successful and failed completion status\",\n          \"Isolated decoder invocation with real built-in future producer\"\n        ],\n        \"event_paths\": [\n          \"Pipeline AppendEntries -> producer completion -> Consumer delivery -> pipelineDecode Response access\"\n        ],\n        \"activity_classes\": [\n          \"A1\",\n          \"A6\"\n        ],\n        \"behavior_ids\": [\n          \"B_inmem_ready\",\n          \"B_net_ready\",\n          \"B_pipeline_match\"\n        ],\n        \"fact_ids\": [\n          \"F_pipeline_ready\"\n        ],\n        \"supporting_behavior_ids\": {\n          \"B_commit\": \"Receives peer match updates and computes commitment, explaining consequence relevance without claiming it is exercised by this check.\",\n          \"B_append_success\": \"Real follower errors return without setting Success, limiting any inference of invalid support.\"\n        },\n        \"obligation_relation_kind\": \"consumption\",\n        \"counterevidence\": [\n          \"Built-in producers record completion before sending the future, so channel receipt orders completed response writes.\",\n          \"Fresh zero-valued responses and follower error paths can prevent an error from looking like a successful match; the selected obligation is not equivalent to a commitment-safety property.\"\n        ],\n        \"unknowns\": [\n          \"A direct call-order observation remains to be executed.\",\n          \"No legal same-execution prefix or endpoint establishing unsupported commitment is available.\"\n        ],\n        \"priority\": 2,\n        \"trigger_rationale\": \"The interface explicitly requires Error to return before Response, while the real decoder reads ready.Request(), ready.Response() without Error. Built-in Consumer publishes error completions, so readiness is not a general success guarantee.\"\n      },\n      \"status\": \"escalated\",\n      \"parent_candidate_id\": null,\n      \"fork_reason\": \"\",\n      \"stage\": \"analyze\",\n      \"read_plan_id\": null,\n      \"material_ids\": [],\n      \"spec_task_ids\": [],\n      \"stagnation\": 0,\n      \"stop_reason\": \"The selected discriminator established an explicit interface expectation and actual producer semantics. Register a bounded implementation-semantics obligation for same-future access ordering. This local check is directly grounded and cheaper than proving an unsafe network history; built-in completion ordering and follower failure guards are retained as contrary evidence against stronger consequences. After this bounded check, return to pipeline error reachability or membership/snapshot support depending on results.\",\n      \"resume_conditions\": [],\n      \"obligation_id\": \"O_pipeline_response_order\"\n    }\n  ],\n  \"current\": {\n    \"phase\": \"executed\",\n    \"operation_id\": \"8123464d05e14a6d8f65bee76a928477\",\n    \"action\": \"obligation\"\n  }\n}\npackage raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\n// AssuranceMessage identifies one actual RPC and its delivery boundary.\n// Payload records actual input/output; callers supply their own discriminator.\ntype AssuranceMessage struct {\n\tID       uint64 `json:\"message_id\"`\n\tSender   string `json:\"sender\"`\n\tReceiver string `json:\"receiver\"`\n\tKind     string `json:\"kind\"`\n\tPhase    string `json:\"event\"`\n\tPayload  string `json:\"payload\"`\n\tError    string `json:\"error,omitempty\"`\n}\n\ntype AssuranceCluster struct {\n\tNodes      []*Raft\n\tTransports []*InmemTransport\n\tdone       chan struct{}\n\tworkers    sync.WaitGroup\n\tsequence   uint64\n\temit       sync.Mutex\n\tgate       func(AssuranceMessage) <-chan struct{}\n}\n\ntype assuranceTransport struct {\n\t*InmemTransport\n\tinbox chan RPC\n}\n\nfunc (t *assuranceTransport) Consumer() <-chan RPC { return t.inbox }\n\nfunc (c *AssuranceCluster) record(m AssuranceMessage) {\n\tc.emit.Lock()\n\traw, err := json.Marshal(m)\n\tif err != nil {\n\t\tc.emit.Unlock()\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(raw))\n\tc.emit.Unlock()\n}\n\nfunc (c *AssuranceCluster) boundary(m AssuranceMessage) bool {\n\tc.record(m)\n\tvar release <-chan struct{}\n\tif c.gate != nil {\n\t\trelease = c.gate(m)\n\t}\n\tif release != nil {\n\t\tselect {\n\t\tcase <-release:\n\t\tcase <-c.done:\n\t\t\treturn false\n\t\t}\n\t}\n\tselect {\n\tcase <-c.done:\n\t\treturn false\n\tdefault:\n\t\treturn true\n\t}\n}\n\nfunc (c *AssuranceCluster) forward(t *assuranceTransport, receiver ServerID, rpc RPC) {\n\tdefer c.workers.Done()\n\tdata, err := json.Marshal(rpc.Command)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tm := AssuranceMessage{ID: atomic.AddUint64(&c.sequence, 1), Receiver: string(receiver),\n\t\tKind: fmt.Sprintf(\"%T\", rpc.Command), Phase: \"request_delivery\", Payload: string(data)}\n\tif h, ok := rpc.Command.(WithRPCHeader); ok {\n\t\tm.Sender = string(h.GetRPCHeader().ID)\n\t}\n\tif !c.boundary(m) {\n\t\treturn\n\t}\n\tresponse := make(chan RPCResponse, 1)\n\tactual := rpc\n\tactual.RespChan = response\n\tselect {\n\tcase t.inbox <- actual:\n\tcase <-c.done:\n\t\treturn\n\t}\n\tm.Phase = \"request_handoff\"\n\tc.record(m)\n\tvar result RPCResponse\n\tselect {\n\tcase result = <-response:\n\tcase <-c.done:\n\t\treturn\n\t}\n\tdata, err = json.Marshal(result.Response)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tm.Phase, m.Payload = \"reply_delivery\", string(data)\n\tif result.Error != nil {\n\t\tm.Error = result.Error.Error()\n\t}\n\tif !c.boundary(m) {\n\t\treturn\n\t}\n\tselect {\n\tcase rpc.RespChan <- result:\n\t\tm.Phase = \"reply_handoff\"\n\t\tc.record(m)\n\tcase <-c.done:\n\t}\n}\n\n// Configurations, FSMs and timeouts are experiment inputs, never hidden answers.\n// Bootstrap uses the public API; every election and reply comes from real workers.\nfunc NewAssuranceCluster(t *testing.T, configs []*Config, fsm func(int) FSM,\n\trpcTimeout time.Duration, gate func(AssuranceMessage) <-chan struct{}) *AssuranceCluster {\n\treturn NewAssuranceClusterWithSuffrage(t, configs, nil, fsm, rpcTimeout, gate)\n}\n\n// Explicit initial membership is passed unchanged to the public bootstrap API.\n// A nil list retains the all-voter convenience entry point.\nfunc NewAssuranceClusterWithSuffrage(t *testing.T, configs []*Config, suffrage []ServerSuffrage,\n\tfsm func(int) FSM, rpcTimeout time.Duration, gate func(AssuranceMessage) <-chan struct{}) *AssuranceCluster {\n\tt.Helper()\n\tif len(suffrage) != 0 && len(suffrage) != len(configs) {\n\t\tt.Fatal(\"suffrage must name every configured member\")\n\t}\n\tc := &AssuranceCluster{done: make(chan struct{}), gate: gate}\n\tt.Cleanup(func() {\n\t\tclose(c.done)\n\t\tfutures := make([]Future, 0, len(c.Nodes))\n\t\tfor _, node := range c.Nodes {\n\t\t\tfutures = append(futures, node.Shutdown())\n\t\t}\n\t\tfor _, transport := range c.Transports {\n\t\t\ttransport.Close()\n\t\t}\n\t\tfinished := make(chan struct{})\n\t\tgo func() {\n\t\t\tfor _, future := range futures {\n\t\t\t\tfuture.Error()\n\t\t\t}\n\t\t\tc.workers.Wait()\n\t\t\tclose(finished)\n\t\t}()\n\t\tselect {\n\t\tcase <-finished:\n\t\tcase <-time.After(5 * time.Second):\n\t\t\tt.Error(\"Raft helper cleanup timed out\")\n\t\t}\n\t})\n\tconfiguration := Configuration{}\n\tfor index, conf := range configs {\n\t\t_, transport := NewInmemTransportWithTimeout(ServerAddress(conf.LocalID), rpcTimeout)\n\t\tc.Transports = append(c.Transports, transport)\n\t\trole := Voter\n\t\tif len(suffrage) != 0 {\n\t\t\trole = suffrage[index]\n\t\t}\n\t\tconfiguration.Servers = append(configuration.Servers, Server{ID: conf.LocalID,\n\t\t\tAddress: transport.LocalAddr(), Suffrage: role})\n\t}\n\tfor i, transport := range c.Transports {\n\t\tfor j, peer := range c.Transports {\n\t\t\tif i != j {\n\t\t\t\ttransport.Connect(peer.LocalAddr(), peer)\n\t\t\t}\n\t\t}\n\t}\n\tfor i, transport := range c.Transports {\n\t\tconf := *configs[i]\n\t\tstore, snapshots := NewInmemStore(), NewInmemSnapshotStore()\n\t\tproxy := &assuranceTransport{InmemTransport: transport, inbox: make(chan RPC)}\n\t\tif err := BootstrapCluster(&conf, store, store, snapshots, proxy, configuration); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tc.workers.Add(1)\n\t\tgo func(receiver ServerID, tr *assuranceTransport) {\n\t\t\tdefer c.workers.Done()\n\t\t\tfor {\n\t\t\t\tselect {\n\t\t\t\tcase rpc := <-tr.InmemTransport.Consumer():\n\t\t\t\t\tc.workers.Add(1)\n\t\t\t\t\tgo c.forward(tr, receiver, rpc)\n\t\t\t\tcase <-c.done:\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t}\n\t\t}(conf.LocalID, proxy)\n\t\tnode, err := NewRaft(&conf, fsm(i), store, store, snapshots, proxy)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tc.Nodes = append(c.Nodes, node)\n\t}\n\treturn c\n}\ntype InmemTransport struct {\n\tsync.RWMutex\n\tconsumerCh chan RPC\n\tlocalAddr  ServerAddress\n\tpeers      map[ServerAddress]*InmemTransport\n\tpipelines  []*inmemPipeline\n\ttimeout    time.Duration\n}\n\n// NewInmemTransportWithTimeout is used to initialize a new transport and\n// generates a random local address if none is specified. The given timeout\n// will be used to decide how long to wait for a connected peer to process the\n// RPCs that we're sending it. See also Connect() and Consumer().\nfunc NewInmemTransportWithTimeout(addr ServerAddress, timeout time.Duration) (ServerAddress, *InmemTransport) {\n\tif string(addr) == \"\" {\n\t\taddr = NewInmemAddr()\n\t}\n\ttrans := &InmemTransport{\n\t\tconsumerCh: make(chan RPC, 16),\n\t\tlocalAddr:  addr,\n\t\tpeers:      make(map[ServerAddress]*InmemTransport),\n\t\ttimeout:    timeout,\n\t}\n\treturn addr, trans\n}\n\n// NewInmemTransport is used to initialize a new transport\n// and generates a random local address if none is specified\nfunc NewInmemTransport(addr ServerAddress) (ServerAddress, *InmemTransport) {\n\treturn NewInmemTransportWithTimeout(addr, 500*time.Millisecond)\n}\n\n// SetHeartbeatHandler is used to set optional fast-path for\n// heartbeats, not supported for this transport.\nfunc (i *InmemTransport) SetHeartbeatHandler(cb func(RPC)) {\n}\n\n// Consumer implements the Transport interface.\nfunc (i *InmemTransport) Consumer() <-chan RPC {\n\treturn i.consumerCh\n}\n\n// LocalAddr implements the Transport interface.\nfunc (i *InmemTransport) LocalAddr() ServerAddress {\n\treturn i.localAddr\n}\n\n// AppendEntriesPipeline returns an interface that can be used to pipeline\n// AppendEntries requests.\nfunc (i *InmemTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {\n\ti.Lock()\n\tdefer i.Unlock()\n\n\tpeer, ok := i.peers[target]\n\tif !ok {\n\t\treturn nil, fmt.Errorf(\"failed to connect to peer: %v\", target)\n\t}\n\tpipeline := newInmemPipeline(i, peer, target)\n\ti.pipelines = append(i.pipelines, pipeline)\n\treturn pipeline, nil\n}\n\n// AppendEntries implements the Transport interface.\nfunc (i *InmemTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n\trpcResp, err := i.makeRPC(target, args, nil, i.timeout)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\t// Copy the result back\n\tout := rpcResp.Response.(*AppendEntriesResponse)\n\t*resp = *out\n\treturn nil\n}\n\n// RequestVote implements the Transport interface.\n","exit_code":0,"status":"completed"}}
