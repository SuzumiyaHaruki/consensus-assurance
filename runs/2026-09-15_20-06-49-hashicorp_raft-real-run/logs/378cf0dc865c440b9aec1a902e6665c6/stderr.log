      "id": "e108f219998c4484b580e8db6d36b7ac",
      "task_id": "2bdda1b046534d0ea4c04acaf8d97098",
      "check_id": "e586cb44d2094ab49cc1d10a41eb83ae",
      "model_id": null,
      "target_versions": {
        "G_apply": 1,
        "O_commit": 1,
        "B_newCommitment": 1,
        "B_match": 1,
        "B_setConfiguration": 1,
        "B_recalculate": 1,
