{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '252,307p' ../agent-source/future.go; sed -n '1086,1103p' ../agent-source/raft.go; sed -n '1007,1030p' ../agent-source/api.go; sed -n '1,90p' ../agent-source/transport.go; python3 - <<'PY'\nimport json\ns=json.load(open('../submission.schema.json'))['\"'$defs'\"']['CandidateSubmission']; print(json.dumps(s,indent=2))\nPY\"","aggregated_output":"\tAddress *ServerAddress\n}\n\n// configurationsFuture is used to retrieve the current configurations. This is\n// used to allow safe access to this information outside of the main thread.\ntype configurationsFuture struct {\n\tdeferError\n\tconfigurations configurations\n}\n\n// Configuration returns the latest configuration in use by Raft.\nfunc (c *configurationsFuture) Configuration() Configuration {\n\treturn c.configurations.latest\n}\n\n// Index returns the index of the latest configuration in use by Raft.\nfunc (c *configurationsFuture) Index() uint64 {\n\treturn c.configurations.latestIndex\n}\n\n// vote is used to respond to a verifyFuture.\n// This may block when responding on the notifyCh.\nfunc (v *verifyFuture) vote(leader bool) {\n\tv.voteLock.Lock()\n\tdefer v.voteLock.Unlock()\n\n\t// Guard against having notified already\n\tif v.notifyCh == nil {\n\t\treturn\n\t}\n\n\tif leader {\n\t\tv.votes++\n\t\tif v.votes >= v.quorumSize {\n\t\t\tv.notifyCh <- v\n\t\t\tv.notifyCh = nil\n\t\t}\n\t} else {\n\t\tv.notifyCh <- v\n\t\tv.notifyCh = nil\n\t}\n}\n\n// appendFuture is used for waiting on a pipelined append\n// entries RPC.\ntype appendFuture struct {\n\tdeferError\n\tstart time.Time\n\targs  *AppendEntriesRequest\n\tresp  *AppendEntriesResponse\n}\n\nfunc (a *appendFuture) Start() time.Time {\n\treturn a.start\n}\n\nfunc (r *Raft) quorumSize() int {\n\tvoters := 0\n\tfor _, server := range r.configurations.latest.Servers {\n\t\tif server.Suffrage == Voter {\n\t\t\tvoters++\n\t\t}\n\t}\n\treturn voters/2 + 1\n}\n\n// restoreUserSnapshot is used to manually consume an external snapshot, such\n// as if restoring from a backup. We will use the current Raft configuration,\n// not the one from the snapshot, so that we can restore into a new cluster. We\n// will also use the higher of the index of the snapshot, or the current index,\n// and then add 1 to that, so we force a new state with a hole in the Raft log,\n// so that the snapshot will be sent to followers and used for any new joiners.\n// This can only be run on the leader, and returns a future that can be used to\n// block until complete.\n}\n\n// Shutdown is used to stop the Raft background routines.\n// This is not a graceful operation. Provides a future that\n// can be used to block until all background routines have exited.\nfunc (r *Raft) Shutdown() Future {\n\tr.shutdownLock.Lock()\n\tdefer r.shutdownLock.Unlock()\n\n\tif !r.shutdown {\n\t\tclose(r.shutdownCh)\n\t\tr.shutdown = true\n\t\tr.setState(Shutdown)\n\t\treturn &shutdownFuture{r}\n\t}\n\n\t// avoid closing transport twice\n\treturn &shutdownFuture{nil}\n}\n\n// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n// that can be used to block until complete, and that contains a function that\n// can be used to open the snapshot.\nfunc (r *Raft) Snapshot() SnapshotFuture {\n// Copyright (c) HashiCorp, Inc.\n// SPDX-License-Identifier: MPL-2.0\n\npackage raft\n\nimport (\n\t\"io\"\n\t\"time\"\n)\n\n// RPCResponse captures both a response and a potential error.\ntype RPCResponse struct {\n\tResponse interface{}\n\tError    error\n}\n\n// RPC has a command, and provides a response mechanism.\ntype RPC struct {\n\tCommand  interface{}\n\tReader   io.Reader // Set only for InstallSnapshot\n\tRespChan chan<- RPCResponse\n}\n\n// Respond is used to respond with a response, error or both\nfunc (r *RPC) Respond(resp interface{}, err error) {\n\tr.RespChan <- RPCResponse{resp, err}\n}\n\n// Transport provides an interface for network transports\n// to allow Raft to communicate with other nodes.\ntype Transport interface {\n\t// Consumer returns a channel that can be used to\n\t// consume and respond to RPC requests.\n\tConsumer() <-chan RPC\n\n\t// LocalAddr is used to return our local address to distinguish from our peers.\n\tLocalAddr() ServerAddress\n\n\t// AppendEntriesPipeline returns an interface that can be used to pipeline\n\t// AppendEntries requests.\n\tAppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error)\n\n\t// AppendEntries sends the appropriate RPC to the target node.\n\tAppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error\n\n\t// RequestVote sends the appropriate RPC to the target node.\n\tRequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error\n\n\t// InstallSnapshot is used to push a snapshot down to a follower. The data is read from\n\t// the ReadCloser and streamed to the client.\n\tInstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error\n\n\t// EncodePeer is used to serialize a peer's address.\n\tEncodePeer(id ServerID, addr ServerAddress) []byte\n\n\t// DecodePeer is used to deserialize a peer's address.\n\tDecodePeer([]byte) ServerAddress\n\n\t// SetHeartbeatHandler is used to setup a heartbeat handler\n\t// as a fast-pass. This is to avoid head-of-line blocking from\n\t// disk IO. If a Transport does not support this, it can simply\n\t// ignore the call, and push the heartbeat onto the Consumer channel.\n\tSetHeartbeatHandler(cb func(rpc RPC))\n\n\t// TimeoutNow is used to start a leadership transfer to the target node.\n\tTimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error\n}\n\n// WithPreVote is an interface that a transport may provide which\n// allows a transport to support a PreVote request.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithPreVote interface {\n\t// RequestPreVote sends the appropriate RPC to the target node.\n\tRequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error\n}\n\n// WithClose is an interface that a transport may provide which\n// allows a transport to be shut down cleanly when a Raft instance\n// shuts down.\n//\n// It is defined separately from Transport as unfortunately it wasn't in the\n// original interface specification.\ntype WithClose interface {\n\t// Close permanently closes a transport, stopping\n\t// any associated goroutines and freeing other resources.\n\tClose() error\n}\n\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Rejected operation ID whose complete draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"reconnect_questions\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/AuditQuestion\"\n      },\n      \"description\": \"Optional explicit question reconnections; changing an accepted Unit proposition still requires F2/F3\",\n      \"title\": \"Reconnect Questions\",\n      \"type\": \"object\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > build_map.py <<'PY'\nimport json\nsources=[]\ndef src(id,file,a,b,kind='code_observation'):\n sources.append(dict(id=id,file=file,start_line=a,end_line=b,kind=kind)); return id\nsrc('src-startup','api.go',500,675)\nsrc('src-replication-lifetime','raft.go',582,642)\nsrc('src-replication-loop','replication.go',137,199)\nsrc('src-replication-snapshot','replication.go',299,384)\nsrc('src-replication-heartbeat','replication.go',388,440)\nsrc('src-replication-completion','replication.go',646,668)\nsrc('src-pipeline','replication.go',446,568)\nsrc('src-install','raft.go',1814,1953)\nsrc('src-config-types','configuration.go',8,84,'interface_statement')\nsrc('src-config-transform','configuration.go',152,307)\nsrc('src-config-consume','raft.go',1582,1600)\nsrc('src-leader-commit','raft.go',785,847)\nsrc('src-lease','raft.go',1036,1095)\nsrc('src-verify-start','raft.go',965,988)\nsrc('src-verify-result','raft.go',848,871)\nsrc('src-verify-notify','replication.go',98,112)\nsrc('src-verify-vote','future.go',272,295)\nsrc('src-verify-contract','api.go',880,894,'interface_statement')\nsrc('src-client-apply','api.go',803,853,'interface_statement')\nsrc('src-fsm-run','fsm.go',85,254)\nsrc('src-snapshot-create','snapshot.go',125,213)\nsrc('src-persist-context','raft.go',2130,2161)\nsrc('src-prevote','raft.go',1736,1809)\nsrc('src-transfer','raft.go',990,1030)\nsrc('src-timeout-now','raft.go',2187,2220)\nsrc('src-fastpath','net_transport.go',660,739)\nsrc('src-rpc-dispatch','raft.go',1390,1436)\nsrc('src-user-restore','raft.go',1104,1200)\nsrc('src-shutdown','api.go',1009,1026,'interface_statement')\nsrc('src-transport','transport.go',28,87,'interface_statement')\nsrc('src-follower-loop','raft.go',158,258)\nB=[]\ndef beh(id,act,owner,context,trigger,ss,**kw):\n b=dict(id=id,primary_activity=act,execution_owner=owner,protocol_context=context,trigger=trigger,source_ids=ss,**kw);B.append(b)\nbeh('b-election','A2','Raft main loop and one RPC goroutine per voter','Candidate campaign and persisted term/vote','Follower contact timeout or TimeoutNow; pre-vote when supported and not transferring',['src-campaign','src-election-producer','src-vote-handler','src-prevote','src-persist-context','src-follower-loop'],implementation_guards=['Known leader, candidate membership/voter status, old term, prior vote, last log term/index checks on vote receipt; compatibility paths omit ID checks.','Fresh response channel per campaign and only configured voters asked.'],writes=['Current term, durable vote term/address, Raft state and known leader'],async_boundaries=['Election request goroutines return into the campaign-local channel; election timeout retries with a new campaign.'],produces_fact_ids=['f-authority'],cross_activity_effects={'A1':'Election chooses the owner of fresh replication and commitment state; log freshness constrains which stored history may lead.'},unknowns=['Atomicity and recoverability of separate stable-store vote writes on partial storage failure.'])\nbeh('b-leader-context','A2','Raft main loop','One leadership tenure','Election success enters runLeader; higher-term RPC, replication stepDown, lease failure or removal exits',['src-leader-lifetime','src-replication-lifetime','src-lease','src-leader-commit'],writes=['Fresh commitment(startIndex=lastIndex+1), fresh replication objects capturing currentTerm/commitment/stepDown, new inflight list'],external_effects=['Dispatch initial no-op; stop replication and fail inflight/verification futures on exit'],consumes_fact_ids=['f-authority'],cross_activity_effects={'A1':'Late old replication replies retain their old commitment object; new tenure starts with zero voter matches and a new current-term threshold.','A7':'ErrLeadershipLost does not establish that an inflight write never committed.'},unknowns=['Old replication work can continue until its stop boundary; shared log reads during overlapping tenure changes need narrower analysis.'])\nbeh('b-dispatch','A1','Leader main loop','Active leader term','Accepted apply batch or configuration/no-op dispatch',['src-dispatch'],implementation_guards=['StoreLogs must succeed before local commitment.match and replicator notification'],writes=['Assigned index/term, inflight list and lastLog'],durable_effects=['StoreLogs writes local entries'],external_effects=['On success match local voter prefix and notify triggerCh; on failure respond errors and become follower'],produces_fact_ids=['f-match'])\nbeh('b-replicate','A1','Per-peer replication goroutine and pipeline decoder','Captured leader term and commitment object','Log trigger, CommitTimeout, transfer catch-up or retry',['src-request-producer','src-replication-retry','src-replication-loop','src-pipeline','src-replication-completion','src-replication-lifetime'],reads=['Captured term, shared log prefix, leader commitIndex and nextIndex'],writes=['Peer nextIndex and captured commitment match'],important_branches=['Reject response backs nextIndex down using follower LastLog and retries.','Missing log invokes snapshot transfer; successful log response counts only the supplied last entry; higher term signals captured stepDown.','Producer limits entries by MaxAppendEntries independently of the propagated LeaderCommitIndex.'],async_boundaries=['RPC and pipelined responses; stop checked between replication iterations'],produces_fact_ids=['f-match'],unknowns=['Reachability of a successful short matching batch leaving a divergent unsupplied follower suffix.'])\nbeh('b-aggregate','A1','commitment mutex plus leader main loop','Current voter map and tenure startIndex','match or setConfiguration; commitCh notification',['src-commitment','src-leader-commit'],implementation_guards=['Only known voter IDs and increasing match indexes count.','Quorum order statistic must increase commitment and reach startIndex.'],writes=['Monotonic commitment index; leader commitIndex and committed configuration'],consumes_fact_ids=['f-match'],produces_fact_ids=['f-commit'],external_effects=['Queue newly committed inflight logs via processLogs; step down if removed.'])\nbeh('b-append','A1','Follower main loop; zero-data heartbeat can use transport callback','Request term compared with local currentTerm','AppendEntries dispatch',['src-append-consumer','src-fastpath','src-rpc-dispatch'],implementation_guards=['Old term rejection and previous entry term validation','Supplied conflict triggers suffix deletion; stored duplicates skipped'],writes=['Current term/state, leader identity, local suffix, configuration and commitIndex'],durable_effects=['Persist term and new log entries after any conflict truncation'],external_effects=['Advance to min(LeaderCommitIndex, local last index), enqueue local logs, respond success and refresh contact'],produces_fact_ids=['f-commit'],cross_activity_effects={'A2':'Higher term demotes and persists context; equal-term append normally demotes except transfer candidate branch.','A5':'The local entries below the calculated commit bound are queued for FSM processing.'},unknowns=['Whether the unsupplied local suffix at the calculated commit bound necessarily agrees with the leader under actual producer history.'])\nbeh('b-membership','A4','Main loop; startup log scanner','Latest and committed configuration indexes','Configuration API entry or replicated configuration log',['src-config-types','src-config-transform','src-config-admission','src-dispatch','src-config-consume','src-leader-commit'],implementation_guards=['Configuration admission waits for latest committed and a current-term commit.','Optional prevIndex comparison; unique nonempty IDs/addresses and at least one voter required.'],writes=['Latest voter set at append, committed set at commit or following configuration; rollback latest on conflicting suffix deletion'],cross_activity_effects={'A1':'setConfiguration carries matches for retained voters, initializes others to zero and recalculates support.','A2':'Latest voters define election requests and quorumSize; committed self removal ends leadership.'})\nbeh('b-application','A5','Main loop queues; dedicated FSM goroutine consumes','Local commitIndex, lastApplied and FSM-local lastIndex','processLogs or queued restore',['src-apply-consumer','src-fsm-run','src-fsm-contract'],consumes_fact_ids=['f-commit'],writes=['lastApplied when queued; FSM lastIndex after processing'],external_effects=['Command calls FSM.Apply or ApplyBatch; barrier completes through FSM queue; futures return after processing'],async_boundaries=['fsmMutateCh decouples enqueue from completed application'],existing_protections=['Skip indexes already queued; ordered iteration through local log; snapshot and restore serialize with FSM work.'])\nbeh('b-recovery','A3','NewRaft before startup; main loop install plus FSM restore','Persisted log/snapshot prefix and configuration','Startup or InstallSnapshot after log-unavailable replication',['src-startup','src-install','src-replication-snapshot'],implementation_guards=['Reject old snapshot RPC term, unsupported version, short data and failed persistence/restore'],writes=['Restored snapshot index/term and configuration; latest config scanned from post-snapshot log'],external_effects=['Successful snapshot replication advances captured peer match; install waits for FSM restore before replying'],produces_fact_ids=['f-match'],cross_activity_effects={'A1':'Snapshot acknowledgment contributes prefix support to the leader commitment object.','A2':'Startup restores term and starts as follower; snapshot metadata seeds membership.'},unknowns=['Stale but same-term snapshot installation and retained suffix consistency require separate analysis.'])\nbeh('b-history','A6','StableStore, LogStore and snapshot goroutine','Persistent election context and snapshotted FSM state','Term/vote update or FSM snapshot request',['src-persist-context','src-snapshot-create','src-startup'],durable_effects=['Persist currentTerm before updating memory; vote term then candidate in separate calls; snapshot data finalized before compacting logs'],cross_activity_effects={'A2':'Recovered term/vote and last log constrain elections.','A1':'Snapshot metadata preserves applied prefix and committed configuration for resynchronization.'},existing_protections=['Reject snapshot whose FSM index precedes committed configuration index.'])\nbeh('b-client','A7','API caller and main/FSM loops','Application invocation and completion','ApplyLog, Barrier, Shutdown',['src-client-apply','src-fsm-run','src-shutdown'],external_effects=['Apply enqueue timeout bounds admission only; leadership loss is an ambiguous write result; Shutdown future waits for background exit'],cross_activity_effects={'A1':'Leader admission dispatches command entries.','A5':'Apply future response follows FSM consumption.'})\nbeh('b-verify','A2','Leader main loop, per-peer notify maps and verifyFuture vote lock','One VerifyLeader request within active leader state','API verifyCh request; successful or rejected peer contact notification',['src-verify-contract','src-verify-start','src-verify-result','src-verify-notify','src-verify-vote','src-replication-heartbeat','src-lease','src-replication-completion'],implementation_guards=['Initial self vote; quorumSize counts voters.','Each per-peer notify map is drained under lock; future notification is disabled once threshold or rejection reached.'],writes=['verifyFuture votes, quorumSize, notifyCh and registered peer notifications'],produces_fact_ids=['f-verify-support'],consumes_fact_ids=['f-verify-support'],external_effects=['Register with every replState peer and trigger heartbeat; count each positive notify; return nil when count reaches quorumSize, otherwise rejection causes stepdown'],cross_activity_effects={'A7':'VerifyLeader API is offered to prevent stale FSM reads after leadership loss.'},unknowns=['Does successful verification require eligible voter support, and can a nonvoter acknowledgment satisfy the threshold before a voter reply?','Which legal timing histories make a false verification success externally stale despite independent lease checks?'])\nbeh('b-transfer','A2','Leader loop and transfer goroutine; target main loop','Target voter and leadership transfer attempt','LeadershipTransfer or TimeoutNow',['src-transfer','src-timeout-now','src-campaign'],external_effects=['Catch up target by nextIndex then send TimeoutNow; recipient becomes candidate and bypasses pre-vote/known-leader vote inhibition for that campaign'],cross_activity_effects={'A1':'Transfer catch-up uses ordinary replication before triggering election.'},unknowns=['Target eligibility and cancellation races outside the representative successful transfer path.'])\nbeh('b-user-restore','A3','Leader main loop and FSM goroutine','Explicit operator snapshot restore','Restore request',['src-user-restore'],implementation_guards=['Stable configuration required; snapshot size/version/persistence checked'],writes=['Abort inflight writes; create snapshot at fresh burned index/current term/current configuration; restore FSM and update lastLog,lastApplied,lastSnapshot'],cross_activity_effects={'A1':'Burned log hole causes replication to switch to snapshot transfer.','A7':'Pending writes receive ErrAbortedByRestore.'})\nfacts=[\ndict(id='f-authority',meaning='The main loop has selected this node as leader after the campaign grant count reaches its configured voter majority.',identity={'node':'localID','campaign':'election term and campaign-local channel'},validity_context='Active leadership tenure; state can change through newer term, lease failure, removal, transfer-related RPC or shutdown.',representation=['Raft state','currentTerm','leader ID/address'],durability='Term and vote are persisted; Leader state is volatile.',recovery='Startup becomes follower and campaigns again.',source_ids=['src-campaign','src-election-producer','src-leader-lifetime','src-startup'],invalidators=['b-leader-context','b-append']),\ndict(id='f-match',meaning='A captured leader commitment object records a monotonically increasing stored-prefix match for a configured voter ID.',identity={'tenure':'commitment object','peer':'ServerID'},validity_context='Only voter IDs present in that commitment map are accepted; configuration update retains matches for retained voter IDs.',representation=['commitment.matchIndexes'],durability='Volatile; local logs and remote acknowledged storage are its inputs.',recovery='Fresh leadership starts all matches at zero; snapshot/log acknowledgments rebuild support.',source_ids=['src-commitment','src-dispatch','src-replication-completion','src-replication-snapshot'],reinterpreters=['b-membership']),\ndict(id='f-commit',meaning='The local Raft commitIndex is the index through which processLogs is authorized by the current handler to enqueue local entries; this is not itself proof of FSM completion or leader/follower content agreement.',identity={'node':'local Raft instance','prefix':'index'},validity_context='Leader updates from tenure commitment; follower updates from leader-advertised index bounded by local last index after request checks.',representation=['raftState.commitIndex'],durability='Volatile commit accounting; persisted logs and snapshots preserve history.',recovery='Startup restores applied snapshot boundary and reconstructs configuration; later leader commitment or AppendEntries reestablishes commit advancement.',source_ids=['src-leader-commit','src-append-consumer','src-apply-consumer','src-startup']),\ndict(id='f-verify-support',meaning='A verifyFuture contains its initial self vote plus positive per-peer notifications received while its notifyCh remains active; the threshold is the latest voter majority computed when verification begins.',identity={'request':'verifyFuture instance'},validity_context='Registered during an active leader tenure; peers are selected from replState, without a suffrage filter at registration or notification.',representation=['verifyFuture.votes','verifyFuture.quorumSize','verifyFuture.notifyCh','followerReplication.notify'],durability='Volatile request accounting.',recovery='No recovery; leader exit fails pending requests and new invocation allocates a fresh future.',source_ids=['src-verify-start','src-verify-vote','src-verify-notify','src-verify-result','src-leader-lifetime'],invalidators=['b-leader-context'])]\nroles=json.load(open('../research.json'))['activity_roles']\nactivities=[]\nfor a,r in roles.items():\n bs=[b for b in B if b['primary_activity']==a]\n activities.append(dict(class_id=a,applicability='applicable',purpose=r['relation'],realization_summary=' '.join(b['trigger']+'.' for b in bs),entry_points=[b['id'] for b in bs],source_ids=list(dict.fromkeys(s for b in bs for s in b['source_ids']))))\ndef path(explanation,ids,fs):\n return dict(explanation=explanation,behavior_ids=ids,fact_ids=fs,source_ids=list(dict.fromkeys(s for b in B if b['id'] in ids for s in b['source_ids'])))\nm=dict(version=1,target_profile=dict(system_boundary='Captured HashiCorp Raft Go module: consensus loops, replication, membership, log/snapshot interfaces and FSM completion. FSM application semantics and durable backend implementation are caller-selected; in-repository mechanisms remain in scope.',protocol_contexts=['Leader election term','Latest and committed configurations','Per-tenure commitment and per-peer replication','Snapshot/log prefix','VerifyLeader invocation'],external_interfaces=['Transport','LogStore','StableStore','SnapshotStore','FSM','Apply and VerifyLeader'],ownership=['Main loop owns normal protocol/configuration processing; replication, FSM and snapshot routines have distinct asynchronous duties.','NetworkTransport can invoke restricted zero-data heartbeat callbacks independently.'],selection_injection=['NewRaft accepts stores, FSM and Transport; network and in-memory transports are provided in repository.'],source_ids=['src-startup','src-transport','src-fastpath'],unknowns=['Backend-specific crash atomicity and alternate transport ordering remain outside this initial reading.']),activities=activities,behaviors=B,facts=facts,surfaces=[dict(entry_point='Raft.appendEntries commit bound',disposition='mapped',behavior_ids=['b-append','b-replicate'],reason='Can normal backtracking or a legal overlap ever deliver a batch ending before a divergent local suffix while advertising a greater commit index?',source_ids=['src-append-consumer','src-replication-retry','src-request-producer'],high_consequence=True),dict(entry_point='Raft.verifyLeader participant eligibility',disposition='mapped',behavior_ids=['b-verify','b-membership'],reason='Verification threshold counts voters but notification registration spans all replication peers. Determine applicable support responsibility and legal consequence.',source_ids=['src-verify-start','src-verify-notify','src-lease','src-config-types'],high_consequence=True),dict(entry_point='Raft.persistVote partial storage failure',disposition='deferred',reason='Separate vote term and candidate writes: determine permitted failure/restart behavior and prior candidate reuse.',source_ids=['src-persist-context'],high_consequence=True),dict(entry_point='NetworkTransport heartbeat callback context',disposition='mapped',behavior_ids=['b-append','b-leader-context'],reason='Fast path excludes log/commit data but changes term/state concurrently with normal processing; overlapping ownership merits separate examination.',source_ids=['src-startup','src-fastpath','src-rpc-dispatch'],high_consequence=True)],core_overview=dict(status='usable',core_gaps=[],formation=path('A1: leader dispatch assigns term/index and persists logs before recording its match and notifying peer replicators. Per-peer requests carry previous prefix, bounded entries and commit index; success supplies stored-prefix support to a captured commitment object. Only configured voters count, and its majority index must reach the first entry of t