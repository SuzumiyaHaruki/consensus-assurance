/toolchain@v0.0.1-go1.23.5.linux-amd64/bin/go\",\n    \"test\",\n    \"-json\",\n    \"-count=1\",\n    \"-timeout=600.0s\",\n    \"-run\",\n    \"^TestAssurance\",\n    \".\"\n  ],\n  \"cwd\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/experiments/cfc8bf465a6d4b489a54e6f9c863a400/workspace\",\n  \"started_at\": \"2026-10-04T03:32:22.676213+00:00\",\n  \"ended_at\": \"2026-10-04T03:32:34.754134+00:00\",\n  \"exit_code\": 0,\n  \"stdout\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/logs/4e26b7ac91e54a21b0db2b361898e129/stdout.log\",\n  \"stderr\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/logs/4e26b7ac91e54a21b0db2b361898e129/stderr.log\",\n  \"reason\": \"\",\n  \"tool_version\": \"go version go1.23.5 linux/amd64\",\n  \"snapshot_id\": \"c4759f41548c49c4be006ce5f45c7b0d\",\n  \"parameters\": {\n    \"timeout_limit\": \"action_timeout\",\n    \"timeout_seconds\": 600.0,\n    \"execution_backend\": {\n      \"name\": \"go_module\",\n      \"version\": \"3\",\n      \"support_files\": []\n    },\n    \"test_started\": true,\n    \"execution_package\": \".\",\n    \"harness_filename\": \"assurance_generated_test.go\",\n    \"changed_target_files\": []\n  },\n  \"artifacts\": [\n    \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/experiments/cfc8bf465a6d4b489a54e6f9c863a400/workspace-delta/manifest.json\",\n    \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/experiments/cfc8bf465a6d4b489a54e6f9c863a400/workspace-outcome/manifest.json\",\n    \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/experiments/cfc8bf465a6d4b489a54e6f9c863a400/workspace/assurance_generated_test.go\"\n  ],\n  \"checker_results\": [\n    {\n      \"invariant\": \"nonvoter-count-unchanged\",\n      \"claim_id\": \"claim-verify-voter-eligibility\",\n      \"scope\": {\n        \"description\": \"Participant eligibility in the per-request VerifyLeader quorum tally, with an unchanged mixed voter/nonvoter configuration and no concurrent leadership/configuration transition during the measured accounting step.\",\n        \"assumptions\": [\n          \"Correct peer identities and suffrage; non-Byzantine, well-formed acknowledgments.\",\n          \"An active verification request with initial self support and a configured voter-majority threshold.\"\n        ],\n        \"excluded\": [\n          \"Whether another leader is actually elected.\",\n          \"External stale-read or split-brain consequences.\",\n          \"Membership changes during verification, transport impersonation and restart recovery.\",\n          \"A guarantee that a permitted voter acknowledgment necessarily completes verification.\"\n        ],\n        \"parameters\": {}\n      },\n      \"outcome\": \"violated\",\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\"\n    }\n  ],\n  \"pending_action_id\": \"cfc8bf465a6d4b489a54e6f9c863a400\"\n}\nclaims {\n  \"id\": \"claim-verify-voter-eligibility\",\n  \"kind\": \"obligation\",\n  \"concern\": \"implementation_semantics\",\n  \"description\": \"Within a stable configuration and an active leader verification request, an acknowledgment from a configured Nonvoter must not increase the support count toward the voter quorum used by VerifyLeader to confirm leadership.\",\n  \"scope\": {\n    \"description\": \"Participant eligibility in the per-request VerifyLeader quorum tally, with an unchanged mixed voter/nonvoter configuration and no concurrent leadership/configuration transition during the measured accounting step.\",\n    \"assumptions\": [\n      \"Correct peer identities and suffrage; non-Byzantine, well-formed acknowledgments.\",\n      \"An active verification request with initial self support and a configured voter-majority threshold.\"\n    ],\n    \"excluded\": [\n      \"Whether another leader is actually elected.\",\n      \"External stale-read or split-brain consequences.\",\n      \"Membership changes during verification, transport impersonation and restart recovery.\",\n      \"A guarantee that a permitted voter acknowledgment necessarily completes verification.\"\n    ],\n    \"parameters\": {}\n  },\n  \"source\": \"Candidate derived from attributed implementation responsibilities\",\n  \"source_ids\": [\n    \"src-verify-doc\",\n    \"src-verify-contract\",\n    \"src-config-types\",\n    \"src-verify-start\",\n    \"src-verify-vote\",\n    \"src-verify-notify\",\n    \"src-verify-result\",\n    \"src-lease\",\n    \"src-replication-lifetime\"\n  ],\n  \"pending\": [],\n  \"assessment\": \"unassessed\",\n  \"candidate\": true,\n  \"grounding\": {\n    \"source_ids\": [\n      \"src-verify-start\",\n      \"src-verify-vote\",\n      \"src-verify-notify\",\n      \"src-verify-result\",\n      \"src-lease\",\n      \"src-replication-lifetime\"\n    ],\n    \"expectation_ids\": [\n      \"src-verify-doc\",\n      \"src-verify-contract\",\n      \"src-config-types\"\n    ],\n    \"binding_ids\": [\n      \"bind-verify-registration\",\n      \"bind-verify-notification\",\n      \"bind-verify-tally\"\n    ],\n    \"derivation\": \"src-verify-doc describes verification by heartbeats to voters; src-verify-contract identifies confirmation of leadership as its purpose, including prevention of stale reads. src-config-types distinguishes Voter and Nonvoter roles. The actual threshold is quorumSize, whose src-lease definition counts voters only. Therefore the support count being compared against that threshold must count eligible voters: an arbitrary nonvoter cannot substitute for one of those participants. The code that registers all replication peers and counts notifyAll results is the subject of comparison, not normative authority that weakens this requirement. The requirement is necessary eligibility accounting, not an assertion that a quorum always succeeds or that every excess tally causes an observed stale read.\",\n    \"applicability\": \"Stable mixed-suffrage configuration, locally active leader verification, response identity known independently of its success value.\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": [\n      \"Independent voter-only lease checking can later demote a leader, but does not change the participant eligibility of this verification tally.\",\n      \"Sending heartbeat messages to nonvoters is not itself forbidden; counting their acknowledgment toward a voter quorum is the checked distinction.\"\n    ]\n  },\n  \"version\": 1\n}\nassessment {\n  \"direct_check_id\": \"915b16f424314914a476b9a962551415\",\n  \"experiment_check_id\": \"4e26b7ac91e54a21b0db2b361898e129\",\n  \"scope\": {\n    \"description\": \"Participant eligibility in the per-request VerifyLeader quorum tally, with an unchanged mixed voter/nonvoter configuration and no concurrent leadership/configuration transition during the measured accounting step.\",\n    \"assumptions\": [\n      \"Correct peer identities and suffrage; non-Byzantine, well-formed acknowledgments.\",\n      \"An active verification request with initial self support and a configured voter-majority threshold.\"\n    ],\n    \"excluded\": [\n      \"Whether another leader is actually elected.\",\n      \"External stale-read or split-brain consequences.\",\n      \"Membership changes during verification, transport impersonation and restart recovery.\",\n      \"A guarantee that a permitted voter acknowledgment necessarily completes verification.\"\n    ],\n    \"parameters\": {}\n  },\n  \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/logs/4e26b7ac91e54a21b0db2b361898e129/stdout.log\",\n  \"parsing_errors\": [],\n  \"prerequisites\": {\n    \"status\": \"matched\",\n    \"reason\": \"Declared prerequisites established\",\n    \"matched_indices\": [\n      0,\n      1\n    ],\n    \"alias_indices\": {\n      \"admitted\": 0,\n      \"ack\": 1\n    }\n  },\n  \"properties\": [\n    {\n      \"monitor_id\": \"monitor-nonvoter-support\",\n      \"checker_id\": \"nonvoter-count-unchanged\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        2\n      ],\n      \"valid_witness_indices\": [\n        2\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        2\n      ],\n      \"outside_applicability_indices\": [\n        5\n      ],\n      \"correlations\": {\n        \"2\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            0,\n            1\n          ],\n          \"alias_indices\": {\n            \"admitted\": 0,\n            \"ack\": 1\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"NewRaft skipStartup prevents autonomous main/FSM/snapshot loops. Driver calls actual runFollower and runCandidate for the selected leader; follower RPC pumps dispatch actual processRPC calls without running their election timers.\",\n    \"Driver invokes setupLeaderState/startStopReplication/dispatchLogs and the sourced leaderLoop commit effects (setCommitIndex, setCommittedConfiguration, processLogs) after observing actual majority commitment. It directly invokes verifyLeader as the source main-loop branch does.\",\n    \"A Transport wrapper delays AppendEntries at the send/return boundary. Responses are generated by actual follower handlers through InmemTransport; no reply value is invented. Pipeline support is declined using the supported ErrPipelineReplicationNotSupported path.\",\n    \"Main-loop lease/timer scheduling and FSM consumption are not exercised during the measured step. No external VerifyLeader future success, stale read, competing leader, or full public-API history is inferred.\",\n    \"Private fields are read under their existing locks where concurrent mutation exists. The driver closes replication stop channels, releases blocked transport calls with cancellation, and waits on Shutdown futures.\"\n  ],\n  \"conditions\": {\n    \"plan_uncertainties\": [\n      \"This check isolates a local eligibility duty. It does not execute the public VerifyLeader return branch, main-loop lease checks, a competing leader election, FSM read, or asynchronous timer consequence.\",\n      \"The heartbeat request may have been sent before registration; response delivery and notification occur after registration, as permitted by the actual notify-map mechanism. The obligation does not assert new-request freshness.\"\n    ],\n    \"grounding_unresolved\": [],\n    \"review_limitations\": []\n  },\n  \"blockers\": [\n    \"Direct oracle correspondence is unreviewed\"\n  ],\n  \"boundaries\": [\n    \"Whether another leader is actually elected.\",\n    \"External stale-read or split-brain consequences.\",\n    \"Membership changes during verification, transport impersonation and restart recovery.\",\n    \"A guarantee that a permitted voter acknowledgment necessarily completes verification.\",\n    \"This check isolates a local eligibility duty. It does not execute the public VerifyLeader return branch, main-loop lease checks, a competing leader election, FSM read, or asynchronous timer consequence.\",\n    \"The heartbeat request may have been sent before registration; response delivery and notification occur after registration, as permitted by the actual notify-map mechanism. The obligation does not assert new-request freshness.\"\n  ],\n  \"review_ids\": [],\n  \"open_issue_ids\": [],\n  \"correspondence\": null,\n  \"reviewed_complete\": false,\n  \"bounded_complete\": true,\n  \"confirmed\": false,\n  \"outcome\": \"violated\",\n  \"level\": \"implementation_test\",\n  \"claim_id\": \"claim-verify-voter-eligibility\",\n  \"claim_version\": 1,\n  \"framework_revision\": \"audit-products-v47\",\n  \"finding_ids\": {\n    \"nonvoter-count-unchanged\": \"ea2b544636f64d5a9deaca7bda2ca3e5\"\n  },\n  \"finding_id\": \"ea2b544636f64d5a9deaca7bda2ca3e5\"\n}\n{\n  \"description\": \"Check the accepted participant-eligibility obligation with three voters and one nonvoter. Bootstrap one voter, run actual follower timeout and candidate election against actual peer RPC handlers, then initialize leader replication and commit a no-op through real stored-log acknowledgments. Hold all subsequent responses. Register a verification and release exactly one nonvoter heartbeat acknowledgment. Read the live tally only after the next heartbeat call proves completion of the preceding native notifyAll. Repeat with one voter as a diagnostic control. The assertion compares the nonvoter post-count to the same request pre-count.\",\n  \"claim_id\": \"claim-verify-voter-eligibility\",\n  \"binding_ids\": [\n    \"bind-verify-registration\",\n    \"bind-verify-notification\",\n    \"bind-verify-tally\"\n  ],\n  \"harness\": {\n    \"execution_package\": \".\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"sync\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\ntype assurancePending struct {\\n\\tid   ServerID\\n\\taddr ServerAddress\\n\\treq  *AppendEntriesRequest\\n\\tresp *AppendEntriesResponse\\n\\tdone chan error\\n}\\n\\nfunc (p *assurancePending) heartbeat() bool {\\n\\treturn p.req.PrevLogEntry == 0 && len(p.req.Entries) == 0 && p.req.LeaderCommitIndex == 0\\n}\\n\\ntype assuranceTransport struct {\\n\\t*InmemTransport\\n\\tpending chan *assurancePending\\n\\tcancel  <-chan struct{}\\n}\\n\\nfunc (a *assuranceTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\\n\\tp := &assurancePending{id: id, addr: addr, req: req, resp: resp, done: make(chan error, 1)}\\n\\tselect {\\n\\tcase a.pending <- p:\\n\\tcase <-a.cancel:\\n\\t\\treturn fmt.Errorf(\\\"driver closed\\\")\\n\\t}\\n\\tselect {\\n\\tcase err := <-p.done:\\n\\t\\treturn err\\n\\tcase <-a.cancel:\\n\\t\\treturn fmt.Errorf(\\\"driver closed\\\")\\n\\t}\\n}\\nfunc (a *assuranceTransport) AppendEntriesPipeline(ServerID, ServerAddress) (AppendPipeline, error) {\\n\\treturn nil, ErrPipelineReplicationNotSupported\\n}\\nfunc assuranceEmit(t *testing.T, event string, fields map[string]interface{}) {\\n\\tfields[\\\"event\\\"] = event\\n\\tdata, err := json.Marshal(fields)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tfmt.Println(\\\"CA_EVENT \\\" + string(data))\\n}\\n\\nfunc TestAssuranceVerifyNonvoterEligibility(t *testing.T) {\\n\\t// Only scheduling is substituted: real elections, storage, replication,\\n\\t// heartbeat response production and verification accounting run unchanged.\\n\\tcancel := make(chan struct{})\\n\\tvar nodes []*Raft\\n\\tvar transports []*InmemTransport\\n\\tvar pump sync.WaitGroup\\n\\tvar leader *Raft\\n\\tdefer func() {\\n\\t\\tclose(cancel)\\n\\t\\tif leader != nil {\\n\\t\\t\\tfor _, s := range leader.leaderState.replState {\\n\\t\\t\\t\\tclose(s.stopCh)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tvar stops []Future\\n\\t\\tfor _, r := range nodes {\\n\\t\\t\\tstops = append(stops, r.Shutdown())\\n\\t\\t}\\n\\t\\tfor _, stop := range stops {\\n\\t\\t\\tif err := stop.Error(); err != nil {\\n\\t\\t\\t\\tt.Log(err)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tpump.Wait()\\n\\t\\tfor _, tr := range transports {\\n\\t\\t\\ttr.Close()\\n\\t\\t}\\n\\t}()\\n\\tconfiguration := Configuration{Servers: []Server{\\n\\t\\t{Suffrage: Voter, ID: \\\"a\\\", Address: \\\"a\\\"}, {Suffrage: Voter, ID: \\\"b\\\", Address: \\\"b\\\"},\\n\\t\\t{Suffrage: Voter, ID: \\\"c\\\", Address: \\\"c\\\"}, {Suffrage: Nonvoter, ID: \\\"n\\\", Address: \\\"n\\\"},\\n\\t}}\\n\\tvar controlled *assuranceTransport\\n\\tfor i, server := range configuration.Servers {\\n\\t\\t_, base := NewInmemTransportWithTimeout(server.Address, time.Second)\\n\\t\\ttransports = append(transports, base)\\n\\t\\tvar tr Transport = base\\n\\t\\tif i == 0 {\\n\\t\\t\\tcontrolled = &assuranceTransport{InmemTransport: base, pending: make(chan *assurancePending, 64), cancel: cancel}\\n\\t\\t\\ttr = controlled\\n\\t\\t}\\n\\t\\tconf := DefaultConfig()\\n\\t\\tconf.LocalID = server.ID\\n\\t\\tconf.skipStartup = true\\n\\t\\tconf.PreVoteDisabled = true\\n\\t\\tconf.HeartbeatTimeout = 20 * time.Millisecond\\n\\t\\tconf.ElectionTimeout = 20 * time.Millisecond\\n\\t\\tconf.LeaderLeaseTimeout = 20 * time.Millisecond\\n\\t\\tconf.CommitTimeout = 5 * time.Millisecond\\n\\t\\tstore := NewInmemStore()\\n\\t\\tsnaps := NewInmemSnapshotStore()\\n\\t\\tif i == 0 {\\n\\t\\t\\tif err := BootstrapCluster(conf, store, store, snaps, tr, configuration); err != nil {\\n\\t\\t\\t\\tt.Fatal(err)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tr, err := NewRaft(conf, &MockFSM{}, store, store, snaps, tr)\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatal(err)\\n\\t\\t}\\n\\t\\tnodes = append(nodes, r)\\n\\t}\\n\\tfor _, a := range transports {\\n\\t\\tfor _, b := range transports {\\n\\t\\t\\tif a != b {\\n\\t\\t\\t\\ta.Connect(b.LocalAddr(), b)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\t// Followers process the actual network RPCs, but their autonomous election\\n\\t// timers are not scheduled during this finite local-accounting experiment.\\n\\tfor _, r := range nodes[1:] {\\n\\t\\tpump.Add(1)\\n\\t\\tgo func(r *Raft) {\\n\\t\\t\\tdefer pump.Done()\\n\\t\\t\\tfor {\\n\\t\\t\\t\\tselect {\\n\\t\\t\\t\\tcase rpc := <-r.rpcCh:\\n\\t\\t\\t\\t\\tr.processRPC(rpc)\\n\\t\\t\\t\\tcase <-cancel:\\n\\t\\t\\t\\t\\treturn\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}(r)\\n\\t}\\n\\tleader = nodes[0]\\n\\tleader.runFollower()\\n\\tif leader.getState() != Candidate {\\n\\t\\tt.Fatal(\\\"candidate transition not reached\\\")\\n\\t}\\n\\tleader.runCandidate()\\n\\tif leader.getState() != Leader {\\n\\t\\tt.Fatal(\\\"real campaign did not elect leader\\\")\\n\\t}\\n\\tleader.setupLeaderState()\\n\\tleader.startStopReplication()\\n\\tnoop := &logFuture{log: Log{Type: LogNoop}}\\n\\tnoop.init()\\n\\tleader.dispatchLogs([]*logFuture{noop})\\n\\tvar held []*assurancePending\\n\\tawait := func(id ServerID, hb bool) *assurancePending {\\n\\t\\tt.Helper()\\n\\t\\ttimer := time.NewTimer(3 * time.Second)\\n\\t\\tdefer timer.Stop()\\n\\t\\tfor {\\n\\t\\t\\tfor i, p := range held {\\n\\t\\t\\t\\tif p.id == id && p.heartbeat() == hb {\\n\\t\\t\\t\\t\\theld = append(held[:i], held[i+1:]...)\\n\\t\\t\\t\\t\\treturn p\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tselect {\\n\\t\\t\\tcase p := <-controlled.pending:\\n\\t\\t\\t\\theld = append(held, p)\\n\\t\\t\\tcase <-timer.C:\\n\\t\\t\\t\\tt.Fatalf(\\\"missing scheduled request peer=%s heartbeat=%v\\\", id, hb)\\n\\t\\t\\t\\treturn nil\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\trelease := func(p *assurancePending) bool {\\n\\t\\tt.Helper()\\n\\t\\terr := controlled.InmemTransport.AppendEntries(p.id, p.addr, p.req, p.resp)\\n\\t\\tsuccess := err == nil && p.resp.Success\\n\\t\\tp.done <- err\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatalf(\\\"actual RPC failed: %v\\\", err)\\n\\t\\t}\\n\\t\\treturn success\\n\\t}\\n\\t// Synchronize every peer through configuration and the elected-term no-op.\\n\\t// Waiting for the next request on the same serial replication path ensures\\n\\t// its previous updateLastAppended/notifyAll has finished before admission.\\n\\tfor _, id := range []ServerID{\\\"b\\\", \\\"c\\\", \\\"n\\\"} {\\n\\t\\tfor {\\n\\t\\t\\tp := await(id, false)\\n\\t\\t\\tif release(p) {\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tp := await(id, false)\\n\\t\\theld = append(held, p)\\n\\t}\\n\\tci := leader.leaderState.commitment.getCommitIndex()\\n\\tif ci != noop.log.Index {\\n\\t\\tt.Fatalf(\\\"no-op commitment missing: %d\\\", ci)\\n\\t}\\n\\t// These calls are the corresponding leaderLoop commit-notification branch;\\n\\t// do not run unrelated main-loop timer cases in this controlled schedule.\\n\\tleader.setCommitIndex(ci)\\n\\tleader.setCommittedConfiguration(leader.configurations.latest, leader.configurations.latestIndex)\\n\\tleader.processLogs(ci, map[uint64]*logFuture{noop.log.Index: noop})\\n\\tfor _, id := range []ServerID{\\\"b\\\", \\\"c\\\", \\\"n\\\"} {\\n\\t\\tfor {\\n\\t\\t\\tp := await(id, false)\\n\\t\\t\\tadvertised := p.req.LeaderCommitIndex\\n\\t\\t\\trelease(p)\\n\\t\\t\\tif advertised == ci {\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tp := await(id, false)\\n\\t\\theld = append(held, p)\\n\\t}\\n\\tif leader.configurations.latestIndex != leader.configurations.committedIndex {\\n\\t\\tt.Fatal(\\\"configuration not stable\\\")\\n\\t}\\n\\tfor _, r := range nodes[1:] {\\n\\t\\tif r.configurations.latestIndex != r.configurations.committedIndex {\\n\\t\\t\\tt.Fatal(\\\"peer configuration not stable\\\")\\n\\t\\t}\\n\\t}\\n\\t// No response remains in post-return notification work: normal replication\\n\\t// requests are all parked at their next send; heartbeats have never replied.\\n\\tfor _, responder := range []ServerID{\\\"n\\\", \\\"b\\\"} {\\n\\t\\tcaseID := \\\"verify-\\\" + string(responder)\\n\\t\\tv := &verifyFuture{}\\n\\t\\tv.init()\\n\\t\\tleader.verifyLeader(v)\\n\\t\\tv.voteLock.Lock()\\n\\t\\tbefore, quorum := v.votes, v.quorumSize\\n\\t\\tv.voteLock.Unlock()\\n\\t\\ts := leader.leaderState.replState[responder]\\n\\t\\tpeer := s.peer\\n\\t\\ts.notifyLock.Lock()\\n\\t\\t_, registered := s.notify[v]\\n\\t\\ts.notifyLock.Unlock()\\n\\t\\tassuranceEmit(t, \\\"verify_admitted\\\", map[string]interface{}{\\\"case_id\\\": caseID, \\\"peer_id\\\": string(peer.ID), \\\"suffrage\\\": peer.Suffrage.String(), \\\"before\\\": before, \\\"quorum\\\": quorum, \\\"registered\\\": registered, \\\"leader\\\": leader.getState() == Leader, \\\"stable\\\": leader.configurations.latestIndex == leader.configurations.committedIndex, \\\"term\\\": leader.getCurrentTerm()})\\n\\t\\tp := await(responder, true)\\n\\t\\tsuccess := release(p)\\n\\t\\tassuranceEmit(t, \\\"verify_acknowledged\\\", map[string]interface{}{\\\"case_id\\\": caseID, \\\"peer_id\\\": string(peer.ID), \\\"response_success\\\": success})\\n\\t\\t// The next heartbeat invocation occurs after native heartbeat() has called\\n\\t\\t// notifyAll for the released response. It is held without a second reply.\\n\\t\\tnext := await(responder, true)\\n\\t\\theld = append(held, next)\\n\\t\\tv.voteLock.Lock()\\n\\t\\tafter := v.votes\\n\\t\\tv.voteLock.Unlock()\\n\\t\\tsignaled := false\\n\\t\\tcorrectIdentity := true\\n\\t\\tselect {\\n\\t\\tcase got := <-leader.verifyCh:\\n\\t\\t\\tsignaled = true\\n\\t\\t\\tcorrectIdentity = got == v\\n\\t\\tdefault:\\n\\t\\t}\\n\\t\\tassuranceEmit(t, \\\"verify_observed\\\", map[string]interface{}{\\\"case_id\\\": caseID, \\\"peer_id\\\": string(peer.ID), \\\"suffrage\\\": peer.Suffrage.String(), \\\"after\\\": after, \\\"delta\\\": after - before, \\\"response_success\\\": success, \\\"callback_finished\\\": true, \\\"completion_signaled\\\": signaled, \\\"completion_identity\\\": correctIdentity, \\\"term\\\": leader.getCurrentTerm()})\\n\\t\\t// Clean the completed test invocation using the production cleanup methods;\\n\\t\\t// no success/failure response or external read is synthesized.\\n\\t\\tdelete(leader.leaderState.notify, v)\\n\\t\\tfor _, rep := range leader.leaderState.replState {\\n\\t\\t\\trep.cleanNotify(v)\\n\\t\\t}\\n\\t}\\n}\\n\",\n    \"description\": \"Controlled scheduling around actual election, AppendEntries, replication acknowledgment, verifyLeader and heartbeat notification methods; in-memory stores and transport. Test terminates after the selected callback and one independent voter control, regardless of whether count changed.\",\n    \"semantic_changes\": [\n      \"NewRaft skipStartup prevents autonomous main/FSM/snapshot loops. Driver calls actual runFollower and runCandidate for the selected leader; follower RPC pumps dispatch actual processRPC calls without running their election timers.\",\n      \"Driver invokes setupLeaderState/startStopReplication/dispatchLogs and the sourced leaderLoop commit effects (setCommitIndex, setCommittedConfiguration, processLogs) after observing actual majority commitment. It directly invokes verifyLeader as the source main-loop branch does.\",\n      \"A Transport wrapper delays AppendEntries at the send/return boundary. Responses are generated by actual follower handlers through InmemTransport; no reply value is invented. Pipeline support is declined using the supported ErrPipelineReplicationNotSupported path.\",\n      \"Main-loop lease/timer scheduling and FSM consumption are not exercised during the measured step. No external VerifyLeader future success, stale read, competing leader, or full public-API history is inferred.\",\n      \"Private fields are read under their existing locks where concurrent mutation exists. The driver closes replication stop channels, releases blocked transport calls with cancellation, and waits on Shutdown futures.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"verify_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"leader\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"stable\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"before\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          },\n          {\n            \"field\": \"quorum\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"ack\",\n        \"event\": \"verify_acknowledged\",\n        \"conditions\": [\n          {\n            \"field\": \"case_id\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"admitted.case_id\"\n          },\n          {\n            \"field\": \"response_success\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"src-startup\",\n        \"src-bootstrap-entry\",\n        \"src-election-producer\",\n        \"src-campaign\",\n        \"src-follower-loop\",\n        \"src-leader-lifetime\",\n        \"src-replication-lifetime\",\n        \"src-replication-loop\",\n        \"src-replication-heartbeat\",\n        \"src-leader-commit\",\n        \"src-verify-start\",\n        \"src-verify-notify\",\n        \"src-verify-vote\",\n        \"src-append-consumer\",\n        \"src-inmem-transport\",\n        \"src-shutdown\"\n      ],\n      \"expectation_ids\": [\n        \"src-verify-doc\",\n        \"src-verify-contract\",\n        \"src-config-types\"\n      ],\n      \"binding_ids\": [\n        \"bind-verify-registration\",\n        \"bind-verify-notification\",\n        \"bind-verify-tally\"\n      ],\n      \"derivation\": \"BootstrapCluster runs once on clean selected-voter storage with one mixed configuration. Actual election responses establish the selected leader; actual replication and commitment establish the no-op and configuration prefix. Subsequent normal replication requests are held at their next invocation, proving previous callbacks have finished, and no heartbeat reply is released before verification registration. Only the selected peer response is then released; its identity is the independently configured peer ID, not inferred from response success. A next heartbeat from that same serial heartbeat routine occurs after its prior notifyAll completed. Manual main-loop scheduling preserves the local claim conditions and explicitly omits lease timing and endpoint inference. The voter control does not add a sufficient-success obligation.\",\n      \"applicability\": \"Stable three-voter/one-nonvoter configuration; finite local accounting step without concurrent configuration or term change.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-nonvoter-support\",\n      \"checker_id\": \"nonvoter-count-unchanged\",\n      \"event\": \"verify_observed\",\n      \"binding_ids\": [\n        \"bind-verify-registration\",\n        \"bind-verify-notification\",\n        \"bind-verify-tally\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"src-startup\",\n          \"src-bootstrap-entry\",\n          \"src-election-producer\",\n          \"src-campaign\",\n          \"src-follower-loop\",\n          \"src-leader-lifetime\",\n          \"src-replication-lifetime\",\n          \"src-replication-loop\",\n          \"src-replication-heartbeat\",\n          \"src-leader-commit\",\n          \"src-verify-start\",\n          \"src-verify-notify\",\n          \"src-verify-vote\",\n          \"src-append-consumer\",\n          \"src-inmem-transport\",\n          \"src-shutdown\"\n        ],\n        \"expectation_ids\": [\n          \"src-verify-doc\",\n          \"src-verify-contract\",\n          \"src-config-types\"\n        ],\n        \"binding_ids\": [\n          \"bind-verify-registration\",\n          \"bind-verify-notification\",\n          \"bind-verify-tally\"\n        ],\n        \"derivation\": \"The result reads the live verifyFuture count after actual heartbeat response notification has finished. The oracle is the accepted exclusion of nonvoters from the voter quorum; comparison against admitted.before checks no increment. registered and completion_signaled are diagnostics, not prerequisites or filters. The observed voter control is outside this property.\",\n        \"applicability\": \"Correlated case_id and peer_id join the admitted operation, actual acknowledgment and resulting count; suffrage is read from the configured replication peer.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"suffrage\",\n          \"op\": \"eq\",\n          \"value\": \"Nonvoter\",\n          \"reference\": null\n        },\n        {\n          \"field\": \"callback_finished\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        }\n      ],\n      \"admission_alias\": \"admitted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"nonvoter-count-unchanged\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"verify_observed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"after\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admitted.before\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"case_id\",\n        \"peer_id\"\n      ],\n      \"description\": \"An actual nonvoter acknowledgment does not increase the verification support tally over the same request initial count.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"This check isolates a local eligibility duty. It does not execute the public VerifyLeader return branch, main-loop lease checks, a competing leader election, FSM read, or asynchronous timer consequence.\",\n    \"The heartbeat request may have been sent before registration; response delivery and notification occur after registration, as permitted by the actual notify-map mechanism. The obligation does not assert new-request freshness.\"\n  ]\n}","exit_code":0,"status":"completed"}}
