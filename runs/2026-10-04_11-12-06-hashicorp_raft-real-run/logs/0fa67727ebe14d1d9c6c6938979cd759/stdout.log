":\"TestAssuranceVerifyNonvoterEligibility\",\"Output\":\"2026-10-04T11:32:34.562+0800 [ERROR] raft: failed to appendEntries to: peer=\\\"{Voter c c}\\\" error=\\\"driver closed\\\"\\n\"}\n{\"Time\":\"2026-10-04T11:32:34.562405601+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterEligibility\",\"Output\":\"2026-10-04T11:32:34.562+0800 [ERROR] raft: failed to appendEntries to: peer=\\\"{Voter b b}\\\" error=\\\"driver closed\\\"\\n\"}\n{\"Time\":\"2026-10-04T11:32:34.562453495+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterEligibility\",\"Output\":\"--- PASS: TestAssuranceVerifyNonvoterEligibility (0.11s)\\n\"}\n{\"Time\":\"2026-10-04T11:32:34.562486149+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Test\":\"TestAssuranceVerifyNonvoterEligibility\",\"Elapsed\":0.11}\n{\"Time\":\"2026-10-04T11:32:34.563163066+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"PASS\\n\"}\n{\"Time\":\"2026-10-04T11:32:34.565987008+08:00\",\"Action\":\"output\",\"Package\":\"github.com/hashicorp/raft\",\"Output\":\"ok  \\tgithub.com/hashicorp/raft\\t0.132s\\n\"}\n{\"Time\":\"2026-10-04T11:32:34.566064335+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/hashicorp/raft\",\"Elapsed\":0.133}\npackage raft\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\ntype assurancePending struct {\n\tid   ServerID\n\taddr ServerAddress\n\treq  *AppendEntriesRequest\n\tresp *AppendEntriesResponse\n\tdone chan error\n}\n\nfunc (p *assurancePending) heartbeat() bool {\n\treturn p.req.PrevLogEntry == 0 && len(p.req.Entries) == 0 && p.req.LeaderCommitIndex == 0\n}\n\ntype assuranceTransport struct {\n\t*InmemTransport\n\tpending chan *assurancePending\n\tcancel  <-chan struct{}\n}\n\nfunc (a *assuranceTransport) AppendEntries(id ServerID, addr ServerAddress, req *AppendEntriesRequest, resp *AppendEntriesResponse) error {\n\tp := &assurancePending{id: id, addr: addr, req: req, resp: resp, done: make(chan error, 1)}\n\tselect {\n\tcase a.pending <- p:\n\tcase <-a.cancel:\n\t\treturn fmt.Errorf(\"driver closed\")\n\t}\n\tselect {\n\tcase err := <-p.done:\n\t\treturn err\n\tcase <-a.cancel:\n\t\treturn fmt.Errorf(\"driver closed\")\n\t}\n}\nfunc (a *assuranceTransport) AppendEntriesPipeline(ServerID, ServerAddress) (AppendPipeline, error) {\n\treturn nil, ErrPipelineReplicationNotSupported\n}\nfunc assuranceEmit(t *testing.T, event string, fields map[string]interface{}) {\n\tfields[\"event\"] = event\n\tdata, err := json.Marshal(fields)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfmt.Println(\"CA_EVENT \" + string(data))\n}\n\nfunc TestAssuranceVerifyNonvoterEligibility(t *testing.T) {\n\t// Only scheduling is substituted: real elections, storage, replication,\n\t// heartbeat response production and verification accounting run unchanged.\n\tcancel := make(chan struct{})\n\tvar nodes []*Raft\n\tvar transports []*InmemTransport\n\tvar pump sync.WaitGroup\n\tvar leader *Raft\n\tdefer func() {\n\t\tclose(cancel)\n\t\tif leader != nil {\n\t\t\tfor _, s := range leader.leaderState.replState {\n\t\t\t\tclose(s.stopCh)\n\t\t\t}\n\t\t}\n\t\tvar stops []Future\n\t\tfor _, r := range nodes {\n\t\t\tstops = append(stops, r.Shutdown())\n\t\t}\n\t\tfor _, stop := range stops {\n\t\t\tif err := stop.Error(); err != nil {\n\t\t\t\tt.Log(err)\n\t\t\t}\n\t\t}\n\t\tpump.Wait()\n\t\tfor _, tr := range transports {\n\t\t\ttr.Close()\n\t\t}\n\t}()\n\tconfiguration := Configuration{Servers: []Server{\n\t\t{Suffrage: Voter, ID: \"a\", Address: \"a\"}, {Suffrage: Voter, ID: \"b\", Address: \"b\"},\n\t\t{Suffrage: Voter, ID: \"c\", Address: \"c\"}, {Suffrage: Nonvoter, ID: \"n\", Address: \"n\"},\n\t}}\n\tvar controlled *assuranceTransport\n\tfor i, server := range configuration.Servers {\n\t\t_, base := NewInmemTransportWithTimeout(server.Address, time.Second)\n\t\ttransports = append(transports, base)\n\t\tvar tr Transport = base\n\t\tif i == 0 {\n\t\t\tcontrolled = &assuranceTransport{InmemTransport: base, pending: make(chan *assurancePending, 64), cancel: cancel}\n\t\t\ttr = controlled\n\t\t}\n\t\tconf := DefaultConfig()\n\t\tconf.LocalID = server.ID\n\t\tconf.skipStartup = true\n\t\tconf.PreVoteDisabled = true\n\t\tconf.HeartbeatTimeout = 20 * time.Millisecond\n\t\tconf.ElectionTimeout = 20 * time.Millisecond\n\t\tconf.LeaderLeaseTimeout = 20 * time.Millisecond\n\t\tconf.CommitTimeout = 5 * time.Millisecond\n\t\tstore := NewInmemStore()\n\t\tsnaps := NewInmemSnapshotStore()\n\t\tif i == 0 {\n\t\t\tif err := BootstrapCluster(conf, store, store, snaps, tr, configuration); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t}\n\t\tr, err := NewRaft(conf, &MockFSM{}, store, store, snaps, tr)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tnodes = append(nodes, r)\n\t}\n\tfor _, a := range transports {\n\t\tfor _, b := range transports {\n\t\t\tif a != b {\n\t\t\t\ta.Connect(b.LocalAddr(), b)\n\t\t\t}\n\t\t}\n\t}\n\t// Followers process the actual network RPCs, but their autonomous election\n\t// timers are not scheduled during this finite local-accounting experiment.\n\tfor _, r := range nodes[1:] {\n\t\tpump.Add(1)\n\t\tgo func(r *Raft) {\n\t\t\tdefer pump.Done()\n\t\t\tfor {\n\t\t\t\tselect {\n\t\t\t\tcase rpc := <-r.rpcCh:\n\t\t\t\t\tr.processRPC(rpc)\n\t\t\t\tcase <-cancel:\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t}\n\t\t}(r)\n\t}\n\tleader = nodes[0]\n\tleader.runFollower()\n\tif leader.getState() != Candidate {\n\t\tt.Fatal(\"candidate transition not reached\")\n\t}\n\tleader.runCandidate()\n\tif leader.getState() != Leader {\n\t\tt.Fatal(\"real campaign did not elect leader\")\n\t}\n\tleader.setupLeaderState()\n\tleader.startStopReplication()\n\tnoop := &logFuture{log: Log{Type: LogNoop}}\n\tnoop.init()\n\tleader.dispatchLogs([]*logFuture{noop})\n\tvar held []*assurancePending\n\tawait := func(id ServerID, hb bool) *assurancePending {\n\t\tt.Helper()\n\t\ttimer := time.NewTimer(3 * time.Second)\n\t\tdefer timer.Stop()\n\t\tfor {\n\t\t\tfor i, p := range held {\n\t\t\t\tif p.id == id && p.heartbeat() == hb {\n\t\t\t\t\theld = append(held[:i], held[i+1:]...)\n\t\t\t\t\treturn p\n\t\t\t\t}\n\t\t\t}\n\t\t\tselect {\n\t\t\tcase p := <-controlled.pending:\n\t\t\t\theld = append(held, p)\n\t\t\tcase <-timer.C:\n\t\t\t\tt.Fatalf(\"missing scheduled request peer=%s heartbeat=%v\", id, hb)\n\t\t\t\treturn nil\n\t\t\t}\n\t\t}\n\t}\n\trelease := func(p *assurancePending) bool {\n\t\tt.Helper()\n\t\terr := controlled.InmemTransport.AppendEntries(p.id, p.addr, p.req, p.resp)\n\t\tsuccess := err == nil && p.resp.Success\n\t\tp.done <- err\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"actual RPC failed: %v\", err)\n\t\t}\n\t\treturn success\n\t}\n\t// Synchronize every peer through configuration and the elected-term no-op.\n\t// Waiting for the next request on the same serial replication path ensures\n\t// its previous updateLastAppended/notifyAll has finished before admission.\n\tfor _, id := range []ServerID{\"b\", \"c\", \"n\"} {\n\t\tfor {\n\t\t\tp := await(id, false)\n\t\t\tif release(p) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tp := await(id, false)\n\t\theld = append(held, p)\n\t}\n\tci := leader.leaderState.commitment.getCommitIndex()\n\tif ci != noop.log.Index {\n\t\tt.Fatalf(\"no-op commitment missing: %d\", ci)\n\t}\n\t// These calls are the corresponding leaderLoop commit-notification branch;\n\t// do not run unrelated main-loop timer cases in this controlled schedule.\n\tleader.setCommitIndex(ci)\n\tleader.setCommittedConfiguration(leader.configurations.latest, leader.configurations.latestIndex)\n\tleader.processLogs(ci, map[uint64]*logFuture{noop.log.Index: noop})\n\tfor _, id := range []ServerID{\"b\", \"c\", \"n\"} {\n\t\tfor {\n\t\t\tp := await(id, false)\n\t\t\tadvertised := p.req.LeaderCommitIndex\n\t\t\trelease(p)\n\t\t\tif advertised == ci {\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tp := await(id, false)\n\t\theld = append(held, p)\n\t}\n\tif leader.configurations.latestIndex != leader.configurations.committedIndex {\n\t\tt.Fatal(\"configuration not stable\")\n\t}\n\tfor _, r := range nodes[1:] {\n\t\tif r.configurations.latestIndex != r.configurations.committedIndex {\n\t\t\tt.Fatal(\"peer configuration not stable\")\n\t\t}\n\t}\n\t// No response remains in post-return notification work: normal replication\n\t// requests are all parked at their next send; heartbeats have never replied.\n\tfor _, responder := range []ServerID{\"n\", \"b\"} {\n\t\tcaseID := \"verify-\" + string(responder)\n\t\tv := &verifyFuture{}\n\t\tv.init()\n\t\tleader.verifyLeader(v)\n\t\tv.voteLock.Lock()\n\t\tbefore, quorum := v.votes, v.quorumSize\n\t\tv.voteLock.Unlock()\n\t\ts := leader.leaderState.replState[responder]\n\t\tpeer := s.peer\n\t\ts.notifyLock.Lock()\n\t\t_, registered := s.notify[v]\n\t\ts.notifyLock.Unlock()\n\t\tassuranceEmit(t, \"verify_admitted\", map[string]interface{}{\"case_id\": caseID, \"peer_id\": string(peer.ID), \"suffrage\": peer.Suffrage.String(), \"before\": before, \"quorum\": quorum, \"registered\": registered, \"leader\": leader.getState() == Leader, \"stable\": leader.configurations.latestIndex == leader.configurations.committedIndex, \"term\": leader.getCurrentTerm()})\n\t\tp := await(responder, true)\n\t\tsuccess := release(p)\n\t\tassuranceEmit(t, \"verify_acknowledged\", map[string]interface{}{\"case_id\": caseID, \"peer_id\": string(peer.ID), \"response_success\": success})\n\t\t// The next heartbeat invocation occurs after native heartbeat() has called\n\t\t// notifyAll for the released response. It is held without a second reply.\n\t\tnext := await(responder, true)\n\t\theld = append(held, next)\n\t\tv.voteLock.Lock()\n\t\tafter := v.votes\n\t\tv.voteLock.Unlock()\n\t\tsignaled := false\n\t\tcorrectIdentity := true\n\t\tselect {\n\t\tcase got := <-leader.verifyCh:\n\t\t\tsignaled = true\n\t\t\tcorrectIdentity = got == v\n\t\tdefault:\n\t\t}\n\t\tassuranceEmit(t, \"verify_observed\", map[string]interface{}{\"case_id\": caseID, \"peer_id\": string(peer.ID), \"suffrage\": peer.Suffrage.String(), \"after\": after, \"delta\": after - before, \"response_success\": success, \"callback_finished\": true, \"completion_signaled\": signaled, \"completion_identity\": correctIdentity, \"term\": leader.getCurrentTerm()})\n\t\t// Clean the completed test invocation using the production cleanup methods;\n\t\t// no success/failure response or external read is synthesized.\n\t\tdelete(leader.leaderState.notify, v)\n\t\tfor _, rep := range leader.leaderState.replState {\n\t\t\trep.cleanNotify(v)\n\t\t}\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The trusted run observed the nonvoter reply increase the tally from 1 to 2, reaching the voter quorum threshold and signaling the same verification request. The separate voter control also increased its tally from 1 to 2. The runner found no parse gaps or target-file changes. This supports the local counting defect; the check did not observe a public `VerifyLeader` return or a stale read.\n"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nr=json.load(open('../research.json'));a=r['artifacts'][0];cid=r['candidates'][0]['id'];check=r['assessments'][0]['experiment_check_id']\nsrc=['src-verify-doc','src-verify-contract','src-config-types','src-verify-start','src-verify-notify','src-verify-vote','src-verify-result','src-lease','src-startup','src-bootstrap-entry','src-follower-loop','src-campaign','src-election-producer','src-leader-lifetime','src-leader-commit','src-replication-lifetime','src-replication-loop','src-replication-heartbeat','src-replication-completion','src-append-consumer','src-inmem-transport','src-shutdown']\nrationale='Reviewed the fixed artifact version 1, claim version 1, source-bound methods, actual runner log '+check+' and parsed assessment. Applicability: the documentation specifies voter heartbeats for leadership confirmation, the API identifies prevention of stale reads as a purpose, and quorumSize computes a voter-only majority. This grounds exclusion of Nonvoter contributions from that tally, independently of proving an external stale read. Inputs/history: one clean voter is bootstrapped with IDs a,b,c as voters and n as Nonvoter; the actual follower timeout and runCandidate execute a term-2 election (raw log records majority=2 and election success). Actual AppendEntries RPCs synchronize the configuration/no-op, commitment is obtained from real voter matches, and the driver performs the corresponding leaderLoop commit setters/processLogs. It does not fabricate a successful vote, append response or counted value. The driver omits autonomous main-loop timers and FSM execution and directly schedules the verification branch, which is admissible for this local accounting responsibility under a stable active leader; it does not establish timed/public API behavior. Producer/consumer continuity: all normal replication callbacks complete before admission, established by holding their next serial request; heartbeat callbacks have not yet received replies. Only the selected peer heartbeat is released through the real InmemTransport and follower processRPC/appendEntries. Waiting for that same peer next heartbeat proves prior native notifyAll has completed, rather than merely sleeping for a deadline. At the measured step no voter response is released and no prior voter notify callback remains. Identity/correlation: case_id verify-n and peer_id n match admission, acknowledgment and result; suffrage comes from the source-created replication peer, independent of its Boolean success. Admission explicitly selects admitted, with leader=true, stable=true, before=1 and quorum=2. ack refers to that admission and observes response_success=true. The result reads live verifyFuture.votes under its lock; after=2 violates after==admitted.before. registered and completion_signaled are diagnostics, not outcome-dependent admission filters. The six parsed events have no ambiguity or parse errors; the voter control verify-b is independently identified and outside the nonvoter property. Actual observations: verify-n before=1, after=2, delta=1, term=2, completion_signaled=true and completion_identity=true; verify-b likewise reports delta=1. The completion signal supports the accounting consequence, not an executed public future return. Counterevidence: checkLeaderLease counts voters and could independently demote a stale leader, but it does not make n eligible in the separately executed verification count. Correct recognition by n likewise cannot substitute for a voter. Cleanup driver-closed RPC errors occur after both measured results and are intentional cancellation, not failed prerequisites. The runner completed with exit 0 and no changed target files; those facts establish execution integrity, not the oracle itself. No correspondence issue was found for the narrow accepted eligibility claim.'\nlimits=['The public VerifyLeader enqueue/return branch, FSM read, competing leader and stale-read consequence were not executed.','Main-loop lease/election timer scheduling is controlled/omitted during the accounting step; this is not a timed availability or end-to-end safety claim.','The heartbeat invocation can precede verification registration; its real response and notification follow registration. The claim does not require newly issued heartbeats.','One stable mixed-suffrage configuration and one nonvoter contribution were measured; membership transitions and backend crash behavior remain outside this result.']\np=dict(action='review',artifact_id=a['id'],rationale='Review the fixed measured comparison as a local voter-eligibility defect, preserving all scheduling and endpoint limits.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=src,rationale=rationale,counterevidence=[],limitations=limits,report_title='非投票节点回复计入领导权验证票数',report_answer='在固定的三个投票节点和一个非投票节点配置中，实际非投票节点心跳回复使验证票数从 1 增至 2，并触发同一请求的完成通知。该结果验证局部资格计数缺陷；未验证公共 API 返回、陈旧读取或并发领导者后果。')],feedback=dict(ref_ids=[cid,'b-verify','f-verify-support',a['id'],check],answered='The fixed execution demonstrates that a configured nonvoter positive heartbeat acknowledgment contributes one to the active verification tally and reaches the voter-majority threshold: 1 -> 2 with quorum 2. Pending voter callbacks were excluded by serial next-request barriers, and the response was produced by the actual configured nonvoter handler. The separately correlated voter control contributes one as expected. Correspondence review finds no issue for the accepted local eligibility requirement.',remaining=['Independent stale-read/public-API consequences under autonomous lease/election timing remain unmeasured.','Other retained source questions, including follower prefix bounds, storage-failure vote persistence and heartbeat context overlap, remain open.'],understanding='updated',rationale='The completed observed comparison answers the local accounting premise without treating tests_passed as an oracle or expanding the conclusion to global leadership safety.',question_updates={cid:dict(unknowns=[],resume_conditions=[])}))\njson.dump(p,open('submission.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-04_11-12-06-hashicorp_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
