 \"insufficient_basis\",\n            \"tool_gap\",\n            \"resource_limit\",\n            \"user_stop\",\n            \"no_actionable_direction\"\n          ],\n          \"title\": \"Reason\",\n          \"type\": \"string\"\n        },\n        \"ref_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Ref Ids\",\n          \"type\": \"array\"\n        },\n        \"resume_conditions\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Resume Conditions\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"action\",\n        \"scope\",\n        \"reason\"\n      ],\n      \"title\": \"StopSubmission\",\n      \"type\": \"object\"\n    },\n    \"UnderstandingChange\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"preserves\": {\n          \"default\": \"\",\n          \"description\": \"Why the affected saved interpretations still apply\",\n          \"title\": \"Preserves\",\n          \"type\": \"string\"\n        },\n        \"challenges\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Candidate IDs and the specific interpretation challenged\",\n          \"title\": \"Challenges\",\n          \"type\": \"object\"\n        }\n      },\n      \"required\": [\n        \"rationale\",\n        \"source_ids\"\n      ],\n      \"title\": \"UnderstandingChange\",\n      \"type\": \"object\"\n    },\n    \"UnitDraft\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"candidate_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Candidate Id\"\n        },\n        \"audit_question\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/AuditQuestion\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"obligation_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"maxItems\": 1,\n          \"minItems\": 1,\n          \"title\": \"Obligation Ids\",\n          \"type\": \"array\"\n        },\n        \"binding_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Binding Ids\",\n          \"type\": \"array\"\n        },\n        \"relation_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Relation Ids\",\n          \"type\": \"array\"\n        },\n        \"scope\": {\n          \"$ref\": \"#/$defs/Scope\"\n        },\n        \"rationale\": {\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"id\",\n        \"obligation_ids\",\n        \"binding_ids\",\n        \"scope\",\n        \"rationale\"\n      ],\n      \"title\": \"UnitDraft\",\n      \"type\": \"object\"\n    }\n  },\n  \"discriminator\": {\n    \"mapping\": {\n      \"check\": \"#/$defs/CheckSubmission\",\n      \"continue\": \"#/$defs/CandidateSubmission\",\n      \"explained\": \"#/$defs/CandidateSubmission\",\n      \"explore\": \"#/$defs/ExploreSubmission\