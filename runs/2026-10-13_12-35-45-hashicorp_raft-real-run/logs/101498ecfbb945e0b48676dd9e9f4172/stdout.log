{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_12-35-45-hashicorp_raft-real-run/agent-source; cat -n commitment.go stable.go progress.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"sort\"\n     8\t\t\"sync\"\n     9\t)\n    10\t\n    11\t// Commitment is used to advance the leader's commit index. The leader and\n    12\t// replication goroutines report in newly written entries with match(), and\n    13\t// this notifies on commitCh when the commit index has advanced.\n    14\ttype commitment struct {\n    15\t\t// protects matchIndexes and commitIndex\n    16\t\tsync.Mutex\n    17\t\t// notified when commitIndex increases\n    18\t\tcommitCh chan struct{}\n    19\t\t// voter ID to log index: the server stores up through this log entry\n    20\t\tmatchIndexes map[ServerID]uint64\n    21\t\t// a quorum stores up through this log entry. monotonically increases.\n    22\t\tcommitIndex uint64\n    23\t\t// the first index of this leader's term: this needs to be replicated to a\n    24\t\t// majority of the cluster before this leader may mark anything committed\n    25\t\t// (per Raft's commitment rule)\n    26\t\tstartIndex uint64\n    27\t}\n    28\t\n    29\t// newCommitment returns a commitment struct that notifies the provided\n    30\t// channel when log entries have been committed. A new commitment struct is\n    31\t// created each time this server becomes leader for a particular term.\n    32\t// 'configuration' is the servers in the cluster.\n    33\t// 'startIndex' is the first index created in this term (see\n    34\t// its description above).\n    35\tfunc newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n    36\t\tmatchIndexes := make(map[ServerID]uint64)\n    37\t\tfor _, server := range configuration.Servers {\n    38\t\t\tif server.Suffrage == Voter {\n    39\t\t\t\tmatchIndexes[server.ID] = 0\n    40\t\t\t}\n    41\t\t}\n    42\t\treturn &commitment{\n    43\t\t\tcommitCh:     commitCh,\n    44\t\t\tmatchIndexes: matchIndexes,\n    45\t\t\tcommitIndex:  0,\n    46\t\t\tstartIndex:   startIndex,\n    47\t\t}\n    48\t}\n    49\t\n    50\t// Called when a new cluster membership configuration is created: it will be\n    51\t// used to determine commitment from now on. 'configuration' is the servers in\n    52\t// the cluster.\n    53\tfunc (c *commitment) setConfiguration(configuration Configuration) {\n    54\t\tc.Lock()\n    55\t\tdefer c.Unlock()\n    56\t\toldMatchIndexes := c.matchIndexes\n    57\t\tc.matchIndexes = make(map[ServerID]uint64)\n    58\t\tfor _, server := range configuration.Servers {\n    59\t\t\tif server.Suffrage == Voter {\n    60\t\t\t\tc.matchIndexes[server.ID] = oldMatchIndexes[server.ID] // defaults to 0\n    61\t\t\t}\n    62\t\t}\n    63\t\tc.recalculate()\n    64\t}\n    65\t\n    66\t// Called by leader after commitCh is notified\n    67\tfunc (c *commitment) getCommitIndex() uint64 {\n    68\t\tc.Lock()\n    69\t\tdefer c.Unlock()\n    70\t\treturn c.commitIndex\n    71\t}\n    72\t\n    73\t// Match is called once a server completes writing entries to disk: either the\n    74\t// leader has written the new entry or a follower has replied to an\n    75\t// AppendEntries RPC. The given server's disk agrees with this server's log up\n    76\t// through the given index.\n    77\tfunc (c *commitment) match(server ServerID, matchIndex uint64) {\n    78\t\tc.Lock()\n    79\t\tdefer c.Unlock()\n    80\t\tif prev, hasVote := c.matchIndexes[server]; hasVote && matchIndex > prev {\n    81\t\t\tc.matchIndexes[server] = matchIndex\n    82\t\t\tc.recalculate()\n    83\t\t}\n    84\t}\n    85\t\n    86\t// Internal helper to calculate new commitIndex from matchIndexes.\n    87\t// Must be called with lock held.\n    88\tfunc (c *commitment) recalculate() {\n    89\t\tif len(c.matchIndexes) == 0 {\n    90\t\t\treturn\n    91\t\t}\n    92\t\n    93\t\tmatched := make([]uint64, 0, len(c.matchIndexes))\n    94\t\tfor _, idx := range c.matchIndexes {\n    95\t\t\tmatched = append(matched, idx)\n    96\t\t}\n    97\t\tsort.Sort(uint64Slice(matched))\n    98\t\tquorumMatchIndex := matched[(len(matched)-1)/2]\n    99\t\n   100\t\tif quorumMatchIndex > c.commitIndex && quorumMatchIndex >= c.startIndex {\n   101\t\t\tc.commitIndex = quorumMatchIndex\n   102\t\t\tasyncNotifyCh(c.commitCh)\n   103\t\t}\n   104\t}\n   105\t// Copyright (c) HashiCorp, Inc.\n   106\t// SPDX-License-Identifier: MPL-2.0\n   107\t\n   108\tpackage raft\n   109\t\n   110\t// StableStore is used to provide stable storage\n   111\t// of key configurations to ensure safety.\n   112\ttype StableStore interface {\n   113\t\tSet(key []byte, val []byte) error\n   114\t\n   115\t\t// Get returns the value for key, or an empty byte slice if key was not found.\n   116\t\tGet(key []byte) ([]byte, error)\n   117\t\n   118\t\tSetUint64(key []byte, val uint64) error\n   119\t\n   120\t\t// GetUint64 returns the uint64 value for key, or 0 if key was not found.\n   121\t\tGetUint64(key []byte) (uint64, error)\n   122\t}\n   123\t// Copyright (c) HashiCorp, Inc.\n   124\t// SPDX-License-Identifier: MPL-2.0\n   125\t\n   126\tpackage raft\n   127\t\n   128\timport (\n   129\t\t\"context\"\n   130\t\t\"io\"\n   131\t\t\"sync\"\n   132\t\t\"time\"\n   133\t\n   134\t\thclog \"github.com/hashicorp/go-hclog\"\n   135\t)\n   136\t\n   137\tconst (\n   138\t\tsnapshotRestoreMonitorInterval = 10 * time.Second\n   139\t)\n   140\t\n   141\ttype snapshotRestoreMonitor struct {\n   142\t\tlogger          hclog.Logger\n   143\t\tcr              CountingReader\n   144\t\tsize            int64\n   145\t\tnetworkTransfer bool\n   146\t\n   147\t\tonce   sync.Once\n   148\t\tcancel func()\n   149\t\tdoneCh chan struct{}\n   150\t}\n   151\t\n   152\tfunc startSnapshotRestoreMonitor(\n   153\t\tlogger hclog.Logger,\n   154\t\tcr CountingReader,\n   155\t\tsize int64,\n   156\t\tnetworkTransfer bool,\n   157\t) *snapshotRestoreMonitor {\n   158\t\tctx, cancel := context.WithCancel(context.Background())\n   159\t\n   160\t\tm := &snapshotRestoreMonitor{\n   161\t\t\tlogger:          logger,\n   162\t\t\tcr:              cr,\n   163\t\t\tsize:            size,\n   164\t\t\tnetworkTransfer: networkTransfer,\n   165\t\t\tcancel:          cancel,\n   166\t\t\tdoneCh:          make(chan struct{}),\n   167\t\t}\n   168\t\tgo m.run(ctx)\n   169\t\treturn m\n   170\t}\n   171\t\n   172\tfunc (m *snapshotRestoreMonitor) run(ctx context.Context) {\n   173\t\tdefer close(m.doneCh)\n   174\t\n   175\t\tticker := time.NewTicker(snapshotRestoreMonitorInterval)\n   176\t\tdefer ticker.Stop()\n   177\t\n   178\t\tranOnce := false\n   179\t\tfor {\n   180\t\t\tselect {\n   181\t\t\tcase <-ctx.Done():\n   182\t\t\t\tif !ranOnce {\n   183\t\t\t\t\tm.runOnce()\n   184\t\t\t\t}\n   185\t\t\t\treturn\n   186\t\t\tcase <-ticker.C:\n   187\t\t\t\tm.runOnce()\n   188\t\t\t\tranOnce = true\n   189\t\t\t}\n   190\t\t}\n   191\t}\n   192\t\n   193\tfunc (m *snapshotRestoreMonitor) runOnce() {\n   194\t\treadBytes := m.cr.Count()\n   195\t\tpct := float64(100*readBytes) / float64(m.size)\n   196\t\n   197\t\tmessage := \"snapshot restore progress\"\n   198\t\tif m.networkTransfer {\n   199\t\t\tmessage = \"snapshot network transfer progress\"\n   200\t\t}\n   201\t\n   202\t\tm.logger.Info(message,\n   203\t\t\t\"read-bytes\", readBytes,\n   204\t\t\t\"percent-complete\", hclog.Fmt(\"%0.2f%%\", pct),\n   205\t\t)\n   206\t}\n   207\t\n   208\tfunc (m *snapshotRestoreMonitor) StopAndWait() {\n   209\t\tm.once.Do(func() {\n   210\t\t\tm.cancel()\n   211\t\t\t<-m.doneCh\n   212\t\t})\n   213\t}\n   214\t\n   215\ttype CountingReader interface {\n   216\t\tio.Reader\n   217\t\tCount() int64\n   218\t}\n   219\t\n   220\ttype countingReader struct {\n   221\t\treader io.Reader\n   222\t\n   223\t\tmu    sync.Mutex\n   224\t\tbytes int64\n   225\t}\n   226\t\n   227\tfunc (r *countingReader) Read(p []byte) (n int, err error) {\n   228\t\tn, err = r.reader.Read(p)\n   229\t\tr.mu.Lock()\n   230\t\tr.bytes += int64(n)\n   231\t\tr.mu.Unlock()\n   232\t\treturn n, err\n   233\t}\n   234\t\n   235\tfunc (r *countingReader) Count() int64 {\n   236\t\tr.mu.Lock()\n   237\t\tdefer r.mu.Unlock()\n   238\t\treturn r.bytes\n   239\t}\n   240\t\n   241\tfunc newCountingReader(r io.Reader) *countingReader {\n   242\t\treturn &countingReader{reader: r}\n   243\t}\n   244\t\n   245\ttype countingReadCloser struct {\n   246\t\t*countingReader\n   247\t\treadCloser io.ReadCloser\n   248\t}\n   249\t\n   250\tfunc newCountingReadCloser(rc io.ReadCloser) *countingReadCloser {\n   251\t\treturn &countingReadCloser{\n   252\t\t\tcountingReader: newCountingReader(rc),\n   253\t\t\treadCloser:     rc,\n   254\t\t}\n   255\t}\n   256\t\n   257\tfunc (c countingReadCloser) Close() error {\n   258\t\treturn c.readCloser.Close()\n   259\t}\n   260\t\n   261\tfunc (c countingReadCloser) WrappedReadCloser() io.ReadCloser {\n   262\t\treturn c.readCloser\n   263\t}\n   264\t\n   265\t// ReadCloserWrapper allows access to an underlying ReadCloser from a wrapper.\n   266\ttype ReadCloserWrapper interface {\n   267\t\tio.ReadCloser\n   268\t\tWrappedReadCloser() io.ReadCloser\n   269\t}\n   270\t\n   271\tvar _ ReadCloserWrapper = &countingReadCloser{}\n","exit_code":0,"status":"completed"}}
