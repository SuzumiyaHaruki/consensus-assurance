{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_12-35-45-hashicorp_raft-real-run/agent-source; cat -n configuration.go | sed -n '1,200p'\"","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\ttype nopConfigurationStore struct{}\n    55\t\n    56\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n    57\t\n    58\t// ServerID is a unique string identifying a server for all time.\n    59\ttype ServerID string\n    60\t\n    61\t// ServerAddress is a network address for a server that a transport can contact.\n    62\ttype ServerAddress string\n    63\t\n    64\t// Server tracks the information about a single server in a configuration.\n    65\ttype Server struct {\n    66\t\t// Suffrage determines whether the server gets a vote.\n    67\t\tSuffrage ServerSuffrage\n    68\t\t// ID is a unique string identifying this server for all time.\n    69\t\tID ServerID\n    70\t\t// Address is its network address that a transport can contact.\n    71\t\tAddress ServerAddress\n    72\t}\n    73\t\n    74\t// Configuration tracks which servers are in the cluster, and whether they have\n    75\t// votes. This should include the local server, if it's a member of the cluster.\n    76\t// The servers are listed no particular order, but each should only appear once.\n    77\t// These entries are appended to the log during membership changes.\n    78\ttype Configuration struct {\n    79\t\tServers []Server\n    80\t}\n    81\t\n    82\t// Clone makes a deep copy of a Configuration.\n    83\tfunc (c *Configuration) Clone() (copy Configuration) {\n    84\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n    85\t\treturn\n    86\t}\n    87\t\n    88\t// ConfigurationChangeCommand is the different ways to change the cluster\n    89\t// configuration.\n    90\ttype ConfigurationChangeCommand uint8\n    91\t\n    92\tconst (\n    93\t\t// AddVoter adds a server with Suffrage of Voter.\n    94\t\tAddVoter ConfigurationChangeCommand = iota\n    95\t\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n    96\t\tAddNonvoter\n    97\t\t// DemoteVoter makes a server Nonvoter unless its absent.\n    98\t\tDemoteVoter\n    99\t\t// RemoveServer removes a server entirely from the cluster membership.\n   100\t\tRemoveServer\n   101\t\t// Promote changes a server from Staging to Voter. The command will be a\n   102\t\t// no-op if the server is not Staging.\n   103\t\t// Deprecated: use AddVoter instead.\n   104\t\tPromote\n   105\t\t// AddStaging makes a server a Voter.\n   106\t\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n   107\t\tAddStaging = 0 // explicit 0 to preserve the old value.\n   108\t)\n   109\t\n   110\tfunc (c ConfigurationChangeCommand) String() string {\n   111\t\tswitch c {\n   112\t\tcase AddVoter:\n   113\t\t\treturn \"AddVoter\"\n   114\t\tcase AddNonvoter:\n   115\t\t\treturn \"AddNonvoter\"\n   116\t\tcase DemoteVoter:\n   117\t\t\treturn \"DemoteVoter\"\n   118\t\tcase RemoveServer:\n   119\t\t\treturn \"RemoveServer\"\n   120\t\tcase Promote:\n   121\t\t\treturn \"Promote\"\n   122\t\t}\n   123\t\treturn \"ConfigurationChangeCommand\"\n   124\t}\n   125\t\n   126\t// configurationChangeRequest describes a change that a leader would like to\n   127\t// make to its current configuration. It's used only within a single server\n   128\t// (never serialized into the log), as part of `configurationChangeFuture`.\n   129\ttype configurationChangeRequest struct {\n   130\t\tcommand       ConfigurationChangeCommand\n   131\t\tserverID      ServerID\n   132\t\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n   133\t\t// prevIndex, if nonzero, is the index of the only configuration upon which\n   134\t\t// this change may be applied; if another configuration entry has been\n   135\t\t// added in the meantime, this request will fail.\n   136\t\tprevIndex uint64\n   137\t}\n   138\t\n   139\t// configurations is state tracked on every server about its Configurations.\n   140\t// Note that, per Diego's dissertation, there can be at most one uncommitted\n   141\t// configuration at a time (the next configuration may not be created until the\n   142\t// prior one has been committed).\n   143\t//\n   144\t// One downside to storing just two configurations is that if you try to take a\n   145\t// snapshot when your state machine hasn't yet applied the committedIndex, we\n   146\t// have no record of the configuration that would logically fit into that\n   147\t// snapshot. We disallow snapshots in that case now. An alternative approach,\n   148\t// which LogCabin uses, is to track every configuration change in the\n   149\t// log.\n   150\ttype configurations struct {\n   151\t\t// committed is the latest configuration in the log/snapshot that has been\n   152\t\t// committed (the one with the largest index).\n   153\t\tcommitted Configuration\n   154\t\t// committedIndex is the log index where 'committed' was written.\n   155\t\tcommittedIndex uint64\n   156\t\t// latest is the latest configuration in the log/snapshot (may be committed\n   157\t\t// or uncommitted)\n   158\t\tlatest Configuration\n   159\t\t// latestIndex is the log index where 'latest' was written.\n   160\t\tlatestIndex uint64\n   161\t}\n   162\t\n   163\t// Clone makes a deep copy of a configurations object.\n   164\tfunc (c *configurations) Clone() (copy configurations) {\n   165\t\tcopy.committed = c.committed.Clone()\n   166\t\tcopy.committedIndex = c.committedIndex\n   167\t\tcopy.latest = c.latest.Clone()\n   168\t\tcopy.latestIndex = c.latestIndex\n   169\t\treturn\n   170\t}\n   171\t\n   172\t// hasVote returns true if the server identified by 'id' is a Voter in the\n   173\t// provided Configuration.\n   174\tfunc hasVote(configuration Configuration, id ServerID) bool {\n   175\t\tfor _, server := range configuration.Servers {\n   176\t\t\tif server.ID == id {\n   177\t\t\t\treturn server.Suffrage == Voter\n   178\t\t\t}\n   179\t\t}\n   180\t\treturn false\n   181\t}\n   182\t\n   183\t// inConfiguration returns true if the server identified by 'id' is in the\n   184\t// provided Configuration.\n   185\tfunc inConfiguration(configuration Configuration, id ServerID) bool {\n   186\t\tfor _, server := range configuration.Servers {\n   187\t\t\tif server.ID == id {\n   188\t\t\t\treturn true\n   189\t\t\t}\n   190\t\t}\n   191\t\treturn false\n   192\t}\n   193\t\n   194\t// checkConfiguration tests a cluster membership configuration for common\n   195\t// errors.\n   196\tfunc checkConfiguration(configuration Configuration) error {\n   197\t\tidSet := make(map[ServerID]bool)\n   198\t\taddressSet := make(map[ServerAddress]bool)\n   199\t\tvar voters int\n   200\t\tfor _, server := range configuration.Servers {\n","exit_code":0,"status":"completed"}}
