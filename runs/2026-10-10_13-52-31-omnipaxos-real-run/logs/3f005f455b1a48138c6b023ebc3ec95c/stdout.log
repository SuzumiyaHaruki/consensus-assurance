{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | head -280'","aggregated_output":"     1\tuse crate::{\n     2\t    ballot_leader_election::{Ballot, BallotLeaderElection},\n     3\t    errors::{valid_config, ConfigError},\n     4\t    messages::Message,\n     5\t    sequence_paxos::{Phase, SequencePaxos},\n     6\t    storage::{Entry, StopSign, Storage},\n     7\t    util::{\n     8\t        defaults::{BUFFER_SIZE, ELECTION_TIMEOUT, FLUSH_BATCH_TIMEOUT, RESEND_MESSAGE_TIMEOUT},\n     9\t        ConfigurationId, FlexibleQuorum, LogEntry, LogicalClock, NodeId,\n    10\t    },\n    11\t    utils::{ui, ui::ClusterState},\n    12\t};\n    13\t#[cfg(any(feature = \"toml_config\", feature = \"serde\"))]\n    14\tuse serde::Deserialize;\n    15\t#[cfg(feature = \"serde\")]\n    16\tuse serde::Serialize;\n    17\t#[cfg(feature = \"toml_config\")]\n    18\tuse std::fs;\n    19\tuse std::{\n    20\t    error::Error,\n    21\t    fmt::{Debug, Display},\n    22\t    ops::RangeBounds,\n    23\t};\n    24\t#[cfg(feature = \"toml_config\")]\n    25\tuse toml;\n    26\t\n    27\t/// Configuration for `OmniPaxos`.\n    28\t/// # Fields\n    29\t/// * `cluster_config`: The configuration settings that are cluster-wide.\n    30\t/// * `server_config`: The configuration settings that are specific to this OmniPaxos server.\n    31\t#[allow(missing_docs)]\n    32\t#[derive(Clone, Debug, Default)]\n    33\t#[cfg_attr(feature = \"toml_config\", derive(Deserialize), serde(default))]\n    34\tpub struct OmniPaxosConfig {\n    35\t    pub cluster_config: ClusterConfig,\n    36\t    pub server_config: ServerConfig,\n    37\t}\n    38\t\n    39\timpl OmniPaxosConfig {\n    40\t    /// Checks that all the fields of the cluster config are valid.\n    41\t    pub fn validate(&self) -> Result<(), ConfigError> {\n    42\t        self.cluster_config.validate()?;\n    43\t        self.server_config.validate()?;\n    44\t        valid_config!(\n    45\t            self.cluster_config.nodes.contains(&self.server_config.pid),\n    46\t            \"Nodes must include own server pid\"\n    47\t        );\n    48\t        Ok(())\n    49\t    }\n    50\t\n    51\t    /// Creates a new `OmniPaxosConfig` from a `toml` file.\n    52\t    #[cfg(feature = \"toml_config\")]\n    53\t    pub fn with_toml(file_path: &str) -> Result<Self, ConfigError> {\n    54\t        let config_file = fs::read_to_string(file_path)?;\n    55\t        let config: OmniPaxosConfig = toml::from_str(&config_file)?;\n    56\t        config.validate()?;\n    57\t        Ok(config)\n    58\t    }\n    59\t\n    60\t    /// Checks all configuration fields and returns the local OmniPaxos node if successful.\n    61\t    pub fn build<T, B>(self, storage: B) -> Result<OmniPaxos<T, B>, ConfigError>\n    62\t    where\n    63\t        T: Entry,\n    64\t        B: Storage<T>,\n    65\t    {\n    66\t        self.validate()?;\n    67\t        // Use stored ballot as initial BLE leader\n    68\t        let recovered_leader = storage\n    69\t            .get_promise()\n    70\t            .expect(\"storage error while trying to read promise\");\n    71\t        Ok(OmniPaxos {\n    72\t            ble: BallotLeaderElection::with(self.clone().into(), recovered_leader),\n    73\t            election_clock: LogicalClock::with(self.server_config.election_tick_timeout),\n    74\t            resend_message_clock: LogicalClock::with(\n    75\t                self.server_config.resend_message_tick_timeout,\n    76\t            ),\n    77\t            flush_batch_clock: LogicalClock::with(self.server_config.flush_batch_tick_timeout),\n    78\t            seq_paxos: SequencePaxos::with(self.into(), storage),\n    79\t        })\n    80\t    }\n    81\t}\n    82\t\n    83\t/// Configuration for an `OmniPaxos` cluster.\n    84\t/// # Fields\n    85\t/// * `configuration_id`: The identifier for the cluster configuration that this OmniPaxos server is part of.\n    86\t/// * `nodes`: The nodes in the cluster i.e. the `pid`s of the other servers in the configuration.\n    87\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n    88\t#[derive(Clone, Debug, PartialEq, Default)]\n    89\t#[cfg_attr(any(feature = \"serde\", feature = \"toml_config\"), derive(Deserialize))]\n    90\t#[cfg_attr(feature = \"toml_config\", serde(default))]\n    91\t#[cfg_attr(feature = \"serde\", derive(Serialize))]\n    92\tpub struct ClusterConfig {\n    93\t    /// The identifier for the cluster configuration that this OmniPaxos server is part of. Must\n    94\t    /// not be 0 and be greater than the previous configuration's id.\n    95\t    pub configuration_id: ConfigurationId,\n    96\t    /// The nodes in the cluster i.e. the `pid`s of the servers in the configuration.\n    97\t    pub nodes: Vec<NodeId>,\n    98\t    /// Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n    99\t    pub flexible_quorum: Option<FlexibleQuorum>,\n   100\t}\n   101\t\n   102\timpl ClusterConfig {\n   103\t    /// Checks that all the fields of the cluster config are valid.\n   104\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   105\t        let num_nodes = self.nodes.len();\n   106\t        valid_config!(num_nodes > 1, \"Need more than 1 node\");\n   107\t        valid_config!(self.configuration_id != 0, \"Configuration ID cannot be 0\");\n   108\t        if let Some(FlexibleQuorum {\n   109\t            read_quorum_size,\n   110\t            write_quorum_size,\n   111\t        }) = self.flexible_quorum\n   112\t        {\n   113\t            valid_config!(\n   114\t                read_quorum_size + write_quorum_size > num_nodes,\n   115\t                \"The quorums must overlap i.e., the sum of their sizes must exceed the # of nodes\"\n   116\t            );\n   117\t            valid_config!(\n   118\t                read_quorum_size >= 2 && read_quorum_size <= num_nodes,\n   119\t                \"Read quorum must be in range 2 to # of nodes in the cluster\"\n   120\t            );\n   121\t            valid_config!(\n   122\t                write_quorum_size >= 2 && write_quorum_size <= num_nodes,\n   123\t                \"Write quorum must be in range 2 to # of nodes in the cluster\"\n   124\t            );\n   125\t            valid_config!(\n   126\t                read_quorum_size >= write_quorum_size,\n   127\t                \"Read quorum size must be >= the write quorum size.\"\n   128\t            );\n   129\t        }\n   130\t        Ok(())\n   131\t    }\n   132\t\n   133\t    /// Checks all configuration fields and builds a local OmniPaxos node with settings for this\n   134\t    /// node defined in `server_config` and using storage `with_storage`.\n   135\t    pub fn build_for_server<T, B>(\n   136\t        self,\n   137\t        server_config: ServerConfig,\n   138\t        with_storage: B,\n   139\t    ) -> Result<OmniPaxos<T, B>, ConfigError>\n   140\t    where\n   141\t        T: Entry,\n   142\t        B: Storage<T>,\n   143\t    {\n   144\t        let op_config = OmniPaxosConfig {\n   145\t            cluster_config: self,\n   146\t            server_config,\n   147\t        };\n   148\t        op_config.build(with_storage)\n   149\t    }\n   150\t}\n   151\t\n   152\t/// Configuration for a singular `OmniPaxos` instance in a cluster.\n   153\t/// # Fields\n   154\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   155\t/// * `election_tick_timeout`: The number of calls to `tick()` before leader election is updated. If this is set to 5 and `tick()` is called every 10ms, then the election timeout will be 50ms. Must not be 0.\n   156\t/// * `resend_message_tick_timeout`: The number of calls to `tick()` before a message is considered dropped and thus resent. Must not be 0.\n   157\t/// * `buffer_size`: The buffer size for outgoing messages.\n   158\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   159\t/// * `logger_file_path`: The path where the default logger logs events.\n   160\t/// * `leader_priority` : Custom priority for this node to be elected as the leader.\n   161\t#[derive(Clone, Debug)]\n   162\t#[cfg_attr(feature = \"toml_config\", derive(Deserialize), serde(default))]\n   163\tpub struct ServerConfig {\n   164\t    /// The unique identifier of this node. Must not be 0.\n   165\t    pub pid: NodeId,\n   166\t    /// The number of calls to `tick()` before leader election is updated. If this is set to 5 and `tick()` is called every 10ms, then the election timeout will be 50ms.\n   167\t    pub election_tick_timeout: u64,\n   168\t    /// The number of calls to `tick()` before a message is considered dropped and thus resent. Must not be 0.\n   169\t    pub resend_message_tick_timeout: u64,\n   170\t    /// The buffer size for outgoing messages.\n   171\t    pub buffer_size: usize,\n   172\t    /// The size of the buffer for log batching. The default is 1, which means no batching.\n   173\t    pub batch_size: usize,\n   174\t    /// The number of calls to `tick()` before the batched log entries are flushed.\n   175\t    pub flush_batch_tick_timeout: u64,\n   176\t    /// Custom priority for this node to be elected as the leader.\n   177\t    pub leader_priority: u32,\n   178\t    /// The path where the default logger logs events.\n   179\t    #[cfg(feature = \"logging\")]\n   180\t    pub logger_file_path: Option<String>,\n   181\t    /// Custom logger, if provided, will be used instead of the default logger.\n   182\t    #[cfg(feature = \"logging\")]\n   183\t    #[cfg_attr(feature = \"toml_config\", serde(skip_deserializing))]\n   184\t    pub custom_logger: Option<slog::Logger>,\n   185\t}\n   186\t\n   187\timpl ServerConfig {\n   188\t    /// Checks that all the fields of the server config are valid.\n   189\t    pub fn validate(&self) -> Result<(), ConfigError> {\n   190\t        valid_config!(self.pid != 0, \"Server pid cannot be 0\");\n   191\t        valid_config!(self.buffer_size != 0, \"Buffer size must be greater than 0\");\n   192\t        valid_config!(self.batch_size != 0, \"Batch size must be greater than 0\");\n   193\t        valid_config!(\n   194\t            self.election_tick_timeout != 0,\n   195\t            \"Election tick timeout must be greater than 0\"\n   196\t        );\n   197\t        valid_config!(\n   198\t            self.resend_message_tick_timeout != 0,\n   199\t            \"Resend message tick timeout must be greater than 0\"\n   200\t        );\n   201\t        Ok(())\n   202\t    }\n   203\t}\n   204\t\n   205\timpl Default for ServerConfig {\n   206\t    fn default() -> Self {\n   207\t        Self {\n   208\t            pid: 0,\n   209\t            election_tick_timeout: ELECTION_TIMEOUT,\n   210\t            resend_message_tick_timeout: RESEND_MESSAGE_TIMEOUT,\n   211\t            buffer_size: BUFFER_SIZE,\n   212\t            batch_size: 1,\n   213\t            flush_batch_tick_timeout: FLUSH_BATCH_TIMEOUT,\n   214\t            leader_priority: 0,\n   215\t            #[cfg(feature = \"logging\")]\n   216\t            logger_file_path: None,\n   217\t            #[cfg(feature = \"logging\")]\n   218\t            custom_logger: None,\n   219\t        }\n   220\t    }\n   221\t}\n   222\t\n   223\t/// The `OmniPaxos` struct represents an OmniPaxos server. Maintains the replicated log that can be read from and appended to.\n   224\t/// It also handles incoming messages and produces outgoing messages that you need to fetch and send periodically using your own network implementation.\n   225\tpub struct OmniPaxos<T, B>\n   226\twhere\n   227\t    T: Entry,\n   228\t    B: Storage<T>,\n   229\t{\n   230\t    seq_paxos: SequencePaxos<T, B>,\n   231\t    ble: BallotLeaderElection,\n   232\t    election_clock: LogicalClock,\n   233\t    resend_message_clock: LogicalClock,\n   234\t    flush_batch_clock: LogicalClock,\n   235\t}\n   236\t\n   237\timpl<T, B> OmniPaxos<T, B>\n   238\twhere\n   239\t    T: Entry,\n   240\t    B: Storage<T>,\n   241\t{\n   242\t    /// Initiates the trim process.\n   243\t    /// # Arguments\n   244\t    /// * `trim_index` - Deletes all entries up to [`trim_index`], if the [`trim_index`] is `None` then the minimum index accepted by **ALL** servers will be used as the [`trim_index`].\n   245\t    pub fn trim(&mut self, trim_index: Option<usize>) -> Result<(), CompactionErr> {\n   246\t        self.seq_paxos.trim(trim_index)\n   247\t    }\n   248\t\n   249\t    /// Trim the log and create a snapshot. ** Note: only up to the `decided_idx` can be snapshotted **\n   250\t    /// # Arguments\n   251\t    /// `compact_idx` - Snapshots all entries < [`compact_idx`], if the [`compact_idx`] is None then the decided index will be used.\n   252\t    /// `local_only` - If `true`, only this server snapshots the log. If `false` all servers performs the snapshot.\n   253\t    pub fn snapshot(\n   254\t        &mut self,\n   255\t        compact_idx: Option<usize>,\n   256\t        local_only: bool,\n   257\t    ) -> Result<(), CompactionErr> {\n   258\t        self.seq_paxos.snapshot(compact_idx, local_only)\n   259\t    }\n   260\t\n   261\t    /// Return the decided index. 0 means that no entry has been decided.\n   262\t    pub fn get_decided_idx(&self) -> usize {\n   263\t        self.seq_paxos.get_decided_idx()\n   264\t    }\n   265\t\n   266\t    /// Return the accepted index of this node's log (as if it was never compacted).\n   267\t    /// Equal to the index of the last accepted entry; useful for tagging a just-appended\n   268\t    /// entry so that decision can be awaited.\n   269\t    pub fn get_accepted_idx(&self) -> usize {\n   270\t        self.seq_paxos.internal_storage.get_accepted_idx()\n   271\t    }\n   272\t\n   273\t    /// Return the number of entries currently buffered for batching (see\n   274\t    /// `ServerConfig::batch_size`), not yet reflected in `get_accepted_idx()`.\n   275\t    /// Useful, alongside `get_accepted_idx()`, for observing every entry that\n   276\t    /// enters this node's log -- including ones added by internal protocol\n   277\t    /// handling (e.g. a forwarded proposal or replicated entries) rather than\n   278\t    /// a direct call to `append`/`reconfigure`.\n   279\t    pub fn get_batched_len(&self) -> usize {\n   280\t        self.seq_paxos.internal_storage.get_batched_len()\n","exit_code":0,"status":"completed"}}
