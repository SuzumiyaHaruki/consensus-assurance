{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/omni_paxos.rs | sed -n '285,510p'\"","aggregated_output":"   285\t        self.seq_paxos.get_compacted_idx()\n   286\t    }\n   287\t\n   288\t    /// Returns the ID of the current leader and whether the node's `Phase` is `Phase::Accepted`.\n   289\t    ///\n   290\t    /// If the node's phase is `Phase::Accepted`, this implies that the returned leader is also\n   291\t    /// in the accepted phase. However, a `Phase::Prepare` or a `false` response does not\n   292\t    /// necessarily imply that the leader is not in the accepted phase; it only reflects the current\n   293\t    /// phase of this node.\n   294\t    pub fn get_current_leader(&self) -> Option<(NodeId, bool)> {\n   295\t        let promised_pid = self.seq_paxos.get_promise().pid;\n   296\t        if promised_pid == 0 {\n   297\t            None\n   298\t        } else {\n   299\t            let is_accepted = self.seq_paxos.get_state().1 == Phase::Accept;\n   300\t            Some((promised_pid, is_accepted))\n   301\t        }\n   302\t    }\n   303\t\n   304\t    /// Returns the promised ballot of this node.\n   305\t    pub fn get_promise(&self) -> Ballot {\n   306\t        self.seq_paxos.get_promise()\n   307\t    }\n   308\t\n   309\t    /// Returns this node's own pid.\n   310\t    pub fn get_pid(&self) -> NodeId {\n   311\t        self.seq_paxos.get_pid()\n   312\t    }\n   313\t\n   314\t    /// Moves outgoing messages from this server into the buffer. The messages should then be sent via the network implementation.\n   315\t    pub fn take_outgoing_messages(&mut self, buffer: &mut Vec<Message<T>>) {\n   316\t        self.seq_paxos.take_outgoing_msgs(buffer);\n   317\t        buffer.extend(self.ble.outgoing_mut().drain(..).map(|b| Message::BLE(b)));\n   318\t    }\n   319\t\n   320\t    /// Read entry at index `idx` in the log. Returns `None` if `idx` is out of bounds.\n   321\t    pub fn read(&self, idx: usize) -> Option<LogEntry<T>> {\n   322\t        match self\n   323\t            .seq_paxos\n   324\t            .internal_storage\n   325\t            .read(idx..idx + 1)\n   326\t            .expect(\"storage error while trying to read log entries\")\n   327\t        {\n   328\t            Some(mut v) => v.pop(),\n   329\t            None => None,\n   330\t        }\n   331\t    }\n   332\t\n   333\t    /// Read entries in the range `r` in the log. Returns `None` if `r` is out of bounds.\n   334\t    pub fn read_entries<R>(&self, r: R) -> Option<Vec<LogEntry<T>>>\n   335\t    where\n   336\t        R: RangeBounds<usize>,\n   337\t    {\n   338\t        self.seq_paxos\n   339\t            .internal_storage\n   340\t            .read(r)\n   341\t            .expect(\"storage error while trying to read log entries\")\n   342\t    }\n   343\t\n   344\t    /// Read all decided entries starting at `from_idx` (inclusive) in the log. Returns `None` if `from_idx` is out of bounds.\n   345\t    pub fn read_decided_suffix(&self, from_idx: usize) -> Option<Vec<LogEntry<T>>> {\n   346\t        self.seq_paxos\n   347\t            .internal_storage\n   348\t            .read_decided_suffix(from_idx)\n   349\t            .expect(\"storage error while trying to read decided log suffix\")\n   350\t    }\n   351\t\n   352\t    /// Handle an incoming message\n   353\t    pub fn handle_incoming(&mut self, m: Message<T>) {\n   354\t        match m {\n   355\t            Message::SequencePaxos(p) => self.seq_paxos.handle(p),\n   356\t            Message::BLE(b) => self.ble.handle(b),\n   357\t            #[cfg(feature = \"async_runtime\")]\n   358\t            Message::AsyncRuntime(_) => {\n   359\t                // Runtime-layer messages are consumed by the actor before reaching here.\n   360\t                // If one leaks through (e.g. user hand-delivered), silently ignore.\n   361\t            }\n   362\t        }\n   363\t    }\n   364\t\n   365\t    /// Returns whether this Sequence Paxos has been reconfigured\n   366\t    pub fn is_reconfigured(&self) -> Option<StopSign> {\n   367\t        self.seq_paxos.is_reconfigured()\n   368\t    }\n   369\t\n   370\t    /// Append an entry to the replicated log.\n   371\t    pub fn append(&mut self, entry: T) -> Result<(), ProposeErr<T>> {\n   372\t        self.seq_paxos.append(entry)\n   373\t    }\n   374\t\n   375\t    /// Propose a cluster reconfiguration. Returns an error if the current configuration has already been stopped\n   376\t    /// by a previous reconfiguration request or if the `new_configuration` is invalid.\n   377\t    /// `new_configuration` defines the cluster-wide configuration settings for the **next** cluster.\n   378\t    /// `metadata` is optional data to commit alongside the reconfiguration.\n   379\t    pub fn reconfigure(\n   380\t        &mut self,\n   381\t        new_configuration: ClusterConfig,\n   382\t        metadata: Option<Vec<u8>>,\n   383\t    ) -> Result<(), ProposeErr<T>> {\n   384\t        if let Err(config_error) = new_configuration.validate() {\n   385\t            return Err(ProposeErr::ConfigError(\n   386\t                config_error,\n   387\t                new_configuration,\n   388\t                metadata,\n   389\t            ));\n   390\t        }\n   391\t        self.seq_paxos.reconfigure(new_configuration, metadata)\n   392\t    }\n   393\t\n   394\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   395\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   396\t    pub fn reconnected(&mut self, pid: NodeId) {\n   397\t        self.seq_paxos.reconnected(pid)\n   398\t    }\n   399\t\n   400\t    /// Increments the internal logical clock. This drives the processes for leader changes, resending dropped messages, and flushing batched log entries.\n   401\t    /// Each of these is triggered every `election_tick_timeout`, `resend_message_tick_timeout`, and `flush_batch_tick_timeout` number of calls to this function\n   402\t    /// (See how to configure these timeouts in `ServerConfig`).\n   403\t    pub fn tick(&mut self) {\n   404\t        if self.election_clock.tick_and_check_timeout() {\n   405\t            self.election_timeout();\n   406\t        }\n   407\t        if self.resend_message_clock.tick_and_check_timeout() {\n   408\t            self.seq_paxos.resend_message_timeout();\n   409\t        }\n   410\t        if self.flush_batch_clock.tick_and_check_timeout() {\n   411\t            self.seq_paxos.flush_batch_timeout();\n   412\t        }\n   413\t    }\n   414\t\n   415\t    /// Manually attempt to become the leader by incrementing this instance's Ballot. Calling this\n   416\t    /// function may not result in gainig leadership if other instances are competing for\n   417\t    /// leadership with higher Ballots.\n   418\t    pub fn try_become_leader(&mut self) {\n   419\t        let mut my_ballot = self.ble.get_current_ballot();\n   420\t        let promise = self.seq_paxos.get_promise();\n   421\t        my_ballot.n = promise.n + 1;\n   422\t        self.seq_paxos.handle_leader(my_ballot);\n   423\t    }\n   424\t\n   425\t    /*** BLE calls ***/\n   426\t    /// Update the custom priority used in the Ballot for this server. Note that changing the\n   427\t    /// priority triggers a leader re-election.\n   428\t    pub fn set_priority(&mut self, p: u32) {\n   429\t        self.ble.set_priority(p)\n   430\t    }\n   431\t\n   432\t    /// If the heartbeat of a leader is not received when election_timeout() is called, the server might attempt to become the leader.\n   433\t    /// It is also used for the election process, where the server checks if it can become the leader.\n   434\t    /// For instance if `election_timeout()` is called every 100ms, then if the leader fails, the servers will detect it after 100ms and elect a new server after another 100ms if possible.\n   435\t    fn election_timeout(&mut self) {\n   436\t        if let Some(new_leader) = self\n   437\t            .ble\n   438\t            .hb_timeout(self.seq_paxos.get_state(), self.seq_paxos.get_promise())\n   439\t        {\n   440\t            self.seq_paxos.handle_leader(new_leader);\n   441\t        }\n   442\t    }\n   443\t\n   444\t    /// Returns the current states of the OmniPaxos instance for OmniPaxos UI to display.\n   445\t    pub fn get_ui_states(&self) -> ui::OmniPaxosStates {\n   446\t        let mut cluster_state = ClusterState::from(self.seq_paxos.get_leader_state());\n   447\t        cluster_state.heartbeats = self.ble.get_ballots();\n   448\t\n   449\t        ui::OmniPaxosStates {\n   450\t            current_ballot: self.ble.get_current_ballot(),\n   451\t            current_leader: self.get_current_leader().map(|(leader, _)| leader),\n   452\t            decided_idx: self.get_decided_idx(),\n   453\t            heartbeats: self.ble.get_ballots(),\n   454\t            cluster_state,\n   455\t        }\n   456\t    }\n   457\t}\n   458\t\n   459\t/// An error indicating a failed proposal due to the current cluster configuration being already stopped\n   460\t/// or due to an invalid proposed configuration. Returns the failed proposal.\n   461\t#[derive(Debug)]\n   462\tpub enum ProposeErr<T>\n   463\twhere\n   464\t    T: Entry,\n   465\t{\n   466\t    /// Couldn't propose entry because a reconfiguration is pending. Returns the failed, proposed entry.\n   467\t    PendingReconfigEntry(T),\n   468\t    /// Couldn't propose reconfiguration because a reconfiguration is already pending. Returns the failed, proposed `ClusterConfig` and the metadata.\n   469\t    /// cluster config and metadata.\n   470\t    PendingReconfigConfig(ClusterConfig, Option<Vec<u8>>),\n   471\t    /// Couldn't propose reconfiguration because of an invalid cluster config. Contains the config\n   472\t    /// error and the failed, proposed cluster config and metadata.\n   473\t    ConfigError(ConfigError, ClusterConfig, Option<Vec<u8>>),\n   474\t}\n   475\t\n   476\t/// An error returning the proposal that was failed due to that the current configuration is stopped.\n   477\t#[derive(Copy, Clone, Debug)]\n   478\tpub enum CompactionErr {\n   479\t    /// Snapshot was called with an index that is not decided yet. Returns the currently decided index.\n   480\t    UndecidedIndex(usize),\n   481\t    /// Snapshot was called with an index which is already trimmed. Returns the currently compacted index.\n   482\t    TrimmedIndex(usize),\n   483\t    /// Trim was called with an index that is not decided by all servers yet. Returns the index decided by ALL servers currently.\n   484\t    NotAllDecided(usize),\n   485\t    /// Trim was called at a follower node. Trim must be called by the leader, which is the returned NodeId.\n   486\t    NotCurrentLeader(NodeId),\n   487\t}\n   488\t\n   489\timpl Error for CompactionErr {}\n   490\timpl Display for CompactionErr {\n   491\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n   492\t        Debug::fmt(self, f)\n   493\t    }\n   494\t}\n","exit_code":0,"status":"completed"}}
