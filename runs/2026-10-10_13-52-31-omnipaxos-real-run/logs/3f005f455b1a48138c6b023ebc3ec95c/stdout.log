{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba ../agent-source/omnipaxos/src/sequence_paxos/mod.rs | sed -n '335,600p'\"","aggregated_output":"   335\t\n   336\t    /// Returns this node's own pid.\n   337\t    pub(crate) fn get_pid(&self) -> NodeId {\n   338\t        self.pid\n   339\t    }\n   340\t\n   341\t    /// Handles re-establishing a connection to a previously disconnected peer.\n   342\t    /// This should only be called if the underlying network implementation indicates that a connection has been re-established.\n   343\t    pub(crate) fn reconnected(&mut self, pid: NodeId) {\n   344\t        if pid == self.pid {\n   345\t            return;\n   346\t        } else if pid == self.get_current_leader() {\n   347\t            self.state = (Role::Follower, Phase::Recover);\n   348\t        }\n   349\t        let prepreq = PrepareReq {\n   350\t            n: self.get_promise(),\n   351\t        };\n   352\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   353\t            from: self.pid,\n   354\t            to: pid,\n   355\t            msg: PaxosMsg::PrepareReq(prepreq),\n   356\t        }));\n   357\t    }\n   358\t\n   359\t    fn propose_entry(&mut self, entry: T) {\n   360\t        match self.state {\n   361\t            (Role::Leader, Phase::Prepare) => self.buffered_proposals.push(entry),\n   362\t            (Role::Leader, Phase::Accept) => self.accept_entry_leader(entry),\n   363\t            _ => self.forward_proposals(vec![entry]),\n   364\t        }\n   365\t    }\n   366\t\n   367\t    pub(crate) fn get_leader_state(&self) -> &LeaderState<T> {\n   368\t        &self.leader_state\n   369\t    }\n   370\t\n   371\t    pub(crate) fn forward_proposals(&mut self, mut entries: Vec<T>) {\n   372\t        let leader = self.get_current_leader();\n   373\t        if leader > 0 && self.pid != leader {\n   374\t            let pf = PaxosMsg::ProposalForward(entries);\n   375\t            let msg = Message::SequencePaxos(PaxosMessage {\n   376\t                from: self.pid,\n   377\t                to: leader,\n   378\t                msg: pf,\n   379\t            });\n   380\t            self.outgoing.push(msg);\n   381\t        } else {\n   382\t            self.buffered_proposals.append(&mut entries);\n   383\t        }\n   384\t    }\n   385\t\n   386\t    pub(crate) fn forward_stopsign(&mut self, ss: StopSign) {\n   387\t        let leader = self.get_current_leader();\n   388\t        if leader > 0 && self.pid != leader {\n   389\t            #[cfg(feature = \"logging\")]\n   390\t            trace!(self.logger, \"Forwarding StopSign to Leader {:?}\", leader);\n   391\t            let fs = PaxosMsg::ForwardStopSign(ss);\n   392\t            let msg = Message::SequencePaxos(PaxosMessage {\n   393\t                from: self.pid,\n   394\t                to: leader,\n   395\t                msg: fs,\n   396\t            });\n   397\t            self.outgoing.push(msg);\n   398\t        } else if self.buffered_stopsign.as_mut().is_none() {\n   399\t            self.buffered_stopsign = Some(ss);\n   400\t        }\n   401\t    }\n   402\t    /// Returns `LogSync`, a struct to help other servers synchronize their log to correspond to the\n   403\t    /// current state of our own log. The `common_prefix_idx` marks where in the log the other server\n   404\t    /// needs to be sync from.\n   405\t    fn create_log_sync(\n   406\t        &self,\n   407\t        common_prefix_idx: usize,\n   408\t        other_logs_decided_idx: usize,\n   409\t    ) -> LogSync<T> {\n   410\t        let decided_idx = self.internal_storage.get_decided_idx();\n   411\t        let (decided_snapshot, suffix, sync_idx) =\n   412\t            if T::Snapshot::use_snapshots() && decided_idx > common_prefix_idx {\n   413\t                // Note: We snapshot from the other log's decided index and not the common prefix because\n   414\t                // snapshots currently only work on decided entries.\n   415\t                let (delta_snapshot, compacted_idx) = self\n   416\t                    .internal_storage\n   417\t                    .create_diff_snapshot(other_logs_decided_idx)\n   418\t                    .expect(READ_ERROR_MSG);\n   419\t                let suffix = self\n   420\t                    .internal_storage\n   421\t                    .get_suffix(decided_idx)\n   422\t                    .expect(READ_ERROR_MSG);\n   423\t                (delta_snapshot, suffix, compacted_idx)\n   424\t            } else {\n   425\t                let suffix = self\n   426\t                    .internal_storage\n   427\t                    .get_suffix(common_prefix_idx)\n   428\t                    .expect(READ_ERROR_MSG);\n   429\t                (None, suffix, common_prefix_idx)\n   430\t            };\n   431\t        LogSync {\n   432\t            decided_snapshot,\n   433\t            suffix,\n   434\t            sync_idx,\n   435\t            stopsign: self.internal_storage.get_stopsign(),\n   436\t        }\n   437\t    }\n   438\t}\n   439\t\n   440\t#[derive(PartialEq, Debug)]\n   441\tpub(crate) enum Phase {\n   442\t    Prepare,\n   443\t    Accept,\n   444\t    Recover,\n   445\t    None,\n   446\t}\n   447\t\n   448\t#[derive(PartialEq, Debug)]\n   449\tpub(crate) enum Role {\n   450\t    Follower,\n   451\t    Leader,\n   452\t}\n   453\t\n   454\t/// Configuration for `SequencePaxos`.\n   455\t/// # Fields\n   456\t/// * `pid`: The unique identifier of this node. Must not be 0.\n   457\t/// * `peers`: The peers of this node i.e. the `pid`s of the other servers in the configuration.\n   458\t/// * `flexible_quorum` : Defines read and write quorum sizes. Can be used for different latency vs fault tolerance tradeoffs.\n   459\t/// * `buffer_size`: The buffer size for outgoing messages.\n   460\t/// * `batch_size`: The size of the buffer for log batching. The default is 1, which means no batching.\n   461\t/// * `logger_file_path`: The path where the default logger logs events.\n   462\t#[derive(Clone, Debug)]\n   463\tpub(crate) struct SequencePaxosConfig {\n   464\t    pid: NodeId,\n   465\t    peers: Vec<NodeId>,\n   466\t    buffer_size: usize,\n   467\t    pub(crate) batch_size: usize,\n   468\t    flexible_quorum: Option<FlexibleQuorum>,\n   469\t    #[cfg(feature = \"logging\")]\n   470\t    logger_file_path: Option<String>,\n   471\t    #[cfg(feature = \"logging\")]\n   472\t    custom_logger: Option<Logger>,\n   473\t}\n   474\t\n   475\timpl From<OmniPaxosConfig> for SequencePaxosConfig {\n   476\t    fn from(config: OmniPaxosConfig) -> Self {\n   477\t        let pid = config.server_config.pid;\n   478\t        let peers = config\n   479\t            .cluster_config\n   480\t            .nodes\n   481\t            .into_iter()\n   482\t            .filter(|x| *x != pid)\n   483\t            .collect();\n   484\t        SequencePaxosConfig {\n   485\t            pid,\n   486\t            peers,\n   487\t            flexible_quorum: config.cluster_config.flexible_quorum,\n   488\t            buffer_size: config.server_config.buffer_size,\n   489\t            batch_size: config.server_config.batch_size,\n   490\t            #[cfg(feature = \"logging\")]\n   491\t            logger_file_path: config.server_config.logger_file_path,\n   492\t            #[cfg(feature = \"logging\")]\n   493\t            custom_logger: config.server_config.custom_logger,\n   494\t        }\n   495\t    }\n   496\t}\n","exit_code":0,"status":"completed"}}
