{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'nl -ba ../agent-source/omnipaxos/src/sequence_paxos/leader.rs | head -200'","aggregated_output":"     1\tuse super::super::{\n     2\t    ballot_leader_election::Ballot,\n     3\t    util::{LeaderState, PromiseMetaData},\n     4\t};\n     5\tuse crate::util::{AcceptedMetaData, WRITE_ERROR_MSG};\n     6\t\n     7\tuse super::*;\n     8\t\n     9\timpl<T, B> SequencePaxos<T, B>\n    10\twhere\n    11\t    T: Entry,\n    12\t    B: Storage<T>,\n    13\t{\n    14\t    /// Handle a new leader. Should be called when the leader election has elected a new leader with the ballot `n`\n    15\t    /*** Leader ***/\n    16\t    pub(crate) fn handle_leader(&mut self, n: Ballot) {\n    17\t        if n <= self.leader_state.n_leader || n <= self.internal_storage.get_promise() {\n    18\t            return;\n    19\t        }\n    20\t        #[cfg(feature = \"logging\")]\n    21\t        debug!(self.logger, \"Newly elected leader: {:?}\", n);\n    22\t        if self.pid == n.pid {\n    23\t            self.leader_state =\n    24\t                LeaderState::with(n, self.leader_state.max_pid, self.leader_state.quorum);\n    25\t            // Flush any pending writes\n    26\t            // Don't have to handle flushed entries here because we will sync with followers\n    27\t            let _ = self.internal_storage.flush_batch().expect(WRITE_ERROR_MSG);\n    28\t            self.internal_storage.set_promise(n).expect(WRITE_ERROR_MSG);\n    29\t            /* insert my promise */\n    30\t            let na = self.internal_storage.get_accepted_round();\n    31\t            let decided_idx = self.get_decided_idx();\n    32\t            let accepted_idx = self.internal_storage.get_accepted_idx();\n    33\t            let my_promise = Promise {\n    34\t                n,\n    35\t                n_accepted: na,\n    36\t                decided_idx,\n    37\t                accepted_idx,\n    38\t                log_sync: None,\n    39\t            };\n    40\t            self.leader_state.set_promise(my_promise, self.pid, true);\n    41\t            /* initialise longest chosen sequence and update state */\n    42\t            self.state = (Role::Leader, Phase::Prepare);\n    43\t            let prep = Prepare {\n    44\t                n,\n    45\t                decided_idx,\n    46\t                n_accepted: na,\n    47\t                accepted_idx,\n    48\t            };\n    49\t            /* send prepare */\n    50\t            for pid in &self.peers {\n    51\t                self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n    52\t                    from: self.pid,\n    53\t                    to: *pid,\n    54\t                    msg: PaxosMsg::Prepare(prep),\n    55\t                }));\n    56\t            }\n    57\t        } else {\n    58\t            self.become_follower();\n    59\t        }\n    60\t    }\n    61\t\n    62\t    pub(crate) fn become_follower(&mut self) {\n    63\t        self.state.0 = Role::Follower;\n    64\t    }\n    65\t\n    66\t    pub(crate) fn handle_preparereq(&mut self, prepreq: PrepareReq, from: NodeId) {\n    67\t        #[cfg(feature = \"logging\")]\n    68\t        debug!(self.logger, \"Incoming message PrepareReq from {}\", from);\n    69\t        if self.state.0 == Role::Leader && prepreq.n <= self.leader_state.n_leader {\n    70\t            self.leader_state.reset_promise(from);\n    71\t            self.leader_state.set_latest_accept_meta(from, None);\n    72\t            self.send_prepare(from);\n    73\t        }\n    74\t    }\n    75\t\n    76\t    pub(crate) fn handle_forwarded_proposal(&mut self, mut entries: Vec<T>) {\n    77\t        if !self.accepted_reconfiguration() {\n    78\t            match self.state {\n    79\t                (Role::Leader, Phase::Prepare) => self.buffered_proposals.append(&mut entries),\n    80\t                (Role::Leader, Phase::Accept) => self.accept_entries_leader(entries),\n    81\t                _ => self.forward_proposals(entries),\n    82\t            }\n    83\t        }\n    84\t    }\n    85\t\n    86\t    pub(crate) fn handle_forwarded_stopsign(&mut self, ss: StopSign) {\n    87\t        if self.accepted_reconfiguration() {\n    88\t            return;\n    89\t        }\n    90\t        match self.state {\n    91\t            (Role::Leader, Phase::Prepare) => self.buffered_stopsign = Some(ss),\n    92\t            (Role::Leader, Phase::Accept) => self.accept_stopsign_leader(ss),\n    93\t            _ => self.forward_stopsign(ss),\n    94\t        }\n    95\t    }\n    96\t\n    97\t    pub(crate) fn send_prepare(&mut self, to: NodeId) {\n    98\t        let prep = Prepare {\n    99\t            n: self.leader_state.n_leader,\n   100\t            decided_idx: self.internal_storage.get_decided_idx(),\n   101\t            n_accepted: self.internal_storage.get_accepted_round(),\n   102\t            accepted_idx: self.internal_storage.get_accepted_idx(),\n   103\t        };\n   104\t        self.outgoing.push(Message::SequencePaxos(PaxosMessage {\n   105\t            from: self.pid,\n   106\t            to,\n   107\t            msg: PaxosMsg::Prepare(prep),\n   108\t        }));\n   109\t    }\n   110\t\n   111\t    pub(crate) fn accept_entry_leader(&mut self, entry: T) {\n   112\t        let accepted_metadata = self\n   113\t            .internal_storage\n   114\t            .append_entry_with_batching(entry)\n   115\t            .expect(WRITE_ERROR_MSG);\n   116\t        if let Some(metadata) = accepted_metadata {\n   117\t            self.leader_state\n   118\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   119\t            self.send_acceptdecide(metadata);\n   120\t        }\n   121\t    }\n   122\t\n   123\t    pub(crate) fn accept_entries_leader(&mut self, entries: Vec<T>) {\n   124\t        let accepted_metadata = self\n   125\t            .internal_storage\n   126\t            .append_entries_with_batching(entries)\n   127\t            .expect(WRITE_ERROR_MSG);\n   128\t        if let Some(metadata) = accepted_metadata {\n   129\t            self.leader_state\n   130\t                .set_accepted_idx(self.pid, metadata.accepted_idx);\n   131\t            self.send_acceptdecide(metadata);\n   132\t        }\n   133\t    }\n   134\t\n   135\t    pub(crate) fn accept_stopsign_leader(&mut self, ss: StopSign) {\n   136\t        let accepted_metadata = self\n   137\t            .internal_storage\n   138\t            .append_stopsign(ss.clone())\n   139\t            .expect(WRITE_ERROR_MSG);\n   140\t        if let Some(metadata) = accepted_metadata {\n   141\t            self.send_acceptdecide(metadata);\n   142\t        }\n   143\t        let accepted_idx = self.internal_storage.get_accepted_idx();\n   144\t        self.leader_state.set_accepted_idx(self.pid, accepted_idx);\n   145\t        for pid in self.leader_state.get_promised_followers() {\n   146\t            self.send_accept_stopsign(pid, ss.clone(), false);\n   147\t        }\n   148\t    }\n   149\t\n   150\t    fn send_accsync(&mut self, to: NodeId) {\n   151\t        let current_n = self.leader_state.n_leader;\n   152\t        let PromiseMetaData {\n   153\t            n_accepted: prev_round_max_promise_n,\n   154\t            accepted_idx: prev_round_max_accepted_idx,\n   155\t            ..\n   156\t        } = &self.leader_state.get_max_promise_meta();\n   157\t        let PromiseMetaData {\n   158\t            n_accepted: followers_promise_n,\n   159\t            accepted_idx: followers_accepted_idx,\n   160\t            pid,\n   161\t            ..\n   162\t        } = self.leader_state.get_promise_meta(to);\n   163\t        let followers_decided_idx = self\n   164\t            .leader_state\n   165\t            .get_decided_idx(*pid)\n   166\t            .expect(\"Received PromiseMetaData but not found in ld\");\n   167\t        // Follower can have valid accepted entries depending on which leader they were previously following\n   168\t        let followers_valid_entries_idx = if *followers_promise_n == current_n {\n   169\t            *followers_accepted_idx\n   170\t        } else if *followers_promise_n == *prev_round_max_promise_n {\n   171\t            *prev_round_max_accepted_idx.min(followers_accepted_idx)\n   172\t        } else {\n   173\t            followers_decided_idx\n   174\t        };\n   175\t        let log_sync = self.create_log_sync(followers_valid_entries_idx, followers_decided_idx);\n   176\t        self.leader_state.increment_seq_num_session(to);\n   177\t        let acc_sync = AcceptSync {\n   178\t            n: current_n,\n   179\t            seq_num: self.leader_state.next_seq_num(to),\n   180\t            decided_idx: self.get_decided_idx(),\n   181\t            log_sync,\n   182\t            #[cfg(feature = \"unicache\")]\n   183\t            unicache: self.internal_storage.get_unicache(),\n   184\t        };\n   185\t        let msg = Message::SequencePaxos(PaxosMessage {\n   186\t            from: self.pid,\n   187\t            to,\n   188\t            msg: PaxosMsg::AcceptSync(acc_sync),\n   189\t        });\n   190\t        self.outgoing.push(msg);\n   191\t    }\n   192\t\n   193\t    fn send_acceptdecide(&mut self, accepted: AcceptedMetaData<T>) {\n   194\t        let decided_idx = self.internal_storage.get_decided_idx();\n   195\t        for pid in self.leader_state.get_promised_followers() {\n   196\t            let latest_accdec = self.get_latest_accdec_message(pid);\n   197\t            match latest_accdec {\n   198\t                // Modify existing AcceptDecide message to follower\n   199\t                Some(accdec) => {\n   200\t                    accdec.entries.extend(accepted.entries.iter().cloned());\n","exit_code":0,"status":"completed"}}
