ecution backend\", \"title\": \"Kind\", \"type\": \"string\"}, \"source\": {\"description\": \"Executable experiment source, calling actual target code; no fabricated expected observations\", \"minLength\": 1, \"title\": \"Source\", \"type\": \"string\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}, \"semantic_changes\": {\"description\": \"Instrumentation and adaptation differences; never alter protocol logic to create a real finding\", \"items\": {\"type\": \"string\"}, \"title\": \"Semantic Changes\", \"type\": \"array\"}, \"prerequisites\": {\"default\": [], \"items\": {\"$ref\": \"#/$defs/EventRequirement\"}, \"title\": \"Prerequisites\", \"type\": \"array\"}, \"legality\": {\"$ref\": \"#/$defs/Grounding\", \"default\": {\"source_ids\": [], \"expectation_ids\": [], \"binding_ids\": [], \"derivation\": \"\", \"applicability\": \"\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}}}, \"required\": [\"kind\", \"source\", \"description\", \"semantic_changes\"], \"title\": \"Harness\", \"type\": \"object\"}\nObservableProperty {\"additionalProperties\": false, \"properties\": {\"checker_id\": {\"title\": \"Checker Id\", \"type\": \"string\"}, \"kind\": {\"default\": \"event_assertion\", \"enum\": [\"event_assertion\", \"event_implication\"], \"title\": \"Kind\", \"type\": \"string\"}, \"trigger\": {\"$ref\": \"#/$defs/Comparison\"}, \"assertion\": {\"$ref\": \"#/$defs/Comparison\"}, \"antecedent\": {\"anyOf\": [{\"$ref\": \"#/$defs/Comparison\"}, {\"type\": \"null\"}], \"default\": null}, \"identity_fields\": {\"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\", \"items\": {\"type\": \"string\"}, \"title\": \"Identity Fields\", \"type\": \"array\"}, \"description\": {\"title\": \"Description\", \"type\": \"string\"}}, \"required\": [\"checker_id\", \"trigger\", \"assertion\", \"description\"], \"title\": \"ObservableProperty\", \"ty