r.handleLeaderReadIndex\n2150:\tr.handlers[observer][pb.ReadIndex] = r.handleObserverReadIndex\n2151:\tr.handlers[observer][pb.ReadIndexResp] = r.handleObserverReadIndexResp\n2165:func (r *raft) checkHandlerMap() {\n2174:\t\t{leader, pb.ReadIndexResp},\n2190:\t\t{witness, pb.ReadIndex},\n2191:\t\t{witness, pb.ReadIndexResp},\n","exit_code":0,"status":"completed"}}
