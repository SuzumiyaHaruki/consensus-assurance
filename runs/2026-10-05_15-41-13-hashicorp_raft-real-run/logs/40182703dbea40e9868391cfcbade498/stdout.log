   \"configurationChangeChIfStable has admitted the request (latest==committed and the leader has committed an entry of its term)\",\n    \"the only faulted component is the LogStore's StoreLogs call\"\n   ],\n   \"excluded\": [\n    \"consequences that require the node to regain leadership and commit the phantom configuration\",\n    \"failures of StableStore, the transport or the snapshot store\"\n   ],\n   \"parameters\": {}\n  },\n  \"rationale\": \"The configuration-append path publishes configuration state without checking whether the supporting log entry was durably stored, so the voter set used for quorum and eligibility can diverge from the agreed log. This is a sourced responsibility on the A4 configuration path with a stated A1 consequence, and it is executable with an injectable LogStore.\",\n  \"status\": \"partial\",\n  \"previous_id\": null,\n  \"version\": 1,\n  \"boundary_changes\": [],\n  \"obligation_checks\": {\n   \"oblig-config-from-durable-entry\": [\n    \"96a2fe479e6d4bf895ca503bd3ee8a29\"\n   ]\n  },\n  \"remaining_obligation_ids\": [\n   \"oblig-config-from-durable-entry\"\n  ],\n  \"recheck_\ndirect_checks [\n {\n  \"id\": \"220b06642e5e437592e379b5af4e8251\",\n  \"version\": 1,\n  \"plan_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-05_15-41-13-hashicorp_raft-real-run/direct-checks/f30f1a06376c4c90ae7671e61e7159f1/plan.json\",\n  \"harness_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-05_15-41-13-hashicorp_raft-real-run/direct-checks/f30f1a06376c4c90ae7671e61e7159f1/assurance_generated_test.go\",\n  \"snapshot_id\": \"5aa6bd2c5335448e8005f411afcbaf16\",\n  \"unit_id\": \"unit-oblig-config-from-durable-entry\",\n  \"claim_id\": \"oblig-config-from-durable-entry\",\n  \"binding_ids\": [\n   \"bind-append-configuration-entry\"\n  ],\n  \"graph_versions\": {\n   \"oblig-config-from-durable-entry\": 1,\n   \"bind-append-configuration-entry\": 1,\n   \"unit-oblig-config-from-durable-entry\": 1\n  },\n  \"origi