&future.logFuture})\n1236: \tindex := future.Index()\n1237: \tr.setLatestConfiguration(configuration, index)\n1238: \tr.leaderState.commitment.setConfiguration(configuration)\n1239: \tr.startStopReplication()\n1240: }\n1241: \n1242: // dispatchLog is called on the leader to push a log to disk, mark it\n1243: // as inflight and begin replication of it.\n1244: func (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n1245: \tnow := time.Now()\n1246: \tdefer metrics.MeasureSince([]string{\"raft\", \"leader\", \"dispatchLog\"}, now)\n1247: \n1248: \tterm := r.getCurrentTerm()\n","exit_code":0,"status":"completed"}}
