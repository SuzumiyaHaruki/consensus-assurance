\t// Skip this one and try the next. We will detect if we\n354: \t\t\t// couldn't open any snapshots.\n355: \t\t\tcontinue\n356: \t\t}\n357: \n358: \t\t// Note this is the one place we call fsm.Restore without the\n359: \t\t// fsmRestoreAndMeasure wrapper since this function should only be called to\n360: \t\t// reset state on disk and the FSM passed will not be used for a running\n361: \t\t// server instance. If the same process will eventually become a Raft peer\n362: \t\t// then it will call NewRaft and restore again from disk then which will\n363: \t\t// report metrics.\n364: \t\tsnapLogger := logger.With(\n365: \t\t\t\"id\", snapshot.ID,\n366: \t\t\t\"last-index\", snapshot.Index,\n367: \t\t\t\"last-term\", snapshot.Term,\n368: \t\t\t\"size-in-bytes\", snapshot.Size,\n369: \t\t)\n370: \t\tcrc := newCountingReadCloser(source)\n371: \t\tmonitor := startSnapshotRestoreMonitor(snapLogger, crc, snapshot.Size, false)\n372: \t\terr = fsm.Restore(crc)\n373: \t\t// Close the source after the restore has completed\n374: \t\tsource.Close()\n375: \t\tmonitor.StopAndWait()\n376: \t\tif err != nil {\n377: \t\t\t// Same here, skip and try the next one.\n378: \t\t\tcontinue\n379: \t\t}\n380: \n381: \t\tsnapshotIndex = snapshot.Index\n382: \t\tsnapshotTerm = snapshot.Term\n383: \t\tbreak\n384: \t}\n385: \tif len(snapshots) > 0 && (snapshotIndex == 0 || snapshotTerm == 0) {\n386: \t\treturn fmt.Errorf(\"failed to restore any of the available snapshots\")\n387: \t}\n388: \n389: \t// The snapshot information is the best known end point for the data\n390: \t// until we play back the Raft log entries.\n391: \tlastIndex := snapshotIndex\n392: \tlastTerm := snapshotTerm\n393: \n394: \t// Apply any Raft log entries past the snapshot.\n395: \tlastLogIndex, err := logs.LastIndex()\n396: \tif err != nil {\n397: \t\treturn fmt.Errorf(\"failed to find last log: %v\", err)\n398: \t}\n399: \tfor index := snapshotIndex + 1; index <= lastLogIndex; index++ {\n400: \t\tvar entry Log\n401: \t\tif err = logs.GetLog(index, &entry); err != nil {\n402: \t\t\treturn fmt.Errorf(\"failed to get log at index %d: %v\", index, err)\n403: \t\t}\n404: \t\tif entry.Type == LogCommand {\n405: \t\t\t_ = fsm.Apply(&entry)\n406: \t\t}\n407: \t\tlastIndex = entry.Index\n408: \t\tlastTerm = entry.Term\n409: \t}\n410: \n411: \t// Create a new snapshot, placing the configuration in as if it was\n412: \t// committed at index 1.\n413: \tsnapshot, err := fsm.Snapshot()\n414: \tif err != nil {\n415: \t\treturn fmt.Errorf(\"failed to snapshot FSM: %v\", err)\n416: \t}\n417: \tversion := getSnapshotVersion(conf.ProtocolVersion)\n418: \tsink, err := snaps.Create(version, lastIndex, lastTerm, configuration, 1, trans)\n419: \tif err != nil {\n420: \t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n421: \t}\n422: \tif err = snapshot.Persist(sink); err != nil {\n423: \t\treturn fmt.Errorf(\"failed to persist snapshot: %v\", err)\n424: \t}\n425: \tif err = sink.Close(); err != nil {\n426: \t\treturn fmt.Errorf(\"failed to finalize snapshot: %v\", err)\n427: \t}\n428: \n429: \t// Compact the log so that we don't get bad interference from any\n430: \t// configuration change log entries that might be there.\n431: \tfirstLogIndex, err := logs.FirstIndex()\n432: \tif err != nil {\n433: \t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n434: \t}\n435: \tif err := logs.DeleteRange(firstLogIndex, lastLogIndex); err != nil {\n436: \t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n437: \t}\n438: \n439: \treturn nil\n440: }\n441: \n442: // GetConfiguration returns the persisted configuration of the Raft cluster\n443: // without starting a Raft instance or connecting to the cluster. This function\n444: // has identical behavior to Raft.GetConfiguration.\n445: func GetConfiguration(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n","exit_code":0,"status":"completed"}}
