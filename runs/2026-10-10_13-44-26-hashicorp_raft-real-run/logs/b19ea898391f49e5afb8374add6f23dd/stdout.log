  },\n    \"applicability_conditions\": {\n     \"default\": [],\n     \"items\": {\n      \"$ref\": \"#/$defs/Comparison\"\n     },\n     \"title\": \"Applicability Conditions\",\n     \"type\": \"array\"\n    },\n    \"admission_alias\": {\n     \"anyOf\": [\n      {\n       \"type\": \"string\"\n      },\n      {\n       \"type\": \"null\"\n      }\n     ],\n     \"default\": null,\n     \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\",\n     \"title\": \"Admission Alias\"\n    }\n   },\n   \"required\": [\n    \"id\",\n    \"checker_id\",\n    \"event\",\n    \"binding_ids\",\n    \"grounding\"\n   ],\n   \"title\": \"EventMonitor\",\n   \"type\": \"object\"\n  },\n  \"EventRequirement\": {\n   \"additionalProperties\": false,\n   \"properties\": {\n    \"alias\": {\n     \"title\": \"Alias\",\n     \"type\": \"string\"\n    },\n    \"event\": {\n     \"title\": \"Event\",\n     \"type\": \"string\"\n    },\n    \"conditions\": {\n     \"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\",\n     \"items\": {\n      \"$ref\": \"#/$defs/Comparison\"\n     },\n     \"title\": \"Conditions\",\n     \"type\": \"array\"\n    }\n   },\n   \"required\": [\n    \"alias\",\n    \"event\"\n   ],\n   \"title\": \"EventRequirement\",\n   \"type\": \"object\"\n  },\n  \"Grounding\": {\n   \"additionalProperties\": false,\n   \"properties\": {\n    \"source_ids\": {\n     \"description\": \"Exact IDs of acquired implementation source materials; not Behavior or Binding IDs\",\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Source Ids\",\n     \"type\": \"array\"\n    },\n    \"expectation_ids\": {\n     \"description\": \"Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.\",\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Expectation Ids\",\n     \"type\": \"array\"\n    },\n    \"binding_ids\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Binding Ids\",\n     \"type\": \"array\"\n    },\n    \"derivation\": {\n     \"default\": \"\",\n     \"description\": \"This component\\u2019s sourced reasoning; cite accepted IDs instead of repeating their full argument\",\n     \"title\": \"Derivation\",\n     \"type\": \"string\"\n    },\n    \"applicability\": {\n     \"default\": \"\",\n     \"description\": \"Conditions for this component, including any added assumptions or omitted protections\",\n     \"title\": \"Applicability\",\n     \"type\": \"string\"\n    },\n    \"unresolved\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Unresolved\",\n     \"type\": \"array\"\n    },\n    \"conflicts\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Conflicts\",\n     \"type\": \"array\"\n    \n--- ConsensusAuditSpec\n{\n \"$defs\": {\n  \"Activity\": {\n   \"additionalProperties\": false,\n   \"properties\": {\n    \"class_id\": {\n     \"enum\": [\n      \"A1\",\n      \"A2\",\n      \"A3\",\n      \"A4\",\n      \"A5\",\n      \"A6\",\n      \"A7\"\n     ],\n     \"title\": \"Class Id\",\n     \"type\": \"string\"\n    },\n    \"applicability\": {\n     \"enum\": [\n      \"applicable\",\n      \"externalized\",\n      \"not_applicable\",\n      \"unknown\"\n     ],\n     \"title\": \"Applicability\",\n     \"type\": \"string\"\n    },\n    \"purpose\": {\n     \"title\": \"Purpose\",\n     \"type\": \"string\"\n    },\n    \"realization_summary\": {\n     \"title\": \"Realization Summary\",\n     \"type\": \"string\"\n    },\n    \"entry_points\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Entry Points\",\n     \"type\": \"array\"\n    },\n    \"behavior_ids\": {\n     \"description\": \"Derived from Behavior.primary_activity\",\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Behavior Ids\",\n     \"type\": \"array\",\n     \"x-controller-derived\": true\n    },\n    \"variants\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Variants\",\n     \"type\": \"array\"\n    },\n    \"unknowns\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Unknowns\",\n     \"type\": \"array\"\n    },\n    \"source_ids\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Source Ids\",\n     \"type\": \"array\"\n    }\n   },\n   \"required\": [\n    \"class_id\",\n    \"applicability\",\n    \"purpose\",\n    \"realization_summary\"\n   ],\n   \"title\": \"Activity\",\n   \"type\": \"object\"\n  },\n  \"Behavior\": {\n   \"additionalProperties\": false,\n   \"properties\": {\n    \"id\": {\n     \"title\": \"Id\",\n     \"type\": \"string\"\n    },\n    \"primary_activity\": {\n     \"enum\": [\n      \"A1\",\n      \"A2\",\n      \"A3\",\n      \"A4\",\n      \"A5\",\n      \"A6\",\n      \"A7\"\n     ],\n     \"title\": \"Primary Activity\",\n     \"type\": \"string\"\n    },\n    \"execution_owner\": {\n     \"title\": \"Execution Owner\",\n     \"type\": \"string\"\n    },\n    \"protocol_context\": {\n     \"title\": \"Protocol Context\",\n     \"type\": \"string\"\n    },\n    \"trigger\": {\n     \"title\": \"Trigger\",\n     \"type\": \"string\"\n    },\n    \"legal_preconditions\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Legal Preconditions\",\n     \"type\": \"array\"\n    },\n    \"implementation_guards\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Implementation Guards\",\n     \"type\": \"array\"\n    },\n    \"reads\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Reads\",\n     \"type\": \"array\"\n    },\n    \"writes\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Writes\",\n     \"type\": \"array\"\n    },\n    \"durable_effects\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Durable Effects\",\n     \"type\": \"array\"\n    },\n    \"external_effects\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"External Effects\",\n     \"type\": \"array\"\n    },\n    \"important_branches\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Important Branches\",\n     \"type\": \"array\"\n    },\n    \"async_boundaries\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Async Boundaries\",\n     \"type\": \"array\"\n    },\n    \"produces_fact_ids\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Produces Fact Ids\",\n     \"type\": \"array\"\n    },\n    \"consumes_fact_ids\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Consumes Fact Ids\",\n     \"type\": \"array\"\n    },\n    \"cross_activity_effects\": {\n     \"additionalProperties\": {\n      \"type\": \"string\"\n     },\n     \"description\": \"Activity ID to a concrete semantic effect description; not feeds, Behavior IDs or an inferred fact guarantee\",\n     \"propertyNames\": {\n      \"enum\": [\n       \"A1\",\n       \"A2\",\n       \"A3\",\n       \"A4\",\n       \"A5\",\n    \n--- GraphPatch\n{\n \"$defs\": {\n  \"AuditQuestion\": {\n   \"additionalProperties\": false,\n   \"description\": \"Sourced investigation of requirements, protections and history; these may remain unknown.\",\n   \"properties\": {\n    \"audit_spec_version\": {\n     \"anyOf\": [\n      {\n       \"minimum\": 1,\n       \"type\": \"integer\"\n      },\n      {\n       \"type\": \"null\"\n      }\n     ],\n     \"default\": null,\n     \"title\": \"Audit Spec Version\"\n    },\n    \"disposition\": {\n     \"anyOf\": [\n      {\n       \"enum\": [\n        \"explained_by_existing_mechanism\",\n        \"concrete_suspicion\",\n        \"needs_specific_evidence\",\n        \"ready_for_check\"\n       ],\n       \"type\": \"string\"\n      },\n      {\n       \"type\": \"null\"\n      }\n     ],\n     \"default\": null,\n     \"title\": \"Disposition\"\n    },\n    \"preferred_check\": {\n     \"anyOf\": [\n      {\n       \"enum\": [\n        \"source_review\",\n        \"direct_test\",\n        \"controlled_schedule\"\n       ],\n       \"type\": \"string\"\n      },\n      {\n       \"type\": \"null\"\n      }\n     ],\n     \"default\": null,\n     \"title\": \"Preferred Check\"\n    },\n    \"question\": {\n     \"title\": \"Question\",\n     \"type\": \"string\"\n    },\n    \"importance\": {\n     \"default\": \"\",\n     \"title\": \"Importance\",\n     \"type\": \"string\"\n    },\n    \"source_ids\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Source Ids\",\n     \"type\": \"array\"\n    },\n    \"participants\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Participants\",\n     \"type\": \"array\"\n    },\n    \"objects\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Objects\",\n     \"type\": \"array\"\n    },\n    \"contexts\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Contexts\",\n     \"type\": \"array\"\n    },\n    \"event_paths\": {\n     \"default\": [],\n     \"items\": {\n      \"type\": \"string\"\n     },\n 