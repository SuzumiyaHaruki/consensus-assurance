{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"nl -ba agent-source/raft.go | sed -n '1030,1090p'; nl -ba agent-source/future.go | sed -n '250,300p'\"","aggregated_output":"  1030\t}\n  1031\t\n  1032\t// checkLeaderLease is used to check if we can contact a quorum of nodes\n  1033\t// within the last leader lease interval. If not, we need to step down,\n  1034\t// as we may have lost connectivity. Returns the maximum duration without\n  1035\t// contact. This must only be called from the main thread.\n  1036\tfunc (r *Raft) checkLeaderLease() time.Duration {\n  1037\t\t// Track contacted nodes, we can always contact ourself\n  1038\t\tcontacted := 0\n  1039\t\n  1040\t\t// Store lease timeout for this one check invocation as we need to refer to it\n  1041\t\t// in the loop and would be confusing if it ever becomes reloadable and\n  1042\t\t// changes between iterations below.\n  1043\t\tleaseTimeout := r.config().LeaderLeaseTimeout\n  1044\t\n  1045\t\t// Check each follower\n  1046\t\tvar maxDiff time.Duration\n  1047\t\tnow := time.Now()\n  1048\t\tfor _, server := range r.configurations.latest.Servers {\n  1049\t\t\tif server.Suffrage == Voter {\n  1050\t\t\t\tif server.ID == r.localID {\n  1051\t\t\t\t\tcontacted++\n  1052\t\t\t\t\tcontinue\n  1053\t\t\t\t}\n  1054\t\t\t\tf := r.leaderState.replState[server.ID]\n  1055\t\t\t\tdiff := now.Sub(f.LastContact())\n  1056\t\t\t\tif diff <= leaseTimeout {\n  1057\t\t\t\t\tcontacted++\n  1058\t\t\t\t\tif diff > maxDiff {\n  1059\t\t\t\t\t\tmaxDiff = diff\n  1060\t\t\t\t\t}\n  1061\t\t\t\t} else {\n  1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n  1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n  1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1065\t\t\t\t\t} else {\n  1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1067\t\t\t\t\t}\n  1068\t\t\t\t}\n  1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n  1070\t\t\t}\n  1071\t\t}\n  1072\t\n  1073\t\t// Verify we can contact a quorum\n  1074\t\tquorum := r.quorumSize()\n  1075\t\tif contacted < quorum {\n  1076\t\t\tr.logger.Warn(\"failed to contact quorum of nodes, stepping down\")\n  1077\t\t\tr.setState(Follower)\n  1078\t\t\tmetrics.IncrCounter([]string{\"raft\", \"transition\", \"leader_lease_timeout\"}, 1)\n  1079\t\t}\n  1080\t\treturn maxDiff\n  1081\t}\n  1082\t\n  1083\t// quorumSize is used to return the quorum size. This must only be called on\n  1084\t// the main thread.\n  1085\t// TODO: revisit usage\n  1086\tfunc (r *Raft) quorumSize() int {\n  1087\t\tvoters := 0\n  1088\t\tfor _, server := range r.configurations.latest.Servers {\n  1089\t\t\tif server.Suffrage == Voter {\n  1090\t\t\t\tvoters++\n   250\t\n   251\t\tID      *ServerID\n   252\t\tAddress *ServerAddress\n   253\t}\n   254\t\n   255\t// configurationsFuture is used to retrieve the current configurations. This is\n   256\t// used to allow safe access to this information outside of the main thread.\n   257\ttype configurationsFuture struct {\n   258\t\tdeferError\n   259\t\tconfigurations configurations\n   260\t}\n   261\t\n   262\t// Configuration returns the latest configuration in use by Raft.\n   263\tfunc (c *configurationsFuture) Configuration() Configuration {\n   264\t\treturn c.configurations.latest\n   265\t}\n   266\t\n   267\t// Index returns the index of the latest configuration in use by Raft.\n   268\tfunc (c *configurationsFuture) Index() uint64 {\n   269\t\treturn c.configurations.latestIndex\n   270\t}\n   271\t\n   272\t// vote is used to respond to a verifyFuture.\n   273\t// This may block when responding on the notifyCh.\n   274\tfunc (v *verifyFuture) vote(leader bool) {\n   275\t\tv.voteLock.Lock()\n   276\t\tdefer v.voteLock.Unlock()\n   277\t\n   278\t\t// Guard against having notified already\n   279\t\tif v.notifyCh == nil {\n   280\t\t\treturn\n   281\t\t}\n   282\t\n   283\t\tif leader {\n   284\t\t\tv.votes++\n   285\t\t\tif v.votes >= v.quorumSize {\n   286\t\t\t\tv.notifyCh <- v\n   287\t\t\t\tv.notifyCh = nil\n   288\t\t\t}\n   289\t\t} else {\n   290\t\t\tv.notifyCh <- v\n   291\t\t\tv.notifyCh = nil\n   292\t\t}\n   293\t}\n   294\t\n   295\t// appendFuture is used for waiting on a pipelined append\n   296\t// entries RPC.\n   297\ttype appendFuture struct {\n   298\t\tdeferError\n   299\t\tstart time.Time\n   300\t\targs  *AppendEntriesRequest\n","exit_code":0,"status":"completed"}}
