{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"nl -ba agent-source/raft.go | sed -n '580,660p;760,840p;860,940p;960,1000p;1045,1070p'\"","aggregated_output":"   580\t// it'll instruct the replication routines to try to replicate to the current\n   581\t// index. This must only be called from the main thread.\n   582\tfunc (r *Raft) startStopReplication() {\n   583\t\tinConfig := make(map[ServerID]bool, len(r.configurations.latest.Servers))\n   584\t\tlastIdx := r.getLastIndex()\n   585\t\n   586\t\t// Start replication goroutines that need starting\n   587\t\tfor _, server := range r.configurations.latest.Servers {\n   588\t\t\tif server.ID == r.localID {\n   589\t\t\t\tcontinue\n   590\t\t\t}\n   591\t\n   592\t\t\tinConfig[server.ID] = true\n   593\t\n   594\t\t\ts, ok := r.leaderState.replState[server.ID]\n   595\t\t\tif !ok {\n   596\t\t\t\tr.logger.Info(\"added peer, starting replication\", \"peer\", server.ID)\n   597\t\t\t\ts = &followerReplication{\n   598\t\t\t\t\tpeer:                server,\n   599\t\t\t\t\tcommitment:          r.leaderState.commitment,\n   600\t\t\t\t\tstopCh:              make(chan uint64, 1),\n   601\t\t\t\t\ttriggerCh:           make(chan struct{}, 1),\n   602\t\t\t\t\ttriggerDeferErrorCh: make(chan *deferError, 1),\n   603\t\t\t\t\tcurrentTerm:         r.getCurrentTerm(),\n   604\t\t\t\t\tnextIndex:           lastIdx + 1,\n   605\t\t\t\t\tlastContact:         time.Now(),\n   606\t\t\t\t\tnotify:              make(map[*verifyFuture]struct{}),\n   607\t\t\t\t\tnotifyCh:            make(chan struct{}, 1),\n   608\t\t\t\t\tstepDown:            r.leaderState.stepDown,\n   609\t\t\t\t}\n   610\t\n   611\t\t\t\tr.leaderState.replState[server.ID] = s\n   612\t\t\t\tr.goFunc(func() { r.replicate(s) })\n   613\t\t\t\tasyncNotifyCh(s.triggerCh)\n   614\t\t\t\tr.observe(PeerObservation{Peer: server, Removed: false})\n   615\t\t\t} else if ok {\n   616\t\n   617\t\t\t\ts.peerLock.RLock()\n   618\t\t\t\tpeer := s.peer\n   619\t\t\t\ts.peerLock.RUnlock()\n   620\t\n   621\t\t\t\tif peer.Address != server.Address {\n   622\t\t\t\t\tr.logger.Info(\"updating peer\", \"peer\", server.ID)\n   623\t\t\t\t\ts.peerLock.Lock()\n   624\t\t\t\t\ts.peer = server\n   625\t\t\t\t\ts.peerLock.Unlock()\n   626\t\t\t\t}\n   627\t\t\t}\n   628\t\t}\n   629\t\n   630\t\t// Stop replication goroutines that need stopping\n   631\t\tfor serverID, repl := range r.leaderState.replState {\n   632\t\t\tif inConfig[serverID] {\n   633\t\t\t\tcontinue\n   634\t\t\t}\n   635\t\t\t// Replicate up to lastIdx and stop\n   636\t\t\tr.logger.Info(\"removed peer, stopping replication\", \"peer\", serverID, \"last-index\", lastIdx)\n   637\t\t\trepl.stopCh <- lastIdx\n   638\t\t\tclose(repl.stopCh)\n   639\t\t\tdelete(r.leaderState.replState, serverID)\n   640\t\t\tr.observe(PeerObservation{Peer: repl.peer, Removed: true})\n   641\t\t}\n   642\t\n   643\t\t// Update peers metric\n   644\t\tmetrics.SetGauge([]string{\"raft\", \"peers\"}, float32(len(r.configurations.latest.Servers)))\n   645\t}\n   646\t\n   647\t// configurationChangeChIfStable returns r.configurationChangeCh if it's safe\n   648\t// to process requests from it, or nil otherwise. This must only be called\n   649\t// from the main thread.\n   650\t//\n   651\t// Note that if the conditions here were to change outside of leaderLoop to take\n   652\t// this from nil to non-nil, we would need leaderLoop to be kicked.\n   653\tfunc (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n   654\t\t// Have to wait until:\n   655\t\t// 1. The latest configuration is committed, and\n   656\t\t// 2. This leader has committed some entry (the noop) in this term\n   657\t\t//    https://groups.google.com/forum/#!msg/raft-dev/t4xj6dJTP6E/d2D9LrWRza8J\n   658\t\tif r.configurations.latestIndex == r.configurations.committedIndex &&\n   659\t\t\tr.getCommitIndex() >= r.leaderState.commitment.startIndex {\n   660\t\t\treturn r.configurationChangeCh\n   760\t\n   761\t\t\t\t// leaderState.replState is accessed here before\n   762\t\t\t\t// starting leadership transfer asynchronously because\n   763\t\t\t\t// leaderState is only supposed to be accessed in the\n   764\t\t\t\t// leaderloop.\n   765\t\t\t\tid := future.ID\n   766\t\t\t\taddress := future.Address\n   767\t\t\t\tif id == nil {\n   768\t\t\t\t\ts := r.pickServer()\n   769\t\t\t\t\tif s != nil {\n   770\t\t\t\t\t\tid = &s.ID\n   771\t\t\t\t\t\taddress = &s.Address\n   772\t\t\t\t\t} else {\n   773\t\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find peer\")\n   774\t\t\t\t\t\tcontinue\n   775\t\t\t\t\t}\n   776\t\t\t\t}\n   777\t\t\t\tstate, ok := r.leaderState.replState[*id]\n   778\t\t\t\tif !ok {\n   779\t\t\t\t\tdoneCh <- fmt.Errorf(\"cannot find replication state for %v\", id)\n   780\t\t\t\t\tcontinue\n   781\t\t\t\t}\n   782\t\t\t\tr.setLeadershipTransferInProgress(true)\n   783\t\t\t\tgo r.leadershipTransfer(*id, *address, state, stopCh, doneCh)\n   784\t\n   785\t\t\tcase <-r.leaderState.commitCh:\n   786\t\t\t\tr.mainThreadSaturation.working()\n   787\t\t\t\t// Process the newly committed entries\n   788\t\t\t\toldCommitIndex := r.getCommitIndex()\n   789\t\t\t\tcommitIndex := r.leaderState.commitment.getCommitIndex()\n   790\t\t\t\tr.setCommitIndex(commitIndex)\n   791\t\n   792\t\t\t\t// New configuration has been committed, set it as the committed\n   793\t\t\t\t// value.\n   794\t\t\t\tif r.configurations.latestIndex > oldCommitIndex &&\n   795\t\t\t\t\tr.configurations.latestIndex <= commitIndex {\n   796\t\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n   797\t\t\t\t\tif !hasVote(r.configurations.committed, r.localID) {\n   798\t\t\t\t\t\tstepDown = true\n   799\t\t\t\t\t}\n   800\t\t\t\t}\n   801\t\n   802\t\t\t\tstart := time.Now()\n   803\t\t\t\tvar groupReady []*list.Element\n   804\t\t\t\tgroupFutures := make(map[uint64]*logFuture)\n   805\t\t\t\tvar lastIdxInGroup uint64\n   806\t\n   807\t\t\t\t// Pull all inflight logs that are committed off the queue.\n   808\t\t\t\tfor e := r.leaderState.inflight.Front(); e != nil; e = e.Next() {\n   809\t\t\t\t\tcommitLog := e.Value.(*logFuture)\n   810\t\t\t\t\tidx := commitLog.log.Index\n   811\t\t\t\t\tif idx > commitIndex {\n   812\t\t\t\t\t\t// Don't go past the committed index\n   813\t\t\t\t\t\tbreak\n   814\t\t\t\t\t}\n   815\t\n   816\t\t\t\t\t// Measure the commit time\n   817\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"commitTime\"}, commitLog.dispatch)\n   818\t\t\t\t\tgroupReady = append(groupReady, e)\n   819\t\t\t\t\tgroupFutures[idx] = commitLog\n   820\t\t\t\t\tlastIdxInGroup = idx\n   821\t\t\t\t}\n   822\t\n   823\t\t\t\t// Process the group\n   824\t\t\t\tif len(groupReady) != 0 {\n   825\t\t\t\t\tr.processLogs(lastIdxInGroup, groupFutures)\n   826\t\n   827\t\t\t\t\tfor _, e := range groupReady {\n   828\t\t\t\t\t\tr.leaderState.inflight.Remove(e)\n   829\t\t\t\t\t}\n   830\t\t\t\t}\n   831\t\n   832\t\t\t\t// Measure the time to enqueue batch of logs for FSM to apply\n   833\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"enqueue\"}, start)\n   834\t\n   835\t\t\t\t// Count the number of logs enqueued\n   836\t\t\t\tmetrics.SetGauge([]string{\"raft\", \"commitNumLogs\"}, float32(len(groupReady)))\n   837\t\n   838\t\t\t\tif stepDown {\n   839\t\t\t\t\tif r.config().ShutdownOnRemove {\n   840\t\t\t\t\t\tr.logger.Info(\"removed ourself, shutting down\")\n   860\t\t\t\t\t}\n   861\t\t\t\t\tv.respond(ErrNotLeader)\n   862\t\n   863\t\t\t\t} else {\n   864\t\t\t\t\t// Quorum of members agree, we are still leader\n   865\t\t\t\t\tdelete(r.leaderState.notify, v)\n   866\t\t\t\t\tfor _, repl := range r.leaderState.replState {\n   867\t\t\t\t\t\trepl.cleanNotify(v)\n   868\t\t\t\t\t}\n   869\t\t\t\t\tv.respond(nil)\n   870\t\t\t\t}\n   871\t\n   872\t\t\tcase future := <-r.userRestoreCh:\n   873\t\t\t\tr.mainThreadSaturation.working()\n   874\t\t\t\tif r.getLeadershipTransferInProgress() {\n   875\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   876\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   877\t\t\t\t\tcontinue\n   878\t\t\t\t}\n   879\t\t\t\terr := r.restoreUserSnapshot(future.meta, future.reader)\n   880\t\t\t\tfuture.respond(err)\n   881\t\n   882\t\t\tcase future := <-r.configurationsCh:\n   883\t\t\t\tr.mainThreadSaturation.working()\n   884\t\t\t\tif r.getLeadershipTransferInProgress() {\n   885\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   886\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   887\t\t\t\t\tcontinue\n   888\t\t\t\t}\n   889\t\t\t\tfuture.configurations = r.configurations.Clone()\n   890\t\t\t\tfuture.respond(nil)\n   891\t\n   892\t\t\tcase future := <-r.configurationChangeChIfStable():\n   893\t\t\t\tr.mainThreadSaturation.working()\n   894\t\t\t\tif r.getLeadershipTransferInProgress() {\n   895\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   896\t\t\t\t\tfuture.respond(ErrLeadershipTransferInProgress)\n   897\t\t\t\t\tcontinue\n   898\t\t\t\t}\n   899\t\t\t\tr.appendConfigurationEntry(future)\n   900\t\n   901\t\t\tcase b := <-r.bootstrapCh:\n   902\t\t\t\tr.mainThreadSaturation.working()\n   903\t\t\t\tb.respond(ErrCantBootstrap)\n   904\t\n   905\t\t\tcase newLog := <-r.applyCh:\n   906\t\t\t\tr.mainThreadSaturation.working()\n   907\t\t\t\tif r.getLeadershipTransferInProgress() {\n   908\t\t\t\t\tr.logger.Debug(ErrLeadershipTransferInProgress.Error())\n   909\t\t\t\t\tnewLog.respond(ErrLeadershipTransferInProgress)\n   910\t\t\t\t\tcontinue\n   911\t\t\t\t}\n   912\t\t\t\t// Group commit, gather all the ready commits\n   913\t\t\t\tready := []*logFuture{newLog}\n   914\t\t\tGROUP_COMMIT_LOOP:\n   915\t\t\t\tfor i := 0; i < r.config().MaxAppendEntries; i++ {\n   916\t\t\t\t\tselect {\n   917\t\t\t\t\tcase newLog := <-r.applyCh:\n   918\t\t\t\t\t\tready = append(ready, newLog)\n   919\t\t\t\t\tdefault:\n   920\t\t\t\t\t\tbreak GROUP_COMMIT_LOOP\n   921\t\t\t\t\t}\n   922\t\t\t\t}\n   923\t\n   924\t\t\t\t// Dispatch the logs\n   925\t\t\t\tif stepDown {\n   926\t\t\t\t\t// we're in the process of stepping down as leader, don't process anything new\n   927\t\t\t\t\tfor i := range ready {\n   928\t\t\t\t\t\tready[i].respond(ErrNotLeader)\n   929\t\t\t\t\t}\n   930\t\t\t\t} else {\n   931\t\t\t\t\tr.dispatchLogs(ready)\n   932\t\t\t\t}\n   933\t\n   934\t\t\tcase <-lease:\n   935\t\t\t\tr.mainThreadSaturation.working()\n   936\t\t\t\t// Check if we've exceeded the lease, potentially stepping down\n   937\t\t\t\tmaxDiff := r.checkLeaderLease()\n   938\t\n   939\t\t\t\t// Next check interval should adjust for the last node we've\n   940\t\t\t\t// contacted, without going negative\n   960\t\t}\n   961\t}\n   962\t\n   963\t// verifyLeader must be called from the main thread for safety.\n   964\t// Causes the followers to attempt an immediate heartbeat.\n   965\tfunc (r *Raft) verifyLeader(v *verifyFuture) {\n   966\t\t// Current leader always votes for self\n   967\t\tv.votes = 1\n   968\t\n   969\t\t// Set the quorum size, hot-path for single node\n   970\t\tv.quorumSize = r.quorumSize()\n   971\t\tif v.quorumSize == 1 {\n   972\t\t\tv.respond(nil)\n   973\t\t\treturn\n   974\t\t}\n   975\t\n   976\t\t// Track this request\n   977\t\tv.notifyCh = r.verifyCh\n   978\t\tr.leaderState.notify[v] = struct{}{}\n   979\t\n   980\t\t// Trigger immediate heartbeats\n   981\t\tfor _, repl := range r.leaderState.replState {\n   982\t\t\trepl.notifyLock.Lock()\n   983\t\t\trepl.notify[v] = struct{}{}\n   984\t\t\trepl.notifyLock.Unlock()\n   985\t\t\tasyncNotifyCh(repl.notifyCh)\n   986\t\t}\n   987\t}\n   988\t\n   989\t// leadershipTransfer is doing the heavy lifting for the leadership transfer.\n   990\tfunc (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n   991\t\t// make sure we are not already stopped\n   992\t\tselect {\n   993\t\tcase <-stopCh:\n   994\t\t\tdoneCh <- nil\n   995\t\t\treturn\n   996\t\tdefault:\n   997\t\t}\n   998\t\n   999\t\tfor atomic.LoadUint64(&repl.nextIndex) <= r.getLastIndex() {\n  1000\t\t\terr := &deferError{}\n  1045\t\t// Check each follower\n  1046\t\tvar maxDiff time.Duration\n  1047\t\tnow := time.Now()\n  1048\t\tfor _, server := range r.configurations.latest.Servers {\n  1049\t\t\tif server.Suffrage == Voter {\n  1050\t\t\t\tif server.ID == r.localID {\n  1051\t\t\t\t\tcontacted++\n  1052\t\t\t\t\tcontinue\n  1053\t\t\t\t}\n  1054\t\t\t\tf := r.leaderState.replState[server.ID]\n  1055\t\t\t\tdiff := now.Sub(f.LastContact())\n  1056\t\t\t\tif diff <= leaseTimeout {\n  1057\t\t\t\t\tcontacted++\n  1058\t\t\t\t\tif diff > maxDiff {\n  1059\t\t\t\t\t\tmaxDiff = diff\n  1060\t\t\t\t\t}\n  1061\t\t\t\t} else {\n  1062\t\t\t\t\t// Log at least once at high value, then debug. Otherwise it gets very verbose.\n  1063\t\t\t\t\tif diff <= 3*leaseTimeout {\n  1064\t\t\t\t\t\tr.logger.Warn(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1065\t\t\t\t\t} else {\n  1066\t\t\t\t\t\tr.logger.Debug(\"failed to contact\", \"server-id\", server.ID, \"time\", diff)\n  1067\t\t\t\t\t}\n  1068\t\t\t\t}\n  1069\t\t\t\tmetrics.AddSample([]string{\"raft\", \"leader\", \"lastContact\"}, float32(diff/time.Millisecond))\n  1070\t\t\t}\n","exit_code":0,"status":"completed"}}
