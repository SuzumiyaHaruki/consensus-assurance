\": {\n  \"additionalProperties\": false,\n  \"properties\": {\n   \"rationale\": {\n    \"minLength\": 1,\n    \"title\": \"Rationale\",\n    \"type\": \"string\"\n   },\n   \"sources\": {\n    \"default\": [],\n    \"items\": {\n     \"$ref\": \"#/$defs/SourceRange\"\n    },\n    \"title\": \"Sources\",\n    \"type\": \"array\"\n   },\n   \"feedback\": {\n    \"anyOf\": [\n     {\n      \"$ref\": \"#/$defs/ResearchFeedback\"\n     },\n     {\n      \"type\": \"null\"\n     }\n    ],\n    \"default\": null\n   },\n   \"review\": {\n    \"anyOf\": [\n     {\n      \"$ref\": \"#/$defs/ResultReview\"\n     },\n     {\n      \"type\": \"null\"\n     }\n    ],\n    \"default\": null\n   },\n   \"map_path\": {\n    \"anyOf\": [\n     {\n      \"type\": \"string\"\n     },\n     {\n      \"type\": \"null\"\n     }\n    ],\n    \"default\": null,\n    \"title\": \"Map Path\"\n   },\n   \"map_changes\": {\n    \"additionalProperties\": {\n     \"$ref\": \"#/$defs/UnderstandingChange\"\n    },\n    \"default\": {},\n    \"title\": \"Map Changes\",\n    \"type\": \"object\"\n   },\n   \"repair_of\": {\n    \"anyOf\": [\n     {\n      \"type\": \"string\"\n     },\n     {\n      \"type\": \"null\"\n     }\n    ],\n    \"default\": null,\n    \"description\": \"Retained rejected operation whose draft this submission repairs\",\n    \"title\": \"Repair Of\"\n   },\n   \"action\": {\n    \"const\": \"research\",\n    \"title\": \"Action\",\n    \"type\": \"string\"\n   }\n  },\n  \"required\": [\n   \"rationale\",\n   \"action\"\n  ],\n  \"title\": \"ResearchSubmission\",\n  \"type\": \"object\"\n },\n \"ResultReview\": {\n  \"additionalProperties\": false,\n  \"properties\": {\n   \"artifact_id\": {\n    \"title\": \"Artifact Id\",\n    \"type\": \"string\"\n   },\n   \"review_items\": {\n    \"items\": {\n     \"$ref\": \"#/$defs/ArtifactReviewItem\"\n    },\n    \"minItems\": 1,\n    \"title\": \"Review Items\",\n    \"type\": \"array\"\n   },\n   \"resolutions\": {\n    \"def