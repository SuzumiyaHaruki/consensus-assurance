{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"nl -ba agent-source/api.go | sed -n '850,900p'; nl -ba agent-source/configuration.go | sed -n '1,60p'\"","aggregated_output":"   850\t\t\treturn logFuture\n   851\t\t}\n   852\t}\n   853\t\n   854\t// Barrier is used to issue a command that blocks until all preceding\n   855\t// operations have been applied to the FSM. It can be used to ensure the\n   856\t// FSM reflects all queued writes. An optional timeout can be provided to\n   857\t// limit the amount of time we wait for the command to be started. This\n   858\t// must be run on the leader, or it will fail.\n   859\tfunc (r *Raft) Barrier(timeout time.Duration) Future {\n   860\t\tmetrics.IncrCounter([]string{\"raft\", \"barrier\"}, 1)\n   861\t\tvar timer <-chan time.Time\n   862\t\tif timeout > 0 {\n   863\t\t\ttimer = time.After(timeout)\n   864\t\t}\n   865\t\n   866\t\t// Create a log future, no index or term yet\n   867\t\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\n   868\t\tlogFuture.init()\n   869\t\n   870\t\tselect {\n   871\t\tcase <-timer:\n   872\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   873\t\tcase <-r.shutdownCh:\n   874\t\t\treturn errorFuture{ErrRaftShutdown}\n   875\t\tcase r.applyCh <- logFuture:\n   876\t\t\treturn logFuture\n   877\t\t}\n   878\t}\n   879\t\n   880\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   881\t// to prevent returning stale data from the FSM after the peer has lost\n   882\t// leadership.\n   883\tfunc (r *Raft) VerifyLeader() Future {\n   884\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   885\t\tverifyFuture := &verifyFuture{}\n   886\t\tverifyFuture.init()\n   887\t\tselect {\n   888\t\tcase <-r.shutdownCh:\n   889\t\t\treturn errorFuture{ErrRaftShutdown}\n   890\t\tcase r.verifyCh <- verifyFuture:\n   891\t\t\treturn verifyFuture\n   892\t\t}\n   893\t}\n   894\t\n   895\t// GetConfiguration returns the latest configuration. This may not yet be\n   896\t// committed. The main loop can access this directly.\n   897\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n   898\t\tconfigReq := &configurationsFuture{}\n   899\t\tconfigReq.init()\n   900\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\ttype nopConfigurationStore struct{}\n    55\t\n    56\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n    57\t\n    58\t// ServerID is a unique string identifying a server for all time.\n    59\ttype ServerID string\n    60\t\n","exit_code":0,"status":"completed"}}
