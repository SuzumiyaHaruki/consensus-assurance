ired\": [\n    \"question\"\n   ],\n   \"title\": \"AuditQuestion\",\n   \"type\": \"object\"\n  },\n  \"BindingAssociation\": {\n   \"additionalProperties\": false,\n   \"properties\": {\n    \"claim_id\": {\n     \"title\": \"Claim Id\",\n     \"type\": \"string\"\n    },\n    \"source_ids\": {\n     \"items\": {\n      \"type\": \"string\"\n     },\n     \"title\": \"Source Ids\",\n     \"type\": \"array\"\n    },\n    \"rationale\": {\n     \"ti\n","exit_code":0,"status":"completed"}}
