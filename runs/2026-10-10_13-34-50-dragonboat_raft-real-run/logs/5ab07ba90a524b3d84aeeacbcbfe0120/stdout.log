      \"origin\"\n    ],\n    \"description\": \"The ReadyToRead context at a follower equals that follower operation's leader-admitted context. There is exactly one request per originating follower.\"\n  }\n]\n   322\t\n   323\tfunc (p *Peer) getUpdate(moreToApply bool, lastApplied uint64) pb.Update {\n   324\t\tud := pb.Update{\n   325\t\t\tClusterID:     p.raft.clusterID,\n   326\t\t\tNodeID:        p.raft.nodeID,\n   327\t\t\tEntriesToSave: p.entryLog().entriesToSave(),\n   328\t\t\tMessages:      p.raft.msgs,\n   329\t\t\tLastApplied:   lastApplied,\n   330\t\t\tFastApply:     true,\n   331\t\t}\n   332\t\tfor idx := range ud.Messages {\n   333\t\t\tud.Messages[idx].ClusterId = p.raft.clusterID\n   334\t\t}\n   335\t\tif moreToApply {\n   336\t\t\tud.CommittedEntries = p.entryLog().entriesToApply()\n   337\t\t}\n   338\t\tif len(ud.CommittedEntries) > 0 {\n   339\t\t\tlastIndex := ud.CommittedEntries[len(ud.CommittedEntries)-1].Index\n   340\t\t\tud.MoreCommittedEntries = p.entryLog().hasMoreEntriesToApply(lastIndex)\n   341\t\t}\n   342\t\tif pst := p.raft.raftState(); !pb.IsStateEqual(pst, p.prevState) {\n   343\t\t\tud.State = pst\n   344\t\t}\n   345\t\tif p.entryLog().inmem.snapshot != nil {\n   346\t\t\tud.Snapshot = *p.entryLog().inmem.snapshot\n   347\t\t}\n   348\t\tif len(p.raft.readyToRead) > 0 {\n   349\t\t\tud.ReadyToReads = p.raft.readyToRead\n   350\t\t}\n   351\t\tif len(p.raft.droppedEntries) > 0 {\n   352\t\t\tud.DroppedEntries = p.raft.droppedEntries\n   353\t\t}\n   354\t\tif len(p.raft.droppedReadIndexes) > 0 {\n   355\t\t\tud.DroppedReadIndexes = p.raft.droppedReadIndexes\n   356\t\t}\n   357\t\treturn ud\n   815\tfunc (r *raft) sendHeartbeatMessage(to uint64,\n   816\t\thint pb.SystemCtx, match uint64) {\n   817\t\tcommit := min(match, r.log.committed)\n   818\t\tr.send(pb.Message{\n   819\t\t\tTo:       to,\n   820\t\t\tType:     pb.Heartbeat,\n   821\t\t\tCommit:   commit,\n   822\t\t\tHint:     hint.Low,\n   823\t\t\tHintHigh: hint.High,\n   824\t\t})\n   825\t}\n   826\t\n   827\t// p72 of the raft thesis describe how to use Heartbeat message in the ReadIndex\n   828\t// protocol.\n   829\tfunc (r *raft) broadcastHeartbeatMessage() {\n   830\t\tr.mustBeLeader()\n   831\t\tif r.readIndex.hasPendingRequest() {\n   832\t\t\tctx := r.readIndex.peepCtx()\n   833\t\t\tr.broadcastHeartbeatMessageWithHint(ctx)\n   834\t\t} else {\n   835\t\t\tr.broadcastHeartbeatMessageWithHint(pb.SystemCtx{})\n   836\t\t}\n   837\t}\n   838\t\n   839\tfunc (r *raft) broadcastHeartbeatMessageWithHint(ctx pb.SystemCtx) {\n   840\t\tzeroCtx := pb.SystemCtx{}\n   841\t\tfor id, rm := range r.votingMembers() {\n   842\t\t\tif id != r.nodeID {\n   843\t\t\t\tr.sendHeartbeatMessage(id, ctx, rm.match)\n   844\t\t\t}\n   845\t\t}\n   846\t\tif ctx == zeroCtx {\n   847\t\t\tfor id, rm := range r.observers {\n   848\t\t\t\tr.sendHeartbeatMessage(id, zeroCtx, rm.match)\n   849\t\t\t}\n   850\t\t}\n   851\t}\n  1728\tfunc (r *raft) handleLeaderHeartbeatResp(m pb.Message, rp *remote) {\n  1729\t\tr.mustBeLeader()\n  1730\t\trp.setActive()\n  1731\t\trp.waitToRetry()\n  1732\t\tif rp.match < r.log.lastIndex() {\n  1733\t\t\tr.sendReplicateMessage(m.From)\n  1734\t\t}\n  1735\t\t// heartbeat response contains leadership confirmation requested as part of\n  1736\t\t// the ReadIndex protocol.\n  1737\t\tif m.Hint != 0 {\n  1738\t\t\tr.handleReadIndexLeaderConfirmation(m)\n  1739\t\t}\n  1740\t}\n  1741\t\n  2079\tfunc lw(r *raft, f func(m pb.Message, rp *remote)) handlerFunc {\n  2080\t\tw := func(nm pb.Message) {\n  2081\t\t\tif npr, ok := r.remotes[nm.From]; ok {\n  2082\t\t\t\tf(nm, npr)\n  2083\t\t\t} else if nob, ok := r.observers[nm.From]; ok {\n  2084\t\t\t\tf(nm, nob)\n  2085\t\t\t} else if wob, ok := r.witnesses[nm.From]; ok {\n  2086\t\t\t\tf(nm, wob)\n  2087\t\t\t} else {\n  2088\t\t\t\tplog.Warningf(\"%s no remote for %s\", r.describe(), NodeID(nm.From))\n  2089\t\t\t\treturn\n  2090\t\t\t}\n  2091\t\t}\n  2092\t\treturn w\n  2093\t}\n  2094\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nsources=[dict(id='peer_update_export',file='internal/raft/peer.go',start_line=323,end_line=358,kind='code_observation'),dict(id='heartbeat_retry_context',file='internal/raft/raft.go',start_line=815,end_line=851,kind='code_observation')]\nids=['peer_bootstrap','peer_bootstrap_entries','peer_read_api','peer_admission','term_admission','commit_quorum','election_config_guard','test_log_storage','loss_permitted','read_batch','read_confirmation','read_forward_consume','read_client_matching','batch_context_expectation','follower_context_expectation','peer_update_export','heartbeat_producer','heartbeat_retry_context']\nreason='Reviewed the fixed v2 plan and harness at direct-checks/c35c44a8b95242108a8c95d2c000f266 against completed CheckRun b74acd29ff6545e8b658b079dc9a48c4 (exit 0). The requirement follows from per-request ctx retention and batch_context_expectation, with exact-context lookup in pendingReadIndex.addReady making response identity necessary. Launch and bootstrap create all three voting members and initial entries; updates are appended and State saved before outbound delivery; actual committed configuration entries are applied. Real ticks, votes, no-op replication and NotifyRaftLastApplied establish term 2 and commit/applied 4. The fixture does not overwrite votes, commitment, read pending objects, handlers or quorum state. Peer.ReadIndex permits the supplied distinct nonzero contexts. The only transport fault is loss of two first-context heartbeats, which is permitted by the transport send-failure paths; delivered messages are FIFO. In one synchronous history, prefix event 0 names origin 2 and actual follower readiness, admission event 4 reads its actual pending readStatus context 101/30, and event 14 reads actual GetUpdate.ReadyToReads context 202/30 before Commit clears it. The response at event 13 was produced by the real confirmation handler after actual heartbeat acknowledgments. Identity is scenario plus origin; exactly one operation is issued per origin, and context is only the compared value. The control origin 3 independently associates prefix 1, admission 10 and result 16, retaining 202/30. These match the recorded monitor correlations, with no parse loss or missing results. Term and membership remain stable by the fixed driver and endpoint observations. This establishes the local context-substitution defect; the test process passing is not the basis of the verdict.'\nlimits=['No NodeHost RequestState completion, timeout deadline or application read value was measured; these are separate consequences and cannot change the observed Peer-level context mismatch.','The three extra heartbeat ticks establish only bounded non-recovery in this run, not permanent stalling.','The predecessor direct check remains unknown because its fixed prefix lacked origin.','Human offline review retains final defect validity, CFT relevance and deduplication.']\nsub=dict(action='research',rationale='Complete source and execution correspondence for the successor context-preservation check and resolve only the repaired prerequisite-identity issue.',sources=sources,feedback=dict(ref_ids=['b74acd29ff6545e8b658b079dc9a48c4','a1fee788ac024b05a95115b9ce50fdef'],answered='The fresh successor has a complete local violating witness: origin 2 admitted context 101/30 (event 4), then received ReadyToRead 202/30 (event 14), linked to its own completed prefix (event 0). Origin 3 correctly retained 202/30 (events 1,10,16). Leader batching removes both pending entries, and its remote response branch uses m.Hint/m.HintHigh instead of each s.ctx. The inspected source consumer cannot match the substituted context to origin 2 original batch.',remaining=['Client-level timeout consequences remain unexecuted and are not needed for this local context-preservation finding.','Continue source investigation of consensus authority and membership-transition protections.'],rationale='Evidence is the exact fresh CheckRun, fixed bytes, source branches and independently correlated events, not the predecessor raw values or process success.',question_updates={'b4f1a4d97742470b8148df31692f8215':dict(unknowns=['Client-level consequences beyond Peer ReadyToRead have not been executed.'],resume_conditions=['A separate question about client deadlines or stale reads needs its own endpoint and applicable contract.'])}),review=dict(artifact_id='a1fee788ac024b05a95115b9ce50fdef',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ids,rationale=reason,counterevidence=['Origin 3 retains its admitted context; the bug affects earlier forwarded reads completed under another request context.','Local leader read completion uses s.ctx and is not shown defective.','Peer sender-membership and message-term guards remain enabled.'],limitations=limits)],resolutions=[dict(issue_id='80f35be38a854348bc5e39599365f455',source_ids=['peer_bootstrap','peer_bootstrap_entries','peer_update_export','read_confirmation','read_forward_consume','read_client_matching','batch_context_expectation'],evidence_ids=['a1fee788ac024b05a95115b9ce50fdef','b74acd29ff6545e8b658b079dc9a48c4'],rationale='The successor adds origin to each real pre-request prefix sample and explicitly links admission.origin to prefix.origin. Fresh events 0/4/14 and 1/10/16 now form independent complete chains; recorded correlations match this fixed harness control flow. This resolves the missing-prefix-origin gap for the successor only and does not repair or confirm predecessor e8bbf4cc81854e38ba62ef52c237419c. The earlier listed counterevidence is preserved: origin 3 and the local branch are correct because they use their own context, which does not negate the earlier remote request mismatch.',residual_issue_ids=[],scope_limitations=limits)]))\nPath('readindex_review.json').write_text(json.dumps(sub,indent=2)+'\\\\n')\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-10_13-34-50-dragonboat_raft-real-run --submission readindex_review.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
