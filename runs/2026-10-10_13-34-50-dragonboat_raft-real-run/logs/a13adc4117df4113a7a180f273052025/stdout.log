\n  1126\t\t\t\tLogTerm:  r.log.lastTerm(),\n  1127\t\t\t\tHint:     hint,\n  1128\t\t\t})\n  1129\t\t\tplog.Warningf(\"%s sent RequestVote to %s\", r.describe(), NodeID(k))\n  1130\t\t}\n  1131\t}\n  1132\t\n  1133\t//\n  1134\t// membership management\n  1135\t//\n  1136\t\n  1196\tfunc (r *raft) removeNode(nodeID uint64) {\n  1197\t\tr.deleteRemote(nodeID)\n  1198\t\tr.deleteObserver(nodeID)\n  1199\t\tr.deleteWitness(nodeID)\n  1200\t\tr.clearPendingConfigChange()\n  1201\t\t// step down as leader once it is removed\n  1202\t\tif r.nodeID == nodeID && r.isLeader() {\n  1203\t\t\tr.becomeFollower(r.term, NoLeader)\n  1204\t\t}\n  1205\t\tif r.leaderTransfering() && r.leaderTransferTarget == nodeID {\n  1206\t\t\tr.abortLeaderTransfer()\n  1207\t\t}\n  1208\t\tif r.isLeader() && r.numVotingMembers() > 0 {\n  1209\t\t\tif r.tryCommit() {\n  1210\t\t\t\tr.broadcastReplicateMessage()\n  1211\t\t\t}\n  1212\t\t}\n  1213\t}\n  1214\t\n  1215\tfunc (r *raft) deleteRemote(nodeID uint64) {\n  1216\t\tdelete(r.remotes, nodeID)\n  1217\t}\n  1218\t\n  1219\tfunc (r *raft) deleteObserver(nodeID uint64) {\n  1220\t\tdelete(r.observers, nodeID)\n  1221\t}\n  1222\t\n  1223\tfunc (r *raft) deleteWitness(nodeID uint64) {\n  1224\t\tdelete(r.witnesses, nodeID)\n  1225\t}\n  1273\t\n  1274\tfunc (n *node) handleReceivedMessages() bool {\n  1275\t\tcount := uint64(0)\n  1276\t\tbusy := n.isBusySnapshotting()\n  1277\t\tmsgs := n.mq.Get()\n  1278\t\tfor _, m := range msgs {\n  1279\t\t\tif m.Type == pb.LocalTick {\n  1280\t\t\t\tcount++\n  1281\t\t\t} else if m.Type == pb.Replicate && busy {\n  1282\t\t\t\tcontinue\n  1283\t\t\t}\n  1284\t\t\tif done := n.handleMessage(m); !done {\n  1285\t\t\t\tn.recordMessage(m)\n  1286\t\t\t\tn.p.Handle(m)\n  1287\t\t\t}\n  1288\t\t}\n  1289\t\tif count > n.config.ElectionRTT/2 {\n  1290\t\t\tplog.Warningf(\"%s had %d LocalTick msgs in one batch\", n.id(), count)\n  1291\t\t}\n  1292\t\tif lazyFreeCycle > 0 {\n  1293\t\t\tfor i := range msgs {\n 