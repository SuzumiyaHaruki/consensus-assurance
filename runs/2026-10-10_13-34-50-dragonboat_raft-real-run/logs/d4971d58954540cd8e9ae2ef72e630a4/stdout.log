 null,\n      \"description\": \"Retained rejected operation whose draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"const\": \"explore\",\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"question\": {\n      \"minLength\": 1,\n      \"title\": \"Question\",\n      \"type\": \"string\"\n    },\n    \"harness_path\": {\n      \"title\": \"Harness Path\",\n      \"type\": \"string\"\n    },\n    \"execution_package\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Execution Package\"\n    },\n    \"files\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"title\": \"Files\",\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\",\n    \"harness_path\"\n  ],\n  \"title\": \"ExploreSubmission\",\n  \"type\": \"object\"\n}\nCandidateSubmission {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"rationale\": {\n      \"minLength\": 1,\n      \"title\": \"Rationale\",\n      \"type\": \"string\"\n    },\n    \"sources\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/SourceRange\"\n      },\n      \"title\": \"Sources\",\n      \"type\": \"array\"\n    },\n    \"feedback\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResearchFeedback\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"review\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ResultReview\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"map_path\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Map Path\"\n    },\n    \"map_changes\": {\n      \"additionalProperties\": {\n        \"$ref\": \"#/$defs/UnderstandingChange\"\n      },\n      \"default\": {},\n      \"title\": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Retained rejected operation whose draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/AuditQuestion\"\n        },\n        {\n          \"additionalProperties\": true,\n          \"type\": \"object\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"New sourced question, or only changed AuditQuestion fields when candidate_id is supplied\",\n      \"title\": \"Question\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\nfunc (r *raft) handleFollowerHeartbeat(m pb.Message) {\n\tr.leaderIsAvailable()\n\tr.setLeaderID(m.From)\n\tr.handleHeartbeatMessage(m)\n}\n\nfunc (r *raft) handleFollowerReadIndex(m pb.Message) {\n\tif r.leaderID == NoLeader {\n\t\tplog.Warningf(\"%s dropped ReadIndex, no leader\", r.describe())\n\t\tr.reportDroppedReadIndex(m)\n\t\treturn\n\t}\n\tm.To = r.leaderID\n\tr.send(m)\n}\n\nfunc (r *raft) handleFollowerLeaderTransfer(m pb.Message) {\n\tif r.leaderID == NoLeader {\n\t\tplog.Warningf(\"%s dropped LeaderTransfer, no leader\", r.describe())\n\t\treturn\n\t}\n\tm.To = r.leaderID\n\tr.send(m)\n}\n\nfunc (r *raft) handleFollowerReadIndexResp(m pb.Message) {\n\tctx := pb.SystemCtx{\n\t\tLow:  m.Hint,\n\t\tHigh: m.HintHigh,\n\t}\n\tr.leaderIsAvailable()\n\tr.setLeaderID(m.From)\n\tr.addReadyToRead(m.LogIndex, ctx)\n}\n\nfunc (r *raft) handleFollowerInstallSnapshot(m pb.Message) {\n\tr.leaderIsAvailable()\n153:// Raft cluster and applied on the local node. For ReadIndex operation, it means\n509:type pendingReadIndex struct {\n511:\tbatches  map[pb.SystemCtx]readBatch\n512:\trequests *readIndexQueue\n792:func newPendingReadIndex(pool *sync.Pool,\n793:\trequests *readIndexQueue) *pendingReadIndex {\n794:\tp := &pendingReadIndex{\n795:\t\tbatches:      make(map[pb.SystemCtx]readBatch),\n803:func (p *pendingReadIndex) close() {\n823:func (p *pendingReadIndex) read(timeoutTick uint64) (*RequestState, error) {\n842:func (p *pendingReadIndex) genCtx() pb.SystemCtx {\n845:\t\tv := pb.SystemCtx{\n855:func (p *pendingReadInde