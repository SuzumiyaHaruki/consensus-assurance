": \"Map Changes\",\n      \"type\": \"object\"\n    },\n    \"repair_of\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Retained rejected operation whose draft this submission repairs\",\n      \"title\": \"Repair Of\"\n    },\n    \"action\": {\n      \"enum\": [\n        \"continue\",\n        \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/AuditQuestion\"\n        },\n        {\n          \"additionalProperties\": true,\n          \"type\": \"object\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"New sourced question, or only changed AuditQuestion fields when candidate_id is supplied\",\n      \"title\": \"Question\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Bi