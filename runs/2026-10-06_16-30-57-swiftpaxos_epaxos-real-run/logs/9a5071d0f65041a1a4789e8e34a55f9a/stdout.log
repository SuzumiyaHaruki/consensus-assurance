        \"high_consequence\": true\n      }\n    ],\n    \"core_regions\": [\n      {\n        \"activity\": \"A1\",\n        \"entries\": [\n          {\n            \"class_id\": \"A1\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Qualified support for decision formation and legal advancement\",\n            \"realization_summary\": \"Client proposal or PreAccept/PreAcceptReply dispatch. Accept or AcceptReply dispatch. Commit dispatch.\",\n            \"entry_points\": [\n              \"B-form\",\n              \"B-accept\",\n              \"B-commit\"\n            ],\n            \"behavior_ids\": [\n              \"B-form\",\n              \"B-accept\",\n              \"B-commit\"\n            ],\n            \"variants\": [],\n            \"unknowns\": [],\n            \"source_ids\": [\n              \"M-phase1\",\n              \"M-attrs\",\n              \"M-send\",\n              \"M-defs\",\n              \"M-accept\",\n              \"M-commit\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [\n          {\n            \"class_id\": \"A2\",\n            \"applicability\": \"applicable\",\n            \"purpose\": \"Context validity and acquisition, transfer or loss of authority\",\n            \"realization_summary\": \"Recovery request or Prepare/PrepareReply dispatch.\",\n            \"entry_points\": [\n              \"B-context\"\n            ],\n            \"behavior_ids\": [\n              \"B-context\"\n            ],\n            \"variants\": [],\n            \"unknowns\": [],\n            \"source_ids\": [\n              \"M-recovery\",\n              \"M-ballot\",\n              \"M-default\",\n              \"M-commit\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor