c.Serializable, defs.CHAN_BUFFER_SIZE*2),\n   145\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   146\t\t\tmake(chan fastrpc.Serializable, defs.CHAN_BUFFER_SIZE),\n   147\t\t\t0, 0, 0, 0, 0, 0, 0, 0, 0,\n   148\t\t\tmake([][]*Instance, len(peerAddrList)),\n   149\t\t\tmake([]int32, len(peerAddrList)),\n   150\t\t\tmake([]int32, len(peerAddrList)),\n   151\t\t\tmake([]int32, len(peerAddrList)),\n   152\t\t\tnil,\n   153\t\t\tmake([]map[state.Key]*InstPair, len(peerAddrList)),\n   154\t\t\tmake(map[state.Key]int32),\n   155\t\t\t0,\n   156\t\t\t0,\n   157\t\t\t-1,\n   158\t\t\tnew(sync.Mutex),\n   159\t\t\tmake(chan *instanceId, defs.CHAN_BUFFER_SIZE),\n   160\t\t\tfalse,\n   161\t\t\t-1,\n   162\t\t\tbatchWait,\n   163\t\t\ttransconf,\n   164\t\t}\n   165\t\n   166\t\tr.Beacon = beacon\n   167\t\tr.Durable = durable\n   168\t\n   169\t\tfor i := 0; i < r.N; i++ {\n   170\t\t\tr.InstanceSpace[i] = make([]*Instance, MAX_INSTANCE) // FIXME\n   171\t\t\tr.crtInstance[i] = -1\n   172\t\t\tr.ExecedUpTo[i] = -1\n   173\t\t\tr.CommittedUpTo[i] = -1\n   174\t\t\tr.conflicts[i] = make(map[state.Key]*InstPair, HT_INIT_SIZE)\n   175\t\t}\n   176\t\n   177\t\tr.exec = &Exec{r}\n   178\t\n   179\t\tcpMarker = make([]state.Command, 0)\n   180\t\n   181\t\t//register RPCs\n   182\t\tr.prepareRPC = r.RPC.Register(new(Prepare), r.prepareChan)\n   183\t\tr.prepareReplyRPC = r.RPC.Register(new(PrepareReply), r.prepareReplyChan)\n   184\t\tr.preAcceptRPC = r.RPC.Register(new(PreAccept), r.preAcceptChan)\n   185\t\tr.preAcceptReplyRPC = r.RPC.Register(new(PreAcceptReply), r.preAcceptReplyChan)\n   186\t\tr.acceptRPC = r.RPC.Register(new(Accept), r.acceptChan)\n   187\t\tr.acceptReplyRPC = r.RPC.Register(new(AcceptReply), r.acceptReplyChan)\n   188\t\tr.commitRPC = r.RPC.Register(new(Commit), r.commitChan)\n   189\t\tr.tryPreAcceptRPC = r.RPC.Register(new(TryPreAccept), r.tryPreAcceptChan)\n   190\t\tr.tryPreAcceptReplyRPC = r.RPC.Register(new(TryPreAcceptReply), r.tryPreAcceptReplyChan)\n   191\t\n   192\t\tr.Stats.M[\"weird\"], r.Stats.M[\"conflicted\"], r.Stats.M[\"slow\"], r.Stats.M[\"fast\"], r.Stats.M[\"totalCommitTime\"], r.Stats.M[\"totalBatching\"], r.Stats.M[\"totalBatchingSize\"] = 0, 0, 0, 0, 0, 0, 0\n   193\t\n   194\t\tgo r.run()\n   195\t\n   196\t\treturn r\n   197\t}\n   198\t\n   199\tfunc (r *Replica) recordInstanceMetadata(inst *Instance) {\n   200\t\tif !r.Durable {\n   201\t\t\treturn\n   202\t\t}\n   203\t\n   204\t\tb := make([]byte, 9+r.N*4)\n   205\t\tbinary.LittleEndian.PutUint32(b[0:4], uint32(inst.bal))\n   206\t\tbinary.LittleEndian.PutUint32(b[0:4], uint32(inst.vbal))\n   207\t\tb[4] = byte(inst.Status)\n   208\t\tbinary.LittleEndian.PutUint32(b[5:9], uint32(inst.Seq))\n   209\t\tl := 9\n   210\t\tfor _, dep := range inst.Deps {\n   211\t\t\tbinary.LittleEndian.PutUint32(b[l:l+4], uint32(dep))\n   212\t\t\tl += 4\n   213\t\t}\n   214\t\tr.StableStore.Write(b[:])\n   215\t}\n   216\t\n   217\tfunc (r *Replica) recordCommands(cmds []state.Command) {\n   218\t\tif !r.Durable {\n   219\t\t\treturn\n   220\t\t}\n   221\t\n   222\t\tif cmds == nil {\n   223\t\t\treturn\n   224\t\t}\n   225\t\tfor i := 0; i < len(cmds); i++ {\n   226\t\t\tcmds[i].Marshal(io.Writer(r.StableStore))\n   227\t\t}\n   228\t}\n   229\t\n   230\tfunc (r *Replica) sync() {\n   231\t\tif !r.Durable {\n   232\t\t\treturn\n   233\t\t}\n   234\t\n   235\t\tr.StableStore.Sync()\n   236\t}\n   237\t\n   238\tvar fastClockChan chan bool\n   239\tvar slowClockChan chan bool\n   240\t\n   241\tfunc (r *Replica) fastClock() {\n   242\t\tfor !r.Shutdown {\n   243\t\t\ttime.Sleep(time.Duration(r.batchWait) * time.Millisecond)\n   244\t\t\tfastClockChan <- true\n   245\t\t}\n   246\t}\n   247\tfunc (r *Replica) slowClock() {\n   248\t\tfor !r.Shutdown {\n   249\t\t\ttime.Sleep(150 * time.Millisecond)\n   250\t\t\tslowClockChan <- true\n   251\t\t}\n   252\t}\n   253\t\n   254\tfunc (r *Replica) stopAdapting() {\n   255\t\ttime.Sleep(1000 * 1000 * 1000 * ADAPT_TIME_SEC)\n   256\t\tr.Beacon = false\n   257\t\ttime.Sleep(1000 * 1000 * 1000)\n   258\t\n   259\t\tfor i := 0; i < r.N-1; i++ {\n   260\t\t\tmin := i\n   261\t\t\tfor j := i + 1; j < r.N-1; j++ {\n   262\t\t\t\tif r.Ewma[r.PreferredPeerOrder[j]] < r.Ewma[r.PreferredPeerOrder[min]] {\n   263\t\t\t\t\tmin = j\n   264\t\t\t\t}\n   265\t\t\t}\n   266\t\t\taux := r.PreferredPeerOrder[i]\n   267\t\t\tr.PreferredPeerOrder[i] = r.PreferredPeerOrder[min]\n   268\t\t\tr.PreferredPeerOrder[min] = aux\n   269\t\t}\n   270\t\n   271\t\tr.Println(r.PreferredPeerOrder)\n   272\t}\n   273\t\n   274\tfunc (r *Replica) BatchingEnabled() bool {\n   275\t\treturn r.batchWait > 0\n   276\t}\n   277\t\n   278\tfunc (r *Replica) run() {\n   279\t\tr.ConnectToPeers()\n   280\t\n   281\t\tr.ComputeClosestPeers()\n   282\t\n   283\t\tif r.Exec {\n   284\t\t\tgo r.executeCommands()\n   285\t\t}\n   286\t\n   287\t\tslowClockChan = make(chan bool, 1)\n   288\t\tfastClockChan = make(chan bool, 1)\n   289\t\tgo r.slowClock()\n   290\t\n   291\t\tif r.BatchingEnabled() {\n   292\t\t\tgo r.fastClock()\n   293\t\t}\n   294\t\n   295\t\tif r.Beacon {\n   296\t\t\tgo r.stopAdapting()\n   297\t\t}\n   298\t\n   299\t\tonOffProposeChan := r.ProposeChan\n   300\t\n   301\t\tgo r.WaitForClientConnections()\n   302\t\n   303\t\tfor !r.Shutdown {\n   304\t\n   305\t\t\tselect {\n   306\t\n   307\t\t\tcase propose := <-onOffProposeChan:\n   308\t\t\t\tr.handlePropose(propose)\n   309\t\t\t\tif r.BatchingEnabled() {\n   310\t\t\t\t\tonOffProposeChan = nil\n   311\t\t\t\t}\n   312\t\t\t\tbreak\n   313\t\n   314\t\t\tcase <-fastClockChan:\n   315\t\t\t\tonOffProposeChan = r.ProposeChan\n   316\t\t\t\tbreak\n   317\t\n   318\t\t\tcase prepareS := <-r.prepareChan:\n   319\t\t\t\tprepare := prepareS.(*Prepare)\n   320\t\t\t\tr.handlePrepare(prepare)\n   321\t\t\t\tbreak\n   322\t\n   323\t\t\tcase preAcceptS := <-r.preAcceptChan:\n   324\t\t\t\tpreAccept := preAcceptS.(*PreAccept)\n   325\t\t\t\tr.handlePreAccept(preAccept)\n   326\t\t\t\tbreak\n   327\t\n   328\t\t\tcase acceptS := <-r.acceptChan:\n   329\t\t\t\taccept := acceptS.(*Accept)\n   330\t\t\t\tr.handleAccept(accept)\n   331\t\t\t\tbreak\n   332\t\n   333\t\t\tcase commitS := <-r.commitChan:\n   334\t\t\t\tcommit := commitS.(*Commit)\n   335\t\t\t\tr.handleCommit(commit)\n   336\t\t\t\tbreak\n   337\t\n   338\t\t\tcase prepareReplyS := <-r.prepareReplyChan:\n   339\t\t\t\tprepareReply := prepareReplyS.(*PrepareReply)\n   340\t\t\t\tr.handlePrepareReply(prepareReply)\n   341\t\t\t\tbreak\n   342\t\n   343\t\t\tcase preAcceptReplyS := <-r.preAcceptReplyChan:\n   344\t\t\t\tpreAcceptReply := preAcceptReplyS.(*PreAcceptReply)\n   345\t\t\t\tr.handlePreAcceptReply(preAcceptReply)\n   346\t\t\t\tbreak\n   347\t\n   348\t\t\tcase acceptReplyS := <-r.acceptReplyChan:\n   349\t\t\t\tacceptReply := acceptReplyS.(*AcceptReply)\n   350\t\t\t\tr.handleAcceptReply(acceptReply)\n   351\t\t\t\tbreak\n   352\t\n   353\t\t\tcase tryPreAcceptS := <-r.tryPreAcceptChan:\n   354\t\t\t\ttryPreAccept := tryPreAcceptS.(*TryPreAccept)\n   355\t\t\t\tr.handleTryPreAccept(tryPreAccept)\n   356\t\t\t\tbreak\n   357\t\n   358\t\t\tcase tryPreAcceptReplyS := <-r.tryPreAcceptReplyChan:\n   359\t\t\t\ttryPreAcceptReply := tryPreAcceptReplyS.(*TryPreAcceptReply)\n   360\t\t\t\tr.handleTryPreAcceptReply(tryPreAcceptReply)\n   361\t\t\t\tbreak\n   362\t\n   363\t\t\tcase beacon := <-r.BeaconChan:\n   364\t\t\t\tr.ReplyBeacon(beacon)\n   365\t\t\t\tbreak\n   366\t\n   367\t\t\tcase <-slowClockChan:\n   368\t\t\t\tif r.Beacon {\n   369\t\t\t\t\tr.Printf(\"weird %d; conflicted %d; slow %d; fast %d\\n\", r.Stats.M[\"weird\"], r.Stats.M[\"conflicted\"], r.Stats.M[\"slow\"], r.Stats.M[\"fast\"])\n   370\t\t\t\t\tfor q := int32(0); q < int32(r.N); q++ {\n   371\t\t\t\t\t\tif q == r.Id {\n   372\t\t\t\t\t\t\tcontinue\n   373\t\t\t\t\t\t}\n   374\t\t\t\t\t\tr.SendBeacon(q)\n   375\t\t\t\t\t}\n   376\t\t\t\t}\n   377\t\t\t\tbreak\n   378\t\n   379\t\t\tcase iid := <-r.instancesToRecover:\n   380\t\t\t\tr.startRecoveryForInstance(iid.replica, iid.instance)\n   381\t\t\t}\n   382\t\t}\n   383\t}\n   384\t\n   385\tfunc (r *Replica) executeCommands() {\n   386\t\tconst SLEEP_TIME_NS = 1e6\n   387\t\tproblemInstance := make([]int32, r.N)\n   388\t\ttimeout := make([]uint64, r.N)\n   389\t\tfor q := 0; q < r.N; q++ {\n   390\t\t\tproblemInstance[q] = -1\n   391\t\t\ttimeout[q] = 0\n   392\t\t}\n   393\t\n   394\t\tfor !r.Shutdown {\n   395\t\t\texecuted := false\n   396\t\t\tfor q := int32(0); q < int32(r.N); q++ {\n   397\t\t\t\tfor inst := r.ExecedUpTo[q] + 1; inst <= r.crtInstance[q]; inst++ {\n   398\t\t\t\t\tif r.InstanceSpace[q][inst] != nil && r.InstanceSpace[q][inst].Status == EXECUTED {\n   399\t\t\t\t\t\tif inst == r.ExecedUpTo[q]+1 {\n   400\t\t\t\t\t\t\tr.ExecedUpTo[q] = inst\n   401\t\t\t\t\t\t}\n   402\t\t\t\t\t\tcontinue\n   403\t\t\t\t\t}\n   404\t\t\t\t\tif r.InstanceSpace[q][inst] == nil || r.InstanceSpace[q][inst].Status < COMMITTED || r.InstanceSpace[q][inst].Cmds == nil {\n   405\t\t\t\t\t\tif inst == problemInstance[q] {\n   406\t\t\t\t\t\t\ttimeout[q] += SLEEP_TIME_NS\n   407\t\t\t\t\t\t\tif timeout[q] >= COMMIT_GRACE_PERIOD {\n   408\t\t\t\t\t\t\t\tfor k := problemInstance[q]; k <= r.crtInstance[q]; k++ {\n   409\t\t\t\t\t\t\t\t\tr.instancesToRecover <- &instanceId{q, k}\n   410\t\t\t\t\t\t\t\t}\n   411\t\t\t\t\t\t\t\ttimeout[q] = 0\n   412\t\t\t\t\t\t\t}\n   413\t\t\t\t\t\t} else {\n   414\t\t\t\t\t\t\tproblemInstance[q] = inst\n   415\t\t\t\t\t\t\ttimeout[q] = 0\n   416\t\t\t\t\t\t}\n   417\t\t\t\t\t\tbreak\n   418\t\t\t\t\t}\n   419\t\t\t\t\tif ok := r.exec.executeCommand(int32(q), inst); ok {\n   420\t\t\t\t\t\texecuted = true\n   421\t\t\t\t\t\tif inst == r.ExecedUpTo[q]+1 {\n   422\t\t\t\t\t\t\tr.ExecedUpTo[q] = inst\n   423\t\t\t\t\t\t}\n   424\t\t\t\t\t}\n   425\t\t\t\t}\n   426\t\t\t}\n   427\t\t\tif !executed {\n   428\t\t\t\tr.M.Lock()\n   429\t\t\t\tr.M.Unlock() // FIXME for cache coherence\n   430\t\t\t\ttime.Sleep(SLEEP_TIME_NS)\n   431\t\t\t}\n   432\t\t}\n   433\t}\n   434\t\n   435\tfunc isInitialBallot(ballot int32, replica int32, instance int32) bool {\n   436\t\treturn ballot == replica\n   437\t}\n   438\t\n   439\tfunc (r *Replica) makeBallot(replica int32, instance int32) {\n   440\t\tlb := r.InstanceSpace[replica][instance].lb\n   441\t\tn := r.Id\n   442\t\tif r.Id != replica {\n   443\t\t\tn += int32(r.N)\n   444\t\t}\n   445\t\tif r.IsLeader {\n   446\t\t\tfor n < r.maxRecvBallot {\n   447\t\t\t\tn += int32(r.N)\n   448\t\t\t}\n   449\t\t}\n   450\t\tlb.lastTriedBallot = n\n   451\t}\n   452\t\n   453\tfunc (r *Replica) replyPrepare(replicaId int32, reply *PrepareReply) {\n   454\t\tr.SendMsg(replicaId, r.prepareReplyRPC, reply)\n   455\t}\n   456\t\n   457\tfunc (r *Replica) replyPreAccept(replicaId int32, reply *PreAcceptReply) {\n   458\t\tr.SendMsg(replicaId, r.preAcceptReplyRPC, reply)\n   459\t}\n   460\t\n   461\tfunc (r *Replica) replyAccept(replicaId int32, reply *AcceptReply) {\n   462\t\tr.SendMsg(replicaId, r.acceptReplyRPC, reply)\n   463\t}\n   464\t\n   465\tfunc (r *Replica) replyTryPreAccept(replicaId int32, reply *TryPreAcceptReply) {\n   466\t\tr.SendMsg(replicaId, r.tryPreAcceptReplyRPC, reply)\n   467\t}\n   468\t\n   469\tfunc (r *Replica) bcastPrepare(replica int32, instance int32) {\n   470\t\tdefer func() {\n   471\t\t\tif err := recover(); err != nil {\n   472\t\t\t\tr.Println(\"Prepare bcast failed:\", err)\n   473\t\t\t}\n   474\t\t}()\n   475\t\tlb := r.InstanceSpace[replica][instance].lb\n   476\t\targs := &Prepare{r.Id, replica, instance, lb.lastTriedBallot}\n   477\t\n   478\t\tn := r.N - 1\n   479\t\tq := r.Id\n   480\t\tfor sent := 0; sent < n; {\n   481\t\t\tq = (q + 1) % int32(r.N)\n   482\t\t\tif q == r.Id {\n   483\t\t\t\tbreak\n   484\t\t\t}\n   485\t\t\tif !r.Alive[q] {\n   486\t\t\t\tcontinue\n   487\t\t\t}\n   488\t\t\tr.SendMsg(q, r.prepareRPC, args)\n   489\t\t\tsent++\n   490\t\t}\n   491\t\n   492\t}\n   493\t\n   494\tfunc (r *Replica) bcastPreAccept(replica int32, instance int32) {\n   495\t\tdefer func() {\n   496\t\t\tif err := recover(); err != nil {\n   497\t\t\t\tr.Println(\"PreAccept bcast failed:\", err)\n   498\t\t\t}\n   499\t\t}()\n   500\t\tlb := r.InstanceSpace[replica][instance].lb\n   501\t\tpa := new(PreAccept)\n   502\t\tpa.LeaderId = r.Id\n   503\t\tpa.Replica = replica\n   504\t\tpa.Instance = instance\n   505\t\tpa.Ballot = lb.lastTriedBallot\n   506\t\tpa.Command = lb.cmds\n   507\t\tpa.Seq = lb.seq\n   508\t\tpa.Deps = lb.deps\n   509\t\n   510\t\tn := r.N - 1\n   511\t\tif r.Thrifty {\n   512\t\t\tn = r.Replica.FastQuorumSize() - 1\n   513\t\t}\n   514\t\n   515\t\tsent := 0\n   516\t\tfor q := 0; q < r.N-1; q++ {\n   517\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   518\t\t\t\tcontinue\n   519\t\t\t}\n   520\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.preAcceptRPC, pa)\n   521\t\t\tsent++\n   522\t\t\tif sent >= n {\n   523\t\t\t\tbreak\n   524\t\t\t}\n   525\t\t}\n   526\t}\n   527\t\n   528\tfunc (r *Replica) bcastTryPreAccept(replica int32, instance int32) {\n   529\t\tdefer func() {\n   530\t\t\tif err := recover(); err != nil {\n   531\t\t\t\tr.Println(\"PreAccept bcast failed:\", err)\n   532\t\t\t}\n   533\t\t}()\n   534\t\tlb := r.InstanceSpace[replica][instance].lb\n   535\t\ttpa := new(TryPreAccept)\n   536\t\ttpa.LeaderId = r.Id\n   537\t\ttpa.Replica = replica\n   538\t\ttpa.Instance = instance\n   539\t\ttpa.Ballot = lb.lastTriedBallot\n   540\t\ttpa.Command = lb.cmds\n   541\t\ttpa.Seq = lb.seq\n   542\t\ttpa.Deps = lb.deps\n   543\t\n   544\t\tfor q := int32(0); q < int32(r.N); q++ {\n   545\t\t\tif q == r.Id {\n   546\t\t\t\tcontinue\n   547\t\t\t}\n   548\t\t\tif !r.Alive[q] {\n   549\t\t\t\tcontinue\n   550\t\t\t}\n   551\t\t\tr.SendMsg(q, r.tryPreAcceptRPC, tpa)\n   552\t\t}\n   553\t}\n   554\t\n   555\tfunc (r *Replica) bcastAccept(replica int32, instance int32) {\n   556\t\tdefer func() {\n   557\t\t\tif err := recover(); err != nil {\n   558\t\t\t\tr.Println(\"Accept bcast failed:\", err)\n   559\t\t\t}\n   560\t\t}()\n   561\t\n   562\t\tlb := r.InstanceSpace[replica][instance].lb\n   563\t\tea := new(Accept)\n   564\t\tea.LeaderId = r.Id\n   565\t\tea.Replica = replica\n   566\t\tea.Instance = instance\n   567\t\tea.Ballot = lb.lastTriedBallot\n   568\t\tea.Seq = lb.seq\n   569\t\tea.Deps = lb.deps\n   570\t\n   571\t\tn := r.N - 1\n   572\t\tif r.Thrifty {\n   573\t\t\tn = r.N / 2\n   574\t\t}\n   575\t\n   576\t\tsent := 0\n   577\t\tfor q := 0; q < r.N-1; q++ {\n   578\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   579\t\t\t\tcontinue\n   580\t\t\t}\n   581\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.acceptRPC, ea)\n   582\t\t\tsent++\n   583\t\t\tif sent >= n {\n   584\t\t\t\tbreak\n   585\t\t\t}\n   586\t\t}\n   587\t}\n   588\t\n   589\tfunc (r *Replica) bcastCommit(replica int32, instance int32) {\n   590\t\tdefer func() {\n   591\t\t\tif err := recover(); err != nil {\n   592\t\t\t\tr.Println(\"Commit bcast failed:\", err)\n   593\t\t\t}\n   594\t\t}()\n   595\t\tlb := r.InstanceSpace[replica][instance].lb\n   596\t\tec := new(Commit)\n   597\t\tec.LeaderId = r.Id\n   598\t\tec.Replica = replica\n   599\t\tec.Instance = instance\n   600\t\tec.Command = lb.cmds\n   601\t\tec.Seq = lb.seq\n   602\t\tec.Deps = lb.deps\n   603\t\tec.Ballot = lb.ballot\n   604\t\n   605\t\tfor q := 0; q < r.N-1; q++ {\n   606\t\t\tif !r.Alive[r.PreferredPeerOrder[q]] {\n   607\t\t\t\tcontinue\n   608\t\t\t}\n   609\t\t\tr.SendMsg(r.PreferredPeerOrder[q], r.commitRPC, ec)\n   610\t\t}\n   611\t}\n   612\t\n   613\tfunc (r *Replica) clearHashtables() {\n   614\t\tfor q := 0; q < r.N; q++ {\n   615\t\t\tr.conflicts[q] = make(map[state.Key]*InstPair, HT_INIT_SIZE)\n   616\t\t}\n   617\t}\n   618\t\n   619\tfunc (r *Replica) updateCommitted(replica int32) {\n   620\t\tr.M.Lock()\n   621\t\tfor r.InstanceSpace[replica][r.CommittedUpTo[replica]+1] != nil &&\n   622\t\t\t(r.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == COMMITTED ||\n   623\t\t\t\tr.InstanceSpace[replica][r.CommittedUpTo[replica]+1].Status == EXECUTED) {\n   624\t\t\tr.CommittedUpTo[replica] = r.CommittedUpTo[replica] + 1\n   625\t\t}\n   626\t\tr.M.Unlock()\n   627\t}\n   628\t\n   629\tfunc (r *Replica) updateConflicts(cmds []state.Command, replica int32, instance int32, seq int32) {\n   630\t\tfor i := 0; i < len(cmds); i++ {\n   631\t\t\tif dpair, present := r.conflicts[replica][cmds[i].K]; present {\n   632\t\t\t\tif dpair.last < instance {\n   633\t\t\t\t\tr.conflicts[replica][cmds[i].K].last = instance\n   634\t\t\t\t}\n   635\t\t\t\tif dpair.lastWrite < instance && cmds[i].Op != state.GET {\n   636\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   637\t\t\t\t}\n   638\t\t\t} else {\n   639\t\t\t\tr.conflicts[replica][cmds[i].K] = &InstPair{\n   640\t\t\t\t\tlast:      instance,\n   641\t\t\t\t\tlastWrite: -1,\n   642\t\t\t\t}\n   643\t\t\t\tif cmds[i].Op != state.GET {\n   644\t\t\t\t\tr.conflicts[replica][cmds[i].K].lastWrite = instance\n   645\t\t\t\t}\n   646\t\t\t}\n   647\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   648\t\t\t\tif s < seq {\n   649\t\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   650\t\t\t\t}\n   651\t\t\t} else {\n   652\t\t\t\tr.maxSeqPerKey[cmds[i].K] = seq\n   653\t\t\t}\n   654\t\t}\n   655\t}\n   656\t\n   657\tfunc (r *Replica) updateAttributes(cmds []state.Command, seq int32, deps []int32, replica int32, instance int32) (int32, []int32, bool) {\n   658\t\tchanged := false\n   659\t\tfor q := 0; q < r.N; q++ {\n   660\t\t\tif r.Id != replica && int32(q) == replica {\n   661\t\t\t\tcontinue\n   662\t\t\t}\n   663\t\t\tfor i := 0; i < len(cmds); i++ {\n   664\t\t\t\tif dpair, present := (r.conflicts[q])[cmds[i].K]; present {\n   665\t\t\t\t\td := dpair.lastWrite\n   666\t\t\t\t\tif cmds[i].Op != state.GET {\n   667\t\t\t\t\t\td = dpair.last\n   668\t\t\t\t\t}\n   669\t\n   670\t\t\t\t\tif d > deps[q] {\n   671\t\t\t\t\t\tdeps[q] = d\n   672\t\t\t\t\t\tif seq <= r.InstanceSpace[q][d].Seq {\n   673\t\t\t\t\t\t\tseq = r.InstanceSpace[q][d].Seq + 1\n   674\t\t\t\t\t\t}\n   675\t\t\t\t\t\tchanged = true\n   676\t\t\t\t\t\tbreak\n   677\t\t\t\t\t}\n   678\t\t\t\t}\n   679\t\t\t}\n   680\t\t}\n   681\t\tfor i := 0; i < len(cmds); i++ {\n   682\t\t\tif s, present := r.maxSeqPerKey[cmds[i].K]; present {\n   683\t\t\t\tif seq <= s {\n   684\t\t\t\t\tchanged = true\n   685\t\t\t\t\tseq = s + 1\n   686\t\t\t\t}\n   687\t\t\t}\n   688\t\t}\n   689\t\n   690\t\treturn seq, deps, changed\n   691\t}\n   692\t\n   693\tfunc (r *Replica) mergeAttributes(seq1 int32, deps1 []int32, seq2 int32, deps2 []int32) (int32, []int32, bool) {\n   694\t\tequal := true\n   695\t\tif seq1 != seq2 {\n   696\t\t\tequal = false\n   697\t\t\tif seq2 > seq1 {\n   698\t\t\t\tseq1 = seq2\n   699\t\t\t}\n   700\t\t}\n   701\t\tfor q := 0; q < r.N; q++ {\n   702\t\t\tif int32(q) == r.Id {\n   703\t\t\t\tcontinue\n   704\t\t\t}\n   705\t\t\tif deps1[q] != deps2[q] {\n   706\t\t\t\tequal = false\n   707\t\t\t\tif deps2[q] > deps1[q] {\n   708\t\t\t\t\tdeps1[q] = deps2[q]\n   709\t\t\t\t}\n   710\t\t\t}\n   711\t\t}\n   712\t\treturn seq1, deps1, equal\n   713\t}\n   714\t\n   715\tfunc equal(deps1 []int32, deps2 []int32) bool {\n   716\t\tfor i := 0; i < len(deps1); i++ {\n   717\t\t\tif deps1[i] != deps2[i] {\n   718\t\t\t\treturn false\n   719\t\t\t}\n   720\t\t}\n   721\t\treturn true\n   722\t}\n   723\t\n   724\tfunc (r *Replica) handlePropose(propose *defs.GPropose) {\n   725\t\t//TODO!! Handle client retries\n   726\t\n   727\t\tbatchSize := len(r.ProposeChan) + 1\n   728\t\tr.M.Lock()\n   729\t\tr.Stats.M[\"totalBatching\"]++\n   730\t\tr.Stats.M[\"totalBatchingSize\"] += batchSize\n   731\t\tr.M.Unlock()\n   732\t\n   733\t\tr.crtInstance[r.Id]++\n   734\t\n   735\t\tcmds := make([]state.Command, batchSize)\n   736\t\tproposals := make([]*defs.GPropose, batchSize)\n   737\t\tcmds[0] = propose.Command\n   738\t\tproposals[0] = propose\n   739\t\tfor i := 1; i < batchSize; i++ {\n   740\t\t\tprop := <-r.ProposeChan\n   741\t\t\tcmds[i] = prop.Command\n   742\t\t\tproposals[i] = prop\n   743\t\t}\n   744\t\n   745\t\tr.startPhase1(cmds, r.Id, r.crtInstance[r.Id], r.Id, proposals)\n   746\t\n   747\t\tcpcounter += len(cmds)\n   748\t\n   749\t}\n   750\t\n   751\tfunc (r *Replica) startPhase1(cmds []state.Command, replica int32, instance int32, ballot int32, proposals []*defs.GPropose) {\n   752\t\t// init command attributes\n   753\t\tseq := int32(0)\n   754\t\tdeps := make([]int32, r.N)\n   755\t\tfor q := 0; q < r.N; q++ {\n   756\t\t\tdeps[q] = -1\n   757\t\t}\n   758\t\tseq, deps, _ = r.updateAttributes(cmds, seq, deps, replica, instance)\n   759\t\tcomDeps := make([]int32, r.N)\n   760\t\tfor i := 0; i < r.N; i++ {\n   761\t\t\tcomDeps[i] = -1\n   762\t\t}\n   763\t\n   764\t\tinst := r.newInstance(replica, instance, cmds, ballot, ballot, PREACCEPTED, seq, deps)\n   765\t\tinst.lb = r.newLeaderBookkeeping(proposals, deps, comDeps, deps, ballot, cmds, PREACCEPTED, -1)\n   766\t\tr.InstanceSpace[replica][instance] = inst\n   767\t\n   768\t\tr.updateConflicts(cmds, replica, instance, seq)\n   769\t\n   770\t\tif seq >= r.maxSeq {\n   771\t\t\tr.maxSeq = seq\n   772\t\t}\n   773\t\n   774\t\tr.recordInstanceMetadata(r.InstanceSpace[r.Id][instance])\n   775\t\tr.recordCommands(cmds)\n   776\t\tr.sync()\n   777\t\n   778\t\tr.bcastPreAccept(replica, instance)\n   779\t}\n   780\t\n   781\tfunc (r *Replica) handlePreAccept(preAccept *PreAccept) {\n   782\t\tinst := r.InstanceSpace[preAccept.Replica][preAccept.Instance]\n   783\t\n   784\t\tif preAccept.Seq >= r.maxSeq {\n   785\t\t\tr.maxSeq = preAccept.Seq + 1\n   786\t\t}\n   787\t\n   788\t\tif preAccept.Ballot > r.maxRecvBallot {\n   789\t\t\tr.maxRecvBallot = preAccept.Ballot\n   790\t\t}\n   791\t\n   792\t\tif preAccept.Instance > r.crtInstance[preAccept.Replica] {\n   793\t\t\tr.crtInstance[preAccept.Replica] = preAccept.Instance\n   794\t\t}\n   795\t\n   796\t\tif inst == nil {\n   797\t\t\tinst = r.newInstanceDefault(preAccept.Replica, preAccept.Instance)\n   798\t\t\tr.InstanceSpace[preAccept.Replica][preAccept.Instance] = inst\n   799\t\t}\n   800\t\n   801\t\tif inst != nil && preAccept.Ballot < inst.bal {\n   802\t\t\treturn\n   803\t\t}\n   804\t\n   805\t\tinst.bal = preAccept.Ballot\n   806\t\n   807\t\tif inst.Status >= ACCEPTED {\n   808\t\t\tif inst.Cmds == nil {\n   809\t\t\t\tr.InstanceSpace[preAccept.LeaderId][preAccept.Instance].Cmds = preAccept.Command\n   810\t\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n   811\t\t\t\tr.recordCommands(preAccept.Command)\n   812\t\t\t\tr.sync()\n   813\t\t\t}\n   814\t\n   815\t\t} else {\n   816\t\t\tseq, deps, changed := r.updateAttributes(preAccept.Command, preAccept.Seq, preAccept.Deps, preAccept.Replica, preAccept.Instance)\n   817\t\t\tstatus := PREACCEPTED_EQ\n   818\t\t\tif changed {\n   819\t\t\t\tstatus = PREACCEPTED\n   820\t\t\t}\n   821\t\t\tinst.Cmds = preAccept.Command\n   822\t\t\tinst.Seq = seq\n   823\t\t\tinst.Deps = deps\n   824\t\t\tinst.bal = preAccept.Ballot\n   825\t\t\tinst.vbal = preAccept.Ballot\n   826\t\t\tinst.Status = status\n   827\t\n   828\t\t\tr.updateConflicts(preAccept.Command, preAccept.Replica, preAccept.Instance, preAccept.Seq)\n   829\t\t\tr.recordInstanceMetadata(r.InstanceSpace[preAccept.Replica][preAccept.Instance])\n   830\t\t\tr.recordCommands(preAccept.Command)\n   831\t\t\tr.sync()\n   832\t\n   833\t\t}\n   834\t\n   835\t\treply := &PreAcceptReply{\n   836\t\t\tpreAccept.Replica,\n   837\t\t\tpreAccept.Instance,\n   838\t\t\tinst.bal,\n   839\t\t\tinst.vbal,\n   840\t\t\tinst.Seq,\n   841\t\t\tinst.Deps,\n   842\t\t\tr.CommittedUpTo,\n   843\t\t\tinst.Status}\n   844\t\tr.replyPreAccept(preAccept.LeaderId, reply)\n   845\t}\n   846\t\n   847\tfunc (r *Replica) handlePreAcceptReply(pareply *PreAcceptReply) {\n   848\t\tinst := r.InstanceSpace[pareply.Replica][pareply.Instance]\n   849\t\tlb := inst.lb\n   850\t\n   851\t\tif pareply.Ballot > r.maxRecvBallot {\n   852\t\t\tr.maxRecvBallot = pareply.Ballot\n   853\t\t}\n   854\t\n   855\t\tif lb.lastTriedBallot > pareply.Ballot {\n   856\t\t\treturn\n   857\t\t}\n   858\t\n   859\t\tif lb.lastTriedBallot < pareply.Ballot {\n   860\t\t\tlb.nacks++\n   861\t\t\tif lb.nacks+1 > r.N>>1 {\n   862\t\t\t\tif r.IsLeader {\n   863\t\t\t\t\tr.makeBallot(pareply.Replica, pareply.Instance)\n   864\t\t\t\t\tr.bcastPrepare(pareply.Replica, pareply.Instance)\n   865\t\t\t\t}\n   866\t\t\t}\n   867\t\t\treturn\n   868\t\t}\n   869\t\n   870\t\tif lb.status != PREACCEPTED && lb.status != PREACCEPTED_EQ {\n   871\t\t\treturn\n   872\t\t}\n   873\t\n   874\t\tinst.lb.preAcceptOKs++\n   875\t\n   876\t\tif pareply.VBallot > lb.ballot {\n   877\t\t\tlb.ballot = pareply.VBallot\n   878\t\t\tlb.seq = pareply.Seq\n   879\t\t\tlb.deps = pareply.Deps\n   880\t\t\tlb.status = pareply.Status\n   881\t\t}\n   882\t\n   883\t\tisInitialBallot := isInitialBallot(lb.lastTriedBallot, pareply.Replica, pareply.Instance)\n   884\t\n   885\t\tseq, deps, allEqual := r.mergeAttributes(lb.seq, lb.deps, pareply.Seq, pareply.Deps)\n   886\t\tif r.N <= 3 && r.Thrifty {\n   887\t\t\t// no need to check for equality\n   888\t\t} else {\n   889\t\t\tinst.lb.allEqual = inst.lb.allEqual && allEqual\n   890\t\t\tif !allEqual {\n   891\t\t\t\tr.M.Lock()\n   892\t\t\t\tr.Stats.M[\"conflicted\"]++\n   893\t\t\t\tr.M.Unlock()\n   894\t\t\t}\n   895\t\t}\n   896\t\n   897\t\tallCommitted := true\n   898\t\tif r.N > 7 {\n   899\t\t\tfor q := 0; q < r.N; q++ {\n   900\t\t\t\tif inst.lb.committedDeps[q] < pareply.CommittedDeps[q] {\n   901\t\t\t\t\tinst.lb.committedDeps[q] = pareply.CommittedDeps[q]\n   902\t\t\t\t}\n   903\t\t\t\tif inst.lb.committedDeps[q] < r.CommittedUpTo[q] {\n   904\t\t\t\t\tinst.lb.committedDeps[q] = r.CommittedUpTo[q]\n   905\t\t\t\t}\n   906\t\t\t\tif inst.lb.committedDeps[q] < inst.Deps[q] {\n   907\t\t\t\t\tallCommitted = false\n   908\t\t\t\t}\n   909\t\t\t}\n   910\t\t}\n   911\t\n   912\t\tif lb.status <= PREACCEPTED_EQ {\n   913\t\t\tlb.deps = deps\n   914\t\t\tlb.seq = seq\n   915\t\t}\n   916\t\n   917\t\tprecondition := inst.lb.allEqual && allCommitted && isInitialBallot\n   918\t\n   919\t\tif inst.lb.preAcceptOKs >= (r.Replica.FastQuorumSize()-1) && precondition {\n   920\t\t\tlb.status = COMMITTED\n   921\t\n   922\t\t\tinst.Status = lb.status\n   923\t\t\tinst.bal = lb.ballot\n   924\t\t\tinst.Cmds = lb.cmds\n   925\t\t\tinst.Deps = lb.deps\n   926\t\t\tinst.Seq = lb.seq\n   927\t\t\tr.recordInstanceMetadata(inst)\n   928\t\t\tr.sync()\n   929\t\n   930\t\t\tr.updateCommitted(pareply.Replica)\n   931\t\t\tif inst.lb.clientProposals != nil && !r.Dreply {\n   932\t\t\t\tfor i := 0; i < len(inst.lb.clientProposals); i++ {\n   933\t\t\t\t\tr.ReplyProposeTS(\n   934\t\t\t\t\t\t&defs.ProposeReplyTS{\n   935\t\t\t\t\t\t\tTRUE,\n   936\t\t\t\t\t\t\tinst.lb.clientProposals[i].CommandId,\n   937\t\t\t\t\t\t\tstate.NIL(),\n   938\t\t\t\t\t\t\tinst.lb.clientProposals[i].Timestamp},\n   939\t\t\t\t\t\tinst.lb.clientProposals[i].Reply,\n   940\t\t\t\t\t\tinst.lb.clientProposals[i].Mutex)\n   941\t\t\t\t}\n   942\t\t\t}\n   943\t\n   944\t\t\tr.bcastCommit(pareply.Replica, pareply.Instance)\n   945\t\n   946\t\t\tr.M.Lock()\n   947\t\t\tr.Stats.M[\"fast\"]++\n   948\t\t\tif inst.proposeTime != 0 {\n   949\t\t\t\tr.Stats.M[\"totalCommitTime\"] += int(time.Now().UnixNano() - inst.proposeTime)\n   950\t\t\t}\n   951\t\t\tr.M.Unlock()\n   952\t\t} else if inst.lb.preAcceptOKs >= r.Replica.FastQuorumSize()-1 {\n   953\t\t\tlb.status = ACCEPTED\n   954\t\n   955\t\t\tinst.Status = lb.status\n   956\t\t\tinst.bal = lb.ballot\n   957\t\t\tinst.Cmds = lb.cmds\n   958\t\t\tinst.Deps = lb.deps\n   959\t\t\tinst.Seq = lb.seq\n   960\t\t\tr.recordInstanceMetadata(inst)\n   961\t\t\tr.sync()\n   962\t\n   963\t\t\tr.bcastAccept(pareply.Replica, pareply.Instance)\n   964\t\n   965\t\t\tr.M.Lock()\n   966\t\t\tr.Stats.M[\"slow\"]++\n   967\t\t\tif !allCommitted {\n   968\t\t\t\tr.Stats.M[\"weird\"]++\n   969\t\t\t}\n   970\t\t\tr.M.Unlock()\n   971\t\t}\n   972\t}\n   973\t\n   974\tfunc (r *Replica) handleAccept(accept *Accept) {\n   975\t\tinst := r.InstanceSpace[accept.Replica][accept.Instance]\n   976\t\n   977\t\tif accept.Ballot > r.maxRecvBallot {\n   978\t\t\tr.maxRecvBallot = accept.Ballot\n   979\t\t}\n   980\t\n   981\t\tif accept.Instance > r.crtInstance[accept.Replica] {\n   982\t\t\tr.crtInstance[accept.Replica] = accept.Instance\n   983\t\t}\n   984\t\n   985\t\tif inst == nil {\n   986\t\t\tinst = r.newInstanceDefault(accept.Replica, accept.Instance)\n   987\t\t\tr.InstanceSpace[accept.Replica][accept.Instance] = inst\n   988\t\t}\n   989\t\n   990\t\tif accept.Ballot < inst.bal {\n   991\t\t\tr.Printf(\"Smaller ballot %d < %d\\n\", accept.Ballot, inst.bal)\n   992\t\t} else if inst.Status >= COMMITTED {\n   993\t\t\tr.Printf(\"Already committed / executed \\n\")\n   994\t\t} else {\n   995\t\t\tinst.Deps = accept.Deps\n   996\t\t\tinst.Seq = accept.Seq\n   997\t\t\tinst.bal = accept.Ballot\n   998\t\t\tinst.vbal = accept.Ballot\n   999\t\t\tr.recordInstanceMetadata(r.InstanceSpace[accept.Replica][accept.Instance])\n  1000\t\t\tr.sync()\n  1001\t\t}\n  1002\t\n  1003\t\treply := &AcceptReply{accept.Replica, accept.Instance, inst.bal}\n  1004\t\tr.replyAccept(accept.LeaderId, reply)\n  1005\t\n  1006\t}\n  1007\t\n  1008\tfunc (r *Replica) handleAcceptReply(areply *AcceptReply) {\n  1009\t\tinst := r.InstanceSpace[areply.Replica][areply.Instance]\n  1010\t\tlb := inst.lb\n  1011\t\n  1012\t\tif areply.Ballot > r.maxRecvBallot {\n  1013\t\t\tr.maxRecvBallot = areply.Ballot\n  1014\t\t}\n  1015\t\n  1016\t\tif lb.status != ACCEPTED {\n  1017\t\t\treturn\n  1018\t\t}\n  1019\t\n  1020\t\tif lb.lastTriedBallot != areply.Ballot {\n  1021\t\t\treturn\n  1022\t\t}\n  1023\t\n  1024\t\tif areply.Ballot > lb.lastTriedBallot {\n  1025\t\t\tlb.nacks++\n  1026\t\t\tif lb.nacks+1 > r.N>>1 {\n  1027\t\t\t\tif r.IsLeader {\n  1028\t\t\t\t\tr.makeBallot(areply.Replica, areply.Instance)\n  1029\t\t\t\t\tr.bcastPrepare(areply.Replica, areply.Instance)\n  1030\t\t\t\t}\n  1031\t\t\t}\n  1032\t\t\treturn\n  1033\t\t}\n  1034\t\n  1035\t\tinst.lb.acceptOKs++\n  1036\t\n  1037\t\tif inst.lb.acceptOKs+1 > r.N/2 {\n  1038\t\t\tlb.status = COMMITTED\n  1039\t\t\tinst.Status = COMMITTED\n  1040\t\t\tr.updateCommitted(areply.Replica)\n  1041\t\t\tr.recordInstanceMetadata(inst)\n  1042\t\t\tr.sync()\n  1043\t\n  1044\t\t\tif inst.lb.clientProposals != nil && !r.Dreply {\n  1045\t\t\t\tfor i := 0; i < len(inst.lb.clientProposals); i++ {\n  1046\t\t\t\t\tr.ReplyProposeTS(\n  1047\t\t\t\t\t\t&defs.ProposeReplyTS{\n  1048\t\t\t\t\t\t\tTRUE,\n  1049\t\t\t\t\t\t\tinst.lb.clientProposals[i].CommandId,\n  1050\t\t\t\t\t\t\tstate.NIL(),\n  1051\t\t\t\t\t\t\tinst.lb.clientProposals[i].Timestamp},\n  1052\t\t\t\t\t\tinst.lb.clientProposals[i].Reply,\n  1053\t\t\t\t\t\tinst.lb.clientProposals[i].Mutex)\n  1054\t\t\t\t}\n  1055\t\t\t}\n  1056\t\n  1057\t\t\tr.bcastCommit(areply.Replica, areply.Instance)\n  1058\t\t\tr.M.Lock()\n  1059\t\t\tif inst.proposeTime != 0 {\n  1060\t\t\t\tr.Stats.M[\"totalCommitTime\"] += int(time.Now().UnixNano() - inst.proposeTime)\n  1061\t\t\t}\n  1062\t\t\tr.M.Unlock()\n  1063\t\t}\n  1064\t}\n  1065\t\n  1066\tfunc (r *Replica) handleCommit(commit *Commit) {\n  1067\t\tinst := r.InstanceSpace[commit.Replica][commit.Instance]\n  1068\t\n  1069\t\tif commit.Instance > r.crtInstance[commit.Replica] {\n  1070\t\t\tr.crtInstance[commit.Replica] = commit.Instance\n  1071\t\t}\n  1072\t\n  1073\t\tif commit.Ballot > r.maxRecvBallot {\n  1074\t\t\tr.maxRecvBallot = commit.Ballot\n  1075\t\t}\n  1076\t\n  1077\t\tif inst == nil {\n  1078\t\t\tr.InstanceSpace[commit.Replica][commit.Instance] = r.newInstanceDefault(commit.Replica, commit.Instance)\n  1079\t\t\tinst = r.InstanceSpace[commit.Replica][commit.Instance]\n  1080\t\t}\n  1081\t\n  1082\t\tif inst.Status >= COMMITTED {\n  1083\t\t\treturn\n  1084\t\t}\n  1085\t\n  1086\t\tif commit.Ballot < inst.bal {\n  1087\t\t\treturn\n  1088\t\t}\n  1089\t\n  1090\t\t// FIXME timeout on client side?\n  1091\t\tif commit.Replica == r.Id {\n  1092\t\t\tif len(commit.Command) == 1 && commit.Command[0].Op == state.NONE && inst.lb.clientProposals != nil {\n  1093\t\t\t\tfor _, p := range inst.lb.clientProposals {\n  1094\t\t\t\t\tr.Printf(\"In %d.%d, re-proposing %s \\n\", commit.Replica, commit.Instance, p.Command.String())\n  1095\t\t\t\t\tr.ProposeChan <- p\n  1096\t\t\t\t}\n  1097\t\t\t\tinst.lb.clientProposals = nil\n  1098\t\t\t}\n  1099\t\t}\n  1100\t\n  1101\t\tinst.bal = commit.Ballot\n  1102\t\tinst.vbal = commit.Ballot\n  1103\t\tinst.Cmds = commit.Command\n  1104\t\tinst.Seq = commit.Seq\n  1105\t\tinst.Deps = commit.Deps\n  1106\t\tinst.Status = COMMITTED\n  1107\t\n  1108\t\tr.updateConflicts(commit.Command, commit.Replica, commit.Instance, commit.Seq)\n  1109\t\tr.updateCommitted(commit.Replica)\n  1110\t\tr.recordInstanceMetadata(r.InstanceSpace[commit.Replica][commit.Instance])\n  1111\t\tr.recordCommands(commit.Command)\n  1112\t\n  1113\t}\n  1114\t\n  1115\t/**********************************************************************\n  1116\t\n  1117\t                     RECOVERY ACTIONS\n  1118\t\n  1119\t***********************************************************************/\n  1120\t\n  1121\tfunc (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n  1122\t\tr.IsLeader = true\n  1123\t\tr.Println(\"I am the leader\")\n  1124\t\treturn nil\n  1125\t}\n  1126\t\n  1127\tfunc (r *Replica) startRecoveryForInstance(replica int32, instance int32) {\n  1128\t\tinst := r.InstanceSpace[replica][instance]\n  1129\t\tif inst == nil {\n  1130\t\t\tinst = r.newInstanceDefault(replica, instance)\n  1131\t\t\tr.InstanceSpace[replica][instance] = inst\n  1132\t\t} else if inst.Status >= COMMITTED && inst.Cmds != nil {\n  1133\t\t\tr.Printf(\"No need to recover %d.%d\", replica, instance)\n  1134\t\t\treturn\n  1135\t\t}\n  1136\t\n  1137\t\t// no TLA guidance here (some difference with the original implementation)\n  1138\t\tvar proposals []*defs.GPropose = nil\n  1139\t\tif inst.lb != nil {\n  1140\t\t\tproposals = inst.lb.clientProposals\n  1141\t\t}\n  1142\t\tinst.lb = r.newLeaderBookkeepingDefault()\n  1143\t\tlb := inst.lb\n  1144\t\tlb.clientProposals = proposals\n  1145\t\tlb.ballot = inst.vbal\n  1146\t\tlb.seq = inst.Seq\n  1147\t\tlb.cmds = inst.Cmds\n  1148\t\tlb.deps = inst.Deps\n  1149\t\tlb.status = inst.Status\n  1150\t\tr.makeBallot(replica, instance)\n  1151\t\n  1152\t\tinst.bal = lb.lastTriedBallot\n  1153\t\tinst.vbal = lb.lastTriedBallot\n  1154\t\tpreply := &PrepareReply{\n  1155\t\t\tr.Id,\n  1156\t\t\treplica,\n  1157\t\t\tinstance,\n  1158\t\t\tinst.bal,\n  1159\t\t\tinst.vbal,\n  1160\t\t\tinst.Status,\n  1161\t\t\tinst.Cmds,\n  1162\t\t\tinst.Seq,\n  1163\t\t\tinst.Deps}\n  1164\t\n  1165\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1166\t\tlb.leaderResponded = r.Id == replica\n  1167\t\n  1168\t\tr.bcastPrepare(replica, instance)\n  1169\t}\n  1170\t\n  1171\tfunc (r *Replica) handlePrepare(prepare *Prepare) {\n  1172\t\tinst := r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1173\t\tvar preply *PrepareReply\n  1174\t\n  1175\t\tif prepare.Ballot > r.maxRecvBallot {\n  1176\t\t\tr.maxRecvBallot = prepare.Ballot\n  1177\t\t}\n  1178\t\n  1179\t\tif inst == nil {\n  1180\t\t\tr.InstanceSpace[prepare.Replica][prepare.Instance] = r.newInstanceDefault(prepare.Replica, prepare.Instance)\n  1181\t\t\tinst = r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1182\t\t}\n  1183\t\n  1184\t\tif prepare.Ballot < inst.bal {\n  1185\t\t\tr.Printf(\"Joined higher ballot %d < %d\", prepare.Ballot, inst.bal)\n  1186\t\t} else if inst.bal < prepare.Ballot {\n  1187\t\t\tr.Printf(\"Joining ballot %d \", prepare.Ballot)\n  1188\t\t\tinst.bal = prepare.Ballot\n  1189\t\t}\n  1190\t\n  1191\t\tpreply = &PrepareReply{\n  1192\t\t\tr.Id,\n  1193\t\t\tprepare.Replica,\n  1194\t\t\tprepare.Instance,\n  1195\t\t\tinst.bal,\n  1196\t\t\tinst.vbal,\n  1197\t\t\tinst.Status,\n  1198\t\t\tinst.Cmds,\n  1199\t\t\tinst.Seq,\n  1200\t\t\tinst.Deps}\n  1201\t\tr.replyPrepare(prepare.LeaderId, preply)\n  1202\t}\n  1203\t\n  1204\tfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n  1205\t\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n  1206\t\tlb := inst.lb\n  1207\t\n  1208\t\tif preply.Ballot > r.maxRecvBallot {\n  1209\t\t\tr.maxRecvBallot = preply.Ballot\n  1210\t\t}\n  1211\t\n  1212\t\tif inst == nil || lb == nil || !lb.preparing {\n  1213\t\t\treturn\n  1214\t\t}\n  1215\t\n  1216\t\tif preply.Ballot != lb.lastTriedBallot {\n  1217\t\t\tlb.nacks++\n  1218\t\t\treturn\n  1219\t\t}\n  1220\t\n  1221\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1222\t\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n  1223\t\t\treturn\n  1224\t\t}\n  1225\t\n  1226\t\tlb.preparing = false\n  1227\t\n  1228\t\t// Deal with each sub-cases in order of the (corrected) TLA specification\n  1229\t\t// only replies from the highest ballot are taken into account\n  1230\t\t// 1 -> committed/executed\n  1231\t\t// 2 -> accepted\n  1232\t\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n  1233\t\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n  1234\t\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n  1235\t\t// 6 -> none of the above\n  1236\t\tpreAcceptCount := 0\n  1237\t\tsubCase := 0\n  1238\t\tallEqual := true\n  1239\t\tfor _, element := range lb.prepareReplies {\n  1240\t\t\tif element.VBallot >= lb.ballot {\n  1241\t\t\t\tlb.ballot = element.VBallot\n  1242\t\t\t\tlb.cmds = element.Command\n  1243\t\t\t\tlb.seq = element.Seq\n  1244\t\t\t\tlb.deps = element.Deps\n  1245\t\t\t\tlb.status = element.Status\n  1246\t\t\t}\n  1247\t\t\tif element.AcceptorId == element.Replica {\n  1248\t\t\t\tlb.leaderResponded = true\n  1249\t\t\t}\n  1250\t\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n  1251\t\t\t\tpreAcceptCount++\n  1252\t\t\t}\n  1253\t\t}\n  1254\t\n  1255\t\tif lb.status >= COMMITTED { // 1\n  1256\t\t\tsubCase = 1\n  1257\t\t} else if lb.status == ACCEPTED { // 2\n  1258\t\t\tsubCase = 2\n  1259\t\t} else if lb.status == PREACCEPTED || lb.status == PREACCEPTED_EQ {\n  1260\t\t\tfor _, element := range lb.prepareReplies {\n  1261\t\t\t\tif element.VBallot == lb.ballot && element.Status >= PREACCEPTED {\n  1262\t\t\t\t\t_, _, equal := r.mergeAttributes(lb.seq, lb.deps, element.Seq, element.Deps)\n  1263\t\t\t\t\tif !equal {\n  1264\t\t\t\t\t\tallEqual = false\n  1265\t\t\t\t\t\tbreak\n  1266\t\t\t\t\t}\n  1267\t\t\t\t}\n  1268\t\t\t}\n  1269\t\t\tif preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1270\t\t\t\tsubCase = 3\n  1271\t\t\t} else if preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1272\t\t\t\tsubCase = 4\n  1273\t\t\t} else if preAcceptCount > 0 && (lb.leaderResponded || !allEqual || preAcceptCount < r.Replica.SlowQuorumSize()-1) {\n  1274\t\t\t\tsubCase = 5\n  1275\t\t\t} else {\n  1276\t\t\t\tpanic(\"Cannot occur\")\n  1277\t\t\t}\n  1278\t\t} else if lb.status == NONE {\n  1279\t\t\tsubCase = 6\n  1280\t\t} else {\n  1281\t\t\tpanic(\"Status unknown\")\n  1282\t\t}\n  1283\t\n  1284\t\t// if subCase != 5 {\n  1285\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d\\n\", preply.Replica, preply.Instance, subCase)\n  1286\t\t// } else {\n  1287\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d with (leaderResponded=%t, allEqual=%t, enough=%t)\\n\",\n  1288\t\t// \t\tpreply.Replica, preply.Instance, subCase, lb.leaderResponded, allEqual, preAcceptCount < r.Replica.SlowQuorumSize()-1)\n  1289\t\t// }\n  1290\t\n  1291\t\tinst.Cmds = lb.cmds\n  1292\t\tinst.bal = lb.lastTriedBallot\n  1293\t\tinst.vbal = lb.lastTriedBallot\n  1294\t\tinst.Seq = lb.seq\n  1295\t\tinst.Deps = lb.deps\n  1296\t\tinst.Status = lb.status\n  1297\t\n  1298\t\tif subCase == 1 {\n  1299\t\t\t// nothing to do\n  1300\t\t} else if subCase == 2 || subCase == 3 {\n  1301\t\t\tinst.Status = ACCEPTED\n  1302\t\t\tlb.status = ACCEPTED\n  1303\t\t\tr.bcastAccept(preply.Replica, preply.Instance)\n  1304\t\t} else if subCase == 4 {\n  1305\t\t\tlb.tryingToPreAccept = true\n  1306\t\t\tr.bcastTryPreAccept(preply.Replica, preply.Instance)\n  1307\t\t} else { // subCase 5 and 6\n  1308\t\t\tcmd := state.NOOP()\n  1309\t\t\tif inst.lb.cmds != nil {\n  1310\t\t\t\tcmd = inst.lb.cmds\n  1311\t\t\t}\n  1312\t\t\tr.startPhase1(cmd, preply.Replica, preply.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1313\t\t}\n  1314\t}\n  1315\t\n  1316\tfunc (r *Replica) handleTryPreAccept(tpa *TryPreAccept) {\n  1317\t\tinst := r.InstanceSpace[tpa.Replica][tpa.Instance]\n  1318\t\n  1319\t\tif inst == nil {\n  1320\t\t\tr.InstanceSpace[tpa.Replica][tpa.Instance] = r.newInstanceDefault(tpa.Replica, tpa.Instance)\n  1321\t\t\tinst = r.InstanceSpace[tpa.Replica][tpa.Instance]\n  1322\t\t}\n  1323\t\n  1324\t\tif inst.bal > tpa.Ballot {\n  1325\t\t\tr.Printf(\"Smaller ballot %d < %d\\n\", tpa.Ballot, inst.bal)\n  1326\t\t\treturn\n  1327\t\t}\n  1328\t\tinst.bal = tpa.Ballot\n  1329\t\n  1330\t\tconfRep := int32(0)\n  1331\t\tconfInst := int32(0)\n  1332\t\tconfStatus := NONE\n  1333\t\tif inst.Status == NONE { // missing in TLA spec.\n  1334\t\t\tif conflict, cr, ci := r.findPreAcceptConflicts(tpa.Command, tpa.Replica, tpa.Instance, tpa.Seq, tpa.Deps); conflict {\n  1335\t\t\t\tconfRep = cr\n  1336\t\t\t\tconfInst = ci\n  1337\t\t\t} else {\n  1338\t\t\t\tif tpa.Instance > r.crtInstance[tpa.Replica] {\n  1339\t\t\t\t\tr.crtInstance[tpa.Replica] = tpa.Instance\n  1340\t\t\t\t}\n  1341\t\t\t\tinst.Cmds = tpa.Command\n  1342\t\t\t\tinst.Seq = tpa.Seq\n  1343\t\t\t\tinst.Deps = tpa.Deps\n  1344\t\t\t\tinst.Status = PREACCEPTED\n  1345\t\t\t}\n  1346\t\t}\n  1347\t\n  1348\t\trtpa := &TryPreAcceptReply{r.Id, tpa.Replica, tpa.Instance, inst.bal, inst.vbal, confRep, confInst, confStatus}\n  1349\t\n  1350\t\tr.replyTryPreAccept(tpa.LeaderId, rtpa)\n  1351\t\n  1352\t}\n  1353\t\n  1354\tfunc (r *Replica) findPreAcceptConflicts(cmds []state.Command, replica int32, instance int32, seq int32, deps []int32) (bool, int32, int32) {\n  1355\t\tinst := r.InstanceSpace[replica][instance]\n  1356\t\tif inst != nil && len(inst.Cmds) > 0 {\n  1357\t\t\tif inst.Status >= ACCEPTED {\n  1358\t\t\t\t// already ACCEPTED or COMMITTED\n  1359\t\t\t\t// we consider this a conflict because we shouldn't regress to PRE-ACCEPTED\n  1360\t\t\t\treturn true, replica, instance\n  1361\t\t\t}\n  1362\t\t\tif inst.Seq == seq && equal(inst.Deps, deps) {\n  1363\t\t\t\t// already PRE-ACCEPTED, no point looking for conflicts again\n  1364\t\t\t\treturn false, replica, instance\n  1365\t\t\t}\n  1366\t\t}\n  1367\t\tfor q := int32(0); q < int32(r.N); q++ {\n  1368\t\t\tfor i := r.ExecedUpTo[q]; i <= r.crtInstance[q]; i++ { // FIXME this is not enough imho.\n  1369\t\t\t\tif i == -1 {\n  1370\t\t\t\t\t//do not check placeholder\n  1371\t\t\t\t\tcontinue\n  1372\t\t\t\t}\n  1373\t\t\t\tif replica == q && instance == i {\n  1374\t\t\t\t\t// no point checking past instance in replica's row, since replica would have\n  1375\t\t\t\t\t// set the dependencies correctly for anything started after instance\n  1376\t\t\t\t\tbreak\n  1377\t\t\t\t}\n  1378\t\t\t\tif i == deps[q] {\n  1379\t\t\t\t\t//the instance cannot be a dependency for itself\n  1380\t\t\t\t\tcontinue\n  1381\t\t\t\t}\n  1382\t\t\t\tinst := r.InstanceSpace[q][i]\n  1383\t\t\t\tif inst == nil || inst.Cmds == nil || len(inst.Cmds) == 0 {\n  1384\t\t\t\t\tcontinue\n  1385\t\t\t\t}\n  1386\t\t\t\tif inst.Deps[replica] >= instance {\n  1387\t\t\t\t\t// instance q.i depends on instance replica.instance, it is not a conflict\n  1388\t\t\t\t\tcontinue\n  1389\t\t\t\t}\n  1390\t\t\t\tif r.LRead || state.ConflictBatch(inst.Cmds, cmds) {\n  1391\t\t\t\t\tif i > deps[q] ||\n  1392\t\t\t\t\t\t(i < deps[q] && inst.Seq >= seq && (q != replica || inst.Status > PREACCEPTED_EQ)) {\n  1393\t\t\t\t\t\t// this is a conflict\n  1394\t\t\t\t\t\treturn true, q, i\n  1395\t\t\t\t\t}\n  1396\t\t\t\t}\n  1397\t\t\t}\n  1398\t\t}\n  1399\t\treturn false, -1, -1\n  1400\t}\n  1401\t\n  1402\tfunc (r *Replica) handleTryPreAcceptReply(tpar *TryPreAcceptReply) {\n  1403\t\tinst := r.InstanceSpace[tpar.Replica][tpar.Instance]\n  1404\t\n  1405\t\tif tpar.Ballot > r.maxRecvBallot {\n  1406\t\t\tr.maxRecvBallot = tpar.Ballot\n  1407\t\t}\n  1408\t\n  1409\t\tif inst == nil {\n  1410\t\t\tr.InstanceSpace[tpar.Replica][tpar.Instance] = r.newInstanceDefault(tpar.Replica, tpar.Instance)\n  1411\t\t\tinst = r.InstanceSpace[tpar.Replica][tpar.Instance]\n  1412\t\t}\n  1413\t\n  1414\t\tlb := inst.lb\n  1415\t\tif lb == nil || !lb.tryingToPreAccept {\n  1416\t\t\treturn\n  1417\t\t}\n  1418\t\n  1419\t\tif tpar.Ballot != lb.lastTriedBallot {\n  1420\t\t\treturn\n  1421\t\t}\n  1422\t\n  1423\t\tlb.tpaReps++\n  1424\t\n  1425\t\tif tpar.VBallot == lb.lastTriedBallot {\n  1426\t\t\tlb.preAcceptOKs++\n  1427\t\t\tif lb.preAcceptOKs >= r.N/2 {\n  1428\t\t\t\t//it's safe to start Accept phase\n  1429\t\t\t\tlb.status = ACCEPTED\n  1430\t\t\t\tlb.tryingToPreAccept = false\n  1431\t\t\t\tlb.acceptOKs = 0\n  1432\t\n  1433\t\t\t\tinst.Cmds = lb.cmds\n  1434\t\t\t\tinst.Seq = lb.seq\n  1435\t\t\t\tinst.Deps = lb.deps\n  1436\t\t\t\tinst.Status = lb.status\n  1437\t\t\t\tinst.vbal = lb.lastTriedBallot\n  1438\t\t\t\tinst.bal = lb.lastTriedBallot\n  1439\t\n  1440\t\t\t\tr.bcastAccept(tpar.Replica, tpar.Instance)\n  1441\t\t\t\treturn\n  1442\t\t\t}\n  1443\t\t} else {\n  1444\t\t\tlb.nacks++\n  1445\t\t\tlb.possibleQuorum[tpar.AcceptorId] = false\n  1446\t\t\tlb.possibleQuorum[tpar.ConflictReplica] = false\n  1447\t\t}\n  1448\t\n  1449\t\tlb.tpaAccepted = lb.tpaAccepted || (tpar.ConflictStatus >= ACCEPTED) // TLA spec. (page 39)\n  1450\t\n  1451\t\tif lb.tpaReps >= r.Replica.SlowQuorumSize()-1 && lb.tpaAccepted {\n  1452\t\t\t//abandon recovery, restart from phase 1\n  1453\t\t\tlb.tryingToPreAccept = false\n  1454\t\t\tr.startPhase1(lb.cmds, tpar.Replica, tpar.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1455\t\t\treturn\n  1456\t\t}\n  1457\t\n  1458\t\t// the code below is not checked in TLA (liveness)\n  1459\t\tnotInQuorum := 0\n  1460\t\tfor q := 0; q < r.N; q++ {\n  1461\t\t\tif !lb.possibleQuorum[tpar.AcceptorId] {\n  1462\t\t\t\tnotInQuorum++\n  1463\t\t\t}\n  1464\t\t}\n  1465\t\n  1466\t\tif notInQuorum == r.N/2 {\n  1467\t\t\t//this is to prevent defer cycles\n  1468\t\t\tif present, dq, _ := deferredByInstance(tpar.Replica, tpar.Instance); present {\n  1469\t\t\t\tif lb.possibleQuorum[dq] {\n  1470\t\t\t\t\t//an instance whose leader must have been in this instance's quorum has been deferred for this instance => contradiction\n  1471\t\t\t\t\t//abandon recovery, restart from phase 1\n  1472\t\t\t\t\tlb.tryingToPreAccept = false\n  1473\t\t\t\t\tr.makeBallot(tpar.Replica, tpar.Instance)\n  1474\t\t\t\t\tr.startPhase1(lb.cmds, tpar.Replica, tpar.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1475\t\t\t\t\treturn\n  1476\t\t\t\t}\n  1477\t\t\t}\n  1478\t\t}\n  1479\t\n  1480\t\tif lb.tpaReps >= r.N/2 {\n  1481\t\t\t//defer recovery and update deferred information\n  1482\t\t\tupdateDeferred(tpar.Replica, tpar.Instance, tpar.ConflictReplica, tpar.ConflictInstance)\n  1483\t\t\tlb.tryingToPreAccept = false\n  1484\t\t}\n  1485\t}\n  1486\t\n  1487\t// helper functions and structures to prevent defer cycles while recovering\n  1488\t\n  1489\tvar deferMap = make(map[uint64]uint64)\n  1490\t\n  1491\tfunc updateDeferred(dr int32, di int32, r int32, i int32) {\n  1492\t\tdaux := (uint64(dr) << 32) | uint64(di)\n  1493\t\taux := (uint64(r) << 32) | uint64(i)\n  1494\t\tdeferMap[aux] = daux\n  1495\t}\n  1496\t\n  1497\tfunc deferredByInstance(q int32, i int32) (bool, int32, int32) {\n  1498\t\taux := (uint64(q) << 32) | uint64(i)\n  1499\t\tdaux, present := deferMap[aux]\n  1500\t\tif !present {\n  1501\t\t\treturn false, 0, 0\n  1502\t\t}\n  1503\t\tdq := int32(daux >> 32)\n  1504\t\tdi := int32(daux)\n  1505\t\treturn true, dq, di\n  1506\t}\n  1507\t\n  1508\tfunc (r *Replica) newInstanceDefault(replica int32, instance int32) *Instance {\n  1509\t\treturn r.newInstance(replica, instance, nil, -1, -1, NONE, -1, nil)\n  1510\t}\n  1511\t\n  1512\tfunc (r *Replica) newInstance(replica int32, instance int32, cmds []state.Command, cballot int32, lballot int32, status int8, seq int32, deps []int32) *Instance {\n  1513\t\treturn &Instance{cmds, cballot, lballot, status, seq, deps, nil, 0, 0, nil, time.Now().UnixNano(), &instanceId{replica, instance}}\n  1514\t}\n  1515\t\n  1516\tfunc (r *Replica) newLeaderBookkeepingDefault() *LeaderBookkeeping {\n  1517\t\treturn r.newLeaderBookkeeping(nil, r.newNilDeps(), r.newNilDeps(), r.newNilDeps(), 0, nil, NONE, -1)\n  1518\t}\n  1519\t\n  1520\tfunc (r *Replica) newLeaderBookkeeping(p []*defs.GPropose, originalDeps []int32, committedDeps []int32, deps []int32, lastTriedBallot int32, cmds []state.Command, status int8, seq int32) *LeaderBookkeeping {\n  1521\t\treturn &LeaderBookkeeping{p, -1, true, 0, 0, 0, originalDeps, committedDeps, nil, true, false, make([]bool, r.N), 0, false, lastTriedBallot, cmds, status, seq, deps, false}\n  1522\t}\n  1523\t\n  1524\tfunc (r *Replica) newNilDeps() []int32 {\n  1525\t\tnildeps := make([]int32, r.N)\n  1526\t\tfor i := 0; i < r.N; i++ {\n  1527\t\t\tnildeps[i] = -1\n  1528\t\t}\n  1529\t\treturn nildeps\n  1530\t}\n","exit_code":0,"status":"completed"}}
