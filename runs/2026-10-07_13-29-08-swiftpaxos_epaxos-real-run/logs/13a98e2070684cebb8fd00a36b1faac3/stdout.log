{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat -n /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run/agent-source/replica/replica.go'","aggregated_output":"     1\tpackage replica\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"encoding/binary\"\n     6\t\t\"encoding/json\"\n     7\t\t\"io\"\n     8\t\t\"math\"\n     9\t\t\"net\"\n    10\t\t\"os\"\n    11\t\t\"sort\"\n    12\t\t\"strings\"\n    13\t\t\"sync\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/imdea-software/swiftpaxos/config\"\n    17\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    18\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    19\t\tfastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n    20\t\t\"github.com/imdea-software/swiftpaxos/state\"\n    21\t)\n    22\t\n    23\ttype Replica struct {\n    24\t\t*dlog.Logger\n    25\t\n    26\t\tM     sync.Mutex\n    27\t\tN     int\n    28\t\tF     int\n    29\t\tId    int32\n    30\t\tAlias string\n    31\t\n    32\t\tPeerAddrList       []string\n    33\t\tPeers              []net.Conn\n    34\t\tPeerReaders        []*bufio.Reader\n    35\t\tPeerWriters        []*bufio.Writer\n    36\t\tClientWriters      map[int32]*bufio.Writer\n    37\t\tConfig             *config.Config\n    38\t\tAlive              []bool\n    39\t\tPreferredPeerOrder []int32\n    40\t\n    41\t\tState       *state.State\n    42\t\tRPC         *fastrpc.Table\n    43\t\tStableStore *os.File\n    44\t\tStats       *defs.Stats\n    45\t\tShutdown    bool\n    46\t\tListener    net.Listener\n    47\t\tProposeChan chan *defs.GPropose\n    48\t\tBeaconChan  chan *defs.GBeacon\n    49\t\n    50\t\tThrifty bool\n    51\t\tExec    bool\n    52\t\tLRead   bool\n    53\t\tDreply  bool\n    54\t\tBeacon  bool\n    55\t\tDurable bool\n    56\t\n    57\t\tEwma      []float64\n    58\t\tLatencies []int64\n    59\t\n    60\t\tDt *defs.LatencyTable\n    61\t}\n    62\t\n    63\tfunc New(alias string, id, f int, addrs []string, thrifty, exec, lread bool, config *config.Config, l *dlog.Logger) *Replica {\n    64\t\tn := len(addrs)\n    65\t\tr := &Replica{\n    66\t\t\tLogger: l,\n    67\t\n    68\t\t\tN:     n,\n    69\t\t\tF:     f,\n    70\t\t\tId:    int32(id),\n    71\t\t\tAlias: alias,\n    72\t\n    73\t\t\tPeerAddrList:       addrs,\n    74\t\t\tPeers:              make([]net.Conn, n),\n    75\t\t\tPeerReaders:        make([]*bufio.Reader, n),\n    76\t\t\tPeerWriters:        make([]*bufio.Writer, n),\n    77\t\t\tClientWriters:      make(map[int32]*bufio.Writer),\n    78\t\t\tConfig:             config,\n    79\t\t\tAlive:              make([]bool, n),\n    80\t\t\tPreferredPeerOrder: make([]int32, n),\n    81\t\n    82\t\t\tState:       state.InitState(),\n    83\t\t\tRPC:         fastrpc.NewTableId(defs.RPC_TABLE),\n    84\t\t\tStableStore: nil,\n    85\t\t\tStats:       &defs.Stats{make(map[string]int)},\n    86\t\t\tShutdown:    false,\n    87\t\t\tListener:    nil,\n    88\t\t\tProposeChan: make(chan *defs.GPropose, defs.CHAN_BUFFER_SIZE),\n    89\t\t\tBeaconChan:  make(chan *defs.GBeacon, defs.CHAN_BUFFER_SIZE),\n    90\t\n    91\t\t\tThrifty: thrifty,\n    92\t\t\tExec:    exec,\n    93\t\t\tLRead:   lread,\n    94\t\t\tDreply:  true,\n    95\t\t\tBeacon:  false,\n    96\t\t\tDurable: false,\n    97\t\n    98\t\t\tEwma:      make([]float64, n),\n    99\t\t\tLatencies: make([]int64, n),\n   100\t\n   101\t\t\tDt: defs.NewLatencyTable(defs.LatencyConf, defs.IP(), addrs),\n   102\t\t}\n   103\t\n   104\t\tfor i := 0; i < r.N; i++ {\n   105\t\t\tr.PreferredPeerOrder[i] = int32((int(r.Id) + 1 + i) % r.N)\n   106\t\t\tr.Ewma[i] = 0.0\n   107\t\t\tr.Latencies[i] = 0\n   108\t\t}\n   109\t\n   110\t\treturn r\n   111\t}\n   112\t\n   113\tfunc (r *Replica) Ping(args *defs.PingArgs, reply *defs.PingReply) error {\n   114\t\treturn nil\n   115\t}\n   116\t\n   117\tfunc (r *Replica) BeTheLeader(args *defs.BeTheLeaderArgs, reply *defs.BeTheLeaderReply) error {\n   118\t\treturn nil\n   119\t}\n   120\t\n   121\tfunc (r *Replica) FastQuorumSize() int {\n   122\t\treturn r.F + (r.F+1)/2\n   123\t}\n   124\t\n   125\tfunc (r *Replica) SlowQuorumSize() int {\n   126\t\treturn (r.N + 1) / 2\n   127\t}\n   128\t\n   129\tfunc (r *Replica) WriteQuorumSize() int {\n   130\t\treturn r.F + 1\n   131\t}\n   132\t\n   133\tfunc (r *Replica) ReadQuorumSize() int {\n   134\t\treturn r.N - r.F\n   135\t}\n   136\t\n   137\tfunc (r *Replica) ConnectToPeers() {\n   138\t\tvar b [4]byte\n   139\t\tbs := b[:4]\n   140\t\tdone := make(chan bool)\n   141\t\n   142\t\tgo r.waitForPeerConnections(done)\n   143\t\n   144\t\tfor i := 0; i < int(r.Id); i++ {\n   145\t\t\tfor {\n   146\t\t\t\tif conn, err := net.Dial(\"tcp\", r.PeerAddrList[i]); err == nil {\n   147\t\t\t\t\tr.Peers[i] = conn\n   148\t\t\t\t\tbreak\n   149\t\t\t\t}\n   150\t\t\t\ttime.Sleep(1e9)\n   151\t\t\t}\n   152\t\t\tbinary.LittleEndian.PutUint32(bs, uint32(r.Id))\n   153\t\t\tif _, err := r.Peers[i].Write(bs); err != nil {\n   154\t\t\t\tr.Println(\"Write id error:\", err)\n   155\t\t\t\tcontinue\n   156\t\t\t}\n   157\t\t\tr.Alive[i] = true\n   158\t\t\tr.PeerReaders[i] = bufio.NewReader(r.Peers[i])\n   159\t\t\tr.PeerWriters[i] = bufio.NewWriter(r.Peers[i])\n   160\t\t\tr.Printf(\"OUT Connected to %d\", i)\n   161\t\t}\n   162\t\t<-done\n   163\t\tr.Printf(\"Replica %d: done connecting to peers\", r.Id)\n   164\t\tr.Printf(\"Node list %v\", r.PeerAddrList)\n   165\t\n   166\t\tfor rid, reader := range r.PeerReaders {\n   167\t\t\tif int32(rid) == r.Id {\n   168\t\t\t\tcontinue\n   169\t\t\t}\n   170\t\t\tgo r.replicaListener(rid, reader)\n   171\t\t}\n   172\t}\n   173\t\n   174\tfunc (r *Replica) ConnectToPeersNoListeners() {\n   175\t\tvar b [4]byte\n   176\t\tbs := b[:4]\n   177\t\tdone := make(chan bool)\n   178\t\n   179\t\tgo r.waitForPeerConnections(done)\n   180\t\n   181\t\tfor i := 0; i < int(r.Id); i++ {\n   182\t\t\tfor {\n   183\t\t\t\tif conn, err := net.Dial(\"tcp\", r.PeerAddrList[i]); err == nil {\n   184\t\t\t\t\tr.Peers[i] = conn\n   185\t\t\t\t\tbreak\n   186\t\t\t\t}\n   187\t\t\t\ttime.Sleep(1e9)\n   188\t\t\t}\n   189\t\t\tbinary.LittleEndian.PutUint32(bs, uint32(r.Id))\n   190\t\t\tif _, err := r.Peers[i].Write(bs); err != nil {\n   191\t\t\t\tr.Println(\"Write id error:\", err)\n   192\t\t\t\tcontinue\n   193\t\t\t}\n   194\t\t\tr.Alive[i] = true\n   195\t\t\tr.PeerReaders[i] = bufio.NewReader(r.Peers[i])\n   196\t\t\tr.PeerWriters[i] = bufio.NewWriter(r.Peers[i])\n   197\t\t}\n   198\t\t<-done\n   199\t\tr.Printf(\"Replica id: %d. Done connecting to peers\\n\", r.Id)\n   200\t}\n   201\t\n   202\tfunc (r *Replica) WaitForClientConnections() {\n   203\t\tr.Println(\"Waiting for client connections\")\n   204\t\n   205\t\tfor !r.Shutdown {\n   206\t\t\tconn, err := r.Listener.Accept()\n   207\t\t\tif err != nil {\n   208\t\t\t\tr.Println(\"Accept error:\", err)\n   209\t\t\t\tcontinue\n   210\t\t\t}\n   211\t\t\tgo r.clientListener(conn)\n   212\t\t}\n   213\t}\n   214\t\n   215\tfunc (r *Replica) SendMsg(peerId int32, code uint8, msg fastrpc.Serializable) {\n   216\t\tr.M.Lock()\n   217\t\tdefer r.M.Unlock()\n   218\t\n   219\t\tw := r.PeerWriters[peerId]\n   220\t\tif w == nil {\n   221\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   222\t\t\treturn\n   223\t\t}\n   224\t\tw.WriteByte(code)\n   225\t\tmsg.Marshal(w)\n   226\t\tw.Flush()\n   227\t}\n   228\t\n   229\tfunc (r *Replica) SendClientMsg(id int32, code uint8, msg fastrpc.Serializable) {\n   230\t\tr.M.Lock()\n   231\t\tdefer r.M.Unlock()\n   232\t\n   233\t\tw := r.ClientWriters[id]\n   234\t\tif w == nil {\n   235\t\t\tr.Printf(\"Connection to client %d lost!\", id)\n   236\t\t\treturn\n   237\t\t}\n   238\t\tw.WriteByte(code)\n   239\t\tmsg.Marshal(w)\n   240\t\tw.Flush()\n   241\t}\n   242\t\n   243\tfunc (r *Replica) SendMsgNoFlush(peerId int32, code uint8, msg fastrpc.Serializable) {\n   244\t\tr.M.Lock()\n   245\t\tdefer r.M.Unlock()\n   246\t\n   247\t\tw := r.PeerWriters[peerId]\n   248\t\tif w == nil {\n   249\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   250\t\t\treturn\n   251\t\t}\n   252\t\tw.WriteByte(code)\n   253\t\tmsg.Marshal(w)\n   254\t}\n   255\t\n   256\tfunc (r *Replica) ReplyProposeTS(reply *defs.ProposeReplyTS, w *bufio.Writer, lock *sync.Mutex) {\n   257\t\tr.M.Lock()\n   258\t\tdefer r.M.Unlock()\n   259\t\n   260\t\treply.Marshal(w)\n   261\t\tw.Flush()\n   262\t}\n   263\t\n   264\tfunc (r *Replica) SendBeacon(peerId int32) {\n   265\t\tr.M.Lock()\n   266\t\tdefer r.M.Unlock()\n   267\t\n   268\t\tw := r.PeerWriters[peerId]\n   269\t\tif w == nil {\n   270\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   271\t\t\treturn\n   272\t\t}\n   273\t\tw.WriteByte(defs.GENERIC_SMR_BEACON)\n   274\t\tbeacon := &defs.Beacon{\n   275\t\t\tTimestamp: time.Now().UnixNano(),\n   276\t\t}\n   277\t\tbeacon.Marshal(w)\n   278\t\tw.Flush()\n   279\t}\n   280\t\n   281\tfunc (r *Replica) ReplyBeacon(beacon *defs.GBeacon) {\n   282\t\tr.M.Lock()\n   283\t\tdefer r.M.Unlock()\n   284\t\n   285\t\tw := r.PeerWriters[beacon.Rid]\n   286\t\tif w == nil {\n   287\t\t\tr.Printf(\"Connection to %d lost!\", beacon.Rid)\n   288\t\t\treturn\n   289\t\t}\n   290\t\tw.WriteByte(defs.GENERIC_SMR_BEACON_REPLY)\n   291\t\trb := &defs.BeaconReply{\n   292\t\t\tTimestamp: beacon.Timestamp,\n   293\t\t}\n   294\t\trb.Marshal(w)\n   295\t\tw.Flush()\n   296\t}\n   297\t\n   298\tfunc (r *Replica) UpdatePreferredPeerOrder(quorum []int32) {\n   299\t\taux := make([]int32, r.N)\n   300\t\ti := 0\n   301\t\tfor _, p := range quorum {\n   302\t\t\tif p == r.Id {\n   303\t\t\t\tcontinue\n   304\t\t\t}\n   305\t\t\taux[i] = p\n   306\t\t\ti++\n   307\t\t}\n   308\t\n   309\t\tfor _, p := range r.PreferredPeerOrder {\n   310\t\t\tfound := false\n   311\t\t\tfor j := 0; j < i; j++ {\n   312\t\t\t\tif aux[j] == p {\n   313\t\t\t\t\tfound = true\n   314\t\t\t\t\tbreak\n   315\t\t\t\t}\n   316\t\t\t}\n   317\t\t\tif !found {\n   318\t\t\t\taux[i] = p\n   319\t\t\t\ti++\n   320\t\t\t}\n   321\t\t}\n   322\t\n   323\t\tr.M.Lock()\n   324\t\tr.PreferredPeerOrder = aux\n   325\t\tr.M.Unlock()\n   326\t}\n   327\t\n   328\tfunc (r *Replica) ComputeClosestPeers() []float64 {\n   329\t\tnpings := 20\n   330\t\n   331\t\tfor j := 0; j < npings; j++ {\n   332\t\t\tfor i := int32(0); i < int32(r.N); i++ {\n   333\t\t\t\tif i == r.Id {\n   334\t\t\t\t\tcontinue\n   335\t\t\t\t}\n   336\t\t\t\tr.M.Lock()\n   337\t\t\t\tif r.Alive[i] {\n   338\t\t\t\t\tr.M.Unlock()\n   339\t\t\t\t\tr.SendBeacon(i)\n   340\t\t\t\t} else {\n   341\t\t\t\t\tr.Latencies[i] = math.MaxInt64\n   342\t\t\t\t\tr.M.Unlock()\n   343\t\t\t\t}\n   344\t\t\t}\n   345\t\t\ttime.Sleep(500 * time.Millisecond)\n   346\t\t}\n   347\t\n   348\t\tquorum := make([]int32, r.N)\n   349\t\n   350\t\tr.M.Lock()\n   351\t\tfor i := int32(0); i < int32(r.N); i++ {\n   352\t\t\tpos := 0\n   353\t\t\tfor j := int32(0); j < int32(r.N); j++ {\n   354\t\t\t\tif (r.Latencies[j] < r.Latencies[i]) ||\n   355\t\t\t\t\t((r.Latencies[j] == r.Latencies[i]) && (j < i)) {\n   356\t\t\t\t\tpos++\n   357\t\t\t\t}\n   358\t\t\t}\n   359\t\t\tquorum[pos] = int32(i)\n   360\t\t}\n   361\t\tr.M.Unlock()\n   362\t\n   363\t\tif r.Dt == nil {\n   364\t\t\tr.UpdatePreferredPeerOrder(quorum)\n   365\t\t} else {\n   366\t\t\tsort.Slice(r.PreferredPeerOrder, func(i, j int) bool {\n   367\t\t\t\tdi := r.Dt.WaitDurationID(int(r.PreferredPeerOrder[i]))\n   368\t\t\t\tdj := r.Dt.WaitDurationID(int(r.PreferredPeerOrder[j]))\n   369\t\t\t\treturn dj == time.Duration(0) || di < dj\n   370\t\t\t})\n   371\t\t}\n   372\t\n   373\t\tlatencies := make([]float64, r.N-1)\n   374\t\n   375\t\tfor i := 0; i < r.N-1; i++ {\n   376\t\t\tnode := r.PreferredPeerOrder[i]\n   377\t\t\tlat := float64(r.Latencies[node]) / float64(npings*1000000)\n   378\t\t\tr.Println(node, \"->\", lat, \"ms\")\n   379\t\t\tlatencies[i] = lat\n   380\t\t}\n   381\t\n   382\t\treturn latencies\n   383\t}\n   384\t\n   385\tfunc (r *Replica) waitForPeerConnections(done chan bool) {\n   386\t\tvar b [4]byte\n   387\t\tbs := b[:4]\n   388\t\n   389\t\tport := strings.Split(r.PeerAddrList[r.Id], \":\")[1]\n   390\t\tl, err := net.Listen(\"tcp\", \"0.0.0.0:\"+port)\n   391\t\tif err != nil {\n   392\t\t\tr.Fatal(r.PeerAddrList[r.Id], err)\n   393\t\t}\n   394\t\tr.Listener = l\n   395\t\tfor i := r.Id + 1; i < int32(r.N); i++ {\n   396\t\t\tconn, err := r.Listener.Accept()\n   397\t\t\tif err != nil {\n   398\t\t\t\tr.Println(\"Accept error:\", err)\n   399\t\t\t\tcontinue\n   400\t\t\t}\n   401\t\t\tif _, err := io.ReadFull(conn, bs); err != nil {\n   402\t\t\t\tr.Println(\"Connection establish error:\", err)\n   403\t\t\t\tcontinue\n   404\t\t\t}\n   405\t\t\tid := int32(binary.LittleEndian.Uint32(bs))\n   406\t\t\tr.Peers[id] = conn\n   407\t\t\tr.PeerReaders[id] = bufio.NewReader(conn)\n   408\t\t\tr.PeerWriters[id] = bufio.NewWriter(conn)\n   409\t\t\tr.Alive[id] = true\n   410\t\t\tr.Printf(\"IN Connected to %d\", id)\n   411\t\t}\n   412\t\n   413\t\tdone <- true\n   414\t}\n   415\t\n   416\tfunc (r *Replica) replicaListener(rid int, reader *bufio.Reader) {\n   417\t\tvar (\n   418\t\t\tmsgType      uint8\n   419\t\t\terr          error = nil\n   420\t\t\tgbeacon      defs.Beacon\n   421\t\t\tgbeaconReply defs.BeaconReply\n   422\t\t)\n   423\t\n   424\t\tfor err == nil && !r.Shutdown {\n   425\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   426\t\t\t\tbreak\n   427\t\t\t}\n   428\t\n   429\t\t\tswitch uint8(msgType) {\n   430\t\n   431\t\t\tcase defs.GENERIC_SMR_BEACON:\n   432\t\t\t\tif err = gbeacon.Unmarshal(reader); err != nil {\n   433\t\t\t\t\tbreak\n   434\t\t\t\t}\n   435\t\t\t\tr.ReplyBeacon(&defs.GBeacon{\n   436\t\t\t\t\tRid:       int32(rid),\n   437\t\t\t\t\tTimestamp: gbeacon.Timestamp,\n   438\t\t\t\t})\n   439\t\t\t\tbreak\n   440\t\n   441\t\t\tcase defs.GENERIC_SMR_BEACON_REPLY:\n   442\t\t\t\tif err = gbeaconReply.Unmarshal(reader); err != nil {\n   443\t\t\t\t\tbreak\n   444\t\t\t\t}\n   445\t\t\t\tr.M.Lock()\n   446\t\t\t\tr.Latencies[rid] += time.Now().UnixNano() - gbeaconReply.Timestamp\n   447\t\t\t\tr.M.Unlock()\n   448\t\t\t\tnow := time.Now().UnixNano()\n   449\t\t\t\tr.Ewma[rid] = 0.99*r.Ewma[rid] + 0.01*float64(now-gbeaconReply.Timestamp)\n   450\t\t\t\tbreak\n   451\t\n   452\t\t\tdefault:\n   453\t\t\t\tp, exists := r.RPC.Get(msgType)\n   454\t\t\t\tif exists {\n   455\t\t\t\t\tobj := p.Obj.New()\n   456\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   457\t\t\t\t\t\tbreak\n   458\t\t\t\t\t}\n   459\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   460\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDurationID(rid))\n   461\t\t\t\t\t\tp.Chan <- obj\n   462\t\t\t\t\t}(obj)\n   463\t\t\t\t} else {\n   464\t\t\t\t\tr.Fatal(\"Error: received unknown message type \", msgType, \" from \", rid)\n   465\t\t\t\t}\n   466\t\t\t}\n   467\t\t}\n   468\t\n   469\t\tr.M.Lock()\n   470\t\tr.Alive[rid] = false\n   471\t\tr.M.Unlock()\n   472\t}\n   473\t\n   474\tfunc (r *Replica) clientListener(conn net.Conn) {\n   475\t\treader := bufio.NewReader(conn)\n   476\t\twriter := bufio.NewWriter(conn)\n   477\t\n   478\t\tvar (\n   479\t\t\tmsgType byte\n   480\t\t\terr     error\n   481\t\t)\n   482\t\n   483\t\tr.M.Lock()\n   484\t\tr.Println(\"Client up\", conn.RemoteAddr(), \"(\", r.LRead, \")\")\n   485\t\tr.M.Unlock()\n   486\t\n   487\t\taddr := strings.Split(conn.RemoteAddr().String(), \":\")[0]\n   488\t\tisProxy := r.Config.Proxy.IsProxy(r.Alias, addr)\n   489\t\n   490\t\tmutex := &sync.Mutex{}\n   491\t\n   492\t\tdchan := defs.NewDelayProposeChan(r.Dt.WaitDuration(addr), r.ProposeChan)\n   493\t\n   494\t\tfor !r.Shutdown && err == nil {\n   495\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   496\t\t\t\tbreak\n   497\t\t\t}\n   498\t\n   499\t\t\tswitch uint8(msgType) {\n   500\t\t\tcase defs.PROPOSE:\n   501\t\t\t\tpropose := &defs.Propose{}\n   502\t\t\t\tif err = propose.Unmarshal(reader); err != nil {\n   503\t\t\t\t\tbreak\n   504\t\t\t\t}\n   505\t\t\t\tr.M.Lock()\n   506\t\t\t\tr.ClientWriters[propose.ClientId] = writer\n   507\t\t\t\tr.M.Unlock()\n   508\t\t\t\top := propose.Command.Op\n   509\t\t\t\tif r.LRead && (op == state.GET || op == state.SCAN) {\n   510\t\t\t\t\tr.ReplyProposeTS(&defs.ProposeReplyTS{\n   511\t\t\t\t\t\tOK:        defs.TRUE,\n   512\t\t\t\t\t\tCommandId: propose.CommandId,\n   513\t\t\t\t\t\tValue:     propose.Command.Execute(r.State),\n   514\t\t\t\t\t\tTimestamp: propose.Timestamp,\n   515\t\t\t\t\t}, writer, mutex)\n   516\t\t\t\t} else {\n   517\t\t\t\t\tdchan.Write(&defs.GPropose{\n   518\t\t\t\t\t\tPropose: propose,\n   519\t\t\t\t\t\tReply:   writer,\n   520\t\t\t\t\t\tMutex:   mutex,\n   521\t\t\t\t\t\tProxy:   isProxy,\n   522\t\t\t\t\t\tAddr:    addr,\n   523\t\t\t\t\t})\n   524\t\t\t\t}\n   525\t\t\t\tbreak\n   526\t\n   527\t\t\tcase defs.READ:\n   528\t\t\t\t// TODO: do something with this\n   529\t\t\t\tread := &defs.Read{}\n   530\t\t\t\tif err = read.Unmarshal(reader); err != nil {\n   531\t\t\t\t\tbreak\n   532\t\t\t\t}\n   533\t\t\t\tbreak\n   534\t\n   535\t\t\tcase defs.PROPOSE_AND_READ:\n   536\t\t\t\t// TODO: do something with this\n   537\t\t\t\tpr := &defs.ProposeAndRead{}\n   538\t\t\t\tif err = pr.Unmarshal(reader); err != nil {\n   539\t\t\t\t\tbreak\n   540\t\t\t\t}\n   541\t\t\t\tbreak\n   542\t\n   543\t\t\tcase defs.STATS:\n   544\t\t\t\tr.M.Lock()\n   545\t\t\t\tb, _ := json.Marshal(r.Stats)\n   546\t\t\t\tr.M.Unlock()\n   547\t\t\t\twriter.Write(b)\n   548\t\t\t\twriter.Flush()\n   549\t\n   550\t\t\tdefault:\n   551\t\t\t\tp, exists := r.RPC.Get(msgType)\n   552\t\t\t\tif exists {\n   553\t\t\t\t\tobj := p.Obj.New()\n   554\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   555\t\t\t\t\t\tbreak\n   556\t\t\t\t\t}\n   557\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   558\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDuration(addr))\n   559\t\t\t\t\t\tp.Chan <- obj\n   560\t\t\t\t\t}(obj)\n   561\t\t\t\t} else {\n   562\t\t\t\t\tr.Fatal(\"Error: received unknown client message \", msgType)\n   563\t\t\t\t}\n   564\t\t\t}\n   565\t\t}\n   566\t\n   567\t\tconn.Close()\n   568\t\tr.Println(\"Client down\", conn.RemoteAddr())\n   569\t}\n   570\t\n   571\tfunc Leader(ballot int32, repNum int) int32 {\n   572\t\treturn ballot % int32(repNum)\n   573\t}\n   574\t\n   575\tfunc NextBallotOf(rid, oldBallot int32, repNum int) int32 {\n   576\t\treturn (oldBallot/int32(repNum)+1)*int32(repNum) + rid\n   577\t}\n","exit_code":0,"status":"completed"}}
