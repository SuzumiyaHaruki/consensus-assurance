{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run/agent-source && cat -n replica/defs/latency.go | sed -n '1,130p' && echo \\\"=== dlog ===\\\" && cat -n dlog/dlog.go\"","aggregated_output":"     1\tpackage defs\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"net\"\n     6\t\t\"os\"\n     7\t\t\"strings\"\n     8\t\t\"time\"\n     9\t)\n    10\t\n    11\tvar LatencyConf = \"\"\n    12\t\n    13\ttype LatencyTable struct {\n    14\t\tti map[int]time.Duration\n    15\t\ttn map[string]time.Duration\n    16\t\td  time.Duration\n    17\t}\n    18\t\n    19\ttype DelayProposeChan struct {\n    20\t\tdelay time.Duration\n    21\t\tpChan chan *GPropose\n    22\t\tlChan chan logCall\n    23\t}\n    24\t\n    25\ttype bstNode struct {\n    26\t\tp     *GPropose\n    27\t\tleft  *bstNode\n    28\t\tright *bstNode\n    29\t\tready bool\n    30\t}\n    31\t\n    32\ttype logCall struct {\n    33\t\taction int\n    34\t\targ    *GPropose\n    35\t}\n    36\t\n    37\tconst (\n    38\t\tLOG_INSERT = iota\n    39\t\tLOG_HANDLE\n    40\t)\n    41\t\n    42\tfunc (root *bstNode) insert(p *GPropose) *bstNode {\n    43\t\tif root == nil {\n    44\t\t\treturn &bstNode{\n    45\t\t\t\tp: p,\n    46\t\t\t}\n    47\t\t}\n    48\t\tif j := root.p.CommandId; p.CommandId < j {\n    49\t\t\troot.left = root.left.insert(p)\n    50\t\t} else if p.CommandId > j {\n    51\t\t\troot.right = root.right.insert(p)\n    52\t\t}\n    53\t\n    54\t\treturn root\n    55\t}\n    56\t\n    57\tfunc (root *bstNode) find(i int32) *bstNode {\n    58\t\tif root == nil {\n    59\t\t\treturn nil\n    60\t\t}\n    61\t\tif j := root.p.CommandId; j == i {\n    62\t\t\treturn root\n    63\t\t} else if j < i {\n    64\t\t\treturn root.right.find(i)\n    65\t\t}\n    66\t\treturn root.left.find(i)\n    67\t}\n    68\t\n    69\t// call `handle` on each continuous element starting from `min`\n    70\t// returns new root and the id of the last handled proposal\n    71\tfunc (root *bstNode) inorderReady(min int32, handle func(*GPropose)) (*bstNode, int32) {\n    72\t\tif root == nil {\n    73\t\t\treturn nil, min\n    74\t\t}\n    75\t\n    76\t\tl, i := root.left.inorderReady(min, handle)\n    77\t\n    78\t\tif l == nil {\n    79\t\t\troot.left = nil\n    80\t\t}\n    81\t\n    82\t\tif !root.ready || i != root.p.CommandId-1 {\n    83\t\t\treturn root, i\n    84\t\t}\n    85\t\thandle(root.p)\n    86\t\tr, j := root.right.inorderReady(i+1, handle)\n    87\t\treturn r, j\n    88\t}\n    89\t\n    90\tfunc NewDelayProposeChan(d time.Duration, c chan *GPropose) *DelayProposeChan {\n    91\t\tif d == time.Duration(0) {\n    92\t\t\treturn &DelayProposeChan{\n    93\t\t\t\tdelay: d,\n    94\t\t\t\tpChan: c,\n    95\t\t\t}\n    96\t\t}\n    97\t\n    98\t\tdc := &DelayProposeChan{\n    99\t\t\tdelay: d,\n   100\t\t\tpChan: c,\n   101\t\t\tlChan: make(chan logCall),\n   102\t\t}\n   103\t\n   104\t\tvar (\n   105\t\t\tlog *bstNode\n   106\t\t\tmin int32 = -1\n   107\t\t)\n   108\t\n   109\t\tgo func() {\n   110\t\t\tfor {\n   111\t\t\t\ta := <-dc.lChan\n   112\t\t\t\tswitch a.action {\n   113\t\t\t\tcase LOG_INSERT:\n   114\t\t\t\t\tlog = log.insert(a.arg)\n   115\t\t\t\tcase LOG_HANDLE:\n   116\t\t\t\t\tn := log.find(a.arg.CommandId)\n   117\t\t\t\t\tif n == nil {\n   118\t\t\t\t\t\tlog = log.insert(a.arg)\n   119\t\t\t\t\t\tn = log.find(a.arg.CommandId)\n   120\t\t\t\t\t}\n   121\t\t\t\t\tn.ready = true\n   122\t\t\t\t\tlog, min = log.inorderReady(min, func(p *GPropose) {\n   123\t\t\t\t\t\tdc.pChan <- p\n   124\t\t\t\t\t})\n   125\t\t\t\t}\n   126\t\t\t}\n   127\t\t}()\n   128\t\n   129\t\treturn dc\n   130\t}\n=== dlog ===\n     1\tpackage dlog\n     2\t\n     3\timport (\n     4\t\t\"log\"\n     5\t\t\"os\"\n     6\t)\n     7\t\n     8\tvar DLOG = false\n     9\t\n    10\tfunc Printf(format string, v ...any) {\n    11\t\tif DLOG {\n    12\t\t\tlog.Printf(format, v...)\n    13\t\t}\n    14\t}\n    15\t\n    16\tfunc Println(v ...any) {\n    17\t\tif DLOG {\n    18\t\t\tlog.Println(v...)\n    19\t\t}\n    20\t}\n    21\t\n    22\ttype Logger struct {\n    23\t\tlogger  *log.Logger\n    24\t\tverbose bool\n    25\t}\n    26\t\n    27\tfunc New(logPath string, verbose bool) *Logger {\n    28\t\tlogF := os.Stdout\n    29\t\tif logPath != \"\" {\n    30\t\t\tvar err error\n    31\t\t\tlogF, err = os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY, 0644)\n    32\t\t\tif err != nil {\n    33\t\t\t\tlog.Fatal(\"Can't open log file:\", logPath)\n    34\t\t\t}\n    35\t\t}\n    36\t\treturn &Logger{\n    37\t\t\tlogger:  log.New(logF, \"\", log.LstdFlags),\n    38\t\t\tverbose: verbose,\n    39\t\t}\n    40\t}\n    41\t\n    42\tfunc (l *Logger) Println(v ...any) {\n    43\t\tif l == nil {\n    44\t\t\tlog.Println(v...)\n    45\t\t}\n    46\t\tif l.verbose {\n    47\t\t\tl.logger.Println(v...)\n    48\t\t}\n    49\t}\n    50\t\n    51\tfunc (l *Logger) Printf(format string, v ...any) {\n    52\t\tif l == nil {\n    53\t\t\tlog.Printf(format, v...)\n    54\t\t}\n    55\t\tif l.verbose {\n    56\t\t\tl.logger.Printf(format, v...)\n    57\t\t}\n    58\t}\n    59\t\n    60\tfunc (l *Logger) Fatal(v ...any) {\n    61\t\tif l == nil {\n    62\t\t\tlog.Fatal(v...)\n    63\t\t}\n    64\t\tif l.verbose {\n    65\t\t\tl.logger.Fatal(v...)\n    66\t\t}\n    67\t}\n","exit_code":0,"status":"completed"}}
