{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run && /home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"\nimport json\ns=json.load(open('product-schemas.json'))\nd=s['GraphPatch']['\\\\\"'$defs'\"']\nprint('DEFS:', list(d.keys()))\nfor n in ['UnitDraft','RelationDraft','BindingDraft','JudgmentChange','ScopeAssessment','ClaimDraft']:\n    if n in d:\n        print('=====',n); print(json.dumps(d[n],indent=1)[:2600])\n\\\"\"","aggregated_output":"DEFS: ['AuditQuestion', 'BindingAssociation', 'BindingDraft', 'ClaimDraft', 'CodeAnchor', 'Grounding', 'RelationDraft', 'Scope', 'UnitDraft']\n===== UnitDraft\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"candidate_id\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null,\n   \"title\": \"Candidate Id\"\n  },\n  \"audit_question\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"obligation_ids\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"maxItems\": 1,\n   \"minItems\": 1,\n   \"title\": \"Obligation Ids\",\n   \"type\": \"array\"\n  },\n  \"binding_ids\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Binding Ids\",\n   \"type\": \"array\"\n  },\n  \"relation_ids\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Relation Ids\",\n   \"type\": \"array\"\n  },\n  \"scope\": {\n   \"$ref\": \"#/$defs/Scope\"\n  },\n  \"rationale\": {\n   \"title\": \"Rationale\",\n   \"type\": \"string\"\n  }\n },\n \"required\": [\n  \"id\",\n  \"obligation_ids\",\n  \"binding_ids\",\n  \"scope\",\n  \"rationale\"\n ],\n \"title\": \"UnitDraft\",\n \"type\": \"object\"\n}\n===== RelationDraft\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"source\": {\n   \"title\": \"Source\",\n   \"type\": \"string\"\n  },\n  \"target\": {\n   \"title\": \"Target\",\n   \"type\": \"string\"\n  },\n  \"kind\": {\n   \"enum\": [\n    \"depends_all\",\n    \"conditional_on\",\n    \"boundary\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"group\": {\n   \"anyOf\": [\n    {\n     \"type\": \"string\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"title\": \"Group\"\n  },\n  \"rationale\": {\n   \"title\": \"Rationale\",\n   \"type\": \"string\"\n  },\n  \"pending\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Pending\",\n   \"type\": \"array\"\n  },\n  \"grounding\": {\n   \"$ref\": \"#/$defs/Grounding\",\n   \"default\": {\n    \"source_ids\": [],\n    \"expectation_ids\": [],\n    \"binding_ids\": [],\n    \"derivation\": \"\",\n    \"applicability\": \"\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": []\n   }\n  }\n },\n \"required\": [\n  \"id\",\n  \"source\",\n  \"target\",\n  \"kind\",\n  \"group\",\n  \"rationale\",\n  \"pending\"\n ],\n \"title\": \"RelationDraft\",\n \"type\": \"object\"\n}\n===== BindingDraft\n{\n \"additionalProperties\": false,\n \"properties\": {\n  \"associations\": {\n   \"items\": {\n    \"$ref\": \"#/$defs/BindingAssociation\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Associations\",\n   \"type\": \"array\"\n  },\n  \"anchor\": {\n   \"anyOf\": [\n    {\n     \"$ref\": \"#/$defs/CodeAnchor\"\n    },\n    {\n     \"type\": \"null\"\n    }\n   ],\n   \"default\": null\n  },\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"material_id\": {\n   \"title\": \"Material Id\",\n   \"type\": \"string\"\n  },\n  \"symbol\": {\n   \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n   \"title\": \"Symbol\",\n   \"type\": \"string\"\n  },\n  \"start_line\": {\n   \"title\": \"Start Line\",\n   \"type\": \"integer\"\n  },\n  \"end_line\": {\n   \"title\": \"End Line\",\n   \"type\": \"integer\"\n  },\n  \"description\": {\n   \"title\": \"Description\",\n   \"type\": \"string\"\n  },\n  \"pending\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Pending\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"associations\",\n  \"id\",\n  \"material_id\",\n  \"symbol\",\n  \"start_line\",\n  \"end_line\",\n  \"description\",\n  \"pending\"\n ],\n \"title\": \"BindingDraft\",\n \"type\": \"object\"\n}\n===== ClaimDraft\n{\n \"additionalProperties\": false,\n \"description\": \"A sourced requirement under explicit conditions, not the script for one experiment.\",\n \"properties\": {\n  \"id\": {\n   \"title\": \"Id\",\n   \"type\": \"string\"\n  },\n  \"kind\": {\n   \"enum\": [\n    \"obligation\",\n    \"assumption\"\n   ],\n   \"title\": \"Kind\",\n   \"type\": \"string\"\n  },\n  \"concern\": {\n   \"default\": \"implementation_semantics\",\n   \"enum\": [\n    \"consensus_safety\",\n    \"bounded_liveness\",\n    \"implementation_semantics\"\n   ],\n   \"title\": \"Concern\",\n   \"type\": \"string\"\n  },\n  \"description\": {\n   \"description\": \"Required relation across applicable objects and contexts; keep test instance IDs and timings in the check unless they determine applicability\",\n   \"title\": \"Description\",\n   \"type\": \"string\"\n  },\n  \"source_ids\": {\n   \"description\": \"Located materials; file kinds do not establish normative authority\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Source Ids\",\n   \"type\": \"array\"\n  },\n  \"scope\": {\n   \"$ref\": \"#/$defs/Scope\"\n  },\n  \"pending\": {\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"title\": \"Pending\",\n   \"type\": \"array\"\n  },\n  \"grounding\": {\n   \"$ref\": \"#/$defs/Grounding\",\n   \"default\": {\n    \"source_ids\": [],\n    \"expectation_ids\": [],\n    \"binding_ids\": [],\n    \"derivation\": \"\",\n    \"applicability\": \"\",\n    \"unresolved\": [],\n    \"conflicts\": [],\n    \"alternatives\": []\n   }\n  }\n },\n \"required\": [\n  \"id\",\n  \"kind\",\n  \"description\",\n  \"source_ids\",\n  \"scope\",\n  \"pending\"\n ],\n \"title\": \"ClaimDraft\",\n \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
