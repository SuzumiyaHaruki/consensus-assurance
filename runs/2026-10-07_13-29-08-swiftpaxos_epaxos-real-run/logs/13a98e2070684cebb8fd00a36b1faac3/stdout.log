'feedback',{}).get('ref_ids',[]))\n189:def feedback_links(state, ref_ids, after=None):\n194:            refs = sorted(set(ref_ids) & set(selection.get('feedback',{}).get('ref_ids',[])))\n204:    \"\"\"Join accepted products, action identities, executions and explicit later feedback.\"\"\"\n214:        handoffs = feedback_links(state,checks,after=operation)\n217:            'ref_ids':product.get('feedback',{}).get('ref_ids',[]) if product.get('feedback') else [],\n225:            'feedback':handoffs, 'without_followup':[id for id in checks if not any(id in h['ref_ids'] for h in handoffs)]})\n272:        'map_handoffs':feedback_links(state,audit_object_index(spec)),\n273:        'handoffs':[s for s in state.selections if s.get('feedback') or s.get('released_candidate_ids') or s['action'] in {'pause','explained'} or s['action']=='stop' and s.get('scope')!='run'],\n345:    recent = next((s['operation_id'] for s in reversed(handoffs) if s.get('feedback') and not s.get('duplicate_of')), None)\n347:        'answered_preview':preview(s.get('feedback',{}).get('answered',s['rationale'])),\n348:        'ref_ids':s.get('feedback',{}).get('ref_ids',s.get('ref_ids',[])),\n350:        **({'feedback':s['feedback']} if s['operation_id']==recent else {})} for s in handoffs]\n459:    feedback = submission.feedback\n460:    if feedback:\n461:        if not set(feedback.ref_ids)<=known:raise ValueError('Research feedback references unknown objects: '+', '.join(set(feedback.ref_ids)-known))\n462:        if not source_refs(state,feedback.ref_ids,include_executions=True):\n463:            raise ValueError('Research feedback needs acquired sources or a retained research execution')\n465:        if not set(feedback.question_updates)<=candidates.keys():raise ValueError('Feedback question_updates must name saved Candidates')\n466:        if feedback.question_updates and not source_refs(state,feedback.ref_ids):raise ValueError('Question updates need sourced answers through retained references')\n468:        'feedback':feedback.model_dump(mode='json') if feedback else {}, 'map_updated':map_changed}\n470:    if (isinstance(submission,ResearchSubmission) and feedback and not any((submission.map_path, submission.graph_path,\n472:            feedback.question_updates, submission.repair_of)) and state.selections):\n","exit_code":0,"status":"completed"}}
