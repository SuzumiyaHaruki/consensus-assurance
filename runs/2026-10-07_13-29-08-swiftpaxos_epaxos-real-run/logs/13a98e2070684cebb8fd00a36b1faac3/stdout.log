{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run/agent-source && cat -n client/client.go'","aggregated_output":"     1\tpackage client\n     2\t\n     3\timport (\n     4\t\t\"bufio\"\n     5\t\t\"encoding/binary\"\n     6\t\t\"errors\"\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"math\"\n    10\t\t\"net\"\n    11\t\t\"net/http\"\n    12\t\t\"net/rpc\"\n    13\t\t\"os/exec\"\n    14\t\t\"strconv\"\n    15\t\t\"strings\"\n    16\t\t\"time\"\n    17\t\n    18\t\t\"github.com/google/uuid\"\n    19\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    20\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    21\t\tfastrpc \"github.com/imdea-software/swiftpaxos/rpc\"\n    22\t\t\"github.com/imdea-software/swiftpaxos/state\"\n    23\t)\n    24\t\n    25\ttype Client struct {\n    26\t\t*dlog.Logger\n    27\t\n    28\t\tClientId  int32\n    29\t\tLeaderId  int\n    30\t\tClosestId int // also co-located\n    31\t\n    32\t\tPing []float64\n    33\t\n    34\t\tFast       bool\n    35\t\tVerbose    bool\n    36\t\tLeaderless bool\n    37\t\n    38\t\tmaster  *rpc.Client\n    39\t\tservers []net.Conn\n    40\t\treaders []*bufio.Reader\n    41\t\twriters []*bufio.Writer\n    42\t\n    43\t\tdt         *defs.LatencyTable\n    44\t\tseqnum     int32\n    45\t\tserver     string // co-located with\n    46\t\tmasterPort int\n    47\t\tmasterAddr string\n    48\t\treplicas   []string\n    49\t}\n    50\t\n    51\tfunc NewClient(server, maddr string, mport int, fast, leaderless, verbose bool) *Client {\n    52\t\treturn NewClientLog(server, maddr, mport, fast, leaderless, verbose, nil)\n    53\t}\n    54\t\n    55\tfunc NewClientLog(server, maddr string, mport int, fast, leaderless, verbose bool, logger *dlog.Logger) *Client {\n    56\t\tif logger == nil {\n    57\t\t\tlogger = dlog.New(\"\", verbose)\n    58\t\t}\n    59\t\n    60\t\treturn &Client{\n    61\t\t\tClientId:  int32(uuid.New().ID()),\n    62\t\t\tLeaderId:  -1,\n    63\t\t\tClosestId: -1,\n    64\t\n    65\t\t\tFast:       fast,\n    66\t\t\tVerbose:    verbose,\n    67\t\t\tLeaderless: leaderless,\n    68\t\n    69\t\t\tLogger: logger,\n    70\t\n    71\t\t\tserver:     server,\n    72\t\t\tmasterPort: mport,\n    73\t\t\tmasterAddr: maddr,\n    74\t\n    75\t\t\tseqnum: -1,\n    76\t\t}\n    77\t}\n    78\t\n    79\tfunc (c *Client) Connect() error {\n    80\t\tc.Println(\"dialing master...\")\n    81\t\t_, err := c.dialMaster()\n    82\t\tif err != nil {\n    83\t\t\treturn err\n    84\t\t}\n    85\t\n    86\t\tc.Println(\"getting list of replicas...\")\n    87\t\trl, err := c.callMaster(\"GetReplicaList\")\n    88\t\tif err != nil {\n    89\t\t\treturn err\n    90\t\t}\n    91\t\tmasterReply := rl.(*defs.GetReplicaListReply)\n    92\t\tc.replicas = masterReply.ReplicaList\n    93\t\n    94\t\tc.Println(\"searching for the closest replica...\")\n    95\t\terr = c.findClosest(masterReply.AliveList)\n    96\t\tif err != nil {\n    97\t\t\treturn err\n    98\t\t}\n    99\t\tc.Println(\"replicas\", c.replicas)\n   100\t\tc.Println(\"closest (alive)\", c.ClosestId)\n   101\t\n   102\t\tc.dt = defs.NewLatencyTable(defs.LatencyConf, defs.IP(), c.replicas)\n   103\t\n   104\t\tN := len(c.replicas)\n   105\t\tc.servers = make([]net.Conn, N)\n   106\t\tc.readers = make([]*bufio.Reader, N)\n   107\t\tc.writers = make([]*bufio.Writer, N)\n   108\t\n   109\t\tif !c.Leaderless {\n   110\t\t\tc.Println(\"getting leader from master...\")\n   111\t\t\tgl, err := c.callMaster(\"GetLeader\")\n   112\t\t\tif err != nil {\n   113\t\t\t\treturn err\n   114\t\t\t}\n   115\t\t\tmasterReply := gl.(*defs.GetLeaderReply)\n   116\t\t\tc.LeaderId = masterReply.LeaderId\n   117\t\t\tc.Println(\"leader id\", c.LeaderId)\n   118\t\t}\n   119\t\n   120\t\tconnect := []int{}\n   121\t\t// Connect to all even if !c.Fast\n   122\t\t// this simplifies connection to a new leader when the old one is down\n   123\t\tfor i := 0; i < N; i++ {\n   124\t\t\tif masterReply.AliveList[i] {\n   125\t\t\t\tconnect = append(connect, i)\n   126\t\t\t}\n   127\t\t}\n   128\t\n   129\t\tfor _, i := range connect {\n   130\t\t\tc.Println(\"connecting to\", c.replicas[i])\n   131\t\t\tc.servers[i], err = c.dial(c.replicas[i], false)\n   132\t\t\tif err != nil {\n   133\t\t\t\treturn err\n   134\t\t\t}\n   135\t\t\tc.readers[i] = bufio.NewReader(c.servers[i])\n   136\t\t\tc.writers[i] = bufio.NewWriter(c.servers[i])\n   137\t\t}\n   138\t\n   139\t\treturn nil\n   140\t}\n   141\t\n   142\tfunc (c *Client) Disconnect() {\n   143\t\tfor _, s := range c.servers {\n   144\t\t\tif s != nil {\n   145\t\t\t\ts.Close()\n   146\t\t\t}\n   147\t\t}\n   148\t\tif c.master != nil {\n   149\t\t\tc.master.Close()\n   150\t\t\tc.master = nil\n   151\t\t}\n   152\t}\n   153\t\n   154\tfunc (c *Client) Reconnect() error {\n   155\t\tc.Println(\"dialing master...\")\n   156\t\t_, err := c.dialMaster()\n   157\t\tif err != nil {\n   158\t\t\treturn err\n   159\t\t}\n   160\t\n   161\t\tif !c.Leaderless {\n   162\t\t\tc.Println(\"getting leader from master...\")\n   163\t\t\tgl, err := c.callMaster(\"GetLeader\")\n   164\t\t\tif err != nil {\n   165\t\t\t\treturn err\n   166\t\t\t}\n   167\t\t\tmasterReply := gl.(*defs.GetLeaderReply)\n   168\t\t\tc.LeaderId = masterReply.LeaderId\n   169\t\t\tc.Println(\"leader id\", c.LeaderId)\n   170\t\t}\n   171\t\n   172\t\treturn nil\n   173\t}\n   174\t\n   175\tfunc (c *Client) SendProposal(cmd defs.Propose) {\n   176\t\td := c.LeaderId\n   177\t\tif c.Leaderless {\n   178\t\t\td = c.ClosestId\n   179\t\t}\n   180\t\n   181\t\tif !c.Fast {\n   182\t\t\tc.Println(\"sending command\", cmd.CommandId, \"to\", d)\n   183\t\t\tc.writers[d].WriteByte(defs.PROPOSE)\n   184\t\t\tcmd.Marshal(c.writers[d])\n   185\t\t\tc.writers[d].Flush()\n   186\t\t} else {\n   187\t\t\tc.Println(\"sending command\", cmd.CommandId, \"to everyone\")\n   188\t\t\tfor rep := 0; rep < len(c.servers); rep++ {\n   189\t\t\t\tif c.writers[rep] != nil {\n   190\t\t\t\t\tc.writers[rep].WriteByte(defs.PROPOSE)\n   191\t\t\t\t\tcmd.Marshal(c.writers[rep])\n   192\t\t\t\t\tc.writers[rep].Flush()\n   193\t\t\t\t}\n   194\t\t\t}\n   195\t\t}\n   196\t}\n   197\t\n   198\tfunc (c *Client) SendWrite(key int64, value []byte) int32 {\n   199\t\tc.seqnum++\n   200\t\tp := defs.Propose{\n   201\t\t\tCommandId: c.seqnum,\n   202\t\t\tClientId:  c.ClientId,\n   203\t\t\tCommand: state.Command{\n   204\t\t\t\tOp: state.PUT,\n   205\t\t\t\tK:  state.Key(key),\n   206\t\t\t\tV:  value,\n   207\t\t\t},\n   208\t\t\tTimestamp: 0,\n   209\t\t}\n   210\t\n   211\t\tc.SendProposal(p)\n   212\t\treturn c.seqnum\n   213\t}\n   214\t\n   215\tfunc (c *Client) SendRead(key int64) int32 {\n   216\t\tc.seqnum++\n   217\t\tp := defs.Propose{\n   218\t\t\tCommandId: c.seqnum,\n   219\t\t\tClientId:  c.ClientId,\n   220\t\t\tCommand: state.Command{\n   221\t\t\t\tOp: state.GET,\n   222\t\t\t\tK:  state.Key(key),\n   223\t\t\t\tV:  state.NIL(),\n   224\t\t\t},\n   225\t\t\tTimestamp: 0,\n   226\t\t}\n   227\t\n   228\t\tc.SendProposal(p)\n   229\t\treturn c.seqnum\n   230\t}\n   231\t\n   232\tfunc (c *Client) SendScan(key, count int64) int32 {\n   233\t\tc.seqnum++\n   234\t\tp := defs.Propose{\n   235\t\t\tCommandId: c.seqnum,\n   236\t\t\tClientId:  c.ClientId,\n   237\t\t\tCommand: state.Command{\n   238\t\t\t\tOp: state.SCAN,\n   239\t\t\t\tK:  state.Key(key),\n   240\t\t\t\tV:  make([]byte, 8),\n   241\t\t\t},\n   242\t\t\tTimestamp: 0,\n   243\t\t}\n   244\t\n   245\t\tbinary.LittleEndian.PutUint64(p.Command.V, uint64(count))\n   246\t\n   247\t\tc.SendProposal(p)\n   248\t\treturn c.seqnum\n   249\t}\n   250\t\n   251\tfunc (c *Client) GetReplyFrom(rid int) (*defs.ProposeReplyTS, error) {\n   252\t\trep := &defs.ProposeReplyTS{}\n   253\t\terr := rep.Unmarshal(c.readers[rid])\n   254\t\treturn rep, err\n   255\t}\n   256\t\n   257\tfunc (c *Client) RegisterRPCTable(t *fastrpc.Table) {\n   258\t\tfor i, reader := range c.readers {\n   259\t\t\tgo func(i int, reader *bufio.Reader) {\n   260\t\t\t\tfor {\n   261\t\t\t\t\tvar (\n   262\t\t\t\t\t\tmsgType uint8\n   263\t\t\t\t\t\terr     error\n   264\t\t\t\t\t)\n   265\t\t\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   266\t\t\t\t\t\tbreak\n   267\t\t\t\t\t}\n   268\t\t\t\t\tp, exists := t.Get(msgType)\n   269\t\t\t\t\tif !exists {\n   270\t\t\t\t\t\tc.Println(\"error: received unknown message:\", msgType)\n   271\t\t\t\t\t\tcontinue\n   272\t\t\t\t\t}\n   273\t\t\t\t\tobj := p.Obj.New()\n   274\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   275\t\t\t\t\t\tbreak\n   276\t\t\t\t\t}\n   277\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   278\t\t\t\t\t\ttime.Sleep(c.dt.WaitDuration(c.replicas[i]))\n   279\t\t\t\t\t\tp.Chan <- obj\n   280\t\t\t\t\t}(obj)\n   281\t\t\t\t}\n   282\t\t\t}(i, reader)\n   283\t\t}\n   284\t}\n   285\t\n   286\t// For custom client messages\n   287\tfunc (c *Client) SendMsg(rid int32, code uint8, msg fastrpc.Serializable) {\n   288\t\tw := c.writers[rid]\n   289\t\tif w == nil {\n   290\t\t\t// TODO: return an error\n   291\t\t\treturn\n   292\t\t}\n   293\t\tw.WriteByte(code)\n   294\t\tmsg.Marshal(w)\n   295\t\tw.Flush()\n   296\t}\n   297\t\n   298\tfunc (c *Client) dial(addr string, connect bool) (net.Conn, error) {\n   299\t\tvar (\n   300\t\t\terr  error    = nil\n   301\t\t\tconn net.Conn = nil\n   302\t\t\tresp *http.Response\n   303\t\t)\n   304\t\n   305\t\tfor try := 0; try < 3; try++ {\n   306\t\t\tconn, err = net.DialTimeout(\"tcp\", addr, 3*time.Second)\n   307\t\t\tif err == nil {\n   308\t\t\t\tif connect {\n   309\t\t\t\t\tio.WriteString(conn, \"CONNECT \"+rpc.DefaultRPCPath+\" HTTP/1.0\\n\\n\")\n   310\t\t\t\t\tresp, err = http.ReadResponse(bufio.NewReader(conn),\n   311\t\t\t\t\t\t&http.Request{\n   312\t\t\t\t\t\t\tMethod: \"CONNECT\",\n   313\t\t\t\t\t\t})\n   314\t\t\t\t\tif err == nil && resp != nil && resp.Status == \"200 Connected to Go RPC\" {\n   315\t\t\t\t\t\treturn conn, nil\n   316\t\t\t\t\t}\n   317\t\t\t\t} else {\n   318\t\t\t\t\treturn conn, nil\n   319\t\t\t\t}\n   320\t\t\t} else {\n   321\t\t\t\tc.Println(addr, \"connection error:\", err)\n   322\t\t\t}\n   323\t\t\tif conn != nil {\n   324\t\t\t\tconn.Close()\n   325\t\t\t}\n   326\t\t}\n   327\t\n   328\t\treturn nil, errors.New(\"cannot connect\")\n   329\t}\n   330\t\n   331\tfunc (c *Client) dialMaster() (*rpc.Client, error) {\n   332\t\tif c.master != nil {\n   333\t\t\tc.master.Close()\n   334\t\t}\n   335\t\taddr := fmt.Sprintf(\"%s:%d\", c.masterAddr, c.masterPort)\n   336\t\tconn, err := c.dial(addr, true)\n   337\t\tif err != nil {\n   338\t\t\treturn nil, err\n   339\t\t}\n   340\t\tc.master = rpc.NewClient(conn)\n   341\t\treturn c.master, nil\n   342\t}\n   343\t\n   344\tfunc (c *Client) findClosest(alive []bool) error {\n   345\t\tc.Println(\"pinging all replicas...\")\n   346\t\n   347\t\tfor i := 0; i < len(c.replicas); i++ {\n   348\t\t\tif !alive[i] {\n   349\t\t\t\tcontinue\n   350\t\t\t}\n   351\t\t\taddr := strings.Split(string(c.replicas[i]), \":\")[0]\n   352\t\t\tif addr == \"\" {\n   353\t\t\t\taddr = \"127.0.0.1\"\n   354\t\t\t}\n   355\t\n   356\t\t\tif addr == c.server {\n   357\t\t\t\tc.ClosestId = i\n   358\t\t\t}\n   359\t\n   360\t\t\tout, err := exec.Command(\"ping\", addr, \"-c 3\", \"-q\").Output()\n   361\t\t\tif err == nil {\n   362\t\t\t\tlatency, _ := strconv.ParseFloat(strings.Split(string(out), \"/\")[4], 64)\n   363\t\t\t\tc.Println(i, \"->\", latency)\n   364\t\t\t\tc.Ping = append(c.Ping, latency)\n   365\t\t\t} else {\n   366\t\t\t\tc.Println(c.replicas[i], err)\n   367\t\t\t\treturn err\n   368\t\t\t}\n   369\t\t}\n   370\t\n   371\t\tif c.ClosestId == -1 {\n   372\t\t\tmin := math.MaxFloat64\n   373\t\t\tfor i, l := range c.Ping {\n   374\t\t\t\tif l < min {\n   375\t\t\t\t\tmin = l\n   376\t\t\t\t\tc.ClosestId = i\n   377\t\t\t\t}\n   378\t\t\t}\n   379\t\t}\n   380\t\n   381\t\treturn nil\n   382\t}\n   383\t\n   384\tfunc (c *Client) call(r *rpc.Client, method string, args, reply interface{}) error {\n   385\t\terrs := make(chan error, 1)\n   386\t\tgo func() {\n   387\t\t\terrs <- r.Call(method, args, reply)\n   388\t\t}()\n   389\t\tselect {\n   390\t\tcase err := <-errs:\n   391\t\t\tif err != nil {\n   392\t\t\t\tc.Println(\"error in RPC: \" + method)\n   393\t\t\t}\n   394\t\t\treturn err\n   395\t\n   396\t\tcase <-time.After(3 * time.Second):\n   397\t\t\tc.Println(\"RPC timeout: \" + method)\n   398\t\t\treturn errors.New(\"RPC timeout\")\n   399\t\t}\n   400\t}\n   401\t\n   402\tfunc (c *Client) callMaster(method string) (interface{}, error) {\n   403\t\tvar (\n   404\t\t\tgl     *defs.GetLeaderReply\n   405\t\t\trl     *defs.GetReplicaListReply\n   406\t\t\tglArgs *defs.GetLeaderArgs\n   407\t\t\trlArgs *defs.GetReplicaListArgs\n   408\t\t)\n   409\t\n   410\t\tfor i := 0; i < 100; i++ {\n   411\t\t\tif method == \"GetReplicaList\" {\n   412\t\t\t\trl = &defs.GetReplicaListReply{}\n   413\t\t\t\trlArgs = &defs.GetReplicaListArgs{}\n   414\t\t\t\terr := c.call(c.master, \"Master.\"+method, rlArgs, rl)\n   415\t\t\t\tif err == nil && rl.Ready {\n   416\t\t\t\t\treturn rl, nil\n   417\t\t\t\t}\n   418\t\t\t} else if method == \"GetLeader\" {\n   419\t\t\t\tgl = &defs.GetLeaderReply{}\n   420\t\t\t\tglArgs = &defs.GetLeaderArgs{}\n   421\t\t\t\terr := c.call(c.master, \"Master.\"+method, glArgs, gl)\n   422\t\t\t\tif err == nil {\n   423\t\t\t\t\treturn gl, nil\n   424\t\t\t\t}\n   425\t\t\t}\n   426\t\t}\n   427\t\n   428\t\treturn nil, errors.New(\"too many call attempts!\")\n   429\t}\n","exit_code":0,"status":"completed"}}
