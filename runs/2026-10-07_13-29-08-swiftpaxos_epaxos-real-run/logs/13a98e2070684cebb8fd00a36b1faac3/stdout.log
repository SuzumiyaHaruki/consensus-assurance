{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run/agent-source && cat -n client/buffer.go && echo \"=== hook ===\" && cat -n hook/hook.go hook/cond.go'","aggregated_output":"     1\tpackage client\n     2\t\n     3\timport (\n     4\t\t\"errors\"\n     5\t\t\"math/rand\"\n     6\t\t\"net\"\n     7\t\t\"sync\"\n     8\t\t\"time\"\n     9\t\n    10\t\t\"github.com/google/uuid\"\n    11\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    12\t\t\"github.com/imdea-software/swiftpaxos/state\"\n    13\t)\n    14\t\n    15\ttype ReqReply struct {\n    16\t\tVal    state.Value\n    17\t\tSeqnum int\n    18\t\tTime   time.Time\n    19\t}\n    20\t\n    21\ttype BufferClient struct {\n    22\t\t*Client\n    23\t\n    24\t\tReply        chan *ReqReply\n    25\t\tGetClientKey func() int64\n    26\t\n    27\t\tseq         bool\n    28\t\tpsize       int\n    29\t\treqNum      int\n    30\t\twrites      int\n    31\t\twindow      int32\n    32\t\tconflict    int\n    33\t\tsyncFreq    int\n    34\t\tconflictKey int64\n    35\t\n    36\t\treqTime    []time.Time\n    37\t\tlaunchTime time.Time\n    38\t\n    39\t\trand *rand.Rand\n    40\t}\n    41\t\n    42\tfunc NewBufferClient(c *Client, reqNum, psize, conflict, writes int, conflictKey int64) *BufferClient {\n    43\t\tbc := &BufferClient{\n    44\t\t\tClient: c,\n    45\t\n    46\t\t\tReply: make(chan *ReqReply, reqNum+1),\n    47\t\n    48\t\t\tseq:         true,\n    49\t\t\tpsize:       psize,\n    50\t\t\treqNum:      reqNum,\n    51\t\t\twrites:      writes,\n    52\t\t\tconflict:    conflict,\n    53\t\t\tconflictKey: conflictKey,\n    54\t\n    55\t\t\treqTime: make([]time.Time, reqNum+1),\n    56\t\t}\n    57\t\tsource := rand.NewSource(time.Now().UnixNano() + int64(c.ClientId))\n    58\t\tbc.rand = rand.New(source)\n    59\t\treturn bc\n    60\t}\n    61\t\n    62\tfunc (c *BufferClient) Pipeline(syncFreq int, window int32) {\n    63\t\tc.seq = false\n    64\t\tc.syncFreq = syncFreq\n    65\t\tc.window = window\n    66\t}\n    67\t\n    68\tfunc (c *BufferClient) RegisterReply(val state.Value, seqnum int32) {\n    69\t\tt := time.Now()\n    70\t\tc.Reply <- &ReqReply{\n    71\t\t\tVal:    val,\n    72\t\t\tSeqnum: int(seqnum),\n    73\t\t\tTime:   t,\n    74\t\t}\n    75\t}\n    76\t\n    77\tfunc (c *BufferClient) Write(key int64, val []byte) {\n    78\t\tc.SendWrite(key, val)\n    79\t\t<-c.Reply\n    80\t\treturn\n    81\t}\n    82\t\n    83\tfunc (c *BufferClient) Read(key int64) []byte {\n    84\t\tc.SendRead(key)\n    85\t\tr := <-c.Reply\n    86\t\treturn r.Val\n    87\t}\n    88\t\n    89\tfunc (c *BufferClient) Scan(key, count int64) []byte {\n    90\t\tc.SendScan(key, count)\n    91\t\tr := <-c.Reply\n    92\t\treturn r.Val\n    93\t}\n    94\t\n    95\t// Assumed to be connected\n    96\tfunc (c *BufferClient) Loop() {\n    97\t\tgetKey := c.genGetKey()\n    98\t\tval := make([]byte, c.psize)\n    99\t\tc.rand.Read(val)\n   100\t\n   101\t\tvar cmdM sync.Mutex\n   102\t\tcmdNum := int32(0)\n   103\t\twait := make(chan struct{}, 0)\n   104\t\tgo func() {\n   105\t\t\tfor i := 0; i <= c.reqNum; i++ {\n   106\t\t\t\tr := <-c.Reply\n   107\t\t\t\t// Ignore first request\n   108\t\t\t\tif i != 0 {\n   109\t\t\t\t\td := r.Time.Sub(c.reqTime[r.Seqnum])\n   110\t\t\t\t\tm := float64(d.Nanoseconds()) / float64(time.Millisecond)\n   111\t\t\t\t\tc.Println(\"Returning:\", r.Val.String())\n   112\t\t\t\t\tc.Printf(\"latency %v\\n\", m)\n   113\t\t\t\t}\n   114\t\t\t\tif c.window > 0 {\n   115\t\t\t\t\tcmdM.Lock()\n   116\t\t\t\t\tif cmdNum == c.window {\n   117\t\t\t\t\t\tcmdNum--\n   118\t\t\t\t\t\tcmdM.Unlock()\n   119\t\t\t\t\t\twait <- struct{}{}\n   120\t\t\t\t\t} else {\n   121\t\t\t\t\t\tcmdNum--\n   122\t\t\t\t\t\tcmdM.Unlock()\n   123\t\t\t\t\t}\n   124\t\t\t\t}\n   125\t\t\t\tif c.seq || (c.syncFreq > 0 && i%c.syncFreq == 0) {\n   126\t\t\t\t\twait <- struct{}{}\n   127\t\t\t\t}\n   128\t\t\t}\n   129\t\t\tif !c.seq {\n   130\t\t\t\twait <- struct{}{}\n   131\t\t\t}\n   132\t\t}()\n   133\t\n   134\t\tfor i := 0; i <= c.reqNum; i++ {\n   135\t\t\tkey := getKey()\n   136\t\t\twrite := c.randomTrue(c.writes)\n   137\t\t\tc.reqTime[i] = time.Now()\n   138\t\n   139\t\t\t// Ignore first request\n   140\t\t\tif i == 1 {\n   141\t\t\t\tc.launchTime = c.reqTime[i]\n   142\t\t\t}\n   143\t\n   144\t\t\tif write {\n   145\t\t\t\tc.SendWrite(key, state.Value(val))\n   146\t\t\t\t// TODO: if the return value != i, something's wrong\n   147\t\t\t} else {\n   148\t\t\t\tc.SendRead(key)\n   149\t\t\t\t// TODO: if the return value != i, something's wrong\n   150\t\t\t}\n   151\t\t\tif c.window > 0 {\n   152\t\t\t\tcmdM.Lock()\n   153\t\t\t\tif cmdNum == c.window-1 {\n   154\t\t\t\t\tcmdNum++\n   155\t\t\t\t\tcmdM.Unlock()\n   156\t\t\t\t\t<-wait\n   157\t\t\t\t} else {\n   158\t\t\t\t\tcmdNum++\n   159\t\t\t\t\tcmdM.Unlock()\n   160\t\t\t\t}\n   161\t\t\t}\n   162\t\t\tif c.seq || (c.syncFreq > 0 && i%c.syncFreq == 0) {\n   163\t\t\t\t<-wait\n   164\t\t\t}\n   165\t\t}\n   166\t\n   167\t\tif !c.seq {\n   168\t\t\t<-wait\n   169\t\t}\n   170\t\n   171\t\tc.Printf(\"Test took %v\\n\", time.Now().Sub(c.launchTime))\n   172\t\tc.Disconnect()\n   173\t}\n   174\t\n   175\tfunc (c *BufferClient) WaitReplies(waitFrom int) {\n   176\t\tgo func() {\n   177\t\t\tfor {\n   178\t\t\t\tr, err := c.GetReplyFrom(waitFrom)\n   179\t\t\t\tif err != nil {\n   180\t\t\t\t\tif errors.Is(err, net.ErrClosed) {\n   181\t\t\t\t\t\tc.Println(\"warning: calling GetReplyFrom after closing connections. Not a big deal\")\n   182\t\t\t\t\t} else {\n   183\t\t\t\t\t\tc.Println(err)\n   184\t\t\t\t\t}\n   185\t\t\t\t\tbreak\n   186\t\t\t\t}\n   187\t\t\t\tif r.OK != defs.TRUE {\n   188\t\t\t\t\tc.Println(\"Faulty reply\")\n   189\t\t\t\t\tbreak\n   190\t\t\t\t}\n   191\t\t\t\tgo func(val state.Value, seqnum int32) {\n   192\t\t\t\t\ttime.Sleep(c.dt.WaitDuration(c.replicas[waitFrom]))\n   193\t\t\t\t\tc.RegisterReply(val, seqnum)\n   194\t\t\t\t}(r.Value, r.CommandId)\n   195\t\t\t}\n   196\t\t}()\n   197\t}\n   198\t\n   199\tfunc (c *BufferClient) genGetKey() func() int64 {\n   200\t\tkey := int64(uuid.New().Time())\n   201\t\tgetKey := func() int64 {\n   202\t\t\tif c.randomTrue(c.conflict) {\n   203\t\t\t\treturn c.conflictKey\n   204\t\t\t}\n   205\t\t\tif c.GetClientKey == nil {\n   206\t\t\t\treturn key\n   207\t\t\t}\n   208\t\t\treturn int64(c.GetClientKey())\n   209\t\t}\n   210\t\treturn getKey\n   211\t}\n   212\t\n   213\tfunc (c *BufferClient) randomTrue(prob int) bool {\n   214\t\tif prob >= 100 {\n   215\t\t\treturn true\n   216\t\t}\n   217\t\tif prob > 0 {\n   218\t\t\treturn c.rand.Intn(100) <= prob\n   219\t\t}\n   220\t\treturn false\n   221\t}\n=== hook ===\n     1\tpackage hook\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"os/signal\"\n     6\t\t\"syscall\"\n     7\t)\n     8\t\n     9\tfunc HookUser1(f func()) {\n    10\t\tuser1 := make(chan os.Signal, 1)\n    11\t\tsignal.Notify(user1, syscall.SIGUSR1)\n    12\t\n    13\t\tgo func() {\n    14\t\t\t<-user1\n    15\t\t\tf()\n    16\t\t}()\n    17\t}\n    18\tpackage hook\n    19\t\n    20\ttype CondF struct {\n    21\t\tcond  func() bool\n    22\t\tfun   func()\n    23\t\twanna bool\n    24\t}\n    25\t\n    26\tfunc NewCondF(cond func() bool) *CondF {\n    27\t\treturn &CondF{\n    28\t\t\tcond:  cond,\n    29\t\t\tfun:   func() {},\n    30\t\t\twanna: false,\n    31\t\t}\n    32\t}\n    33\t\n    34\tfunc (cf *CondF) ReinitCondF(cond func() bool) *CondF {\n    35\t\tif cf == nil {\n    36\t\t\treturn NewCondF(cond)\n    37\t\t}\n    38\t\n    39\t\tcf.cond = cond\n    40\t\tcf.fun = func() {}\n    41\t\tcf.wanna = false\n    42\t\treturn cf\n    43\t}\n    44\t\n    45\tfunc (cf *CondF) Call(f func()) bool {\n    46\t\tif cf.cond() {\n    47\t\t\tif cf.wanna {\n    48\t\t\t\tcf.wanna = false\n    49\t\t\t\tcf.fun()\n    50\t\t\t}\n    51\t\t\tcf.wanna = false\n    52\t\t\tf()\n    53\t\t\tcf.fun = func() {}\n    54\t\n    55\t\t\treturn true\n    56\t\t} else {\n    57\t\t\toldFun := cf.fun\n    58\t\t\tcf.fun = func() {\n    59\t\t\t\toldFun()\n    60\t\t\t\tf()\n    61\t\t\t}\n    62\t\t\tcf.wanna = true\n    63\t\n    64\t\t\treturn false\n    65\t\t}\n    66\t}\n    67\t\n    68\tfunc (cf *CondF) Recall() bool {\n    69\t\tif cf.wanna && cf.cond() {\n    70\t\t\tcf.wanna = false\n    71\t\t\tcf.fun()\n    72\t\t\tcf.fun = func() {}\n    73\t\n    74\t\t\treturn true\n    75\t\t}\n    76\t\n    77\t\treturn false\n    78\t}\n    79\t\n    80\tfunc (cf *CondF) AndCond(cond func() bool) {\n    81\t\toldCond := cf.cond\n    82\t\tcf.cond = func() bool {\n    83\t\t\treturn oldCond() && cond()\n    84\t\t}\n    85\t}\n    86\t\n    87\tfunc (cf *CondF) OrCond(cond func() bool) {\n    88\t\toldCond := cf.cond\n    89\t\tcf.cond = func() bool {\n    90\t\t\treturn oldCond() || cond()\n    91\t\t}\n    92\t}\n    93\t\n    94\ttype OptCondF struct {\n    95\t\tcond     func() bool\n    96\t\tfuns     []func()\n    97\t\tfuns_num int\n    98\t}\n    99\t\n   100\tfunc NewOptCondF(cond func() bool) *OptCondF {\n   101\t\treturn &OptCondF{\n   102\t\t\tcond:     cond,\n   103\t\t\tfuns:     nil,\n   104\t\t\tfuns_num: 0,\n   105\t\t}\n   106\t}\n   107\t\n   108\tfunc (cf *OptCondF) ReinitCondF(cond func() bool) *OptCondF {\n   109\t\tif cf == nil {\n   110\t\t\treturn NewOptCondF(cond)\n   111\t\t}\n   112\t\n   113\t\tcf.cond = cond\n   114\t\tcf.funs_num = 0\n   115\t\treturn cf\n   116\t}\n   117\t\n   118\tfunc (cf *OptCondF) Call(f func()) bool {\n   119\t\tif cf.cond() {\n   120\t\t\tfor i := 0; i < cf.funs_num; i++ {\n   121\t\t\t\tcf.funs[i]()\n   122\t\t\t}\n   123\t\t\tf()\n   124\t\t\tcf.funs_num = 0\n   125\t\t\treturn true\n   126\t\t}\n   127\t\tif cf.funs_num >= len(cf.funs) {\n   128\t\t\tcf.funs = append(cf.funs, f)\n   129\t\t} else {\n   130\t\t\tcf.funs[cf.funs_num] = f\n   131\t\t}\n   132\t\tcf.funs_num++\n   133\t\treturn false\n   134\t}\n   135\t\n   136\tfunc (cf *OptCondF) Recall() bool {\n   137\t\tif cf.funs_num > 0 && cf.cond() {\n   138\t\t\tfor i := 0; i < cf.funs_num; i++ {\n   139\t\t\t\tcf.funs[i]()\n   140\t\t\t}\n   141\t\t\tcf.funs_num = 0\n   142\t\t\treturn true\n   143\t\t}\n   144\t\treturn false\n   145\t}\n","exit_code":0,"status":"completed"}}
