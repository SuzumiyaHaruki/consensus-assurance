{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-07_13-29-08-swiftpaxos_epaxos-real-run/agent-source && cat -n master/master.go'","aggregated_output":"     1\tpackage master\n     2\t\n     3\timport (\n     4\t\t\"errors\"\n     5\t\t\"fmt\"\n     6\t\t\"math\"\n     7\t\t\"net\"\n     8\t\t\"net/http\"\n     9\t\t\"net/rpc\"\n    10\t\t\"os/exec\"\n    11\t\t\"strconv\"\n    12\t\t\"strings\"\n    13\t\t\"sync\"\n    14\t\t\"time\"\n    15\t\n    16\t\t\"github.com/imdea-software/swiftpaxos/config\"\n    17\t\t\"github.com/imdea-software/swiftpaxos/dlog\"\n    18\t\t\"github.com/imdea-software/swiftpaxos/replica/defs\"\n    19\t)\n    20\t\n    21\ttype Master struct {\n    22\t\t*dlog.Logger\n    23\t\n    24\t\tN          int\n    25\t\tport       int\n    26\t\tnodeList   []string\n    27\t\taddrList   []string\n    28\t\tportList   []int\n    29\t\tlock       *sync.Mutex\n    30\t\tnodes      []*rpc.Client\n    31\t\tleader     []bool\n    32\t\talive      []bool\n    33\t\tlatencies  []float64\n    34\t\tfinishInit bool\n    35\t\tinitCond   *sync.Cond\n    36\t\tnextLeader int\n    37\t\tconfig     *config.Config\n    38\t}\n    39\t\n    40\tfunc New(N, port int, config *config.Config, logger *dlog.Logger) *Master {\n    41\t\tmaster := &Master{\n    42\t\t\tLogger: logger,\n    43\t\n    44\t\t\tN:          N,\n    45\t\t\tport:       port,\n    46\t\t\tnodeList:   make([]string, 0, N),\n    47\t\t\taddrList:   make([]string, 0, N),\n    48\t\t\tportList:   make([]int, 0, N),\n    49\t\t\tlock:       new(sync.Mutex),\n    50\t\t\tnodes:      make([]*rpc.Client, N),\n    51\t\t\tleader:     make([]bool, N),\n    52\t\t\talive:      make([]bool, N),\n    53\t\t\tlatencies:  make([]float64, N),\n    54\t\t\tfinishInit: false,\n    55\t\t\tnextLeader: -1,\n    56\t\t\tconfig:     config,\n    57\t\t}\n    58\t\tmaster.initCond = sync.NewCond(master.lock)\n    59\t\treturn master\n    60\t}\n    61\t\n    62\tfunc (master *Master) Run() {\n    63\t\tmaster.Printf(\"master starting on port %d\", master.port)\n    64\t\tmaster.Printf(\"waiting for %d replicas\", master.N)\n    65\t\n    66\t\trpc.Register(master)\n    67\t\trpc.HandleHTTP()\n    68\t\tl, err := net.Listen(\"tcp\", fmt.Sprintf(\":%d\", master.port))\n    69\t\tif err != nil {\n    70\t\t\tmaster.Fatal(\"master listen error:\", err)\n    71\t\t}\n    72\t\tgo master.run()\n    73\t\thttp.Serve(l, nil)\n    74\t}\n    75\t\n    76\tfunc (master *Master) run() {\n    77\t\tfor {\n    78\t\t\tmaster.lock.Lock()\n    79\t\t\tif len(master.nodeList) == master.N {\n    80\t\t\t\tmaster.lock.Unlock()\n    81\t\t\t\tbreak\n    82\t\t\t}\n    83\t\t\tmaster.lock.Unlock()\n    84\t\t\ttime.Sleep(time.Second)\n    85\t\t}\n    86\t\ttime.Sleep(2 * time.Second)\n    87\t\n    88\t\tfor i := 0; i < master.N; {\n    89\t\t\tvar err error\n    90\t\t\taddr := fmt.Sprintf(\"%s:%d\", master.addrList[i], master.portList[i]+1000)\n    91\t\t\tmaster.nodes[i], err = rpc.DialHTTP(\"tcp\", addr)\n    92\t\t\tif err != nil {\n    93\t\t\t\tmaster.Printf(\"error connecting to replica %d (%v), retrying...\", i, addr)\n    94\t\t\t\ttime.Sleep(time.Second)\n    95\t\t\t} else {\n    96\t\t\t\tbtlReply := defs.NewBeTheLeaderReply()\n    97\t\t\t\tif master.leader[i] {\n    98\t\t\t\t\terr = master.nodes[i].Call(\"Replica.BeTheLeader\", &defs.BeTheLeaderArgs{}, btlReply)\n    99\t\t\t\t\tif err != nil {\n   100\t\t\t\t\t\tmaster.Fatal(\"Not today Zurg!\")\n   101\t\t\t\t\t}\n   102\t\t\t\t\tdefs.UpdateBeTheLeaderReply(btlReply)\n   103\t\t\t\t\tleaderI := i\n   104\t\t\t\t\tif btlReply.Leader != -1 {\n   105\t\t\t\t\t\tleaderI = int(btlReply.Leader)\n   106\t\t\t\t\t\tmaster.leader[i] = false\n   107\t\t\t\t\t\tmaster.leader[leaderI] = true\n   108\t\t\t\t\t}\n   109\t\t\t\t\tmaster.nextLeader = int(btlReply.NextLeader)\n   110\t\t\t\t\tif leaderI == i {\n   111\t\t\t\t\t\tmaster.Printf(\"replica %d is the new leader\", leaderI)\n   112\t\t\t\t\t} else if leaderI < i {\n   113\t\t\t\t\t\ti = leaderI - 1\n   114\t\t\t\t\t}\n   115\t\t\t\t}\n   116\t\t\t\ti++\n   117\t\t\t}\n   118\t\t}\n   119\t\n   120\t\tvar new_leader bool\n   121\t\tpingNode := func(i int, node *rpc.Client) {\n   122\t\t\terr := node.Call(\"Replica.Ping\", &defs.PingArgs{}, &defs.PingReply{})\n   123\t\t\tif err != nil {\n   124\t\t\t\tmaster.alive[i] = false\n   125\t\t\t\tif master.leader[i] {\n   126\t\t\t\t\tnew_leader = true\n   127\t\t\t\t\tmaster.leader[i] = false\n   128\t\t\t\t}\n   129\t\t\t} else {\n   130\t\t\t\tmaster.alive[i] = true\n   131\t\t\t}\n   132\t\t}\n   133\t\tmaster.lock.Lock()\n   134\t\tfor i, node := range master.nodes {\n   135\t\t\tpingNode(i, node)\n   136\t\t}\n   137\t\t// initialization is finished\n   138\t\t// (i.e., `alive` has been computed)\n   139\t\tmaster.finishInit = true\n   140\t\tmaster.initCond.Broadcast()\n   141\t\tmaster.lock.Unlock()\n   142\t\n   143\t\tbeTheLeader := func(i int) error {\n   144\t\t\tif master.alive[i] {\n   145\t\t\t\tbtlReply := defs.NewBeTheLeaderReply()\n   146\t\t\t\terr := master.nodes[i].Call(\"Replica.BeTheLeader\", &defs.BeTheLeaderArgs{}, btlReply)\n   147\t\t\t\tif err == nil {\n   148\t\t\t\t\tdefs.UpdateBeTheLeaderReply(btlReply)\n   149\t\t\t\t\tleaderI := i\n   150\t\t\t\t\tif btlReply.Leader != -1 {\n   151\t\t\t\t\t\t// TODO: need to set leader[old_leader] to false?\n   152\t\t\t\t\t\tleaderI = int(btlReply.Leader)\n   153\t\t\t\t\t}\n   154\t\t\t\t\tmaster.leader[leaderI] = true\n   155\t\t\t\t\tmaster.nextLeader = int(btlReply.NextLeader)\n   156\t\t\t\t\tmaster.Printf(\"replica %d is the new leader\", leaderI)\n   157\t\t\t\t\treturn nil\n   158\t\t\t\t}\n   159\t\t\t\treturn err\n   160\t\t\t}\n   161\t\t\treturn errors.New(\"dead\")\n   162\t\t}\n   163\t\n   164\t\tfor {\n   165\t\t\ttime.Sleep(3 * time.Second)\n   166\t\t\tnew_leader = false\n   167\t\t\tfor i, node := range master.nodes {\n   168\t\t\t\tpingNode(i, node)\n   169\t\t\t}\n   170\t\n   171\t\t\tif !new_leader {\n   172\t\t\t\tcontinue\n   173\t\t\t}\n   174\t\t\tif master.nextLeader != -1 {\n   175\t\t\t\tif beTheLeader(master.nextLeader) == nil {\n   176\t\t\t\t\tcontinue\n   177\t\t\t\t}\n   178\t\t\t}\n   179\t\t\tfor i := range master.nodes {\n   180\t\t\t\tif beTheLeader(i) == nil {\n   181\t\t\t\t\tbreak\n   182\t\t\t\t}\n   183\t\t\t}\n   184\t\t}\n   185\t}\n   186\t\n   187\tfunc (master *Master) Register(args *defs.RegisterArgs, reply *defs.RegisterReply) error {\n   188\t\tmaster.lock.Lock()\n   189\t\tdefer master.lock.Unlock()\n   190\t\n   191\t\tnlen := len(master.nodeList)\n   192\t\tindex := nlen\n   193\t\n   194\t\taddrPort := fmt.Sprintf(\"%s:%d\", args.Addr, args.Port)\n   195\t\n   196\t\tfor i, ap := range master.nodeList {\n   197\t\t\tif addrPort == ap {\n   198\t\t\t\tindex = i\n   199\t\t\t\tbreak\n   200\t\t\t}\n   201\t\t}\n   202\t\n   203\t\tif index == nlen {\n   204\t\t\tmaster.nodeList = master.nodeList[0 : nlen+1]\n   205\t\t\tmaster.nodeList[nlen] = addrPort\n   206\t\t\tmaster.addrList = master.addrList[0 : nlen+1]\n   207\t\t\tmaster.addrList[nlen] = args.Addr\n   208\t\t\tmaster.portList = master.portList[0 : nlen+1]\n   209\t\t\tmaster.portList[nlen] = args.Port\n   210\t\t\tmaster.leader[index] = false\n   211\t\t\tnlen++\n   212\t\n   213\t\t\taddr := args.Addr\n   214\t\t\tif addr == \"\" {\n   215\t\t\t\taddr = \"127.0.0.1\"\n   216\t\t\t}\n   217\t\t\tout, err := exec.Command(\"ping\", addr, \"-c 2\", \"-q\").Output()\n   218\t\t\tif err == nil {\n   219\t\t\t\tmaster.latencies[index], _ =\n   220\t\t\t\t\tstrconv.ParseFloat(strings.Split(string(out), \"/\")[4], 64)\n   221\t\t\t\tmaster.Printf(\"node %v [%v] -> %v\", index,\n   222\t\t\t\t\tmaster.nodeList[index], master.latencies[index])\n   223\t\t\t} else {\n   224\t\t\t\tmaster.Fatal(\"cannot connect to \" + addr)\n   225\t\t\t}\n   226\t\t}\n   227\t\n   228\t\tif nlen == master.N {\n   229\t\t\treply.Ready = true\n   230\t\t\treply.ReplicaId = index\n   231\t\t\treply.NodeList = master.nodeList\n   232\t\t\treply.IsLeader = false\n   233\t\n   234\t\t\tminLatency := math.MaxFloat64\n   235\t\t\tleader := -1\n   236\t\n   237\t\t\tif master.config.Leader != nil {\n   238\t\t\t\tif addrPort == *master.config.Leader {\n   239\t\t\t\t\tleader = index\n   240\t\t\t\t}\n   241\t\t\t} else {\n   242\t\t\t\tfor i := 0; i < len(master.leader); i++ {\n   243\t\t\t\t\tif master.latencies[i] < minLatency {\n   244\t\t\t\t\t\tminLatency = master.latencies[i]\n   245\t\t\t\t\t\tleader = i\n   246\t\t\t\t\t}\n   247\t\t\t\t}\n   248\t\t\t}\n   249\t\n   250\t\t\tif leader == index {\n   251\t\t\t\tmaster.leader[index] = true\n   252\t\t\t\treply.IsLeader = true\n   253\t\t\t}\n   254\t\n   255\t\t} else {\n   256\t\t\treply.Ready = false\n   257\t\t}\n   258\t\n   259\t\treturn nil\n   260\t}\n   261\t\n   262\tfunc (master *Master) GetLeader(args *defs.GetLeaderArgs, reply *defs.GetLeaderReply) error {\n   263\t\tmaster.lock.Lock()\n   264\t\tdefer master.lock.Unlock()\n   265\t\n   266\t\tfor i, l := range master.leader {\n   267\t\t\tif l {\n   268\t\t\t\t*reply = defs.GetLeaderReply{\n   269\t\t\t\t\tLeaderId: i,\n   270\t\t\t\t}\n   271\t\t\t\tbreak\n   272\t\t\t}\n   273\t\t}\n   274\t\treturn nil\n   275\t}\n   276\t\n   277\tfunc (master *Master) GetReplicaList(args *defs.GetReplicaListArgs, reply *defs.GetReplicaListReply) error {\n   278\t\tmaster.lock.Lock()\n   279\t\n   280\t\tfor !master.finishInit {\n   281\t\t\tmaster.initCond.Wait()\n   282\t\t}\n   283\t\n   284\t\tif len(master.nodeList) == master.N {\n   285\t\t\treply.Ready = true\n   286\t\t} else {\n   287\t\t\treply.Ready = false\n   288\t\t}\n   289\t\n   290\t\treply.ReplicaList = make([]string, 0)\n   291\t\treply.AliveList = make([]bool, 0)\n   292\t\tfor i, node := range master.nodeList {\n   293\t\t\treply.ReplicaList = append(reply.ReplicaList, node)\n   294\t\t\treply.AliveList = append(reply.AliveList, master.alive[i])\n   295\t\t}\n   296\t\n   297\t\tmaster.Printf(\"nodes list %v\", reply.ReplicaList)\n   298\t\tmaster.lock.Unlock()\n   299\t\treturn nil\n   300\t}\n","exit_code":0,"status":"completed"}}
