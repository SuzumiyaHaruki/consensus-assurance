id,file=ref.file,start_line=ref.start_line,end_line=ref.end_line,\nworkflow/audit.py-601-            kind=ref.kind,text='\\n'.join(lines[ref.start_line-1:ref.end_line]),content_digest=state.snapshot.files[ref.file])\nworkflow/audit.py-602-        if message is None and ref.id in existing and existing[ref.id] != material:\nworkflow/audit.py-603-            message = 'Source range ID reused for a different excerpt: ' + ref.id\nworkflow/audit.py-604-        if message:\nworkflow/audit.py-605-            errors.append(Diagnostic(code='source_range',category='material',object_ids=[ref.id],\nworkflow/audit.py-606-                paths=[paths[index] if paths else '/sources/'+str(index)],message=message,\nworkflow/audit.py-607-                details={'blocked_checks':'Checks requiring this excerpt await valid source bytes'},allowed=['read','representation']))\nworkflow/audit.py-608-        elif ref.id not in existing:\nworkflow/audit.py-609-            additions.append(material);existing[ref.id] = material\nworkflow/audit.py-610-    if issues is not None:issues.extend(errors)\nworkflow/audit.py-611-    elif errors:raise DiagnosticError(errors)\nworkflow/audit.py-612-    return additions\nworkflow/audit.py-613-\nworkflow/audit.py-614-\nworkflow/audit.py-615-def prepare_agent_source(engine):\nworkflow/audit.py-616-    \"\"\"Expose only configured readable files; the complete source remains for trusted execution.\"\"\"\nworkflow/audit.py-617-    source=engine.root/\"source\"\nworkflow/audit.py-618-    view=engine.root/\"agent-source\"\n","exit_code":0,"status":"completed"}}
