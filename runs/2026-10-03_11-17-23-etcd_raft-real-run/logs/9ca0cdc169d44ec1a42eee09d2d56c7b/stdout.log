  \"pause\",\n        \"explained\",\n        \"obligation\"\n      ],\n      \"title\": \"Action\",\n      \"type\": \"string\"\n    },\n    \"candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Candidate Id\"\n    },\n    \"parent_candidate_id\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Parent Candidate Id\"\n    },\n    \"question\": {\n      \"$ref\": \"#/$defs/AuditQuestion\"\n    },\n    \"resume_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Resume Conditions\",\n      \"type\": \"array\"\n    },\n    \"result_implications\": {\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      },\n      \"default\": {},\n      \"propertyNames\": {\n        \"enum\": [\n          \"holds\",\n          \"violated\",\n          \"incomplete\"\n        ]\n      },\n      \"title\": \"Result Implications\",\n      \"type\": \"object\"\n    },\n    \"obligation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/ClaimDraft\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"bindings\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/BindingDraft\"\n      },\n      \"title\": \"Bindings\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"rationale\",\n    \"action\",\n    \"question\"\n  ],\n  \"title\": \"CandidateSubmission\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > update_map.py <<'PY'\nimport json\nm=json.load(open('../audit-spec/v1.json'));m['version']=1\n# Controller-derived reverse indexes are omitted from authored products.\nfor a in m['activities']: a.pop('behavior_ids',None)\ns=[]\ndef source(i,f,a,b,k='code_observation'): s.append(dict(id=i,file=f,start_line=a,end_line=b,kind=k))\nfor args in [('s_tracker','tracker/tracker.go',160,281),('s_joint','quorum/joint.go',17,76),('s_majority','quorum/majority.go',116,196),('s_changer','confchange/confchange.go',36,245),('s_changer_guards','confchange/confchange.go',246,345),('s_restore_config','confchange/restore.go',24,161),('s_init','raft.go',437,496),('s_timers','raft.go',850,889),('s_hup','raft.go',973,1021),('s_read_transfer','raft.go',1571,1664),('s_apply_config','raft.go',1942,1974),('s_readonly','read_only.go',17,129),('s_node_loop','node.go',343,457),('s_load_read','raft.go',2033,2085),('s_send_replication','raft.go',616,738),('s_log_init','log.go',67,98),('s_bootstrap','bootstrap.go',23,83),('s_start_node','node.go',254,297),('s_autoleave','raft.go',740,775),('s_apply_resp','rawnode.go',368,403)]: source(*args)\nsource('s_conf_contract','raftpb/raft.proto',116,150,'interface_statement')\nsource('s_conf_contract2','raftpb/raft.proto',181,205,'interface_statement')\nsource('s_read_contract','node.go',218,229,'interface_statement')\nsource('s_apply_contract','node.go',159,187,'interface_statement')\nsource('s_read_test','raft_test.go',2046,2111,'test_expectation')\nB={b['id']:b for b in m['behaviors']}\nchanges={}\ndef change(i,ss,why,impact='clarification'):\n changes[i]=dict(impact=impact,rationale=why,source_ids=ss,preserves='No accepted Candidate or obligation exists; the update preserves the observed branch-specific effects and adds sourced dependencies without asserting execution results.')\ndef extend(i,ss,**kw):\n B[i]['source_ids']+=ss;B[i].update(kw);change(i,ss,'Complete the previously identified source gap with concrete producer, consumer and completion paths.')\nextend('b_ack_commit',['s_tracker','s_joint','s_majority'],unknowns=[],reads=['Current voter sets and per-peer Match. Joint commitment takes the lesser index supported by each constituent majority; learners outside voters do not contribute.'])\nextend('b_authority',['s_hup','s_timers','s_tracker'],unknowns=[],implementation_guards=['Campaign admission requires voter progress, no pending snapshot, and no committed unapplied configuration entries.','Only the first vote from each identity is recorded; result uses configured voter sets and both majorities when joint.'],important_branches=B['b_authority']['important_branches']+['Pre-current-term read messages survive reset, but acquire a fresh committed index and fresh quorum acknowledgments when later released. In-flight readOnly acknowledgments are discarded by reset.'])\nextend('b_snapshot',['s_restore_config','s_changer'],unknowns=[],reads=['confchange.Restore reconstructs incoming and outgoing configurations through Simple then EnterJoint; voter/learner compatibility is checked.'])\nextend('b_config',['s_apply_config','s_changer','s_changer_guards','s_conf_contract2'],legal_preconditions=['Caller applies a committed configuration entry in application order.'],implementation_guards=['Simple changes alter at most one voter; EnterJoint preserves the outgoing set; LeaveJoint removes outgoing-only participants and activates staged learners.'],unknowns=['Whether a legal history can make configuration installation cause the first current-term commit despite campaign admission guards remains a local question.'])\nextend('b_application',['s_node_loop','s_apply_resp','s_apply_contract'],unknowns=['Early Advance before configuration application is allowed by general Advance prose; how callers preserve configuration-specific ordering remains a local contract question.'],async_boundaries=['Node serializes input, configuration application, Ready acceptance and Advance in one select loop. While sync Ready awaits Advance, other input and configuration calls can still run.','Async apply responses use Term=0 because committed application is not term-scoped.'])\ndef add(i,a,owner,ctx,trig,ss,**kw):\n b=dict(id=i,primary_activity=a,execution_owner=owner,protocol_context=ctx,trigger=trig,source_ids=ss,**kw);m['behaviors'].append(b);B[i]=b\nadd('b_reconstruct','A6','newRaft, newLogWithSize and RawNode.Bootstrap','Caller-provided Storage and Applied index','NewRawNode, RestartNode or Bootstrap',['s_init','s_log_init','s_restore_config','s_load_read','s_bootstrap','s_start_node'],writes=['Initialize unstable offset beyond stored last index; initialize application and commit at compacted boundary; restore ConfState, load HardState, optionally advance Applied, then become follower.','Bootstrap requires empty log and peers; creates committed configuration entries while leaving application delivery outstanding.'],cross_activity_effects={'A1':'Durable committed prefix constrains future append and application.','A2':'Restored term, vote and membership constrain elections; volatile votes and progress are reset.'})\nadd('b_reads','A7','raft leader/follower and caller','ReadOnlySafe or lease mode, request context, term and applied index','ReadIndex admission, append-response commit, or heartbeat quorum',['s_readonly','s_leader_admit','s_read_transfer','s_release_reads','s_read_contract','s_load_read','s_send_replication'],implementation_guards=['Non-singleton leader defers until a current-term entry is committed. Safe mode records leader self acknowledgment and uses configured voter quorum for heartbeat acknowledgments.'],important_branches=['Singleton answers directly. Safe read queue can release earlier requests when a later context reaches quorum. Reset discards readOnly state, while pre-commit requests can survive and be reprocessed at a later committed index.','ReadIndex interface allows request