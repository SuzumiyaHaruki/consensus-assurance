defs/CandidateSubmission\",\n      \"pause\": \"#/$defs/CandidateSubmission\",\n      \"research\": \"#/$defs/ResearchSubmission\",\n      \"review\": \"#/$defs/ReviewSubmission\",\n      \"revise_check\": \"#/$defs/CheckSubmission\",\n      \"semantic_revision\": \"#/$defs/SemanticSubmission\",\n      \"stop\": \"#/$defs/StopSubmission\"\n    },\n    \"propertyName\": \"action\"\n  },\n  \"oneOf\": [\n    {\n      \"$ref\": \"#/$defs/CandidateSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/CheckSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ResearchSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/SemanticSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ReviewSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/ExploreSubmission\"\n    },\n    {\n      \"$ref\": \"#/$defs/StopSubmission\"\n    }\n  ]\n}","exit_code":0,"status":"completed"}}
