  },\n    {\n      \"id\": \"fa267c61288944acbf9df7f94f7681d6\",\n      \"question\": {\n        \"audit_spec_version\": 4,\n        \"disposition\": \"needs_specific_evidence\",\n        \"preferred_check\": \"controlled_schedule\",\n        \"question\": \"Can a removed former leader with StepDownOnRemoval=false use the singleton ReadIndex shortcut to certify its old prefix after the surviving voter has independently acquired authority and completed a later write, or does an applicable caller duty or another implementation mechanism exclude that history?\",\n        \"importance\": \"A returned stale read certificate could permit a linearizable read to omit a write that completed before the read invocation. This is a possible read safety consequence, not established by the local branch alone.\",\n        \"source_ids\": [\n          \"s_tracker\",\n          \"s_config_commit\",\n          \"s_restore_config\",\n          \"s_leader_admit\",\n          \"s_load_read\",\n          \"s_removal_option\",\n          \"s_raw_read\",\n          \"s_read_safety\",\n          \"s_read_contract\"\n        ],\n        \"participants\": [\n          \"removed old leader\",\n          \"retained singleton voter\",\n          \"read caller\"\n        ],\n        \"objects\": [\n          \"singleton voter configuration\",\n          \"leader role\",\n          \"ReadState.Index\",\n          \"completed write\"\n        ],\n        \"contexts\": [\n          \"ReadOnlySafe\",\n          \"StepDownOnRemoval=false\",\n          \"Applied joint transition to a singleton retaining a different node\"\n        ],\n        \"event_paths\": [\n          \"Replicated removal -> automatic exit applied -> old leader remains StateLeader -> retained voter campaigns and commits a write -> old node ReadIndex -> caller consumes read state\"\n        ],\n        \"activity_classes\": [\n          \"A2\",\n          \"A4\",\n          \"A7\"\n        ],\n        \"behavior_ids\": [\n          \"b_singleton_read_authority\",\n          \"b_config\"\n        ],\n        \"fact_ids\": [\n          \"f_single_voter_config\"\n        ],\n        \"supporting_behavior_ids\": {\n          \"b_reads\": \"Defines returned read index and application consumption contract.\",\n          \"b_authority\": \"Actual election and term filtering for the surviving voter.\",\n          \"b_ack_commit\": \"Establishes independently completed write before read invocation.\"\n        },\n        \"obligation_relation_kind\": \"consumption\",\n        \"counterevidence\": [\n          \"StepDownOnRemoval=true would remove the old leader role.\",\n          \"CheckQuorum can later demote an inactive removed leader.\",\n          \"An application may stop or reject reads after removal; whether that is mandatory remains to be established.\",\n          \"Ordinary proposal admission already rejects removed leaders; that protection does not automatically apply to ReadIndex.\"\n        ],\n        \"unknowns\": [\n          \"Caller legality of continuing ReadIndex on a removed yet unstopped node.\",\n          \"Actual protocol history reaching a new singleton leader and completed write without first notifying the removed leader of a higher term.\",\n          \"Whether a returned ReadState permits the stale application value under the documented applied-index condition.\"\n        ],\n        \"priority\": 0,\n        \"trigger_rationale\": \"The mismatch is between a cardinality predicate and a local-authority consumer, with optional stepdown and separate proposal rejection as concrete contrary protections. Inspect caller duties and use an actual multi-node history rather than manually setting StateLeader or progress.\"\n      },\n      \"status\": \"active\",\n      \"parent_candidate_id\": null,\n      \"fork_reason\": \"\",\n      \"stop_reason\": \"Select a distinct read-authority safety question from the completed core map while preserving the confirmed automatic-exit result.\