gChange\n                if err := cc.Unmarshal(e.Cmd); err != nil { n.t.Fatal(err) }\n                if !cc.Initialize || cc.Type != pb.AddNode { n.t.Fatal(\"unexpected membership mutation\") }\n                x.peer.ApplyConfigChange(cc)\n            } else if e.Type != pb.ApplicationEntry || len(e.Cmd) != 0 {\n                n.t.Fatal(\"unexpected non-noop application\")\n            }\n            x.applied = e.Index\n        }\n        x.peer.Commit(u)\n        x.peer.NotifyRaftLastApplied(x.applied)\n        n.queue = append(n.queue, messages...)\n        for _, rr := range ready {\n            assuranceEvent(map[string]interface{}{\n                \"event\":\"read_ready\", \"scenario\":\"remote_prefix\", \"origin\":id,\n                \"context\":assuranceContext(rr.SystemCtx), \"index\":rr.Index,\n                \"applied\":x.applied, \"term\":x.peer.raft.term, \"phase\":n.phase,\n            })\n        }\n    }\n}\n\n// All phases use this one delivery path. Only genuine early-context heartbeat\n// responses are delayed; no message fields are rewritten or forged.\nfunc (n *assuranceReadNetwork) drain() {\n    for count := 0; len(n.queue)>0; count++ {\n        if count > 10000 { n.t.Fatal(\"message processing did not drain\") }\n        m := n.queue[0]\n        n.queue = n.queue[1:]\n        if n.deferEarly && m.Type == pb.HeartbeatResp && m.Hint == n.early.Low && m.HintHigh == n.early.High {\n            n.held = append(n.held,m)\n            continue\n        }\n        x := n.nodes[m.To]\n        if x == nil { n.t.Fatal(\"message addressed outside fixed membership\") }\n        // Keep references to the actual registered statuses across the handler;\n        // confirm mutates their indexes and removes them from the live map.\n        var before []*readStatus\n        if m.Type == pb.HeartbeatResp && m.To == 1 {\n            for _, ctx := range x.peer.raft.readIndex.queue {\n                before = append(before, x.peer.raft.readIndex.pending[ctx])\n            }\n        }\n        x.peer.Handle(m)\n        if n.phase == \"reads\" && m.Type == pb.ReadIndex && m.To == 1 {\n            ctx := pb.SystemCtx{Low:m.Hint, High:m.HintHigh}\n            s, ok := x.peer.raft.readIndex.pending[ctx]\n            if !ok || s.from != m.From { n.t.Fatal(\"read was not registered\") }\n            if _, exists := n.admissions[s.from]; exists { n.t.Fatal(\"ambiguous origin identity\") }\n            n.admissions[s.from] = s\n            assuranceEvent(map[string]interface{}{\n                \"event\":\"read_admitted\", \"scenario\":\"remote_prefix\", \"origin\":s.from,\n                \"context\":assuranceContext(s.ctx), \"index\":s.index, \"term\":x.peer.raft.term,\n            })\n        }\n        for _, s := range before {\n            if _, ok := x.peer.raft.readIndex.pending[s.ctx]; !ok {\n                assuranceEvent(map[string]interface{}{\n                    \"event\":\"read_confirmed\", \"scenario\":\"remote_prefix\", \"origin\":s.from,\n                    \"context\":assuranceContext(s.ctx), \"index\":s.index,\n                    \"term\":x.peer.raft.term, \"ack_from\":m.From,\n                    \"ack_context\":assuranceContext(pb.SystemCtx{Low:m.Hint,High:m.HintHigh}),\n                })\n            }\n        }\n        if n.phase == \"reads\" && m.Type == pb.ReadIndexResp {\n            assuranceEvent(map[string]interface{}{\n                \"event\":\"response_delivered\", \"scenario\":\"remote_prefix\", \"origin\":m.To,\n                \"context\":assuranceContext(pb.SystemCtx{Low:m.Hint,High:m.HintHigh}),\n                \"index\":m.LogIndex, \"term\":m.Term,\n            })\n        }\n        n.harvest(m.To)\n    }\n}\n\nfunc TestAssuranceRemoteReadContext(t *testing.T) {\n    n := &assuranceReadNetwork{t:t, nodes:make(map[uint64]*assuranceReadNode),\n        phase:\"setup\", admissions:make(map[uint64]*readStatus)}\n    addresses := []PeerAddress{{NodeID:1,Address:\"n1\"},{NodeID:2,Address:\"n2\"},{NodeID:3,Address:\"n3\"}}\n    for id:=uint64(1); id<=3; id++ {\n        db := NewTestLogDB()\n        c := config.Config{ClusterID:41,NodeID:id,ElectionRTT:10,HeartbeatRTT:1,CheckQuorum:true}\n        p := Launch(c,db,nil,append([]PeerAddress(nil),addresses...),true,true)\n        n.nodes[id]=&assuranceReadNode{peer:p,db:db}\n        n.harvest(id)\n    }\n    n.drain()\n    // Only node 1'\"'s clock is advanced during election. No node has crashed;\n    // all produced messages are processed through the same delivery path.\n    for i:=0; i<30 && \"'!n.nodes[1].peer.raft.isLeader(); i++ {\n        n.nodes[1].peer.Tick()\n        n.harvest(1)\n        n.drain()\n    }\n    leader := n.nodes[1].peer.raft\n    if !leader.isLeader() || !leader.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"current-term committed leader not reached\") }\n    for id:=uint64(1); id<=3; id++ {\n        x:=n.nodes[id]\n        if x.peer.raft.leaderID!=1 || x.peer.raft.term!=leader.term || x.applied!=leader.log.committed {\n            t.Fatal(\"stable applied prefix not reached\")\n        }\n    }\n    assuranceEvent(map[string]interface{}{\"event\":\"setup\", \"leader\":uint64(1),\"term\":leader.term,\"commit\":leader.log.committed})\n    n.phase=\"reads\"\n    n.early=pb.SystemCtx{Low:101,High:301}\n    late:=pb.SystemCtx{Low:202,High:302}\n    n.deferEarly=true\n    n.nodes[2].peer.ReadIndex(n.early)\n    n.harvest(2)\n    n.drain()\n    if len(n.held)!=2 || len(leader.readIndex.pending)!=1 { t.Fatal(\"early read overlap prerequisite not reached\") }\n    n.nodes[3].peer.ReadIndex(late)\n    n.harvest(3)\n    n.drain()\n    // Release all earlier replies regardless of observed contexts/results.\n    n.deferEarly=false\n    n.queue=append(n.queue,n.held...)\n    n.held=nil\n    n.drain()\n    assuranceEvent(map[string]interface{}{\"event\":\"end\", \"pending\":len(leader.readIndex.pending),\"queued\":len(n.queue),\"held\":len(n.held),\"admitted\":len(n.admissions)})\n    // Peer and TestLogDB own no goroutines or open resources. No target state\n    // was assigned by the harness; all protocol inputs used Peer methods.\n}\nGO'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > build_check.py <<'PY'\nimport json\nr=json.load(open('../research.json')); c=r['candidates'][0]; q=c['question']; q['unknowns']=[]; q['disposition']='ready_for_check'\nnews=[('S-context-contract','raftpb/raft.go',42,54,'interface_statement'),('S-read-context-test','internal/raft/raft_etcd_test.go',1852,1902,'test_expectation'),('S-prefix-context-test','internal/raft/readindex_test.go',125,163,'test_expectation'),('S-peer-launch','internal/raft/peer.go',57,95,'code_observation'),('S-peer-update','internal/raft/peer.go',200,242,'code_observation'),('S-peer-export','internal/raft/peer.go',252,358,'code_observation'),('S-bootstrap','internal/raft/peer.go',360,430,'code_observation'),('S-peer-members','internal/raft/peer.go',136,150,'code_observation'),('S-memory-db','internal/raft/logdb_test.go',23,159,'code_observation'),('S-logdb-interface','internal/raft/logentry.go',45,73,'interface_statement')]\nsources=[dict(id=i,file=f,start_line=a,end_line=b,kind=k) for i,f,a,b,k in news]\nq['source_ids']+=['S-context-contract','S-read-context-test','S-prefix-context-test']\nclaimid='C-read-context'\nbindid='BD-read-response'\nexpect=['S-context-contract','S-read-context-test','S-prefix-context-test']\nss=['S-read-queue','S-read-response','S-follower-read','S-client-batches','S-peer-read']\ndef ground(deriv,app,source=ss,unresolved=[]):\n return dict(source_ids=source,expectation_ids=expect,binding_ids=[bindid],derivation=deriv,applicability=app,unresolved=unresolved,conflicts=[],alternatives=[])\nclaim=dict(id=claimid,kind='obligation',concern='implementation_semantics',description='For a remotely initiated ReadIndex operation registered under a distinct SystemCtx and included in a successfully confirmed pending prefix, propagation of its readiness to the originating peer must preserve that operation\\\\'s SystemCtx. A later context may supply confirmation for earlier requests, but must not substitute its identity for theirs.',source_ids=ss+expect,scope=dict(description='ReadIndex request-to-readiness identity preservation across stable-term, fixed-membership leader prefix confirmation and remote response delivery.',assumptions=['Crash-free non-Byzantine peers and unmodified messages; asynchronous delivery may delay earlier heartbeat replies.','Distinct nonzero contexts, one outstanding operation per remote origin, current-term leader commitment, and successful prefix confirmation.','Consumer is Peer.GetUpdate ReadyToReads; no application read result is claimed.'],excluded=['Client timeout as a deadline violation','Infinite stalling or whole-cluster liveness','Stale application values or linearizability violation','Membership changes, crash recovery and context collisions'],parameters={}),pending=[],grounding=ground('SystemCtx is explicitly the operation identifier (S-context-contract). S-read-context-test requires remote ReadyToRead context equal to the invoking request; S-prefix-context-test requires released earlier status retain its own context. Composed with exact-context batch lookup (S-client-batches), these establish identity preservation independent of whether a client can time out. The requirement is conditional on actual successful confirmation, not guaranteed read success under arbitrary delay.','Stable membership and term; each confirmed remote operation has a unique context and a unique origin in the bounded history.'))\nbinding=dict(id=bindid,material_id='S-read-response',symbol='handleReadIndexLeaderConfirmation',start_line=1771,end_line=1790,description='Consumes confirmed statuses and emits local readiness or remote ReadIndexResp.',pending=[],associations=[dict(claim_id=claimid,source_ids=ss+expect,rationale='This response branch propagates each confirmed read identity; the originating peer and client batch consume the propagated SystemCtx.')])\ncandidate=dict(action='obligation',candidate_id=c['id'],question=q,obligation=claim,bindings=[binding],rationale='Explicit SystemCtx identity contract and repository expectations ground per-operation correlation; successful confirmation is independently observed, avoiding a timeout-based liveness claim.')\nlegsrc=['S-peer-launch','S-bootstrap','S-peer-update','S-peer-export','S-peer-members','S-memory-db','S-logdb-interface','S-engine-order','S-node-effects','S-node-config','S-peer-admission','S-message-term','S-read-send','S-replication-recv','S-read-queue','S-read-response','S-ticks','S-client-batches']\nplan=dict(description='Launch three actual Peer instances with bootstrap membership and existing TestLogDB, persist and apply updates before message delivery, elect node 1 via ticks and drain a current-term no-op. Admit one remote read at node 2 and defer its actual heartbeat replies; admit a second at node 3 and deliver its actual replies, then release all earlier replies. Observe live prefix removal with original status identities and each origin\\\\'s exported ReadyToRead context.',claim_id=claimid,binding_ids=[bindid],harness=dict(kind='go_test',source='',files={},execution_package='internal/raft',description='Crash-free Peer-level network using real Handle/ReadIndex/Tick/GetUpdate/Commit and existing in-memory TestLogDB. Only two fixed read contexts and delivery policy are injected.',semantic_changes=['No target code or protocol state mutation. Package-local reads observe live registration, term, commit, queue removal and status index.','Memory-backed TestLogDB substitutes durable storage under a no-crash scope; production transport and RSM scheduling replaced by synchronous update processing.','Bootstrap configuration entries are accepted through Peer.ApplyConfigChange; the harness verifies all are Initialize/AddNode. No later configuration change or application command occurs.','Only node 1 clock advances for election; no ticks during finite read-message schedule. All messages are genuine outputs and delivered unchanged, with earlier-context replies delayed then released.','Request contexts are fixed legal distinct nonzero values instead of node random generation; the contract treats them as opaque operation identifiers.'],prerequisites=[dict(alias='admitted',event='read_admitted',conditions=[]),dict(alias='confirmed',event='read_confirmed',conditions=[dict(field='context',op='eq',reference='admitted.context'),dict(field='term',op='eq',reference='admitted.term')])],legality=ground('Launch/bootstrap sources establish fixed initial membership and committed initial configuration. Driver persists each update into TestLogDB before exposing messages, applies committed bootstrap/no-op entries, calls Commit and NotifyRaftLastApplied. This is stricter than the permitted early Replicate send, without excluding overlapping read requests. Peer.Handle supplies sender admission/term protection. All heartbeat replies are produced by actual followers; policy delays early-context replies only. Setup requires elected leader, current-term committed entry, common term/leader and applied prefix. No target goroutines/resources are owned by Peer/TestLogDB; the finite network drains all captured messages before return.','Only crash-free volatile read identity is measured. TestLogDB durability across failure, RSM client completion and real transport behavior are outside this check.',legsrc)),monitors=[dict(id='M-read-context',checker_id='CK-read-context',event='read_ready',binding_ids=[bindid],admission_alias='confirmed',applicability_conditions=[],grounding=ground('Compare an exported ReadyToRead context to the same origin\\\\'s independently recorded request context after confirmed prefix removal. There is exactly one request per origin, so scenario+origin identifies it without using the compared context.','Both operations use the same preselected policy and are compared; no selection by observed context or outcome.'))],observable_properties=[dict(checker_id='CK-read-context',kind='event_assertion',trigger=dict(field='event',op='eq',value='read_ready'),assertion=dict(field='context',op='eq',reference='admitted.context'),identity_fields=['scenario','origin'],description='Each successfully confirmed remote operation retains its admitted SystemCtx in the originating Peer readiness result.')],uncertainties=['This observes the Peer interface, not a NodeHost client timeout or application read.','Memory test storage excludes crash/durable ordering defects; captured response and readiness values are actual implementation outputs.'])\nsub=dict(action='check',rationale='Execute the sourced per-operation identity obligation under a legal, bounded overlap schedule. Actual confirmation and readiness are distinct events; compare context only after independent correlation by unique origin.',sources=sources,candidate=candidate,plan_path='read_context_plan.json',harness_path='read_context_test.go',files={},feedback=dict(ref_ids=[c['id'],'S-context-contract','S-read-context-test','S-prefix-context-test','S-client-batches'],answered='SystemCtx has an explicit operation-identity contract. Tests require remote readiness to retain the requested context and prefix confirmation to retain each original context. This grounds a per-operation propagation duty distinct from success deadlines; the fixed check observes successful confirmation and resulting peer readiness.',remaining=['Execution and current-version correspondence are required before attribution.','Client-level timeout and application consequences remain outside the checked endpoint.'],rationale='The discriminator is preserved: the later genuine heartbeat response confirms an earlier remote request while its earlier responses remain in flight.',understanding='updated'))\njson.dump(plan,open('read_context_plan.json','w'),indent=2);json.dump(sub,open('submission3.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python build_check.py\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-04_18-11-07-dragonboat_raft-real-run --submission submission3.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
