{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'cat ../direct-checks/daa3cdee65e44f2089392448006c6c93/internal/logdb/assurance_generated_test.go; cat ../direct-checks/daa3cdee65e44f2089392448006c6c93/plan.json'","aggregated_output":"package logdb\n\nimport (\n \"bytes\"\n \"encoding/json\"\n \"errors\"\n \"fmt\"\n \"path/filepath\"\n \"testing\"\n\n \"github.com/lni/dragonboat/v3/config\"\n \"github.com/lni/dragonboat/v3/internal/logdb/kv\"\n \"github.com/lni/dragonboat/v3/internal/vfs\"\n pb \"github.com/lni/dragonboat/v3/raftpb\"\n)\n\nfunc assuranceStorageEvent(event string, fields map[string]interface{}) {\n fields[\"event\"] = event\n fields[\"operation\"] = \"cold-append-4\"\n fields[\"cluster\"] = uint64(11)\n fields[\"node\"] = uint64(1)\n data, err := json.Marshal(fields)\n if err != nil { panic(err) }\n fmt.Println(\"CA_EVENT \" + string(data))\n}\n\ntype assuranceReadErrorStore struct {\n kv.IKVStore\n key []byte\n armed bool\n hits int\n}\nfunc (s *assuranceReadErrorStore) GetValue(key []byte, op func([]byte) error) error {\n if s.armed && bytes.Equal(key, s.key) {\n  s.armed = false\n  s.hits++\n  assuranceStorageEvent(\"lookup_failed\", map[string]interface{}{\"policy\":\"one-read-error\"})\n  return errors.New(\"injected non-not-found storage read error\")\n }\n return s.IKVStore.GetValue(key, op)\n}\n\ntype assuranceStoredEntry struct {\n Index uint64 `json:\"index\"`\n Term uint64 `json:\"term\"`\n Cmd string `json:\"cmd\"`\n}\nfunc assuranceStoredBatch(t *testing.T, r *db, key []byte) []assuranceStoredEntry {\n t.Helper()\n var batch pb.EntryBatch\n err := r.kvs.GetValue(key, func(data []byte) error {\n  if len(data)==0 { return errors.New(\"batch missing during observation\") }\n  return batch.Unmarshal(data)\n })\n if err != nil { t.Fatal(err) }\n if len(batch.Entries)>1 { batch=restoreBatchFields(batch) }\n result:=make([]assuranceStoredEntry,0,len(batch.Entries))\n for _, e:=range batch.Entries { result=append(result,assuranceStoredEntry{e.Index,e.Term,string(e.Cmd)}) }\n return result\n}\nfunc assurancePrefix(entries []assuranceStoredEntry) string {\n prefix:=make([]assuranceStoredEntry,0)\n for _,e:=range entries { if e.Index<4 { prefix=append(prefix,e) } }\n data,err:=json.Marshal(prefix)\n if err!=nil {panic(err)}\n return string(data)\n}\nfunc TestAssuranceColdBatchAppendReadError(t *testing.T) {\n if batchSize<=4 { t.Fatal(\"requires indexes 1 through 4 in the same unaligned batch\") }\n dir:=filepath.Join(t.TempDir(),\"logdb\")\n key:=newKey(maxKeySize,nil)\n key.SetEntryBatchKey(11,1,getBatchID(4))\n batchKey:=append([]byte(nil),key.Key()...)\n var current *db\n var fault *assuranceReadErrorStore\n defer func(){if current!=nil { if err:=current.close();err!=nil {t.Error(err)} }}()\n open:=func(){\n  factory:=func(cfg config.LogDBConfig, cb kv.LogDBCallback, d,w string, fs vfs.IFS)(kv.IKVStore,error){\n   underlying,err:=newDefaultKVStore(cfg,cb,d,w,fs)\n   if err!=nil{return nil,err}\n   fault=&assuranceReadErrorStore{IKVStore:underlying,key:batchKey}\n   return fault,nil\n  }\n  var err error\n  current,err=openRDB(config.GetTinyMemLogDBConfig(),nil,dir,\"\",true,vfs.DefaultFS,factory)\n  if err!=nil {t.Fatal(err)}\n }\n closeDB:=func(){r:=current;current=nil;if err:=r.close();err!=nil {t.Fatal(err)}}\n save:=func(entries []pb.Entry)error{\n  ctx:=newContext(4096,1024*1024)\n  defer ctx.Destroy()\n  ctx.Reset()\n  return current.saveRaftState([]pb.Update{{ClusterID:11,NodeID:1,State:pb.State{Term:1,Commit:3},EntriesToSave:entries}},ctx)\n }\n open()\n old:=[]pb.Entry{{Index:1,Term:1,Cmd:[]byte(\"one\")},{Index:2,Term:1,Cmd:[]byte(\"two\")},{Index:3,Term:1,Cmd:[]byte(\"three\")}}\n if err:=save(old);err!=nil {t.Fatal(err)}\n baseline:=assuranceStoredBatch(t,current,batchKey)\n if len(baseline)!=3 {t.Fatal(\"initial storage incomplete\")}\n for i,e:=range baseline {if e.Index!=old[i].Index || e.Term!=old[i].Term || e.Cmd!=string(old[i].Cmd){t.Fatal(\"initial storage differs\")}}\n closeDB()\n open()\n before:=assuranceStoredBatch(t,current,batchKey)\n if assurancePrefix(before)!=assurancePrefix(baseline) {t.Fatal(\"reopen changed prefix before fault\")}\n if _,ok:=current.cs.getLastBatch(11,1,pb.EntryBatch{});ok {t.Fatal(\"reopen cache unexpectedly populated\")}\n assuranceStorageEvent(\"append_admitted\",map[string]interface{}{\"prefix\":assurancePrefix(before),\"policy\":\"one-read-error\",\"cold_cache\":true,\"batch_size\":batchSize})\n fault.armed=true\n err:=save([]pb.Entry{{Index:4,Term:1,Cmd:[]byte(\"four\")}})\n fault.armed=false\n if fault.hits!=1 {t.Fatalf(\"fault delivery count %d\",fault.hits)}\n returnedError:=\"\"\n if err!=nil {returnedError=err.Error()}\n closeDB()\n open()\n after:=assuranceStoredBatch(t,current,batchKey)\n assuranceStorageEvent(\"append_observed\",map[string]interface{}{\"success\":err==nil,\"returned_error\":returnedError,\"prefix\":assurancePrefix(after),\"stored_entries\":after})\n closeDB()\n}\n{\n  \"description\": \"Persist entries 1-3 using the real batched shard and default Pebble backend. Verify them, destroy the context and close/reopen to obtain an empty cache. Verify the prefix again through raw KV decoding, then inject one explicit non-not-found GetValue error for that batch during append of entry 4. Record the save result, close/reopen, and decode the actual persisted prefix. Compare preservation only if save returned nil.\",\n  \"claim_id\": \"C-batch-prefix\",\n  \"binding_ids\": [\n    \"BD-batch-prefix\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./internal/logdb\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package logdb\\n\\nimport (\\n \\\"bytes\\\"\\n \\\"encoding/json\\\"\\n \\\"errors\\\"\\n \\\"fmt\\\"\\n \\\"path/filepath\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/lni/dragonboat/v3/config\\\"\\n \\\"github.com/lni/dragonboat/v3/internal/logdb/kv\\\"\\n \\\"github.com/lni/dragonboat/v3/internal/vfs\\\"\\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\\n)\\n\\nfunc assuranceStorageEvent(event string, fields map[string]interface{}) {\\n fields[\\\"event\\\"] = event\\n fields[\\\"operation\\\"] = \\\"cold-append-4\\\"\\n fields[\\\"cluster\\\"] = uint64(11)\\n fields[\\\"node\\\"] = uint64(1)\\n data, err := json.Marshal(fields)\\n if err != nil { panic(err) }\\n fmt.Println(\\\"CA_EVENT \\\" + string(data))\\n}\\n\\ntype assuranceReadErrorStore struct {\\n kv.IKVStore\\n key []byte\\n armed bool\\n hits int\\n}\\nfunc (s *assuranceReadErrorStore) GetValue(key []byte, op func([]byte) error) error {\\n if s.armed && bytes.Equal(key, s.key) {\\n  s.armed = false\\n  s.hits++\\n  assuranceStorageEvent(\\\"lookup_failed\\\", map[string]interface{}{\\\"policy\\\":\\\"one-read-error\\\"})\\n  return errors.New(\\\"injected non-not-found storage read error\\\")\\n }\\n return s.IKVStore.GetValue(key, op)\\n}\\n\\ntype assuranceStoredEntry struct {\\n Index uint64 `json:\\\"index\\\"`\\n Term uint64 `json:\\\"term\\\"`\\n Cmd string `json:\\\"cmd\\\"`\\n}\\nfunc assuranceStoredBatch(t *testing.T, r *db, key []byte) []assuranceStoredEntry {\\n t.Helper()\\n var batch pb.EntryBatch\\n err := r.kvs.GetValue(key, func(data []byte) error {\\n  if len(data)==0 { return errors.New(\\\"batch missing during observation\\\") }\\n  return batch.Unmarshal(data)\\n })\\n if err != nil { t.Fatal(err) }\\n if len(batch.Entries)>1 { batch=restoreBatchFields(batch) }\\n result:=make([]assuranceStoredEntry,0,len(batch.Entries))\\n for _, e:=range batch.Entries { result=append(result,assuranceStoredEntry{e.Index,e.Term,string(e.Cmd)}) }\\n return result\\n}\\nfunc assurancePrefix(entries []assuranceStoredEntry) string {\\n prefix:=make([]assuranceStoredEntry,0)\\n for _,e:=range entries { if e.Index<4 { prefix=append(prefix,e) } }\\n data,err:=json.Marshal(prefix)\\n if err!=nil {panic(err)}\\n return string(data)\\n}\\nfunc TestAssuranceColdBatchAppendReadError(t *testing.T) {\\n if batchSize<=4 { t.Fatal(\\\"requires indexes 1 through 4 in the same unaligned batch\\\") }\\n dir:=filepath.Join(t.TempDir(),\\\"logdb\\\")\\n key:=newKey(maxKeySize,nil)\\n key.SetEntryBatchKey(11,1,getBatchID(4))\\n batchKey:=append([]byte(nil),key.Key()...)\\n var current *db\\n var fault *assuranceReadErrorStore\\n defer func(){if current!=nil { if err:=current.close();err!=nil {t.Error(err)} }}()\\n open:=func(){\\n  factory:=func(cfg config.LogDBConfig, cb kv.LogDBCallback, d,w string, fs vfs.IFS)(kv.IKVStore,error){\\n   underlying,err:=newDefaultKVStore(cfg,cb,d,w,fs)\\n   if err!=nil{return nil,err}\\n   fault=&assuranceReadErrorStore{IKVStore:underlying,key:batchKey}\\n   return fault,nil\\n  }\\n  var err error\\n  current,err=openRDB(config.GetTinyMemLogDBConfig(),nil,dir,\\\"\\\",true,vfs.DefaultFS,factory)\\n  if err!=nil {t.Fatal(err)}\\n }\\n closeDB:=func(){r:=current;current=nil;if err:=r.close();err!=nil {t.Fatal(err)}}\\n save:=func(entries []pb.Entry)error{\\n  ctx:=newContext(4096,1024*1024)\\n  defer ctx.Destroy()\\n  ctx.Reset()\\n  return current.saveRaftState([]pb.Update{{ClusterID:11,NodeID:1,State:pb.State{Term:1,Commit:3},EntriesToSave:entries}},ctx)\\n }\\n open()\\n old:=[]pb.Entry{{Index:1,Term:1,Cmd:[]byte(\\\"one\\\")},{Index:2,Term:1,Cmd:[]byte(\\\"two\\\")},{Index:3,Term:1,Cmd:[]byte(\\\"three\\\")}}\\n if err:=save(old);err!=nil {t.Fatal(err)}\\n baseline:=assuranceStoredBatch(t,current,batchKey)\\n if len(baseline)!=3 {t.Fatal(\\\"initial storage incomplete\\\")}\\n for i,e:=range baseline {if e.Index!=old[i].Index || e.Term!=old[i].Term || e.Cmd!=string(old[i].Cmd){t.Fatal(\\\"initial storage differs\\\")}}\\n closeDB()\\n open()\\n before:=assuranceStoredBatch(t,current,batchKey)\\n if assurancePrefix(before)!=assurancePrefix(baseline) {t.Fatal(\\\"reopen changed prefix before fault\\\")}\\n if _,ok:=current.cs.getLastBatch(11,1,pb.EntryBatch{});ok {t.Fatal(\\\"reopen cache unexpectedly populated\\\")}\\n assuranceStorageEvent(\\\"append_admitted\\\",map[string]interface{}{\\\"prefix\\\":assurancePrefix(before),\\\"policy\\\":\\\"one-read-error\\\",\\\"cold_cache\\\":true,\\\"batch_size\\\":batchSize})\\n fault.armed=true\\n err:=save([]pb.Entry{{Index:4,Term:1,Cmd:[]byte(\\\"four\\\")}})\\n fault.armed=false\\n if fault.hits!=1 {t.Fatalf(\\\"fault delivery count %d\\\",fault.hits)}\\n returnedError:=\\\"\\\"\\n if err!=nil {returnedError=err.Error()}\\n closeDB()\\n open()\\n after:=assuranceStoredBatch(t,current,batchKey)\\n assuranceStorageEvent(\\\"append_observed\\\",map[string]interface{}{\\\"success\\\":err==nil,\\\"returned_error\\\":returnedError,\\\"prefix\\\":assurancePrefix(after),\\\"stored_entries\\\":after})\\n closeDB()\\n}\\n\",\n    \"description\": \"Real shard save, batching and default backend in a temporary directory with a one-shot IKVStore read-error adapter. No target state or backend bytes are edited.\",\n    \"semantic_changes\": [\n      \"Direct db.saveRaftState entry bypasses ShardedDB partition routing and the Raft engine; one cluster/node and sequential calls make those scheduling duties explicit.\",\n      \"Factory wraps real default KV backend only to return one non-not-found error for the selected entry-batch lookup; actual filesystem fault production is substituted, not claimed.\",\n      \"A real close/reopen produces the cache miss. Observations decode actual stored bytes through GetValue and restoreBatchFields; they do not use the merge cache.\",\n      \"Single-thread contexts are reset before saving and destroyed before closing each database. The same database directory is reopened, resources are closed and temporary storage cleaned by testing.\",\n      \"No crash, concurrent write, snapshot or compaction is introduced. Entry commands and fixed indexes are ordinary pb.Update inputs.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admitted\",\n        \"event\": \"append_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": \"one-read-error\",\n            \"reference\": null\n          },\n          {\n            \"field\": \"cold_cache\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      },\n      {\n        \"alias\": \"faulted\",\n        \"event\": \"lookup_failed\",\n        \"conditions\": [\n          {\n            \"field\": \"policy\",\n            \"op\": \"eq\",\n            \"value\": null,\n            \"reference\": \"admitted.policy\"\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-batch-read\",\n        \"S-batch-record\",\n        \"S-batch-merge\",\n        \"S-db-save\",\n        \"S-db-save-entries\",\n        \"S-pebble-get\",\n        \"S-db-open\",\n        \"S-logdb-context\",\n        \"S-logdb-factory\",\n        \"S-pebble-open-close\",\n        \"S-shard-save\",\n        \"S-tiny-config\",\n        \"S-log-cache\"\n      ],\n      \"expectation_ids\": [\n        \"S-logdb-contract\",\n        \"S-kv-contract\",\n        \"S-batch-test\"\n      ],\n      \"binding_ids\": [\n        \"BD-batch-prefix\"\n      ],\n      \"derivation\": \"ShardedDB resets its context and delegates the selected update to db.saveRaftState. The harness follows the same shard save path with fresh reset contexts and one consistent cluster/node. openRDB constructs a fresh cache and entry manager; the default factory supplies Pebble and creates storage directories. Context destruction precedes DB close; backend Close closes Pebble and its listener. Initial save is verified including index, term and command before any fault; after reopen the prefix is reverified and cache absence checked. The adapter affects only the subsequent target-key read and leaves all writes and later observations delegated. Successful save result and reopened stored bytes are recorded separately.\",\n      \"applicability\": \"Local persistence responsibility under an explicit reported read fault; the error channel is sourced from actual GetValue behavior but no physical I/O fault or engine-generated producer history is asserted.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-batch-prefix\",\n      \"checker_id\": \"CK-batch-prefix\",\n      \"event\": \"append_observed\",\n      \"binding_ids\": [\n        \"BD-batch-prefix\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-batch-read\",\n          \"S-batch-record\",\n          \"S-batch-merge\",\n          \"S-db-save\",\n          \"S-db-save-entries\",\n          \"S-pebble-get\"\n        ],\n        \"expectation_ids\": [\n          \"S-logdb-contract\",\n          \"S-kv-contract\",\n          \"S-batch-test\"\n        ],\n        \"binding_ids\": [\n          \"BD-batch-prefix\"\n        ],\n        \"derivation\": \"The result event records the actual return value and independently decoded prefix after reopen. Match the unique operation/cluster/node to its earlier verified prefix and observed lookup fault. Compare prefix equality only under success, allowing a returned error.\",\n        \"applicability\": \"Policy and operation are fixed before execution; neither preservation nor success selects formal applicability.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"faulted\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"CK-batch-prefix\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"append_observed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"prefix\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admitted.prefix\"\n      },\n      \"antecedent\": {\n        \"field\": \"success\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"operation\",\n        \"cluster\",\n        \"node\"\n      ],\n      \"description\": \"A successfully completed suffix append preserves the independently verified earlier persisted prefix.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"A backend error adapter substitutes the physical read fault; the check does not establish an actual filesystem producer history.\",\n    \"The endpoint is persisted batch bytes after reopening, not a cluster/client result.\",\n    \"A missing fault event or failed observation is incomplete, not proof of preservation or loss.\"\n  ]\n}","exit_code":0,"status":"completed"}}
