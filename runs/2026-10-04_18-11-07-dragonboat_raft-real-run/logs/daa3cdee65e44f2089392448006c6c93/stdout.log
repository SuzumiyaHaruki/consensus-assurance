 \"description\": \"Optional Chinese observed-answer summary preserving applicability; numbers and status come from retained assessment\",\n          \"title\": \"Report Answer\"\n        },\n        \"counterevidence\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Counterevidence\",\n          \"type\": \"array\"\n        },\n        \"limitations\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Limitations\",\n          \"type\": \"array\"\n        },\n        \"challenged_components\": {\n          \"description\": \"Components requiring repair, distinct from the review aspect; revision_needed must name them\",\n          \"items\": {\n            \"enum\": [\n              \"configuration\",\n              \"initialization\",\n              \"driver\",\n              \"observation\",\n              \"oracle\",\n              \"expectation\",\n              \"scope\"\n            ],\n            \"type\": \"string\"\n          },\n          \"title\": \"Challenged Components\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"aspect\",\n        \"status\",\n        \"source_ids\",\n        \"rationale\"\n      ],\n      \"title\": \"ArtifactReviewItem\",\n      \"type\": \"object\"\n    },\n    \"AuditQuestion\": {\n      \"additionalProperties\": false,\n      \"description\": \"Sourced investigation of requirements, protections and history; these may remain unknown.\",\n      \"properties\": {\n        \"audit_spec_version\": {\n          \"anyOf\": [\n            {\n              \"minimum\": 1,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Audit Spec Version\"\n        },\n        \"disposition\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"explained_by_existing_mechanism\",\n                \"concrete_suspicion\",\n                \"needs_specific_evidence\",\n                \"ready_for_check\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Disposition\"\n        },\n        \"preferred_check\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"source_review\",\n                \"direct_test\",\n                \"controlled_schedule\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Preferred Check\"\n        },\n        \"question\": {\n          \"title\": \"Question\",\n          \"type\": \"string\"\n        },\n        \"importance\": {\n          \"title\": \"Importance\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"participants\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Participants\",\n          \"type\": \"array\"\n        },\n        \"objects\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Objects\",\n          \"type\": \"array\"\n        },\n        \"contexts\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Contexts\",\n          \"type\": \"array\"\n        },\n        \"event_paths\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Event Paths\",\n          \"type\": \"array\"\n        },\n        \"activity_classes\": {\n          \"default\": [],\n          \"items\": {\n            \"enum\": [\n              \"A1\",\n              \"A2\",\n              \"A3\",\n              \"A4\",\n              \"A5\",\n              \"A6\",\n              \"A7\"\n            ],\n            \"type\": \"string\"\n          },\n          \"title\": \"Activity Classes\",\n          \"type\": \"array\"\n        },\n        \"behavior_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Behavior Ids\",\n          \"type\": \"array\"\n        },\n        \"fact_ids\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Fact Ids\",\n          \"type\": \"array\"\n        },\n        \"supporting_behavior_ids\": {\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          },\n          \"description\": \"Behavior ID to sourced prehistory, context or consequence support; not a direct principal Fact edge\",\n          \"title\": \"Supporting Behavior Ids\",\n          \"type\": \"object\"\n        },\n        \"obligation_relation_kind\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"establishment\",\n                \"preservation\",\n                \"consumption\",\n                \"recovery\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Obligation Relation Kind\"\n        },\n        \"counterevidence\": {\n          \"default\": [],\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Counterevidence\",\n          \"type\": \"array\"\n        },\n        \"unknowns\": {\n          \"description\": \"Specific unresolved premises or discriminators of this question; not generic caution or a checklist of untested cases\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Unknowns\",\n          \"type\": \"array\"\n        },\n        \"priority\": {\n          \"default\": 0,\n          \"description\": \"System consequence and audit significance, justified in importance; not proof\",\n          \"maximum\": 3,\n          \"minimum\": 0,\n          \"title\": \"Priority\",\n          \"type\": \"integer\"\n        },\n        \"trigger_rationale\": {\n          \"title\": \"Trigger Rationale\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"question\",\n        \"importance\",\n        \"trigger_rationale\"\n      ],\n      \"title\": \"AuditQuestion\",\n      \"type\": \"object\"\n    },\n    \"BindingAssociation\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"claim_id\": {\n          \"title\": \"Claim Id\",\n          \"type\": \"string\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"rationale\": {\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"claim_id\",\n        \"source_ids\",\n        \"rationale\"\n      ],\n      \"title\": \"BindingAssociation\",\n      \"type\": \"object\"\n    },\n    \"BindingDraft\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"associations\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/BindingAssociation\"\n          },\n          \"minItems\": 1,\n          \"title\": \"Associations\",\n          \"type\": \"array\"\n        },\n        \"anchor\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/CodeAnchor\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"id\": {\n          \"title\": \"Id\",\n          \"type\": \"string\"\n        },\n        \"material_id\": {\n          \"title\": \"Material Id\",\n          \"type\": \"string\"\n        },\n        \"symbol\": {\n          \"description\": \"Source symbol tied to a verified declaration, interface member or explicitly declared call-site anchor. The behavior range may be a narrow internal snippet. Do not substitute arbitrary words from the excerpt.\",\n          \"title\": \"Symbol\",\n          \"type\": \"string\"\n        },\n        \"start_line\": {\n          \"title\": \"Start Line\",\n          \"type\": \"integer\"\n        },\n        \"end_line\": {\n          \"title\": \"End Line\",\n          \"type\": \"integer\"\n        },\n        \"description\": {\n          \"title\": \"Description\",\n          \"type\": \"string\"\n        },\n        \"pending\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Pending\",\n          \"type\": \"array\"\n        }\n      },\n      \"required\": [\n        \"associations\",\n        \"id\",\n        \"material_id\",\n        \"symbol\",\n        \"start_line\",\n        \"end_line\",\n        \"description\",\n        \"pending\"\n      ],\n      \"title\": \"BindingDraft\",\n      \"type\": \"object\"\n    },\n    \"CandidateSubmission\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"rationale\": {\n          \"minLength\": 1,\n          \"title\": \"Rationale\",\n          \"type\": \"string\"\n        },\n        \"sources\": {\n          \"default\": [],\n          \"items\": {\n            \"$ref\": \"#/$defs/SourceRange\"\n          },\n          \"title\": \"Sources\",\n          \"type\": \"array\"\n