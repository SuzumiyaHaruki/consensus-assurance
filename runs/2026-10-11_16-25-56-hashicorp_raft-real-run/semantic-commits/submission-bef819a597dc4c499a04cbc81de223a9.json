  "input": {
    "rationale": "Final item of the run, filling the last knowledge gap I created but never promoted: the batching apply path. It was read early on and referenced only as a limitation of other statements, so its response mapping, its exclusion of barriers and no-ops, and its index bookkeeping are recorded here alongside the single-apply behaviour they contrast with.",
    "sources": [
      {
        "id": "s_fsm_apply_batch",
        "file": "fsm.go",
        "start_line": 127,
        "end_line": 186,
        "kind": "code_observation"
      }
    ],
    "investigations": [],
    "knowledge": [
      {
        "id": null,
        "ref": null,
        "kind": "behavior",
        "statement": "When the FSM implements BatchingFSM, the apply loop sends only command and configuration entries to ApplyBatch, in commit order and without gaps; no-ops and barriers are excluded from the batch but still advance the batch's index and term bookkeeping, so the FSM thread's reported index covers the whole batch. Responses are mapped back to the entries that were sent, one per sent log in order, and every queued future in the batch is answered in input order - a future whose entry was not sent receives a nil response, and a response count that does not match the number of sent logs panics rather than being silently truncated. Without BatchingFSM the same loop applies entries one at a time.",
        "conditions": "Applies to the captured revision's FSM thread for an FSM that implements BatchingFSM; batches are bounded by MaxAppendEntries and are built by processLogs, so the exclusions concern entry types rather than whole batches.",
        "source_ids": [
          "s_fsm_apply_batch",
          "s_fsm_apply_single"
        ],
