n we get an append entries RPC call. This must\n// only be called from the main thread.\nfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n=======\napi.go:1252:// and starts the transfer with a TimeoutNow message. This message has the same\ncommands.go:204:// TimeoutNowRequest is the command used by a leader to signal another server to\ncommands.go:206:type TimeoutNowRequest struct {\ncommands.go:211:func (r *TimeoutNowRequest) GetRPCHeader() RPCHeader {\ncommands.go:215:// TimeoutNowResponse is the response to TimeoutNowRequest.\ncommands.go:216:type TimeoutNowResponse struct {\ncommands.go:221:func (r *TimeoutNowResponse) GetRPCHeader() RPCHeader {\ninmem_transport.go:153:// TimeoutNow implements the Transport interface.\ninmem_transport.go:154:func (i *InmemTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {\ninmem_transport.go:161:\tout := rpcResp.Response.(*TimeoutNowResponse)\nnet_transport.go:26:\trpcTimeoutNow\nnet_transport.go:557:// TimeoutNow implements the Transport interface.\nnet_transport.go:558:func (n *NetworkTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {\nnet_transport.go:559:\treturn n.genericRPC(id, target, rpcTimeoutNow, args, resp)\nnet_transport.go:709:\tcase rpcTimeoutNow:\nnet_transport.go:710:\t\tvar req TimeoutNowRequest\nnet_transport.go:715:\t\tlabels = []metrics.Label{{Name: \"rpcType\", Value: \"TimeoutNow\"}}\nraft.go:710:\t\t\t// leadershipTransfer function. Because the TimeoutNow\nraft.go:1024:\t// Step 3: send TimeoutNow message to target server.\nraft.go:1025:\terr := r.trans.TimeoutNow(id, address, &TimeoutNowRequest{RPCHeader: r.getRPCHeader()}, &TimeoutNowResponse{})\nraft.go:1027:\t\terr = fmt.Errorf(\"failed to make TimeoutNow RPC to %v: %v\", id, err)\nraft.go:1405:\tcase *TimeoutNowRequest:\nraft.go:2208:// timeoutNow is what happens when a server receives a TimeoutNowRequest.\