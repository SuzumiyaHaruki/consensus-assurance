"type\": \"null\"}], \"default\": null}, \"repair_of\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"description\": \"Rejected operation ID whose complete draft this submission repairs\", \"title\": \"Repair Of\"}, \"action\": {\"const\": \"explore\", \"title\": \"Action\", \"type\": \"string\"}, \"question\": {\"minLength\": 1, \"title\": \"Question\", \"type\": \"string\"}, \"harness_path\": {\"title\": \"Harness Path\", \"type\": \"string\"}, \"files\": {\"additionalProperties\": {\"type\": \"string\"}, \"default\": {}, \"title\": \"Files\", \"type\": \"object\"}}, \"required\": [\"rationale\", \"action\", \"question\", \"harness_path\"], \"title\": \"ExploreSubmission\", \"type\": \"object\"}\n","exit_code":0,"status":"completed"}}
