{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"grep -n '\"'^func'\"\\\\|ReadIndex\\\\|Advance' ../agent-source/node.go; grep -n 'pendingReadIndexMessages' ../agent-source/raft.go; sed -n '45,125p' ../agent-source/storage.go\"","aggregated_output":"45:func (a *SoftState) equal(b *SoftState) bool {\n70:\t// Note that the readState will be returned when raft receives msgReadIndex.\n117:func isHardStateEqual(a, b pb.HardState) bool {\n122:func IsEmptyHardState(st pb.HardState) bool {\n127:func IsEmptySnap(sp pb.Snapshot) bool {\n159:\t// Users of the Node must call Advance after retrieving the state returned by Ready (unless\n166:\t// Advance notifies the Node that the application has saved progress up to the last Ready.\n169:\t// The application should generally call Advance after it applies the entries in last Ready.\n171:\t// However, as an optimization, the application may call Advance while it is applying the\n174:\t// progress, it can call Advance before finishing applying the last ready.\n176:\t// NOTE: Advance must not be called when using AsyncStorageWrites. Response messages from the\n178:\tAdvance()\n218:\t// ReadIndex request a read state. The read state will be set in the ready.\n223:\t// to retry ReadIndex.\n226:\t// passed into ReadIndex. Starting with release-3.7, this restriction is\n229:\tReadIndex(ctx context.Context, rctx []byte) error\n255:func setupNode(c *Config, peers []Peer) *node {\n276:func StartNode(c *Config, peers []Peer) Node {\n286:func RestartNode(c *Config) Node {\n317:func newNode(rn *RawNode) node {\n336:func (n *node) Stop() {\n348:func (n *node) run() {\n449:\t\t\tn.rn.Advance(rd)\n463:func (n *node) Tick() {\n472:func (n *node) Campaign(ctx context.Context) error { return n.step(ctx, pb.Message{Type: pb.MsgHup}) }\n474:func (n *node) Propose(ctx context.Context, data []byte) error {\n478:func (n *node) Step(ctx context.Context, m pb.Message) error {\n487:func confChangeToMsg(c pb.ConfChangeI) (pb.Message, error) {\n495:func (n *node) ProposeConfChange(ctx context.Context, cc pb.ConfChangeI) error {\n503:func (n *node) step(ctx context.Context, m pb.Message) error {\n507:func (n *node) stepWait(ctx context.Context, m pb.Message) error {\n513:func (n *node) stepWithWaitOption(ctx context.Context, m pb.Message, wait bool) error {\n552:func (n *node) Ready() <-chan Ready { return n.readyc }\n554:func (n *node) Advance() {\n561:func (n *node) ApplyConfChange(cc pb.ConfChangeI) *pb.ConfState {\n574:func (n *node) Status() Status {\n584:func (n *node) ReportUnreachable(id uint64) {\n591:func (n *node) ReportSnapshot(id uint64, status SnapshotStatus) {\n600:func (n *node) TransferLeadership(ctx context.Context, lead, transferee uint64) {\n609:func (n *node) ForgetLeader(ctx context.Context) error {\n613:func (n *node) ReadIndex(ctx context.Context, rctx []byte) error {\n614:\treturn n.step(ctx, pb.Message{Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: rctx}}})\n428:\t// pendingReadIndexMessages is used to store messages of type MsgReadIndex\n432:\tpendingReadIndexMessages []pb.Message\n1358:\t\t\tr.pendingReadIndexMessages = append(r.pendingReadIndexMessages, m)\n2124:\tif len(r.pendingReadIndexMessages) == 0 {\n2134:\tmsgs := r.pendingReadIndexMessages\n2135:\tr.pendingReadIndexMessages = nil\n// application is responsible for cleanup and recovery in this case.\ntype Storage interface {\n\t// TODO(tbg): split this into two interfaces, LogStorage and StateStorage.\n\n\t// InitialState returns the saved HardState and ConfState information.\n\tInitialState() (pb.HardState, pb.ConfState, error)\n\n\t// Entries returns a slice of consecutive log entries in the range [lo, hi),\n\t// starting from lo. The maxSize limits the total size of the log entries\n\t// returned, but Entries returns at least one entry if any.\n\t//\n\t// The caller of Entries owns the returned slice, and may append to it. The\n\t// individual entries in the slice must not be mutated, neither by the Storage\n\t// implementation nor the caller. Note that raft may forward these entries\n\t// back to the application via Ready struct, so the corresponding handler must\n\t// not mutate entries either (see comments in Ready struct).\n\t//\n\t// Since the caller may append to the returned slice, Storage implementation\n\t// must protect its state from corruption that such appends may cause. For\n\t// example, common ways to do so are:\n\t//  - allocate the slice before returning it (safest option),\n\t//  - return a slice protected by Go full slice expression, which causes\n\t//  copying on appends (see MemoryStorage).\n\t//\n\t// Returns ErrCompacted if entry lo has been compacted, or ErrUnavailable if\n\t// encountered an unavailable entry in [lo, hi).\n\tEntries(lo, hi, maxSize uint64) ([]pb.Entry, error)\n\n\t// Term returns the term of entry i, which must be in the range\n\t// [FirstIndex()-1, LastIndex()]. The term of the entry before\n\t// FirstIndex is retained for matching purposes even though the\n\t// rest of that entry may not be available.\n\tTerm(i uint64) (uint64, error)\n\t// LastIndex returns the index of the last entry in the log.\n\tLastIndex() (uint64, error)\n\t// FirstIndex returns the index of the first log entry that is\n\t// possibly available via Entries (older entries have been incorporated\n\t// into the latest Snapshot; if storage only contains the dummy entry the\n\t// first log entry is not available).\n\tFirstIndex() (uint64, error)\n\t// Snapshot returns the most recent snapshot.\n\t// If snapshot is temporarily unavailable, it should return ErrSnapshotTemporarilyUnavailable,\n\t// so raft state machine could know that Storage needs some time to prepare\n\t// snapshot and call Snapshot later.\n\tSnapshot() (pb.Snapshot, error)\n}\n\ntype inMemStorageCallStats struct {\n\tinitialState, firstIndex, lastIndex, entries, term, snapshot int\n}\n\n// MemoryStorage implements the Storage interface backed by an\n// in-memory array.\ntype MemoryStorage struct {\n\t// Protects access to all fields. Most methods of MemoryStorage are\n\t// run on the raft goroutine, but Append() is run on an application\n\t// goroutine.\n\tsync.Mutex\n\n\thardState pb.HardState\n\tsnapshot  pb.Snapshot\n\t// ents[i] has raft log position i+snapshot.Metadata.Index\n\tents []pb.Entry\n\n\tcallStats inMemStorageCallStats\n}\n\n// NewMemoryStorage creates an empty MemoryStorage.\nfunc NewMemoryStorage() *MemoryStorage {\n\treturn &MemoryStorage{\n\t\t// When starting from scratch populate the list with a dummy entry at term zero.\n\t\tents: make([]pb.Entry, 1),\n\t}\n}\n\n// InitialState implements the Storage interface.\nfunc (ms *MemoryStorage) InitialState() (pb.HardState, pb.ConfState, error) {\n\tms.callStats.initialState++\n\treturn ms.hardState, ms.snapshot.Metadata.ConfState, nil\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The quorum code counts configured voters and requires both majorities in joint configurations. Pending reads have two distinct lifecycles: reset discards collected heartbeat acknowledgments, but retains requests waiting for a current-term commit so they can be requalified. I also found different persistence-order wording in the package guide and `Ready` contract; I’ll preserve that conflict when describing caller duties.\n"}}
