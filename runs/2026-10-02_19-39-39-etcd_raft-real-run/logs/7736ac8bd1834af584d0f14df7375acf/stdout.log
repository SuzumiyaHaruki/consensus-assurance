,\"before_term\":2,\"call_completed\":true,\"campaign_started\":false,\"event\":\"campaign_observed\",\"node\":3,\"phase\":\"older_apply_completed\",\"request\":\"snapshot-campaign-1\",\"snapshot_completed\":false,\"snapshot_index\":7}\nCA_EVENT {\"event\":\"snapshot_installed\",\"payload\":[\"\",\"old-normal\",\"new-normal-a\",\"new-normal-b\"],\"request\":\"snapshot-campaign-1\",\"snapshot_index\":7}\nCA_EVENT {\"before_role\":\"StateFollower\",\"before_term\":2,\"event\":\"campaign_admitted\",\"node\":3,\"old_apply_completed\":true,\"phase\":\"snapshot_completed\",\"request\":\"snapshot-campaign-1\",\"snapshot_completed\":true,\"snapshot_index\":7}\nCA_EVENT {\"after_role\":\"StateCandidate\",\"after_term\":3,\"app_applied\":7,\"applied\":7,\"before_term\":2,\"call_completed\":true,\"campaign_started\":true,\"event\":\"campaign_observed\",\"node\":3,\"phase\":\"snapshot_completed\",\"request\":\"snapshot-campaign-1\",\"snapshot_completed\":true,\"snapshot_index\":7}\nCA_EVENT {\"event\":\"history_finished\",\"final_role\":\"StateLeader\",\"final_term\":3,\"request\":\"snapshot-campaign-1\",\"snapshot_index\":7}\nimport json\nr=json.load(open('../research.json'));candidate=r['candidates'][0];q=candidate['question']\nclaim_id='C_append_completed_quorum'\nbid='BIND_self_support'\nsources=[dict(id='S_bootstrap_api',file='bootstrap.go',start_line=25,end_line=79,kind='code_observation'),dict(id='S_memory_read_write',file='storage.go',start_line=120,end_line=155,kind='code_observation'),dict(id='S_config_validation',file='raft.go',start_line=291,end_line=338,kind='code_observation'),dict(id='S_discard_logger',file='logger.go',start_line=61,end_line=75,kind='code_observation'),dict(id='S_append_duty',file='raft.go',start_line=544,end_line=590,kind='document_statement')]\nscope=dict(description='Fresh current-term normal entry in a fixed three-voter RawNode cluster with AsyncStorageWrites, following a completed election and committed/applied leader no-op.',assumptions=['Crash-free, non-Byzantine execution with actual protocol-produced messages.','Each local append target is processed reliably in FIFO order; attached responses are delivered only after modeled stable writes complete.','MemoryStorage represents the stable-storage API boundary for this no-crash schedule; a completed append is not physical disk durability evidence.','No membership changes after bootstrap, leader transfer, compaction or snapshots in the measured suffix.'],excluded=['Overall consensus correctness, physical crash durability, restart loss and client-visible safety consequences.','General liveness; the remote-majority phase is a permitted control, not a deadline claim.','Other configurations, term transitions and arbitrary network reorderings.'])\nground=dict(source_ids=['S_reset_append','S_send','S_leader_ack','S_tracker_commit','S_majority','S_log_decision'],expectation_ids=['S_append_duty','S_async_contract','S_joint'],binding_ids=[bid],derivation='S_append_duty states that new entries must persist before counting toward commitment, including explicit deferred response enforcement. S_async_contract assigns durability-before-response to the local storage caller. S_joint describes majority support semantics, with an empty outgoing half reducing to one majority. For the fixed three-voter scope this yields commitment implies append-completed copies on at least two voters; it does not require the leader to be one of them.',applicability='Actual RawNode producer paths and compliant local FIFO storage adapter; modeled storage completion in a crash-free history, not a disk-failure experiment.',alternatives=['Both followers may form the majority while the leader local append remains pending.','A minority can remain pending indefinitely without violating this safety implication.'])\nclaim=dict(id=claim_id,kind='obligation',concern='consensus_safety',description='Under a compliant asynchronous storage caller, an elected leader must not commit a fresh current-term entry in a fixed three-voter configuration unless copies of that entry have completed stable append on a voter majority. The leader need not belong to that completed majority.',source_ids=['S_append_duty','S_async_contract','S_joint','S_majority'],scope=scope,pending=[],grounding=ground)\nbinding=dict(id=bid,material_id='S_reset_append',symbol='appendEntry',start_line=815,end_line=847,description='Assigns fresh entry identity, appends to unstable log and sends the leader self acknowledgment through send, whose storage-dependent response queue determines when self support can be consumed.',pending=[],associations=[dict(claim_id=claim_id,source_ids=['S_reset_append','S_send','S_append_duty','S_leader_ack'],rationale='The leader append producer delays new self support; stepLeader later consumes that support to advance commitment. Observations compare actual resulting commit with independent per-node storage reads.')],anchor=dict(material_id='S_reset_append',start_line=815,end_line=847,symbol='appendEntry',source_ids=['S_reset_append'],boundary_complete=True))\nlegality=dict(source_ids=['S_bootstrap_api','S_raw_entry','S_config_validation','S_campaign','S_ready_advance','S_append_messages','S_memory_append','S_memory_read_write','S_node_loop','S_test_ready','S_test_append','S_test_apply'],expectation_ids=['S_async_contract','S_ready_contract','S_storage_contract'],binding_ids=[bid],derivation='Construct three empty MemoryStorage-backed RawNodes, Bootstrap identical peers and drain all local/network work. Campaign node 1 and drain actual vote/append responses until the elected leader no-op is stored, committed and applied on all nodes. No raft/tracker fields are assigned. Propose one payload through RawNode.Propose; read its generated index and term. In the suffix process four fixed FIFO schedules: no append worker, follower 2 only, followers 2 and 3, then all workers. Each worker appends actual Entries and saves nonempty HardState before releasing actual attached Responses; all messages target actual node IDs. Apply workers process only actual MsgStorageApply entries and call ApplyConfChange for bootstrap configuration entries. No Advance is called in async mode. Access to raft fields is read-only observation. Each phase drains available permitted work, retaining blocked queues, and terminates independently of the measured commitment.',applicability='RawNode is used sequentially on one test goroutine. Reliable FIFO local append/application work, no Tick or term-changing input during the measured suffix. Adapter uses MemoryStorage as modeled stable storage and performs no crash. Maximum 10000 scheduler iterations per phase is a construction bound, not a liveness deadline.',unresolved=[],alternatives=['Synchronous Ready/Advance has a different caller boundary and is outside this check.','The Node channel API is not invoked; its public completion permission is not substituted for RawNode.'])\nmonitor_ground=dict(source_ids=['S_leader_ack','S_tracker_commit','S_log_decision','S_memory_read_write','S_memory_append','S_reset_append'],expectation_ids=['S_append_duty','S_async_contract','S_joint'],binding_ids=[bid],derivation='quorum_observed reads raftLog.committed after each phase and compares it to the actual target index. Independently, each MemoryStorage is queried for target index/term/payload. stored_copies and append_completed_majority derive solely from those storage reads, never from tracker Match. Match, pending queues and leader application are diagnostic fields. The safety oracle is the one-way implication committed => append_completed_majority. The fixed phase schedule continues regardless of the comparison.',applicability='A phase_admitted event records a reached elected/persisted/applied prefix and accepted proposal before its phase runs. request and phase distinguish observations; target index/term are diagnostic identity confirmations. schedule_complete selects completion of the fixed phase, not success of the property.',alternatives=['A committed remote quorum with local leader storage still pending is allowed.','False committed antecedent is a pending outcome, not a violation or an eventual-success claim.'])\nplan=dict(description='Delay the elected leader append worker for one fresh proposal; compare no completed follower, one completed follower, both completed followers, then leader completion. Measure commitment and storage copies independently after each completed permitted-work phase. Remote-only majority and final all-worker phase are retained controls without equating quorum sufficiency with a general liveness guarantee.',claim_id=claim_id,binding_ids=[bid],harness=dict(kind='go_test',source='',files={},description='Single TestAssuranceDelayedLeaderStorageQuorum. Three sequential RawNodes, actual bootstrap/election prefix, actual proposal and message/Ready/storage producers; independent storage and commit observations.',semantic_changes=['MemoryStorage substitutes for a crash-durable backend in a no-crash schedule; it represents the completion boundary only.','Deterministic FIFO transport and separate per-node append/apply queues replace a production scheduler.','Read-only internal fields expose entry identity, leader role, Match and committed index; no protocol state or dependency is modified.'],prerequisites=[dict(alias='admitted',event='phase_admitted',conditions=[dict(field='prefix_complete',value=True),dict(field='proposal_accepted',value=True)])],legality=legality),monitors=[dict(id='M_quorum_completion',checker_id='quorum_completion',event='quorum_observed',binding_ids=[bid],grounding=monitor_ground,admission_alias='admitted',applicability_conditions=[])],observable_properties=[dict(checker_id='quorum_completion',kind='event_implication',trigger=dict(field='event',value='quorum_observed'),antecedent=dict(field='committed',value=True),assertion=dict(field='append_completed_majority',value=True),identity_fields=['request','phase'],description='At each completed scheduled checkpoint, commitment of the proposed entry implies actual modeled stable append completion at two or more of the three voters. A pending minority is permitted; remote-majority and final phases retain raw control measurements.')],uncertainties=['This observation concerns storage-completion-aware quorum bookkeeping under a modeled stable-storage interface, not physical durability or client-visible loss.','Only the four fixed phase boundaries of one no-crash, single-term suffix are measured.'])\njson.dump(plan,open('quorum-check-plan.json','w'),indent=2)\nsub=dict(action='check',rationale='Execute a bounded same-history quorum implication with an independent storage oracle and a remote-only-majority control.',sources=sources,candidate=dict(action='obligation',candidate_id=candidate['id'],question=q,rationale='Fix the documented durability-before-counting responsibility for the accepted fresh-entry quorum question; remote-majority is permitted and pending minority is not equated to failure.',obligation=claim,bindings=[binding]),plan_path='quorum-check-plan.json',harness_path='quorum_storage_test.go',feedback=dict(ref_ids=['S_bootstrap_api','S_async_contract','S_append_duty','S_memory_read_write','S_reset_append','S_leader_ack'],answered='The check now has a concrete public-API producer prefix and independent MemoryStorage entry observations; no critical protocol state is assigned. Phase completion is controlled by a fixed scheduler rather than waiting for the forbidden outcome.',remaining=['Trusted-runner execution and current checker correspondence remain necessary.','Physical crash/restart and client consequences remain outside this fixed obligation scope.'],understanding='unchanged',rationale='The next discriminator is the actual commit/storage comparison after one follower and both followers finish while leader append work is held.'))\njson.dump(sub,open('submission-quorum-check.json','w'),indent=2)\n","exit_code":0,"status":"completed"}}
