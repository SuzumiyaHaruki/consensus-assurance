{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,250p' ../direct-checks/fb3f8314acbe4a5886ec686005617442/assurance_generated_test.go\npython3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/fb3f8314acbe4a5886ec686005617442/plan.json'));print(json.dumps({'prerequisites':p['harness']['prerequisites'],'monitors':p['monitors'],'properties':p['observable_properties']},indent=2))\nPY\"","aggregated_output":"        for i:=0; i<3; i++ {\n            if allow[i] && c.appendOne(i) { work=true }\n            if c.applyOne(i) { work=true }\n        }\n        if len(c.network)>0 {\n            msg := c.network[0]\n            c.network = c.network[1:]\n            if msg.To<1 || msg.To>3 { c.t.Fatalf(\"unexpected recipient %d\",msg.To) }\n            assuranceEmit(map[string]interface{}{\"event\":\"message_dequeued\", \"request\":c.request, \"phase\":c.phase, \"from\":msg.From,\"to\":msg.To,\"type\":msg.Type.String(),\"index\":msg.Index,\"term\":msg.Term})\n            if msg.Type==pb.MsgVoteResp && msg.To==1 {\n                hs,_,err:=c.stores[msg.From-1].InitialState();if err!=nil {c.t.Fatal(err)}\n                if msg.Reject || hs.Term!=msg.Term || hs.Vote!=1 {c.t.Fatal(\"grant lacks matching completed vote at capture\")}\n                c.heldVotes=append(c.heldVotes,msg)\n                assuranceEmit(map[string]interface{}{\"event\":\"grant_captured\",\"request\":c.request,\"from\":msg.From,\"term\":msg.Term,\"stored_term\":hs.Term,\"stored_vote\":hs.Vote})\n            } else {c.deliver(msg)}\n            work=true\n        }\n        if !work { return }\n    }\n    c.t.Fatal(\"schedule work bound exhausted\")\n}\n\n\nfunc (c *assuranceStorageCluster) deliver(msg pb.Message) {\n    if msg.Type==pb.MsgVoteResp && msg.To==1 && !msg.Reject && msg.Term==c.currentTerm {c.delivered[msg.From]=true}\n    assuranceEmit(map[string]interface{}{\"event\":\"actual_delivery\",\"request\":c.request,\"phase\":c.phase,\"from\":msg.From,\"to\":msg.To,\"type\":msg.Type.String(),\"term\":msg.Term})\n    if err:=c.nodes[msg.To-1].Step(msg);err!=nil {c.t.Fatal(err)}\n}\nfunc (c *assuranceStorageCluster) release(term,from uint64) {\n    for i,m:=range c.heldVotes {\n        if m.Term==term && m.From==from {\n            c.heldVotes=append(c.heldVotes[:i],c.heldVotes[i+1:]...)\n            c.deliver(m)\n            return\n        }\n    }\n    c.t.Fatalf(\"missing actual grant term=%d from=%d\",term,from)\n}\nfunc TestAssuranceDelayedElectionGrants(t *testing.T) {\n    c:=&assuranceStorageCluster{t:t,request:\"consecutive-campaigns-1\",phase:\"bootstrap\",delivered:map[uint64]bool{}}\n    all:=[3]bool{true,true,true}\n    peers:=[]Peer{{ID:1},{ID:2},{ID:3}}\n    for i:=0;i<3;i++ {\n        c.stores[i]=NewMemoryStorage()\n        n,err:=NewRawNode(&Config{ID:uint64(i+1),Storage:c.stores[i],ElectionTick:10,HeartbeatTick:1,MaxSizePerMsg:1<<20,MaxInflightMsgs:8,AsyncStorageWrites:true,Logger:discardLogger})\n        if err!=nil {t.Fatal(err)}\n        c.nodes[i]=n\n        if err=n.Bootstrap(peers);err!=nil {t.Fatal(err)}\n    }\n    c.drain(all)\n    c.phase=\"first_campaign\"\n    if err:=c.nodes[0].Campaign();err!=nil {t.Fatal(err)}\n    oldTerm:=c.nodes[0].BasicStatus().Term\n    c.drain(all)\n    if len(c.heldVotes)!=3 || c.nodes[0].BasicStatus().RaftState!=StateCandidate {t.Fatal(\"first campaign prefix missing\")}\n    c.phase=\"second_campaign\"\n    if err:=c.nodes[0].Campaign();err!=nil {t.Fatal(err)}\n    c.currentTerm=c.nodes[0].BasicStatus().Term\n    c.drain(all)\n    if len(c.heldVotes)!=6 || c.currentTerm!=oldTerm+1 || c.nodes[0].BasicStatus().RaftState!=StateCandidate {t.Fatal(\"second campaign prefix missing\")}\n    phases:=[]struct{name string;term,from uint64}{\n        {\"old_self\",oldTerm,1},{\"old_peer_2\",oldTerm,2},{\"old_peer_3\",oldTerm,3},\n        {\"current_self\",c.currentTerm,1},{\"current_peer_2\",c.currentTerm,2},{\"current_peer_3\",c.currentTerm,3},\n    }\n    for _,p:=range phases {\n        c.phase=p.name\n        assuranceEmit(map[string]interface{}{\"event\":\"vote_phase_admitted\",\"request\":c.request,\"phase\":p.name,\"node\":1,\"campaign_term\":c.currentTerm,\"prefix_ready\":true,\"released_term\":p.term,\"released_sender\":p.from})\n        c.release(p.term,p.from)\n        c.drain(all)\n        st:=c.nodes[0].BasicStatus()\n        assuranceEmit(map[string]interface{}{\"event\":\"election_observed\",\"request\":c.request,\"phase\":p.name,\"node\":1,\"campaign_term\":c.currentTerm,\"actual_term\":st.Term,\"role\":st.RaftState.String(),\"leader\":st.RaftState==StateLeader,\"current_grants\":len(c.delivered),\"current_majority\":len(c.delivered)>=2,\"senders\":c.delivered,\"held_grants\":len(c.heldVotes),\"schedule_complete\":true})\n    }\n    assuranceEmit(map[string]interface{}{\"event\":\"history_finished\",\"request\":c.request,\"campaign_term\":c.currentTerm,\"held_grants\":len(c.heldVotes)})\n}\n{\n  \"prerequisites\": [\n    {\n      \"alias\": \"release_input\",\n      \"event\": \"vote_phase_admitted\",\n      \"conditions\": [\n        {\n          \"field\": \"prefix_ready\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        }\n      ]\n    }\n  ],\n  \"monitors\": [\n    {\n      \"id\": \"M_current_grants\",\n      \"checker_id\": \"current_campaign_grants\",\n      \"event\": \"election_observed\",\n      \"binding_ids\": [\n        \"BIND_vote_consumer\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S_candidate_follower\",\n          \"S_step\",\n          \"S_roles\",\n          \"S_tracker_votes\",\n          \"S_raw_entry\"\n        ],\n        \"expectation_ids\": [\n          \"S_majority\",\n          \"S_send\"\n        ],\n        \"binding_ids\": [\n          \"BIND_vote_consumer\"\n        ],\n        \"derivation\": \"The driver maintains an independent sender set from the original delivered VoteResp messages whose Term equals the second actual campaign term and Reject is false. It does not inspect ProgressTracker.Votes or TallyVotes. Public BasicStatus supplies the leader role and actual term after each completed fixed phase. Compare leader implies current_majority. Raw counts, sender IDs, release identity, actual term and held reply count remain diagnostic; no observation is filtered on its expected outcome.\",\n        \"applicability\": \"Each vote_phase_admitted and election_observed pair shares request/phase/node/campaign_term identity. The prerequisite denotes completed two-campaign construction and admission of a fixed release operation. Every phase drains and emits one result. Current-majority is necessary, not an equality or liveness assertion.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"Old-term delivery can leave the candidate pending without a violation.\",\n          \"The current self-plus-peer phase is a permitted completion control.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"release_input\"\n    }\n  ],\n  \"properties\": [\n    {\n      \"checker_id\": \"current_campaign_grants\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"election_observed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"current_majority\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"leader\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"request\",\n        \"phase\",\n        \"node\",\n        \"campaign_term\"\n      ],\n      \"description\": \"At each fixed completed phase, leadership requires delivered current-term grants from at least two of the three voters; lower-term grants do not contribute.\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/fb3f8314acbe4a5886ec686005617442/plan.json'));src=set()\nfor g in [p['harness']['legality']]+[m['grounding'] for m in p['monitors']]:src.update(g['source_ids']);src.update(g['expectation_ids'])\nsrc.update(['S_tracker_votes','S_reset_append'])\ns=dict(action='review',artifact_id='88a7a3fc3ae0481da6ac92aedb163cbb',rationale='Assess the fixed election-support check against actual six-phase execution and the local term-qualified majority duty.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=sorted(src),rationale='Reviewed the fixed plan and driver in direct-checks/fb3f8314acbe4a5886ec686005617442, execution 9f6e375680194d83847ef7ce1e57ee6a and its observations. The duty is local implementation eligibility: ordinary replies pass term admission before stepCandidate consumes a configured majority; no broader consensus theorem is claimed. Three bootstrapped RawNodes genuinely campaign twice. Capture events establish six original grants, one from each voter at terms 2 and 3, with matching stored term and vote=1. Delaying actual messages after completed FIFO local writes is within the async transport contract. Repeated Campaign occurs while still candidate, causing a real term increment and reset, with no state assignment. The ledger adds sender IDs only when original current-term grants are actually delivered; it does not read the implementation vote map. Each of six uniquely identified release_input events has its corresponding fully completed result, with actual_term remaining 3. All three old grants leave node 1 candidate with zero current grants; the current self response leaves one grant and candidate role; current peer 2 yields leader with two grants; peer 3 leaves leader with three. The final event has no held grants. The fixed drain never waits for leadership, and no result applicability depends on the outcome. Only checkpoint leadership is compared; in this observed suffix there are no other terms, timers, rejections or competing leaders to mask a transient role change during drain. The direct implication holds at all declared checkpoints, including the permitted current-majority control. Source term filtering and campaign reset explain this branch; they do not prove all election histories. No current correspondence issue found.',limitations=['Six fixed checkpoints in two ordinary campaigns, not every response interleaving or pre-vote transition.','Stored vote checks are construction observations under MemoryStorage; no crash durability result.','The result is local current-term support eligibility, not a conflicting-leader or client-visible safety conclusion.'])],feedback=dict(ref_ids=['71093e782cd5489d80cb7a6ea0a93892','9f6e375680194d83847ef7ce1e57ee6a','S_step','S_candidate_follower','S_roles'],answered='Execution 9f6e375680194d83847ef7ce1e57ee6a kept node 1 candidate after all three term-2 grants arrived in campaign term 3. One current grant also left it pending; a current-term majority yielded leadership. All six correlated comparisons completed. This answers the selected stale-term grant discriminator within its fixed scope.',remaining=['A delayed pre-vote grant can carry the same numeric term as a subsequently entered real campaign, so term filtering alone does not address that separate response-type boundary.'],understanding='unchanged',rationale='The lower-term guard settles the selected case. Next inspect and, if tractable, check the same-term pre-vote/real-vote distinction: retain one genuine pre-vote response while a pre-vote majority starts the real campaign, then deliver it before a real-vote majority. This tests the distinct stepCandidate response-type guard rather than repeating stale-term cases.',question_updates={'0d4afe8e07334282b959ffe00179b9da':{'unknowns':[],'resume_conditions':[]}}))\njson.dump(s,open('submission-vote-review.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-02_19-39-39-etcd_raft-real-run --submission submission-vote-review.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
