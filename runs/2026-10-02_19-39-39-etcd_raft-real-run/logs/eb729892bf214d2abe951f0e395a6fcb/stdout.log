{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\ns=Path('snapshot_old_config_test.go').read_text().replace('TestAssuranceSnapshotOldConfiguration','TestAssuranceSnapshotConfigurationBeforeRestore').replace('snapshot-old-config-1','snapshot-config-before-restore-1')\nneedle='            if err := c.nodes[msg.To-1].Step(msg); err \"'!= nil { c.t.Fatal(err) }'\"'\ninsert='''            if msg.Type==pb.MsgSnap && msg.To==3 {\n                // Caller policy control: apply the older issued batch before\n                // delivering this actual snapshot. Its response remains queued.\n                for c.applyOne(2) {}\n                st:=c.nodes[2].Status()\n                assuranceEmit(map[string]interface{}{\\\"event\\\":\\\"pre_restore_configuration\\\",\\\"request\\\":c.request,\\\"snapshot_index\\\":c.snapshotIndex,\\\"current_learners\\\":st.Config.Learners,\\\"app_applied\\\":c.applied[2],\\\"raft_applied\\\":st.Applied,\\\"pending_responses\\\":len(c.network)})\n            }\n'''\nassert needle in s;s=s.replace(needle,insert+needle);Path('snapshot_config_before_restore_test.go').write_text(s)\nimport json\np=dict(action='explore',rationale='Compare one explicit caller ordering control against the retained after-restore exploration, keeping the actual producer history and snapshot unchanged.',question='Does applying the already issued learner-add batch immediately before Step receives the actual newer snapshot, while leaving its storage-apply response queued, avoid the membership difference observed when ApplyConfChange ran after restore?',harness_path='snapshot_config_before_restore_test.go',feedback=dict(ref_ids=['71b0b0216b9f493dabbfcc7ac791b691','S_raw_entry','S_restore_config','S_apply_progress','S_async_usage','S_node_loop'],answered='The control changes only the timing of the older batch application relative to network snapshot delivery. Before Step(MsgSnap),