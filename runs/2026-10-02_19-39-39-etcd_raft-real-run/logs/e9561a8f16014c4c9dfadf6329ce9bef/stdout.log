. The read state will have the same rctx attached.\n   222\t\t// Note that request can be lost without notice, therefore it is user's job\n   223\t\t// to retry ReadIndex.\n   224\t\t//\n   225\t\t// Retries must always use new rctxes, and never reuse an rctx already\n   226\t\t// passed into ReadIndex. Starting with release-3.7, this restriction is\n   227\t\t// lifted, and it is ok to retry the same rctx. Refer to\n   228\t\t// https://github.com/etcd-io/raft/issues/392 for more details.\n   229\t\tReadIndex(ctx context.Context, rctx []byte) error\n   230\t\n   231\t\t// Status returns the current status of the raft state machine.\n   232\t\tStatus() Status\n   233\t\t// ReportUnreachable reports the given node is not reachable for the last send.\n   234\t\tReportUnreachable(id uint64)\n   235\t\t// ReportSnapshot reports the status of the sent snapshot. The id is the raft ID of the follower\n   236\t\t// who is meant to receive the snapshot, and the status is SnapshotFinish or SnapshotFailure.\n   237\t\t// Calling ReportSnapshot with SnapshotFinish is a no-op. But, any failure in applying a\n   238\t\t// snapshot (for e.g., while streaming it from leader to follower), should be reported to the\n   239\t\t// leader with SnapshotFailure. When leader sends a snapshot to a follower, it pauses any raft\n   240\t\t// log probes until the follower can apply the snapshot and advance its state. If the follower\n   241\t\t// can't do that, for e.g., due to a crash, it could end up in a limbo, never getting any\n   242\t\t// updates from the leader. Therefore, it is crucial that the application ensures that any\n   243\t\t// failure in snapshot sending is caught and reported back to the leader; so it can resume raft\n   244\t\t// log probing in the follower.\n   535\t\t_ = rn.raft.Step(pb.Message{Type: pb.MsgUnreachable, From: id})\n   536\t}\n   537\t\n   538\t// ReportSnapshot reports the status of the sent snapshot.\n   539\tfunc (rn *RawNode) ReportSnapshot(id uint64, status SnapshotStatus) {\n   540\t\trej := status == SnapshotFailure\n   541\t\n   542\t\t_ = rn.raft.Step(pb.Message{Type: pb.MsgSnapStatus, From: id, Reject: rej})\n   543\t}\n   544\t\n   545\t// TransferLeader tries to transfer leadership to the given transferee.\n   546\tfunc (rn *RawNode) TransferLeader(transferee uint64) {\n   547\t\t_ = rn.raft.Step(pb.Message{Type: pb.MsgTransferLeader, From: transferee})\n   548\t}\n   549\t\n   550\t// ForgetLeader forgets a follower's current leader, changing it to None.\n   551\t// See (Node).ForgetLeader for details.\n   552\tfunc (rn *RawNode) ForgetLeader() error {\n   553\t\treturn rn.raft.Step(pb.Message{Type: pb.MsgForgetLeader})\n   554\t}\n   555\t\n   556\t// ReadIndex requests a read state. The read state will be set in ready.\n   557\t// Read State has a read index. Once the application advances further than the read\n   558\t// index, any linearizable read requests issued before the read request can be\n   559\t// processed safely. The read state will have the same rctx attached.\n   560\t// See (Node).ReadIndex for more details.\n   561\tfunc (rn *RawNode) ReadIndex(rctx []byte) {\n   562\t\t_ = rn.raft.Step(pb.Message{Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: rctx}}})\n   563\t}\n1192:// TestRaftFreesReadOnlyMem ensures raft will free read request from\n1193:// readOnly readIndexQueue and pendingReadIndex map.\n1195:func TestRaftFreesReadOnlyMem(t *testing.T) {\n1205:\tsm.Step(pb.Message{From: 2, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: ctx}}})\n1210:\trequire.Len(t, sm.readOnly.readIndexQueue, 1)\n1211:\trequire.Len(t, sm.readOnly.pendingReadIndex, 1)\n1212:\t_, ok := sm.readOnly.pendingReadIndex[string(ctx)]\n1219:\trequire.Empty(t, sm.readOnly.readIndexQueue)\n1220:\trequire.Empty(t, sm.readOnly.pendingReadIndex)\n1221:\t_, ok = sm.readOnly.pendingReadIndex[string(ctx)]\n1907:func TestReadOnlyOptionSafe(t *testing.T) {\n1941:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n1952:func TestReadOnlyWithLearner(t *testing.T) {\n1985:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n1996:func TestReadOnlyOptionLease(t *testing.T) {\n2000:\ta.readOnly.option = ReadOnlyLeaseBased\n2001:\tb.readOnly.option = ReadOnlyLeaseBased\n2002:\tc.readOnly.option = ReadOnlyLeaseBased\n2036:\t\tnt.send(pb.Message{From: tt.sm.id, To: tt.sm.id, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: tt.wctx}}})\n2046:// TestReadOnlyForNewLeader ensures that a leader only accepts MsgReadIndex message\n2048:func TestReadOnlyForNewLeader(t *testing.T) {\n2082:\t// Ensure peer a drops read only request.\n2085:\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: wctx}}})\n2099:\t// Ensure peer a processed postponed read only request after it committed an entry at its term.\n2105:\t// Ensure peer a accepts read only request after it committed an entry at its term.\n2106:\tnt.send(pb.Message{From: 1, To: 1, Type: pb.MsgReadIndex, Entries: []pb.Entry{{Data: wctx}}})\n","exit_code":0,"status":"completed"}}
