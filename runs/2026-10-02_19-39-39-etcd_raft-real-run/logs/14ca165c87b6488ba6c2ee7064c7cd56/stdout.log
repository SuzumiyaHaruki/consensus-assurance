 \"object_type\": \"direct_check\",\n      \"version\": 1,\n      \"required_aspects\": [\n        \"checker_correspondence\"\n      ],\n      \"optional_aspects\": [\n        \"applicability\",\n        \"decomposition\"\n      ]\n    }\n  ]\n}\n{\n  \"id\": \"80c04c78294148dc8dd4a859c2434ed4\",\n  \"question\": {\n    \"audit_spec_version\": 4,\n    \"disposition\": \"ready_for_check\",\n    \"preferred_check\": \"controlled_schedule\",\n    \"question\": \"With a full snapshot pending on a voter using AsyncStorageWrites, can completion of older normal-entry application work allow an explicit Campaign before the snapshot append response is delivered?\",\n    \"importance\": \"Campaigning before the pending recovery barrier is released could let authority acquisition use a restored log/configuration while local snapshot work remains incomplete. The selected discriminator concerns local campaign admission; an election win, conflicting decision or client-visible consequence would require independent history and observations.\",\n    \"source_ids\": [\n      \"S_append_messages\",\n      \"S_apply_progress\",\n      \"S_async_contract\",\n      \"S_async_usage\",\n      \"S_campaign\",\n      \"S_candidate_follower\",\n      \"S_config_restore\",\n      \"S_follower_log\",\n      \"S_joint\",\n      \"S_leader_ack\",\n      \"S_leader_admit\",\n      \"S_leader_other\",\n      \"S_load_read\",\n      \"S_log_append\",\n      \"S_log_apply\",\n      \"S_log_decision\",\n      \"S_log_progress\",\n      \"S_log_snapshot\",\n      \"S_majority\",\n      \"S_memory_snapshot\",\n      \"S_node_loop\",\n      \"S_node_wait\",\n      \"S_progress_update\",\n      \"S_raw_entry\",\n      \"S_ready_advance\",\n      \"S_ready_usage\",\n      \"S_replication_send\",\n      \"S_reset_append\",\n      \"S_restart\",\n      \"S_restore_config\",\n      \"S_roles\",\n      \"S_send\",\n      \"S_step\",\n      \"S_storage_contract\",\n      \"S_test_append\",\n      \"S_test_ready\",\n      \"S_ticks\",\n      \"S_tracker_active\",\n      \"S_tracker_commit\",\n      \"S_tracker_votes\",\n      \"S_transfer_snapshot_test\",\n      \"S_unstable_replace\",\n      \"S_unstable_stable\"\n    ],\n    \"participants\": [\n      \"Elected leader and quorum follower producing a snapshot prefix\",\n      \"Lagging voter receiving a full snapshot\",\n      \"Serialized RawNode caller and separate FIFO append/apply workers\"\n    ],\n    \"objects\": [\n      \"Pending snapshot identity\",\n      \"Previously issued normal-entry apply batch and attached response\",\n      \"Campaign request\",\n      \"Term, role and outbound vote requests\"\n    ],\n    \"contexts\": [\n      \"Three fixed voters with all bootstrap configuration entries applied\",\n      \"AsyncStorageWrites and no pre-vote; explicit Campaign, without election timer assumptions\",\n      \"Snapshot produced from an actually committed and applied leader prefix after the receiving voter is isolated\",\n      \"Older apply batch contains only normal entries; complete it before state-machine snapshot installation\",\n      \"No restart, configuration transition or critical raft-state assignment\"\n    ],\n    \"event_paths\": [\n      \"Proposal and replication -> leader application -> MemoryStorage.CreateSnapshot and Compact -> automatic snapshot fallback -> follower full restore\",\n      \"Earlier MsgStorageApply work -> apply normal entries -> attached MsgStorageApplyResp -> explicit Campaign while snapshot append work remains held\",\n      \"Complete snapshot storage and installation -> attached MsgStorageAppendResp -> repeat Campaign with a fixed output drain\"\n    ],\n    \"activity_classes\": [\n      \"A2\",\n      \"A3\",\n      \"A5\",\n      \"A6\"\n    ],\n    \"behavior_ids\": [\n      \"B_recovery\",\n      \"B_append_response_packaging\",\n      \"B_step_context_and_storage\",\n      \"B_elect_transfer\",\n      \"B_ready_application\"\n    ],\n    \"fact_ids\": [\n      \"F_pending_snapshot\"\n    ],\n    \"supporting_behavior_ids\": {\n      \"B_propose_replicate\": \"Actual missing-predecessor replication path produces MsgSnap from leader storage.\",\n      \"B_aggregate_commit\": \"Quorum commitment establishes the producer prefix from which the application creates the snapshot.\"\n    },\n    \"obligation_relation_kind\": \"consumption\",\n    \"counterevidence\": [\n      \"promotable directly tests hasNextOrInProgressSnapshot, while MsgStorageApplyResp only changes applied progress; source review predicts the barrier remains intact.\",\n      \"Ready acceptance changes snapshotInProgress but leaves the pointer used by the guard present.\",\n      \"Snapshot fast-forward when its index/term already matches the recipient log does not create the selected pending barrier and must be distinguished in construction.\"\n    ],\n    \"unknowns\": [\n      \"The older-configuration-batch ordering contract remains outside this normal-entry scope.\"\n    ],\n    \"priority\": 0,\n    \"trigger_rationale\": \"The prior source handoff separated applied-index advancement from snapshot completion. A single actual pending snapshot with an older normal apply response isolates the consumer guard with fewer caller-contract assumptions than overlapping configuration application or replacement snapshots. Compare term/role/vote output for Campaign while held and after completed snapshot work; controls should finish under a fixed schedule rather than await an election win.\"\n  },\n  \"status\": \"escalated\",\n  \"parent_candidate_id\": null,\n  \"fork_reason\": \"\",\n  \"stop_reason\": \"Attribute the duty to the implementation campaign precondition and pending-snapshot eligibility definition; do not generalize it to consensus correctness.\",\n  \"resume_conditions\": [],\n  \"obligation_id\": \"C_snapshot_campaign_barrier\",\n  \"result_claim_ids\": [\n    \"C_snapshot_campaign_barrier\"\n  ],\n  \"open_issue_ids\": [],\n  \"current_applicability\": \"within_recorded_scope\",\n  \"executions\": [\n    {\n      \"check_id\": \"d686bc84b11b41479b42297a35cca17a\",\n      \"artifact_id\": \"def39335c6a64985bb7df2fea4aabe98\",\n      \"action\": \"direct_check\",\n      \"status\": \"completed\",\n      \"outcome\": \"tests_passed\",\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"checks\",\n        \"match\": {\n          \"id\": \"d686bc84b11b41479b42297a35cca17a\"\n        }\n      }\n    }\n  ],\n  \"record\": {\n    \"path\": \"state.json\",\n    \"collection\": \"question_candidates\",\n    \"match\": {\n      \"id\": \"80c04c78294148dc8dd4a859c2434ed4\"\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
