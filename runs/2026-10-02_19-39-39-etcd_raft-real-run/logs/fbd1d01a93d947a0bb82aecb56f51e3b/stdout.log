{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '103,210p' ../direct-checks/28cccd2edbbb499d8d37d5f129639d5f/assurance_generated_test.go\npython3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/28cccd2edbbb499d8d37d5f129639d5f/plan.json'));print(json.dumps({'scope':p.get('scope'),'prerequisites':p['harness']['prerequisites'],'monitors':p['monitors'],'properties':p['observable_properties']},indent=2))\nPY\"","aggregated_output":"        }\n        if len(c.network)>0 {\n            msg := c.network[0]\n            c.network = c.network[1:]\n            if msg.To<1 || msg.To>3 { c.t.Fatalf(\"unexpected recipient %d\",msg.To) }\n            assuranceEmit(map[string]interface{}{\"event\":\"message_dequeued\", \"request\":c.request, \"phase\":c.phase, \"from\":msg.From,\"to\":msg.To,\"type\":msg.Type.String(),\"index\":msg.Index,\"term\":msg.Term})\n            if (msg.Type==pb.MsgVoteResp || msg.Type==pb.MsgPreVoteResp) && msg.To==1 {\n                hs,_,err:=c.stores[msg.From-1].InitialState();if err!=nil {c.t.Fatal(err)}\n                if msg.Reject || (msg.Type==pb.MsgVoteResp && (hs.Term!=msg.Term || hs.Vote!=1)) {c.t.Fatal(\"grant lacks matching completed vote at capture\")}\n                c.heldVotes=append(c.heldVotes,msg)\n                assuranceEmit(map[string]interface{}{\"event\":\"grant_captured\",\"type\":msg.Type.String(),\"request\":c.request,\"from\":msg.From,\"term\":msg.Term,\"stored_term\":hs.Term,\"stored_vote\":hs.Vote})\n            } else {c.deliver(msg)}\n            work=true\n        }\n        if !work { return }\n    }\n    c.t.Fatal(\"schedule work bound exhausted\")\n}\n\n\nfunc (c *assuranceStorageCluster) deliver(msg pb.Message) {\n    if msg.Type==pb.MsgVoteResp && msg.To==1 && !msg.Reject && msg.Term==c.currentTerm {c.delivered[msg.From]=true}\n    assuranceEmit(map[string]interface{}{\"event\":\"actual_delivery\",\"request\":c.request,\"phase\":c.phase,\"from\":msg.From,\"to\":msg.To,\"type\":msg.Type.String(),\"term\":msg.Term})\n    if err:=c.nodes[msg.To-1].Step(msg);err!=nil {c.t.Fatal(err)}\n}\nfunc (c *assuranceStorageCluster) release(typ pb.MessageType,term,from uint64) {\n    for i,m:=range c.heldVotes {\n        if m.Type==typ && m.Term==term && m.From==from {\n            c.heldVotes=append(c.heldVotes[:i],c.heldVotes[i+1:]...)\n            c.deliver(m)\n            return\n        }\n    }\n    c.t.Fatalf(\"missing actual grant term=%d from=%d\",term,from)\n}\nfunc TestAssuranceDelayedPreVoteGrant(t *testing.T) {\n    c:=&assuranceStorageCluster{t:t,request:\"prevote-real-campaign-1\",phase:\"bootstrap\",delivered:map[uint64]bool{}}\n    all:=[3]bool{true,true,true}\n    peers:=[]Peer{{ID:1},{ID:2},{ID:3}}\n    for i:=0;i<3;i++ {\n        c.stores[i]=NewMemoryStorage()\n        n,err:=NewRawNode(&Config{ID:uint64(i+1),Storage:c.stores[i],ElectionTick:10,HeartbeatTick:1,MaxSizePerMsg:1<<20,MaxInflightMsgs:8,AsyncStorageWrites:true,PreVote:true,Logger:discardLogger})\n        if err!=nil {t.Fatal(err)}\n        c.nodes[i]=n\n        if err=n.Bootstrap(peers);err!=nil {t.Fatal(err)}\n    }\n    c.drain(all)\n    c.phase=\"pre_campaign\"\n    before:=c.nodes[0].BasicStatus().Term\n    if err:=c.nodes[0].Campaign();err!=nil {t.Fatal(err)}\n    c.drain(all)\n    if len(c.heldVotes)!=3 || c.nodes[0].BasicStatus().RaftState!=StatePreCandidate || c.nodes[0].BasicStatus().Term!=before {t.Fatal(\"pre-campaign prefix missing\")}\n    c.currentTerm=before+1\n    c.phase=\"pre_majority\"\n    c.release(pb.MsgPreVoteResp,c.currentTerm,1)\n    c.drain(all)\n    c.release(pb.MsgPreVoteResp,c.currentTerm,2)\n    c.drain(all)\n    if len(c.heldVotes)!=4 || c.nodes[0].BasicStatus().Term!=c.currentTerm || c.nodes[0].BasicStatus().RaftState!=StateCandidate {t.Fatal(\"real campaign prefix missing\")}\n    phases:=[]struct{name string;typ pb.MessageType;term,from uint64}{\n        {\"delayed_pre_vote\",pb.MsgPreVoteResp,c.currentTerm,3},\n        {\"real_self\",pb.MsgVoteResp,c.currentTerm,1},\n        {\"real_peer_2\",pb.MsgVoteResp,c.currentTerm,2},\n        {\"real_peer_3\",pb.MsgVoteResp,c.currentTerm,3},\n    }\n    for _,p:=range phases {\n        c.phase=p.name\n        assuranceEmit(map[string]interface{}{\"event\":\"vote_phase_admitted\",\"request\":c.request,\"phase\":p.name,\"node\":1,\"campaign_term\":c.currentTerm,\"prefix_ready\":true,\"released_type\":p.typ.String(),\"released_term\":p.term,\"released_sender\":p.from})\n        c.release(p.typ,p.term,p.from)\n        c.drain(all)\n        st:=c.nodes[0].BasicStatus()\n        assuranceEmit(map[string]interface{}{\"event\":\"election_observed\",\"request\":c.request,\"phase\":p.name,\"node\":1,\"campaign_term\":c.currentTerm,\"actual_term\":st.Term,\"role\":st.RaftState.String(),\"leader\":st.RaftState==StateLeader,\"current_grants\":len(c.delivered),\"current_majority\":len(c.delivered)>=2,\"senders\":c.delivered,\"held_grants\":len(c.heldVotes),\"schedule_complete\":true})\n    }\n    assuranceEmit(map[string]interface{}{\"event\":\"history_finished\",\"request\":c.request,\"campaign_term\":c.currentTerm,\"held_grants\":len(c.heldVotes)})\n}\n{\n  \"scope\": null,\n  \"prerequisites\": [\n    {\n      \"alias\": \"release_input\",\n      \"event\": \"vote_phase_admitted\",\n      \"conditions\": [\n        {\n          \"field\": \"prefix_ready\",\n          \"op\": \"eq\",\n          \"value\": true,\n          \"reference\": null\n        }\n      ]\n    }\n  ],\n  \"monitors\": [\n    {\n      \"id\": \"M_real_vote_type\",\n      \"checker_id\": \"real_vote_type\",\n      \"event\": \"election_observed\",\n      \"binding_ids\": [\n        \"BIND_real_vote_consumer\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S_candidate_follower\",\n          \"S_step\",\n          \"S_roles\",\n          \"S_tracker_votes\",\n          \"S_raw_entry\"\n        ],\n        \"expectation_ids\": [\n          \"S_majority\",\n          \"S_send\"\n        ],\n        \"binding_ids\": [\n          \"BIND_real_vote_consumer\"\n        ],\n        \"derivation\": \"Independent ledger admits only original delivered MsgVoteResp with the real campaign term. Original MsgPreVoteResp is delivered but never added even with matching term. Compare observed leadership from BasicStatus against two distinct real-grant senders. The implementation vote map is never read. Prerequisite and result identities remain request/phase/node/campaign_term; every fixed phase completes regardless of the predicate.\",\n        \"applicability\": \"Four release operations after actual pre-vote majority and real-candidate admission; no outcome-dependent filtering.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"A pending candidate after delayed pre-vote or one real grant is permitted.\",\n          \"Real self plus peer 2 provides a permitted current-real-majority control.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"release_input\"\n    }\n  ],\n  \"properties\": [\n    {\n      \"checker_id\": \"real_vote_type\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"election_observed\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"current_majority\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"leader\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"request\",\n        \"phase\",\n        \"node\",\n        \"campaign_term\"\n      ],\n      \"description\": \"Leadership at each fixed checkpoint requires at least two genuine delivered real vote grants; matching-term pre-vote grants do not contribute.\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
