uthority\"\n    ],\n    \"validity_context\": \"Established decisions survive ordinary role/term reset; history conflict checks protect committed entries on append paths.\",\n    \"representation\": [\n      \"raftLog.committed\",\n      \"Ready.HardState.Commit\",\n      \"MsgApp.Commit / MsgHeartbeat.Commit\"\n    ],\n    \"invalidators\": [],\n    \"reinterpreters\": [],\n    \"durability\": \"HardState and entries/snapshot must be persisted by the embedding storage path; committed may transiently exceed local stable extent.\",\n    \"recovery\": \"newLog seeds compacted prefix; loadState restores stored commit in range; snapshot restore can advance it.\",\n    \"source_ids\": [\n      \"S_log_append\",\n      \"S_log_decision\",\n      \"S_log_progress\",\n      \"S_load_read\",\n      \"S_replication_send\",\n      \"S_restore_config\",\n      \"S_log_apply\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"F_pending_read_support\",\n    \"meaning\": \"A pending readIndexStatus records the original request, commit index and a set of sender IDs that acknowledged its request context, including the locally added self acknowledgment. The stored set alone is not a completed authority confirmation: the heartbeat-response consumer applies current voter quorum rules, and a later acknowledged request may release an earlier queue prefix.\",\n    \"identity\": {\n      \"owner\": \"local raft instance and its current readOnly object\",\n      \"request\": \"string(req.Entries[0].Data) used as pendingReadIndex key\",\n      \"supporter\": \"sender ID in readIndexStatus.acks\"\n    },\n    \"established_by\": [\n      \"B_read_authority\"\n    ],\n    \"consumed_by\": [\n      \"B_read_authority\"\n    ],\n    \"validity_context\": \"ReadOnlySafe after the current-term-commit admission barrier, except singleton fast path which bypasses this structure. Context must identify the caller request under the captured ReadIndex API. Joint/non-joint voter eligibility is evaluated at consumption, not captured in the status.\",\n    \"representation\": [\n      \"readOnly.pendingReadIndex[context] -> readIndexStatus{req,index,acks}\",\n      \"readOnly.readIndexQueue\"\n    ],\n    \"invalidators\": [\n      \"B_role_reset\"\n    ],\n    \"reinterpreters\": [\n      \"B_configuration\"\n    ],\n    \"durability\": \"Volatile request and acknowledgment bookkeeping, not a persisted vote/log entry and not completed client application.\",\n    \"recovery\": \"newReadOnly creates an empty map; reset replaces the object, while pre-admission pendingReadIndexMessages is a separate queue.\",\n    \"source_ids\": [\n      \"S_read_tracking\",\n      \"S_leader_other\",\n      \"S_pending_reads\",\n      \"S_reset_append\",\n      \"S_restore_config\",\n      \"S_read_api\"\n    ],\n    \"unknowns\": [\n      \"A legal same-history joint transition with retained pending support is not yet executed.\"\n    ]\n  }\n]\n[\n  {\n    \"id\": \"B_append_response_packaging\",\n    \"primary_activity\": \"A6\",\n    \"execution_owner\": \"RawNode.readyWithoutAccept and newStorageAppendMsg/newStorageAppendRespMsg, serialized by the RawNode caller\",\n    \"protocol_context\": \"AsyncStorageWrites enabled; Ready includes outstanding or in-progress unstable entries, hard-state updates, snapshots, or responses waiting for append completion.\",\n    \"trigger\": \"Ready generation creates local append work and attached response messages.\",\n    \"legal_preconditions\": [\n      \"Config requires reliable in-order processing per local target and durable append writes before responses; different append/apply targets may run independently.\"\n    ],\n    \"implementation_guards\": [],\n    \"reads\": [\n      \"raft.msgsAfterAppend\",\n      \"raft.Term\",\n      \"raftLog.lastEntryID and hasNextOrInProgressUnstableEnts\",\n      \"Ready HardState, Entries and Snapshot\"\n    ],\n    \"writes\": [\n      \"MsgStorageAppend.Responses with deferred protocol replies and a local MsgStorageAppendResp\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [\n      \"The embedding application must process local append work before delivering its attached responses; creation of the message itself does not perform storage IO.\",\n      \"The in-repository rafttest implementation queues local targets separately, processes the head of AppendWork, performs processAppend and then exposes attached responses. Its MemoryStorage is not disk durability evidence.\"\n    ],\n    \"produces_fact_ids\": [\n      \"F_append_completion_descriptor\"\n    ],\n    \"consumes_fact_ids\": [],\n    \"cross_activity_effects\": {\n      \"A1\": \"Wraps MsgAppResp, including leader self-acknowledgments, behind the append completion boundary.\",\n      \"A2\": \"Wraps vote/pre-vote responses behind append completion and records the current term in the local stabilization response.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_raw_entry\",\n      \"S_append_messages\",\n      \"S_send\",\n      \"S_async_contract\",\n      \"S_test_ready\",\n      \"S_test_append\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_step_context_and_storage\",\n    \"primary_activity\": \"A2\",\n    \"execution_owner\": \"raft.Step called by RawNode.Step or internal methods; RawNode requires caller serialization\",\n    \"protocol_context\": \"Message term relative to current raft.Term; local storage responses enter the same term dispatch.\",\n    \"trigger\": \"Incoming protocol or local completion message.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"RawNode.Step rejects unexpected local message senders and responses from unknown nonlocal peers.\",\n      \"Step handles higher-term messages before per-state dispatch, except pre-vote and active-lease exceptions.\",\n      \"Lower-term MsgStorageAppendResp never calls stableTo for