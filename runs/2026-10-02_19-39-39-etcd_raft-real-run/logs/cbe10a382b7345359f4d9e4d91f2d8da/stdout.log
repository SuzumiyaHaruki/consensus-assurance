{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat build_read_candidate.py'","aggregated_output":"import json\nm=json.load(open('../audit-spec/v2.json'))\nsources=[dict(id='S_read_api',file='node.go',start_line=218,end_line=229,kind='interface_statement'),dict(id='S_raw_read_api',file='rawnode.go',start_line=556,end_line=563,kind='interface_statement'),dict(id='S_heartbeat_broadcast',file='raft.go',start_line=710,end_line=738,kind='code_observation'),dict(id='S_joint_selection',file='raftpb/confchange.go',start_line=77,end_line=112,kind='code_observation'),dict(id='S_tracker_config',file='tracker/tracker.go',start_line=26,end_line=78,kind='code_observation'),dict(id='S_read_learner_test',file='raft_test.go',start_line=1952,end_line=1993,kind='test_expectation')]\nfor b in m['behaviors']:\n if b['id']=='B_read_authority':\n  b['produces_fact_ids']=['F_pending_read_support'];b['consumes_fact_ids']=list(set(b.get('consumes_fact_ids',[])+['F_pending_read_support']))\n  b['source_ids']+=['S_read_api','S_raw_read_api','S_heartbeat_broadcast']\n  b['reads']=['readOnly.pendingReadIndex[request context] acknowledgment map','Current r.trk.Voters rather than a configuration saved with readIndexStatus']\n  b['writes']+=['readIndexStatus stores original commit index, request and per-sender acknowledgments without a voter-configuration snapshot. Heartbeat response processing uses current Voters.VoteResult on the stored set before releasing the queue prefix.']\n  b['unknowns']=['Client-visible safety of combining prior acknowledgments with later configurations has not been established by an endpoint witness.','Multiple pending requests may be released by a later request context; that batching case is outside the selected single-request question.']\n if b['id']=='B_configuration':\n  b['source_ids']+=['S_joint_selection']\n  b['writes']+=['switchToConfig replaces tracker Config and Progress but does not replace readOnly or clear its pending acknowledgments. Their later eligibility is determined by the new voter sets.']\n  b['cross_activity_effects']['A2']+=' Pending read acknowledgments are subsequently evaluated against the updated voter sets without a request-time configuration snapshot.'\nm['facts'].append(dict(id='F_pending_read_support',meaning='A pending readIndexStatus records the original request, commit index and a set of sender IDs that acknowledged its request context, including the locally added self acknowledgment. The stored set alone is not a completed authority confirmation: the heartbeat-response consumer applies current voter quorum rules, and a later acknowledged request may release an earlier queue prefix.',identity={'owner':'local raft instance and its current readOnly object','request':'string(req.Entries[0].Data) used as pendingReadIndex key','supporter':'sender ID in readIndexStatus.acks'},validity_context='ReadOnlySafe after the current-term-commit admission barrier, except singleton fast path which bypasses this structure. Context must identify the caller request under the captured ReadIndex API. Joint/non-joint voter eligibility is evaluated at consumption, not captured in the status.',representation=['readOnly.pendingReadIndex[context] -> readIndexStatus{req,index,acks}','readOnly.readIndexQueue'],invalidators=['B_role_reset'],reinterpreters=['B_configuration'],durability='Volatile request and acknowledgment bookkeeping, not a persisted vote/log entry and not completed client application.',recovery='newReadOnly creates an empty map; reset replaces the object, while pre-admission pendingReadIndexMessages is a separate queue.',source_ids=['S_read_tracking','S_leader_other','S_pending_reads','S_reset_append','S_restore_config','S_read_api'],unknowns=['A legal same-history joint transition with retained pending support is not yet executed.']))\nfor f in m['facts']:f.pop('established_by',None);f.pop('consumed_by',None)\nfor a in m['activities']:a.pop('behavior_ids',None)\n# Retain the wider surface after mapping this narrow relationship.\nfor s in m['surfaces']:\n if s['entry_point']=='raft.stepLeader MsgReadIndex and MsgHeartbeatResp':\n  s['reason']='Mapped context-keyed pending support and current-configuration consumption. A single-request joint transition is selected; batching, configuration-history linearizability and client read endpoints remain separate.'\n  s['source_ids']+=['S_read_api','S_raw_read_api']\nchange=dict(impact='dependency',rationale='Add the explicit stored read-support Fact and its producer/consumer and configuration reinterpretation paths already observed in readOnly, heartbeat response handling and switchToConfig.',source_ids=['S_read_tracking','S_leader_other','S_restore_config','S_read_api'],preserves='C_append_completed_quorum and its artifact depend on append acknowledgment support under fixed membership. This read-context addition does not change that principal Fact, claim, driver, oracle or observations. The new read support Fact is distinct from durable append support.')\nchanges={'B_read_authority':change,'B_configuration':change,'surface:raft.stepLeader MsgReadIndex and MsgHeartbeatResp':dict(impact='clarification',rationale='Retain remaining variants while recording the now-mapped single-request joint-voter discriminator.',source_ids=['S_read_tracking','S_leader_other','S_restore_config'],preserves='The prior quorum obligation and all fixed artifacts retain their original scope and basis.')}\njson.dump(m,open('read-support-map.json','w'),indent=2)\nq=dict(question='For one unique outstanding ReadOnlySafe request retained while an explicit joint configuration is applied, can acknowledgments forming only an outgoing majority release a ReadState before an incoming majority also supports that context?',importance='If removed voters alone can authorize a read after the joint configuration is active, the library could hand out read authority without the configured overlap protection. The immediate duty is qualified ReadState release; client-visible stale reads require additional history and application observations not supplied by this question.',source_ids=['S_options','S_joint','S_leader_other','S_read_tracking','S_restore_config','S_read_api','S_raw_read_api','S_joint_selection'],participants=['Leader, outgoing voters and retained incoming voters','Application applying a committed explicit-joint configuration entry'],objects=['Single unique ReadIndex context','Pending acknowledgment sender set','Current incoming/outgoing voter sets','Ready.ReadStates'],contexts=['ReadOnlySafe; unique nonempty request context used once','Leader has committed a current-term entry before request','Explicit joint transition removes two voters from an initial five-voter configuration; leader remains a voter','No role or term change between request and observed release'],event_paths=['RawNode.ReadIndex -> sendMsgReadIndexResponse -> addRequest/self ack -> actual heartbeat responses held by scheduler','ProposeConfChange -> replicated/committed entry -> application ApplyConfChange -> switchToConfig','Release actual delayed heartbeat responses -> recvAck -> current JointConfig.VoteResult -> readOnly.advance -> Ready.ReadStates'],activity_classes=['A2','A1','A4','A7'],behavior_ids=['B_read_authority','B_configuration','B_role_reset'],fact_ids=['F_pending_read_support'],supporting_behavior_ids={'B_propose_replicate':'Produces the joint-configuration entry through legal proposal and replication.','B_aggregate_commit':'Establishes commitment of the configuration before application.','B_ready_application':'Serializes actual configuration application and captures public Ready output.','B_elect_transfer':'Establishes the initial authority and current-term commit prefix.'},obligation_relation_kind='consumption',counterevidence=['The heartbeat consumer explicitly invokes current r.trk.Voters.VoteResult, whose JointConfig implementation requires both majority configurations.','switchToConfig does not clear the pending acknowledgment set, so preservation does not itself imply a defect.','A later context can release earlier queued requests; restricting this question to a single request is necessary to avoid an unsupported per-request majority assertion.'],unknowns=['Execute the same history from election through a pending read and committed explicit-joint transition, with actual delayed producer responses.','Confirm the public ReadState output remains absent after outgoing-only support, and observe a permitted completion after both sets have majority support.','Normative attribution should remain local quorum eligibility, not a conclusion about all linearizable read histories.'],disposition='needs_specific_evidence',preferred_check='controlled_schedule',trigger_rationale='The current-configuration consumer and retained context-keyed support give a concrete distinction between an old-only majority and both joint majorities. Five initial voters transitioning to incoming {1,4,5} and outgoing {1,2,3,4,5} permits actual delayed replies from 2 and 3 to form only the outgoing majority with leader 1; reply 4 then supplies the incoming majority. This avoids fabricated membership state and needs no new process or snapshot bootstrap.')\ns=dict(action='continue',rationale='Select an independent read-authority eligibility question from the retained configuration surface, preserving the completed append-quorum artifact.',sources=sources,map_path='read-support-map.json',map_changes=changes,question=q,feedback=dict(ref_ids=['S_read_api','S_raw_read_api','S_read_tracking','S_leader_other','S_restore_config','S_joint_selection','S_joint','S_read_learner_test'],answered='The read consumer uses the current voter sets against a context-keyed acknowledgment map that contains no configuration snapshot. switchToConfig retains that map. The API requires request-context correlation and allows unnoticed request loss; the captured learner test checks basic index/context return but does not establish the joint-transition history. A single-request scope avoids read queue batching as an alternative release mechanism.',remaining=['Construct and execute the retained-response joint transition through RawNode and committed configuration application.','Multiple request batching and a client-visible stale-read endpoint remain independent questions.'],understanding='updated',rationale='The reviewed append-quorum comparison has no remaining blocker and does not settle read authority. The next informative relation is whether actual old-context replies are qualified by both active joint voter sets, with an independent delivered-reply ledger and public Ready.ReadStates observation.'))\njson.dump(s,open('submission-read-candidate.json','w'),indent=2)\n","exit_code":0,"status":"completed"}}
