  \"protocol_context\": \"Follower, candidate, pre-candidate and leader state transitions.\",\n    \"trigger\": \"becomeFollower, becomeCandidate, becomePreCandidate or becomeLeader.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [],\n    \"reads\": [],\n    \"writes\": [\n      \"reset changes Term and clears Vote only on term change; clears leader, transfer, votes, pendingConfIndex, readOnly and uncommittedSize.\",\n      \"reset reconstructs progress with remote Match zero and local Match at lastIndex.\",\n      \"becomeCandidate increments term and records self vote.\",\n      \"becomePreCandidate resets votes without increasing term or changing Vote.\",\n      \"becomeLeader enters replicate mode for itself and appends an empty entry, whose self-ack is deferred by send.\",\n      \"pendingReadIndexMessages is not cleared by reset; releasePendingReadIndexMessages drains it only after a current-term commit and re-enters the configured read protocol.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_matched_support\"\n    ],\n    \"consumes_fact_ids\": [],\n    \"cross_activity_effects\": {\n      \"A1\": \"Rebuilds replication support for a new role and appends a current-term empty entry on leadership acquisition.\",\n      \"A6\": \"appendEntry queues its self-ack in msgsAfterAppend rather than immediately advancing local replication progress.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_reset_append\",\n      \"S_roles\",\n      \"S_send\",\n      \"S_campaign\",\n      \"S_candidate_follower\",\n      \"S_pending_reads\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_propose_replicate\",\n    \"primary_activity\": \"A1\",\n    \"execution_owner\": \"raft.stepLeader / stepFollower and appendEntry\",\n    \"protocol_context\": \"Current role and term, applied voter configuration, current log and replication progress.\",\n    \"trigger\": \"RawNode.Propose or Node.Propose dispatches MsgProp; network append replication follows.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"Leader drops proposals when removed, transferring leadership, or exceeding uncommitted payload quota.\",\n      \"Configuration proposals may be replaced by empty normal entries when another configuration is unapplied or the joint transition is invalid, unless validation is disabled.\",\n      \"Followers forward only with a known leader and forwarding enabled; candidates drop proposals.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"appendEntry assigns current term/consecutive indexes and appends unstable entries.\",\n      \"Queues leader self MsgAppResp behind storage; broadcasts MsgApp with predecessor index/term and commit.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [\n      \"Heartbeat commit is capped at min(peer Match, leader committed).\",\n      \"Missing predecessor or unavailable entries cause snapshot fallback when the peer is recently active.\"\n    ],\n    \"important_branches\": [],\n    \"async_boundaries\": [\n      \"A successful proposal return is not a commit or client application acknowledgment.\"\n    ],\n    \"produces_fact_ids\": [],\n    \"consumes_fact_ids\": [\n      \"F_matched_support\"\n    ],\n    \"cross_activity_effects\": {\n      \"A6\": \"Local self support is deferred through msgsAfterAppend.\",\n      \"A7\": \"Submission errors and dropped proposals require caller retry; client request deduplication is outside this core.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_raw_entry\",\n      \"S_node_loop\",\n      \"S_node_wait\",\n      \"S_leader_admit\",\n      \"S_candidate_follower\",\n      \"S_reset_append\",\n      \"S_send\",\n      \"S_replication_send\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_follower_accept\",\n    \"primary_activity\": \"A1\",\n    \"execution_owner\": \"raft.stepFollower/stepCandidate -> handleAppendEntries -> raftLog.maybeAppend\",\n    \"protocol_context\": \"Term checks already performed by Step; leader-provided contiguous entries and predecessor identity.\",\n    \"trigger\": \"MsgApp received by follower or candidate.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"A predecessor below committed returns existing committed index.\",\n      \"Otherwise predecessor term must match; conflicts at or below committed panic, conflicting uncommitted suffix is replaced.\",\n      \"Commit advances only to min(leader commit, last index covered by this append).\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"Log suffix and committed index; deferred MsgAppResp acknowledging accepted extent or rejection with conflict hint.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_committed_prefix\"\n    ],\n    \"consumes_fact_ids\": [],\n    \"cross_activity_effects\": {\n      \"A6\": \"Accepted/rejected append responses are placed behind the storage boundary by send.\",\n      \"A2\": \"Candidate adopts a current-term leader before processing its append.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_candidate_follower\",\n      \"S_follower_log\",\n      \"S_log_append\",\n      \"S_log_decision\",\n      \"S_send\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_aggregate_commit\",\n    \"primary_activity\": \"A1\",\n    \"execution_owner\": \"raft.stepLeader, ProgressTracker, quorum configurations and raftLog.maybeCommit\",\n    \"protocol_context\": \"Leader term and active incoming/outgoing voter sets.\",\n    \"trigger\": \"MsgAppResp after Step term filtering, or configuration application calls maybeCommit.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"Unknown peer has no progress and is ignored.\",\n      \"Positive MaybeUpdate only raises Match; rejects never raise Match and stale rejections do not lower Next.\",\n      \"Only voter IDs feed majority CommittedIndex; joint result is the smaller of the two majority indexes.\",\n      \"maybeCommit requires nonzero current term matching the local entry at the quorum index, and index greater than committed.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"Updates peer Match and replication mode/inflight bookkeeping.\",\n      \"Advances committed index, releases pending reads and broadcasts updated commit when possible.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_matched_support\",\n      \"F_committed_prefix\"\n    ],\n    \"consumes_fact_ids\": [\n      \"F_matched_support\"\n    ],\n    \"cross_activity_effects\": {\n      \"A2\": \"Transfer sends TimeoutNow only once transferee Match reaches lastIndex.\",\n      \"A3\": \"Conflict hints and probing recover replication; exact divergent-tail optimization variants remain open.\"\n    },\n    \"existing_protections\": [\n      \"New appends do not immediately increase leader Match; its own MsgAppResp is delayed by appendEntry/send.\",\n      \"Both majorities are required in joint state; learners do not add commit support.\"\n    ],\n    \"source_ids\": [\n      \"S_leader_ack\",\n      \"S_leader_admit\",\n      \"S_progress_update\",\n      \"S_tracker_commit\",\n      \"S_joint\",\n      \"S_majority\",\n      \"S_reset_append\",\n      \"S_log_decision\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_elect_transfer\",\n    \"primary_activity\": \"A2\",\n    \"execution_owner\": \"raft.hup/campaign/stepCandidate/tickElection/tickHeartbeat and tracker vote tally\",\n    \"protocol_context\": \"Role, current term, configured voter sets and pending committed configuration/snapshot work.\",\n    \"trigger\": \"Campaign/timeout, vote response, CheckQuorum or leadership transfer.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"promotable requires own progress, nonlearner status and no pending/in-progress snapshot.\",\n      \"hup refuses an election when committed unapplied configuration entries are found.\",\n      \"Campaign targets voter union and delays its self-vote response behind append completion.\",\n      \"Only the matching pre-vote or vote response type is counted; each ID records only its first vote.\",\n      \"Quorum vote result uses active voter configuration, including both joint majorities.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"Pre-vote win starts real campaign; real vote win installs leader; vote loss returns follower.\",\n      \"CheckQuorum can step down at same term; new election raises term.\",\n      \"Transfer to learner/self is ignored, otherwise proposals pause and catch-up precedes TimeoutNow; timeout aborts transfer.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [],\n    \"consumes_fact_ids\": [\n      \"F_matched_support\",\n      \"F_committed_prefix\"\n    ],\n    \"cross_activity_effects\": {\n      \"A1\": \"Authority acquisition installs the role reset and new current-term empty append.\",\n      \"A4\": \"Eligibility and blocking on unapplied configuration constrain which context may form the next quorum.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_campaign\",\n      \"S_candidate_follower\",\n      \"S_ticks\",\n      \"S_tracker_votes\",\n      \"S_tracker_active\",\n      \"S_joint\",\n      \"S_majority\",\n      \"S_restore_config\",\n      \"S_leader_other\",\n      \"S_leader_admit\",\n      \"S_roles\",\n      \"S_step\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_configuration\",\n    \"primary_activity\": \"A4\",\n    \"execution_owner\": \"RawNode.ApplyConfChange / node.run -> raft.applyConfChange -> confchange.Changer -> switchToConfig\",\n    \"protocol_context\": \"Application invokes change for committed configuration entry or rejects it per API; active configuration can lag committed log.\",\n    \"trigger\": \"Committed configuration entry applied or ConfState restored.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"Simple changes reject joint state, empty resulting voters, or more than one voter symmetric difference.\",\n      \"EnterJoint preserves old voters as outgoing; LeaveJoint removes outgoing-only progress and completes staged learners.\",\n      \"LearnersNext preserves outgoing voter role until leaving joint state.\",\n      \"Proposal validation is best-effort; disabling it requires caller serialization and verification.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"Replaces tracker Config/Progress with checked copies; existing progress retained for surviving members and new progress begins Match zero.\",\n      \"Leader removal/demotion optionally steps down; membership change recomputes commit or probes peers; removed transferee aborts transfer.\",\n      \"AutoLeave is proposed after application progress crosses pendingConfIndex when leader.\",\n      \"switchToConfig replaces tracker Config and Progress but does not replace readOnly or clear its pending acknowledgments. Their later eligibility is determined by the new voter sets.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_matched_support\"\n    ],\n    \"consumes_fact_ids\": [\n      \"F_matched_support\",\n      \"F_committed_prefix\"\n    ],\n    \"cross_activity_effects\": {\n      \"A1\": \"Changes which Match values contribute to quorum and can immediately advance commitment.\",\n      \"A2\": \"Alters campaign/transfer eligibility and optional leader step-down. Pending read acknowledgments are subsequently evaluated against the updated voter sets without a request-time configuration snapshot.\",\n      \"A6\": \"Returned ConfState must be retained in snapshots.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_ready_contract\",\n      \"S_restore_config\",\n      \"S_change\",\n      \"S_change_members\",\n      \"S_config_restore\",\n      \"S_apply_progress\",\n      \"S_options\",\n      \"S_joint_selection\"\n    ],\n    \"unknowns\": [\n      \"Disabling proposal validation and application-level rejection policy are separate variants not selected for the first check.\"\n    ]\n  },\n  {\n    \"id\": \"B_recovery\",\n    \"primary_activity\": \"A3\",\n    \"execution_owner\": \"newRaft, raft.restore and confchange.Restore\",\n    \"protocol_context\": \"Restart from Storage or follower receives newer snapshot.\",\n    \"trigger\": \"Construction/restart or MsgSnap.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"loadState requires stored commit in available log range.\",\n      \"Snapshot at/below committed is ignored; restore requires follower role and recipient present in snapshot configuration.\",\n      \"Matching snapshot index/term advances commit without replacing log/config; otherwise snapshot replaces unstable log and restores ConfState.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"Restart reconstructs configuration, term/vote/commit and optional caller Applied before follower reset.\",\n      \"Snapshot installs committed index and pending unstable snapshot; rebuilding progress uses configuration reconstruction.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_matched_support\",\n      \"F_committed_prefix\"\n    ],\n    \"consumes_fact_ids\": [],\n    \"cross_activity_effects\": {\n      \"A2\": \"Pending snapshot blocks promotability until completion; restart begins follower with reconstructed term and vote.\",\n      \"A5\": \"Pending snapshot blocks committed entry delivery until cleared.\",\n      \"A6\": \"Stable Storage supplies reconstruction; storage corruption and cleanup are caller boundaries.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_restart\",\n      \"S_load_read\",\n      \"S_restore_config\",\n      \"S_config_restore\",\n      \"S_log_append\",\n      \"S_log_decision\",\n      \"S_log_snapshot\",\n      \"S_unstable_replace\",\n      \"S_follower_log\",\n      \"S_storage_contract\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_ready_application\",\n    \"primary_activity\": \"A5\",\n    \"execution_owner\": \"RawNode Ready acceptance/Advance, raftLog application selection and raft.appliedTo\",\n    \"protocol_context\": \"Committed prefix, local stability and application quota; synchronous or asynchronous API mode.\",\n    \"trigger\": \"Ready emitted and accepted, then Advance or storage response.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"nextCommittedEnts blocks with a pending snapshot or exhausted applying quota.\",\n      \"Async mode caps delivery at min(committed, unstable.offset-1); synchronous mode may include committed unstable entries under Ready caller sequencing.\",\n      \"Advance panics in async mode; otherwise steps queued self-acks and completion messages.\"\n    ],\n    \"reads\": [],\n    \"writes\": [\n      \"acceptReady marks unstable/applying work in progress and clears output queues.\",\n      \"Application completion moves applied forward and releases byte quota; already committed entries survive term change through zero-term responses.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [],\n    \"consumes_fact_ids\": [\n      \"F_committed_prefix\"\n    ],\n    \"cross_activity_effects\": {\n      \"A6\": \"Ready acceptance is not durable completion; async apply scheduling waits for local stable offset.\",\n      \"A4\": \"Application progress may trigger leaving joint configuration.\",\n      \"A7\": \"Application must correlate its own client completion with commands, not proposal return.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_ready_advance\",\n      \"S_log_apply\",\n      \"S_log_progress\",\n      \"S_apply_progress\",\n      \"S_append_messages\",\n      \"S_async_contract\",\n      \"S_node_loop\"\n    ],\n    \"unknowns\": []\n  },\n  {\n    \"id\": \"B_read_authority\",\n    \"primary_activity\": \"A2\",\n    \"execution_owner\": \"raft.stepLeader/stepFollower, readOnly and ReadState output\",\n    \"protocol_context\": \"ReadOnlySafe uses request-context keyed pending acknowledgments; lease mode requires CheckQuorum and clock assumptions.\",\n    \"trigger\": \"ReadIndex input, heartbeat acknowledgment, current-term commit or role reset.\",\n    \"legal_preconditions\": [],\n    \"implementation_guards\": [\n      \"Non-singleton leader buffers reads until a current-term entry is committed.\",\n      \"ReadOnlySafe records local ack and broadcasts request context; current voter quorum of heartbeat acks releases requests through that context.\",\n      \"Unknown request context yields no stored ack set; callers must distinguish request contexts.\",\n      \"Lease mode returns current commit directly; ForgetLeader is disabled in that mode.\"\n    ],\n    \"reads\": [\n      \"readOnly.pendingReadIndex[request context] acknowledgment map\",\n      \"Current r.trk.Voters rather than a configuration saved with readIndexStatus\"\n    ],\n    \"writes\": [\n      \"Returns local ReadStates or forwarded MsgReadIndexResp with request context.\",\n      \"reset replaces readOnly acknowledgments; pendingReadIndexMessages survive and are reprocessed only after later current-term commitment.\",\n      \"readIndexStatus stores original commit index, request and per-sender acknowledgments without a voter-configuration snapshot. Heartbeat response processing uses current Voters.VoteResult on the stored set before releasing the queue prefix.\"\n    ],\n    \"durable_effects\": [],\n    \"external_effects\": [],\n    \"important_branches\": [],\n    \"async_boundaries\": [],\n    \"produces_fact_ids\": [\n      \"F_pending_read_support\"\n    ],\n    \"consumes_fact_ids\": [\n      \"F_committed_prefix\",\n      \"F_pending_read_support\"\n    ],\n    \"cross_activity_effects\": {\n      \"A7\": \"ReadState is an index/context handoff; caller must wait for sufficient applied progress before serving the read.\"\n    },\n    \"existing_protections\": [],\n    \"source_ids\": [\n      \"S_leader_admit\",\n      \"S_leader_other\",\n      \"S_pending_reads\",\n      \"S_load_read\",\n      \"S_read_tracking\",\n      \"S_options\",\n      \"S_candidate_follower\",\n      \"S_reset_append\",\n      \"S_read_api\",\n      \"S_raw_read_api\",\n      \"S_heartbeat_broadcast\"\n    ],\n    \"unknowns\": [\n      \"Client-visible safety of combining prior acknowledgments with later configurations has not been established by an endpoint witness.\",\n      \"Multiple pending requests may be released by a later request context; that batching case is outside the selected single-request question.\"\n    ]\n  }\n]\n","exit_code":0,"status":"completed"}}
