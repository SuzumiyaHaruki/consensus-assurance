{
  "$defs": {
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        }
      },
      "required": [
        "field",
        "op",
        "value",
        "reference"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "DirectCheckPlan": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Binding Ids",
          "type": "array"
        },
        "harness": {
          "$ref": "#/$defs/Harness"
        },
        "monitors": {
          "items": {
            "$ref": "#/$defs/EventMonitor"
          },
          "minItems": 1,
          "title": "Monitors",
          "type": "array"
        },
        "observable_properties": {
          "description": "Direct route supports event_assertion only. Assertions may compare an observed field with a prior correlated prerequisite field; history properties require a local_model fallback.",
          "items": {
            "$ref": "#/$defs/ObservableProperty"
          },
          "minItems": 1,
          "title": "Observable Properties",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "description",
        "claim_id",
        "binding_ids",
        "harness",
        "monitors",
        "observable_properties",
        "uncertainties"
      ],
      "title": "DirectCheckPlan",
      "type": "object"
    },
    "EncodingRevision": {
      "additionalProperties": false,
      "properties": {
        "old_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old Model Id"
        },
        "old_direct_check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old Direct Check Id"
        },
        "issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Issue Id"
        },
        "input_changes": {
          "items": {
            "type": "string"
          },
          "title": "Input Changes",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "old_model_id",
        "old_direct_check_id",
        "issue_id",
        "input_changes",
        "source_ids",
        "rationale"
      ],
      "title": "EncodingRevision",
      "type": "object"
    },
    "EventMonitor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "checker_id": {
          "title": "Checker Id",
          "type": "string"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/Grounding"
        },
        "applicability_conditions": {
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "title": "Applicability Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "checker_id",
        "event",
        "binding_ids",
        "grounding",
        "applicability_conditions"
      ],
      "title": "EventMonitor",
      "type": "object"
    },
    "EventRequirement": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "conditions": {
          "description": "Prerequisite conditions; alias references declare causal predecessors, list position does not",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "alias",
        "event",
        "conditions"
      ],
      "title": "EventRequirement",
      "type": "object"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "description": "Exact IDs of acquired implementation source materials; not Behavior or Binding IDs",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "expectation_ids": {
          "description": "Exact IDs of acquired materials supporting the expectation; not invented expectation labels. Explain normative applicability in derivation.",
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "binding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Binding Ids",
          "type": "array"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "title": "Grounding",
      "type": "object",
      "required": [
        "source_ids",
        "expectation_ids",
        "binding_ids",
        "derivation",
        "applicability",
        "unresolved",
        "conflicts",
        "alternatives"
      ]
    },
    "Harness": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Harness kind advertised by the configured execution backend",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "description": "Executable experiment source, calling actual target code; no fabricated expected observations",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "semantic_changes": {
          "description": "Instrumentation and adaptation differences; never alter protocol logic to create a real finding",
          "items": {
            "type": "string"
          },
          "title": "Semantic Changes",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/EventRequirement"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "legality": {
          "$ref": "#/$defs/Grounding"
        }
      },
      "required": [
        "kind",
        "source",
        "description",
        "semantic_changes",
        "prerequisites",
        "legality"
      ],
      "title": "Harness",
      "type": "object"
    },
    "ObservableProperty": {
      "additionalProperties": false,
      "properties": {
        "checker_id": {
          "title": "Checker Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event_assertion",
            "stable_support"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/Comparison"
        },
        "assertion": {
          "$ref": "#/$defs/Comparison"
        },
        "identity_fields": {
          "description": "Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change",
          "items": {
            "type": "string"
          },
          "title": "Identity Fields",
          "type": "array"
        },
        "history_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "History Field"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "checker_id",
        "kind",
        "trigger",
        "assertion",
        "identity_fields",
        "history_field",
        "description"
      ],
      "title": "ObservableProperty",
      "type": "object"
    },
    "ReadRequest": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Line"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol"
        },
        "literal": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Literal"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "symbol",
        "literal",
        "reason"
      ],
      "title": "ReadRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reading_purpose": {
      "enum": [
        "dependency",
        "context"
      ],
      "title": "Reading Purpose",
      "type": "string"
    },
    "encoding_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/EncodingRevision"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/DirectCheckPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "gap": {
      "title": "Gap",
      "type": "string"
    },
    "partial_design": {
      "title": "Partial Design",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/ReadRequest"
      },
      "title": "Requests",
      "type": "array"
    },
    "fallback": {
      "enum": [
        "none",
        "source_review",
        "local_model"
      ],
      "title": "Fallback",
      "type": "string"
    }
  },
  "required": [
    "reading_purpose",
    "encoding_revision",
    "plan",
    "gap",
    "partial_design",
    "requests",
    "fallback"
  ],
  "title": "DirectCheckReply",
  "type": "object"
}