leObserverSnapshot(m pb.Message) {\n  1871\t\tr.handleFollowerInstallSnapshot(m)\n  1872\t}\n  1873\t\n  1874\tfunc (r *raft) handleObserverPropose(m pb.Message) {\n  1875\t\tr.handleFollowerPropose(m)\n  1876\t}\n  1877\t\n  1878\tfunc (r *raft) handleObserverReadIndex(m pb.Message) {\n  1879\t\tr.handleFollowerReadIndex(m)\n  1880\t}\n  1881\t\n  1882\tfunc (r *raft) handleObserverReadIndexResp(m pb.Message) {\n  1883\t\tr.handleFollowerReadIndexResp(m)\n  1884\t}\n  1885\t\n  1886\t//\n  1887\t// message handlers used by witness, re-route them to follower handlers\n  1888\t//\n  1936\tfunc (r *raft) handleFollowerReadIndex(m pb.Message) {\n  1937\t\tif r.leaderID == NoLeader {\n  1938\t\t\tplog.Warningf(\"%s dropped ReadIndex, no leader\", r.describe())\n  1939\t\t\tr.reportDroppedReadIndex(m)\n  1940\t\t\treturn\n  1941\t\t}\n  1942\t\tm.To = r.leaderID\n  1943\t\tr.send(m)\n  1944\t}\n  1945\t\n","exit_code":0,"status":"completed"}}
