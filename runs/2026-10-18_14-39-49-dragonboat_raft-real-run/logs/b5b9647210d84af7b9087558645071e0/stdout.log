":\\\"completed_after_reply\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1,\\\"reference\\\":None},\n  \\\"antecedent\\\":None,\n  \\\"applicability_conditions\\\":[{\\\"field\\\":\\\"original_batch_exists\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True,\\\"reference\\\":None},\n                              {\\\"field\\\":\\\"applied_index\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":4,\\\"reference\\\":None}],\n  \\\"description\\\":\\\"The middle queued read must also complete after the same confirmed index is applied.\\\"},\n {\\\"event\\\":\\\"read_c_completion\\\",\\\"identity_fields\\\":[\\\"request_id\\\"],\\\"admission_alias\\\":\\\"read_c\\\",\n  \\\"assertion\\\":{\\\"field\\\":\\\"completed_after_reply\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":1,\\\"reference\\\":None},\n  \\\"antecedent\\\":None,\n  \\\"applicability_conditions\\\":[{\\\"field\\\":\\\"applied_index\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":4,\\\"reference\\\":None}],\n  \\\"description\\\":\\\"The newest queued read, whose context confirmed the batch, must complete.\\\"},\n]\ne['scope']['assumptions']=[\n \\\"The voter group is three real in-process Raft Peer handlers with bootstrap membership {1,2,3}; node 1 is leader and each node uses a test-only in-memory ILogDB.\\\",\n \\\"All three reads are registered through the node-level pendingReadIndex and forwarded through the real follower path, in the order read-A from node 2, read-B from node 3 and read-C from node 2.\\\",\n \\\"The only scheduling input is one leader tick, and the harness delivers only the heartbeat addressed to node 3; it does not choose which read is confirmed.\\\",\n \\\"Each requester's reply and completion state is emitted as its own event, so a comparison is correlated only to that requester's admission even though the two replies addressed to node 2 carry identical contexts and indexes.\\\",\n \\\"Production code is unchanged.\\\",\n]\nd['rationale']=(\\\"Revise the multi-requester experiment so each requester has its own result 