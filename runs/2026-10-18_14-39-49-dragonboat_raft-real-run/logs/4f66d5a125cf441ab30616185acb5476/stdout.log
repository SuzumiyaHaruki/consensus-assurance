{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_14-39-49-dragonboat_raft-real-run/agent-source && sed -n 1174,1196p internal/raft/raft.go && sed -n 2996,3030p internal/raft/raft_etcd_test.go && sed -n 418,440p internal/raft/raft.go'","aggregated_output":"func (r *raft) addObserver(nodeID uint64) {\n\tr.clearPendingConfigChange()\n\tif nodeID == r.nodeID && !r.isObserver() {\n\t\tplog.Panicf(\"%s is not an observer\", r.describe())\n\t}\n\tif _, ok := r.observers[nodeID]; ok {\n\t\treturn\n\t}\n\tr.setObserver(nodeID, 0, r.log.lastIndex()+1)\n}\n\nfunc (r *raft) addWitness(nodeID uint64) {\n\tr.clearPendingConfigChange()\n\tif nodeID == r.nodeID && !r.isWitness() {\n\t\tplog.Panicf(\"%s is not witness\", r.describe())\n\t}\n\tif _, ok := r.witnesses[nodeID]; ok {\n\t\treturn\n\t}\n\tr.setWitness(nodeID, 0, r.log.lastIndex()+1)\n}\n\nfunc (r *raft) removeNode(nodeID uint64) {\nfunc newTestRaft(id uint64, peers []uint64, election, heartbeat int, logdb ILogDB) *raft {\n\tr := newRaft(newTestConfig(id, election, heartbeat), logdb)\n\tif len(r.remotes) == 0 {\n\t\tfor _, p := range peers {\n\t\t\tr.remotes[p] = &remote{next: 1}\n\t\t}\n\t}\n\tr.hasNotAppliedConfigChange = r.testOnlyHasConfigChangeToApply\n\treturn r\n}\n\nfunc newRateLimitedTestRaft(id uint64, peers []uint64, election, heartbeat int, logdb ILogDB) *raft {\n\tcfg := config.Config{\n\t\tNodeID:          id,\n\t\tElectionRTT:     uint64(election),\n\t\tHeartbeatRTT:    uint64(heartbeat),\n\t\tMaxInMemLogSize: testRateLimit,\n\t}\n\tr := newRaft(cfg, logdb)\n\tif len(r.remotes) == 0 {\n\t\tfor _, p := range peers {\n\t\t\tr.remotes[p] = &remote{next: 1}\n\t\t}\n\t}\n\tr.hasNotAppliedConfigChange = r.testOnlyHasConfigChangeToApply\n\treturn r\n}\n\nfunc newTestObserver(id uint64, peers []uint64, observers []uint64, election, heartbeat int, logdb ILogDB) *raft {\n\tfound := false\n\tfor _, p := range observers {\n\t\tif p == id {\n\t\t\tfound = true\n\t\t}\n\t}\nfunc (r *raft) votingMembers() map[uint64]*remote {\n\tnodes := make(map[uint64]*remote, r.numVotingMembers())\n\tfor id, rm := range r.remotes {\n\t\tnodes[id] = rm\n\t}\n\tfor id, wt := range r.witnesses {\n\t\tnodes[id] = wt\n\t}\n\treturn nodes\n}\n\nfunc (r *raft) raftState() pb.State {\n\treturn pb.State{\n\t\tTerm:   r.term,\n\t\tVote:   r.vote,\n\t\tCommit: r.log.committed,\n\t}\n}\n\nfunc (r *raft) loadState(st pb.State) {\n\tif st.Commit < r.log.committed || st.Commit > r.log.lastIndex() {\n\t\tplog.Panicf(\"%s got out of range state, st.commit %d, range[%d,%d]\",\n\t\t\tr.describe(), st.Commit, r.log.committed, r.log.lastIndex())\n","exit_code":0,"status":"completed"}}
