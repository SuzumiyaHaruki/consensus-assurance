{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-18_14-39-49-dragonboat_raft-real-run/draft && python3 - <<'PY'\nimport json\nu=json.load(open('update.json'))\nu['knowledge']=[{\n \\\"ref\\\":\\\"@restore-matching-term-commit-only\\\",\n \\\"kind\\\":\\\"behavior\\\",\n \\\"statement\\\":\\\"raft.restore rejects a snapshot whose index does not exceed the committed index, panics if the local node would become an observer or witness, and then, when the local log already matches the snapshot index and term, calls commitTo on that index and returns false without invoking log.restore or restoreRemotes. Otherwise it restores the log and returns true, and restoreRemotes later rebuilds the remote, observer and witness maps from the snapshot membership.\\\",\n \\\"conditions\\\":\\\"A node receives or recovers from a snapshot whose index exceeds its committed index, and the local log either already matches the snapshot index and term or does not.\\\",\n \\\"source_ids\\\":[\\\"raft-restore-guard\\\",\\\"raft-log-restore\\\",\\\"raft-restore-remotes\\\"]\n}]\njson.dump(u, open('update.json','w'), indent=2)\nopen('update.json','a').write(\\\"\\\\n\\\")\nPY\ncd /home/nitro/Desktop/consensus-assurance && .venv/bin/consensus-assurance validate --run runs/2026-10-18_14-39-49-dragonboat_raft-real-run --submission update.json 2>&1 | tail -3\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
