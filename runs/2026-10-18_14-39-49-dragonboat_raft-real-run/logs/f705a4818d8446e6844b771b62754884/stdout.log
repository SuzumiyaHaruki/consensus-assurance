nal/raft/raft.go:1151:\tr.clearPendingConfigChange()\ninternal/raft/raft.go:1175:\tr.clearPendingConfigChange()\ninternal/raft/raft.go:1186:\tr.clearPendingConfigChange()\ninternal/raft/raft.go:1200:\tr.clearPendingConfigChange()\ninternal/raft/raft.go:1280:// we use the following pendingConfigChange flag to help tracking whether there\ninternal/raft/raft.go:1284:func (r *raft) setPendingConfigChange() {\ninternal/raft/raft.go:1285:\tr.pendingConfigChange = true\ninternal/raft/raft.go:1288:func (r *raft) hasPendingConfigChange() bool {\ninternal/raft/raft.go:1289:\treturn r.pendingConfigChange\ninternal/raft/raft.go:1292:func (r *raft) clearPendingConfigChange() {\ninternal/raft/raft.go:1293:\tr.pendingConfigChange = false\ninternal/raft/raft.go:1296:func (r *raft) getPendingConfigChangeCount() int {\ninternal/raft/raft.go:1568:\t\tr.clearPendingConfigChange()\ninternal/raft/raft.go:1625:\t\t\tif r.hasPendingConfigChange() {\ninternal/raft/raft.go:1630:\t\t\tr.setPendingConfigChange()\n","exit_code":0,"status":"completed"}}
