temitObserverAssuranceEvent(t, map[string]interface{}{\\n\\t\\t\\\"event\\\":      \\\"observer_readindex_requested\\\",\\n\\t\\t\\\"request_id\\\": \\\"observer-read-A\\\",\\n\\t\\t\\\"node_id\\\":    uint64(4),\\n\\t\\t\\\"leader_id\\\":  uint64(1),\\n\\t\\t\\\"ctx_low\\\":    ctxA.Low,\\n\\t\\t\\\"ctx_high\\\":   ctxA.High,\\n\\t})\\n\\n\\tr.msgs = nil\\n\\tr.Handle(pb.Message{\\n\\t\\tFrom:     3,\\n\\t\\tTo:       1,\\n\\t\\tType:     pb.HeartbeatResp,\\n\\t\\tHint:     ctxB.Low,\\n\\t\\tHintHigh: ctxB.High,\\n\\t})\\n\\tvar observerReply *pb.Message\\n\\tfor i := range r.msgs {\\n\\t\\tif r.msgs[i].Type == pb.ReadIndexResp && r.msgs[i].To == 4 {\\n\\t\\t\\tobserverReply = &r.msgs[i]\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif observerReply == nil {\\n\\t\\tt.Fatal(\\\"no ReadIndex response was produced for observer 4\\\")\\n\\t}\\n\\temitObserverAssuranceEvent(t, map[string]interface{}{\\n\\t\\t\\\"event\\\":              \\\"observer_readindex_reply\\\",\\n\\t\\t\\\"request_id\\\":         \\\"observer-read-A\\\",\\n\\t\\t\\\"reply_to\\\":           observerReply.To,\\n\\t\\t\\\"trigger_from\\\":       uint64(3),\\n\\t\\t\\\"trigger_ctx_low\\\":    ctxB.Low,\\n\\t\\t\\\"trigger_ctx_high\\\":   ctxB.High,\\n\\t\\t\\\"response_ctx_low\\\":   observerReply.Hint,\\n\\t\\t\\\"response_ctx_high\\\":  observerReply.HintHigh,\\n\\t\\t\\\"response_log_index\\\": observerReply.LogIndex,\\n\\t\\t\\\"pending_after\\\":      len(r.readIndex.pending),\\n\\t})\\n}\\n\",\n   \"files\": {},\n   \"execution_package\": \"./internal/raft\",\n   \"test_names\": [\n    \"TestAssuranceObserverReadIndexReplyContext\"\n   ],\n   \"description\": \"\",\n   \"semantic_changes\": [],\n   \"prerequisites\": [\n    {\n     \"alias\": \"observer_admitted\",\n     \"event\": \"observer_readindex_requested\",\n     \"conditions\": [\n      {\n       \"field\": \"node_id\",\n       \"op\": \"eq\",\n       \"value\": 4,\n       \"reference\": null\n      }\n     ]\n    }\n   ]\n  },\n  \"source_ids\": [\n   \"leader-readindex-admission\",\n   \"readindex-confirm-handler\",\n   \"readindex-confirm\",\n   \"observer-readindex-forward\",\n   \"follower-readindex-forward\",\n   \"systemctx-identity\"\n  ],\n  \"anchors\": [\n   {\n    \"material_id\": \"leader-readindex-admission\",\n    \"symbol\": \"handleLeaderReadIndex\",\n    \"start_line\": 1662,\n    \"end_line\": 1695,\n    \"anchor\": {\n     \"source_ids\": [\n      \"leader-readindex-admission\"\n     ],\n     \"boundary_complete\": true,\n     \"kind\": \"declaration\",\n     \"material_id\": \"leader-readindex-admission\",\n     \"start_line\": 1662,\n     \"end_line\": 1662,\n     \"symbol\": \"handleLeaderReadIndex\"\n    }\n   },\n   {\n    \"material_id\": \"readindex-confirm-handler\",\n    \"symbol\": \"handleReadIndexLeaderConfirmation\",\n    \"start_line\": 1771,\n    \"end_line\": 1790,\n    \"anchor\": {\n     \"\n{\n \"id\": \"90f787d3f2b44fbd9217e785b2fd7787-experiment\",\n \"investigation_id\": \"7034811e609340afbfc17ad24f2fc632-question-0\",\n \"version\": 1,\n \"basis\": {\n  \"harness\": {\n   \"kind\": \"go_test\",\n   \"source\": \"package rsm\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"testing\\\"\\n\\n\\tpb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\\n)\\n\\nfunc emitPromotionAssuranceEvent(t *testing.T, event map[string]interface{}) {\\n\\tt.Helper()\\n\\tb, err := json.Marshal(event)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"failed to marshal assurance event: %v\\\", err)\\n\\t}\\n\\tt.Logf(\\\"CA_EVENT %s\\\", b)\\n}\\n\\nfunc TestAssuranceObserverPromotionTargets(t *testing.T) {\\n\\tcases := []struct {\\n\\t\\tid   string\\n\\t\\tkind string\\n\\t\\taddr string\\n\\t\\twant bool\\n\\t}{\\n\\t\\t{id: \\\"promote-matching\\\", kind: \\\"matching\\\", addr: \\\"a2\\\", want: true},\\n\\t\\t{id: \\\"promote-different\\\", kind: \\\"different\\\", addr: \\\"a3\\\", want: false},\\n\\t\\t{id: \\\"promote-empty\\\", kind: \\\"empty\\\", addr: \\\"\\\", want: false},\\n\\t}\\n\\tfor _, tc := range cases {\\n\\t\\tm := newMembership(1, 2, true)\\n\\t\\tm.members.Observers[100] = \\\"a2\\\"\\n\\t\\temitPromotionAssuranceEvent(t, map[string]interface{}{\\n\\t\\t\\t\\\"event\\\":             \\\"promotion_target_requested\\\",\\n\\t\\t\\t\\\"request_id\\\":        tc.id,\\n\\t\\t\\t\\\"node_id\\\":           uint64(100),\\n\\t\\t\\t\\\"target_kind\\\":       tc.kind,\\n\\t\\t\\t\\\"target\\\":            tc.addr,\\n\\t\\t\\t\\\"expected\\\":          tc.want,\\n\\t\\t\\t\\\"expected_retained\\\": !tc.want,\\n\\t\\t})\\n\\t\\taccepted := m.handleConfigChange(pb.ConfigChange{\\n\\t\\t\\tType:    pb.AddNode,\\n\\t\\t\\tNodeID:  100,\\n\\t\\t\\tAddress: tc.addr,\\n\\t\\t}, 1000)\\n\\t\\t_, stillObserver := m.members.Observers[100]\\n\\t\\temitPromotionAssuranceEvent(t, map[string]interface{}{\\n\\t\\t\\t\\\"event\\\":                  \\\"promotion_target_decision\\\",\\n\\t\\t\\t\\\"request_id\\\":             tc.id,\\n\\t\\t\\t\\\"target_kind\\\":            tc.kind,\\n\\t\\t\\t\\\"accepted\\\":               accepted,\\n\\t\\t\\t\\\"expected\\\":               tc.want,\\n\\t\\t\\t\\\"observer_role_retained\\\": stillObserver,\\n\\t\\t})\\n\\t}\\n}\\n\",\n   \"files\": {},\n   \"execution_package\": \"./internal/rsm\",\n   \"test_names\": [\n    \"TestAssuranceObserverPromotionTargets\"\n   ],\n   \"description\": \"\",\n   \"semantic_changes\": [],\n   \"prerequisites\": [\n    {\n     \"alias\": \"admitted\",\n     \"event\": \"promotion_target_requested\",\n     \"conditions\": []\n    }\n   ]\n  },\n  \"source_ids\": [\n   \"membership-promote-guard\",\n   \"membership-config-accept\",\n   \"promotion-match-test\",\n   \"promotion-mismatch-test\"\n  ],\n  \"anchors\": [\n   {\n    \"material_id\": \"membership-promote-guard\",\n    \"symbol\": \"membership.isPromoteObserver\",\n    \"start_line\": 133,\n    \"end_line\": 139,\n    \"anchor\": {\n     \"source_ids\": [\n      \"membership-promote-guard\"\n     ],\n     \"boundary_complete\": true,\n     \"kind\": \"declaration\",\n     \"material_id\": \"membership-promote-guard\",\n     \"start_line\": 133,\n     \"end_line\": 133,\n     \"symbol\": \"membership.isPromoteObserver\"\n    }\n   }\n  ],\n  \"scope\": {\n   \"description\": \"Membership-level observer-promotion control with an observer at address a2 and AddNode targets a2, a3, and empty.\",\n   \"assumptions\": [\n    \"The internal membership state machine is exercised directly with OrderedConfigChange enabled and an empty ConfigChangeId.\",\n    \"Each target case starts from a fresh membership containing observer 100 at a2.\",\n    \"The request-level target validator is source-traced but not included; this control starts at handleConfigChange.\",\n    \"Production code is unchanged; no execution of NodeHost or transport is included.\"\n   ],\n   \"excluded\": [\n    \"This control does not resolve whether the API comment or the membership guard is the intended contract.\",\n    \"It does not test a custom target validator or a transport-level request.\"\n   ],\n   \"parameters\": {}\n  },\n  \"prefix\": \"The harness creates an ordered membership with observer 100 at address a2 for each case. It submits an AddNode config change at index 1000 with target a2, a3, or empty, records the accepted decision and whether observer 100 remains, and compares those obser\n","exit_code":0,"status":"completed"}}
