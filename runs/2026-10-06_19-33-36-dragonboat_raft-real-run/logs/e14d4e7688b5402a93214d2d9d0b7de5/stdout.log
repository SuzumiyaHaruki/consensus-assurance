{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > read_prefix_test.go <<'GO'\npackage raft\n\nimport (\n \\\"encoding/json\\\"\n \\\"fmt\\\"\n \\\"testing\\\"\n\n \\\"github.com/lni/dragonboat/v3/config\\\"\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\n)\n\ntype assuranceReadNode struct {\n peer *Peer\n db *TestLogDB\n applied uint64\n ready []pb.ReadyToRead\n}\n\ntype assuranceReadNetwork struct {\n t *testing.T\n nodes map[uint64]*assuranceReadNode\n queue []pb.Message\n sent []pb.Message\n phase string\n dropCtx pb.SystemCtx\n dropped int\n}\n\nfunc assuranceReadEvent(v map[string]interface{}) {\n b, err := json.Marshal(v)\n if err \"'!= nil { panic(err) }\n fmt.Println(\"CA_EVENT \" + string(b))\n}\n\nfunc (n *assuranceReadNetwork) collect(id uint64) {\n x := n.nodes[id]\n if !x.peer.HasUpdate(true) { return }\n u := x.peer.GetUpdate(true, x.applied)\n // Complete storage work before exposing messages, including all ordinary replies.\n if err := x.db.Append(u.EntriesToSave); err != nil { n.t.Fatal(err) }\n if !pb.IsEmptyState(u.State) { x.db.SetState(u.State) }\n if !pb.IsEmptySnapshot(u.Snapshot) { n.t.Fatal(\"unexpected snapshot\") }\n messages := append([]pb.Message(nil), u.Messages...)\n x.ready = append(x.ready, u.ReadyToReads...)\n for _, e := range u.CommittedEntries {\n  if e.Type == pb.ConfigChangeEntry {\n   var cc pb.ConfigChange\n   if err := cc.Unmarshal(e.Cmd); err != nil { n.t.Fatal(err) }\n   x.peer.ApplyConfigChange(cc)\n  } else if len(e.Cmd) != 0 { n.t.Fatal(\"unexpected application command\") }\n  x.applied = e.Index\n }\n x.peer.Commit(u)\n x.peer.NotifyRaftLastApplied(x.applied)\n for _, m := range messages {\n  n.sent = append(n.sent, m)\n  drop := n.phase == \"reads\" && m.Type == pb.Heartbeat && m.Hint == n.dropCtx.Low && m.HintHigh == n.dropCtx.High\n  assuranceReadEvent(map[string]interface{}{\"event\":\"wire\",\"phase\":n.phase,\"from\":m.From,\"to\":m.To,\"type\":m.Type.String(),\"term\":m.Term,\"low\":m.Hint,\"high\":m.HintHigh,\"dropped\":drop})\n  if drop { n.dropped++; continue }\n  n.queue = append(n.queue, m)\n }\n}\n\nfunc (n *assuranceReadNetwork) step() {\n if len(n.queue) == 0 { n.t.Fatal(\"no message available\") }\n m := n.queue[0]\n n.queue = n.queue[1:]\n n.nodes[m.To].peer.Handle(m)\n n.collect(m.To)\n}\n\nfunc (n *assuranceReadNetwork) drain() {\n for steps := 0; len(n.queue)>0; steps++ {\n  if steps >= 1000 { n.t.Fatal(\"message drain bound exceeded\") }\n  n.step()\n }\n}\n\nfunc TestAssuranceReadPrefixIdentity(t *testing.T) {\n n := &assuranceReadNetwork{t:t,nodes:make(map[uint64]*assuranceReadNode),phase:\"setup\",dropCtx:pb.SystemCtx{Low:1001,High:101}}\n addresses := []PeerAddress{{NodeID:1,Address:\"n1\"},{NodeID:2,Address:\"n2\"},{NodeID:3,Address:\"n3\"}}\n for id:=uint64(1);id<=3;id++ {\n  db := NewTestLogDB().(*TestLogDB)\n  p := Launch(config.Config{ClusterID:77,NodeID:id,ElectionRTT:10,HeartbeatRTT:1,CheckQuorum:true},db,nil,addresses,true,true)\n  n.nodes[id]=&assuranceReadNode{peer:p,db:db}\n  n.collect(id)\n }\n n.drain()\n for tick:=0;tick<25 && !n.nodes[1].peer.raft.isLeader();tick++ {\n  n.nodes[1].peer.Tick(); n.collect(1); n.drain()\n }\n leader:=n.nodes[1].peer.raft\n if !leader.isLeader() || !leader.hasCommittedEntryAtCurrentTerm() { t.Fatal(\"election/current-term commit prerequisite not reached\") }\n term:=leader.term\n for id:=uint64(1);id<=3;id++ {\n  r:=n.nodes[id].peer.raft\n  if r.term!=term || r.leaderID!=1 || r.log.committed!=leader.log.committed || n.nodes[id].applied!=leader.log.committed { t.Fatalf(\"node %d not synchronized\",id) }\n }\n if len(n.queue)!=0 { t.Fatal(\"setup queue not drained\") }\n n.phase=\"reads\"\n n.sent=nil\n contexts:=map[uint64]pb.SystemCtx{2:n.dropCtx,3:{Low:2001,High:202}}\n // Only the initial confirmation heartbeats are lost. No surviving message is reordered.\n n.nodes[2].peer.ReadIndex(contexts[2]); n.collect(2); n.drain()\n if n.dropped!=2 || len(leader.readIndex.pending)!=1 { t.Fatal(\"first pending read/loss prerequisite not reached\") }\n n.nodes[3].peer.ReadIndex(contexts[3]); n.collect(3)\n if len(n.queue)!=1 || n.queue[0].Type!=pb.ReadIndex || n.queue[0].From!=3 || n.queue[0].To!=1 { t.Fatal(\"second forward prerequisite not reached\") }\n n.step() // Register the second request; its real heartbeat messages remain queued.\n if len(leader.readIndex.pending)!=2 || len(leader.readIndex.queue)!=2 { t.Fatal(\"two pending reads prerequisite not reached\") }\n for _,id:=range []uint64{2,3} {\n  ctx:=contexts[id]\n  status,ok:=leader.readIndex.pending[ctx]\n  if !ok || status.from!=id || status.ctx!=ctx || len(status.confirmed)!=0 { t.Fatal(\"pending identity prerequisite mismatch\") }\n  expected,_:=json.Marshal([]pb.SystemCtx{ctx})\n  assuranceReadEvent(map[string]interface{}{\"event\":\"admitted\",\"scenario\":\"remote_prefix\",\"requester\":id,\"queued\":ok,\"current_term_committed\":leader.hasCommittedEntryAtCurrentTerm(),\"term\":term,\"expected_contexts\":string(expected),\"pending_count\":len(leader.readIndex.pending),\"sampled_index\":status.index,\"dropped_heartbeats\":n.dropped})\n }\n n.drain()\n if leader.term!=term || !leader.isLeader() { t.Fatal(\"authority changed unexpectedly\") }\n for _,id:=range []uint64{2,3} {\n  ctx:=contexts[id]\n  _,stillPending:=leader.readIndex.pending[ctx]\n  actual:=make([]pb.SystemCtx,0)\n  for _,m:=range n.sent {\n   if m.Type==pb.ReadIndexResp && m.To==id {\n    actual=append(actual,pb.SystemCtx{Low:m.Hint,High:m.HintHigh})\n   }\n  }\n  encoded,_:=json.Marshal(actual)\n  assuranceReadEvent(map[string]interface{}{\"event\":\"publication\",\"scenario\":\"remote_prefix\",\"requester\":id,\"released\":!stillPending,\"term\":leader.term,\"actual_contexts\":string(encoded),\"response_count\":len(actual),\"leader_pending\":len(leader.readIndex.pending),\"queue_empty\":len(n.queue)==0,\"follower_ready\":n.nodes[id].ready,\"applied\":n.nodes[id].applied})\n }\n}\nGO\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'\"'PY'\nimport json\nr=json.load(open('../research.json'));c=r['claims'][0]\ng=dict(source_ids=c['source_ids'],expectation_ids=['src-read-prefix-expectation'],binding_ids=['bind-read-publish','bind-read-consume'],derivation='C-read-prefix-identity requires publication of each released remote prefix member with its own complete SystemCtx. Compare the full ordered singleton context list addressed to each distinct requester with the original retained context. Requester identity is independent of compared context; the two requests originate from different followers.',applicability='Stable-term current-term-committed leader, unchanged membership, two admitted remote contexts, no crashes or storage faults.',unresolved=[],conflicts=[],alternatives=['If a request is not released, the implication does not test context preservation for that request. Follower readiness is diagnostic, not a full NodeHost endpoint.'])\nlegal=dict(source_ids=['src-peer-launch','src-peer-bootstrap','src-test-storage','src-peer-update','src-engine-order','src-node-step','src-node-read-batch','src-wire-identity','src-transport-loss','src-nodehost-send','src-raft-timers'],expectation_ids=['src-read-prefix-expectation'],binding_ids=['bind-read-publish'],derivation='Three Peers use Launch bootstrap, then actual ticks elect node 1 through generated vote/replication messages. collect saves entries/state in the captured TestLogDB before exposing messages, applies only bootstrap config/no-op committed entries, commits the Update, and reports lastApplied. There are no application commands or crashes. FIFO delivery uses only generated messages through Peer.Handle. The declared loss policy discards all heartbeat messages for the first context at enqueue and none for the second, modeling permitted admission loss. No ordinary message is delivered out of order. Each follower initiates one ReadIndex; independent event batches need not wait for earlier completion. The second forwarded request is delivered before recording admission, with its generated heartbeats still queued. Then the queue drains synchronously; no sleep or background worker is needed. Sampled state is owned by the sole test goroutine. No protocol state or handler is modified.',applicability='Peer-level protocol isolation; TestLogDB represents successful synchronous storage, not filesystem durability. Application work is limited to bootstrap config and leader no-op. Only node 1 ticks during bounded election preparation; the read suffix has no ticks or membership changes.',unresolved=[],conflicts=[],alternatives=['Local client timeout and RSM consumer are outside the execution package; follower ReadyToRead is retained as the immediate result-consumption diagnostic.'])\nplan=dict(description='Exercise C-read-prefix-identity with two distinct remote requesters after real bootstrap/election/current-term commit. Drop the first context heartbeat sends, admit a second context, deliver all surviving messages FIFO, and observe the complete per-requester response context lists and follower readiness after prefix release.',claim_id=c['id'],binding_ids=['bind-read-publish','bind-read-consume'],harness=dict(kind='go_test',execution_package='internal/raft',source='',files={},description='Single goroutine Peer network with real constructors and handlers, captured TestLogDB and deterministic loss of first-context heartbeats.',semantic_changes=['Replaces asynchronous engine/transport with a synchronous persist-before-send Peer driver and FIFO queue; protocol logic is unchanged.','Uses captured TestLogDB and applies only initialization config/no-op entries; excludes crash durability and user application execution.'],prerequisites=[dict(alias='admit',event='admitted',conditions=[dict(field='queued',value=True),dict(field='current_term_committed',value=True),dict(field='pending_count',value=2),dict(field='dropped_heartbeats',value=2)])],legality=legal),monitors=[dict(id='M-read-prefix',checker_id='K-read-prefix',event='publication',binding_ids=['bind-read-publish','bind-read-consume'],grounding=g,admission_alias='admit',applicability_conditions=[dict(field='term',reference='admit.term')])],observable_properties=[dict(checker_id='K-read-prefix',kind='event_implication',trigger=dict(field='scenario',value='remote_prefix'),antecedent=dict(field='released',value=True),assertion=dict(field='actual_contexts',reference='admit.expected_contexts'),identity_fields=['scenario','requester'],description='For each admitted remote requester whose pending read is released, the emitted complete response context list equals the singleton original context list. Comparison includes both High and Low, not just response count.')],uncertainties=['No full NodeHost completion/timeout observation or linearizable application read is included.','A non-release yields only a vacuous implication result for that operation; actual release is reported explicitly.'])\njson.dump(plan,open('read_prefix_plan.json','w'),indent=2)\ns=dict(action='check',unit_id=r['units'][0]['id'],plan_path='read_prefix_plan.json',harness_path='read_prefix_test.go',rationale='The obligation is grounded and the remaining discriminator is actual remote context publication after a legal prefix-confirmation history. This fixed check preserves overlap, includes complete per-requester admission/result identity, and records actual follower readiness without asserting a client deadline.')\njson.dump(s,open('submission.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-33-36-dragonboat_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
