{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat ../direct-checks/e14d4e7688b5402a93214d2d9d0b7de5/plan.json; sed -n '137,158p' ../agent-source/internal/raft/peer.go; sed -n '72,116p' ../agent-source/internal/raft/readindex.go; sed -n '1728,1742p' ../agent-source/internal/raft/raft.go; sed -n '1771,1791p' ../agent-source/internal/raft/raft.go; cat ../logs/c611aead474d4b8fa96906fb00bd1771/stderr.log\"","aggregated_output":"{\n  \"description\": \"Exercise C-read-prefix-identity with two distinct remote requesters after real bootstrap/election/current-term commit. Drop the first context heartbeat sends, admit a second context, deliver all surviving messages FIFO, and observe the complete per-requester response context lists and follower readiness after prefix release.\",\n  \"claim_id\": \"C-read-prefix-identity\",\n  \"binding_ids\": [\n    \"bind-read-publish\",\n    \"bind-read-consume\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./internal/raft\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/lni/dragonboat/v3/config\\\"\\n pb \\\"github.com/lni/dragonboat/v3/raftpb\\\"\\n)\\n\\ntype assuranceReadNode struct {\\n peer *Peer\\n db *TestLogDB\\n applied uint64\\n ready []pb.ReadyToRead\\n}\\n\\ntype assuranceReadNetwork struct {\\n t *testing.T\\n nodes map[uint64]*assuranceReadNode\\n queue []pb.Message\\n sent []pb.Message\\n phase string\\n dropCtx pb.SystemCtx\\n dropped int\\n}\\n\\nfunc assuranceReadEvent(v map[string]interface{}) {\\n b, err := json.Marshal(v)\\n if err != nil { panic(err) }\\n fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n}\\n\\nfunc (n *assuranceReadNetwork) collect(id uint64) {\\n x := n.nodes[id]\\n if !x.peer.HasUpdate(true) { return }\\n u := x.peer.GetUpdate(true, x.applied)\\n // Complete storage work before exposing messages, including all ordinary replies.\\n if err := x.db.Append(u.EntriesToSave); err != nil { n.t.Fatal(err) }\\n if !pb.IsEmptyState(u.State) { x.db.SetState(u.State) }\\n if !pb.IsEmptySnapshot(u.Snapshot) { n.t.Fatal(\\\"unexpected snapshot\\\") }\\n messages := append([]pb.Message(nil), u.Messages...)\\n x.ready = append(x.ready, u.ReadyToReads...)\\n for _, e := range u.CommittedEntries {\\n  if e.Type == pb.ConfigChangeEntry {\\n   var cc pb.ConfigChange\\n   if err := cc.Unmarshal(e.Cmd); err != nil { n.t.Fatal(err) }\\n   x.peer.ApplyConfigChange(cc)\\n  } else if len(e.Cmd) != 0 { n.t.Fatal(\\\"unexpected application command\\\") }\\n  x.applied = e.Index\\n }\\n x.peer.Commit(u)\\n x.peer.NotifyRaftLastApplied(x.applied)\\n for _, m := range messages {\\n  n.sent = append(n.sent, m)\\n  drop := n.phase == \\\"reads\\\" && m.Type == pb.Heartbeat && m.Hint == n.dropCtx.Low && m.HintHigh == n.dropCtx.High\\n  assuranceReadEvent(map[string]interface{}{\\\"event\\\":\\\"wire\\\",\\\"phase\\\":n.phase,\\\"from\\\":m.From,\\\"to\\\":m.To,\\\"type\\\":m.Type.String(),\\\"term\\\":m.Term,\\\"low\\\":m.Hint,\\\"high\\\":m.HintHigh,\\\"dropped\\\":drop})\\n  if drop { n.dropped++; continue }\\n  n.queue = append(n.queue, m)\\n }\\n}\\n\\nfunc (n *assuranceReadNetwork) step() {\\n if len(n.queue) == 0 { n.t.Fatal(\\\"no message available\\\") }\\n m := n.queue[0]\\n n.queue = n.queue[1:]\\n n.nodes[m.To].peer.Handle(m)\\n n.collect(m.To)\\n}\\n\\nfunc (n *assuranceReadNetwork) drain() {\\n for steps := 0; len(n.queue)>0; steps++ {\\n  if steps >= 1000 { n.t.Fatal(\\\"message drain bound exceeded\\\") }\\n  n.step()\\n }\\n}\\n\\nfunc TestAssuranceReadPrefixIdentity(t *testing.T) {\\n n := &assuranceReadNetwork{t:t,nodes:make(map[uint64]*assuranceReadNode),phase:\\\"setup\\\",dropCtx:pb.SystemCtx{Low:1001,High:101}}\\n addresses := []PeerAddress{{NodeID:1,Address:\\\"n1\\\"},{NodeID:2,Address:\\\"n2\\\"},{NodeID:3,Address:\\\"n3\\\"}}\\n for id:=uint64(1);id<=3;id++ {\\n  db := NewTestLogDB().(*TestLogDB)\\n  p := Launch(config.Config{ClusterID:77,NodeID:id,ElectionRTT:10,HeartbeatRTT:1,CheckQuorum:true},db,nil,addresses,true,true)\\n  n.nodes[id]=&assuranceReadNode{peer:p,db:db}\\n  n.collect(id)\\n }\\n n.drain()\\n for tick:=0;tick<25 && !n.nodes[1].peer.raft.isLeader();tick++ {\\n  n.nodes[1].peer.Tick(); n.collect(1); n.drain()\\n }\\n leader:=n.nodes[1].peer.raft\\n if !leader.isLeader() || !leader.hasCommittedEntryAtCurrentTerm() { t.Fatal(\\\"election/current-term commit prerequisite not reached\\\") }\\n term:=leader.term\\n for id:=uint64(1);id<=3;id++ {\\n  r:=n.nodes[id].peer.raft\\n  if r.term!=term || r.leaderID!=1 || r.log.committed!=leader.log.committed || n.nodes[id].applied!=leader.log.committed { t.Fatalf(\\\"node %d not synchronized\\\",id) }\\n }\\n if len(n.queue)!=0 { t.Fatal(\\\"setup queue not drained\\\") }\\n n.phase=\\\"reads\\\"\\n n.sent=nil\\n contexts:=map[uint64]pb.SystemCtx{2:n.dropCtx,3:{Low:2001,High:202}}\\n // Only the initial confirmation heartbeats are lost. No surviving message is reordered.\\n n.nodes[2].peer.ReadIndex(contexts[2]); n.collect(2); n.drain()\\n if n.dropped!=2 || len(leader.readIndex.pending)!=1 { t.Fatal(\\\"first pending read/loss prerequisite not reached\\\") }\\n n.nodes[3].peer.ReadIndex(contexts[3]); n.collect(3)\\n if len(n.queue)!=1 || n.queue[0].Type!=pb.ReadIndex || n.queue[0].From!=3 || n.queue[0].To!=1 { t.Fatal(\\\"second forward prerequisite not reached\\\") }\\n n.step() // Register the second request; its real heartbeat messages remain queued.\\n if len(leader.readIndex.pending)!=2 || len(leader.readIndex.queue)!=2 { t.Fatal(\\\"two pending reads prerequisite not reached\\\") }\\n for _,id:=range []uint64{2,3} {\\n  ctx:=contexts[id]\\n  status,ok:=leader.readIndex.pending[ctx]\\n  if !ok || status.from!=id || status.ctx!=ctx || len(status.confirmed)!=0 { t.Fatal(\\\"pending identity prerequisite mismatch\\\") }\\n  expected,_:=json.Marshal([]pb.SystemCtx{ctx})\\n  assuranceReadEvent(map[string]interface{}{\\\"event\\\":\\\"admitted\\\",\\\"scenario\\\":\\\"remote_prefix\\\",\\\"requester\\\":id,\\\"queued\\\":ok,\\\"current_term_committed\\\":leader.hasCommittedEntryAtCurrentTerm(),\\\"term\\\":term,\\\"expected_contexts\\\":string(expected),\\\"pending_count\\\":len(leader.readIndex.pending),\\\"sampled_index\\\":status.index,\\\"dropped_heartbeats\\\":n.dropped})\\n }\\n n.drain()\\n if leader.term!=term || !leader.isLeader() { t.Fatal(\\\"authority changed unexpectedly\\\") }\\n for _,id:=range []uint64{2,3} {\\n  ctx:=contexts[id]\\n  _,stillPending:=leader.readIndex.pending[ctx]\\n  actual:=make([]pb.SystemCtx,0)\\n  for _,m:=range n.sent {\\n   if m.Type==pb.ReadIndexResp && m.To==id {\\n    actual=append(actual,pb.SystemCtx{Low:m.Hint,High:m.HintHigh})\\n   }\\n  }\\n  encoded,_:=json.Marshal(actual)\\n  assuranceReadEvent(map[string]interface{}{\\\"event\\\":\\\"publication\\\",\\\"scenario\\\":\\\"remote_prefix\\\",\\\"requester\\\":id,\\\"released\\\":!stillPending,\\\"term\\\":leader.term,\\\"actual_contexts\\\":string(encoded),\\\"response_count\\\":len(actual),\\\"leader_pending\\\":len(leader.readIndex.pending),\\\"queue_empty\\\":len(n.queue)==0,\\\"follower_ready\\\":n.nodes[id].ready,\\\"applied\\\":n.nodes[id].applied})\\n }\\n}\\n\",\n    \"description\": \"Single goroutine Peer network with real constructors and handlers, captured TestLogDB and deterministic loss of first-context heartbeats.\",\n    \"semantic_changes\": [\n      \"Replaces asynchronous engine/transport with a synchronous persist-before-send Peer driver and FIFO queue; protocol logic is unchanged.\",\n      \"Uses captured TestLogDB and applies only initialization config/no-op entries; excludes crash durability and user application execution.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admit\",\n        \"event\": \"admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"queued\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"current_term_committed\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"pending_count\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          },\n          {\n            \"field\": \"dropped_heartbeats\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"src-peer-launch\",\n        \"src-peer-bootstrap\",\n        \"src-test-storage\",\n        \"src-peer-update\",\n        \"src-engine-order\",\n        \"src-node-step\",\n        \"src-node-read-batch\",\n        \"src-wire-identity\",\n        \"src-transport-loss\",\n        \"src-nodehost-send\",\n        \"src-raft-timers\"\n      ],\n      \"expectation_ids\": [\n        \"src-read-prefix-expectation\"\n      ],\n      \"binding_ids\": [\n        \"bind-read-publish\"\n      ],\n      \"derivation\": \"Three Peers use Launch bootstrap, then actual ticks elect node 1 through generated vote/replication messages. collect saves entries/state in the captured TestLogDB before exposing messages, applies only bootstrap config/no-op committed entries, commits the Update, and reports lastApplied. There are no application commands or crashes. FIFO delivery uses only generated messages through Peer.Handle. The declared loss policy discards all heartbeat messages for the first context at enqueue and none for the second, modeling permitted admission loss. No ordinary message is delivered out of order. Each follower initiates one ReadIndex; independent event batches need not wait for earlier completion. The second forwarded request is delivered before recording admission, with its generated heartbeats still queued. Then the queue drains synchronously; no sleep or background worker is needed. Sampled state is owned by the sole test goroutine. No protocol state or handler is modified.\",\n      \"applicability\": \"Peer-level protocol isolation; TestLogDB represents successful synchronous storage, not filesystem durability. Application work is limited to bootstrap config and leader no-op. Only node 1 ticks during bounded election preparation; the read suffix has no ticks or membership changes.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Local client timeout and RSM consumer are outside the execution package; follower ReadyToRead is retained as the immediate result-consumption diagnostic.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-read-prefix\",\n      \"checker_id\": \"K-read-prefix\",\n      \"event\": \"publication\",\n      \"binding_ids\": [\n        \"bind-read-publish\",\n        \"bind-read-consume\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"src-read-prefix-expectation\",\n          \"src-api-read\",\n          \"src-peer-update\",\n          \"src-read-prefix\",\n          \"src-read-confirm-send\",\n          \"src-read-follower\",\n          \"src-read-consume\"\n        ],\n        \"expectation_ids\": [\n          \"src-read-prefix-expectation\"\n        ],\n        \"binding_ids\": [\n          \"bind-read-publish\",\n          \"bind-read-consume\"\n        ],\n        \"derivation\": \"C-read-prefix-identity requires publication of each released remote prefix member with its own complete SystemCtx. Compare the full ordered singleton context list addressed to each distinct requester with the original retained context. Requester identity is independent of compared context; the two requests originate from different followers.\",\n        \"applicability\": \"Stable-term current-term-committed leader, unchanged membership, two admitted remote contexts, no crashes or storage faults.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"If a request is not released, the implication does not test context preservation for that request. Follower readiness is diagnostic, not a full NodeHost endpoint.\"\n        ]\n      },\n      \"applicability_conditions\": [\n        {\n          \"field\": \"term\",\n          \"op\": \"eq\",\n          \"value\": null,\n          \"reference\": \"admit.term\"\n        }\n      ],\n      \"admission_alias\": \"admit\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"K-read-prefix\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"scenario\",\n        \"op\": \"eq\",\n        \"value\": \"remote_prefix\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"actual_contexts\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"admit.expected_contexts\"\n      },\n      \"antecedent\": {\n        \"field\": \"released\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"scenario\",\n        \"requester\"\n      ],\n      \"description\": \"For each admitted remote requester whose pending read is released, the emitted complete response context list equals the singleton original context list. Comparison includes both High and Low, not just response count.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"No full NodeHost completion/timeout observation or linearizable application read is included.\",\n    \"A non-release yields only a vacuous implication result for that operation; actual release is reported explicitly.\"\n  ]\n}func (p *Peer) ApplyConfigChange(cc pb.ConfigChange) {\n\tif cc.NodeID == NoLeader {\n\t\tp.raft.clearPendingConfigChange()\n\t\treturn\n\t}\n\tp.raft.Handle(pb.Message{\n\t\tType:     pb.ConfigChangeEvent,\n\t\tReject:   false,\n\t\tHint:     cc.NodeID,\n\t\tHintHigh: uint64(cc.Type),\n\t})\n}\n\n// RejectConfigChange rejects the currently pending raft membership change.\nfunc (p *Peer) RejectConfigChange() {\n\tp.raft.Handle(pb.Message{\n\t\tType:   pb.ConfigChangeEvent,\n\t\tReject: true,\n\t})\n}\n\n// RestoreRemotes applies the remotes info obtained from the specified snapshot.\n\nfunc (r *readIndex) peepCtx() raftpb.SystemCtx {\n\treturn r.queue[len(r.queue)-1]\n}\n\nfunc (r *readIndex) confirm(ctx raftpb.SystemCtx,\n\tfrom uint64, quorum int) []*readStatus {\n\tp, ok := r.pending[ctx]\n\tif !ok {\n\t\treturn nil\n\t}\n\tp.confirmed[from] = struct{}{}\n\tif len(p.confirmed)+1 < quorum {\n\t\treturn nil\n\t}\n\tdone := 0\n\tcs := []*readStatus{}\n\tfor _, pctx := range r.queue {\n\t\tdone++\n\t\ts, ok := r.pending[pctx]\n\t\tif !ok {\n\t\t\tpanic(\"inconsistent pending and queue content\")\n\t\t}\n\t\tcs = append(cs, s)\n\t\tif pctx == ctx {\n\t\t\tfor _, v := range cs {\n\t\t\t\tif v.index > s.index {\n\t\t\t\t\tpanic(\"v.index > s.index is unexpected\")\n\t\t\t\t}\n\t\t\t\t// re-write the index for extra safety.\n\t\t\t\t// we don't know what we don't know.\n\t\t\t\tv.index = s.index\n\t\t\t}\n\t\t\tr.queue = r.queue[done:]\n\t\t\tfor _, v := range cs {\n\t\t\t\tdelete(r.pending, v.ctx)\n\t\t\t}\n\t\t\tif len(r.queue) != len(r.pending) {\n\t\t\t\tpanic(\"inconsistent length\")\n\t\t\t}\n\t\t\treturn cs\n\t\t}\n\t}\n\treturn nil\n}\nfunc (r *raft) handleLeaderHeartbeatResp(m pb.Message, rp *remote) {\n\tr.mustBeLeader()\n\trp.setActive()\n\trp.waitToRetry()\n\tif rp.match < r.log.lastIndex() {\n\t\tr.sendReplicateMessage(m.From)\n\t}\n\t// heartbeat response contains leadership confirmation requested as part of\n\t// the ReadIndex protocol.\n\tif m.Hint != 0 {\n\t\tr.handleReadIndexLeaderConfirmation(m)\n\t}\n}\n\nfunc (r *raft) handleLeaderTransfer(m pb.Message) {\nfunc (r *raft) handleReadIndexLeaderConfirmation(m pb.Message) {\n\tctx := pb.SystemCtx{\n\t\tLow:  m.Hint,\n\t\tHigh: m.HintHigh,\n\t}\n\tris := r.readIndex.confirm(ctx, m.From, r.quorum())\n\tfor _, s := range ris {\n\t\tif s.from == NoNode || s.from == r.nodeID {\n\t\t\tr.addReadyToRead(s.index, s.ctx)\n\t\t} else {\n\t\t\tr.send(pb.Message{\n\t\t\t\tTo:       s.from,\n\t\t\t\tType:     pb.ReadIndexResp,\n\t\t\t\tLogIndex: s.index,\n\t\t\t\tHint:     m.Hint,\n\t\t\t\tHintHigh: m.HintHigh,\n\t\t\t})\n\t\t}\n\t}\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"The execution observed the mismatch. Requester 2’s context was `(Low=1001, High=101)`, but its response and follower readiness carried requester 3’s `(2001, 202)`. Both reads were removed from the leader’s pending queue; requester 3 received the expected context. This supports the local identity-loss finding. It does not measure a client timeout or a linearizability failure.\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python - <<'PY'\nimport json\nr=json.load(open('../research.json'));a=r['artifacts'][0];run=r['assessments'][0]['experiment_check_id'];cid=r['candidates'][0]['id']\nids=['src-peer-launch','src-peer-bootstrap','src-test-storage','src-peer-update','src-engine-order','src-node-step','src-node-read-batch','src-wire-identity','src-transport-loss','src-nodehost-send','src-read-prefix-expectation','src-read-prefix','src-read-confirm-send','src-read-follower','src-read-consume','src-api-read','src-raft-timers','src-core-term-election','src-core-commit-reset']\nitem=dict(aspect='checker_correspondence',status='no_issue_found',source_ids=ids,rationale='Reviewed fixed artifact e4465cc7b4964f2faf0e4099ccd60176, its stored plan and harness, and raw stdout/stderr for c611aead474d4b8fa96906fb00bd1771 against claim version 1. The duty is preservation of the original SystemCtx for each remote read released by prefix confirmation, supported by the explicit per-prefix ctx/from test expectation and exact-context consumer. It is not a successful-completion deadline. Launch constructs three configured full voters and bootstrap entries. The driver applies only committed bootstrap membership and the empty leader entry; it never changes term, role, pending reads or generated message contents. Tick-driven election actually reaches term 2 and current-term commit 4; setup assertions check all nodes committed/applied at 4 and known leader 1. Storage Append/SetState precedes message exposure; Update Commit and NotifyRaftLastApplied retain caller completion order for this synchronous non-crashing history. A globally FIFO queue is a permitted restriction of per-route ordering and does not serialize the two pending reads: both are observed pending before confirmation. The two first-context heartbeats are dropped at send admission, a failure explicitly permitted by Transport.send and not retried by NodeHost.sendMessage; later traffic is generated by real Peer handlers and delivered without reordering. The known-peer Peer.Handle checks and current-term checks remain active. No background owners, sleeps, shutdown, forged replies or hidden callbacks participate.\\\\n\\\\nRaw events 18 and 19 admit distinct requester identities 2 and 3, with queued=true, two pending requests, current-term commit, sampled index 4 and original contexts (1001,101)/(2001,202). Both actual nonzero-context heartbeat replies originate from voters in term 2. The first suffices with leader self-support to release the prefix. Raw result 24 for requester 2 contains one response context (2001,202), released=true, leader_pending=0 and queue_empty=true; its actual follower ReadyToRead also contains (2001,202) at index 4. Result 25 for requester 3 contains its correct (2001,202), also released=true. Thus both antecedents are observed true, not vacuous. The raw wire records independently exhibit the wrong leader-to-2 response. The monitor correlates each admitted operation by scenario/requester, not the compared context, and checks exact serialized complete High/Low context lists. Both sides use the same Go struct encoder; the observed lists each have one element, so the decisive mismatch is content identity, not cardinality or order. A comparison on response count alone would miss it. The run has no parser gaps and both admissions have results. The sent slice is an immutable copied message history accumulated by the sole goroutine; ReadyToRead values are copied before Peer.Commit clears the producer queue. Absence from pending is valid release evidence in this suffix because no reset/removal path runs and source confirm is the deletion owner.\\\\n\\\\nThe implementation cause agrees with the measurement: confirm retains original s.ctx and s.from while releasing the prefix, but the remote send loop uses m.Hint/m.HintHigh for each s.from; the local branch correctly uses s.ctx. The exact-key client consumer cannot associate this wrong context with requester 2 original batch. That final NodeHost timeout consequence is source-supported risk, not an executed endpoint result. No correspondence issue was found for this complete local counterexample.',counterevidence=['The later request succeeds in the same run: requester 3 receives its own (2001,202), so the finding is not a blanket failure of remote ReadIndex.','The source local-completion branch uses s.ctx correctly; no local-prefix violation is claimed.','Requester timeout/GC remains available and prevents inferring permanent resource retention.','The test process passed because it emitted measurements for the monitor; process success is not the property verdict.'],limitations=['This is a Peer-level local correlation violation under fixed membership and a stable term, not an observed application-level stale read or cluster safety violation.','The singleton-list oracle is assessed for this one-request-per-requester, nonduplicating delivery history; this review does not assert a general prohibition on repeated identical network responses.','TestLogDB exercises successful storage API ordering but provides no filesystem/crash evidence.','No NodeHost pending batch, RequestState timeout, session endpoint or user state machine was executed; follower ReadyToRead is the immediate downstream observation.'],report_title='批量确认读取时，早期远端请求收到后一个请求的上下文',report_answer='实测节点 2 的请求上下文为 (1001,101)，但领导者向它发送、且它接收的就绪结果均为后一个请求的 (2001,202)；两个请求都已从领导者待处理队列移除。该结果验证了稳定任期内前缀确认的远端请求身份丢失，不等同于已测得客户端超时或线性一致性破坏。')\ns=dict(action='review',artifact_id=a['id'],review_items=[item],rationale='The trusted run contains a complete non-vacuous identity mismatch for the earlier remote prefix member. Fixed-artifact review reconstructs legal setup, produced messages, actual release, independent operation correlation and downstream readiness, retaining wider endpoint limits.',feedback=dict(ref_ids=[run,a['id'],cid,'B-read-confirm','B-read-forward','F-read-pending','src-read-confirm-send','src-read-consume'],answered='The checked proposition is answered by execution: in term 2 at committed index 4, requester 2 original context (1001,101) is released but the response and follower ReadyToRead carry requester 3 context (2001,202). Requester 3 is released with its expected context. The source remote branch substitutes the confirming context for each prefix member; local publication does not. This excludes the proposed explanation that batching or ordinary ordering necessarily prevents the discrepant remote-prefix path. The review found no applicability, driver, observation or oracle issue for this local witness.',remaining=['No additional execution is needed to settle this fixed local correlation proposition.','Independent membership-transition support eligibility, persistence/recovery surfaces and broader endpoint consequences remain outside this check.','At the next related map handoff, replace the answered correlation unknown with this conditional source relationship and retain independent unknowns.'],understanding='updated',rationale='Execution and current correspondence are retained together; no result is inferred from process success alone.',question_updates={cid:dict(unknowns=[],resume_conditions=[])}))\njson.dump(s,open('submission.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-06_19-33-36-dragonboat_raft-real-run --submission submission.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
