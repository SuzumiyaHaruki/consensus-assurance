emoval-in-flight cases remain open'])\nbeh('B-read-admit','A1','Leader receives local or forwarded ReadIndex',['src-read-confirm-send','src-core-commit-reset','src-read-prefix'],implementation_guards=['Witness requester rejected','Multi-voter leader requires current-term committed entry','Duplicate SystemCtx does not add a second pending record'],writes=['Record committed index, original ctx and requester in pending map/queue'],external_effects=['Nonzero-context heartbeat sent to voting members; periodic heartbeat repeats latest pending context','Single-voter leader produces local ready and response to remote observer'],consumes_fact_ids=['F-committed'],produces_fact_ids=['F-read-pending'],cross_activity_effects={'A2':'Heartbeat responses seek current leadership confirmation'},unknowns=['Single-voter remote-request variants have not been fully investigated'])\nbeh('B-read-confirm','A1','Leader accepts heartbeat response with nonzero Hint',['src-read-confirm-send','src-read-prefix'],reads=['Pending map keyed by SystemCtx and current quorum'],writes=['Deduplicate confirming sender; release prefix when confirmed count plus leader reaches quorum; raise released indexes to confirmed request index; delete released records'],external_effects=['Local release publishes s.ctx; remote release addresses s.from but encodes confirming message Hint/HintHigh'],consumes_fact_ids=['F-read-pending'],cross_activity_effects={'A7':'Published context is the key used by requester-side completion'},unknowns=['Does the remote prefix path preserve each released operation identity under legal delayed delivery?','Eligibility of already-recorded confirmations across membership changes is not established'])\nbeh('B-read-forward','A7','Follower/observer receives request or ReadIndexResp',['src-read-follower','src-node-read-batch','src-node-step','src-read-consume','src-peer-update'],execution_owner='Node step worker and pendingReadIndex mutex',implementation_guards=['No known leader: drop request','Client batch registration precedes Peer.ReadIndex','addReady only updates exact SystemCtx match; completion requires positive read index <= applied and unexpired deadline'],writes=['Distinct event-loop batches register new contexts without awaiting prior batches; response context becomes ReadyToRead'],external_effects=['Forward to known leader; notify request completion, dropped status or timeout'],async_boundaries=['Transport delivery -> raft ReadyToRead -> Peer Update -> pending batch readiness -> applied-index completion'],cross_activity_effects={'A1':'Supplies request context and consumes quorum-confirmed read result'},unknowns=['Transport batching/delivery policy needed for a concrete two-context witness remains unread'])\nbeh('B-persist','A6','Peer Update is processed by engine',['src-peer-update','src-engine-order','src-node-step'],execution_owner='Engine step worker, LogDB implementation and node update processing',implementation_guards=['validateUpdate bounds committed entries by saved/committed indexes','FastApply disabled when applying newly saved entries or snapshot'],durable_effects=['SaveRaftState receives entries, term/vote/commit and snapshot before ordinary response messages are sent'],external_effects=['Replicate/Ping can precede save; ordinary messages follow save; Commit marks update processed'],async_boundaries=['Replication may overlap local persistence; application queue runs independently'],cross_activity_effects={'A1':'Persists follower acknowledgement basis and committed work','A2':'Persists term/vote before ordinary replies'},unknowns=['Concrete LogDB crash atomicity and filesystem fault behavior remain unread'])\nbeh('B-apply','A5','Committed-entry tasks consumed by StateMachine',['src-rsm-apply','src-rsm-wake','src-node-step'],execution_owner='RSM worker, state-machine mutex and application implementation',implementation_guards=['Session tracking rejects missing clients, suppresses acknowledged duplicates and returns cached results for