=['src-transport-loss','src-nodehost-send']\nf['F-read-pending']['unknowns']=['Whether membership changes invalidate retained confirmations']\nb['B-apply']['writes'].append('Visible lastApplied is published by setLastApplied after all handleEntry calls in a batch return, including node.ApplyConfigChange; internal s.index/s.term advance earlier and are not the exported lastApplied.')\nb['B-apply']['source_ids']+=['src-visible-applied','src-rsm-batch-order'];b['B-apply']['produces_fact_ids']=['F-visible-applied']\nb['B-recovery']['writes'].append('StateMachine.apply publishes snapshot lastApplied and RSM membership before Recover calls node.RestoreRemotes. The latter acquires raftMu separately; no snapshotLock is acquired by stepNode.')\nb['B-recovery']['async_boundaries']=['Snapshot worker calls RSM recovery; after visible snapshot index publication it invokes RestoreRemotes, which competes for raftMu with stepNode. Initial node stepping is separately blocked until initialized.']\nb['B-recovery']['unknowns'].append('Can an initialized node step/elect with snapshot-visible lastApplied but old Peer membership before RestoreRemotes acquires raftMu?')\nb['B-recovery']['source_ids']+=['src-rsm-recover-entry','src-visible-applied','src-node-recover-worker','src-engine-recover-worker','src-node-step','src-recovery-dispatch'];b['B-recovery']['produces_fact_ids']=['F-visible-applied']\nb['B-authority']['consumes_fact_ids']=['F-visible-applied'];b['B-authority']['reads']=['node.updateAppliedIndex reads RSM.GetLastApplied and passes it to Peer before handling message/tick events; hasConfigChangeToApply compares committed to this reported applied index.'];b['B-authority']['source_ids']+=['src-visible-applied','src-node-step']\nm['facts'].append(dict(id='F-visible-applied',meaning='The RSM publicly reports an applied log/snapshot index. Ordinary entry batches publish after their callbacks return; snapshot recovery publishes during apply before the subsequent RestoreRemotes callback. This assertion alone does not establish that Peer membership already matches the published snapshot.',identity={'node':'clusterID/nodeID','prefix':'lastApplied.index'},validity_context='Per-node RSM visibility under lastApplied mutex; read by step worker independently of RSM.mu and snapshotLock.',representation=['StateMachine.lastApplied.index/term','GetLastApplied()'],durability='Volatile visibility reconstructed from application/log or snapshot; separate from durable log state.',recovery='Snapshot apply sets visible index/term directly before Recover invokes RestoreRemotes.',source_ids=['src-visible-applied','src-rsm-batch-order','src-rsm-recover','src-rsm-recover-entry','src-node-step'],unknowns=['Whether step scheduling can consume the snapshot-visible index while Peer membership is still stale']))\nco=m['core_overview'];co['open_details']=[x for x in co['open_details'] if x not in ['Remote prefix read-response correlation','Transport batching and message-loss history for a fixed witness']];co['open_details'].append('Snapshot applied-index publication versus Peer membership restoration and election admission')\nco['connection']['explanation']=co['connection']['explanation'].replace('making remote prefix correlation a concrete unresolved consumption premise.','but remote prefix publication substitutes the confirming context for earlier remote requests. Ordinary configuration callbacks complete before visible batch lastApplied publication; snapshot recovery instead publishes its visible index before RestoreRemotes. Whether a step can use that interval for election is an open authority premise.')\n# The accepted prose uses a slightly different clause; ensure the higher-level account is explicit.\nif 'snapshot recovery instead' not in co['connection']['explanation']:\n co['connection']['explanation'] += ' Remote prefix response identity loss has now been measured and reviewed separately. Ordinary config callbacks precede visible batch applied publication; snapshot apply publishes before RestoreRemotes, leaving an open election-admission ordering premise.'\nco['connection']['explanation']=co['connection']['explanation'].replace('making remote prefix correlation a concrete unresolved consumption premise','with a measured remote-prefix context substitution')\nco['connection']['fact_ids'].append('F-visible-applied')\nfor p in ['formation','context','connection']:\n path=co[p];lookup={x['id']:x for x in m['behaviors']+m['facts']};path['source_ids']=list(dict.fromkeys(path['source_ids']+[s for i in path['behavior_ids']+path['fact_ids'] for s in lookup[i]['source_ids']]))\nm['surfaces'].append(dict(entry_point='StateMachine.Recover -> apply -> node.RestoreRemotes',disposition='mapped',behavior_ids=['B-recovery','B-authority'],reason='Visible applied index may cross the election barrier before the corresponding snapshot membership is installed in Peer; competing locks require schedule investigation.',source_ids=['src-rsm-recover-entry','src-rsm-recover','src-node-members','src-node-step'],high_consequence=True))\nchanges={}\nfor i,impact in [('B-read-confirm','clarification'),('B-read-forward','clarification'),('F-read-pending','clarification'),('B-apply','dependency'),('B-recovery','dependency'),('B-authority','dependency')]:\n changes[i]=dict(impact=impact,source_ids=list(dict.fromkeys((b.get(i) or f.get(i))['source_ids'])),rationale='Retain answered read correlation in its source mechanism and add the separate applied-index producer/consumer relationship. The new Fact deliberately distinguishes ordinary batch and snapshot publication ordering.',preserves='C-read-prefix-identity and its fixed check remain unchanged: stable membership and no snapshot/recovery were explicit premises, and no request identity, requirement, oracle or executed bytes change.')\nq=dict(question='Can an initialized node consume a snapshot-published lastApplied and campaign using its old Peer membership before the snapshot RestoreRemotes callback installs