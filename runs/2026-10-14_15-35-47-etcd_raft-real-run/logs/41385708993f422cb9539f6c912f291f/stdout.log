raft-real-run\",\n  \"started_at\": \"2026-10-14T07:35:48.335588+00:00\",\n  \"ended_at\": \"2026-10-14T07:35:48.346539+00:00\",\n  \"exit_code\": 0,\n  \"stdout\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run/logs/87b6a3aee7624c188a7c09da270c6b38/stdout.log\",\n  \"stderr\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run/logs/87b6a3aee7624c188a7c09da270c6b38/stderr.log\",\n  \"reason\": \"\",\n  \"tool_version\": \"unknown\",\n  \"snapshot_id\": \"6d28710f29264921841841eece2388b0\",\n  \"parameters\": {\n   \"timeout_limit\": \"action_timeout\",\n   \"timeout_seconds\": 600.0\n  },\n  \"artifacts\": [],\n  \"pending_action_id\": null\n },\n {\n  \"experiment_id\": null,\n  \"id\": \"1b539c0efe17434d89696546f5fe27cc\",\n  \"action\": \"codex_profile_bootstrap\",\n  \"status\": \"completed\",\n  \"outcome\": \"unknown\",\n  \"origin\": \"executed\",\n  \"command\": [\n   \"bwrap\",\n   \"--unshare-net\",\n   \"--ro-bind\",\n   \"/\",\n   \"/\",\n   \"--bind\",\n   \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run\",\n   \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run\",\n   \"--bind\",\n   \"/home/nitro/.codex\",\n   \"/home/nitro/.codex\",\n   \"--proc\",\n   \"/proc\",\n   \"--dev\",\n   \"/dev\",\n   \"--\",\n   \"codex\",\n   \"debug\",\n   \"prompt-input\",\n   \"Local configuration initialization only.\",\n   \"-c\",\n   \"default_permissions=\\\"ca_audit\\\"\",\n   \"-c\",\n   \"permissions.ca_audit.filesystem={\\\":root\\\"=\\\"deny\\\",\\\":minimal\\\"=\\\"read\\\",\\\":slash_tmp\\\"=\\\"deny\\\",\\\"/tmp\\\"=\\\"deny\\\",\\\"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run/agent-source\\\"=\\\"read\\\",\\\"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run/draft\\\"=\\\"write\\\",\\\"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_