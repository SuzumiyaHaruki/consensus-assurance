meout_ceiling_seconds\": 600.0,\n      \"note\": \"Capacity is not a runtime estimate. Include construction/review time; source work remains useful if a test will not fit.\"\n    }\n  },\n  \"current\": {},\n  \"validation\": {\n    \"command\": [\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin/python\",\n      \"-I\",\n      \"-B\",\n      \"-c\",\n      \"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\",\n      \"validate\",\n      \"--run\",\n      \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run\",\n      \"--submission\"\n    ],\n    \"read_only_paths\": [\n      \"/home/nitro/Desktop/consensus-assurance/src\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/lib/python3.10/site-packages\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/bin\",\n      \"/home/nitro/Desktop/consensus-assurance/.venv/pyvenv.cfg\"\n    ]\n  },\n  \"tools\": {\n    \"agent\": \"codex-cli 0.162.0-alpha.17.2\",\n    \"implementation\": \"go version go1.26.7 linux/amd64\"\n  },\n  \"build_inputs\": [],\n  \"implementation\": {\n    \"name\": \"go_module\",\n    \"harness_kind\": \"go_test\",\n    \"harness_filename\": \"assurance_generated_test.go\",\n    \"default_execution_package\": \".\",\n    \"instructions\": \"Use TestAssurance-prefixed Go tests in the selected local package; derive its declaration from actual source, including valid external test packages. The controller runs Go directly. Emit CA_EVENT JSON using fmt.Println or t.Log. Dependencies are offline; inspect actual source before using internal APIs.\",\n    \"network\": \"Agent shell networking is disabled. Isolated target execution may communicate only inside its private network namespace.\",\n    \"support_path\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-14_15-35-47-etcd_raft-real-run/target-support\"\n  },\n  \"example\": {\n    \"rationale\":