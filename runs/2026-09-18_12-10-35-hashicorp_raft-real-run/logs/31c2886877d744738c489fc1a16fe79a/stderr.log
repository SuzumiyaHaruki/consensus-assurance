oints":["Raft.runFSM","FSM.Apply","BatchingFSM.ApplyBatch","FSM.Restore","FSM.Snapshot"],"behavior_ids":["B6","B7"],"variants":["BatchingFSM","ConfigurationStore"],"unknowns":["Remaining runFSM channel dispatch","Producer and ordering of commit tuples","Application-specific determinism and snapshot isolation"],"source_ids":["fsm.go:1:80","fsm.go:81:240"]},{"class_id":"A6","applicability":"applicable","purpose":"Persist, publish, replace and reclaim recovery evidence.","realization_summary":"Snapshot creation persists an FSM capture before updating snapshot metadata and compacting logs. FileSnapshotSink closes resources, writes metadata, renames the directory and reaps old snapshots. Concrete normal-log persistence remains unread.","entry_points":["Raft.takeSnapshot","Raft.compactLogsWithTrailing","Raft.removeOldLogs","FileSnapshotSink.Close","FileSnapshotSink.Cancel"],"behavior_ids":["B8","B9","B10","B11","B14"],"variants":["File synchronization flags and platform behavior","Trailing-log retention","Whole-log removal after monotonic-store restore"],"unknowns":["Snapshot Create/Open/List and retention semantics","Metadata synchronization","Stable term and vote persistence","Built-in storage error behavior"],"source_ids":["snapshot.go:125:278","file_snapshot.go:397:500","raft.go:1814:1955"]},{"class_id":"A7","applicability":"applicable","purpose":"Expose operation admission, completion and read-related coordination.","realization_summary":"ApplyLog, Barrier and VerifyLeader enqueue futures. Candidate processing rejects these operations. FSM handlers respond to application futures after callback handling. API comments explicitly describe ambiguous leadership-loss outcomes and restore abortion.","entry_points":["Raft.ApplyLog","Raft.Barrier","Raft.VerifyLeader","Raft.GetConfiguration"],"behavior_ids":["B1","B3"],"variants":["Positive enqueue timeout versus no timer","Command versus barrier","Candidate rejection"],"unknowns":["Future synchronization implementation","Lead