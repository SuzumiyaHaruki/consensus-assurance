,\"voters\":[2]}\nCA_EVENT {\"event\":\"configuration_applied\",\"index\":3,\"learners\":[1],\"node\":2,\"voters\":[2]}\nCA_EVENT {\"applied\":3,\"event\":\"demotion_complete\",\"node\":1,\"role\":\"StateLeader\",\"term\":2}\nCA_EVENT {\"applied\":3,\"event\":\"demotion_complete\",\"node\":2,\"role\":\"StateFollower\",\"term\":2}\nCA_EVENT {\"event\":\"message_dropped\",\"from\":2,\"message_type\":\"MsgApp\",\"to\":1}\nCA_EVENT {\"event\":\"write_completed\",\"index\":5,\"node\":2,\"value\":\"new\"}\nCA_EVENT {\"applied\":3,\"event\":\"read_admitted\",\"isolated\":true,\"node\":1,\"request\":\"fresh-read-1\",\"role\":\"StateLeader\",\"run\":\"demotion\",\"safe_mode\":true,\"term\":2,\"write_index\":5}\nCA_EVENT {\"admission_known\":true,\"applied\":3,\"event\":\"read_result\",\"incoming_since_admission\":0,\"local_is_sole_voter\":false,\"node\":1,\"read_index\":3,\"request\":\"fresh-read-1\",\"response_number\":1,\"result_emitted\":true,\"role\":\"StateLeader\",\"run\":\"demotion\",\"term\":2,\"value\":\"old\"}\nCA_EVENT {\"applied\":3,\"event\":\"read_window_closed\",\"incoming_since_admission\":0,\"node\":1,\"request\":\"fresh-read-1\",\"results\":1,\"run\":\"demotion\"}\nCA_EVENT {\"applied\":5,\"event\":\"read_admitted\",\"isolated\":true,\"node\":2,\"request\":\"fresh-read-2\",\"role\":\"StateLeader\",\"run\":\"demotion\",\"safe_mode\":true,\"term\":3,\"write_index\":5}\nCA_EVENT {\"admission_known\":true,\"applied\":5,\"event\":\"read_result\",\"incoming_since_admission\":0,\"local_is_sole_voter\":true,\"node\":2,\"read_index\":5,\"request\":\"fresh-read-2\",\"response_number\":1,\"result_emitted\":true,\"role\":\"StateLeader\",\"run\":\"demotion\",\"term\":3,\"value\":\"new\"}\nCA_EVENT {\"applied\":5,\"event\":\"read_window_closed\",\"incoming_since_admission\":0,\"node\":2,\"request\":\"fresh-read-2\",\"results\":1,\"run\":\"demotion\"}\n","exit_code":0,"status":"completed"}}
