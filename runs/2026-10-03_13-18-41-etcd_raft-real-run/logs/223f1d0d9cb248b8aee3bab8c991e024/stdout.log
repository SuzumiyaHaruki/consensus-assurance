every read must complete.\",\n      \"Global linearizability endpoint without a separate observed client history.\"\n    ],\n    \"parameters\": {\n      \"ReadOnlyOption\": \"ReadOnlySafe\",\n      \"StepDownOnRemoval\": false\n    }\n  },\n  \"raw_log\": \"/home/nitro/Desktop/consensus-assurance/runs/2026-10-03_13-18-41-etcd_raft-real-run/logs/e94f713eff47485582d7004dd190b24e/stdout.log\",\n  \"parsing_errors\": [],\n  \"prerequisites\": {\n    \"status\": \"matched\",\n    \"reason\": \"Declared prerequisites established\",\n    \"matched_indices\": [\n      6\n    ],\n    \"alias_indices\": {\n      \"admission\": 6\n    }\n  },\n  \"properties\": [\n    {\n      \"monitor_id\": \"monitor-singleton\",\n      \"checker_id\": \"singleton-eligibility\",\n      \"outcome\": \"violated\",\n      \"witness_indices\": [\n        7\n      ],\n      \"valid_witness_indices\": [\n        7\n      ],\n      \"witness_complete\": true,\n      \"comparison_complete\": true,\n      \"missing_indices\": [],\n      \"evaluated_indices\": [\n        7,\n        10\n      ],\n      \"outside_applicability_indices\": [],\n      \"correlations\": {\n        \"7\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            6\n          ],\n          \"alias_indices\": {\n            \"admission\": 6\n          }\n        },\n        \"10\": {\n          \"status\": \"matched\",\n          \"reason\": \"Declared prerequisites established\",\n          \"matched_indices\": [\n            9\n          ],\n          \"alias_indices\": {\n            \"admission\": 9\n          }\n        }\n      },\n      \"diagnostics\": [],\n      \"limitations\": [],\n      \"reason\": \"Independent applicability, correlated prerequisites and fully observed result comparison\",\n      \"confirmed\": false\n    }\n  ],\n  \"adaptations\": [\n    \"No target edits. Host state machine stores the last nonempty norma