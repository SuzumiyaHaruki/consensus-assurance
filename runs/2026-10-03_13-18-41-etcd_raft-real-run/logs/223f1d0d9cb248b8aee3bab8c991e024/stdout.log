{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'cat ../direct-checks/b1ac8b0d3d584f8b90f1f75b49f9c285/plan.json; cmp singleton_read_test.go ../direct-checks/b1ac8b0d3d584f8b90f1f75b49f9c285/assurance_generated_test.go'","aggregated_output":"{\n  \"description\": \"Execute a two-voter election, commit and apply leader 1 demotion to learner, isolate the peers, elect sole voter 2 and apply a new write. Invoke fresh reads separately on learner 1 and voter 2 and drain all bounded Ready work. Measure shortcut eligibility on actual ReadStates, preserving missing results and diagnostics. The current voter is the permitted control; write/read indexes and application values are consequence diagnostics, not a global linearizability oracle.\",\n  \"claim_id\": \"o-singleton-read-eligibility\",\n  \"binding_ids\": [\n    \"bind-singleton\"\n  ],\n  \"harness\": {\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package raft\\n\\nimport (\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"testing\\\"\\n pb \\\"go.etcd.io/raft/v3/raftpb\\\"\\n)\\n\\nfunc TestAssuranceSingletonReadEligibility(t *testing.T) {\\n type replica struct {\\n  rn *RawNode\\n  store *MemoryStorage\\n  applied uint64\\n  value string\\n  writeIndex uint64\\n  incoming int\\n }\\n nodes := map[uint64]*replica{}\\n emit := func(e map[string]interface{}) {\\n  b, err := json.Marshal(e); if err != nil { t.Fatal(err) }\\n  fmt.Println(\\\"CA_EVENT \\\" + string(b))\\n }\\n for _, id := range []uint64{1,2} {\\n  st := NewMemoryStorage()\\n  // Common initial snapshot is the declared bootstrap state. Subsequent\\n  // election, commitment, configuration change and application all execute.\\n  if err := st.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{\\n   Index:1, Term:1, ConfState:pb.ConfState{Voters:[]uint64{1,2}},\\n  }}); err != nil {t.Fatal(err)}\\n  if err := st.SetHardState(pb.HardState{Term:1,Commit:1}); err != nil {t.Fatal(err)}\\n  rn, err := NewRawNode(&Config{ID:id, ElectionTick:10, HeartbeatTick:1,\\n   Storage:st, Applied:1, MaxSizePerMsg:4096, MaxInflightMsgs:256,\\n   ReadOnlyOption:ReadOnlySafe, StepDownOnRemoval:false})\\n  if err != nil {t.Fatal(err)}\\n  nodes[id]= &replica{rn:rn,store:st,applied:1,value:\\\"old\\\"}\\n }\\n isolated := false\\n var queue []pb.Message\\n admissionIncoming := map[string]int{}\\n results := map[string]int{}\\n // This pump drains bounded work independently of any read result. It persists\\n // and applies every accepted Ready, then Advances; no early-Advance shortcut.\\n pump := func() {\\n  for round:=0; round<200; round++ {\\n   work:=false\\n   for _, id := range []uint64{1,2} {\\n    n:=nodes[id]\\n    if !n.rn.HasReady() {continue}\\n    work=true\\n    rd:=n.rn.Ready()\\n    if !IsEmptySnap(rd.Snapshot) {t.Fatal(\\\"unexpected runtime snapshot\\\")}\\n    if err:=n.store.Append(rd.Entries); err!=nil {t.Fatal(err)}\\n    if !IsEmptyHardState(rd.HardState) {if err:=n.store.SetHardState(rd.HardState);err!=nil {t.Fatal(err)}}\\n    for _, e:=range rd.CommittedEntries {\\n     if e.Index!=n.applied+1 {t.Fatalf(\\\"node %d nonconsecutive apply %d after %d\\\",id,e.Index,n.applied)}\\n     switch e.Type {\\n     case pb.EntryConfChange:\\n      var cc pb.ConfChange\\n      if err:=cc.Unmarshal(e.Data);err!=nil {t.Fatal(err)}\\n      cs:=n.rn.ApplyConfChange(cc)\\n      emit(map[string]interface{}{\\\"event\\\":\\\"configuration_applied\\\",\\\"node\\\":id,\\\"index\\\":e.Index,\\\"voters\\\":cs.Voters,\\\"learners\\\":cs.Learners})\\n     case pb.EntryNormal:\\n      if len(e.Data)>0 {n.value=string(e.Data);n.writeIndex=e.Index}\\n     default:t.Fatalf(\\\"unexpected entry type %v\\\",e.Type)\\n     }\\n     n.applied=e.Index\\n    }\\n    for _, rs:=range rd.ReadStates {\\n     request:=string(rs.RequestCtx)\\n     s:=n.rn.Status()\\n     voters:=s.Config.Voters.IDs()\\n     _,member:=voters[id]\\n     soleLocal:=len(s.Config.Voters[0])==1 && len(s.Config.Voters[1])==0 && member\\n     count, admitted:=admissionIncoming[request]\\n     results[request]++\\n     emit(map[string]interface{}{\\\"event\\\":\\\"read_result\\\",\\\"run\\\":\\\"demotion\\\",\\\"node\\\":id,\\\"request\\\":request,\\n      \\\"read_index\\\":rs.Index,\\\"applied\\\":n.applied,\\\"value\\\":n.value,\\\"term\\\":s.Term,\\\"role\\\":s.RaftState.String(),\\n      \\\"local_is_sole_voter\\\":soleLocal,\\\"incoming_since_admission\\\":n.incoming-count,\\\"admission_known\\\":admitted,\\n      \\\"response_number\\\":results[request],\\\"result_emitted\\\":true})\\n    }\\n    queue=append(queue,rd.Messages...)\\n    n.rn.Advance(rd)\\n   }\\n   if len(queue)>0 {\\n    work=true\\n    msgs:=queue;queue=nil\\n    for _, msg:=range msgs {\\n     if isolated && msg.From!=msg.To {\\n      emit(map[string]interface{}{\\\"event\\\":\\\"message_dropped\\\",\\\"from\\\":msg.From,\\\"to\\\":msg.To,\\\"message_type\\\":msg.Type.String()})\\n      continue\\n     }\\n     n:=nodes[msg.To];if n==nil {t.Fatalf(\\\"unknown recipient %d\\\",msg.To)}\\n     n.incoming++\\n     if err:=n.rn.Step(msg);err!=nil {t.Fatal(err)}\\n    }\\n   }\\n   if !work {return}\\n  }\\n  t.Fatal(\\\"work bound exceeded\\\")\\n }\\n if err:=nodes[1].rn.Campaign();err!=nil {t.Fatal(err)}\\n pump()\\n if nodes[1].rn.Status().RaftState!=StateLeader {t.Fatal(\\\"initial leader not elected\\\")}\\n if err:=nodes[1].rn.ProposeConfChange(pb.ConfChange{Type:pb.ConfChangeAddLearnerNode,NodeID:1});err!=nil {t.Fatal(err)}\\n pump()\\n for _,id:=range []uint64{1,2} {\\n  s:=nodes[id].rn.Status()\\n  _,voter2:=s.Config.Voters[0][2];_,learner1:=s.Config.Learners[1]\\n  if len(s.Config.Voters[0])!=1 || len(s.Config.Voters[1])!=0 || !voter2 || !learner1 {t.Fatalf(\\\"demotion not installed on %d: %+v\\\",id,s.Config)}\\n  emit(map[string]interface{}{\\\"event\\\":\\\"demotion_complete\\\",\\\"node\\\":id,\\\"role\\\":s.RaftState.String(),\\\"applied\\\":nodes[id].applied,\\\"term\\\":s.Term})\\n }\\n isolated=true\\n if err:=nodes[2].rn.Campaign();err!=nil {t.Fatal(err)}\\n pump()\\n if nodes[2].rn.Status().RaftState!=StateLeader {t.Fatal(\\\"remaining voter not elected\\\")}\\n if err:=nodes[2].rn.Propose([]byte(\\\"new\\\"));err!=nil {t.Fatal(err)}\\n pump()\\n if nodes[2].value!=\\\"new\\\" || nodes[2].writeIndex==0 {t.Fatal(\\\"new write did not apply\\\")}\\n emit(map[string]interface{}{\\\"event\\\":\\\"write_completed\\\",\\\"node\\\":uint64(2),\\\"index\\\":nodes[2].writeIndex,\\\"value\\\":nodes[2].value})\\n // Each invocation has a new context. Both the suspect learner and the valid\\n // current singleton voter are observed; no returned state is suppressed.\\n for _,id:=range []uint64{1,2} {\\n  n:=nodes[id];request:=fmt.Sprintf(\\\"fresh-read-%d\\\",id)\\n  admissionIncoming[request]=n.incoming\\n  s:=n.rn.Status()\\n  emit(map[string]interface{}{\\\"event\\\":\\\"read_admitted\\\",\\\"run\\\":\\\"demotion\\\",\\\"node\\\":id,\\\"request\\\":request,\\n   \\\"safe_mode\\\":true,\\\"isolated\\\":isolated,\\\"role\\\":s.RaftState.String(),\\\"term\\\":s.Term,\\n   \\\"write_index\\\":nodes[2].writeIndex,\\\"applied\\\":n.applied})\\n  n.rn.ReadIndex([]byte(request))\\n  pump()\\n  emit(map[string]interface{}{\\\"event\\\":\\\"read_window_closed\\\",\\\"run\\\":\\\"demotion\\\",\\\"node\\\":id,\\\"request\\\":request,\\n   \\\"results\\\":results[request],\\\"incoming_since_admission\\\":n.incoming-admissionIncoming[request],\\\"applied\\\":n.applied})\\n }\\n}\\n\",\n    \"description\": \"Public RawNode driver with MemoryStorage modeling completed persistence and no crashes. A common index-1 snapshot supplies only initial membership/history. All subsequent election messages, demotion proposal/commit/application, successor election and write commitment execute through target APIs. Deterministic network delivers messages until quiescence before partition, then drops inter-node messages. No protocol implementation is substituted.\",\n    \"semantic_changes\": [\n      \"No target edits. Host state machine stores the last nonempty normal entry as a diagnostic value.\",\n      \"Network isolation is modeled by dropping inter-node messages; no messages or votes are fabricated.\",\n      \"RawNode.Status and Ready.ReadStates are observational APIs; CA_EVENT records host scheduling and output.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"admission\",\n        \"event\": \"read_admitted\",\n        \"conditions\": [\n          {\n            \"field\": \"safe_mode\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          },\n          {\n            \"field\": \"isolated\",\n            \"op\": \"eq\",\n            \"value\": true,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"s-raw-api\",\n        \"s-ready-contract\",\n        \"s-node-contract\",\n        \"s-config-changer\",\n        \"s-restart\",\n        \"s-storage-contract\",\n        \"s-memory-storage\",\n        \"s-safe-read-option\",\n        \"s-removal-option\"\n      ],\n      \"expectation_ids\": [\n        \"s-ready-contract\",\n        \"s-node-contract\",\n        \"s-raw-api\"\n      ],\n      \"binding_ids\": [\n        \"bind-singleton\"\n      ],\n      \"derivation\": \"NewRawNode recommends initial Storage snapshot membership. Ready entries/HardState are stored before queued messages are delivered; committed entries are applied consecutively with ApplyConfChange before Advance. Demotion uses public ProposeConfChange and Changer.Simple changes one voter. StepDownOnRemoval=false is supported; learner remains a participant. Only actual generated messages reach Step; isolation occurs after both nodes install demotion.\",\n      \"applicability\": \"No crashes or disk-failure model. Two initial voters are allowed though README recommends larger deployments for availability. Common bootstrap snapshot is declared, not represented as an executed prehistory.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": []\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"monitor-singleton\",\n      \"checker_id\": \"singleton-eligibility\",\n      \"event\": \"read_result\",\n      \"binding_ids\": [\n        \"bind-singleton\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s-safe-read-option\",\n          \"s-singleton-predicate\",\n          \"s-config\",\n          \"s-config-changer\",\n          \"s-proposal-read\",\n          \"s-read-contract\"\n        ],\n        \"expectation_ids\": [\n          \"s-safe-read-option\",\n          \"s-singleton-predicate\"\n        ],\n        \"binding_ids\": [\n          \"bind-singleton\"\n        ],\n        \"derivation\": \"Observe actual returned ReadStates for fresh requests in ReadOnlySafe with no incoming message during each read. Under the accepted singleton shortcut duty, the local node must be the sole installed voter; compute that predicate from Status.Config membership, not role or the shortcut result.\",\n        \"applicability\": \"Actual two-node demotion history; all configuration entries applied before Advance. Read completion is optional: a missing result remains unknown rather than requiring success.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": [\n          \"No ReadState is a permitted pending outcome; the current sole voter supplies a positive completion control.\"\n        ]\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"admission\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"singleton-eligibility\",\n      \"kind\": \"event_implication\",\n      \"trigger\": {\n        \"field\": \"result_emitted\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"local_is_sole_voter\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"antecedent\": {\n        \"field\": \"incoming_since_admission\",\n        \"op\": \"eq\",\n        \"value\": 0,\n        \"reference\": null\n      },\n      \"identity_fields\": [\n        \"run\",\n        \"node\",\n        \"request\"\n      ],\n      \"description\": \"For an observed ReadState produced with no incoming quorum message after this fresh read admission, the responding node must itself be the sole installed voter. The control may return; the learner may remain pending. No completion is forced.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"The checked proposition is local read-support eligibility, not a measured client linearizability endpoint.\",\n    \"No crash persistence or asynchronous-storage ordering is exercised.\",\n    \"An initial common snapshot substitutes bootstrap prehistory; all histories material to demotion and reads execute.\"\n  ]\n}","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The trusted execution measured a violation of the local eligibility requirement: learner 1 returned read index 3 without receiving any message during the read, after voter 2 had applied the new write at index 5. The voter control returned index 5. I’ll submit the correspondence review; these observations do not by themselves establish a client-visible stale read.\n"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\ns=dict(action='review',artifact_id='9050f0c543c046d98f7220703a46ed84',rationale='Review the executed fixed driver and oracle against the accepted singleton eligibility obligation; the measured learner result is a complete local violation witness, while wider client consequences remain excluded.',review_items=[dict(aspect='checker_correspondence',status='no_issue_found',source_ids=['s-safe-read-option','s-singleton-predicate','s-removal-option','s-config','s-config-changer','s-read-contract','s-raw-api','s-ready-contract','s-node-contract','s-restart','s-memory-storage','s-read-result','s-proposal-read'],rationale='Reviewed artifact 9050f0c543c046d98f7220703a46ed84 version 1, fixed plan and byte-identical assurance_generated_test.go, and execution e94f713eff47485582d7004dd190b24e with its monitor_result and raw CA_EVENT outputs. Applicability: ReadOnlySafe explicitly promises quorum-based linearizable read authority. The singleton shortcut may replace a quorum round only when its local node constitutes that quorum; learner membership cannot supply the sole voter support. StepDownOnRemoval=false changes role transition, not that read obligation. The selected node remains a learner, so this does not depend on a removed-node host shutdown policy. Entry and history: public NewRawNode starts two peers from an explicit common snapshot at index 1; Campaign, generated messages, persistence-delayed self/peer replies and ProposeConfChange produce actual election and commitment. Changer.Simple legally demotes one voter. Both configuration_applied events report voters=[2], learners=[1], index=3. Host stores all Ready entries/HardState, applies committed entries in strict index order with ApplyConfChange, and only then Advances and delivers queued messages. No early Advance, role mutation, fabricated acknowledgment, lease or dropped local storage completion is used. Isolation begins only after both configurations are installed; actual voter 2 campaigns, persists and commits its term-3 no-op and normal write at index 5. Correlation: admission_alias explicitly names read_admitted, with independent run/node/fresh RequestCtx identity shared by the result. Results are emitted from every Ready.ReadState without expected-outcome filtering; membership is read independently from Status.Config, not from IsSingleton. Both operations have one result and a bounded quiescence-close event. The zero incoming-message antecedent is supported by the deterministic network driver, counters, unique fresh contexts, no prior read requests and partition; no pending old read/quorum support can satisfy this request. Oracle: result-emitted with no post-admission quorum message implies local-is-sole-voter; this is a necessary support eligibility condition, not a requirement that a read complete. Actual learner result at read index 3 has local_is_sole_voter=false and incoming_since_admission=0, so it violates the claim. The same-history voter control returns index 5 with local_is_sole_voter=true and no incoming messages, corroborating the permitted shortcut case. The fixed monitor evaluates both, with complete unique correlations and no parsing errors. Source dispatch connects the learner StateLeader to the cardinality-only shortcut, supporting the proposed local cause; no global client endpoint is attributed.',counterevidence=['StepDownOnRemoval=true would prevent retaining the learner leader role; this alternate configuration is outside the checked false setting.','Non-singleton ReadOnlySafe uses actual voter heartbeat acknowledgments and is not shown defective by this check.','The returned index/value diagnostics show stale local state relative to the new write, but the driver does not execute a client read-barrier consumption API; no broader linearizability verdict is claimed.'],limitations=['Only the local singleton read-support eligibility obligation is assessed.','Initial snapshot membership and index-1 prefix are declared bootstrap inputs; they are not claimed as produced by this execution. All demotion/election/read-relevant subsequent history executes.','MemoryStorage models completed writes without crashes; real persistence faults and asynchronous storage are outside scope.','No claim that every read must complete; a missing output would remain unknown rather than a liveness violation.'],report_title='降级为 learner 的旧领导者仍通过单节点读捷径',report_answer='在 StepDownOnRemoval=false、ReadOnlySafe 模式下，双方已应用降级配置后，旧领导者作为 learner 在未收到任何读期间消息的情况下返回索引 3；唯一投票节点已应用索引 5 的新写入。该结果违反本次检查的单节点读支持资格要求；尚未据此认定客户端线性一致性端点违规。')],feedback=dict(ref_ids=['e0d801b078524898adcb8fa69969d946','9050f0c543c046d98f7220703a46ed84','e94f713eff47485582d7004dd190b24e','b-read','b-membership','s-singleton-predicate','s-config'],answered='The actual two-node public RawNode history admits and applies leader demotion to learner. With singleton voters=[2], learner 1 retains StateLeader and returns fresh-read-1 at index 3 with zero incoming messages, while node 2 has applied write index 5 and returns its own fresh read at 5. This answers both pending reachability/result premises for the local shortcut eligibility requirement.',remaining=['A client read consumption endpoint and broader linearizability consequences are outside the accepted check.','Independent early-Advance contract ambiguity remains paused.','Other formation and context relationships remain available for investigation.'],understanding='updated',rationale='The review relates actual fixed input history and observations to the local requirement, preserving alternative protections and independent consequence limits.'))\njson.dump(s,open('submission-singleton-review.json','w'),indent=2)\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-03_13-18-41-etcd_raft-real-run --submission submission-singleton-review.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
