{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nr=json.load(open('../research.json'))\nfor k in ['capacity','units','claims','pending_work']: print(k,json.dumps(r[k],indent=2))\ns=json.load(open('../product-schemas.json'))['DirectCheckPlan']\nprint('PLAN',json.dumps({k:v for k,v in s.items() if k\"'!='\"'\"'$defs'\"'},indent=2))\nfor k,v in s['\"'$defs'\"'].items(): print(k,'required',v.get('required'),'fields',list(v.get('properties',{})))\nPY\"","aggregated_output":"capacity {\n  \"remaining\": {\n    \"agent_calls\": 34,\n    \"experiments\": 15,\n    \"audit_units\": 5,\n    \"semantic_reviews\": 10,\n    \"revisions\": 6\n  },\n  \"remaining_seconds\": 1224.1210200889982,\n  \"new_obligation\": true,\n  \"direct_execution\": true,\n  \"source_investigation\": true,\n  \"exhausted\": []\n}\nunits [\n  {\n    \"id\": \"unit-o-singleton-read-eligibility\",\n    \"candidate_id\": \"e0d801b078524898adcb8fa69969d946\",\n    \"obligation_ids\": [\n      \"o-singleton-read-eligibility\"\n    ],\n    \"binding_ids\": [\n      \"bind-singleton\"\n    ],\n    \"relation_ids\": [],\n    \"scope\": {\n      \"description\": \"Eligibility of the local-only ReadOnlySafe shortcut after a fully applied leader-to-learner demotion, with StepDownOnRemoval disabled.\",\n      \"assumptions\": [\n        \"Non-Byzantine peers and immutable unique IDs.\",\n        \"Configuration change is committed using the prior configuration and applied in order.\",\n        \"Caller persists Ready state before sends and calls ApplyConfChange before Advance.\",\n        \"Read request uses a fresh unique context; no incoming voter message is delivered after invocation.\"\n      ],\n      \"excluded\": [\n        \"Lease-based reads and clock assumptions.\",\n        \"Early Advance before configuration application.\",\n        \"A requirement that every read must complete.\",\n        \"Global linearizability endpoint without a separate observed client history.\"\n      ],\n      \"parameters\": {\n        \"ReadOnlyOption\": \"ReadOnlySafe\",\n        \"StepDownOnRemoval\": false\n      }\n    },\n    \"rationale\": \"Ground a narrow singleton read-support eligibility duty from the public safe-read contract and actual voter configuration, while preserving wider stale-read consequences as limits.\",\n    \"status\": \"pending\",\n    \"previous_id\": null,\n    \"version\": 1,\n    \"boundary_changes\": [],\n    \"obligation_checks\": {},\n    \"remaining_obligation_ids\": [\n      \"o-singleton-read-eligibility\"\n    ],\n    \"recheck_reasons\": [],\n    \"coverage_limitations\": [],\n    \"progress\": [\n      {\n        \"claim_id\": \"o-singleton-read-eligibility\",\n        \"record_status\": \"no_fixed_check\"\n      }\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"units\",\n      \"match\": {\n        \"id\": \"unit-o-singleton-read-eligibility\",\n        \"version\": 1\n      }\n    }\n  }\n]\nclaims [\n  {\n    \"id\": \"o-singleton-read-eligibility\",\n    \"kind\": \"obligation\",\n    \"concern\": \"consensus_safety\",\n    \"description\": \"In ReadOnlySafe mode, completing a ReadIndex request through the singleton shortcut without a quorum-confirmation round requires that the local responding node be the sole voter in its installed configuration. A retained learner leader with a different sole voter must not complete the request using only its local state.\",\n    \"scope\": {\n      \"description\": \"Eligibility of the local-only ReadOnlySafe shortcut after a fully applied leader-to-learner demotion, with StepDownOnRemoval disabled.\",\n      \"assumptions\": [\n        \"Non-Byzantine peers and immutable unique IDs.\",\n        \"Configuration change is committed using the prior configuration and applied in order.\",\n        \"Caller persists Ready state before sends and calls ApplyConfChange before Advance.\",\n        \"Read request uses a fresh unique context; no incoming voter message is delivered after invocation.\"\n      ],\n      \"excluded\": [\n        \"Lease-based reads and clock assumptions.\",\n        \"Early Advance before configuration application.\",\n        \"A requirement that every read must complete.\",\n        \"Global linearizability endpoint without a separate observed client history.\"\n      ],\n      \"parameters\": {\n        \"ReadOnlyOption\": \"ReadOnlySafe\",\n        \"StepDownOnRemoval\": false\n      }\n    },\n    \"source\": \"Candidate derived from attributed implementation responsibilities\",\n    \"source_ids\": [\n      \"s-safe-read-option\",\n      \"s-singleton-predicate\",\n      \"s-config\",\n      \"s-removal-option\",\n      \"s-config-changer\",\n      \"s-read-contract\",\n      \"s-proposal-read\"\n    ],\n    \"pending\": [],\n    \"assessment\": \"unassessed\",\n    \"candidate\": true,\n    \"grounding\": {\n      \"source_ids\": [\n        \"s-singleton-predicate\",\n        \"s-config\",\n        \"s-config-changer\",\n        \"s-proposal-read\"\n      ],\n      \"expectation_ids\": [\n        \"s-safe-read-option\",\n        \"s-read-contract\",\n        \"s-singleton-predicate\"\n      ],\n      \"binding_ids\": [\n        \"bind-singleton\"\n      ],\n      \"derivation\": \"The Config ReadOnlySafe contract guarantees linearizability by quorum communication. Its singleton optimization is documented as the one voting member being the leader. Installed voter sets define who can contribute quorum support; a learner outside the singleton cannot substitute local state for the actual voter. This obligation checks that eligibility condition, not eventual read completion or an equality between leadership and success.\",\n      \"applicability\": \"The host completes configuration installation normally. The implementation option permits retaining the old leader role, but does not weaken ReadOnlySafe. Scope selects a retained learner rather than relying on the duties of a host after complete node removal.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Enabled StepDownOnRemoval transitions the demoted node to follower.\",\n        \"The node could safely leave a read pending or forward it to a current leader instead of returning a local result.\"\n      ]\n    },\n    \"version\": 1,\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"claims\",\n      \"match\": {\n        \"id\": \"o-singleton-read-eligibility\",\n        \"version\": 1\n      }\n    }\n  }\n]\npending_work [\n  {\n    \"id\": \"unit-o-singleton-read-eligibility\",\n    \"candidate_id\": \"e0d801b078524898adcb8fa69969d946\",\n    \"kind\": \"unit\",\n    \"remaining\": [\n      \"o-singleton-read-eligibility\"\n    ],\n    \"record\": {\n      \"path\": \"state.json\",\n      \"collection\": \"units\",\n      \"match\": {\n        \"id\": \"unit-o-singleton-read-eligibility\"\n      }\n    }\n  }\n]\nPLAN {\n  \"additionalProperties\": false,\n  \"description\": \"Concrete investigation of an accepted requirement; execution determines the observed result.\",\n  \"properties\": {\n    \"description\": {\n      \"description\": \"This check\\u2019s discriminator, prefix, controls and observations; reference the accepted claim rather than restating it\",\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    },\n    \"claim_id\": {\n      \"title\": \"Claim Id\",\n      \"type\": \"string\"\n    },\n    \"binding_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Binding Ids\",\n      \"type\": \"array\"\n    },\n    \"harness\": {\n      \"$ref\": \"#/$defs/Harness\"\n    },\n    \"monitors\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/EventMonitor\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Monitors\",\n      \"type\": \"array\"\n    },\n    \"observable_properties\": {\n      \"description\": \"Direct route supports event_assertion and event_implication. Correlate prerequisite fields by alias; observe prerequisites and results from the same legal history. Unsupported general temporal properties must remain an explicit limitation.\",\n      \"items\": {\n        \"$ref\": \"#/$defs/ObservableProperty\"\n      },\n      \"minItems\": 1,\n      \"title\": \"Observable Properties\",\n      \"type\": \"array\"\n    },\n    \"uncertainties\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Uncertainties\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"description\",\n    \"claim_id\",\n    \"binding_ids\",\n    \"harness\",\n    \"monitors\",\n    \"observable_properties\"\n  ],\n  \"title\": \"DirectCheckPlan\",\n  \"type\": \"object\"\n}\nComparison required ['field'] fields ['field', 'op', 'value', 'reference']\nEventMonitor required ['id', 'checker_id', 'event', 'binding_ids', 'grounding'] fields ['id', 'checker_id', 'event', 'binding_ids', 'grounding', 'applicability_conditions', 'admission_alias']\nEventRequirement required ['alias', 'event'] fields ['alias', 'event', 'conditions']\nGrounding required None fields ['source_ids', 'expectation_ids', 'binding_ids', 'derivation', 'applicability', 'unresolved', 'conflicts', 'alternatives']\nHarness required ['kind', 'source', 'description', 'semantic_changes'] fields ['files', 'kind', 'source', 'description', 'semantic_changes', 'prerequisites', 'legality']\nObservableProperty required ['checker_id', 'trigger', 'assertion', 'description'] fields ['checker_id', 'kind', 'trigger', 'assertion', 'antecedent', 'identity_fields', 'description']\n","exit_code":0,"status":"completed"}}
