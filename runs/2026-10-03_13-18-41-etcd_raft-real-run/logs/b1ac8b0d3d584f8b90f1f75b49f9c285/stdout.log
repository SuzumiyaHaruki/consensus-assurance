es\": []\n      }\n    }\n  },\n  \"required\": [\n    \"kind\",\n    \"source\",\n    \"description\",\n    \"semantic_changes\"\n  ],\n  \"title\": \"Harness\",\n  \"type\": \"object\"\n}\nEventMonitor {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"title\": \"Id\",\n      \"type\": \"string\"\n    },\n    \"checker_id\": {\n      \"title\": \"Checker Id\",\n      \"type\": \"string\"\n    },\n    \"event\": {\n      \"title\": \"Event\",\n      \"type\": \"string\"\n    },\n    \"binding_ids\": {\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Binding Ids\",\n      \"type\": \"array\"\n    },\n    \"grounding\": {\n      \"$ref\": \"#/$defs/Grounding\"\n    },\n    \"applicability_conditions\": {\n      \"default\": [],\n      \"items\": {\n        \"$ref\": \"#/$defs/Comparison\"\n      },\n      \"title\": \"Applicability Conditions\",\n      \"type\": \"array\"\n    },\n    \"admission_alias\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"description\": \"Prerequisite alias identifying admitted operations whose completion must be observed; may depend on earlier prerequisites, never on the result or array order\",\n      \"title\": \"Admission Alias\"\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"checker_id\",\n    \"event\",\n    \"binding_ids\",\n    \"grounding\"\n  ],\n  \"title\": \"EventMonitor\",\n  \"type\": \"object\"\n}\nObservableProperty {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"checker_id\": {\n      \"title\": \"Checker Id\",\n      \"type\": \"string\"\n    },\n    \"kind\": {\n      \"default\": \"event_assertion\",\n      \"enum\": [\n        \"event_assertion\",\n        \"event_implication\"\n      ],\n      \"title\": \"Kind\",\n      \"type\": \"string\"\n    },\n    \"trigger\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"assertion\": {\n      \"$ref\": \"#/$defs/Comparison\"\n    },\n    \"antecedent\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/Comparison\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null\n    },\n    \"identity_fields\": {\n      \"description\": \"Independent operation identity shared by prerequisites and result; never the value being compared or a context expected to change\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Identity Fields\",\n      \"type\": \"array\"\n    },\n    \"description\": {\n      \"title\": \"Description\",\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"checker_id\",\n    \"trigger\",\n    \"assertion\",\n    \"description\"\n  ],\n  \"title\": \"ObservableProperty\",\n  \"type\": \"object\"\n}\nComparison {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"field\": {\n      \"title\": \"Field\",\n      \"type\": \"string\"\n    },\n    \"op\": {\n      \"default\": \"eq\",\n      \"enum\": [\n        \"eq\",\n        \"ne\"\n      ],\n      \"title\": \"Op\",\n      \"type\": \"string\"\n    },\n    \"value\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"boolean\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Value\"\n    },\n    \"reference\": {\n      \"anyOf\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ],\n      \"default\": null,\n      \"title\": \"Reference\"\n    }\n  },\n  \"required\": [\n    \"field\"\n  ],\n  \"title\": \"Comparison\",\n  \"type\": \"object\"\n}\nEventRequirement {\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"alias\": {\n      \"title\": \"Alias\",\n      \"type\": \"string\"\n    },\n    \"event\": {\n      \"title\": \"Event\",\n      \"type\": \"string\"\n    },\n    \"conditions\": {\n      \"description\": \"Prerequisite conditions; alias references declare causal predecessors, list position does not\",\n      \"items\": {\n        \"$ref\": \"#/$defs/Comparison\"\n      },\n      \"title\": \"Conditions\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"alias\",\n    \"event\"\n  ],\n  \"title\": \"EventRequirement\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > singleton_read_test.go <<'EOF'\npackage raft\n\nimport (\n \\\"encoding/json\\\"\n \\\"fmt\\\"\n \\\"testing\\\"\n pb \\\"go.etcd.io/raft/v3/raftpb\\\"\n)\n\nfunc TestAssuranceSingletonReadEligibility(t *testing.T) {\n type replica struct {\n  rn *RawNode\n  store *MemoryStorage\n  applied uint64\n  value string\n  writeIndex uint64\n  incoming int\n }\n nodes := map[uint64]*replica{}\n emit := func(e map[string]interface{}) {\n  b, err := json.Marshal(e); if err \"'!= nil { t.Fatal(err) }\n  fmt.Println(\"CA_EVENT \" + string(b))\n }\n for _, id := range []uint64{1,2} {\n  st := NewMemoryStorage()\n  // Common initial snapshot is the declared bootstrap state. Subsequent\n  // election, commitment, configuration change and application all execute.\n  if err := st.ApplySnapshot(pb.Snapshot{Metadata:pb.SnapshotMetadata{\n   Index:1, Term:1, ConfState:pb.ConfState{Voters:[]uint64{1,2}},\n  }}); err != nil {t.Fatal(err)}\n  if err := st.SetHardState(pb.HardState{Term:1,Commit:1}); err != nil {t.Fatal(err)}\n  rn, err := NewRawNode(&Config{ID:id, ElectionTick:10, HeartbeatTick:1,\n   Storage:st, Applied:1, MaxSizePerMsg:4096, MaxInflightMsgs:256,\n   ReadOnlyOption:ReadOnlySafe, StepDownOnRemoval:false})\n  if err != nil {t.Fatal(err)}\n  nodes[id]= &replica{rn:rn,store:st,applied:1,value:\"old\"}\n }\n isolated := false\n var queue []pb.Message\n admissionIncoming := map[string]int{}\n results := map[string]int{}\n // This pump drains bounded work independently of any read result. It persists\n // and applies every accepted Ready, then Advances; no early-Advance shortcut.\n pump := func() {\n  for round:=0; round<200; round++ {\n   work:=false\n   for _, id := range []uint64{1,2} {\n    n:=nodes[id]\n    if !n.rn.HasReady() {continue}\n    work=true\n    rd:=n.rn.Ready()\n    if !IsEmptySnap(rd.Snapshot) {t.Fatal(\"unexpected runtime snapshot\")}\n    if err:=n.store.Append(rd.Entries); err!=nil {t.Fatal(err)}\n    if !IsEmptyHardState(rd.HardState) {if err:=n.store.SetHardState(rd.HardState);err!=nil {t.Fatal(err)}}\n    for _, e:=range rd.CommittedEntries {\n     if e.Index!=n.applied+1 {t.Fatalf(\"node %d nonconsecutive apply %d after %d\",id,e.Index,n.applied)}\n     switch e.Type {\n     case pb.EntryConfChange:\n      var cc pb.ConfChange\n      if err:=cc.Unmarshal(e.Data);err!=nil {t.Fatal(err)}\n      cs:=n.rn.ApplyConfChange(cc)\n      emit(map[string]interface{}{\"event\":\"configuration_applied\",\"node\":id,\"index\":e.Index,\"voters\":cs.Voters,\"learners\":cs.Learners})\n     case pb.EntryNormal:\n      if len(e.Data)>0 {n.value=string(e.Data);n.writeIndex=e.Index}\n     default:t.Fatalf(\"unexpected entry type %v\",e.Type)\n     }\n     n.applied=e.Index\n    }\n    for _, rs:=range rd.ReadStates {\n     request:=string(rs.RequestCtx)\n     s:=n.rn.Status()\n     voters:=s.Config.Voters.IDs()\n     _,member:=voters[id]\n     soleLocal:=len(s.Config.Voters[0])==1 && len(s.Config.Voters[1])==0 && member\n     count, admitted:=admissionIncoming[request]\n     results[request]++\n     emit(map[string]interface{}{\"event\":\"read_result\",\"run\":\"demotion\",\"node\":id,\"request\":request,\n      \"read_index\":rs.Index,\"applied\":n.applied,\"value\":n.value,\"term\":s.Term,\"role\":s.RaftState.String(),\n      \"local_is_sole_voter\":soleLocal,\"incoming_since_admission\":n.incoming-count,\"admission_known\":admitted,\n      \"response_number\":results[request],\"result_emitted\":true})\n    }\n    queue=append(queue,rd.Messages...)\n    n.rn.Advance(rd)\n   }\n   if len(queue)>0 {\n    work=true\n    msgs:=queue;queue=nil\n    for _, msg:=range msgs {\n     if isolated && msg.From!=msg.To {\n      emit(map[string]interface{}{\"event\":\"message_dropped\",\"from\":msg.From,\"to\":msg.To,\"message_type\":msg.Type.String()})\n      continue\n     }\n     n:=nodes[msg.To];if n==nil {t.Fatalf(\"unknown recipient %d\",msg.To)}\n     n.incoming++\n     if err:=n.rn.Step(msg);err!=nil {t.Fatal(err)}\n    }\n   }\n   if !work {return}\n  }\n  t.Fatal(\"work bound exceeded\")\n }\n if err:=nodes[1].rn.Campaign();err!=nil {t.Fatal(err)}\n pump()\n if nodes[1].rn.Status().RaftState!=StateLeader {t.Fatal(\"initial leader not elected\")}\n if err:=nodes[1].rn.ProposeConfChange(pb.ConfChange{Type:pb.ConfChangeAddLearnerNode,NodeID:1});err!=nil {t.Fatal(err)}\n pump()\n for _,id:=range []uint64{1,2} {\n  s:=nodes[id].rn.Status()\n  _,voter2:=s.Config.Voters[0][2];_,learner1:=s.Config.Learners[1]\n  if len(s.Config.Voters[0])!=1 || len(s.Config.Voters[1])!=0 || !voter2 || !learner1 {t.Fatalf(\"demotion not installed on %d: %+v\",id,s.Config)}\n  emit(map[string]interface{}{\"event\":\"demotion_complete\",\"node\":id,\"role\":s.RaftState.String(),\"applied\":nodes[id].applied,\"term\":s.Term})\n }\n isolated=true\n if err:=nodes[2].rn.Campaign();err!=nil {t.Fatal(err)}\n pump()\n if nodes[2].rn.Status().RaftState!=StateLeader {t.Fatal(\"remaining voter not elected\")}\n if err:=nodes[2].rn.Propose([]byte(\"new\"));err!=nil {t.Fatal(err)}\n pump()\n if nodes[2].value!=\"new\" || nodes[2].writeIndex==0 {t.Fatal(\"new write did not apply\")}\n emit(map[string]interface{}{\"event\":\"write_completed\",\"node\":uint64(2),\"index\":nodes[2].writeIndex,\"value\":nodes[2].value})\n // Each invocation has a new context. Both the suspect learner and the valid\n // current singleton voter are observed; no returned state is suppressed.\n for _,id:=range []uint64{1,2} {\n  n:=nodes[id];request:=fmt.Sprintf(\"fresh-read-%d\",id)\n  admissionIncoming[request]=n.incoming\n  s:=n.rn.Status()\n  emit(map[string]interface{}{\"event\":\"read_admitted\",\"run\":\"demotion\",\"node\":id,\"request\":request,\n   \"safe_mode\":true,\"isolated\":isolated,\"role\":s.RaftState.String(),\"term\":s.Term,\n   \"write_index\":nodes[2].writeIndex,\"applied\":n.applied})\n  n.rn.ReadIndex([]byte(request))\n  pump()\n  emit(map[string]interface{}{\"event\":\"read_window_closed\",\"run\":\"demotion\",\"node\":id,\"request\":request,\n   \"results\":results[request],\"incoming_since_admission\":n.incoming-admissionIncoming[request],\"applied\":n.applied})\n }\n}\nEOF\npython3 - <<'\"'PY'\nimport json\nr=json.load(open('../research.json'))\ng=dict(source_ids=['s-safe-read-option','s-singleton-predicate','s-config','s-config-changer','s-proposal-read','s-read-contract'],expectation_ids=['s-safe-read-option','s-singleton-predicate'],binding_ids=['bind-singleton'],derivation='Observe actual returned ReadStates for fresh requests in ReadOnlySafe with no incoming message during each read. Under the accepted singleton shortcut duty, the local node must be the sole installed voter; compute that predicate from Status.Config membership, not role or the shortcut result.',applicability='Actual two-node demotion history; all configuration entries applied before Advance. Read completion is optional: a missing result remains unknown rather than requiring success.',unresolved=[],conflicts=[],alternatives=['No ReadState is a permitted pending outcome; the current sole voter supplies a positive completion control.'])\nplan=dict(description='Execute a two-voter election, commit and apply leader 1 demotion to learner, isolate the peers, elect sole voter 2 and apply a new write. Invoke fresh reads separately on learner 1 and voter 2 and drain all bounded Ready work. Measure shortcut eligibility on actual ReadStates, preserving missing results and diagnostics. The current voter is the permitted control; write/read indexes and application values are consequence diagnostics, not a global linearizability oracle.',claim_id='o-singleton-read-eligibility',binding_ids=['bind-singleton'],harness=dict(kind='go_test',source='',files={},description='Public RawNode driver with MemoryStorage modeling completed persistence and no crashes. A common index-1 snapshot supplies only initial membership/history. All subsequent e