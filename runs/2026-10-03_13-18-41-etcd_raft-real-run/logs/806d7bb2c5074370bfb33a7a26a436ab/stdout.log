{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cmp status_autoleave_test.go ../direct-checks/c34f1669973445af97dd9f8eeaa34e49/assurance_generated_test.go\npython3 - <<'PY'\nimport json\np=json.load(open('../direct-checks/c34f1669973445af97dd9f8eeaa34e49/plan.json'))\nprint(json.dumps({k:v for k,v in p.items() if k\"'!='\"'harness'},indent=2));print(json.dumps(p['harness']['legality']))\nPY\nsed -n '1947,1973p' ../agent-source/raft.go; sed -n '148,157p' ../agent-source/tracker/tracker.go; sed -n '495,504p' ../agent-source/rawnode.go\"","aggregated_output":"{\n  \"description\": \"Elect a one-voter node from declared snapshot, commit a joint change adding a learner, then compare returned configuration policy to immediate Status. Run implicit true and explicit false modes. Finish all Ready work regardless of observed comparison.\",\n  \"claim_id\": \"o-status-autoleave-copy\",\n  \"binding_ids\": [\n    \"bind-config-clone\"\n  ],\n  \"monitors\": [\n    {\n      \"id\": \"monitor-copy\",\n      \"checker_id\": \"status-policy-copy\",\n      \"event\": \"status_copy\",\n      \"binding_ids\": [\n        \"bind-config-clone\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"s-config-clone\",\n          \"s-status-config-copy\",\n          \"s-config-changer\",\n          \"s-auto-field-contract\"\n        ],\n        \"expectation_ids\": [\n          \"s-config-clone\",\n          \"s-auto-field-contract\"\n        ],\n        \"binding_ids\": [\n          \"bind-config-clone\"\n        ],\n        \"derivation\": \"Compare Status.Config.AutoLeave to the actual immediately preceding ApplyConfChange return, using index/case/node as identity. The expected value is observed from configuration installation, not precomputed from the desired failure.\",\n        \"applicability\": \"Same-thread observation before Advance or further protocol calls can mutate configuration.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"installed\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"status-policy-copy\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"observed\",\n        \"op\": \"eq\",\n        \"value\": true,\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"auto_leave\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"installed.auto_leave\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"case\",\n        \"node\",\n        \"index\"\n      ],\n      \"description\": \"Immediate Status must preserve the actual installed AutoLeave value for this configuration operation.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"This measures status reporting only; no live configuration mutation or external consumer effect is attributed.\"\n  ]\n}\n{\"source_ids\": [\"s-raw-api\", \"s-ready-contract\", \"s-config-changer\", \"s-node-contract\", \"s-restart\"], \"expectation_ids\": [\"s-raw-api\", \"s-ready-contract\", \"s-node-contract\"], \"binding_ids\": [], \"derivation\": \"RawNode used serially; entries and HardState saved before Advance, configurations applied consecutively. Status is an allowed synchronous observation between ApplyConfChange and Advance. Both voter halves are node 1, so no learner acknowledgment is needed.\", \"applicability\": \"No crashes; initial snapshot substitutes bootstrap only.\", \"unresolved\": [], \"conflicts\": [], \"alternatives\": []}\nfunc (r *raft) applyConfChange(cc pb.ConfChangeV2) pb.ConfState {\n\tcfg, trk, err := func() (tracker.Config, tracker.ProgressMap, error) {\n\t\tchanger := confchange.Changer{\n\t\t\tTracker:   r.trk,\n\t\t\tLastIndex: r.raftLog.lastIndex(),\n\t\t}\n\t\tif cc.LeaveJoint() {\n\t\t\treturn changer.LeaveJoint()\n\t\t} else if autoLeave, ok := cc.EnterJoint(); ok {\n\t\t\treturn changer.EnterJoint(autoLeave, cc.Changes...)\n\t\t}\n\t\treturn changer.Simple(cc.Changes...)\n\t}()\n\n\tif err != nil {\n\t\t// TODO(tbg): return the error to the caller.\n\t\tpanic(err)\n\t}\n\n\treturn r.switchToConfig(cfg, trk)\n}\n\n// switchToConfig reconfigures this node to use the provided configuration. It\n// updates the in-memory state and, when necessary, carries out additional\n// actions such as reacting to the removal of nodes or changed quorum\n// requirements.\n//\nfunc (p *ProgressTracker) ConfState() pb.ConfState {\n\treturn pb.ConfState{\n\t\tVoters:         p.Voters[0].Slice(),\n\t\tVotersOutgoing: p.Voters[1].Slice(),\n\t\tLearners:       quorum.MajorityConfig(p.Learners).Slice(),\n\t\tLearnersNext:   quorum.MajorityConfig(p.LearnersNext).Slice(),\n\t\tAutoLeave:      p.AutoLeave,\n\t}\n}\n\n\n// Status returns the current status of the given group. This allocates, see\n// BasicStatus and WithProgress for allocation-friendlier choices.\nfunc (rn *RawNode) Status() Status {\n\tstatus := getStatus(rn.raft)\n\treturn status\n}\n\n// BasicStatus returns a BasicStatus. Notably this does not contain the\n// Progress map; see WithProgress for an allocation-free way to inspect it.\n","exit_code":0,"status":"completed"}}
