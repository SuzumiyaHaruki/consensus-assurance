: 'array', 'fact_ids': 'array', 'source_ids': 'array'}\n\n Fact required= ['id', 'meaning', 'identity', 'validity_context', 'representation', 'durability', 'recovery', 'source_ids'] fields= {'id': 'string', 'meaning': 'string', 'identity': 'object', 'established_by': 'array', 'consumed_by': 'array', 'validity_context': 'string', 'representation': 'array', 'invalidators': 'array', 'reinterpreters': 'array', 'durability': 'string', 'recovery': 'string', 'source_ids': 'array', 'unknowns': 'array'}\n\n Surface required= ['entry_point', 'disposition', 'reason'] fields= {'entry_point': 'string', 'disposition': 'string', 'behavior_ids': 'array', 'reason': 'string', 'source_ids': 'array', 'high_consequence': 'boolean'}\n\n TargetProfile required= ['system_boundary'] fields= {'system_boundary': 'string', 'protocol_contexts': 'array', 'external_interfaces': 'array', 'ownership': 'array', 'selection_injection': 'array', 'variants': 'array', 'source_ids': 'array', 'unknowns': 'array'}\n","exit_code":0,"status":"completed"}}
