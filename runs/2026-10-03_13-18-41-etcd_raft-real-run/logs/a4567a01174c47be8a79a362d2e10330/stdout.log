n\",\n            \"entry_points\": [],\n            \"behavior_ids\": [\n              \"b-context\"\n            ],\n            \"variants\": [],\n            \"unknowns\": [],\n            \"source_ids\": [\n              \"s-term\",\n              \"s-authority\",\n              \"s-campaign\",\n              \"s-voting\",\n              \"s-commit-reset\"\n            ]\n          }\n        ],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      }\n    ]\n  },\n  \"capacity\": {\n    \"remaining\": {\n      \"agent_calls\": 38,\n      \"experiments\": 16,\n      \"audit_units\": 6,\n      \"semantic_reviews\": 10,\n      \"revisions\": 6\n    },\n    \"remaining_seconds\": 2132.025118518999,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  },\n  \"conclusions\": [],\n  \"costs\": {\n    \"agent_calls\": 2,\n    \"agent_seconds\": 266.750485,\n    \"rejected_calls\": 0,\n    \"rejected_call_seconds\": 0,\n    \"formal_executions\": 0,\n    \"formal_execution_seconds\": 0,\n    \"elapsed_seconds\": 267.9748814810009,\n    \"interpretation\": \"Rejected calls may contain useful investigation; wall time is not token cost or pure waste\"\n  },\n  \"map_handoffs\": [],\n  \"handoffs\": [\n    {\n      \"operation_id\": \"abda8828f7a848e49d21c51418958ef0\",\n      \"action\": \"research\",\n      \"candidate_ids\": [],\n      \"answered_preview\": \"Commit qualification depends on both current voter aggregation and current-term log matching; follow-up read release differs between acknowledgment and configuration entry paths. Deferred responses link host durability obligations to suppor…\",\n      \"ref_ids\": [\n        \"s-config\",\n        \"s-ready\",\n        \"s-host-contract\",\n        \"s-log-commit\",\n        \"s-term\"\n      ],\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"