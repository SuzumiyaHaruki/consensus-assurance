.localAddr, 0, 0)\n../agent-source/configuration.go:19:\t// Staging is a server that acts like a Nonvoter. A configuration change\n../agent-source/configuration.go:20:\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n../agent-source/configuration.go:23:\tStaging\n../agent-source/configuration.go:32:\tcase Staging:\n../agent-source/configuration.go:33:\t\treturn \"Staging\"\n../agent-source/configuration.go:93:\t// AddVoter adds a server with Suffrage of Voter.\n../agent-source/configuration.go:94:\tAddVoter ConfigurationChangeCommand = iota\n../agent-source/configuration.go:95:\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n../agent-source/configuration.go:101:\t// Promote changes a server from Staging to Voter. The command will be a\n../agent-source/configuration.go:102:\t// no-op if the server is not Staging.\n../agent-source/configuration.go:103:\t// Deprecated: use AddVoter instead.\n../agent-source/configuration.go:104:\tPromote\n../agent-source/configuration.go:105:\t// AddStaging makes a server a Voter.\n../agent-source/configuration.go:106:\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n../agent-source/configuration.go:107:\tAddStaging = 0 // explicit 0 to preserve the old value.\n../agent-source/configuration.go:112:\tcase AddVoter:\n../agent-source/configuration.go:113:\t\treturn \"AddVoter\"\n../agent-source/configuration.go:120:\tcase Promote:\n../agent-source/configuration.go:121:\t\treturn \"Promote\"\n../agent-source/configuration.go:132:\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n../agent-source/configuration.go:235:\tcase AddVoter:\n../agent-source/configuration.go:291:\tcase Promote:\n../agent-source/configuration.go:293:\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\nfunc decodeResponse(conn *netConn, resp interface{}) (bool, error) {\n\t// Decode the error if any\n\tvar rpcError string\n\tif err := conn.dec.Decode(&rpc