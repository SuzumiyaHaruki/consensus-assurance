\"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      },\n      {\n        \"activity\": \"A2\",\n        \"entries\": [],\n        \"coverage\": \"Partial understanding; neither candidate labels nor object counts establish exhaustion\"\n      }\n    ]\n  },\n  \"capacity\": {\n    \"remaining\": {\n      \"agent_calls\": 38,\n      \"experiments\": 16,\n      \"audit_units\": 6,\n      \"semantic_reviews\": 10,\n      \"revisions\": 6\n    },\n    \"remaining_seconds\": 2273.262469421992,\n    \"new_obligation\": true,\n    \"direct_execution\": true,\n    \"source_investigation\": true,\n    \"exhausted\": []\n  },\n  \"conclusions\": [],\n  \"costs\": {\n    \"agent_calls\": 2,\n    \"agent_seconds\": 126.261041,\n    \"rejected_calls\": 0,\n    \"rejected_call_seconds\": 0,\n    \"formal_executions\": 0,\n    \"formal_execution_seconds\": 0,\n    \"elapsed_seconds\": 126.73753057800786,\n    \"interpretation\": \"Rejected calls may contain useful investigation; wall time is not token cost or pure waste\"\n  },\n  \"map_handoffs\": [],\n  \"handoffs\": [\n    {\n      \"operation_id\": \"4b52122f1efb42bab56011a077fc10b3\",\n      \"action\": \"research\",\n      \"candidate_ids\": [],\n      \"answered_preview\": \"A1: local durable StoreLogs success and successful follower AppendEntries replies report per-voter match indexes to a leader-owned commitment object. It takes the majority order statistic and advances only at or beyond this leadership term'…\",\n      \"ref_ids\": [\n        \"formation\",\n        \"authority\",\n        \"leader_context\",\n        \"local_support\",\n        \"follower_accept\",\n        \"replication_reply\",\n        \"pipeline_reply\",\n        \"request_bounds\",\n        \"support_update\",\n        \"application_queue\",\n        \"fsm_contract\"\n      ],\n      \"record\": {\n        \"path\": \"state.json\",\n        \"collection\": \"selections\",\n        \"match\"