rship\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Ownership\",\n      \"type\": \"array\"\n    },\n    \"selection_injection\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Selection Injection\",\n      \"type\": \"array\"\n    },\n    \"variants\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Variants\",\n      \"type\": \"array\"\n    },\n    \"source_ids\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Source Ids\",\n      \"type\": \"array\"\n    },\n    \"unknowns\": {\n      \"default\": [],\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"Unknowns\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"system_boundary\"\n  ],\n  \"title\": \"TargetProfile\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
