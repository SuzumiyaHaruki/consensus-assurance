{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'; s=open(p).read()\nold='''\tresult[\\\"leader_state_after\\\"] = leader.State().String()\n\tcaEmit(t, result)\n}'''\nnew='''\tresult[\\\"leader_state_after\\\"] = leader.State().String()\n\tcaEmit(t, result)\n\n\t// Bound the exposure: the leader lease counts voters only, so a leader that\n\t// cannot reach a voter quorum should step down shortly.\n\twaitStart := time.Now()\n\tcaPoll(func() bool { return leader.State() \"'!= Leader }, 5*conf.LeaderLeaseTimeout+2*time.Second)\n\tcaEmit(t, map[string]interface{}{\n\t\t\"event\":                \"verify_leader_nonvoter_lease_bound\",\n\t\t\"variant\":              variant,\n\t\t\"lease_timeout_ms\":     conf.LeaderLeaseTimeout.Milliseconds(),\n\t\t\"leader_stepped_down\":  leader.State() != Leader,\n\t\t\"leader_state_after_wait\": leader.State().String(),\n\t\t\"waited_ms\":            time.Since(waitStart).Milliseconds(),\n\t})\n}'\"'''\nassert old in s\ns=s.replace(old,new,1)\nopen(p,'w').write(s)\nprint('patched')\nPY\ncp assurance_generated_test.go work/src/ && cd work/src && export GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft/work/gocache && GOFLAGS=-mod=readonly timeout 200 go test -count=1 -timeout 180s -v -run 'TestAssurance_VerifyLeaderNonvoterAck' . 2>&1 | grep -E \\\"verify_leader_nonvoter_(result|lease_bound)|\"'^--- |''^ok |''^FAIL\" | cut -c1-260'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
