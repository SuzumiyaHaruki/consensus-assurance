{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft && python3 - <<'PY'\nimport json\nu={\n \\\"rationale\\\":\\\"The verification probe now also measures the exposure bound: after the verification result each case waits, bounded by five lease timeouts, for the leader to stop reporting itself as leader, and emits that state with the lease timeout and the elapsed wait. Local construction feedback showed the leader becoming a follower after about one lease interval in both timer configurations. The experiment is requeued as a successor so the bound is measured alongside the defect.\\\",\n \\\"experiment\\\":{\n  \\\"investigation_id\\\":\\\"790eb5d64ed94ef5aea4736e6f66381d-question-0\\\",\n  \\\"previous_id\\\":\\\"055ce90edba24e96b6cad538951eea1a-experiment\\\",\n  \\\"revision_reason\\\":\\\"Harness changed to add a bounded post-verification wait per case that records whether the isolated leader stops reporting itself as leader, together with the configured lease timeout and the elapsed wait.\\\",\n  \\\"harness_path\\\":\\\"assurance_generated_test.go\\\",\n  \\\"source_ids\\\":[\\\"s-verifyleader\\\",\\\"s-replstate\\\",\\\"s-heartbeat\\\",\\\"s-lease\\\"],\n  \\\"scope\\\":{\n   \\\"description\\\":\\\"The same two-case isolation probe (slowed timers and the repository's default in-memory timers) is extended: after VerifyLeader returns, each case waits up to five lease timeouts for the leader to step down and records the outcome.\\\",\n   \\\"assumptions\\\":[\n    \\\"Cluster, transports and FSM are the repository's own MakeCluster, InmemTransport and MockFSM facilities; demotion uses the public DemoteVoter API.\\\",\n    \\\"The leader remains connected to the non-voter and disconnected from the other voters for the whole case, so the lease check sees only itself and the two unreachable voters.\\\",\n    \\\"The step-down observation is bounded by five lease timeouts plus two seconds and records the lease timeout it used.\\\"\n   ]},\n  \\\"prefix\\\":\\\"For each timer configuration: start a four-peer cluster, wait for a leader and apply one command; demote a follower so the configuration is three voters plus one non-voter; disconnect the leader from the other two voters in both directions; confirm reachability with direct AppendEntries attempts and emit the setup event; call VerifyLeader and emit the result event; then wait, bounded by five lease timeouts, until the leader no longer reports itself as leader and emit the lease-bound event with the lease timeout, the elapsed wait and the final state.\\\",\n  \\\"requirement\\\":\\\"Leader verification must not report success unless a voter quorum has acknowledged, and the leader must stop reporting itself as leader shortly after it loses the voter quorum.\\\",\n  \\\"responsibility\\\":\\\"Raft itself: verifyLeader chooses which peers' acknowledgements count, and checkLeaderLease decides when the leader steps down.\\\",\n  \\\"anchors\\\":[\n   {\\\"material_id\\\":\\\"s-verifyleader\\\",\\\"symbol\\\":\\\"verifyLeader\\\",\\\"start_line\\\":966,\\\"end_line\\\":966},\n   {\\\"material_id\\\":\\\"s-lease\\\",\\\"symbol\\\":\\\"checkLeaderLease\\\",\\\"start_line\\\":1037,\\\"end_line\\\":1037},\n   {\\\"material_id\\\":\\\"s-heartbeat\\\",\\\"symbol\\\":\\\"heartbeat\\\",\\\"start_line\\\":388,\\\"end_line\\\":388}\n  ],\n  \\\"prerequisites\\\":[\n   {\\\"alias\\\":\\\"verify-setup-slowed\\\",\\\"event\\\":\\\"verify_leader_nonvoter_setup\\\",\n    \\\"conditions\\\":[{\\\"field\\\":\\\"variant\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"slowed-timers\\\"},\n                  {\\\"field\\\":\\\"voter_quorum\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":2}]},\n   {\\\"alias\\\":\\\"verify-setup-default\\\",\\\"event\\\":\\\"verify_leader_nonvoter_setup\\\",\n    \\\"conditions\\\":[{\\\"field\\\":\\\"variant\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":\\\"default-timers\\\"},\n                  {\\\"field\\\":\\\"voter_quorum\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":2}]}\n  ],\n  \\\"comparisons\\\":[\n   {\\\"event\\\":\\\"verify_leader_nonvoter_result\\\",\\\"identity_fields\\\":[\\\"variant\\\"],\\\"admission_alias\\\":\\\"verify-setup-slowed\\\",\n    \\\"assertion\\\":{\\\"field\\\":\\\"verify_succeeded\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":False},\n    \\\"description\\\":\\\"With slowed timers, verification fails while only a non-voter can acknowledge.\\\"},\n   {\\\"event\\\":\\\"verify_leader_nonvoter_result\\\",\\\"identity_fields\\\":[\\\"variant\\\"],\\\"admission_alias\\\":\\\"verify-setup-default\\\",\n    \\\"assertion\\\":{\\\"field\\\":\\\"verify_succeeded\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":False},\n    \\\"description\\\":\\\"With default timers, verification fails while only a non-voter can acknowledge.\\\"},\n   {\\\"event\\\":\\\"verify_leader_nonvoter_lease_bound\\\",\\\"identity_fields\\\":[\\\"variant\\\"],\\\"admission_alias\\\":\\\"verify-setup-default\\\",\n    \\\"assertion\\\":{\\\"field\\\":\\\"leader_stepped_down\\\",\\\"op\\\":\\\"eq\\\",\\\"value\\\":True},\n    \\\"description\\\":\\\"With default timers the isolated leader stops reporting itself as leader within the bounded wait.\\\"}\n  ]\n }\n}\njson.dump(u,open('update.json','w'),indent=2); print('written')\nPY\n/home/nitro/Desktop/consensus-assurance/.venv/bin/python -I -B -c \\\"import sys; sys.path.insert(0, '/home/nitro/Desktop/consensus-assurance/src'); from consensus_assurance.cli import main; raise SystemExit(main())\\\" validate --run /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run --submission update.json 2>&1 | tail -2\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
