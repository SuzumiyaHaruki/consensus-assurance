{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft && cat >> assurance_generated_test.go <<'EOF'\n\n// TestAssurance_TimeoutNowRepeatFromRemovedNode measures whether the transfer\n// trigger can be repeated from the same non-member sender, producing leadership\n// churn round after round.\nfunc TestAssurance_TimeoutNowRepeatFromRemovedNode(t *testing.T) {\n\tconf := inmemConfig(t)\n\tconf.ElectionTimeout = 200 * time.Millisecond\n\tconf.HeartbeatTimeout = 100 * time.Millisecond\n\tconf.LeaderLeaseTimeout = 100 * time.Millisecond\n\n\tc := MakeCluster(3, t, conf)\n\tdefer func() {\n\t\tdefer func() { _ = recover() }()\n\t\tc.Close()\n\t}()\n\n\tvar leader *Raft\n\tif \"'!caPoll(func() bool {\n\t\tleader = caFindLeader(c.rafts...)\n\t\treturn leader != nil\n\t}, 20*time.Second) {\n\t\tt.Fatalf(\"no leader\")\n\t}\n\tif err := leader.Apply([]byte(\"warm\"), 5*time.Second).Error(); err != nil {\n\t\tt.Fatalf(\"apply: %v\", err)\n\t}\n\n\t// Pick a node to remove; it stays transport-reachable.\n\tremovedIdx := -1\n\tfor i, r := range c.rafts {\n\t\tif r != leader {\n\t\t\tremovedIdx = i\n\t\t\tbreak\n\t\t}\n\t}\n\tremoved := c.rafts[removedIdx]\n\tif err := leader.RemoveServer(removed.localID, 0, 0).Error(); err != nil {\n\t\tt.Fatalf(\"RemoveServer: %v\", err)\n\t}\n\tcaPoll(func() bool { return !inConfiguration(removed.getLatestConfiguration(), removed.localID) }, 10*time.Second)\n\n\trounds := 3\n\tchangedRounds := 0\n\tsettled := 0\n\tterms := []uint64{}\n\tfor round := 0; round < rounds; round++ {\n\t\t// Pick a surviving follower that is not the current leader.\n\t\tcur := caFindLeader(c.rafts...)\n\t\tvar target *Raft\n\t\tfor _, r := range c.rafts {\n\t\t\tif r != removed && r != cur {\n\t\t\t\ttarget = r\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif target == nil {\n\t\t\tbreak\n\t\t}\n\t\tbeforeLeader := cur\n\t\tbeforeTerm := target.getCurrentTerm()\n\t\tpeerAddr, peerTrans := NewInmemTransport(\"\")\n\t\town := removed.trans.(*InmemTransport)\n\t\town.Connect(peerAddr, peerTrans)\n\t\tpeerTrans.Connect(target.localAddr, own)\n\t\t_ = peerTrans.TimeoutNow(target.localID, target.localAddr, &TimeoutNowRequest{\n\t\t\tRPCHeader: RPCHeader{ProtocolVersion: removed.protocolVersion, ID: []byte(removed.localID),\n\t\t\t\tAddr: peerTrans.EncodePeer(removed.localID, removed.localAddr)},\n\t\t}, &TimeoutNowResponse{})\n\t\tpeerTrans.Close()\n\n\t\tcaPoll(func() bool { return caFindLeader(c.rafts...) != nil && caFindLeader(c.rafts...) != beforeLeader }, 10*time.Second)\n\t\tafter := caFindLeader(c.rafts...)\n\t\tif after != nil && after != beforeLeader {\n\t\t\tchangedRounds++\n\t\t}\n\t\tif after != nil {\n\t\t\tsettled++\n\t\t\tterms = append(terms, target.getCurrentTerm())\n\t\t}\n\t\t_ = beforeTerm\n\t}\n\n\tcaEmit(t, map[string]interface{}{\n\t\t\"event\":                       \"timeoutnow_repeat_from_removed\",\n\t\t\"variant\":                     \"three-voter-one-removed\",\n\t\t\"rounds_requested\":            rounds,\n\t\t\"rounds_with_leadership_change\": changedRounds,\n\t\t\"rounds_with_a_stable_leader\": settled,\n\t\t\"churn_persisted\":             changedRounds >= 2,\n\t\t\"terms_after_each_round\":      terms,\n\t})\n}\nEOF\ncp assurance_generated_test.go work/src/ && cd work/src && export GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft/work/gocache && GOFLAGS=-mod=readonly timeout 200 go test -count=1 -timeout 180s -v -run '\"'TestAssurance_TimeoutNowRepeatFromRemovedNode' . 2>&1 | grep -E \\\"timeoutnow_repeat|\"'^--- |''^ok |''^FAIL\" | cut -c1-460'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
