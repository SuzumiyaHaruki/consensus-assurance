estarted_leader_after_outsider\":\"outsider-not-in-config\",\"restarted_live_config_len_final\":0,\"restarted_term_after_outsider\":7,\"serving_leader_state_after\":\"Follower\",\"serving_leader_stepped_down\":true,\"variant\":\"three-voter-restart-one-follower\"}\n","exit_code":0,"status":"completed"}}
