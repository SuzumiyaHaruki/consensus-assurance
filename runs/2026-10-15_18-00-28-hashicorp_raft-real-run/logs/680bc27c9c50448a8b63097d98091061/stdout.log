{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n replication.go | sed -n 1,220p'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"sync\"\n    10\t\t\"sync/atomic\"\n    11\t\t\"time\"\n    12\t\n    13\t\t\"github.com/hashicorp/go-metrics\"\n    14\t)\n    15\t\n    16\tconst (\n    17\t\tmaxFailureScale = 12\n    18\t\tfailureWait     = 10 * time.Millisecond\n    19\t)\n    20\t\n    21\tvar (\n    22\t\t// ErrLogNotFound indicates a given log entry is not available.\n    23\t\tErrLogNotFound = errors.New(\"log not found\")\n    24\t\n    25\t\t// ErrPipelineReplicationNotSupported can be returned by the transport to\n    26\t\t// signal that pipeline replication is not supported in general, and that\n    27\t\t// no error message should be produced.\n    28\t\tErrPipelineReplicationNotSupported = errors.New(\"pipeline replication not supported\")\n    29\t)\n    30\t\n    31\t// followerReplication is in charge of sending snapshots and log entries from\n    32\t// this leader during this particular term to a remote follower.\n    33\ttype followerReplication struct {\n    34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n    35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n    36\t\t// platforms.\n    37\t\n    38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n    39\t\t// requests.\n    40\t\tcurrentTerm uint64\n    41\t\n    42\t\t// nextIndex is the index of the next log entry to send to the follower,\n    43\t\t// which may fall past the end of the log.\n    44\t\tnextIndex uint64\n    45\t\n    46\t\t// peer contains the network address and ID of the remote follower.\n    47\t\tpeer Server\n    48\t\t// peerLock protects 'peer'\n    49\t\tpeerLock sync.RWMutex\n    50\t\n    51\t\t// commitment tracks the entries acknowledged by followers so that the\n    52\t\t// leader's commit index can advance. It is updated on successful\n    53\t\t// AppendEntries responses.\n    54\t\tcommitment *commitment\n    55\t\n    56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n    57\t\t// removed from the cluster. In the follower removed case, it carries a log\n    58\t\t// index; replication should be attempted with a best effort up through that\n    59\t\t// index, before exiting.\n    60\t\tstopCh chan uint64\n    61\t\n    62\t\t// triggerCh is notified every time new entries are appended to the log.\n    63\t\ttriggerCh chan struct{}\n    64\t\n    65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n    66\t\t// deferErr, the sender can be notified when the replication is done.\n    67\t\ttriggerDeferErrorCh chan *deferError\n    68\t\n    69\t\t// lastContact is updated to the current time whenever any response is\n    70\t\t// received from the follower (successful or not). This is used to check\n    71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n    72\t\tlastContact time.Time\n    73\t\t// lastContactLock protects 'lastContact'.\n    74\t\tlastContactLock sync.RWMutex\n    75\t\n    76\t\t// failures counts the number of failed RPCs since the last success, which is\n    77\t\t// used to apply backoff.\n    78\t\tfailures uint64\n    79\t\n    80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n    81\t\t// this server is still leader.\n    82\t\tnotifyCh chan struct{}\n    83\t\t// notify is a map of futures to be resolved upon receipt of an\n    84\t\t// acknowledgement, then cleared from this map.\n    85\t\tnotify map[*verifyFuture]struct{}\n    86\t\t// notifyLock protects 'notify'.\n    87\t\tnotifyLock sync.Mutex\n    88\t\n    89\t\t// stepDown is used to indicate to the leader that we\n    90\t\t// should step down based on information from a follower.\n    91\t\tstepDown chan struct{}\n    92\t\n    93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n    94\t\t// It is private to this replication goroutine.\n    95\t\tallowPipeline bool\n    96\t}\n    97\t\n    98\t// notifyAll is used to notify all the waiting verify futures\n    99\t// if the follower believes we are still the leader.\n   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   101\t\t// Clear the waiting notifies minimizing lock time\n   102\t\ts.notifyLock.Lock()\n   103\t\tn := s.notify\n   104\t\ts.notify = make(map[*verifyFuture]struct{})\n   105\t\ts.notifyLock.Unlock()\n   106\t\n   107\t\t// Submit our votes\n   108\t\tfor v := range n {\n   109\t\t\tv.vote(leader)\n   110\t\t}\n   111\t}\n   112\t\n   113\t// cleanNotify is used to delete notify, .\n   114\tfunc (s *followerReplication) cleanNotify(v *verifyFuture) {\n   115\t\ts.notifyLock.Lock()\n   116\t\tdelete(s.notify, v)\n   117\t\ts.notifyLock.Unlock()\n   118\t}\n   119\t\n   120\t// LastContact returns the time of last contact.\n   121\tfunc (s *followerReplication) LastContact() time.Time {\n   122\t\ts.lastContactLock.RLock()\n   123\t\tlast := s.lastContact\n   124\t\ts.lastContactLock.RUnlock()\n   125\t\treturn last\n   126\t}\n   127\t\n   128\t// setLastContact sets the last contact to the current time.\n   129\tfunc (s *followerReplication) setLastContact() {\n   130\t\ts.lastContactLock.Lock()\n   131\t\ts.lastContact = time.Now()\n   132\t\ts.lastContactLock.Unlock()\n   133\t}\n   134\t\n   135\t// replicate is a long running routine that replicates log entries to a single\n   136\t// follower.\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n   165\t\t\t// followers quickly learn the leader's commit index when\n   166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n   167\t\t\t// can't do this to keep them unblocked by disk IO on the\n   168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n   169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   172\t\t\t}\n   173\t\n   174\t\t\t// If things looks healthy, switch to pipeline mode\n   175\t\t\tif !shouldStop && s.allowPipeline {\n   176\t\t\t\tgoto PIPELINE\n   177\t\t\t}\n   178\t\t}\n   179\t\treturn\n   180\t\n   181\tPIPELINE:\n   182\t\t// Disable until re-enabled\n   183\t\ts.allowPipeline = false\n   184\t\n   185\t\t// Replicates using a pipeline for high performance. This method\n   186\t\t// is not able to gracefully recover from errors, and so we fall back\n   187\t\t// to standard mode on failure.\n   188\t\tif err := r.pipelineReplicate(s); err != nil {\n   189\t\t\tif err != ErrPipelineReplicationNotSupported {\n   190\t\t\t\ts.peerLock.RLock()\n   191\t\t\t\tpeer := s.peer\n   192\t\t\t\ts.peerLock.RUnlock()\n   193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n   194\t\t\t}\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   201\t// If the follower log is behind, we take care to bring them up to date.\n   202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n   203\t\t// Create the base request\n   204\t\tvar req AppendEntriesRequest\n   205\t\tvar resp AppendEntriesResponse\n   206\t\tvar start time.Time\n   207\t\tvar peer Server\n   208\t\n   209\tSTART:\n   210\t\t// Prevent an excessive retry rate on errors\n   211\t\tif s.failures > 0 {\n   212\t\t\tselect {\n   213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n   214\t\t\tcase <-r.shutdownCh:\n   215\t\t\t}\n   216\t\t}\n   217\t\n   218\t\ts.peerLock.RLock()\n   219\t\tpeer = s.peer\n   220\t\ts.peerLock.RUnlock()\n","exit_code":0,"status":"completed"}}
