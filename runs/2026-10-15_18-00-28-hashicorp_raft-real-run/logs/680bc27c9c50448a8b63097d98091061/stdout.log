leaderID))\n  1791\t\t\treturn\n  1792\t\t}\n  1793\t\n  1794\t\t// Ignore an older term\n  1795\t\tif req.Term < r.getCurrentTerm() {\n  1796\t\t\treturn\n  1797\t\t}\n  1798\t\n  1799\t\tif req.Term > r.getCurrentTerm() {\n  1800\t\t\t// continue processing here to possibly grant the pre-vote as in a \"real\" vote this will transition us to follower\n  1801\t\t\tr.logger.Debug(\"received a requestPreVote with a newer term, grant the pre-vote\")\n  1802\t\t\tresp.Term = req.Term\n  1803\t\t}\n  1804\t\n  1805\t\t// if we get a request for a pre-vote from a nonVoter  and the request term is higher, do not grant the Pre-Vote\n  1806\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1807\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1808\t\t\tr.logger.Warn(\"rejecting pre-vote request since node is not a voter\", \"from\", candidate)\n  1809\t\t\treturn\n  1810\t\t}\n  1811\t\n  1812\t\t// Reject if their term is older\n  1813\t\tlastIdx, lastTerm := r.getLastEntry()\n  1814\t\tif lastTerm > req.LastLogTerm {\n  1815\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last term is greater\",\n  1816\t\t\t\t\"candidate\", candidate,\n  1817\t\t\t\t\"last-term\", lastTerm,\n  1818\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1819\t\t\treturn\n  1820\t\t}\n  1821\t\n  1822\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1823\t\t\tr.logger.Warn(\"rejecting pre-vote request since our last index is greater\",\n  1824\t\t\t\t\"candidate\", candidate,\n  1825\t\t\t\t\"last-index\", lastIdx,\n  1826\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1827\t\t\treturn\n  1828\t\t}\n  1829\t\n  1830\t\tresp.Granted = true\n  1831\t}\n  1832\t\n  1833\t// installSnapshot is invoked when we get a InstallSnapshot RPC call.\n  1834\t// We must be in the follower state for this, since it means we are\n  1835\t// too far behind a leader for log replay. This must only be called\n  1836\t// from the main thread.\n  1837\tfunc (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n  1838\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"installSnapshot\"}, time.Now())\n  1839\t\t// Setup a response\n  1840\t\tresp := &InstallSnapshotResponse{\n  1841\t\t\tTerm:    r.getCurrentTerm(),\n  1842\t\t\tSuccess: false,\n  1843\t\t}\n  1844\t\tvar rpcErr error\n  1845\t\tdefer func() {\n  1846\t\t\t_, _ = io.Copy(io.Discard, rpc.Reader) // ensure we always consume all the snapshot data from the stream [see issue #212]\n  1847\t\t\trpc.Respond(resp, rpcErr)\n  1848\t\t}()\n  1849\t\n  1850\t\t// Sanity check the version\n  1851\t\tif req.SnapshotVersion < SnapshotVersionMin ||\n  1852\t\t\treq.SnapshotVersion > SnapshotVersionMax {\n  1853\t\t\trpcErr = fmt.Errorf(\"unsupported snapshot version %d\", req.SnapshotVersion)\n  1854\t\t\treturn\n  1855\t\t}\n  1856\t\n  1857\t\t// Ignore an older term\n  1858\t\tif req.Term < r.getCurrentTerm() {\n  1859\t\t\tr.logger.Info(\"ignoring installSnapshot request with older term than current term\",\n  1860\t\t\t\t\"request-term\", req.Term,\n  1861\t\t\t\t\"current-term\", r.getCurrentTerm())\n  1862\t\t\treturn\n  1863\t\t}\n  1864\t\n  1865\t\t// Increase the term if we see a newer one\n  1866\t\tif req.Term > r.getCurrentTerm() {\n  1867\t\t\t// Ensure transition to follower\n  1868\t\t\tr.setState(Follower)\n  1869\t\t\tr.setCurrentTerm(req.Term)\n  1870\t\t\tresp.Term = req.Term\n  1871\t\t}\n  1872\t\n  1873\t\t// Save the current leader\n  1874\t\tif len(req.ID) > 0 {\n  1875\t\t\tr.setLeader(r.trans.DecodePeer(req.Addr), ServerID(req.ID))\n  1876\t\t} else {\n  1877\t\t\tr.setLeader(r.trans.DecodePeer(req.Leader), ServerID(req.ID))\n  1878\t\t}\n  1879\t\n  1880\t\t// Create a new snapshot\n  1881\t\tvar reqConfiguration Configuration\n  1882\t\tvar reqConfigurationIndex uint64\n  1883\t\tif req.SnapshotVersion > 0 {\n  1884\t\t\treqConfiguration = DecodeConfiguration(req.Configuration)\n  1885\t\t\treqConfigurationIndex = req.ConfigurationIndex\n  1886\t\t} else {\n  1887\t\t\treqConfiguration, rpcErr = decodePeers(req.Peers, r.trans)\n  1888\t\t\tif rpcErr != nil {\n  1889\t\t\t\tr.logger.Error(\"failed to install snapshot\", \"error\", rpcErr)\n  1890\t\t\t\treturn\n  1891\t\t\t}\n  1892\t\t\treqConfigurationIndex = req.LastLogIndex\n  1893\t\t}\n  1894\t\tversion := getSnapshotVersion(r.protocolVersion)\n  1895\t\tsink, err := r.snapshots.Create(version, req.LastLogIndex, req.LastLogTerm,\n  1896\t\t\treqConfiguration, reqConfigurationIndex, r.trans)\n  1897\t\tif err != nil {\n  1898\t\t\tr.logger.Error(\"failed to create snapshot to install\", \"error\", err)\n  1899\t\t\trpcErr = fmt.Errorf(\"failed to create snapshot: %v\", err)\n  1900\t\t\treturn\n  1901\t\t}\n  1902\t\n  1903\t\t// Separately track the progress of streaming a snapshot over the network\n  1904\t\t// because this too can take a long time.\n  1905\t\tcountingRPCReader := newCountingReader(rpc.Reader)\n  1906\t\n  1907\t\t// Spill the remote snapshot to disk\n  1908\t\ttransferMonitor := startSnapshotRestoreMonitor(r.logger, countingRPCReader, req.Size, true)\n  1909\t\tn, err := io.Copy(sink, countingRPCReader)\n  1910\t\ttransferMonitor.StopAndWait()\n  1911\t\tif err != nil {\n  1912\t\t\t_ = sink.Cancel()\n  1913\t\t\tr.logger.Error(\"failed to copy snapshot\", \"error\", err)\n  1914\t\t\trpcErr = err\n  1915\t\t\treturn\n  1916\t\t}\n  1917\t\n  1918\t\t// Check that we received it all\n  1919\t\tif n != req.Size {\n  1920\t\t\t_ = sink.Cancel()\n  1921\t\t\tr.logger.Error(\"failed to receive whole snapshot\",\n  1922\t\t\t\t\"received\", hclog.Fmt(\"%d / %d\", n, req.Size))\n  1923\t\t\trpcErr = fmt.Errorf(\"short read\")\n  1924\t\t\treturn\n  1925\t\t}\n  1926\t\n  1927\t\t// Finalize the snapshot\n  1928\t\tif err := sink.Close(); err != nil {\n  1929\t\t\tr.logger.Error(\"failed to finalize snapshot\", \"error\", err)\n  1930\t\t\trpcErr = err\n  1931\t\t\treturn\n  1932\t\t}\n  1933\t\tr.logger.Info(\"copied to local snapshot\", \"bytes\", n)\n  1934\t\n  1935\t\t// Restore snapshot\n  1936\t\tfuture := &restoreFuture{ID: sink.ID()}\n  1937\t\tfuture.ShutdownCh = r.shutdownCh\n  1938\t\tfuture.init()\n  1939\t\tselect {\n  1940\t\tcase r.fsmMutateCh <- future:\n  1941\t\tcase <-r.shutdownCh:\n  1942\t\t\tfuture.respond(ErrRaftShutdown)\n  1943\t\t\treturn\n  1944\t\t}\n  1945\t\n  1946\t\t// Wait for the restore to happen\n  1947\t\tif err := future.Error(); err != nil {\n  1948\t\t\tr.logger.Error(\"failed to restore snapshot\", \"error\", err)\n  1949\t\t\trpcErr = err\n  1950\t\t\treturn\n  1951\t\t}\n  1952\t\n  1953\t\t// Update the lastApplied so we don't replay old logs\n  1954\t\tr.setLastApplied(req.LastLogIndex)\n  1955\t\n  1956\t\t// Update the last stable snapshot info\n  1957\t\tr.setLastSnapshot(req.LastLogIndex, req.LastLogTerm)\n  1958\t\n  1959\t\t// Restore the peer set\n  1960\t\tr.setLatestConfiguration(reqConfiguration, reqConfigurationIndex)\n  1961\t\tr.setCommittedConfiguration(reqConfiguration, reqConfigurationIndex)\n  1962\t\n  1963\t\t// Clear old logs if r.logs is a MonotonicLogStore. Otherwise compact the\n  1964\t\t// logs. In both cases, log any errors and continue.\n  1965\t\tif mlogs, ok := r.logs.(MonotonicLogStore); ok && mlogs.IsMonotonic() {\n  1966\t\t\tif err := r.removeOldLogs(); err != nil {\n  1967\t\t\t\tr.logger.Error(\"failed to reset logs\", \"error\", err)\n  1968\t\t\t}\n  1969\t\t} else if err := r.compactLogs(req.LastLogIndex); err != nil {\n  1970\t\t\tr.logger.Error(\"failed to compact logs\", \"error\", err)\n  1971\t\t}\n  1972\t\n  1973\t\tr.logger.Info(\"Installed remote snapshot\")\n  1974\t\tresp.Success = true\n  1975\t\tr.setLastContact()\n  1976\t}\n  1977\t\n  1978\t// setLastContact is used to set the last contact time to now\n  1979\tfunc (r *Raft) setLastContact() {\n  1980\t\tr.lastContactLock.Lock()\n  1981\t\tr.lastContact = time.Now()\n  1982\t\tr.lastContactLock.Unlock()\n  1983\t}\n  1984\t\n  1985\ttype voteResult struct {\n  1986\t\tRequestVoteResponse\n  1987\t\tvoterID ServerID\n  1988\t}\n  1989\t\n  1990\ttype preVoteResult struct {\n  1991\t\tRequestPreVoteResponse\n  1992\t\tvoterID ServerID\n  1993\t}\n  1994\t\n  1995\t// electSelf is used to send a RequestVote RPC to all peers, and vote for\n  1996\t// ourself. This has the side affecting of incrementing the current term. The\n  1997\t// response channel returned is used to wait for all the responses (including a\n  1998\t// vote for ourself). This must only be called from the main thread.\n  1999\tfunc (r *Raft) electSelf() <-chan *voteResult {\n  2000\t\t// Create a response channel\n  2001\t\trespCh := make(chan *voteResult, len(r.configurations.latest.Servers))\n  2002\t\n  2003\t\t// Increment the term\n  2004\t\tnewTerm := r.getCurrentTerm() + 1\n  2005\t\n  2006\t\tr.setCurrentTerm(newTerm)\n  2007\t\t// Construct the request\n  2008\t\tlastIdx, lastTerm := r.getLastEntry()\n  2009\t\treq := &RequestVoteRequest{\n  2010\t\t\tRPCHeader: r.getRPCHeader(),\n  2011\t\t\tTerm:      newTerm,\n  2012\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n  2013\t\t\tCandidate:          r.trans.EncodePeer(r.localID, r.localAddr),\n  2014\t\t\tLastLogIndex:       lastIdx,\n  2015\t\t\tLastLogTerm:        lastTerm,\n  2016\t\t\tLeadershipTransfer: r.candidateFromLeadershipTransfer.Load(),\n  2017\t\t}\n  2018\t\n  2019\t\t// Construct a function to ask for a vote\n  2020\t\taskPeer := func(peer Server) {\n  2021\t\t\tr.goFunc(func() {\n  2022\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"electSelf\"}, time.Now())\n  2023\t\t\t\tresp := &voteResult{voterID: peer.ID}\n  2024\t\t\t\terr := r.trans.RequestVote(peer.ID, peer.Address, req, &resp.RequestVoteResponse)\n  2025\t\t\t\tif err != nil {\n  2026\t\t\t\t\tr.logger.Error(\"failed to make requestVote RPC\",\n  2027\t\t\t\t\t\t\"target\", peer,\n  2028\t\t\t\t\t\t\"error\", err,\n  2029\t\t\t\t\t\t\"term\", req.Term)\n  2030\t\t\t\t\tresp.Term = req.Term\n  2031\t\t\t\t\tresp.Granted = false\n  2032\t\t\t\t}\n  2033\t\t\t\trespCh <- resp\n  2034\t\t\t})\n  2035\t\t}\n  2036\t\n  2037\t\t// For each peer, request a vote\n  2038\t\tfor _, server := range r.configurations.latest.Servers {\n  2039\t\t\tif server.Suffrage == Voter {\n  2040\t\t\t\tif server.ID == r.localID {\n  2041\t\t\t\t\tr.logger.Debug(\"voting for self\", \"term\", req.Term, \"id\", r.localID)\n  2042\t\n  2043\t\t\t\t\t// Persist a vote for ourselves\n  2044\t\t\t\t\tif err := r.persistVote(req.Term, req.Addr); err != nil {\n  2045\t\t\t\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n  2046\t\t\t\t\t\treturn nil\n  2047\t\n  2048\t\t\t\t\t}\n  2049\t\t\t\t\t// Include our own vote\n  2050\t\t\t\t\trespCh <- &voteResult{\n  2051\t\t\t\t\t\tRequestVoteResponse: RequestVoteResponse{\n  2052\t\t\t\t\t\t\tRPCHeader: r.getRPCHeader(),\n  2053\t\t\t\t\t\t\tTerm:      req.Term,\n  2054\t\t\t\t\t\t\tGranted:   true,\n  2055\t\t\t\t\t\t},\n  2056\t\t\t\t\t\tvoterID: r.localID,\n  2057\t\t\t\t\t}\n  2058\t\t\t\t} else {\n  2059\t\t\t\t\tr.logger.Debug(\"asking for vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2060\t\t\t\t\taskPeer(server)\n  2061\t\t\t\t}\n  2062\t\t\t}\n  2063\t\t}\n  2064\t\n  2065\t\treturn respCh\n  2066\t}\n  2067\t\n  2068\t// preElectSelf is used to send a RequestPreVote RPC to all peers, and vote for\n  2069\t// ourself. This will not increment the current term. The\n  2070\t// response channel returned is used to wait for all the responses (including a\n  2071\t// vote for ourself).\n  2072\t// This must only be called from the main thread.\n  2073\tfunc (r *Raft) preElectSelf() <-chan *preVoteResult {\n  2074\t\n  2075\t\t// At this point transport should support pre-vote\n  2076\t\t// but check just in case\n  2077\t\tprevoteTrans, prevoteTransSupported := r.trans.(WithPreVote)\n  2078\t\tif !prevoteTransSupported {\n  2079\t\t\tpanic(\"preElection is not possible if the transport don't support pre-vote\")\n  2080\t\t}\n  2081\t\n  2082\t\t// Create a response channel\n  2083\t\trespCh := make(chan *preVoteResult, len(r.configurations.latest.Servers))\n  2084\t\n  2085\t\t// Propose the next term without actually changing our state\n  2086\t\tnewTerm := r.getCurrentTerm() + 1\n  2087\t\n  2088\t\t// Construct the request\n  2089\t\tlastIdx, lastTerm := r.getLastEntry()\n  2090\t\treq := &RequestPreVoteRequest{\n  2091\t\t\tRPCHeader:    r.getRPCHeader(),\n  2092\t\t\tTerm:         newTerm,\n  2093\t\t\tLastLogIndex: lastIdx,\n  2094\t\t\tLastLogTerm:  lastTerm,\n  2095\t\t}\n  2096\t\n  2097\t\t// Construct a function to ask for a vote\n  2098\t\taskPeer := func(peer Server) {\n  2099\t\t\tr.goFunc(func() {\n  2100\t\t\t\tdefer metrics.MeasureSince([]string{\"raft\", \"candidate\", \"preElectSelf\"}, time.Now())\n","exit_code":0,"status":"completed"}}
