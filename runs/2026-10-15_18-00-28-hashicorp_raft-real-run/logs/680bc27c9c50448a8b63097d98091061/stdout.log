{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n replication.go | sed -n 220,480p'","aggregated_output":"   220\t\ts.peerLock.RUnlock()\n   221\t\n   222\t\t// Setup the request\n   223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n   224\t\t\tgoto SEND_SNAP\n   225\t\t} else if err != nil {\n   226\t\t\treturn\n   227\t\t}\n   228\t\n   229\t\t// Make the RPC call\n   230\t\tstart = time.Now()\n   231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n   233\t\t\ts.failures++\n   234\t\t\treturn\n   235\t\t}\n   236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n   237\t\n   238\t\t// Check for a newer term, stop running\n   239\t\tif resp.Term > req.Term {\n   240\t\t\tr.handleStaleTerm(s)\n   241\t\t\treturn true\n   242\t\t}\n   243\t\n   244\t\t// Update the last contact\n   245\t\ts.setLastContact()\n   246\t\n   247\t\t// Update s based on success\n   248\t\tif resp.Success {\n   249\t\t\t// Update our replication state\n   250\t\t\tupdateLastAppended(s, &req)\n   251\t\n   252\t\t\t// Clear any failures, allow pipelining\n   253\t\t\ts.failures = 0\n   254\t\t\ts.allowPipeline = true\n   255\t\t} else {\n   256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n   257\t\t\tif resp.NoRetryBackoff {\n   258\t\t\t\ts.failures = 0\n   259\t\t\t} else {\n   260\t\t\t\ts.failures++\n   261\t\t\t}\n   262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n   263\t\t}\n   264\t\n   265\tCHECK_MORE:\n   266\t\t// Poll the stop channel here in case we are looping and have been asked\n   267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n   268\t\t// where we are asked to replicate to a given index and then shutdown,\n   269\t\t// it's better to not loop in here to send lots of entries to a straggler\n   270\t\t// that's leaving the cluster anyways.\n   271\t\tselect {\n   272\t\tcase <-s.stopCh:\n   273\t\t\treturn true\n   274\t\tdefault:\n   275\t\t}\n   276\t\n   277\t\t// Check if there are more logs to replicate\n   278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n   279\t\t\tgoto START\n   280\t\t}\n   281\t\treturn\n   282\t\n   283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n   284\t\t// is too far behind, and we must ship a snapshot down instead\n   285\tSEND_SNAP:\n   286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n   287\t\t\treturn true\n   288\t\t} else if err != nil {\n   289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n   290\t\t\treturn\n   291\t\t}\n   292\t\n   293\t\t// Check if there is more to replicate\n   294\t\tgoto CHECK_MORE\n   295\t}\n   296\t\n   297\t// sendLatestSnapshot is used to send the latest snapshot we have\n   298\t// down to our follower.\n   299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n   300\t\t// Get the snapshots\n   301\t\tsnapshots, err := r.snapshots.List()\n   302\t\tif err != nil {\n   303\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   304\t\t\treturn false, err\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer func() { _ = snapshot.Close() }()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   381\t\t}\n   382\t\treturn false, nil\n   383\t}\n   384\t\n   385\t// heartbeat is used to periodically invoke AppendEntries on a peer\n   386\t// to ensure they don't time out. This is done async of replicate(),\n   387\t// since that routine could potentially be blocked on disk IO.\n   388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n   389\t\tvar failures uint64\n   390\t\treq := AppendEntriesRequest{\n   391\t\t\tRPCHeader: r.getRPCHeader(),\n   392\t\t\tTerm:      s.currentTerm,\n   393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n   395\t\t}\n   396\t\n   397\t\tvar resp AppendEntriesResponse\n   398\t\tfor {\n   399\t\t\t// Wait for the next heartbeat interval or forced notify\n   400\t\t\tselect {\n   401\t\t\tcase <-s.notifyCh:\n   402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n   403\t\t\tcase <-stopCh:\n   404\t\t\t\treturn\n   405\t\t\t}\n   406\t\n   407\t\t\ts.peerLock.RLock()\n   408\t\t\tpeer := s.peer\n   409\t\t\ts.peerLock.RUnlock()\n   410\t\n   411\t\t\tstart := time.Now()\n   412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n   414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n   415\t\t\t\t\tnextBackoffTime, \"error\", err)\n   416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n   417\t\t\t\tfailures++\n   418\t\t\t\tselect {\n   419\t\t\t\tcase <-time.After(nextBackoffTime):\n   420\t\t\t\tcase <-stopCh:\n   421\t\t\t\t\treturn\n   422\t\t\t\t}\n   423\t\t\t} else {\n   424\t\t\t\tif failures > 0 {\n   425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n   426\t\t\t\t}\n   427\t\t\t\ts.setLastContact()\n   428\t\t\t\tfailures = 0\n   429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n   431\t\n   432\t\t\t\tif !r.noLegacyTelemetry {\n   433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n   434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n   435\t\t\t\t}\n   436\t\n   437\t\t\t\ts.notifyAll(resp.Success)\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n   443\t// and want to switch to a higher performance pipeline mode of replication.\n   444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n   445\t// back to the standard replication which can handle more complex situations.\n   446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n   447\t\ts.peerLock.RLock()\n   448\t\tpeer := s.peer\n   449\t\ts.peerLock.RUnlock()\n   450\t\n   451\t\t// Create a new pipeline\n   452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n   453\t\tif err != nil {\n   454\t\t\treturn err\n   455\t\t}\n   456\t\tdefer func() { _ = pipeline.Close() }()\n   457\t\n   458\t\t// Log start and stop of pipeline\n   459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n   460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n   461\t\n   462\t\t// Create a shutdown and finish channel\n   463\t\tstopCh := make(chan struct{})\n   464\t\tfinishCh := make(chan struct{})\n   465\t\n   466\t\t// Start a dedicated decoder\n   467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n   468\t\n   469\t\t// Start pipeline sends at the last good nextIndex\n   470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n   471\t\n   472\t\tshouldStop := false\n   473\tSEND:\n   474\t\tfor !shouldStop {\n   475\t\t\tselect {\n   476\t\t\tcase <-finishCh:\n   477\t\t\t\tbreak SEND\n   478\t\t\tcase maxIndex := <-s.stopCh:\n   479\t\t\t\t// Make a best effort to replicate up to this index\n   480\t\t\t\tif maxIndex > 0 {\n","exit_code":0,"status":"completed"}}
