figuration(singleServer, 2, req)\n273:\t\tt.Fatalf(\"nextConfiguration should have succeeded, got %v\", err)\n283:\t_, err = nextConfiguration(singleServer, 2, req)\n285:\t\tt.Fatalf(\"nextConfiguration should have succeeded, got %v\", err)\n289:func TestConfiguration_nextConfiguration_checkConfiguration(t *testing.T) {\n291:\t\tcommand:       AddNonvoter,\n295:\t_, err := nextConfiguration(Configuration{}, 1, req)\n297:\t\tt.Fatalf(\"nextConfiguration should have failed for not having a voter\")\n","exit_code":0,"status":"completed"}}
