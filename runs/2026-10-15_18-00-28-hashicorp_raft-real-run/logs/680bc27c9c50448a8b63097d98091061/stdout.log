n fmt.Errorf(\"RPC does not have a header\")\n    51\t\t}\n    52\t\theader := wh.GetRPCHeader()\n    53\t\n    54\t\t// First check is to just make sure the code can understand the\n    55\t\t// protocol at all.\n    56\t\tif header.ProtocolVersion < ProtocolVersionMin ||\n    57\t\t\theader.ProtocolVersion > ProtocolVersionMax {\n    58\t\t\treturn ErrUnsupportedProtocol\n    59\t\t}\n    60\t\n---\n36:func (r *Raft) getRPCHeader() RPCHeader {\n46:func (r *Raft) checkRPCHeader(rpc RPC) error {\n101:func (r *Raft) setLeader(leaderAddr ServerAddress, leaderID ServerID) {\n116:func (r *Raft) requestConfigChange(req configurationChangeRequest, timeout time.Duration) IndexFuture {\n136:func (r *Raft) run() {\n159:func (r *Raft) runFollower() {\n262:func (r *Raft) liveBootstrap(configuration Configuration) error {\n286:func (r *Raft) runCandidate() {\n443:func (r *Raft) setLeadershipTransferInProgress(v bool) {\n451:func (r *Raft) getLeadershipTransferInProgress() bool {\n456:func (r *Raft) setupLeaderState() {\n469:func (r *Raft) runLeader() {\n583:func (r *Raft) startStopReplication() {\n654:func (r *Raft) configurationChangeChIfStable() chan *configurationChangeFuture {\n668:func (r *Raft) leaderLoop() {\n966:func (r *Raft) verifyLeader(v *verifyFuture) {\n991:func (r *Raft) leadershipTransfer(id ServerID, address ServerAddress, repl *followerReplication, stopCh chan struct{}, doneCh chan error) {\n1037:func (r *Raft) checkLeaderLease() time.Duration {\n1087:func (r *Raft) quorumSize() int {\n1105:func (r *Raft) restoreUserSnapshot(meta *SnapshotMeta, reader io.Reader) error {\n1204:func (r *Raft) appendConfigurationEntry(future *configurationChangeFuture) {\n1245:func (r *Raft) dispatchLogs(applyLogs []*logFuture) {\n1296:func (r *Raft) processLogs(index uint64, futures map[uint64]*logFuture) {\n1366:func (r *Raft) prepareLog(l *Log, future *logFuture) *commitTuple {\n1393:func (r *Raft) tryStageCommitIndex(commitIndex uint64) {\n1408:func (r *Raft) processRPC(rpc RPC) {\n1436:func (r *Raft) processHeartbeat(rpc RPC) {\n1458:func (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n1608:func (r *Raft) processConfigurationLogEntry(entry *Log) error {\n1626:func (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n1759:func (r *Raft) requestPreVote(rpc RPC, req *RequestPreVoteRequest) {\n1837:func (r *Raft) installSnapshot(rpc RPC, req *InstallSnapshotRequest) {\n1979:func (r *Raft) setLastContact() {\n1999:func (r *Raft) electSelf() <-chan *voteResult {\n2073:func (r *Raft) preElectSelf() <-chan *preVoteResult {\n2153:func (r *Raft) persistVote(term uint64, candidate []byte) error {\n2164:func (r *Raft) setCurrentTerm(t uint64) {\n2175:func (r *Raft) setState(state RaftState) {\n2186:func (r *Raft) pickServer() *Server {\n2210:func (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n2232:func (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n2240:func (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n2247:func (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n2255:func (r *Raft) getLatestConfiguration() Configuration {\n","exit_code":0,"status":"completed"}}
