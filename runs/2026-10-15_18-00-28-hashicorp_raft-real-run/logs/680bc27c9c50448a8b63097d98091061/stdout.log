{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n snapshot.go'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"io\"\n    10\t\t\"time\"\n    11\t\n    12\t\tmetrics \"github.com/hashicorp/go-metrics\"\n    13\t)\n    14\t\n    15\t// SnapshotMeta is for metadata of a snapshot.\n    16\ttype SnapshotMeta struct {\n    17\t\t// Version is the version number of the snapshot metadata. This does not cover\n    18\t\t// the application's data in the snapshot, that should be versioned\n    19\t\t// separately.\n    20\t\tVersion SnapshotVersion\n    21\t\n    22\t\t// ID is opaque to the store, and is used for opening.\n    23\t\tID string\n    24\t\n    25\t\t// Index and Term store when the snapshot was taken.\n    26\t\tIndex uint64\n    27\t\tTerm  uint64\n    28\t\n    29\t\t// Peers is deprecated and used to support version 0 snapshots, but will\n    30\t\t// be populated in version 1 snapshots as well to help with upgrades.\n    31\t\tPeers []byte\n    32\t\n    33\t\t// Configuration and ConfigurationIndex are present in version 1\n    34\t\t// snapshots and later.\n    35\t\tConfiguration      Configuration\n    36\t\tConfigurationIndex uint64\n    37\t\n    38\t\t// Size is the size of the snapshot in bytes.\n    39\t\tSize int64\n    40\t}\n    41\t\n    42\t// SnapshotStore interface is used to allow for flexible implementations\n    43\t// of snapshot storage and retrieval. For example, a client could implement\n    44\t// a shared state store such as S3, allowing new nodes to restore snapshots\n    45\t// without streaming from the leader.\n    46\ttype SnapshotStore interface {\n    47\t\t// Create is used to begin a snapshot at a given index and term, and with\n    48\t\t// the given committed configuration. The version parameter controls\n    49\t\t// which snapshot version to create.\n    50\t\tCreate(version SnapshotVersion, index, term uint64, configuration Configuration,\n    51\t\t\tconfigurationIndex uint64, trans Transport) (SnapshotSink, error)\n    52\t\n    53\t\t// List is used to list the available snapshots in the store.\n    54\t\t// It should return then in descending order, with the highest index first.\n    55\t\tList() ([]*SnapshotMeta, error)\n    56\t\n    57\t\t// Open takes a snapshot ID and provides a ReadCloser. Once close is\n    58\t\t// called it is assumed the snapshot is no longer needed.\n    59\t\tOpen(id string) (*SnapshotMeta, io.ReadCloser, error)\n    60\t}\n    61\t\n    62\t// SnapshotSink is returned by StartSnapshot. The FSM will Write state\n    63\t// to the sink and call Close on completion. On error, Cancel will be invoked.\n    64\ttype SnapshotSink interface {\n    65\t\tio.WriteCloser\n    66\t\tID() string\n    67\t\tCancel() error\n    68\t}\n    69\t\n    70\t// runSnapshots is a long running goroutine used to manage taking\n    71\t// new snapshots of the FSM. It runs in parallel to the FSM and\n    72\t// main goroutines, so that snapshots do not block normal operation.\n    73\tfunc (r *Raft) runSnapshots() {\n    74\t\tfor {\n    75\t\t\tselect {\n    76\t\t\tcase <-randomTimeout(r.config().SnapshotInterval):\n    77\t\t\t\t// Check if we should snapshot\n    78\t\t\t\tif !r.shouldSnapshot() {\n    79\t\t\t\t\tcontinue\n    80\t\t\t\t}\n    81\t\n    82\t\t\t\t// Trigger a snapshot\n    83\t\t\t\tif _, err := r.takeSnapshot(); err != nil && !errors.Is(err, ErrNothingNewToSnapshot) {\n    84\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    85\t\t\t\t}\n    86\t\n    87\t\t\tcase future := <-r.userSnapshotCh:\n    88\t\t\t\t// User-triggered, run immediately\n    89\t\t\t\tid, err := r.takeSnapshot()\n    90\t\t\t\tif err != nil && !errors.Is(err, ErrNothingNewToSnapshot) {\n    91\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    92\t\t\t\t} else if err == nil {\n    93\t\t\t\t\tfuture.opener = func() (*SnapshotMeta, io.ReadCloser, error) {\n    94\t\t\t\t\t\treturn r.snapshots.Open(id)\n    95\t\t\t\t\t}\n    96\t\t\t\t}\n    97\t\t\t\tfuture.respond(err)\n    98\t\n    99\t\t\tcase <-r.shutdownCh:\n   100\t\t\t\treturn\n   101\t\t\t}\n   102\t\t}\n   103\t}\n   104\t\n   105\t// shouldSnapshot checks if we meet the conditions to take\n   106\t// a new snapshot.\n   107\tfunc (r *Raft) shouldSnapshot() bool {\n   108\t\t// Check the last snapshot index\n   109\t\tlastSnap, _ := r.getLastSnapshot()\n   110\t\n   111\t\t// Check the last log index\n   112\t\tlastIdx, err := r.logs.LastIndex()\n   113\t\tif err != nil {\n   114\t\t\tr.logger.Error(\"failed to get last log index\", \"error\", err)\n   115\t\t\treturn false\n   116\t\t}\n   117\t\n   118\t\t// Compare the delta to the threshold\n   119\t\tdelta := lastIdx - lastSnap\n   120\t\treturn delta >= r.config().SnapshotThreshold\n   121\t}\n   122\t\n   123\t// takeSnapshot is used to take a new snapshot. This must only be called from\n   124\t// the snapshot thread, never the main thread. This returns the ID of the new\n   125\t// snapshot, along with an error.\n   126\tfunc (r *Raft) takeSnapshot() (string, error) {\n   127\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n   128\t\n   129\t\t// Create a request for the FSM to perform a snapshot.\n   130\t\tsnapReq := &reqSnapshotFuture{}\n   131\t\tsnapReq.init()\n   132\t\n   133\t\t// Wait for dispatch or shutdown.\n   134\t\tselect {\n   135\t\tcase r.fsmSnapshotCh <- snapReq:\n   136\t\tcase <-r.shutdownCh:\n   137\t\t\treturn \"\", ErrRaftShutdown\n   138\t\t}\n   139\t\n   140\t\t// Wait until we get a response\n   141\t\tif err := snapReq.Error(); err != nil {\n   142\t\t\tif err != ErrNothingNewToSnapshot {\n   143\t\t\t\terr = fmt.Errorf(\"failed to start snapshot: %v\", err)\n   144\t\t\t}\n   145\t\t\treturn \"\", err\n   146\t\t}\n   147\t\tdefer snapReq.snapshot.Release()\n   148\t\n   149\t\t// Make a request for the configurations and extract the committed info.\n   150\t\t// We have to use the future here to safely get this information since\n   151\t\t// it is owned by the main thread.\n   152\t\tconfigReq := &configurationsFuture{}\n   153\t\tconfigReq.ShutdownCh = r.shutdownCh\n   154\t\tconfigReq.init()\n   155\t\tselect {\n   156\t\tcase r.configurationsCh <- configReq:\n   157\t\tcase <-r.shutdownCh:\n   158\t\t\treturn \"\", ErrRaftShutdown\n   159\t\t}\n   160\t\tif err := configReq.Error(); err != nil {\n   161\t\t\treturn \"\", err\n   162\t\t}\n   163\t\tcommitted := configReq.configurations.committed\n   164\t\tcommittedIndex := configReq.configurations.committedIndex\n   165\t\n   166\t\t// We don't support snapshots while there's a config change outstanding\n   167\t\t// since the snapshot doesn't have a means to represent this state. This\n   168\t\t// is a little weird because we need the FSM to apply an index that's\n   169\t\t// past the configuration change, even though the FSM itself doesn't see\n   170\t\t// the configuration changes. It should be ok in practice with normal\n   171\t\t// application traffic flowing through the FSM. If there's none of that\n   172\t\t// then it's not crucial that we snapshot, since there's not much going\n   173\t\t// on Raft-wise.\n   174\t\tif snapReq.index < committedIndex {\n   175\t\t\treturn \"\", fmt.Errorf(\"cannot take snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n   176\t\t\t\tcommittedIndex, snapReq.index)\n   177\t\t}\n   178\t\n   179\t\t// Create a new snapshot.\n   180\t\tr.logger.Info(\"starting snapshot up to\", \"index\", snapReq.index)\n   181\t\tstart := time.Now()\n   182\t\tversion := getSnapshotVersion(r.protocolVersion)\n   183\t\tsink, err := r.snapshots.Create(version, snapReq.index, snapReq.term, committed, committedIndex, r.trans)\n   184\t\tif err != nil {\n   185\t\t\treturn \"\", fmt.Errorf(\"failed to create snapshot: %v\", err)\n   186\t\t}\n   187\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"create\"}, start)\n   188\t\n   189\t\t// Try to persist the snapshot.\n   190\t\tstart = time.Now()\n   191\t\tif err := snapReq.snapshot.Persist(sink); err != nil {\n   192\t\t\t_ = sink.Cancel()\n   193\t\t\treturn \"\", fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   194\t\t}\n   195\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"persist\"}, start)\n   196\t\n   197\t\t// Close and check for error.\n   198\t\tif err := sink.Close(); err != nil {\n   199\t\t\treturn \"\", fmt.Errorf(\"failed to close snapshot: %v\", err)\n   200\t\t}\n   201\t\n   202\t\t// Update the last stable snapshot info.\n   203\t\tr.setLastSnapshot(snapReq.index, snapReq.term)\n   204\t\n   205\t\t// Compact the logs.\n   206\t\tif err := r.compactLogs(snapReq.index); err != nil {\n   207\t\t\treturn \"\", err\n   208\t\t}\n   209\t\n   210\t\tr.logger.Info(\"snapshot complete up to\", \"index\", snapReq.index)\n   211\t\treturn sink.ID(), nil\n   212\t}\n   213\t\n   214\t// compactLogsWithTrailing takes the last inclusive index of a snapshot,\n   215\t// the lastLogIdx, and the trailingLogs and trims the logs that\n   216\t// are no longer needed.\n   217\tfunc (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n   218\t\t// Determine log ranges to compact\n   219\t\tminLog, err := r.logs.FirstIndex()\n   220\t\tif err != nil {\n   221\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   222\t\t}\n   223\t\n   224\t\t// Check if we have enough logs to truncate\n   225\t\t// Use a consistent value for trailingLogs for the duration of this method\n   226\t\t// call to avoid surprising behaviour.\n   227\t\tif lastLogIdx <= trailingLogs {\n   228\t\t\treturn nil\n   229\t\t}\n   230\t\n   231\t\t// Truncate up to the end of the snapshot, or `TrailingLogs`\n   232\t\t// back from the head, which ever is further back. This ensures\n   233\t\t// at least `TrailingLogs` entries, but does not allow logs\n   234\t\t// after the snapshot to be removed.\n   235\t\tmaxLog := min(snapIdx, lastLogIdx-trailingLogs)\n   236\t\n   237\t\tif minLog > maxLog {\n   238\t\t\tr.logger.Info(\"no logs to truncate\")\n   239\t\t\treturn nil\n   240\t\t}\n   241\t\n   242\t\tr.logger.Info(\"compacting logs\", \"from\", minLog, \"to\", maxLog)\n   243\t\n   244\t\t// Compact the logs\n   245\t\tif err := r.logs.DeleteRange(minLog, maxLog); err != nil {\n   246\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   247\t\t}\n   248\t\treturn nil\n   249\t}\n   250\t\n   251\t// compactLogs takes the last inclusive index of a snapshot\n   252\t// and trims the logs that are no longer needed.\n   253\tfunc (r *Raft) compactLogs(snapIdx uint64) error {\n   254\t\tdefer metrics.MeasureSince([]string{\"raft\", \"compactLogs\"}, time.Now())\n   255\t\n   256\t\tlastLogIdx, _ := r.getLastLog()\n   257\t\ttrailingLogs := r.config().TrailingLogs\n   258\t\n   259\t\treturn r.compactLogsWithTrailing(snapIdx, lastLogIdx, trailingLogs)\n   260\t}\n   261\t\n   262\t// removeOldLogs removes all old logs from the store. This is used for\n   263\t// MonotonicLogStores after restore. Callers should verify that the store\n   264\t// implementation is monotonic prior to calling.\n   265\tfunc (r *Raft) removeOldLogs() error {\n   266\t\tdefer metrics.MeasureSince([]string{\"raft\", \"removeOldLogs\"}, time.Now())\n   267\t\n   268\t\tlastLogIdx, err := r.logs.LastIndex()\n   269\t\tif err != nil {\n   270\t\t\treturn fmt.Errorf(\"failed to get last log index: %w\", err)\n   271\t\t}\n   272\t\n   273\t\tr.logger.Info(\"removing all old logs from log store\")\n   274\t\n   275\t\t// call compactLogsWithTrailing with lastLogIdx for snapIdx since\n   276\t\t// it will take the lesser of lastLogIdx and snapIdx to figure out\n   277\t\t// the end for which to apply trailingLogs.\n   278\t\treturn r.compactLogsWithTrailing(lastLogIdx, lastLogIdx, 0)\n   279\t}\n","exit_code":0,"status":"completed"}}
