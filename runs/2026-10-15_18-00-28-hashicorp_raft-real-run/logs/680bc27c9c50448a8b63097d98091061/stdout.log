{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n file_snapshot.go | sed -n 300,551p'","aggregated_output":"   300\t\n   301\t\t// Buffer the file IO\n   302\t\tbuffered := bufio.NewReader(fh)\n   303\t\n   304\t\t// Read in the JSON\n   305\t\tmeta := &fileSnapshotMeta{}\n   306\t\tdec := json.NewDecoder(buffered)\n   307\t\tif err := dec.Decode(meta); err != nil {\n   308\t\t\treturn nil, err\n   309\t\t}\n   310\t\treturn meta, nil\n   311\t}\n   312\t\n   313\t// Open takes a snapshot ID and returns a ReadCloser for that snapshot.\n   314\tfunc (f *FileSnapshotStore) Open(id string) (*SnapshotMeta, io.ReadCloser, error) {\n   315\t\t// Get the metadata\n   316\t\tmeta, err := f.readMeta(id)\n   317\t\tif err != nil {\n   318\t\t\tf.logger.Error(\"failed to get meta data to open snapshot\", \"error\", err)\n   319\t\t\treturn nil, nil, err\n   320\t\t}\n   321\t\n   322\t\t// Open the state file\n   323\t\tstatePath := filepath.Join(f.path, id, stateFilePath)\n   324\t\tfh, err := os.Open(statePath)\n   325\t\tif err != nil {\n   326\t\t\tf.logger.Error(\"failed to open state file\", \"error\", err)\n   327\t\t\treturn nil, nil, err\n   328\t\t}\n   329\t\n   330\t\t// Create a CRC64 hash\n   331\t\tstateHash := crc64.New(crc64.MakeTable(crc64.ECMA))\n   332\t\n   333\t\t// Compute the hash\n   334\t\t_, err = io.Copy(stateHash, fh)\n   335\t\tif err != nil {\n   336\t\t\tf.logger.Error(\"failed to read state file\", \"error\", err)\n   337\t\t\t_ = fh.Close()\n   338\t\t\treturn nil, nil, err\n   339\t\t}\n   340\t\n   341\t\t// Verify the hash\n   342\t\tcomputed := stateHash.Sum(nil)\n   343\t\tif !bytes.Equal(meta.CRC, computed) {\n   344\t\t\tf.logger.Error(\"CRC checksum failed\", \"stored\", meta.CRC, \"computed\", computed)\n   345\t\t\t_ = fh.Close()\n   346\t\t\treturn nil, nil, fmt.Errorf(\"CRC mismatch\")\n   347\t\t}\n   348\t\n   349\t\t// Seek to the start\n   350\t\tif _, err := fh.Seek(0, 0); err != nil {\n   351\t\t\tf.logger.Error(\"state file seek failed\", \"error\", err)\n   352\t\t\t_ = fh.Close()\n   353\t\t\treturn nil, nil, err\n   354\t\t}\n   355\t\n   356\t\t// Return a buffered file\n   357\t\tbuffered := &bufferedFile{\n   358\t\t\tbh: bufio.NewReader(fh),\n   359\t\t\tfh: fh,\n   360\t\t}\n   361\t\n   362\t\treturn &meta.SnapshotMeta, buffered, nil\n   363\t}\n   364\t\n   365\t// ReapSnapshots reaps any snapshots beyond the retain count.\n   366\tfunc (f *FileSnapshotStore) ReapSnapshots() error {\n   367\t\tsnapshots, err := f.getSnapshots()\n   368\t\tif err != nil {\n   369\t\t\tf.logger.Error(\"failed to get snapshots\", \"error\", err)\n   370\t\t\treturn err\n   371\t\t}\n   372\t\n   373\t\tfor i := f.retain; i < len(snapshots); i++ {\n   374\t\t\tpath := filepath.Join(f.path, snapshots[i].ID)\n   375\t\t\tf.logger.Info(\"reaping snapshot\", \"path\", path)\n   376\t\t\tif err := os.RemoveAll(path); err != nil {\n   377\t\t\t\tf.logger.Error(\"failed to reap snapshot\", \"path\", path, \"error\", err)\n   378\t\t\t\treturn err\n   379\t\t\t}\n   380\t\t}\n   381\t\treturn nil\n   382\t}\n   383\t\n   384\t// ID returns the ID of the snapshot, can be used with Open()\n   385\t// after the snapshot is finalized.\n   386\tfunc (s *FileSnapshotSink) ID() string {\n   387\t\treturn s.meta.ID\n   388\t}\n   389\t\n   390\t// Write is used to append to the state file. We write to the\n   391\t// buffered IO object to reduce the amount of context switches.\n   392\tfunc (s *FileSnapshotSink) Write(b []byte) (int, error) {\n   393\t\treturn s.buffered.Write(b)\n   394\t}\n   395\t\n   396\t// Close is used to indicate a successful end.\n   397\tfunc (s *FileSnapshotSink) Close() error {\n   398\t\t// Make sure close is idempotent\n   399\t\tif s.closed {\n   400\t\t\treturn nil\n   401\t\t}\n   402\t\ts.closed = true\n   403\t\n   404\t\t// Close the open handles\n   405\t\tif err := s.finalize(); err != nil {\n   406\t\t\ts.logger.Error(\"failed to finalize snapshot\", \"error\", err)\n   407\t\t\tif delErr := os.RemoveAll(s.dir); delErr != nil {\n   408\t\t\t\ts.logger.Error(\"failed to delete temporary snapshot directory\", \"path\", s.dir, \"error\", delErr)\n   409\t\t\t\treturn delErr\n   410\t\t\t}\n   411\t\t\treturn err\n   412\t\t}\n   413\t\n   414\t\t// Write out the meta data\n   415\t\tif err := s.writeMeta(); err != nil {\n   416\t\t\ts.logger.Error(\"failed to write metadata\", \"error\", err)\n   417\t\t\treturn err\n   418\t\t}\n   419\t\n   420\t\t// Move the directory into place\n   421\t\tnewPath := strings.TrimSuffix(s.dir, tmpSuffix)\n   422\t\tif err := os.Rename(s.dir, newPath); err != nil {\n   423\t\t\ts.logger.Error(\"failed to move snapshot into place\", \"error\", err)\n   424\t\t\treturn err\n   425\t\t}\n   426\t\n   427\t\tif !s.noSync && runtime.GOOS != \"windows\" { // skipping fsync for directory entry edits on Windows, only needed for *nix style file systems\n   428\t\t\tparentFH, err := os.Open(s.parentDir)\n   429\t\t\tif err != nil {\n   430\t\t\t\ts.logger.Error(\"failed to open snapshot parent directory\", \"path\", s.parentDir, \"error\", err)\n   431\t\t\t\treturn err\n   432\t\t\t}\n   433\t\t\tdefer func() { _ = parentFH.Close() }()\n   434\t\n   435\t\t\tif err = parentFH.Sync(); err != nil {\n   436\t\t\t\ts.logger.Error(\"failed syncing parent directory\", \"path\", s.parentDir, \"error\", err)\n   437\t\t\t\treturn err\n   438\t\t\t}\n   439\t\t}\n   440\t\n   441\t\t// Reap any old snapshots\n   442\t\tif err := s.store.ReapSnapshots(); err != nil {\n   443\t\t\treturn err\n   444\t\t}\n   445\t\n   446\t\treturn nil\n   447\t}\n   448\t\n   449\t// Cancel is used to indicate an unsuccessful end.\n   450\tfunc (s *FileSnapshotSink) Cancel() error {\n   451\t\t// Make sure close is idempotent\n   452\t\tif s.closed {\n   453\t\t\treturn nil\n   454\t\t}\n   455\t\ts.closed = true\n   456\t\n   457\t\t// Close the open handles\n   458\t\tif err := s.finalize(); err != nil {\n   459\t\t\ts.logger.Error(\"failed to finalize snapshot\", \"error\", err)\n   460\t\t\treturn err\n   461\t\t}\n   462\t\n   463\t\t// Attempt to remove all artifacts\n   464\t\treturn os.RemoveAll(s.dir)\n   465\t}\n   466\t\n   467\t// finalize is used to close all of our resources.\n   468\tfunc (s *FileSnapshotSink) finalize() error {\n   469\t\t// Flush any remaining data\n   470\t\tif err := s.buffered.Flush(); err != nil {\n   471\t\t\treturn err\n   472\t\t}\n   473\t\n   474\t\t// Sync to force fsync to disk\n   475\t\tif !s.noSync {\n   476\t\t\tif err := s.stateFile.Sync(); err != nil {\n   477\t\t\t\treturn err\n   478\t\t\t}\n   479\t\t}\n   480\t\n   481\t\t// Get the file size\n   482\t\tstat, statErr := s.stateFile.Stat()\n   483\t\n   484\t\t// Close the file\n   485\t\tif err := s.stateFile.Close(); err != nil {\n   486\t\t\treturn err\n   487\t\t}\n   488\t\n   489\t\t// Set the file size, check after we close\n   490\t\tif statErr != nil {\n   491\t\t\treturn statErr\n   492\t\t}\n   493\t\ts.meta.Size = stat.Size()\n   494\t\n   495\t\t// Set the CRC\n   496\t\ts.meta.CRC = s.stateHash.Sum(nil)\n   497\t\treturn nil\n   498\t}\n   499\t\n   500\t// writeMeta is used to write out the metadata we have.\n   501\tfunc (s *FileSnapshotSink) writeMeta() error {\n   502\t\tvar err error\n   503\t\t// Open the meta file\n   504\t\tmetaPath := filepath.Join(s.dir, metaFilePath)\n   505\t\tvar fh *os.File\n   506\t\tfh, err = os.Create(metaPath)\n   507\t\tif err != nil {\n   508\t\t\treturn err\n   509\t\t}\n   510\t\tdefer func() { _ = fh.Close() }()\n   511\t\n   512\t\t// Buffer the file IO\n   513\t\tbuffered := bufio.NewWriter(fh)\n   514\t\n   515\t\t// Write out as JSON\n   516\t\tenc := json.NewEncoder(buffered)\n   517\t\tif err = enc.Encode(&s.meta); err != nil {\n   518\t\t\treturn err\n   519\t\t}\n   520\t\n   521\t\tif err = buffered.Flush(); err != nil {\n   522\t\t\treturn err\n   523\t\t}\n   524\t\n   525\t\tif !s.noSync {\n   526\t\t\tif err = fh.Sync(); err != nil {\n   527\t\t\t\treturn err\n   528\t\t\t}\n   529\t\t}\n   530\t\n   531\t\treturn nil\n   532\t}\n   533\t\n   534\t// Implement the sort interface for []*fileSnapshotMeta.\n   535\tfunc (s snapMetaSlice) Len() int {\n   536\t\treturn len(s)\n   537\t}\n   538\t\n   539\tfunc (s snapMetaSlice) Less(i, j int) bool {\n   540\t\tif s[i].Term != s[j].Term {\n   541\t\t\treturn s[i].Term < s[j].Term\n   542\t\t}\n   543\t\tif s[i].Index != s[j].Index {\n   544\t\t\treturn s[i].Index < s[j].Index\n   545\t\t}\n   546\t\treturn s[i].ID < s[j].ID\n   547\t}\n   548\t\n   549\tfunc (s snapMetaSlice) Swap(i, j int) {\n   550\t\ts[i], s[j] = s[j], s[i]\n   551\t}\n","exit_code":0,"status":"completed"}}
