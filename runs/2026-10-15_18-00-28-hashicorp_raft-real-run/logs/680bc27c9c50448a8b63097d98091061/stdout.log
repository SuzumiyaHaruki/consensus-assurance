{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n configuration.go'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\t// ServerID is a unique string identifying a server for all time.\n    55\ttype ServerID string\n    56\t\n    57\t// ServerAddress is a network address for a server that a transport can contact.\n    58\ttype ServerAddress string\n    59\t\n    60\t// Server tracks the information about a single server in a configuration.\n    61\ttype Server struct {\n    62\t\t// Suffrage determines whether the server gets a vote.\n    63\t\tSuffrage ServerSuffrage\n    64\t\t// ID is a unique string identifying this server for all time.\n    65\t\tID ServerID\n    66\t\t// Address is its network address that a transport can contact.\n    67\t\tAddress ServerAddress\n    68\t}\n    69\t\n    70\t// Configuration tracks which servers are in the cluster, and whether they have\n    71\t// votes. This should include the local server, if it's a member of the cluster.\n    72\t// The servers are listed no particular order, but each should only appear once.\n    73\t// These entries are appended to the log during membership changes.\n    74\ttype Configuration struct {\n    75\t\tServers []Server\n    76\t}\n    77\t\n    78\t// Clone makes a deep copy of a Configuration.\n    79\tfunc (c *Configuration) Clone() (copy Configuration) {\n    80\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n    81\t\treturn\n    82\t}\n    83\t\n    84\t// ConfigurationChangeCommand is the different ways to change the cluster\n    85\t// configuration.\n    86\ttype ConfigurationChangeCommand uint8\n    87\t\n    88\tconst (\n    89\t\t// AddVoter adds a server with Suffrage of Voter.\n    90\t\tAddVoter ConfigurationChangeCommand = iota\n    91\t\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n    92\t\tAddNonvoter\n    93\t\t// DemoteVoter makes a server Nonvoter unless its absent.\n    94\t\tDemoteVoter\n    95\t\t// RemoveServer removes a server entirely from the cluster membership.\n    96\t\tRemoveServer\n    97\t\t// Promote changes a server from Staging to Voter. The command will be a\n    98\t\t// no-op if the server is not Staging.\n    99\t\t// Deprecated: use AddVoter instead.\n   100\t\tPromote\n   101\t\t// AddStaging makes a server a Voter.\n   102\t\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n   103\t\tAddStaging = 0 // explicit 0 to preserve the old value.\n   104\t)\n   105\t\n   106\tfunc (c ConfigurationChangeCommand) String() string {\n   107\t\tswitch c {\n   108\t\tcase AddVoter:\n   109\t\t\treturn \"AddVoter\"\n   110\t\tcase AddNonvoter:\n   111\t\t\treturn \"AddNonvoter\"\n   112\t\tcase DemoteVoter:\n   113\t\t\treturn \"DemoteVoter\"\n   114\t\tcase RemoveServer:\n   115\t\t\treturn \"RemoveServer\"\n   116\t\tcase Promote:\n   117\t\t\treturn \"Promote\"\n   118\t\t}\n   119\t\treturn \"ConfigurationChangeCommand\"\n   120\t}\n   121\t\n   122\t// configurationChangeRequest describes a change that a leader would like to\n   123\t// make to its current configuration. It's used only within a single server\n   124\t// (never serialized into the log), as part of `configurationChangeFuture`.\n   125\ttype configurationChangeRequest struct {\n   126\t\tcommand       ConfigurationChangeCommand\n   127\t\tserverID      ServerID\n   128\t\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n   129\t\t// prevIndex, if nonzero, is the index of the only configuration upon which\n   130\t\t// this change may be applied; if another configuration entry has been\n   131\t\t// added in the meantime, this request will fail.\n   132\t\tprevIndex uint64\n   133\t}\n   134\t\n   135\t// configurations is state tracked on every server about its Configurations.\n   136\t// Note that, per Diego's dissertation, there can be at most one uncommitted\n   137\t// configuration at a time (the next configuration may not be created until the\n   138\t// prior one has been committed).\n   139\t//\n   140\t// One downside to storing just two configurations is that if you try to take a\n   141\t// snapshot when your state machine hasn't yet applied the committedIndex, we\n   142\t// have no record of the configuration that would logically fit into that\n   143\t// snapshot. We disallow snapshots in that case now. An alternative approach,\n   144\t// which LogCabin uses, is to track every configuration change in the\n   145\t// log.\n   146\ttype configurations struct {\n   147\t\t// committed is the latest configuration in the log/snapshot that has been\n   148\t\t// committed (the one with the largest index).\n   149\t\tcommitted Configuration\n   150\t\t// committedIndex is the log index where 'committed' was written.\n   151\t\tcommittedIndex uint64\n   152\t\t// latest is the latest configuration in the log/snapshot (may be committed\n   153\t\t// or uncommitted)\n   154\t\tlatest Configuration\n   155\t\t// latestIndex is the log index where 'latest' was written.\n   156\t\tlatestIndex uint64\n   157\t}\n   158\t\n   159\t// Clone makes a deep copy of a configurations object.\n   160\tfunc (c *configurations) Clone() (copy configurations) {\n   161\t\tcopy.committed = c.committed.Clone()\n   162\t\tcopy.committedIndex = c.committedIndex\n   163\t\tcopy.latest = c.latest.Clone()\n   164\t\tcopy.latestIndex = c.latestIndex\n   165\t\treturn\n   166\t}\n   167\t\n   168\t// hasVote returns true if the server identified by 'id' is a Voter in the\n   169\t// provided Configuration.\n   170\tfunc hasVote(configuration Configuration, id ServerID) bool {\n   171\t\tfor _, server := range configuration.Servers {\n   172\t\t\tif server.ID == id {\n   173\t\t\t\treturn server.Suffrage == Voter\n   174\t\t\t}\n   175\t\t}\n   176\t\treturn false\n   177\t}\n   178\t\n   179\t// inConfiguration returns true if the server identified by 'id' is in the\n   180\t// provided Configuration.\n   181\tfunc inConfiguration(configuration Configuration, id ServerID) bool {\n   182\t\tfor _, server := range configuration.Servers {\n   183\t\t\tif server.ID == id {\n   184\t\t\t\treturn true\n   185\t\t\t}\n   186\t\t}\n   187\t\treturn false\n   188\t}\n   189\t\n   190\t// checkConfiguration tests a cluster membership configuration for common\n   191\t// errors.\n   192\tfunc checkConfiguration(configuration Configuration) error {\n   193\t\tidSet := make(map[ServerID]bool)\n   194\t\taddressSet := make(map[ServerAddress]bool)\n   195\t\tvar voters int\n   196\t\tfor _, server := range configuration.Servers {\n   197\t\t\tif server.ID == \"\" {\n   198\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   199\t\t\t}\n   200\t\t\tif server.Address == \"\" {\n   201\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   202\t\t\t}\n   203\t\t\tif idSet[server.ID] {\n   204\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   205\t\t\t}\n   206\t\t\tidSet[server.ID] = true\n   207\t\t\tif addressSet[server.Address] {\n   208\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   209\t\t\t}\n   210\t\t\taddressSet[server.Address] = true\n   211\t\t\tif server.Suffrage == Voter {\n   212\t\t\t\tvoters++\n   213\t\t\t}\n   214\t\t}\n   215\t\tif voters == 0 {\n   216\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   217\t\t}\n   218\t\treturn nil\n   219\t}\n   220\t\n   221\t// nextConfiguration generates a new Configuration from the current one and a\n   222\t// configuration change request. It's split from appendConfigurationEntry so\n   223\t// that it can be unit tested easily.\n   224\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   225\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   226\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   227\t\t}\n   228\t\n   229\t\tconfiguration := current.Clone()\n   230\t\tswitch change.command {\n   231\t\tcase AddVoter:\n   232\t\t\tnewServer := Server{\n   233\t\t\t\tSuffrage: Voter,\n   234\t\t\t\tID:       change.serverID,\n   235\t\t\t\tAddress:  change.serverAddress,\n   236\t\t\t}\n   237\t\t\tfound := false\n   238\t\t\tfor i, server := range configuration.Servers {\n   239\t\t\t\tif server.ID == change.serverID {\n   240\t\t\t\t\tif server.Suffrage == Voter {\n   241\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   242\t\t\t\t\t} else {\n   243\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   244\t\t\t\t\t}\n   245\t\t\t\t\tfound = true\n   246\t\t\t\t\tbreak\n   247\t\t\t\t}\n   248\t\t\t}\n   249\t\t\tif !found {\n   250\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   251\t\t\t}\n   252\t\tcase AddNonvoter:\n   253\t\t\tnewServer := Server{\n   254\t\t\t\tSuffrage: Nonvoter,\n   255\t\t\t\tID:       change.serverID,\n   256\t\t\t\tAddress:  change.serverAddress,\n   257\t\t\t}\n   258\t\t\tfound := false\n   259\t\t\tfor i, server := range configuration.Servers {\n   260\t\t\t\tif server.ID == change.serverID {\n   261\t\t\t\t\tif server.Suffrage != Nonvoter {\n   262\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   263\t\t\t\t\t} else {\n   264\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   265\t\t\t\t\t}\n   266\t\t\t\t\tfound = true\n   267\t\t\t\t\tbreak\n   268\t\t\t\t}\n   269\t\t\t}\n   270\t\t\tif !found {\n   271\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   272\t\t\t}\n   273\t\tcase DemoteVoter:\n   274\t\t\tfor i, server := range configuration.Servers {\n   275\t\t\t\tif server.ID == change.serverID {\n   276\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   277\t\t\t\t\tbreak\n   278\t\t\t\t}\n   279\t\t\t}\n   280\t\tcase RemoveServer:\n   281\t\t\tfor i, server := range configuration.Servers {\n   282\t\t\t\tif server.ID == change.serverID {\n   283\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   284\t\t\t\t\tbreak\n   285\t\t\t\t}\n   286\t\t\t}\n   287\t\tcase Promote:\n   288\t\t\tfor i, server := range configuration.Servers {\n   289\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   290\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   291\t\t\t\t\tbreak\n   292\t\t\t\t}\n   293\t\t\t}\n   294\t\t}\n   295\t\n   296\t\t// Make sure we didn't do something bad like remove the last voter\n   297\t\tif err := checkConfiguration(configuration); err != nil {\n   298\t\t\treturn Configuration{}, err\n   299\t\t}\n   300\t\n   301\t\treturn configuration, nil\n   302\t}\n   303\t\n   304\t// encodePeers is used to serialize a Configuration into the old peers format.\n   305\t// This is here for backwards compatibility when operating with a mix of old\n   306\t// servers and should be removed once we deprecate support for protocol version 1.\n   307\tfunc encodePeers(configuration Configuration, trans Transport) []byte {\n   308\t\t// Gather up all the voters, other suffrage types are not supported by\n   309\t\t// this data format.\n   310\t\tvar encPeers [][]byte\n   311\t\tfor _, server := range configuration.Servers {\n   312\t\t\tif server.Suffrage == Voter {\n   313\t\t\t\tencPeers = append(encPeers, trans.EncodePeer(server.ID, server.Address))\n   314\t\t\t}\n   315\t\t}\n   316\t\n   317\t\t// Encode the entire array.\n   318\t\tbuf, err := encodeMsgPack(encPeers)\n   319\t\tif err != nil {\n   320\t\t\tpanic(fmt.Errorf(\"failed to encode peers: %v\", err))\n   321\t\t}\n   322\t\n   323\t\treturn buf.Bytes()\n   324\t}\n   325\t\n   326\t// decodePeers is used to deserialize an old list of peers into a Configuration.\n   327\t// This is here for backwards compatibility with old log entries and snapshots;\n   328\t// it should be removed eventually.\n   329\tfunc decodePeers(buf []byte, trans Transport) (Configuration, error) {\n   330\t\t// Decode the buffer first.\n   331\t\tvar encPeers [][]byte\n   332\t\tif err := decodeMsgPack(buf, &encPeers); err != nil {\n   333\t\t\treturn Configuration{}, fmt.Errorf(\"failed to decode peers: %v\", err)\n   334\t\t}\n   335\t\n   336\t\t// Deserialize each peer.\n   337\t\tvar servers []Server\n   338\t\tfor _, enc := range encPeers {\n   339\t\t\tp := trans.DecodePeer(enc)\n   340\t\t\tservers = append(servers, Server{\n   341\t\t\t\tSuffrage: Voter,\n   342\t\t\t\tID:       ServerID(p),\n   343\t\t\t\tAddress:  p,\n   344\t\t\t})\n   345\t\t}\n   346\t\n   347\t\treturn Configuration{Servers: servers}, nil\n   348\t}\n   349\t\n   350\t// EncodeConfiguration serializes a Configuration using MsgPack, or panics on\n   351\t// errors.\n   352\tfunc EncodeConfiguration(configuration Configuration) []byte {\n   353\t\tbuf, err := encodeMsgPack(configuration)\n   354\t\tif err != nil {\n   355\t\t\tpanic(fmt.Errorf(\"failed to encode configuration: %v\", err))\n   356\t\t}\n   357\t\treturn buf.Bytes()\n   358\t}\n   359\t\n   360\t// DecodeConfiguration deserializes a Configuration using MsgPack, or panics on\n   361\t// errors.\n   362\tfunc DecodeConfiguration(buf []byte) Configuration {\n   363\t\tvar configuration Configuration\n   364\t\tif err := decodeMsgPack(buf, &configuration); err != nil {\n   365\t\t\tpanic(fmt.Errorf(\"failed to decode configuration: %v\", err))\n   366\t\t}\n   367\t\treturn configuration\n   368\t}\n","exit_code":0,"status":"completed"}}
