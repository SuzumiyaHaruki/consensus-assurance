{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n api.go | sed -n 560,900p'","aggregated_output":"   560\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n   561\t\t\tfsmSnapshotCh:         make(chan *reqSnapshotFuture),\n   562\t\t\tleaderCh:              make(chan bool, 1),\n   563\t\t\tlocalID:               localID,\n   564\t\t\tlocalAddr:             localAddr,\n   565\t\t\tlogger:                logger,\n   566\t\t\tlogs:                  logs,\n   567\t\t\tconfigurationChangeCh: make(chan *configurationChangeFuture),\n   568\t\t\tconfigurations:        configurations{},\n   569\t\t\trpcCh:                 trans.Consumer(),\n   570\t\t\tsnapshots:             snaps,\n   571\t\t\tuserSnapshotCh:        make(chan *userSnapshotFuture),\n   572\t\t\tuserRestoreCh:         make(chan *userRestoreFuture),\n   573\t\t\tshutdownCh:            make(chan struct{}),\n   574\t\t\tstable:                stable,\n   575\t\t\ttrans:                 trans,\n   576\t\t\tverifyCh:              make(chan *verifyFuture, 64),\n   577\t\t\tconfigurationsCh:      make(chan *configurationsFuture, 8),\n   578\t\t\tbootstrapCh:           make(chan *bootstrapFuture),\n   579\t\t\tobservers:             make(map[uint64]*Observer),\n   580\t\t\tleadershipTransferCh:  make(chan *leadershipTransferFuture, 1),\n   581\t\t\tleaderNotifyCh:        make(chan struct{}, 1),\n   582\t\t\tfollowerNotifyCh:      make(chan struct{}, 1),\n   583\t\t\tmainThreadSaturation:  newSaturationMetric([]string{\"raft\", \"thread\", \"main\", \"saturation\"}, 1*time.Second),\n   584\t\t\tpreVoteDisabled:       conf.PreVoteDisabled || !transportSupportPreVote,\n   585\t\t\tnoLegacyTelemetry:     conf.NoLegacyTelemetry,\n   586\t\t\tRestoreCommittedLogs:  conf.RestoreCommittedLogs,\n   587\t\t}\n   588\t\tif !transportSupportPreVote && !conf.PreVoteDisabled {\n   589\t\t\tr.logger.Warn(\"pre-vote is disabled because it is not supported by the Transport\")\n   590\t\t}\n   591\t\n   592\t\tr.conf.Store(*conf)\n   593\t\n   594\t\t// Initialize as a follower.\n   595\t\tr.setState(Follower)\n   596\t\n   597\t\t// Restore the current term and the last log.\n   598\t\tr.setCurrentTerm(currentTerm)\n   599\t\tr.setLastLog(lastLog.Index, lastLog.Term)\n   600\t\n   601\t\t// Attempt to restore a snapshot if there are any.\n   602\t\tif err := r.restoreSnapshot(); err != nil {\n   603\t\t\treturn nil, err\n   604\t\t}\n   605\t\n   606\t\tif err := r.restoreFromCommittedLogs(); err != nil {\n   607\t\t\treturn nil, err\n   608\t\t}\n   609\t\n   610\t\t// Scan through the log for any configuration change entries.\n   611\t\tsnapshotIndex, _ := r.getLastSnapshot()\n   612\t\tlastappliedIndex := r.getLastApplied()\n   613\t\tfor index := max(snapshotIndex, lastappliedIndex) + 1; index <= lastLog.Index; index++ {\n   614\t\t\tvar entry Log\n   615\t\t\tif err := r.logs.GetLog(index, &entry); err != nil {\n   616\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", index, \"error\", err)\n   617\t\t\t\tpanic(err)\n   618\t\t\t}\n   619\t\t\tif err := r.processConfigurationLogEntry(&entry); err != nil {\n   620\t\t\t\treturn nil, err\n   621\t\t\t}\n   622\t\t}\n   623\t\tr.logger.Info(\"initial configuration\",\n   624\t\t\t\"index\", r.configurations.latestIndex,\n   625\t\t\t\"servers\", hclog.Fmt(\"%+v\", r.configurations.latest.Servers))\n   626\t\n   627\t\t// Setup a heartbeat fast-path to avoid head-of-line\n   628\t\t// blocking where possible. It MUST be safe for this\n   629\t\t// to be called concurrently with a blocking RPC.\n   630\t\ttrans.SetHeartbeatHandler(r.processHeartbeat)\n   631\t\n   632\t\tif conf.skipStartup {\n   633\t\t\treturn r, nil\n   634\t\t}\n   635\t\t// Start the background work.\n   636\t\tr.goFunc(r.run)\n   637\t\tr.goFunc(r.runFSM)\n   638\t\tr.goFunc(r.runSnapshots)\n   639\t\treturn r, nil\n   640\t}\n   641\t\n   642\t// restoreSnapshot attempts to restore the latest snapshots, and fails if none\n   643\t// of them can be restored. This is called at initialization time, and is\n   644\t// completely unsafe to call at any other time.\n   645\tfunc (r *Raft) restoreSnapshot() error {\n   646\t\tsnapshots, err := r.snapshots.List()\n   647\t\tif err != nil {\n   648\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   649\t\t\treturn err\n   650\t\t}\n   651\t\n   652\t\t// Try to load in order of newest to oldest\n   653\t\tfor _, snapshot := range snapshots {\n   654\t\t\tif success := r.tryRestoreSingleSnapshot(snapshot); !success {\n   655\t\t\t\tcontinue\n   656\t\t\t}\n   657\t\n   658\t\t\t// Update the lastApplied so we don't replay old logs\n   659\t\t\tr.setLastApplied(snapshot.Index)\n   660\t\n   661\t\t\t// Update the last stable snapshot info\n   662\t\t\tr.setLastSnapshot(snapshot.Index, snapshot.Term)\n   663\t\n   664\t\t\t// Update the configuration\n   665\t\t\tvar conf Configuration\n   666\t\t\tvar index uint64\n   667\t\t\tif snapshot.Version > 0 {\n   668\t\t\t\tconf = snapshot.Configuration\n   669\t\t\t\tindex = snapshot.ConfigurationIndex\n   670\t\t\t} else {\n   671\t\t\t\tvar err error\n   672\t\t\t\tif conf, err = decodePeers(snapshot.Peers, r.trans); err != nil {\n   673\t\t\t\t\treturn err\n   674\t\t\t\t}\n   675\t\t\t\tindex = snapshot.Index\n   676\t\t\t}\n   677\t\t\tr.setCommittedConfiguration(conf, index)\n   678\t\t\tr.setLatestConfiguration(conf, index)\n   679\t\n   680\t\t\t// Success!\n   681\t\t\treturn nil\n   682\t\t}\n   683\t\n   684\t\t// If we had snapshots and failed to load them, its an error\n   685\t\tif len(snapshots) > 0 {\n   686\t\t\treturn fmt.Errorf(\"failed to load any existing snapshots\")\n   687\t\t}\n   688\t\treturn nil\n   689\t}\n   690\t\n   691\tfunc (r *Raft) tryRestoreSingleSnapshot(snapshot *SnapshotMeta) bool {\n   692\t\tif r.config().NoSnapshotRestoreOnStart {\n   693\t\t\treturn true\n   694\t\t}\n   695\t\n   696\t\tsnapLogger := r.logger.With(\n   697\t\t\t\"id\", snapshot.ID,\n   698\t\t\t\"last-index\", snapshot.Index,\n   699\t\t\t\"last-term\", snapshot.Term,\n   700\t\t\t\"size-in-bytes\", snapshot.Size,\n   701\t\t)\n   702\t\n   703\t\tsnapLogger.Info(\"starting restore from snapshot\")\n   704\t\n   705\t\t_, source, err := r.snapshots.Open(snapshot.ID)\n   706\t\tif err != nil {\n   707\t\t\tsnapLogger.Error(\"failed to open snapshot\", \"error\", err)\n   708\t\t\treturn false\n   709\t\t}\n   710\t\n   711\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, snapshot.Size); err != nil {\n   712\t\t\t_ = source.Close()\n   713\t\t\tsnapLogger.Error(\"failed to restore snapshot\", \"error\", err)\n   714\t\t\treturn false\n   715\t\t}\n   716\t\t_ = source.Close()\n   717\t\n   718\t\tsnapLogger.Info(\"restored from snapshot\")\n   719\t\n   720\t\treturn true\n   721\t}\n   722\t\n   723\t// restoreFromCommittedLogs recovers the Raft node from committed logs.\n   724\tfunc (r *Raft) restoreFromCommittedLogs() error {\n   725\t\tif !r.RestoreCommittedLogs {\n   726\t\t\treturn nil\n   727\t\t}\n   728\t\n   729\t\t// If the store implements CommitTrackingLogStore, we can read the commit index from the store.\n   730\t\t// This is useful when the store is able to track the commit index and we can avoid replaying logs.\n   731\t\tstore, ok := r.logs.(CommitTrackingLogStore)\n   732\t\tif !ok {\n   733\t\t\tr.logger.Warn(\"restore committed logs enabled but log store does not support it\", \"log_store\", fmt.Sprintf(\"%T\", r.logs))\n   734\t\t\treturn ErrIncompatibleLogStore\n   735\t\t}\n   736\t\n   737\t\tcommitIndex, err := store.GetCommitIndex()\n   738\t\tif err != nil {\n   739\t\t\tr.logger.Error(\"failed to get commit index from store\", \"error\", err)\n   740\t\t\treturn err\n   741\t\t}\n   742\t\n   743\t\tlastIndex, err := r.logs.LastIndex()\n   744\t\tif err != nil {\n   745\t\t\tr.logger.Error(\"failed to get last log index from store\", \"error\", err)\n   746\t\t\treturn err\n   747\t\t}\n   748\t\tif commitIndex > lastIndex {\n   749\t\t\tcommitIndex = lastIndex\n   750\t\t}\n   751\t\n   752\t\tr.setCommitIndex(commitIndex)\n   753\t\tr.processLogs(commitIndex, nil)\n   754\t\treturn nil\n   755\t}\n   756\t\n   757\tfunc (r *Raft) config() Config {\n   758\t\treturn r.conf.Load().(Config)\n   759\t}\n   760\t\n   761\t// ReloadConfig updates the configuration of a running raft node. If the new\n   762\t// configuration is invalid an error is returned and no changes made to the\n   763\t// instance. All fields will be copied from rc into the new configuration, even\n   764\t// if they are zero valued.\n   765\tfunc (r *Raft) ReloadConfig(rc ReloadableConfig) error {\n   766\t\tr.confReloadMu.Lock()\n   767\t\tdefer r.confReloadMu.Unlock()\n   768\t\n   769\t\t// Load the current config (note we are under a lock so it can't be changed\n   770\t\t// between this read and a later Store).\n   771\t\toldCfg := r.config()\n   772\t\n   773\t\t// Set the reloadable fields\n   774\t\tnewCfg := rc.apply(oldCfg)\n   775\t\n   776\t\tif err := ValidateConfig(&newCfg); err != nil {\n   777\t\t\treturn err\n   778\t\t}\n   779\t\tr.conf.Store(newCfg)\n   780\t\n   781\t\tif rc.HeartbeatTimeout < oldCfg.HeartbeatTimeout {\n   782\t\t\t// On leader, ensure replication loops running with a longer\n   783\t\t\t// timeout than what we want now discover the change.\n   784\t\t\tasyncNotifyCh(r.leaderNotifyCh)\n   785\t\t\t// On follower, update current timer to use the shorter new value.\n   786\t\t\tasyncNotifyCh(r.followerNotifyCh)\n   787\t\t}\n   788\t\treturn nil\n   789\t}\n   790\t\n   791\t// ReloadableConfig returns the current state of the reloadable fields in Raft's\n   792\t// configuration. This is useful for programs to discover the current state for\n   793\t// reporting to users or tests. It is safe to call from any goroutine. It is\n   794\t// intended for reporting and testing purposes primarily; external\n   795\t// synchronization would be required to safely use this in a read-modify-write\n   796\t// pattern for reloadable configuration options.\n   797\tfunc (r *Raft) ReloadableConfig() ReloadableConfig {\n   798\t\tcfg := r.config()\n   799\t\tvar rc ReloadableConfig\n   800\t\trc.fromConfig(cfg)\n   801\t\treturn rc\n   802\t}\n   803\t\n   804\t// BootstrapCluster is equivalent to non-member BootstrapCluster but can be\n   805\t// called on an un-bootstrapped Raft instance after it has been created. This\n   806\t// should only be called at the beginning of time for the cluster with an\n   807\t// identical configuration listing all Voter servers. There is no need to\n   808\t// bootstrap Nonvoter and Staging servers.\n   809\t//\n   810\t// A cluster can only be bootstrapped once from a single participating Voter\n   811\t// server. Any further attempts to bootstrap will return an error that can be\n   812\t// safely ignored.\n   813\t//\n   814\t// One sane approach is to bootstrap a single server with a configuration\n   815\t// listing just itself as a Voter, then invoke AddVoter() on it to add other\n   816\t// servers to the cluster.\n   817\tfunc (r *Raft) BootstrapCluster(configuration Configuration) Future {\n   818\t\tbootstrapReq := &bootstrapFuture{}\n   819\t\tbootstrapReq.init()\n   820\t\tbootstrapReq.configuration = configuration\n   821\t\tselect {\n   822\t\tcase <-r.shutdownCh:\n   823\t\t\treturn errorFuture{ErrRaftShutdown}\n   824\t\tcase r.bootstrapCh <- bootstrapReq:\n   825\t\t\treturn bootstrapReq\n   826\t\t}\n   827\t}\n   828\t\n   829\t// Leader is used to return the current leader of the cluster.\n   830\t// Deprecated: use LeaderWithID instead\n   831\t// It may return empty string if there is no current leader\n   832\t// or the leader is unknown.\n   833\t// Deprecated: use LeaderWithID instead.\n   834\tfunc (r *Raft) Leader() ServerAddress {\n   835\t\tr.leaderLock.RLock()\n   836\t\tleaderAddr := r.leaderAddr\n   837\t\tr.leaderLock.RUnlock()\n   838\t\treturn leaderAddr\n   839\t}\n   840\t\n   841\t// LeaderWithID is used to return the current leader address and ID of the cluster.\n   842\t// It may return empty strings if there is no current leader\n   843\t// or the leader is unknown.\n   844\tfunc (r *Raft) LeaderWithID() (ServerAddress, ServerID) {\n   845\t\tr.leaderLock.RLock()\n   846\t\tleaderAddr := r.leaderAddr\n   847\t\tleaderID := r.leaderID\n   848\t\tr.leaderLock.RUnlock()\n   849\t\treturn leaderAddr, leaderID\n   850\t}\n   851\t\n   852\t// Apply is used to apply a command to the FSM in a highly consistent\n   853\t// manner. This returns a future that can be used to wait on the application.\n   854\t// An optional timeout can be provided to limit the amount of time we wait\n   855\t// for the command to be started. This must be run on the leader or it\n   856\t// will fail.\n   857\t//\n   858\t// If the node discovers it is no longer the leader while applying the command,\n   859\t// it will return ErrLeadershipLost. There is no way to guarantee whether the\n   860\t// write succeeded or failed in this case. For example, if the leader is\n   861\t// partitioned it can't know if a quorum of followers wrote the log to disk. If\n   862\t// at least one did, it may survive into the next leader's term.\n   863\t//\n   864\t// If a user snapshot is restored while the command is in-flight, an\n   865\t// ErrAbortedByRestore is returned. In this case the write effectively failed\n   866\t// since its effects will not be present in the FSM after the restore.\n   867\tfunc (r *Raft) Apply(cmd []byte, timeout time.Duration) ApplyFuture {\n   868\t\treturn r.ApplyLog(Log{Data: cmd}, timeout)\n   869\t}\n   870\t\n   871\t// ApplyLog performs Apply but takes in a Log directly. The only values\n   872\t// currently taken from the submitted Log are Data and Extensions. See\n   873\t// Apply for details on error cases.\n   874\tfunc (r *Raft) ApplyLog(log Log, timeout time.Duration) ApplyFuture {\n   875\t\tmetrics.IncrCounter([]string{\"raft\", \"apply\"}, 1)\n   876\t\n   877\t\tvar timer <-chan time.Time\n   878\t\tif timeout > 0 {\n   879\t\t\ttimer = time.After(timeout)\n   880\t\t}\n   881\t\n   882\t\t// Create a log future, no index or term yet\n   883\t\tlogFuture := &logFuture{\n   884\t\t\tlog: Log{\n   885\t\t\t\tType:       LogCommand,\n   886\t\t\t\tData:       log.Data,\n   887\t\t\t\tExtensions: log.Extensions,\n   888\t\t\t},\n   889\t\t}\n   890\t\tlogFuture.init()\n   891\t\n   892\t\tselect {\n   893\t\tcase <-timer:\n   894\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   895\t\tcase <-r.shutdownCh:\n   896\t\t\treturn errorFuture{ErrRaftShutdown}\n   897\t\tcase r.applyCh <- logFuture:\n   898\t\t\treturn logFuture\n   899\t\t}\n   900\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n api.go | sed -n 900,1330p'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n api.go | sed -n 900,1330p'","aggregated_output":"   900\t}\n   901\t\n   902\t// Barrier is used to issue a command that blocks until all preceding\n   903\t// operations have been applied to the FSM. It can be used to ensure the\n   904\t// FSM reflects all queued writes. An optional timeout can be provided to\n   905\t// limit the amount of time we wait for the command to be started. This\n   906\t// must be run on the leader, or it will fail.\n   907\tfunc (r *Raft) Barrier(timeout time.Duration) Future {\n   908\t\tmetrics.IncrCounter([]string{\"raft\", \"barrier\"}, 1)\n   909\t\tvar timer <-chan time.Time\n   910\t\tif timeout > 0 {\n   911\t\t\ttimer = time.After(timeout)\n   912\t\t}\n   913\t\n   914\t\t// Create a log future, no index or term yet\n   915\t\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\n   916\t\tlogFuture.init()\n   917\t\n   918\t\tselect {\n   919\t\tcase <-timer:\n   920\t\t\treturn errorFuture{ErrEnqueueTimeout}\n   921\t\tcase <-r.shutdownCh:\n   922\t\t\treturn errorFuture{ErrRaftShutdown}\n   923\t\tcase r.applyCh <- logFuture:\n   924\t\t\treturn logFuture\n   925\t\t}\n   926\t}\n   927\t\n   928\t// VerifyLeader is used to ensure this peer is still the leader. It may be used\n   929\t// to prevent returning stale data from the FSM after the peer has lost\n   930\t// leadership.\n   931\tfunc (r *Raft) VerifyLeader() Future {\n   932\t\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n   933\t\tverifyFuture := &verifyFuture{}\n   934\t\tverifyFuture.init()\n   935\t\tselect {\n   936\t\tcase <-r.shutdownCh:\n   937\t\t\treturn errorFuture{ErrRaftShutdown}\n   938\t\tcase r.verifyCh <- verifyFuture:\n   939\t\t\treturn verifyFuture\n   940\t\t}\n   941\t}\n   942\t\n   943\t// GetConfiguration returns the latest configuration. This may not yet be\n   944\t// committed. The main loop can access this directly.\n   945\tfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n   946\t\tconfigReq := &configurationsFuture{}\n   947\t\tconfigReq.init()\n   948\t\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n   949\t\tconfigReq.respond(nil)\n   950\t\treturn configReq\n   951\t}\n   952\t\n   953\t// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n   954\t//\n   955\t// Deprecated: Use AddVoter/AddNonvoter instead.\n   956\tfunc (r *Raft) AddPeer(peer ServerAddress) Future {\n   957\t\tif r.protocolVersion > 2 {\n   958\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   959\t\t}\n   960\t\n   961\t\treturn r.requestConfigChange(configurationChangeRequest{\n   962\t\t\tcommand:       AddVoter,\n   963\t\t\tserverID:      ServerID(peer),\n   964\t\t\tserverAddress: peer,\n   965\t\t\tprevIndex:     0,\n   966\t\t}, 0)\n   967\t}\n   968\t\n   969\t// RemovePeer from the cluster configuration. If the current leader is being\n   970\t// removed, it will cause a new election to occur. Must be run on the leader,\n   971\t// or it will fail.\n   972\t\n   973\t// Deprecated: Use RemoveServer instead.\n   974\tfunc (r *Raft) RemovePeer(peer ServerAddress) Future {\n   975\t\tif r.protocolVersion > 2 {\n   976\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   977\t\t}\n   978\t\n   979\t\treturn r.requestConfigChange(configurationChangeRequest{\n   980\t\t\tcommand:   RemoveServer,\n   981\t\t\tserverID:  ServerID(peer),\n   982\t\t\tprevIndex: 0,\n   983\t\t}, 0)\n   984\t}\n   985\t\n   986\t// AddVoter will add the given server to the cluster as a staging server. If the\n   987\t// server is already in the cluster as a voter, this updates the server's address.\n   988\t// This must be run on the leader or it will fail. The leader will promote the\n   989\t// staging server to a voter once that server is ready. If nonzero, prevIndex is\n   990\t// the index of the only configuration upon which this change may be applied; if\n   991\t// another configuration entry has been added in the meantime, this request will\n   992\t// fail. If nonzero, timeout is how long this server should wait before the\n   993\t// configuration change log entry is appended.\n   994\tfunc (r *Raft) AddVoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n   995\t\tif r.protocolVersion < 2 {\n   996\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n   997\t\t}\n   998\t\n   999\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1000\t\t\tcommand:       AddVoter,\n  1001\t\t\tserverID:      id,\n  1002\t\t\tserverAddress: address,\n  1003\t\t\tprevIndex:     prevIndex,\n  1004\t\t}, timeout)\n  1005\t}\n  1006\t\n  1007\t// AddNonvoter will add the given server to the cluster but won't assign it a\n  1008\t// vote. The server will receive log entries, but it won't participate in\n  1009\t// elections or log entry commitment. If the server is already in the cluster,\n  1010\t// this updates the server's address. This must be run on the leader or it will\n  1011\t// fail. For prevIndex and timeout, see AddVoter.\n  1012\tfunc (r *Raft) AddNonvoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1013\t\tif r.protocolVersion < 3 {\n  1014\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1015\t\t}\n  1016\t\n  1017\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1018\t\t\tcommand:       AddNonvoter,\n  1019\t\t\tserverID:      id,\n  1020\t\t\tserverAddress: address,\n  1021\t\t\tprevIndex:     prevIndex,\n  1022\t\t}, timeout)\n  1023\t}\n  1024\t\n  1025\t// RemoveServer will remove the given server from the cluster. If the current\n  1026\t// leader is being removed, it will cause a new election to occur. This must be\n  1027\t// run on the leader or it will fail. For prevIndex and timeout, see AddVoter.\n  1028\tfunc (r *Raft) RemoveServer(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1029\t\tif r.protocolVersion < 2 {\n  1030\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1031\t\t}\n  1032\t\n  1033\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1034\t\t\tcommand:   RemoveServer,\n  1035\t\t\tserverID:  id,\n  1036\t\t\tprevIndex: prevIndex,\n  1037\t\t}, timeout)\n  1038\t}\n  1039\t\n  1040\t// DemoteVoter will take away a server's vote, if it has one. If present, the\n  1041\t// server will continue to receive log entries, but it won't participate in\n  1042\t// elections or log entry commitment. If the server is not in the cluster, this\n  1043\t// does nothing. This must be run on the leader or it will fail. For prevIndex\n  1044\t// and timeout, see AddVoter.\n  1045\tfunc (r *Raft) DemoteVoter(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n  1046\t\tif r.protocolVersion < 3 {\n  1047\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1048\t\t}\n  1049\t\n  1050\t\treturn r.requestConfigChange(configurationChangeRequest{\n  1051\t\t\tcommand:   DemoteVoter,\n  1052\t\t\tserverID:  id,\n  1053\t\t\tprevIndex: prevIndex,\n  1054\t\t}, timeout)\n  1055\t}\n  1056\t\n  1057\t// Shutdown is used to stop the Raft background routines.\n  1058\t// This is not a graceful operation. Provides a future that\n  1059\t// can be used to block until all background routines have exited.\n  1060\tfunc (r *Raft) Shutdown() Future {\n  1061\t\tr.shutdownLock.Lock()\n  1062\t\tdefer r.shutdownLock.Unlock()\n  1063\t\n  1064\t\tif !r.shutdown {\n  1065\t\t\tclose(r.shutdownCh)\n  1066\t\t\tr.shutdown = true\n  1067\t\t\tr.setState(Shutdown)\n  1068\t\t\treturn &shutdownFuture{r}\n  1069\t\t}\n  1070\t\n  1071\t\t// avoid closing transport twice\n  1072\t\treturn &shutdownFuture{nil}\n  1073\t}\n  1074\t\n  1075\t// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n  1076\t// that can be used to block until complete, and that contains a function that\n  1077\t// can be used to open the snapshot.\n  1078\tfunc (r *Raft) Snapshot() SnapshotFuture {\n  1079\t\tfuture := &userSnapshotFuture{}\n  1080\t\tfuture.init()\n  1081\t\tselect {\n  1082\t\tcase r.userSnapshotCh <- future:\n  1083\t\t\treturn future\n  1084\t\tcase <-r.shutdownCh:\n  1085\t\t\tfuture.respond(ErrRaftShutdown)\n  1086\t\t\treturn future\n  1087\t\t}\n  1088\t}\n  1089\t\n  1090\t// Restore is used to manually force Raft to consume an external snapshot, such\n  1091\t// as if restoring from a backup. We will use the current Raft configuration,\n  1092\t// not the one from the snapshot, so that we can restore into a new cluster. We\n  1093\t// will also use the max of the index of the snapshot, or the current index,\n  1094\t// and then add 1 to that, so we force a new state with a hole in the Raft log,\n  1095\t// so that the snapshot will be sent to followers and used for any new joiners.\n  1096\t// This can only be run on the leader, and blocks until the restore is complete\n  1097\t// or an error occurs.\n  1098\t//\n  1099\t// WARNING! This operation has the leader take on the state of the snapshot and\n  1100\t// then sets itself up so that it replicates that to its followers though the\n  1101\t// install snapshot process. This involves a potentially dangerous period where\n  1102\t// the leader commits ahead of its followers, so should only be used for disaster\n  1103\t// recovery into a fresh cluster, and should not be used in normal operations.\n  1104\tfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n  1105\t\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n  1106\t\tvar timer <-chan time.Time\n  1107\t\tif timeout > 0 {\n  1108\t\t\ttimer = time.After(timeout)\n  1109\t\t}\n  1110\t\n  1111\t\t// Perform the restore.\n  1112\t\trestore := &userRestoreFuture{\n  1113\t\t\tmeta:   meta,\n  1114\t\t\treader: reader,\n  1115\t\t}\n  1116\t\trestore.init()\n  1117\t\tselect {\n  1118\t\tcase <-timer:\n  1119\t\t\treturn ErrEnqueueTimeout\n  1120\t\tcase <-r.shutdownCh:\n  1121\t\t\treturn ErrRaftShutdown\n  1122\t\tcase r.userRestoreCh <- restore:\n  1123\t\t\t// If the restore is ingested then wait for it to complete.\n  1124\t\t\tif err := restore.Error(); err != nil {\n  1125\t\t\t\treturn err\n  1126\t\t\t}\n  1127\t\t}\n  1128\t\n  1129\t\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n  1130\t\t// followers have gotten the restore and replicated at least this new\n  1131\t\t// entry, which shows that we've also faulted and installed the\n  1132\t\t// snapshot with the contents of the restore.\n  1133\t\tnoop := &logFuture{\n  1134\t\t\tlog: Log{\n  1135\t\t\t\tType: LogNoop,\n  1136\t\t\t},\n  1137\t\t}\n  1138\t\tnoop.init()\n  1139\t\tselect {\n  1140\t\tcase <-timer:\n  1141\t\t\treturn ErrEnqueueTimeout\n  1142\t\tcase <-r.shutdownCh:\n  1143\t\t\treturn ErrRaftShutdown\n  1144\t\tcase r.applyCh <- noop:\n  1145\t\t\treturn noop.Error()\n  1146\t\t}\n  1147\t}\n  1148\t\n  1149\t// State returns the state of this raft peer.\n  1150\tfunc (r *Raft) State() RaftState {\n  1151\t\treturn r.getState()\n  1152\t}\n  1153\t\n  1154\t// LeaderCh is used to get a channel which delivers signals on acquiring or\n  1155\t// losing leadership. It sends true if we become the leader, and false if we\n  1156\t// lose it.\n  1157\t//\n  1158\t// Receivers can expect to receive a notification only if leadership\n  1159\t// transition has occurred.\n  1160\t//\n  1161\t// If receivers aren't ready for the signal, signals may drop and only the\n  1162\t// latest leadership transition. For example, if a receiver receives subsequent\n  1163\t// `true` values, they may deduce that leadership was lost and regained while\n  1164\t// the receiver was processing first leadership transition.\n  1165\tfunc (r *Raft) LeaderCh() <-chan bool {\n  1166\t\treturn r.leaderCh\n  1167\t}\n  1168\t\n  1169\t// String returns a string representation of this Raft node.\n  1170\tfunc (r *Raft) String() string {\n  1171\t\treturn fmt.Sprintf(\"Node at %s [%v]\", r.localAddr, r.getState())\n  1172\t}\n  1173\t\n  1174\t// LastContact returns the time of last contact by a leader.\n  1175\t// This only makes sense if we are currently a follower.\n  1176\tfunc (r *Raft) LastContact() time.Time {\n  1177\t\tr.lastContactLock.RLock()\n  1178\t\tlast := r.lastContact\n  1179\t\tr.lastContactLock.RUnlock()\n  1180\t\treturn last\n  1181\t}\n  1182\t\n  1183\t// Stats is used to return a map of various internal stats. This\n  1184\t// should only be used for informative purposes or debugging.\n  1185\t//\n  1186\t// Keys are: \"state\", \"term\", \"last_log_index\", \"last_log_term\",\n  1187\t// \"commit_index\", \"applied_index\", \"fsm_pending\",\n  1188\t// \"last_snapshot_index\", \"last_snapshot_term\",\n  1189\t// \"latest_configuration\", \"last_contact\", and \"num_peers\".\n  1190\t//\n  1191\t// The value of \"state\" is a numeric constant representing one of\n  1192\t// the possible leadership states the node is in at any given time.\n  1193\t// the possible states are: \"Follower\", \"Candidate\", \"Leader\", \"Shutdown\".\n  1194\t//\n  1195\t// The value of \"latest_configuration\" is a string which contains\n  1196\t// the id of each server, its suffrage status, and its address.\n  1197\t//\n  1198\t// The value of \"last_contact\" is either \"never\" if there\n  1199\t// has been no contact with a leader, \"0\" if the node is in the\n  1200\t// leader state, or the time since last contact with a leader\n  1201\t// formatted as a string.\n  1202\t//\n  1203\t// The value of \"num_peers\" is the number of other voting servers in the\n  1204\t// cluster, not including this node. If this node isn't part of the\n  1205\t// configuration then this will be \"0\".\n  1206\t//\n  1207\t// All other values are uint64s, formatted as strings.\n  1208\tfunc (r *Raft) Stats() map[string]string {\n  1209\t\ttoString := func(v uint64) string {\n  1210\t\t\treturn strconv.FormatUint(v, 10)\n  1211\t\t}\n  1212\t\tlastLogIndex, lastLogTerm := r.getLastLog()\n  1213\t\tlastSnapIndex, lastSnapTerm := r.getLastSnapshot()\n  1214\t\ts := map[string]string{\n  1215\t\t\t\"state\":                r.getState().String(),\n  1216\t\t\t\"term\":                 toString(r.getCurrentTerm()),\n  1217\t\t\t\"last_log_index\":       toString(lastLogIndex),\n  1218\t\t\t\"last_log_term\":        toString(lastLogTerm),\n  1219\t\t\t\"commit_index\":         toString(r.getCommitIndex()),\n  1220\t\t\t\"applied_index\":        toString(r.getLastApplied()),\n  1221\t\t\t\"fsm_pending\":          toString(uint64(len(r.fsmMutateCh))),\n  1222\t\t\t\"last_snapshot_index\":  toString(lastSnapIndex),\n  1223\t\t\t\"last_snapshot_term\":   toString(lastSnapTerm),\n  1224\t\t\t\"protocol_version\":     toString(uint64(r.protocolVersion)),\n  1225\t\t\t\"protocol_version_min\": toString(uint64(ProtocolVersionMin)),\n  1226\t\t\t\"protocol_version_max\": toString(uint64(ProtocolVersionMax)),\n  1227\t\t\t\"snapshot_version_min\": toString(uint64(SnapshotVersionMin)),\n  1228\t\t\t\"snapshot_version_max\": toString(uint64(SnapshotVersionMax)),\n  1229\t\t}\n  1230\t\n  1231\t\tfuture := r.GetConfiguration()\n  1232\t\tif err := future.Error(); err != nil {\n  1233\t\t\tr.logger.Warn(\"could not get configuration for stats\", \"error\", err)\n  1234\t\t} else {\n  1235\t\t\tconfiguration := future.Configuration()\n  1236\t\t\ts[\"latest_configuration_index\"] = toString(future.Index())\n  1237\t\t\ts[\"latest_configuration\"] = fmt.Sprintf(\"%+v\", configuration.Servers)\n  1238\t\n  1239\t\t\t// This is a legacy metric that we've seen people use in the wild.\n  1240\t\t\thasUs := false\n  1241\t\t\tnumPeers := 0\n  1242\t\t\tfor _, server := range configuration.Servers {\n  1243\t\t\t\tif server.Suffrage == Voter {\n  1244\t\t\t\t\tif server.ID == r.localID {\n  1245\t\t\t\t\t\thasUs = true\n  1246\t\t\t\t\t} else {\n  1247\t\t\t\t\t\tnumPeers++\n  1248\t\t\t\t\t}\n  1249\t\t\t\t}\n  1250\t\t\t}\n  1251\t\t\tif !hasUs {\n  1252\t\t\t\tnumPeers = 0\n  1253\t\t\t}\n  1254\t\t\ts[\"num_peers\"] = toString(uint64(numPeers))\n  1255\t\t}\n  1256\t\n  1257\t\tlast := r.LastContact()\n  1258\t\tif r.getState() == Leader {\n  1259\t\t\ts[\"last_contact\"] = \"0\"\n  1260\t\t} else if last.IsZero() {\n  1261\t\t\ts[\"last_contact\"] = \"never\"\n  1262\t\t} else {\n  1263\t\t\ts[\"last_contact\"] = fmt.Sprintf(\"%v\", time.Since(last))\n  1264\t\t}\n  1265\t\treturn s\n  1266\t}\n  1267\t\n  1268\t// CurrentTerm returns the current term.\n  1269\tfunc (r *Raft) CurrentTerm() uint64 {\n  1270\t\treturn r.getCurrentTerm()\n  1271\t}\n  1272\t\n  1273\t// LastIndex returns the last index in stable storage,\n  1274\t// either from the last log or from the last snapshot.\n  1275\tfunc (r *Raft) LastIndex() uint64 {\n  1276\t\treturn r.getLastIndex()\n  1277\t}\n  1278\t\n  1279\t// CommitIndex returns the committed index.\n  1280\t// This API maybe helpful for server to implement the read index optimization\n  1281\t// as described in the Raft paper.\n  1282\tfunc (r *Raft) CommitIndex() uint64 {\n  1283\t\treturn r.getCommitIndex()\n  1284\t}\n  1285\t\n  1286\t// AppliedIndex returns the last index applied to the FSM. This is generally\n  1287\t// lagging behind the last index, especially for indexes that are persisted but\n  1288\t// have not yet been considered committed by the leader. NOTE - this reflects\n  1289\t// the last index that was sent to the application's FSM over the apply channel\n  1290\t// but DOES NOT mean that the application's FSM has yet consumed it and applied\n  1291\t// it to its internal state. Thus, the application's state may lag behind this\n  1292\t// index.\n  1293\tfunc (r *Raft) AppliedIndex() uint64 {\n  1294\t\treturn r.getLastApplied()\n  1295\t}\n  1296\t\n  1297\t// LeadershipTransfer will transfer leadership to a server in the cluster.\n  1298\t// This can only be called from the leader, or it will fail. The leader will\n  1299\t// stop accepting client requests, make sure the target server is up to date\n  1300\t// and starts the transfer with a TimeoutNow message. This message has the same\n  1301\t// effect as if the election timeout on the target server fires. Since\n  1302\t// it is unlikely that another server is starting an election, it is very\n  1303\t// likely that the target server is able to win the election.  Note that raft\n  1304\t// protocol version 3 is not sufficient to use LeadershipTransfer. A recent\n  1305\t// version of that library has to be used that includes this feature.  Using\n  1306\t// transfer leadership is safe however in a cluster where not every node has\n  1307\t// the latest version. If a follower cannot be promoted, it will fail\n  1308\t// gracefully.\n  1309\tfunc (r *Raft) LeadershipTransfer() Future {\n  1310\t\tif r.protocolVersion < 3 {\n  1311\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1312\t\t}\n  1313\t\n  1314\t\treturn r.initiateLeadershipTransfer(nil, nil)\n  1315\t}\n  1316\t\n  1317\t// LeadershipTransferToServer does the same as LeadershipTransfer but takes a\n  1318\t// server in the arguments in case a leadership should be transitioned to a\n  1319\t// specific server in the cluster.  Note that raft protocol version 3 is not\n  1320\t// sufficient to use LeadershipTransfer. A recent version of that library has\n  1321\t// to be used that includes this feature. Using transfer leadership is safe\n  1322\t// however in a cluster where not every node has the latest version. If a\n  1323\t// follower cannot be promoted, it will fail gracefully.\n  1324\tfunc (r *Raft) LeadershipTransferToServer(id ServerID, address ServerAddress) Future {\n  1325\t\tif r.protocolVersion < 3 {\n  1326\t\t\treturn errorFuture{ErrUnsupportedProtocol}\n  1327\t\t}\n  1328\t\n  1329\t\treturn r.initiateLeadershipTransfer(&id, &address)\n  1330\t}\n","exit_code":0,"status":"completed"}}
