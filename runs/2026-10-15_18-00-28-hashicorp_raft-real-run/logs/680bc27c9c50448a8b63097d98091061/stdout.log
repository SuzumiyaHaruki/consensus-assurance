{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n api.go | sed -n 240,560p'","aggregated_output":"   240\t// A cluster can only be bootstrapped once from a single participating Voter\n   241\t// server. Any further attempts to bootstrap will return an error that can be\n   242\t// safely ignored.\n   243\t//\n   244\t// One approach is to bootstrap a single server with a configuration\n   245\t// listing just itself as a Voter, then invoke AddVoter() on it to add other\n   246\t// servers to the cluster.\n   247\tfunc BootstrapCluster(conf *Config, logs LogStore, stable StableStore,\n   248\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n   249\t) error {\n   250\t\t// Validate the Raft server config.\n   251\t\tif err := ValidateConfig(conf); err != nil {\n   252\t\t\treturn err\n   253\t\t}\n   254\t\n   255\t\t// Sanity check the Raft peer configuration.\n   256\t\tif err := checkConfiguration(configuration); err != nil {\n   257\t\t\treturn err\n   258\t\t}\n   259\t\n   260\t\t// Make sure the cluster is in a clean state.\n   261\t\thasState, err := HasExistingState(logs, stable, snaps)\n   262\t\tif err != nil {\n   263\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n   264\t\t}\n   265\t\tif hasState {\n   266\t\t\treturn ErrCantBootstrap\n   267\t\t}\n   268\t\n   269\t\t// Set current term to 1.\n   270\t\tif err := stable.SetUint64(keyCurrentTerm, 1); err != nil {\n   271\t\t\treturn fmt.Errorf(\"failed to save current term: %v\", err)\n   272\t\t}\n   273\t\n   274\t\t// Append configuration entry to log.\n   275\t\tentry := &Log{\n   276\t\t\tIndex: 1,\n   277\t\t\tTerm:  1,\n   278\t\t}\n   279\t\tif conf.ProtocolVersion < 3 {\n   280\t\t\tentry.Type = LogRemovePeerDeprecated\n   281\t\t\tentry.Data = encodePeers(configuration, trans)\n   282\t\t} else {\n   283\t\t\tentry.Type = LogConfiguration\n   284\t\t\tentry.Data = EncodeConfiguration(configuration)\n   285\t\t}\n   286\t\tif err := logs.StoreLog(entry); err != nil {\n   287\t\t\treturn fmt.Errorf(\"failed to append configuration entry to log: %v\", err)\n   288\t\t}\n   289\t\n   290\t\treturn nil\n   291\t}\n   292\t\n   293\t// RecoverCluster is used to manually force a new configuration in order to\n   294\t// recover from a loss of quorum where the current configuration cannot be\n   295\t// restored, such as when several servers die at the same time. This works by\n   296\t// reading all the current state for this server, creating a snapshot with the\n   297\t// supplied configuration, and then truncating the Raft log. This is the only\n   298\t// safe way to force a given configuration without actually altering the log to\n   299\t// insert any new entries, which could cause conflicts with other servers with\n   300\t// different state.\n   301\t//\n   302\t// WARNING! This operation implicitly commits all entries in the Raft log, so\n   303\t// in general this is an extremely unsafe operation. If you've lost your other\n   304\t// servers and are performing a manual recovery, then you've also lost the\n   305\t// commit information, so this is likely the best you can do, but you should be\n   306\t// aware that calling this can cause Raft log entries that were in the process\n   307\t// of being replicated but not yet be committed to be committed.\n   308\t//\n   309\t// Note the FSM passed here is used for the snapshot operations and will be\n   310\t// left in a state that should not be used by the application. Be sure to\n   311\t// discard this FSM and any associated state and provide a fresh one when\n   312\t// calling NewRaft later.\n   313\t//\n   314\t// A typical way to recover the cluster is to shut down all servers and then\n   315\t// run RecoverCluster on every server using an identical configuration. When\n   316\t// the cluster is then restarted, and election should occur and then Raft will\n   317\t// resume normal operation. If it's desired to make a particular server the\n   318\t// leader, this can be used to inject a new configuration with that server as\n   319\t// the sole voter, and then join up other new clean-state peer servers using\n   320\t// the usual APIs in order to bring the cluster back into a known state.\n   321\tfunc RecoverCluster(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n   322\t\tsnaps SnapshotStore, trans Transport, configuration Configuration,\n   323\t) error {\n   324\t\t// Validate the Raft server config.\n   325\t\tif err := ValidateConfig(conf); err != nil {\n   326\t\t\treturn err\n   327\t\t}\n   328\t\n   329\t\t// Sanity check the Raft peer configuration.\n   330\t\tif err := checkConfiguration(configuration); err != nil {\n   331\t\t\treturn err\n   332\t\t}\n   333\t\n   334\t\t// Refuse to recover if there's no existing state. This would be safe to\n   335\t\t// do, but it is likely an indication of an operator error where they\n   336\t\t// expect data to be there and it's not. By refusing, we force them\n   337\t\t// to show intent to start a cluster fresh by explicitly doing a\n   338\t\t// bootstrap, rather than quietly fire up a fresh cluster here.\n   339\t\tif hasState, err := HasExistingState(logs, stable, snaps); err != nil {\n   340\t\t\treturn fmt.Errorf(\"failed to check for existing state: %v\", err)\n   341\t\t} else if !hasState {\n   342\t\t\treturn fmt.Errorf(\"refused to recover cluster with no initial state, this is probably an operator error\")\n   343\t\t}\n   344\t\n   345\t\t// Attempt to restore any snapshots we find, newest to oldest.\n   346\t\tvar (\n   347\t\t\tsnapshotIndex  uint64\n   348\t\t\tsnapshotTerm   uint64\n   349\t\t\tsnapshots, err = snaps.List()\n   350\t\t)\n   351\t\tif err != nil {\n   352\t\t\treturn fmt.Errorf(\"failed to list snapshots: %v\", err)\n   353\t\t}\n   354\t\n   355\t\tlogger := conf.getOrCreateLogger()\n   356\t\n   357\t\tfor _, snapshot := range snapshots {\n   358\t\t\tvar source io.ReadCloser\n   359\t\t\t_, source, err = snaps.Open(snapshot.ID)\n   360\t\t\tif err != nil {\n   361\t\t\t\t// Skip this one and try the next. We will detect if we\n   362\t\t\t\t// couldn't open any snapshots.\n   363\t\t\t\tcontinue\n   364\t\t\t}\n   365\t\n   366\t\t\t// Note this is the one place we call fsm.Restore without the\n   367\t\t\t// fsmRestoreAndMeasure wrapper since this function should only be called to\n   368\t\t\t// reset state on disk and the FSM passed will not be used for a running\n   369\t\t\t// server instance. If the same process will eventually become a Raft peer\n   370\t\t\t// then it will call NewRaft and restore again from disk then which will\n   371\t\t\t// report metrics.\n   372\t\t\tsnapLogger := logger.With(\n   373\t\t\t\t\"id\", snapshot.ID,\n   374\t\t\t\t\"last-index\", snapshot.Index,\n   375\t\t\t\t\"last-term\", snapshot.Term,\n   376\t\t\t\t\"size-in-bytes\", snapshot.Size,\n   377\t\t\t)\n   378\t\t\tcrc := newCountingReadCloser(source)\n   379\t\t\tmonitor := startSnapshotRestoreMonitor(snapLogger, crc, snapshot.Size, false)\n   380\t\t\terr = fsm.Restore(crc)\n   381\t\t\t// Close the source after the restore has completed\n   382\t\t\t_ = source.Close()\n   383\t\t\tmonitor.StopAndWait()\n   384\t\t\tif err != nil {\n   385\t\t\t\t// Same here, skip and try the next one.\n   386\t\t\t\tcontinue\n   387\t\t\t}\n   388\t\n   389\t\t\tsnapshotIndex = snapshot.Index\n   390\t\t\tsnapshotTerm = snapshot.Term\n   391\t\t\tbreak\n   392\t\t}\n   393\t\tif len(snapshots) > 0 && (snapshotIndex == 0 || snapshotTerm == 0) {\n   394\t\t\treturn fmt.Errorf(\"failed to restore any of the available snapshots\")\n   395\t\t}\n   396\t\n   397\t\t// The snapshot information is the best known end point for the data\n   398\t\t// until we play back the Raft log entries.\n   399\t\tlastIndex := snapshotIndex\n   400\t\tlastTerm := snapshotTerm\n   401\t\n   402\t\t// Apply any Raft log entries past the snapshot.\n   403\t\tlastLogIndex, err := logs.LastIndex()\n   404\t\tif err != nil {\n   405\t\t\treturn fmt.Errorf(\"failed to find last log: %v\", err)\n   406\t\t}\n   407\t\tfor index := snapshotIndex + 1; index <= lastLogIndex; index++ {\n   408\t\t\tvar entry Log\n   409\t\t\tif err = logs.GetLog(index, &entry); err != nil {\n   410\t\t\t\treturn fmt.Errorf(\"failed to get log at index %d: %v\", index, err)\n   411\t\t\t}\n   412\t\t\tif entry.Type == LogCommand {\n   413\t\t\t\t_ = fsm.Apply(&entry)\n   414\t\t\t}\n   415\t\t\tlastIndex = entry.Index\n   416\t\t\tlastTerm = entry.Term\n   417\t\t}\n   418\t\n   419\t\t// Create a new snapshot, placing the configuration in as if it was\n   420\t\t// committed at index 1.\n   421\t\tsnapshot, err := fsm.Snapshot()\n   422\t\tif err != nil {\n   423\t\t\treturn fmt.Errorf(\"failed to snapshot FSM: %v\", err)\n   424\t\t}\n   425\t\tversion := getSnapshotVersion(conf.ProtocolVersion)\n   426\t\tsink, err := snaps.Create(version, lastIndex, lastTerm, configuration, 1, trans)\n   427\t\tif err != nil {\n   428\t\t\treturn fmt.Errorf(\"failed to create snapshot: %v\", err)\n   429\t\t}\n   430\t\tif err = snapshot.Persist(sink); err != nil {\n   431\t\t\treturn fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   432\t\t}\n   433\t\tif err = sink.Close(); err != nil {\n   434\t\t\treturn fmt.Errorf(\"failed to finalize snapshot: %v\", err)\n   435\t\t}\n   436\t\n   437\t\t// Compact the log so that we don't get bad interference from any\n   438\t\t// configuration change log entries that might be there.\n   439\t\tfirstLogIndex, err := logs.FirstIndex()\n   440\t\tif err != nil {\n   441\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   442\t\t}\n   443\t\tif err := logs.DeleteRange(firstLogIndex, lastLogIndex); err != nil {\n   444\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   445\t\t}\n   446\t\n   447\t\treturn nil\n   448\t}\n   449\t\n   450\t// GetConfiguration returns the persisted configuration of the Raft cluster\n   451\t// without starting a Raft instance or connecting to the cluster. This function\n   452\t// has identical behavior to Raft.GetConfiguration.\n   453\tfunc GetConfiguration(conf *Config, fsm FSM, logs LogStore, stable StableStore,\n   454\t\tsnaps SnapshotStore, trans Transport,\n   455\t) (Configuration, error) {\n   456\t\tconf.skipStartup = true\n   457\t\tr, err := NewRaft(conf, fsm, logs, stable, snaps, trans)\n   458\t\tif err != nil {\n   459\t\t\treturn Configuration{}, err\n   460\t\t}\n   461\t\tfuture := r.GetConfiguration()\n   462\t\tif err = future.Error(); err != nil {\n   463\t\t\treturn Configuration{}, err\n   464\t\t}\n   465\t\treturn future.Configuration(), nil\n   466\t}\n   467\t\n   468\t// HasExistingState returns true if the server has any existing state (logs,\n   469\t// knowledge of a current term, or any snapshots).\n   470\tfunc HasExistingState(logs LogStore, stable StableStore, snaps SnapshotStore) (bool, error) {\n   471\t\t// Make sure we don't have a current term.\n   472\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   473\t\tif err == nil {\n   474\t\t\tif currentTerm > 0 {\n   475\t\t\t\treturn true, nil\n   476\t\t\t}\n   477\t\t} else {\n   478\t\t\tif err.Error() != \"not found\" {\n   479\t\t\t\treturn false, fmt.Errorf(\"failed to read current term: %v\", err)\n   480\t\t\t}\n   481\t\t}\n   482\t\n   483\t\t// Make sure we have an empty log.\n   484\t\tlastIndex, err := logs.LastIndex()\n   485\t\tif err != nil {\n   486\t\t\treturn false, fmt.Errorf(\"failed to get last log index: %v\", err)\n   487\t\t}\n   488\t\tif lastIndex > 0 {\n   489\t\t\treturn true, nil\n   490\t\t}\n   491\t\n   492\t\t// Make sure we have no snapshots\n   493\t\tsnapshots, err := snaps.List()\n   494\t\tif err != nil {\n   495\t\t\treturn false, fmt.Errorf(\"failed to list snapshots: %v\", err)\n   496\t\t}\n   497\t\tif len(snapshots) > 0 {\n   498\t\t\treturn true, nil\n   499\t\t}\n   500\t\n   501\t\treturn false, nil\n   502\t}\n   503\t\n   504\t// NewRaft is used to construct a new Raft node. It takes a configuration, as well\n   505\t// as implementations of various interfaces that are required. If we have any\n   506\t// old state, such as snapshots, logs, peers, etc, all those will be restored\n   507\t// when creating the Raft node.\n   508\tfunc NewRaft(conf *Config, fsm FSM, logs LogStore, stable StableStore, snaps SnapshotStore, trans Transport) (*Raft, error) {\n   509\t\t// Validate the configuration.\n   510\t\tif err := ValidateConfig(conf); err != nil {\n   511\t\t\treturn nil, err\n   512\t\t}\n   513\t\n   514\t\t// Ensure we have a LogOutput.\n   515\t\tlogger := conf.getOrCreateLogger()\n   516\t\n   517\t\t// Try to restore the current term.\n   518\t\tcurrentTerm, err := stable.GetUint64(keyCurrentTerm)\n   519\t\tif err != nil && err.Error() != \"not found\" {\n   520\t\t\treturn nil, fmt.Errorf(\"failed to load current term: %v\", err)\n   521\t\t}\n   522\t\n   523\t\t// Read the index of the last log entry.\n   524\t\tlastIndex, err := logs.LastIndex()\n   525\t\tif err != nil {\n   526\t\t\treturn nil, fmt.Errorf(\"failed to find last log: %v\", err)\n   527\t\t}\n   528\t\n   529\t\t// Get the last log entry.\n   530\t\tvar lastLog Log\n   531\t\tif lastIndex > 0 {\n   532\t\t\tif err = logs.GetLog(lastIndex, &lastLog); err != nil {\n   533\t\t\t\treturn nil, fmt.Errorf(\"failed to get last log at index %d: %v\", lastIndex, err)\n   534\t\t\t}\n   535\t\t}\n   536\t\n   537\t\t// Make sure we have a valid server address and ID.\n   538\t\tprotocolVersion := conf.ProtocolVersion\n   539\t\tlocalAddr := trans.LocalAddr()\n   540\t\tlocalID := conf.LocalID\n   541\t\n   542\t\t// TODO (slackpad) - When we deprecate protocol version 2, remove this\n   543\t\t// along with the AddPeer() and RemovePeer() APIs.\n   544\t\tif protocolVersion < 3 && string(localID) != string(localAddr) {\n   545\t\t\treturn nil, fmt.Errorf(\"when running with ProtocolVersion < 3, LocalID must be set to the network address\")\n   546\t\t}\n   547\t\n   548\t\t// Buffer applyCh to MaxAppendEntries if the option is enabled\n   549\t\tapplyCh := make(chan *logFuture)\n   550\t\tif conf.BatchApplyCh {\n   551\t\t\tapplyCh = make(chan *logFuture, conf.MaxAppendEntries)\n   552\t\t}\n   553\t\n   554\t\t_, transportSupportPreVote := trans.(WithPreVote)\n   555\t\t// Create Raft struct.\n   556\t\tr := &Raft{\n   557\t\t\tprotocolVersion:       protocolVersion,\n   558\t\t\tapplyCh:               applyCh,\n   559\t\t\tfsm:                   fsm,\n   560\t\t\tfsmMutateCh:           make(chan interface{}, 128),\n","exit_code":0,"status":"completed"}}
