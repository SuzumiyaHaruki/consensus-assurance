168\t\n   169\t\t// Shutdown channel to exit, protected to prevent concurrent exits\n   170\t\tshutdown     bool\n   171\t\tshutdownCh   chan struct{}\n   172\t\tshutdownLock sync.Mutex\n   173\t\n   174\t\t// snapshots is used to store and retrieve snapshots\n   175\t\tsnapshots SnapshotStore\n   176\t\n   177\t\t// userSnapshotCh is used for user-triggered snapshots\n   178\t\tuserSnapshotCh chan *userSnapshotFuture\n   179\t\n   180\t\t// userRestoreCh is used for user-triggered restores of external\n   181\t\t// snapshots\n   182\t\tuserRestoreCh chan *userRestoreFuture\n   183\t\n   184\t\t// stable is a StableStore implementation for durable state\n   185\t\t// It provides stable storage for many fields in raftState\n   186\t\tstable StableStore\n   187\t\n   188\t\t// The transport layer we use\n   189\t\ttrans Transport\n   190\t\n   191\t\t// verifyCh is used to async send verify futures to the main thread\n   192\t\t// to verify we are still the leader\n   193\t\tverifyCh chan *verifyFuture\n   194\t\n   195\t\t// configurationsCh is used to get the configuration data safely from\n   196\t\t// outside of the main thread.\n   197\t\tconfigurationsCh chan *configurationsFuture\n   198\t\n   199\t\t// bootstrapCh is used to attempt an initial bootstrap from outside of\n   200\t\t// the main thread.\n   201\t\tbootstrapCh chan *bootstrapFuture\n   202\t\n   203\t\t// List of observers and the mutex that protects them. The observers list\n   204\t\t// is indexed by an artificial ID which is used for deregistration.\n   205\t\tobserversLock sync.RWMutex\n   206\t\tobservers     map[uint64]*Observer\n   207\t\n   208\t\t// leadershipTransferCh is used to start a leadership transfer from outside of\n   209\t\t// the main thread.\n   210\t\tleadershipTransferCh chan *leadershipTransferFuture\n   211\t\n   212\t\t// leaderNotifyCh is used to tell leader that config has changed\n   213\t\tleaderNotifyCh chan struct{}\n   214\t\n   215\t\t// followerNotifyCh is used to tell followers that config has changed\n   216\t\tfollowerNotifyCh chan struct{}\n   217\t\n   218\t\t// mainThreadSaturation measures the saturation of the main raft goroutine.\n   219\t\tmainThreadSaturation *saturationMetric\n   220\t\n   221\t\t// preVoteDisabled control if the pre-vote feature is activated,\n   222\t\t// prevote feature is disabled if set to true.\n   223\t\tpreVoteDisabled bool\n   224\t\n   225\t\t// noLegacyTelemetry allows to skip the legacy metrics to avoid duplicates.\n   226\t\t// legacy metrics are those that have `_peer_name` as metric suffix instead as labels.\n   227\t\t// e.g: raft_replication_heartbeat_peer0\n   228\t\tnoLegacyTelemetry bool\n   229\t\n   230\t\t// RestoreCommittedLogs is used to enable restore committed logs mode\n   231\t\t// restore committed logs mode is disabled if set to false.\n   232\t\tRestoreCommittedLogs bool\n   233\t}\n   234\t\n   235\t// BootstrapCluster initializes a server's storage with the given cluster\n   236\t// configuration. This should only be called at the beginning of time for the\n   237\t// cluster with an identical configuration listing all Voter servers. There is\n   238\t// no need to bootstrap Nonvoter and Staging servers.\n   239\t//\n   240\t// A cluster can only be bootstrapped once from a single participating Voter\n","exit_code":0,"status":"completed"}}
