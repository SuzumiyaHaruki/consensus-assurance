{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n inmem_store.go | sed -n 1,159p; echo \"=== util.go ===\"; cat -n util.go | sed -n 1,160p'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"sync\"\n     9\t\t\"sync/atomic\"\n    10\t)\n    11\t\n    12\tvar _ CommitTrackingLogStore = &InmemCommitTrackingStore{}\n    13\t\n    14\t// InmemStore implements the LogStore and StableStore interface.\n    15\t// It should NOT EVER be used for production. It is used only for\n    16\t// unit tests. Use the MDBStore implementation instead.\n    17\ttype InmemStore struct {\n    18\t\tl         sync.RWMutex\n    19\t\tlowIndex  uint64\n    20\t\thighIndex uint64\n    21\t\tlogs      map[uint64]*Log\n    22\t\tkv        map[string][]byte\n    23\t\tkvInt     map[string]uint64\n    24\t}\n    25\t\n    26\t// NewInmemStore returns a new in-memory backend. Do not ever\n    27\t// use for production. Only for testing.\n    28\tfunc NewInmemStore() *InmemStore {\n    29\t\ti := &InmemStore{\n    30\t\t\tlogs:  make(map[uint64]*Log),\n    31\t\t\tkv:    make(map[string][]byte),\n    32\t\t\tkvInt: make(map[string]uint64),\n    33\t\t}\n    34\t\treturn i\n    35\t}\n    36\t\n    37\t// FirstIndex implements the LogStore interface.\n    38\tfunc (i *InmemStore) FirstIndex() (uint64, error) {\n    39\t\ti.l.RLock()\n    40\t\tdefer i.l.RUnlock()\n    41\t\treturn i.lowIndex, nil\n    42\t}\n    43\t\n    44\t// LastIndex implements the LogStore interface.\n    45\tfunc (i *InmemStore) LastIndex() (uint64, error) {\n    46\t\ti.l.RLock()\n    47\t\tdefer i.l.RUnlock()\n    48\t\treturn i.highIndex, nil\n    49\t}\n    50\t\n    51\t// GetLog implements the LogStore interface.\n    52\tfunc (i *InmemStore) GetLog(index uint64, log *Log) error {\n    53\t\ti.l.RLock()\n    54\t\tdefer i.l.RUnlock()\n    55\t\tl, ok := i.logs[index]\n    56\t\tif !ok {\n    57\t\t\treturn ErrLogNotFound\n    58\t\t}\n    59\t\t*log = *l\n    60\t\treturn nil\n    61\t}\n    62\t\n    63\t// StoreLog implements the LogStore interface.\n    64\tfunc (i *InmemStore) StoreLog(log *Log) error {\n    65\t\treturn i.StoreLogs([]*Log{log})\n    66\t}\n    67\t\n    68\t// StoreLogs implements the LogStore interface.\n    69\tfunc (i *InmemStore) StoreLogs(logs []*Log) error {\n    70\t\ti.l.Lock()\n    71\t\tdefer i.l.Unlock()\n    72\t\tfor _, l := range logs {\n    73\t\t\ti.logs[l.Index] = l\n    74\t\t\tif i.lowIndex == 0 {\n    75\t\t\t\ti.lowIndex = l.Index\n    76\t\t\t}\n    77\t\t\tif l.Index > i.highIndex {\n    78\t\t\t\ti.highIndex = l.Index\n    79\t\t\t}\n    80\t\t}\n    81\t\treturn nil\n    82\t}\n    83\t\n    84\t// DeleteRange implements the LogStore interface.\n    85\tfunc (i *InmemStore) DeleteRange(min, max uint64) error {\n    86\t\ti.l.Lock()\n    87\t\tdefer i.l.Unlock()\n    88\t\tfor j := min; j <= max; j++ {\n    89\t\t\tdelete(i.logs, j)\n    90\t\t}\n    91\t\tif min <= i.lowIndex {\n    92\t\t\ti.lowIndex = max + 1\n    93\t\t}\n    94\t\tif max >= i.highIndex {\n    95\t\t\ti.highIndex = min - 1\n    96\t\t}\n    97\t\tif i.lowIndex > i.highIndex {\n    98\t\t\ti.lowIndex = 0\n    99\t\t\ti.highIndex = 0\n   100\t\t}\n   101\t\treturn nil\n   102\t}\n   103\t\n   104\t// Set implements the StableStore interface.\n   105\tfunc (i *InmemStore) Set(key []byte, val []byte) error {\n   106\t\ti.l.Lock()\n   107\t\tdefer i.l.Unlock()\n   108\t\ti.kv[string(key)] = val\n   109\t\treturn nil\n   110\t}\n   111\t\n   112\t// Get implements the StableStore interface.\n   113\tfunc (i *InmemStore) Get(key []byte) ([]byte, error) {\n   114\t\ti.l.RLock()\n   115\t\tdefer i.l.RUnlock()\n   116\t\tval := i.kv[string(key)]\n   117\t\tif val == nil {\n   118\t\t\treturn nil, errors.New(\"not found\")\n   119\t\t}\n   120\t\treturn val, nil\n   121\t}\n   122\t\n   123\t// SetUint64 implements the StableStore interface.\n   124\tfunc (i *InmemStore) SetUint64(key []byte, val uint64) error {\n   125\t\ti.l.Lock()\n   126\t\tdefer i.l.Unlock()\n   127\t\ti.kvInt[string(key)] = val\n   128\t\treturn nil\n   129\t}\n   130\t\n   131\t// GetUint64 implements the StableStore interface.\n   132\tfunc (i *InmemStore) GetUint64(key []byte) (uint64, error) {\n   133\t\ti.l.RLock()\n   134\t\tdefer i.l.RUnlock()\n   135\t\treturn i.kvInt[string(key)], nil\n   136\t}\n   137\t\n   138\ttype InmemCommitTrackingStore struct {\n   139\t\tInmemStore\n   140\t\tcommitIndex atomic.Uint64\n   141\t}\n   142\t\n   143\t// NewInmemCommitTrackingStore returns a new in-memory backend that tracks the commit index. Do not ever\n   144\t// use for production. Only for testing.\n   145\tfunc NewInmemCommitTrackingStore() *InmemCommitTrackingStore {\n   146\t\ti := &InmemCommitTrackingStore{\n   147\t\t\tInmemStore: *NewInmemStore(),\n   148\t\t}\n   149\t\treturn i\n   150\t}\n   151\t\n   152\tfunc (i *InmemCommitTrackingStore) StageCommitIndex(index uint64) error {\n   153\t\ti.commitIndex.Store(index)\n   154\t\treturn nil\n   155\t}\n   156\t\n   157\tfunc (i *InmemCommitTrackingStore) GetCommitIndex() (uint64, error) {\n   158\t\treturn i.commitIndex.Load(), nil\n   159\t}\n=== util.go ===\n     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bytes\"\n     8\t\tcrand \"crypto/rand\"\n     9\t\t\"fmt\"\n    10\t\t\"math\"\n    11\t\t\"math/big\"\n    12\t\t\"math/rand\"\n    13\t\t\"time\"\n    14\t\n    15\t\t\"github.com/hashicorp/go-msgpack/v2/codec\"\n    16\t)\n    17\t\n    18\t// returns an int64 from a crypto random source\n    19\t// can be used to seed a source for a math/rand.\n    20\tfunc newSeed() int64 {\n    21\t\tr, err := crand.Int(crand.Reader, big.NewInt(math.MaxInt64))\n    22\t\tif err != nil {\n    23\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n    24\t\t}\n    25\t\treturn r.Int64()\n    26\t}\n    27\t\n    28\t// randomTimeout returns a value that is between the minVal and 2x minVal.\n    29\tfunc randomTimeout(minVal time.Duration) <-chan time.Time {\n    30\t\tif minVal == 0 {\n    31\t\t\treturn nil\n    32\t\t}\n    33\t\textra := time.Duration(rand.Int63()) % minVal\n    34\t\treturn time.After(minVal + extra)\n    35\t}\n    36\t\n    37\t// min returns the minimum.\n    38\tfunc min(a, b uint64) uint64 {\n    39\t\tif a <= b {\n    40\t\t\treturn a\n    41\t\t}\n    42\t\treturn b\n    43\t}\n    44\t\n    45\t// max returns the maximum.\n    46\tfunc max(a, b uint64) uint64 {\n    47\t\tif a >= b {\n    48\t\t\treturn a\n    49\t\t}\n    50\t\treturn b\n    51\t}\n    52\t\n    53\t// generateUUID is used to generate a random UUID.\n    54\tfunc generateUUID() string {\n    55\t\tbuf := make([]byte, 16)\n    56\t\tif _, err := crand.Read(buf); err != nil {\n    57\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n    58\t\t}\n    59\t\n    60\t\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%12x\",\n    61\t\t\tbuf[0:4],\n    62\t\t\tbuf[4:6],\n    63\t\t\tbuf[6:8],\n    64\t\t\tbuf[8:10],\n    65\t\t\tbuf[10:16])\n    66\t}\n    67\t\n    68\t// asyncNotifyCh is used to do an async channel send\n    69\t// to a single channel without blocking.\n    70\tfunc asyncNotifyCh(ch chan struct{}) {\n    71\t\tselect {\n    72\t\tcase ch <- struct{}{}:\n    73\t\tdefault:\n    74\t\t}\n    75\t}\n    76\t\n    77\t// drainNotifyCh empties out a single-item notification channel without\n    78\t// blocking, and returns whether it received anything.\n    79\tfunc drainNotifyCh(ch chan struct{}) bool {\n    80\t\tselect {\n    81\t\tcase <-ch:\n    82\t\t\treturn true\n    83\t\tdefault:\n    84\t\t\treturn false\n    85\t\t}\n    86\t}\n    87\t\n    88\t// overrideNotifyBool is used to notify on a bool channel\n    89\t// but override existing value if value is present.\n    90\t// ch must be 1-item buffered channel.\n    91\t//\n    92\t// This method does not support multiple concurrent calls.\n    93\tfunc overrideNotifyBool(ch chan bool, v bool) {\n    94\t\tselect {\n    95\t\tcase ch <- v:\n    96\t\t\t// value sent, all done\n    97\t\tcase <-ch:\n    98\t\t\t// channel had an old value\n    99\t\t\tselect {\n   100\t\t\tcase ch <- v:\n   101\t\t\tdefault:\n   102\t\t\t\tpanic(\"race: channel was sent concurrently\")\n   103\t\t\t}\n   104\t\t}\n   105\t}\n   106\t\n   107\t// Decode reverses the encode operation on a byte slice input.\n   108\tfunc decodeMsgPack(buf []byte, out interface{}) error {\n   109\t\tr := bytes.NewBuffer(buf)\n   110\t\thd := codec.MsgpackHandle{}\n   111\t\tdec := codec.NewDecoder(r, &hd)\n   112\t\treturn dec.Decode(out)\n   113\t}\n   114\t\n   115\t// Encode writes an encoded object to a new bytes buffer.\n   116\tfunc encodeMsgPack(in interface{}) (*bytes.Buffer, error) {\n   117\t\tbuf := bytes.NewBuffer(nil)\n   118\t\thd := codec.MsgpackHandle{}\n   119\t\thd.TimeNotBuiltin = true\n   120\t\n   121\t\tenc := codec.NewEncoder(buf, &hd)\n   122\t\terr := enc.Encode(in)\n   123\t\treturn buf, err\n   124\t}\n   125\t\n   126\t// backoff is used to compute an exponential backoff\n   127\t// duration. Base time is scaled by the current round,\n   128\t// up to some maximum scale factor.\n   129\tfunc backoff(base time.Duration, round, limit uint64) time.Duration {\n   130\t\tpower := min(round, limit)\n   131\t\tfor power > 2 {\n   132\t\t\tbase *= 2\n   133\t\t\tpower--\n   134\t\t}\n   135\t\treturn base\n   136\t}\n   137\t\n   138\t// cappedExponentialBackoff computes the exponential backoff with an adjustable\n   139\t// cap on the max timeout.\n   140\tfunc cappedExponentialBackoff(base time.Duration, round, limit uint64, cap time.Duration) time.Duration {\n   141\t\tpower := min(round, limit)\n   142\t\tfor power > 2 {\n   143\t\t\tif base > cap {\n   144\t\t\t\treturn cap\n   145\t\t\t}\n   146\t\t\tbase *= 2\n   147\t\t\tpower--\n   148\t\t}\n   149\t\tif base > cap {\n   150\t\t\treturn cap\n   151\t\t}\n   152\t\treturn base\n   153\t}\n   154\t\n   155\t// Needed for sorting []uint64, used to determine commitment\n   156\ttype uint64Slice []uint64\n   157\t\n   158\tfunc (p uint64Slice) Len() int           { return len(p) }\n   159\tfunc (p uint64Slice) Less(i, j int) bool { return p[i] < p[j] }\n   160\tfunc (p uint64Slice) Swap(i, j int)      { p[i], p[j] = p[j], p[i] }\n","exit_code":0,"status":"completed"}}
