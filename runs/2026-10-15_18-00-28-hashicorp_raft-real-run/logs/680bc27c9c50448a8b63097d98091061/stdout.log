\tTerm:      req.Term,\n  2138\t\t\t\t\t\t\tGranted:   true,\n  2139\t\t\t\t\t\t},\n  2140\t\t\t\t\t\tvoterID: r.localID,\n  2141\t\t\t\t\t}\n  2142\t\t\t\t} else {\n  2143\t\t\t\t\tr.logger.Debug(\"asking for pre-vote\", \"term\", req.Term, \"from\", server.ID, \"address\", server.Address)\n  2144\t\t\t\t\taskPeer(server)\n  2145\t\t\t\t}\n  2146\t\t\t}\n  2147\t\t}\n  2148\t\n  2149\t\treturn respCh\n  2150\t}\n  2151\t\n  2152\t// persistVote is used to persist our vote for safety.\n  2153\tfunc (r *Raft) persistVote(term uint64, candidate []byte) error {\n  2154\t\tif err := r.stable.SetUint64(keyLastVoteTerm, term); err != nil {\n  2155\t\t\treturn err\n  2156\t\t}\n  2157\t\tif err := r.stable.Set(keyLastVoteCand, candidate); err != nil {\n  2158\t\t\treturn err\n  2159\t\t}\n  2160\t\treturn nil\n  2161\t}\n  2162\t\n  2163\t// setCurrentTerm is used to set the current term in a durable manner.\n  2164\tfunc (r *Raft) setCurrentTerm(t uint64) {\n  2165\t\t// Persist to disk first\n  2166\t\tif err := r.stable.SetUint64(keyCurrentTerm, t); err != nil {\n  2167\t\t\tpanic(fmt.Errorf(\"failed to save current term: %v\", err))\n  2168\t\t}\n  2169\t\tr.raftState.setCurrentTerm(t)\n  2170\t}\n  2171\t\n  2172\t// setState is used to update the current state. Any state\n  2173\t// transition causes the known leader to be cleared. This means\n  2174\t// that leader should be set only after updating the state.\n  2175\tfunc (r *Raft) setState(state RaftState) {\n  2176\t\tr.setLeader(\"\", \"\")\n  2177\t\toldState := r.getState()\n  2178\t\tr.raftState.setState(state)\n  2179\t\tif oldState != state {\n  2180\t\t\tr.observe(state)\n  2181\t\t}\n  2182\t}\n  2183\t\n  2184\t// pickServer returns the follower that is most up to date and participating in quorum.\n  2185\t// Because it accesses leaderstate, it should only be called from the leaderloop.\n  2186\tfunc (r *Raft) pickServer() *Server {\n  2187\t\tvar pick *Server\n  2188\t\tvar current uint64\n  2189\t\tfor _, server := range r.configurations.latest.Servers {\n  2190\t\t\tif server.ID == r.localID || server.Suffrage != Voter {\n  2191\t\t\t\tcontinue\n  2192\t\t\t}\n  2193\t\t\tstate, ok := r.leaderState.replState[server.ID]\n  2194\t\t\tif !ok {\n  2195\t\t\t\tcontinue\n  2196\t\t\t}\n  2197\t\t\tnextIdx := atomic.LoadUint64(&state.nextIndex)\n  2198\t\t\tif nextIdx > current {\n  2199\t\t\t\tcurrent = nextIdx\n  2200\t\t\t\ttmp := server\n  2201\t\t\t\tpick = &tmp\n  2202\t\t\t}\n  2203\t\t}\n  2204\t\treturn pick\n  2205\t}\n  2206\t\n  2207\t// initiateLeadershipTransfer starts the leadership on the leader side, by\n  2208\t// sending a message to the leadershipTransferCh, to make sure it runs in the\n  2209\t// mainloop.\n  2210\tfunc (r *Raft) initiateLeadershipTransfer(id *ServerID, address *ServerAddress) LeadershipTransferFuture {\n  2211\t\tfuture := &leadershipTransferFuture{ID: id, Address: address}\n  2212\t\tfuture.init()\n  2213\t\n  2214\t\tif id != nil && *id == r.localID {\n  2215\t\t\terr := fmt.Errorf(\"cannot transfer leadership to itself\")\n  2216\t\t\tr.logger.Info(err.Error())\n  2217\t\t\tfuture.respond(err)\n  2218\t\t\treturn future\n  2219\t\t}\n  2220\t\n  2221\t\tselect {\n  2222\t\tcase r.leadershipTransferCh <- future:\n  2223\t\t\treturn future\n  2224\t\tcase <-r.shutdownCh:\n  2225\t\t\treturn errorFuture{ErrRaftShutdown}\n  2226\t\tdefault:\n  2227\t\t\treturn errorFuture{ErrEnqueueTimeout}\n  2228\t\t}\n  2229\t}\n  2230\t\n  2231\t// timeoutNow is what happens when a server receives a TimeoutNowRequest.\n  2232\tfunc (r *Raft) timeoutNow(rpc RPC, req *TimeoutNowRequest) {\n  2233\t\tr.setLeader(\"\", \"\")\n  2234\t\tr.setState(Candidate)\n  2235\t\tr.candidateFromLeadershipTransfer.Store(true)\n  2236\t\trpc.Respond(&TimeoutNowResponse{}, nil)\n  2237\t}\n  2238\t\n  2239\t// setLatestConfiguration stores the latest configuration and updates a copy of it.\n  2240\tfunc (r *Raft) setLatestConfiguration(c Configuration, i uint64) {\n  2241\t\tr.configurations.latest = c\n  2242\t\tr.configurations.latestIndex = i\n  2243\t\tr.latestConfiguration.Store(c.Clone())\n  2244\t}\n  2245\t\n  2246\t// setCommittedConfiguration stores the committed configuration.\n  2247\tfunc (r *Raft) setCommittedConfiguration(c Configuration, i uint64) {\n  2248\t\tr.configurations.committed = c\n  2249\t\tr.configurations.committedIndex = i\n  2250\t}\n  2251\t\n  2252\t// getLatestConfiguration reads the configuration from a copy of the main\n  2253\t// configuration, which means it can be accessed independently from the main\n  2254\t// loop.\n  2255\tfunc (r *Raft) getLatestConfiguration() Configuration {\n  2256\t\t// this switch catches the case where this is called without having set\n  2257\t\t// a configuration previously.\n  2258\t\tswitch c := r.latestConfiguration.Load().(type) {\n  2259\t\tcase Configuration:\n  2260\t\t\treturn c\n  2261\t\tdefault:\n  2262\t\t\treturn Configuration{}\n  2263\t\t}\n  2264\t}\n","exit_code":0,"status":"completed"}}
