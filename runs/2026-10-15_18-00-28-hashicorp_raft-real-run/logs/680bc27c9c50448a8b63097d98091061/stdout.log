{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n testing.go | sed -n 1,200p'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2026\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bytes\"\n     8\t\t\"context\"\n     9\t\t\"fmt\"\n    10\t\t\"io\"\n    11\t\t\"os\"\n    12\t\t\"reflect\"\n    13\t\t\"sync\"\n    14\t\t\"testing\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"github.com/hashicorp/go-hclog\"\n    18\t\t\"github.com/hashicorp/go-msgpack/v2/codec\"\n    19\t)\n    20\t\n    21\tvar userSnapshotErrorsOnNoData = true\n    22\t\n    23\t// Return configurations optimized for in-memory\n    24\tfunc inmemConfig(t testing.TB) *Config {\n    25\t\tconf := DefaultConfig()\n    26\t\tconf.HeartbeatTimeout = 50 * time.Millisecond\n    27\t\tconf.ElectionTimeout = 50 * time.Millisecond\n    28\t\tconf.LeaderLeaseTimeout = 50 * time.Millisecond\n    29\t\tconf.CommitTimeout = 5 * time.Millisecond\n    30\t\tconf.Logger = newTestLogger(t)\n    31\t\treturn conf\n    32\t}\n    33\t\n    34\t// MockFSM is an implementation of the FSM interface, and just stores\n    35\t// the logs sequentially.\n    36\t//\n    37\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    38\ttype MockFSM struct {\n    39\t\tsync.Mutex\n    40\t\tlogs           [][]byte\n    41\t\tconfigurations []Configuration\n    42\t}\n    43\t\n    44\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    45\ttype MockFSMConfigStore struct {\n    46\t\tFSM\n    47\t}\n    48\t\n    49\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    50\ttype WrappingFSM interface {\n    51\t\tUnderlying() FSM\n    52\t}\n    53\t\n    54\tfunc getMockFSM(fsm FSM) *MockFSM {\n    55\t\tswitch f := fsm.(type) {\n    56\t\tcase *MockFSM:\n    57\t\t\treturn f\n    58\t\tcase *MockFSMConfigStore:\n    59\t\t\treturn f.FSM.(*MockFSM)\n    60\t\tcase WrappingFSM:\n    61\t\t\treturn getMockFSM(f.Underlying())\n    62\t\t}\n    63\t\n    64\t\treturn nil\n    65\t}\n    66\t\n    67\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    68\ttype MockSnapshot struct {\n    69\t\tlogs     [][]byte\n    70\t\tmaxIndex int\n    71\t}\n    72\t\n    73\tvar _ ConfigurationStore = (*MockFSMConfigStore)(nil)\n    74\t\n    75\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    76\tfunc (m *MockFSM) Apply(log *Log) interface{} {\n    77\t\tm.Lock()\n    78\t\tdefer m.Unlock()\n    79\t\tm.logs = append(m.logs, log.Data)\n    80\t\treturn len(m.logs)\n    81\t}\n    82\t\n    83\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    84\tfunc (m *MockFSM) Snapshot() (FSMSnapshot, error) {\n    85\t\tm.Lock()\n    86\t\tdefer m.Unlock()\n    87\t\treturn &MockSnapshot{m.logs, len(m.logs)}, nil\n    88\t}\n    89\t\n    90\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n    91\tfunc (m *MockFSM) Restore(inp io.ReadCloser) error {\n    92\t\tm.Lock()\n    93\t\tdefer m.Unlock()\n    94\t\tdefer func() { _ = inp.Close() }()\n    95\t\thd := codec.MsgpackHandle{}\n    96\t\tdec := codec.NewDecoder(inp, &hd)\n    97\t\n    98\t\tm.logs = nil\n    99\t\treturn dec.Decode(&m.logs)\n   100\t}\n   101\t\n   102\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n   103\tfunc (m *MockFSM) Logs() [][]byte {\n   104\t\tm.Lock()\n   105\t\tdefer m.Unlock()\n   106\t\treturn m.logs\n   107\t}\n   108\t\n   109\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n   110\tfunc (m *MockFSMConfigStore) StoreConfiguration(index uint64, config Configuration) {\n   111\t\tmm := m.FSM.(*MockFSM)\n   112\t\tmm.Lock()\n   113\t\tdefer mm.Unlock()\n   114\t\tmm.configurations = append(mm.configurations, config)\n   115\t}\n   116\t\n   117\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n   118\tfunc (m *MockSnapshot) Persist(sink SnapshotSink) error {\n   119\t\thd := codec.MsgpackHandle{}\n   120\t\tenc := codec.NewEncoder(sink, &hd)\n   121\t\tif err := enc.Encode(m.logs[:m.maxIndex]); err != nil {\n   122\t\t\t_ = sink.Cancel()\n   123\t\t\treturn err\n   124\t\t}\n   125\t\t_ = sink.Close()\n   126\t\treturn nil\n   127\t}\n   128\t\n   129\t// NOTE: This is exposed for middleware testing purposes and is not a stable API\n   130\tfunc (m *MockSnapshot) Release() {\n   131\t}\n   132\t\n   133\t// MockMonotonicLogStore is a LogStore wrapper for testing the\n   134\t// MonotonicLogStore interface.\n   135\ttype MockMonotonicLogStore struct {\n   136\t\ts LogStore\n   137\t}\n   138\t\n   139\t// IsMonotonic implements the MonotonicLogStore interface.\n   140\tfunc (m *MockMonotonicLogStore) IsMonotonic() bool {\n   141\t\treturn true\n   142\t}\n   143\t\n   144\t// FirstIndex implements the LogStore interface.\n   145\tfunc (m *MockMonotonicLogStore) FirstIndex() (uint64, error) {\n   146\t\treturn m.s.FirstIndex()\n   147\t}\n   148\t\n   149\t// LastIndex implements the LogStore interface.\n   150\tfunc (m *MockMonotonicLogStore) LastIndex() (uint64, error) {\n   151\t\treturn m.s.LastIndex()\n   152\t}\n   153\t\n   154\t// GetLog implements the LogStore interface.\n   155\tfunc (m *MockMonotonicLogStore) GetLog(index uint64, log *Log) error {\n   156\t\treturn m.s.GetLog(index, log)\n   157\t}\n   158\t\n   159\t// StoreLog implements the LogStore interface.\n   160\tfunc (m *MockMonotonicLogStore) StoreLog(log *Log) error {\n   161\t\treturn m.s.StoreLog(log)\n   162\t}\n   163\t\n   164\t// StoreLogs implements the LogStore interface.\n   165\tfunc (m *MockMonotonicLogStore) StoreLogs(logs []*Log) error {\n   166\t\treturn m.s.StoreLogs(logs)\n   167\t}\n   168\t\n   169\t// DeleteRange implements the LogStore interface.\n   170\tfunc (m *MockMonotonicLogStore) DeleteRange(min uint64, max uint64) error {\n   171\t\treturn m.s.DeleteRange(min, max)\n   172\t}\n   173\t\n   174\t// This can be used as the destination for a logger and it'll\n   175\t// map them into calls to testing.T.Log, so that you only see\n   176\t// the logging for failed tests.\n   177\ttype testLoggerAdapter struct {\n   178\t\ttb     testing.TB\n   179\t\tprefix string\n   180\t}\n   181\t\n   182\tfunc (a *testLoggerAdapter) Write(d []byte) (int, error) {\n   183\t\tif d[len(d)-1] == '\\n' {\n   184\t\t\td = d[:len(d)-1]\n   185\t\t}\n   186\t\tif a.prefix != \"\" {\n   187\t\t\tl := a.prefix + \": \" + string(d)\n   188\t\t\ta.tb.Log(l)\n   189\t\t\treturn len(l), nil\n   190\t\t}\n   191\t\n   192\t\ta.tb.Log(string(d))\n   193\t\treturn len(d), nil\n   194\t}\n   195\t\n   196\tfunc newTestLogger(tb testing.TB) hclog.Logger {\n   197\t\treturn newTestLoggerWithPrefix(tb, \"\")\n   198\t}\n   199\t\n   200\t// newTestLoggerWithPrefix returns a Logger that can be used in tests. prefix\n","exit_code":0,"status":"completed"}}
