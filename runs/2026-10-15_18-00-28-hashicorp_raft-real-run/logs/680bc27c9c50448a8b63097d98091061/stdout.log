{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n replication.go | sed -n 480,665p'","aggregated_output":"   480\t\t\t\tif maxIndex > 0 {\n   481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n   482\t\t\t\t}\n   483\t\t\t\tbreak SEND\n   484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   487\t\t\t\tif !shouldStop {\n   488\t\t\t\t\tdeferErr.respond(nil)\n   489\t\t\t\t} else {\n   490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   491\t\t\t\t}\n   492\t\t\tcase <-s.triggerCh:\n   493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   498\t\t\t}\n   499\t\t}\n   500\t\n   501\t\t// Stop our decoder, and wait for it to finish\n   502\t\tclose(stopCh)\n   503\t\tselect {\n   504\t\tcase <-finishCh:\n   505\t\tcase <-r.shutdownCh:\n   506\t\t}\n   507\t\treturn nil\n   508\t}\n   509\t\n   510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n   511\t// pipelineReplicate.\n   512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n   513\t\t// Create a new append request\n   514\t\treq := new(AppendEntriesRequest)\n   515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n   516\t\t\treturn true\n   517\t\t}\n   518\t\n   519\t\t// Pipeline the append entries\n   520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n   521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n   522\t\t\treturn true\n   523\t\t}\n   524\t\n   525\t\t// Increase the next send log to avoid re-sending old logs\n   526\t\tif n := len(req.Entries); n > 0 {\n   527\t\t\tlast := req.Entries[n-1]\n   528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n   529\t\t}\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   561\t\t\t\t// Update our replication state\n   562\t\t\t\tupdateLastAppended(s, req)\n   563\t\t\tcase <-stopCh:\n   564\t\t\t\treturn\n   565\t\t\t}\n   566\t\t}\n   567\t}\n   568\t\n   569\t// setupAppendEntries is used to setup an append entries request.\n   570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   571\t\treq.RPCHeader = r.getRPCHeader()\n   572\t\treq.Term = s.currentTerm\n   573\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   574\t\treq.Leader = r.trans.EncodePeer(r.localID, r.localAddr)\n   575\t\treq.LeaderCommitIndex = r.getCommitIndex()\n   576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n   580\t\t\treturn err\n   581\t\t}\n   582\t\treturn nil\n   583\t}\n   584\t\n   585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n   634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n   635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n   636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n   637\t\n   638\t\tif !skipLegacy {\n   639\t\t\t// Duplicated information. Kept for backward compatibility.\n   640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n   641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n   642\t\t}\n   643\t}\n   644\t\n   645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n","exit_code":0,"status":"completed"}}
