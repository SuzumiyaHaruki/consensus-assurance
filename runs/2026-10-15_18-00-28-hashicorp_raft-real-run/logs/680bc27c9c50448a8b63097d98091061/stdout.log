{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n file_snapshot.go | sed -n 1,300p'","aggregated_output":"     1\t// Copyright IBM Corp. 2013, 2025\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"bufio\"\n     8\t\t\"bytes\"\n     9\t\t\"encoding/json\"\n    10\t\t\"fmt\"\n    11\t\t\"hash\"\n    12\t\t\"hash/crc64\"\n    13\t\t\"io\"\n    14\t\t\"os\"\n    15\t\t\"path/filepath\"\n    16\t\t\"runtime\"\n    17\t\t\"sort\"\n    18\t\t\"strings\"\n    19\t\t\"time\"\n    20\t\n    21\t\thclog \"github.com/hashicorp/go-hclog\"\n    22\t)\n    23\t\n    24\tconst (\n    25\t\ttestPath      = \"permTest\"\n    26\t\tsnapPath      = \"snapshots\"\n    27\t\tmetaFilePath  = \"meta.json\"\n    28\t\tstateFilePath = \"state.bin\"\n    29\t\ttmpSuffix     = \".tmp\"\n    30\t)\n    31\t\n    32\t// FileSnapshotStore implements the SnapshotStore interface and allows\n    33\t// snapshots to be made on the local disk.\n    34\ttype FileSnapshotStore struct {\n    35\t\tpath   string\n    36\t\tretain int\n    37\t\tlogger hclog.Logger\n    38\t\n    39\t\t// noSync, if true, skips crash-safe file fsync api calls.\n    40\t\t// It's a private field, only used in testing\n    41\t\tnoSync bool\n    42\t}\n    43\t\n    44\ttype snapMetaSlice []*fileSnapshotMeta\n    45\t\n    46\t// FileSnapshotSink implements SnapshotSink with a file.\n    47\ttype FileSnapshotSink struct {\n    48\t\tstore     *FileSnapshotStore\n    49\t\tlogger    hclog.Logger\n    50\t\tdir       string\n    51\t\tparentDir string\n    52\t\tmeta      fileSnapshotMeta\n    53\t\n    54\t\tnoSync bool\n    55\t\n    56\t\tstateFile *os.File\n    57\t\tstateHash hash.Hash64\n    58\t\tbuffered  *bufio.Writer\n    59\t\n    60\t\tclosed bool\n    61\t}\n    62\t\n    63\t// fileSnapshotMeta is stored on disk. We also put a CRC\n    64\t// on disk so that we can verify the snapshot.\n    65\ttype fileSnapshotMeta struct {\n    66\t\tSnapshotMeta\n    67\t\tCRC []byte\n    68\t}\n    69\t\n    70\t// bufferedFile is returned when we open a snapshot. This way\n    71\t// reads are buffered and the file still gets closed.\n    72\ttype bufferedFile struct {\n    73\t\tbh *bufio.Reader\n    74\t\tfh *os.File\n    75\t}\n    76\t\n    77\tfunc (b *bufferedFile) Read(p []byte) (n int, err error) {\n    78\t\treturn b.bh.Read(p)\n    79\t}\n    80\t\n    81\tfunc (b *bufferedFile) Close() error {\n    82\t\treturn b.fh.Close()\n    83\t}\n    84\t\n    85\t// NewFileSnapshotStoreWithLogger creates a new FileSnapshotStore based\n    86\t// on a base directory. The `retain` parameter controls how many\n    87\t// snapshots are retained. Must be at least 1.\n    88\tfunc NewFileSnapshotStoreWithLogger(base string, retain int, logger hclog.Logger) (*FileSnapshotStore, error) {\n    89\t\tif retain < 1 {\n    90\t\t\treturn nil, fmt.Errorf(\"must retain at least one snapshot\")\n    91\t\t}\n    92\t\tif logger == nil {\n    93\t\t\tlogger = hclog.New(&hclog.LoggerOptions{\n    94\t\t\t\tName:   \"snapshot\",\n    95\t\t\t\tOutput: hclog.DefaultOutput,\n    96\t\t\t\tLevel:  hclog.DefaultLevel,\n    97\t\t\t})\n    98\t\t}\n    99\t\n   100\t\t// Ensure our path exists\n   101\t\tpath := filepath.Join(base, snapPath)\n   102\t\tif err := os.MkdirAll(path, 0o755); err != nil && !os.IsExist(err) {\n   103\t\t\treturn nil, fmt.Errorf(\"snapshot path not accessible: %v\", err)\n   104\t\t}\n   105\t\n   106\t\t// Setup the store\n   107\t\tstore := &FileSnapshotStore{\n   108\t\t\tpath:   path,\n   109\t\t\tretain: retain,\n   110\t\t\tlogger: logger,\n   111\t\t}\n   112\t\n   113\t\t// Do a permissions test\n   114\t\tif err := store.testPermissions(); err != nil {\n   115\t\t\treturn nil, fmt.Errorf(\"permissions test failed: %v\", err)\n   116\t\t}\n   117\t\treturn store, nil\n   118\t}\n   119\t\n   120\t// NewFileSnapshotStore creates a new FileSnapshotStore based\n   121\t// on a base directory. The `retain` parameter controls how many\n   122\t// snapshots are retained. Must be at least 1.\n   123\tfunc NewFileSnapshotStore(base string, retain int, logOutput io.Writer) (*FileSnapshotStore, error) {\n   124\t\tif logOutput == nil {\n   125\t\t\tlogOutput = os.Stderr\n   126\t\t}\n   127\t\treturn NewFileSnapshotStoreWithLogger(base, retain, hclog.New(&hclog.LoggerOptions{\n   128\t\t\tName:   \"snapshot\",\n   129\t\t\tOutput: logOutput,\n   130\t\t\tLevel:  hclog.DefaultLevel,\n   131\t\t}))\n   132\t}\n   133\t\n   134\t// testPermissions tries to touch a file in our path to see if it works.\n   135\tfunc (f *FileSnapshotStore) testPermissions() error {\n   136\t\tpath := filepath.Join(f.path, testPath)\n   137\t\tfh, err := os.Create(path)\n   138\t\tif err != nil {\n   139\t\t\treturn err\n   140\t\t}\n   141\t\n   142\t\tif err = fh.Close(); err != nil {\n   143\t\t\treturn err\n   144\t\t}\n   145\t\n   146\t\tif err = os.Remove(path); err != nil {\n   147\t\t\treturn err\n   148\t\t}\n   149\t\treturn nil\n   150\t}\n   151\t\n   152\t// snapshotName generates a name for the snapshot.\n   153\tfunc snapshotName(term, index uint64) string {\n   154\t\tnow := time.Now()\n   155\t\tmsec := now.UnixNano() / int64(time.Millisecond)\n   156\t\treturn fmt.Sprintf(\"%d-%d-%d\", term, index, msec)\n   157\t}\n   158\t\n   159\t// Create is used to start a new snapshot\n   160\tfunc (f *FileSnapshotStore) Create(version SnapshotVersion, index, term uint64,\n   161\t\tconfiguration Configuration, configurationIndex uint64, trans Transport) (SnapshotSink, error) {\n   162\t\t// We only support version 1 snapshots at this time.\n   163\t\tif version != 1 {\n   164\t\t\treturn nil, fmt.Errorf(\"unsupported snapshot version %d\", version)\n   165\t\t}\n   166\t\n   167\t\t// Create a new path\n   168\t\tname := snapshotName(term, index)\n   169\t\tpath := filepath.Join(f.path, name+tmpSuffix)\n   170\t\tf.logger.Info(\"creating new snapshot\", \"path\", path)\n   171\t\n   172\t\t// Make the directory\n   173\t\tif err := os.MkdirAll(path, 0o755); err != nil {\n   174\t\t\tf.logger.Error(\"failed to make snapshot directly\", \"error\", err)\n   175\t\t\treturn nil, err\n   176\t\t}\n   177\t\n   178\t\t// Create the sink\n   179\t\tsink := &FileSnapshotSink{\n   180\t\t\tstore:     f,\n   181\t\t\tlogger:    f.logger,\n   182\t\t\tdir:       path,\n   183\t\t\tparentDir: f.path,\n   184\t\t\tnoSync:    f.noSync,\n   185\t\t\tmeta: fileSnapshotMeta{\n   186\t\t\t\tSnapshotMeta: SnapshotMeta{\n   187\t\t\t\t\tVersion:            version,\n   188\t\t\t\t\tID:                 name,\n   189\t\t\t\t\tIndex:              index,\n   190\t\t\t\t\tTerm:               term,\n   191\t\t\t\t\tPeers:              encodePeers(configuration, trans),\n   192\t\t\t\t\tConfiguration:      configuration,\n   193\t\t\t\t\tConfigurationIndex: configurationIndex,\n   194\t\t\t\t},\n   195\t\t\t\tCRC: nil,\n   196\t\t\t},\n   197\t\t}\n   198\t\n   199\t\t// Write out the meta data\n   200\t\tif err := sink.writeMeta(); err != nil {\n   201\t\t\tf.logger.Error(\"failed to write metadata\", \"error\", err)\n   202\t\t\treturn nil, err\n   203\t\t}\n   204\t\n   205\t\t// Open the state file\n   206\t\tstatePath := filepath.Join(path, stateFilePath)\n   207\t\tfh, err := os.Create(statePath)\n   208\t\tif err != nil {\n   209\t\t\tf.logger.Error(\"failed to create state file\", \"error\", err)\n   210\t\t\treturn nil, err\n   211\t\t}\n   212\t\tsink.stateFile = fh\n   213\t\n   214\t\t// Create a CRC64 hash\n   215\t\tsink.stateHash = crc64.New(crc64.MakeTable(crc64.ECMA))\n   216\t\n   217\t\t// Wrap both the hash and file in a MultiWriter with buffering\n   218\t\tmulti := io.MultiWriter(sink.stateFile, sink.stateHash)\n   219\t\tsink.buffered = bufio.NewWriter(multi)\n   220\t\n   221\t\t// Done\n   222\t\treturn sink, nil\n   223\t}\n   224\t\n   225\t// List returns available snapshots in the store.\n   226\tfunc (f *FileSnapshotStore) List() ([]*SnapshotMeta, error) {\n   227\t\t// Get the eligible snapshots\n   228\t\tsnapshots, err := f.getSnapshots()\n   229\t\tif err != nil {\n   230\t\t\tf.logger.Error(\"failed to get snapshots\", \"error\", err)\n   231\t\t\treturn nil, err\n   232\t\t}\n   233\t\n   234\t\tvar snapMeta []*SnapshotMeta\n   235\t\tfor _, meta := range snapshots {\n   236\t\t\tsnapMeta = append(snapMeta, &meta.SnapshotMeta)\n   237\t\t\tif len(snapMeta) == f.retain {\n   238\t\t\t\tbreak\n   239\t\t\t}\n   240\t\t}\n   241\t\treturn snapMeta, nil\n   242\t}\n   243\t\n   244\t// getSnapshots returns all the known snapshots.\n   245\tfunc (f *FileSnapshotStore) getSnapshots() ([]*fileSnapshotMeta, error) {\n   246\t\t// Get the eligible snapshots\n   247\t\tsnapshots, err := os.ReadDir(f.path)\n   248\t\tif err != nil {\n   249\t\t\tf.logger.Error(\"failed to scan snapshot directory\", \"error\", err)\n   250\t\t\treturn nil, err\n   251\t\t}\n   252\t\n   253\t\t// Populate the metadata\n   254\t\tvar snapMeta []*fileSnapshotMeta\n   255\t\tfor _, snap := range snapshots {\n   256\t\t\t// Ignore any files\n   257\t\t\tif !snap.IsDir() {\n   258\t\t\t\tcontinue\n   259\t\t\t}\n   260\t\n   261\t\t\t// Ignore any temporary snapshots\n   262\t\t\tdirName := snap.Name()\n   263\t\t\tif strings.HasSuffix(dirName, tmpSuffix) {\n   264\t\t\t\tf.logger.Warn(\"found temporary snapshot\", \"name\", dirName)\n   265\t\t\t\tcontinue\n   266\t\t\t}\n   267\t\n   268\t\t\t// Try to read the meta data\n   269\t\t\tmeta, err := f.readMeta(dirName)\n   270\t\t\tif err != nil {\n   271\t\t\t\tf.logger.Warn(\"failed to read metadata\", \"name\", dirName, \"error\", err)\n   272\t\t\t\tcontinue\n   273\t\t\t}\n   274\t\n   275\t\t\t// Make sure we can understand this version.\n   276\t\t\tif meta.Version < SnapshotVersionMin || meta.Version > SnapshotVersionMax {\n   277\t\t\t\tf.logger.Warn(\"snapshot version not supported\", \"name\", dirName, \"version\", meta.Version)\n   278\t\t\t\tcontinue\n   279\t\t\t}\n   280\t\n   281\t\t\t// Append, but only return up to the retain count\n   282\t\t\tsnapMeta = append(snapMeta, meta)\n   283\t\t}\n   284\t\n   285\t\t// Sort the snapshot, reverse so we get new -> old\n   286\t\tsort.Sort(sort.Reverse(snapMetaSlice(snapMeta)))\n   287\t\n   288\t\treturn snapMeta, nil\n   289\t}\n   290\t\n   291\t// readMeta is used to read the meta data for a given named backup\n   292\tfunc (f *FileSnapshotStore) readMeta(name string) (*fileSnapshotMeta, error) {\n   293\t\t// Open the meta file\n   294\t\tmetaPath := filepath.Join(f.path, name, metaFilePath)\n   295\t\tfh, err := os.Open(metaPath)\n   296\t\tif err != nil {\n   297\t\t\treturn nil, err\n   298\t\t}\n   299\t\tdefer func() { _ = fh.Close() }()\n   300\t\n","exit_code":0,"status":"completed"}}
