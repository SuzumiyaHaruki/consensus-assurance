{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/agent-source && cat -n raft.go | sed -n 1400,1750p'","aggregated_output":"  1400\t\t}\n  1401\t\tif err := store.StageCommitIndex(commitIndex); err != nil {\n  1402\t\t\tr.logger.Error(\"failed to stage commit index in commit tracking log store\", \"index\", commitIndex, \"error\", err)\n  1403\t\t}\n  1404\t}\n  1405\t\n  1406\t// processRPC is called to handle an incoming RPC request. This must only be\n  1407\t// called from the main thread.\n  1408\tfunc (r *Raft) processRPC(rpc RPC) {\n  1409\t\tif err := r.checkRPCHeader(rpc); err != nil {\n  1410\t\t\trpc.Respond(nil, err)\n  1411\t\t\treturn\n  1412\t\t}\n  1413\t\n  1414\t\tswitch cmd := rpc.Command.(type) {\n  1415\t\tcase *AppendEntriesRequest:\n  1416\t\t\tr.appendEntries(rpc, cmd)\n  1417\t\tcase *RequestVoteRequest:\n  1418\t\t\tr.requestVote(rpc, cmd)\n  1419\t\tcase *RequestPreVoteRequest:\n  1420\t\t\tr.requestPreVote(rpc, cmd)\n  1421\t\tcase *InstallSnapshotRequest:\n  1422\t\t\tr.installSnapshot(rpc, cmd)\n  1423\t\tcase *TimeoutNowRequest:\n  1424\t\t\tr.timeoutNow(rpc, cmd)\n  1425\t\tdefault:\n  1426\t\t\tr.logger.Error(\"got unexpected command\",\n  1427\t\t\t\t\"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1428\t\n  1429\t\t\trpc.Respond(nil, errors.New(rpcUnexpectedCommandError))\n  1430\t\t}\n  1431\t}\n  1432\t\n  1433\t// processHeartbeat is a special handler used just for heartbeat requests\n  1434\t// so that they can be fast-pathed if a transport supports it. This must only\n  1435\t// be called from the main thread.\n  1436\tfunc (r *Raft) processHeartbeat(rpc RPC) {\n  1437\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"processHeartbeat\"}, time.Now())\n  1438\t\n  1439\t\t// Check if we are shutdown, just ignore the RPC\n  1440\t\tselect {\n  1441\t\tcase <-r.shutdownCh:\n  1442\t\t\treturn\n  1443\t\tdefault:\n  1444\t\t}\n  1445\t\n  1446\t\t// Ensure we are only handling a heartbeat\n  1447\t\tswitch cmd := rpc.Command.(type) {\n  1448\t\tcase *AppendEntriesRequest:\n  1449\t\t\tr.appendEntries(rpc, cmd)\n  1450\t\tdefault:\n  1451\t\t\tr.logger.Error(\"expected heartbeat, got\", \"command\", hclog.Fmt(\"%#v\", rpc.Command))\n  1452\t\t\trpc.Respond(nil, fmt.Errorf(\"unexpected command\"))\n  1453\t\t}\n  1454\t}\n  1455\t\n  1456\t// appendEntries is invoked when we get an append entries RPC call. This must\n  1457\t// only be called from the main thread.\n  1458\tfunc (r *Raft) appendEntries(rpc RPC, a *AppendEntriesRequest) {\n  1459\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\"}, time.Now())\n  1460\t\t// Setup a response\n  1461\t\tresp := &AppendEntriesResponse{\n  1462\t\t\tRPCHeader:      r.getRPCHeader(),\n  1463\t\t\tTerm:           r.getCurrentTerm(),\n  1464\t\t\tLastLog:        r.getLastIndex(),\n  1465\t\t\tSuccess:        false,\n  1466\t\t\tNoRetryBackoff: false,\n  1467\t\t}\n  1468\t\tvar rpcErr error\n  1469\t\tdefer func() {\n  1470\t\t\trpc.Respond(resp, rpcErr)\n  1471\t\t}()\n  1472\t\n  1473\t\t// Ignore an older term\n  1474\t\tif a.Term < r.getCurrentTerm() {\n  1475\t\t\treturn\n  1476\t\t}\n  1477\t\n  1478\t\t// Increase the term if we see a newer one, also transition to follower\n  1479\t\t// if we ever get an appendEntries call\n  1480\t\tif a.Term > r.getCurrentTerm() || (r.getState() != Follower && !r.candidateFromLeadershipTransfer.Load()) {\n  1481\t\t\t// Ensure transition to follower\n  1482\t\t\tr.setState(Follower)\n  1483\t\t\tr.setCurrentTerm(a.Term)\n  1484\t\t\tresp.Term = a.Term\n  1485\t\t}\n  1486\t\n  1487\t\t// Save the current leader\n  1488\t\tif len(a.Addr) > 0 {\n  1489\t\t\tr.setLeader(r.trans.DecodePeer(a.Addr), ServerID(a.ID))\n  1490\t\t} else {\n  1491\t\t\tr.setLeader(r.trans.DecodePeer(a.Leader), ServerID(a.ID))\n  1492\t\t}\n  1493\t\t// Verify the last log entry\n  1494\t\tif a.PrevLogEntry > 0 {\n  1495\t\t\tlastIdx, lastTerm := r.getLastEntry()\n  1496\t\n  1497\t\t\tvar prevLogTerm uint64\n  1498\t\t\tif a.PrevLogEntry == lastIdx {\n  1499\t\t\t\tprevLogTerm = lastTerm\n  1500\t\t\t} else {\n  1501\t\t\t\tvar prevLog Log\n  1502\t\t\t\tif err := r.logs.GetLog(a.PrevLogEntry, &prevLog); err != nil {\n  1503\t\t\t\t\tr.logger.Warn(\"failed to get previous log\",\n  1504\t\t\t\t\t\t\"previous-index\", a.PrevLogEntry,\n  1505\t\t\t\t\t\t\"last-index\", lastIdx,\n  1506\t\t\t\t\t\t\"error\", err)\n  1507\t\t\t\t\tresp.NoRetryBackoff = true\n  1508\t\t\t\t\treturn\n  1509\t\t\t\t}\n  1510\t\t\t\tprevLogTerm = prevLog.Term\n  1511\t\t\t}\n  1512\t\n  1513\t\t\tif a.PrevLogTerm != prevLogTerm {\n  1514\t\t\t\tr.logger.Warn(\"previous log term mis-match\",\n  1515\t\t\t\t\t\"ours\", prevLogTerm,\n  1516\t\t\t\t\t\"remote\", a.PrevLogTerm)\n  1517\t\t\t\tresp.NoRetryBackoff = true\n  1518\t\t\t\treturn\n  1519\t\t\t}\n  1520\t\t}\n  1521\t\n  1522\t\t// Process any new entries\n  1523\t\tif len(a.Entries) > 0 {\n  1524\t\t\tstart := time.Now()\n  1525\t\n  1526\t\t\t// Delete any conflicting entries, skip any duplicates\n  1527\t\t\tlastLogIdx, _ := r.getLastLog()\n  1528\t\t\tvar newEntries []*Log\n  1529\t\t\tfor i, entry := range a.Entries {\n  1530\t\t\t\tif entry.Index > lastLogIdx {\n  1531\t\t\t\t\tnewEntries = a.Entries[i:]\n  1532\t\t\t\t\tbreak\n  1533\t\t\t\t}\n  1534\t\t\t\tvar storeEntry Log\n  1535\t\t\t\tif err := r.logs.GetLog(entry.Index, &storeEntry); err != nil {\n  1536\t\t\t\t\tr.logger.Warn(\"failed to get log entry\",\n  1537\t\t\t\t\t\t\"index\", entry.Index,\n  1538\t\t\t\t\t\t\"error\", err)\n  1539\t\t\t\t\treturn\n  1540\t\t\t\t}\n  1541\t\t\t\tif entry.Term != storeEntry.Term {\n  1542\t\t\t\t\tr.logger.Warn(\"clearing log suffix\", \"from\", entry.Index, \"to\", lastLogIdx)\n  1543\t\t\t\t\tif err := r.logs.DeleteRange(entry.Index, lastLogIdx); err != nil {\n  1544\t\t\t\t\t\tr.logger.Error(\"failed to clear log suffix\", \"error\", err)\n  1545\t\t\t\t\t\treturn\n  1546\t\t\t\t\t}\n  1547\t\t\t\t\tif entry.Index <= r.configurations.latestIndex {\n  1548\t\t\t\t\t\tr.setLatestConfiguration(r.configurations.committed, r.configurations.committedIndex)\n  1549\t\t\t\t\t}\n  1550\t\t\t\t\tnewEntries = a.Entries[i:]\n  1551\t\t\t\t\tbreak\n  1552\t\t\t\t}\n  1553\t\t\t}\n  1554\t\n  1555\t\t\tif n := len(newEntries); n > 0 {\n  1556\t\t\t\t// Stage the future commit index if possible\n  1557\t\t\t\tlastNewIndex := newEntries[len(newEntries)-1].Index\n  1558\t\t\t\tcommitIndex := min(a.LeaderCommitIndex, lastNewIndex)\n  1559\t\t\t\tr.tryStageCommitIndex(commitIndex)\n  1560\t\n  1561\t\t\t\t// Append the new entries\n  1562\t\t\t\tif err := r.logs.StoreLogs(newEntries); err != nil {\n  1563\t\t\t\t\tr.logger.Error(\"failed to append to logs\", \"error\", err)\n  1564\t\t\t\t\t// TODO: leaving r.getLastLog() in the wrong\n  1565\t\t\t\t\t// state if there was a truncation above\n  1566\t\t\t\t\treturn\n  1567\t\t\t\t}\n  1568\t\n  1569\t\t\t\t// Handle any new configuration changes\n  1570\t\t\t\tfor _, newEntry := range newEntries {\n  1571\t\t\t\t\tif err := r.processConfigurationLogEntry(newEntry); err != nil {\n  1572\t\t\t\t\t\tr.logger.Warn(\"failed to append entry\",\n  1573\t\t\t\t\t\t\t\"index\", newEntry.Index,\n  1574\t\t\t\t\t\t\t\"error\", err)\n  1575\t\t\t\t\t\trpcErr = err\n  1576\t\t\t\t\t\treturn\n  1577\t\t\t\t\t}\n  1578\t\t\t\t}\n  1579\t\n  1580\t\t\t\t// Update the lastLog\n  1581\t\t\t\tlast := newEntries[n-1]\n  1582\t\t\t\tr.setLastLog(last.Index, last.Term)\n  1583\t\t\t}\n  1584\t\n  1585\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"storeLogs\"}, start)\n  1586\t\t}\n  1587\t\n  1588\t\t// Update the commit index\n  1589\t\tif a.LeaderCommitIndex > 0 && a.LeaderCommitIndex > r.getCommitIndex() {\n  1590\t\t\tstart := time.Now()\n  1591\t\t\tidx := min(a.LeaderCommitIndex, r.getLastIndex())\n  1592\t\t\tr.setCommitIndex(idx)\n  1593\t\t\tif r.configurations.latestIndex <= idx {\n  1594\t\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1595\t\t\t}\n  1596\t\t\tr.processLogs(idx, nil)\n  1597\t\t\tmetrics.MeasureSince([]string{\"raft\", \"rpc\", \"appendEntries\", \"processLogs\"}, start)\n  1598\t\t}\n  1599\t\n  1600\t\t// Everything went well, set success\n  1601\t\tresp.Success = true\n  1602\t\tr.setLastContact()\n  1603\t}\n  1604\t\n  1605\t// processConfigurationLogEntry takes a log entry and updates the latest\n  1606\t// configuration if the entry results in a new configuration. This must only be\n  1607\t// called from the main thread, or from NewRaft() before any threads have begun.\n  1608\tfunc (r *Raft) processConfigurationLogEntry(entry *Log) error {\n  1609\t\tswitch entry.Type {\n  1610\t\tcase LogConfiguration:\n  1611\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1612\t\t\tr.setLatestConfiguration(DecodeConfiguration(entry.Data), entry.Index)\n  1613\t\n  1614\t\tcase LogAddPeerDeprecated, LogRemovePeerDeprecated:\n  1615\t\t\tr.setCommittedConfiguration(r.configurations.latest, r.configurations.latestIndex)\n  1616\t\t\tconf, err := decodePeers(entry.Data, r.trans)\n  1617\t\t\tif err != nil {\n  1618\t\t\t\treturn err\n  1619\t\t\t}\n  1620\t\t\tr.setLatestConfiguration(conf, entry.Index)\n  1621\t\t}\n  1622\t\treturn nil\n  1623\t}\n  1624\t\n  1625\t// requestVote is invoked when we get a request vote RPC call.\n  1626\tfunc (r *Raft) requestVote(rpc RPC, req *RequestVoteRequest) {\n  1627\t\tdefer metrics.MeasureSince([]string{\"raft\", \"rpc\", \"requestVote\"}, time.Now())\n  1628\t\tr.observe(*req)\n  1629\t\n  1630\t\t// Setup a response\n  1631\t\tresp := &RequestVoteResponse{\n  1632\t\t\tRPCHeader: r.getRPCHeader(),\n  1633\t\t\tTerm:      r.getCurrentTerm(),\n  1634\t\t\tGranted:   false,\n  1635\t\t}\n  1636\t\tvar rpcErr error\n  1637\t\tdefer func() {\n  1638\t\t\trpc.Respond(resp, rpcErr)\n  1639\t\t}()\n  1640\t\n  1641\t\t// Version 0 servers will panic unless the peers is present. It's only\n  1642\t\t// used on them to produce a warning message.\n  1643\t\tif r.protocolVersion < 2 {\n  1644\t\t\tresp.Peers = encodePeers(r.configurations.latest, r.trans)\n  1645\t\t}\n  1646\t\n  1647\t\t// Check if we have an existing leader [who's not the candidate] and also\n  1648\t\t// check the LeadershipTransfer flag is set. Usually votes are rejected if\n  1649\t\t// there is a known leader. But if the leader initiated a leadership transfer,\n  1650\t\t// vote!\n  1651\t\tvar candidate ServerAddress\n  1652\t\tvar candidateBytes []byte\n  1653\t\tif len(req.Addr) > 0 {\n  1654\t\t\tcandidate = r.trans.DecodePeer(req.Addr)\n  1655\t\t\tcandidateBytes = req.Addr\n  1656\t\t} else {\n  1657\t\t\tcandidate = r.trans.DecodePeer(req.Candidate)\n  1658\t\t\tcandidateBytes = req.Candidate\n  1659\t\t}\n  1660\t\n  1661\t\t// For older raft version ID is not part of the packed message\n  1662\t\t// We assume that the peer is part of the configuration and skip this check\n  1663\t\tif len(req.ID) > 0 {\n  1664\t\t\tcandidateID := ServerID(req.ID)\n  1665\t\t\t// if the Servers list is empty that mean the cluster is very likely trying to bootstrap,\n  1666\t\t\t// Grant the vote\n  1667\t\t\tif len(r.configurations.latest.Servers) > 0 && !inConfiguration(r.configurations.latest, candidateID) {\n  1668\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not in configuration\",\n  1669\t\t\t\t\t\"from\", candidate)\n  1670\t\t\t\treturn\n  1671\t\t\t}\n  1672\t\t}\n  1673\t\tif leaderAddr, leaderID := r.LeaderWithID(); leaderAddr != \"\" && leaderAddr != candidate && !req.LeadershipTransfer {\n  1674\t\t\tr.logger.Warn(\"rejecting vote request since we have a leader\",\n  1675\t\t\t\t\"from\", candidate,\n  1676\t\t\t\t\"leader\", leaderAddr,\n  1677\t\t\t\t\"leader-id\", string(leaderID))\n  1678\t\t\treturn\n  1679\t\t}\n  1680\t\n  1681\t\t// Ignore an older term\n  1682\t\tif req.Term < r.getCurrentTerm() {\n  1683\t\t\treturn\n  1684\t\t}\n  1685\t\n  1686\t\t// Increase the term if we see a newer one\n  1687\t\tif req.Term > r.getCurrentTerm() {\n  1688\t\t\t// Ensure transition to follower\n  1689\t\t\tr.logger.Debug(\"lost leadership because received a requestVote with a newer term\")\n  1690\t\t\tr.setState(Follower)\n  1691\t\t\tr.setCurrentTerm(req.Term)\n  1692\t\n  1693\t\t\tresp.Term = req.Term\n  1694\t\t}\n  1695\t\n  1696\t\t// if we get a request for vote from a nonVoter  and the request term is higher,\n  1697\t\t// step down and update term, but reject the vote request\n  1698\t\t// This could happen when a node, previously voter, is converted to non-voter\n  1699\t\t// The reason we need to step in is to permit to the cluster to make progress in such a scenario\n  1700\t\t// More details about that in https://github.com/hashicorp/raft/pull/526\n  1701\t\tif len(req.ID) > 0 {\n  1702\t\t\tcandidateID := ServerID(req.ID)\n  1703\t\t\tif len(r.configurations.latest.Servers) > 0 && !hasVote(r.configurations.latest, candidateID) {\n  1704\t\t\t\tr.logger.Warn(\"rejecting vote request since node is not a voter\", \"from\", candidate)\n  1705\t\t\t\treturn\n  1706\t\t\t}\n  1707\t\t}\n  1708\t\t// Check if we have voted yet\n  1709\t\tlastVoteTerm, err := r.stable.GetUint64(keyLastVoteTerm)\n  1710\t\tif err != nil && err.Error() != \"not found\" {\n  1711\t\t\tr.logger.Error(\"failed to get last vote term\", \"error\", err)\n  1712\t\t\treturn\n  1713\t\t}\n  1714\t\tlastVoteCandBytes, err := r.stable.Get(keyLastVoteCand)\n  1715\t\tif err != nil && err.Error() != \"not found\" {\n  1716\t\t\tr.logger.Error(\"failed to get last vote candidate\", \"error\", err)\n  1717\t\t\treturn\n  1718\t\t}\n  1719\t\n  1720\t\t// Check if we've voted in this election before\n  1721\t\tif lastVoteTerm == req.Term && lastVoteCandBytes != nil {\n  1722\t\t\tr.logger.Info(\"duplicate requestVote for same term\", \"term\", req.Term)\n  1723\t\t\tif bytes.Equal(lastVoteCandBytes, candidateBytes) {\n  1724\t\t\t\tr.logger.Warn(\"duplicate requestVote from\", \"candidate\", candidate)\n  1725\t\t\t\tresp.Granted = true\n  1726\t\t\t}\n  1727\t\t\treturn\n  1728\t\t}\n  1729\t\n  1730\t\t// Reject if their term is older\n  1731\t\tlastIdx, lastTerm := r.getLastEntry()\n  1732\t\tif lastTerm > req.LastLogTerm {\n  1733\t\t\tr.logger.Warn(\"rejecting vote request since our last term is greater\",\n  1734\t\t\t\t\"candidate\", candidate,\n  1735\t\t\t\t\"last-term\", lastTerm,\n  1736\t\t\t\t\"last-candidate-term\", req.LastLogTerm)\n  1737\t\t\treturn\n  1738\t\t}\n  1739\t\n  1740\t\tif lastTerm == req.LastLogTerm && lastIdx > req.LastLogIndex {\n  1741\t\t\tr.logger.Warn(\"rejecting vote request since our last index is greater\",\n  1742\t\t\t\t\"candidate\", candidate,\n  1743\t\t\t\t\"last-index\", lastIdx,\n  1744\t\t\t\t\"last-candidate-index\", req.LastLogIndex)\n  1745\t\t\treturn\n  1746\t\t}\n  1747\t\n  1748\t\t// Persist a vote for safety\n  1749\t\tif err := r.persistVote(req.Term, candidateBytes); err != nil {\n  1750\t\t\tr.logger.Error(\"failed to persist vote\", \"error\", err)\n","exit_code":0,"status":"completed"}}
