ionFuture {\n\tconfigReq := &configurationsFuture{}\n\tconfigReq.init()\n\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n\tconfigReq.respond(nil)\n\treturn configReq\n=== grep Barrier\napi.go:902:// Barrier is used to issue a command that blocks until all preceding\napi.go:907:func (r *Raft) Barrier(timeout time.Duration) Future {\napi.go:915:\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\nfsm.go:135:\t\t// Only send LogCommand and LogConfiguration log types. LogBarrier types\nlog.go:33:\t// LogBarrier is used to ensure all preceding operations have been\nlog.go:38:\tLogBarrier\nlog.go:57:\tcase LogBarrier:\nlog.go:58:\t\treturn \"LogBarrier\"\nraft.go:1368:\tcase LogBarrier:\nraft.go:1369:\t\t// Barrier is handled by the FSM\n","exit_code":0,"status":"completed"}}
