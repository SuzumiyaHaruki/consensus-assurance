{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'; s=open(p).read()\nhelper='''\n// caConfigChange retries a configuration change on the current leader so that an\n// election racing the call does not fail the whole harness.\nfunc caConfigChange(t *testing.T, leader func() *Raft, apply func(l *Raft) error) {\n\tt.Helper()\n\tfor i := 0; i < 40; i++ {\n\t\tl := leader()\n\t\tif l \"'!= nil {\n\t\t\terr := apply(l)\n\t\t\tif err == nil {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif err != ErrNotLeader {\n\t\t\t\tt.Fatalf(\"configuration change failed: %v\", err)\n\t\t\t}\n\t\t}\n\t\ttime.Sleep(25 * time.Millisecond)\n\t}\n\tt.Fatalf(\"configuration change did not succeed\")\n}\n'\"'''\ns=s.replace('func caPoll(cond func() bool, d time.Duration) bool {', helper.strip()+'\\\\n\\\\nfunc caPoll(cond func() bool, d time.Duration) bool {',1)\npairs=[\n('''\tif l := ldr(); l == nil {\n\t\tt.Fatalf(\\\"no leader for bootstrap step\\\")\n\t} else if err := l.RemoveServer(ids[3], 0, 0).Error(); err \"'!= nil {\n\t\tt.Fatalf(\"remove 3: %v\", err)\n\t}\n\tif l := ldr(); l == nil {\n\t\tt.Fatalf(\"no leader after first removal\")\n\t} else if err := l.RemoveServer(ids[4], 0, 0).Error(); err != nil {\n\t\tt.Fatalf(\"remove 4: %v\", err)\n\t}'\"''','''\tcaConfigChange(t, ldr, func(l *Raft) error { return l.RemoveServer(ids[3], 0, 0).Error() })\n\tcaConfigChange(t, ldr, func(l *Raft) error { return l.RemoveServer(ids[4], 0, 0).Error() })'''),\n('''\tif l := ldr(); l == nil {\n\t\tt.Fatalf(\\\"no leader after snapshot\\\")\n\t} else {\n\t\tif err := l.AddVoter(ids[3], roles[3].localAddr, 0, 0).Error(); err \"'!= nil {\n\t\t\tt.Fatalf(\"re-add 3: %v\", err)\n\t\t}\n\t\tif err := l.AddVoter(ids[4], roles[4].localAddr, 0, 0).Error(); err != nil {\n\t\t\tt.Fatalf(\"re-add 4: %v\", err)\n\t\t}\n\t}'\"''','''\tcaConfigChange(t, ldr, func(l *Raft) error { return l.AddVoter(ids[3], roles[3].localAddr, 0, 0).Error() })\n\tcaConfigChange(t, ldr, func(l *Raft) error { return l.AddVoter(ids[4], roles[4].localAddr, 0, 0).Error() })'''),\n]\nfor old,new in pairs:\n    assert old in s, old[:60]\n    s=s.replace(old,new,1)\nopen(p,'w').write(s)\nprint('patched')\nPY\ncp assurance_generated_test.go work/src/ && cd work/src && export GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft/work/gocache && GOFLAGS=-mod=readonly timeout 400 go test -count=1 -timeout 380s . 2>&1 | tail -3\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
