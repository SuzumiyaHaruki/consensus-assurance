e': False, 'true_quorum': 3, 'write_acknowledged': True, 'write_holders_count': 2}\n13 configuration_future_setup | two-voter-cluster-plus-nonvoter | {}\n14 configuration_future_index | two-voter-cluster-plus-nonvoter | {'future_index': 0, 'stats_latest_configuration_index': '0'}\n15 empty_config_repair_setup | two-voter-restart-no-snapshot | {}\n16 empty_config_repair_result | two-voter-restart-no-snapshot | {'config_repaired_by_later_entry': True}\n17 timeoutnow_removed_setup | three-voter-one-removed | {'removed_node_in_config': False}\n18 timeoutnow_removed_result | three-voter-one-removed | {'leadership_changed': True, 'old_leader_stepped_down': True, 'target_became_leader': True, 'timeoutnow_error': '<nil>'}\n","exit_code":0,"status":"completed"}}
