\": \"three-voter-restart-one-follower\", \"_ca_stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\", \"_ca_observation\": {\"stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\", \"locat\n{\"event\": \"live_cluster_restart_state\", \"leader_in_recovered_config\": false, \"live_config_after_restart\": [], \"live_config_len_after_restart\": 0, \"restarted_leader_after_restart\": \"\", \"restarted_state\": \"Follower\", \"restarted_term_after_restart\": 2, \"variant\": \"three-voter-restart-one-follower\", \"_ca_stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\", \"_ca_observation\": {\"stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\", \"location\": {\"line\": 1529, \"stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\"}, \"runner_time\": \"2026-10-15T19:17:07.172733665+08:00\"}}\n{\"event\": \"live_cluster_heartbeat_convergence\", \"leader_apply_error\": \"<nil>\", \"leader_converged_to_serving_leader\": true, \"restarted_campaigned_on_its_own\": false, \"restarted_last_log_index_after\": 11, \"restarted_last_log_index_before\": 10, \"restarted_leader_after_contact\": \"server-f3a97072-ed9a-c23d-8cf8-2aecba8ee93f\", \"restarted_leader_matches_serving_leader\": true, \"restarted_live_config_len_after_contact\": 0, \"restarted_received_new_command\": true, \"restarted_state_after_contact\": \"Follower\", \"variant\": \"three-voter-restart-one-follower\", \"_ca_stream\": \"[\\\"github.com/hashicorp/raft\\\",\\\"TestAssurance_LiveClusterEmptyConfigRestart\\\"]\", \"_ca_observation\": {\"stream\": \"[\\\"github.com/hashicor\n{\"append_entries_error\": \"<nil>\", \"append_entries_success\": true, \"cluster_leader_present_after\": false, \"event\": \"live_cluster_outsider_contact\", \"outsider_became_leader_of_restarted_node\":