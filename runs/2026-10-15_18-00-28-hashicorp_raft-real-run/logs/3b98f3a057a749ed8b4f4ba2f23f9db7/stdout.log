f err := stable.SetUint64(keyCurrentTerm, 1); err != nil {\n\t\tt.Fatalf(\"set current term: %v\", err)\n\t}\n\n\tcfg := DefaultConfig()\n\tcfg.LocalID = \"self\"\n\tcfg.RestoreCommittedLogs = true\n\tcfg.SnapshotThreshold = 1 << 30\n\tcfg.SnapshotInterval = time.Hour\n\tcfg.TrailingLogs = 10\n\n\t_, trans := NewInmemTransport(\"addr-self\")\n\tn, err := NewRaft(cfg, &MockFSM{}, store, stable, NewInmemSnapshotStore(), trans)\n\tif err != nil {\n\t\tt.Fatalf(\"NewRaft: %v\", err)\n\t}\n\tlive := n.getLatestConfiguration()\n\tlastIdx, _ := store.LastIndex()\n\tstaged, _ := store.GetCommitIndex()\n\n\tcaEmit(t, map[string]interface{}{\n\t\t\"event\":                    \"gap_monotonic_store\",\n\t\t\"variant\":                  \"monotonic-commit-tracking\",\n\t\t\"store_is_monotonic\":       store.IsMonotonic(),\n\t\t\"last_log_index\":           lastIdx,\n\t\t\"staged_commit_index\":      staged,\n\t\t\"last_applied_after_start\": n.getLastApplied(),\n\t\t\"live_config_len\":          len(live.Servers),\n\t\t\"live_config\":              caServers(live),\n\t\t\"config_entry_index\":       1,\n\t\t\"config_entry_in_scan\":     false,\n\t\t\"gap_present\":              len(live.Servers) == 0,\n\t})\n}\nEOF\ncp assurance_generated_test.go work/src/ && cd work/src && export GOCACHE=/home/nitro/Desktop/consensus-assurance/runs/2026-10-15_18-00-28-hashicorp_raft-real-run/draft/work/gocache && GOFLAGS=-mod=readonly timeout 200 go test -count=1 -timeout 180s -v -run '\"'TestAssurance_GapWithMonotonicCommitTrackingStore' . 2>&1 | grep -E \\\"gap_monotonic_store|\"'^--- |''^ok |''^FAIL|declared|undefined\" | cut -c1-420'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
