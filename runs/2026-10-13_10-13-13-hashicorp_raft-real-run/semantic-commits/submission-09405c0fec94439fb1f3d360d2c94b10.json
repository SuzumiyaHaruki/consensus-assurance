    "knowledge": [
      {
        "id": null,
        "ref": "@stale-claim-cannot-win-an-election",
        "kind": "behavior",
        "statement": "A follower that keeps a stale last-log certificate after a truncated conflicting suffix cannot use it to win an election. Truncation only happens when the incoming AppendEntries term is not older than the receiver's current term, so the deleted suffix's terms are strictly lower than the truncating leader's term; any voter that accepted that leader's entries therefore has a last term at least that high and denies the stale claimant through the up-to-date comparison, while the claimant's own campaign and pre-vote messages carry the same stale position. The residue is a misreported LastIndex, a vote credential that does not match the durable log, and the loss of one commitment-quorum slot, not a path to electing a node that lacks committed entries.",
        "conditions": "A follower whose conflicting suffix was deleted while its cached lastLogIndex/lastLogTerm still describe the deleted range, in a configuration where at least a quorum of voters accepted the truncating leader's entries.",
        "source_ids": [
          "appendentries-older-term-guard",
          "requestvote-up-to-date-check",
          "electself-last-entry-claim",
          "appendentries-entry-loop-cached-lastlog"
        ],
