{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/draft && python3 - <<'PY'\np='assurance_generated_test.go'\ns=open(p).read()\n\n# global switch for tight compaction, used only by the snapshot-repair subtest\ns=s.replace('''func assuranceBuildNodes(t *testing.T, n int) []*assuranceNode {\n\tt.Helper()''','''// assuranceTightCompaction makes snapshots cheap and compaction aggressive, so\n// that a leader can be forced to stop serving log entries and send a snapshot\n// instead. It is set by the subtest that needs it and reset afterwards.\nvar assuranceTightCompaction bool\n\nfunc assuranceBuildNodes(t *testing.T, n int) []*assuranceNode {\n\tt.Helper()''',1)\n\ns=s.replace('''\tconf := inmemConfig(t)\n\tfor i := range nodes {\n\t\tpeerConf := *conf\n\t\tpeerConf.LocalID = nodes[i].id\n\t\tif err := BootstrapCluster(&peerConf, nodes[i].store, nodes[i].store, nodes[i].snaps, nodes[i].trans, configuration); err \"'!= nil {'\"''','''\tconf := inmemConfig(t)\n\tif assuranceTightCompaction {\n\t\tconf.SnapshotThreshold = 1\n\t\tconf.TrailingLogs = 0\n\t\tconf.SnapshotInterval = time.Hour\n\t}\n\tfor i := range nodes {\n\t\tpeerConf := *conf\n\t\tpeerConf.LocalID = nodes[i].id\n\t\tif err := BootstrapCluster(&peerConf, nodes[i].store, nodes[i].store, nodes[i].snaps, nodes[i].trans, configuration); err \"'!= nil {'\"''',1)\n\n# add the snapshot-repair subtest to the case table\ns=s.replace('''\t\t{\\\"injected_store_error_then_restart\\\", 3, 1},''','''\t\t{\\\"injected_store_error_then_restart\\\", 3, 1},\n\t\t{\\\"injected_store_error_then_snapshot\\\", 3, 0},''',1)\n\n# set the switch for that subtest\ns=s.replace('''\t\tc := c\n\t\tt.Run(c.mode, func(t *testing.T) {\n\t\t\tassuranceRunTruncationCase(t, c.mode, c.n, c.steps)\n\t\t})''','''\t\tc := c\n\t\tt.Run(c.mode, func(t *testing.T) {\n\t\t\tassuranceTightCompaction = c.mode == \\\"injected_store_error_then_snapshot\\\"\n\t\t\tdefer func() { assuranceTightCompaction = false }()\n\t\t\tassuranceRunTruncationCase(t, c.mode, c.n, c.steps)\n\t\t})''',1)\n\n# snapshot-repair phase, placed before the escalation phase returns\ns=s.replace('''\tif mode == \\\"injected_store_error_then_restart\\\" {''','''\tif mode == \\\"injected_store_error_then_snapshot\\\" {\n\t\tleaderForSnap := assuranceWaitLeader(nodes, time.Second)\n\t\tif leaderForSnap == nil {\n\t\t\tassuranceEmit(\\\"truncation_after_snapshot\\\", map[string]interface{}{\n\t\t\t\t\\\"mode\\\":   mode,\n\t\t\t\t\\\"reason\\\": \\\"no leader before the snapshot phase\\\",\n\t\t\t})\n\t\t\treturn\n\t\t}\n\t\tbeforeFirst, _ := diverging.store.FirstIndex()\n\t\tsnapErr := make(chan error, 1)\n\t\tgo func() { snapErr <- leaderForSnap.raft.Snapshot().Error() }()\n\t\tvar serr error\n\t\tselect {\n\t\tcase serr = <-snapErr:\n\t\tcase <-time.After(3 * time.Second):\n\t\t}\n\t\tafterFirst, _ := diverging.store.FirstIndex()\n\t\tstartSnap := time.Now()\n\t\tvar certs, stores, commits, firsts []interface{}\n\t\tfor i := 0; i < 20; i++ {\n\t\t\tcertIdx, _ := diverging.raft.getLastEntry()\n\t\t\tlast, _ := diverging.store.LastIndex()\n\t\t\tfirst, _ := diverging.store.FirstIndex()\n\t\t\tcerts = append(certs, certIdx)\n\t\t\tstores = append(stores, last)\n\t\t\tcommits = append(commits, diverging.raft.CommitIndex())\n\t\t\tfirsts = append(firsts, first)\n\t\t\ttime.Sleep(200 * time.Millisecond)\n\t\t}\n\t\tassuranceEmit(\\\"truncation_after_snapshot\\\", map[string]interface{}{\n\t\t\t\\\"mode\\\":                mode,\n\t\t\t\\\"snapshot_error\\\":      assuranceErrString(serr),\n\t\t\t\\\"store_first_before\\\":  beforeFirst,\n\t\t\t\\\"store_first_after\\\":   afterFirst,\n\t\t\t\\\"cert_samples\\\":        certs,\n\t\t\t\\\"store_last_samples\\\":  stores,\n\t\t\t\\\"store_first_samples\\\": firsts,\n\t\t\t\\\"commit_samples\\\":      commits,\n\t\t\t\\\"diverging_probe\\\":     assuranceStoreProbe(diverging),\n\t\t\t\\\"leader_probe\\\":        assuranceStoreProbe(leaderForSnap),\n\t\t\t\\\"elapsed_ms\\\":          float64(time.Since(startSnap).Nanoseconds()) / 1e6,\n\t\t})\n\t\treturn\n\t}\n\n\tif mode == \\\"injected_store_error_then_restart\\\" {''',1)\nopen(p,'w').write(s)\nPY\ngofmt -w assurance_generated_test.go && cp assurance_generated_test.go tmp/verify/ && cd tmp/verify && export GOCACHE=\"'$PWD/../gocache GOFLAGS=-mod=mod GOPROXY=off && go vet . 2>&1 | head -5 && timeout 280 go test -count=1 -run '\"'TestAssuranceTruncationStoreFailure/injected_store_error_then_snapshot' -v ./ 2>&1 | grep -E \\\"after_snapshot|\"'^---|FAIL|ok |panic\" | head -4'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
