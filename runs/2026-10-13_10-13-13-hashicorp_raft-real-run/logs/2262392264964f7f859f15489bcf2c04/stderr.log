// assuranceSampleStates polls every node for a window and reports the observed
// state set per node. Sampling can miss intermediate transitions; the sampled
// values are reported as sampled.
func assuranceSampleStates(rafts []*Raft, window time.Duration) map[string][]string {
	seen := make(map[string][]string, len(rafts))
	record := func() {
		for _, r := range rafts {
			id := string(r.localID)
			st := r.State().String()
			list := seen[id]
			if len(list) == 0 || list[len(list)-1] != st {
				seen[id] = append(seen[id], list...)
			}
		}
	}
	record()
	limit := time.Now().Add(window)
	for time.Now().Before(limit) {
		time.Sleep(2 * time.Millisecond)
		record()
	}
	return seen
}
