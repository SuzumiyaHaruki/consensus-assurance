{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run && python3 -c \\\"\nimport json\nd=json.load(open('logs/b487504d6cf743fc8e70b4a75f79f0db/observations.json'))\nev=d['events']; print('total',len(ev))\nfor i,e in enumerate(ev):\n    if e.get('event') in ('growth_api_repair_attempt','growth_write_attempt','growth_recovery'):\n        print('idx',i,e.get('event'),e.get('mode'))\n        for k,v in e.items():\n            if k.startswith('_') or k in ('event','mode'): continue\n            if isinstance(v,list) and len(v)>4: print('   ',k,'uniq',sorted(set(map(str,v))))\n            else: print('   ',k,json.dumps(v))\n\\\"\"","aggregated_output":"total 41\nidx 28 growth_write_attempt absent_server\n    commit_now 3\n    write_error \"node is not the leader\"\nidx 29 growth_api_repair_attempt absent_server\n    add_nonvoter_error \"node is not the leader\"\n    final_commit 3\n    final_state \"Candidate\"\n    final_term 2\n    remove_server_error \"node is not the leader\"\n    unrepaired_commit_samples uniq ['3']\n    unrepaired_state_samples uniq ['Candidate']\n    unrepaired_term_samples uniq ['2']\n    unrepaired_window_ms 3000\nidx 30 growth_recovery absent_server\n    config_entry_idx 3\n    elapsed_ms 4595.943469\n    named_server_up true\n    original_commit 4\n    original_last 4\n    original_term 3\n    recovered true\n    states {\"named\": \"Follower\", \"original\": \"Leader\"}\nidx 33 growth_write_attempt control_present_server\n    commit_now 4\n    write_error null\nidx 34 growth_api_repair_attempt control_present_server\n    add_nonvoter_error null\n    final_commit 6\n    final_state \"Leader\"\n    final_term 2\n    remove_server_error null\n    unrepaired_commit_samples uniq ['6']\n    unrepaired_state_samples uniq ['Leader']\n    unrepaired_term_samples uniq ['2']\n    unrepaired_window_ms 3000\nidx 35 growth_recovery control_present_server\n    config_entry_idx 3\n    elapsed_ms 4563.399716\n    named_server_up true\n    original_commit 6\n    original_last 6\n    original_term 2\n    recovered true\n    states {\"named\": \"Follower\", \"original\": \"Leader\"}\n","exit_code":0,"status":"completed"}}
