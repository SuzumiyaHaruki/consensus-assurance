{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run && python3 -c \\\"\nimport json\nd=json.load(open('logs/f82d709e8f5f4f80ba19cc48ff29ff0a/observations.json'))\nev=d['events']; print('total',len(ev))\nfor i,e in enumerate(ev):\n    n=e.get('event')\n    if n=='peer_loss_after_wedge':\n        cs=e.get('commit_samples') or []\n        print('idx',i,n,e.get('mode'),'step',e.get('step'),'voters',e.get('voters'))\n        print('   removed',e.get('removed_voter'),'leader',e.get('leader'),e.get('leader_state'),'term',e.get('leader_term'),'commit_before',e.get('commit_before'),'commit_uniq',sorted(set(map(str,cs))),'done',e.get('apply_future_done'),'err',e.get('apply_future_error'))\n        print('   leader_probe',json.dumps(e.get('leader_probe')))\n        print('   wedged_probe',json.dumps(e.get('wedged_node_probe')))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
