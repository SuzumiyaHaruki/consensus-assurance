{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n saturation.go observer.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"math\"\n     8\t\t\"time\"\n     9\t\n    10\t\t\"github.com/hashicorp/go-metrics/compat\"\n    11\t)\n    12\t\n    13\t// saturationMetric measures the saturation (percentage of time spent working vs\n    14\t// waiting for work) of an event processing loop, such as runFSM. It reports the\n    15\t// saturation as a gauge metric (at most) once every reportInterval.\n    16\t//\n    17\t// Callers must instrument their loop with calls to sleeping and working, starting\n    18\t// with a call to sleeping.\n    19\t//\n    20\t// Note: the caller must be single-threaded and saturationMetric is not safe for\n    21\t// concurrent use by multiple goroutines.\n    22\ttype saturationMetric struct {\n    23\t\treportInterval time.Duration\n    24\t\n    25\t\t// slept contains time for which the event processing loop was sleeping rather\n    26\t\t// than working in the period since lastReport.\n    27\t\tslept time.Duration\n    28\t\n    29\t\t// lost contains time that is considered lost due to incorrect use of\n    30\t\t// saturationMetricBucket (e.g. calling sleeping() or working() multiple\n    31\t\t// times in succession) in the period since lastReport.\n    32\t\tlost time.Duration\n    33\t\n    34\t\tlastReport, sleepBegan, workBegan time.Time\n    35\t\n    36\t\t// These are overwritten in tests.\n    37\t\tnowFn    func() time.Time\n    38\t\treportFn func(float32)\n    39\t}\n    40\t\n    41\t// newSaturationMetric creates a saturationMetric that will update the gauge\n    42\t// with the given name at the given reportInterval. keepPrev determines the\n    43\t// number of previous measurements that will be used to smooth out spikes.\n    44\tfunc newSaturationMetric(name []string, reportInterval time.Duration) *saturationMetric {\n    45\t\tm := &saturationMetric{\n    46\t\t\treportInterval: reportInterval,\n    47\t\t\tnowFn:          time.Now,\n    48\t\t\tlastReport:     time.Now(),\n    49\t\t\treportFn:       func(sat float32) { metrics.AddSample(name, sat) },\n    50\t\t}\n    51\t\treturn m\n    52\t}\n    53\t\n    54\t// sleeping records the time at which the loop began waiting for work. After the\n    55\t// initial call it must always be proceeded by a call to working.\n    56\tfunc (s *saturationMetric) sleeping() {\n    57\t\tnow := s.nowFn()\n    58\t\n    59\t\tif !s.sleepBegan.IsZero() {\n    60\t\t\t// sleeping called twice in succession. Count that time as lost rather than\n    61\t\t\t// measuring nonsense.\n    62\t\t\ts.lost += now.Sub(s.sleepBegan)\n    63\t\t}\n    64\t\n    65\t\ts.sleepBegan = now\n    66\t\ts.workBegan = time.Time{}\n    67\t\ts.report()\n    68\t}\n    69\t\n    70\t// working records the time at which the loop began working. It must always be\n    71\t// proceeded by a call to sleeping.\n    72\tfunc (s *saturationMetric) working() {\n    73\t\tnow := s.nowFn()\n    74\t\n    75\t\tif s.workBegan.IsZero() {\n    76\t\t\tif s.sleepBegan.IsZero() {\n    77\t\t\t\t// working called before the initial call to sleeping. Count that time as\n    78\t\t\t\t// lost rather than measuring nonsense.\n    79\t\t\t\ts.lost += now.Sub(s.lastReport)\n    80\t\t\t} else {\n    81\t\t\t\ts.slept += now.Sub(s.sleepBegan)\n    82\t\t\t}\n    83\t\t} else {\n    84\t\t\t// working called twice in succession. Count that time as lost rather than\n    85\t\t\t// measuring nonsense.\n    86\t\t\ts.lost += now.Sub(s.workBegan)\n    87\t\t}\n    88\t\n    89\t\ts.workBegan = now\n    90\t\ts.sleepBegan = time.Time{}\n    91\t\ts.report()\n    92\t}\n    93\t\n    94\t// report updates the gauge if reportInterval has passed since our last report.\n    95\tfunc (s *saturationMetric) report() {\n    96\t\tnow := s.nowFn()\n    97\t\ttimeSinceLastReport := now.Sub(s.lastReport)\n    98\t\n    99\t\tif timeSinceLastReport < s.reportInterval {\n   100\t\t\treturn\n   101\t\t}\n   102\t\n   103\t\tvar saturation float64\n   104\t\ttotal := timeSinceLastReport - s.lost\n   105\t\tif total != 0 {\n   106\t\t\tsaturation = float64(total-s.slept) / float64(total)\n   107\t\t\tsaturation = math.Round(saturation*100) / 100\n   108\t\t}\n   109\t\ts.reportFn(float32(saturation))\n   110\t\n   111\t\ts.slept = 0\n   112\t\ts.lost = 0\n   113\t\ts.lastReport = now\n   114\t}\n   115\t// Copyright (c) HashiCorp, Inc.\n   116\t// SPDX-License-Identifier: MPL-2.0\n   117\t\n   118\tpackage raft\n   119\t\n   120\timport (\n   121\t\t\"sync/atomic\"\n   122\t\t\"time\"\n   123\t)\n   124\t\n   125\t// Observation is sent along the given channel to observers when an event occurs.\n   126\ttype Observation struct {\n   127\t\t// Raft holds the Raft instance generating the observation.\n   128\t\tRaft *Raft\n   129\t\t// Data holds observation-specific data. Possible types are\n   130\t\t// RequestVoteRequest\n   131\t\t// RaftState\n   132\t\t// PeerObservation\n   133\t\t// LeaderObservation\n   134\t\tData interface{}\n   135\t}\n   136\t\n   137\t// LeaderObservation is used for the data when leadership changes.\n   138\ttype LeaderObservation struct {\n   139\t\t// DEPRECATED The LeaderAddr field should now be used\n   140\t\tLeader     ServerAddress\n   141\t\tLeaderAddr ServerAddress\n   142\t\tLeaderID   ServerID\n   143\t}\n   144\t\n   145\t// PeerObservation is sent to observers when peers change.\n   146\ttype PeerObservation struct {\n   147\t\tRemoved bool\n   148\t\tPeer    Server\n   149\t}\n   150\t\n   151\t// FailedHeartbeatObservation is sent when a node fails to heartbeat with the leader\n   152\ttype FailedHeartbeatObservation struct {\n   153\t\tPeerID      ServerID\n   154\t\tLastContact time.Time\n   155\t}\n   156\t\n   157\t// ResumedHeartbeatObservation is sent when a node resumes to heartbeat with the leader following failures\n   158\ttype ResumedHeartbeatObservation struct {\n   159\t\tPeerID ServerID\n   160\t}\n   161\t\n   162\t// nextObserverId is used to provide a unique ID for each observer to aid in\n   163\t// deregistration.\n   164\tvar nextObserverID uint64\n   165\t\n   166\t// FilterFn is a function that can be registered in order to filter observations.\n   167\t// The function reports whether the observation should be included - if\n   168\t// it returns false, the observation will be filtered out.\n   169\ttype FilterFn func(o *Observation) bool\n   170\t\n   171\t// Observer describes what to do with a given observation.\n   172\ttype Observer struct {\n   173\t\t// numObserved and numDropped are performance counters for this observer.\n   174\t\t// 64 bit types must be 64 bit aligned to use with atomic operations on\n   175\t\t// 32 bit platforms, so keep them at the top of the struct.\n   176\t\tnumObserved uint64\n   177\t\tnumDropped  uint64\n   178\t\n   179\t\t// channel receives observations.\n   180\t\tchannel chan Observation\n   181\t\n   182\t\t// blocking, if true, will cause Raft to block when sending an observation\n   183\t\t// to this observer. This should generally be set to false.\n   184\t\tblocking bool\n   185\t\n   186\t\t// filter will be called to determine if an observation should be sent to\n   187\t\t// the channel.\n   188\t\tfilter FilterFn\n   189\t\n   190\t\t// id is the ID of this observer in the Raft map.\n   191\t\tid uint64\n   192\t}\n   193\t\n   194\t// NewObserver creates a new observer that can be registered\n   195\t// to make observations on a Raft instance. Observations\n   196\t// will be sent on the given channel if they satisfy the\n   197\t// given filter.\n   198\t//\n   199\t// If blocking is true, the observer will block when it can't\n   200\t// send on the channel, otherwise it may discard events.\n   201\tfunc NewObserver(channel chan Observation, blocking bool, filter FilterFn) *Observer {\n   202\t\treturn &Observer{\n   203\t\t\tchannel:  channel,\n   204\t\t\tblocking: blocking,\n   205\t\t\tfilter:   filter,\n   206\t\t\tid:       atomic.AddUint64(&nextObserverID, 1),\n   207\t\t}\n   208\t}\n   209\t\n   210\t// GetNumObserved returns the number of observations.\n   211\tfunc (or *Observer) GetNumObserved() uint64 {\n   212\t\treturn atomic.LoadUint64(&or.numObserved)\n   213\t}\n   214\t\n   215\t// GetNumDropped returns the number of dropped observations due to blocking.\n   216\tfunc (or *Observer) GetNumDropped() uint64 {\n   217\t\treturn atomic.LoadUint64(&or.numDropped)\n   218\t}\n   219\t\n   220\t// RegisterObserver registers a new observer.\n   221\tfunc (r *Raft) RegisterObserver(or *Observer) {\n   222\t\tr.observersLock.Lock()\n   223\t\tdefer r.observersLock.Unlock()\n   224\t\tr.observers[or.id] = or\n   225\t}\n   226\t\n   227\t// DeregisterObserver deregisters an observer.\n   228\tfunc (r *Raft) DeregisterObserver(or *Observer) {\n   229\t\tr.observersLock.Lock()\n   230\t\tdefer r.observersLock.Unlock()\n   231\t\tdelete(r.observers, or.id)\n   232\t}\n   233\t\n   234\t// observe sends an observation to every observer.\n   235\tfunc (r *Raft) observe(o interface{}) {\n   236\t\t// In general observers should not block. But in any case this isn't\n   237\t\t// disastrous as we only hold a read lock, which merely prevents\n   238\t\t// registration / deregistration of observers.\n   239\t\tr.observersLock.RLock()\n   240\t\tdefer r.observersLock.RUnlock()\n   241\t\tfor _, or := range r.observers {\n   242\t\t\t// It's wasteful to do this in the loop, but for the common case\n   243\t\t\t// where there are no observers we won't create any objects.\n   244\t\t\tob := Observation{Raft: r, Data: o}\n   245\t\t\tif or.filter != nil && !or.filter(&ob) {\n   246\t\t\t\tcontinue\n   247\t\t\t}\n   248\t\t\tif or.channel == nil {\n   249\t\t\t\tcontinue\n   250\t\t\t}\n   251\t\t\tif or.blocking {\n   252\t\t\t\tor.channel <- ob\n   253\t\t\t\tatomic.AddUint64(&or.numObserved, 1)\n   254\t\t\t} else {\n   255\t\t\t\tselect {\n   256\t\t\t\tcase or.channel <- ob:\n   257\t\t\t\t\tatomic.AddUint64(&or.numObserved, 1)\n   258\t\t\t\tdefault:\n   259\t\t\t\t\tatomic.AddUint64(&or.numDropped, 1)\n   260\t\t\t\t}\n   261\t\t\t}\n   262\t\t}\n   263\t}\n","exit_code":0,"status":"completed"}}
