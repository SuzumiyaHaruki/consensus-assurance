{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n progress.go stable.go discard_snapshot.go inmem_snapshot.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"context\"\n     8\t\t\"io\"\n     9\t\t\"sync\"\n    10\t\t\"time\"\n    11\t\n    12\t\thclog \"github.com/hashicorp/go-hclog\"\n    13\t)\n    14\t\n    15\tconst (\n    16\t\tsnapshotRestoreMonitorInterval = 10 * time.Second\n    17\t)\n    18\t\n    19\ttype snapshotRestoreMonitor struct {\n    20\t\tlogger          hclog.Logger\n    21\t\tcr              CountingReader\n    22\t\tsize            int64\n    23\t\tnetworkTransfer bool\n    24\t\n    25\t\tonce   sync.Once\n    26\t\tcancel func()\n    27\t\tdoneCh chan struct{}\n    28\t}\n    29\t\n    30\tfunc startSnapshotRestoreMonitor(\n    31\t\tlogger hclog.Logger,\n    32\t\tcr CountingReader,\n    33\t\tsize int64,\n    34\t\tnetworkTransfer bool,\n    35\t) *snapshotRestoreMonitor {\n    36\t\tctx, cancel := context.WithCancel(context.Background())\n    37\t\n    38\t\tm := &snapshotRestoreMonitor{\n    39\t\t\tlogger:          logger,\n    40\t\t\tcr:              cr,\n    41\t\t\tsize:            size,\n    42\t\t\tnetworkTransfer: networkTransfer,\n    43\t\t\tcancel:          cancel,\n    44\t\t\tdoneCh:          make(chan struct{}),\n    45\t\t}\n    46\t\tgo m.run(ctx)\n    47\t\treturn m\n    48\t}\n    49\t\n    50\tfunc (m *snapshotRestoreMonitor) run(ctx context.Context) {\n    51\t\tdefer close(m.doneCh)\n    52\t\n    53\t\tticker := time.NewTicker(snapshotRestoreMonitorInterval)\n    54\t\tdefer ticker.Stop()\n    55\t\n    56\t\tranOnce := false\n    57\t\tfor {\n    58\t\t\tselect {\n    59\t\t\tcase <-ctx.Done():\n    60\t\t\t\tif !ranOnce {\n    61\t\t\t\t\tm.runOnce()\n    62\t\t\t\t}\n    63\t\t\t\treturn\n    64\t\t\tcase <-ticker.C:\n    65\t\t\t\tm.runOnce()\n    66\t\t\t\tranOnce = true\n    67\t\t\t}\n    68\t\t}\n    69\t}\n    70\t\n    71\tfunc (m *snapshotRestoreMonitor) runOnce() {\n    72\t\treadBytes := m.cr.Count()\n    73\t\tpct := float64(100*readBytes) / float64(m.size)\n    74\t\n    75\t\tmessage := \"snapshot restore progress\"\n    76\t\tif m.networkTransfer {\n    77\t\t\tmessage = \"snapshot network transfer progress\"\n    78\t\t}\n    79\t\n    80\t\tm.logger.Info(message,\n    81\t\t\t\"read-bytes\", readBytes,\n    82\t\t\t\"percent-complete\", hclog.Fmt(\"%0.2f%%\", pct),\n    83\t\t)\n    84\t}\n    85\t\n    86\tfunc (m *snapshotRestoreMonitor) StopAndWait() {\n    87\t\tm.once.Do(func() {\n    88\t\t\tm.cancel()\n    89\t\t\t<-m.doneCh\n    90\t\t})\n    91\t}\n    92\t\n    93\ttype CountingReader interface {\n    94\t\tio.Reader\n    95\t\tCount() int64\n    96\t}\n    97\t\n    98\ttype countingReader struct {\n    99\t\treader io.Reader\n   100\t\n   101\t\tmu    sync.Mutex\n   102\t\tbytes int64\n   103\t}\n   104\t\n   105\tfunc (r *countingReader) Read(p []byte) (n int, err error) {\n   106\t\tn, err = r.reader.Read(p)\n   107\t\tr.mu.Lock()\n   108\t\tr.bytes += int64(n)\n   109\t\tr.mu.Unlock()\n   110\t\treturn n, err\n   111\t}\n   112\t\n   113\tfunc (r *countingReader) Count() int64 {\n   114\t\tr.mu.Lock()\n   115\t\tdefer r.mu.Unlock()\n   116\t\treturn r.bytes\n   117\t}\n   118\t\n   119\tfunc newCountingReader(r io.Reader) *countingReader {\n   120\t\treturn &countingReader{reader: r}\n   121\t}\n   122\t\n   123\ttype countingReadCloser struct {\n   124\t\t*countingReader\n   125\t\treadCloser io.ReadCloser\n   126\t}\n   127\t\n   128\tfunc newCountingReadCloser(rc io.ReadCloser) *countingReadCloser {\n   129\t\treturn &countingReadCloser{\n   130\t\t\tcountingReader: newCountingReader(rc),\n   131\t\t\treadCloser:     rc,\n   132\t\t}\n   133\t}\n   134\t\n   135\tfunc (c countingReadCloser) Close() error {\n   136\t\treturn c.readCloser.Close()\n   137\t}\n   138\t\n   139\tfunc (c countingReadCloser) WrappedReadCloser() io.ReadCloser {\n   140\t\treturn c.readCloser\n   141\t}\n   142\t\n   143\t// ReadCloserWrapper allows access to an underlying ReadCloser from a wrapper.\n   144\ttype ReadCloserWrapper interface {\n   145\t\tio.ReadCloser\n   146\t\tWrappedReadCloser() io.ReadCloser\n   147\t}\n   148\t\n   149\tvar _ ReadCloserWrapper = &countingReadCloser{}\n   150\t// Copyright (c) HashiCorp, Inc.\n   151\t// SPDX-License-Identifier: MPL-2.0\n   152\t\n   153\tpackage raft\n   154\t\n   155\t// StableStore is used to provide stable storage\n   156\t// of key configurations to ensure safety.\n   157\ttype StableStore interface {\n   158\t\tSet(key []byte, val []byte) error\n   159\t\n   160\t\t// Get returns the value for key, or an empty byte slice if key was not found.\n   161\t\tGet(key []byte) ([]byte, error)\n   162\t\n   163\t\tSetUint64(key []byte, val uint64) error\n   164\t\n   165\t\t// GetUint64 returns the uint64 value for key, or 0 if key was not found.\n   166\t\tGetUint64(key []byte) (uint64, error)\n   167\t}\n   168\t// Copyright (c) HashiCorp, Inc.\n   169\t// SPDX-License-Identifier: MPL-2.0\n   170\t\n   171\tpackage raft\n   172\t\n   173\timport (\n   174\t\t\"fmt\"\n   175\t\t\"io\"\n   176\t)\n   177\t\n   178\t// DiscardSnapshotStore is used to successfully snapshot while\n   179\t// always discarding the snapshot. This is useful for when the\n   180\t// log should be truncated but no snapshot should be retained.\n   181\t// This should never be used for production use, and is only\n   182\t// suitable for testing.\n   183\ttype DiscardSnapshotStore struct{}\n   184\t\n   185\t// DiscardSnapshotSink is used to fulfill the SnapshotSink interface\n   186\t// while always discarding the . This is useful for when the log\n   187\t// should be truncated but no snapshot should be retained. This\n   188\t// should never be used for production use, and is only suitable\n   189\t// for testing.\n   190\ttype DiscardSnapshotSink struct{}\n   191\t\n   192\t// NewDiscardSnapshotStore is used to create a new DiscardSnapshotStore.\n   193\tfunc NewDiscardSnapshotStore() *DiscardSnapshotStore {\n   194\t\treturn &DiscardSnapshotStore{}\n   195\t}\n   196\t\n   197\t// Create returns a valid type implementing the SnapshotSink which\n   198\t// always discards the snapshot.\n   199\tfunc (d *DiscardSnapshotStore) Create(version SnapshotVersion, index, term uint64,\n   200\t\tconfiguration Configuration, configurationIndex uint64, trans Transport) (SnapshotSink, error) {\n   201\t\treturn &DiscardSnapshotSink{}, nil\n   202\t}\n   203\t\n   204\t// List returns successfully with a nil for []*SnapshotMeta.\n   205\tfunc (d *DiscardSnapshotStore) List() ([]*SnapshotMeta, error) {\n   206\t\treturn nil, nil\n   207\t}\n   208\t\n   209\t// Open returns an error since the DiscardSnapshotStore does not\n   210\t// support opening snapshots.\n   211\tfunc (d *DiscardSnapshotStore) Open(id string) (*SnapshotMeta, io.ReadCloser, error) {\n   212\t\treturn nil, nil, fmt.Errorf(\"open is not supported\")\n   213\t}\n   214\t\n   215\t// Write returns successfully with the length of the input byte slice\n   216\t// to satisfy the WriteCloser interface\n   217\tfunc (d *DiscardSnapshotSink) Write(b []byte) (int, error) {\n   218\t\treturn len(b), nil\n   219\t}\n   220\t\n   221\t// Close returns a nil error\n   222\tfunc (d *DiscardSnapshotSink) Close() error {\n   223\t\treturn nil\n   224\t}\n   225\t\n   226\t// ID returns \"discard\" for DiscardSnapshotSink\n   227\tfunc (d *DiscardSnapshotSink) ID() string {\n   228\t\treturn \"discard\"\n   229\t}\n   230\t\n   231\t// Cancel returns successfully with a nil error\n   232\tfunc (d *DiscardSnapshotSink) Cancel() error {\n   233\t\treturn nil\n   234\t}\n   235\t// Copyright (c) HashiCorp, Inc.\n   236\t// SPDX-License-Identifier: MPL-2.0\n   237\t\n   238\tpackage raft\n   239\t\n   240\timport (\n   241\t\t\"bytes\"\n   242\t\t\"fmt\"\n   243\t\t\"io\"\n   244\t\t\"sync\"\n   245\t)\n   246\t\n   247\t// InmemSnapshotStore implements the SnapshotStore interface and\n   248\t// retains only the most recent snapshot\n   249\ttype InmemSnapshotStore struct {\n   250\t\tlatest      *InmemSnapshotSink\n   251\t\thasSnapshot bool\n   252\t\tsync.RWMutex\n   253\t}\n   254\t\n   255\t// InmemSnapshotSink implements SnapshotSink in memory\n   256\ttype InmemSnapshotSink struct {\n   257\t\tmeta     SnapshotMeta\n   258\t\tcontents *bytes.Buffer\n   259\t}\n   260\t\n   261\t// NewInmemSnapshotStore creates a blank new InmemSnapshotStore\n   262\tfunc NewInmemSnapshotStore() *InmemSnapshotStore {\n   263\t\treturn &InmemSnapshotStore{\n   264\t\t\tlatest: &InmemSnapshotSink{\n   265\t\t\t\tcontents: &bytes.Buffer{},\n   266\t\t\t},\n   267\t\t}\n   268\t}\n   269\t\n   270\t// Create replaces the stored snapshot with a new one using the given args\n   271\tfunc (m *InmemSnapshotStore) Create(version SnapshotVersion, index, term uint64,\n   272\t\tconfiguration Configuration, configurationIndex uint64, trans Transport) (SnapshotSink, error) {\n   273\t\t// We only support version 1 snapshots at this time.\n   274\t\tif version != 1 {\n   275\t\t\treturn nil, fmt.Errorf(\"unsupported snapshot version %d\", version)\n   276\t\t}\n   277\t\n   278\t\tname := snapshotName(term, index)\n   279\t\n   280\t\tm.Lock()\n   281\t\tdefer m.Unlock()\n   282\t\n   283\t\tsink := &InmemSnapshotSink{\n   284\t\t\tmeta: SnapshotMeta{\n   285\t\t\t\tVersion:            version,\n   286\t\t\t\tID:                 name,\n   287\t\t\t\tIndex:              index,\n   288\t\t\t\tTerm:               term,\n   289\t\t\t\tPeers:              encodePeers(configuration, trans),\n   290\t\t\t\tConfiguration:      configuration,\n   291\t\t\t\tConfigurationIndex: configurationIndex,\n   292\t\t\t},\n   293\t\t\tcontents: &bytes.Buffer{},\n   294\t\t}\n   295\t\tm.hasSnapshot = true\n   296\t\tm.latest = sink\n   297\t\n   298\t\treturn sink, nil\n   299\t}\n   300\t\n   301\t// List returns the latest snapshot taken\n   302\tfunc (m *InmemSnapshotStore) List() ([]*SnapshotMeta, error) {\n   303\t\tm.RLock()\n   304\t\tdefer m.RUnlock()\n   305\t\n   306\t\tif !m.hasSnapshot {\n   307\t\t\treturn []*SnapshotMeta{}, nil\n   308\t\t}\n   309\t\treturn []*SnapshotMeta{&m.latest.meta}, nil\n   310\t}\n   311\t\n   312\t// Open wraps an io.ReadCloser around the snapshot contents\n   313\tfunc (m *InmemSnapshotStore) Open(id string) (*SnapshotMeta, io.ReadCloser, error) {\n   314\t\tm.RLock()\n   315\t\tdefer m.RUnlock()\n   316\t\n   317\t\tif m.latest.meta.ID != id {\n   318\t\t\treturn nil, nil, fmt.Errorf(\"[ERR] snapshot: failed to open snapshot id: %s\", id)\n   319\t\t}\n   320\t\n   321\t\t// Make a copy of the contents, since a bytes.Buffer can only be read\n   322\t\t// once.\n   323\t\tcontents := bytes.NewBuffer(m.latest.contents.Bytes())\n   324\t\treturn &m.latest.meta, io.NopCloser(contents), nil\n   325\t}\n   326\t\n   327\t// Write appends the given bytes to the snapshot contents\n   328\tfunc (s *InmemSnapshotSink) Write(p []byte) (n int, err error) {\n   329\t\twritten, err := s.contents.Write(p)\n   330\t\ts.meta.Size += int64(written)\n   331\t\treturn written, err\n   332\t}\n   333\t\n   334\t// Close updates the Size and is otherwise a no-op\n   335\tfunc (s *InmemSnapshotSink) Close() error {\n   336\t\treturn nil\n   337\t}\n   338\t\n   339\t// ID returns the ID of the SnapshotMeta\n   340\tfunc (s *InmemSnapshotSink) ID() string {\n   341\t\treturn s.meta.ID\n   342\t}\n   343\t\n   344\t// Cancel returns successfully with a nil error\n   345\tfunc (s *InmemSnapshotSink) Cancel() error {\n   346\t\treturn nil\n   347\t}\n","exit_code":0,"status":"completed"}}
