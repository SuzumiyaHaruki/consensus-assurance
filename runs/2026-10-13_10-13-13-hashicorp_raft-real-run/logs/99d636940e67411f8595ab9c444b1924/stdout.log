{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n replication.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"errors\"\n     8\t\t\"fmt\"\n     9\t\t\"sync\"\n    10\t\t\"sync/atomic\"\n    11\t\t\"time\"\n    12\t\n    13\t\t\"github.com/hashicorp/go-metrics/compat\"\n    14\t)\n    15\t\n    16\tconst (\n    17\t\tmaxFailureScale = 12\n    18\t\tfailureWait     = 10 * time.Millisecond\n    19\t)\n    20\t\n    21\tvar (\n    22\t\t// ErrLogNotFound indicates a given log entry is not available.\n    23\t\tErrLogNotFound = errors.New(\"log not found\")\n    24\t\n    25\t\t// ErrPipelineReplicationNotSupported can be returned by the transport to\n    26\t\t// signal that pipeline replication is not supported in general, and that\n    27\t\t// no error message should be produced.\n    28\t\tErrPipelineReplicationNotSupported = errors.New(\"pipeline replication not supported\")\n    29\t)\n    30\t\n    31\t// followerReplication is in charge of sending snapshots and log entries from\n    32\t// this leader during this particular term to a remote follower.\n    33\ttype followerReplication struct {\n    34\t\t// currentTerm and nextIndex must be kept at the top of the struct so\n    35\t\t// they're 64 bit aligned which is a requirement for atomic ops on 32 bit\n    36\t\t// platforms.\n    37\t\n    38\t\t// currentTerm is the term of this leader, to be included in AppendEntries\n    39\t\t// requests.\n    40\t\tcurrentTerm uint64\n    41\t\n    42\t\t// nextIndex is the index of the next log entry to send to the follower,\n    43\t\t// which may fall past the end of the log.\n    44\t\tnextIndex uint64\n    45\t\n    46\t\t// peer contains the network address and ID of the remote follower.\n    47\t\tpeer Server\n    48\t\t// peerLock protects 'peer'\n    49\t\tpeerLock sync.RWMutex\n    50\t\n    51\t\t// commitment tracks the entries acknowledged by followers so that the\n    52\t\t// leader's commit index can advance. It is updated on successful\n    53\t\t// AppendEntries responses.\n    54\t\tcommitment *commitment\n    55\t\n    56\t\t// stopCh is notified/closed when this leader steps down or the follower is\n    57\t\t// removed from the cluster. In the follower removed case, it carries a log\n    58\t\t// index; replication should be attempted with a best effort up through that\n    59\t\t// index, before exiting.\n    60\t\tstopCh chan uint64\n    61\t\n    62\t\t// triggerCh is notified every time new entries are appended to the log.\n    63\t\ttriggerCh chan struct{}\n    64\t\n    65\t\t// triggerDeferErrorCh is used to provide a backchannel. By sending a\n    66\t\t// deferErr, the sender can be notified when the replication is done.\n    67\t\ttriggerDeferErrorCh chan *deferError\n    68\t\n    69\t\t// lastContact is updated to the current time whenever any response is\n    70\t\t// received from the follower (successful or not). This is used to check\n    71\t\t// whether the leader should step down (Raft.checkLeaderLease()).\n    72\t\tlastContact time.Time\n    73\t\t// lastContactLock protects 'lastContact'.\n    74\t\tlastContactLock sync.RWMutex\n    75\t\n    76\t\t// failures counts the number of failed RPCs since the last success, which is\n    77\t\t// used to apply backoff.\n    78\t\tfailures uint64\n    79\t\n    80\t\t// notifyCh is notified to send out a heartbeat, which is used to check that\n    81\t\t// this server is still leader.\n    82\t\tnotifyCh chan struct{}\n    83\t\t// notify is a map of futures to be resolved upon receipt of an\n    84\t\t// acknowledgement, then cleared from this map.\n    85\t\tnotify map[*verifyFuture]struct{}\n    86\t\t// notifyLock protects 'notify'.\n    87\t\tnotifyLock sync.Mutex\n    88\t\n    89\t\t// stepDown is used to indicate to the leader that we\n    90\t\t// should step down based on information from a follower.\n    91\t\tstepDown chan struct{}\n    92\t\n    93\t\t// allowPipeline is used to determine when to pipeline the AppendEntries RPCs.\n    94\t\t// It is private to this replication goroutine.\n    95\t\tallowPipeline bool\n    96\t}\n    97\t\n    98\t// notifyAll is used to notify all the waiting verify futures\n    99\t// if the follower believes we are still the leader.\n   100\tfunc (s *followerReplication) notifyAll(leader bool) {\n   101\t\t// Clear the waiting notifies minimizing lock time\n   102\t\ts.notifyLock.Lock()\n   103\t\tn := s.notify\n   104\t\ts.notify = make(map[*verifyFuture]struct{})\n   105\t\ts.notifyLock.Unlock()\n   106\t\n   107\t\t// Submit our votes\n   108\t\tfor v := range n {\n   109\t\t\tv.vote(leader)\n   110\t\t}\n   111\t}\n   112\t\n   113\t// cleanNotify is used to delete notify, .\n   114\tfunc (s *followerReplication) cleanNotify(v *verifyFuture) {\n   115\t\ts.notifyLock.Lock()\n   116\t\tdelete(s.notify, v)\n   117\t\ts.notifyLock.Unlock()\n   118\t}\n   119\t\n   120\t// LastContact returns the time of last contact.\n   121\tfunc (s *followerReplication) LastContact() time.Time {\n   122\t\ts.lastContactLock.RLock()\n   123\t\tlast := s.lastContact\n   124\t\ts.lastContactLock.RUnlock()\n   125\t\treturn last\n   126\t}\n   127\t\n   128\t// setLastContact sets the last contact to the current time.\n   129\tfunc (s *followerReplication) setLastContact() {\n   130\t\ts.lastContactLock.Lock()\n   131\t\ts.lastContact = time.Now()\n   132\t\ts.lastContactLock.Unlock()\n   133\t}\n   134\t\n   135\t// replicate is a long running routine that replicates log entries to a single\n   136\t// follower.\n   137\tfunc (r *Raft) replicate(s *followerReplication) {\n   138\t\t// Start an async heartbeating routing\n   139\t\tstopHeartbeat := make(chan struct{})\n   140\t\tdefer close(stopHeartbeat)\n   141\t\tr.goFunc(func() { r.heartbeat(s, stopHeartbeat) })\n   142\t\n   143\tRPC:\n   144\t\tshouldStop := false\n   145\t\tfor !shouldStop {\n   146\t\t\tselect {\n   147\t\t\tcase maxIndex := <-s.stopCh:\n   148\t\t\t\t// Make a best effort to replicate up to this index\n   149\t\t\t\tif maxIndex > 0 {\n   150\t\t\t\t\tr.replicateTo(s, maxIndex)\n   151\t\t\t\t}\n   152\t\t\t\treturn\n   153\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   154\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   155\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   156\t\t\t\tif !shouldStop {\n   157\t\t\t\t\tdeferErr.respond(nil)\n   158\t\t\t\t} else {\n   159\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   160\t\t\t\t}\n   161\t\t\tcase <-s.triggerCh:\n   162\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   163\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   164\t\t\t// This is _not_ our heartbeat mechanism but is to ensure\n   165\t\t\t// followers quickly learn the leader's commit index when\n   166\t\t\t// raft commits stop flowing naturally. The actual heartbeats\n   167\t\t\t// can't do this to keep them unblocked by disk IO on the\n   168\t\t\t// follower. See https://github.com/hashicorp/raft/issues/282.\n   169\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   170\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   171\t\t\t\tshouldStop = r.replicateTo(s, lastLogIdx)\n   172\t\t\t}\n   173\t\n   174\t\t\t// If things looks healthy, switch to pipeline mode\n   175\t\t\tif !shouldStop && s.allowPipeline {\n   176\t\t\t\tgoto PIPELINE\n   177\t\t\t}\n   178\t\t}\n   179\t\treturn\n   180\t\n   181\tPIPELINE:\n   182\t\t// Disable until re-enabled\n   183\t\ts.allowPipeline = false\n   184\t\n   185\t\t// Replicates using a pipeline for high performance. This method\n   186\t\t// is not able to gracefully recover from errors, and so we fall back\n   187\t\t// to standard mode on failure.\n   188\t\tif err := r.pipelineReplicate(s); err != nil {\n   189\t\t\tif err != ErrPipelineReplicationNotSupported {\n   190\t\t\t\ts.peerLock.RLock()\n   191\t\t\t\tpeer := s.peer\n   192\t\t\t\ts.peerLock.RUnlock()\n   193\t\t\t\tr.logger.Error(\"failed to start pipeline replication to\", \"peer\", peer, \"error\", err)\n   194\t\t\t}\n   195\t\t}\n   196\t\tgoto RPC\n   197\t}\n   198\t\n   199\t// replicateTo is a helper to replicate(), used to replicate the logs up to a\n   200\t// given last index.\n   201\t// If the follower log is behind, we take care to bring them up to date.\n   202\tfunc (r *Raft) replicateTo(s *followerReplication, lastIndex uint64) (shouldStop bool) {\n   203\t\t// Create the base request\n   204\t\tvar req AppendEntriesRequest\n   205\t\tvar resp AppendEntriesResponse\n   206\t\tvar start time.Time\n   207\t\tvar peer Server\n   208\t\n   209\tSTART:\n   210\t\t// Prevent an excessive retry rate on errors\n   211\t\tif s.failures > 0 {\n   212\t\t\tselect {\n   213\t\t\tcase <-time.After(backoff(failureWait, s.failures, maxFailureScale)):\n   214\t\t\tcase <-r.shutdownCh:\n   215\t\t\t}\n   216\t\t}\n   217\t\n   218\t\ts.peerLock.RLock()\n   219\t\tpeer = s.peer\n   220\t\ts.peerLock.RUnlock()\n   221\t\n   222\t\t// Setup the request\n   223\t\tif err := r.setupAppendEntries(s, &req, atomic.LoadUint64(&s.nextIndex), lastIndex); err == ErrLogNotFound {\n   224\t\t\tgoto SEND_SNAP\n   225\t\t} else if err != nil {\n   226\t\t\treturn\n   227\t\t}\n   228\t\n   229\t\t// Make the RPC call\n   230\t\tstart = time.Now()\n   231\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   232\t\t\tr.logger.Error(\"failed to appendEntries to\", \"peer\", peer, \"error\", err)\n   233\t\t\ts.failures++\n   234\t\t\treturn\n   235\t\t}\n   236\t\tappendStats(string(peer.ID), start, float32(len(req.Entries)), r.noLegacyTelemetry)\n   237\t\n   238\t\t// Check for a newer term, stop running\n   239\t\tif resp.Term > req.Term {\n   240\t\t\tr.handleStaleTerm(s)\n   241\t\t\treturn true\n   242\t\t}\n   243\t\n   244\t\t// Update the last contact\n   245\t\ts.setLastContact()\n   246\t\n   247\t\t// Update s based on success\n   248\t\tif resp.Success {\n   249\t\t\t// Update our replication state\n   250\t\t\tupdateLastAppended(s, &req)\n   251\t\n   252\t\t\t// Clear any failures, allow pipelining\n   253\t\t\ts.failures = 0\n   254\t\t\ts.allowPipeline = true\n   255\t\t} else {\n   256\t\t\tatomic.StoreUint64(&s.nextIndex, max(min(s.nextIndex-1, resp.LastLog+1), 1))\n   257\t\t\tif resp.NoRetryBackoff {\n   258\t\t\t\ts.failures = 0\n   259\t\t\t} else {\n   260\t\t\t\ts.failures++\n   261\t\t\t}\n   262\t\t\tr.logger.Warn(\"appendEntries rejected, sending older logs\", \"peer\", peer, \"next\", atomic.LoadUint64(&s.nextIndex))\n   263\t\t}\n   264\t\n   265\tCHECK_MORE:\n   266\t\t// Poll the stop channel here in case we are looping and have been asked\n   267\t\t// to stop, or have stepped down as leader. Even for the best effort case\n   268\t\t// where we are asked to replicate to a given index and then shutdown,\n   269\t\t// it's better to not loop in here to send lots of entries to a straggler\n   270\t\t// that's leaving the cluster anyways.\n   271\t\tselect {\n   272\t\tcase <-s.stopCh:\n   273\t\t\treturn true\n   274\t\tdefault:\n   275\t\t}\n   276\t\n   277\t\t// Check if there are more logs to replicate\n   278\t\tif atomic.LoadUint64(&s.nextIndex) <= lastIndex {\n   279\t\t\tgoto START\n   280\t\t}\n   281\t\treturn\n   282\t\n   283\t\t// SEND_SNAP is used when we fail to get a log, usually because the follower\n   284\t\t// is too far behind, and we must ship a snapshot down instead\n   285\tSEND_SNAP:\n   286\t\tif stop, err := r.sendLatestSnapshot(s); stop {\n   287\t\t\treturn true\n   288\t\t} else if err != nil {\n   289\t\t\tr.logger.Error(\"failed to send snapshot to\", \"peer\", peer, \"error\", err)\n   290\t\t\treturn\n   291\t\t}\n   292\t\n   293\t\t// Check if there is more to replicate\n   294\t\tgoto CHECK_MORE\n   295\t}\n   296\t\n   297\t// sendLatestSnapshot is used to send the latest snapshot we have\n   298\t// down to our follower.\n   299\tfunc (r *Raft) sendLatestSnapshot(s *followerReplication) (bool, error) {\n   300\t\t// Get the snapshots\n   301\t\tsnapshots, err := r.snapshots.List()\n   302\t\tif err != nil {\n   303\t\t\tr.logger.Error(\"failed to list snapshots\", \"error\", err)\n   304\t\t\treturn false, err\n   305\t\t}\n   306\t\n   307\t\t// Check we have at least a single snapshot\n   308\t\tif len(snapshots) == 0 {\n   309\t\t\treturn false, fmt.Errorf(\"no snapshots found\")\n   310\t\t}\n   311\t\n   312\t\t// Open the most recent snapshot\n   313\t\tsnapID := snapshots[0].ID\n   314\t\tr.logger.Info(\"opening snapshot\", \"id\", snapID)\n   315\t\tmeta, snapshot, err := r.snapshots.Open(snapID)\n   316\t\tif err != nil {\n   317\t\t\tr.logger.Error(\"failed to open snapshot\", \"id\", snapID, \"error\", err)\n   318\t\t\treturn false, err\n   319\t\t}\n   320\t\tdefer snapshot.Close()\n   321\t\n   322\t\t// Setup the request\n   323\t\treq := InstallSnapshotRequest{\n   324\t\t\tRPCHeader:       r.getRPCHeader(),\n   325\t\t\tSnapshotVersion: meta.Version,\n   326\t\t\tTerm:            s.currentTerm,\n   327\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   328\t\t\tLeader:             r.trans.EncodePeer(r.localID, r.localAddr),\n   329\t\t\tLastLogIndex:       meta.Index,\n   330\t\t\tLastLogTerm:        meta.Term,\n   331\t\t\tPeers:              meta.Peers,\n   332\t\t\tSize:               meta.Size,\n   333\t\t\tConfiguration:      EncodeConfiguration(meta.Configuration),\n   334\t\t\tConfigurationIndex: meta.ConfigurationIndex,\n   335\t\t}\n   336\t\n   337\t\ts.peerLock.RLock()\n   338\t\tpeer := s.peer\n   339\t\ts.peerLock.RUnlock()\n   340\t\n   341\t\tr.logger.Info(\"installing snapshot on\", \"peer\", peer.ID, \"id\", snapID, \"size\", req.Size)\n   342\t\t// Make the call\n   343\t\tstart := time.Now()\n   344\t\tvar resp InstallSnapshotResponse\n   345\t\tif err := r.trans.InstallSnapshot(peer.ID, peer.Address, &req, &resp, snapshot); err != nil {\n   346\t\t\tr.logger.Error(\"failed to install snapshot\", \"peer\", peer.ID, \"id\", snapID, \"error\", err)\n   347\t\t\ts.failures++\n   348\t\t\treturn false, err\n   349\t\t}\n   350\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   351\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"installSnapshot\"}, start, labels)\n   352\t\n   353\t\tif !r.noLegacyTelemetry {\n   354\t\t\t// Duplicated information. Kept for backward compatibility.\n   355\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"installSnapshot\", string(peer.ID)}, start)\n   356\t\t}\n   357\t\n   358\t\t// Check for a newer term, stop running\n   359\t\tif resp.Term > req.Term {\n   360\t\t\tr.handleStaleTerm(s)\n   361\t\t\treturn true, nil\n   362\t\t}\n   363\t\n   364\t\t// Update the last contact\n   365\t\ts.setLastContact()\n   366\t\n   367\t\t// Check for success\n   368\t\tif resp.Success {\n   369\t\t\t// Update the indexes\n   370\t\t\tatomic.StoreUint64(&s.nextIndex, meta.Index+1)\n   371\t\t\ts.commitment.match(peer.ID, meta.Index)\n   372\t\n   373\t\t\t// Clear any failures\n   374\t\t\ts.failures = 0\n   375\t\n   376\t\t\t// Notify we are still leader\n   377\t\t\ts.notifyAll(true)\n   378\t\t} else {\n   379\t\t\ts.failures++\n   380\t\t\tr.logger.Warn(\"installSnapshot rejected to\", \"peer\", peer.ID, \"id\", snapID)\n   381\t\t}\n   382\t\treturn false, nil\n   383\t}\n   384\t\n   385\t// heartbeat is used to periodically invoke AppendEntries on a peer\n   386\t// to ensure they don't time out. This is done async of replicate(),\n   387\t// since that routine could potentially be blocked on disk IO.\n   388\tfunc (r *Raft) heartbeat(s *followerReplication, stopCh chan struct{}) {\n   389\t\tvar failures uint64\n   390\t\treq := AppendEntriesRequest{\n   391\t\t\tRPCHeader: r.getRPCHeader(),\n   392\t\t\tTerm:      s.currentTerm,\n   393\t\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   394\t\t\tLeader: r.trans.EncodePeer(r.localID, r.localAddr),\n   395\t\t}\n   396\t\n   397\t\tvar resp AppendEntriesResponse\n   398\t\tfor {\n   399\t\t\t// Wait for the next heartbeat interval or forced notify\n   400\t\t\tselect {\n   401\t\t\tcase <-s.notifyCh:\n   402\t\t\tcase <-randomTimeout(r.config().HeartbeatTimeout / 10):\n   403\t\t\tcase <-stopCh:\n   404\t\t\t\treturn\n   405\t\t\t}\n   406\t\n   407\t\t\ts.peerLock.RLock()\n   408\t\t\tpeer := s.peer\n   409\t\t\ts.peerLock.RUnlock()\n   410\t\n   411\t\t\tstart := time.Now()\n   412\t\t\tif err := r.trans.AppendEntries(peer.ID, peer.Address, &req, &resp); err != nil {\n   413\t\t\t\tnextBackoffTime := cappedExponentialBackoff(failureWait, failures, maxFailureScale, r.config().HeartbeatTimeout/2)\n   414\t\t\t\tr.logger.Error(\"failed to heartbeat to\", \"peer\", peer.Address, \"backoff time\",\n   415\t\t\t\t\tnextBackoffTime, \"error\", err)\n   416\t\t\t\tr.observe(FailedHeartbeatObservation{PeerID: peer.ID, LastContact: s.LastContact()})\n   417\t\t\t\tfailures++\n   418\t\t\t\tselect {\n   419\t\t\t\tcase <-time.After(nextBackoffTime):\n   420\t\t\t\tcase <-stopCh:\n   421\t\t\t\t\treturn\n   422\t\t\t\t}\n   423\t\t\t} else {\n   424\t\t\t\tif failures > 0 {\n   425\t\t\t\t\tr.observe(ResumedHeartbeatObservation{PeerID: peer.ID})\n   426\t\t\t\t}\n   427\t\t\t\ts.setLastContact()\n   428\t\t\t\tfailures = 0\n   429\t\t\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: string(peer.ID)}}\n   430\t\t\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"heartbeat\"}, start, labels)\n   431\t\n   432\t\t\t\tif !r.noLegacyTelemetry {\n   433\t\t\t\t\t// Duplicated information. Kept for backward compatibility.\n   434\t\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"heartbeat\", string(peer.ID)}, start)\n   435\t\t\t\t}\n   436\t\n   437\t\t\t\ts.notifyAll(resp.Success)\n   438\t\t\t}\n   439\t\t}\n   440\t}\n   441\t\n   442\t// pipelineReplicate is used when we have synchronized our state with the follower,\n   443\t// and want to switch to a higher performance pipeline mode of replication.\n   444\t// We only pipeline AppendEntries commands, and if we ever hit an error, we fall\n   445\t// back to the standard replication which can handle more complex situations.\n   446\tfunc (r *Raft) pipelineReplicate(s *followerReplication) error {\n   447\t\ts.peerLock.RLock()\n   448\t\tpeer := s.peer\n   449\t\ts.peerLock.RUnlock()\n   450\t\n   451\t\t// Create a new pipeline\n   452\t\tpipeline, err := r.trans.AppendEntriesPipeline(peer.ID, peer.Address)\n   453\t\tif err != nil {\n   454\t\t\treturn err\n   455\t\t}\n   456\t\tdefer pipeline.Close()\n   457\t\n   458\t\t// Log start and stop of pipeline\n   459\t\tr.logger.Info(\"pipelining replication\", \"peer\", peer)\n   460\t\tdefer r.logger.Info(\"aborting pipeline replication\", \"peer\", peer)\n   461\t\n   462\t\t// Create a shutdown and finish channel\n   463\t\tstopCh := make(chan struct{})\n   464\t\tfinishCh := make(chan struct{})\n   465\t\n   466\t\t// Start a dedicated decoder\n   467\t\tr.goFunc(func() { r.pipelineDecode(s, pipeline, stopCh, finishCh) })\n   468\t\n   469\t\t// Start pipeline sends at the last good nextIndex\n   470\t\tnextIndex := atomic.LoadUint64(&s.nextIndex)\n   471\t\n   472\t\tshouldStop := false\n   473\tSEND:\n   474\t\tfor !shouldStop {\n   475\t\t\tselect {\n   476\t\t\tcase <-finishCh:\n   477\t\t\t\tbreak SEND\n   478\t\t\tcase maxIndex := <-s.stopCh:\n   479\t\t\t\t// Make a best effort to replicate up to this index\n   480\t\t\t\tif maxIndex > 0 {\n   481\t\t\t\t\tr.pipelineSend(s, pipeline, &nextIndex, maxIndex)\n   482\t\t\t\t}\n   483\t\t\t\tbreak SEND\n   484\t\t\tcase deferErr := <-s.triggerDeferErrorCh:\n   485\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   486\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   487\t\t\t\tif !shouldStop {\n   488\t\t\t\t\tdeferErr.respond(nil)\n   489\t\t\t\t} else {\n   490\t\t\t\t\tdeferErr.respond(fmt.Errorf(\"replication failed\"))\n   491\t\t\t\t}\n   492\t\t\tcase <-s.triggerCh:\n   493\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   494\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   495\t\t\tcase <-randomTimeout(r.config().CommitTimeout):\n   496\t\t\t\tlastLogIdx, _ := r.getLastLog()\n   497\t\t\t\tshouldStop = r.pipelineSend(s, pipeline, &nextIndex, lastLogIdx)\n   498\t\t\t}\n   499\t\t}\n   500\t\n   501\t\t// Stop our decoder, and wait for it to finish\n   502\t\tclose(stopCh)\n   503\t\tselect {\n   504\t\tcase <-finishCh:\n   505\t\tcase <-r.shutdownCh:\n   506\t\t}\n   507\t\treturn nil\n   508\t}\n   509\t\n   510\t// pipelineSend is used to send data over a pipeline. It is a helper to\n   511\t// pipelineReplicate.\n   512\tfunc (r *Raft) pipelineSend(s *followerReplication, p AppendPipeline, nextIdx *uint64, lastIndex uint64) (shouldStop bool) {\n   513\t\t// Create a new append request\n   514\t\treq := new(AppendEntriesRequest)\n   515\t\tif err := r.setupAppendEntries(s, req, *nextIdx, lastIndex); err != nil {\n   516\t\t\treturn true\n   517\t\t}\n   518\t\n   519\t\t// Pipeline the append entries\n   520\t\tif _, err := p.AppendEntries(req, new(AppendEntriesResponse)); err != nil {\n   521\t\t\tr.logger.Error(\"failed to pipeline appendEntries\", \"peer\", s.peer, \"error\", err)\n   522\t\t\treturn true\n   523\t\t}\n   524\t\n   525\t\t// Increase the next send log to avoid re-sending old logs\n   526\t\tif n := len(req.Entries); n > 0 {\n   527\t\t\tlast := req.Entries[n-1]\n   528\t\t\tatomic.StoreUint64(nextIdx, last.Index+1)\n   529\t\t}\n   530\t\treturn false\n   531\t}\n   532\t\n   533\t// pipelineDecode is used to decode the responses of pipelined requests.\n   534\tfunc (r *Raft) pipelineDecode(s *followerReplication, p AppendPipeline, stopCh, finishCh chan struct{}) {\n   535\t\tdefer close(finishCh)\n   536\t\trespCh := p.Consumer()\n   537\t\tfor {\n   538\t\t\tselect {\n   539\t\t\tcase ready := <-respCh:\n   540\t\t\t\ts.peerLock.RLock()\n   541\t\t\t\tpeer := s.peer\n   542\t\t\t\ts.peerLock.RUnlock()\n   543\t\n   544\t\t\t\treq, resp := ready.Request(), ready.Response()\n   545\t\t\t\tappendStats(string(peer.ID), ready.Start(), float32(len(req.Entries)), r.noLegacyTelemetry)\n   546\t\n   547\t\t\t\t// Check for a newer term, stop running\n   548\t\t\t\tif resp.Term > req.Term {\n   549\t\t\t\t\tr.handleStaleTerm(s)\n   550\t\t\t\t\treturn\n   551\t\t\t\t}\n   552\t\n   553\t\t\t\t// Update the last contact\n   554\t\t\t\ts.setLastContact()\n   555\t\n   556\t\t\t\t// Abort pipeline if not successful\n   557\t\t\t\tif !resp.Success {\n   558\t\t\t\t\treturn\n   559\t\t\t\t}\n   560\t\n   561\t\t\t\t// Update our replication state\n   562\t\t\t\tupdateLastAppended(s, req)\n   563\t\t\tcase <-stopCh:\n   564\t\t\t\treturn\n   565\t\t\t}\n   566\t\t}\n   567\t}\n   568\t\n   569\t// setupAppendEntries is used to setup an append entries request.\n   570\tfunc (r *Raft) setupAppendEntries(s *followerReplication, req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   571\t\treq.RPCHeader = r.getRPCHeader()\n   572\t\treq.Term = s.currentTerm\n   573\t\t// this is needed for retro compatibility, before RPCHeader.Addr was added\n   574\t\treq.Leader = r.trans.EncodePeer(r.localID, r.localAddr)\n   575\t\treq.LeaderCommitIndex = r.getCommitIndex()\n   576\t\tif err := r.setPreviousLog(req, nextIndex); err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tif err := r.setNewLogs(req, nextIndex, lastIndex); err != nil {\n   580\t\t\treturn err\n   581\t\t}\n   582\t\treturn nil\n   583\t}\n   584\t\n   585\t// setPreviousLog is used to setup the PrevLogEntry and PrevLogTerm for an\n   586\t// AppendEntriesRequest given the next index to replicate.\n   587\tfunc (r *Raft) setPreviousLog(req *AppendEntriesRequest, nextIndex uint64) error {\n   588\t\t// Guard for the first index, since there is no 0 log entry\n   589\t\t// Guard against the previous index being a snapshot as well\n   590\t\tlastSnapIdx, lastSnapTerm := r.getLastSnapshot()\n   591\t\tif nextIndex == 1 {\n   592\t\t\treq.PrevLogEntry = 0\n   593\t\t\treq.PrevLogTerm = 0\n   594\t\n   595\t\t} else if (nextIndex - 1) == lastSnapIdx {\n   596\t\t\treq.PrevLogEntry = lastSnapIdx\n   597\t\t\treq.PrevLogTerm = lastSnapTerm\n   598\t\n   599\t\t} else {\n   600\t\t\tvar l Log\n   601\t\t\tif err := r.logs.GetLog(nextIndex-1, &l); err != nil {\n   602\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", nextIndex-1, \"error\", err)\n   603\t\t\t\treturn err\n   604\t\t\t}\n   605\t\n   606\t\t\t// Set the previous index and term (0 if nextIndex is 1)\n   607\t\t\treq.PrevLogEntry = l.Index\n   608\t\t\treq.PrevLogTerm = l.Term\n   609\t\t}\n   610\t\treturn nil\n   611\t}\n   612\t\n   613\t// setNewLogs is used to setup the logs which should be appended for a request.\n   614\tfunc (r *Raft) setNewLogs(req *AppendEntriesRequest, nextIndex, lastIndex uint64) error {\n   615\t\t// Append up to MaxAppendEntries or up to the lastIndex. we need to use a\n   616\t\t// consistent value for maxAppendEntries in the lines below in case it ever\n   617\t\t// becomes reloadable.\n   618\t\tmaxAppendEntries := r.config().MaxAppendEntries\n   619\t\treq.Entries = make([]*Log, 0, maxAppendEntries)\n   620\t\tmaxIndex := min(nextIndex+uint64(maxAppendEntries)-1, lastIndex)\n   621\t\tfor i := nextIndex; i <= maxIndex; i++ {\n   622\t\t\toldLog := new(Log)\n   623\t\t\tif err := r.logs.GetLog(i, oldLog); err != nil {\n   624\t\t\t\tr.logger.Error(\"failed to get log\", \"index\", i, \"error\", err)\n   625\t\t\t\treturn err\n   626\t\t\t}\n   627\t\t\treq.Entries = append(req.Entries, oldLog)\n   628\t\t}\n   629\t\treturn nil\n   630\t}\n   631\t\n   632\t// appendStats is used to emit stats about an AppendEntries invocation.\n   633\tfunc appendStats(peer string, start time.Time, logs float32, skipLegacy bool) {\n   634\t\tlabels := []metrics.Label{{Name: \"peer_id\", Value: peer}}\n   635\t\tmetrics.MeasureSinceWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\"}, start, labels)\n   636\t\tmetrics.IncrCounterWithLabels([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\"}, logs, labels)\n   637\t\n   638\t\tif !skipLegacy {\n   639\t\t\t// Duplicated information. Kept for backward compatibility.\n   640\t\t\tmetrics.MeasureSince([]string{\"raft\", \"replication\", \"appendEntries\", \"rpc\", peer}, start)\n   641\t\t\tmetrics.IncrCounter([]string{\"raft\", \"replication\", \"appendEntries\", \"logs\", peer}, logs)\n   642\t\t}\n   643\t}\n   644\t\n   645\t// handleStaleTerm is used when a follower indicates that we have a stale term.\n   646\tfunc (r *Raft) handleStaleTerm(s *followerReplication) {\n   647\t\tr.logger.Error(\"peer has newer term, stopping replication\", \"peer\", s.peer)\n   648\t\ts.notifyAll(false) // No longer leader\n   649\t\tasyncNotifyCh(s.stepDown)\n   650\t}\n   651\t\n   652\t// updateLastAppended is used to update follower replication state after a\n   653\t// successful AppendEntries RPC.\n   654\t// TODO: This isn't used during InstallSnapshot, but the code there is similar.\n   655\tfunc updateLastAppended(s *followerReplication, req *AppendEntriesRequest) {\n   656\t\t// Mark any inflight logs as committed\n   657\t\tif logs := req.Entries; len(logs) > 0 {\n   658\t\t\tlast := logs[len(logs)-1]\n   659\t\t\tatomic.StoreUint64(&s.nextIndex, last.Index+1)\n   660\t\t\ts.commitment.match(s.peer.ID, last.Index)\n   661\t\t}\n   662\t\n   663\t\t// Notify still leader\n   664\t\ts.notifyAll(true)\n   665\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n commitment.go && cat -n configuration.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n commitment.go && cat -n configuration.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"sort\"\n     8\t\t\"sync\"\n     9\t)\n    10\t\n    11\t// Commitment is used to advance the leader's commit index. The leader and\n    12\t// replication goroutines report in newly written entries with match(), and\n    13\t// this notifies on commitCh when the commit index has advanced.\n    14\ttype commitment struct {\n    15\t\t// protects matchIndexes and commitIndex\n    16\t\tsync.Mutex\n    17\t\t// notified when commitIndex increases\n    18\t\tcommitCh chan struct{}\n    19\t\t// voter ID to log index: the server stores up through this log entry\n    20\t\tmatchIndexes map[ServerID]uint64\n    21\t\t// a quorum stores up through this log entry. monotonically increases.\n    22\t\tcommitIndex uint64\n    23\t\t// the first index of this leader's term: this needs to be replicated to a\n    24\t\t// majority of the cluster before this leader may mark anything committed\n    25\t\t// (per Raft's commitment rule)\n    26\t\tstartIndex uint64\n    27\t}\n    28\t\n    29\t// newCommitment returns a commitment struct that notifies the provided\n    30\t// channel when log entries have been committed. A new commitment struct is\n    31\t// created each time this server becomes leader for a particular term.\n    32\t// 'configuration' is the servers in the cluster.\n    33\t// 'startIndex' is the first index created in this term (see\n    34\t// its description above).\n    35\tfunc newCommitment(commitCh chan struct{}, configuration Configuration, startIndex uint64) *commitment {\n    36\t\tmatchIndexes := make(map[ServerID]uint64)\n    37\t\tfor _, server := range configuration.Servers {\n    38\t\t\tif server.Suffrage == Voter {\n    39\t\t\t\tmatchIndexes[server.ID] = 0\n    40\t\t\t}\n    41\t\t}\n    42\t\treturn &commitment{\n    43\t\t\tcommitCh:     commitCh,\n    44\t\t\tmatchIndexes: matchIndexes,\n    45\t\t\tcommitIndex:  0,\n    46\t\t\tstartIndex:   startIndex,\n    47\t\t}\n    48\t}\n    49\t\n    50\t// Called when a new cluster membership configuration is created: it will be\n    51\t// used to determine commitment from now on. 'configuration' is the servers in\n    52\t// the cluster.\n    53\tfunc (c *commitment) setConfiguration(configuration Configuration) {\n    54\t\tc.Lock()\n    55\t\tdefer c.Unlock()\n    56\t\toldMatchIndexes := c.matchIndexes\n    57\t\tc.matchIndexes = make(map[ServerID]uint64)\n    58\t\tfor _, server := range configuration.Servers {\n    59\t\t\tif server.Suffrage == Voter {\n    60\t\t\t\tc.matchIndexes[server.ID] = oldMatchIndexes[server.ID] // defaults to 0\n    61\t\t\t}\n    62\t\t}\n    63\t\tc.recalculate()\n    64\t}\n    65\t\n    66\t// Called by leader after commitCh is notified\n    67\tfunc (c *commitment) getCommitIndex() uint64 {\n    68\t\tc.Lock()\n    69\t\tdefer c.Unlock()\n    70\t\treturn c.commitIndex\n    71\t}\n    72\t\n    73\t// Match is called once a server completes writing entries to disk: either the\n    74\t// leader has written the new entry or a follower has replied to an\n    75\t// AppendEntries RPC. The given server's disk agrees with this server's log up\n    76\t// through the given index.\n    77\tfunc (c *commitment) match(server ServerID, matchIndex uint64) {\n    78\t\tc.Lock()\n    79\t\tdefer c.Unlock()\n    80\t\tif prev, hasVote := c.matchIndexes[server]; hasVote && matchIndex > prev {\n    81\t\t\tc.matchIndexes[server] = matchIndex\n    82\t\t\tc.recalculate()\n    83\t\t}\n    84\t}\n    85\t\n    86\t// Internal helper to calculate new commitIndex from matchIndexes.\n    87\t// Must be called with lock held.\n    88\tfunc (c *commitment) recalculate() {\n    89\t\tif len(c.matchIndexes) == 0 {\n    90\t\t\treturn\n    91\t\t}\n    92\t\n    93\t\tmatched := make([]uint64, 0, len(c.matchIndexes))\n    94\t\tfor _, idx := range c.matchIndexes {\n    95\t\t\tmatched = append(matched, idx)\n    96\t\t}\n    97\t\tsort.Sort(uint64Slice(matched))\n    98\t\tquorumMatchIndex := matched[(len(matched)-1)/2]\n    99\t\n   100\t\tif quorumMatchIndex > c.commitIndex && quorumMatchIndex >= c.startIndex {\n   101\t\t\tc.commitIndex = quorumMatchIndex\n   102\t\t\tasyncNotifyCh(c.commitCh)\n   103\t\t}\n   104\t}\n     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport \"fmt\"\n     7\t\n     8\t// ServerSuffrage determines whether a Server in a Configuration gets a vote.\n     9\ttype ServerSuffrage int\n    10\t\n    11\t// Note: Don't renumber these, since the numbers are written into the log.\n    12\tconst (\n    13\t\t// Voter is a server whose vote is counted in elections and whose match index\n    14\t\t// is used in advancing the leader's commit index.\n    15\t\tVoter ServerSuffrage = iota\n    16\t\t// Nonvoter is a server that receives log entries but is not considered for\n    17\t\t// elections or commitment purposes.\n    18\t\tNonvoter\n    19\t\t// Staging is a server that acts like a Nonvoter. A configuration change\n    20\t\t// with a ConfigurationChangeCommand of Promote can change a Staging server\n    21\t\t// into a Voter.\n    22\t\t// Deprecated: use Nonvoter instead.\n    23\t\tStaging\n    24\t)\n    25\t\n    26\tfunc (s ServerSuffrage) String() string {\n    27\t\tswitch s {\n    28\t\tcase Voter:\n    29\t\t\treturn \"Voter\"\n    30\t\tcase Nonvoter:\n    31\t\t\treturn \"Nonvoter\"\n    32\t\tcase Staging:\n    33\t\t\treturn \"Staging\"\n    34\t\t}\n    35\t\treturn \"ServerSuffrage\"\n    36\t}\n    37\t\n    38\t// ConfigurationStore provides an interface that can optionally be implemented by FSMs\n    39\t// to store configuration updates made in the replicated log. In general this is only\n    40\t// necessary for FSMs that mutate durable state directly instead of applying changes\n    41\t// in memory and snapshotting periodically. By storing configuration changes, the\n    42\t// persistent FSM state can behave as a complete snapshot, and be able to recover\n    43\t// without an external snapshot just for persisting the raft configuration.\n    44\ttype ConfigurationStore interface {\n    45\t\t// ConfigurationStore is a superset of the FSM functionality\n    46\t\tFSM\n    47\t\n    48\t\t// StoreConfiguration is invoked once a log entry containing a configuration\n    49\t\t// change is committed. It takes the index at which the configuration was\n    50\t\t// written and the configuration value.\n    51\t\tStoreConfiguration(index uint64, configuration Configuration)\n    52\t}\n    53\t\n    54\ttype nopConfigurationStore struct{}\n    55\t\n    56\tfunc (s nopConfigurationStore) StoreConfiguration(_ uint64, _ Configuration) {}\n    57\t\n    58\t// ServerID is a unique string identifying a server for all time.\n    59\ttype ServerID string\n    60\t\n    61\t// ServerAddress is a network address for a server that a transport can contact.\n    62\ttype ServerAddress string\n    63\t\n    64\t// Server tracks the information about a single server in a configuration.\n    65\ttype Server struct {\n    66\t\t// Suffrage determines whether the server gets a vote.\n    67\t\tSuffrage ServerSuffrage\n    68\t\t// ID is a unique string identifying this server for all time.\n    69\t\tID ServerID\n    70\t\t// Address is its network address that a transport can contact.\n    71\t\tAddress ServerAddress\n    72\t}\n    73\t\n    74\t// Configuration tracks which servers are in the cluster, and whether they have\n    75\t// votes. This should include the local server, if it's a member of the cluster.\n    76\t// The servers are listed no particular order, but each should only appear once.\n    77\t// These entries are appended to the log during membership changes.\n    78\ttype Configuration struct {\n    79\t\tServers []Server\n    80\t}\n    81\t\n    82\t// Clone makes a deep copy of a Configuration.\n    83\tfunc (c *Configuration) Clone() (copy Configuration) {\n    84\t\tcopy.Servers = append(copy.Servers, c.Servers...)\n    85\t\treturn\n    86\t}\n    87\t\n    88\t// ConfigurationChangeCommand is the different ways to change the cluster\n    89\t// configuration.\n    90\ttype ConfigurationChangeCommand uint8\n    91\t\n    92\tconst (\n    93\t\t// AddVoter adds a server with Suffrage of Voter.\n    94\t\tAddVoter ConfigurationChangeCommand = iota\n    95\t\t// AddNonvoter makes a server Nonvoter unless its Staging or Voter.\n    96\t\tAddNonvoter\n    97\t\t// DemoteVoter makes a server Nonvoter unless its absent.\n    98\t\tDemoteVoter\n    99\t\t// RemoveServer removes a server entirely from the cluster membership.\n   100\t\tRemoveServer\n   101\t\t// Promote changes a server from Staging to Voter. The command will be a\n   102\t\t// no-op if the server is not Staging.\n   103\t\t// Deprecated: use AddVoter instead.\n   104\t\tPromote\n   105\t\t// AddStaging makes a server a Voter.\n   106\t\t// Deprecated: AddStaging was actually AddVoter. Use AddVoter instead.\n   107\t\tAddStaging = 0 // explicit 0 to preserve the old value.\n   108\t)\n   109\t\n   110\tfunc (c ConfigurationChangeCommand) String() string {\n   111\t\tswitch c {\n   112\t\tcase AddVoter:\n   113\t\t\treturn \"AddVoter\"\n   114\t\tcase AddNonvoter:\n   115\t\t\treturn \"AddNonvoter\"\n   116\t\tcase DemoteVoter:\n   117\t\t\treturn \"DemoteVoter\"\n   118\t\tcase RemoveServer:\n   119\t\t\treturn \"RemoveServer\"\n   120\t\tcase Promote:\n   121\t\t\treturn \"Promote\"\n   122\t\t}\n   123\t\treturn \"ConfigurationChangeCommand\"\n   124\t}\n   125\t\n   126\t// configurationChangeRequest describes a change that a leader would like to\n   127\t// make to its current configuration. It's used only within a single server\n   128\t// (never serialized into the log), as part of `configurationChangeFuture`.\n   129\ttype configurationChangeRequest struct {\n   130\t\tcommand       ConfigurationChangeCommand\n   131\t\tserverID      ServerID\n   132\t\tserverAddress ServerAddress // only present for AddVoter, AddNonvoter\n   133\t\t// prevIndex, if nonzero, is the index of the only configuration upon which\n   134\t\t// this change may be applied; if another configuration entry has been\n   135\t\t// added in the meantime, this request will fail.\n   136\t\tprevIndex uint64\n   137\t}\n   138\t\n   139\t// configurations is state tracked on every server about its Configurations.\n   140\t// Note that, per Diego's dissertation, there can be at most one uncommitted\n   141\t// configuration at a time (the next configuration may not be created until the\n   142\t// prior one has been committed).\n   143\t//\n   144\t// One downside to storing just two configurations is that if you try to take a\n   145\t// snapshot when your state machine hasn't yet applied the committedIndex, we\n   146\t// have no record of the configuration that would logically fit into that\n   147\t// snapshot. We disallow snapshots in that case now. An alternative approach,\n   148\t// which LogCabin uses, is to track every configuration change in the\n   149\t// log.\n   150\ttype configurations struct {\n   151\t\t// committed is the latest configuration in the log/snapshot that has been\n   152\t\t// committed (the one with the largest index).\n   153\t\tcommitted Configuration\n   154\t\t// committedIndex is the log index where 'committed' was written.\n   155\t\tcommittedIndex uint64\n   156\t\t// latest is the latest configuration in the log/snapshot (may be committed\n   157\t\t// or uncommitted)\n   158\t\tlatest Configuration\n   159\t\t// latestIndex is the log index where 'latest' was written.\n   160\t\tlatestIndex uint64\n   161\t}\n   162\t\n   163\t// Clone makes a deep copy of a configurations object.\n   164\tfunc (c *configurations) Clone() (copy configurations) {\n   165\t\tcopy.committed = c.committed.Clone()\n   166\t\tcopy.committedIndex = c.committedIndex\n   167\t\tcopy.latest = c.latest.Clone()\n   168\t\tcopy.latestIndex = c.latestIndex\n   169\t\treturn\n   170\t}\n   171\t\n   172\t// hasVote returns true if the server identified by 'id' is a Voter in the\n   173\t// provided Configuration.\n   174\tfunc hasVote(configuration Configuration, id ServerID) bool {\n   175\t\tfor _, server := range configuration.Servers {\n   176\t\t\tif server.ID == id {\n   177\t\t\t\treturn server.Suffrage == Voter\n   178\t\t\t}\n   179\t\t}\n   180\t\treturn false\n   181\t}\n   182\t\n   183\t// inConfiguration returns true if the server identified by 'id' is in the\n   184\t// provided Configuration.\n   185\tfunc inConfiguration(configuration Configuration, id ServerID) bool {\n   186\t\tfor _, server := range configuration.Servers {\n   187\t\t\tif server.ID == id {\n   188\t\t\t\treturn true\n   189\t\t\t}\n   190\t\t}\n   191\t\treturn false\n   192\t}\n   193\t\n   194\t// checkConfiguration tests a cluster membership configuration for common\n   195\t// errors.\n   196\tfunc checkConfiguration(configuration Configuration) error {\n   197\t\tidSet := make(map[ServerID]bool)\n   198\t\taddressSet := make(map[ServerAddress]bool)\n   199\t\tvar voters int\n   200\t\tfor _, server := range configuration.Servers {\n   201\t\t\tif server.ID == \"\" {\n   202\t\t\t\treturn fmt.Errorf(\"empty ID in configuration: %v\", configuration)\n   203\t\t\t}\n   204\t\t\tif server.Address == \"\" {\n   205\t\t\t\treturn fmt.Errorf(\"empty address in configuration: %v\", server)\n   206\t\t\t}\n   207\t\t\tif idSet[server.ID] {\n   208\t\t\t\treturn fmt.Errorf(\"found duplicate ID in configuration: %v\", server.ID)\n   209\t\t\t}\n   210\t\t\tidSet[server.ID] = true\n   211\t\t\tif addressSet[server.Address] {\n   212\t\t\t\treturn fmt.Errorf(\"found duplicate address in configuration: %v\", server.Address)\n   213\t\t\t}\n   214\t\t\taddressSet[server.Address] = true\n   215\t\t\tif server.Suffrage == Voter {\n   216\t\t\t\tvoters++\n   217\t\t\t}\n   218\t\t}\n   219\t\tif voters == 0 {\n   220\t\t\treturn fmt.Errorf(\"need at least one voter in configuration: %v\", configuration)\n   221\t\t}\n   222\t\treturn nil\n   223\t}\n   224\t\n   225\t// nextConfiguration generates a new Configuration from the current one and a\n   226\t// configuration change request. It's split from appendConfigurationEntry so\n   227\t// that it can be unit tested easily.\n   228\tfunc nextConfiguration(current Configuration, currentIndex uint64, change configurationChangeRequest) (Configuration, error) {\n   229\t\tif change.prevIndex > 0 && change.prevIndex != currentIndex {\n   230\t\t\treturn Configuration{}, fmt.Errorf(\"configuration changed since %v (latest is %v)\", change.prevIndex, currentIndex)\n   231\t\t}\n   232\t\n   233\t\tconfiguration := current.Clone()\n   234\t\tswitch change.command {\n   235\t\tcase AddVoter:\n   236\t\t\tnewServer := Server{\n   237\t\t\t\tSuffrage: Voter,\n   238\t\t\t\tID:       change.serverID,\n   239\t\t\t\tAddress:  change.serverAddress,\n   240\t\t\t}\n   241\t\t\tfound := false\n   242\t\t\tfor i, server := range configuration.Servers {\n   243\t\t\t\tif server.ID == change.serverID {\n   244\t\t\t\t\tif server.Suffrage == Voter {\n   245\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   246\t\t\t\t\t} else {\n   247\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   248\t\t\t\t\t}\n   249\t\t\t\t\tfound = true\n   250\t\t\t\t\tbreak\n   251\t\t\t\t}\n   252\t\t\t}\n   253\t\t\tif !found {\n   254\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   255\t\t\t}\n   256\t\tcase AddNonvoter:\n   257\t\t\tnewServer := Server{\n   258\t\t\t\tSuffrage: Nonvoter,\n   259\t\t\t\tID:       change.serverID,\n   260\t\t\t\tAddress:  change.serverAddress,\n   261\t\t\t}\n   262\t\t\tfound := false\n   263\t\t\tfor i, server := range configuration.Servers {\n   264\t\t\t\tif server.ID == change.serverID {\n   265\t\t\t\t\tif server.Suffrage != Nonvoter {\n   266\t\t\t\t\t\tconfiguration.Servers[i].Address = change.serverAddress\n   267\t\t\t\t\t} else {\n   268\t\t\t\t\t\tconfiguration.Servers[i] = newServer\n   269\t\t\t\t\t}\n   270\t\t\t\t\tfound = true\n   271\t\t\t\t\tbreak\n   272\t\t\t\t}\n   273\t\t\t}\n   274\t\t\tif !found {\n   275\t\t\t\tconfiguration.Servers = append(configuration.Servers, newServer)\n   276\t\t\t}\n   277\t\tcase DemoteVoter:\n   278\t\t\tfor i, server := range configuration.Servers {\n   279\t\t\t\tif server.ID == change.serverID {\n   280\t\t\t\t\tconfiguration.Servers[i].Suffrage = Nonvoter\n   281\t\t\t\t\tbreak\n   282\t\t\t\t}\n   283\t\t\t}\n   284\t\tcase RemoveServer:\n   285\t\t\tfor i, server := range configuration.Servers {\n   286\t\t\t\tif server.ID == change.serverID {\n   287\t\t\t\t\tconfiguration.Servers = append(configuration.Servers[:i], configuration.Servers[i+1:]...)\n   288\t\t\t\t\tbreak\n   289\t\t\t\t}\n   290\t\t\t}\n   291\t\tcase Promote:\n   292\t\t\tfor i, server := range configuration.Servers {\n   293\t\t\t\tif server.ID == change.serverID && server.Suffrage == Staging {\n   294\t\t\t\t\tconfiguration.Servers[i].Suffrage = Voter\n   295\t\t\t\t\tbreak\n   296\t\t\t\t}\n   297\t\t\t}\n   298\t\t}\n   299\t\n   300\t\t// Make sure we didn't do something bad like remove the last voter\n   301\t\tif err := checkConfiguration(configuration); err != nil {\n   302\t\t\treturn Configuration{}, err\n   303\t\t}\n   304\t\n   305\t\treturn configuration, nil\n   306\t}\n   307\t\n   308\t// encodePeers is used to serialize a Configuration into the old peers format.\n   309\t// This is here for backwards compatibility when operating with a mix of old\n   310\t// servers and should be removed once we deprecate support for protocol version 1.\n   311\tfunc encodePeers(configuration Configuration, trans Transport) []byte {\n   312\t\t// Gather up all the voters, other suffrage types are not supported by\n   313\t\t// this data format.\n   314\t\tvar encPeers [][]byte\n   315\t\tfor _, server := range configuration.Servers {\n   316\t\t\tif server.Suffrage == Voter {\n   317\t\t\t\tencPeers = append(encPeers, trans.EncodePeer(server.ID, server.Address))\n   318\t\t\t}\n   319\t\t}\n   320\t\n   321\t\t// Encode the entire array.\n   322\t\tbuf, err := encodeMsgPack(encPeers)\n   323\t\tif err != nil {\n   324\t\t\tpanic(fmt.Errorf(\"failed to encode peers: %v\", err))\n   325\t\t}\n   326\t\n   327\t\treturn buf.Bytes()\n   328\t}\n   329\t\n   330\t// decodePeers is used to deserialize an old list of peers into a Configuration.\n   331\t// This is here for backwards compatibility with old log entries and snapshots;\n   332\t// it should be removed eventually.\n   333\tfunc decodePeers(buf []byte, trans Transport) (Configuration, error) {\n   334\t\t// Decode the buffer first.\n   335\t\tvar encPeers [][]byte\n   336\t\tif err := decodeMsgPack(buf, &encPeers); err != nil {\n   337\t\t\treturn Configuration{}, fmt.Errorf(\"failed to decode peers: %v\", err)\n   338\t\t}\n   339\t\n   340\t\t// Deserialize each peer.\n   341\t\tvar servers []Server\n   342\t\tfor _, enc := range encPeers {\n   343\t\t\tp := trans.DecodePeer(enc)\n   344\t\t\tservers = append(servers, Server{\n   345\t\t\t\tSuffrage: Voter,\n   346\t\t\t\tID:       ServerID(p),\n   347\t\t\t\tAddress:  p,\n   348\t\t\t})\n   349\t\t}\n   350\t\n   351\t\treturn Configuration{Servers: servers}, nil\n   352\t}\n   353\t\n   354\t// EncodeConfiguration serializes a Configuration using MsgPack, or panics on\n   355\t// errors.\n   356\tfunc EncodeConfiguration(configuration Configuration) []byte {\n   357\t\tbuf, err := encodeMsgPack(configuration)\n   358\t\tif err != nil {\n   359\t\t\tpanic(fmt.Errorf(\"failed to encode configuration: %v\", err))\n   360\t\t}\n   361\t\treturn buf.Bytes()\n   362\t}\n   363\t\n   364\t// DecodeConfiguration deserializes a Configuration using MsgPack, or panics on\n   365\t// errors.\n   366\tfunc DecodeConfiguration(buf []byte) Configuration {\n   367\t\tvar configuration Configuration\n   368\t\tif err := decodeMsgPack(buf, &configuration); err != nil {\n   369\t\t\tpanic(fmt.Errorf(\"failed to decode configuration: %v\", err))\n   370\t\t}\n   371\t\treturn configuration\n   372\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n snapshot.go log.go log_cache.go state.go future.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n snapshot.go log.go log_cache.go state.go future.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"time\"\n    10\t\n    11\t\t\"github.com/hashicorp/go-metrics/compat\"\n    12\t)\n    13\t\n    14\t// SnapshotMeta is for metadata of a snapshot.\n    15\ttype SnapshotMeta struct {\n    16\t\t// Version is the version number of the snapshot metadata. This does not cover\n    17\t\t// the application's data in the snapshot, that should be versioned\n    18\t\t// separately.\n    19\t\tVersion SnapshotVersion\n    20\t\n    21\t\t// ID is opaque to the store, and is used for opening.\n    22\t\tID string\n    23\t\n    24\t\t// Index and Term store when the snapshot was taken.\n    25\t\tIndex uint64\n    26\t\tTerm  uint64\n    27\t\n    28\t\t// Peers is deprecated and used to support version 0 snapshots, but will\n    29\t\t// be populated in version 1 snapshots as well to help with upgrades.\n    30\t\tPeers []byte\n    31\t\n    32\t\t// Configuration and ConfigurationIndex are present in version 1\n    33\t\t// snapshots and later.\n    34\t\tConfiguration      Configuration\n    35\t\tConfigurationIndex uint64\n    36\t\n    37\t\t// Size is the size of the snapshot in bytes.\n    38\t\tSize int64\n    39\t}\n    40\t\n    41\t// SnapshotStore interface is used to allow for flexible implementations\n    42\t// of snapshot storage and retrieval. For example, a client could implement\n    43\t// a shared state store such as S3, allowing new nodes to restore snapshots\n    44\t// without streaming from the leader.\n    45\ttype SnapshotStore interface {\n    46\t\t// Create is used to begin a snapshot at a given index and term, and with\n    47\t\t// the given committed configuration. The version parameter controls\n    48\t\t// which snapshot version to create.\n    49\t\tCreate(version SnapshotVersion, index, term uint64, configuration Configuration,\n    50\t\t\tconfigurationIndex uint64, trans Transport) (SnapshotSink, error)\n    51\t\n    52\t\t// List is used to list the available snapshots in the store.\n    53\t\t// It should return then in descending order, with the highest index first.\n    54\t\tList() ([]*SnapshotMeta, error)\n    55\t\n    56\t\t// Open takes a snapshot ID and provides a ReadCloser. Once close is\n    57\t\t// called it is assumed the snapshot is no longer needed.\n    58\t\tOpen(id string) (*SnapshotMeta, io.ReadCloser, error)\n    59\t}\n    60\t\n    61\t// SnapshotSink is returned by StartSnapshot. The FSM will Write state\n    62\t// to the sink and call Close on completion. On error, Cancel will be invoked.\n    63\ttype SnapshotSink interface {\n    64\t\tio.WriteCloser\n    65\t\tID() string\n    66\t\tCancel() error\n    67\t}\n    68\t\n    69\t// runSnapshots is a long running goroutine used to manage taking\n    70\t// new snapshots of the FSM. It runs in parallel to the FSM and\n    71\t// main goroutines, so that snapshots do not block normal operation.\n    72\tfunc (r *Raft) runSnapshots() {\n    73\t\tfor {\n    74\t\t\tselect {\n    75\t\t\tcase <-randomTimeout(r.config().SnapshotInterval):\n    76\t\t\t\t// Check if we should snapshot\n    77\t\t\t\tif !r.shouldSnapshot() {\n    78\t\t\t\t\tcontinue\n    79\t\t\t\t}\n    80\t\n    81\t\t\t\t// Trigger a snapshot\n    82\t\t\t\tif _, err := r.takeSnapshot(); err != nil {\n    83\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    84\t\t\t\t}\n    85\t\n    86\t\t\tcase future := <-r.userSnapshotCh:\n    87\t\t\t\t// User-triggered, run immediately\n    88\t\t\t\tid, err := r.takeSnapshot()\n    89\t\t\t\tif err != nil {\n    90\t\t\t\t\tr.logger.Error(\"failed to take snapshot\", \"error\", err)\n    91\t\t\t\t} else {\n    92\t\t\t\t\tfuture.opener = func() (*SnapshotMeta, io.ReadCloser, error) {\n    93\t\t\t\t\t\treturn r.snapshots.Open(id)\n    94\t\t\t\t\t}\n    95\t\t\t\t}\n    96\t\t\t\tfuture.respond(err)\n    97\t\n    98\t\t\tcase <-r.shutdownCh:\n    99\t\t\t\treturn\n   100\t\t\t}\n   101\t\t}\n   102\t}\n   103\t\n   104\t// shouldSnapshot checks if we meet the conditions to take\n   105\t// a new snapshot.\n   106\tfunc (r *Raft) shouldSnapshot() bool {\n   107\t\t// Check the last snapshot index\n   108\t\tlastSnap, _ := r.getLastSnapshot()\n   109\t\n   110\t\t// Check the last log index\n   111\t\tlastIdx, err := r.logs.LastIndex()\n   112\t\tif err != nil {\n   113\t\t\tr.logger.Error(\"failed to get last log index\", \"error\", err)\n   114\t\t\treturn false\n   115\t\t}\n   116\t\n   117\t\t// Compare the delta to the threshold\n   118\t\tdelta := lastIdx - lastSnap\n   119\t\treturn delta >= r.config().SnapshotThreshold\n   120\t}\n   121\t\n   122\t// takeSnapshot is used to take a new snapshot. This must only be called from\n   123\t// the snapshot thread, never the main thread. This returns the ID of the new\n   124\t// snapshot, along with an error.\n   125\tfunc (r *Raft) takeSnapshot() (string, error) {\n   126\t\tdefer metrics.MeasureSince([]string{\"raft\", \"snapshot\", \"takeSnapshot\"}, time.Now())\n   127\t\n   128\t\t// Create a request for the FSM to perform a snapshot.\n   129\t\tsnapReq := &reqSnapshotFuture{}\n   130\t\tsnapReq.init()\n   131\t\n   132\t\t// Wait for dispatch or shutdown.\n   133\t\tselect {\n   134\t\tcase r.fsmSnapshotCh <- snapReq:\n   135\t\tcase <-r.shutdownCh:\n   136\t\t\treturn \"\", ErrRaftShutdown\n   137\t\t}\n   138\t\n   139\t\t// Wait until we get a response\n   140\t\tif err := snapReq.Error(); err != nil {\n   141\t\t\tif err != ErrNothingNewToSnapshot {\n   142\t\t\t\terr = fmt.Errorf(\"failed to start snapshot: %v\", err)\n   143\t\t\t}\n   144\t\t\treturn \"\", err\n   145\t\t}\n   146\t\tdefer snapReq.snapshot.Release()\n   147\t\n   148\t\t// Make a request for the configurations and extract the committed info.\n   149\t\t// We have to use the future here to safely get this information since\n   150\t\t// it is owned by the main thread.\n   151\t\tconfigReq := &configurationsFuture{}\n   152\t\tconfigReq.ShutdownCh = r.shutdownCh\n   153\t\tconfigReq.init()\n   154\t\tselect {\n   155\t\tcase r.configurationsCh <- configReq:\n   156\t\tcase <-r.shutdownCh:\n   157\t\t\treturn \"\", ErrRaftShutdown\n   158\t\t}\n   159\t\tif err := configReq.Error(); err != nil {\n   160\t\t\treturn \"\", err\n   161\t\t}\n   162\t\tcommitted := configReq.configurations.committed\n   163\t\tcommittedIndex := configReq.configurations.committedIndex\n   164\t\n   165\t\t// We don't support snapshots while there's a config change outstanding\n   166\t\t// since the snapshot doesn't have a means to represent this state. This\n   167\t\t// is a little weird because we need the FSM to apply an index that's\n   168\t\t// past the configuration change, even though the FSM itself doesn't see\n   169\t\t// the configuration changes. It should be ok in practice with normal\n   170\t\t// application traffic flowing through the FSM. If there's none of that\n   171\t\t// then it's not crucial that we snapshot, since there's not much going\n   172\t\t// on Raft-wise.\n   173\t\tif snapReq.index < committedIndex {\n   174\t\t\treturn \"\", fmt.Errorf(\"cannot take snapshot now, wait until the configuration entry at %v has been applied (have applied %v)\",\n   175\t\t\t\tcommittedIndex, snapReq.index)\n   176\t\t}\n   177\t\n   178\t\t// Create a new snapshot.\n   179\t\tr.logger.Info(\"starting snapshot up to\", \"index\", snapReq.index)\n   180\t\tstart := time.Now()\n   181\t\tversion := getSnapshotVersion(r.protocolVersion)\n   182\t\tsink, err := r.snapshots.Create(version, snapReq.index, snapReq.term, committed, committedIndex, r.trans)\n   183\t\tif err != nil {\n   184\t\t\treturn \"\", fmt.Errorf(\"failed to create snapshot: %v\", err)\n   185\t\t}\n   186\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"create\"}, start)\n   187\t\n   188\t\t// Try to persist the snapshot.\n   189\t\tstart = time.Now()\n   190\t\tif err := snapReq.snapshot.Persist(sink); err != nil {\n   191\t\t\tsink.Cancel()\n   192\t\t\treturn \"\", fmt.Errorf(\"failed to persist snapshot: %v\", err)\n   193\t\t}\n   194\t\tmetrics.MeasureSince([]string{\"raft\", \"snapshot\", \"persist\"}, start)\n   195\t\n   196\t\t// Close and check for error.\n   197\t\tif err := sink.Close(); err != nil {\n   198\t\t\treturn \"\", fmt.Errorf(\"failed to close snapshot: %v\", err)\n   199\t\t}\n   200\t\n   201\t\t// Update the last stable snapshot info.\n   202\t\tr.setLastSnapshot(snapReq.index, snapReq.term)\n   203\t\n   204\t\t// Compact the logs.\n   205\t\tif err := r.compactLogs(snapReq.index); err != nil {\n   206\t\t\treturn \"\", err\n   207\t\t}\n   208\t\n   209\t\tr.logger.Info(\"snapshot complete up to\", \"index\", snapReq.index)\n   210\t\treturn sink.ID(), nil\n   211\t}\n   212\t\n   213\t// compactLogsWithTrailing takes the last inclusive index of a snapshot,\n   214\t// the lastLogIdx, and the trailingLogs and trims the logs that\n   215\t// are no longer needed.\n   216\tfunc (r *Raft) compactLogsWithTrailing(snapIdx uint64, lastLogIdx uint64, trailingLogs uint64) error {\n   217\t\t// Determine log ranges to compact\n   218\t\tminLog, err := r.logs.FirstIndex()\n   219\t\tif err != nil {\n   220\t\t\treturn fmt.Errorf(\"failed to get first log index: %v\", err)\n   221\t\t}\n   222\t\n   223\t\t// Check if we have enough logs to truncate\n   224\t\t// Use a consistent value for trailingLogs for the duration of this method\n   225\t\t// call to avoid surprising behaviour.\n   226\t\tif lastLogIdx <= trailingLogs {\n   227\t\t\treturn nil\n   228\t\t}\n   229\t\n   230\t\t// Truncate up to the end of the snapshot, or `TrailingLogs`\n   231\t\t// back from the head, which ever is further back. This ensures\n   232\t\t// at least `TrailingLogs` entries, but does not allow logs\n   233\t\t// after the snapshot to be removed.\n   234\t\tmaxLog := min(snapIdx, lastLogIdx-trailingLogs)\n   235\t\n   236\t\tif minLog > maxLog {\n   237\t\t\tr.logger.Info(\"no logs to truncate\")\n   238\t\t\treturn nil\n   239\t\t}\n   240\t\n   241\t\tr.logger.Info(\"compacting logs\", \"from\", minLog, \"to\", maxLog)\n   242\t\n   243\t\t// Compact the logs\n   244\t\tif err := r.logs.DeleteRange(minLog, maxLog); err != nil {\n   245\t\t\treturn fmt.Errorf(\"log compaction failed: %v\", err)\n   246\t\t}\n   247\t\treturn nil\n   248\t}\n   249\t\n   250\t// compactLogs takes the last inclusive index of a snapshot\n   251\t// and trims the logs that are no longer needed.\n   252\tfunc (r *Raft) compactLogs(snapIdx uint64) error {\n   253\t\tdefer metrics.MeasureSince([]string{\"raft\", \"compactLogs\"}, time.Now())\n   254\t\n   255\t\tlastLogIdx, _ := r.getLastLog()\n   256\t\ttrailingLogs := r.config().TrailingLogs\n   257\t\n   258\t\treturn r.compactLogsWithTrailing(snapIdx, lastLogIdx, trailingLogs)\n   259\t}\n   260\t\n   261\t// removeOldLogs removes all old logs from the store. This is used for\n   262\t// MonotonicLogStores after restore. Callers should verify that the store\n   263\t// implementation is monotonic prior to calling.\n   264\tfunc (r *Raft) removeOldLogs() error {\n   265\t\tdefer metrics.MeasureSince([]string{\"raft\", \"removeOldLogs\"}, time.Now())\n   266\t\n   267\t\tlastLogIdx, err := r.logs.LastIndex()\n   268\t\tif err != nil {\n   269\t\t\treturn fmt.Errorf(\"failed to get last log index: %w\", err)\n   270\t\t}\n   271\t\n   272\t\tr.logger.Info(\"removing all old logs from log store\")\n   273\t\n   274\t\t// call compactLogsWithTrailing with lastLogIdx for snapIdx since\n   275\t\t// it will take the lesser of lastLogIdx and snapIdx to figure out\n   276\t\t// the end for which to apply trailingLogs.\n   277\t\treturn r.compactLogsWithTrailing(lastLogIdx, lastLogIdx, 0)\n   278\t}\n   279\t// Copyright (c) HashiCorp, Inc.\n   280\t// SPDX-License-Identifier: MPL-2.0\n   281\t\n   282\tpackage raft\n   283\t\n   284\timport (\n   285\t\t\"fmt\"\n   286\t\t\"time\"\n   287\t\n   288\t\tmetrics \"github.com/hashicorp/go-metrics/compat\"\n   289\t)\n   290\t\n   291\t// LogType describes various types of log entries.\n   292\ttype LogType uint8\n   293\t\n   294\tconst (\n   295\t\t// LogCommand is applied to a user FSM.\n   296\t\tLogCommand LogType = iota\n   297\t\n   298\t\t// LogNoop is used to assert leadership.\n   299\t\tLogNoop\n   300\t\n   301\t\t// LogAddPeerDeprecated is used to add a new peer. This should only be used with\n   302\t\t// older protocol versions designed to be compatible with unversioned\n   303\t\t// Raft servers. See comments in config.go for details.\n   304\t\tLogAddPeerDeprecated\n   305\t\n   306\t\t// LogRemovePeerDeprecated is used to remove an existing peer. This should only be\n   307\t\t// used with older protocol versions designed to be compatible with\n   308\t\t// unversioned Raft servers. See comments in config.go for details.\n   309\t\tLogRemovePeerDeprecated\n   310\t\n   311\t\t// LogBarrier is used to ensure all preceding operations have been\n   312\t\t// applied to the FSM. It is similar to LogNoop, but instead of returning\n   313\t\t// once committed, it only returns once the FSM manager acks it. Otherwise,\n   314\t\t// it is possible there are operations committed but not yet applied to\n   315\t\t// the FSM.\n   316\t\tLogBarrier\n   317\t\n   318\t\t// LogConfiguration establishes a membership change configuration. It is\n   319\t\t// created when a server is added, removed, promoted, etc. Only used\n   320\t\t// when protocol version 1 or greater is in use.\n   321\t\tLogConfiguration\n   322\t)\n   323\t\n   324\t// String returns LogType as a human readable string.\n   325\tfunc (lt LogType) String() string {\n   326\t\tswitch lt {\n   327\t\tcase LogCommand:\n   328\t\t\treturn \"LogCommand\"\n   329\t\tcase LogNoop:\n   330\t\t\treturn \"LogNoop\"\n   331\t\tcase LogAddPeerDeprecated:\n   332\t\t\treturn \"LogAddPeerDeprecated\"\n   333\t\tcase LogRemovePeerDeprecated:\n   334\t\t\treturn \"LogRemovePeerDeprecated\"\n   335\t\tcase LogBarrier:\n   336\t\t\treturn \"LogBarrier\"\n   337\t\tcase LogConfiguration:\n   338\t\t\treturn \"LogConfiguration\"\n   339\t\tdefault:\n   340\t\t\treturn fmt.Sprintf(\"%d\", lt)\n   341\t\t}\n   342\t}\n   343\t\n   344\t// Log entries are replicated to all members of the Raft cluster\n   345\t// and form the heart of the replicated state machine.\n   346\ttype Log struct {\n   347\t\t// Index holds the index of the log entry.\n   348\t\tIndex uint64\n   349\t\n   350\t\t// Term holds the election term of the log entry.\n   351\t\tTerm uint64\n   352\t\n   353\t\t// Type holds the type of the log entry.\n   354\t\tType LogType\n   355\t\n   356\t\t// Data holds the log entry's type-specific data.\n   357\t\tData []byte\n   358\t\n   359\t\t// Extensions holds an opaque byte slice of information for middleware. It\n   360\t\t// is up to the client of the library to properly modify this as it adds\n   361\t\t// layers and remove those layers when appropriate. This value is a part of\n   362\t\t// the log, so very large values could cause timing issues.\n   363\t\t//\n   364\t\t// N.B. It is _up to the client_ to handle upgrade paths. For instance if\n   365\t\t// using this with go-raftchunking, the client should ensure that all Raft\n   366\t\t// peers are using a version that can handle that extension before ever\n   367\t\t// actually triggering chunking behavior. It is sometimes sufficient to\n   368\t\t// ensure that non-leaders are upgraded first, then the current leader is\n   369\t\t// upgraded, but a leader changeover during this process could lead to\n   370\t\t// trouble, so gating extension behavior via some flag in the client\n   371\t\t// program is also a good idea.\n   372\t\tExtensions []byte\n   373\t\n   374\t\t// AppendedAt stores the time the leader first appended this log to it's\n   375\t\t// LogStore. Followers will observe the leader's time. It is not used for\n   376\t\t// coordination or as part of the replication protocol at all. It exists only\n   377\t\t// to provide operational information for example how many seconds worth of\n   378\t\t// logs are present on the leader which might impact follower's ability to\n   379\t\t// catch up after restoring a large snapshot. We should never rely on this\n   380\t\t// being in the past when appending on a follower or reading a log back since\n   381\t\t// the clock skew can mean a follower could see a log with a future timestamp.\n   382\t\t// In general too the leader is not required to persist the log before\n   383\t\t// delivering to followers although the current implementation happens to do\n   384\t\t// this.\n   385\t\tAppendedAt time.Time\n   386\t}\n   387\t\n   388\t// LogStore is used to provide an interface for storing\n   389\t// and retrieving logs in a durable fashion.\n   390\ttype LogStore interface {\n   391\t\t// FirstIndex returns the first index written. 0 for no entries.\n   392\t\tFirstIndex() (uint64, error)\n   393\t\n   394\t\t// LastIndex returns the last index written. 0 for no entries.\n   395\t\tLastIndex() (uint64, error)\n   396\t\n   397\t\t// GetLog gets a log entry at a given index.\n   398\t\tGetLog(index uint64, log *Log) error\n   399\t\n   400\t\t// StoreLog stores a log entry.\n   401\t\tStoreLog(log *Log) error\n   402\t\n   403\t\t// StoreLogs stores multiple log entries. By default the logs stored may not be contiguous with previous logs (i.e. may have a gap in Index since the last log written). If an implementation can't tolerate this it may optionally implement `MonotonicLogStore` to indicate that this is not allowed. This changes Raft's behaviour after restoring a user snapshot to remove all previous logs instead of relying on a \"gap\" to signal the discontinuity between logs before the snapshot and logs after.\n   404\t\tStoreLogs(logs []*Log) error\n   405\t\n   406\t\t// DeleteRange deletes a range of log entries. The range is inclusive.\n   407\t\tDeleteRange(min, max uint64) error\n   408\t}\n   409\t\n   410\t// MonotonicLogStore is an optional interface for LogStore implementations that\n   411\t// cannot tolerate gaps in between the Index values of consecutive log entries. For example,\n   412\t// this may allow more efficient indexing because the Index values are densely populated. If true is\n   413\t// returned, Raft will avoid relying on gaps to trigger re-synching logs on followers after a\n   414\t// snapshot is restored. The LogStore must have an efficient implementation of\n   415\t// DeleteLogs for the case where all logs are removed, as this must be called after snapshot restore when gaps are not allowed.\n   416\t// We avoid deleting all records for LogStores that do not implement MonotonicLogStore\n   417\t// because although it's always correct to do so, it has a major negative performance impact on the BoltDB store that is currently\n   418\t// the most widely used.\n   419\ttype MonotonicLogStore interface {\n   420\t\tIsMonotonic() bool\n   421\t}\n   422\t\n   423\tfunc oldestLog(s LogStore) (Log, error) {\n   424\t\tvar l Log\n   425\t\n   426\t\t// We might get unlucky and have a truncate right between getting first log\n   427\t\t// index and fetching it so keep trying until we succeed or hard fail.\n   428\t\tvar lastFailIdx uint64\n   429\t\tvar lastErr error\n   430\t\tfor {\n   431\t\t\tfirstIdx, err := s.FirstIndex()\n   432\t\t\tif err != nil {\n   433\t\t\t\treturn l, err\n   434\t\t\t}\n   435\t\t\tif firstIdx == 0 {\n   436\t\t\t\treturn l, ErrLogNotFound\n   437\t\t\t}\n   438\t\t\tif firstIdx == lastFailIdx {\n   439\t\t\t\t// Got same index as last time around which errored, don't bother trying\n   440\t\t\t\t// to fetch it again just return the error.\n   441\t\t\t\treturn l, lastErr\n   442\t\t\t}\n   443\t\t\terr = s.GetLog(firstIdx, &l)\n   444\t\t\tif err == nil {\n   445\t\t\t\t// We found the oldest log, break the loop\n   446\t\t\t\tbreak\n   447\t\t\t}\n   448\t\t\t// We failed, keep trying to see if there is a new firstIndex\n   449\t\t\tlastFailIdx = firstIdx\n   450\t\t\tlastErr = err\n   451\t\t}\n   452\t\treturn l, nil\n   453\t}\n   454\t\n   455\tfunc emitLogStoreMetrics(s LogStore, prefix []string, interval time.Duration, stopCh <-chan struct{}) {\n   456\t\tfor {\n   457\t\t\tselect {\n   458\t\t\tcase <-time.After(interval):\n   459\t\t\t\t// In error case emit 0 as the age\n   460\t\t\t\tageMs := float32(0.0)\n   461\t\t\t\tl, err := oldestLog(s)\n   462\t\t\t\tif err == nil && !l.AppendedAt.IsZero() {\n   463\t\t\t\t\tageMs = float32(time.Since(l.AppendedAt).Milliseconds())\n   464\t\t\t\t}\n   465\t\t\t\tmetrics.SetGauge(append(prefix, \"oldestLogAge\"), ageMs)\n   466\t\t\tcase <-stopCh:\n   467\t\t\t\treturn\n   468\t\t\t}\n   469\t\t}\n   470\t}\n   471\t// Copyright (c) HashiCorp, Inc.\n   472\t// SPDX-License-Identifier: MPL-2.0\n   473\t\n   474\tpackage raft\n   475\t\n   476\timport (\n   477\t\t\"fmt\"\n   478\t\t\"sync\"\n   479\t)\n   480\t\n   481\t// LogCache wraps any LogStore implementation to provide an\n   482\t// in-memory ring buffer. This is used to cache access to\n   483\t// the recently written entries. For implementations that do not\n   484\t// cache themselves, this can provide a substantial boost by\n   485\t// avoiding disk I/O on recent entries.\n   486\ttype LogCache struct {\n   487\t\tstore LogStore\n   488\t\n   489\t\tcache []*Log\n   490\t\tl     sync.RWMutex\n   491\t}\n   492\t\n   493\t// NewLogCache is used to create a new LogCache with the\n   494\t// given capacity and backend store.\n   495\tfunc NewLogCache(capacity int, store LogStore) (*LogCache, error) {\n   496\t\tif capacity <= 0 {\n   497\t\t\treturn nil, fmt.Errorf(\"capacity must be positive\")\n   498\t\t}\n   499\t\tc := &LogCache{\n   500\t\t\tstore: store,\n   501\t\t\tcache: make([]*Log, capacity),\n   502\t\t}\n   503\t\treturn c, nil\n   504\t}\n   505\t\n   506\t// IsMonotonic implements the MonotonicLogStore interface. This is a shim to\n   507\t// expose the underlying store as monotonically indexed or not.\n   508\tfunc (c *LogCache) IsMonotonic() bool {\n   509\t\tif store, ok := c.store.(MonotonicLogStore); ok {\n   510\t\t\treturn store.IsMonotonic()\n   511\t\t}\n   512\t\n   513\t\treturn false\n   514\t}\n   515\t\n   516\tfunc (c *LogCache) GetLog(idx uint64, log *Log) error {\n   517\t\t// Check the buffer for an entry\n   518\t\tc.l.RLock()\n   519\t\tcached := c.cache[idx%uint64(len(c.cache))]\n   520\t\tc.l.RUnlock()\n   521\t\n   522\t\t// Check if entry is valid\n   523\t\tif cached != nil && cached.Index == idx {\n   524\t\t\t*log = *cached\n   525\t\t\treturn nil\n   526\t\t}\n   527\t\n   528\t\t// Forward request on cache miss\n   529\t\treturn c.store.GetLog(idx, log)\n   530\t}\n   531\t\n   532\tfunc (c *LogCache) StoreLog(log *Log) error {\n   533\t\treturn c.StoreLogs([]*Log{log})\n   534\t}\n   535\t\n   536\tfunc (c *LogCache) StoreLogs(logs []*Log) error {\n   537\t\terr := c.store.StoreLogs(logs)\n   538\t\t// Insert the logs into the ring buffer, but only on success\n   539\t\tif err != nil {\n   540\t\t\treturn fmt.Errorf(\"unable to store logs within log store, err: %q\", err)\n   541\t\t}\n   542\t\tc.l.Lock()\n   543\t\tfor _, l := range logs {\n   544\t\t\tc.cache[l.Index%uint64(len(c.cache))] = l\n   545\t\t}\n   546\t\tc.l.Unlock()\n   547\t\treturn nil\n   548\t}\n   549\t\n   550\tfunc (c *LogCache) FirstIndex() (uint64, error) {\n   551\t\treturn c.store.FirstIndex()\n   552\t}\n   553\t\n   554\tfunc (c *LogCache) LastIndex() (uint64, error) {\n   555\t\treturn c.store.LastIndex()\n   556\t}\n   557\t\n   558\tfunc (c *LogCache) DeleteRange(min, max uint64) error {\n   559\t\t// Invalidate the cache on deletes\n   560\t\tc.l.Lock()\n   561\t\tc.cache = make([]*Log, len(c.cache))\n   562\t\tc.l.Unlock()\n   563\t\n   564\t\treturn c.store.DeleteRange(min, max)\n   565\t}\n   566\t// Copyright (c) HashiCorp, Inc.\n   567\t// SPDX-License-Identifier: MPL-2.0\n   568\t\n   569\tpackage raft\n   570\t\n   571\timport (\n   572\t\t\"sync\"\n   573\t\t\"sync/atomic\"\n   574\t)\n   575\t\n   576\t// RaftState captures the state of a Raft node: Follower, Candidate, Leader,\n   577\t// or Shutdown.\n   578\ttype RaftState uint32\n   579\t\n   580\tconst (\n   581\t\t// Follower is the initial state of a Raft node.\n   582\t\tFollower RaftState = iota\n   583\t\n   584\t\t// Candidate is one of the valid states of a Raft node.\n   585\t\tCandidate\n   586\t\n   587\t\t// Leader is one of the valid states of a Raft node.\n   588\t\tLeader\n   589\t\n   590\t\t// Shutdown is the terminal state of a Raft node.\n   591\t\tShutdown\n   592\t)\n   593\t\n   594\tfunc (s RaftState) String() string {\n   595\t\tswitch s {\n   596\t\tcase Follower:\n   597\t\t\treturn \"Follower\"\n   598\t\tcase Candidate:\n   599\t\t\treturn \"Candidate\"\n   600\t\tcase Leader:\n   601\t\t\treturn \"Leader\"\n   602\t\tcase Shutdown:\n   603\t\t\treturn \"Shutdown\"\n   604\t\tdefault:\n   605\t\t\treturn \"Unknown\"\n   606\t\t}\n   607\t}\n   608\t\n   609\t// raftState is used to maintain various state variables\n   610\t// and provides an interface to set/get the variables in a\n   611\t// thread safe manner.\n   612\ttype raftState struct {\n   613\t\t// currentTerm commitIndex, lastApplied,  must be kept at the top of\n   614\t\t// the struct so they're 64 bit aligned which is a requirement for\n   615\t\t// atomic ops on 32 bit platforms.\n   616\t\n   617\t\t// The current term, cache of StableStore\n   618\t\tcurrentTerm uint64\n   619\t\n   620\t\t// Highest committed log entry\n   621\t\tcommitIndex uint64\n   622\t\n   623\t\t// Last applied log to the FSM\n   624\t\tlastApplied uint64\n   625\t\n   626\t\t// protects 4 next fields\n   627\t\tlastLock sync.Mutex\n   628\t\n   629\t\t// Cache the latest snapshot index/term\n   630\t\tlastSnapshotIndex uint64\n   631\t\tlastSnapshotTerm  uint64\n   632\t\n   633\t\t// Cache the latest log from LogStore\n   634\t\tlastLogIndex uint64\n   635\t\tlastLogTerm  uint64\n   636\t\n   637\t\t// Tracks running goroutines\n   638\t\troutinesGroup sync.WaitGroup\n   639\t\n   640\t\t// The current state\n   641\t\tstate RaftState\n   642\t}\n   643\t\n   644\tfunc (r *raftState) getState() RaftState {\n   645\t\tstateAddr := (*uint32)(&r.state)\n   646\t\treturn RaftState(atomic.LoadUint32(stateAddr))\n   647\t}\n   648\t\n   649\tfunc (r *raftState) setState(s RaftState) {\n   650\t\tstateAddr := (*uint32)(&r.state)\n   651\t\tatomic.StoreUint32(stateAddr, uint32(s))\n   652\t}\n   653\t\n   654\tfunc (r *raftState) getCurrentTerm() uint64 {\n   655\t\treturn atomic.LoadUint64(&r.currentTerm)\n   656\t}\n   657\t\n   658\tfunc (r *raftState) setCurrentTerm(term uint64) {\n   659\t\tatomic.StoreUint64(&r.currentTerm, term)\n   660\t}\n   661\t\n   662\tfunc (r *raftState) getLastLog() (index, term uint64) {\n   663\t\tr.lastLock.Lock()\n   664\t\tindex = r.lastLogIndex\n   665\t\tterm = r.lastLogTerm\n   666\t\tr.lastLock.Unlock()\n   667\t\treturn\n   668\t}\n   669\t\n   670\tfunc (r *raftState) setLastLog(index, term uint64) {\n   671\t\tr.lastLock.Lock()\n   672\t\tr.lastLogIndex = index\n   673\t\tr.lastLogTerm = term\n   674\t\tr.lastLock.Unlock()\n   675\t}\n   676\t\n   677\tfunc (r *raftState) getLastSnapshot() (index, term uint64) {\n   678\t\tr.lastLock.Lock()\n   679\t\tindex = r.lastSnapshotIndex\n   680\t\tterm = r.lastSnapshotTerm\n   681\t\tr.lastLock.Unlock()\n   682\t\treturn\n   683\t}\n   684\t\n   685\tfunc (r *raftState) setLastSnapshot(index, term uint64) {\n   686\t\tr.lastLock.Lock()\n   687\t\tr.lastSnapshotIndex = index\n   688\t\tr.lastSnapshotTerm = term\n   689\t\tr.lastLock.Unlock()\n   690\t}\n   691\t\n   692\tfunc (r *raftState) getCommitIndex() uint64 {\n   693\t\treturn atomic.LoadUint64(&r.commitIndex)\n   694\t}\n   695\t\n   696\tfunc (r *raftState) setCommitIndex(index uint64) {\n   697\t\tatomic.StoreUint64(&r.commitIndex, index)\n   698\t}\n   699\t\n   700\tfunc (r *raftState) getLastApplied() uint64 {\n   701\t\treturn atomic.LoadUint64(&r.lastApplied)\n   702\t}\n   703\t\n   704\tfunc (r *raftState) setLastApplied(index uint64) {\n   705\t\tatomic.StoreUint64(&r.lastApplied, index)\n   706\t}\n   707\t\n   708\t// Start a goroutine and properly handle the race between a routine\n   709\t// starting and incrementing, and exiting and decrementing.\n   710\tfunc (r *raftState) goFunc(f func()) {\n   711\t\tr.routinesGroup.Add(1)\n   712\t\tgo func() {\n   713\t\t\tdefer r.routinesGroup.Done()\n   714\t\t\tf()\n   715\t\t}()\n   716\t}\n   717\t\n   718\tfunc (r *raftState) waitShutdown() {\n   719\t\tr.routinesGroup.Wait()\n   720\t}\n   721\t\n   722\t// getLastIndex returns the last index in stable storage.\n   723\t// Either from the last log or from the last snapshot.\n   724\tfunc (r *raftState) getLastIndex() uint64 {\n   725\t\tr.lastLock.Lock()\n   726\t\tdefer r.lastLock.Unlock()\n   727\t\treturn max(r.lastLogIndex, r.lastSnapshotIndex)\n   728\t}\n   729\t\n   730\t// getLastEntry returns the last index and term in stable storage.\n   731\t// Either from the last log or from the last snapshot.\n   732\tfunc (r *raftState) getLastEntry() (uint64, uint64) {\n   733\t\tr.lastLock.Lock()\n   734\t\tdefer r.lastLock.Unlock()\n   735\t\tif r.lastLogIndex >= r.lastSnapshotIndex {\n   736\t\t\treturn r.lastLogIndex, r.lastLogTerm\n   737\t\t}\n   738\t\treturn r.lastSnapshotIndex, r.lastSnapshotTerm\n   739\t}\n   740\t// Copyright (c) HashiCorp, Inc.\n   741\t// SPDX-License-Identifier: MPL-2.0\n   742\t\n   743\tpackage raft\n   744\t\n   745\timport (\n   746\t\t\"fmt\"\n   747\t\t\"io\"\n   748\t\t\"sync\"\n   749\t\t\"time\"\n   750\t)\n   751\t\n   752\t// Future is used to represent an action that may occur in the future.\n   753\ttype Future interface {\n   754\t\t// Error blocks until the future arrives and then returns the error status\n   755\t\t// of the future. This may be called any number of times - all calls will\n   756\t\t// return the same value, however is not OK to call this method twice\n   757\t\t// concurrently on the same Future instance.\n   758\t\t// Error will only return generic errors related to raft, such\n   759\t\t// as ErrLeadershipLost, or ErrRaftShutdown. Some operations, such as\n   760\t\t// ApplyLog, may also return errors from other methods.\n   761\t\tError() error\n   762\t}\n   763\t\n   764\t// IndexFuture is used for future actions that can result in a raft log entry\n   765\t// being created.\n   766\ttype IndexFuture interface {\n   767\t\tFuture\n   768\t\n   769\t\t// Index holds the index of the newly applied log entry.\n   770\t\t// This must not be called until after the Error method has returned.\n   771\t\tIndex() uint64\n   772\t}\n   773\t\n   774\t// ApplyFuture is used for Apply and can return the FSM response.\n   775\ttype ApplyFuture interface {\n   776\t\tIndexFuture\n   777\t\n   778\t\t// Response returns the FSM response as returned by the FSM.Apply method. This\n   779\t\t// must not be called until after the Error method has returned.\n   780\t\t// Note that if FSM.Apply returns an error, it will be returned by Response,\n   781\t\t// and not by the Error method, so it is always important to check Response\n   782\t\t// for errors from the FSM.\n   783\t\tResponse() interface{}\n   784\t}\n   785\t\n   786\t// ConfigurationFuture is used for GetConfiguration and can return the\n   787\t// latest configuration in use by Raft.\n   788\ttype ConfigurationFuture interface {\n   789\t\tIndexFuture\n   790\t\n   791\t\t// Configuration contains the latest configuration. This must\n   792\t\t// not be called until after the Error method has returned.\n   793\t\tConfiguration() Configuration\n   794\t}\n   795\t\n   796\t// SnapshotFuture is used for waiting on a user-triggered snapshot to complete.\n   797\ttype SnapshotFuture interface {\n   798\t\tFuture\n   799\t\n   800\t\t// Open is a function you can call to access the underlying snapshot and\n   801\t\t// its metadata. This must not be called until after the Error method\n   802\t\t// has returned.\n   803\t\tOpen() (*SnapshotMeta, io.ReadCloser, error)\n   804\t}\n   805\t\n   806\t// LeadershipTransferFuture is used for waiting on a user-triggered leadership\n   807\t// transfer to complete.\n   808\ttype LeadershipTransferFuture interface {\n   809\t\tFuture\n   810\t}\n   811\t\n   812\t// errorFuture is used to return a static error.\n   813\ttype errorFuture struct {\n   814\t\terr error\n   815\t}\n   816\t\n   817\tfunc (e errorFuture) Error() error {\n   818\t\treturn e.err\n   819\t}\n   820\t\n   821\tfunc (e errorFuture) Response() interface{} {\n   822\t\treturn nil\n   823\t}\n   824\t\n   825\tfunc (e errorFuture) Index() uint64 {\n   826\t\treturn 0\n   827\t}\n   828\t\n   829\t// deferError can be embedded to allow a future\n   830\t// to provide an error in the future.\n   831\ttype deferError struct {\n   832\t\terr        error\n   833\t\terrCh      chan error\n   834\t\tresponded  bool\n   835\t\tShutdownCh chan struct{}\n   836\t}\n   837\t\n   838\tfunc (d *deferError) init() {\n   839\t\td.errCh = make(chan error, 1)\n   840\t}\n   841\t\n   842\tfunc (d *deferError) Error() error {\n   843\t\tif d.err != nil {\n   844\t\t\t// Note that when we've received a nil error, this\n   845\t\t\t// won't trigger, but the channel is closed after\n   846\t\t\t// send so we'll still return nil below.\n   847\t\t\treturn d.err\n   848\t\t}\n   849\t\tif d.errCh == nil {\n   850\t\t\tpanic(\"waiting for response on nil channel\")\n   851\t\t}\n   852\t\tselect {\n   853\t\tcase d.err = <-d.errCh:\n   854\t\tcase <-d.ShutdownCh:\n   855\t\t\td.err = ErrRaftShutdown\n   856\t\t}\n   857\t\treturn d.err\n   858\t}\n   859\t\n   860\tfunc (d *deferError) respond(err error) {\n   861\t\tif d.errCh == nil {\n   862\t\t\treturn\n   863\t\t}\n   864\t\tif d.responded {\n   865\t\t\treturn\n   866\t\t}\n   867\t\td.errCh <- err\n   868\t\tclose(d.errCh)\n   869\t\td.responded = true\n   870\t}\n   871\t\n   872\t// There are several types of requests that cause a configuration entry to\n   873\t// be appended to the log. These are encoded here for leaderLoop() to process.\n   874\t// This is internal to a single server.\n   875\ttype configurationChangeFuture struct {\n   876\t\tlogFuture\n   877\t\treq configurationChangeRequest\n   878\t}\n   879\t\n   880\t// bootstrapFuture is used to attempt a live bootstrap of the cluster. See the\n   881\t// Raft object's BootstrapCluster member function for more details.\n   882\ttype bootstrapFuture struct {\n   883\t\tdeferError\n   884\t\n   885\t\t// configuration is the proposed bootstrap configuration to apply.\n   886\t\tconfiguration Configuration\n   887\t}\n   888\t\n   889\t// logFuture is used to apply a log entry and waits until\n   890\t// the log is considered committed.\n   891\ttype logFuture struct {\n   892\t\tdeferError\n   893\t\tlog      Log\n   894\t\tresponse interface{}\n   895\t\tdispatch time.Time\n   896\t}\n   897\t\n   898\tfunc (l *logFuture) Response() interface{} {\n   899\t\treturn l.response\n   900\t}\n   901\t\n   902\tfunc (l *logFuture) Index() uint64 {\n   903\t\treturn l.log.Index\n   904\t}\n   905\t\n   906\ttype shutdownFuture struct {\n   907\t\traft *Raft\n   908\t}\n   909\t\n   910\tfunc (s *shutdownFuture) Error() error {\n   911\t\tif s.raft == nil {\n   912\t\t\treturn nil\n   913\t\t}\n   914\t\ts.raft.waitShutdown()\n   915\t\tif closeable, ok := s.raft.trans.(WithClose); ok {\n   916\t\t\tcloseable.Close()\n   917\t\t}\n   918\t\treturn nil\n   919\t}\n   920\t\n   921\t// userSnapshotFuture is used for waiting on a user-triggered snapshot to\n   922\t// complete.\n   923\ttype userSnapshotFuture struct {\n   924\t\tdeferError\n   925\t\n   926\t\t// opener is a function used to open the snapshot. This is filled in\n   927\t\t// once the future returns with no error.\n   928\t\topener func() (*SnapshotMeta, io.ReadCloser, error)\n   929\t}\n   930\t\n   931\t// Open is a function you can call to access the underlying snapshot and its\n   932\t// metadata.\n   933\tfunc (u *userSnapshotFuture) Open() (*SnapshotMeta, io.ReadCloser, error) {\n   934\t\tif u.opener == nil {\n   935\t\t\treturn nil, nil, fmt.Errorf(\"no snapshot available\")\n   936\t\t}\n   937\t\t// Invalidate the opener so it can't get called multiple times,\n   938\t\t// which isn't generally safe.\n   939\t\tdefer func() {\n   940\t\t\tu.opener = nil\n   941\t\t}()\n   942\t\treturn u.opener()\n   943\t}\n   944\t\n   945\t// userRestoreFuture is used for waiting on a user-triggered restore of an\n   946\t// external snapshot to complete.\n   947\ttype userRestoreFuture struct {\n   948\t\tdeferError\n   949\t\n   950\t\t// meta is the metadata that belongs with the snapshot.\n   951\t\tmeta *SnapshotMeta\n   952\t\n   953\t\t// reader is the interface to read the snapshot contents from.\n   954\t\treader io.Reader\n   955\t}\n   956\t\n   957\t// reqSnapshotFuture is used for requesting a snapshot start.\n   958\t// It is only used internally.\n   959\ttype reqSnapshotFuture struct {\n   960\t\tdeferError\n   961\t\n   962\t\t// snapshot details provided by the FSM runner before responding\n   963\t\tindex    uint64\n   964\t\tterm     uint64\n   965\t\tsnapshot FSMSnapshot\n   966\t}\n   967\t\n   968\t// restoreFuture is used for requesting an FSM to perform a\n   969\t// snapshot restore. Used internally only.\n   970\ttype restoreFuture struct {\n   971\t\tdeferError\n   972\t\tID string\n   973\t}\n   974\t\n   975\t// verifyFuture is used to verify the current node is still\n   976\t// the leader. This is to prevent a stale read.\n   977\ttype verifyFuture struct {\n   978\t\tdeferError\n   979\t\tnotifyCh   chan *verifyFuture\n   980\t\tquorumSize int\n   981\t\tvotes      int\n   982\t\tvoteLock   sync.Mutex\n   983\t}\n   984\t\n   985\t// leadershipTransferFuture is used to track the progress of a leadership\n   986\t// transfer internally.\n   987\ttype leadershipTransferFuture struct {\n   988\t\tdeferError\n   989\t\n   990\t\tID      *ServerID\n   991\t\tAddress *ServerAddress\n   992\t}\n   993\t\n   994\t// configurationsFuture is used to retrieve the current configurations. This is\n   995\t// used to allow safe access to this information outside of the main thread.\n   996\ttype configurationsFuture struct {\n   997\t\tdeferError\n   998\t\tconfigurations configurations\n   999\t}\n  1000\t\n  1001\t// Configuration returns the latest configuration in use by Raft.\n  1002\tfunc (c *configurationsFuture) Configuration() Configuration {\n  1003\t\treturn c.configurations.latest\n  1004\t}\n  1005\t\n  1006\t// Index returns the index of the latest configuration in use by Raft.\n  1007\tfunc (c *configurationsFuture) Index() uint64 {\n  1008\t\treturn c.configurations.latestIndex\n  1009\t}\n  1010\t\n  1011\t// vote is used to respond to a verifyFuture.\n  1012\t// This may block when responding on the notifyCh.\n  1013\tfunc (v *verifyFuture) vote(leader bool) {\n  1014\t\tv.voteLock.Lock()\n  1015\t\tdefer v.voteLock.Unlock()\n  1016\t\n  1017\t\t// Guard against having notified already\n  1018\t\tif v.notifyCh == nil {\n  1019\t\t\treturn\n  1020\t\t}\n  1021\t\n  1022\t\tif leader {\n  1023\t\t\tv.votes++\n  1024\t\t\tif v.votes >= v.quorumSize {\n  1025\t\t\t\tv.notifyCh <- v\n  1026\t\t\t\tv.notifyCh = nil\n  1027\t\t\t}\n  1028\t\t} else {\n  1029\t\t\tv.notifyCh <- v\n  1030\t\t\tv.notifyCh = nil\n  1031\t\t}\n  1032\t}\n  1033\t\n  1034\t// appendFuture is used for waiting on a pipelined append\n  1035\t// entries RPC.\n  1036\ttype appendFuture struct {\n  1037\t\tdeferError\n  1038\t\tstart time.Time\n  1039\t\targs  *AppendEntriesRequest\n  1040\t\tresp  *AppendEntriesResponse\n  1041\t}\n  1042\t\n  1043\tfunc (a *appendFuture) Start() time.Time {\n  1044\t\treturn a.start\n  1045\t}\n  1046\t\n  1047\tfunc (a *appendFuture) Request() *AppendEntriesRequest {\n  1048\t\treturn a.args\n  1049\t}\n  1050\t\n  1051\tfunc (a *appendFuture) Response() *AppendEntriesResponse {\n  1052\t\treturn a.resp\n  1053\t}\n","exit_code":0,"status":"completed"}}
