{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && sed -n 760,1105p api.go'","aggregated_output":"// bootstrap Nonvoter and Staging servers.\n//\n// A cluster can only be bootstrapped once from a single participating Voter\n// server. Any further attempts to bootstrap will return an error that can be\n// safely ignored.\n//\n// One sane approach is to bootstrap a single server with a configuration\n// listing just itself as a Voter, then invoke AddVoter() on it to add other\n// servers to the cluster.\nfunc (r *Raft) BootstrapCluster(configuration Configuration) Future {\n\tbootstrapReq := &bootstrapFuture{}\n\tbootstrapReq.init()\n\tbootstrapReq.configuration = configuration\n\tselect {\n\tcase <-r.shutdownCh:\n\t\treturn errorFuture{ErrRaftShutdown}\n\tcase r.bootstrapCh <- bootstrapReq:\n\t\treturn bootstrapReq\n\t}\n}\n\n// Leader is used to return the current leader of the cluster.\n// Deprecated: use LeaderWithID instead\n// It may return empty string if there is no current leader\n// or the leader is unknown.\n// Deprecated: use LeaderWithID instead.\nfunc (r *Raft) Leader() ServerAddress {\n\tr.leaderLock.RLock()\n\tleaderAddr := r.leaderAddr\n\tr.leaderLock.RUnlock()\n\treturn leaderAddr\n}\n\n// LeaderWithID is used to return the current leader address and ID of the cluster.\n// It may return empty strings if there is no current leader\n// or the leader is unknown.\nfunc (r *Raft) LeaderWithID() (ServerAddress, ServerID) {\n\tr.leaderLock.RLock()\n\tleaderAddr := r.leaderAddr\n\tleaderID := r.leaderID\n\tr.leaderLock.RUnlock()\n\treturn leaderAddr, leaderID\n}\n\n// Apply is used to apply a command to the FSM in a highly consistent\n// manner. This returns a future that can be used to wait on the application.\n// An optional timeout can be provided to limit the amount of time we wait\n// for the command to be started. This must be run on the leader or it\n// will fail.\n//\n// If the node discovers it is no longer the leader while applying the command,\n// it will return ErrLeadershipLost. There is no way to guarantee whether the\n// write succeeded or failed in this case. For example, if the leader is\n// partitioned it can't know if a quorum of followers wrote the log to disk. If\n// at least one did, it may survive into the next leader's term.\n//\n// If a user snapshot is restored while the command is in-flight, an\n// ErrAbortedByRestore is returned. In this case the write effectively failed\n// since its effects will not be present in the FSM after the restore.\nfunc (r *Raft) Apply(cmd []byte, timeout time.Duration) ApplyFuture {\n\treturn r.ApplyLog(Log{Data: cmd}, timeout)\n}\n\n// ApplyLog performs Apply but takes in a Log directly. The only values\n// currently taken from the submitted Log are Data and Extensions. See\n// Apply for details on error cases.\nfunc (r *Raft) ApplyLog(log Log, timeout time.Duration) ApplyFuture {\n\tmetrics.IncrCounter([]string{\"raft\", \"apply\"}, 1)\n\n\tvar timer <-chan time.Time\n\tif timeout > 0 {\n\t\ttimer = time.After(timeout)\n\t}\n\n\t// Create a log future, no index or term yet\n\tlogFuture := &logFuture{\n\t\tlog: Log{\n\t\t\tType:       LogCommand,\n\t\t\tData:       log.Data,\n\t\t\tExtensions: log.Extensions,\n\t\t},\n\t}\n\tlogFuture.init()\n\n\tselect {\n\tcase <-timer:\n\t\treturn errorFuture{ErrEnqueueTimeout}\n\tcase <-r.shutdownCh:\n\t\treturn errorFuture{ErrRaftShutdown}\n\tcase r.applyCh <- logFuture:\n\t\treturn logFuture\n\t}\n}\n\n// Barrier is used to issue a command that blocks until all preceding\n// operations have been applied to the FSM. It can be used to ensure the\n// FSM reflects all queued writes. An optional timeout can be provided to\n// limit the amount of time we wait for the command to be started. This\n// must be run on the leader, or it will fail.\nfunc (r *Raft) Barrier(timeout time.Duration) Future {\n\tmetrics.IncrCounter([]string{\"raft\", \"barrier\"}, 1)\n\tvar timer <-chan time.Time\n\tif timeout > 0 {\n\t\ttimer = time.After(timeout)\n\t}\n\n\t// Create a log future, no index or term yet\n\tlogFuture := &logFuture{log: Log{Type: LogBarrier}}\n\tlogFuture.init()\n\n\tselect {\n\tcase <-timer:\n\t\treturn errorFuture{ErrEnqueueTimeout}\n\tcase <-r.shutdownCh:\n\t\treturn errorFuture{ErrRaftShutdown}\n\tcase r.applyCh <- logFuture:\n\t\treturn logFuture\n\t}\n}\n\n// VerifyLeader is used to ensure this peer is still the leader. It may be used\n// to prevent returning stale data from the FSM after the peer has lost\n// leadership.\nfunc (r *Raft) VerifyLeader() Future {\n\tmetrics.IncrCounter([]string{\"raft\", \"verify_leader\"}, 1)\n\tverifyFuture := &verifyFuture{}\n\tverifyFuture.init()\n\tselect {\n\tcase <-r.shutdownCh:\n\t\treturn errorFuture{ErrRaftShutdown}\n\tcase r.verifyCh <- verifyFuture:\n\t\treturn verifyFuture\n\t}\n}\n\n// GetConfiguration returns the latest configuration. This may not yet be\n// committed. The main loop can access this directly.\nfunc (r *Raft) GetConfiguration() ConfigurationFuture {\n\tconfigReq := &configurationsFuture{}\n\tconfigReq.init()\n\tconfigReq.configurations = configurations{latest: r.getLatestConfiguration()}\n\tconfigReq.respond(nil)\n\treturn configReq\n}\n\n// AddPeer to the cluster configuration. Must be run on the leader, or it will fail.\n//\n// Deprecated: Use AddVoter/AddNonvoter instead.\nfunc (r *Raft) AddPeer(peer ServerAddress) Future {\n\tif r.protocolVersion > 2 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:       AddVoter,\n\t\tserverID:      ServerID(peer),\n\t\tserverAddress: peer,\n\t\tprevIndex:     0,\n\t}, 0)\n}\n\n// RemovePeer from the cluster configuration. If the current leader is being\n// removed, it will cause a new election to occur. Must be run on the leader,\n// or it will fail.\n\n// Deprecated: Use RemoveServer instead.\nfunc (r *Raft) RemovePeer(peer ServerAddress) Future {\n\tif r.protocolVersion > 2 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:   RemoveServer,\n\t\tserverID:  ServerID(peer),\n\t\tprevIndex: 0,\n\t}, 0)\n}\n\n// AddVoter will add the given server to the cluster as a staging server. If the\n// server is already in the cluster as a voter, this updates the server's address.\n// This must be run on the leader or it will fail. The leader will promote the\n// staging server to a voter once that server is ready. If nonzero, prevIndex is\n// the index of the only configuration upon which this change may be applied; if\n// another configuration entry has been added in the meantime, this request will\n// fail. If nonzero, timeout is how long this server should wait before the\n// configuration change log entry is appended.\nfunc (r *Raft) AddVoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n\tif r.protocolVersion < 2 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:       AddVoter,\n\t\tserverID:      id,\n\t\tserverAddress: address,\n\t\tprevIndex:     prevIndex,\n\t}, timeout)\n}\n\n// AddNonvoter will add the given server to the cluster but won't assign it a\n// vote. The server will receive log entries, but it won't participate in\n// elections or log entry commitment. If the server is already in the cluster,\n// this updates the server's address. This must be run on the leader or it will\n// fail. For prevIndex and timeout, see AddVoter.\nfunc (r *Raft) AddNonvoter(id ServerID, address ServerAddress, prevIndex uint64, timeout time.Duration) IndexFuture {\n\tif r.protocolVersion < 3 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:       AddNonvoter,\n\t\tserverID:      id,\n\t\tserverAddress: address,\n\t\tprevIndex:     prevIndex,\n\t}, timeout)\n}\n\n// RemoveServer will remove the given server from the cluster. If the current\n// leader is being removed, it will cause a new election to occur. This must be\n// run on the leader or it will fail. For prevIndex and timeout, see AddVoter.\nfunc (r *Raft) RemoveServer(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n\tif r.protocolVersion < 2 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:   RemoveServer,\n\t\tserverID:  id,\n\t\tprevIndex: prevIndex,\n\t}, timeout)\n}\n\n// DemoteVoter will take away a server's vote, if it has one. If present, the\n// server will continue to receive log entries, but it won't participate in\n// elections or log entry commitment. If the server is not in the cluster, this\n// does nothing. This must be run on the leader or it will fail. For prevIndex\n// and timeout, see AddVoter.\nfunc (r *Raft) DemoteVoter(id ServerID, prevIndex uint64, timeout time.Duration) IndexFuture {\n\tif r.protocolVersion < 3 {\n\t\treturn errorFuture{ErrUnsupportedProtocol}\n\t}\n\n\treturn r.requestConfigChange(configurationChangeRequest{\n\t\tcommand:   DemoteVoter,\n\t\tserverID:  id,\n\t\tprevIndex: prevIndex,\n\t}, timeout)\n}\n\n// Shutdown is used to stop the Raft background routines.\n// This is not a graceful operation. Provides a future that\n// can be used to block until all background routines have exited.\nfunc (r *Raft) Shutdown() Future {\n\tr.shutdownLock.Lock()\n\tdefer r.shutdownLock.Unlock()\n\n\tif !r.shutdown {\n\t\tclose(r.shutdownCh)\n\t\tr.shutdown = true\n\t\tr.setState(Shutdown)\n\t\treturn &shutdownFuture{r}\n\t}\n\n\t// avoid closing transport twice\n\treturn &shutdownFuture{nil}\n}\n\n// Snapshot is used to manually force Raft to take a snapshot. Returns a future\n// that can be used to block until complete, and that contains a function that\n// can be used to open the snapshot.\nfunc (r *Raft) Snapshot() SnapshotFuture {\n\tfuture := &userSnapshotFuture{}\n\tfuture.init()\n\tselect {\n\tcase r.userSnapshotCh <- future:\n\t\treturn future\n\tcase <-r.shutdownCh:\n\t\tfuture.respond(ErrRaftShutdown)\n\t\treturn future\n\t}\n}\n\n// Restore is used to manually force Raft to consume an external snapshot, such\n// as if restoring from a backup. We will use the current Raft configuration,\n// not the one from the snapshot, so that we can restore into a new cluster. We\n// will also use the max of the index of the snapshot, or the current index,\n// and then add 1 to that, so we force a new state with a hole in the Raft log,\n// so that the snapshot will be sent to followers and used for any new joiners.\n// This can only be run on the leader, and blocks until the restore is complete\n// or an error occurs.\n//\n// WARNING! This operation has the leader take on the state of the snapshot and\n// then sets itself up so that it replicates that to its followers though the\n// install snapshot process. This involves a potentially dangerous period where\n// the leader commits ahead of its followers, so should only be used for disaster\n// recovery into a fresh cluster, and should not be used in normal operations.\nfunc (r *Raft) Restore(meta *SnapshotMeta, reader io.Reader, timeout time.Duration) error {\n\tmetrics.IncrCounter([]string{\"raft\", \"restore\"}, 1)\n\tvar timer <-chan time.Time\n\tif timeout > 0 {\n\t\ttimer = time.After(timeout)\n\t}\n\n\t// Perform the restore.\n\trestore := &userRestoreFuture{\n\t\tmeta:   meta,\n\t\treader: reader,\n\t}\n\trestore.init()\n\tselect {\n\tcase <-timer:\n\t\treturn ErrEnqueueTimeout\n\tcase <-r.shutdownCh:\n\t\treturn ErrRaftShutdown\n\tcase r.userRestoreCh <- restore:\n\t\t// If the restore is ingested then wait for it to complete.\n\t\tif err := restore.Error(); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\t// Apply a no-op log entry. Waiting for this allows us to wait until the\n\t// followers have gotten the restore and replicated at least this new\n\t// entry, which shows that we've also faulted and installed the\n\t// snapshot with the contents of the restore.\n\tnoop := &logFuture{\n\t\tlog: Log{\n\t\t\tType: LogNoop,\n\t\t},\n\t}\n\tnoop.init()\n\tselect {\n\tcase <-timer:\n\t\treturn ErrEnqueueTimeout\n\tcase <-r.shutdownCh:\n\t\treturn ErrRaftShutdown\n\tcase r.applyCh <- noop:\n\t\treturn noop.Error()\n\t}\n}\n\n// State returns the state of this raft peer.\nfunc (r *Raft) State() RaftState {\n\treturn r.getState()\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n fsm.go util.go commands.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run/agent-source && cat -n fsm.go util.go commands.go'","aggregated_output":"     1\t// Copyright (c) HashiCorp, Inc.\n     2\t// SPDX-License-Identifier: MPL-2.0\n     3\t\n     4\tpackage raft\n     5\t\n     6\timport (\n     7\t\t\"fmt\"\n     8\t\t\"io\"\n     9\t\t\"time\"\n    10\t\n    11\t\thclog \"github.com/hashicorp/go-hclog\"\n    12\t\t\"github.com/hashicorp/go-metrics/compat\"\n    13\t)\n    14\t\n    15\t// FSM is implemented by clients to make use of the replicated log.\n    16\ttype FSM interface {\n    17\t\t// Apply is called once a log entry is committed by a majority of the cluster.\n    18\t\t//\n    19\t\t// Apply should apply the log to the FSM. Apply must be deterministic and\n    20\t\t// produce the same result on all peers in the cluster.\n    21\t\t//\n    22\t\t// The returned value is returned to the client as the ApplyFuture.Response.\n    23\t\tApply(*Log) interface{}\n    24\t\n    25\t\t// Snapshot returns an FSMSnapshot used to: support log compaction, to\n    26\t\t// restore the FSM to a previous state, or to bring out-of-date followers up\n    27\t\t// to a recent log index.\n    28\t\t//\n    29\t\t// The Snapshot implementation should return quickly, because Apply can not\n    30\t\t// be called while Snapshot is running. Generally this means Snapshot should\n    31\t\t// only capture a pointer to the state, and any expensive IO should happen\n    32\t\t// as part of FSMSnapshot.Persist.\n    33\t\t//\n    34\t\t// Apply and Snapshot are always called from the same thread, but Apply will\n    35\t\t// be called concurrently with FSMSnapshot.Persist. This means the FSM should\n    36\t\t// be implemented to allow for concurrent updates while a snapshot is happening.\n    37\t\t//\n    38\t\t// Clients of this library should make no assumptions about whether a returned\n    39\t\t// Snapshot() will actually be stored by Raft. In fact it's quite possible that\n    40\t\t// any Snapshot returned by this call will be discarded, and that\n    41\t\t// FSMSnapshot.Persist will never be called. Raft will always call\n    42\t\t// FSMSnapshot.Release however.\n    43\t\tSnapshot() (FSMSnapshot, error)\n    44\t\n    45\t\t// Restore is used to restore an FSM from a snapshot. It is not called\n    46\t\t// concurrently with any other command. The FSM must discard all previous\n    47\t\t// state before restoring the snapshot.\n    48\t\tRestore(snapshot io.ReadCloser) error\n    49\t}\n    50\t\n    51\t// BatchingFSM extends the FSM interface to add an ApplyBatch function. This can\n    52\t// optionally be implemented by clients to enable multiple logs to be applied to\n    53\t// the FSM in batches. Up to MaxAppendEntries could be sent in a batch.\n    54\ttype BatchingFSM interface {\n    55\t\t// ApplyBatch is invoked once a batch of log entries has been committed and\n    56\t\t// are ready to be applied to the FSM. ApplyBatch will take in an array of\n    57\t\t// log entries. These log entries will be in the order they were committed,\n    58\t\t// will not have gaps, and could be of a few log types. Clients should check\n    59\t\t// the log type prior to attempting to decode the data attached. Presently\n    60\t\t// the LogCommand and LogConfiguration types will be sent.\n    61\t\t//\n    62\t\t// The returned slice must be the same length as the input and each response\n    63\t\t// should correlate to the log at the same index of the input. The returned\n    64\t\t// values will be made available in the ApplyFuture returned by Raft.Apply\n    65\t\t// method if that method was called on the same Raft node as the FSM.\n    66\t\tApplyBatch([]*Log) []interface{}\n    67\t\n    68\t\tFSM\n    69\t}\n    70\t\n    71\t// FSMSnapshot is returned by an FSM in response to a Snapshot\n    72\t// It must be safe to invoke FSMSnapshot methods with concurrent\n    73\t// calls to Apply.\n    74\ttype FSMSnapshot interface {\n    75\t\t// Persist should dump all necessary state to the WriteCloser 'sink',\n    76\t\t// and call sink.Close() when finished or call sink.Cancel() on error.\n    77\t\tPersist(sink SnapshotSink) error\n    78\t\n    79\t\t// Release is invoked when we are finished with the snapshot.\n    80\t\tRelease()\n    81\t}\n    82\t\n    83\t// runFSM is a long running goroutine responsible for applying logs\n    84\t// to the FSM. This is done async of other logs since we don't want\n    85\t// the FSM to block our internal operations.\n    86\tfunc (r *Raft) runFSM() {\n    87\t\tvar lastIndex, lastTerm uint64\n    88\t\n    89\t\tbatchingFSM, batchingEnabled := r.fsm.(BatchingFSM)\n    90\t\tconfigStore, configStoreEnabled := r.fsm.(ConfigurationStore)\n    91\t\n    92\t\tapplySingle := func(req *commitTuple) {\n    93\t\t\t// Apply the log if a command or config change\n    94\t\t\tvar resp interface{}\n    95\t\t\t// Make sure we send a response\n    96\t\t\tdefer func() {\n    97\t\t\t\t// Invoke the future if given\n    98\t\t\t\tif req.future != nil {\n    99\t\t\t\t\treq.future.response = resp\n   100\t\t\t\t\treq.future.respond(nil)\n   101\t\t\t\t}\n   102\t\t\t}()\n   103\t\n   104\t\t\tswitch req.log.Type {\n   105\t\t\tcase LogCommand:\n   106\t\t\t\tstart := time.Now()\n   107\t\t\t\tresp = r.fsm.Apply(req.log)\n   108\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"apply\"}, start)\n   109\t\n   110\t\t\tcase LogConfiguration:\n   111\t\t\t\tif !configStoreEnabled {\n   112\t\t\t\t\t// Return early to avoid incrementing the index and term for\n   113\t\t\t\t\t// an unimplemented operation.\n   114\t\t\t\t\treturn\n   115\t\t\t\t}\n   116\t\n   117\t\t\t\tstart := time.Now()\n   118\t\t\t\tconfigStore.StoreConfiguration(req.log.Index, DecodeConfiguration(req.log.Data))\n   119\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"store_config\"}, start)\n   120\t\t\t}\n   121\t\n   122\t\t\t// Update the indexes\n   123\t\t\tlastIndex = req.log.Index\n   124\t\t\tlastTerm = req.log.Term\n   125\t\t}\n   126\t\n   127\t\tapplyBatch := func(reqs []*commitTuple) {\n   128\t\t\tif !batchingEnabled {\n   129\t\t\t\tfor _, ct := range reqs {\n   130\t\t\t\t\tapplySingle(ct)\n   131\t\t\t\t}\n   132\t\t\t\treturn\n   133\t\t\t}\n   134\t\n   135\t\t\t// Only send LogCommand and LogConfiguration log types. LogBarrier types\n   136\t\t\t// will not be sent to the FSM.\n   137\t\t\tshouldSend := func(l *Log) bool {\n   138\t\t\t\tswitch l.Type {\n   139\t\t\t\tcase LogCommand, LogConfiguration:\n   140\t\t\t\t\treturn true\n   141\t\t\t\t}\n   142\t\t\t\treturn false\n   143\t\t\t}\n   144\t\n   145\t\t\tvar lastBatchIndex, lastBatchTerm uint64\n   146\t\t\tsendLogs := make([]*Log, 0, len(reqs))\n   147\t\t\tfor _, req := range reqs {\n   148\t\t\t\tif shouldSend(req.log) {\n   149\t\t\t\t\tsendLogs = append(sendLogs, req.log)\n   150\t\t\t\t}\n   151\t\t\t\tlastBatchIndex = req.log.Index\n   152\t\t\t\tlastBatchTerm = req.log.Term\n   153\t\t\t}\n   154\t\n   155\t\t\tvar responses []interface{}\n   156\t\t\tif len(sendLogs) > 0 {\n   157\t\t\t\tstart := time.Now()\n   158\t\t\t\tresponses = batchingFSM.ApplyBatch(sendLogs)\n   159\t\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"applyBatch\"}, start)\n   160\t\t\t\tmetrics.AddSample([]string{\"raft\", \"fsm\", \"applyBatchNum\"}, float32(len(reqs)))\n   161\t\n   162\t\t\t\t// Ensure we get the expected responses\n   163\t\t\t\tif len(sendLogs) != len(responses) {\n   164\t\t\t\t\tpanic(\"invalid number of responses\")\n   165\t\t\t\t}\n   166\t\t\t}\n   167\t\n   168\t\t\t// Update the indexes\n   169\t\t\tlastIndex = lastBatchIndex\n   170\t\t\tlastTerm = lastBatchTerm\n   171\t\n   172\t\t\tvar i int\n   173\t\t\tfor _, req := range reqs {\n   174\t\t\t\tvar resp interface{}\n   175\t\t\t\t// If the log was sent to the FSM, retrieve the response.\n   176\t\t\t\tif shouldSend(req.log) {\n   177\t\t\t\t\tresp = responses[i]\n   178\t\t\t\t\ti++\n   179\t\t\t\t}\n   180\t\n   181\t\t\t\tif req.future != nil {\n   182\t\t\t\t\treq.future.response = resp\n   183\t\t\t\t\treq.future.respond(nil)\n   184\t\t\t\t}\n   185\t\t\t}\n   186\t\t}\n   187\t\n   188\t\trestore := func(req *restoreFuture) {\n   189\t\t\t// Open the snapshot\n   190\t\t\tmeta, source, err := r.snapshots.Open(req.ID)\n   191\t\t\tif err != nil {\n   192\t\t\t\treq.respond(fmt.Errorf(\"failed to open snapshot %v: %v\", req.ID, err))\n   193\t\t\t\treturn\n   194\t\t\t}\n   195\t\t\tdefer source.Close()\n   196\t\n   197\t\t\tsnapLogger := r.logger.With(\n   198\t\t\t\t\"id\", req.ID,\n   199\t\t\t\t\"last-index\", meta.Index,\n   200\t\t\t\t\"last-term\", meta.Term,\n   201\t\t\t\t\"size-in-bytes\", meta.Size,\n   202\t\t\t)\n   203\t\n   204\t\t\t// Attempt to restore\n   205\t\t\tif err := fsmRestoreAndMeasure(snapLogger, r.fsm, source, meta.Size); err != nil {\n   206\t\t\t\treq.respond(fmt.Errorf(\"failed to restore snapshot %v: %v\", req.ID, err))\n   207\t\t\t\treturn\n   208\t\t\t}\n   209\t\n   210\t\t\t// Update the last index and term\n   211\t\t\tlastIndex = meta.Index\n   212\t\t\tlastTerm = meta.Term\n   213\t\t\treq.respond(nil)\n   214\t\t}\n   215\t\n   216\t\tsnapshot := func(req *reqSnapshotFuture) {\n   217\t\t\t// Is there something to snapshot?\n   218\t\t\tif lastIndex == 0 {\n   219\t\t\t\treq.respond(ErrNothingNewToSnapshot)\n   220\t\t\t\treturn\n   221\t\t\t}\n   222\t\n   223\t\t\t// Start a snapshot\n   224\t\t\tstart := time.Now()\n   225\t\t\tsnap, err := r.fsm.Snapshot()\n   226\t\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"snapshot\"}, start)\n   227\t\n   228\t\t\t// Respond to the request\n   229\t\t\treq.index = lastIndex\n   230\t\t\treq.term = lastTerm\n   231\t\t\treq.snapshot = snap\n   232\t\t\treq.respond(err)\n   233\t\t}\n   234\t\n   235\t\tsaturation := newSaturationMetric([]string{\"raft\", \"thread\", \"fsm\", \"saturation\"}, 1*time.Second)\n   236\t\n   237\t\tfor {\n   238\t\t\tsaturation.sleeping()\n   239\t\n   240\t\t\tselect {\n   241\t\t\tcase ptr := <-r.fsmMutateCh:\n   242\t\t\t\tsaturation.working()\n   243\t\n   244\t\t\t\tswitch req := ptr.(type) {\n   245\t\t\t\tcase []*commitTuple:\n   246\t\t\t\t\tapplyBatch(req)\n   247\t\n   248\t\t\t\tcase *restoreFuture:\n   249\t\t\t\t\trestore(req)\n   250\t\n   251\t\t\t\tdefault:\n   252\t\t\t\t\tpanic(fmt.Errorf(\"bad type passed to fsmMutateCh: %#v\", ptr))\n   253\t\t\t\t}\n   254\t\n   255\t\t\tcase req := <-r.fsmSnapshotCh:\n   256\t\t\t\tsaturation.working()\n   257\t\n   258\t\t\t\tsnapshot(req)\n   259\t\n   260\t\t\tcase <-r.shutdownCh:\n   261\t\t\t\treturn\n   262\t\t\t}\n   263\t\t}\n   264\t}\n   265\t\n   266\t// fsmRestoreAndMeasure wraps the Restore call on an FSM to consistently measure\n   267\t// and report timing metrics. The caller is still responsible for calling Close\n   268\t// on the source in all cases.\n   269\tfunc fsmRestoreAndMeasure(logger hclog.Logger, fsm FSM, source io.ReadCloser, snapshotSize int64) error {\n   270\t\tstart := time.Now()\n   271\t\n   272\t\tcrc := newCountingReadCloser(source)\n   273\t\n   274\t\tmonitor := startSnapshotRestoreMonitor(logger, crc, snapshotSize, false)\n   275\t\tdefer monitor.StopAndWait()\n   276\t\n   277\t\tif err := fsm.Restore(crc); err != nil {\n   278\t\t\treturn err\n   279\t\t}\n   280\t\tmetrics.MeasureSince([]string{\"raft\", \"fsm\", \"restore\"}, start)\n   281\t\tmetrics.SetGauge([]string{\"raft\", \"fsm\", \"lastRestoreDuration\"},\n   282\t\t\tfloat32(time.Since(start).Milliseconds()))\n   283\t\n   284\t\treturn nil\n   285\t}\n   286\t// Copyright (c) HashiCorp, Inc.\n   287\t// SPDX-License-Identifier: MPL-2.0\n   288\t\n   289\tpackage raft\n   290\t\n   291\timport (\n   292\t\t\"bytes\"\n   293\t\tcrand \"crypto/rand\"\n   294\t\t\"fmt\"\n   295\t\t\"math\"\n   296\t\t\"math/big\"\n   297\t\t\"math/rand\"\n   298\t\t\"time\"\n   299\t\n   300\t\t\"github.com/hashicorp/go-msgpack/v2/codec\"\n   301\t)\n   302\t\n   303\tfunc init() {\n   304\t\t// Ensure we use a high-entropy seed for the pseudo-random generator\n   305\t\trand.Seed(newSeed())\n   306\t}\n   307\t\n   308\t// returns an int64 from a crypto random source\n   309\t// can be used to seed a source for a math/rand.\n   310\tfunc newSeed() int64 {\n   311\t\tr, err := crand.Int(crand.Reader, big.NewInt(math.MaxInt64))\n   312\t\tif err != nil {\n   313\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n   314\t\t}\n   315\t\treturn r.Int64()\n   316\t}\n   317\t\n   318\t// randomTimeout returns a value that is between the minVal and 2x minVal.\n   319\tfunc randomTimeout(minVal time.Duration) <-chan time.Time {\n   320\t\tif minVal == 0 {\n   321\t\t\treturn nil\n   322\t\t}\n   323\t\textra := time.Duration(rand.Int63()) % minVal\n   324\t\treturn time.After(minVal + extra)\n   325\t}\n   326\t\n   327\t// min returns the minimum.\n   328\tfunc min(a, b uint64) uint64 {\n   329\t\tif a <= b {\n   330\t\t\treturn a\n   331\t\t}\n   332\t\treturn b\n   333\t}\n   334\t\n   335\t// max returns the maximum.\n   336\tfunc max(a, b uint64) uint64 {\n   337\t\tif a >= b {\n   338\t\t\treturn a\n   339\t\t}\n   340\t\treturn b\n   341\t}\n   342\t\n   343\t// generateUUID is used to generate a random UUID.\n   344\tfunc generateUUID() string {\n   345\t\tbuf := make([]byte, 16)\n   346\t\tif _, err := crand.Read(buf); err != nil {\n   347\t\t\tpanic(fmt.Errorf(\"failed to read random bytes: %v\", err))\n   348\t\t}\n   349\t\n   350\t\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%12x\",\n   351\t\t\tbuf[0:4],\n   352\t\t\tbuf[4:6],\n   353\t\t\tbuf[6:8],\n   354\t\t\tbuf[8:10],\n   355\t\t\tbuf[10:16])\n   356\t}\n   357\t\n   358\t// asyncNotifyCh is used to do an async channel send\n   359\t// to a single channel without blocking.\n   360\tfunc asyncNotifyCh(ch chan struct{}) {\n   361\t\tselect {\n   362\t\tcase ch <- struct{}{}:\n   363\t\tdefault:\n   364\t\t}\n   365\t}\n   366\t\n   367\t// drainNotifyCh empties out a single-item notification channel without\n   368\t// blocking, and returns whether it received anything.\n   369\tfunc drainNotifyCh(ch chan struct{}) bool {\n   370\t\tselect {\n   371\t\tcase <-ch:\n   372\t\t\treturn true\n   373\t\tdefault:\n   374\t\t\treturn false\n   375\t\t}\n   376\t}\n   377\t\n   378\t// asyncNotifyBool is used to do an async notification\n   379\t// on a bool channel.\n   380\tfunc asyncNotifyBool(ch chan bool, v bool) {\n   381\t\tselect {\n   382\t\tcase ch <- v:\n   383\t\tdefault:\n   384\t\t}\n   385\t}\n   386\t\n   387\t// overrideNotifyBool is used to notify on a bool channel\n   388\t// but override existing value if value is present.\n   389\t// ch must be 1-item buffered channel.\n   390\t//\n   391\t// This method does not support multiple concurrent calls.\n   392\tfunc overrideNotifyBool(ch chan bool, v bool) {\n   393\t\tselect {\n   394\t\tcase ch <- v:\n   395\t\t\t// value sent, all done\n   396\t\tcase <-ch:\n   397\t\t\t// channel had an old value\n   398\t\t\tselect {\n   399\t\t\tcase ch <- v:\n   400\t\t\tdefault:\n   401\t\t\t\tpanic(\"race: channel was sent concurrently\")\n   402\t\t\t}\n   403\t\t}\n   404\t}\n   405\t\n   406\t// Decode reverses the encode operation on a byte slice input.\n   407\tfunc decodeMsgPack(buf []byte, out interface{}) error {\n   408\t\tr := bytes.NewBuffer(buf)\n   409\t\thd := codec.MsgpackHandle{}\n   410\t\tdec := codec.NewDecoder(r, &hd)\n   411\t\treturn dec.Decode(out)\n   412\t}\n   413\t\n   414\t// Encode writes an encoded object to a new bytes buffer.\n   415\tfunc encodeMsgPack(in interface{}) (*bytes.Buffer, error) {\n   416\t\tbuf := bytes.NewBuffer(nil)\n   417\t\thd := codec.MsgpackHandle{\n   418\t\t\tBasicHandle: codec.BasicHandle{\n   419\t\t\t\tTimeNotBuiltin: true,\n   420\t\t\t},\n   421\t\t}\n   422\t\tenc := codec.NewEncoder(buf, &hd)\n   423\t\terr := enc.Encode(in)\n   424\t\treturn buf, err\n   425\t}\n   426\t\n   427\t// backoff is used to compute an exponential backoff\n   428\t// duration. Base time is scaled by the current round,\n   429\t// up to some maximum scale factor.\n   430\tfunc backoff(base time.Duration, round, limit uint64) time.Duration {\n   431\t\tpower := min(round, limit)\n   432\t\tfor power > 2 {\n   433\t\t\tbase *= 2\n   434\t\t\tpower--\n   435\t\t}\n   436\t\treturn base\n   437\t}\n   438\t\n   439\t// cappedExponentialBackoff computes the exponential backoff with an adjustable\n   440\t// cap on the max timeout.\n   441\tfunc cappedExponentialBackoff(base time.Duration, round, limit uint64, cap time.Duration) time.Duration {\n   442\t\tpower := min(round, limit)\n   443\t\tfor power > 2 {\n   444\t\t\tif base > cap {\n   445\t\t\t\treturn cap\n   446\t\t\t}\n   447\t\t\tbase *= 2\n   448\t\t\tpower--\n   449\t\t}\n   450\t\tif base > cap {\n   451\t\t\treturn cap\n   452\t\t}\n   453\t\treturn base\n   454\t}\n   455\t\n   456\t// Needed for sorting []uint64, used to determine commitment\n   457\ttype uint64Slice []uint64\n   458\t\n   459\tfunc (p uint64Slice) Len() int           { return len(p) }\n   460\tfunc (p uint64Slice) Less(i, j int) bool { return p[i] < p[j] }\n   461\tfunc (p uint64Slice) Swap(i, j int)      { p[i], p[j] = p[j], p[i] }\n   462\t// Copyright (c) HashiCorp, Inc.\n   463\t// SPDX-License-Identifier: MPL-2.0\n   464\t\n   465\tpackage raft\n   466\t\n   467\t// RPCHeader is a common sub-structure used to pass along protocol version and\n   468\t// other information about the cluster. For older Raft implementations before\n   469\t// versioning was added this will default to a zero-valued structure when read\n   470\t// by newer Raft versions.\n   471\ttype RPCHeader struct {\n   472\t\t// ProtocolVersion is the version of the protocol the sender is\n   473\t\t// speaking.\n   474\t\tProtocolVersion ProtocolVersion\n   475\t\t// ID is the ServerID of the node sending the RPC Request or Response\n   476\t\tID []byte\n   477\t\t// Addr is the ServerAddr of the node sending the RPC Request or Response\n   478\t\tAddr []byte\n   479\t}\n   480\t\n   481\t// WithRPCHeader is an interface that exposes the RPC header.\n   482\ttype WithRPCHeader interface {\n   483\t\tGetRPCHeader() RPCHeader\n   484\t}\n   485\t\n   486\t// AppendEntriesRequest is the command used to append entries to the\n   487\t// replicated log.\n   488\ttype AppendEntriesRequest struct {\n   489\t\tRPCHeader\n   490\t\n   491\t\t// Provide the current term and leader\n   492\t\tTerm uint64\n   493\t\n   494\t\t// Deprecated: use RPCHeader.Addr instead\n   495\t\tLeader []byte\n   496\t\n   497\t\t// Provide the previous entries for integrity checking\n   498\t\tPrevLogEntry uint64\n   499\t\tPrevLogTerm  uint64\n   500\t\n   501\t\t// New entries to commit\n   502\t\tEntries []*Log\n   503\t\n   504\t\t// Commit index on the leader\n   505\t\tLeaderCommitIndex uint64\n   506\t}\n   507\t\n   508\t// GetRPCHeader - See WithRPCHeader.\n   509\tfunc (r *AppendEntriesRequest) GetRPCHeader() RPCHeader {\n   510\t\treturn r.RPCHeader\n   511\t}\n   512\t\n   513\t// AppendEntriesResponse is the response returned from an\n   514\t// AppendEntriesRequest.\n   515\ttype AppendEntriesResponse struct {\n   516\t\tRPCHeader\n   517\t\n   518\t\t// Newer term if leader is out of date\n   519\t\tTerm uint64\n   520\t\n   521\t\t// Last Log is a hint to help accelerate rebuilding slow nodes\n   522\t\tLastLog uint64\n   523\t\n   524\t\t// We may not succeed if we have a conflicting entry\n   525\t\tSuccess bool\n   526\t\n   527\t\t// There are scenarios where this request didn't succeed\n   528\t\t// but there's no need to wait/back-off the next attempt.\n   529\t\tNoRetryBackoff bool\n   530\t}\n   531\t\n   532\t// GetRPCHeader - See WithRPCHeader.\n   533\tfunc (r *AppendEntriesResponse) GetRPCHeader() RPCHeader {\n   534\t\treturn r.RPCHeader\n   535\t}\n   536\t\n   537\t// RequestVoteRequest is the command used by a candidate to ask a Raft peer\n   538\t// for a vote in an election.\n   539\ttype RequestVoteRequest struct {\n   540\t\tRPCHeader\n   541\t\n   542\t\t// Provide the term and our id\n   543\t\tTerm uint64\n   544\t\n   545\t\t// Deprecated: use RPCHeader.Addr instead\n   546\t\tCandidate []byte\n   547\t\n   548\t\t// Used to ensure safety\n   549\t\tLastLogIndex uint64\n   550\t\tLastLogTerm  uint64\n   551\t\n   552\t\t// Used to indicate to peers if this vote was triggered by a leadership\n   553\t\t// transfer. It is required for leadership transfer to work, because servers\n   554\t\t// wouldn't vote otherwise if they are aware of an existing leader.\n   555\t\tLeadershipTransfer bool\n   556\t}\n   557\t\n   558\t// GetRPCHeader - See WithRPCHeader.\n   559\tfunc (r *RequestVoteRequest) GetRPCHeader() RPCHeader {\n   560\t\treturn r.RPCHeader\n   561\t}\n   562\t\n   563\t// RequestVoteResponse is the response returned from a RequestVoteRequest.\n   564\ttype RequestVoteResponse struct {\n   565\t\tRPCHeader\n   566\t\n   567\t\t// Newer term if leader is out of date.\n   568\t\tTerm uint64\n   569\t\n   570\t\t// Peers is deprecated, but required by servers that only understand\n   571\t\t// protocol version 0. This is not populated in protocol version 2\n   572\t\t// and later.\n   573\t\tPeers []byte\n   574\t\n   575\t\t// Is the vote granted.\n   576\t\tGranted bool\n   577\t}\n   578\t\n   579\t// GetRPCHeader - See WithRPCHeader.\n   580\tfunc (r *RequestVoteResponse) GetRPCHeader() RPCHeader {\n   581\t\treturn r.RPCHeader\n   582\t}\n   583\t\n   584\t// RequestPreVoteRequest is the command used by a candidate to ask a Raft peer\n   585\t// for a vote in an election.\n   586\ttype RequestPreVoteRequest struct {\n   587\t\tRPCHeader\n   588\t\n   589\t\t// Provide the term and our id\n   590\t\tTerm uint64\n   591\t\n   592\t\t// Used to ensure safety\n   593\t\tLastLogIndex uint64\n   594\t\tLastLogTerm  uint64\n   595\t}\n   596\t\n   597\t// GetRPCHeader - See WithRPCHeader.\n   598\tfunc (r *RequestPreVoteRequest) GetRPCHeader() RPCHeader {\n   599\t\treturn r.RPCHeader\n   600\t}\n   601\t\n   602\t// RequestPreVoteResponse is the response returned from a RequestPreVoteRequest.\n   603\ttype RequestPreVoteResponse struct {\n   604\t\tRPCHeader\n   605\t\n   606\t\t// Newer term if leader is out of date.\n   607\t\tTerm uint64\n   608\t\n   609\t\t// Is the vote granted.\n   610\t\tGranted bool\n   611\t}\n   612\t\n   613\t// GetRPCHeader - See WithRPCHeader.\n   614\tfunc (r *RequestPreVoteResponse) GetRPCHeader() RPCHeader {\n   615\t\treturn r.RPCHeader\n   616\t}\n   617\t\n   618\t// InstallSnapshotRequest is the command sent to a Raft peer to bootstrap its\n   619\t// log (and state machine) from a snapshot on another peer.\n   620\ttype InstallSnapshotRequest struct {\n   621\t\tRPCHeader\n   622\t\tSnapshotVersion SnapshotVersion\n   623\t\n   624\t\tTerm   uint64\n   625\t\tLeader []byte\n   626\t\n   627\t\t// These are the last index/term included in the snapshot\n   628\t\tLastLogIndex uint64\n   629\t\tLastLogTerm  uint64\n   630\t\n   631\t\t// Peer Set in the snapshot.\n   632\t\t// but remains here in case we receive an InstallSnapshot from a leader\n   633\t\t// that's running old code.\n   634\t\t// Deprecated: This is deprecated in favor of Configuration\n   635\t\tPeers []byte\n   636\t\n   637\t\t// Cluster membership.\n   638\t\tConfiguration []byte\n   639\t\t// Log index where 'Configuration' entry was originally written.\n   640\t\tConfigurationIndex uint64\n   641\t\n   642\t\t// Size of the snapshot\n   643\t\tSize int64\n   644\t}\n   645\t\n   646\t// GetRPCHeader - See WithRPCHeader.\n   647\tfunc (r *InstallSnapshotRequest) GetRPCHeader() RPCHeader {\n   648\t\treturn r.RPCHeader\n   649\t}\n   650\t\n   651\t// InstallSnapshotResponse is the response returned from an\n   652\t// InstallSnapshotRequest.\n   653\ttype InstallSnapshotResponse struct {\n   654\t\tRPCHeader\n   655\t\n   656\t\tTerm    uint64\n   657\t\tSuccess bool\n   658\t}\n   659\t\n   660\t// GetRPCHeader - See WithRPCHeader.\n   661\tfunc (r *InstallSnapshotResponse) GetRPCHeader() RPCHeader {\n   662\t\treturn r.RPCHeader\n   663\t}\n   664\t\n   665\t// TimeoutNowRequest is the command used by a leader to signal another server to\n   666\t// start an election.\n   667\ttype TimeoutNowRequest struct {\n   668\t\tRPCHeader\n   669\t}\n   670\t\n   671\t// GetRPCHeader - See WithRPCHeader.\n   672\tfunc (r *TimeoutNowRequest) GetRPCHeader() RPCHeader {\n   673\t\treturn r.RPCHeader\n   674\t}\n   675\t\n   676\t// TimeoutNowResponse is the response to TimeoutNowRequest.\n   677\ttype TimeoutNowResponse struct {\n   678\t\tRPCHeader\n   679\t}\n   680\t\n   681\t// GetRPCHeader - See WithRPCHeader.\n   682\tfunc (r *TimeoutNowResponse) GetRPCHeader() RPCHeader {\n   683\t\treturn r.RPCHeader\n   684\t}\n","exit_code":0,"status":"completed"}}
