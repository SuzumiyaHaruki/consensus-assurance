{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c \"cd /home/nitro/Desktop/consensus-assurance/runs/2026-10-13_10-13-13-hashicorp_raft-real-run && python3 -c \\\"\nimport json\nd=json.load(open('logs/963b67610f634f0abcfc1d808093505c/observations.json'))\nev=d['events']; print('total',len(ev))\nfor i,e in enumerate(ev):\n    n=e.get('event'); print('---',i,n)\n    if n=='nonvoter_transfer_after':\n        print('   future',e.get('future_error'),round(e.get('future_elapsed_ms',0),3),'target_state',e.get('target_state'),'target_term',e.get('target_term'),'incumbent',e.get('incumbent_state'),e.get('incumbent_term'),'leaders',e.get('leaders_after'))\n        print('   votes',[(v['candidate_id'][:14],v['term'],v['transfer_flagged']) for v in e.get('observed_vote_requests',[])])\n    elif n=='nonvoter_transfer_before':\n        print('   target_voter',e.get('target_is_voter_on_leader'),'caught_up',e.get('target_caught_up_to_proof'),'incumbent',e.get('incumbent_id')[:16])\n    elif n=='nonvoter_transfer_recovery':\n        print('   recovered',e.get('voters_have_one_leader'),'leaders',e.get('leaders'),'elapsed',round(e.get('elapsed_ms_since_call',0),1))\n    elif n=='control_transfer_after':\n        print('   future',e.get('future_error'),'target_became_leader',e.get('target_became_leader'),'target_state',e.get('target_state'))\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
