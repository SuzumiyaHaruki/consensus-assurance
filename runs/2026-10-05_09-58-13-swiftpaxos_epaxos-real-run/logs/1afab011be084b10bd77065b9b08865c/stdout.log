{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat ../direct-checks/90b0c970a398426d91118919c8b2284e/plan.json; cat ../direct-checks/90b0c970a398426d91118919c8b2284e/epaxos/assurance_generated_test.go; cat ../logs/fd01442675f846f1a5adc7de29ea3b7d/stdout.log'","aggregated_output":"{\n  \"description\": \"Owner 1 admits one PUT and emits PreAccept to acceptor 2; its reply to owner is held. Coordinator 0 explicitly starts recovery of row 1 instance 0 and emits Prepare ballot 3. Acceptor handles that request, sending a reply through actual SendMsg/Marshal to a captured writer. Observe live producer vbal then decode with New/Unmarshal and compare value ballot for the same reply. Stop after decode independently of equality.\",\n  \"claim_id\": \"C-prepare-value-ballot\",\n  \"binding_ids\": [\n    \"BD-prepare-marshal\",\n    \"BD-prepare-unmarshal\"\n  ],\n  \"harness\": {\n    \"execution_package\": \"./epaxos\",\n    \"files\": {},\n    \"kind\": \"go_test\",\n    \"source\": \"package epaxos\\n\\nimport (\\n \\\"bufio\\\"\\n \\\"bytes\\\"\\n \\\"encoding/json\\\"\\n \\\"fmt\\\"\\n \\\"sync\\\"\\n \\\"testing\\\"\\n\\n \\\"github.com/imdea-software/swiftpaxos/dlog\\\"\\n base \\\"github.com/imdea-software/swiftpaxos/replica\\\"\\n \\\"github.com/imdea-software/swiftpaxos/replica/defs\\\"\\n \\\"github.com/imdea-software/swiftpaxos/state\\\"\\n)\\n\\n// Isolate synchronous handlers. Reproduce constructor state for a three-node,\\n// volatile, thrifty configuration, with bounded empty instance rows. No network,\\n// timer, execution goroutine or file is opened; captured streams replace TCP.\\nfunc assuranceNode(id int32) (*Replica, []*bytes.Buffer) {\\n const n = 3\\n r := &Replica{Replica: &base.Replica{\\n  Logger:dlog.New(\\\"\\\",false), N:n,F:1,Id:id, Thrifty:true,Dreply:true,\\n  PeerWriters:make([]*bufio.Writer,n),Alive:make([]bool,n),\\n  PreferredPeerOrder:make([]int32,n),ProposeChan:make(chan *defs.GPropose,8),\\n  Stats:&defs.Stats{M:make(map[string]int)},State:state.InitState(),\\n },InstanceSpace:make([][]*Instance,n),crtInstance:make([]int32,n),\\n CommittedUpTo:make([]int32,n),ExecedUpTo:make([]int32,n),\\n conflicts:make([]map[state.Key]*InstPair,n),maxSeqPerKey:make(map[state.Key]int32),\\n clientMutex:new(sync.Mutex),maxRecvBallot:-1,latestCPInstance:-1,\\n prepareRPC:1,prepareReplyRPC:2,preAcceptRPC:3,preAcceptReplyRPC:4,\\n acceptRPC:5,acceptReplyRPC:6,commitRPC:7,\\n }\\n out:=make([]*bytes.Buffer,n)\\n for i:=0;i<n;i++ {\\n  r.InstanceSpace[i]=make([]*Instance,8)\\n  r.crtInstance[i]=-1;r.CommittedUpTo[i]=-1;r.ExecedUpTo[i]=-1\\n  r.conflicts[i]=make(map[state.Key]*InstPair)\\n  r.PreferredPeerOrder[i]=(id+1+int32(i))%n\\n  r.Alive[i]=int32(i)!=id\\n  out[i]=new(bytes.Buffer);r.PeerWriters[i]=bufio.NewWriter(out[i])\\n }\\n return r,out\\n}\\nfunc assuranceEvent(v any) {b,_:=json.Marshal(v);fmt.Println(\\\"CA_EVENT \\\"+string(b))}\\nfunc assuranceReader(t *testing.T,b *bytes.Buffer,code byte)*bufio.Reader{\\n t.Helper();rd:=bufio.NewReader(bytes.NewReader(append([]byte(nil),b.Bytes()...)))\\n got,e:=rd.ReadByte();if e!=nil||got!=code{t.Fatalf(\\\"missing packet code %d: got %d, %v\\\",code,got,e)}\\n return rd\\n}\\nfunc TestAssurancePrepareReplyPreservation(t *testing.T){\\n owner,ownerOut:=assuranceNode(1)\\n acceptor,acceptorOut:=assuranceNode(2)\\n recovery,recoveryOut:=assuranceNode(0)\\n // Owner creates the command at its legal initial ballot and emits PreAccept.\\n owner.handlePropose(&defs.GPropose{Propose:&defs.Propose{ClientId:9,CommandId:1,Command:state.Command{Op:state.PUT,K:17,V:[]byte(\\\"x\\\")}},Mutex:new(sync.Mutex)})\\n pa:=new(PreAccept)\\n if err:=pa.Unmarshal(assuranceReader(t,ownerOut[2],owner.preAcceptRPC));err!=nil{t.Fatal(err)}\\n acceptor.handlePreAccept(pa)\\n inst:=acceptor.InstanceSpace[1][0]\\n if inst==nil||inst.vbal!=1||inst.Status<PREACCEPTED||len(inst.Cmds)!=1{t.Fatal(\\\"PreAccept prerequisite absent\\\")}\\n // Delay its reply to the owner. Owner and request are not modified. A recovery\\n // request for the missing row instance is produced by the real recovery entry.\\n // This explicit trigger substitutes the execution scanner; no timeout is claimed.\\n recovery.startRecoveryForInstance(1,0)\\n prepare:=new(Prepare)\\n if err:=prepare.Unmarshal(assuranceReader(t,recoveryOut[2],recovery.prepareRPC));err!=nil{t.Fatal(err)}\\n acceptor.handlePrepare(prepare)\\n assuranceEvent(map[string]any{\\\"event\\\":\\\"producer\\\",\\\"acceptor\\\":2,\\\"replica\\\":1,\\\"instance\\\":0,\\\"ballot\\\":inst.bal,\\\"vballot\\\":inst.vbal,\\\"status\\\":inst.Status,\\\"command_count\\\":len(inst.Cmds),\\\"prepare_ballot\\\":prepare.Ballot})\\n decoded:=new(PrepareReply).New().(*PrepareReply)\\n if err:=decoded.Unmarshal(assuranceReader(t,acceptorOut[0],acceptor.prepareReplyRPC));err!=nil{t.Fatal(err)}\\n assuranceEvent(map[string]any{\\\"event\\\":\\\"decoded\\\",\\\"acceptor\\\":decoded.AcceptorId,\\\"replica\\\":decoded.Replica,\\\"instance\\\":decoded.Instance,\\\"ballot\\\":decoded.Ballot,\\\"vballot\\\":decoded.VBallot,\\\"status\\\":decoded.Status,\\\"command_count\\\":len(decoded.Command)})\\n}\\n\",\n    \"description\": \"Bounded synchronous handler harness with constructor-equivalent empty arrays and in-memory peer byte streams.\",\n    \"semantic_changes\": [\n      \"Manual constructor-equivalent state uses bounded rows and channels rather than allocating MAX_INSTANCE and starting run goroutines.\",\n      \"Buffered in-memory streams replace peer sockets; actual SendMsg and codecs execute unchanged. No bytes or protocol fields are edited.\",\n      \"Driver calls synchronous handlers, delivers one generated PreAccept and one generated Prepare, and leaves other generated messages pending.\",\n      \"Explicit startRecoveryForInstance substitutes for automatic scanner scheduling; no automatic continuation or deadline assertion.\",\n      \"No background goroutines, files or connections require cleanup; test terminates after decoding the reply.\"\n    ],\n    \"prerequisites\": [\n      {\n        \"alias\": \"producer\",\n        \"event\": \"producer\",\n        \"conditions\": [\n          {\n            \"field\": \"command_count\",\n            \"op\": \"eq\",\n            \"value\": 1,\n            \"reference\": null\n          },\n          {\n            \"field\": \"status\",\n            \"op\": \"eq\",\n            \"value\": 2,\n            \"reference\": null\n          }\n        ]\n      }\n    ],\n    \"legality\": {\n      \"source_ids\": [\n        \"S-init\",\n        \"S-base\",\n        \"S-formation\",\n        \"S-broadcast\",\n        \"S-recovery\",\n        \"S-send\",\n        \"S-receive\"\n      ],\n      \"expectation_ids\": [\n        \"S-init\",\n        \"S-formation\",\n        \"S-recovery\"\n      ],\n      \"binding_ids\": [],\n      \"derivation\": \"Initialization reproduces zero/empty state of New and base New for fields used by selected entries: N=3,F=1,Id, cyclic preferred peers, live writers, volatile mode, initial -1 row frontiers, conflicts and stats. handlePropose constructs initial ballot 1 request. handlePreAccept establishes value state; startRecoveryForInstance constructs legal ballot 3 Prepare. For this local codec responsibility its explicit invocation needs no natural scanner trigger. Pending PreAcceptReply is retained without delivery, and no committed decision is asserted. Actual SendMsg/Marshal output is parsed without mutation; New/Unmarshal reproduces receiver allocation. Identity and state prerequisites are measured. No source/dependency replacement.\",\n      \"applicability\": \"Handler and codec boundary only; controlled scheduling replaces dispatch but does not permit an invented decided prefix.\",\n      \"unresolved\": [],\n      \"conflicts\": [],\n      \"alternatives\": [\n        \"Natural automatic recovery triggering and cluster consequences are excluded.\"\n      ]\n    }\n  },\n  \"monitors\": [\n    {\n      \"id\": \"M-prepare-vballot\",\n      \"checker_id\": \"CK-prepare-vballot\",\n      \"event\": \"decoded\",\n      \"binding_ids\": [\n        \"BD-prepare-marshal\",\n        \"BD-prepare-unmarshal\"\n      ],\n      \"grounding\": {\n        \"source_ids\": [\n          \"S-recovery\",\n          \"S-reply-wire\",\n          \"S-reply-type\",\n          \"S-send\",\n          \"S-receive\"\n        ],\n        \"expectation_ids\": [\n          \"S-recovery\",\n          \"S-reply-type\"\n        ],\n        \"binding_ids\": [\n          \"BD-prepare-marshal\",\n          \"BD-prepare-unmarshal\"\n        ],\n        \"derivation\": \"C-prepare-value-ballot grounds the preservation relation. producer reads live acceptor inst.vbal after synchronous handlePrepare, which reports precisely that unchanged field; decoded reads the fresh object after actual wire decode. Correlation uses acceptor, row and instance, never VBallot. There is one PrepareReply on this captured stream.\",\n        \"applicability\": \"Three-node volatile prefix; complete unmodified bytes; actual PreAccept and Prepare producers; no decision or recovery outcome assertion.\",\n        \"unresolved\": [],\n        \"conflicts\": [],\n        \"alternatives\": []\n      },\n      \"applicability_conditions\": [],\n      \"admission_alias\": \"producer\"\n    }\n  ],\n  \"observable_properties\": [\n    {\n      \"checker_id\": \"CK-prepare-vballot\",\n      \"kind\": \"event_assertion\",\n      \"trigger\": {\n        \"field\": \"event\",\n        \"op\": \"eq\",\n        \"value\": \"decoded\",\n        \"reference\": null\n      },\n      \"assertion\": {\n        \"field\": \"vballot\",\n        \"op\": \"eq\",\n        \"value\": null,\n        \"reference\": \"producer.vballot\"\n      },\n      \"antecedent\": null,\n      \"identity_fields\": [\n        \"acceptor\",\n        \"replica\",\n        \"instance\"\n      ],\n      \"description\": \"Decoded prior-value ballot equals the producer live value ballot for this reply.\"\n    }\n  ],\n  \"uncertainties\": [\n    \"A representation violation is not a proved consensus decision violation.\",\n    \"Self-reply relabeling and automatic trigger reachability are independent and excluded.\"\n  ]\n}package epaxos\n\nimport (\n \"bufio\"\n \"bytes\"\n \"encoding/json\"\n \"fmt\"\n \"sync\"\n \"testing\"\n\n \"github.com/imdea-software/swiftpaxos/dlog\"\n base \"github.com/imdea-software/swiftpaxos/replica\"\n \"github.com/imdea-software/swiftpaxos/replica/defs\"\n \"github.com/imdea-software/swiftpaxos/state\"\n)\n\n// Isolate synchronous handlers. Reproduce constructor state for a three-node,\n// volatile, thrifty configuration, with bounded empty instance rows. No network,\n// timer, execution goroutine or file is opened; captured streams replace TCP.\nfunc assuranceNode(id int32) (*Replica, []*bytes.Buffer) {\n const n = 3\n r := &Replica{Replica: &base.Replica{\n  Logger:dlog.New(\"\",false), N:n,F:1,Id:id, Thrifty:true,Dreply:true,\n  PeerWriters:make([]*bufio.Writer,n),Alive:make([]bool,n),\n  PreferredPeerOrder:make([]int32,n),ProposeChan:make(chan *defs.GPropose,8),\n  Stats:&defs.Stats{M:make(map[string]int)},State:state.InitState(),\n },InstanceSpace:make([][]*Instance,n),crtInstance:make([]int32,n),\n CommittedUpTo:make([]int32,n),ExecedUpTo:make([]int32,n),\n conflicts:make([]map[state.Key]*InstPair,n),maxSeqPerKey:make(map[state.Key]int32),\n clientMutex:new(sync.Mutex),maxRecvBallot:-1,latestCPInstance:-1,\n prepareRPC:1,prepareReplyRPC:2,preAcceptRPC:3,preAcceptReplyRPC:4,\n acceptRPC:5,acceptReplyRPC:6,commitRPC:7,\n }\n out:=make([]*bytes.Buffer,n)\n for i:=0;i<n;i++ {\n  r.InstanceSpace[i]=make([]*Instance,8)\n  r.crtInstance[i]=-1;r.CommittedUpTo[i]=-1;r.ExecedUpTo[i]=-1\n  r.conflicts[i]=make(map[state.Key]*InstPair)\n  r.PreferredPeerOrder[i]=(id+1+int32(i))%n\n  r.Alive[i]=int32(i)!=id\n  out[i]=new(bytes.Buffer);r.PeerWriters[i]=bufio.NewWriter(out[i])\n }\n return r,out\n}\nfunc assuranceEvent(v any) {b,_:=json.Marshal(v);fmt.Println(\"CA_EVENT \"+string(b))}\nfunc assuranceReader(t *testing.T,b *bytes.Buffer,code byte)*bufio.Reader{\n t.Helper();rd:=bufio.NewReader(bytes.NewReader(append([]byte(nil),b.Bytes()...)))\n got,e:=rd.ReadByte();if e!=nil||got!=code{t.Fatalf(\"missing packet code %d: got %d, %v\",code,got,e)}\n return rd\n}\nfunc TestAssurancePrepareReplyPreservation(t *testing.T){\n owner,ownerOut:=assuranceNode(1)\n acceptor,acceptorOut:=assuranceNode(2)\n recovery,recoveryOut:=assuranceNode(0)\n // Owner creates the command at its legal initial ballot and emits PreAccept.\n owner.handlePropose(&defs.GPropose{Propose:&defs.Propose{ClientId:9,CommandId:1,Command:state.Command{Op:state.PUT,K:17,V:[]byte(\"x\")}},Mutex:new(sync.Mutex)})\n pa:=new(PreAccept)\n if err:=pa.Unmarshal(assuranceReader(t,ownerOut[2],owner.preAcceptRPC));err!=nil{t.Fatal(err)}\n acceptor.handlePreAccept(pa)\n inst:=acceptor.InstanceSpace[1][0]\n if inst==nil||inst.vbal!=1||inst.Status<PREACCEPTED||len(inst.Cmds)!=1{t.Fatal(\"PreAccept prerequisite absent\")}\n // Delay its reply to the owner. Owner and request are not modified. A recovery\n // request for the missing row instance is produced by the real recovery entry.\n // This explicit trigger substitutes the execution scanner; no timeout is claimed.\n recovery.startRecoveryForInstance(1,0)\n prepare:=new(Prepare)\n if err:=prepare.Unmarshal(assuranceReader(t,recoveryOut[2],recovery.prepareRPC));err!=nil{t.Fatal(err)}\n acceptor.handlePrepare(prepare)\n assuranceEvent(map[string]any{\"event\":\"producer\",\"acceptor\":2,\"replica\":1,\"instance\":0,\"ballot\":inst.bal,\"vballot\":inst.vbal,\"status\":inst.Status,\"command_count\":len(inst.Cmds),\"prepare_ballot\":prepare.Ballot})\n decoded:=new(PrepareReply).New().(*PrepareReply)\n if err:=decoded.Unmarshal(assuranceReader(t,acceptorOut[0],acceptor.prepareReplyRPC));err!=nil{t.Fatal(err)}\n assuranceEvent(map[string]any{\"event\":\"decoded\",\"acceptor\":decoded.AcceptorId,\"replica\":decoded.Replica,\"instance\":decoded.Instance,\"ballot\":decoded.Ballot,\"vballot\":decoded.VBallot,\"status\":decoded.Status,\"command_count\":len(decoded.Command)})\n}\n{\"Time\":\"2026-10-05T10:13:48.842285159+08:00\",\"Action\":\"start\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\"}\n{\"Time\":\"2026-10-05T10:13:48.846510528+08:00\",\"Action\":\"run\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyPreservation\"}\n{\"Time\":\"2026-10-05T10:13:48.846546777+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyPreservation\",\"Output\":\"=== RUN   TestAssurancePrepareReplyPreservation\\n\"}\n{\"Time\":\"2026-10-05T10:13:48.846606626+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyPreservation\",\"Output\":\"CA_EVENT {\\\"acceptor\\\":2,\\\"ballot\\\":3,\\\"command_count\\\":1,\\\"event\\\":\\\"producer\\\",\\\"instance\\\":0,\\\"prepare_ballot\\\":3,\\\"replica\\\":1,\\\"status\\\":2,\\\"vballot\\\":1}\\n\"}\n{\"Time\":\"2026-10-05T10:13:48.846613543+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyPreservation\",\"Output\":\"CA_EVENT {\\\"acceptor\\\":2,\\\"ballot\\\":3,\\\"command_count\\\":1,\\\"event\\\":\\\"decoded\\\",\\\"instance\\\":0,\\\"replica\\\":1,\\\"status\\\":2,\\\"vballot\\\":0}\\n\"}\n{\"Time\":\"2026-10-05T10:13:48.846620729+08:00\",\"Action\":\"output\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareReplyPreservation\",\"Output\":\"--- PASS: TestAssurancePrepareReplyPreservation (0.00s)\\n\"}\n{\"Time\":\"2026-10-05T10:13:48.84662307+08:00\",\"Action\":\"pass\",\"Package\":\"github.com/imdea-software/swiftpaxos/epaxos\",\"Test\":\"TestAssurancePrepareR