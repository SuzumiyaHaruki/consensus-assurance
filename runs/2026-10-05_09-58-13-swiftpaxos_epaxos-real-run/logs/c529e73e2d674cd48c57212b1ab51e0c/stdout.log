ceSpace[prepare.Replica][prepare.Instance]\n  1173\t\tvar preply *PrepareReply\n  1174\t\n  1175\t\tif prepare.Ballot > r.maxRecvBallot {\n  1176\t\t\tr.maxRecvBallot = prepare.Ballot\n  1177\t\t}\n  1178\t\n  1179\t\tif inst == nil {\n  1180\t\t\tr.InstanceSpace[prepare.Replica][prepare.Instance] = r.newInstanceDefault(prepare.Replica, prepare.Instance)\n  1181\t\t\tinst = r.InstanceSpace[prepare.Replica][prepare.Instance]\n  1182\t\t}\n  1183\t\n  1184\t\tif prepare.Ballot < inst.bal {\n  1185\t\t\tr.Printf(\"Joined higher ballot %d < %d\", prepare.Ballot, inst.bal)\n  1186\t\t} else if inst.bal < prepare.Ballot {\n  1187\t\t\tr.Printf(\"Joining ballot %d \", prepare.Ballot)\n  1188\t\t\tinst.bal = prepare.Ballot\n  1189\t\t}\n  1190\t\n  1191\t\tpreply = &PrepareReply{\n  1192\t\t\tr.Id,\n  1193\t\t\tprepare.Replica,\n  1194\t\t\tprepare.Instance,\n  1195\t\t\tinst.bal,\n  1196\t\t\tinst.vbal,\n  1197\t\t\tinst.Status,\n  1198\t\t\tinst.Cmds,\n  1199\t\t\tinst.Seq,\n  1200\t\t\tinst.Deps}\n  1201\t\tr.replyPrepare(prepare.LeaderId, preply)\n  1202\t}\n  1203\t\n  1204\tfunc (r *Replica) handlePrepareReply(preply *PrepareReply) {\n  1205\t\tinst := r.InstanceSpace[preply.Replica][preply.Instance]\n  1206\t\tlb := inst.lb\n  1207\t\n  1208\t\tif preply.Ballot > r.maxRecvBallot {\n  1209\t\t\tr.maxRecvBallot = preply.Ballot\n  1210\t\t}\n  1211\t\n  1212\t\tif inst == nil || lb == nil || !lb.preparing {\n  1213\t\t\treturn\n  1214\t\t}\n  1215\t\n  1216\t\tif preply.Ballot != lb.lastTriedBallot {\n  1217\t\t\tlb.nacks++\n  1218\t\t\treturn\n  1219\t\t}\n  1220\t\n  1221\t\tlb.prepareReplies = append(lb.prepareReplies, preply)\n  1222\t\tif len(lb.prepareReplies) < r.Replica.SlowQuorumSize() {\n  1223\t\t\treturn\n  1224\t\t}\n  1225\t\n  1226\t\tlb.preparing = false\n  1227\t\n  1228\t\t// Deal with each sub-cases in order of the (corrected) TLA specification\n  1229\t\t// only replies from the highest ballot are taken into account\n  1230\t\t// 1 -> committed/executed\n  1231\t\t// 2 -> accepted\n  1232\t\t// 3 -> pre-accepted > f (not including the leader) and allEqual\n  1233\t\t// 4 -> pre-accepted >= f/2 (not including the leader) and allEqual\n  1234\t\t// 5 -> pre-accepted > 0 and (disagreeing or leader replied or pre-accepted < f/2)\n  1235\t\t// 6 -> none of the above\n  1236\t\tpreAcceptCount := 0\n  1237\t\tsubCase := 0\n  1238\t\tallEqual := true\n  1239\t\tfor _, element := range lb.prepareReplies {\n  1240\t\t\tif element.VBallot >= lb.ballot {\n  1241\t\t\t\tlb.ballot = element.VBallot\n  1242\t\t\t\tlb.cmds = element.Command\n  1243\t\t\t\tlb.seq = element.Seq\n  1244\t\t\t\tlb.deps = element.Deps\n  1245\t\t\t\tlb.status = element.Status\n  1246\t\t\t}\n  1247\t\t\tif element.AcceptorId == element.Replica {\n  1248\t\t\t\tlb.leaderResponded = true\n  1249\t\t\t}\n  1250\t\t\tif element.Status == PREACCEPTED_EQ || element.Status == PREACCEPTED {\n  1251\t\t\t\tpreAcceptCount++\n  1252\t\t\t}\n  1253\t\t}\n  1254\t\n  1255\t\tif lb.status >= COMMITTED { // 1\n  1256\t\t\tsubCase = 1\n  1257\t\t} else if lb.status == ACCEPTED { // 2\n  1258\t\t\tsubCase = 2\n  1259\t\t} else if lb.status == PREACCEPTED || lb.status == PREACCEPTED_EQ {\n  1260\t\t\tfor _, element := range lb.prepareReplies {\n  1261\t\t\t\tif element.VBallot == lb.ballot && element.Status >= PREACCEPTED {\n  1262\t\t\t\t\t_, _, equal := r.mergeAttributes(lb.seq, lb.deps, element.Seq, element.Deps)\n  1263\t\t\t\t\tif !equal {\n  1264\t\t\t\t\t\tallEqual = false\n  1265\t\t\t\t\t\tbreak\n  1266\t\t\t\t\t}\n  1267\t\t\t\t}\n  1268\t\t\t}\n  1269\t\t\tif preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1270\t\t\t\tsubCase = 3\n  1271\t\t\t} else if preAcceptCount >= r.Replica.SlowQuorumSize()-1 && !lb.leaderResponded && allEqual {\n  1272\t\t\t\tsubCase = 4\n  1273\t\t\t} else if preAcceptCount > 0 && (lb.leaderResponded || !allEqual || preAcceptCount < r.Replica.SlowQuorumSize()-1) {\n  1274\t\t\t\tsubCase = 5\n  1275\t\t\t} else {\n  1276\t\t\t\tpanic(\"Cannot occur\")\n  1277\t\t\t}\n  1278\t\t} else if lb.status == NONE {\n  1279\t\t\tsubCase = 6\n  1280\t\t} else {\n  1281\t\t\tpanic(\"Status unknown\")\n  1282\t\t}\n  1283\t\n  1284\t\t// if subCase != 5 {\n  1285\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d\\n\", preply.Replica, preply.Instance, subCase)\n  1286\t\t// } else {\n  1287\t\t// \tdlog.Printf(\"In %d.%d, sub-case %d with (leaderResponded=%t, allEqual=%t, enough=%t)\\n\",\n  1288\t\t// \t\tpreply.Replica, preply.Instance, subCase, lb.leaderResponded, allEqual, preAcceptCount < r.Replica.SlowQuorumSize()-1)\n  1289\t\t// }\n  1290\t\n  1291\t\tinst.Cmds = lb.cmds\n  1292\t\tinst.bal = lb.lastTriedBallot\n  1293\t\tinst.vbal = lb.lastTriedBallot\n  1294\t\tinst.Seq = lb.seq\n  1295\t\tinst.Deps = lb.deps\n  1296\t\tinst.Status = lb.status\n  1297\t\n  1298\t\tif subCase == 1 {\n  1299\t\t\t// nothing to do\n  1300\t\t} else if subCase == 2 || subCase == 3 {\n  1301\t\t\tinst.Status = ACCEPTED\n  1302\t\t\tlb.status = ACCEPTED\n  1303\t\t\tr.bcastAccept(preply.Replica, preply.Instance)\n  1304\t\t} else if subCase == 4 {\n  1305\t\t\tlb.tryingToPreAccept = true\n  1306\t\t\tr.bcastTryPreAccept(preply.Replica, preply.Instance)\n  1307\t\t} else { // subCase 5 and 6\n  1308\t\t\tcmd := state.NOOP()\n  1309\t\t\tif inst.lb.cmds != nil {\n  1310\t\t\t\tcmd = inst.lb.cmds\n  1311\t\t\t}\n  1312\t\t\tr.startPhase1(cmd, preply.Replica, preply.Instance, lb.lastTriedBallot, lb.clientProposals)\n  1313\t\t}\n  1314\t}\n  1315\t\n   207\t\t\tif err != nil {\n   208\t\t\t\tr.Println(\"Accept error:\", err)\n   209\t\t\t\tcontinue\n   210\t\t\t}\n   211\t\t\tgo r.clientListener(conn)\n   212\t\t}\n   213\t}\n   214\t\n   215\tfunc (r *Replica) SendMsg(peerId int32, code uint8, msg fastrpc.Serializable) {\n   216\t\tr.M.Lock()\n   217\t\tdefer r.M.Unlock()\n   218\t\n   219\t\tw := r.PeerWriters[peerId]\n   220\t\tif w == nil {\n   221\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   222\t\t\treturn\n   223\t\t}\n   224\t\tw.WriteByte(code)\n   225\t\tmsg.Marshal(w)\n   226\t\tw.Flush()\n   227\t}\n   228\t\n   229\tfunc (r *Replica) SendClientMsg(id int32, code uint8, msg fastrpc.Serializable) {\n   230\t\tr.M.Lock()\n   231\t\tdefer r.M.Unlock()\n   232\t\n   233\t\tw := r.ClientWriters[id]\n   234\t\tif w == nil {\n   235\t\t\tr.Printf(\"Connection to client %d lost!\", id)\n   236\t\t\treturn\n   237\t\t}\n   238\t\tw.WriteByte(code)\n   239\t\tmsg.Marshal(w)\n   240\t\tw.Flush()\n   241\t}\n   242\t\n   243\tfunc (r *Replica) SendMsgNoFlush(peerId int32, code uint8, msg fastrpc.Serializable) {\n   244\t\tr.M.Lock()\n   245\t\tdefer r.M.Unlock()\n   246\t\n   247\t\tw := r.PeerWriters[peerId]\n   248\t\tif w == nil {\n   249\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   250\t\t\treturn\n   251\t\t}\n   252\t\tw.WriteByte(code)\n   253\t\tmsg.Marshal(w)\n   254\t}\n   255\t\n   256\tfunc (r *Replica) ReplyProposeTS(reply *defs.ProposeReplyTS, w *bufio.Writer, lock *sync.Mutex) {\n   257\t\tr.M.Lock()\n   258\t\tdefer r.M.Unlock()\n   259\t\n   260\t\treply.Marshal(w)\n   261\t\tw.Flush()\n   262\t}\n   263\t\n   264\tfunc (r *Replica) SendBeacon(peerId int32) {\n   265\t\tr.M.Lock()\n   266\t\tdefer r.M.Unlock()\n   267\t\n   268\t\tw := r.PeerWriters[peerId]\n   269\t\tif w == nil {\n   270\t\t\tr.Printf(\"Connection to %d lost!\", peerId)\n   271\t\t\treturn\n   272\t\t}\n   273\t\tw.WriteByte(defs.GENERIC_SMR_BEACON)\n   274\t\tbeacon := &defs.Beacon{\n   275\t\t\tTimestamp: time.Now().UnixNano(),\n   276\t\t}\n   277\t\tbeacon.Marshal(w)\n   278\t\tw.Flush()\n   279\t}\n   280\t\n   281\tfunc (r *Replica) ReplyBeacon(beacon *defs.GBeacon) {\n   282\t\tr.M.Lock()\n   283\t\tdefer r.M.Unlock()\n   284\t\n   285\t\tw := r.PeerWriters[beacon.Rid]\n   286\t\tif w == nil {\n   287\t\t\tr.Printf(\"Connection to %d lost!\", beacon.Rid)\n   288\t\t\treturn\n--\n   408\t\t\tr.PeerWriters[id] = bufio.NewWriter(conn)\n   409\t\t\tr.Alive[id] = true\n   410\t\t\tr.Printf(\"IN Connected to %d\", id)\n   411\t\t}\n   412\t\n   413\t\tdone <- true\n   414\t}\n   415\t\n   416\tfunc (r *Replica) replicaListener(rid int, reader *bufio.Reader) {\n   417\t\tvar (\n   418\t\t\tmsgType      uint8\n   419\t\t\terr          error = nil\n   420\t\t\tgbeacon      defs.Beacon\n   421\t\t\tgbeaconReply defs.BeaconReply\n   422\t\t)\n   423\t\n   424\t\tfor err == nil && !r.Shutdown {\n   425\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   426\t\t\t\tbreak\n   427\t\t\t}\n   428\t\n   429\t\t\tswitch uint8(msgType) {\n   430\t\n   431\t\t\tcase defs.GENERIC_SMR_BEACON:\n   432\t\t\t\tif err = gbeacon.Unmarshal(reader); err != nil {\n   433\t\t\t\t\tbreak\n   434\t\t\t\t}\n   435\t\t\t\tr.ReplyBeacon(&defs.GBeacon{\n   436\t\t\t\t\tRid:       int32(rid),\n   437\t\t\t\t\tTimestamp: gbeacon.Timestamp,\n   438\t\t\t\t})\n   439\t\t\t\tbreak\n   440\t\n   441\t\t\tcase defs.GENERIC_SMR_BEACON_REPLY:\n   442\t\t\t\tif err = gbeaconReply.Unmarshal(reader); err != nil {\n   443\t\t\t\t\tbreak\n   444\t\t\t\t}\n   445\t\t\t\tr.M.Lock()\n   446\t\t\t\tr.Latencies[rid] += time.Now().UnixNano() - gbeaconReply.Timestamp\n   447\t\t\t\tr.M.Unlock()\n   448\t\t\t\tnow := time.Now().UnixNano()\n   449\t\t\t\tr.Ewma[rid] = 0.99*r.Ewma[rid] + 0.01*float64(now-gbeaconReply.Timestamp)\n   450\t\t\t\tbreak\n   451\t\n   452\t\t\tdefault:\n   453\t\t\t\tp, exists := r.RPC.Get(msgType)\n   454\t\t\t\tif exists {\n   455\t\t\t\t\tobj := p.Obj.New()\n   456\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   457\t\t\t\t\t\tbreak\n   458\t\t\t\t\t}\n   459\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   460\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDurationID(rid))\n   461\t\t\t\t\t\tp.Chan <- obj\n   462\t\t\t\t\t}(obj)\n   463\t\t\t\t} else {\n   464\t\t\t\t\tr.Fatal(\"Error: received unknown message type \", msgType, \" from \", rid)\n   465\t\t\t\t}\n   466\t\t\t}\n   467\t\t}\n   468\t\n   469\t\tr.M.Lock()\n   470\t\tr.Alive[rid] = false\n   471\t\tr.M.Unlock()\n   472\t}\n   473\t\n   474\tfunc (r *Replica) clientListener(conn net.Conn) {\n   475\t\treader := bufio.NewReader(conn)\n   476\t\twriter := bufio.NewWriter(conn)\n   477\t\n   478\t\tvar (\n   479\t\t\tmsgType byte\n   480\t\t\terr     error\n   481\t\t)\n   482\t\n   483\t\tr.M.Lock()\n   484\t\tr.Println(\"Client up\", conn.RemoteAddr(), \"(\", r.LRead, \")\")\n   485\t\tr.M.Unlock()\n   486\t\n   487\t\taddr := strings.Split(conn.RemoteAddr().String(), \":\")[0]\n   488\t\tisProxy := r.Config.Proxy.IsProxy(r.Alias, addr)\n   489\t\n   490\t\tmutex := &sync.Mutex{}\n   491\t\n   492\t\tdchan := defs.NewDelayProposeChan(r.Dt.WaitDuration(addr), r.ProposeChan)\n   493\t\n   494\t\tfor !r.Shutdown && err == nil {\n   495\t\t\tif msgType, err = reader.ReadByte(); err != nil {\n   496\t\t\t\tbreak\n   497\t\t\t}\n   498\t\n   499\t\t\tswitch uint8(msgType) {\n   500\t\t\tcase defs.PROPOSE:\n   501\t\t\t\tpropose := &defs.Propose{}\n   502\t\t\t\tif err = propose.Unmarshal(reader); err != nil {\n   503\t\t\t\t\tbreak\n   504\t\t\t\t}\n   505\t\t\t\tr.M.Lock()\n   506\t\t\t\tr.ClientWriters[propose.ClientId] = writer\n   507\t\t\t\tr.M.Unlock()\n   508\t\t\t\top := propose.Command.Op\n   509\t\t\t\tif r.LRead && (op == state.GET || op == state.SCAN) {\n   510\t\t\t\t\tr.ReplyProposeTS(&defs.ProposeReplyTS{\n   511\t\t\t\t\t\tOK:        defs.TRUE,\n   512\t\t\t\t\t\tCommandId: propose.CommandId,\n   513\t\t\t\t\t\tValue:     propose.Command.Execute(r.State),\n   514\t\t\t\t\t\tTimestamp: propose.Timestamp,\n   515\t\t\t\t\t}, writer, mutex)\n   516\t\t\t\t} else {\n   517\t\t\t\t\tdchan.Write(&defs.GPropose{\n   518\t\t\t\t\t\tPropose: propose,\n   519\t\t\t\t\t\tReply:   writer,\n   520\t\t\t\t\t\tMutex:   mutex,\n   521\t\t\t\t\t\tProxy:   isProxy,\n   522\t\t\t\t\t\tAddr:    addr,\n   523\t\t\t\t\t})\n   524\t\t\t\t}\n   525\t\t\t\tbreak\n   526\t\n   527\t\t\tcase defs.READ:\n   528\t\t\t\t// TODO: do something with this\n   529\t\t\t\tread := &defs.Read{}\n   530\t\t\t\tif err = read.Unmarshal(reader); err != nil {\n   531\t\t\t\t\tbreak\n   532\t\t\t\t}\n   533\t\t\t\tbreak\n   534\t\n   535\t\t\tcase defs.PROPOSE_AND_READ:\n   536\t\t\t\t// TODO: do something with this\n   537\t\t\t\tpr := &defs.ProposeAndRead{}\n   538\t\t\t\tif err = pr.Unmarshal(reader); err != nil {\n   539\t\t\t\t\tbreak\n   540\t\t\t\t}\n   541\t\t\t\tbreak\n   542\t\n   543\t\t\tcase defs.STATS:\n   544\t\t\t\tr.M.Lock()\n   545\t\t\t\tb, _ := json.Marshal(r.Stats)\n   546\t\t\t\tr.M.Unlock()\n   547\t\t\t\twriter.Write(b)\n   548\t\t\t\twriter.Flush()\n   549\t\n   550\t\t\tdefault:\n   551\t\t\t\tp, exists := r.RPC.Get(msgType)\n   552\t\t\t\tif exists {\n   553\t\t\t\t\tobj := p.Obj.New()\n   554\t\t\t\t\tif err = obj.Unmarshal(reader); err != nil {\n   555\t\t\t\t\t\tbreak\n   556\t\t\t\t\t}\n   557\t\t\t\t\tgo func(obj fastrpc.Serializable) {\n   558\t\t\t\t\t\ttime.Sleep(r.Dt.WaitDuration(addr))\n   559\t\t\t\t\t\tp.Chan <- obj\n   560\t\t\t\t\t}(obj)\n   561\t\t\t\t} else {\n   562\t\t\t\t\tr.Fatal(\"Error: received unknown client message \", msgType)\n   563\t\t\t\t}\n   564\t\t\t}\n   565\t\t}\n   566\t\n   567\t\tconn.Close()\n   568\t\tr.Println(\"Client down\", conn.RemoteAddr())\n   569\t}\n   570\t\n   571\tfunc Leader(ballot int32, repNum int) int32 {\n   572\t\treturn ballot % int32(repNum)\n   573\t}\n   574\t\n   575\tfunc NextBallotOf(rid, oldBallot int32, repNum int) int32 {\n   576\t\treturn (oldBallot/int32(repNum)+1)*int32(repNum) + rid\n   577\t}\npackage rpc\n\nimport \"io\"\n\ntype Serializable interface {\n\tMarshal(io.Writer)\n\tUnmarshal(io.Reader) error\n\tNew() Serializable\n}\n\ntype Pair struct {\n\tObj  Serializable\n\tChan chan Serializable\n}\n\ntype Table struct {\n\tid    uint8\n\tpairs map[uint8]Pair\n}\n\nfunc NewTable() *Table {\n\treturn &Table{\n\t\tid:    0,\n\t\tpairs: make(map[uint8]Pair),\n\t}\n}\n\nfunc NewTableId(id uint8) *Table {\n\treturn &Table{\n\t\tid:    id,\n\t\tpairs: make(map[uint8]Pair),\n\t}\n}\n\nfunc (t *Table) Register(obj Serializable, notify chan Serializable) uint8 {\n\tid := t.id\n\tt.id++\n\tt.pairs[id] = Pair{\n\t\tObj:  obj,\n\t\tChan: notify,\n\t}\n\treturn id\n}\n\nfunc (t *Table) Get(id uint8) (Pair, bool) {\n\tp, exists := t.pairs[id]\n\treturn p, exists\n}\n","exit_code":0,"status":"completed"}}
