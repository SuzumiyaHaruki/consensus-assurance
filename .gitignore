.venv/
.tools/
/runs/*
# Only explicitly selected experiments and the global index are tracked.
!/runs/README.md
!/runs/2026-09-27_13-22-02-hashicorp_raft-real-run/
/runs/**/.run.lock
/runs/**/.execution/
/runs/**/native-draft/tmp/
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/

# Local execution permissions and machine-specific overrides.
configs/targets/*.run.yaml

# Future selected archives retain source + reconstructible experiment deltas.
/runs/**/experiments/**/workspace/
