.venv/
.tools/
/runs/*
# Only explicitly selected experiments and the global index are tracked.
!/runs/README.md
!/runs/2026-10-04_10-35-25-etcd_raft-real-run/
!/runs/2026-10-04_11-12-06-hashicorp_raft-real-run/
!/runs/2026-10-04_11-52-07-dragonboat_raft-real-run/
!/runs/2026-10-04_12-40-09-omnipaxos-real-run/
/runs/**/.run.lock
/runs/**/.execution/
/runs/**/native-draft/tmp/
/runs/**/native-draft/local-tmp/
/runs/**/native-draft/local-cache/
/runs/**/native-draft/local-go-cache/
/runs/**/draft/tmp/
/runs/**/draft/local-tmp/
/runs/**/draft/local-cache/
/runs/**/draft/local-go-cache/
/runs/**/draft/local-go-tmp/
/runs/**/draft/gocache/
/runs/**/draft/gotmp/
__pycache__/
.pytest_cache/
*.egg-info/
build/
dist/

# Local execution permissions and machine-specific overrides.
configs/targets/*.run.yaml

# Future selected archives retain source + reconstructible experiment deltas.
/runs/**/experiments/**/workspace/
